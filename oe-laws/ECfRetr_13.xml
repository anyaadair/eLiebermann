    <body>
      <div type="clause" n="13">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 13</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 13"><pb n="640" ed="#liebermann"/><hi rend="spaced"><hi rend="bold">De</hi><ptr type="liebermannNote" n="4" target="#ECfRetr_13.lnote.la.4"/> <hi rend="bold">diuisionibus scirarum</hi><ptr type="liebermannNote" n="5" target="#ECfRetr_13.lnote.la.5"/><hi rend="bold">.</hi></hi> Diuisiones<ptr type="liebermannNote" n="6" target="#ECfRetr_13.lnote.la.6"/> scirarum regis<ptr type="liebermannNote" n="7" target="#ECfRetr_13.lnote.la.7"/> proprie<ptr type="liebermannNote" n="8" target="#ECfRetr_13.lnote.la.8"/> cum iudicio quatuor cheminorum regalium sunt<ptr type="liebermannNote" n="9" target="#ECfRetr_13.lnote.la.9"/>.</ab>
        <note type="comparison" source="#liebermann" n="640"><label>printed alongside</label> <ref target="clause:ECf_13">ECf 13</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 640 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_13.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">Diuisiones <hi rend="italic">Cb Lond; Rubr. fehlt Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">Diuisiones Cb Lond; the rubric is lacking in Pl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_13.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">schi. <hi rend="italic">Va Hv K</hi></seg><seg type="translation" xml:lang="en" source="#claude">schi. Va Hv K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_13.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">Diu.—reg. sunt <hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Diu.—reg. sunt lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_13.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">et regni <hi rend="italic">fügt zu K</hi></seg><seg type="translation" xml:lang="en" source="#claude">K adds et regni</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_13.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">proprio <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">proprio Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_13.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier bringt</hi> XVIII Murdra—d. est, <hi rend="italic">d. i. C.</hi> 16. 16, 1, <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">here Lond brings XVIII Murdra—d. est, i.e. c. 16. 16, 1</seg></note>
      </div>
