    <body>
      <div type="clause" n="35.4">
        <head><ref type="lawCode" target="law:Af">Af</ref> 35.4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35.4" corresp="#wit-e"><pb n="68" ed="#liebermann"/>Gif he hine to preoste<ptr type="liebermannNote" n="35" target="#Af_35-4.lnote.oe.35"/> bescire<ptr type="liebermannNote" n="36" target="#Af_35-4.lnote.oe.36"/> unbundenne, mid XXX scill. gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35.4" corresp="#wit-h"><pb n="68" ed="#liebermann"/>Gif he hine to preoste<ptr type="liebermannNote" n="14" target="#Af_35-4.lnote.oe.14"/> bescyre unbundenne, mid XXX scll' gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35.4" corresp="#wit-b-no-prol"><pb n="69" ed="#liebermann"/>Gyf he hine to preoste bescyre unbundenne, mid XXX scill' gebete.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="35.4" corresp="#wit-q"><pb n="69" ed="#liebermann"/>Si eum radat<ptr type="liebermannNote" n="15" target="#Af_35-4.lnote.oe.15"/> in presbiterum, solutum<ptr type="liebermannNote" n="16" target="#Af_35-4.lnote.oe.16"/>, XXX<ptr type="liebermannNote" n="17" target="#Af_35-4.lnote.oe.17"/> sol. emendet.<ptr type="liebermannNote" n="18" target="#Af_35-4.lnote.oe.18"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="78" ed="#attenborough"/>Gif he hine to preoste bescire unbundenne, mid XXX scill. gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="36.4" corresp="#wit-e"><pb n="330" ed="#jurasinski-and-oliver"/>Gif he hine to preoste bescire unbundenne, mid XXX scill gebete.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="69" ed="#liebermann"/>Wenn er ihn zum Priester<ptr type="liebermannNote" n="1" target="#Af_35-4.lnote.de.1"/>, ungefesselt<ptr type="liebermannNote" n="2" target="#Af_35-4.lnote.de.2"/>, schert, büsse er mit 30 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he shaves him like a priest, without binding him, let him pay 30 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="79" ed="#attenborough"/>If he cuts his hair after the fashion of a priest's<ptr type="editorNote" n="1" target="#Af_35-4.attnote.n.1"/> without binding him, he shall pay 30 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="414" ed="#whitelock"/>If, without binding him, he cuts his hair like a priest’s, he is to pay him 30 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="331" ed="#jurasinski-and-oliver"/>If he shears him unbound as a priest,120 let him pay with 30 shillings.</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="331"><label>cf.</label> <ref target="clause:Wi_7">Wi 7</ref> <quote>Wihtred §6 [L7] urges a wary attitude toward tonsured men not known to be bound by a rule.</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-4.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">-st <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-st So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-4.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">bescyre <hi rend="italic">Ld;</hi> scyre <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">bescyre Ld; scyre So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-4.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">erstes</hi> e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">first e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-4.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de">reddat <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">reddat Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-4.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de">solitum <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">solitum Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-4.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de">XX <hi rend="italic">T Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">XX T Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-4.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_35-4.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Nur das geschädigte Aussehen des freien Waffenfähigen, nicht eine Standesveränderung ist gemeint. <hi rend="italic">Vgl. Gl</hi> Geistliche Z. 10, n. 31</seg><seg type="translation" xml:lang="en" source="#claude">Only the damaged appearance of the free man capable of bearing arms is meant, not a change of status. <hi rend="italic">Cf. Gl</hi> Geistliche l. 10, n. 31</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_35-4.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Im Ggs. zu 35, 6</seg><seg type="translation" xml:lang="en" source="#claude">In contrast to 35, 6</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_35-4.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">197</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e.</hi> if he tonsures him.</seg></note>
      </div>
    </body>
  </text>
