      <div type="clause" n="12">
        <head>Af Rb 12</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="12" corresp="#wit-e"><pb n="16" ed="#liebermann"/>XIII. Be wudubærnette.<ptr type="liebermannNote" n="17" target="#Rubrics-Af_12.lnote.oe.17"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="12" corresp="#wit-ot-frag"><pb n="16" ed="#liebermann"/>… udubærnete.<ptr type="liebermannNote" n="2" target="#Rubrics-Af_12.lnote.oe.2"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="12" corresp="#wit-g-prol"><pb n="16" ed="#liebermann"/>XIII. Be wudubærnette.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="12" corresp="#wit-h"><pb n="17" ed="#liebermann"/>XIII. Be wuda<ptr type="liebermannNote" n="11" target="#Rubrics-Af_12.lnote.oe.11"/> bærnette.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="12" corresp="#wit-q"><pb n="17" ed="#liebermann"/>De nemore combusto.<ptr type="liebermannNote" n="14" target="#Rubrics-Af_12.lnote.oe.14"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="190" ed="#jurasinski-and-oliver"/>XIII Be wudu bærnette</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="190" ed="#jurasinski-and-oliver"/>Be wudebernete gif man afylled bið on gemænum weorce</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="17" ed="#liebermann"/>Von Gehölz-Abbrennung.<ptr type="liebermannNote" n="1" target="#Rubrics-Af_12.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of the burning of woodland.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="191" ed="#jurasinski-and-oliver"/>Concerning burning wood</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="191" ed="#jurasinski-and-oliver"/>Concerning burning wood, and if a person is killed during shared work</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_12.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht</hi> [w]udab.</seg><seg type="translation" xml:lang="en" source="#claude">perhaps [w]udab.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_12.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">17</biblScope></bibl><seg type="original" xml:lang="de">vel secato <hi rend="italic">fügt Hk Br zu;</hi> De secante casu ligni oppresso <hi rend="italic">fügt Hk zu;</hi> De interfecto a casu in communi opere <hi rend="italic">fügt Br zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">vel secato added by Hk Br; De secante casu ligni oppresso added by Hk; De interfecto a casu in communi opere added by Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_12.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de">Be ðon ðe mon oþerne offylle <hi rend="italic">fügt ein Ld</hi> [<hi rend="italic">aus B?</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">Be ðon ðe mon oþerne offylle inserted by Ld [from B?]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_12.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">17</biblScope></bibl><seg type="original" xml:lang="de">a <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">a on an erasure</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_12.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">40</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">In H’s <hi rend="italic">wuda</hi>, das Frühere aufnahmen, steht <hi rend="italic">a</hi> nur auf Rasur. — ‘Waldbrand’, bei Schmid, könnte an Zufall denken lassen</seg><seg type="translation" xml:lang="en" source="#claude">In H’s <hi rend="italic">wuda</hi>, which earlier editors adopted, <hi rend="italic">a</hi> stands only on an erasure. — ‘Forest fire’, in Schmid, might suggest an accident</seg></note>
      </div>
    </body>
