      <div type="clause" n="3">
        <head><ref type="lawCode" target="law:IIIAs">III As</ref> 3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3" corresp="#wit-q"><pb n="170" ed="#liebermann"/>Tertium est, quod gratiant omnes misericorditer te<ptr type="liebermannNote" n="22" target="#IIIAs_3.lnote.oe.22"/>, karissimum<ptr type="liebermannNote" n="23" target="#IIIAs_3.lnote.oe.23"/> dominum<ptr type="liebermannNote" n="24" target="#IIIAs_3.lnote.oe.24"/> suum<ptr type="liebermannNote" n="25" target="#IIIAs_3.lnote.oe.25"/>, super<ptr type="liebermannNote" n="26" target="#IIIAs_3.lnote.oe.26"/> dono<ptr type="liebermannNote" n="27" target="#IIIAs_3.lnote.oe.27"/> quod forisfactis hominibus concessisti: hoc est, quod perdonatur omnibus<ptr type="liebermannNote" n="28" target="#IIIAs_3.lnote.oe.28"/> forisfactum<ptr type="liebermannNote" n="5" target="#IIIAs_3.lnote.oe.5"/><ptr type="liebermannNote" n="a" target="#IIIAs_3.lnote.oe.a"/> (forisfactura) de quocumque furto, quod ante concilium<ptr type="liebermannNote" n="20" target="#IIIAs_3.lnote.oe.20"/> de Fefresham<ptr type="liebermannNote" n="21" target="#IIIAs_3.lnote.oe.21"/> factum fuit, eo tenore ut<ptr type="liebermannNote" n="5" target="#IIIAs_3.lnote.oe.5"/> (quo) semper<ptr type="liebermannNote" n="b" target="#IIIAs_3.lnote.oe.b"/> deinceps ab omni malo quiescant<ptr type="liebermannNote" n="29" target="#IIIAs_3.lnote.oe.29"/> et omne latrocinium<ptr type="liebermannNote" n="30" target="#IIIAs_3.lnote.oe.30"/> suum<ptr type="liebermannNote" n="31" target="#IIIAs_3.lnote.oe.31"/> confiteantur et emendent hinc ad Augustum.<ptr type="liebermannNote" n="32" target="#IIIAs_3.lnote.oe.32"/><ptr type="liebermannNote" n="c" target="#IIIAs_3.lnote.oe.c"/></ab>
        <ab type="editionText" xml:lang="la" source="#attenborough" n="3" corresp="#wit-q"><pb n="144" ed="#attenborough"/>Tertium est, quod gratiant omnes misericorditer te<ptr type="editorNote" n="1" target="#IIIAs_3.attnote.fn.1"/>, karissimum<ptr type="editorNote" n="2" target="#IIIAs_3.attnote.fn.2"/> dominum suum, super<ptr type="editorNote" n="3" target="#IIIAs_3.attnote.fn.3"/> dono quod forisfactis hominibus concessisti; hoc est, quod pardonatur omnibus forisfactura de quocumque furto, quod ante concilium de Favresham<ptr type="editorNote" n="4" target="#IIIAs_3.attnote.fn.4"/> factum fuit, eo tenore ut<ptr type="editorNote" n="5" target="#IIIAs_3.attnote.fn.5"/> semper deinceps ab omni malo quiescant, et omne latrocinium suum<ptr type="editorNote" n="6" target="#IIIAs_3.attnote.fn.6"/> confiteantur et emendent hinc ad Augustum.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="145" ed="#attenborough"/>Thirdly, all humbly<ptr type="editorNote" n="1" target="#IIIAs_3.attnote.n.1"/> thank you, their most beloved lord, for the favour you have granted to criminals; namely that all criminals shall be pardoned<ptr type="editorNote" n="2" target="#IIIAs_3.attnote.n.2"/> for any crime whatsoever, which was committed before the Council of Faversham, on the condition that henceforth and forever they abstain from all evil doing, and between now and August confess their crimes and make amends for everything of which they have been guilty.</ab>
        <note type="comparison" source="#liebermann" n="170"><ref target="clause:VAs_3">V As 3.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. V As. 3, 1</note>
        <note type="comparison" source="#wormald-mel" n="296"><label>parallel (extended amnesty)</label> V As 3.1 <quote>there was an 'amnesty' clause, this time extended to 'August' as opposed to Exeter's (May?) Rogation Days</quote></note>
        <note type="editorial">Latin only; no German translation in Liebermann. Liebermann compares V As.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">trie <hi rend="italic">T; fehlt MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">trie T; lacking in MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">h' m̄ ū <hi rend="italic">MHk;</hi> hoc munerum <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">h' m̄ ū MHk; hoc munerum T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">s. d. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. d. T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Jl</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Jl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">de <hi rend="italic">TM</hi></seg><seg type="translation" xml:lang="en" source="#claude">de TM</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">donis <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">donis T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">omnis <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">omnis T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond; (eingeklammertes) übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket Lond; (the bracketed words) the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">consil. <hi rend="italic">M</hi></seg><seg type="translation" xml:lang="en" source="#claude">consil. M</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so TMHkBr;</hi> Faur. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus TMHkBr; Faur. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">requi. <hi rend="italic">Jl</hi></seg><seg type="translation" xml:lang="en" source="#claude">requi. Jl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. Co;</hi> s. atroc. <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above Co; s. atroc. Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">ang. <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">ang. MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">111</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Das unpassende <hi rend="italic">misericorditer</hi> erklärt sich aus falscher Wahl Q’s zwischen den 2 Bedd. von <hi rend="italic">arlice; ar</hi> nämlich glossiert neben <hi rend="italic">misericordia</hi> auch <hi rend="italic">honor;</hi> offenbar meinte das Orig. ‘ehrerbietig’. — Ebenso lag für <hi rend="italic">forisfactum</hi> wohl <hi rend="italic">wite</hi> im Or. vor, womit dies genauer ‘Strafe gegenüber dem Richter’ meinte. Die Busspflicht gegenüber dem Kläger <hi rend="italic">emendare</hi> [aus <hi rend="italic">betan</hi>] bleibt gewahrt. <hi rend="italic">Vgl. Gl</hi> Amnestie 2</seg><seg type="translation" xml:lang="en" source="#claude">The inappropriate <hi rend="italic">misericorditer</hi> is explained by Q’s wrong choice between the 2 meanings of <hi rend="italic">arlice; ar</hi> glosses not only <hi rend="italic">misericordia</hi> but also <hi rend="italic">honor;</hi> evidently the orig. meant ‘respectfully’. — Likewise <hi rend="italic">forisfactum</hi> probably represents <hi rend="italic">wite</hi> in the orig., by which this meant more precisely ‘penalty due to the judge’. The obligation to pay compensation to the plaintiff, <hi rend="italic">emendare</hi> [from <hi rend="italic">betan</hi>], remains intact. <hi rend="italic">Cf. Gl</hi> Amnestie 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">111</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Wb conquiescere;</hi> im Or. stand <hi rend="italic">geswican</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Wb conquiescere;</hi> the orig. had <hi rend="italic">geswican</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_3.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">111</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S.</hi> Einl. 5</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See</hi> Introduction 5</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIAs_3.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">209</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">misericorditer</hi> is evidently a mistranslation—of <hi rend="italic">arlice</hi> according to Liebermann.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIAs_3.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">209</biblScope></bibl><seg type="original" xml:lang="en">Lit. ‘that the <hi rend="italic">wite</hi> should be excused to all.’</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_3.attnote.fn.1" n="1" source="#attenborough"><bibl><biblScope unit="page">144</biblScope></bibl><label>te</label><seg type="original" xml:lang="en">om. Br, M.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_3.attnote.fn.2" n="2" source="#attenborough"><bibl><biblScope unit="page">144</biblScope></bibl><label>karissimum</label><seg type="original" xml:lang="en"><hi rend="italic">h'm̅u̅</hi>. Hk, M.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_3.attnote.fn.3" n="3" source="#attenborough"><bibl><biblScope unit="page">144</biblScope></bibl><label>super</label><seg type="original" xml:lang="en"><hi rend="italic">de</hi>. Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_3.attnote.fn.4" n="4" source="#attenborough"><bibl><biblScope unit="page">144</biblScope></bibl><label>Favresham</label><seg type="original" xml:lang="en"><hi rend="italic">Fefresham</hi>. Br, M.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_3.attnote.fn.5" n="5" source="#attenborough"><bibl><biblScope unit="page">144</biblScope></bibl><label>ut</label><seg type="original" xml:lang="en"><hi rend="italic">quo</hi>. Br, M.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_3.attnote.fn.6" n="6" source="#attenborough"><bibl><biblScope unit="page">144</biblScope></bibl><label>suum</label><seg type="original" xml:lang="en">om. Br, M.</seg></note>
      </div>
