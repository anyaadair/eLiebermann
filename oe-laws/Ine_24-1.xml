      <div type="clause" n="24.1">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 24.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="24.1" corresp="#wit-e"><pb n="100" ed="#liebermann"/>Gif hine mon ofsléa, ne gylde hine mon his mægum<ptr type="liebermannNote" n="8" target="#Ine_24-1.lnote.oe.8"/>, gif hie<ptr type="liebermannNote" n="9" target="#Ine_24-1.lnote.oe.9-2"/> hine on XII<ptr type="liebermannNote" n="10" target="#Ine_24-1.lnote.oe.10-2"/> monðum ne áliesden.<ptr type="liebermannNote" n="11" target="#Ine_24-1.lnote.oe.11-2"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="24.1" corresp="#wit-h"><pb n="100" ed="#liebermann"/>Gif hine man ofslea, ne gylde hine man his magum, gif hy hine on twelf monþum ne alysdon.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="24.1" corresp="#wit-b-no-prol"><pb n="100" ed="#liebermann"/>Gyf hine mon ofsléa, ne gylde hine man his magu<hi rend="italic">m</hi>, gyf hy hine on twelf monðum ne alysdon.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="24.1" corresp="#wit-q"><pb n="101" ed="#liebermann"/>Si occidatur, non soluatur parentibus suis, si eum<ptr type="liebermannNote" n="9" target="#Ine_24-1.lnote.oe.9"/> intra<ptr type="liebermannNote" n="10" target="#Ine_24-1.lnote.oe.10"/> duodecim menses non redemerint.<ptr type="liebermannNote" n="11" target="#Ine_24-1.lnote.oe.11"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="44" ed="#attenborough"/>Gif hine mon ofsléa, ne gylde hine mon his mægum, gif hie hine on XII monðum ne áliesden.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="24.1" corresp="#wit-e"><pb n="390" ed="#jurasinski-and-oliver"/>Gif hine mon ofsléa, ne gylde hine mon his mægum, gif hie hine on XII monðum ne áliesden.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="101" ed="#liebermann"/>Wenn jemand einen solchen erschlägt, entgelte man ihn an dessen Verwandte<ptr type="liebermannNote" n="1" target="#Ine_24-1.lnote.de.1"/>, wenn sie ihn in 12 Monaten nicht ausgelöst haben, nicht [nach dem ersten Jahre der Verknechtung].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone slays such a man, let him not be paid for to his kinsmen, if they have not redeemed him within 12 months [after the first year of his enslavement].</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="45" ed="#attenborough"/>If he is slain, nothing shall be paid for him to his kinsmen if they have left him unransomed for twelve months.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="402" ed="#whitelock"/>If anyone kills him, nothing is to be paid to his kinsmen if they have not redeemed him within twelve months.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="391" ed="#jurasinski-and-oliver"/>If he is killed, one need not recompense his kin, if they have not ransomed him within twelve months.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_24-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">101</biblScope></bibl><seg type="original" xml:lang="de">non i. XII m. r. <hi rend="italic">M Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">non i. XII m. r. M Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_24-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">101</biblScope></bibl><seg type="original" xml:lang="de">infra <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">infra Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_24-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">101</biblScope></bibl><seg type="original" xml:lang="de">-runt <hi rend="italic">R;</hi> redimerent <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">-runt R; redimerent Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_24-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">100</biblScope></bibl><seg type="original" xml:lang="de">mag. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mag. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_24-1.lnote.oe.9-2" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">100</biblScope></bibl><seg type="original" xml:lang="de">hi <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hi Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_24-1.lnote.oe.10-2" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">100</biblScope></bibl><seg type="original" xml:lang="de">twelf <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">twelf Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_24-1.lnote.oe.11-2" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">100</biblScope></bibl><seg type="original" xml:lang="de">alysdon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">alysdon Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_24-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">72</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Verknechtung 9; Sippe 9; Frist 19</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Verknechtung 9; Sippe 9; Frist 19</seg></note>
      </div>
