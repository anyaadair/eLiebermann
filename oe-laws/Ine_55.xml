    <body>
      <div type="clause" n="55">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 55</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="55" corresp="#wit-e"><pb n="114" ed="#liebermann"/>XCVIIII. Ewo<ptr type="liebermannNote" n="16" target="#Ine_55.lnote.oe.16"/> bið<ptr type="liebermannNote" n="17" target="#Ine_55.lnote.oe.17"/> mid hire<ptr type="liebermannNote" n="18" target="#Ine_55.lnote.oe.18"/> giunge<ptr type="liebermannNote" n="19" target="#Ine_55.lnote.oe.19"/> sceape scill. weorð oþþæt XII<ptr type="liebermannNote" n="20" target="#Ine_55.lnote.oe.20"/><ptr type="liebermannNote" n="**" target="#Ine_55.lnote.oe.star2"/> niht ofer eastran.<ptr type="liebermannNote" n="21" target="#Ine_55.lnote.oe.21"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="55" corresp="#wit-h"><pb n="114" ed="#liebermann"/>XCIX. Eowu<ptr type="liebermannNote" n="11" target="#Ine_55.lnote.oe.11"/> bið mid hire geongan sceape scll' weorð oðþæt XIIII nyht<ptr type="liebermannNote" n="1" target="#Ine_55.lnote.oe.1"/> ofer eastran.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="55" corresp="#wit-b-no-prol"><pb n="114" ed="#liebermann"/>Be eowe wyrðe. Eowu<ptr type="liebermannNote" n="3" target="#Ine_55.lnote.oe.3"/> bið [mid<ptr type="liebermannNote" n="4" target="#Ine_55.lnote.oe.4"/>] hire geonge sceape scill' weorð oðþ<hi rend="italic">æt</hi> feowertyne niht ofer eastron.<ptr type="liebermannNote" n="5" target="#Ine_55.lnote.oe.5"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="55" corresp="#wit-q"><pb n="115" ed="#liebermann"/>Ouis cum agno suo ualet I solidum usque ad XIIII<ptr type="liebermannNote" n="10" target="#Ine_55.lnote.oe.10"/> noctes post pascha.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="54" ed="#attenborough"/>[Be eowe wyrðe.] Ewo bið mid hire giunge<ptr type="editorNote" n="17" target="#Ine_55.attnote.fn.17"/> sceape scill. weorð oþþæt XIIII<ptr type="editorNote" n="18" target="#Ine_55.attnote.fn.18"/> niht ofer Eastran.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="59" corresp="#wit-e"><pb n="420" ed="#jurasinski-and-oliver"/>{XCVIIII} Ewo bið mid hire giunge sceape sciƚƚ weorð oþþæt XII niht ofer eastran.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="115" ed="#liebermann"/>Ein Mutterschaf mit seinem<ptr type="liebermannNote" n="1" target="#Ine_55.lnote.de.1"/> jungen Schafe ist einen Schilling<ptr type="liebermannNote" n="2" target="#Ine_55.lnote.de.2"/> werth bis<ptr type="liebermannNote" n="3" target="#Ine_55.lnote.de.3"/> 12 (14<ptr type="liebermannNote" n="4" target="#Ine_55.lnote.de.4"/>) Tage nach Ostern.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">A ewe with her lamb is worth one shilling until 12 (14) days after Easter.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="55" ed="#attenborough"/>An ewe with her lamb is worth a shilling<ptr type="editorNote" n="1" target="#Ine_55.attnote.n.1"/>, until a fortnight after Easter.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><ptr type="editorNote" n="5" target="#Ine_55.whinote.n.5"/><pb n="406" ed="#whitelock"/>A ewe with her lamb is worth a shilling until 12 days after Easter.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="421" ed="#jurasinski-and-oliver"/>A ewe with her young sheep is worth a shilling until the twelfth night after Easter.</ab>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="409"><label>cf.</label> <ref target="clause:Ine_44-1">Ine 44.1</ref> <quote>Note that §59 values a ewe with her lamb at a shilling [...] But this does not seem out-of-line with the food-render required by §70.</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_55.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. geänd.</hi> eowe</seg><seg type="translation" xml:lang="en" source="#claude">altered to eowe in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_55.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. eingefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">inserted in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_55.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">r <hi rend="italic">später eingefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">r inserted later</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_55.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">115</biblScope></bibl><seg type="original" xml:lang="de">XIII <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">XIII MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_55.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">u <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">u on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_55.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_55.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">Eowu <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Eowu Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_55.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">beoð <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">beoð So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_55.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">hyre <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">hyre So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_55.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">geonge <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">geonge Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_55.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">XIIII <hi rend="italic">So;</hi> feowertyn <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">XIIII So; feowertyn Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_55.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">XIIII <hi rend="italic">mit allen übrigen Hss. zu bessern.</hi></seg><seg type="translation" xml:lang="en" source="#claude">emend to XIIII with all the other MSS.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_55.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">-ron <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ron So Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_55.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">78</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Schaf 1. a; Termin für Entwöhnung wird wie Schur (<hi rend="italic">ebd.</hi> 4) festgesetzt</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Schaf 1. a; a date for weaning is fixed, as for shearing (<hi rend="italic">ibid.</hi> 4)</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_55.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">78</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Preis 11</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Preis 11</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_55.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">78</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Wenn 14 richtig, 5. April bis 9. Mai; also Winterlammung im Februar und Lämmerweide im Frühjahr</seg><seg type="translation" xml:lang="en" source="#claude">If 14 is correct, 5 April to 9 May; hence winter lambing in February and pasturing of the lambs in spring</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_55.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">78</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘12 Nächte’ sonst nur nach Weihnachten gebräuchliche Frist; <hi rend="italic">s. d. Gl</hi> 8. a</seg><seg type="translation" xml:lang="en" source="#claude">‘12 nights’ is otherwise a period used only after Christmas; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 8. a</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_55.attnote.fn.17" n="17" source="#attenborough"><bibl><biblScope unit="page">54</biblScope></bibl><label>giunge</label><seg type="original" xml:lang="en"><hi rend="italic">geongan</hi>. H. <hi rend="italic">geonge</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_55.attnote.fn.18" n="18" source="#attenborough"><bibl><biblScope unit="page">54</biblScope></bibl><label>xiiii</label><seg type="original" xml:lang="en"><hi rend="italic"><hi rend="smallcaps">xii</hi></hi>. E. <hi rend="italic"><hi rend="smallcaps">xiiii</hi></hi>. H, B &amp; Quad.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_55.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">191</biblScope></bibl><seg type="original" xml:lang="en">The value of a sheep alone is given at a shilling (cf. note 1 to cap. 59 below) in VI As. cap. 6 § 2, and <hi rend="italic">Duns.</hi> cap. 7.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Ine_55.whinote.n.5" n="5" source="#whitelock"><bibl><biblScope unit="page">406</biblScope></bibl><label>12</label><seg type="original" xml:lang="en">Nowell’s transcript originally read 12, corrected to 14; later MSS have 14.</seg></note>
      </div>
