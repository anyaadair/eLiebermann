    <body>
      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:Blas">Blas</ref> 2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2" corresp="#wit-h"><pb n="388" ed="#liebermann"/>⁊ hæbbe se teond cyre swa wæterordal swa ysenordal, swa hwæþer<ptr type="liebermannNote" n="***" target="#Blas_2.lnote.oe.star3"/> him leofra sy.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2" corresp="#wit-b"><pb n="388" ed="#liebermann"/>⁊ hæbbe se ðe tyhð cyre<ptr type="liebermannNote" n="5" target="#Blas_2.lnote.oe.5"/> swa wæterordal swa isenordal, swa hwæðer swa him leofre sy.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2" corresp="#wit-q"><pb n="389" ed="#liebermann"/>Et<ptr type="liebermannNote" n="8" target="#Blas_2.lnote.oe.8"/> sit in arbitrio compellantis ordalium aque uel igniti ferri, quod ei carius (et<ptr type="liebermannNote" n="9" target="#Blas_2.lnote.oe.9"/> complacitius) erit.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2" corresp="#wit-cons"><pb n="389" ed="#liebermann"/>Accusator autem habeat electionem, utrum Dei iudicium malit, aque scilicet aut ferri.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-h">and hæbbe se teond<ptr type="editorNote" n="3" target="#Blas_2.attnote.fn.3"/> cyre, swa wæterordal swa ysenordal, swa hwæðer [swa] him leofra sy.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><ptr type="liebermannNote" n="1" target="#Blas_2.lnote.de.1"/><pb n="389" ed="#liebermann"/>Jedoch<ptr type="liebermannNote" n="2" target="#Blas_2.lnote.de.2"/> habe der Kläger<ptr type="liebermannNote" n="3" target="#Blas_2.lnote.de.3"/> die Wahl: ob Wasserordal oder Eisenordal, welches von beiden ihm lieber ist [von jenem erbracht zu verlangen].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">However, let the accuser have the choice: whether water ordeal or iron ordeal, whichever of the two he prefers [to demand that the other undergo].</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">And the man who is accused shall go to the ordeal, and the accuser shall choose either the ordeal by water or the ordeal by iron—whichever he prefers.</ab>
        <ab type="translation" xml:lang="en" source="#wormald" corresp="#wit-h">And the person charged is to go himself to the ordeal, and the accuser to have a choice between water-ordeal and iron-ordeal.</ab>
        <note type="comparison" source="#liebermann" n="389"><ref target="clause:IIIAtr_6">III Atr 6</ref></note>
        <note type="comparisonPrinted" source="#liebermann">III Atr. 6</note>
        <note type="editorial">H omits ‘swa’ after ‘hwæþer’ (also in I Atr 1.3 and III Atr 6). B's ‘cyre’ was later altered to ‘kyre’. Liebermann compares III Atr 6.; BR: added from Gesetze I p. 388, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Blas_2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">388</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">spät geänd.</hi> kyre</seg><seg type="translation" xml:lang="en" source="#claude">altered at a late date to kyre</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Blas_2.lnote.oe.star3" n="***" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">388</biblScope></bibl><seg type="original" xml:lang="de">swa <hi rend="italic">fortgelassen, auch I Atr.</hi> 1, 3; <hi rend="italic">III</hi> 6.</seg><seg type="translation" xml:lang="en" source="#claude">swa omitted, also I Atr. 1, 3; III 6.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Blas_2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">389</biblScope></bibl><seg type="original" xml:lang="de">per sol. <hi rend="italic">M</hi></seg><seg type="translation" xml:lang="en" source="#claude">per sol. M</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Blas_2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">389</biblScope></bibl><seg type="original" xml:lang="de">solo <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">solo K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Blas_2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">389</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Blas_2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">229</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Neuer Satz (gegen Schmid), weil Präsens <hi rend="italic">hæbbe</hi> nicht vom Ptt. <hi rend="italic">cwædon</hi> in normaler Consecutio temporum abhängen würde</seg><seg type="translation" xml:lang="en" source="#claude">A new sentence (against Schmid), because the present <hi rend="italic">hæbbe</hi> would not depend on the pret. <hi rend="italic">cwædon</hi> in a normal consecutio temporum</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Blas_2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">229</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">autem</hi> Cons richtig, da c. 1 nur von Eisen sprach</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">autem</hi> Cons rightly, since c. 1 spoke only of iron</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Blas_2.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">229</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Für <hi rend="italic">cyre</hi> liest Atr <hi rend="italic">geweald</hi>, für <hi rend="italic">leofra</hi> (= Hl 10): <hi rend="italic">he wille</hi>, was moderner klingt. <hi rend="italic">Vgl Gl</hi> Beweis 4</seg><seg type="translation" xml:lang="en" source="#claude">For <hi rend="italic">cyre</hi> Atr reads <hi rend="italic">geweald</hi>, and for <hi rend="italic">leofra</hi> (= Hl 10) <hi rend="italic">he wille</hi>, which sounds more modern. <hi rend="italic">Cf Gl</hi> Beweis 4</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Blas_2.attnote.fn.3" n="3" source="#attenborough"><bibl><biblScope unit="page">170</biblScope></bibl><label>teond</label><seg type="original" xml:lang="en"><hi rend="italic">se ðe tyhð.</hi> B.</seg></note>
      </div>
    </body>
