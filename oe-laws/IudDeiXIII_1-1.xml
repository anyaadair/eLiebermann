      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 1.1" corresp="#wit-lat"><pb n="422" ed="#liebermann"/>Accipe<ptr type="liebermannNote" n="3" target="#IudDeiXIII_1-1.lnote.oe.3"/> illos homines quos in uoluntate habes mittere in aquam et duc eos in ęcclesiam; et coram omnibus<ptr type="liebermannNote" n="4" target="#IudDeiXIII_1-1.lnote.oe.4"/> illis cantet presbyter missam, sicut mos est; et faciat<ptr type="liebermannNote" n="5" target="#IudDeiXIII_1-1.lnote.oe.5"/> eos ad<ptr type="liebermannNote" n="6" target="#IudDeiXIII_1-1.lnote.oe.6"/> ipsam missam<ptr type="liebermannNote" n="7" target="#IudDeiXIII_1-1.lnote.oe.7"/> offerre.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 422 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_1-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">422</biblScope></bibl><seg type="original" xml:lang="de">Peractis primo coram sacerdote trium dierum ieiuniis, duc [<hi rend="italic">aus</hi> I 1] <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Peractis primo coram sacerdote trium dierum ieiuniis, duc [from I 1] Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_1-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">422</biblScope></bibl><seg type="original" xml:lang="de">i. o. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. o. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_1-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">422</biblScope></bibl><seg type="original" xml:lang="de">fac <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">fac Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_1-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">422</biblScope></bibl><seg type="original" xml:lang="de">of. ad i. m. <hi rend="italic">Tr Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">of. ad i. m. Tr Mg</seg></note>
