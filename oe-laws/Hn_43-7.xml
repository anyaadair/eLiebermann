      <div type="clause" n="43.7">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 43.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 43.7" corresp="#wit-lat"><pb n="569" ed="#liebermann"/>Qui furtum<ptr type="liebermannNote" n="n" target="#Hn_43-7.lnote.oe.n"/> fecerit, qui proditor<ptr type="liebermannNote" n="26" target="#Hn_43-7.lnote.oe.26"/> domini<ptr type="liebermannNote" n="o" target="#Hn_43-7.lnote.oe.o"/> sui fuerit, quicunque ab eo in<ptr type="liebermannNote" n="p" target="#Hn_43-7.lnote.oe.p"/> obuiacione hostili uel bello campali fugerit, uel uictus erit<ptr type="liebermannNote" n="pp" target="#Hn_43-7.lnote.oe.pp"/> uel feloniam<ptr type="liebermannNote" n="q" target="#Hn_43-7.lnote.oe.q"/><ptr type="liebermannNote" n="27" target="#Hn_43-7.lnote.oe.27"/> fecerit, terram suam forisfecerit<ptr type="liebermannNote" n="28" target="#Hn_43-7.lnote.oe.28"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 569 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-7.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">anderes Recht als</hi> VI As. 1, 1</seg><seg type="translation" xml:lang="en" source="#claude">a different law from VI As. 1, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-7.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Af. 4, 2; II Cn. 57, <hi rend="italic">dem u.</hi> 75, 2 <hi rend="italic">folgt</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. Af. 4, 2; II Cn. 57, which is followed below in 75, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-7.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie oben</hi> 13, 12</seg><seg type="translation" xml:lang="en" source="#claude">as above 13, 12</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-7.lnote.oe.pp" n="pp" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">sc.</hi> bello <hi rend="italic">iudiciali</hi></seg><seg type="translation" xml:lang="en" source="#claude">sc. bello iudiciali</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-7.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier</hi> (<hi rend="italic">auch</hi> 46, 3) <hi rend="italic">zuerst</hi></seg><seg type="translation" xml:lang="en" source="#claude">here (also 46, 3) for the first time</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-7.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">d. sui p. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. sui p. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-7.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">felen. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">felen. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-7.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">-cit <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cit Sc Hg</seg></note>
