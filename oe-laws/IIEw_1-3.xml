      <div type="clause" n="1.3">
        <head><ref type="lawCode" target="law:IIEw">II Ew</ref> 1.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.3" corresp="#wit-h"><pb n="142" ed="#liebermann"/>Gif hit hwa dó, bete<ptr type="liebermannNote" n="1" target="#IIEw_1-3.lnote.oe.1"/> swa hit beforan awriten is: æt forman cyrre XXX scll. ⁊ æt oðran cyrre ealswa ⁊ æt þriddan<ptr type="liebermannNote" n="*" target="#IIEw_1-3.lnote.oe.star"/> mid CXX scll. ðam cyninge.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.3" corresp="#wit-b"><pb n="142" ed="#liebermann"/>Gif hit hwa do, bete<ptr type="liebermannNote" n="6" target="#IIEw_1-3.lnote.oe.6"/> swa hit beoforan awriten is: æt forman cyrre XXX scyl'<ptr type="liebermannNote" n="7" target="#IIEw_1-3.lnote.oe.7"/> ⁊ æt oðran<ptr type="liebermannNote" n="8" target="#IIEw_1-3.lnote.oe.8"/> cyrre ealswa ⁊ æt ðriddan<ptr type="liebermannNote" n="9" target="#IIEw_1-3.lnote.oe.9"/> mid CXX scyl'<ptr type="liebermannNote" n="7" target="#IIEw_1-3.lnote.oe.7"/> ðam<ptr type="liebermannNote" n="10" target="#IIEw_1-3.lnote.oe.10"/> cynge.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.3" corresp="#wit-q"><pb n="143" ed="#liebermann"/>Si quis hoc faciat, emendet sicut supra dictum est<ptr type="liebermannNote" n="4" target="#IIEw_1-3.lnote.oe.4"/>: prima uice XXX sol., secunda uice similiter, ad terciam uicem CXX sol.<ptr type="liebermannNote" n="5" target="#IIEw_1-3.lnote.oe.5"/> regi.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="§3" corresp="#wit-h"><pb n="118" ed="#attenborough"/>Gif hit hwa dó, bete<ptr type="editorNote" n="5" target="#IIEw_1-3.attnote.fn.5"/> swa hit beforan awriten is: æt forman cyrre XXX scll. ⁊ æt oðran cyrre ealswa ⁊ æt þriddan<ptr type="editorNote" n="6" target="#IIEw_1-3.attnote.fn.6"/> mid CXX scll. ðam cyninge.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="143" ed="#liebermann"/>Wenn das einer thut, büsse er, wie es zuvor<ptr type="liebermannNote" n="1" target="#IIEw_1-3.lnote.de.1"/> geschrieben steht: beim ersten Male 30 Schll. und beim zweiten Male ebenso und beim dritten mit 120 Schll. dem Könige.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If anyone does that, let him pay compensation as it is written above: the first time 30 shillings, and the second time the same, and the third time 120 shillings to the king.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="119" ed="#attenborough"/>If anyone does so he shall pay such compensation as has been already prescribed<ptr type="editorNote" n="1" target="#IIEw_1-3.attnote.n.1"/>—on the first occasion 30 shillings, on the second the same amount, and on the third 120 shillings to the king.</ab>
        <note type="comparison" source="#liebermann" n="143"><ref target="clause:IEw_2-1">I Ew 2.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. I Ew. 2, 1</note>
        <note type="comparison" source="#wormald-mel" n="288"><label>refers to</label> <ref target="clause:IEw_2-1">I Ew 2.1</ref> <quote>Yet the second code cited 'what was written before', meaning the first (n. 111: II Ew 1:3, referring to I Ew 2:1)</quote></note>
        <note type="editorial">Liebermann compares I Ew 2.1.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_1-3.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">142</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">davor</hi> (ge?) <hi rend="italic">radirt H</hi></seg><seg type="translation" xml:lang="en" source="#claude">before it (ge?) erased H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_1-3.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">142</biblScope></bibl><seg type="original" xml:lang="de">cyrre <hi rend="italic">fügt zu Ld</hi> [<hi rend="italic">wie Quadripartitus</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">cyrre added by Ld [as in Quadripartitus]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_1-3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">143</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_1-3.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">143</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt T</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_1-3.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">142</biblScope></bibl><seg type="original" xml:lang="de">gebete s. h. bef. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gebete s. h. bef. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_1-3.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">142</biblScope></bibl><seg type="original" xml:lang="de">scill. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">scill. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_1-3.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">142</biblScope></bibl><seg type="original" xml:lang="de">oþrū <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">oþrū Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_1-3.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">142</biblScope></bibl><seg type="original" xml:lang="de">cyrre <hi rend="italic">fügt zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyrre added by Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_1-3.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">142</biblScope></bibl><seg type="original" xml:lang="de">ðæm cyng <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm cyng Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEw_1-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">95</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Hier ist die bisherige Beschränkung der Rechtsweigerung-Geldstrafe auf Liegenschaftsprozess aufgehoben: ein Vorteil für den Fiskus</seg><seg type="translation" xml:lang="en" source="#claude">Here the previous restriction of the fine for refusal of justice to suits concerning land is lifted: an advantage for the treasury</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIEw_1-3.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">205</biblScope></bibl><seg type="original" xml:lang="en">Cf. I Edw. cap. 2 § 1.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIEw_1-3.attnote.fn.5" n="5" source="#attenborough"><bibl><biblScope unit="page">118</biblScope></bibl><label>bete</label><seg type="original" xml:lang="en"><hi rend="italic">gebete</hi>. Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIEw_1-3.attnote.fn.6" n="6" source="#attenborough"><bibl><biblScope unit="page">118</biblScope></bibl><label>þriddan</label><seg type="original" xml:lang="en"><hi rend="italic">þriddan cyrre</hi>. Ld. <hi rend="italic">terciam uicem</hi>. Quad.</seg></note>
      </div>
