      <div type="clause" n="15.2">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 15.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 15.2" corresp="#wit-lat"><pb n="403" ed="#liebermann"/>Petitiones nostras<ptr type="liebermannNote" n="66" target="#IudDeiI_15-2.lnote.oe.66"/> placatus intende<ptr type="liebermannNote" n="67" target="#IudDeiI_15-2.lnote.oe.67"/> et culparum omnium praeteritarum eis<ptr type="liebermannNote" n="68" target="#IudDeiI_15-2.lnote.oe.68"/> ueniam clementer attribue<ptr type="liebermannNote" n="69" target="#IudDeiI_15-2.lnote.oe.69"/>; et si culpabiles<ptr type="liebermannNote" n="70" target="#IudDeiI_15-2.lnote.oe.70"/> sunt, tua larga benedictio non eis<ptr type="liebermannNote" n="71" target="#IudDeiI_15-2.lnote.oe.71"/> ad suffragium, sed huius<ptr type="liebermannNote" n="72" target="#IudDeiI_15-2.lnote.oe.72"/> culpae<ptr type="liebermannNote" n="73" target="#IudDeiI_15-2.lnote.oe.73"/> ad insinuandam ueritatem proficiat. Amen. Quod ipse<ptr type="liebermannNote" n="74" target="#IudDeiI_15-2.lnote.oe.74"/> praestare<ptr type="liebermannNote" n="75" target="#IudDeiI_15-2.lnote.oe.75"/> dignetur, cuius<ptr type="liebermannNote" n="76" target="#IudDeiI_15-2.lnote.oe.76"/> regnum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 403 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15-2.lnote.oe.66" n="66" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">ūras <hi rend="italic">Rj;</hi> Domine <hi rend="italic">fügt zu Ch Al Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">ūras Rj; Domine added by Ch Al Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15-2.lnote.oe.67" n="67" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">-des <hi rend="italic">Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">-des Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15-2.lnote.oe.68" n="68" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">huic <hi rend="italic">Al Ma; übergeschr.</hi> ei <hi rend="italic">H;</hi> ei, <hi rend="italic">übergeschr.</hi> eis <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">huic Al Ma; ei written above H; ei, with eis written above, Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15-2.lnote.oe.69" n="69" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">tribue <hi rend="italic">Al Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">tribue Al Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15-2.lnote.oe.70" n="70" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">-lis est de hoc furto <hi rend="italic">Al Ma; übergeschr.</hi> uel -is sit <hi rend="italic">H;</hi> -lis est, <hi rend="italic">übergeschr.</hi> uel -biles sunt <hi rend="italic">Ch;</hi> -is sit <hi rend="italic">übergeschr. Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lis est de hoc furto Al Ma; uel -is sit written above H; -lis est, with uel -biles sunt written above, Ch; -is sit written above Vt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15-2.lnote.oe.71" n="71" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi> ei <hi rend="italic">H;</hi> ei, <hi rend="italic">übergeschr.</hi> eis <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei written above H; ei, with eis written above, Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15-2.lnote.oe.72" n="72" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">praesentis inquisitionis nostrae <hi rend="italic">statt</hi> h. c. <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">praesentis inquisitionis nostrae instead of h. c. Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15-2.lnote.oe.73" n="73" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">nobis <hi rend="italic">fügt zu Al Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">nobis added by Al Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15-2.lnote.oe.74" n="74" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15-2.lnote.oe.75" n="75" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">p. d. c. r. <hi rend="italic">fehlt Ch Ci H Vt;</hi> d. c. r. <hi rend="italic">fehlt Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. d. c. r. lacking in Ch Ci H Vt; d. c. r. lacking in Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15-2.lnote.oe.76" n="76" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">c. r. <hi rend="italic">fehlt Rj, wo</hi> Amen; qui cum Patre et Spiritu uiuit et regnat per omnia saecula saeculorum. Amen <hi rend="italic">Al Ma, wo</hi> c. r. <hi rend="italic">fehlt</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. r. lacking in Rj, where Amen; qui cum Patre et Spiritu uiuit et regnat per omnia saecula saeculorum. Amen Al Ma, where c. r. is lacking</seg></note>
      </div>
    </body>
