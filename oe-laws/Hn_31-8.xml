      <div type="clause" n="31.8">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 31.8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 31.8" corresp="#wit-lat"><pb n="564" ed="#liebermann"/>In quibusdam<ptr type="liebermannNote" n="14" target="#Hn_31-8.lnote.oe.14"/> locis utrimque<ptr type="liebermannNote" n="15" target="#Hn_31-8.lnote.oe.15"/> eligitur<ptr type="liebermannNote" n="l" target="#Hn_31-8.lnote.oe.l"/> iudicium, medietas ab eis<ptr type="liebermannNote" n="16" target="#Hn_31-8.lnote.oe.16"/> quorum est negocium, et ibi testes nominati et electi sunt habendi, nisi odium uel aliquid<ptr type="liebermannNote" n="17" target="#Hn_31-8.lnote.oe.17"/> competens in<ptr type="liebermannNote" n="18" target="#Hn_31-8.lnote.oe.18"/> nominacione proponatur<ptr type="liebermannNote" n="19" target="#Hn_31-8.lnote.oe.19"/>, cur haberi non possint<ptr type="liebermannNote" n="20" target="#Hn_31-8.lnote.oe.20"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 564 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-8.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">wird das Urtheilfindercolleg [<hi rend="italic">vgl.</hi> 31, 8<hi rend="italic">a; nicht Eideshilfe!</hi>] je zur Hälfte von jeder Partei erwählt; und dort sind die Eideshelfer (<hi rend="italic">auch so zu nehmen: halb vom Gegner des Schwörenden oder dem Gericht</hi>) ernannte und (<hi rend="italic">halb vom Schwörenden</hi>) erwählte, ausser wenn (dieser) bei jener Ernennung Hass oder zureichenden Grund anführt, dass man diese (Ernannten) nicht nehmen könne</seg><seg type="translation" xml:lang="en" source="#claude">the panel of judgment-finders [<hi rend="italic">cf.</hi> 31, 8<hi rend="italic">a; not compurgation!</hi>] is chosen half by each party; and there the oath-helpers (<hi rend="italic">also to be understood thus: half by the opponent of the man swearing, or by the court</hi>) are nominated and (<hi rend="italic">half by the man swearing</hi>) chosen, unless (the latter) alleges hatred, or sufficient reason, against that nomination why these (nominees) cannot be taken</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-8.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">quibus <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">quibus <hi rend="italic">Sc Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-8.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">utrumque <hi rend="italic">Lond Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">utrumque <hi rend="italic">Lond Edd.</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-8.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius <hi rend="italic">K Co</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-8.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">c. a. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. a. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-8.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. vom Corr. aus</hi> innouac. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">corrected by the corrector from</hi> innouac. <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-8.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">prep. <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">prep. <hi rend="italic">K Co</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-8.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">-sunt <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sunt <hi rend="italic">Sc Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-8.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Auswahleid 16. Hälftig (<hi rend="italic">s. Gl</hi> Lagamen 2) zu ernennende Urteiler zeigt das Nord. <hi rend="italic">skiladomr</hi>; Amira{3} 160.—{16}<hi rend="italic">eius</hi>—<hi rend="italic">co. al</hi>.{17}—32 <hi rend="italic">Ne quis</hi>{27} <hi rend="italic">i</hi>. Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Auswahleid 16. Judgment-finders to be appointed half by each side (<hi rend="italic">see Gl</hi> Lagamen 2) are found in the Norse <hi rend="italic">skiladomr</hi>; Amira{3} 160.—{16}<hi rend="italic">eius</hi>—<hi rend="italic">co. al</hi>.{17}—32 <hi rend="italic">Ne quis</hi>{27} <hi rend="italic">i</hi>. Rs</seg></note>
      </div>
