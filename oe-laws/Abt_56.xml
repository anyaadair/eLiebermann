    <body>
      <div type="clause" n="56">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 56</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-h"><seg type="part" corresp="#part-a"><pb n="6" ed="#liebermann"/>Æt þam lærestan wlitewamme III scillingas</seg> <seg type="part" corresp="#part-b"><pb n="6" ed="#liebermann"/>ond<ptr type="liebermannNote" n="2" target="#Abt_56-b.lnote.oe.2"/> æt þam maran VI scill'.</seg></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-h"><seg type="part" corresp="#part-a"><pb n="10" ed="#attenborough"/>Æt þam lærestan wlitewamme III scillingas</seg> <seg type="part" corresp="#part-b"><pb n="10" ed="#attenborough"/>ond<ptr type="editorNote" n="2" target="#Abt_56-b.attnote.fn.2"/> æt þam maran VI scill'.</seg></ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" corresp="#wit-h" n="60–60.1"><seg type="part" n="60" corresp="#part-a"><pb n="72" ed="#oliver"/>Æt þam lærestan wlitewamme, III scillingas.</seg> <seg type="part" n="60.1" corresp="#part-b"><pb n="72" ed="#oliver"/>And<ptr type="editorNote" n="c" target="#Abt_56-b.olinote.fn.c"/> æt þam maran, VI sciƚƚ.</seg></ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><seg type="part" corresp="#part-a"><pb n="6" ed="#liebermann"/>Bei der kleinsten<ptr type="liebermannNote" n="1" target="#Abt_56-a.lnote.de.1"/> Verunstaltung<ptr type="liebermannNote" n="2" target="#Abt_56-a.lnote.de.2"/> des Aussehens [büsse der Verletzer] 3 Schilling</seg> <seg type="part" corresp="#part-b"><pb n="6" ed="#liebermann"/>und<ptr type="liebermannNote" n="3" target="#Abt_56-b.lnote.de.3"/> bei der grösseren 6 Schill.</seg></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman"><seg type="part" corresp="#part-a">For the slightest disfigurement of the appearance [let the one who caused the injury pay] 3 shillings</seg> <seg type="part" corresp="#part-b">and for the greater, 6 shillings.</seg></ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><seg type="part" corresp="#part-a"><pb n="11" ed="#attenborough"/>For the slightest disfigurement, 3 shillings,</seg> <seg type="part" corresp="#part-b"><pb n="11" ed="#attenborough"/>and for a greater 6 shillings [shall be paid as compensation].</seg></ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h"><seg type="part" corresp="#part-a"><pb n="73" ed="#oliver"/>For the least disfigurement of the appearance, 3 shillings.</seg> <seg type="part" corresp="#part-b"><pb n="73" ed="#oliver"/>And for the greater, 6 shillings.</seg></ab>
        <note type="concordance"><seg type="edition">Oliver 60, 60.1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_56-a.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">12</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Durch Friesisch <hi rend="italic">lerest</hi> als archaisch gerechtfertigt; <hi rend="italic">vgl.</hi> L. Tobler in <hi rend="italic">Zs. vergl. Sprachfo.</hi> IX 269; Sievers aaO. (Einl. 2)</seg><seg type="translation" xml:lang="en" source="#claude">Justified as archaic by Frisian <hi rend="italic">lerest</hi>; <hi rend="italic">cf.</hi> L. Tobler in <hi rend="italic">Zs. vergl. Sprachfo.</hi> IX 269; Sievers loc. cit. (Introd. 2)</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_56-a.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">12</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Antlitz; so eng übersetzen Frühere, geleitet von <hi rend="italic">Lex Frision. Add.</hi> IIIa 16: <hi rend="italic">deformitas faciei,</hi> wo aber <hi rend="italic">facies</hi> weiter ‘äussere Gestalt’ bedeuten kann. Bei Wilda 746f. ist die Nordische Verengung des Begriffs jünger. ‘Angesicht’ im besonderen heisst Ags. <hi rend="italic">andwlite</hi>, nicht (wie allerdings in anderen German. Dialekten) <hi rend="italic">wlite</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Antlitz; earlier translators render it this narrowly, guided by <hi rend="italic">Lex Frision. Add.</hi> IIIa 16: <hi rend="italic">deformitas faciei,</hi> where, however, <hi rend="italic">facies</hi> can have the broader meaning ‘outward form’. In Wilda 746f. the Norse narrowing of the concept is of later date. ‘Face’ in the specific sense is <hi rend="italic">andwlite</hi> in A.-S., not <hi rend="italic">wlite</hi> (as it admittedly is in other Germanic dialects)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Abt_56-b.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">6</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geändert in</hi> and</seg><seg type="translation" xml:lang="en" source="#claude">altered to and</seg><note type="remark" resp="#claude">One footnote serves two places on p. 6: Abt 51 and 56.</note></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_56-b.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">12</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o.</hi> 51⁴</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 51⁴</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Abt_56-b.attnote.fn.2" n="2" source="#attenborough"><bibl><biblScope unit="page">10</biblScope></bibl><seg type="original" xml:lang="en">Altered to <hi rend="italic">and</hi>.</seg><note type="remark" resp="#claude">The number 2 is printed 2 times on the page (51[d], 56[b]), with one footnote. The number stands at the beginning of the chapter.</note></note>
        <note type="editorNote" subtype="footnote" xml:id="Abt_56-b.olinote.fn.c" n="c" source="#oliver"><bibl><biblScope unit="page">72</biblScope></bibl><label>And</label><seg type="original" xml:lang="en">Changed from <hi rend="italic">ond</hi> by scribe.</seg></note>
      </div>
    </body>
