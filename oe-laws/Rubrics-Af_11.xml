    <body>
      <div type="clause" n="11">
        <head>Af Rb 11</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11" corresp="#wit-e"><pb n="16" ed="#liebermann"/>XII. Be<ptr type="liebermannNote" n="14" target="#Rubrics-Af_11.lnote.oe.14"/> cirliscre<ptr type="liebermannNote" n="15" target="#Rubrics-Af_11.lnote.oe.15"/> fæmnan onfenge.<ptr type="liebermannNote" n="16" target="#Rubrics-Af_11.lnote.oe.16"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11" corresp="#wit-ot-frag"><pb n="16" ed="#liebermann"/>… irilscre<ptr type="liebermannNote" n="1" target="#Rubrics-Af_11.lnote.oe.1"/> fæmnan onfenge.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11" corresp="#wit-g-prol"><pb n="16" ed="#liebermann"/>XII. Be cyrliscre fæmnan anfenge.<ptr type="liebermannNote" n="1" target="#Rubrics-Af_11.lnote.oe.1-2"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11" corresp="#wit-h"><pb n="17" ed="#liebermann"/>XII. Be cierliscre fæmnan onfænge.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="11" corresp="#wit-q"><pb n="17" ed="#liebermann"/>De apprehensione<ptr type="liebermannNote" n="12" target="#Rubrics-Af_11.lnote.oe.12"/> cyrliscræ feminæ.<ptr type="liebermannNote" n="13" target="#Rubrics-Af_11.lnote.oe.13"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="188" ed="#jurasinski-and-oliver"/>XII Be cirliscre fæmnan onfenge</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="188" ed="#jurasinski-and-oliver"/>Eft</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="17" ed="#liebermann"/>Vom Antasten eines gemeinfreien Mädchens.<ptr type="liebermannNote" n="1" target="#Rubrics-Af_11.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of the seizing of a common freeman’s girl.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="189" ed="#jurasinski-and-oliver"/>Concerning seizing a <hi rend="italic">ceorl</hi>-rank woman</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="189" ed="#jurasinski-and-oliver"/>Further</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_11.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_11.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">17</biblScope></bibl><seg type="original" xml:lang="de">iniuria <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">iniuria Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_11.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">17</biblScope></bibl><seg type="original" xml:lang="de">vel ingenue <hi rend="italic">fügt Hk zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">vel ingenue added by Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_11.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">diese Rb. fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">this rubric lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_11.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de">cyrl. <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyrl. So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_11.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de">-ng <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ng So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_11.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de">en- <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">en- on an erasure</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_11.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">40</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">femina</hi> im Quadr zu weit, wohl durch Gleichklang. Da Af 11, 3 von Jungferschaft spricht und von Busse an den Ehemann schweigt, meint er Unverehelichte. — Hk nimmt <hi rend="italic">ingenuae</hi> aus Af 11, 5</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">femina</hi> in Quadr is too broad, probably owing to the similarity of sound. Since Af 11, 3 speaks of virginity and says nothing of compensation to the husband, he means unmarried women. — Hk takes <hi rend="italic">ingenuae</hi> from Af 11, 5</seg></note>
      </div>
    </body>
