      <div type="clause" n="22.2">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 22.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 22.2" corresp="#wit-lat"><pb n="405" ed="#liebermann"/>Adiuro te per sanctam ecclesiam catholicam et per communionem sanctorum et per<ptr type="liebermannNote" n="31" target="#IudDeiI_22-2.lnote.oe.31"/> resurrectionem eorum, ut fias aqua exorcizata, adiurata<ptr type="liebermannNote" n="32" target="#IudDeiI_22-2.lnote.oe.32"/> et obfirmata aduersus inimicum hominis diabolum et aduersus hominem<ptr type="liebermannNote" n="33" target="#IudDeiI_22-2.lnote.oe.33"/>, qui ab eo seductus<ptr type="liebermannNote" n="34" target="#IudDeiI_22-2.lnote.oe.34"/> furtum<ptr type="liebermannNote" n="35" target="#IudDeiI_22-2.lnote.oe.35"/> hoc — uel<ptr type="liebermannNote" n="36" target="#IudDeiI_22-2.lnote.oe.36"/> homicidium aut adulterium —, unde ratio agitur, perpetrauit<ptr type="liebermannNote" n="37" target="#IudDeiI_22-2.lnote.oe.37"/>,</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 405 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-2.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ci Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Ci Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-2.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">et ad. et obfor. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">et ad. et obfor. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-2.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi> -es <hi rend="italic">Ci H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-es written above Ci H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-2.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi> -ti <hi rend="italic">Ci H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ti written above Ci H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-2.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">fu.—adult. <hi rend="italic">am Rande H</hi></seg><seg type="translation" xml:lang="en" source="#claude">fu.—adult. in the margin H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-2.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">uel—agitur <hi rend="italic">fehlt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel—agitur omitted in Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-2.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi> -uerunt <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uerunt written above Ci</seg></note>
