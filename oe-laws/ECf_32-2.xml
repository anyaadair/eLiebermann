    <body>
      <div type="clause" n="32.2">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 32.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 32.2"><pb n="654" ed="#liebermann"/>Frisones<ptr type="liebermannNote" n="30" target="#ECf_32-2.lnote.la.30"/> etiam<ptr type="liebermannNote" n="31" target="#ECf_32-2.lnote.la.31"/> et Flandrenses<ptr type="liebermannNote" n="g" target="#ECf_32-2.lnote.la.fn.g"/> comites suos<ptr type="liebermannNote" n="32" target="#ECf_32-2.lnote.la.32"/> maregraue<ptr type="liebermannNote" n="33" target="#ECf_32-2.lnote.la.33"/>, quasi maiores<ptr type="liebermannNote" n="h" target="#ECf_32-2.lnote.la.fn.h"/> uel bonos pacificos, uocant<ptr type="liebermannNote" n="1" target="#ECf_32-2.lnote.la.1"/>.</ab>
        <note type="comparison" source="#liebermann" n="654"><label>printed alongside</label> <ref target="clause:ECfRetr_32-2">ECf retr 32.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 654 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_32-2.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">Markgraf <hi rend="italic">erlischt als Titel in Flandern</hi> 1119 <hi rend="italic">und kommt in Frisland</hi> 1046—1103 <hi rend="italic">vor</hi> (<hi rend="italic">Warnkönig</hi> Flandr. RG. I 256; <hi rend="italic">Waitz</hi> Dt. Verf.-G. VII 79). <hi rend="italic">Retr. schlimmbessert, als wären</hi> Frisones et Fl. <hi rend="italic">nicht</hi> Teutonici, <hi rend="italic">und als hätten die Deutschen nicht auch</hi> Grafen</seg><seg type="translation" xml:lang="en" source="#claude">Markgraf dies out as a title in Flanders in 1119 and occurs in Frisia 1046–1103 (Warnkönig, Flandr. RG. I 256; Waitz, Dt. Verf.-G. VII 79). The Retr. makes it worse in correcting it, as if the Frisians and Flemings were not Teutonici, and as if the Germans did not also have counts</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_32-2.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verf. identificirt falsch in</hi> Markgraf, <hi rend="italic">das er in Franz. Aussprache hörte,</hi> graf <hi rend="italic">mit</hi> gerefa <hi rend="italic">und die erste Silbe mit Engl.</hi> (<hi rend="italic">oder ähnlichem Niederdeutschen</hi>) mare (maior) <hi rend="italic">oder mit</hi> mære, <hi rend="italic">welches aber eher</hi> berühmt, hehr <hi rend="italic">als</hi> gut <hi rend="italic">bedeutet</hi></seg><seg type="translation" xml:lang="en" source="#claude">in Markgraf, which he heard in French pronunciation, the author wrongly identifies graf with gerefa, and the first syllable with English (or similar Low German) mare (maior) or with mære, which however means famous, exalted rather than good</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-2.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">Frisiones <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Frisiones Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-2.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk S Ad Wo Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk S Ad Wo Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-2.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">uocant <hi rend="italic">schon hier fügt zu Hr Ad Do; hinter</hi> mer. <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hr Ad Do already add uocant here; after mer. S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-2.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">mer. <hi rend="italic">Hk S Hr;</hi> meng. <hi rend="italic">Ad Do;</hi> maragreues <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">mer. Hk S Hr; meng. Ad Do; maragreues Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-2.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
      </div>
