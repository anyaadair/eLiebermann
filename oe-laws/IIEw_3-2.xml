    <body>
      <div type="clause" n="3.2">
        <head><ref type="lawCode" target="law:IIEw">II Ew</ref> 3.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.2" corresp="#wit-h"><pb n="142" ed="#liebermann"/>Gif he naðor næbbe ne æhta ne oðerne borh, ðonne healde hine man to dome.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.2" corresp="#wit-b"><pb n="142" ed="#liebermann"/>Gif he naðor næbbe ne æhta ne oðerne borh, ðone<ptr type="liebermannNote" n="19" target="#IIEw_3-2.lnote.oe.19"/> healde hine man to dome.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3.2" corresp="#wit-q"><pb n="143" ed="#liebermann"/>Si neutrum habeat, nec pecuniam<ptr type="liebermannNote" n="10" target="#IIEw_3-2.lnote.oe.10"/> nec alium<ptr type="liebermannNote" n="11" target="#IIEw_3-2.lnote.oe.11"/> plegium, tunc seruetur ad iudicandum.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="3.2" corresp="#wit-h"><pb n="118" ed="#attenborough"/>Gif he naðor næbbe ne æhta ne oðerne borh, ðonne healde hine man to dome.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="143" ed="#liebermann"/>Wenn er keines von beiden, weder Vermögen noch sonstige Bürgschaft besitzt, dann werde er verhaftet<ptr type="liebermannNote" n="1" target="#IIEw_3-2.lnote.de.1"/> [bis] zum Gerichtsurtheil.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he has neither of the two, neither property nor other surety, then let him be held in custody [until] the court's judgment.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="119" ed="#attenborough"/>If he has neither property nor any other [means of providing] security, then he shall be kept for trial<ptr type="editorNote" n="1" target="#IIEw_3-2.attnote.n.1"/>.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_35">II Cn 35</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_3-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">143</biblScope></bibl><seg type="original" xml:lang="de">suam <hi rend="italic">fügt zu Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">suam added by Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_3-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">143</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_3-2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">142</biblScope></bibl><seg type="original" xml:lang="de">ðonne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðonne Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEw_3-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">95</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Ähnlich II As 20, 5. <hi rend="italic">Vgl. Gl</hi> Gefängnis 7</seg><seg type="translation" xml:lang="en" source="#claude">Similarly II As 20, 5. <hi rend="italic">Cf. Gl</hi> Gefängnis 7</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIEw_3-2.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">205</biblScope></bibl><seg type="original" xml:lang="en">See note to Ine, cap. 37.</seg></note>
      </div>
