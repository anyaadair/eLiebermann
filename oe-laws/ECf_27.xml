    <body>
      <div type="clause" n="27">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 27</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 27"><pb n="651" ed="#liebermann"/>(Iterum<ptr type="liebermannNote" n="1" target="#ECf_27.lnote.la.1"/> de pace regis.) Pax<ptr type="liebermannNote" n="a" target="#ECf_27.lnote.la.fn.a"/><ptr type="liebermannNote" n="a" target="#ECf_27.lnote.oe.erkl-a"/> data manu regis et<ptr type="liebermannNote" n="2" target="#ECf_27.lnote.la.2"/> VIII dierum<ptr type="liebermannNote" n="3" target="#ECf_27.lnote.la.3"/> quibus primum<ptr type="liebermannNote" n="4" target="#ECf_27.lnote.la.4"/> coronatus est et pax supradictorum<ptr type="liebermannNote" n="5" target="#ECf_27.lnote.la.5"/> festorum et<ptr type="liebermannNote" n="2" target="#ECf_27.lnote.la.2"/> pax per breue regis unam mensuram habent emendationis, et hoc<ptr type="liebermannNote" n="b" target="#ECf_27.lnote.la.fn.b"/> iudicio quod maius habetur<ptr type="liebermannNote" n="7" target="#ECf_27.lnote.la.7"/> in scyra<ptr type="liebermannNote" n="8" target="#ECf_27.lnote.la.8"/>, ubi<ptr type="liebermannNote" n="9" target="#ECf_27.lnote.la.9"/> pax fuerit fracta</ab>
        <note type="comparison" source="#liebermann" n="651"><label>printed alongside</label> <ref target="clause:ECfRetr_27">ECf retr 27</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 651 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">There is no note 6 in the ECf column of this page: Liebermann’s numbering goes from 5 to 7.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 12—12, 3. 27, 2; <hi rend="italic">mein</hi> Über Ed. Conf. <hi rend="italic">S.</hi> 113</seg><seg type="translation" xml:lang="en" source="#claude">cf. 12–12, 3. 27, 2; my Über Ed. Conf. p. 113</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">und zwar nach höchstem Bussbetrag, der am Thatort gilt</seg><seg type="translation" xml:lang="en" source="#claude">namely according to the highest amount of compensation in force at the scene of the deed</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so im Text Ad Wo;</hi> Item de p. r. <hi rend="italic">Cl;</hi> De emendando pacis infractore <hi rend="italic">Hr;</hi> Item quomodo—infringebant, <hi rend="italic">wie Retr., Pl S; fehlt Rl Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">so in the text Ad Wo; Item de p. r. Cl; De emendando pacis infractore Hr; Item quomodo—infringebant, as in the Retr., Pl S; lacking in Rl Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad</hi> (<hi rend="italic">nicht Do</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad (not Do)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">diebus <hi rend="italic">Hk S Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">diebus Hk S Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt S Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in S Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">dict. <hi rend="italic">Hr S</hi></seg><seg type="translation" xml:lang="en" source="#claude">dict. Hr S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">dicitur <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">dicitur Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">syra <hi rend="italic">Hk;</hi> scira <hi rend="italic">S;</hi> sua <hi rend="italic">Hr;</hi> shira <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">syra Hk; scira S; sua Hr; shira Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">ut si <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">ut si Ad Do</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">(Again concerning the king's peace.) The peace given by the king's hand, and that of the eight days on which he was first crowned, and the peace of the above-mentioned feasts, and the peace by the king's writ have one measure of compensation, and that by the judgment which is held the greater in the shire where the peace has been broken</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd.</hi> Handfrieden 7; Grafschaft 17. Zweite Rubrik <hi rend="italic">Quom.</hi> bis <hi rend="italic">infr.</hi> fehlt</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid.</hi> Handfrieden 7; Grafschaft 17. The second rubric <hi rend="italic">Quom.</hi> to <hi rend="italic">infr.</hi> lacking</seg></note>
      </div>
    </body>
  </text>
