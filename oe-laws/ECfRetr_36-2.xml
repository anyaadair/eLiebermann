      <div type="clause" n="36.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 36.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 36.2"><pb n="666" ed="#liebermann"/><hi rend="bold">Quod</hi>si isti decem et octo<ptr type="liebermannNote" n="32" target="#ECfRetr_36-2.lnote.la.32"/> uelint dirationari<ptr type="liebermannNote" n="33" target="#ECfRetr_36-2.lnote.la.33"/> cum illo qui <hi rend="spaced">primitus</hi> clamorem fecerat<ptr type="liebermannNote" n="34" target="#ECfRetr_36-2.lnote.la.34"/> et <hi rend="bold">qui</hi><ptr type="liebermannNote" n="35" target="#ECfRetr_36-2.lnote.la.35"/> uadimonium de<pb n="667" ed="#liebermann"/>derat, det <hi rend="bold">unus</hi>quisque eorum uadimonium<ptr type="liebermannNote" n="1" target="#ECfRetr_36-2.lnote.la.1"/> <hi rend="bold">suum</hi> cum gladio et <hi rend="bold">postea</hi> inueniat plegios tales, qui possint reddere forisfacturam, id est were<ptr type="liebermannNote" n="2" target="#ECfRetr_36-2.lnote.la.2"/> suam<ptr type="liebermannNote" n="3" target="#ECfRetr_36-2.lnote.la.3"/>, <hi rend="bold">nisi</hi> possint<ptr type="liebermannNote" n="4" target="#ECfRetr_36-2.lnote.la.4"/> dirationari<ptr type="liebermannNote" n="5" target="#ECfRetr_36-2.lnote.la.5"/> <hi rend="bold">quod dicunt.</hi> Tunc <hi rend="bold">demum</hi><ptr type="liebermannNote" n="6" target="#ECfRetr_36-2.lnote.la.6"/> interfector suum<ptr type="liebermannNote" n="7" target="#ECfRetr_36-2.lnote.la.7"/> det uadimonium et inueniat plegios<ptr type="liebermannNote" n="8" target="#ECfRetr_36-2.lnote.la.8"/>, quod iuste interfectus est<ptr type="liebermannNote" n="9" target="#ECfRetr_36-2.lnote.la.9"/> et <hi rend="bold">merito</hi> iacet inter latrones secundum legem sicut latro.</ab>
        <note type="comparison" source="#liebermann" n="666"><label>printed alongside</label> <ref target="clause:ECf_36-2">ECf 36.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 666–667 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-2.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">XVI <hi rend="italic">Va;</hi> XVIII <hi rend="italic">Hv;</hi> nouendecim <hi rend="italic">nur Hv’s Ed. Savile</hi></seg><seg type="translation" xml:lang="en" source="#claude">XVI Va; XVIII Hv; nouendecim only Hv’s editor Savile</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-2.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">-tiocinari <hi rend="italic">Cb Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tiocinari Cb Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-2.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">-rit et qui uadium dederit <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rit et qui uadium dederit Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-2.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lb Ph Db Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lb Ph Db Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-2.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">uadium <hi rend="italic">Hv;</hi> suum uadium <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">uadium Hv; suum uadium Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-2.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">werre <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">werre Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-2.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">suum <hi rend="italic">Hv Ph Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">suum Hv Ph Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-2.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">possunt <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">possunt Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-2.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">-tiocinari <hi rend="italic">Cb Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tiocinari Cb Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-2.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">deinde <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">deinde Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-2.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">det s. u. suum <hi rend="italic">Cb; fehlt Db;</hi> det s. uadium <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">det s. u. suum Cb; lacking in Db; det s. uadium Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-2.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">-ium <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ium Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-2.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">sit <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But if these eighteen wish to deraign with him who first made the complaint and who gave a gage, let each one of them give his gage with a sword and afterwards find such pledges as may be able to pay the forfeiture, that is, his wergild, unless they can deraign what they say. Then at last let the slayer give his gage and find pledges, [to show] that he was killed justly and deservedly lies among thieves according to law as a thief.</ab>
      </div>
    </body>
