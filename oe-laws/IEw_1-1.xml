      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:IEw">I Ew</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-h"><pb n="138" ed="#liebermann"/>⁊ gif hwa butan porte ceapige, ðonne sy he cyninges oferhyrnesse scyldig; ⁊ gange se team þeah forð, oð þæt man wite, hwær he oðstande.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-b"><pb n="138" ed="#liebermann"/>⁊ gyf<ptr type="liebermannNote" n="12" target="#IEw_1-1.lnote.oe.12"/> hwa butan porte ceapige, ðone<ptr type="liebermannNote" n="13" target="#IEw_1-1.lnote.oe.13"/> sy he cyniges<ptr type="liebermannNote" n="14" target="#IEw_1-1.lnote.oe.14"/> oferhyrnesse<ptr type="liebermannNote" n="9" target="#IEw_1-1.lnote.oe.9"/> scyldig; ⁊ gange se<ptr type="liebermannNote" n="15" target="#IEw_1-1.lnote.oe.15"/> team ðeah forð, oð man wite, hwær he oðstande.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.1" corresp="#wit-q"><pb n="139" ed="#liebermann"/>Quodsi quis extra portum barganniet, ouerhyrnesse regis culpa sit; et procedat tamen aduocatio, donec sciatur, in quo consistet.<ptr type="liebermannNote" n="6" target="#IEw_1-1.lnote.oe.6"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="1.1" corresp="#wit-h"><pb n="114" ed="#attenborough"/>⁊ gif hwa butan porte ceapige, ðonne<ptr type="editorNote" n="7" target="#IEw_1-1.attnote.fn.7"/> sy he cyninges oferhyrnesse scyldig; ⁊ gange se team þeah forð, oð þæt man wite, hwær he oðstande.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="139" ed="#liebermann"/>Und wenn einer ausserhalb der Stadt einkauft, dann sei er [die Summe<ptr type="liebermannNote" n="1" target="#IEw_1-1.lnote.de.1"/> für] Ungehorsam gegen den König schuldig; und es gehe der Gewährszug dennoch fort, bis (dass<ptr type="liebermannNote" n="2" target="#IEw_1-1.lnote.de.2"/>) man erkennt, wo er stehen bleibt.<ptr type="liebermannNote" n="3" target="#IEw_1-1.lnote.de.3"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if anyone buys outside a town, then let him be liable [for the sum for] disobedience to the king; and let the vouching to warranty nevertheless go on until it is known where it comes to a stop.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="115" ed="#attenborough"/>And if anyone buys outside a market town, he shall forfeit the sum due for insubordination to the king<ptr type="editorNote" n="1" target="#IEw_1-1.attnote.n.1"/>; but the production of warrantors shall nevertheless be continued, until the point is known at which they can no longer be found<ptr type="editorNote" n="2" target="#IEw_1-1.attnote.n.2"/>.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="IEw_1-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">138</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IEw_1-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">138</biblScope></bibl><seg type="original" xml:lang="de">ðonne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðonne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IEw_1-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">138</biblScope></bibl><seg type="original" xml:lang="de">cyninges <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyninges Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IEw_1-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">138</biblScope></bibl><seg type="original" xml:lang="de">-nysse <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nysse Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IEw_1-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">138</biblScope></bibl><seg type="original" xml:lang="de">seceam <hi rend="italic">B</hi></seg><seg type="translation" xml:lang="en" source="#claude">seceam B</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IEw_1-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">139</biblScope></bibl><seg type="original" xml:lang="de">-stit <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-stit Hk</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IEw_1-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">94</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">120 Schill. laut 2, 1; <hi rend="italic">vgl. Gl</hi> Ungehorsam 14</seg><seg type="translation" xml:lang="en" source="#claude">120 shill. according to 2, 1; <hi rend="italic">cf. Gl</hi> Ungehorsam 14</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IEw_1-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">94</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">þæt</hi> kann fehlen, <hi rend="italic">oð</hi> Konjunktion sein</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">þæt</hi> may be absent, and <hi rend="italic">oð</hi> may be a conjunction</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IEw_1-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">94</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Anefang 1d. 27</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Anefang 1d. 27</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IEw_1-1.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">204</biblScope></bibl><seg type="original" xml:lang="en">120 shillings (see cap. 2 § 1, below).</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IEw_1-1.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">204</biblScope></bibl><seg type="original" xml:lang="en">Lit. ‘where it comes to a standstill.’ When a man could not produce witnesses to prove his rightful possession of property, he was held guilty of theft (see II Athlr. cap. 9). Later, vouching to warranty was necessary to three removes only (see II Can. cap. 24).</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IEw_1-1.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">114</biblScope></bibl><label>ðonne</label><seg type="original" xml:lang="en"><hi rend="italic">ðone</hi>. B.</seg></note>
      </div>
    </body>
