    <body>
      <div type="clause" n="12.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 12.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 12.1"><pb n="638" ed="#liebermann"/>Illa<ptr type="liebermannNote" n="8" target="#ECf_12-1.lnote.la.8"/> autem<ptr type="liebermannNote" n="9" target="#ECf_12-1.lnote.la.9"/> pax manus<ptr type="liebermannNote" n="a" target="#ECf_12-1.lnote.oe.erkl-a"/> sue<ptr type="liebermannNote" n="10" target="#ECf_12-1.lnote.la.10"/>, dierum coronationis<ptr type="liebermannNote" n="11" target="#ECf_12-1.lnote.la.11"/> et breuis sub iudicio<ptr type="liebermannNote" n="b" target="#ECf_12-1.lnote.la.fn.b"/> unius forisfacture<ptr type="liebermannNote" n="12" target="#ECf_12-1.lnote.la.12"/> est<ptr type="liebermannNote" n="13" target="#ECf_12-1.lnote.la.13"/> (similiter<ptr type="liebermannNote" n="c" target="#ECf_12-1.lnote.la.fn.c"/> quatuor chiminorum<ptr type="liebermannNote" n="14" target="#ECf_12-1.lnote.la.14"/> et maiorum aquarum<ptr type="liebermannNote" n="15" target="#ECf_12-1.lnote.la.15"/>): de assaltu<ptr type="liebermannNote" n="e" target="#ECf_12-1.lnote.la.fn.e"/>;</ab>
        <note type="comparison" source="#liebermann" n="638"><label>printed alongside</label> <ref target="clause:ECfRetr_12-1">ECf retr 12.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 638 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-1.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> lex 12, 9; 18, 3: ‘<hi rend="italic">Strafgeld</hi>’</seg><seg type="translation" xml:lang="en" source="#claude">as lex at 12, 9; 18, 3: ‘fine’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-1.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 12, 7; 11. <hi rend="italic">Diese Parenthese und</hi> 12, 2 <hi rend="italic">scheinen Nachgedanken</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 12, 7; 11. This parenthesis and 12, 2 seem to be afterthoughts</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-1.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. u.</hi> 12, 7</seg><seg type="translation" xml:lang="en" source="#claude">see below, 12, 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-1.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">In illa <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">In illa Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-1.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">a. p. <hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. p. lacking in Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-1.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-1.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">sue <hi rend="italic">fügt zu S;</hi> orationis sue <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">S adds sue; orationis sue Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-1.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-1.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-1.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">chem. <hi rend="italic">Hk Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">chem. Hk Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-1.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad Do add et</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But that peace of his hand, of the days of the coronation and of the writ, is under the judgment of one forfeiture (likewise that of the four highways and of the greater waters): for assault;</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-1.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">345</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Strasse 11b. 12; Handfrieden 5—c; Angriff 7</seg><seg type="translation" xml:lang="en" source="#claude">Cf. Gl Strasse 11b. 12; Handfrieden 5—c; Angriff 7</seg></note>
      </div>
    </body>
