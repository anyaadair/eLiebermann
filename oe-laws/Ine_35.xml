        <note type="liebermannNote" subtype="textual" xml:id="Ine_35.lnote.oe.6-3" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">mid <hi rend="italic">fügt zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mid added by Ld</seg></note>
