      <div type="clause" n="59.24">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.24</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.24" corresp="#wit-lat"><pb n="580" ed="#liebermann"/>Si liber cum seruo furetur, <ptr type="liebermannNote" n="g" target="#Hn_59-24.lnote.oe.g"/>liber solus paciatur, quicquid euenerit dampnacionis uel redempcionis; seruus domino suo reddatur iure castigatus<ptr type="liebermannNote" n="h" target="#Hn_59-24.lnote.oe.h"/><ptr type="liebermannNote" n="12" target="#Hn_59-24.lnote.oe.12"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 580 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-24.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt</hi> 85, 4<hi rend="italic">a</hi>; <hi rend="italic">vgl.</hi> 85, 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">repeated</hi> 85, 4<hi rend="italic">a</hi>; <hi rend="italic">cf.</hi> 85, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-24.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de">castigandus <hi rend="italic">ändern WiTho</hi> [<hi rend="italic">aber vgl.</hi> 59, 23: uerberetur a repetente], <hi rend="italic">woraus Somner mit Unrecht folgert, dass</hi> domini uitae seruorum adhuc potestatem retinerent</seg><seg type="translation" xml:lang="en" source="#claude">castigandus <hi rend="italic">altered by WiTho</hi> [<hi rend="italic">but cf.</hi> 59, 23: uerberetur a repetente], <hi rend="italic">from which Somner wrongly infers that</hi> domini uitae seruorum adhuc potestatem retinerent</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-24.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de">-ationis <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ationis <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-24.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. gemeinschaftliche Missetat 3. a. 13; unfrei 16b—59, 25 <hi rend="italic">-rit</hi>{15}—59, 25b ohne <hi rend="italic">liberi</hi>{17} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. gemeinschaftliche Missetat 3. a. 13; unfrei 16b—59, 25 <hi rend="italic">-rit</hi>{15}—59, 25b without <hi rend="italic">liberi</hi>{17} Rs</seg></note>
      </div>
