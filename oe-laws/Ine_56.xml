        <note type="liebermannNote" subtype="textual" xml:id="Ine_56.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">115</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Lond; fehlt übrigen</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Lond; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_56.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">115</biblScope></bibl><seg type="original" xml:lang="de">ueniatur aliqua inf. <hi rend="italic">M</hi></seg><seg type="translation" xml:lang="en" source="#claude">ueniatur aliqua inf. M</seg></note>
