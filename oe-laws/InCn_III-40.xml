      <div type="clause" n="III 40">
        <head><ref type="lawCode" target="law:InCn">In Cn</ref> III 40</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="In Cn III 40" corresp="#wit-lat"><pb n="613" ed="#liebermann"/>Si quis alii<ptr type="liebermannNote" n="22" target="#InCn_III-40.lnote.oe.22"/> arma sua pręstiterit, et ille, cui pręstita sunt, inde hominem occiderit, ipse<ptr type="liebermannNote" n="g" target="#InCn_III-40.lnote.oe.g"/> qui arma pręstitit<ptr type="liebermannNote" n="23" target="#InCn_III-40.lnote.oe.23"/> tertiam partem pretii et forisfacturę persoluat; aut se<ptr type="liebermannNote" n="24" target="#InCn_III-40.lnote.oe.24"/> purget, quod non fuit consilium nec uoluntas eius.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 613 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-40.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verf. lässt die Vereinigung von Ver- und Entleiher zur Wergeldzahlung fort</hi></seg><seg type="translation" xml:lang="en" source="#claude">The author omits the joining of lender and borrower in the payment of the wergild</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-40.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">alicui <hi rend="italic">LbS</hi></seg><seg type="translation" xml:lang="en" source="#claude">alicui LbS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-40.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">-terit <hi rend="italic">LbS</hi></seg><seg type="translation" xml:lang="en" source="#claude">-terit LbS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-40.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">p. se <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. se Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-40.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">332</biblScope></bibl><seg type="original" xml:lang="de">Wahrscheinlich Worte des Agnorm. Gefährdeeides; <hi rend="italic">s. d. Gl</hi> 1a. 2</seg><seg type="translation" xml:lang="en" source="#claude">Probably the words of the Anglo-Norman oath of calumny; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1a. 2</seg></note>
      </div>
