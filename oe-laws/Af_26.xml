        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_26.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> mündig 5</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> mündig 5</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_26.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Q <hi rend="smallcaps">i</hi> gibt Af’s Text wörtlicher als spätere Rez.</seg><seg type="translation" xml:lang="en" source="#claude">Q <hi rend="smallcaps">i</hi> renders Af’s text more literally than later recensions</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_26.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">ihrem Vormunde</seg><seg type="translation" xml:lang="en" source="#claude">to her guardian</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_26.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Hs. So modernisiert verdeutlichend</seg><seg type="translation" xml:lang="en" source="#claude">MS So modernizes, for clarity</seg></note>
