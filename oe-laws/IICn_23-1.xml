        <note type="liebermannNote" subtype="textual" xml:id="IICn_23-1.lnote.oe.7-3" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">327</biblScope></bibl><seg type="original" xml:lang="de">ei <hi rend="italic">fügt zu Di S</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei added by Di S</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_23-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">206</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Mit den Lateinern ‘Treue gegen Gott und Herrn’ Toller s. v. <hi rend="italic">hyldu; s. Gl</hi> Gefolge 10d. e. Ich folge Thorpe, Schmid</seg><seg type="translation" xml:lang="en" source="#claude">‘Loyalty to God and lord’, in agreement with the Latin versions, Toller s. v. <hi rend="italic">hyldu; see Gl</hi> Gefolge 10d. e. I follow Thorpe, Schmid</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_23-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">206</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Cn steht näher zur Eidesformel als zu IV Eg 6, 1, der sie auch benutzt</seg><seg type="translation" xml:lang="en" source="#claude">Cn stands closer to the oath formula than to IV Eg 6, 1, which also uses it</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_23-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">355</biblScope></bibl><seg type="original" xml:lang="en">Lit. ‘that they are bearing true testimony on his behalf that he acquired it legally in accordance with what, etc.’</seg></note>
