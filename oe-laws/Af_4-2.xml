        <note type="liebermannNote" subtype="textual" xml:id="Af_4-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">50</biblScope></bibl><seg type="original" xml:lang="de">ewsie <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">ewsie on an erasure</seg></note>
