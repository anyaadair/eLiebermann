    <body>
      <div type="clause" n="67">
        <head><ref type="lawCode" target="law:Af">Af</ref> 67</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="67" corresp="#wit-e"><pb n="84" ed="#liebermann"/>Gif sio<ptr type="liebermannNote" n="19" target="#Af_67.lnote.oe.19"/> lendenbræde bið forslegen, þær sceal LX<ptr type="liebermannNote" n="20" target="#Af_67.lnote.oe.20"/> scill. to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="67" corresp="#wit-h"><pb n="84" ed="#liebermann"/>Gif seo<ptr type="liebermannNote" n="5" target="#Af_67.lnote.oe.5"/> lendenbræde<ptr type="liebermannNote" n="13" target="#Af_67.lnote.oe.13"/> bið forslægen, ðær sceal LX scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="67" corresp="#wit-b-no-prol"><pb n="84" ed="#liebermann"/>Gyf seo lendenbreda bið forslægen, þær sceal syxtig scill' to bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="67" corresp="#wit-q"><pb n="85" ed="#liebermann"/>Si lumbi truncentur alicui<ptr type="liebermannNote" n="12" target="#Af_67.lnote.oe.12"/>, LX solidorum multa iudicetur.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="90" ed="#attenborough"/>Gif sio lendenbræde<ptr type="editorNote" n="14" target="#Af_67.attnote.fn.14"/> bið forslegen, þær sceal LX scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="71" corresp="#wit-e"><pb n="360" ed="#jurasinski-and-oliver"/>Gif sio lendenbræde bið forslegen, þær sceal LX scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="85" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_67.lnote.de.1"/> die Lendenseite<ptr type="liebermannNote" n="2" target="#Af_67.lnote.de.2"/> zerschlagen ist, da gehört 60 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the loin is smashed, 60 shillings are due as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="91" ed="#attenborough"/>If the loin be maimed<ptr type="editorNote" n="1" target="#Af_67.attnote.n.1"/>, 60 shillings must be paid as compensation for it.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="361" ed="#jurasinski-and-oliver"/>If the scrotum is struck off, 60 shillings shall be compensation for that.</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="361"><label>echoes</label> <ref target="clause:Abt_64">Abt 64</ref> <quote>As did §68, these rulings echo Æthelberht §64, and are unparalled in any near-contemporary Frankish laws</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_67.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">seo lendenbreda biþ forslagen <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">seo lendenbreda biþ forslagen Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_67.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">syxtig <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">syxtig Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_67.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_67.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">æ <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">æ on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_67.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">85</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_67.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Lenden</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Lenden</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_67.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Das Kompositum ist auch sonst belegt; Toller <hi rend="italic">Dict.</hi> Das Fem. <hi rend="italic">-bræde</hi> ‘Breite’ ist in Inst. verwechselt mit dem gleichlautenden Wort, das <hi rend="italic">assatura</hi> glossiert wird. Das Kompositum ‘Lendenbraten’ aber kennt Toller nur aus Deutschland. Inst. übersetzen <hi rend="italic">assatura renum</hi> silbenhaft</seg><seg type="translation" xml:lang="en" source="#claude">The compound is attested elsewhere too; Toller <hi rend="italic">Dict.</hi> The fem. <hi rend="italic">-bræde</hi> ‘breadth’ is confused in Inst. with the homonymous word that is glossed <hi rend="italic">assatura</hi>. The compound ‘loin roast’, however, Toller knows only from Germany. Inst. translate <hi rend="italic">assatura renum</hi> syllable by syllable</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_67.attnote.fn.14" n="14" source="#attenborough"><bibl><biblScope unit="page">90</biblScope></bibl><label>lendenbræde</label><seg type="original" xml:lang="en"><hi rend="italic">lendenbreda</hi>. B.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_67.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">199</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">forslean</hi> means ‘to strike with violence, smite, break, etc.’ (see B. and T.). Liebermann translates ‘Wenn die Lendenseite zerschlagen ist etc.’ The translation given is Thorpe’s. He suggests the law refers either to the maiming of the lower false ribs, or the posterior part of the haunch-bones, or the spinous processes of the lumbar vertebrae.</seg></note>
      </div>
    </body>
