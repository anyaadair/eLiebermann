    <body>
      <div type="clause" n="59.21">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.21</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.21" corresp="#wit-lat"><pb n="580" ed="#liebermann"/>Omne autem furtum mobile uel immobile<ptr type="liebermannNote" n="a" target="#Hn_59-21.lnote.oe.a"/>, simplex aut multiplex, redimendum<ptr type="liebermannNote" n="4" target="#Hn_59-21.lnote.oe.4"/> [uel<ptr type="liebermannNote" n="5" target="#Hn_59-21.lnote.oe.5"/>] non est. Redimendorum alia menbris<ptr type="liebermannNote" n="b" target="#Hn_59-21.lnote.oe.b"/><ptr type="liebermannNote" n="6" target="#Hn_59-21.lnote.oe.6"/> alia peccunia.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 580 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-21.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">tote Fahrhabe (vgl. II Cn.</hi> 24) <hi rend="italic">im Gegensatz zu Vieh:</hi> 59, 25<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">inanimate chattels (cf. II Cn.</hi> 24) <hi rend="italic">as opposed to livestock:</hi> 59, 25<hi rend="italic">b</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-21.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de">redimere <hi rend="italic">hiess soeben noch enger: ‘mit Geld büssen’; der weitere Sinn hier</hi> ‘entgelten’ <hi rend="italic">macht den Satz zur Tautologie der vorigen Worte</hi></seg><seg type="translation" xml:lang="en" source="#claude">redimere <hi rend="italic">meant something narrower just before: ‘to pay compensation in money’; the wider sense here,</hi> ‘to pay for’, <hi rend="italic">makes the clause a tautology of the preceding words</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-21.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de">remedium <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">remedium <hi rend="italic">Co Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-21.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hss. Edd.; erfordert durch folgenden Satz und</hi> 59, 20<hi rend="italic">a</hi>; <hi rend="italic">vgl. Stilparallele</hi> 59, 22</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">missing in MSS and edd.; required by the following sentence and</hi> 59, 20<hi rend="italic">a</hi>; <hi rend="italic">cf. the stylistic parallel</hi> 59, 22</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-21.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de">p. alia m. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. alia m. <hi rend="italic">Lond</hi></seg></note>
      </div>
