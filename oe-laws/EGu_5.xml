    <body>
      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:EGu">EGu</ref> 5</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5" corresp="#wit-h"><pb n="130" ed="#liebermann"/>⁊ gif deaþscyldig<ptr type="liebermannNote" n="29" target="#EGu_5.lnote.oe.29"/> man scriftspræce gyrne, ne him<ptr type="liebermannNote" n="31" target="#EGu_5.lnote.oe.31"/> man næfre ne wyrne.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5" corresp="#wit-b"><pb n="130" ed="#liebermann"/>⁊ gyf deaðscyldig man scriftspræce gyrne, ne him man næfre.<ptr type="liebermannNote" n="3" target="#EGu_5.lnote.oe.3"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5" corresp="#wit-q"><pb n="131" ed="#liebermann"/>Et si quis reus mortis confessionem<ptr type="liebermannNote" n="26" target="#EGu_5.lnote.oe.26"/> desiderat (profiteri desideret sacerdoti), nunquam negetur ei.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="5" corresp="#wit-h"><pb n="104" ed="#attenborough"/>⁊ gif deaþscyldig man scriftspræce gyrne, ne him man næfre ne wyrne.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-h"><pb n="4" ed="#rabin-doml"/>And gif deaþscyldig man scriftspræce gyrne, ne him man næfre ne wyrne.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="131" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#EGu_5.lnote.de.1"/> wenn ein Todes schuldiger Mensch Beichte verlangt, verweigere man sie ihm niemals.<ptr type="liebermannNote" n="2" target="#EGu_5.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if a man liable to death asks for confession, let it never be refused him.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="105" ed="#attenborough"/>If a man condemned to death desires confession, it shall never be refused him.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-h"><pb n="5" ed="#rabin-doml"/>And if someone sentenced to death desires confession, it shall never be denied to him.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_44">II Cn 44</ref></note>
        <note type="textual" source="#rabin-doml">ne wyrne: omitted B</note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_5.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">131</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond;</hi> (<hi rend="italic">eingeklammertes</hi>) <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket Lond; (the bracketed words) the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_5.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">130</biblScope></bibl><seg type="original" xml:lang="de">deaþe sc. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">deaþe sc. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_5.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">130</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">forwyrne</hi> him m. næfre. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">forwyrne</hi> him m. næfre. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_5.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">130</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> ne wyrne</seg><seg type="translation" xml:lang="en" source="#claude">supply ne wyrne</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_5.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">90</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Wiederholt II Cn 44; aus Q Hn 11, 9. 66, 4; <hi rend="italic">vgl. Gl</hi> Beichte 4</seg><seg type="translation" xml:lang="en" source="#claude">Repeated in II Cn 44; from Q in Hn 11, 9. 66, 4; <hi rend="italic">cf. Gl</hi> Beichte 4</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_5.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">90</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Engl. Gerichtsprotokolle (seit Ende 12. Jhs.) drücken die gerichtliche Verfügung: ‘er werde hingerichtet’ aus durch die Worte: ‘er bekomme einen Priester’ zur Absolution vor dem Tode</seg><seg type="translation" xml:lang="en" source="#claude">English court records (from the end of the 12th cent.) express the judicial order ‘let him be executed’ by the words ‘let him have a priest’, for absolution before death</seg></note>
      </div>
    </body>
  </text>
