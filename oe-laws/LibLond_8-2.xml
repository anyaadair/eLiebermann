      <div type="clause" n="8.2">
        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 8.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 8.2" corresp="#wit-lat"><pb n="675" ed="#liebermann"/>Et si piper<ptr type="liebermannNote" n="b" target="#LibLond_8-2.lnote.oe.b"/> uel cuminum<ptr type="liebermannNote" n="1" target="#LibLond_8-2.lnote.oe.1"/> uel gingiber<ptr type="liebermannNote" n="c" target="#LibLond_8-2.lnote.oe.c"/> uel alumen<ptr type="liebermannNote" n="d" target="#LibLond_8-2.lnote.oe.d"/> uel brasil’<ptr type="liebermannNote" n="e" target="#LibLond_8-2.lnote.oe.e"/><ptr type="liebermannNote" n="2" target="#LibLond_8-2.lnote.oe.2"/> uel lacem<ptr type="liebermannNote" n="f" target="#LibLond_8-2.lnote.oe.f"/><ptr type="liebermannNote" n="3" target="#LibLond_8-2.lnote.oe.3"/> uel thus attulerit, non minus quam XXV<ptr type="liebermannNote" n="4" target="#LibLond_8-2.lnote.oe.4"/> libr.<ptr type="liebermannNote" n="g" target="#LibLond_8-2.lnote.oe.g"/> simul uendat<ptr type="liebermannNote" n="h" target="#LibLond_8-2.lnote.oe.h"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 675 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-2.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">il poent vendre quartrun de peivre, quartrun de cire, quartrun de cummin; Lei as Loorengs 502</seg><seg type="translation" xml:lang="en" source="#claude">il poent vendre quartrun de peivre, quartrun de cire, quartrun de cummin; Lei as Loorengs 502</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-2.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">Ingwer</seg><seg type="translation" xml:lang="en" source="#claude">Ginger</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-2.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Alaun diente als Beize beim Färben</hi> (<hi rend="italic">Kemble</hi> Brit. rev. 76) <hi rend="italic">und Weissgerben; Ropp</hi> Hans. Geschichtsbl. 1900 (1901) <hi rend="italic">S.</hi> 121; <hi rend="italic">Redstone</hi> Transa. Histor. soc., N. S. XVI <hi rend="italic">p.</hi> 197</seg><seg type="translation" xml:lang="en" source="#claude">Alum served as a mordant in dyeing (Kemble Brit. rev. 76) and in tawing; Ropp Hans. Geschichtsbl. 1900 (1901) p. 121; Redstone Transa. Histor. soc., N. S. XVI p. 197</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-2.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">Roth-Färbholz; <hi rend="italic">vgl. Ducange</hi> brezellum; <hi rend="italic">mengl.</hi> brasil; <hi rend="italic">Littré s. v.</hi> bresil; <hi rend="italic">Riley</hi> Munim. Gildh. Lond. III 298</seg><seg type="translation" xml:lang="en" source="#claude">Red dye-wood; cf. Ducange brezellum; Middle Engl. brasil; Littré s. v. bresil; Riley Munim. Gildh. Lond. III 298</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-2.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">‘<hi rend="italic">Lack, Gummilack, Harz, durch die Schildlaus aus Bäumen gezogen; vgl. Heyd</hi> Levantehandel II 611’ <hi rend="italic">erklärt Höhlbaum</hi> Hans. Urkb. III <hi rend="italic">S.</hi> 382; <hi rend="italic">vgl. Ducange s. v.</hi> laca; <hi rend="italic">Littré</hi> lacque. <hi rend="italic">Statt dessen nennt</hi> cotun <hi rend="italic">Ord</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘Lac, gum-lac, resin, drawn from trees by the scale insect; cf. Heyd Levantehandel II 611’ is Höhlbaum’s explanation, Hans. Urkb. III p. 382; cf. Ducange s. v. laca; Littré lacque. Instead of this Ord names cotun</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-2.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">¹/₄ <hi rend="italic">Hundert</hi> = quarter’ 8, 5. <hi rend="italic">Auch Deutschland kennt</hi> 25 <hi rend="italic">Pfund als Maximum des Kleinhandels; vgl. Keutgen</hi> Hans. Geschichtsbl. 1901 (1902) <hi rend="italic">S.</hi> 103</seg><seg type="translation" xml:lang="en" source="#claude">¹/₄ hundred = quarter’ 8, 5. Germany too knows 25 pounds as the maximum for retail trade; cf. Keutgen Hans. Geschichtsbl. 1901 (1902) p. 103</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-2.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">et hoc liberis [<hi rend="italic">Bürgerrecht geniessenden</hi>] hominibus ciuitatis <hi rend="italic">fügt zu Douai</hi></seg><seg type="translation" xml:lang="en" source="#claude">Douai adds et hoc liberis [enjoying the freedom of the city] hominibus ciuitatis</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">cim. <hi rend="italic">S Co Alb</hi></seg><seg type="translation" xml:lang="en" source="#claude">cim. S Co Alb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so PlS;</hi> -lis <hi rend="italic">Ai;</hi> -lium <hi rend="italic">Horn Alb;</hi> brasil <hi rend="italic">Ord</hi></seg><seg type="translation" xml:lang="en" source="#claude">so PlS; -lis Ai; -lium Horn Alb; brasil Ord</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Ai Co Horn;</hi> latein <hi rend="italic">Alb;</hi> lacō <hi rend="italic">Pl;</hi> lac’o <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Ai Co Horn; latein Alb; lacō Pl; lac’o S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">XXII <hi rend="italic">Ord</hi></seg><seg type="translation" xml:lang="en" source="#claude">XXII Ord</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Pfeffer 2; Kümmel; Ingwer; Alaun; Färberei; Lack; Banmwolle [<hi rend="italic">cotonum</hi> zu a. 1380 Schulte II 108]; Weihrauch; Quarter</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Pfeffer 2; Kümmel; Ingwer; Alaun; Färberei; Lack; Banmwolle [<hi rend="italic">cotonum</hi> for the year 1380, Schulte II 108]; Weihrauch; Quarter</seg></note>
      </div>
