      <div type="clause" n="59.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.1" corresp="#wit-lat"><pb n="577" ed="#liebermann"/>Si dies placiti sit contramandatus<ptr type="liebermannNote" n="i" target="#Hn_59-1.lnote.oe.i"/>, ubi<ptr type="liebermannNote" n="20" target="#Hn_59-1.lnote.oe.20"/> residens<ptr type="liebermannNote" n="k" target="#Hn_59-1.lnote.oe.k"/> est cum quo agitur, ipsi uel familie eius<ptr type="liebermannNote" n="21" target="#Hn_59-1.lnote.oe.21"/> libere<ptr type="liebermannNote" n="22" target="#Hn_59-1.lnote.oe.22"/>: siue suscipiant siue non, nichil<ptr type="liebermannNote" n="23" target="#Hn_59-1.lnote.oe.23"/> refert, quin<ptr type="liebermannNote" n="l" target="#Hn_59-1.lnote.oe.l"/><ptr type="liebermannNote" n="24" target="#Hn_59-1.lnote.oe.24"/> contramandatus iudicetur — nisi causa sit que<ptr type="liebermannNote" n="25" target="#Hn_59-1.lnote.oe.25"/> contramandari non debeat, uel pactum<ptr type="liebermannNote" n="m" target="#Hn_59-1.lnote.oe.m"/> intercesserit, quod legem contramandacionis uicerit<ptr type="liebermannNote" n="26" target="#Hn_59-1.lnote.oe.26"/> —; causa<ptr type="liebermannNote" n="n" target="#Hn_59-1.lnote.oe.n"/> uero contramandacionis uicinaliter debet addi et alius dies competens poni cum testibus.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 577 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">abbestellt wird (= werden soll), ibi <hi rend="italic">hinzu zu denken.</hi> L’exoine est fondé sur l’état corporel de l’accusé, le contremant sur la nature de ses embarras <hi rend="italic">bemerkt hierzu Houard, der</hi> Beaumanoir c. 3 <hi rend="italic">citirt</hi></seg><seg type="translation" xml:lang="en" source="#claude">is countermanded (= is to be countermanded); ibi is to be supplied. L’exoine est fondé sur l’état corporel de l’accusé, le contremant sur la nature de ses embarras, remarks Houard on this, citing Beaumanoir c. 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. die Ladung</hi> 41, 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. the summons 41, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 59, 7: ‘es kommt nicht darauf an, so dass er nicht’, <hi rend="italic">m. a. W.:</hi> ‘jedenfalls wird es als abbestellt beurtheilt’</seg><seg type="translation" xml:lang="en" source="#claude">cf. 59, 7: ‘it does not matter, so that he does not’, in other words: ‘in any case it is judged to have been countermanded’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 49, 5<hi rend="italic">a</hi>. 59, 2<hi rend="italic">c</hi>; 4<hi rend="italic">a</hi>&lt;sup&gt;<hi rend="italic">k</hi>&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude">cf. 49, 5<hi rend="italic">a</hi>. 59, 2<hi rend="italic">c</hi>; 4<hi rend="italic">a</hi>&lt;sup&gt;<hi rend="italic">k</hi>&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 61, 7</seg><seg type="translation" xml:lang="en" source="#claude">cf. 61, 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">ubi — contramandatus <hi rend="italic">überspringt Or Gi, obwohl in K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">ubi — contramandatus skipped by Or Gi, although present in K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">sue <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">sue K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">nil <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">nil Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">quoniam <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">quoniam K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">qua <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">qua Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">uicis <hi rend="italic">K Co;</hi> uic. c. u. contr. <hi rend="italic">überspringt Or Gi, obwohl in K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">uicis K Co; uic. c. u. contr. skipped by Or Gi, although present in K Co</seg></note>
      </div>
