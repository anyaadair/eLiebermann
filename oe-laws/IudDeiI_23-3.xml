        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 23.3" corresp="#wit-lat"><pb n="405" ed="#liebermann"/>Et<ptr type="liebermannNote" n="58" target="#IudDeiI_23-3.lnote.oe.58"/> si submersi<ptr type="liebermannNote" n="59" target="#IudDeiI_23-3.lnote.oe.59"/> fuerint, inculpabiles reputentur; si supernatauerint<ptr type="liebermannNote" n="60" target="#IudDeiI_23-3.lnote.oe.60"/>, rei esse iudicentur<ptr type="liebermannNote" n="61" target="#IudDeiI_23-3.lnote.oe.61"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 405 (two independent readings of the page images, differences settled against the page)</note>
