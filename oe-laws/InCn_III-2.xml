    <body>
      <div type="clause" n="III 2">
        <head><ref type="lawCode" target="law:InCn">In Cn</ref> III 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="In Cn III 2" corresp="#wit-lat"><pb n="613" ed="#liebermann"/><hi rend="small">Latrones appellamus usque VII homines, a septem usque XXXV</hi><ptr type="liebermannNote" n="10" target="#InCn_III-2.lnote.oe.10"/><hi rend="small"> <hi rend="spaced">uocant Angli</hi> hloth</hi><ptr type="liebermannNote" n="11" target="#InCn_III-2.lnote.oe.11"/><hi rend="small">, a</hi><ptr type="liebermannNote" n="12" target="#InCn_III-2.lnote.oe.12"/><hi rend="small"> XXXV dehinc</hi><ptr type="liebermannNote" n="13" target="#InCn_III-2.lnote.oe.13"/><hi rend="small"> erit</hi><ptr type="liebermannNote" n="14" target="#InCn_III-2.lnote.oe.14"/><hi rend="small"> exercitus.</hi></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 613 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">fügt zu Lb S Ct</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod added by Lb S Ct</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">hloht <hi rend="italic">Di;</hi> hlot <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">hloht Di; hlot Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">a XXXV <hi rend="italic">fehlt Lb S Ct</hi></seg><seg type="translation" xml:lang="en" source="#claude">a XXXV missing in Lb S Ct</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">de <hi rend="italic">Ct</hi></seg><seg type="translation" xml:lang="en" source="#claude">de Ct</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">ex. erit <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">ex. erit Cb</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat"><hi rend="small">We call [them] thieves up to VII men; from seven to XXXV <hi rend="spaced">the English call [it]</hi> <hi rend="italic">hloth</hi> [band], from XXXV onward it will be an army.</hi></ab>
      </div>
    </body>
