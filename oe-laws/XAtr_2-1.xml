    <body>
      <div type="clause" n="2.1">
        <head><ref type="lawCode" target="law:XAtr">X Atr</ref> 2.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2.1" corresp="#wit-vr"><pb n="270" ed="#liebermann"/>⁊ þ<hi rend="italic">æt</hi> man frið ⁊ freondscype rihtlice healde for Gode ⁊ for worolde.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="2.1" corresp="#wit-vr"><pb n="132" ed="#robertson"/>⁊ þæt man frið ⁊ freondscype rihtlice healde for Gode ⁊ for worolde.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml"><pb n="208" ed="#rabin-doml"/>and þæt man frið and freondscype rihtlice healde for Gode and for worolde.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="270" ed="#liebermann"/>und dass man Frieden und Freundschaft rechtlich halte in Geistlichem und Weltlichem.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">and that peace and friendship be lawfully kept in spiritual and secular matters.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-vr"><pb n="133" ed="#robertson"/>And that peace and goodwill be duly maintained in matters both religious and secular.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml"><pb n="209" ed="#rabin-doml"/>and that peace and friendship be justly preserved before God and the world.</ab>
        <note type="comparison" source="#liebermann" n="270"><ref target="clause:VAtr_1-2">V Atr 1.2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 1, 2</note>
        <note type="editorial">Vr breaks off here. Liebermann compares V Atr 1.2.</note>
      </div>
    </body>
