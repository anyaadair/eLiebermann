      <div type="clause" n="13">
        <head><ref type="lawCode" target="law:QuadrArg">Quadr Arg</ref> 13</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Arg 13" corresp="#wit-lat"><pb n="533" ed="#liebermann"/>Pene dixerim, omnes gratia ueritatis<ptr type="liebermannNote" n="o" target="#QuadrArg_13.lnote.oe.o"/> exoletos, uelut eam pariter sacrilega condempnatione proscripserint et simplum<ptr type="liebermannNote" n="p" target="#QuadrArg_13.lnote.oe.p"/> fraudis exactum triplis bene meritorum exhibitionibus præferant.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 533 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_13.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">533</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Hn</hi> 6, 2: legis ueritas raro possit inueniri</seg><seg type="translation" xml:lang="en" source="#claude">cf. Hn 6, 2: legis ueritas raro possit inueniri</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_13.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">533</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Prov.</hi> 16, 8: Melius est parum cum iustitia quam multi fructus cum iniquitate</seg><seg type="translation" xml:lang="en" source="#claude">cf. Prov. 16, 8: Melius est parum cum iustitia quam multi fructus cum iniquitate</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_13.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de">{e} Lies Hn 6,4 statt 6,2</seg><seg type="translation" xml:lang="en" source="#claude">{e} Read Hn 6,4 instead of 6,2</seg></note>
