      <div type="clause" n="42.6">
        <head><ref type="lawCode" target="law:Af">Af</ref> 42.6</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42.6" corresp="#wit-e"><pb n="76" ed="#liebermann"/>Æfter þære<ptr type="liebermannNote" n="19" target="#Af_42-6.lnote.oe.19"/> ilcan wisan mon<ptr type="liebermannNote" n="20" target="#Af_42-6.lnote.oe.20"/> mot feohtan mid his geborene mæge, gif hine mon on woh onfeohteð<ptr type="liebermannNote" n="21" target="#Af_42-6.lnote.oe.21"/>, buton wið his hlaforde<ptr type="liebermannNote" n="22" target="#Af_42-6.lnote.oe.22"/>: þæt we ne liefað.<ptr type="liebermannNote" n="23" target="#Af_42-6.lnote.oe.23"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42.6" corresp="#wit-ot-frags"><pb n="76" ed="#liebermann"/>... ilcan wisan ... mæge, gif hin ... on woh on ..., ..hlaford ... ne lyfað.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42.6" corresp="#wit-h"><pb n="76" ed="#liebermann"/>Æfter ðære ilcan wisan<ptr type="liebermannNote" n="17" target="#Af_42-6.lnote.oe.17"/> mon<ptr type="liebermannNote" n="3" target="#Af_42-6.lnote.oe.3"/> mot feohtan<ptr type="liebermannNote" n="11" target="#Af_42-6.lnote.oe.11"/> mid his geborenum mæge<ptr type="liebermannNote" n="18" target="#Af_42-6.lnote.oe.18"/>, gif him mon<ptr type="liebermannNote" n="3" target="#Af_42-6.lnote.oe.3"/> on wóh onfeohteð<ptr type="liebermannNote" n="19" target="#Af_42-6.lnote.oe.19-2"/>, buton<ptr type="liebermannNote" n="3" target="#Af_42-6.lnote.oe.3"/> wið his hlaforde: ðæt we ne lyfað.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="42.6" corresp="#wit-q"><pb n="77" ed="#liebermann"/>Ad eundem modum potest homo pugnare<ptr type="liebermannNote" n="13" target="#Af_42-6.lnote.oe.13"/> cum germano cognato suo, si quis assalliat eum iniuste, preter contra dominum<ptr type="liebermannNote" n="14" target="#Af_42-6.lnote.oe.14"/>: hoc non concedimus.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="84" ed="#attenborough"/>Æfter þære ilcan wisan mon mot feohtan mid his geborene<ptr type="editorNote" n="16" target="#Af_42-6.attnote.fn.16"/> mæge, gif hine<ptr type="editorNote" n="17" target="#Af_42-6.attnote.fn.17"/> mon on woh onfeohteð, buton wið his hlaforde: þæt we ne liefað</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="45.1" corresp="#wit-e"><pb n="346" ed="#jurasinski-and-oliver"/>Æfter þære ilcan wisan mon mot feohtan mid his geborene mæge, gif hine mon on woh onfeohteð, buton wið his hlaforde: þæt we ne liefeð.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="77" ed="#liebermann"/>Nach derselben Weise darf<ptr type="liebermannNote" n="1" target="#Af_42-6.lnote.de.1"/> man bei seinem angeborenen Verwandten fechten, wenn jemand diesen unrecht angreift; ausgenommen gegen den eigenen Herrn<ptr type="liebermannNote" n="2" target="#Af_42-6.lnote.de.2"/>: letzteres erlauben wir nicht.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">In the same way one may fight on behalf of one’s kinsman by birth, if someone attacks him wrongfully; except against one’s own lord: that we do not permit.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="85" ed="#attenborough"/>In the same way a man may fight on behalf of one who is related to him by blood, if he is attacked unjustly, except it be against his lord. This we do not permit.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="416" ed="#whitelock"/>In the same way, a man may fight on behalf of his born kinsman, if he is being wrongfully attacked, except against his lord; that we do not allow.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="347" ed="#jurasinski-and-oliver"/>In the same manner a man may fight at the side of his born kin, if they are attacked wrongfully, except against his lord: that we do not allow.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-6.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">ðær yl. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðær yl. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-6.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">mot mon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mot mon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-6.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">-taþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-taþ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-6.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">-rd <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rd Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-6.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">lyf. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lyf. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-6.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">a <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">a on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-6.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-6.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-6.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">æ <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">æ on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-6.lnote.oe.19-2" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">erstes</hi> e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">first e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-6.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">77</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt R</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-6.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">77</biblScope></bibl><seg type="original" xml:lang="de">quia <hi rend="italic">fügt zu T Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">quia added by T Or</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_42-6.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">60</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">In Hn 82, 7 aus Q benutzt</seg><seg type="translation" xml:lang="en" source="#claude">Used in Hn 82, 7, from Q</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_42-6.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">60</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Gefolge 15c. d; Sippe 16f. Die Sippe geht dagegen der Vassallität vor bei diesem Pflichtenkonflikt in <hi rend="italic">Chanson de geste</hi> ‘Ren. Mont.’ bei Phillpott <hi rend="italic">Kindred</hi> 200</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Gefolge 15c. d; Sippe 16f. In the <hi rend="italic">Chanson de geste</hi> ‘Ren. Mont.’, on the other hand, the kindred takes precedence over vassalage in this conflict of duties; Phillpott <hi rend="italic">Kindred</hi> 200</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_42-6.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">84</biblScope></bibl><label>geborene</label><seg type="original" xml:lang="en"><hi rend="italic">geborenum</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_42-6.attnote.fn.17" n="17" source="#attenborough"><bibl><biblScope unit="page">84</biblScope></bibl><label>hine</label><seg type="original" xml:lang="en"><hi rend="italic">him</hi>. H.</seg></note>
      </div>
