    <body>
      <div type="clause" n="Rb XIII">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> Rb XIII</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr Rb XIII"><pb n="671" ed="#liebermann"/><ptr type="liebermannNote" n="1" target="#ECfRetr_Rb-XIII.lnote.la.1"/>De multimoda pace regis<ptr type="liebermannNote" n="2" target="#ECfRetr_Rb-XIII.lnote.la.2"/> et IIII cheminorum <hi rend="bold">siue</hi><ptr type="liebermannNote" n="3" target="#ECfRetr_Rb-XIII.lnote.la.3"/> <hi rend="bold">uiarum regalium</hi> et fluuiorum nominatorum<ptr type="liebermannNote" n="4" target="#ECfRetr_Rb-XIII.lnote.la.4"/>, quorum nauigio de diuersis locis uictualia ciuitatibus<ptr type="liebermannNote" n="5" target="#ECfRetr_Rb-XIII.lnote.la.5"/> siue burgis deferuntur.</ab>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 671 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">This is one of the chapter headings (rubrics) that a later writer, whom Liebermann calls “Rubricator II” and dates 1163–1189, made for the Retractator’s text; so the date given for ECf retr (c. 1140–59) does not apply to it. Liebermann prints them on pp. 670–672 as an appendix (Anhang) to ECf retr; they are numbered here “Rb” with his Roman numerals. He prints in small type what is taken from the text of ECf retr, so the words in bold are the Rubricator’s own.</note>
        <note type="editorial">Liebermann gives in the margin, in square brackets, the chapter of ECf retr that this heading belongs to: 12.</note>
        <note type="editorial">Liebermann puts note 1 on the numeral (“XIII<hi rend="superscript">1</hi>”); here it stands at the start of the heading.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Rb-XIII.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">671</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> XVI. De pace regis <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">only XVI. De pace regis Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Rb-XIII.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">671</biblScope></bibl><seg type="original" xml:lang="de">r. et <hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. et lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Rb-XIII.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">671</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Rb-XIII.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">671</biblScope></bibl><seg type="original" xml:lang="de">notatorum <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">notatorum Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Rb-XIII.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">671</biblScope></bibl><seg type="original" xml:lang="de">c. s. b. <hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. s. b. lacking in Hv</seg></note>
      </div>
