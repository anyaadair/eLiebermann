        <note type="liebermannNote" subtype="textual" xml:id="Ine_53-1.lnote.oe.24a" n="24a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">112</biblScope></bibl><seg type="original" xml:lang="de">ðæm yrf <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm yrf Ld</seg></note>
