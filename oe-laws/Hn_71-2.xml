      <div type="clause" n="71.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 71.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 71.2" corresp="#wit-lat"><pb n="590" ed="#liebermann"/>Si autem<ptr type="liebermannNote" n="27" target="#Hn_71-2.lnote.oe.27"/> insortiatus<ptr type="liebermannNote" n="28" target="#Hn_71-2.lnote.oe.28"/> non fuerit mortuus<ptr type="liebermannNote" n="29" target="#Hn_71-2.lnote.oe.29"/>, set cutis uariationem uel probabilem<ptr type="liebermannNote" n="30" target="#Hn_71-2.lnote.oe.30"/> corporis contrahat egritudinem, emendetur sapientum antiquis diffinicionibus<ptr type="liebermannNote" n="l" target="#Hn_71-2.lnote.oe.l"/>, sicut acciderit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 590 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-2.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verhexung halben Erfolges straft mit halbem Wergeld</hi> Lex Ribuar. 83, 2. <hi rend="italic">Vgl. Richards III. Klage</hi> 1483, <hi rend="italic">durch Jane Shore welke ihm ein Glied; Brunner</hi> DRG. II 561</seg><seg type="translation" xml:lang="en" source="#claude">Bewitchment that is only half successful is punished with half the wergild by Lex Ribuar. 83, 2. Cf. the complaint of Richard III, 1483, that through Jane Shore one of his limbs withered; Brunner DRG. II 561</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-2.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">uero <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">uero K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-2.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">insortica. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">insortica. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-2.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">modo uiuus <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">modo uiuus K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-2.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">-bacionem <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">-bacionem K Co Or Gi</seg></note>
