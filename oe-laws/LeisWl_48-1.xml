    <body>
      <div type="clause" n="48.1">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 48.1</head>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-i"><ptr type="liebermannNote" n="15" target="#LeisWl_48-1.lnote.oe.15"/><pb n="519" ed="#liebermann"/>Ne nuls ne lait sun hum[e]<ptr type="liebermannNote" n="16" target="#LeisWl_48-1.lnote.oe.16"/> de li partir<ptr type="liebermannNote" n="1" target="#LeisWl_48-1.lnote.oe.1"/>, pus que<ptr type="liebermannNote" n="17" target="#LeisWl_48-1.lnote.oe.17"/> il est reté.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="519" ed="#liebermann"/>Nec permittat quis hominem<ptr type="liebermannNote" n="1" target="#LeisWl_48-1.lnote.oe.1-2"/>, postquam rectatus est, a se recedere.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="48.1" corresp="#wit-i"><pb n="274" ed="#robertson"/>Ne nuls ne lait sun hum[e] de li partir pus que il est reté.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="519" ed="#liebermann"/>48, 1. Und Keiner lasse seinen Untergebenen von sich ziehen, nachdem derselbe angeklagt worden ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">48, 1. And let no one let his subordinate depart from him after the same has been accused.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-i"><pb n="275" ed="#robertson"/>And no-one shall let any of his men leave him after an accusation has been brought against him.</ab>
        <note type="comparison" source="#liebermann" n="519"><ref target="clause:IICn_28-1">II Cn 28.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 28, 1</note>
        <note type="editorial">Added October 2026 from Robertson pp. 274–275 (text and translation); Liebermann’s text and German translation added from Gesetze I p. 519, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_48-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">519</biblScope></bibl><seg type="original" xml:lang="de">per. <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">per. Im</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_48-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">519</biblScope></bibl><seg type="original" xml:lang="de">XLVII. <hi rend="italic">I</hi></seg><seg type="translation" xml:lang="en" source="#claude">XLVII. I</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_48-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">519</biblScope></bibl><seg type="original" xml:lang="de">hum <hi rend="italic">I</hi></seg><seg type="translation" xml:lang="en" source="#claude">hum I</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_48-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">519</biblScope></bibl><seg type="original" xml:lang="de">qui <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_48-1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">519</biblScope></bibl><seg type="original" xml:lang="de">suum <hi rend="italic">ergänzt Palgr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">suum supplied by Palgr.</seg></note>
      </div>
