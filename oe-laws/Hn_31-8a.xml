      <div type="clause" n="31.8a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 31.8a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 31.8a" corresp="#wit-lat"><pb n="564" ed="#liebermann"/>In Westsexa<ptr type="liebermannNote" n="21" target="#Hn_31-8a.lnote.oe.21"/> duo modi testium sunt: nominati<ptr type="liebermannNote" n="m" target="#Hn_31-8a.lnote.oe.m"/> et electi<ptr type="liebermannNote" n="22" target="#Hn_31-8a.lnote.oe.22"/>, electi<ptr type="liebermannNote" n="23" target="#Hn_31-8a.lnote.oe.23"/> et non nominati<ptr type="liebermannNote" n="24" target="#Hn_31-8a.lnote.oe.24"/>; iudices: constituti<ptr type="liebermannNote" n="25" target="#Hn_31-8a.lnote.oe.25"/>, aduocati.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 564 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-8a.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">(<hi rend="italic">entweder zur Hälfte vom Gegner</hi>) ernannte und (<hi rend="italic">zur Hälfte vom Schwörenden</hi>) erwählte (<hi rend="italic">Eideshelfer, oder nur</hi>) erwählte und keine ernannte; Urtheilsfinder (<hi rend="italic">giebt es hier ebenfalls zwei Arten:</hi>) feststehende, (<hi rend="italic">oder von den Parteien</hi>) zugezogene; <hi rend="italic">vgl.</hi> Quadr. Ded. 25&lt;sup&gt;i&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude">(<hi rend="italic">either half by the opponent</hi>) nominated and (<hi rend="italic">half by the man swearing</hi>) chosen (<hi rend="italic">oath-helpers, or only</hi>) chosen and none nominated; judgment-finders (<hi rend="italic">here too there are two kinds:</hi>) standing ones, (<hi rend="italic">or ones</hi>) called in (<hi rend="italic">by the parties</hi>); <hi rend="italic">cf.</hi> Quadr. Ded. 25&lt;sup&gt;i&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-8a.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">Wess. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Wess. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-8a.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt K zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">et <hi rend="italic">added by K</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-8a.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in <hi rend="italic">Co Or Gi</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-8a.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-8a.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">et <hi rend="italic">added by K Co</hi></seg></note>
      </div>
