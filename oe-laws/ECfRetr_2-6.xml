  <text>
    <body>
      <div type="clause" n="2.6">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 2.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 2.6"><pb n="629" ed="#liebermann"/><ptr type="liebermannNote" n="1" target="#ECfRetr_2-6.lnote.la.1"/>Item<ptr type="liebermannNote" n="2" target="#ECfRetr_2-6.lnote.la.2"/> in parochiis ecclesiarum<ptr type="liebermannNote" n="3" target="#ECfRetr_2-6.lnote.la.3"/>, ubi <hi rend="bold">proprii</hi><ptr type="liebermannNote" n="4" target="#ECfRetr_2-6.lnote.la.4"/> festiuitas<ptr type="liebermannNote" n="5" target="#ECfRetr_2-6.lnote.la.5"/> sancti celebratur<ptr type="liebermannNote" n="6" target="#ECfRetr_2-6.lnote.la.6"/>.</ab>
        <note type="comparison" source="#liebermann" n="629"><label>printed alongside</label> <ref target="clause:ECf_2-6">ECf 2.6</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 629 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-6.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">2, 6 <hi rend="italic">steht hinter</hi> 2, 7 <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">2, 6 stands after 2, 7 in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-6.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">etiam <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Lond adds etiam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-6.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">in quibus ded. d. obs. [<hi rend="italic">aus</hi> 2, 6a]; item in p. ec. <hi rend="italic">Co Or Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">in quibus ded. d. obs. [from 2, 6a]; item in p. ec. Co Or Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-6.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">propria <hi rend="italic">L Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">propria L Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-6.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">s. f. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. f. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-6.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Cb Sp;</hi> -bretur <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Cb Sp; -bretur the others</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Likewise in the parishes of churches where the feast of their own saint is celebrated.</ab>
      </div>
    </body>
