  <text>
    <body>
      <div type="clause" n="44">
        <head><ref type="lawCode" target="law:Northu">Northu</ref> 44</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-d"><pb n="382" ed="#liebermann"/>Gif pr<hi rend="italic">eost</hi> sinoð forbuge, g<hi rend="italic">e</hi>bete þ<hi rend="italic">æt</hi>.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-d"><pb n="310" ed="#rabin-doml"/>Gif preost sinoð forbuge, gebete þæt.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="382" ed="#liebermann"/>Wenn ein Priester die Synode zu besuchen versäumt<ptr type="liebermannNote" n="1" target="#Northu_44.lnote.de.1"/>, büsse er das.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a priest fails to attend the synod, let him atone for it.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-d"><pb n="483" ed="#whitelock"/>If a priest stays away from a synod, he is to compensate for it.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-d"><pb n="311" ed="#rabin-doml"/>If a priest fails to attend a synod, he is to atone for that.</ab>
        <note type="comparison" source="#liebermann" n="382">Can. Eg. 3f.</note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 3 f.</note>
        <note type="editorial">Liebermann compares Canons of Edgar 3 f.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Northu_44.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">224</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. 4. 6. 42</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 4. 6. 42</seg></note>
      </div>
    </body>
