      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:Duel">Duel</ref> 5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Duel 5" corresp="#wit-lat"><ptr type="liebermannNote" n="19" target="#Duel_5.lnote.oe.19"/><pb n="431" ed="#liebermann"/>Deinde curuet<ptr type="liebermannNote" n="20" target="#Duel_5.lnote.oe.20"/> genua<ptr type="liebermannNote" n="21" target="#Duel_5.lnote.oe.21"/> tenens<ptr type="liebermannNote" n="22" target="#Duel_5.lnote.oe.22"/> scutum et baculum<ptr type="liebermannNote" n="23" target="#Duel_5.lnote.oe.23"/>, sacerdote<ptr type="liebermannNote" n="24" target="#Duel_5.lnote.oe.24"/> dicente super eum<ptr type="liebermannNote" n="25" target="#Duel_5.lnote.oe.25"/> orationem<ptr type="liebermannNote" n="26" target="#Duel_5.lnote.oe.26"/> cum<ptr type="liebermannNote" n="27" target="#Duel_5.lnote.oe.27"/> ‘Dominus uobiscum’ et ‘Oremus’.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 431 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_5.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">statt</hi> 5 <hi rend="italic">nur</hi> Super accipientem <hi rend="italic">Tr; nur</hi> Benedictio super eum <hi rend="italic">Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">instead of 5 only Super accipientem Tr; only Benedictio super eum Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_5.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">-uat <hi rend="italic">Gl;</hi> c. g. <hi rend="italic">fehlt Sr; vgl. Note</hi> 23</seg><seg type="translation" xml:lang="en" source="#claude">-uat Gl; c. g. missing in Sr; cf. note 23</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_5.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">sua (coram sacerdote <hi rend="italic">Hm</hi>) <hi rend="italic">fügt zu Hm Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">sua (coram sacerdote Hm) added in Hm Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_5.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">qui b. et s. suscepturus est <hi rend="italic">Hm;</hi> pugnaturus <hi rend="italic">fügt zu Sr</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui b. et s. suscepturus est Hm; pugnaturus added in Sr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_5.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">iterum [<hi rend="italic">vgl.</hi> 1<hi rend="italic">ᵇ</hi>] genu flectat coram altari <hi rend="italic">fügt zu Sr</hi></seg><seg type="translation" xml:lang="en" source="#claude">iterum [cf. 1ᵇ] genu flectat coram altari added in Sr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_5.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">di. su. e. sa. <hi rend="italic">Sr;</hi> et sacerdos dicat <hi rend="italic">Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">di. su. e. sa. Sr; et sacerdos dicat Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_5.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">hanc <hi rend="italic">fügt zu Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">hanc added in Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_5.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">o. c. <hi rend="italic">fehlt Sr</hi></seg><seg type="translation" xml:lang="en" source="#claude">o. c. missing in Sr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_5.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">cum — Oratio <hi rend="italic">fehlt Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">cum — Oratio missing in Ym</seg></note>
      </div>
