    <body>
      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:IVAs">IV As</ref> 5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5" corresp="#wit-q"><pb n="172" ed="#liebermann"/>Et item, ne<ptr type="liebermannNote" n="a" target="#IVAs_5.lnote.oe.a"/> dominus libero<ptr type="liebermannNote" n="5" target="#IVAs_5.lnote.oe.5"/> homini hlafordsocnam<ptr type="liebermannNote" n="6" target="#IVAs_5.lnote.oe.6"/> prohibeat, qui ei<ptr type="liebermannNote" n="7" target="#IVAs_5.lnote.oe.7"/> per omnia rectum fecerit.</ab>
        <ab type="editionText" xml:lang="la" source="#attenborough" n="5" corresp="#wit-q"><pb n="148" ed="#attenborough"/>[Ne dominus libero homini ius prohibeat.] Et item, ne dominus libero homini hlafordsocnam prohibeat, qui ei per omnia rectum fecerit.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="149" ed="#attenborough"/>And further, a freeman who has acted rightly in all respects to his lord, shall not be prevented from seeking a [new] lord<ptr type="editorNote" n="1" target="#IVAs_5.attnote.n.0"/>.</ab>
        <note type="comparison" source="#liebermann" n="172"><ref target="clause:IIIAs_4">III As 4</ref> [ed.: the matching text is <ref target="clause:IIIAs_4-1">III As 4.1</ref>]</note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. III As. 4</note>
        <note type="editorial">Latin only; no German translation in Liebermann. Liebermann compares III As 4.1.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_5.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">h. l. <hi rend="italic">RMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. l. RMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_5.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">laf. <hi rend="italic">R;</hi> blaf. perh. <hi rend="italic">K;</hi> -sconam <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">laf. R; blaf. perh. K; -sconam MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_5.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">r. ei p. o. <hi rend="italic">RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. ei p. o. RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_5.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">113</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Denselben Sinn <hi rend="italic">s.</hi> V 1, 1; <hi rend="italic">vgl. Gl</hi> Freizügigkeit 4; Gefolge 26h; Herrensuche 3</seg><seg type="translation" xml:lang="en" source="#claude">For the same sense <hi rend="italic">see</hi> V 1, 1; <hi rend="italic">cf. Gl</hi> Freizügigkeit 4; Gefolge 26h; Herrensuche 3</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAs_5.attnote.n.0" n="0" source="#attenborough"><bibl><biblScope unit="page">210</biblScope></bibl><seg type="original" xml:lang="en">Cf. III As. cap. 4 § 1; V As. cap. 1 § 1.</seg></note>
      </div>
