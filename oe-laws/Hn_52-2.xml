      <div type="clause" n="52.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 52.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 52.2" corresp="#wit-lat"><ptr type="liebermannNote" n="2" target="#Hn_52-2.lnote.oe.2"/><pb n="574" ed="#liebermann"/>Clericus<ptr type="liebermannNote" n="c" target="#Hn_52-2.lnote.oe.c"/> per consilium prelati sui uadium dare debet, cum dederit<ptr type="liebermannNote" n="d" target="#Hn_52-2.lnote.oe.d"/><ptr type="liebermannNote" n="3" target="#Hn_52-2.lnote.oe.3"/> in accusatione.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 574 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_52-2.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">574</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 57, 9</seg><seg type="translation" xml:lang="en" source="#claude">cf. 57, 9</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_52-2.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">574</biblScope></bibl><seg type="original" xml:lang="de">geben muss? <hi rend="italic">oder bessere</hi> deciderit: verfällt</seg><seg type="translation" xml:lang="en" source="#claude">must give? or read deciderit: forfeits</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_52-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">574</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Initiale zu neuem Capitel Sc Lond; davor</hi> C. LIII <hi rend="italic">Lond; Überschrift von</hi> 53 <hi rend="italic">hier Sc Wh Wi; Überschrift von</hi> 52 <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">initial for a new chapter Sc Lond; before it C. LIII Lond; heading of 53 here Sc Wh Wi; heading of 52 Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_52-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">574</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Hss. Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus MSS, edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_52-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Geistliche 24a.—Die zu 53 gehörige Rb steht schon hier; Initiale <hi rend="italic">C</hi> bunt Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Geistliche 24a.—The Rb belonging to 53 already stands here; initial <hi rend="italic">C</hi> coloured Rs</seg></note>
      </div>
