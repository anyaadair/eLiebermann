      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 2" corresp="#wit-lat"><ptr type="liebermannNote" n="10" target="#LibLond_2.lnote.oe.10"/><pb n="673" ed="#liebermann"/>Sciendum item est, quod homo qui de curia sit<ptr type="liebermannNote" n="11" target="#LibLond_2.lnote.oe.11"/> regis uel baronum, in domo alicuius ciuis Lund[oniarum<ptr type="liebermannNote" n="12" target="#LibLond_2.lnote.oe.12"/>] ui<ptr type="liebermannNote" n="13" target="#LibLond_2.lnote.oe.13"/> uel liberatione<ptr type="liebermannNote" n="g" target="#LibLond_2.lnote.oe.g"/> uel consuetudine, nisi gratis hospitis, hospitari non debet<ptr type="liebermannNote" n="cc" target="#LibLond_2.lnote.oe.cc"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 673 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_2.lnote.oe.cc" n="cc" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">673</biblScope></bibl><seg type="original" xml:lang="de">darf</seg><seg type="translation" xml:lang="en" source="#claude">may</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_2.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">673</biblScope></bibl><seg type="original" xml:lang="de">per uim uel per liberationem marescalli <hi rend="italic">Freibrief von Heinrich II.</hi> 1155, <hi rend="italic">dem Ampl</hi> 712 <hi rend="italic">folgt</hi></seg><seg type="translation" xml:lang="en" source="#claude">per uim uel per liberationem marescalli charter of Henry II, 1155, followed by Ampl 712</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">673</biblScope></bibl><seg type="original" xml:lang="de">De libertate ciuium Lundoniensium (Lond. <hi rend="italic">Pl</hi>) <hi rend="italic">überschr. PlS.</hi> [<hi rend="italic">Offenbar nur, weil ein nicht nur Londoner Stück</hi> (<hi rend="italic">s. o.</hi> ECf. 39, 2{6}) <hi rend="italic">voraufgeht, wiederholt in jeder Rubrik</hi> de Lond. <hi rend="italic">ps</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">De libertate ciuium Lundoniensium (Lond. Pl) as heading PlS. [Evidently only because a piece not concerned with London alone (see above ECf. 39, 2{6}) precedes, ps repeats de Lond. in every rubric]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">673</biblScope></bibl><seg type="original" xml:lang="de">r. sit <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. sit Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">673</biblScope></bibl><seg type="original" xml:lang="de">Lond. <hi rend="italic">meist PlS Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Lond. mostly PlS Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">673</biblScope></bibl><seg type="original" xml:lang="de">III <hi rend="italic">ähnelnd S;</hi> III <hi rend="italic">Thorpe</hi> [<hi rend="italic">falsch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">something resembling III S; III Thorpe [wrong]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Gastung 3a. b; Königshof 11</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Gastung 3a. b; Königshof 11</seg></note>
      </div>
