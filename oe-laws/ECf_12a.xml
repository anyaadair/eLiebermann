  <text>
    <body>
      <div type="clause" n="12a">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 12a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 12a"><pb n="637" ed="#liebermann"/>alia die qua primum<ptr type="liebermannNote" n="11" target="#ECf_12a.lnote.la.11"/> coronatus<ptr type="liebermannNote" n="b" target="#ECf_12a.lnote.la.fn.b"/> est — ipsa habet octo<ptr type="liebermannNote" n="d" target="#ECf_12a.lnote.la.fn.d"/> dies —; in<ptr type="liebermannNote" n="12" target="#ECf_12a.lnote.la.12"/> natali<ptr type="liebermannNote" n="b" target="#ECf_12a.lnote.la.fn.b"/> Domini<ptr type="liebermannNote" n="e" target="#ECf_12a.lnote.la.fn.e"/> VIII dies et<ptr type="liebermannNote" n="13" target="#ECf_12a.lnote.la.13"/> VIII<ptr type="liebermannNote" n="14" target="#ECf_12a.lnote.la.14"/> dies pasche et VIII<ptr type="liebermannNote" n="15" target="#ECf_12a.lnote.la.15"/> pentecostes;</ab>
        <note type="comparison" source="#liebermann" n="637"><label>printed alongside</label> <ref target="clause:ECfRetr_12a">ECf retr 12a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 637 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12a.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt</hi> 27; <hi rend="italic">vgl.</hi> Hn 10, 1<hi rend="italic">h</hi></seg><seg type="translation" xml:lang="en" source="#claude">repeated at 27; cf. Hn 10, 1, note h</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12a.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">also erste Woche jeden Regierungsjahres, die bekannt war, da die Königskanzlei nach letzterem datirte. Da Verf.</hi> primum <hi rend="italic">hervorhebt, dachte er wohl noch den König dreimal jährlich, an den drei Hauptfesten, unter Krone gehend, was</hi> 1139 <hi rend="italic">für ein halbes Menschenalter aufhörte</hi></seg><seg type="translation" xml:lang="en" source="#claude">so the first week of each regnal year, which was known because the royal chancery dated by it. Since the author stresses primum, he was probably still thinking of the king wearing his crown three times a year, at the three chief feasts, which stopped in 1139 for half a generation</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12a.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ausserdem herrscht an den drei Festen Gottesfrieden laut</hi> 2</seg><seg type="translation" xml:lang="en" source="#claude">besides, the peace of God prevails at the three feasts, according to 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12a.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk;</hi> cor. est pr. <hi rend="italic">Hr Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk; cor. est pr. Hr Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12a.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">in n. D. VIII d. <hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">in n. D. VIII d. lacking in Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12a.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">in pascha similiter et in pentecoste similiter <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">in pascha similiter et in pentecoste similiter Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12a.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">d. pa. VIII dies pent. VIII dies <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. pa. VIII dies pent. VIII dies Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12a.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">dies <hi rend="italic">fügt zu S</hi></seg><seg type="translation" xml:lang="en" source="#claude">S adds dies</seg></note>
      </div>
    </body>
  </text>
