      <div type="clause" n="56.7">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 56.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 56.7" corresp="#wit-lat"><pb n="576" ed="#liebermann"/>Unicuique uero<ptr type="liebermannNote" n="3" target="#Hn_56-7.lnote.oe.3"/> licet secundum legem preposituram<ptr type="liebermannNote" n="c" target="#Hn_56-7.lnote.oe.c"/> non suscipere, custodiam non licet.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 576 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-7.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">der Mann darf den Posten des Gutsamtmanns ausschlagen, aber [bei Behinderung des Herrn] nicht den des Hüters</seg><seg type="translation" xml:lang="en" source="#claude">a man may decline the post of estate reeve, but [if the lord is prevented] not that of keeper</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-7.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">non <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">non K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-7.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Herrschaftsgut 11a; Vassallität 8a—<hi rend="italic">non</hi>{8} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Herrschaftsgut 11a; Vassallität 8a—<hi rend="italic">non</hi>{8} Rs</seg></note>
