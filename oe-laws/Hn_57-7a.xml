      <div type="clause" n="57.7a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 57.7a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 57.7a" corresp="#wit-lat"><pb n="576" ed="#liebermann"/>Considerate<ptr type="liebermannNote" n="27" target="#Hn_57-7a.lnote.oe.27"/> scilicet<ptr type="liebermannNote" n="qq" target="#Hn_57-7a.lnote.oe.qq"/> et coram testibus et racione<ptr type="liebermannNote" n="q" target="#Hn_57-7a.lnote.oe.q"/> hoc, non furore fiat, ne<ptr type="liebermannNote" n="28" target="#Hn_57-7a.lnote.oe.28"/> rieflacum<ptr type="liebermannNote" n="29" target="#Hn_57-7a.lnote.oe.29"/> reputetur et iusticia repetentis in iniusticiam<ptr type="liebermannNote" n="30" target="#Hn_57-7a.lnote.oe.30"/> conuertatur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 576 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-7a.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ebenso</hi> 82, 2<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">likewise 82, 2<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-7a.lnote.oe.qq" n="qq" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">jedoch vermeide Schein des Raubes</seg><seg type="translation" xml:lang="en" source="#claude">but let him avoid the appearance of robbery</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-7a.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">-rante <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rante Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-7a.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so K;</hi> nec <hi rend="italic">Sc Hg;</hi> uel <hi rend="italic">Co; fehlt Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus K; nec Sc Hg; uel Co; missing Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-7a.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">neffl. <hi rend="italic">K;</hi> nefflatum <hi rend="italic">Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">neffl. K; nefflatum Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-7a.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">iust. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">iust. Co</seg></note>
