    <body>
      <div type="clause" n="75.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 75.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 75.3" corresp="#wit-lat"><pb n="592" ed="#liebermann"/>Si quis hominem<ptr type="liebermannNote" n="e" target="#Hn_75-3.lnote.oe.e"/> suum sine culpa mortis occidat, parentibus eius<ptr type="liebermannNote" n="8" target="#Hn_75-3.lnote.oe.8"/>, sicut natus est, nichilominus eum reddat, quia uidelicet ad seruiendum, non ad occidendum suus<ptr type="liebermannNote" n="f" target="#Hn_75-3.lnote.oe.f"/> erat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 592 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-3.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">freien Vasallen</hi></seg><seg type="translation" xml:lang="en" source="#claude">free vassal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-3.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de">s'uus <hi rend="italic">Sc;</hi> seruus <hi rend="italic">Hg Edd., gilt Schmid als möglich laut des Sklavenwergeldes</hi> 70, 2; 4; 7. 76, 2; <hi rend="italic">allein</hi> 75, 4 <hi rend="italic">bestimmt über Sklaventödtung anders, und laut</hi> 75, 3<hi rend="italic">a ist die hier gemeinte Abhängigkeit vasallitisch</hi></seg><seg type="translation" xml:lang="en" source="#claude">s'uus Sc; seruus Hg Edd., which Schmid considers possible in view of the slave’s wergild 70, 2; 4; 7. 76, 2; but 75, 4 makes different provision for the killing of a slave, and according to 75, 3a the dependence meant here is that of a vassal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-3.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de">suis <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">suis Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-3.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">326</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Mannbusse 12a; Vassalität 21—<hi rend="italic">suis</hi>{8}—75, 3a <hi rend="italic">in capud</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Mannbusse 12a; Vassalität 21—<hi rend="italic">suis</hi>{8}—75, 3a <hi rend="italic">in capud</hi> Rs</seg></note>
      </div>
