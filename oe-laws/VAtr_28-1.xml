    <body>
      <div type="clause" n="28.1">
        <head><ref type="lawCode" target="law:VAtr">V Atr</ref> 28.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="28.1" corresp="#wit-g"><pb n="244" ed="#liebermann"/>⁊ se þe elles of fyrde gewende, beo se CXX scill' scyldig.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="28.1" corresp="#wit-g2"><pb n="244" ed="#liebermann"/>⁊ se þe elles ha<hi rend="italic">m</hi> of fyrde gewende, beo se CXX scill' scyldig.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="28.1" corresp="#wit-d"><ptr type="editorNote" n="11" target="#VAtr_28-1.robnote.fn.11"/><pb n="86" ed="#robertson"/>[⁊ se þe elles (ham)<ptr type="editorNote" n="12" target="#VAtr_28-1.robnote.fn.12"/> of fyrde gewende, beo se CXX scill' scyldig.]</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g"><pb n="154" ed="#rabin-doml"/>And se þe elles of fyrde gewende, beo se CXX scillinga scyldig.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="245" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#VAtr_28-1.lnote.de.1"/> wer von sonstiger<ptr type="liebermannNote" n="2" target="#VAtr_28-1.lnote.de.2"/> Landwehr (heimwärts<ptr type="liebermannNote" n="3" target="#VAtr_28-1.lnote.de.3"/> <hi rend="italic">G2</hi>) fortgeht, der sei 120 Schill.<ptr type="liebermannNote" n="4" target="#VAtr_28-1.lnote.de.4"/> schuldig.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And whoever otherwise leaves the army (for home, G2), let him be liable for 120 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d"><pb n="87" ed="#robertson"/>[And he who deserts any other army shall forfeit 120 shillings<ptr type="editorNote" n="1" target="#VAtr_28-1.robnote.n.1"/>.]</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-g"><pb n="451" ed="#whitelock"/>And he who otherwise deserts from the army is to forfeit 120 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g"><pb n="155" ed="#rabin-doml"/>And he who deserts any other army is to be penalized 120 shillings.</ab>
        <note type="editorial">Clause number standardised from ‘[28.1]’.</note>
        <note type="textual" source="#rabin-doml">omitted D</note>
        <note type="textual" source="#rabin-doml">elles: G2 adds ham</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_28-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">174</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Sowohl D wie VI Atr fehlt der Satz: schien beiden unabhängig die Strafe zu gering?</seg><seg type="translation" xml:lang="en" source="#claude">The sentence is missing in both D and VI Atr: did the penalty seem too light to each of them independently?</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_28-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">174</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Heer 8b</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Heer 8b</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_28-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">174</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">gewend</hi>(<hi rend="italic">on</hi>) <hi rend="italic">ham</hi>: ‘nach Hause gehen’ des Heeres Ann. Agsax. 1052</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">gewend</hi>(<hi rend="italic">on</hi>) <hi rend="italic">ham</hi>: ‘going home’ of the army Ann. Agsax. 1052</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_28-1.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">174</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘Ungehorsam’; <hi rend="italic">s. d. Gl</hi> 8</seg><seg type="translation" xml:lang="en" source="#claude">‘Disobedience’; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 8</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VAtr_28-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">330</biblScope></bibl><seg type="original" xml:lang="en">This clause is not found either in D or in VI Atr.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="VAtr_28-1.robnote.fn.11" n="11" source="#robertson"><bibl><biblScope unit="page">86</biblScope></bibl><label>⁊</label><seg type="original" xml:lang="en">G, G₂; om. D.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="VAtr_28-1.robnote.fn.12" n="12" source="#robertson"><bibl><biblScope unit="page">86</biblScope></bibl><label>ham</label><seg type="original" xml:lang="en">G₂.</seg></note>
      </div>
    </body>
