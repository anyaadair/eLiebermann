        <dictScrap type="liebermann"><hi rend="bold"><hi rend="italic">hypothetischer Satz</hi></hi> <hi rend="italic">beginnt <ref type="abbreviation" target="gram:oft"><abbr>oft</abbr></ref></hi> seþe (<ref type="lawCode" target="law:Ine">Ine</ref> 54), <hi rend="italic">und ihm folgt, <ref type="abbreviation" target="gram:hinter"><abbr>hinter</abbr></ref></hi> ⁊, <hi rend="italic">ein coordinirter, beide im Optativ, <ref type="abbreviation" target="gram:als"><abbr>als</abbr></ref> stände</hi> gif <hi rend="italic">davor</hi> <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 15; se mon seþe bocland hæbbe, and him his mægas læfden <ref type="lawCode" target="law:Af">Af</ref> 41. <hi rend="bold"><hi rend="italic">Hypothese</hi></hi> <hi rend="italic">ausgedrückt <ref type="abbreviation" target="gram:durch"><abbr>durch</abbr></ref></hi> be <hi rend="italic">‘im <ref type="abbreviation" target="gram:Fall"><abbr>Falle</abbr></ref> <ref type="abbreviation" target="gram:von"><abbr>von</abbr></ref>’, <ref type="abbreviation" target="gram:siehe"><abbr>s.</abbr></ref></hi> <ref type="entry" target="entry:be">be</ref> <hi rend="italic"><ref type="abbreviation" target="gram:Nummer"><abbr>n.</abbr></ref></hi> II 1a</dictScrap>
        <xr type="see"><ref target="entry:be">be</ref></xr>
