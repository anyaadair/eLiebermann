      <div type="clause" n="30">
        <head>Af Rb 30</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="30" corresp="#wit-e"><pb n="18" ed="#liebermann"/>XXV. Be syxhyndum men.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="30" corresp="#wit-ot-frag"><pb n="18" ed="#liebermann"/>… yxhyndum …</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="30" corresp="#wit-g-prol"><pb n="18" ed="#liebermann"/>XXV. Be syxhyndum men.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="30" corresp="#wit-h"><pb n="19" ed="#liebermann"/>XXIV. Be syxhyndum<ptr type="liebermannNote" n="10" target="#Rubrics-Af_30.lnote.oe.10"/> men.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="30" corresp="#wit-q"><pb n="19" ed="#liebermann"/>De homine VIhyndo<ptr type="liebermannNote" n="11" target="#Rubrics-Af_30.lnote.oe.11"/> (id est sexcenteno).</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="192" ed="#jurasinski-and-oliver"/>XXIIII Be twyhundu<hi rend="italic">m</hi> men æt hloþslyhte</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="192" ed="#jurasinski-and-oliver"/>Be twyhyndu<hi rend="italic">m</hi> men æt hloðslihte</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="19" ed="#liebermann"/>über einen von 600;</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">concerning one of 600;</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="193" ed="#jurasinski-and-oliver"/>Concerning a two-hundred [wergild] man slain by a band</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="193" ed="#jurasinski-and-oliver"/></ab>
        <note type="editorial">H’s rubric XXIV belongs to Af 30.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_30.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">sexhindo <hi rend="italic">T Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">sexhindo T Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_30.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">beide</hi> y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">both y’s on an erasure</seg></note>
