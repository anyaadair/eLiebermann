      <div type="clause" n="76.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 76.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 76.1a" corresp="#wit-lat"><pb n="593" ed="#liebermann"/>Et rectum est, ut homicida postquam weregildum uadiauerit, inueniat were plegios<ptr type="liebermannNote" n="9" target="#Hn_76-1a.lnote.oe.9"/>, sicut ad eam pertinebit: id est de thaino debent dari XII wereplegii<ptr type="liebermannNote" n="10" target="#Hn_76-1a.lnote.oe.10"/>, VIII de parte patris<ptr type="liebermannNote" n="11" target="#Hn_76-1a.lnote.oe.11"/> et<ptr type="liebermannNote" n="12" target="#Hn_76-1a.lnote.oe.12"/> IIII de cognacione matris.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 593 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-1a.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de">plegg. <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">plegg. Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-1a.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de">-gus, <hi rend="italic">aber</hi> s <hi rend="italic">unterpunctirt, Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gus, <hi rend="italic">but</hi> s <hi rend="italic">dotted for deletion, Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-1a.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K; and. Hd. Co</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">missing in K; another hand Co</hi></seg></note>
