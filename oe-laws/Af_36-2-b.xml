      <div type="clause" n="36.2[b]">
        <head><ref type="lawCode" target="law:Af">Af</ref> 36.2[b]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.2[b]" corresp="#wit-e"><pb n="70" ed="#liebermann"/>Gif hie<ptr type="liebermannNote" n="7" target="#Af_36-2-b.lnote.oe.7"/> sien<ptr type="liebermannNote" n="8" target="#Af_36-2-b.lnote.oe.8"/> bu<ptr type="liebermannNote" n="9" target="#Af_36-2-b.lnote.oe.9"/> gelic, ord ⁊ hindeweard<ptr type="liebermannNote" n="10" target="#Af_36-2-b.lnote.oe.10"/> sceaft, þæt sie<ptr type="liebermannNote" n="11" target="#Af_36-2-b.lnote.oe.11"/> butan pleo.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.2[b]" corresp="#wit-h"><pb n="70" ed="#liebermann"/>Gif hy<ptr type="liebermannNote" n="2" target="#Af_36-2-b.lnote.oe.2"/> syn<ptr type="liebermannNote" n="2" target="#Af_36-2-b.lnote.oe.2"/> bú gelic, ord ⁊ hindeweard sceaft, ðæt sy<ptr type="liebermannNote" n="2" target="#Af_36-2-b.lnote.oe.2"/> buton<ptr type="liebermannNote" n="1" target="#Af_36-2-b.lnote.oe.1"/> pleo.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="36.2[b]" corresp="#wit-q"><pb n="71" ed="#liebermann"/>Si equaliter ferantur acies et cuspis, sine culpa reputetur.<ptr type="liebermannNote" n="6" target="#Af_36-2-b.lnote.oe.6"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="80" ed="#attenborough"/>Gif<ptr type="editorNote" n="7" target="#Af_36-2-b.attnote.fn.7"/> hie sien bu gelic<ptr type="editorNote" n="8" target="#Af_36-2-b.attnote.fn.8"/>, ord ⁊ hindeweard sceaft, þæt sie butan pleo.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="37.3" corresp="#wit-e"><pb n="334" ed="#jurasinski-and-oliver"/>Gif hie sien bu gelic, ord ⁊ hindeweard sceaft, þæt sie butan pleo.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="71" ed="#liebermann"/>Wenn sie gleich [hoch] sind, beides<ptr type="liebermannNote" n="4" target="#Af_36-2-b.lnote.de.4"/>, Spitze und hinterer Schaft, das gelte ohne gefährliche Absicht.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If they are both equal [in height], point and rear shaft, let that count as without dangerous intent.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="81" ed="#attenborough"/>If they are both on a level, the point and the [other] end of the shaft, the man with the spear shall not be regarded as responsible for causing danger<ptr type="editorNote" n="2" target="#Af_36-2-b.attnote.n.2"/>.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="335" ed="#jurasinski-and-oliver"/>If they are equal in height, the point and the shaft in the back, that shall not be considered danger[ous intention].</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-b.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">hi <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hi Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-b.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">synd <hi rend="italic">So;</hi> syn <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">synd So; syn Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-b.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">bú <hi rend="italic">So;</hi> <hi rend="spaced">butu</hi> gelice <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">bú So; <hi rend="italic">butu</hi> gelice Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-b.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">hindw. <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hindw. So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-b.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">sy buton pleoh <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy buton pleoh Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-b.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-b.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-b.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">71</biblScope></bibl><seg type="original" xml:lang="de">sit <hi rend="italic">Hn</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit Hn</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_36-2-b.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Diese Neutra <hi rend="italic">bu</hi> und verstärkt <hi rend="italic">buta,</hi> obwohl <hi rend="italic">ord</hi> und <hi rend="italic">sceaft</hi> masc., bedeuten den Übergang zur Mittelengl. Partikel ‘sowohl — als auch’; Leas 19 in Grein <hi rend="italic">Agsä. Poesie</hi> II 142; Sievers <hi rend="italic">Gram.</hi> 324; Mätzner <hi rend="italic">Wb</hi> 191 b 4</seg><seg type="translation" xml:lang="en" source="#claude">These neuters <hi rend="italic">bu</hi> and, reinforced, <hi rend="italic">buta,</hi> although <hi rend="italic">ord</hi> and <hi rend="italic">sceaft</hi> are masc., mark the transition to the Middle English particle ‘both — and’; Leas 19 in Grein <hi rend="italic">Agsä. Poesie</hi> II 142; Sievers <hi rend="italic">Gram.</hi> 324; Mätzner <hi rend="italic">Wb</hi> 191 b 4</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_36-2-b.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>Gif</label><seg type="original" xml:lang="en"><hi rend="italic">(Ac) gyf</hi>. B*.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_36-2-b.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>gelic</label><seg type="original" xml:lang="en"><hi rend="italic">buta gelice</hi>. B.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_36-2-b.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">197</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">Butan pleo</hi>; lit. ‘without danger.’ Quadr. translates <hi rend="italic">sine culpa.</hi></seg></note>
      </div>
    </body>
  </text>
