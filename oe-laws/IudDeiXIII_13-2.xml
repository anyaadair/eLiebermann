      <div type="clause" n="13.2">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 13.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 13.2" corresp="#wit-lat"><pb n="424" ed="#liebermann"/>adiuro uos<ptr type="liebermannNote" n="6" target="#IudDeiXIII_13-2.lnote.oe.6"/> per Patrem et Filium et Spiritum sanctum, et<ptr type="liebermannNote" n="7" target="#IudDeiXIII_13-2.lnote.oe.7"/> per sanctam Trinitatem inseparabilem<ptr type="liebermannNote" n="8" target="#IudDeiXIII_13-2.lnote.oe.8"/> et per omnes<ptr type="liebermannNote" n="9" target="#IudDeiXIII_13-2.lnote.oe.9"/> angelos et archangelos et per omnes sanctos<ptr type="liebermannNote" n="10" target="#IudDeiXIII_13-2.lnote.oe.10"/> Dei et per diem tremendi iudicii et per uiginti quattuor seniores, qui cotidie Deum laudant, et per quattuor euangelistas Matheum et<ptr type="liebermannNote" n="11" target="#IudDeiXIII_13-2.lnote.oe.11"/> Marcum, Lucam et Iohannem<ptr type="liebermannNote" n="12" target="#IudDeiXIII_13-2.lnote.oe.12"/>, per duodecim apostolos<ptr type="liebermannNote" n="13" target="#IudDeiXIII_13-2.lnote.oe.13"/>, per duodecim prophetas et per omnes sanctos Dei martyres et<ptr type="liebermannNote" n="14" target="#IudDeiXIII_13-2.lnote.oe.14"/> confessores<ptr type="liebermannNote" n="15" target="#IudDeiXIII_13-2.lnote.oe.15"/>, uirgines, principatus et potestates<ptr type="liebermannNote" n="12" target="#IudDeiXIII_13-2.lnote.oe.12"/>, dominationes et uirtutes, per<ptr type="liebermannNote" n="16" target="#IudDeiXIII_13-2.lnote.oe.16"/> thronos et Cherubin et<ptr type="liebermannNote" n="17" target="#IudDeiXIII_13-2.lnote.oe.17"/> Seraphin<ptr type="liebermannNote" n="a" target="#IudDeiXIII_13-2.lnote.oe.a"/> et<ptr type="liebermannNote" n="18" target="#IudDeiXIII_13-2.lnote.oe.18"/> per tres pueros, qui cotidie ante Deum assistunt Sydrac<ptr type="liebermannNote" n="19" target="#IudDeiXIII_13-2.lnote.oe.19"/>, Misac et Abdenago<ptr type="liebermannNote" n="b" target="#IudDeiXIII_13-2.lnote.oe.b"/>, et per<ptr type="liebermannNote" n="20" target="#IudDeiXIII_13-2.lnote.oe.20"/> Mariam matrem<ptr type="liebermannNote" n="21" target="#IudDeiXIII_13-2.lnote.oe.21"/> domini nostri Iesu Christi et per cunctum<ptr type="liebermannNote" n="22" target="#IudDeiXIII_13-2.lnote.oe.22"/> populum sanctum Dei et per illud baptismum, quo<ptr type="liebermannNote" n="23" target="#IudDeiXIII_13-2.lnote.oe.23"/> te<ptr type="liebermannNote" n="24" target="#IudDeiXIII_13-2.lnote.oe.24"/> regenerauit sacerdos,</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Apoc. 5, 8; Rom. 8, 38; Dan. 3, 51</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 424 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">et per omnia celestia agmina <hi rend="italic">fügt zu Co und</hi> [secreta <hi rend="italic">statt</hi> ag.] <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">et per omnia celestia agmina added by Co and [with secreta instead of ag.] Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">et per centum quadraginta quatuor milia innocentium qui pro Christi nomine passi fuerunt <hi rend="italic">fügt zu Co und einige Hss. Zeumer’s</hi> [<hi rend="italic">vgl. Apoc.</hi> 7, 4].</seg><seg type="translation" xml:lang="en" source="#claude">et per centum quadraginta quatuor milia innocentium qui pro Christi nomine passi fuerunt added by Co and some of Zeumer’s MSS [cf. Apoc. 7, 4].</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">te <hi rend="italic">und stets Sing. Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">te, and always singular, Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Vt2;</hi> et per s. <hi rend="italic">fehlt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Vt2; et per s. omitted in Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">et per dominum nostrum Ihesum Christum <hi rend="italic">fügt zu Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">et per dominum nostrum Ihesum Christum added by Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bricht ab Zeu.</hi> 665&lt;sub&gt;15&lt;/sub&gt;</seg><seg type="translation" xml:lang="en" source="#claude">Zeu. 665&lt;sub&gt;15&lt;/sub&gt; breaks off</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">spiritus <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">spiritus Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">pro. et per d. apost. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">pro. et per d. apost. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">atque sanctas <hi rend="italic">fügt zu Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">atque sanctas added by Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">p. t. et <hi rend="italic">fehlt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. t. et omitted in Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">atque <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">atque Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">Adiuro te <hi rend="italic">statt</hi> et <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Adiuro te instead of et Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Tr adds et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">sanctam <hi rend="italic">fügt zu Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">sanctam added by Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">Dei et <hi rend="italic">fügt zu Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Dei et added by Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">ubi <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">ubi Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-2.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">uos, <hi rend="italic">darüber</hi> te <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">uos, above it te Tr</seg></note>
      </div>
    </body>
