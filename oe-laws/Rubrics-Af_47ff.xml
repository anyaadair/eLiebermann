    <body>
      <div type="clause" n="47ff">
        <head>Af Rb 47ff</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47ff" corresp="#wit-e"><pb n="20" ed="#liebermann"/>XLIII. Be monnes eagwunde ⁊ oðerra missenlicra lima.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47ff" corresp="#wit-ot-frag"><pb n="20" ed="#liebermann"/>… nnes eagwunde ⁊ oððerra missen …</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47ff" corresp="#wit-g-prol"><pb n="20" ed="#liebermann"/>XLIII. Be mannes eagwunde ⁊ oðra mislicra lima.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47ff" corresp="#wit-h"><pb n="21" ed="#liebermann"/>XLIII. Be monnes<ptr type="liebermannNote" n="2" target="#Rubrics-Af_47ff.lnote.oe.2"/> eagwunde<ptr type="liebermannNote" n="3" target="#Rubrics-Af_47ff.lnote.oe.3"/> ⁊ oðre<ptr type="liebermannNote" n="4" target="#Rubrics-Af_47ff.lnote.oe.4"/> mislicra<ptr type="liebermannNote" n="5" target="#Rubrics-Af_47ff.lnote.oe.5"/> lima.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="47ff" corresp="#wit-q"><pb n="21" ed="#liebermann"/>De oculo<ptr type="liebermannNote" n="7" target="#Rubrics-Af_47ff.lnote.oe.7"/> et multorum plagis membrorum.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="198" ed="#jurasinski-and-oliver"/>XLIII Be monnes eagwunde oðerra missenlicra lima</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="21" ed="#liebermann"/>Über Verwundung von jemandes Auge und anderen<ptr type="liebermannNote" n="1" target="#Rubrics-Af_47ff.lnote.de.1"/> verschiedenen Gliedern.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning the wounding of a person’s eye and of other various limbs.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="199" ed="#jurasinski-and-oliver"/>Concerning a person’s eye-wound and other various limbs</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_47ff.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">oculorum <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">oculorum T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_47ff.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_47ff.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> eagena wunde</seg><seg type="translation" xml:lang="en" source="#claude">altered eagena wunde</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_47ff.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">re <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">re on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_47ff.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> mistl.</seg><seg type="translation" xml:lang="en" source="#claude">altered mistl.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_47ff.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Der Gen. des Originals hängt von <hi rend="italic">wunde</hi> ab; <hi rend="italic">vgl.</hi> Wülfing <hi rend="italic">Syntax</hi> I 52</seg><seg type="translation" xml:lang="en" source="#claude">The genitive of the original depends on <hi rend="italic">wunde</hi>; <hi rend="italic">cf.</hi> Wülfing <hi rend="italic">Syntax</hi> I 52</seg></note>
      </div>
