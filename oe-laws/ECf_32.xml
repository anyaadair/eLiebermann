      <div type="clause" n="32">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 32</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 32"><pb n="654" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_32.lnote.oe.erkl-clause"/>Greue<ptr type="liebermannNote" n="aa" target="#ECf_32.lnote.la.fn.aa"/> autem<ptr type="liebermannNote" n="6" target="#ECf_32.lnote.la.6"/> nomen<ptr type="liebermannNote" n="7" target="#ECf_32.lnote.la.7"/> potestatis<ptr type="liebermannNote" n="8" target="#ECf_32.lnote.la.8"/> apud nos<ptr type="liebermannNote" n="9" target="#ECf_32.lnote.la.9"/> nichil melius uidetur<ptr type="liebermannNote" n="10" target="#ECf_32.lnote.la.10"/> esse quam prefectura; est enim multiplex<ptr type="liebermannNote" n="11" target="#ECf_32.lnote.la.11"/> nomen: greue enim dicitur de<ptr type="liebermannNote" n="6" target="#ECf_32.lnote.la.6"/> scyra<ptr type="liebermannNote" n="13" target="#ECf_32.lnote.la.13"/>, de wapentagiis<ptr type="liebermannNote" n="b" target="#ECf_32.lnote.la.fn.b"/>, de hundredis<ptr type="liebermannNote" n="b" target="#ECf_32.lnote.la.fn.b"/><ptr type="liebermannNote" n="14" target="#ECf_32.lnote.la.14"/>, de burgis<ptr type="liebermannNote" n="c" target="#ECf_32.lnote.la.fn.c"/><ptr type="liebermannNote" n="15" target="#ECf_32.lnote.la.15"/>, de uillis<ptr type="liebermannNote" n="d" target="#ECf_32.lnote.la.fn.d"/>.</ab>
        <note type="comparison" source="#liebermann" n="654"><label>printed alongside</label> <ref target="clause:ECfRetr_32">ECf retr 32</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 654 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">There is no note 12 in the ECf column of this page: Liebermann’s numbering goes from 11 to 13.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32.lnote.la.fn.aa" n="aa" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vom Angelsächs.</hi> gerefa <hi rend="italic">schwindet</hi> ge <hi rend="italic">schon um</hi> 1210 <hi rend="italic">u.</hi> 32, 3¹, <hi rend="italic">doch sind noch heute</hi> moorgrieve, fieldgrieve <hi rend="italic">Gemeindeämter; vgl. Gomme</hi> Index of munic. offices 30. 32</seg><seg type="translation" xml:lang="en" source="#claude">the ge of Anglo-Saxon gerefa disappears already around 1210 and at 32, 3¹, but moorgrieve, fieldgrieve are still parish offices today; cf. Gomme, Index of munic. offices 30. 32</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. o.</hi> 24, 2. 30, 2 <hi rend="italic">und zum Retr. o.</hi> 31, 2; <hi rend="italic">ergänze laut</hi> 31a þrihinge?</seg><seg type="translation" xml:lang="en" source="#claude">cf. above, 24, 2. 30, 2 and, for the Retr., above 31, 2; supply þrihinge, according to 31a?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">portgerefa</seg><seg type="translation" xml:lang="en" source="#claude">portgerefa</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">tungerefa, <hi rend="italic">nicht, wie Retr. meint,</hi> Dorfherr</seg><seg type="translation" xml:lang="en" source="#claude">tungerefa, not, as the Retr. thinks, the lord of the village</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">est <hi rend="italic">fügt zu Hk S;</hi> est nomen <hi rend="italic">Ad Do;</hi> n. pot. est <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hk S add est; est nomen Ad Do; n. pot. est Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">cum illis <hi rend="italic">fügt zu Ad;</hi> quod <hi rend="italic">fügt zu Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad adds cum illis; Rl adds quod</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">autem <hi rend="italic">fügt zu Hk S</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hk S add autem</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">e. u. <hi rend="italic">Hr;</hi> putatur <hi rend="italic">Ad; fehlt Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. u. Hr; putatur Ad; lacking in Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">n. m. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">n. m. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">syra <hi rend="italic">Hk;</hi> scira <hi rend="italic">S;</hi> shire <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">syra Hk; scira S; shire Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">-do <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">-do S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">ui., de bu. <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">ui., de bu. Ad Do</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Now <hi rend="italic">greue</hi>, the name of an authority among us, seems to be nothing better than <hi rend="italic">prefectura</hi> (reeveship); for it is a manifold name: for <hi rend="italic">greue</hi> is said of the shire, of wapentakes, of hundreds, of boroughs, of vills.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">348</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Vogt 1a.b.g. 5. — <hi rend="italic">De</hi><hi rend="superscript">8</hi> <hi rend="italic">greuis et aldermannis</hi> (ohne <hi rend="superscript">8</hi><hi rend="italic">Quid</hi> bis <hi rend="italic">distenditur</hi>). <hi rend="italic">G. quoque</hi><hi rend="superscript">14</hi> — <hi rend="italic">syra</hi><hi rend="superscript">17</hi> — <hi rend="italic">q.</hi><hi rend="superscript">18</hi> <hi rend="italic">etiam est et leid</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">Cf. <hi rend="italic">Gl</hi> Vogt 1a.b.g. 5. — <hi rend="italic">De</hi><hi rend="superscript">8</hi> <hi rend="italic">greuis et aldermannis</hi> (without <hi rend="superscript">8</hi><hi rend="italic">Quid</hi> to <hi rend="italic">distenditur</hi>). <hi rend="italic">G. quoque</hi><hi rend="superscript">14</hi> — <hi rend="italic">syra</hi><hi rend="superscript">17</hi> — <hi rend="italic">q.</hi><hi rend="superscript">18</hi> <hi rend="italic">etiam est et leid</hi> Rs</seg></note>
      </div>
    </body>
