        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 12.1a" corresp="#wit-lat"><pb n="558" ed="#liebermann"/>Quedam<ptr type="liebermannNote" n="a" target="#Hn_12-1a.lnote.oe.a"/> (enim<ptr type="liebermannNote" n="5" target="#Hn_12-1a.lnote.oe.5"/>) non<ptr type="liebermannNote" n="6" target="#Hn_12-1a.lnote.oe.6"/> possunt emendari, que sunt: husbreche et<ptr type="liebermannNote" n="7" target="#Hn_12-1a.lnote.oe.7"/> bernet et open þifþ<ptr type="liebermannNote" n="8" target="#Hn_12-1a.lnote.oe.8"/> et ebere morþ<ptr type="liebermannNote" n="9" target="#Hn_12-1a.lnote.oe.9"/> et hlafordsƿike<ptr type="liebermannNote" n="10" target="#Hn_12-1a.lnote.oe.10"/> et infraccio pacis<ptr type="liebermannNote" n="b" target="#Hn_12-1a.lnote.oe.b"/> ecclesie uel manus regis<ptr type="liebermannNote" n="c" target="#Hn_12-1a.lnote.oe.c"/> per homicidium.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 558 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-1a.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">giltig für Heinrich I.; Pollock and Maitland</hi> HEL. II 456. <hi rend="italic">Ferner steht</hi> III Atr. 1</seg><seg type="translation" xml:lang="en" source="#claude">valid for Henry I; Pollock and Maitland HEL. II 456. There is further III Atr. 1</seg></note>
