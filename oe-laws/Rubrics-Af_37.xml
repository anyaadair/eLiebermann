    <body>
      <div type="clause" n="37">
        <head>Af Rb 37</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="37" corresp="#wit-e"><pb n="18" ed="#liebermann"/>XXXIIII. Be boldgetale.<ptr type="liebermannNote" n="21" target="#Rubrics-Af_37.lnote.oe.21"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="37" corresp="#wit-ot-frag"><pb n="18" ed="#liebermann"/>… Be boldge:ale.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="37" corresp="#wit-g-prol"><pb n="18" ed="#liebermann"/>XXXIIII. Be boldgetale.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="37" corresp="#wit-h"><pb n="19" ed="#liebermann"/>XXXIIII. Be boldgetale.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="37" corresp="#wit-q"><pb n="19" ed="#liebermann"/>De<ptr type="liebermannNote" n="22" target="#Rubrics-Af_37.lnote.oe.22"/> edificii ratione.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="196" ed="#jurasinski-and-oliver"/>XXXIIII Be boldgetale</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="196" ed="#jurasinski-and-oliver"/>Be boldgetale</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="19" ed="#liebermann"/>Über eine Häuser-Gemeinde<ptr type="liebermannNote" n="1" target="#Rubrics-Af_37.lnote.de.1"/> [Herrschaftsdorf?].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning a community of houses [a lordship-village?].</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="197" ed="#jurasinski-and-oliver"/>About a district</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="197" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_37.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">De mutatione mansionis <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">De mutatione mansionis Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_37.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de">-tæle <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tæle So Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_37.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Bessere: ‘Über eine Provinz, Grafschaft’ (<hi rend="italic">s. d. Gl</hi> 1b). Q übersetzt ihm Unverständliches öfters silbenhaft; Q spät. Rez. nimmt den richtigen Sinn aus dem Text; dabei heisst <hi rend="italic">mansio</hi> entweder ‘Wohnung (des Ausziehenden)’ oder ‘Manor, Herrschaftsgut’; <hi rend="italic">s. d. Gl</hi></seg><seg type="translation" xml:lang="en" source="#claude">Read: ‘On a province, shire’ (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1b). Q often translates what it does not understand syllable by syllable; Q later rec. takes the correct sense from the text; here <hi rend="italic">mansio</hi> means either ‘dwelling (of the man moving away)’ or ‘manor, lordship estate’; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi></seg></note>
      </div>
