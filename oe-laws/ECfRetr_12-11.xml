    <body>
      <div type="clause" n="12.11">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 12.11</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 12.11"><pb n="639" ed="#liebermann"/>Similiter de<ptr type="liebermannNote" n="31" target="#ECfRetr_12-11.lnote.la.31"/> aquis <hi rend="bold">fiat</hi> minoribus, naues <hi rend="bold">tamen</hi><ptr type="liebermannNote" n="32" target="#ECfRetr_12-11.lnote.la.32"/> <hi rend="bold">portantibus</hi><ptr type="liebermannNote" n="33" target="#ECfRetr_12-11.lnote.la.33"/> cum eis <hi rend="bold">rebus</hi><ptr type="liebermannNote" n="34" target="#ECfRetr_12-11.lnote.la.34"/> que necessaria sunt burgis et <pb n="640" ed="#liebermann"/>ciuitatibus, <hi rend="bold">saltem</hi><ptr type="liebermannNote" n="1" target="#ECfRetr_12-11.lnote.la.1"/> ligna et <hi rend="bold">huiusmodi:</hi> cum lege minorum chiminorum sit<ptr type="liebermannNote" n="2" target="#ECfRetr_12-11.lnote.la.2"/> et emendatio eorum<ptr type="liebermannNote" n="3" target="#ECfRetr_12-11.lnote.la.3"/>.</ab>
        <note type="comparison" source="#liebermann" n="639"><label>printed alongside</label> <ref target="clause:ECf_12-11">ECf 12.11</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 639–640 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-11.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">f. de a. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. de a. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-11.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">inde <hi rend="italic">Lb Va Kn Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">inde Lb Va Kn Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-11.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">portantes ea que <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">portantes ea que Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-11.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">r. q. n. s. <hi rend="italic">fehlt Lond;</hi> retibus <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. q. n. s. lacking in Lond; retibus Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-11.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">salem <hi rend="italic">Lb Va Ra Kn Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">salem Lb Va Ra Kn Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-11.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">sunt <hi rend="italic">Cb Lb Va Kn Ph K;</hi> fit <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">sunt Cb Lb Va Kn Ph K; fit Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-11.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">so</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Let it be done likewise concerning the lesser waters, which nevertheless carry ships with the things which are necessary for boroughs and cities, at least wood and the like: let their compensation also be with the law of the lesser highways.</ab>
      </div>
    </body>
