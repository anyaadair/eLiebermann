      <div type="clause" n="9.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 9.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 9.2" corresp="#wit-lat"><pb n="555" ed="#liebermann"/>Et siue unus unum accuset aut plures, uel<ptr type="liebermannNote" n="4" target="#Hn_9-2.lnote.oe.4"/> plures unum, uel plures sint compellantes<ptr type="liebermannNote" n="5" target="#Hn_9-2.lnote.oe.5"/> et compellati, aliquando<ptr type="liebermannNote" n="6" target="#Hn_9-2.lnote.oe.6"/> statim<ptr type="liebermannNote" n="b" target="#Hn_9-2.lnote.oe.b"/><ptr type="liebermannNote" n="7" target="#Hn_9-2.lnote.oe.7"/> inculpationibus responderi oportet, aliquando competenti termino, aliquando<ptr type="liebermannNote" n="8" target="#Hn_9-2.lnote.oe.8"/> nullo.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 555 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-2.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 45, 1. 47. 49, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. 45, 1. 47. 49, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">u. p. <hi rend="italic">fehlt K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. p. omitted K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">-lentes <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lentes Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">-quem <hi rend="italic">Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-quem edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">fügt zu Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">in added Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. vom Corr. aus</hi> alii <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the corrector from alii Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">317</biblScope></bibl><seg type="original" xml:lang="de">Am Rande selbe Hd: <hi rend="italic">aut plures unum uel plures</hi> (<hi rend="italic">unum</hi> radiert) Rs</seg><seg type="translation" xml:lang="en" source="#claude">In the margin, same hand: <hi rend="italic">aut plures unum uel plures</hi> (<hi rend="italic">unum</hi> erased) Rs</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">317</biblScope></bibl><seg type="original" xml:lang="de">Vielleicht gehört Zeile 1 schon hinter 9, 1<hi rend="italic">a</hi> (d. h. ‘eines der Einteilungsprinzipien der Prozesse sei Ein- oder Mehrheit der Partei’), so dass hinter <hi rend="italic">compellati</hi> Punkt stehen und <hi rend="italic">Aliquando</hi>{6} neuen Satz beginnen sollte</seg><seg type="translation" xml:lang="en" source="#claude">Perhaps line 1 already belongs after 9, 1<hi rend="italic">a</hi> (i.e. ‘one of the principles for classifying lawsuits is whether the party is one person or several’), so that there should be a full stop after <hi rend="italic">compellati</hi> and <hi rend="italic">Aliquando</hi>{6} should begin a new sentence</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-2.lnote.oe.b-2" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">317</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Klage 18e; Rechtsgang 17a b</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Klage 18e; Rechtsgang 17a b</seg></note>
      </div>
