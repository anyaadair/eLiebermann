        <head><ref type="lawCode" target="law:QuadrArg">Quadr Arg</ref> 4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Arg 4" corresp="#wit-lat"><pb n="532–533" ed="#liebermann"/>Habitum autem est et omnium comprobatione signatum sanctum<ptr type="liebermannNote" n="15" target="#QuadrArg_4.lnote.oe.15"/> hoc et uenerabile comitium<ptr type="liebermannNote" n="m" target="#QuadrArg_4.lnote.oe.m"/> ad laudem et gloriam Dei, congregatis apud Wintoniam totius Angliæ, Daciæ<ptr type="liebermannNote" n="n" target="#QuadrArg_4.lnote.oe.n"/><ptr type="liebermannNote" n="16" target="#QuadrArg_4.lnote.oe.16"/> primatibus in natali Domini.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 532–533 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_4.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">532</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">für</hi> gemot <hi rend="italic">II As</hi> 20</seg><seg type="translation" xml:lang="en" source="#claude">for gemot II As 20</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_4.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">532</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 3</seg><seg type="translation" xml:lang="en" source="#claude">see above 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_4.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">532</biblScope></bibl><seg type="original" xml:lang="de">secundum hoc in u. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">secundum hoc in u. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_4.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">532</biblScope></bibl><seg type="original" xml:lang="de">Datię <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">Datię Dm</seg></note>
