      <div type="clause" n="14.1">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 14.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 14.1" corresp="#wit-lat"><pb n="403" ed="#liebermann"/>cuius nos pietatem supplices exoramus, ut famulos<ptr type="liebermannNote" n="46" target="#IudDeiI_14-1.lnote.oe.46"/> tuos<ptr type="liebermannNote" n="47" target="#IudDeiI_14-1.lnote.oe.47"/> illos<ptr type="liebermannNote" n="48" target="#IudDeiI_14-1.lnote.oe.48"/> non de praeteritis iudices reatibus, sed huius culpae ueritatem spectantibus<ptr type="liebermannNote" n="49" target="#IudDeiI_14-1.lnote.oe.49"/> insinuas<ptr type="liebermannNote" n="50" target="#IudDeiI_14-1.lnote.oe.50"/>,</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 403 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_14-1.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">-lum N tuum non <hi rend="italic">Al;</hi> -lum tuum non <hi rend="italic">Ma;</hi> lū -ū <hi rend="italic">übergeschr. Rj;</hi> lū lā <hi rend="italic">überschr. Ci;</hi> -lum (uel -los) tuum <hi rend="italic">Ch;</hi> uel -lum <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lum N tuum non Al; -lum tuum non Ma; lū, with -ū written above, Rj; lū, with lā written above, Ci; -lum (uel -los) tuum Ch; uel -lum written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_14-1.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">-lum (<hi rend="italic">so</hi>) <hi rend="italic">übergeschr. H;</hi> tuum tuā <hi rend="italic">übergeschr. Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lum (sic) written above H; tuum, with tuā written above, Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_14-1.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">N <hi rend="italic">Rj Ca H; fehlt Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">N Rj Ca H; lacking in Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_14-1.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">expect. <hi rend="italic">Al</hi></seg><seg type="translation" xml:lang="en" source="#claude">expect. Al</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_14-1.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">-ues <hi rend="italic">Al Ma Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ues Al Ma Tr</seg></note>
      </div>
