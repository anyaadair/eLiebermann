        <note type="liebermannNote" subtype="textual" xml:id="IIAs_8.lnote.oe.18-2" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">155</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> si se. in a. c. <hi rend="italic">K; nur</hi> et — fa. <hi rend="italic">übrige;</hi> et <hi rend="italic">fehlt M Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">only si se. in a. c. K; only et — fa. the rest; et missing in M Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_8.lnote.oe.19-2" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">155</biblScope></bibl><seg type="original" xml:lang="de">ediximus <hi rend="italic">T M Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">ediximus T M Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_8.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">155</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond;</hi> (<hi rend="italic">eingeklammertes</hi>) <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket Lond; (the bracketed words) the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_8.lnote.oe.20-2" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">155</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> r. <hi rend="italic">Lond Hn</hi> 8, 4; <hi rend="italic">nur</hi> ius <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">only r. Lond Hn 8, 4; only ius the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_8.lnote.oe.21-2" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">155</biblScope></bibl><seg type="original" xml:lang="de">pres. <hi rend="italic">Br;</hi> <hi rend="spaced">ducat</hi> <hi rend="italic">Hn</hi></seg><seg type="translation" xml:lang="en" source="#claude">pres. Br; <hi rend="italic">ducat</hi> Hn</seg></note>
