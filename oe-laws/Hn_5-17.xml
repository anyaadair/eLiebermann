    <body>
      <div type="clause" n="5.17">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.17</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.17" corresp="#wit-lat"><pb n="550" ed="#liebermann"/>Caueat<ptr type="liebermannNote" n="e" target="#Hn_5-17.lnote.oe.e"/> sacerdos, ne<ptr type="liebermannNote" n="8" target="#Hn_5-17.lnote.oe.8"/> de hiis qui ei confitentur peccata sua, alicui recitet quod ei confessus est, non propinquis, non extraneis; quodsi fecerit, deponatur et omnibus diebus uite sue ignominiosus<ptr type="liebermannNote" n="9" target="#Hn_5-17.lnote.oe.9"/> peregrinando peniteat<ptr type="liebermannNote" n="10" target="#Hn_5-17.lnote.oe.10"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 550 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-17.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Gratian</hi> C. 33 q. 3 <hi rend="italic">De pen.</hi> D. 6, c. 2 <hi rend="italic">citirt</hi> Gregorius, <hi rend="italic">Friedberg als Parallelen</hi> Polycarp <hi rend="italic">und</hi> Petr. Lomb.: <hi rend="italic">jener ist Hn etwa zeitgenössisch, dieser etwas später</hi></seg><seg type="translation" xml:lang="en" source="#claude">Gratian C. 33 q. 3 De pen. D. 6, c. 2 cites Gregorius, and Friedberg gives Polycarp and Petr. Lomb. as parallels: the former is roughly contemporary with Hn, the latter somewhat later</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-17.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">ne de h. <hi rend="italic">übergeschr. Corr. Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">ne de h. written above by the corrector in Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-17.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">ignum. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">ignum. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-17.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">pergat <hi rend="italic">Gr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">pergat Gr.</seg></note>
