    <body>
      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:IudDeiVI">Iud Dei VI</ref> 2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei VI 2" corresp="#wit-du"><pb n="412" ed="#liebermann"/>þ<hi rend="italic">æt</hi> ge tó þys<ptr type="liebermannNote" n="20" target="#IudDeiVI_2.lnote.oe.20"/> husle ne gangen ne to ðæm ordale<ptr type="liebermannNote" n="21" target="#IudDeiVI_2.lnote.oe.21"/>, gif ge scyld on eow (ðe<ptr type="liebermannNote" n="11" target="#IudDeiVI_2.lnote.oe.11"/>) witen ðæs ðe eow (ðe<ptr type="liebermannNote" n="11" target="#IudDeiVI_2.lnote.oe.11"/>) man tihð oððe on gewyrhtu<hi rend="italic">m<ptr type="liebermannNote" n="22" target="#IudDeiVI_2.lnote.oe.22"/></hi> oððe on gewitnesse.<ptr type="liebermannNote" n="23" target="#IudDeiVI_2.lnote.oe.23"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei VI 2" corresp="#wit-vt"><pb n="412" ed="#liebermann"/>. . . husle ne gangen (ga<ptr type="liebermannNote" n="1" target="#IudDeiVI_2.lnote.oe.1"/>) ne . . ., . . ge (þu<ptr type="liebermannNote" n="1" target="#IudDeiVI_2.lnote.oe.1-2"/>) scyld on eow (þe<ptr type="liebermannNote" n="1" target="#IudDeiVI_2.lnote.oe.1-2"/>) witan (-te<ptr type="liebermannNote" n="1" target="#IudDeiVI_2.lnote.oe.1-2"/>) þæs þe eow (þe<ptr type="liebermannNote" n="1" target="#IudDeiVI_2.lnote.oe.1-2"/>) . . . . . . oððe on gewyrhtu<hi rend="italic">m</hi> oððe on gewitn . . .<ptr type="liebermannNote" n="3" target="#IudDeiVI_2.lnote.oe.3"/></ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="412" ed="#liebermann"/>dass ihr zu dieser Hostie nicht gehet noch zu dem Ordal, wenn ihr Schuld an euch (dir) wisset, dessen, wessen man euch (dich) zeihet, entweder in Werken oder in Mitwissenschaft.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">that you go not to this host nor to the ordeal, if you know guilt in you (thee) of that of which you are (thou art) accused, either in deeds or in complicity.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text and German translation transcribed from Gesetze I p. 412 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVI_2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">412</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">in anderer Tinte übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above in different ink</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVI_2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">412</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> VII</seg><seg type="translation" xml:lang="en" source="#claude">followed by VII</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVI_2.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">412</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">f.</hi> 55, <hi rend="italic">ed. Stevenson p.</hi> 114, <hi rend="italic">hinter</hi> V. <hi rend="italic">Kentische Sprache, Hand des Lateinschreibers um</hi> 900</seg><seg type="translation" xml:lang="en" source="#claude">f. 55, ed. Stevenson p. 114, after V. Kentish dialect, hand of the Latin scribe, c. 900</seg><note type="remark" resp="#claude">marker not found in the text</note></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVI_2.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">412</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">f.</hi> 13, <hi rend="italic">stark angebrannt, hinter Iud. Dei</hi> III; <hi rend="italic">Sprache spätes Westsächsisch. Vgl. o. S.</hi> 401{b}.</seg><seg type="translation" xml:lang="en" source="#claude">f. 13, badly scorched, after Iud. Dei III; language late West Saxon. Cf. above p. 401ᵇ.</seg><note type="remark" resp="#claude">marker not found in the text</note></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVI_2.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">412</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">in anderer Tinte verb. aus</hi> mode</seg><seg type="translation" xml:lang="en" source="#claude">corrected from mode in different ink</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVI_2.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">412</biblScope></bibl><seg type="original" xml:lang="de">2, 3 <hi rend="italic">f. scheint sonst nicht ebenso vorzukommen</hi></seg><seg type="translation" xml:lang="en" source="#claude">2, 3 f. does not seem to occur in the same form elsewhere</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVI_2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">412</biblScope></bibl><seg type="original" xml:lang="de">(<hi rend="italic">eingeklammertes</hi>) <hi rend="italic">übergeschrieben Du</hi></seg><seg type="translation" xml:lang="en" source="#claude">(bracketed words) written above Du</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVI_2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">412</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert aus</hi> þus</seg><seg type="translation" xml:lang="en" source="#claude">corrected from þus</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVI_2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">412</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt I</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in I</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVI_2.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">412</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">‘merits’ Sweet; es übersetzt</hi> hoc fecistis</seg><seg type="translation" xml:lang="en" source="#claude">‘merits’ Sweet; it translates hoc fecistis</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVI_2.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">412</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt Segen über heilen sollendes Wasser Du</hi></seg><seg type="translation" xml:lang="en" source="#claude">followed by a blessing over water meant to heal Du</seg></note>
      </div>
    </body>
