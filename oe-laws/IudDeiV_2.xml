        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei V 2" corresp="#wit-du" ana="#glossed"><pb n="411" ed="#liebermann"/>✠ Adiuro<ptr type="liebermannNote" n="29" target="#IudDeiV_2.lnote.oe.29"/> te, creaturæ<ptr type="liebermannNote" n="30" target="#IudDeiV_2.lnote.oe.30"/> ferri, per Deum, Patrem et Filium et Spiritum sanctum, et per<ptr type="liebermannNote" n="c" target="#IudDeiV_2.lnote.oe.c"/> tremendum diem iudicii et per XII apostolos et per septuaginta<ptr type="liebermannNote" n="31" target="#IudDeiV_2.lnote.oe.31"/> discipulos et per XII prophetas et per XXIIII <seg type="glossed"><seg type="base">seniores,</seg><gloss xml:lang="ang">wuðwuto,</gloss></seg> <seg type="glossed"><seg type="base">qui</seg><gloss xml:lang="ang">ða ðe</gloss></seg> <seg type="glossed"><seg type="base">assidue</seg><gloss xml:lang="ang">givunvlice</gloss></seg> <seg type="glossed"><seg type="base">Deum</seg><gloss xml:lang="ang">God</gloss></seg> <seg type="glossed"><seg type="base">laudant,</seg><gloss xml:lang="ang">heriað,</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">per</seg><gloss xml:lang="ang">ðerh</gloss></seg> <seg type="glossed"><seg type="base">CXLIIII</seg><gloss xml:lang="ang">hvndfeor:::<ptr type="liebermannNote" n="32" target="#IudDeiV_2.lnote.oe.32"/></gloss></seg> <seg type="glossed"><seg type="base">milia,</seg><gloss xml:lang="ang">ðusendo,</gloss></seg> <seg type="glossed"><seg type="base">qui</seg><gloss xml:lang="ang">ða ðe</gloss></seg> <seg type="glossed"><seg type="base">secuntur</seg><gloss xml:lang="ang">fylgað</gloss></seg> <seg type="glossed"><seg type="base">Agnum,</seg><gloss xml:lang="ang">lomb,</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">per</seg><gloss xml:lang="ang">ðerh</gloss></seg> <seg type="glossed"><seg type="base">omnia</seg><gloss xml:lang="ang">alle</gloss></seg> <seg type="glossed"><seg type="base">agmina</seg><gloss xml:lang="ang">hergia</gloss></seg> <seg type="glossed"><seg type="base">sanctorum</seg><gloss xml:lang="ang">haligra</gloss></seg> <seg type="glossed"><seg type="base">angelorum</seg><gloss xml:lang="ang">engla</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊ .</gloss></seg> <seg type="glossed"><seg type="base">archangelorum,</seg><gloss xml:lang="ang">hehangla,</gloss></seg> <seg type="glossed"><seg type="base">thrones<ptr type="liebermannNote" n="33" target="#IudDeiV_2.lnote.oe.33"/>,</seg><gloss xml:lang="ang">hehsedlo,</gloss></seg> <seg type="glossed"><seg type="base">dominationes</seg><gloss xml:lang="ang">ricsares</gloss></seg> <seg type="glossed"><seg type="base">principatum<ptr type="liebermannNote" n="34" target="#IudDeiV_2.lnote.oe.34"/></seg><gloss xml:lang="ang">aldorm<hi rend="italic">onna</hi></gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">potestatum,</seg><gloss xml:lang="ang">mæht<hi rend="italic">a</hi>,</gloss></seg> <seg type="glossed"><seg type="base">uirtutum,</seg><gloss xml:lang="ang">mægna,</gloss></seg> <seg type="glossed"><seg type="base">Cherubim</seg><gloss xml:lang="ang">Cer'</gloss></seg> <seg type="glossed"><seg type="base">atque</seg><gloss xml:lang="ang">⁊ æc</gloss></seg> <seg type="glossed"><seg type="base">Seraphin,</seg><gloss xml:lang="ang">Se',</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">per</seg><gloss xml:lang="ang">ðerh</gloss></seg> <seg type="glossed"><seg type="base">omnia</seg><gloss xml:lang="ang">alle</gloss></seg> <seg type="glossed"><seg type="base">milia</seg><gloss xml:lang="ang">ðvsenda<ptr type="liebermannNote" n="35" target="#IudDeiV_2.lnote.oe.35"/></gloss></seg> <seg type="glossed"><seg type="base">sanctorum</seg><gloss xml:lang="ang">haligra</gloss></seg> <seg type="glossed"><seg type="base">martyrum</seg><gloss xml:lang="ang">ðrevara</gloss></seg> <seg type="glossed"><seg type="base">tuorum<ptr type="liebermannNote" n="36" target="#IudDeiV_2.lnote.oe.36"/>,</seg><gloss xml:lang="ang">ðinra,</gloss></seg> <seg type="glossed"><seg type="base">uirginum</seg><gloss xml:lang="ang">hehstaldra</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">confessorum;</seg><gloss xml:lang="ang">ond<hi rend="italic">etra</hi>;</gloss></seg></ab>
