    <body>
      <div type="clause" n="8.1">
        <head><ref type="lawCode" target="law:ICn">I Cn</ref> 8.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8.1" corresp="#wit-g-a"><pb n="290" ed="#liebermann"/>Þ<hi rend="italic">æt</hi> is sulhælmesse XV<ptr type="liebermannNote" n="24" target="#ICn_8-1.lnote.oe.24"/> niht ofer Eastran ⁊ geoguþe<ptr type="liebermannNote" n="25" target="#ICn_8-1.lnote.oe.25"/> teoðunge be Pentecosten ⁊ eorðwæstma be Ealra halgena mæssan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8.1" corresp="#wit-a"><pb n="290" ed="#liebermann"/>Ðæt is sulhælmesse fiftene nyht<ptr type="liebermannNote" n="7" target="#ICn_8-1.lnote.oe.7"/> ofer Eastran ⁊ geogoþe teoþunge be Pentecosten ⁊ eorðwæstma be Ealra halgena mæssan.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="8.1" corresp="#wit-q"><pb n="290" ed="#liebermann"/>hoc est elemosina carrucarum<ptr type="liebermannNote" n="11" target="#ICn_8-1.lnote.oe.11"/> XV diebus post Pascha, decimę de nouellis gregibus in Pentecosten, terrenorum fructuum in festo<ptr type="liebermannNote" n="1" target="#ICn_8-1.lnote.oe.1"/> Omnium sanctorum.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8.1" corresp="#wit-inst-cn"><pb n="291" ed="#liebermann"/>scilicet elemosinas carrucarum<ptr type="liebermannNote" n="13" target="#ICn_8-1.lnote.oe.13"/>, quam Angli uocant súlhælmesse<ptr type="liebermannNote" n="1" target="#ICn_8-1.lnote.oe.1-2"/>, quindecim dies post Pascha et<ptr type="liebermannNote" n="2" target="#ICn_8-1.lnote.oe.2"/> decimas pecorum et pecudum in Pentecosten, frugum (et<ptr type="liebermannNote" n="3" target="#ICn_8-1.lnote.oe.3"/> fructuum) terrę<ptr type="liebermannNote" n="4" target="#ICn_8-1.lnote.oe.4"/> in festiuitate Omnium sanctorum.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="8.1" corresp="#wit-cons-cn"><pb n="291" ed="#liebermann"/>que sunt aratri elemosina post XV dies post Pascha, iuuentutis decimacio ad Pentecosten, terre fructus ad festiuitatem Omnium sanctorum.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="8.1" corresp="#wit-g-a"><pb n="164" ed="#robertson"/>Þæt is sulhælmesse XV niht ofer Eastran ⁊ geogoþe teoðunge be Pentecosten ⁊ eorðwæstma be Ealra halgena mæssan.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="242" ed="#rabin-doml"/>Þæt is, sulhælmesse XV niht ofer Eastran and geoguþe teoðunge be Pentecosten and eorðwæstma be Ealra Halgena mæssan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="291" ed="#liebermann"/>nämlich das Pflugalmosen vierzehn Tage nach Ostern und vom Jungvieh Zehnten zu Pfingsten und Feldfrüchte[-Zehnt] zum Aller Heiligen-Fest [1. November].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">namely plough-alms a fortnight after Easter, and the tithe of young stock at Pentecost, and [the tithe of] the fruits of the earth at All Saints [1 November].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-g-a"><pb n="165" ed="#robertson"/>Namely, plough-alms 15 days after Easter, and the tithe of young animals at Pentecost, and [the tithe] of the fruits of the earth at All Saints.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="243" ed="#rabin-doml"/>That is, plow dues fifteen nights after Easter, and the tithe of the young animals by Pentecost, and the tithe on the fruits of the earth by the Feast of All Saints.</ab>
        <note type="comparison" source="#liebermann" n="291"><ref target="clause:VIAtr_17">VI Atr 17</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 17</note>
        <note type="editorial">Liebermann compares VI Atr 17.; BR: added from Gesetze I p. 291, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_8-1.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de">fiftene <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fiftene Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_8-1.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de">gegoþe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gegoþe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_8-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de">caruarum <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">caruarum R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_8-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">292</biblScope></bibl><seg type="original" xml:lang="de">ante <hi rend="italic">fügt zu Dm, später unterstrichen</hi></seg><seg type="translation" xml:lang="en" source="#claude">ante added by Dm, later underlined</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_8-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">291</biblScope></bibl><seg type="original" xml:lang="de">caru. <hi rend="italic">Cb stets</hi></seg><seg type="translation" xml:lang="en" source="#claude">caru. Cb always</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_8-1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">293</biblScope></bibl><seg type="original" xml:lang="de">sulhelmæsse <hi rend="italic">Cb</hi>; sulæl. <hi rend="italic">H</hi>; sulel. <hi rend="italic">Di</hi>; sulcheimesse <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">sulhelmæsse Cb; sulæl. H; sulel. Di; sulcheimesse S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_8-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">293</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Cb</hi>; <hi rend="italic">fehlt H</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Cb; missing in H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_8-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">293</biblScope></bibl><seg type="original" xml:lang="de">et fruct. <hi rend="italic">nur Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">et fruct. only Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_8-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">293</biblScope></bibl><seg type="original" xml:lang="de">sicut carruca perarat [<hi rend="italic">aus</hi> 8,2] <hi rend="italic">fügt ein HDi</hi></seg><seg type="translation" xml:lang="en" source="#claude">sicut carruca perarat [from 8,2] inserted by HDi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_8-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de">nylt <hi rend="italic">A</hi></seg><seg type="translation" xml:lang="en" source="#claude">nylt A</seg></note>
      </div>
