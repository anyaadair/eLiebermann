    <body>
      <div type="clause" n="18.3">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 18.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 18.3"><pb n="644" ed="#liebermann"/>Quodsi periuri<ptr type="liebermannNote" n="21" target="#ECfRetr_18-3.lnote.la.21"/> <hi rend="bold">postea</hi> in terra remanserint<ptr type="liebermannNote" n="22" target="#ECfRetr_18-3.lnote.la.22"/>, quicunque eos<ptr type="liebermannNote" n="23" target="#ECfRetr_18-3.lnote.la.23"/> inuenire poterit, faciat<ptr type="liebermannNote" n="24" target="#ECfRetr_18-3.lnote.la.24"/> de eis<ptr type="liebermannNote" n="25" target="#ECfRetr_18-3.lnote.la.25"/> <hi rend="bold">sine iudicio</hi> iustitiam.</ab>
        <note type="comparison" source="#liebermann" n="644"><label>printed alongside</label> <ref target="clause:ECf_18-3">ECf 18.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 644 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-3.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">‘<hi rend="italic">vollstrecke die Hinrichtung</hi> (‘<hi rend="italic">ohne</hi> [<hi rend="italic">weiteren</hi>] <hi rend="italic">Process</hi>’; <hi rend="italic">Retr.</hi>)’; <hi rend="italic">Tödtung Geächteter war zwar erlaubt</hi> (<hi rend="italic">s. o.</hi> 6, 2), <hi rend="italic">aber im XII. Jahrh. kaum mehr, wie bei den alten Germanen, Pflicht</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘let him carry out the execution (‘without [further] process’; Retr.)’; the killing of outlaws was indeed permitted (see above, 6, 2), but in the 12th century hardly still a duty, as among the ancient Germans</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-3.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">-rus <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rus Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-3.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">-rit <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rit Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-3.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">eum <hi rend="italic">Hv Va K</hi></seg><seg type="translation" xml:lang="en" source="#claude">eum Hv Va K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-3.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">de eo s. i. i. faciat <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">de eo s. i. i. faciat Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-3.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">his <hi rend="italic">Lb Va Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">his Lb Va Ph</seg></note>
      </div>
