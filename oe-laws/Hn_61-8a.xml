        <head><ref type="lawCode" target="law:Hn">Hn</ref> 61.8a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 61.8a" corresp="#wit-lat"><pb n="581" ed="#liebermann"/>Si uero non contradixit<ptr type="liebermannNote" n="q" target="#Hn_61-8a.lnote.oe.q"/><ptr type="liebermannNote" n="38" target="#Hn_61-8a.lnote.oe.38"/>, et paratum ta[ndem<ptr type="liebermannNote" n="39" target="#Hn_61-8a.lnote.oe.39"/>] sit, ut coram eo debeat agi: qui non uenerit, amiserit<ptr type="liebermannNote" n="r" target="#Hn_61-8a.lnote.oe.r"/> et ouerseunesse<ptr type="liebermannNote" n="d" target="#Hn_61-8a.lnote.oe.d"/><ptr type="liebermannNote" n="40" target="#Hn_61-8a.lnote.oe.40"/> culpa sit, nisi sonius<ptr type="liebermannNote" n="41" target="#Hn_61-8a.lnote.oe.41"/> intercedat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 581 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-8a.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">581</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 60, 1<hi rend="italic">a</hi>. 61, 8<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 60, 1<hi rend="italic">a</hi>. 61, 8<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-8a.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">581</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier</hi> = contramandauit</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">here</hi> = contramandauit</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-8a.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">581</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 60, 1<hi rend="italic">b</hi>. 61, 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 60, 1<hi rend="italic">b</hi>. 61, 1</seg></note>
