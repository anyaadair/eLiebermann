      <div type="clause" n="50.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 50.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 50.2" corresp="#wit-lat"><pb n="573" ed="#liebermann"/>Aliud enim est, si quis a domino suo sic<ptr type="liebermannNote" n="8" target="#Hn_50-2.lnote.oe.8"/> submoneatur, <ptr type="liebermannNote" n="9" target="#Hn_50-2.lnote.oe.9"/>ut illa<ptr type="liebermannNote" n="10" target="#Hn_50-2.lnote.oe.10"/> uel<ptr type="liebermannNote" n="11" target="#Hn_50-2.lnote.oe.11"/> illa die sit ad eum, et placitum ei non<ptr type="liebermannNote" n="12" target="#Hn_50-2.lnote.oe.12"/> nominetur; et<ptr type="liebermannNote" n="13" target="#Hn_50-2.lnote.oe.13"/> aliter, si ita expresse sit mannitus, ut ei placitum nominetur<ptr type="liebermannNote" n="14" target="#Hn_50-2.lnote.oe.14"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 573 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_50-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_50-2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">unterpunctirt fügt zu Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel, subpuncted, added by Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_50-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">illo <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">illo Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_50-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">u. i. d. <hi rend="italic">fehlt K;</hi> u. i. <hi rend="italic">fehlt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. i. d. missing in K; u. i. missing in Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_50-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus K</hi></seg><seg type="translation" xml:lang="en" source="#claude">from K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_50-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">et — nominetur <hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">et — nominetur missing in K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_50-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">non nom. ˙Si nom. p. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">non nom. ˙Si nom. p. Sc Hg</seg></note>
