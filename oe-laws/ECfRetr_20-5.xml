      <div type="clause" n="20.5">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 20.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 20.5"><pb n="646" ed="#liebermann"/><hi rend="bold">Tandem uero</hi> sacramentum, quod non potuerunt <hi rend="bold">ad</hi>implere per <hi rend="bold">tres</hi><ptr type="liebermannNote" n="g" target="#ECfRetr_20-5.lnote.la.fn.g"/> <hi rend="bold">friborgos</hi><ptr type="liebermannNote" n="24" target="#ECfRetr_20-5.lnote.la.24"/> <hi rend="bold">sibi</hi> uiciniores, per se<ptr type="liebermannNote" n="25" target="#ECfRetr_20-5.lnote.la.25"/> ipsos nouem iurarent: sese <hi rend="bold">nullatenus fore</hi><ptr type="liebermannNote" n="26" target="#ECfRetr_20-5.lnote.la.26"/> <hi rend="bold">culpabiles.</hi></ab>
        <note type="comparison" source="#liebermann" n="646"><label>printed alongside</label> <ref target="clause:ECf_20-5">ECf 20.5</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 646 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECfRetr_20-5.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 20, 3, <hi rend="italic">woraus Retr. schöpft; Eidesformel theilweise in</hi> Wl art. 8</seg><seg type="translation" xml:lang="en" source="#claude">cf. 20, 3, from which the Retr. draws; the oath formula partly in Wl art. 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-5.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">-gas <hi rend="italic">Cb;</hi> fridb. <hi rend="italic">Lb Va Ph;</hi> frithb. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gas Cb; fridb. Lb Va Ph; frithb. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-5.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">semet <hi rend="italic">Lb Va Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">semet Lb Va Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-5.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">esse <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">esse Cb</seg></note>
      </div>
