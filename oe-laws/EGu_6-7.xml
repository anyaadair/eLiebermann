      <div type="clause" n="6.7">
        <head><ref type="lawCode" target="law:EGu">EGu</ref> 6.7</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.7" corresp="#wit-h"><pb n="132" ed="#liebermann"/>⁊ gif he gewyrce, þ<hi rend="italic">æt</hi> hine man<ptr type="liebermannNote" n="7" target="#EGu_6-7.lnote.oe.7"/> afylle, þurh þ<hi rend="italic">æt</hi> hine<ptr type="liebermannNote" n="**" target="#EGu_6-7.lnote.oe.star2"/> man gean Godes ryht<ptr type="liebermannNote" n="8" target="#EGu_6-7.lnote.oe.8"/> oððe þæs cynges geonbyrde, gif man þæt gesoðige, licge ǽgylde.<ptr type="liebermannNote" n="***" target="#EGu_6-7.lnote.oe.star3"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.7" corresp="#wit-b"><pb n="132" ed="#liebermann"/>⁊ gyf he gewyrce, þ<hi rend="italic">æt</hi> hine man afylle, þurh þ<hi rend="italic">æt</hi> he ongean Godes riht oððe ðæs cynges geonbyrde, gyf man þ<hi rend="italic">æt</hi> gesoðige, licge ægylde.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6.7" corresp="#wit-q"><pb n="133" ed="#liebermann"/>Et si efficiat<ptr type="liebermannNote" n="11" target="#EGu_6-7.lnote.oe.11"/>, ut occidatur, pro eo quod contra Dei rectum et regis imperium stet, si hoc inueritetur, iaceat ægylde.<ptr type="liebermannNote" n="12" target="#EGu_6-7.lnote.oe.12"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="6.7" corresp="#wit-h"><pb n="106" ed="#attenborough"/>⁊ gif he gewyrce, þæt hine man afylle, þurh þæt [he ongean]<ptr type="editorNote" n="4" target="#EGu_6-7.attnote.fn.4"/> Godes ryht oððe þæs cynges geonbyrde, gif man þæt gesoðige, licge ǽgylde<ptr type="editorNote" n="5" target="#EGu_6-7.attnote.fn.5"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-h"><pb n="6" ed="#rabin-doml"/>And gif he gewyrce þæt hine man afylle þurh þæt he ongean Godes ryht oððe þæs cynges geonbyrde, gif man þæt gesoðige, licge ægylde.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="133" ed="#liebermann"/>Und wenn er bewirkt, dass man ihn erschlägt, weil er gegen die Gerechtsame der Kirche oder des Königs ankämpft(e<ptr type="liebermannNote" n="1" target="#EGu_6-7.lnote.de.1"/>?), wenn dies erwiesen wird, liege er ohne [seiner Sippe durch den Todtschläger] entgolten<ptr type="liebermannNote" n="2" target="#EGu_6-7.lnote.de.2"/> zu werden.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if he brings it about that he is slain, because he fights against the dues of the Church or of the king, if this is proved, let him lie without being paid for [to his kin by the slayer].</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="107" ed="#attenborough"/>If he so acts as to bring about his own death by setting himself against the laws of God and the king, no compensation shall be paid for him, if this can be proved.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-h"><pb n="7" ed="#rabin-doml"/>And if he acts in such a way as to cause his own death through resistance to God’s justice or the king’s, and if that is shown to be true, no compensation need be paid for him.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VAtr_31-1">V Atr 31.1</ref>; <ref target="clause:IICn_48-3">II Cn 48.3</ref></note>
        <note type="textual" source="#rabin-doml">he ongean: hine man gean H</note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_6-7.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">133</biblScope></bibl><seg type="original" xml:lang="de">faciat <hi rend="italic">TMHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">faciat TMHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_6-7.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">133</biblScope></bibl><seg type="original" xml:lang="de">ægilde <hi rend="italic">T;</hi> egilde <hi rend="italic">MHk;</hi> ælgylde <hi rend="italic">KOr;</hi> orgilde <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">ægilde T; egilde MHk; ælgylde KOr; orgilde Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_6-7.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">mon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_6-7.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> he ongean (<hi rend="italic">st.</hi> h. m. g.) <hi rend="italic">aus BLd; II Cnut</hi> 48, 3</seg><seg type="translation" xml:lang="en" source="#claude">read he ongean (instead of h. m. g.) from BLd; II Cnut 48, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_6-7.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">rihte o. ð. cyninges <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">rihte o. ð. cyninges Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_6-7.lnote.oe.star3" n="***" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">he orgylde <hi rend="italic">Ld; vgl. Quadr.-Bromton</hi></seg><seg type="translation" xml:lang="en" source="#claude">he orgylde Ld; cf. Quadr.-Bromton</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_6-7.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Wiederholt II Cn 48, 3 = Hn 11, 11c. — Mit <hi rend="italic">geonbyrde</hi> ist <hi rend="italic">wigie</hi> 6, 5 synonym</seg><seg type="translation" xml:lang="en" source="#claude">Repeated in II Cn 48, 3 = Hn 11, 11c. — <hi rend="italic">wigie</hi> 6, 5 is synonymous with <hi rend="italic">geonbyrde</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_6-7.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Totschlag 3a D; Wergeld 17a; Grab 2b. Zum Begriffe: <hi rend="italic">νήποινος</hi> Pollock <hi rend="italic">HEL</hi> I 27</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Totschlag 3a D; Wergeld 17a; Grab 2b. On the concept: <hi rend="italic">νήποινος</hi> Pollock <hi rend="italic">HEL</hi> I 27</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="EGu_6-7.attnote.fn.4" n="4" source="#attenborough"><bibl><biblScope unit="page">106</biblScope></bibl><label>ongean</label><seg type="original" xml:lang="en">B. <hi rend="italic">hine man gean</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="EGu_6-7.attnote.fn.5" n="5" source="#attenborough"><bibl><biblScope unit="page">106</biblScope></bibl><label>ǽgylde</label><seg type="original" xml:lang="en"><hi rend="italic">he orgylde</hi>. Ld.</seg></note>
      </div>
