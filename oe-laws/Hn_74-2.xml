      <div type="clause" n="74.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 74.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 74.2" corresp="#wit-lat"><pb n="591" ed="#liebermann"/>Et qui culpam exigit de fure occiso, eat se tercio, ut duo sint de cognacione patris, tercius de cognacione matris; et iurent<ptr type="liebermannNote" n="29" target="#Hn_74-2.lnote.oe.29"/>, quod in cognato suo nullum f[ur]tum<ptr type="liebermannNote" n="30" target="#Hn_74-2.lnote.oe.30"/> erat, pro quo de uita forisfactus esset.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 591 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_74-2.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">591</biblScope></bibl><seg type="original" xml:lang="de">-ret <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ret Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_74-2.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">591</biblScope></bibl><seg type="original" xml:lang="de">fcm̄ <hi rend="italic">Sc Hg;</hi> facinum <hi rend="italic">Lond; vielleicht</hi> facnum, <hi rend="italic">das Quadr. oft für</hi> facn <hi rend="italic">setzt</hi></seg><seg type="translation" xml:lang="en" source="#claude">fcm̄ Sc Hg; facinum Lond; perhaps facnum, which Quadr. often uses for facn</seg></note>
      </div>
