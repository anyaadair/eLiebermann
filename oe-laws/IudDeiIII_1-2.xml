      <div type="clause" n="1.2">
        <head><ref type="lawCode" target="law:IudDeiIII">Iud Dei III</ref> 1.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei III 1.2" corresp="#wit-lat"><pb n="408" ed="#liebermann"/>Fac eum<ptr type="liebermannNote" n="13" target="#IudDeiIII_1-2.lnote.oe.13"/>, <ptr type="liebermannNote" n="18" target="#IudDeiIII_1-2.lnote.oe.18"/>Domine, in uisceribus angustari<ptr type="liebermannNote" n="19" target="#IudDeiIII_1-2.lnote.oe.19"/> eiusque<ptr type="liebermannNote" n="20" target="#IudDeiIII_1-2.lnote.oe.20"/> guttur conclude, ut panem uel caseum istum in tuo nomine sanctificatum deuorare non possit<ptr type="liebermannNote" n="21" target="#IudDeiIII_1-2.lnote.oe.21"/> hic qui iniuste iurauit<ptr type="liebermannNote" n="22" target="#IudDeiIII_1-2.lnote.oe.22"/> ac negauit<ptr type="liebermannNote" n="22" target="#IudDeiIII_1-2.lnote.oe.22"/> illud<ptr type="liebermannNote" n="23" target="#IudDeiIII_1-2.lnote.oe.23"/> furtum — uel homicidium<ptr type="liebermannNote" n="24" target="#IudDeiIII_1-2.lnote.oe.24"/> aut adulterium seu maleficium — quod quaerebatur, et iusiurandum pro nihilo habuit<ptr type="liebermannNote" n="22" target="#IudDeiIII_1-2.lnote.oe.22"/> et nomen<ptr type="liebermannNote" n="25" target="#IudDeiIII_1-2.lnote.oe.25"/> tuum nominauit<ptr type="liebermannNote" n="22" target="#IudDeiIII_1-2.lnote.oe.22"/>, ubi rectum non erat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 408 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">-os <hi rend="italic">übergeschr. H; stets Plural darüber auch Ci;</hi> uel eos <hi rend="italic">übergeschr. Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">-os written above in H; Ci too always has the plural written above; uel eos written above in Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">quesumus <hi rend="italic">fügt zu Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">quesumus added in Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">angantur, ut p. uel c. i. non possit manducare <hi rend="italic">Zeu.</hi> 687<hi rend="italic">d</hi></seg><seg type="translation" xml:lang="en" source="#claude">angantur, ut p. uel c. i. non possit manducare Zeu. 687d</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">eorum -ra <hi rend="italic">übergeschr. Rj H</hi></seg><seg type="translation" xml:lang="en" source="#claude">eorum -ra written above in Rj H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">-nt hi <hi rend="italic">übergeschr. Rj H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nt hi written above in Rj H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-2.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">-erunt <hi rend="italic">übergeschr. Rj H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-erunt written above in Rj H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-2.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">ill. — malef. <hi rend="italic">am Rande,</hi> hoc <hi rend="italic">im Texte H</hi></seg><seg type="translation" xml:lang="en" source="#claude">ill. — malef. in the margin, hoc in the text H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-2.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">h. a. <hi rend="italic">aus Ch Ca H; fehlt Ps Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. a. from Ch Ca H; omitted in Ps Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-2.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">sanctum <hi rend="italic">fügt zu Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">sanctum added in Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">239</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Geweihter Bissen 7</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Geweihter Bissen 7</seg></note>
      </div>
