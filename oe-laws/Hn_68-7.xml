      <div type="clause" n="68.7">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 68.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 68.7" corresp="#wit-lat"><pb n="587" ed="#liebermann"/>Qui<ptr type="liebermannNote" n="g" target="#Hn_68-7.lnote.oe.g"/> monachum uel clericum occiderit<ptr type="liebermannNote" n="11" target="#Hn_68-7.lnote.oe.11"/>, arma relinquat et Deo seruiat; et si casu perpetrauit et noluit<ptr type="liebermannNote" n="12" target="#Hn_68-7.lnote.oe.12"/>, VII annis peniteat; si uolens fecit, usque ad exitum uite peniteat<ptr type="liebermannNote" n="5" target="#Hn_68-7.lnote.oe.5"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 587 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_68-7.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ferner stehen Ps.-Egb.</hi> Poen. 4, 68, 22; Conf. 23</seg><seg type="translation" xml:lang="en" source="#claude">further in Ps.-Egb. Poen. 4, 68, 22; Conf. 23</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_68-7.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_68-7.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_68-7.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de">uolens <hi rend="italic">Sc</hi>; noluerit <hi rend="italic">Ps.-Theodor</hi></seg><seg type="translation" xml:lang="en" source="#claude">uolens Sc; noluerit Ps.-Theodor</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_68-7.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Deo serviat</hi>: ‘trete ins Kloster’ versteht Stubbs <hi rend="italic">Lect</hi>. 164—<hi rend="italic">nolens</hi>{12}—<hi rend="italic">peniteat</hi>{5} fehlt—vor 68, 8 steht 68, 10 Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Deo serviat</hi>: Stubbs <hi rend="italic">Lect</hi>. 164 takes this as ‘let him enter a monastery’—<hi rend="italic">nolens</hi>{12}—<hi rend="italic">peniteat</hi>{5} missing—68, 10 stands before 68, 8 Rs</seg></note>
      </div>
