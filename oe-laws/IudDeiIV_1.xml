      <div type="clause" n="1">
        <head><ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 1" corresp="#wit-du"><pb n="409" ed="#liebermann"/>Deus<ptr type="liebermannNote" n="21" target="#IudDeiIV_1.lnote.oe.21"/>, qui tribus pueris<ptr type="liebermannNote" n="22" target="#IudDeiIV_1.lnote.oe.22"/> mitigasti flammas<ptr type="liebermannNote" n="23" target="#IudDeiIV_1.lnote.oe.23"/> ign[i]um, concede, quesumus<ptr type="liebermannNote" n="25" target="#IudDeiIV_1.lnote.oe.25"/>, ut nos, famulos tuos, non exurat flamma uitiorum! Per</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei IV 1" corresp="#wit-gl"><pb n="409" ed="#liebermann"/>God, ðu ðe ðriim cnehtu<hi rend="italic">m</hi> gimetgadest lego fyrā<ptr type="liebermannNote" n="24" target="#IudDeiIV_1.lnote.oe.24"/>, gilef, ve bid<hi rend="italic">dað</hi>, þ<hi rend="italic">æt</hi>te usig, ðea ðino, ne giberne leg synna!</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Dan. 3, 12</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 409 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">c.</hi> 1 = <hi rend="italic">Zeumer</hi> 693₃₁: Benedictio ferri; <hi rend="italic">auch unten</hi> XVI 6</seg><seg type="translation" xml:lang="en" source="#claude">c. 1 = Zeumer 693₃₁: Benedictio ferri; also below XVI 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_1.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. u.</hi> 3, 3</seg><seg type="translation" xml:lang="en" source="#claude">cf. below 3, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">flāma signum <hi rend="italic">Du;</hi> -mam <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">flāma signum Du; -mam Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_1.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so. ‘A curl over certain words .. is added, by way of flourish, when the word is quite complete’ Skeat p.</hi> *59</seg><seg type="translation" xml:lang="en" source="#claude">thus. ‘A curl over certain words .. is added, by way of flourish, when the word is quite complete’ Skeat p. *59</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_1.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">propitius <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">propitius Zeu.</seg></note>
      </div>
