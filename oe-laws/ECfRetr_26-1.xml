    <body>
      <div type="clause" n="26.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 26.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 26.1"><pb n="650" ed="#liebermann"/><hi rend="bold">Nec ob</hi><ptr type="liebermannNote" n="29" target="#ECfRetr_26-1.lnote.la.29"/> <hi rend="bold">securitatem</hi> pacis <hi rend="bold">adeptam</hi><ptr type="liebermannNote" n="30" target="#ECfRetr_26-1.lnote.la.30"/> <hi rend="bold">de</hi>tineant rectitudines <hi rend="bold">uel</hi><ptr type="liebermannNote" n="31" target="#ECfRetr_26-1.lnote.la.31"/> seruitia dominorum suorum, <hi rend="bold">sed</hi> nec uicinorum; quia non est dignus habere pacem qui non diligit<ptr type="liebermannNote" n="32" target="#ECfRetr_26-1.lnote.la.32"/> obseruare <hi rend="bold">eam.</hi></ab>
        <note type="comparison" source="#liebermann" n="650"><label>printed alongside</label> <ref target="clause:ECf_26-1">ECf 26.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 650 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_26-1.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Sonderschutz durch Krone soll nicht von Bürger- oder Lehnspflicht befreien; vgl.</hi> Hn com. 4</seg><seg type="translation" xml:lang="en" source="#claude">special protection by the Crown is not to release from the duties of a citizen or vassal; cf. Hn com. 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_26-1.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">obscur. <hi rend="italic">nur Hv’s Ed. Savile</hi></seg><seg type="translation" xml:lang="en" source="#claude">obscur. only Hv’s ed. Savile</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_26-1.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">ademptam <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">ademptam Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_26-1.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_26-1.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">uult <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">uult Hv</seg></note>
      </div>
    </body>
