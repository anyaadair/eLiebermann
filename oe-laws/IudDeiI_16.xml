      <div type="clause" n="16">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 16</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 16" corresp="#wit-lat"><ptr type="liebermannNote" n="a" target="#IudDeiI_16.lnote.oe.a"/><pb n="403" ed="#liebermann"/>Hic<ptr type="liebermannNote" n="b" target="#IudDeiI_16.lnote.oe.b"/> communicent<ptr type="liebermannNote" n="77" target="#IudDeiI_16.lnote.oe.77"/> post<ptr type="liebermannNote" n="78" target="#IudDeiI_16.lnote.oe.78"/> sacerdotem<ptr type="liebermannNote" n="79" target="#IudDeiI_16.lnote.oe.79"/>, et dicat sacerdos:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 403 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_16.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. oben</hi> 3, 2ᵇ; <hi rend="italic">hier lassen</hi> 16. 16, 1 <hi rend="italic">fort Al Ma;</hi> 16—17 <hi rend="italic">auch Zeu.</hi> 627.</seg><seg type="translation" xml:lang="en" source="#claude">Cf. above 3, 2ᵇ; here Al Ma omit 16. 16, 1; 16—17 also Zeu. 627.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_16.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">Sac. communicans eos post se, dicat <hi rend="spaced">per singulos</hi> <hi rend="italic">Tr; vgl. oben</hi> 3, 3ᶜ.</seg><seg type="translation" xml:lang="en" source="#claude">Sac. communicans eos post se, dicat <hi rend="italic">per singulos</hi> Tr; cf. above 3, 3ᶜ.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_16.lnote.oe.77" n="77" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi> -t <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-t written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_16.lnote.oe.78" n="78" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">pro <hi rend="italic">Ps;</hi> per <hi rend="italic">Pt</hi></seg><seg type="translation" xml:lang="en" source="#claude">pro Ps; per Pt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_16.lnote.oe.79" n="79" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">sacerdo tenet di. <hi rend="italic">Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">sacerdo tenet di. Rj</seg></note>
      </div>
