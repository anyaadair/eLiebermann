      <div type="clause" n="23.3">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 23.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 23.3"><pb n="649" ed="#liebermann"/>Si <hi rend="bold">uero</hi> malefactor non<ptr type="liebermannNote" n="3" target="#ECfRetr_23-3.lnote.la.3"/> poterit damnum restaurare quod fecerat, hospes <hi rend="bold">suus</hi><ptr type="liebermannNote" n="4" target="#ECfRetr_23-3.lnote.la.4"/> restaurabit, et forisfacturam.</ab>
        <note type="comparison" source="#liebermann" n="649"><label>printed alongside</label> <ref target="clause:ECf_23-3">ECf 23.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 649 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_23-3.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">d. r. n. p. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. r. n. p. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_23-3.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
      </div>
    </body>
