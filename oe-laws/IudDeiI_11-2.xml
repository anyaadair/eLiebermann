      <div type="clause" n="11.2">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 11.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 11.2" corresp="#wit-lat"><pb n="403" ed="#liebermann"/>Precepta nosti?’ Ille dixit<ptr type="liebermannNote" n="13" target="#IudDeiI_11-2.lnote.oe.13"/>: ‘Quae?’<ptr type="liebermannNote" n="14" target="#IudDeiI_11-2.lnote.oe.14"/> ‘Non occidas<ptr type="liebermannNote" n="15" target="#IudDeiI_11-2.lnote.oe.15"/>; non adulteres<ptr type="liebermannNote" n="16" target="#IudDeiI_11-2.lnote.oe.16"/>; non fureris; non falsum testimonium dicas<ptr type="liebermannNote" n="17" target="#IudDeiI_11-2.lnote.oe.17"/>; non fraudem feceris<ptr type="liebermannNote" n="18" target="#IudDeiI_11-2.lnote.oe.18"/>; honora patrem<ptr type="liebermannNote" n="19" target="#IudDeiI_11-2.lnote.oe.19"/> et matrem tuam.’</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">10, 19</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 403 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_11-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">autem dixit ei <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">autem dixit ei Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_11-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">ait <hi rend="italic">fügt zu Ca H;</hi> Dixit ei Iesus <hi rend="italic">fügt zu Al Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">ait added by Ca H; Dixit ei Iesus added by Al Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_11-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">-des <hi rend="italic">Tr Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-des Tr Co</seg></note>
