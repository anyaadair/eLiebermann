      <div type="clause" n="47.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 47.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47.1" corresp="#wit-g-a"><pb n="344" ed="#liebermann"/>And gif man ætsace, ladige<ptr type="liebermannNote" n="16" target="#IICn_47-1.lnote.oe.16"/> mid þryfealdre lade.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47.1" corresp="#wit-b"><pb n="344" ed="#liebermann"/>And gyf man ætsace, ladige hine mid ðryfealdre lade.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47.1" corresp="#wit-a"><pb n="344" ed="#liebermann"/>And gif man ætsace, ladige mid þryfealdre lade.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="47.1" corresp="#wit-q"><pb n="345" ed="#liebermann"/>Si negetur, triplici lada fiat.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="47.1" corresp="#wit-inst-cn"><pb n="345" ed="#liebermann"/>Et si negauerit, triplici purgatione<ptr type="liebermannNote" n="8" target="#IICn_47-1.lnote.oe.8"/> id neget.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47.1" corresp="#wit-cons-cn"><pb n="345" ed="#liebermann"/>[47, 1] Quodsi inficiatur, triplici purgamine se purget.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="47.1" corresp="#wit-b"><pb n="200" ed="#robertson"/>And gyf man ætsace, ladige hine<ptr type="editorNote" n="3" target="#IICn_47-1.robnote.fn.3"/> mid ðryfealdre lade.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="280" ed="#rabin-doml"/>And gif man ætsace, ladige mid þryfealdre lade.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="345" ed="#liebermann"/>Und wenn man sich [gegen solche Anklage] vertheidigen will, reinige man sich durch dreifachen Beweis.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if one denies [such a charge], let one clear oneself by the threefold clearing.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="201" ed="#robertson"/>And if anyone denies [the charge], he shall clear himself by the triple process of exculpation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="469" ed="#whitelock"/>And if anyone denies it, he is to clear himself with the three-fold process of exculpation.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="281" ed="#rabin-doml"/>And if anyone denies the accusation, he must exonerate himself with the threefold oath.</ab>
        <note type="editorial">BR: added from Gesetze I p. 345, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">ladige mid: ladige hine mid B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_47-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">344</biblScope></bibl><seg type="original" xml:lang="de">hine <hi rend="italic">fügt zu Ld</hi> [<hi rend="italic">aus B</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">hine added by Ld [from B]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_47-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">345</biblScope></bibl><seg type="original" xml:lang="de">negatione <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">negatione Cb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_47-1.lnote.de.0" n="0" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">209</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Beweis 81</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Beweis 81</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_47-1.robnote.fn.3" n="3" source="#robertson"><bibl><biblScope unit="page">200</biblScope></bibl><label>hine</label><seg type="original" xml:lang="en">Om. G, A.</seg></note>
      </div>
