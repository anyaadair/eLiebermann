        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 75.11" corresp="#wit-lat"><pb n="593" ed="#liebermann"/>Si<ptr type="liebermannNote" n="a" target="#Hn_75-11.lnote.oe.a"/> quis moriens<ptr type="liebermannNote" n="1" target="#Hn_75-11.lnote.oe.1"/> debitor<ptr type="liebermannNote" n="2" target="#Hn_75-11.lnote.oe.2"/> testamenta<ptr type="liebermannNote" n="3" target="#Hn_75-11.lnote.oe.3"/> tradicionis uel uendicionis aliqua fecerit, et filios uel filias non habuerit<ptr type="liebermannNote" n="4" target="#Hn_75-11.lnote.oe.4"/>, quicunque de parentibus suis in hereditatem successerit, uel<ptr type="liebermannNote" n="5" target="#Hn_75-11.lnote.oe.5"/> cui weregildum eius, si occisus esset, pertinebat, omne debitum eius iuste restituat et omne factum ydoneare studeat uel culpam incurrat<ptr type="liebermannNote" n="6" target="#Hn_75-11.lnote.oe.6"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 593 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-11.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Hn benutzt den jüngeren Text der Ribuaria; vgl. Schreuer</hi> Verbrechenskonkurrenz 197</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Hn uses the younger text of the Ribuaria; cf. Schreuer</hi> Verbrechenskonkurrenz 197</seg></note>
