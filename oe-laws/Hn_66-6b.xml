      <div type="clause" n="66.6b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 66.6b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 66.6b" corresp="#wit-lat"><pb n="586" ed="#liebermann"/>In hiis uero secundum legem nominati<ptr type="liebermannNote" n="a" target="#Hn_66-6b.lnote.oe.a"/> consacramentales uicini<ptr type="liebermannNote" n="1" target="#Hn_66-6b.lnote.oe.1"/> habendi sunt, quia solus non potuit tantis efficienciis<ptr type="liebermannNote" n="b" target="#Hn_66-6b.lnote.oe.b"/> inuisibilis affuisse.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 586 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-6b.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">zu Eideshelfern ernenne der Richter Nachbarn [des Verklagten]</seg><seg type="translation" xml:lang="en" source="#claude">the judge is to appoint neighbours [of the accused] as oath-helpers</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-6b.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier</hi> ‘Missethaten’; <hi rend="italic">anders</hi> 7, 4</seg><seg type="translation" xml:lang="en" source="#claude">here ‘misdeeds’; otherwise 7, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-6b.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">-ne <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ne Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-6b.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Auswahleid 10; <hi rend="italic">efficientia</hi>: ‘Tun, Bewirken’</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Auswahleid 10; <hi rend="italic">efficientia</hi>: ‘doing, effecting’</seg></note>
