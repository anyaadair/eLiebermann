      <div type="clause" n="11.6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 11.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 11.6" corresp="#wit-lat"><pb n="557" ed="#liebermann"/>Qui periurium super sancta<ptr type="liebermannNote" n="12" target="#Hn_11-6.lnote.oe.12"/> commiserit, perdat manum suam uel dimidiam weram<ptr type="liebermannNote" n="13" target="#Hn_11-6.lnote.oe.13"/> suam, et hoc<ptr type="liebermannNote" n="14" target="#Hn_11-6.lnote.oe.14"/> commune sit domino eius et episcopo.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 557 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-6.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de">cā, <hi rend="italic">davor</hi> s <hi rend="italic">vom Corr. Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">cā, <hi rend="italic">with</hi> s <hi rend="italic">before it by the corrector Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-6.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de">wottam, <hi rend="italic">vom Corr. verb.</hi> werram <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">wottam, <hi rend="italic">corrected by the corrector to</hi> werram <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-6.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vom Corr. übergeschr. Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">written above by the corrector Sc</hi></seg></note>
      </div>
