      <div type="clause" n="3.2">
        <head><ref type="lawCode" target="law:IudDeiIX">Iud Dei IX</ref> 3.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IX 3.2" corresp="#wit-lat"><pb n="416" ed="#liebermann"/>atque oleo<ptr type="liebermannNote" n="27" target="#IudDeiIX_3-2.lnote.oe.27"/> caelesti, hoc<ptr type="liebermannNote" n="28" target="#IudDeiIX_3-2.lnote.oe.28"/> (uel<ptr type="liebermannNote" n="2" target="#IudDeiIX_3-2.lnote.oe.2"/> hęc) iudicii ferrum (uel<ptr type="liebermannNote" n="2" target="#IudDeiIX_3-2.lnote.oe.2"/> -ramenta) cónsecres et benedicas, quatinus, quicquid titubationis<ptr type="liebermannNote" n="29" target="#IudDeiIX_3-2.lnote.oe.29"/> causa perquírimus, per<ptr type="liebermannNote" n="30" target="#IudDeiIX_3-2.lnote.oe.30"/> hoc (uel<ptr type="liebermannNote" n="2" target="#IudDeiIX_3-2.lnote.oe.2"/> hęc) uera<ptr type="liebermannNote" n="31" target="#IudDeiIX_3-2.lnote.oe.31"/> discernantur a fálsis.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 416 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_3-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">rund Eingeklammertes übergeschrieben Ch; fehlt Rj Vt Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">words in round brackets written above in Ch; missing in Rj Vt Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_3-2.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Rj Vt;</hi> examinatióne <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Rj Vt; examinatióne Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_3-2.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de">illud <hi rend="italic">Rj Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">illud Rj Vt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_3-2.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de">tyt. <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">tyt. Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_3-2.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. oben</hi> 2, 4</seg><seg type="translation" xml:lang="en" source="#claude">cf. above 2, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_3-2.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de">a f. u. d. <hi rend="italic">Rj Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">a f. u. d. Rj Vt</seg></note>
