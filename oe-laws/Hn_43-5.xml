    <body>
      <div type="clause" n="43.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 43.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 43.5" corresp="#wit-lat"><pb n="569" ed="#liebermann"/>Si quis diuersos<ptr type="liebermannNote" n="21" target="#Hn_43-5.lnote.oe.21"/> diuersorum<ptr type="liebermannNote" n="21" target="#Hn_43-5.lnote.oe.21"/> feodos teneat, de eo quod ad eorum feudum pertinet cum singulis componat; et de<ptr type="liebermannNote" n="h" target="#Hn_43-5.lnote.oe.h"/> rebus alterius alteri non intendat<ptr type="liebermannNote" n="i" target="#Hn_43-5.lnote.oe.i"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 569 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-5.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">vom [= mit dem] Vermögen, das er von dem einen Herrn zu Lehn trägt, diene (willfahre) er nicht dem andern Lehnsherrn; <hi rend="italic">vgl.</hi> 59, 12. 61, 4; <hi rend="italic">die Rechte und Pflichten einer Person aus verschiedenen Lehnsbanden trennt</hi> 41, 1<hi rend="italic">a</hi>; 3<hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">with [= by means of] the property that he holds in fief from the one lord, let him not serve (comply with) the other feudal lord; cf. 59, 12. 61, 4; the rights and duties of one person arising from different feudal bonds are kept apart in 41, 1a; 3f.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-5.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Altfranz.</hi> entendre: gehorchen</seg><seg type="translation" xml:lang="en" source="#claude">Old French entendre: to obey</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-5.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">-rss. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rss. <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-5.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Lehnwesen 7. a</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Lehnwesen 7. a</seg></note>
      </div>
