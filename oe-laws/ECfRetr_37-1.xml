    <body>
      <div type="clause" n="37.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 37.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 37.1"><pb n="668" ed="#liebermann"/>Hoc autem <hi rend="bold">asserebat ipse</hi><ptr type="liebermannNote" n="12" target="#ECfRetr_37-1.lnote.la.12"/> <hi rend="bold">rex</hi> se<ptr type="liebermannNote" n="13" target="#ECfRetr_37-1.lnote.la.13"/> audisse<ptr type="liebermannNote" n="14" target="#ECfRetr_37-1.lnote.la.14"/> in curia regis Francorum, dum <hi rend="spaced">ibidem moraretur</hi>, <hi rend="bold">quod</hi> usura summa<ptr type="liebermannNote" n="15" target="#ECfRetr_37-1.lnote.la.15"/> radix <hi rend="bold">omnium</hi><ptr type="liebermannNote" n="16" target="#ECfRetr_37-1.lnote.la.16"/> uitiorum<ptr type="liebermannNote" n="17" target="#ECfRetr_37-1.lnote.la.17"/> <hi rend="bold">est.</hi></ab>
        <note type="comparison" source="#liebermann" n="668"><label>printed alongside</label> <ref target="clause:ECf_37-1">ECf 37.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 668 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_37-1.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielmehr</hi> cupiditas: <hi rend="italic">I Tim.</hi> 6, 10</seg><seg type="translation" xml:lang="en" source="#claude">rather cupiditas: I Tim. 6, 10</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_37-1.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">ille <hi rend="italic">Lb Ph Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">ille Lb Ph Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_37-1.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">in cu. r. Fr. se audisse, dum <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">in cu. r. Fr. se audisse, dum Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_37-1.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">audiuisse <hi rend="italic">Lb Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">audiuisse Lb Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_37-1.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_37-1.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">est o. u. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">est o. u. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_37-1.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">malorum <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">malorum Cb</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And this the king himself asserted he had heard in the court of the king of the Franks, while he was staying there, that usury is the chief root of all vices.</ab>
      </div>
