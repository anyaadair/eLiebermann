      <div type="clause" n="7.2">
        <head><ref type="lawCode" target="law:IIIAs">III As</ref> 7.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7.2" corresp="#wit-q"><pb n="170" ed="#liebermann"/>Et<ptr type="liebermannNote" n="46" target="#IIIAs_7-2.lnote.oe.46"/> si prepositus alicui hominum<ptr type="liebermannNote" n="47" target="#IIIAs_7-2.lnote.oe.47"/> eorum concredere<ptr type="liebermannNote" n="48" target="#IIIAs_7-2.lnote.oe.48"/> non audeat, inueniat XII<ptr type="liebermannNote" n="a" target="#IIIAs_7-2.lnote.oe.a"/> plegios cognationis<ptr type="liebermannNote" n="b" target="#IIIAs_7-2.lnote.oe.b"/> sue, qui ei stent in fideiussione sua.<ptr type="liebermannNote" n="49" target="#IIIAs_7-2.lnote.oe.49"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="7.2" corresp="#wit-q"><pb n="144" ed="#attenborough"/>[Et si præpositus alicui eorum hominum concredere non audeat, inveniat XII plegios cognationis suæ, qui ei stent in fideiussione sua.]<ptr type="editorNote" n="16" target="#IIIAs_7-2.attnote.fn.16"/></ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="145" ed="#attenborough"/>And if there is any of those men whom the reeve dare not trust, he shall find twelve supporters from among his kindred, who will stand as security for him.</ab>
        <note type="editorial">Latin only; no German translation in Liebermann. 7.2 is missing from K (Liebermann's base MS) and added in the margin of Co.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_7-2.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">7, 2 <hi rend="italic">fehlt K, am Rande Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">7, 2 lacking in K, in the margin Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_7-2.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">e. h. <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. h. MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_7-2.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">credere <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">credere T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_7-2.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_7-2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">112</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Bürgschaft 6h. 7b. 10</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Bürgschaft 6h. 7b. 10</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_7-2.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">112</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd.</hi> Sippe 16b ff., nämlich des Verdächtigen</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid.</hi> Sippe 16b ff., namely the kindred of the suspect</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_7-2.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">144</biblScope></bibl><label>sua</label><seg type="original" xml:lang="en">Br, M.</seg></note>
      </div>
