      <div type="clause" n="6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 6" corresp="#wit-lat"><ptr type="liebermannNote" n="8" target="#Hn_6.lnote.oe.8"/><pb n="552" ed="#liebermann"/>De<ptr type="liebermannNote" n="9" target="#Hn_6.lnote.oe.9"/> triparticione<ptr type="liebermannNote" n="d" target="#Hn_6.lnote.oe.d"/> regni Anglie<ptr type="liebermannNote" n="e" target="#Hn_6.lnote.oe.e"/> in<ptr type="liebermannNote" n="10" target="#Hn_6.lnote.oe.10"/> diuersitate legum, comitatuum<ptr type="liebermannNote" n="11" target="#Hn_6.lnote.oe.11"/> uel prouinciarum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 552 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 9, 10</seg><seg type="translation" xml:lang="en" source="#claude">cf. 9, 10</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">Britannie <hi rend="italic">Lond</hi> [<hi rend="italic">Grossbritannische Tendenz: vgl.</hi> Leges Angl. Lond. coll. <hi rend="italic">S.</hi> 75]</seg><seg type="translation" xml:lang="en" source="#claude">Britannie Lond [Great-British tendency: cf. Leges Angl. Lond. coll. p. 75]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">C. VII <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">C. VII Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Überschrift von Texthand am Rande schwarz, vom Rubricator roth wiederholt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">heading in the margin in black by the text hand, repeated in red by the rubricator Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">et auersitate <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">et auersitate Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">comm. <hi rend="italic">Sc Hg Rubr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">comm. Sc Hg Rubr.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">315</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> England 1; Wessex; Mercien; Denalagu. Zu deren geographischer Ausdehnung <hi rend="italic">vgl</hi>. Lindekvist <hi rend="italic">Middle Engl. place names Scand</hi>. <hi rend="smallcaps">xxvii</hi> ff.—<hi rend="italic">De</hi>{9} <hi rend="italic">tripert. r. Britannie et</hi>{10} <hi rend="italic">auc</hi>.—6, 1 <hi rend="italic">Anglorum</hi>{12} <hi rend="italic">t. d. et in regno Britannie: in W</hi>., die Wörter <hi rend="italic">et in r. B</hi>. [eine Einschwärzung der <hi rend="italic">Leges Angl. Lond</hi>. Grossbritannischer Tendenz] stehen über der Linie [waren also vermutlich im Originale jenes Londoners erst nachträglich eingefügt] Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> England 1; Wessex; Mercien; Denalagu. On their geographical extent <hi rend="italic">cf</hi>. Lindekvist <hi rend="italic">Middle Engl. place names Scand</hi>. <hi rend="smallcaps">xxvii</hi> ff.—<hi rend="italic">De</hi>{9} <hi rend="italic">tripert. r. Britannie et</hi>{10} <hi rend="italic">auc</hi>.—6, 1 <hi rend="italic">Anglorum</hi>{12} <hi rend="italic">t. d. et in regno Britannie: in W</hi>., the words <hi rend="italic">et in r. B</hi>. [an interpolation of the <hi rend="italic">Leges Angl. Lond</hi>., with their Great-British tendency] stand above the line [and so were presumably inserted only afterwards in the original of that Londoner] Rs</seg></note>
      </div>
