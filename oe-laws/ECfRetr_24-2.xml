      <div type="clause" n="24.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 24.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 24.2"><pb n="649" ed="#liebermann"/>Post<hi rend="bold">ea uero</hi> testimonio<ptr type="liebermannNote" n="24" target="#ECfRetr_24-2.lnote.la.24"/> ipsorum<ptr type="liebermannNote" n="25" target="#ECfRetr_24-2.lnote.la.25"/> pre<hi rend="bold">positus</hi>, de cuius dominio inuentor est, custodiat inuentum<ptr type="liebermannNote" n="4" target="#ECfRetr_24-2.lnote.la.4"/> usque in diem<ptr type="liebermannNote" n="26" target="#ECfRetr_24-2.lnote.la.26"/> crastinum; die <hi rend="bold">autem</hi> crastino cum ali<hi rend="bold">quantis</hi> uicinorum suorum qui uiderunt<ptr type="liebermannNote" n="27" target="#ECfRetr_24-2.lnote.la.27"/> inuentum, ad hundredi eat<ptr type="liebermannNote" n="28" target="#ECfRetr_24-2.lnote.la.28"/> prefectum<ptr type="liebermannNote" n="29" target="#ECfRetr_24-2.lnote.la.29"/>, in quo <hi rend="bold">hundreto</hi><ptr type="liebermannNote" n="4" target="#ECfRetr_24-2.lnote.la.4"/> sua uilla est, et <hi rend="bold">ipsi</hi> ostendat<ptr type="liebermannNote" n="30" target="#ECfRetr_24-2.lnote.la.30"/> totum.</ab>
        <note type="comparison" source="#liebermann" n="649"><label>printed alongside</label> <ref target="clause:ECf_24-2">ECf 24.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 649 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-2.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">testius <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">testius Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-2.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">istorum <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">istorum Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-2.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-2.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">cr. d. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">cr. d. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-2.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">-rint <hi rend="italic">Cb K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rint Cb K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-2.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">adeat <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">adeat K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-2.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">perf. <hi rend="italic">Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">perf. Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-2.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">t. o. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. o. Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But afterwards, on their testimony, let the reeve in whose lordship the finder is keep the find until the next day; and on the next day, with some of his neighbours who saw the find, let him go to the reeve of the hundred, in which hundred his vill is, and show him all.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-2.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hundredo</hi><hi rend="superscript">4</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">hundredo</hi><hi rend="superscript">4</hi> Rs</seg></note>
      </div>
    </body>
