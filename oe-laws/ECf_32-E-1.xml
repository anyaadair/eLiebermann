    <body>
      <div type="clause" n="32 E 1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 32 E 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 32 E 1"><pb n="659" ed="#liebermann"/>‘Fuerunt gentes fere et indomite, et ‘non habuerunt dilectionem Dei’ neque<ptr type="liebermannNote" n="50" target="#ECf_32-E-1.lnote.la.50"/> proximi, quia ‘ab aquilone pandetur omne malum’. Fuerunt enim<ptr type="liebermannNote" n="51" target="#ECf_32-E-1.lnote.la.51"/> ibi Christiani occulte et<ptr type="liebermannNote" n="52" target="#ECf_32-E-1.lnote.la.52"/> non pa[s]sim<ptr type="liebermannNote" n="53" target="#ECf_32-E-1.lnote.la.53"/>. Arturus enim<ptr type="liebermannNote" n="51" target="#ECf_32-E-1.lnote.la.51"/> Christia<pb n="660" ed="#liebermann"/>nus optimus fuit et<ptr type="liebermannNote" n="d" target="#ECf_32-E-1.lnote.la.fn.d"/> fecit ipsos<ptr type="liebermannNote" n="1" target="#ECf_32-E-1.lnote.la.1"/> omnes<ptr type="liebermannNote" n="2" target="#ECf_32-E-1.lnote.la.2"/> baptizare<ptr type="liebermannNote" n="3" target="#ECf_32-E-1.lnote.la.3"/> et unum Deum per totam Norweiam uenerare<ptr type="liebermannNote" n="3" target="#ECf_32-E-1.lnote.la.3"/> et unam fidem Christi semper inuiolatam suscipere<ptr type="liebermannNote" n="4" target="#ECf_32-E-1.lnote.la.4"/> et custodire.</ab>
        <note type="comparisonPrinted" source="#liebermann">Ioan. 5, 42</note>
        <note type="comparisonPrinted" source="#liebermann">Ierem. 1, 14</note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 659–660 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">This passage is not part of ECf or ECf retr: it is one of the additions of the London collection (Leges Anglorum s. XIII in. Londoniis collectae), which Liebermann prints across the page as an insertion into ECf retr. 32 (32 A–E, pp. 655–660). The dictionary cites it as “ECf 32 E …”, so it is kept with ECf here.</note>
        <note type="editorial">Liebermann marks “ab aquilone” with a dagger for his marginal reference to Jeremiah 1, 14.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-E-1.lnote.la.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">659</biblScope></bibl><seg type="original" xml:lang="de">nec <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">nec Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-E-1.lnote.la.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">659</biblScope></bibl><seg type="original" xml:lang="de">autem <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">autem Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-E-1.lnote.la.52" n="52" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">659</biblScope></bibl><seg type="original" xml:lang="de">et n. p. <hi rend="italic">fehlt Ld, wo</hi> ‘desiderantur nonnulla in exemplari’</seg><seg type="translation" xml:lang="en" source="#claude">et n. p. lacking in Ld, where ‘desiderantur nonnulla in exemplari’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-E-1.lnote.la.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">659</biblScope></bibl><seg type="original" xml:lang="de">pſim <hi rend="italic">K, was Riley</hi> persini <hi rend="italic">liest;</hi> deficit hic (<hi rend="italic">d. h. Lücke in der Vorlage</hi>) <hi rend="italic">Co; fehlt Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">pſim K, which Riley reads as persini; deficit hic (i.e. a gap in the exemplar) Co; lacking in Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-E-1.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">659</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">gedenkt der Londoner des Antheils der Angelsachsen an der Bekehrung des Nordens?</hi></seg><seg type="translation" xml:lang="en" source="#claude">is the Londoner thinking of the Anglo-Saxons’ part in the conversion of the North?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-E-1.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">659</biblScope></bibl><seg type="original" xml:lang="de">eos <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">eos Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-E-1.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">659</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co Or Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Co Or Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-E-1.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">659</biblScope></bibl><seg type="original" xml:lang="de">-ri <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ri Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-E-1.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">659</biblScope></bibl><seg type="original" xml:lang="de">cu. et su. <hi rend="italic">Co Or Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cu. et su. Co Or Ld</seg></note>
      </div>
