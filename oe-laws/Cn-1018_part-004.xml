    <body>
      <div type="clause" n="1.2">
        <head>Cn 1018 1.2</head>
        <ab type="editionText" xml:lang="ang" source="#kennedy" n="1.2" corresp="#wit-d"><pb n="72" ed="#kennedy"/>Nu wille we swutelian. hwæt us mæg to ræde for gode. 7 for worlde. gime se þe wille.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-d"><pb n="210" ed="#rabin-doml"/>Nu wille we swutelian hwæt us mæg to ræde for Gode and for worlde, gime se þe wille.</ab>
        <ab type="translation" xml:lang="en" source="#kennedy" corresp="#wit-d"><pb n="72" ed="#kennedy"/>Now we wish to make it known what may be for our advantage in religious and secular matters, let him who will, take heed.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-d"><pb n="211" ed="#rabin-doml"/>Now it is our will to make known that which may be to our advantage before God and the world, take heed who will.</ab>
      </div>
    </body>
