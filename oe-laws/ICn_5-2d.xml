        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-2d.lnote.oe.14-2" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">287</biblScope></bibl><seg type="original" xml:lang="de">eiusdem p. e., li. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">eiusdem p. e., li. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-2d.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">287</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Cb; eingeklammertes übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">the text before the bracket Cb; the bracketed text the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-2d.lnote.oe.15-2" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">287</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">fügt zu Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">in added by Lb S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-2d.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">287</biblScope></bibl><seg type="original" xml:lang="de">reliquit <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">reliquit Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-2d.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">287</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> Af. 20, <hi rend="italic">s. oben S.</hi> 61</seg><seg type="translation" xml:lang="en" source="#claude">there follows Af. 20, see above p. 61</seg></note>
      </div>
