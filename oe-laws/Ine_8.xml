        <note type="liebermannNote" subtype="textual" xml:id="Ine_8.lnote.oe.22-2" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">rihtes <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">rihtes Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_8.lnote.oe.23-2" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">hwil. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hwil. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_8.lnote.oe.star3" n="***" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">hebban <hi rend="italic">Ld; vgl. Quadr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">hebban Ld; cf. Quadr.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_8.lnote.oe.24-2" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">mæg <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mæg Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_8.lnote.oe.25-2" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">mon syllan nylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mon syllan nylle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_8.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">seofon nihte <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">seofon nihte Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_8.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">rihtes wyrþe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">rihtes wyrþe Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_8.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">70</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nur Rechtsweigerung (<hi rend="italic">s. d. Gl</hi> 3. a), nicht etwa Justizweigerung (<hi rend="italic">s. d. Gl</hi>) liegt vor</seg><seg type="translation" xml:lang="en" source="#claude">This is only refusal of right (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 3. a), not, say, denial of justice (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi>)</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_8.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">70</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Q missversteht zu Ap AGu 1 zweimal den Plural</seg><seg type="translation" xml:lang="en" source="#claude">Q, as at Ap AGu 1, twice misunderstands the plural</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_8.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">70</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Vogt 1. 2—d. Es braucht hier kein Sheriff (<hi rend="italic">s. d. Gl</hi>) gemeint zu sein; deutlich wird die Grafschaftsvogtei erst im 10. Jh.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Vogt 1. 2—d. No sheriff (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi>) need be meant here; the shire-reeveship becomes clearly visible only in the 10th cent.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_8.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">70</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘sich Recht’ unnütze Einfügung H’s</seg><seg type="translation" xml:lang="en" source="#claude">‘for himself right’ is a needless insertion of H’s</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_8.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">70</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Wb and</hi> 6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Wb and</hi> 6</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_8.lnote.de.6" n="6" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">70</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Prozessualpfand 1. 6. 11. Vielleicht aus Hl 9; <hi rend="italic">s.</hi> Einl. 11</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Prozessualpfand 1. 6. 11. Perhaps from Hl 9; <hi rend="italic">see</hi> Introduction 11</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_8.lnote.de.7" n="7" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">70</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nicht der Ladung ist Beklagter ungehorsam, sondern er weigert Antwort oder Urteilserfüllung</seg><seg type="translation" xml:lang="en" source="#claude">It is not the summons that the defendant disobeys; rather, he refuses to answer or to fulfil the judgment</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_8.lnote.de.8" n="8" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">70</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">30 Schill. (den 12 Kents entsprechend) für Rechtsweigerung im unteren ordentlichen Gericht auch sonst</seg><seg type="translation" xml:lang="en" source="#claude">30 shill. (corresponding to the 12 of Kent) for refusal of right in the lower ordinary court occur elsewhere too</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_8.lnote.de.9" n="9" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">70</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">nicht ‘den Wert’. Die jüngeren Texte schwächen die Endung ab; ebenso <hi rend="italic">frige</hi> 11B</seg><seg type="translation" xml:lang="en" source="#claude">not ‘the value’. The younger texts weaken the ending; likewise <hi rend="italic">frige</hi> 11B</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_8.attnote.fn.15" n="15" source="#attenborough"><bibl><biblScope unit="page">38</biblScope></bibl><label>him</label><seg type="original" xml:lang="en"><hi rend="italic">hine</hi>. Bu.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_8.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">38</biblScope></bibl><label>oþrum</label><seg type="original" xml:lang="en"><hi rend="italic">oþrum</hi>. om. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_8.attnote.fn.17" n="17" source="#attenborough"><bibl><biblScope unit="page">38</biblScope></bibl><label>ryht</label><seg type="original" xml:lang="en">H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_8.attnote.fn.18" n="18" source="#attenborough"><bibl><biblScope unit="page">38</biblScope></bibl><label>ábiddan</label><seg type="original" xml:lang="en"><hi rend="italic">hebban</hi>. Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_8.attnote.fn.19" n="19" source="#attenborough"><bibl><biblScope unit="page">38</biblScope></bibl><label>sellan</label><seg type="original" xml:lang="en"><hi rend="italic">mon syllan</hi>. Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_8.attnote.fn.20" n="20" source="#attenborough"><bibl><biblScope unit="page">38</biblScope></bibl><label>xxx</label><seg type="original" xml:lang="en"><hi rend="italic">mid xxx</hi>. Bu.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_8.attnote.fn.21" n="21" source="#attenborough"><bibl><biblScope unit="page">38</biblScope></bibl><label>wierðne</label><seg type="original" xml:lang="en"><hi rend="italic">wyrðe</hi>. H, B. <hi rend="italic">weorðe</hi>. Bu.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_8.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">184</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e.</hi> apparently, fulfilment of a legal debt or obligation.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_8.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">184</biblScope></bibl><seg type="original" xml:lang="en">If the word <hi rend="italic">scir</hi> is used in its technical sense, <hi rend="italic">i.e.</hi> ‘county,’ the official indicated is presumably an <hi rend="italic">ealdorman</hi>, since each county was under an <hi rend="italic">ealdorman</hi> at this time (cf. Preamble, note 2). <hi rend="italic">Scirgerefa</hi> (sheriff) does not appear before the 10th century. It is possible however, that <hi rend="italic">scir</hi> is here used in a wider sense.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_8.attnote.n.3" n="3" source="#attenborough"><bibl><biblScope unit="page">184</biblScope></bibl><seg type="original" xml:lang="en">To the king (Liebermann).</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Ine_8.whinote.n.1" n="1" source="#whitelock"><bibl><biblScope unit="page">401</biblScope></bibl><label>official</label><seg type="original" xml:lang="en"><hi rend="italic">scirman</hi></seg></note>
      </div>
