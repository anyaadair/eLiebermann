        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei II 3.2" corresp="#wit-lat"><pb n="406" ed="#liebermann"/>Qui tres<ptr type="liebermannNote" n="54" target="#IudDeiII_3-2.lnote.oe.54"/> pueros Sidrac<ptr type="liebermannNote" n="55" target="#IudDeiII_3-2.lnote.oe.55"/>, Misac et Abdenago, iussu regis Babiloniae<ptr type="liebermannNote" n="56" target="#IudDeiII_3-2.lnote.oe.56"/> in camino ignis<ptr type="liebermannNote" n="f" target="#IudDeiII_3-2.lnote.oe.f"/> accensa fornace, saluasti et<ptr type="liebermannNote" n="57" target="#IudDeiII_3-2.lnote.oe.57"/> inlesos<ptr type="liebermannNote" n="58" target="#IudDeiII_3-2.lnote.oe.58"/> per angelum sanctum<ptr type="liebermannNote" n="59" target="#IudDeiII_3-2.lnote.oe.59"/> tuum eduxisti,</ab>
