      <div type="clause" n="2.5">
        <head><ref type="lawCode" target="law:IudDeiIII">Iud Dei III</ref> 2.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei III 2.5" corresp="#wit-lat"><pb n="408" ed="#liebermann"/>ut cognoscant omnes, quia tu es iustus<ptr type="liebermannNote" n="57" target="#IudDeiIII_2-5.lnote.oe.57"/> iudex, qui saluos facis sperantes in te, et non est alius praeter te, qui uiuis et<ptr type="liebermannNote" n="58" target="#IudDeiIII_2-5.lnote.oe.58"/> regnas Deus<ptr type="liebermannNote" n="59" target="#IudDeiIII_2-5.lnote.oe.59"/> per omnia secula seculorum.<ptr type="liebermannNote" n="60" target="#IudDeiIII_2-5.lnote.oe.60"/></ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Ps. 16, ⁊</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 408 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-5.lnote.oe.57" n="57" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">iud. iust. <hi rend="italic">Ch Ca H</hi></seg><seg type="translation" xml:lang="en" source="#claude">iud. iust. Ch Ca H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-5.lnote.oe.58" n="58" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">et — sec. <hi rend="italic">fehlt Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">et — sec. omitted in Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-5.lnote.oe.59" n="59" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">Deus <hi rend="italic">fehlt Ch Ca Par;</hi> Deus — seculorum <hi rend="italic">fehlt Rj H</hi></seg><seg type="translation" xml:lang="en" source="#claude">Deus omitted in Ch Ca Par; Deus — seculorum omitted in Rj H</seg></note>
