    <body>
      <div type="clause" n="9">
        <head><ref type="lawCode" target="law:IIIAtr">III Atr</ref> 9</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="9" corresp="#wit-h"><pb n="230" ed="#liebermann"/>⁊ nan mann hryðer ne sléa, buton he habbe twégra trywra manna gewitnesse, ⁊ he healde III niht hyde ⁊ heafod; ⁊ sceapes<ptr type="liebermannNote" n="3" target="#IIIAtr_9.lnote.oe.3"/> eallswa.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="9" corresp="#wit-q"><pb n="230" ed="#liebermann"/>Et nemo pecus<ptr type="liebermannNote" n="17" target="#IIIAtr_9.lnote.oe.17"/> aliquod occidat, si non habeat duorum credibilium<ptr type="liebermannNote" n="18" target="#IIIAtr_9.lnote.oe.18"/> hominum testimonium, et<ptr type="liebermannNote" n="19" target="#IIIAtr_9.lnote.oe.19"/> custodiat corium eius tres noctes et caput<ptr type="liebermannNote" n="20" target="#IIIAtr_9.lnote.oe.20"/>; et ouis similiter.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="9" corresp="#wit-h"><pb n="68" ed="#robertson"/>⁊ nan mann hryðer ne sléa, buton he habbe twégra trywra manna gewitnesse, ⁊ he healde III niht hyde ⁊ heafod; ⁊ sceapes eallswa.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="231" ed="#liebermann"/>Und niemand schlachte<ptr type="liebermannNote" n="1" target="#IIIAtr_9.lnote.de.1"/> ein Rind, ohne dass er zweier vertrauenswerther Männer Zeugniss habe, und er behalte drei Nächte lang Haut<ptr type="liebermannNote" n="2" target="#IIIAtr_9.lnote.de.2"/> und Kopf<ptr type="liebermannNote" n="3" target="#IIIAtr_9.lnote.de.3"/> [des Rindes]; und eines Schafes ebenso.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let no one slaughter an ox unless he has the witness of two trustworthy men, and let him keep the hide and head [of the ox] for three nights; and likewise [those] of a sheep.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-h"><pb n="69" ed="#robertson"/>And no-one shall kill a cow unless he has two trustworthy men as witnesses, and he shall keep the hide and the head<ptr type="editorNote" n="1" target="#IIIAtr_9.robnote.n.1"/> for three days; and those of a sheep likewise.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h"><pb n="446" ed="#whitelock"/>And no one is to slaughter an ox, unless he has the witness of two trusty men; and he is to keep the hide and the head for three days, and those of a sheep likewise.</ab>
        <note type="editorial">Some Quadr. MSS read ‘emat’ (buy) for ‘occidat’.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAtr_9.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">230</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">emat</hi> p. a., si <hi rend="italic">MHkBr; vgl. o. S.</hi> 228*</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">emat</hi> p. a., si <hi rend="italic">MHkBr</hi>; cf. above p. 228*</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAtr_9.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">230</biblScope></bibl><seg type="original" xml:lang="de">h. c. <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. c. <hi rend="italic">MHkBr</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAtr_9.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">230</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAtr_9.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">230</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">capre</hi> <hi rend="italic">R;</hi> capud <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">capre</hi> <hi rend="italic">R;</hi> capud <hi rend="italic">T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAtr_9.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">230</biblScope></bibl><seg type="original" xml:lang="de">c <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">c written above</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIIAtr_9.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">160</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Q <hi rend="smallcaps">ii</hi> verschlechtert ‘schlachte’ in ‘kaufe’, auch in der Rubrik. <hi rend="italic">Vgl. Gl</hi> Hehlerei 6</seg><seg type="translation" xml:lang="en" source="#claude">Q <hi rend="smallcaps">ii</hi> corrupts ‘slaughter’ into ‘buy’, in the rubric too. <hi rend="italic">Cf. Gl</hi> Hehlerei 6</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIIAtr_9.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">160</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Fell 1; dieses trug Merkmal; <hi rend="italic">s. d. Gl</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Fell 1; the hide bore a mark; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIIAtr_9.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">160</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nur Eine Hs. des Q verderbt den Text in ‘Ziege’</seg><seg type="translation" xml:lang="en" source="#claude">Only one MS of Q corrupts the text into ‘goat’</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIAtr_9.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="en">Cf. Bateson, <hi rend="italic">Borough Customs</hi>, <hi rend="smallcaps">i</hi>. p. 59: ownership of cattle attached within the bounds of the city of Waterford about 1300 was to be proved <hi rend="italic">par pel e par quier</hi>. The hide presumably would be branded with the owner’s mark.</seg></note>
      </div>
