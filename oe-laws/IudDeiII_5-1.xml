      <div type="clause" n="5.1">
        <head><ref type="lawCode" target="law:IudDeiII">Iud Dei II</ref> 5.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei II 5.1" corresp="#wit-lat"><pb n="407" ed="#liebermann"/>Et ferrum proferatur, quod a culpato<ptr type="liebermannNote" n="66" target="#IudDeiII_5-1.lnote.oe.66"/> coram<ptr type="liebermannNote" n="67" target="#IudDeiII_5-1.lnote.oe.67"/> omnibus accipiatur et per mensuram nouem<ptr type="liebermannNote" n="68" target="#IudDeiII_5-1.lnote.oe.68"/> pedum portetur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 407 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_5-1.lnote.oe.66" n="66" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-a <hi rend="italic">vom Rubricator übergeschr. Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-a written above by the rubricator in Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_5-1.lnote.oe.67" n="67" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">c. o. <hi rend="italic">fehlt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. o. omitted in Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_5-1.lnote.oe.68" n="68" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">nonum <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">nonum Ch</seg></note>
