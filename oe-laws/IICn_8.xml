        <note type="liebermannNote" subtype="textual" xml:id="IICn_8.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">315</biblScope></bibl><seg type="original" xml:lang="de">-nes <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nes Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_8.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">315</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. aus</hi> -ris <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected from -ris Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_8.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">315</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">beginnt wieder Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hk begins again</seg></note>
