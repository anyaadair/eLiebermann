    <body>
      <div type="clause" n="30.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 30.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 30.1"><pb n="652" ed="#liebermann"/>Et quod<ptr type="liebermannNote" n="32" target="#ECfRetr_30-1.lnote.la.32"/> Angli uocant hundretum<ptr type="liebermannNote" n="33" target="#ECfRetr_30-1.lnote.la.33"/>, supradicti comitatus uocant wapentagium<ptr type="liebermannNote" n="34" target="#ECfRetr_30-1.lnote.la.34"/>.</ab>
        <note type="comparison" source="#liebermann" n="652"><label>printed alongside</label> <ref target="clause:ECf_30-1">ECf 30.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 652 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-1.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt</hi> 31, 1. <hi rend="italic">Ungenau für die fünf in</hi> 30 <hi rend="italic">genannten</hi> (<hi rend="italic">vollends für die</hi> 13) <hi rend="italic">Grafschaften</hi></seg><seg type="translation" xml:lang="en" source="#claude">repeated at 31, 1. Inexact for the five shires named in 30 (and still more so for the 13)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-1.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-1.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">wapentagium <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">wapentagium Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-1.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">-tachium <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tachium K</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And what the English call a hundred, the above-mentioned shires call a wapentake.</ab>
      </div>
    </body>
