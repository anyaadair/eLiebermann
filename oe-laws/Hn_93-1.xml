      <div type="clause" n="93.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 93.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 93.1" corresp="#wit-lat"><pb n="609" ed="#liebermann"/>Si uulnus eueniat<ptr type="liebermannNote" n="19" target="#Hn_93-1.lnote.oe.19"/> alicui, siue<ptr type="liebermannNote" n="20" target="#Hn_93-1.lnote.oe.20"/> menbri truncacione uel debilitacione uel diffractione<ptr type="liebermannNote" n="21" target="#Hn_93-1.lnote.oe.21"/>, in nudo et manifesto — ut ante<ptr type="liebermannNote" n="f" target="#Hn_93-1.lnote.oe.f"/> capillos, ante manicam, sub genibus —, duppliciter<ptr type="liebermannNote" n="22" target="#Hn_93-1.lnote.oe.22"/> emendandum<ptr type="liebermannNote" n="23" target="#Hn_93-1.lnote.oe.23"/> est supra id quod in capite sub capillis<ptr type="liebermannNote" n="24" target="#Hn_93-1.lnote.oe.24"/>, uel in menbris sub uestibus, in occulto, fieret.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 609 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_93-1.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">609</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 93, 26. 94, 2; Abt. 59 <hi rend="italic">f.</hi>; Leis Wl 10, 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 93, 26. 94, 2; Abt. 59 <hi rend="italic">f.</hi>; Leis Wl 10, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_93-1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">609</biblScope></bibl><seg type="original" xml:lang="de">a. fiat <hi rend="italic">K Co;</hi> fiat <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. fiat <hi rend="italic">K Co;</hi> fiat <hi rend="italic">Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_93-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">609</biblScope></bibl><seg type="original" xml:lang="de">sine <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">sine <hi rend="italic">K</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_93-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">609</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so K;</hi> disfra. <hi rend="italic">Sl;</hi> defra. <hi rend="italic">Co Or Gi Tw;</hi> diffa. <hi rend="italic">Sc Hg;</hi> disfa. <hi rend="italic">Edd.</hi> (<hi rend="italic">was aber</hi> Hinrichtung, Verstümmelung des ganzen Menschen; <hi rend="italic">auch ist</hi> Verstümmelung eines Gliedes <hi rend="italic">schon</hi> truncatio)</seg><seg type="translation" xml:lang="en" source="#claude">thus K; disfra. Sl; defra. Co Or Gi Tw; diffa. Sc Hg; disfa. edd. (<hi rend="italic">but that means</hi> execution, mutilation of the whole person; <hi rend="italic">and</hi> mutilation of a limb <hi rend="italic">is already</hi> truncatio)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_93-1.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">609</biblScope></bibl><seg type="original" xml:lang="de">displicet <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">displicet <hi rend="italic">Co Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_93-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">609</biblScope></bibl><seg type="original" xml:lang="de">-dus <hi rend="italic">Wh Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dus <hi rend="italic">Wh Wi</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_93-1.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">609</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">Sc Hg add et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_93-1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Gliederbussen 11—<hi rend="italic">Si u. al. fiat sine</hi>{20} <hi rend="italic">m</hi>. wohl besser: ‘der Grundsatz trifft bei Verlust eines Gliedes nicht zu’—<hi rend="italic">diffa</hi>.{21}—93, 2 <hi rend="italic">perforatum</hi>{25}—93, 3 <hi rend="italic">sit</hi>{14} fehlt—93, 5 <hi rend="italic">u. denarii</hi>. 93, 5a <hi rend="italic">ubi</hi>{28}— 93, 6 <hi rend="italic">-tant</hi>{34}—<hi rend="italic">-cindere</hi>{35}—<hi rend="italic">consc</hi>.{36}—<hi rend="italic">moluntur</hi>{38} <hi rend="italic">et inmassantur</hi>—93, 7 ohne <hi rend="italic">co</hi>.{14}—93, 8 <hi rend="italic">fracte</hi>{44} <hi rend="italic">XV s. emendetur</hi>—93, 10 fehlt—93, 13 <hi rend="italic">super</hi>{1}—93, 17 <hi rend="italic">Medicus</hi>—93, 18 <hi rend="italic">sexdecim</hi>{4}—93, 20 <hi rend="italic">-dandum</hi>{9} <hi rend="italic">si transpungtus</hi>—93, 21 <hi rend="italic">C. tranf</hi>.—93, 23 <hi rend="italic">p. m</hi>.{11}—93, 27 <hi rend="italic">-tet</hi>{15}—93, 31 <hi rend="italic">alacui, pa</hi>.—93, 33 <hi rend="italic">mulcetur</hi>{27}—93, 34 <hi rend="italic">ex., sint ad emendacionem XV sol</hi>. in den Text zu setzen, weil Q näher und in beiden Hss.-Klassen—93, 35 <hi rend="italic">am</hi>.{29}—93, 36 <hi rend="italic">emendetur</hi>. 93, 37 <hi rend="italic">ita</hi>{2} fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Gliederbussen 11—<hi rend="italic">Si u. al. fiat sine</hi>{20} <hi rend="italic">m</hi>. probably better: ‘the principle does not apply in the case of the loss of a limb’—<hi rend="italic">diffa</hi>.{21}—93, 2 <hi rend="italic">perforatum</hi>{25}—93, 3 <hi rend="italic">sit</hi>{14} missing—93, 5 <hi rend="italic">u. denarii</hi>. 93, 5a <hi rend="italic">ubi</hi>{28}— 93, 6 <hi rend="italic">-tant</hi>{34}—<hi rend="italic">-cindere</hi>{35}—<hi rend="italic">consc</hi>.{36}—<hi rend="italic">moluntur</hi>{38} <hi rend="italic">et inmassantur</hi>—93, 7 without <hi rend="italic">co</hi>.{14}—93, 8 <hi rend="italic">fracte</hi>{44} <hi rend="italic">XV s. emendetur</hi>—93, 10 missing—93, 13 <hi rend="italic">super</hi>{1}—93, 17 <hi rend="italic">Medicus</hi>—93, 18 <hi rend="italic">sexdecim</hi>{4}—93, 20 <hi rend="italic">-dandum</hi>{9} <hi rend="italic">si transpungtus</hi>—93, 21 <hi rend="italic">C. tranf</hi>.—93, 23 <hi rend="italic">p. m</hi>.{11}—93, 27 <hi rend="italic">-tet</hi>{15}—93, 31 <hi rend="italic">alacui, pa</hi>.—93, 33 <hi rend="italic">mulcetur</hi>{27}—93, 34 <hi rend="italic">ex., sint ad emendacionem XV sol</hi>. to be put in the text, since Q is closer and it is in both classes of MSS—93, 35 <hi rend="italic">am</hi>.{29}—93, 36 <hi rend="italic">emendetur</hi>. 93, 37 <hi rend="italic">ita</hi>{2} missing Rs</seg></note>
      </div>
