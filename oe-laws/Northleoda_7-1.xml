    <body>
      <div type="clause" n="7.1">
        <head><ref type="lawCode" target="law:Northleoda">Norðleoda</ref> 7.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.1" corresp="#wit-d"><pb n="460" ed="#liebermann"/>And gif he ne geþeo buton to healfre hide, þonne si his wer LXXX scill'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.1" corresp="#wit-h"><pb n="460" ed="#liebermann"/>⁊ gif he ne geþeo butan to healfre hide, þonne sy his wergyld LXXX scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.1" corresp="#wit-ld"><pb n="460" ed="#liebermann"/>Ac<ptr type="liebermannNote" n="b" target="#Northleoda_7-1.lnote.oe.b"/> he ne biþ butan to healfhyda<ptr type="liebermannNote" n="a" target="#Northleoda_7-1.lnote.oe.a"/> gerysen<ptr type="liebermannNote" n="*" target="#Northleoda_7-1.lnote.oe.star"/>, ðonne sie his were LXXX scill.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7.1" corresp="#wit-q"><pb n="461" ed="#liebermann"/>Et si non assurgat<ptr type="liebermannNote" n="*" target="#Northleoda_7-1.lnote.oe.star-2"/> nisi ad dimidiam hidam<ptr type="liebermannNote" n="10" target="#Northleoda_7-1.lnote.oe.10"/>, tunc sit wera eius<ptr type="liebermannNote" n="11" target="#Northleoda_7-1.lnote.oe.11"/> (id est soluendi<ptr type="liebermannNote" n="12" target="#Northleoda_7-1.lnote.oe.12"/> pretium) LXXX sol.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-h"><pb n="12" ed="#rabin-doml"/>And gif he ne geþeo butan to healfre hide, þonne sy his wergild LXXX scillinga.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="461" ed="#liebermann"/>Und (Aber <hi rend="italic">Ld<ptr type="liebermannNote" n="c" target="#Northleoda_7-1.lnote.de1.c"/></hi>) wenn er nur zu ¹/₂ Hid<ptr type="liebermannNote" n="d" target="#Northleoda_7-1.lnote.de1.d"/> kommt (gestiegen ist <hi rend="italic">lq</hi>), dann sei sein Wergeld 80 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And (But, Ld) if he only attains to ½ hide (has risen, lq), then let his wergild be 80 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-d"><pb n="477" ed="#whitelock"/>And if he does not prosper beyond half a hide, then his wergild is to be 80 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-h">And if he does not prosper to more than half of a hide, then his wergild will be eighty shillings.</ab>
        <note type="comparison" source="#liebermann" n="461"><ref target="clause:Ine_32">Ine 32</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd.</note>
        <note type="editorial">Ld's ‘healfhyda’ occurs only here. Liebermann compares Ine 32.</note>
        <note type="textual" source="#rabin-doml">wergild: wer D</note>
        <note type="liebermannNote" subtype="textual" xml:id="Northleoda_7-1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">460</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> gif</seg><seg type="translation" xml:lang="en" source="#claude">supply gif</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Northleoda_7-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">460</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Northleoda_7-1.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">460</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">weniger archaisch, Abweichung vom Original</hi></seg><seg type="translation" xml:lang="en" source="#claude">less archaic, a departure from the original</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Northleoda_7-1.lnote.oe.star-2" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">461</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zunächst zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">closest to Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Northleoda_7-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">461</biblScope></bibl><seg type="original" xml:lang="de">hyd. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">hyd. T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Northleoda_7-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">461</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Lond;</hi> w., i. pr. so. eum <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Lond; w., i. pr. so. eum the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Northleoda_7-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">461</biblScope></bibl><seg type="original" xml:lang="de">eum <hi rend="italic">darüber Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">eum written above Co</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="Northleoda_7-1.lnote.de1.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">461</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ebenso</hi> Mirce 3, 1</seg><seg type="translation" xml:lang="en" source="#claude">likewise Mirce 3, 1</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="Northleoda_7-1.lnote.de1.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">461</biblScope></bibl><seg type="original" xml:lang="de">Halbhid <hi rend="italic">Ld; das Wort findet sich nur hier</hi></seg><seg type="translation" xml:lang="en" source="#claude">Half-hide Ld; the word occurs only here</seg></note>
      </div>
