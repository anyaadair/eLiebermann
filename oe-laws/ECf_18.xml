    <body>
      <div type="clause" n="18">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 18</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 18"><pb n="643" ed="#liebermann"/>Tamen si<ptr type="liebermannNote" n="f" target="#ECf_18.lnote.la.fn.f"/> aliquis<ptr type="liebermannNote" n="18" target="#ECf_18.lnote.la.18"/> forisfactus requisierit<ptr type="liebermannNote" n="19" target="#ECf_18.lnote.la.19"/> misericordiam, eius<ptr type="liebermannNote" n="20" target="#ECf_18.lnote.la.20"/> timore mortis uel membrorum pro forefacto<ptr type="liebermannNote" n="21" target="#ECf_18.lnote.la.21"/> suo, potest<ptr type="liebermannNote" n="22" target="#ECf_18.lnote.la.22"/> ei condonare, si<ptr type="liebermannNote" n="g" target="#ECf_18.lnote.la.fn.g"/> placet, lege<ptr type="liebermannNote" n="23" target="#ECf_18.lnote.la.23"/> sue<ptr type="liebermannNote" n="24" target="#ECf_18.lnote.la.24"/> dignitatis.</ab>
        <note type="comparison" source="#liebermann" n="643"><label>printed alongside</label> <ref target="clause:ECfRetr_18">ECf retr 18</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 643 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">vor <hi rend="italic">Verhaftung und Urtheil, wie aus dem Gegensatz zu</hi> 18, 1 <hi rend="italic">folgt</hi></seg><seg type="translation" xml:lang="en" source="#claude">before arrest and judgement, as follows from the contrast with 18, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">der König</hi> kann, <hi rend="italic">die Kirche</hi> muss <hi rend="italic">den Zufluchtsuchenden vor Leibesstrafe schützen; Pollock-M.</hi> HEL. II 481</seg><seg type="translation" xml:lang="en" source="#claude">the king can, the Church must, protect the one seeking refuge from corporal punishment; Pollock–M., HEL. II 481</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">quis f. sit et r. <hi rend="italic">Ad Do;</hi> forefaciens <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">quis f. sit et r. Ad Do; forefaciens Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">quesierit <hi rend="italic">Hk;</hi> requierit <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">quesierit Hk; requierit Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">regis <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">regis Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Rl Hk;</hi> forisf. <hi rend="italic">S Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Rl Hk; forisf. S Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">poterit <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">poterit Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">leg’ s. dignitati <hi rend="italic">Hk;</hi> legi <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">leg’ s. dignitati Hk; legi Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">d. s. <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. s. Ad</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Yet if anyone who has committed an offence asks his mercy, in fear of death or of limbs, for his offence, he can pardon him, if he pleases, by the law of his dignity.</ab>
      </div>
    </body>
