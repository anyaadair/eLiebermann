    <body>
      <div type="clause" n="61.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 61.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="61.1" corresp="#wit-g-a"><pb n="350" ed="#liebermann"/>Gif he samwyrce<ptr type="liebermannNote" n="*" target="#IICn_61-1.lnote.oe.star"/>, bete<ptr type="liebermannNote" n="14" target="#IICn_61-1.lnote.oe.14"/>, be þam þe seo dæd<ptr type="liebermannNote" n="15" target="#IICn_61-1.lnote.oe.15"/> sy, <hi rend="italic">hine</hi>.<ptr type="liebermannNote" n="**" target="#IICn_61-1.lnote.oe.star2"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="61.1" corresp="#wit-b"><pb n="350" ed="#liebermann"/>Gyf he samwyrce, bete be ðam ðe seo dæd sy.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="61.1" corresp="#wit-a"><pb n="350" ed="#liebermann"/>Gif he samwyrce, bete be þam þe seo dæde sy.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="61.1" corresp="#wit-q"><pb n="351" ed="#liebermann"/>Si non<ptr type="liebermannNote" n="18" target="#IICn_61-1.lnote.oe.18"/> perfecerit, emendationem<ptr type="liebermannNote" n="19" target="#IICn_61-1.lnote.oe.19"/> inde faciat (emendet), iuxta quod factum sit.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="61.1" corresp="#wit-cons-cn"><pb n="351" ed="#liebermann"/>[61, 1] Si uero semifecerit, emendet iuxta modum facti.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="61.1" corresp="#wit-b"><pb n="204" ed="#robertson"/>Gyf he samwyrce<ptr type="editorNote" n="6" target="#IICn_61-1.robnote.fn.6"/>, bete be ðam ðe seo dæd sy<ptr type="editorNote" n="7" target="#IICn_61-1.robnote.fn.7"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="284" ed="#rabin-doml"/>Gif he samwyrce, bete, be þam þe seo dæd sy, hine.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="351" ed="#liebermann"/>Wenn er halb[schweren<ptr type="liebermannNote" n="1" target="#IICn_61-1.lnote.de.1"/> Friedensbruch] verübt, büsse er (ihn <hi rend="italic">G</hi>), je<ptr type="liebermannNote" n="2" target="#IICn_61-1.lnote.de.2"/> nachdem die That ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he commits a half[-weight breach of peace], let him atone (for it, G) according to what the deed is.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="205" ed="#robertson"/>If he is guilty of a minor deed of violence<ptr type="editorNote" n="1" target="#IICn_61-1.robnote.n.1"/>, he shall make amends according to the nature of the deed.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="471" ed="#whitelock"/>If he commits a partial breach,<ptr type="editorNote" n="10" target="#IICn_61-1.whinote.n.10"/> he is to compensate in proportion to the deed.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="285" ed="#rabin-doml"/>If anyone commits a lesser crime, he is to compensate the victim according to the seriousness of the offense.</ab>
        <note type="editorial">G's ‘hine’ is written with the abbreviation ·N· and is missing in the other MSS. Ld reads ‘ran [robbery] wyrce’ for ‘samwyrce’.; BR: added from Gesetze I p. 351, October 2026 (MS Cons); AY: corrected against Rabin p. 284 / 285, October 2026 (was “~N~”, now “-N-”)</note>
        <note type="textual" source="#rabin-doml">hine: -N- G</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_61-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de">autem <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">autem Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_61-1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de">n. p. <hi rend="italic">übergeschr. Dm; fehlt KR</hi></seg><seg type="translation" xml:lang="en" source="#claude">n. p. written above Dm; lacking in KR</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_61-1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de">e. i. f. <hi rend="italic">unterstrichen Dm; fehlt THkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. i. f. underlined Dm; lacking in THkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_61-1.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">350</biblScope></bibl><seg type="original" xml:lang="de">ran [‘<hi rend="italic">Raub</hi>’] wyrce <hi rend="italic">Ld</hi> [<hi rend="italic">nicht original, aber vielleicht Fehler des</hi> 11—13. <hi rend="italic">Jhs.</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">ran [‘robbery’] wyrce Ld [not original, but perhaps an error of the 11th—13th cent.]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_61-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">350</biblScope></bibl><seg type="original" xml:lang="de">bæte <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">bæte Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_61-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">350</biblScope></bibl><seg type="original" xml:lang="de">dæde <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">dæde Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_61-1.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">350</biblScope></bibl><seg type="original" xml:lang="de">·N· <hi rend="italic">G; fehlt übrigen</hi> [<hi rend="italic">besser</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">·N· G; lacking in the others [better]</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_61-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">210</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘mitwirkt’ (durch Verwechselung von <hi rend="italic">sám</hi> mit <hi rend="italic">sam</hi>). Toller weist <hi rend="italic">sámworht</hi> ‘unvollendet’ auch sonst nach und 10 Composita, in denen <hi rend="italic">sám</hi>- ‘halb-’ bedeutet. <hi rend="italic">Vgl. Gl</hi> Halbverletzung 2</seg><seg type="translation" xml:lang="en" source="#claude">Not ‘takes part in’ (through confusion of <hi rend="italic">sám</hi> with <hi rend="italic">sam</hi>). Toller shows <hi rend="italic">sámworht</hi> ‘unfinished’ elsewhere too, and 10 compounds in which <hi rend="italic">sám</hi>- means ‘half-’. <hi rend="italic">Cf. Gl</hi> Halbverletzung 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_61-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">210</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Namentlich wohl Verwundung.—Bei Baiern kostet aber Diebstahl <hi rend="italic">in exercitu</hi> Handlösung (Brunner II 644), also halbes Wergeld nach Agsächs. Recht. Vielleicht damit hängt Ld's Variante <hi rend="italic">ran</hi> zusammen</seg><seg type="translation" xml:lang="en" source="#claude">Probably wounding in particular.—Among the Bavarians, however, theft <hi rend="italic">in exercitu</hi> costs the redemption of the hand (Brunner II 644), i.e. half the wergild by Anglo-Saxon law. Ld's variant <hi rend="italic">ran</hi> is perhaps connected with this</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_61-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">357</biblScope></bibl><seg type="original" xml:lang="en">Lit. ‘half perpetrates,’ <hi rend="italic">i.e.</hi> probably, without the taking of life; cf. for a similar distinction I Cn. 2, 3; 3. Ld reads <hi rend="italic">ran wyrce</hi>, <hi rend="italic">i.e.</hi> commits robbery.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_61-1.robnote.fn.6" n="6" source="#robertson"><bibl><biblScope unit="page">204</biblScope></bibl><label>samwyrce</label><seg type="original" xml:lang="en"><hi rend="italic">ran wyrce</hi> Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_61-1.robnote.fn.7" n="7" source="#robertson"><bibl><biblScope unit="page">204</biblScope></bibl><label>sy</label><seg type="original" xml:lang="en">G adds ·<hi rend="italic">N</hi>·.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IICn_61-1.whinote.n.10" n="10" source="#whitelock"><bibl><biblScope unit="page">471</biblScope></bibl><label>breach</label><seg type="original" xml:lang="en">i.e. by a minor offence</seg></note>
      </div>
    </body>
