        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-5b.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">Indici. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Indici. <hi rend="italic">Lond</hi></seg></note>
