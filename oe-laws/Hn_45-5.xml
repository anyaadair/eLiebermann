      <div type="clause" n="45.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 45.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 45.5" corresp="#wit-lat"><pb n="570" ed="#liebermann"/>Et si quis delegiatus<ptr type="liebermannNote" n="k" target="#Hn_45-5.lnote.oe.k"/><ptr type="liebermannNote" n="18" target="#Hn_45-5.lnote.oe.18"/> legalem<ptr type="liebermannNote" n="19" target="#Hn_45-5.lnote.oe.19"/> hominem accuset, funestam<ptr type="liebermannNote" n="l" target="#Hn_45-5.lnote.oe.l"/> dicimus uocem eius.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 570 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-5.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">desleié: rechtsunfähig; <hi rend="italic">vgl.</hi> illeg. 5, 3</seg><seg type="translation" xml:lang="en" source="#claude">desleié: without legal capacity; cf. illeg. 5, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-5.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Pseudo-Isidor p.</hi> 239: <hi rend="italic">Verbrecher</hi> nullatenus ad accusationem erunt admittendi, quia funesta est vox eorum; <hi rend="italic">vgl. Angilram</hi> 763</seg><seg type="translation" xml:lang="en" source="#claude">cf. Pseudo-Isidor p. 239: criminals nullatenus ad accusationem erunt admittendi, quia funesta est vox eorum; cf. Angilram 763</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-5.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">delig. <hi rend="italic">Lond;</hi> dilig. <hi rend="italic">Wh Wi Spelman</hi> Glossar. [<hi rend="italic">irrig von</hi> ligius <hi rend="italic">ableitend</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">delig. Lond; dilig. Wh Wi Spelman Glossar. [wrongly deriving it from ligius]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-5.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-5.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> bescholten 8; Klage 13—<hi rend="italic">delig</hi>.{18} ohne <hi rend="italic">legalem</hi>—46 <hi rend="italic">De inplacit' dominorum</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> bescholten 8; Klage 13—<hi rend="italic">delig</hi>.{18} without <hi rend="italic">legalem</hi>—46 <hi rend="italic">De inplacit' dominorum</hi> Rs</seg></note>
