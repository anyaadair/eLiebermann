d="bold">1</hi>) <hi rend="italic">fassen, dingfest machen:</hi> banan <ref type="lawCode" target="law:Hl">Hl</ref> 2. 4. <ref type="lawCode" target="law:IIAtr">II Atr</ref> 6; hine (<hi rend="italic">Herrnlosen</hi>) <ref type="lawCode" target="law:IIAs">II As</ref> 2,1 <hi rend="bold">2</hi>) <hi rend="italic">erwerben: Geldwert</hi> <ref type="lawCode" target="law:IAs">I As</ref> 5 <ref type="lawCode" target="law:Ld">Ld</ref>; gestrinan <ref type="lawCode" target="law:G">G</ref> <ref type="lawCode" target="law:D">D</ref>; <hi rend="italic">Land</hi> <ref type="lawCode" target="law:Becwaeth">Becwæð</ref> 1; <hi rend="italic">Fahrhabe</hi> <ref type="lawCode" target="law:IICn">II Cn</ref> 23,1. <ref type="lawCode" target="law:Forf">Forf</ref> 3,2. <ref type="lawCode" target="law:Swer">Swer</ref> 3,1; bade ham <hi rend="italic">Abgepfändetes heimschaffen</hi> <ref type="lawCode" target="law:Duns">Duns</ref> 3; <hi rend="italic">beschaffen:</hi> wif <ref type="lawCode" target="law:Abt">Abt</ref> 31; læce <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 16; him spalan <hi rend="italic">sich Vertreter</hi> Wl lad 2,1 <hi rend="bold">3</hi>) <hi rend="italic">erlangen:</hi> þe riht æt <hi rend="italic">von welchem Rechtserfüllung</hi> <ref type="lawCode" target="law:IIAs">II As</ref> 2. <ref type="lawCode" target="law:Duns">Duns</ref> 2,2; clænsunge <hi rend="italic">besorgen</hi> <ref type="lawCode" target="law:VIIIAtr">VIII Atr</ref> 3 = <ref type="lawCode" target="law:ICn">I Cn</ref> 2,5; had <hi rend="italic">Weihe nehmen</hi> <ref type="lawCode" target="law:Northu">Northu</ref> 12 | <hi rend="italic">m <ref type="abbreviation" target="gram:Praeteritum"><abbr>ptt</abbr></ref> <ref type="abbreviation" target="gram:Particip"><abbr>pc</abbr></ref>:</hi> gesungen <hi rend="italic">lasse singen</hi> <ref type="lawCode" target="law:VIAs">VI As</ref> 8,6 <hi rend="bold">4</hi>) bearn <hi rend="italic">Kind zeugen</hi> <ref type="lawCode" target="law:Af">Af</ref> 65 <ref type="lawCode" target="law:B">B</ref>; gestrienan <ref type="lawCode" target="law:H">H</ref> <ref type="lawCode" target="law:Ld">Ld</ref> <hi rend="bold">5</hi>) ~, þæt <hi rend="italic">erlangen, durchsetzen, dass</hi> <ref type="lawCode" target="law:Northleoda">Norðleod</ref> 10 <ref type="lawCode" target="law:Ld">Ld</ref>; geþeo <ref type="lawCode" target="law:D">D</ref> <ref type="lawCode" target="law:H">H</ref>) <hi rend="bold">6</hi>) <hi rend="italic">sich zu Eidhelfern gewinnen</hi> <ref type="lawCode" target="law:IEw">I Ew</ref> 1,4. <ref type="lawCode" target="law:IIAs">II As</ref> 9. <ref type="lawCode" target="law:IICn">II Cn</ref> 65</dictScrap>
