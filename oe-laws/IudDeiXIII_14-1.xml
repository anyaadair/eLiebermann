      <div type="clause" n="14.1">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 14.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 14.1" corresp="#wit-lat"><pb n="424" ed="#liebermann"/>Hęc autem<ptr type="liebermannNote" n="53" target="#IudDeiXIII_14-1.lnote.oe.53"/> omnia debes<ptr type="liebermannNote" n="54" target="#IudDeiXIII_14-1.lnote.oe.54"/> facere ieiunus; neque illi comedant<ptr type="liebermannNote" n="d" target="#IudDeiXIII_14-1.lnote.oe.d"/> qui ipsos in aquam mittunt<ptr type="liebermannNote" n="55" target="#IudDeiXIII_14-1.lnote.oe.55"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 424 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_14-1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. oben</hi> I 23, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. above I 23, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_14-1.lnote.oe.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_14-1.lnote.oe.54" n="54" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">ieiunis illis, ab aliis pariter ieiunis fieri debent <hi rend="italic">Tr, ohne</hi> fa.— mittunt</seg><seg type="translation" xml:lang="en" source="#claude">ieiunis illis, ab aliis pariter ieiunis fieri debent Tr, without fa.— mittunt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_14-1.lnote.oe.55" n="55" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> XIV <hi rend="italic">Vt2 Tr Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">followed by XIV Vt2 Tr Mg</seg></note>
