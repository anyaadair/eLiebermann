    <body>
      <div type="clause" n="25.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 25.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 25.1" corresp="#wit-lat"><pb n="562" ed="#liebermann"/>Si exurgat placitum inter homines alicuius<ptr type="liebermannNote" n="6" target="#Hn_25-1.lnote.oe.6"/> baronum<ptr type="liebermannNote" n="c" target="#Hn_25-1.lnote.oe.c"/> socnam suam<ptr type="liebermannNote" n="7" target="#Hn_25-1.lnote.oe.7"/> habentium, tractetur placitum in curia domini sui<ptr type="liebermannNote" n="d" target="#Hn_25-1.lnote.oe.d"/> de<ptr type="liebermannNote" n="8" target="#Hn_25-1.lnote.oe.8"/> causa communi<ptr type="liebermannNote" n="e" target="#Hn_25-1.lnote.oe.e"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 562 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_25-1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic"><hi rend="spaced">über den</hi></hi> uauassores: 26, 3. 27</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">above the</hi> uauassores: 26, 3. 27</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_25-1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verstehe</hi> eorum</seg><seg type="translation" xml:lang="en" source="#claude">understand eorum</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_25-1.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">falls es sich nicht handelt um</hi> causa singulari (19, 2; capitali 20, 3); <hi rend="italic">vgl.</hi> 20, 2</seg><seg type="translation" xml:lang="en" source="#claude">if it is not a matter of causa singulari (19, 2; capitali 20, 3); <hi rend="italic">cf.</hi> 20, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_25-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">-cui <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cui Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_25-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_25-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">de c. co. <hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">de c. co. omitted K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_25-1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de">Der Satz stammt aus Hn com 3, 1; <hi rend="italic">vgl. Gl</hi> Gerichtsbarkeit 38a.—<hi rend="italic">de</hi>{8} <hi rend="italic">ea. co</hi>. fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude">The sentence derives from Hn com 3, 1; <hi rend="italic">cf. Gl</hi> Gerichtsbarkeit 38a.—<hi rend="italic">de</hi>{8} <hi rend="italic">ea. co</hi>. omitted Rs</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">If a plea arises between the men of any of the barons having their soke, let the plea be dealt with in the court of their lord, in a common case.</ab>
      </div>
