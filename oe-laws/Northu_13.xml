  <text>
    <body>
      <div type="clause" n="13">
        <head><ref type="lawCode" target="law:Northu">Northu</ref> 13</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="13" corresp="#wit-d"><pb n="381" ed="#liebermann"/>Gif pr<hi rend="italic">eost</hi> on unhalgodon huse mæssige, gilde XII ór.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-d"><pb n="304" ed="#rabin-doml"/>Gif preost on unhalgodon huse mæssige, gilde XII or.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="381" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Northu_13.lnote.de.1"/> ein Priester in ungeweihtem<ptr type="liebermannNote" n="2" target="#Northu_13.lnote.de.2"/> Hause Messe liest, zahle er 12 Ör.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a priest says mass in an unconsecrated building, let him pay 12 ores.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-d"><pb n="481" ed="#whitelock"/>If a priest celebrates mass in an unconsecrated building, he is to pay 12 ores.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-d"><pb n="305" ed="#rabin-doml"/>If a priest holds Mass in an unconsecrated building, he is to pay twelve oras.</ab>
        <note type="comparison" source="#liebermann" n="381">Can. Edg. 30</note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. Can. Edg. 30</note>
        <note type="editorial">Liebermann compares Canons of Edgar 30.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Northu_13.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">223</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Das Stück 13—18 ist hier nur übernommen und Rechtsbruchbusse hinzugefügt</seg><seg type="translation" xml:lang="en" source="#claude">The section 13—18 is merely taken over here, with compensation for breach of law added</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Northu_13.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">223</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Messe 1</seg><seg type="translation" xml:lang="en" source="#claude">Cf. <hi rend="italic">Gl</hi> Messe 1</seg></note>
      </div>
    </body>
