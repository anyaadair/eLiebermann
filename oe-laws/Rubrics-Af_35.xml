      <div type="clause" n="35">
        <head>Af Rb 35</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35" corresp="#wit-e"><pb n="18" ed="#liebermann"/>XXXII. Be cierlisces<ptr type="liebermannNote" n="17" target="#Rubrics-Af_35.lnote.oe.17"/> monnes<ptr type="liebermannNote" n="18" target="#Rubrics-Af_35.lnote.oe.18"/> byndellan.<ptr type="liebermannNote" n="19" target="#Rubrics-Af_35.lnote.oe.19-2"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35" corresp="#wit-ot-frag"><pb n="18" ed="#liebermann"/>:::II. Be cyrlisc … s byndellan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35" corresp="#wit-g-prol"><pb n="18" ed="#liebermann"/>XXXII. Be cyrlisces mannes byndellan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35" corresp="#wit-h"><pb n="19" ed="#liebermann"/>XXXII. Be cierlisces monnes<ptr type="liebermannNote" n="2" target="#Rubrics-Af_35.lnote.oe.2"/> byndelan.<ptr type="liebermannNote" n="15" target="#Rubrics-Af_35.lnote.oe.15"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="35" corresp="#wit-q"><pb n="19" ed="#liebermann"/>De uillano homine<ptr type="liebermannNote" n="19" target="#Rubrics-Af_35.lnote.oe.19"/> ligato.<ptr type="liebermannNote" n="20" target="#Rubrics-Af_35.lnote.oe.20"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="196" ed="#jurasinski-and-oliver"/>XXXII Be cierlisces monnes byndellan</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="196" ed="#jurasinski-and-oliver"/>Be ceorlisces mannes bindelan</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="19" ed="#liebermann"/>Vom Binden<ptr type="liebermannNote" n="1" target="#Rubrics-Af_35.lnote.de.1"/> eines gemeinfreien Mannes.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of the binding of a common freeman.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="197" ed="#jurasinski-and-oliver"/>Concerning the binding of a <hi rend="italic">ceorl</hi>-rank man</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="197" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_35.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">iniuste <hi rend="italic">fügt zu Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">iniuste added by Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_35.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">vel suspenso vel raso <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">vel suspenso vel raso added by Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_35.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de">cyrl. <hi rend="italic">So;</hi> ceorl. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyrl. So; ceorl. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_35.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de">mannes <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mannes Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_35.lnote.oe.19-2" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de">-elan <hi rend="italic">So;</hi> bindelan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-elan So; bindelan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_35.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_35.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rasur vor</hi> l</seg><seg type="translation" xml:lang="en" source="#claude">erasure before l</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_35.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Q spät. Rez. deutet auch den Inhalt von 35, 2f. in der Rubrik an; <hi rend="italic">suspenso</hi> erklärt sich aus <hi rend="italic">suspendio</hi> Af 35, 2</seg><seg type="translation" xml:lang="en" source="#claude">Q later rec. also indicates the content of 35, 2f. in the rubric; <hi rend="italic">suspenso</hi> is explained by <hi rend="italic">suspendio</hi> Af 35, 2</seg></note>
      </div>
