    <body>
      <div type="clause" n="18.2">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 18.2</head>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-hk"><ptr type="liebermannNote" n="b" target="#LeisWl_18-2.lnote.oe.b"/><pb n="504–505" ed="#liebermann"/>. . . . . . . . . . . . . . . .</ab>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-i"><pb n="504–505" ed="#liebermann"/>S’il<ptr type="liebermannNote" n="24" target="#LeisWl_18-2.lnote.oe.24"/> la purgist<ptr type="liebermannNote" n="25" target="#LeisWl_18-2.lnote.oe.25"/>, forfait est de membres.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="18.2" corresp="#wit-i"><pb n="262" ed="#robertson"/>[S'il la purgist, forfait est de membres.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="504–505" ed="#liebermann"/>(18, 2. Wenn er sie beschläft, ist er verfallen in Verlust der [Viril]glieder. <hi rend="italic">I</hi>)</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">(18, 2. If he lies with her, he has incurred loss of the [virile] members. <hi rend="italic">I</hi>)</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-i"><pb n="263" ed="#robertson"/>[If he assaults her, he shall suffer castration.</ab>
        <note type="editorial">Added October 2026 from Robertson pp. 262–263 (text and translation); 18.2–19.1 are from I (not in Hk) (Robertson).; Liebermann’s text and German translation added from Gesetze I p. 504–505, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_18-2.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">18, 2 <hi rend="italic">wiederholt nur</hi> 18, <hi rend="italic">fehlt auch L</hi></seg><seg type="translation" xml:lang="en" source="#claude">18, 2 merely repeats 18; also missing in L</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_18-2.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">Si <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">Si <hi rend="italic">Im</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_18-2.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">purgiste <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">purgiste <hi rend="italic">Io</hi></seg></note>
      </div>
