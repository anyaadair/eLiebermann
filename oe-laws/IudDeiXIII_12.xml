      <div type="clause" n="12">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 12</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 12" corresp="#wit-lat"><pb n="423" ed="#liebermann"/>Et<ptr type="liebermannNote" n="39" target="#IudDeiXIII_12.lnote.oe.39"/> si alius<ptr type="liebermannNote" n="d" target="#IudDeiXIII_12.lnote.oe.d"/> immittatur quam ille cui culpa obicitur, ad[iuratio<ptr type="liebermannNote" n="40" target="#IudDeiXIII_12.lnote.oe.40"/>].</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 423 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_12.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im Gegensatz zu</hi> se man sylf <hi rend="italic">in</hi> Blas. 1, <hi rend="italic">o. S.</hi> 388</seg><seg type="translation" xml:lang="en" source="#claude">in contrast to se man sylf in Blas. 1, above p. 388</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_12.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">diese Rubrik fehlt Tr;</hi> = <hi rend="italic">Zeu.</hi> 653&lt;sub&gt;33&lt;/sub&gt;</seg><seg type="translation" xml:lang="en" source="#claude">this rubric omitted in Tr; = Zeu. 653&lt;sub&gt;33&lt;/sub&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_12.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">dicat <hi rend="italic">Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">dicat Mg</seg></note>
      </div>
