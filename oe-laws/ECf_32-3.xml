  <text>
    <body>
      <div type="clause" n="32.3">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 32.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 32.3"><pb n="655" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_32-3.lnote.oe.erkl-clause"/>Et sicut modo uocantur greues<ptr type="liebermannNote" n="1" target="#ECf_32-3.lnote.la.1"/> qui<ptr type="liebermannNote" n="2" target="#ECf_32-3.lnote.la.2"/> habent prefecturas<ptr type="liebermannNote" n="3" target="#ECf_32-3.lnote.la.3"/> super alios<ptr type="liebermannNote" n="4" target="#ECf_32-3.lnote.la.4"/>, ita<ptr type="liebermannNote" n="5" target="#ECf_32-3.lnote.la.5"/> tunc temporis uocabantur<ptr type="liebermannNote" n="a" target="#ECf_32-3.lnote.la.fn.a"/> alderman<ptr type="liebermannNote" n="6" target="#ECf_32-3.lnote.la.6"/>, non propter senectutem sed propter sapientiam<ptr type="liebermannNote" n="7" target="#ECf_32-3.lnote.la.7"/>.<ptr type="liebermannNote" n="*" target="#ECf_32-3.lnote.la.star"/></ab>
        <note type="comparison" source="#liebermann" n="655"><label>printed alongside</label> <ref target="clause:ECfRetr_32-3">ECf retr 32.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 655 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s asterisk introduces the London collection’s insertion into the Retr. here, 32 A–E.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-3.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht ganz übernahm der Sheriff das Amt des Angelsächs.</hi> ealdorman <hi rend="italic">und nicht jedem</hi> ealdor <hi rend="italic">folgte ein</hi> gerefa</seg><seg type="translation" xml:lang="en" source="#claude">the sheriff did not entirely take over the office of the Anglo-Saxon ealdorman, and not every ealdor was followed by a gerefa</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-3.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier schaltet Lond in die Retr.</hi> 32 A—E, <hi rend="italic">bis S.</hi> 660, <hi rend="italic">ein:</hi></seg><seg type="translation" xml:lang="en" source="#claude">here Lond inserts 32 A–E into the Retr., up to p. 660:</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-3.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de">reues <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">reues Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-3.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de">modo <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hk adds modo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-3.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de">-ram <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ram Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-3.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de">illos <hi rend="italic">Ad</hi> (<hi rend="italic">nicht Do</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">illos Ad (not Do)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-3.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de">primi <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">primi Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-3.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de">eld. <hi rend="italic">Rl;</hi> elderemen <hi rend="italic">S;</hi> aldermanni <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">eld. Rl; elderemen S; aldermanni Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-3.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de">scientiam <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">scientiam Hk</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And just as those who have reeveships over others are now called <hi rend="italic">greues</hi>, so at that time they were called <hi rend="italic">alderman</hi>, not on account of old age but on account of wisdom.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-3.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">348</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Ealdorman 6—7b</seg><seg type="translation" xml:lang="en" source="#claude">Cf. <hi rend="italic">Gl</hi> Ealdorman 6—7b</seg></note>
      </div>
    </body>
  </text>
