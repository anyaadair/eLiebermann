    <body>
      <div type="clause" n="8.1">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 8.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-hk"><pb n="498–499" ed="#liebermann"/>[E<ptr type="liebermannNote" n="4" target="#LeisWl_8-1.lnote.oe.4"/>] la were del vilain C sol. en Merchenelahe e ensement en Westsexene<ptr type="liebermannNote" n="5" target="#LeisWl_8-1.lnote.oe.5"/>.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-i"><ptr type="liebermannNote" n="19" target="#LeisWl_8-1.lnote.oe.19"/><pb n="498–499" ed="#liebermann"/>E la wer del vilain C solz en Merchenelae e e[n]sement<ptr type="liebermannNote" n="20" target="#LeisWl_8-1.lnote.oe.20"/> en Westsexenelae.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="498–499" ed="#liebermann"/>rustici autem C solid. in Merchenelahe et similiter in Westsaxenelahe.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="8.1" corresp="#wit-hk"><pb n="256" ed="#robertson"/>E la were del vilain—C sol. en Merchenelahe e ensement en Westsexene.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="498–499" ed="#liebermann"/>8, 1. Und das Wergeld des Bauern [= Ceorl] 100 Schill. im Mercier-Rechtsgebiet und ebenso im Westsachsen(-Rechtsgebiet <hi rend="italic">IL</hi>).</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">8, 1. And the wergild of the peasant [= ceorl] 100 shill. in the Mercian legal district and likewise in the West Saxon (legal district <hi rend="italic">IL</hi>).</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-hk"><pb n="257" ed="#robertson"/>And the wergeld of a villein is 100 shillings in the province of Mercia, and the same in the province of Wessex.</ab>
        <note type="editorial">Added October 2026 from Robertson pp. 256–257 (text and translation); Liebermann’s text and German translation added from Gesetze I p. 498–499, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_8-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">498</biblScope></bibl><seg type="original" xml:lang="de">En <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">En Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_8-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">498</biblScope></bibl><seg type="original" xml:lang="de">lahe <hi rend="italic">ergänzen Edd. ohne Noth</hi></seg><seg type="translation" xml:lang="en" source="#claude">lahe supplied by edd. unnecessarily</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_8-1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">498</biblScope></bibl><seg type="original" xml:lang="de">8, 1 <hi rend="italic">fehlt Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">8, 1 missing in Im</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_8-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">498</biblScope></bibl><seg type="original" xml:lang="de">eus. <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">eus. Io</seg></note>
      </div>
