      <div type="clause" n="42">
        <head>Ine Rb 42</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42" corresp="#wit-e"><pb n="24" ed="#liebermann"/>LXXXVI. Be<ptr type="liebermannNote" n="*" target="#Rubrics-Ine_41_dup2.lnote.oe.star"/> ceorles gærstune.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42" corresp="#wit-g-prol"><pb n="24" ed="#liebermann"/>LXXXVI. Be ceorles gærstune.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42" corresp="#wit-h"><pb n="25" ed="#liebermann"/>LXXXVI. Be ciorles gærstune.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="42" corresp="#wit-q"><pb n="25" ed="#liebermann"/>De compascuis<ptr type="liebermannNote" n="3" target="#Rubrics-Ine_41_dup2.lnote.oe.3"/> uillanorum.<ptr type="liebermannNote" n="4" target="#Rubrics-Ine_41_dup2.lnote.oe.4"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="208" ed="#jurasinski-and-oliver"/>LXXXVI Be ceorles gærstune</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="208" ed="#jurasinski-and-oliver"/>Be ðam þ<hi rend="italic">æt</hi> ceorlas habbað land gemæne gærstunas</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="25" ed="#liebermann"/>Von des Bauern Wiesengehege.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of the peasant’s meadow-enclosure.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="209" ed="#jurasinski-and-oliver"/>Concerning a <hi rend="italic">ceorl</hi>’s common meadow</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="209" ed="#jurasinski-and-oliver"/>Concerning that <hi rend="italic">ceorls</hi> have land in common and the common meadows</ab>
        <note type="editorial">Liebermann’s margin has [42].</note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_41_dup2.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">24</biblScope></bibl><seg type="original" xml:lang="de">Be ceorla gemænum land <hi rend="italic">Ld</hi> [<hi rend="italic">nach B?</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">Be ceorla gemænum land Ld [after B?]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_41_dup2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">v. pascuis <hi rend="italic">Br</hi>; v. divisis <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">v. pascuis Br; v. divisis Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_41_dup2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">claudendis <hi rend="italic">fügt zu Hk Br. Dann</hi> [42,1] Si animal vicini sepes frangatur [<hi rend="italic">so</hi>] <hi rend="italic">Hk</hi>; De animalibus sepes vicinorum frangentibus <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">claudendis added by Hk Br. Then [42,1] Si animal vicini sepes frangatur [sic] Hk; De animalibus sepes vicinorum frangentibus Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_41_dup2.lnote.de.1" n="1" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘Davon dass Bauern Ackerland und Wiesen gemeinsam haben’ B, wovon einiges Ld</seg><seg type="translation" xml:lang="en" source="#claude">‘Of peasants having arable land and meadows in common’ B, part of which Ld</seg></note>
      </div>
