      <div type="clause" n="13.5">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 13.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 13.5" corresp="#wit-lat"><pb n="424" ed="#liebermann"/>Propter hoc obnixe precamur<ptr type="liebermannNote" n="36" target="#IudDeiXIII_13-5.lnote.oe.36"/> te, domine Iesu Christe, fac signum tale, ut, si<ptr type="liebermannNote" n="37" target="#IudDeiXIII_13-5.lnote.oe.37"/> culpabilis est homo<ptr type="liebermannNote" n="38" target="#IudDeiXIII_13-5.lnote.oe.38"/> iste, nullatenus recipiatur ab hac aqua.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 424 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-5.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">te depr. <hi rend="italic">Co Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">te depr. Co Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-5.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">quicumque c. est in hac re, nu. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">quicumque c. est in hac re, nu. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-5.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">iste ex hoc <hi rend="italic">ohne</hi> homo <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">iste ex hoc without homo Co</seg></note>
      </div>
