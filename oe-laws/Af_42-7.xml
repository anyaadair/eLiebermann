      <div type="clause" n="42.7">
        <head><ref type="lawCode" target="law:Af">Af</ref> 42.7</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42.7" corresp="#wit-e"><pb n="76" ed="#liebermann"/>⁊<ptr type="liebermannNote" n="24" target="#Af_42-7.lnote.oe.24"/> mon mot feohtan órwige<ptr type="liebermannNote" n="25" target="#Af_42-7.lnote.oe.25"/>, gif he gemeteð oþerne æt his æwum wife, betynedu<hi rend="italic">m</hi> durum oððe under anre réon, oððe æt his dehter<ptr type="liebermannNote" n="26" target="#Af_42-7.lnote.oe.26"/> æwumborenre (oððe<ptr type="liebermannNote" n="27" target="#Af_42-7.lnote.oe.27"/> æt his swistær<ptr type="liebermannNote" n="28" target="#Af_42-7.lnote.oe.28"/><ptr type="liebermannNote" n="*" target="#Af_42-7.lnote.oe.star"/> borenre) oððe æt his medder<ptr type="liebermannNote" n="29" target="#Af_42-7.lnote.oe.29"/> ðe wære to æwum wife forgifen<ptr type="liebermannNote" n="30" target="#Af_42-7.lnote.oe.30"/> his fæder.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42.7" corresp="#wit-ot-frags"><pb n="76" ed="#liebermann"/>...orwige, ...gemeteð oþer ... durum oþþe...der anre reon, ... his dehter æw ... oþþe æt his sweos .. borenre oþþe æt.. ..æwum wife forgyfen his fæ...</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42.7" corresp="#wit-h"><pb n="76" ed="#liebermann"/>⁊ mon<ptr type="liebermannNote" n="3" target="#Af_42-7.lnote.oe.3"/> mot feohtan<ptr type="liebermannNote" n="11" target="#Af_42-7.lnote.oe.11"/> orwige, gif he oðerne gemeteð mid his æwum wife, betynede<ptr type="liebermannNote" n="20" target="#Af_42-7.lnote.oe.20"/> durum oððe under anre<ptr type="liebermannNote" n="21" target="#Af_42-7.lnote.oe.21"/> reon, oþþe mid his dehter æwumborenre oððe<ptr type="liebermannNote" n="22" target="#Af_42-7.lnote.oe.22"/> mid his swister æwumborenre oððe mid his meder þe wære<ptr type="liebermannNote" n="18" target="#Af_42-7.lnote.oe.18"/> to æwum<ptr type="liebermannNote" n="18" target="#Af_42-7.lnote.oe.18"/> wife forgifen his fæder.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="42.7" corresp="#wit-q"><pb n="77" ed="#liebermann"/>Et<ptr type="liebermannNote" n="13" target="#Af_42-7.lnote.oe.13"/> item potest homo pugnare sine forisfacto, si alii<ptr type="liebermannNote" n="15" target="#Af_42-7.lnote.oe.15"/> obuiet cum sponsa sua, clausis hostiis uel sub una ueste, uel cum filia sua<ptr type="liebermannNote" n="16" target="#Af_42-7.lnote.oe.16"/> de<ptr type="liebermannNote" n="17" target="#Af_42-7.lnote.oe.17"/> sponsa uel cum sorore sua quę de sponsa nata<ptr type="liebermannNote" n="18" target="#Af_42-7.lnote.oe.18-2"/> sit uel cum matre sua quę patri suo fuerit desponsata.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="84" ed="#attenborough"/>⁊ mon mot feohtan órwige, gif he gemeteð oþerne æt<ptr type="editorNote" n="18" target="#Af_42-7.attnote.fn.18"/> his æwum wife, betynedum<ptr type="editorNote" n="19" target="#Af_42-7.attnote.fn.19"/> durum oððe under anre réon, oðer æt<ptr type="editorNote" n="18" target="#Af_42-7.attnote.fn.18-2"/> his dehter æwumborenre (oððe æt<ptr type="editorNote" n="18" target="#Af_42-7.attnote.fn.18-3"/> his swistær [æwum]<ptr type="editorNote" n="20" target="#Af_42-7.attnote.fn.20"/>borenre) oððe æt<ptr type="editorNote" n="18" target="#Af_42-7.attnote.fn.18-4"/> his medder<ptr type="editorNote" n="21" target="#Af_42-7.attnote.fn.21"/> ðe wære to æwum wife forgifen his fæder.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="45.2" corresp="#wit-e"><pb n="346" ed="#jurasinski-and-oliver"/>⁊ mon mot feohtan órwige, gif he gemeteð oþerne æt his æwum wife, betynedu<hi rend="italic">m</hi> durum oððe under anre réon, oððe æt his dehter æwumborenre \oððe æt his swistær borenre/ oððe æt his medder ðe wære to æwum wife forgifen his fæder.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="77" ed="#liebermann"/>Und jemand<ptr type="liebermannNote" n="1" target="#Af_42-7.lnote.de.1"/> darf fechten, ohne Fehde<ptr type="liebermannNote" n="2" target="#Af_42-7.lnote.de.2"/> [auf sich zu laden], wenn er einen anderen trifft bei<ptr type="liebermannNote" n="3" target="#Af_42-7.lnote.de.3"/> seinem ehelichen Weibe, bei<ptr type="liebermannNote" n="4" target="#Af_42-7.lnote.de.4"/> verschlossenen<ptr type="liebermannNote" n="5" target="#Af_42-7.lnote.de.5"/> Thüren oder unter einer Decke<ptr type="liebermannNote" n="6" target="#Af_42-7.lnote.de.6"/>, oder bei seiner ehelich geborenen Tochter<ptr type="liebermannNote" n="7" target="#Af_42-7.lnote.de.7"/> oder<ptr type="liebermannNote" n="9" target="#Af_42-7.lnote.de.9"/> bei seiner ehelich<ptr type="liebermannNote" n="9" target="#Af_42-7.lnote.de.9"/> geborenen Schwester oder bei seiner Mutter, die seinem Vater zum ehelichen Weibe angetraut worden war.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And one may fight without [incurring] feud if he finds another man with his lawful wife, behind closed doors or under one blanket, or with his legitimately born daughter or with his legitimately born sister or with his mother who had been given to his father as lawful wife.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="85" ed="#attenborough"/>A man may fight, without becoming liable to vendetta<ptr type="editorNote" n="1" target="#Af_42-7.attnote.n.1"/>, if he finds another [man] with his wedded wife, within closed doors or under the same blanket; or [if he finds another man] with his legitimate daughter [or sister]; or with his mother, if she has been given in lawful wedlock to his father.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="416" ed="#whitelock"/>And a man may fight without incurring a vendetta if he finds another man with his wedded wife, within closed doors or under the same blanket, or with his legitimate daughter or his legitimate sister, or with his mother who was given as a lawful wife to his father.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="347" ed="#jurasinski-and-oliver"/>And a man may fight without incurring liability if he finds another with his lawful wife, behind doors or under a single blanket or with his lawfully born daughter, or with his born sister, or with his mother who was given as lawful wife to his father.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-7.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">Eac</hi> <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Eac</hi> Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-7.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">orwite</hi> <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">orwite</hi> Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-7.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">dohtor <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">dohtor Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-7.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">o. æt h. s. b. <hi rend="italic">andere Tinte, gleichzeitige Hd., übergeschr. E</hi></seg><seg type="translation" xml:lang="en" source="#claude">o. æt h. s. b. different ink, contemporary hand, written above E</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-7.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">sweoster <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sweoster Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-7.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> æwum <hi rend="italic">aus H Ld Quadr; fehlte auch Ot.</hi></seg><seg type="translation" xml:lang="en" source="#claude">supply æwum from H Ld Quadr; it was lacking in Ot too.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-7.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">meder <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">meder Ld</seg></note>
