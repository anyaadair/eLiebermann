      <div type="clause" n="I Cn 4">
        <head>Quadr Rb I Cn 4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Rb I Cn 4" corresp="#wit-lat"><pb n="535" ed="#liebermann"/>De<ptr type="liebermannNote" n="21" target="#Quadr-Rb_I-Cn-4.lnote.la.21"/> dignitate<ptr type="liebermannNote" n="*" target="#Quadr-Rb_I-Cn-4.lnote.la.star"/> sacerdotum et<ptr type="liebermannNote" n="22" target="#Quadr-Rb_I-Cn-4.lnote.la.22"/> accusatione eorum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 535 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">Of the dignity of priests and the accusation of them.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-4.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">535</biblScope></bibl><seg type="original" xml:lang="de">De d. s. <hi rend="italic">zu</hi> 4, 1 <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">De d. s. at 4, 1 R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-4.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">535</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Sperrdruck zeichnet Worte aus, die nicht im Texte des Quadr., oben S. 279 ff., stehen.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Spaced type marks words that do not stand in the text of Quadr., above pp. 279 ff.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-4.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">535</biblScope></bibl><seg type="original" xml:lang="de">De acc. sacerdotum <hi rend="italic">zu</hi> 5 <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">De acc. sacerdotum at 5 R</seg></note>
