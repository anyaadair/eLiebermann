    <body>
      <div type="clause" n="41.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 41.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 41.2" corresp="#wit-lat"><ptr type="liebermannNote" n="p" target="#Hn_41-2.lnote.oe.p"/><pb n="567" ed="#liebermann"/>Qui <ptr type="liebermannNote" n="q" target="#Hn_41-2.lnote.oe.q"/>residens est, ad domum suam submoneri<ptr type="liebermannNote" n="51" target="#Hn_41-2.lnote.oe.51"/> debet<ptr type="liebermannNote" n="52" target="#Hn_41-2.lnote.oe.52"/> de quolibet<ptr type="liebermannNote" n="53" target="#Hn_41-2.lnote.oe.53"/> placito cum testibus, et si domi est, eidem dicatur; uel dapifero<ptr type="liebermannNote" n="r" target="#Hn_41-2.lnote.oe.r"/> uel denique familie sue libere denuncietur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 567 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hierher gehört logisch Rubrik</hi> 42</seg><seg type="translation" xml:lang="en" source="#claude">the rubric 42 belongs here logically</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bei Termin-Abbestellung dieselben Empfänger und Fristen</hi> 59, 1—2<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">the same recipients and time-limits when a court day is countermanded 59, 1—2b</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 42, 2. 92, 18</seg><seg type="translation" xml:lang="en" source="#claude">cf. 42, 2. 92, 18</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2.lnote.oe.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">summoniri <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">summoniri Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2.lnote.oe.52" n="52" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vom Corr. übergeschr. Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">written above by the corrector Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2.lnote.oe.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">p. q. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. q. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Vorladung 11; Truchsess 4a. <hi rend="italic">Si</hi> [Vorzuladender] <hi rend="italic">inveniri non potest, ad senescallum vel prepositum fit submonitio; si nec senescallum nec prepositum habuerit, ad proprium domicilium recurrendum est</hi>; Summa leg. Norm. 60, 6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Vorladung 11; Truchsess 4a. <hi rend="italic">Si</hi> [the person to be summoned] <hi rend="italic">inveniri non potest, ad senescallum vel prepositum fit submonitio; si nec senescallum nec prepositum habuerit, ad proprium domicilium recurrendum est</hi>; Summa leg. Norm. 60, 6</seg></note>
      </div>
