      <div type="clause" n="59.14">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.14</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.14" corresp="#wit-lat"><pb n="579" ed="#liebermann"/>Qui de iudicata<ptr type="liebermannNote" n="g" target="#Hn_59-14.lnote.oe.g"/> et uadiata domino peccunia apud iusticiam falso conqueritur et contradicit et molitur<ptr type="liebermannNote" n="22" target="#Hn_59-14.lnote.oe.22"/>, secundum quod natus est culpa sit erga iusticiam cui mentitus est<ptr type="liebermannNote" n="23" target="#Hn_59-14.lnote.oe.23"/>; pro falso clamore XX<ptr type="liebermannNote" n="24" target="#Hn_59-14.lnote.oe.24"/> ma[n]c.<ptr type="liebermannNote" n="25" target="#Hn_59-14.lnote.oe.25"/> culpa sit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 579 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-14.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wer wegen Geld, das er im Gericht der Herrschaft an diese zu zahlen verurtheilt worden, beim Königsrichter fälschlich klagt und durch Urtheilschelte (gegen sie) intrigirt, sei Wergeld (vgl.</hi> 34, 7) <hi rend="italic">schuldig</hi></seg><seg type="translation" xml:lang="en" source="#claude">whoever, concerning money that he has been sentenced in the court of his lord to pay to the lord, brings a false complaint before the king's justice and intrigues (against the lord) by challenging the judgment, shall be liable to pay wergild (cf. 34, 7)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-14.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de">moll. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">moll. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-14.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-14.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">doppelt Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">written twice in Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-14.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de">mͣ <hi rend="italic">Sc;</hi> marc. <hi rend="italic">übr., Edd.; aber vgl.</hi> 53, 1</seg><seg type="translation" xml:lang="en" source="#claude">mͣ Sc; marc. the rest, edd.; but cf. 53, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-14.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Urteilschelte 6. 7; Klage 7—<hi rend="italic">marcas</hi>{25} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Urteilschelte 6. 7; Klage 7—<hi rend="italic">marcas</hi>{25} Rs</seg></note>
      </div>
