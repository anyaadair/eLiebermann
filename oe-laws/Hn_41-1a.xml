      <div type="clause" n="41.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 41.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 41.1a" corresp="#wit-lat"><pb n="567" ed="#liebermann"/>Quodsi diuersos feodos<ptr type="liebermannNote" n="43" target="#Hn_41-1a.lnote.oe.43"/> quis teneat, ouerseunessam<ptr type="liebermannNote" n="44" target="#Hn_41-1a.lnote.oe.44"/> que<ptr type="liebermannNote" n="n" target="#Hn_41-1a.lnote.oe.n"/> ad feodum attinet<ptr type="liebermannNote" n="45" target="#Hn_41-1a.lnote.oe.45"/> ex<ptr type="liebermannNote" n="46" target="#Hn_41-1a.lnote.oe.46"/> inde tenentibus et inibi<ptr type="liebermannNote" n="47" target="#Hn_41-1a.lnote.oe.47"/> forisfacientibus habet<ptr type="liebermannNote" n="48" target="#Hn_41-1a.lnote.oe.48"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 567 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-1a.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">diejenige Ungehorsamsbusse von den dort straffälligen Hintersassen, welche dem (<hi rend="italic">Ortsrecht des</hi>) Lehns (<hi rend="italic">wo die That geschah</hi>) entspricht; <hi rend="italic">vgl. über den Vasallen verschiedener Herren</hi> 41, 3. 43, 5 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">that fine for disobedience, from the tenants liable to punishment there, which corresponds to the (<hi rend="italic">local law of the</hi>) fief (<hi rend="italic">where the deed was committed</hi>); <hi rend="italic">on the vassal of several lords cf.</hi> 41, 3. 43, 5 <hi rend="italic">f.</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-1a.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">q. f. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">q. f. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-1a.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-1a.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">-ent <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ent Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-1a.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-1a.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond; fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Lond; missing Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-1a.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">faciat <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">faciat Sc Hg</seg></note>
      </div>
