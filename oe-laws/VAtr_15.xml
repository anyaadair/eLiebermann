  <text>
    <body>
      <div type="clause" n="15">
        <head><ref type="lawCode" target="law:VAtr">V Atr</ref> 15</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15" corresp="#wit-g"><pb n="240" ed="#liebermann"/>Elles oðre freolsa ⁊ fæstena healde man georne, swa swa þa heoldan þa ðe betst heoldan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15" corresp="#wit-g2"><pb n="240" ed="#liebermann"/>Elles oðre freolsa ⁊ fæstena healde man georne, swa swa þa heoldan þa þe betst heoldan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15" corresp="#wit-d"><pb n="241" ed="#liebermann"/>Elles oðre freolsa ⁊ fæstena healde man georne, swa swa þa heoldon þa ðe betst heoldon.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="15" corresp="#wit-d"><pb n="84" ed="#robertson"/>Elles oðre freolsa ⁊ fæstena healde man georne, swa swa þe heoldon þa ðe betst heoldon.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g"><pb n="152" ed="#rabin-doml"/>Elles oðre freolsa and fæstena healde man georne, swa swa þa heoldan þa ðe betst heoldan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="241" ed="#liebermann"/>Andere<ptr type="liebermannNote" n="1" target="#VAtr_15.lnote.de.1"/> Feste<ptr type="liebermannNote" n="2" target="#VAtr_15.lnote.de.2"/> und Fasten sonst halte man willig, so<ptr type="liebermannNote" n="3" target="#VAtr_15.lnote.de.3"/> wie jene, welche [sie] bestens hielten, gehalten haben.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Let other feasts and fasts otherwise be eagerly kept, as those kept them who kept them best.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d"><ptr type="editorNote" n="1" target="#VAtr_15.robnote.n.1"/><pb n="85" ed="#robertson"/>Otherwise, festivals and fasts shall be strictly observed in accordance with the highest standards of the past<ptr type="editorNote" n="2" target="#VAtr_15.robnote.n.2"/>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-g"><pb n="450" ed="#whitelock"/>Otherwise other festivals and fasts are to be kept diligently just as those kept them who kept them best.<ptr type="editorNote" n="7" target="#VAtr_15.whinote.n.7"/></ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g"><pb n="153" ed="#rabin-doml"/>Otherwise, feasts and fasts are to be kept assiduously, just as they were kept when they were kept best.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VIAtr_22-3">VI Atr 22.3</ref>; <ref target="clause:VIIAtr_4">VII Atr 4</ref></note>
        <note type="comparison" source="#whitelock" n="450"><label>expanded in</label> <ref target="clause:VIAtr_23">VI Atr 23</ref> <quote>VI Ethelred 23 adds here “and the Ember fasts, just as St Gregory himself prescribed for the English nation”</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="331"><ref target="clause:VIIAtr_4">VII Atr 4</ref></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_15.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">172</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">= VI 22, 5</seg><seg type="translation" xml:lang="en" source="#claude">= VI 22, 5</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_15.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">172</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. 12, 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 12, 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_15.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">172</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Diese Art der Gradbestimmung <hi rend="italic">s</hi>. zu II Eg 5, 3</seg><seg type="translation" xml:lang="en" source="#claude">For this way of determining the degree <hi rend="italic">see</hi> on II Eg 5, 3</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VAtr_15.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="en">Cf. VI, 22, 4.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VAtr_15.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="en">Cf. II Edg. 5, 3, where a similar expression is employed.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="VAtr_15.whinote.n.7" n="7" source="#whitelock"><bibl><biblScope unit="page">450</biblScope></bibl><label>best</label><seg type="original" xml:lang="en">VI Ethelred 23 adds here “and the Ember fasts, just as St Gregory himself prescribed for the English nation”</seg></note>
      </div>
    </body>
  </text>
