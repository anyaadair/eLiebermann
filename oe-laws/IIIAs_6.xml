    <body>
      <div type="clause" n="6">
        <head><ref type="lawCode" target="law:IIIAs">III As</ref> 6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6" corresp="#wit-q"><pb n="170" ed="#liebermann"/>Sextum: si<ptr type="liebermannNote" n="a" target="#IIIAs_6.lnote.oe.a"/> aliquis homo sit adeo diues uel tante parentele<ptr type="liebermannNote" n="b" target="#IIIAs_6.lnote.oe.b"/>, ut<ptr type="liebermannNote" n="5" target="#IIIAs_6.lnote.oe.5"/> (cur<ptr type="liebermannNote" n="c" target="#IIIAs_6.lnote.oe.c"/>) castigari non possit uel idem<ptr type="liebermannNote" n="40" target="#IIIAs_6.lnote.oe.40"/> cessare<ptr type="liebermannNote" n="d" target="#IIIAs_6.lnote.oe.d"/> nolit, ut facias<ptr type="liebermannNote" n="5" target="#IIIAs_6.lnote.oe.5"/> (efficias), qualiter abstrahatur<ptr type="liebermannNote" n="e" target="#IIIAs_6.lnote.oe.e"/> in aliam aliquam<ptr type="liebermannNote" n="41" target="#IIIAs_6.lnote.oe.41"/> partem regni<ptr type="liebermannNote" n="42" target="#IIIAs_6.lnote.oe.42"/> tui, sicut dictum<ptr type="liebermannNote" n="f" target="#IIIAs_6.lnote.oe.f"/> est in occiduis partibus, sit<ptr type="liebermannNote" n="g" target="#IIIAs_6.lnote.oe.g"/> alterutrum quod sit sic<ptr type="liebermannNote" n="43" target="#IIIAs_6.lnote.oe.43"/> comitum sic<ptr type="liebermannNote" n="43" target="#IIIAs_6.lnote.oe.43"/> uillanorum.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="6" corresp="#wit-q"><pb n="144" ed="#attenborough"/>Sextum, si aliquis homo sit adeo dives vel tantæ parentelæ ut<ptr type="editorNote" n="11" target="#IIIAs_6.attnote.fn.11"/> castigari non possit vel idem<ptr type="editorNote" n="12" target="#IIIAs_6.attnote.fn.12"/> cessare nolit, ut facias<ptr type="editorNote" n="13" target="#IIIAs_6.attnote.fn.13"/> qualiter abstrahatur in aliam aliquam partem regni tui, sicut dictum est in occiduis partibus, sit alterutrum quod sit, sic<ptr type="editorNote" n="14" target="#IIIAs_6.attnote.fn.14"/> comitum sic<ptr type="editorNote" n="14" target="#IIIAs_6.attnote.fn.14"/> villanorum.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="145" ed="#attenborough"/>Sixthly, if any man is so rich<ptr type="editorNote" n="1" target="#IIIAs_6.attnote.n.1"/>, or belongs to so powerful a kindred that he cannot be punished, and moreover is not willing to desist [from his wrongdoing], you shall cause him to be removed to another part of your kingdom, as was declared in the west<ptr type="editorNote" n="2" target="#IIIAs_6.attnote.n.2"/>—whatever his station in life, whether he be noble or commoner.</ab>
        <note type="comparison" source="#liebermann" n="170"><ref target="clause:VAs_Prol-to-1">V As Pr. 1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. V As[?] Pr. 1</note>
        <note type="comparisonIncomplete">Some of Liebermann’s notes here are cut off in the gutter of the scan used, and are still to be completed.</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IVAs_3">IV As 3</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="296"><ref target="clause:IVAs_3">IV As 3–3.2</ref></note>
        <note type="editorial">Latin only; no German translation in Liebermann. Liebermann compares V As Prol. 1.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_6.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond; (eingeklammertes) übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket Lond; (the bracketed words) the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_6.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">illud <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">illud Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_6.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt TMHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in TMHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_6.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">cui <hi rend="italic">statt</hi> r. tui <hi rend="italic">Jl</hi></seg><seg type="translation" xml:lang="en" source="#claude">cui instead of r. tui Jl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_6.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">sit <hi rend="italic">Or T</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit Or T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_6.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">111</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Diesen Satz wiederholt IV 3. — Erst hier erhellt das Motiv für V As Pro, 1¹: des Staates Ohnmacht gegenüber reichen, dem Gesetze trotzenden Sippen</seg><seg type="translation" xml:lang="en" source="#claude">This sentence is repeated in IV 3. — Only here does the motive for V As Pro, 1¹ become clear: the powerlessness of the State in the face of rich kindreds defying the law</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_6.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">111</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">= <hi rend="italic">cognatio</hi> III 6; <hi rend="italic">s. d. Wb:</hi> aus <hi rend="italic">mægð. Vgl. Gl</hi> Sippe 6</seg><seg type="translation" xml:lang="en" source="#claude">= <hi rend="italic">cognatio</hi> III 6; <hi rend="italic">see</hi> that word in <hi rend="italic">Wb:</hi> from <hi rend="italic">mægð. Cf. Gl</hi> Sippe 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_6.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">111</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Wb: cur</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Wb: cur</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_6.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">111</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">cessare</hi> ebenso absolut wie <hi rend="italic">geswican</hi> ‘von Missetat abstehn’</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cessare</hi> used as absolutely as <hi rend="italic">geswican</hi> ‘to desist from wrongdoing’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_6.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">111</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">= <hi rend="italic">educatur</hi> IV 3; aus <hi rend="italic">læde man ut; vgl. Wb: ut(ge)lædan</hi></seg><seg type="translation" xml:lang="en" source="#claude">= <hi rend="italic">educatur</hi> IV 3; from <hi rend="italic">læde man ut; cf. Wb: ut(ge)lædan</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_6.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">111</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">aus <hi rend="italic">gecweden; vgl. Wb: cweðan.</hi> — Exeter war Æthelstans westlichste Hauptstadt; es wird auch sonst unter <hi rend="italic">Occidentales</hi> (<hi rend="italic">s. Wb</hi>) mitverstanden. — Hier aber sprechen Südostengländer</seg><seg type="translation" xml:lang="en" source="#claude">from <hi rend="italic">gecweden; cf. Wb: cweðan.</hi> — Exeter was Æthelstan’s westernmost capital; it is elsewhere too included under <hi rend="italic">Occidentales</hi> (<hi rend="italic">see Wb</hi>). — Here, however, it is South-East Englishmen who are speaking</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_6.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">111</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">aus <hi rend="italic">swa hwæðer swa hit sie, swa eorl swa ceorl; vgl. Wb</hi> S. 205 F—H</seg><seg type="translation" xml:lang="en" source="#claude">from <hi rend="italic">swa hwæðer swa hit sie, swa eorl swa ceorl; cf. Wb</hi> p. 205 F—H</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIAs_6.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">210</biblScope></bibl><seg type="original" xml:lang="en">Cf. IV As. cap. 3; VI As. cap. 8 § 2.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIAs_6.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">210</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e</hi>. at Exeter; cf. V As. Preamble, § 1.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_6.attnote.fn.11" n="11" source="#attenborough"><bibl><biblScope unit="page">144</biblScope></bibl><label>ut</label><seg type="original" xml:lang="en"><hi rend="italic">cur</hi>. M, Hk, Br, etc.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_6.attnote.fn.12" n="12" source="#attenborough"><bibl><biblScope unit="page">144</biblScope></bibl><label>idem</label><seg type="original" xml:lang="en"><hi rend="italic">illud</hi>. Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_6.attnote.fn.13" n="13" source="#attenborough"><bibl><biblScope unit="page">144</biblScope></bibl><label>facias</label><seg type="original" xml:lang="en"><hi rend="italic">efficias</hi>. Br, M.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_6.attnote.fn.14" n="14" source="#attenborough"><bibl><biblScope unit="page">144</biblScope></bibl><label>sic</label><seg type="original" xml:lang="en"><hi rend="italic">sit</hi>. Or, T.</seg></note>
      </div>
    </body>
  </text>
