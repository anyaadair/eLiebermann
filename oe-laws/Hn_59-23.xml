      <div type="clause" n="59.23">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.23</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.23" corresp="#wit-lat"><pb n="580" ed="#liebermann"/>Si<ptr type="liebermannNote" n="c" target="#Hn_59-23.lnote.oe.c"/> seruus<ptr type="liebermannNote" n="d" target="#Hn_59-23.lnote.oe.d"/> in redimendis inmobilibus intra VIII<ptr type="liebermannNote" n="e" target="#Hn_59-23.lnote.oe.e"/> denar. estimatis furetur, reddat dominus eius<ptr type="liebermannNote" n="7" target="#Hn_59-23.lnote.oe.7"/> repetenti capitale suum semel; et uerberetur<ptr type="liebermannNote" n="f" target="#Hn_59-23.lnote.oe.f"/> et signetur<ptr type="liebermannNote" n="c" target="#Hn_59-23.lnote.oe.c"/> ab eodem repetente prima<ptr type="liebermannNote" n="c" target="#Hn_59-23.lnote.oe.c"/> uice.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 580 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-23.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht aus II Cn.</hi> 32; <hi rend="italic">vgl.</hi> 59, 26</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">perhaps from II Cn.</hi> 32; <hi rend="italic">cf.</hi> 59, 26</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-23.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verf. schwankt über die strafrechtliche Stellung des</hi> seruus: <hi rend="italic">durch Benutzen der Quellen verschiedener Zeitalter, aber auch, weil in Wirklichkeit das Recht unklar war; Maitland</hi> Domesday 32</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">the author wavers over the penal status of the</hi> seruus: <hi rend="italic">through using sources of different periods, but also because the law was in reality unclear; Maitland</hi> Domesday 32</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-23.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 59, 20</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 59, 20</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-23.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">sc.</hi> seruus; <hi rend="italic">vielleicht aus Ine</hi> 48; <hi rend="italic">vgl.</hi> 59, 24</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">sc.</hi> seruus; <hi rend="italic">perhaps from Ine</hi> 48; <hi rend="italic">cf.</hi> 59, 24</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-23.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-23.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Brandmarken 2. 3; unfrei 17e. f—<hi rend="italic">in</hi> korr. aus <hi rend="italic">non</hi>—ohne <hi rend="italic">VIII</hi>—<hi rend="italic">captale</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Brandmarken 2. 3; unfrei 17e. f—<hi rend="italic">in</hi> corrected from <hi rend="italic">non</hi>—without <hi rend="italic">VIII</hi>—<hi rend="italic">captale</hi> Rs</seg></note>
      </div>
