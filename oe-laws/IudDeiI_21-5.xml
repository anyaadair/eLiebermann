    <body>
      <div type="clause" n="21.5">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 21.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 21.5" corresp="#wit-lat"><pb n="405" ed="#liebermann"/>sed fac eos<ptr type="liebermannNote" n="1" target="#IudDeiI_21-5.lnote.oe.1"/> super<ptr type="liebermannNote" n="2" target="#IudDeiI_21-5.lnote.oe.2"/>. te natare; et<ptr type="liebermannNote" n="3" target="#IudDeiI_21-5.lnote.oe.3"/> nulla possit esse contra te causa facta<ptr type="liebermannNote" n="4" target="#IudDeiI_21-5.lnote.oe.4"/> aut ullum prestigium<ptr type="liebermannNote" n="5" target="#IudDeiI_21-5.lnote.oe.5"/> inimici, quod illud possit occultare.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 405 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-5.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">-um <hi rend="italic">übergeschr. Ci H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-um written above Ci H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-5.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">n. s. te <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">n. s. te Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-5.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">ut <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">ut Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-5.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">esse <hi rend="italic">fügt zu Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">esse added by Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-5.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">prestri. <hi rend="italic">Rj Ci;</hi> prestigatio, quae i. p. non manifestare <hi rend="italic">Zeu., doch verbessert Hs. St. Germain</hi> non ma. <hi rend="italic">in</hi> occ.</seg><seg type="translation" xml:lang="en" source="#claude">prestri. Rj Ci; prestigatio, quae i. p. non manifestare Zeu., though MS St. Germain corrects non ma. to occ.</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">but make them float upon you; and may no thing done [?] against you, nor any deceit of the enemy, be able to conceal it.</ab>
      </div>
    </body>
