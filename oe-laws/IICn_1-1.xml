        <note type="liebermannNote" subtype="textual" xml:id="IICn_1-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">308</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert aus</hi> forh</seg><seg type="translation" xml:lang="en" source="#claude">corrected from forh</seg></note>
