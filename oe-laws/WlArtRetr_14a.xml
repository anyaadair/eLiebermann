      <div type="clause" n="14a">
        <head><ref type="lawCode" target="law:WlArtRetr">Wl art retr</ref> 14a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-lond"><pb n="491" ed="#liebermann"/>Et si<ptr type="liebermannNote" n="35" target="#WlArtRetr_14a.lnote.oe.35"/> quisquam euaserit talium, uideant plegii ut soluant quod calumpniatum est, et purgent se, quia in euaso nullam fraudem nouerunt<ptr type="liebermannNote" n="36" target="#WlArtRetr_14a.lnote.oe.36"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 491 (two independent readings of the page images, differences settled against the page); Robertson does not print this clause separately</note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_14a.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_14a.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">-rint <hi rend="italic">Ld Se</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rint Ld Se</seg></note>
