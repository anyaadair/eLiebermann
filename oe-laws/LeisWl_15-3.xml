    <body>
      <div type="clause" n="15.3">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 15.3</head>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-hk"><pb n="502–503" ed="#liebermann"/>E s’il ad larrecin ça en ariere<ptr type="liebermannNote" n="1" target="#LeisWl_15-3.lnote.oe.1"/> amendé, aut a<ptr type="liebermannNote" n="g" target="#LeisWl_15-3.lnote.oe.g"/> l’ewe.</ab>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-i"><pb n="502–503" ed="#liebermann"/>E s’il ad en arere<ptr type="liebermannNote" n="17" target="#LeisWl_15-3.lnote.oe.17"/> larcin amended, alt a l’ewe<ptr type="liebermannNote" n="29" target="#LeisWl_15-3.lnote.oe.29"/>.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="502–503" ed="#liebermann"/>Si furtum aliquando<ptr type="liebermannNote" n="3" target="#LeisWl_15-3.lnote.oe.3"/> calumpniatus emendauit, eat ad iudicium aque.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="15.3" corresp="#wit-hk"><pb n="260" ed="#robertson"/>E s'il ad larrecin ça en ariere amendé, aut a l'ewe.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="502–503" ed="#liebermann"/>15, 3. Und wenn er bereits früher Diebstahl gebüsst hat, schreite er zum [Kalt]wasser[ordal].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">15, 3. And if he has already previously paid compensation for theft, he shall proceed to the [cold-]water [ordeal].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-hk"><pb n="261" ed="#robertson"/>And if he has previously paid compensation for theft, he shall go to the water ordeal.</ab>
        <note type="comparison" source="#liebermann" n="503"><ref target="clause:IICn_30-1">II Cn 30.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">vgl. II Cn. 30, 1</note>
        <note type="editorial">Added October 2026 from Robertson pp. 260–261 (text and translation); Liebermann’s text and German translation added from Gesetze I p. 502–503, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_15-3.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">502</biblScope></bibl><seg type="original" xml:lang="de">ad ewe <hi rend="italic">ändert BA.</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad ewe altered by BA.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_15-3.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">502</biblScope></bibl><seg type="original" xml:lang="de">en nariere <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">en nariere <hi rend="italic">Hk</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_15-3.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">502</biblScope></bibl><seg type="original" xml:lang="de">arer <hi rend="italic">Io Isp</hi></seg><seg type="translation" xml:lang="en" source="#claude">arer <hi rend="italic">Io Isp</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_15-3.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">502</biblScope></bibl><seg type="original" xml:lang="de">ew <hi rend="italic">Isp</hi></seg><seg type="translation" xml:lang="en" source="#claude">ew <hi rend="italic">Isp</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_15-3.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">503</biblScope></bibl><seg type="original" xml:lang="de">aln̄ <hi rend="italic">S;</hi> alii <hi rend="italic">Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">aln̄ <hi rend="italic">S;</hi> alii <hi rend="italic">edd.</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_15-3.lnote.de._" n="-" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">288</biblScope></bibl><seg type="original" xml:lang="de">Hiernach scheint Kaltwasserordal (<hi rend="italic">s. d</hi>. 10f.) schwerer als Eisenordal; es war weniger ehrenvoll</seg><seg type="translation" xml:lang="en" source="#claude">Accordingly the cold-water ordeal (<hi rend="italic">see</hi> that word 10f.) seems to be more severe than the iron ordeal; it was less honourable</seg></note>
      </div>
    </body>
