      <div type="clause" n="14">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 14</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 14"><pb n="640" ed="#liebermann"/><hi rend="spaced">De<ptr type="liebermannNote" n="13" target="#ECfRetr_14.lnote.la.13"/> thesauris <hi rend="bold">(in</hi><ptr type="liebermannNote" n="14" target="#ECfRetr_14.lnote.la.14"/> <hi rend="bold">terra absconditis et) inuentis</hi><ptr type="liebermannNote" n="15" target="#ECfRetr_14.lnote.la.15"/><hi rend="bold">.</hi></hi> Thesauri de<ptr type="liebermannNote" n="16" target="#ECfRetr_14.lnote.la.16"/> terra regis sunt, nisi in ecclesia uel in<ptr type="liebermannNote" n="17" target="#ECfRetr_14.lnote.la.17"/> cemeterio inueniantur.</ab>
        <note type="comparison" source="#liebermann" n="640"><label>printed alongside</label> <ref target="clause:ECf_14">ECf 14</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 640 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_14.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Überschr. fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">heading lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_14.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">in t. a. et <hi rend="italic">aus Lb Va Sp; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">in t. a. et from Lb Va Sp; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_14.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Pl S;</hi> cuius sint <hi rend="italic">fügt zu Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Pl S; Cb adds cuius sint</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_14.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">r. s. de t. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. s. de t. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_14.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Va Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Va Ph</seg></note>
      </div>
