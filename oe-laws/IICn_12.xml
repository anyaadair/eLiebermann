        <note type="liebermannNote" subtype="textual" xml:id="IICn_12.lnote.oe.12-2" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">317</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verschlechtert</hi> ferderw. <hi rend="italic">Lb;</hi> ferderƿite <hi rend="italic">Jo</hi></seg><seg type="translation" xml:lang="en" source="#claude">corruptly ferderw. Lb; ferderƿite Jo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_12.lnote.oe.13-2" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">317</biblScope></bibl><seg type="original" xml:lang="de">i. s. <hi rend="italic">HLbS</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. s. HLbS</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_12.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">203</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Die Kapitel 12—15, 3 bilden, nachdem <hi rend="italic">Amen</hi> das Stück vorher abschloss, Einen Abschnitt ‘Vom Kronprozess’ (<hi rend="italic">s. d. Gl</hi> 1a. 8ff.), der in Ggs. tritt zur privaten Gerichtsbarkeit, die namentlich seit Æthelred der Adel sich angemasst hatte. Cnut wahrt den Justizertrag der Krone auch <hi rend="italic">u</hi>. 30, 6¹; <hi rend="italic">vgl</hi>. Maitland <hi rend="italic">Domesday</hi> 87ff. 261. 282</seg><seg type="translation" xml:lang="en" source="#claude">Chapters 12—15, 3, after <hi rend="italic">Amen</hi> had closed the preceding piece, form a single section ‘On pleas of the Crown’ (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1a. 8ff.), which stands in contrast to the private jurisdiction that the nobility had usurped, especially since Æthelred. Cnut safeguards the Crown's judicial revenue also <hi rend="italic">below</hi> 30, 6¹; <hi rend="italic">cf</hi>. Maitland <hi rend="italic">Domesday</hi> 87ff. 261. 282</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_12.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">203</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Diese Stelle wird zitiert durch Hn 20, 3</seg><seg type="translation" xml:lang="en" source="#claude">This passage is cited by Hn 20, 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_12.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">203</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Justizertrag samt Richterbefugnis</seg><seg type="translation" xml:lang="en" source="#claude">Judicial revenue together with judicial authority</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_12.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">203</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">d. h. auch über Untertanen privaten Gerichts, doch mit Ausnahmen (<hi rend="italic">s</hi>. 3 Z. weiter): z. B. zugunsten des Erzbischofs von Canterbury</seg><seg type="translation" xml:lang="en" source="#claude">i.e. also over those subject to private jurisdiction, but with exceptions (<hi rend="italic">see</hi> 3 ll. further on): e.g. in favour of the Archbishop of Canterbury</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_12.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">203</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Der Acc. <hi rend="italic">socne</hi> beweist, dass die folgenden Wörter Objekte zu <hi rend="italic">ah</hi> sind</seg><seg type="translation" xml:lang="en" source="#claude">The acc. <hi rend="italic">socne</hi> proves that the following words are objects of <hi rend="italic">ah</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_12.lnote.de.6" n="6" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">203</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Königsfrieden 6d</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Königsfrieden 6d</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_12.lnote.de.7" n="7" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">203</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Schutz 1—3d</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Schutz 1—3d</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_12.lnote.de.8" n="8" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">203</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Heimsuchung 11</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Heimsuchung 11</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_12.lnote.de.9" n="9" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">203</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Rechtsperrung 6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Rechtsperrung 6</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_12.lnote.de.10" n="10" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">203</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Begünstigung 4. 20; <hi rend="italic">vgl. u</hi>. 13, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Begünstigung 4. 20; <hi rend="italic">cf. below</hi> 13, 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_12.lnote.de.11" n="11" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">203</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Die Variante in AQ (danach Hn 10, 1) ändert den Sinn nicht; ‘Landwehrversäumnis’ meint, auch richtig, Inst laut II 15. III 46. <hi rend="italic">Vgl. Gl</hi> Heer 2. 8</seg><seg type="translation" xml:lang="en" source="#claude">The variant in AQ (followed by Hn 10, 1) does not change the sense; Inst means, also correctly, ‘neglect of land defence’, according to II 15. III 46. <hi rend="italic">Cf. Gl</hi> Heer 2. 8</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_12.lnote.de.12" n="12" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">203</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>.⁴. <hi rend="italic">Vgl. gemæð(r)ian</hi> (ohne <hi rend="italic">ge</hi>- nur aus A), <hi rend="italic">mæðian</hi> ‘Rücksicht schenken’; Toller. Cons wählt missverständlich unter den Bedd. ‘sich erbarmen, erlassen’, als würde der Schuldige berücksichtigt; vielmehr der private Gerichtsherr ist gemeint; <hi rend="italic">vgl. u</hi>. 15⁶</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi>⁴. <hi rend="italic">Cf. gemæð(r)ian</hi> (without <hi rend="italic">ge</hi>- only from A), <hi rend="italic">mæðian</hi> ‘to show consideration’; Toller. Cons, misunderstanding, chooses from among the meanings ‘to have mercy, to remit’, as though the guilty man were being shown consideration; rather, the private lord of jurisdiction is meant; <hi rend="italic">cf. below</hi> 15⁶</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_12.lnote.de.13" n="13" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">203</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>.⁴. <hi rend="italic">Vgl. gemæð(r)ian</hi> (ohne <hi rend="italic">ge</hi>- nur aus A), <hi rend="italic">mæðian</hi> ‘Rücksicht schenken’; Toller. Cons wählt missverständlich unter den Bedd. ‘sich erbarmen, erlassen’, als würde der Schuldige berücksichtigt; vielmehr der private Gerichtsherr ist gemeint; <hi rend="italic">vgl. u</hi>. 15⁶</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi>⁴. <hi rend="italic">Cf. gemæð(r)ian</hi> (without <hi rend="italic">ge</hi>- only from A), <hi rend="italic">mæðian</hi> ‘to show consideration’; Toller. Cons, misunderstanding, chooses from among the meanings ‘to have mercy, to remit’, as though the guilty man were being shown consideration; rather, the private lord of jurisdiction is meant; <hi rend="italic">cf. below</hi> 15⁶</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_12.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">353</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">gerihta</hi> means rights of jurisdiction as well as the profits of jurisdiction, cf. IV Edg. 2 <hi rend="italic">a</hi>.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_12.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">353</biblScope></bibl><seg type="original" xml:lang="en">Cf. <hi rend="italic">griðbryce</hi>, cap. 15.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_12.robnote.n.3" n="3" source="#robertson"><bibl><biblScope unit="page">353</biblScope></bibl><seg type="original" xml:lang="en">Generally, from the time of IV Atr. 4, <hi rend="italic">mundbryce</hi>, <hi rend="italic">hamsocn</hi> and <hi rend="italic">forstal</hi> are classed together, the fine for each being £5, cf. Hn. 12, 2; 35, 2; DB. <hi rend="smallcaps">i</hi>. 154 <hi rend="italic">b</hi>, 2; 172 <hi rend="italic">a</hi>, 1; 179 <hi rend="italic">a</hi>, 1; 252 <hi rend="italic">a</hi>, 1.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_12.robnote.n.4" n="4" source="#robertson"><bibl><biblScope unit="page">353</biblScope></bibl><seg type="original" xml:lang="en">Cf. In. 51; II Cn. 65; 77; Kemble, <hi rend="smallcaps">iv</hi>., Nos. *771, *785, *809, 853, 874.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_12.robnote.n.5" n="5" source="#robertson"><bibl><biblScope unit="page">353</biblScope></bibl><seg type="original" xml:lang="en">Cf. Canute’s grant to the Archbishop of Canterbury, Earle, <hi rend="italic">Land Charters</hi>, p. 232.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_12.robnote.fn.2" n="2" source="#robertson"><bibl><biblScope unit="page">180</biblScope></bibl><label>forstal</label><seg type="original" xml:lang="en"><hi rend="italic">forsteal</hi> ⁊ <hi rend="italic">flymena fyrmðe</hi> G.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_12.robnote.fn.3" n="3" source="#robertson"><bibl><biblScope unit="page">180</biblScope></bibl><label>fyrdwite</label><seg type="original" xml:lang="en"><hi rend="italic">fyrdigce</hi> A, for which Liebermann, in view of Q’s reading <hi rend="italic">fyrdunga</hi>, suggests the emendation <hi rend="italic">fyrdinge</hi>.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_12.robnote.fn.4" n="4" source="#robertson"><bibl><biblScope unit="page">180</biblScope></bibl><label>he</label><seg type="original" xml:lang="en"><hi rend="italic">he hwæne ðe</hi> G; <hi rend="italic">he hw.</hi> A, Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_12.robnote.fn.5" n="5" source="#robertson"><bibl><biblScope unit="page">180</biblScope></bibl><label>gemæðian</label><seg type="original" xml:lang="en"><hi rend="italic">gemæðrian</hi> G, Ld; <hi rend="italic">mæðrian</hi> A.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_12.robnote.fn.6" n="6" source="#robertson"><bibl><biblScope unit="page">180</biblScope></bibl><label>wylle</label><seg type="original" xml:lang="en">G adds: ⁊ <hi rend="italic">he him ðæs weorðscipes geunne.</hi></seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IICn_12.whinote.n.3" n="3" source="#whitelock"><bibl><biblScope unit="page">463</biblScope></bibl><label>mundbryce</label><seg type="original" xml:lang="en">breach of the king’s protection</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IICn_12.whinote.n.4" n="4" source="#whitelock"><bibl><biblScope unit="page">463</biblScope></bibl><label>hamsocn</label><seg type="original" xml:lang="en"><hi rend="italic">see</hi> p. 428, n. 3</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IICn_12.whinote.n.5" n="5" source="#whitelock"><bibl><biblScope unit="page">463</biblScope></bibl><label>forstal</label><seg type="original" xml:lang="en"><hi rend="italic">see</hi> p. 446, n. 5.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IICn_12.whinote.n.6" n="6" source="#whitelock"><bibl><biblScope unit="page">463</biblScope></bibl><label>fugitives</label><seg type="original" xml:lang="en">This is mentioned only in the Nero version.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IICn_12.whinote.n.7" n="7" source="#whitelock"><bibl><biblScope unit="page">463</biblScope></bibl><label>further</label><seg type="original" xml:lang="en">i.e. further than by giving the usual grant of private jurisdiction, which did not include these special royal pleas. The Nero version adds here: “and he grants him this privilege”.</seg></note>
      </div>
    </body>
  </text>
