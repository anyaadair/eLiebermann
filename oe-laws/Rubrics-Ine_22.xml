      <div type="clause" n="22">
        <head>Ine Rb 22</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22" corresp="#wit-e"><pb n="22" ed="#liebermann"/>LXVI. Be ðon ðe monnes geneat stalige.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22" corresp="#wit-g-prol"><pb n="22" ed="#liebermann"/>LXVI. Be þan ðe mannes<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_22.lnote.oe.1"/> gestalige.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22" corresp="#wit-h"><pb n="23" ed="#liebermann"/>LXVI. Be þon<ptr type="liebermannNote" n="3" target="#Rubrics-Ine_22.lnote.oe.3"/> ðe monnes<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_22.lnote.oe.2"/> geneat stalige.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="22" corresp="#wit-q"><pb n="23" ed="#liebermann"/>Si<ptr type="liebermannNote" n="4" target="#Rubrics-Ine_22.lnote.oe.4"/> alicuius<ptr type="liebermannNote" n="5" target="#Rubrics-Ine_22.lnote.oe.5"/> colonus furetur.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="204" ed="#jurasinski-and-oliver"/>LXVI Be ðon ðe monnes geneat stalige</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="204" ed="#jurasinski-and-oliver"/>Be ðam þe mannes geneat stalige</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="23" ed="#liebermann"/>Darüber, dass jemandes Dienstmann<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_22.lnote.de.1"/> stiehlt.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning someone’s retainer stealing.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="205" ed="#jurasinski-and-oliver"/>Concerning theft by someone in a man’s service</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="205" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_22.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> geneat.</seg><seg type="translation" xml:lang="en" source="#claude">supply geneat.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_22.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">De colono vel villano a. qui est fur <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">De colono vel villano a. qui est fur Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_22.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">c. a. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. a. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_22.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> þam</seg><seg type="translation" xml:lang="en" source="#claude">altered þam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_22.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_22.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Hintersass oder landloses Gesinde</seg><seg type="translation" xml:lang="en" source="#claude">Dependent tenant or landless household servant</seg></note>
      </div>
