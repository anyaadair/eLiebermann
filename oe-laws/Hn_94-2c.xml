      <div type="clause" n="94.2c">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 94.2c</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 94.2c" corresp="#wit-lat"><pb n="611" ed="#liebermann"/>Si sint duorum<ptr type="liebermannNote" n="13" target="#Hn_94-2c.lnote.oe.13"/> dominorum, et alius alium uerberet cecis<ptr type="liebermannNote" n="g" target="#Hn_94-2c.lnote.oe.g"/> ictibus et non cruentis<ptr type="liebermannNote" n="14" target="#Hn_94-2c.lnote.oe.14"/>, siue crauatus<ptr type="liebermannNote" n="12" target="#Hn_94-2c.lnote.oe.12"/> ibi<ptr type="liebermannNote" n="15" target="#Hn_94-2c.lnote.oe.15"/> sit uel non, conuictus noxe witam<ptr type="liebermannNote" n="g" target="#Hn_94-2c.lnote.oe.g"/><ptr type="liebermannNote" n="16" target="#Hn_94-2c.lnote.oe.16"/> emendabit domino, cuius hominem uerberauit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 611 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2c.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 94, 1: <hi rend="italic">also</hi> fihtwite <hi rend="italic">dem Herrn des Verletzten</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 94, 1: hence fihtwite goes to the lord of the injured man</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2c.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">gr. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">gr. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2c.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">do. du. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">do. du. Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2c.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">-tibus <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tibus K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2c.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">siue <hi rend="italic">statt</hi> i. sit u. <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">siue instead of i. sit u. K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2c.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">uit. <hi rend="italic">Co Or;</hi> wyt. <hi rend="italic">K meist</hi></seg><seg type="translation" xml:lang="en" source="#claude">uit. Co Or; wyt. K mostly</seg></note>
