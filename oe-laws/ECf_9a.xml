  <text>
    <body>
      <div type="clause" n="9a">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 9a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 9a"><pb n="633" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_9a.lnote.oe.erkl-clause"/>Et quos saluauerit<ptr type="liebermannNote" n="12" target="#ECf_9a.lnote.la.12"/> Dominus per misericordiam<ptr type="liebermannNote" n="cc" target="#ECf_9a.lnote.la.fn.cc"/> suam et iusticiam<ptr type="liebermannNote" n="13" target="#ECf_9a.lnote.la.13"/> eorum<ptr type="liebermannNote" n="14" target="#ECf_9a.lnote.la.14"/>, quieti<ptr type="liebermannNote" n="d" target="#ECf_9a.lnote.la.fn.d"/> sint<ptr type="liebermannNote" n="15" target="#ECf_9a.lnote.la.15"/> et liberi<ptr type="liebermannNote" n="16" target="#ECf_9a.lnote.la.16"/> abscedant<ptr type="liebermannNote" n="17" target="#ECf_9a.lnote.la.17"/>; et quos iniquitas et iniusticia<ptr type="liebermannNote" n="18" target="#ECf_9a.lnote.la.18"/> sua dampnauerit<ptr type="liebermannNote" n="19" target="#ECf_9a.lnote.la.19"/>, iusticia<ptr type="liebermannNote" n="20" target="#ECf_9a.lnote.la.20"/> regis de ipsis iusticiam<ptr type="liebermannNote" n="21" target="#ECf_9a.lnote.la.21"/> fieri faciat<ptr type="liebermannNote" n="22" target="#ECf_9a.lnote.la.22"/>.</ab>
        <note type="comparison" source="#liebermann" n="633"><label>printed alongside</label> <ref target="clause:ECfRetr_9a">ECf retr 9a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 633 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9a.lnote.la.fn.cc" n="cc" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 19, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. 19, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9a.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">Assisa Clarendon. 14 <hi rend="italic">fordert</hi> 1166 <hi rend="italic">auch von Verdächtigen, die Ordal bestanden, Landesabschwörung</hi> (<hi rend="italic">s. o.</hi> 5, 3)</seg><seg type="translation" xml:lang="en" source="#claude">the Assize of Clarendon, 14, in 1166 demands abjuration of the realm even from suspects who have passed the ordeal (see above, 5, 3)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9a.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">soluerit <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">soluerit Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9a.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">-icia <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-icia Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9a.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">sua <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">sua Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9a.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">sunt <hi rend="italic">Rl Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">sunt Rl Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9a.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">libere <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">libere Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9a.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">acce. <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">acce. Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9a.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">iust. <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">iust. S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9a.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">condempn. <hi rend="italic">S;</hi> dapnauit <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">condempn. S; dapnauit Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9a.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">-cie <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cie Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9a.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">f. i. <hi rend="italic">Hk;</hi> fi. fa. iu. <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. i. Hk; fi. fa. iu. S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9a.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">faciant <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">faciant Ad Do</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And those whom the Lord has saved through his mercy and their righteousness, let them be quit and depart free; and those whom their iniquity and unrighteousness have condemned, let the king's justice cause justice to be done upon them.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9a.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">344</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Retr Z. 1 <hi rend="italic">non per merita</hi> vielleicht aus Formel Iud Dei III 3, 1</seg><seg type="translation" xml:lang="en" source="#claude">Retr line 1 <hi rend="italic">non per merita</hi> perhaps from the formula Iud Dei III 3, 1</seg></note>
      </div>
    </body>
  </text>
