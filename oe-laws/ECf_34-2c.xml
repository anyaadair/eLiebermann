    <body>
      <div type="clause" n="34.2c">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 34.2c</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 34.2c"><pb n="663" ed="#liebermann"/><ptr type="liebermannNote" n="12" target="#ECf_34-2c.lnote.la.12"/>Et<ptr type="liebermannNote" n="13" target="#ECf_34-2c.lnote.la.13"/> Chnutus<ptr type="liebermannNote" n="14" target="#ECf_34-2c.lnote.la.14"/> totum<ptr type="liebermannNote" n="15" target="#ECf_34-2c.lnote.la.15"/> suscepit Anglie<ptr type="liebermannNote" n="16" target="#ECf_34-2c.lnote.la.16"/> principatum<ptr type="liebermannNote" n="17" target="#ECf_34-2c.lnote.la.17"/>; regnauitque fere X<ptr type="liebermannNote" n="18" target="#ECf_34-2c.lnote.la.18"/> et VIII annis†.</ab>
        <note type="comparison" source="#liebermann" n="663"><label>printed alongside</label> <ref target="clause:ECfRetr_34-2c">ECf retr 34.2c</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 663 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann prints “†” and gives in the outer margin of the ECf retr column the dates †1016–35.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2c.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">Regnum Chnuti regis <hi rend="italic">überschreibt Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">Pl S head it Regnum Chnuti regis</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2c.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk S Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk S Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2c.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">uero <hi rend="italic">fügt zu S Hr;</hi> Can. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">S Hr add uero; Can. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2c.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">su. totius <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">su. totius Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2c.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">regnum A. et princ. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">regnum A. et princ. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2c.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">regnum <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">regnum S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2c.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">XXVII <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">XXVII Hr</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And Cnut took up the rule of all England; and reigned almost eighteen years†.</ab>
      </div>
