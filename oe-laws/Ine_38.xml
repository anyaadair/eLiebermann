        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">107</biblScope></bibl><seg type="original" xml:lang="de">Captale hoc est Anglice frumstol <hi rend="italic">am Rande Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Captale hoc est Anglice frumstol in the margin Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">æ <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">æ on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">on <hi rend="italic">geänd. in</hi> and</seg><seg type="translation" xml:lang="en" source="#claude">on altered to and</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">106</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in a</hi></seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">106</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zweites</hi> e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">second e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">106</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">gemane, ⁊ fære <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gemane, ⁊ fære Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">se <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">se Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">agyfe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">agyfe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">106</biblScope></bibl><seg type="original" xml:lang="de">syx <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">syx Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">106</biblScope></bibl><seg type="original" xml:lang="de">-ran <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ran Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">106</biblScope></bibl><seg type="original" xml:lang="de">-dan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">106</biblScope></bibl><seg type="original" xml:lang="de">magas <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">magas Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">106</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">statt</hi> um <hi rend="italic">Loch mit Spur eines Buchst. E</hi></seg><seg type="translation" xml:lang="en" source="#claude">instead of um a hole with the trace of a letter E</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">106</biblScope></bibl><seg type="original" xml:lang="de">-rod sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rod sy Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_38.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">75</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘Ehemann’ versteht Rubricator. Die Kleinheit des Erziehungsgeldes (<hi rend="italic">o.</hi> 26) beweist, dass Ine Adel nicht meint</seg><seg type="translation" xml:lang="en" source="#claude">The rubricator understands ‘husband’. The smallness of the payment for upbringing (<hi rend="italic">above</hi> 26) proves that Ine does not mean the nobility</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_38.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">75</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘Kinder’ Maurer <hi rend="italic">Kr. Übsch.</hi> I 99; allerdings sprechen andere Germanen (Rive <hi rend="italic">Vormundsch.</hi> 195) im Parallelfalle von <hi rend="italic">filii,</hi> und kann <hi rend="italic">bearn</hi> ‘Nachkommenschaft’ bedeuten; allein das niedrige Geld zur Erziehung (<hi rend="italic">s. d. Gl</hi> 2), für nur 1 Findling <hi rend="italic">o.</hi> 26 ebenso berechnet, und die Vermögensverwaltung gewiss nur bis zur Mündigkeit des ältesten Sohnes beweisen, dass im Nachsatzschlusse nur Ein Kind gemeint ist; so Q: <hi rend="italic">puer.</hi> — Das ‘gemeinschaftliche, ihr’ Kind steht im Ggs. zu des Mannes Bastard; <hi rend="italic">s. d. Gl</hi> 7b</seg><seg type="translation" xml:lang="en" source="#claude">‘Children’ Maurer <hi rend="italic">Kr. Übsch.</hi> I 99; it is true that other Germanic peoples (Rive <hi rend="italic">Vormundsch.</hi> 195) speak of <hi rend="italic">filii</hi> in the parallel case, and <hi rend="italic">bearn</hi> can mean ‘offspring’; but the low payment for upbringing (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 2), reckoned in the same way for only 1 foundling <hi rend="italic">above</hi> 26, and the administration of the property, certainly only until the eldest son came of age, prove that at the end of the main clause only one child is meant; so Q: <hi rend="italic">puer.</hi> — The ‘joint, their’ child stands in contrast to the husband's bastard; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 7b</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_38.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">75</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Q verstand ursprünglich wohl Eheverlassung durch den Mann; ein Glossator verdeutlicht: ‘d. h. stirbt’</seg><seg type="translation" xml:lang="en" source="#claude">Q originally probably understood desertion of the marriage by the husband; a glossator makes it clear: ‘i.e. dies’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_38.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">75</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘und’ setzt H cor. schlecht ein</seg><seg type="translation" xml:lang="en" source="#claude">H cor. inserts ‘and’, wrongly</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_38.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">75</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Die Vatersippe; <hi rend="italic">vgl. Gl</hi> 14a; mündig 3. a</seg><seg type="translation" xml:lang="en" source="#claude">The father's kindred; <hi rend="italic">cf. Gl</hi> 14a; mündig 3. a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_38.lnote.de.6" n="6" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">75</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Dies folgt aus der Viehrente</seg><seg type="translation" xml:lang="en" source="#claude">This follows from the rent in cattle</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_38.lnote.de.7" n="7" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">75</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘Wintern’ unpassend B</seg><seg type="translation" xml:lang="en" source="#claude">‘winters’ B, inappropriately</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_38.lnote.de.8" n="8" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">75</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Auch Hl 6 weist <hi rend="italic">bearn medder</hi> zu und dem Kinde in der Vatersippe einen Bürgen, der dessen <hi rend="italic">feoh</hi> hütet, bis es 10 Jahr ist</seg><seg type="translation" xml:lang="en" source="#claude">Hl 6 too assigns <hi rend="italic">bearn medder</hi>, and gives the child a surety from the father's kindred who is to look after its <hi rend="italic">feoh</hi> until it is 10 years old</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_38.lnote.de.9" n="9" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">75</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">frum-</hi> in Compositis nicht bloss ‘hauptsächlich’, sondern auch ‘ursprünglich, altangestammt’, z. B. <hi rend="italic">frumscyld</hi> ‘Erbsünde’. <hi rend="italic">Vgl. Gl</hi> Grundbesitz 2; Erbgang 2b. c. d. Ein Testator bestimmt: ‘mein Land <hi rend="italic">hæbbe min wiif, ⁊ min broðar hire fultume ⁊ þæt lond hire nytt gedoe</hi> a. 835 Bi 412</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">frum-</hi> in compounds means not only ‘chief’ but also ‘original, ancestral’, e.g. <hi rend="italic">frumscyld</hi> ‘original sin’. <hi rend="italic">Cf. Gl</hi> Grundbesitz 2; Erbgang 2b. c. d. A testator directs: ‘my land <hi rend="italic">hæbbe min wiif, ⁊ min broðar hire fultume ⁊ þæt lond hire nytt gedoe</hi> a. 835 Bi 412</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_38.lnote.de.10" n="10" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">75</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Zehn Jahr alt; Hl 6; Ine 7, 2</seg><seg type="translation" xml:lang="en" source="#claude">Ten years old; Hl 6; Ine 7, 2</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_38.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">48</biblScope></bibl><label>fede</label><seg type="original" xml:lang="en">⁊. H*.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_38.attnote.fn.9" n="9" source="#attenborough"><bibl><biblScope unit="page">48</biblScope></bibl><label>wintra</label><seg type="original" xml:lang="en"><hi rend="italic">wintran</hi>. B.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_38.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">189</biblScope></bibl><seg type="original" xml:lang="en">Presumably a cow is to be given if the husband dies in summer, an ox, if he dies in winter. The husband, judging from the amount of the maintenance allowance, would be a commoner (cf. cap. 26 above).</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_38.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">189</biblScope></bibl><seg type="original" xml:lang="en">Liebermann translates ‘den Hauptsitz (das Stammgut).’ ‘Maturity’ is reached apparently at the age of ten (cf. Ine, cap. 7 § 2, H. and E. cap. 6).</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Ine_38.whinote.n.2" n="2" source="#whitelock"><bibl><biblScope unit="page">404</biblScope></bibl><label>husband</label><seg type="original" xml:lang="en">Or <hi rend="italic">ceorl</hi> may be being used in its usual sense of the ordinary freeman. The amounts paid are low enough to suggest that it is this class that the law has in mind, but it may not intend to exclude the nobility in the first part of the regulation.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Ine_38.whinote.n.3" n="3" source="#whitelock"><bibl><biblScope unit="page">404</biblScope></bibl><label>home</label><seg type="original" xml:lang="en"><hi rend="italic">frumstol,</hi> literally “first seat”, therefore “principal (or ‘original’) residence”</seg></note>
      </div>
