      <div type="clause" n="49.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 49.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 49.1" corresp="#wit-lat"><pb n="572" ed="#liebermann"/>Quedam cause sunt, de<ptr type="liebermannNote" n="11" target="#Hn_49-1.lnote.oe.11"/> quibus statim respondere (tenetur<ptr type="liebermannNote" n="12" target="#Hn_49-1.lnote.oe.12"/>), sicut dictum est<ptr type="liebermannNote" n="b" target="#Hn_49-1.lnote.oe.b"/>, set non statim placitare neccesse<ptr type="liebermannNote" n="13" target="#Hn_49-1.lnote.oe.13"/> est<ptr type="liebermannNote" n="14" target="#Hn_49-1.lnote.oe.14"/>; quedam, de quibus sine competenti sumonicione non cogitur aliquis uel placitare<ptr type="liebermannNote" n="15" target="#Hn_49-1.lnote.oe.15"/> uel respondere<ptr type="liebermannNote" n="16" target="#Hn_49-1.lnote.oe.16"/> sine consilio uel in omni loco; quedam, de quibus respondere et placitare oportet; quedam, in quibus nec<ptr type="liebermannNote" n="17" target="#Hn_49-1.lnote.oe.17"/> respondere oportet tam in causis quam (in<ptr type="liebermannNote" n="18" target="#Hn_49-1.lnote.oe.18"/>) causatoribus<ptr type="liebermannNote" n="c" target="#Hn_49-1.lnote.oe.c"/><ptr type="liebermannNote" n="19" target="#Hn_49-1.lnote.oe.19"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 572 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 46, 1<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">see above 46, 1<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">‘<hi rend="italic">bei</hi> [<hi rend="italic">allen</hi>] <hi rend="italic">Processen und Processirenden</hi> [<hi rend="italic">welchen Ranges immer</hi>]’ <hi rend="italic">wie</hi> 59, 4<hi rend="italic">a</hi> in omnibus causis et hominibus</seg><seg type="translation" xml:lang="en" source="#claude">‘in [all] suits and with [all] litigants [of whatever rank]’, as 59, 4<hi rend="italic">a</hi> in omnibus causis et hominibus</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur Sc; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">only Sc; lacking in the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi> [<hi rend="italic">besser?</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">lacking Sc Hg [better?]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">-ssarie <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ssarie Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">cogitare <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">cogitare Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">resp. — de quibus <hi rend="italic">überspringt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">resp. — de quibus omitted by Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">non <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">non Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">accusacionibus <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">accusacionibus Lond</seg></note>
      </div>
