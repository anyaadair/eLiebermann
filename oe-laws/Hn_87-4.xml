      <div type="clause" n="87.4">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 87.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 87.4" corresp="#wit-lat"><pb n="601" ed="#liebermann"/>Si<ptr type="liebermannNote" n="o" target="#Hn_87-4.lnote.oe.o"/> quis occidatur in<ptr type="liebermannNote" n="39" target="#Hn_87-4.lnote.oe.39"/> hloþe, reddat interfector weram parentibus et manbotam domino, et omnes qui interfuerunt hlo[ð]botam<ptr type="liebermannNote" n="40" target="#Hn_87-4.lnote.oe.40"/>, sic<ptr type="liebermannNote" n="41" target="#Hn_87-4.lnote.oe.41"/> ut<ptr type="liebermannNote" n="42" target="#Hn_87-4.lnote.oe.42"/> emendent<ptr type="liebermannNote" n="43" target="#Hn_87-4.lnote.oe.43"/> tƿihindeman<ptr type="liebermannNote" n="44" target="#Hn_87-4.lnote.oe.44"/> XXX sol.<ptr type="liebermannNote" n="45" target="#Hn_87-4.lnote.oe.45"/>, sixhinde<ptr type="liebermannNote" n="p" target="#Hn_87-4.lnote.oe.p"/><ptr type="liebermannNote" n="46" target="#Hn_87-4.lnote.oe.46"/> LX<ptr type="liebermannNote" n="47" target="#Hn_87-4.lnote.oe.47"/> sol., tƿelfhinde<ptr type="liebermannNote" n="48" target="#Hn_87-4.lnote.oe.48"/> CXX sol.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 601 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-4.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ine</hi> 13, 1 <hi rend="italic">ff.</hi> 34 <hi rend="italic">steht ferner</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ine</hi> 13, 1 <hi rend="italic">ff.</hi> 34 <hi rend="italic">is more remote</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-4.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 76, 3<hi rend="italic">a</hi><hi rend="superscript">h</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 76, 3<hi rend="italic">a</hi><hi rend="superscript">h</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-4.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">cum lope <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">cum lope K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-4.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">hlotb. <hi rend="italic">Sc Hg;</hi> blodb. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">hlotb. Sc Hg; blodb. the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-4.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">sicut <hi rend="italic">Edd.; wozu</hi> qui occiditur natus est [<hi rend="italic">unnöthig</hi>] <hi rend="italic">ergänzt Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">sicut edd.; to which Wi adds qui occiditur natus est [unnecessary]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-4.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-4.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">-det <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-det Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-4.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">tyih. <hi rend="italic">Sc;</hi> twfh. <hi rend="italic">Co Or;</hi> tƿifh. <hi rend="italic">K;</hi> twifh. <hi rend="italic">Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">tyih. Sc; twfh. Co Or; tƿifh. K; twifh. Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-4.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">soutz <hi rend="italic">Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">soutz Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-4.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">sex. <hi rend="italic">Gi;</hi> man <hi rend="italic">fügt zu K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">sex. Gi; man added by K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-4.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">XI <hi rend="italic">K Co Or;</hi> XL <hi rend="italic">Gi Edd.</hi> [<hi rend="italic">falsch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">XI K Co Or; XL Gi edd. [wrong]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-4.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">t. man CL s. <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. man CL s. K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-4.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Mannbusse 15a—<hi rend="italic">-rint blodb</hi>.{43} <hi rend="italic">s. e. tpyfhyndem</hi>. ohne <hi rend="italic">ut</hi>—<hi rend="italic">t</hi>.{48} <hi rend="italic">man</hi>—87, 4a <hi rend="italic">l. i. an</hi>{49} <hi rend="italic">p. s</hi>.—87, 5 <hi rend="italic">uel</hi>{52}—<hi rend="italic">mance</hi>{32} <hi rend="italic">in Westsexe</hi> (<hi rend="italic">s. Gl</hi> Wessex 3) Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Mannbusse 15a—<hi rend="italic">-rint blodb</hi>.{43} <hi rend="italic">s. e. tpyfhyndem</hi>. without <hi rend="italic">ut</hi>—<hi rend="italic">t</hi>.{48} <hi rend="italic">man</hi>—87, 4a <hi rend="italic">l. i. an</hi>{49} <hi rend="italic">p. s</hi>.—87, 5 <hi rend="italic">uel</hi>{52}—<hi rend="italic">mance</hi>{32} <hi rend="italic">in Westsexe</hi> (<hi rend="italic">see Gl</hi> Wessex 3) Rs</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">If anyone is killed in a <hi rend="italic">hloþ</hi> (band of men), let the slayer pay the wergild to the kinsmen and the manbot to the lord, and all who were present the <hi rend="italic">hlo[ð]bot</hi> (compensation for taking part in a band), so that they pay for a <hi rend="italic">tƿihindeman</hi> (man of 200-shilling wergild) thirty shillings, for a <hi rend="italic">sixhinde</hi> (man of 600-shilling wergild) sixty shillings, for a <hi rend="italic">tƿelfhinde</hi> (man of 1200-shilling wergild) 120 shillings.</ab>
      </div>
