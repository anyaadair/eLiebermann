      <div type="clause" n="24A">
        <head><ref type="lawCode" target="law:IudDeiVII">Iud Dei VII</ref> 24A</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei VII 24A" corresp="#wit-ci"><pb n="414" ed="#liebermann"/>We biddað þe, drihten hælend<ptr type="liebermannNote" n="6" target="#IudDeiVII_24A.lnote.oe.6"/> Crist, þ<hi rend="italic">æt</hi> þu sette her on þin tacn swa: gif þes mann (þas<ptr type="liebermannNote" n="4" target="#IudDeiVII_24A.lnote.oe.4"/> menn) scildig si (-dige<ptr type="liebermannNote" n="4" target="#IudDeiVII_24A.lnote.oe.4-2"/> syn), na si he<ptr type="liebermannNote" n="15" target="#IudDeiVII_24A.lnote.oe.15"/> (sin<ptr type="liebermannNote" n="4" target="#IudDeiVII_24A.lnote.oe.4-2"/> hy) on þis wæter afangen.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 414 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_24A.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">‘dazu beistimmtest’ nicht in Vt, obwohl aus Latein</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘consented thereto’ not in Vt, although from the Latin</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_24A.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ähnlich</hi> XIII 13, 1. VIII 2</seg><seg type="translation" xml:lang="en" source="#claude">similarly XIII 13, 1. VIII 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_24A.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_24A.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de">hælend <hi rend="italic">für</hi> Iesus <hi rend="italic">auch</hi> IV 2²⁹</seg><seg type="translation" xml:lang="en" source="#claude">hælend for Iesus also IV 2²⁹</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_24A.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de">he <hi rend="italic">doppelt</hi></seg><seg type="translation" xml:lang="en" source="#claude">he twice</seg></note>
      </div>
