      <div type="clause" n="90.7a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 90.7a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 90.7a" corresp="#wit-lat"><pb n="606" ed="#liebermann"/>Uel, si quis obstinata mente contra omnium estimacionem uindicare<ptr type="liebermannNote" n="7" target="#Hn_90-7a.lnote.oe.7"/> uel weram<ptr type="liebermannNote" n="8" target="#Hn_90-7a.lnote.oe.8"/> exigere presumpserit<ptr type="liebermannNote" n="f" target="#Hn_90-7a.lnote.oe.f"/>, si<ptr type="liebermannNote" n="9" target="#Hn_90-7a.lnote.oe.9"/> placet, ascendat et illum similiter obruat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 606 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-7a.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">strenge Vergeltung am absichtslosen Missethäter umgeht jüngerer Rechtsbrauch zu Gunsten des moralisch Unschuldigen, indem er sie durch peinliche Genauigkeit ad absurdum führt, sie an Unerfüllbares knüpfend; Parallelen aus Altindien und dem Mittelalter Lübecks und Briels bei Brunner</hi> Absichtslose Missethat 818, <hi rend="italic">aus heutigem Abessynien bei Pollock-Maitland</hi> HEL. II 470</seg><seg type="translation" xml:lang="en" source="#claude">later legal custom evades strict retribution upon the unintentional wrongdoer, in favour of the morally innocent, by reducing it ad absurdum through meticulous exactness, tying it to conditions that cannot be fulfilled; parallels from ancient India and from medieval Lübeck and Briel in Brunner Absichtslose Missethat 818, and from present-day Abyssinia in Pollock-Maitland HEL. II 470</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-7a.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">iudic. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">iudic. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-7a.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-7a.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">si p. <hi rend="italic">doppelt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">si p. twice Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-7a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Humor 1—<hi rend="italic">weram</hi>{8} fehlt—90, 9 <hi rend="italic">half</hi>.{12} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Humor 1—<hi rend="italic">weram</hi>{8} missing—90, 9 <hi rend="italic">half</hi>.{12} Rs</seg></note>
      </div>
