    <body>
      <div type="clause" n="9a">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 9a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 9a"><pb n="633" ed="#liebermann"/>Et quos Dominus<ptr type="liebermannNote" n="20" target="#ECfRetr_9a.lnote.la.20"/> per misericordiam suam, <hi rend="bold">non</hi><ptr type="liebermannNote" n="21" target="#ECfRetr_9a.lnote.la.21"/> <hi rend="bold">per merita</hi><ptr type="liebermannNote" n="22" target="#ECfRetr_9a.lnote.la.22"/>, saluare <hi rend="bold">uoluerit,</hi> quieti sint<ptr type="liebermannNote" n="23" target="#ECfRetr_9a.lnote.la.23"/> et libere<ptr type="liebermannNote" n="24" target="#ECfRetr_9a.lnote.la.24"/> <hi rend="bold">recedant;</hi> et quos iniquitas <hi rend="bold">culpe, non Dominus</hi><ptr type="liebermannNote" n="25" target="#ECfRetr_9a.lnote.la.25"/>, damnauerit<ptr type="liebermannNote" n="26" target="#ECfRetr_9a.lnote.la.26"/>, iusticia regis de<ptr type="liebermannNote" n="27" target="#ECfRetr_9a.lnote.la.27"/> ipsis iusticiam faciat.</ab>
        <note type="comparison" source="#liebermann" n="633"><label>printed alongside</label> <ref target="clause:ECf_9a">ECf 9a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 633 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">There is no note 19 in the ECf retr column of this page: Liebermann’s numbering goes from 18 to 20.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9a.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">Deus <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">Deus Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9a.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9a.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">eorum <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds eorum</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9a.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">sunt <hi rend="italic">Lb Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">sunt Lb Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9a.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">liberi <hi rend="italic">Hv Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">liberi Hv Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9a.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">Deus <hi rend="italic">Va Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">Deus Va Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9a.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">-uit <hi rend="italic">Db;</hi> -rat <hi rend="italic">Ph;</hi> calumpniauerit <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uit Db; -rat Ph; calumpniauerit K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9a.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">ius. de i. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">ius. de i. Lond</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And those whom the Lord has willed to save through his mercy, not through merits, let them be quit and depart freely; and those whom the iniquity of their guilt, not the Lord, has condemned, let the king's justice do justice upon them.</ab>
      </div>
    </body>
