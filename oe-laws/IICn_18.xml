    <body>
      <div type="clause" n="18">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 18</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="18" corresp="#wit-g-a"><pb n="320" ed="#liebermann"/>⁊ hæbbe<ptr type="liebermannNote" n="19" target="#IICn_18.lnote.oe.19"/> mann þriwa on geare<ptr type="liebermannNote" n="20" target="#IICn_18.lnote.oe.20"/> burhgemot ⁊ tuwa<ptr type="liebermannNote" n="21" target="#IICn_18.lnote.oe.21"/> scirgemot, butan<ptr type="liebermannNote" n="13" target="#IICn_18.lnote.oe.13-2"/> hit oftor sig.<ptr type="liebermannNote" n="11" target="#IICn_18.lnote.oe.11"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="18" corresp="#wit-b"><pb n="320" ed="#liebermann"/>⁊ habbe man ðreowa burhgemot ⁊ twá scirgemot be<ptr type="liebermannNote" n="5" target="#IICn_18.lnote.oe.5-2"/> wíte, ealswa hit riht is, buton hit oftor [neod<ptr type="liebermannNote" n="6" target="#IICn_18.lnote.oe.6-2"/>] sy.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="18" corresp="#wit-a"><pb n="320" ed="#liebermann"/>And habbe man ðriwa on geara burhgemot ⁊ twa scyrgemot, buton hit oftor sy.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="18" corresp="#wit-q"><pb n="321" ed="#liebermann"/>Et habeatur<ptr type="liebermannNote" n="13" target="#IICn_18.lnote.oe.13"/> in anno ter burgimotus<ptr type="liebermannNote" n="14" target="#IICn_18.lnote.oe.14"/> et scyremotus<ptr type="liebermannNote" n="15" target="#IICn_18.lnote.oe.15"/> bis, nisi sepius sit (necesse<ptr type="liebermannNote" n="16" target="#IICn_18.lnote.oe.16"/>).</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="18" corresp="#wit-inst-cn"><pb n="321" ed="#liebermann"/>Ciuilia placita ter in anno teneantur, et comitatus bis in anno congregetur, nisi plus necesse sit.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="18" corresp="#wit-cons-cn"><pb n="321" ed="#liebermann"/>Et conuentus urbis ter in anno et bis conuentus comitatus aut sepius.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="18" corresp="#wit-b"><pb n="182" ed="#robertson"/>⁊ habbe man ðreowa<ptr type="editorNote" n="7" target="#IICn_18.robnote.fn.7"/> burhgemot ⁊ twa<ptr type="editorNote" n="8" target="#IICn_18.robnote.fn.8"/>́ scirgemot be wíte, ealswa hit riht <ptr type="editorNote" n="9" target="#IICn_18.robnote.fn.9"/>is, buton hit oftor ne<ptr type="editorNote" n="10" target="#IICn_18.robnote.fn.10"/>od sy.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="262" ed="#rabin-doml"/>And hæbbe mann þriwa on geare burhgemot and tuwa scirgemot, butan hit oftor sig.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><ptr type="liebermannNote" n="1" target="#IICn_18.lnote.de.1"/><pb n="321" ed="#liebermann"/>Und dreimal im Jahre werde Stadtgericht<ptr type="liebermannNote" n="2" target="#IICn_18.lnote.de.2"/> und zweimal (zwei<ptr type="liebermannNote" n="3" target="#IICn_18.lnote.de.3"/> <hi rend="italic">B A</hi>) Grafschaftsgericht<ptr type="liebermannNote" n="4" target="#IICn_18.lnote.de.4"/> gehalten, wenn<ptr type="liebermannNote" n="5" target="#IICn_18.lnote.de.5"/> es nicht öfter (nöthig <hi rend="italic">B; Quadr. II; Inst</hi>.) ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let the borough-court be held three times a year and the shire-court twice (two, B A), unless it is (needed, B; Quadr. II; Inst.) more often.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_18.robnote.n.1"/><pb n="183" ed="#robertson"/>And the borough court shall be held three times and the shire court twice, in accordance with the law<ptr type="editorNote" n="2" target="#IICn_18.robnote.n.2"/>, under pain of fine, unless need arises for more frequent meetings.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="263" ed="#rabin-doml"/>And the borough court is to meet three times a year and the shire court twice unless the need arises more frequently.</ab>
        <note type="comparison" source="#liebermann" n="321"><ref target="clause:IIIEg_5-1">III Eg 5.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 5, 1</note>
        <note type="editorial">B's ‘be wite, ealswa hit riht is’ is probably wrongly repeated from 17.1. Liebermann compares III Eg 5.1.; BR: added from Gesetze I p. 321, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">on geare: omitted B</note>
        <note type="textual" source="#rabin-doml">tuwa: twa AB</note>
        <note type="textual" source="#rabin-doml">scirgemot: B adds be wite ealswa hit riht is</note>
        <note type="textual" source="#rabin-doml">oftor: B adds neod in a sixteeenth-century hand</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de">habeatur <hi rend="italic">zu ergänzen</hi></seg><seg type="translation" xml:lang="en" source="#claude">habeatur to be supplied</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de">com̄ut. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">com̄ut. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de">be — is <hi rend="italic">wohl nur irrig aus</hi> 17, 1 <hi rend="italic">wiederholt; vgl.</hi> 23, 1</seg><seg type="translation" xml:lang="en" source="#claude">be — is probably merely repeated in error from 17, 1; cf. 23, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. übergeschr.; vgl. Quadr. Inst.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above in the 16th cent.; cf. Quadr. Inst.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de">hat' <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">hat' Dm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de">burgesm. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">burgesm. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de">sir. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">sir. R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus DmTHk; fehlt KR</hi></seg><seg type="translation" xml:lang="en" source="#claude">from DmTHk; lacking in KR</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de">habbe mon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">habbe mon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de">-ra <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ra Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de">twa scyreg. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">twa scyreg. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18.lnote.oe.13-2" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de">buton <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">buton Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_18.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">205</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Vielleicht benutzt durch Hn 7, 4. 51, 2</seg><seg type="translation" xml:lang="en" source="#claude">Perhaps used by Hn 7, 4. 51, 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_18.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">205</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">civilia</hi> in Inst meint ‘städtisch’, nicht etwa ‘Zivilprozess’.—In <hi rend="italic">burgimot</hi> Q's ist -<hi rend="italic">i</hi>- mittelengl. statt Präfix <hi rend="italic">ge</hi>- und nicht, wie Schreiber K um 1310 meint, Genetiv</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">civilia</hi> in Inst means ‘urban’, not, say, ‘civil procedure’.—In Q's <hi rend="italic">burgimot</hi> the -<hi rend="italic">i</hi>- is Middle English for the prefix <hi rend="italic">ge</hi>-, and not, as scribe K c. 1310 thinks, a genitive</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_18.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">205</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">twa</hi> zu lesen und ‘zweimal’ mit Früheren zu übersetzen, geht nicht an; <hi rend="italic">vgl. Wb: tuwa</hi>, <hi rend="italic">twegen</hi></seg><seg type="translation" xml:lang="en" source="#claude">To read <hi rend="italic">twa</hi> and to translate it ‘twice’ with earlier editors is not admissible; <hi rend="italic">cf. Wb: tuwa</hi>, <hi rend="italic">twegen</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_18.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">205</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">B's Zusatz ‘bei Strafe, so wie es richtig ist’ scheint mir Dittographie aus 17, 1. Cohn (<hi rend="italic">Justizweigerung</hi> 114) sieht darin mit Unrecht eine Bischof und Ealdorman bedrohende Strafe</seg><seg type="translation" xml:lang="en" source="#claude">B's addition ‘under penalty, as is right’ seems to me a dittography from 17, 1. Cohn (<hi rend="italic">Justizweigerung</hi> 114) wrongly sees in it a penalty threatening the bishop and ealdorman</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_18.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">205</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Der Zusatz bed. nur ‘mindestens’</seg><seg type="translation" xml:lang="en" source="#claude">The addition means only ‘at least’</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_18.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">354</biblScope></bibl><seg type="original" xml:lang="en">Cf. III Edg. 5, 1.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_18.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">354</biblScope></bibl><seg type="original" xml:lang="en">This phrase, which appears only in B, has perhaps been taken over from the preceding clause.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_18.robnote.fn.7" n="7" source="#robertson"><bibl><biblScope unit="page">182</biblScope></bibl><label>ðreowa</label><seg type="original" xml:lang="en"><hi rend="italic">þriwa on geare</hi> (<hi rend="italic">-a</hi>) G, A, Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_18.robnote.fn.8" n="8" source="#robertson"><bibl><biblScope unit="page">182</biblScope></bibl><label>twá</label><seg type="original" xml:lang="en"><hi rend="italic">tuwa</hi> G.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_18.robnote.fn.9" n="9" source="#robertson"><bibl><biblScope unit="page">182</biblScope></bibl><label>is</label><seg type="original" xml:lang="en"><hi rend="italic">be w.—riht is.</hi> Only in B and probably carried over from the preceding clause.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_18.robnote.fn.10" n="10" source="#robertson"><bibl><biblScope unit="page">182</biblScope></bibl><label>neod</label><seg type="original" xml:lang="en">Om. G, A, Ld; added in B in 16th cent.</seg></note>
      </div>
