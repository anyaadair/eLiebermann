      <div type="clause" n="36.1d">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 36.1d</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 36.1d" corresp="#wit-lat"><pb n="566" ed="#liebermann"/>Quodsi iuramentum pacationis<ptr type="liebermannNote" n="39" target="#Hn_36-1d.lnote.oe.39"/> exigitur, iuret — sicut presens causa dictabit in circumstantiis, uel paupertatis uel<ptr type="liebermannNote" n="t" target="#Hn_36-1d.lnote.oe.t"/> qui aderunt optentibus —: quod<ptr type="liebermannNote" n="u" target="#Hn_36-1d.lnote.oe.u"/>, si ille sic esset pro huiusmodi forisfacto, hoc reciperet uel hoc modo dimitteret.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 566 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-1d.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">aliis <hi rend="italic">hinzuzudenken</hi></seg><seg type="translation" xml:lang="en" source="#claude">aliis to be understood</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-1d.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Leis Wl 10, 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. Leis Wl 10, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-1d.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. Corr. aus</hi> pacc. <hi rend="italic">Sc;</hi> plac. <hi rend="italic">Co Or Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the corrector from pacc. Sc; plac. Co Or Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-1d.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Gleichheitseid 5.—<hi rend="italic">obtent</hi>.—36, 2 <hi rend="italic">quod</hi>{42} <hi rend="italic">t. r., non etiam con</hi>.—36, 2a—<hi rend="italic">eff</hi>.{45} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Gleichheitseid 5.—<hi rend="italic">obtent</hi>.—36, 2 <hi rend="italic">quod</hi>{42} <hi rend="italic">t. r., non etiam con</hi>.—36, 2a—<hi rend="italic">eff</hi>.{45} Rs</seg></note>
