    <body>
      <div type="clause" n="92.7">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 92.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 92.7" corresp="#wit-lat"><pb n="608" ed="#liebermann"/>Et licet malefactor regem<ptr type="liebermannNote" n="d" target="#Hn_92-7.lnote.oe.d"/> requirat, ut uitam<ptr type="liebermannNote" n="6" target="#Hn_92-7.lnote.oe.6"/> et membra recipiat<ptr type="liebermannNote" n="7" target="#Hn_92-7.lnote.oe.7"/>, nichilominus murdrum soluatur, sicut diximus.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 608 (two independent readings of the page images, differences settled against the page); Liebermann’s Erklärung (Gesetze III p. 329) has the note number 0 after ‘ui.’ (probably for 6 or 9); transcribed as printed</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-7.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Mord ist nach</hi> II Cn. 56 = Hn. 71, 1<hi rend="italic">a</hi>. 92, 15; 19 <hi rend="italic">busslos; begnadigen, d.h. Busse eintreten lassen, kann nur der König</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">According to</hi> II Cn. 56 = Hn. 71, 1<hi rend="italic">a</hi>. 92, 15; 19 <hi rend="italic">murder is bootless; only the king can grant pardon, i.e. allow compensation to be paid instead</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-7.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de">inquirat <hi rend="italic">fügt zu K Co Or Gi;</hi> requirat <hi rend="italic">fügt zu Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">inquirat added by K Co Or Gi; requirat added by Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-7.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-7.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Begnadigung 7—<hi rend="italic">ui</hi>.{0} <hi rend="italic">inquirat et m., n</hi>. ohne <hi rend="italic">re</hi>. Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Begnadigung 7—<hi rend="italic">ui</hi>.{0} <hi rend="italic">inquirat et m., n</hi>. without <hi rend="italic">re</hi>. Rs</seg></note>
      </div>
