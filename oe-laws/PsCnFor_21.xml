      <div type="clause" n="21">
        <head><ref type="lawCode" target="law:PsCnFor">Ps Cn for</ref> 21</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Ps Cn for 21" corresp="#wit-ho-st-cii"><pb n="623" ed="#liebermann"/>Pena et forisfactio non una<ptr type="liebermannNote" n="l" target="#PsCnFor_21.lnote.la.fn.l"/> eademque erit liberalis<ptr type="liebermannNote" n="23" target="#PsCnFor_21.lnote.la.23"/>, quem Dani<ptr type="liebermannNote" n="m" target="#PsCnFor_21.lnote.la.fn.m"/> ealderman<ptr type="liebermannNote" n="24" target="#PsCnFor_21.lnote.la.24"/> uocant, et illiberalis<ptr type="liebermannNote" n="25" target="#PsCnFor_21.lnote.la.25"/>, domini<ptr type="liebermannNote" n="26" target="#PsCnFor_21.lnote.la.26"/> et serui, noti et ignoti;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 623 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-ho-st-cii">The penalty and forfeiture shall not be one and the same for a noble, whom the Danes call <hi rend="italic">ealderman</hi>, and for a non-noble, for lord and slave, for known and unknown;</ab>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_21.lnote.la.fn.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">623</biblScope></bibl><seg type="original" xml:lang="de">in regiis .. debitoribus cohercendis baronum regis et ceterorum .. par condicio non est <hi rend="italic">Dial. scacc.</hi> II 19</seg><seg type="translation" xml:lang="en" source="#claude">in regiis .. debitoribus cohercendis baronum regis et ceterorum .. par condicio non est Dial. scacc. II 19</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_21.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">623</biblScope></bibl><seg type="original" xml:lang="de">-li <hi rend="italic">St Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">-li St Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_21.lnote.la.fn.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">623</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ebenso o.</hi> 3, 1</seg><seg type="translation" xml:lang="en" source="#claude">likewise above 3, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_21.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">623</biblScope></bibl><seg type="original" xml:lang="de">el. <hi rend="italic">St;</hi> eldermen <hi rend="italic">Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">el. St; eldermen Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_21.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">623</biblScope></bibl><seg type="original" xml:lang="de">-li <hi rend="italic">St;</hi> illi liberalis <hi rend="italic">Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">-li St; illi liberalis Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_21.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">623</biblScope></bibl><seg type="original" xml:lang="de">hominis <hi rend="italic">Cii;</hi> homines <hi rend="italic">St</hi></seg><seg type="translation" xml:lang="en" source="#claude">hominis Cii; homines St</seg></note>
      </div>
