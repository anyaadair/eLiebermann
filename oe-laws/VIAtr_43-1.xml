      <div type="clause" n="43.1">
        <head><ref type="lawCode" target="law:VIAtr">VI Atr</ref> 43.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="43.1" corresp="#wit-k"><pb n="258" ed="#liebermann"/>⁊ freolsa ⁊ fæstena rihtlice healdan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="43.1" corresp="#wit-d-incomplete"><pb n="258" ed="#liebermann"/>⁊ freolsa ⁊ fæstena rihtlice healdan.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="43[b]" corresp="#wit-k"><pb n="104" ed="#robertson"/>⁊ freolsa ⁊ fæstena rihtlice healdan.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-k"><pb n="176" ed="#rabin-doml"/>and freolsa and fæstena rihtlice healdan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="259" ed="#liebermann"/>und Feiertage und Fasten richtig halten.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">and keep feasts and fasts rightly.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-k"><pb n="105" ed="#robertson"/>and duly observe festivals and fasts.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-k"><pb n="177" ed="#rabin-doml"/>and feasts and fasts properly kept.</ab>
        <note type="comparison" source="#liebermann" n="259"><ref target="clause:VIAtr_22">VI Atr 22</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 22</note>
