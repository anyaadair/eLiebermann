    <body>
      <div type="clause" n="66">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 66</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="66" corresp="#wit-e"><pb n="118" ed="#liebermann"/>CX. Se ðe hæbbe<ptr type="liebermannNote" n="13" target="#Ine_66.lnote.oe.13"/> þreora<ptr type="liebermannNote" n="14" target="#Ine_66.lnote.oe.14"/> hida<ptr type="liebermannNote" n="9" target="#Ine_66.lnote.oe.9"/>, tæcne<ptr type="liebermannNote" n="15" target="#Ine_66.lnote.oe.15"/> oþres healfes.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="66" corresp="#wit-ot-frags"><pb n="118" ed="#liebermann"/>Se þe hæbbe þreora hida ....</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="66" corresp="#wit-h"><pb n="118" ed="#liebermann"/>CX. Se þe hæbbe III hida londes<ptr type="liebermannNote" n="1" target="#Ine_66.lnote.oe.1"/>, tæce<ptr type="liebermannNote" n="3" target="#Ine_66.lnote.oe.3"/> oðres healfes hides gesettes.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="66" corresp="#wit-b-no-prol"><pb n="119" ed="#liebermann"/>Be ðreo<hi rend="italic">m</hi> h<hi rend="italic">idum</hi>. Se ðe hæbbe ðreo hída, tæce oðres healfes.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="66" corresp="#wit-q"><pb n="119" ed="#liebermann"/>Qui habet tres hidas terre, tecnet<ptr type="liebermannNote" n="6" target="#Ine_66.lnote.oe.6"/> unam hidam et dimidiam.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="58" ed="#attenborough"/>[Be ðreom hidum.] Se ðe hæbbe þreora hida<ptr type="editorNote" n="1" target="#Ine_66.attnote.fn.1"/>, tæcne<ptr type="editorNote" n="3" target="#Ine_66.attnote.fn.3"/> oþres healfes<ptr type="editorNote" n="4" target="#Ine_66.attnote.fn.4"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="67.3" corresp="#wit-e"><pb n="426" ed="#jurasinski-and-oliver"/>{CX} Se ðe hæbbe þreora hida, tæcne oþres healfes.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="119" ed="#liebermann"/>Wer 3 Hiden hat, weise 1½<ptr type="liebermannNote" n="1" target="#Ine_66.lnote.de.1"/> (besäte Hiden<ptr type="liebermannNote" n="2" target="#Ine_66.lnote.de.2"/>) vor.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Whoever has 3 hides, let him show 1½ (sown hides).</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="59" ed="#attenborough"/>He who has [a holding of] 3 hides shall show one hide and a half under cultivation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="407" ed="#whitelock"/>He who has three hides is to show one and a half.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="427" ed="#jurasinski-and-oliver"/>He who has three hides must show one and a half.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_66.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">119</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so T;</hi> tectet <hi rend="italic">Lond;</hi> tenet <hi rend="italic">R;</hi> reddat <hi rend="italic">M Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus T; tectet Lond; tenet R; reddat M Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_66.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">118</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_66.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">118</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> tæcne</seg><seg type="translation" xml:lang="en" source="#claude">altered to tæcne</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_66.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">118</biblScope></bibl><seg type="original" xml:lang="de">hæfþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hæfþ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_66.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">118</biblScope></bibl><seg type="original" xml:lang="de">þry <hi rend="italic">So;</hi> ðreo <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þry So; ðreo Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_66.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">118</biblScope></bibl><seg type="original" xml:lang="de">hyda <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hyda So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_66.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">118</biblScope></bibl><seg type="original" xml:lang="de">tæce <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">tæce Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_66.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">80</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Über das Genus <hi rend="italic">s. Wb: hid</hi></seg><seg type="translation" xml:lang="en" source="#claude">On the gender see <hi rend="italic">Wb: hid</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_66.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">80</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">H Q füllen die archaische Ellipse aus</seg><seg type="translation" xml:lang="en" source="#claude">H Q fill out the archaic ellipsis</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_66.attnote.fn.1" n="1" source="#attenborough"><bibl><biblScope unit="page">58</biblScope></bibl><label>hida</label><seg type="original" xml:lang="en"><hi rend="italic">hida londes</hi>. H.</seg><note type="remark" resp="#claude">The number 1 is printed 2 times on the page (65, 66), with one footnote.</note></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_66.attnote.fn.3" n="3" source="#attenborough"><bibl><biblScope unit="page">58</biblScope></bibl><label>tæcne</label><seg type="original" xml:lang="en"><hi rend="italic">tæce</hi>. H, B &amp; Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_66.attnote.fn.4" n="4" source="#attenborough"><bibl><biblScope unit="page">58</biblScope></bibl><label>healfes</label><seg type="original" xml:lang="en"><hi rend="italic">healfes hides gesettes</hi>. H.</seg></note>
      </div>
    </body>
