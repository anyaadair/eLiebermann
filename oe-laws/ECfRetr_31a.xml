    <body>
      <div type="clause" n="31a">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 31a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 31a"><pb n="653" ed="#liebermann"/>Qui <hi rend="bold">uero</hi> super <hi rend="bold">eas</hi><ptr type="liebermannNote" n="1" target="#ECfRetr_31a.lnote.la.1"/> dominabantur: trehingreues<ptr type="liebermannNote" n="30" target="#ECfRetr_31a.lnote.la.30"/>; ad <hi rend="bold">hos</hi> deferebantur<ptr type="liebermannNote" n="31" target="#ECfRetr_31a.lnote.la.31"/> cause<ptr type="liebermannNote" n="32" target="#ECfRetr_31a.lnote.la.32"/> que non poterant diffiniri<ptr type="liebermannNote" n="33" target="#ECfRetr_31a.lnote.la.33"/> in wapentagiis.</ab>
        <note type="comparison" source="#liebermann" n="653"><label>printed alongside</label> <ref target="clause:ECf_31a">ECf 31a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 653 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31a.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31a.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv;</hi> -greue <hi rend="italic">Cb;</hi> -grefe <hi rend="italic">Lond;</hi> ðrihingerefas <hi rend="italic">Ld</hi> [<hi rend="italic">archaisirend?</hi>]; trihengr. <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv; -greue Cb; -grefe Lond; ðrihingerefas Ld [archaizing?]; trihengr. Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31a.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">diff. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">diff. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31a.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">ēē (<hi rend="italic">d. h.</hi> esse) qui <hi rend="italic">Lb;</hi> esse <hi rend="italic">Ph;</hi> trihinguie <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">ēē (i.e. esse) qui Lb; esse Ph; Hv adds trihinguie</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31a.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">defi. <hi rend="italic">Va Lond Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">defi. Va Lond Ld</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And those who had lordship over them were <hi rend="italic">trehingreues</hi> (riding-reeves); to these were brought the cases which could not be determined in the wapentakes.</ab>
      </div>
    </body>
  </text>
