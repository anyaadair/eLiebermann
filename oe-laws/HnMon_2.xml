    <body>
      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:HnMon">Hn mon</ref> 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-sc"><pb n="523" ed="#liebermann"/>Et si quis cum falso denario inuentus fuerit, si warant<ptr type="liebermannNote" n="6" target="#HnMon_2.lnote.oe.6"/> inde reuocauerit, ad eum ducatur<ptr type="liebermannNote" n="7" target="#HnMon_2.lnote.oe.7"/>; et si illum<ptr type="liebermannNote" n="8" target="#HnMon_2.lnote.oe.8"/> inde conprobare poterit, fiat<ptr type="liebermannNote" n="9" target="#HnMon_2.lnote.oe.9"/> iusticia mea de ipso warant<ptr type="liebermannNote" n="10" target="#HnMon_2.lnote.oe.10"/>.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="2" corresp="#wit-sc"><pb n="284" ed="#robertson"/>Et si quis cum falso denario inventus fuerit, si warant inde revocaverit, ad eum ducatur, et si illum inde conprobare poterit, fiat iusticia mea de ipso warant.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-sc"><pb n="285" ed="#robertson"/>And if anyone has been discovered with false money, and has vouched a warrantor for it, the prosecution shall be directed against the latter, and if he [the original defendant] succeeds in proving him guilty, justice in accordance with my laws shall be executed upon the warrantor himself.</ab>
        <note type="editorial">Added October 2026 from Robertson pp. 284–285 (text and translation); Liebermann’s text added from Gesetze I p. 523, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="HnMon_2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">523</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Sc Hg;</hi> -ntum <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">so Sc Hg;</hi> -ntum <hi rend="italic">K</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="HnMon_2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">523</biblScope></bibl><seg type="original" xml:lang="de">deuc., <hi rend="italic">mit geänd.</hi> d. <hi rend="italic">Hg;</hi> feuc. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">deuc., <hi rend="italic">with altered</hi> d. <hi rend="italic">Hg;</hi> feuc. <hi rend="italic">K</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="HnMon_2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">523</biblScope></bibl><seg type="original" xml:lang="de">-ud <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ud <hi rend="italic">K</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="HnMon_2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">523</biblScope></bibl><seg type="original" xml:lang="de">fiet <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">fiet <hi rend="italic">K</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="HnMon_2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">523</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Sc Hg;</hi> -nto <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">so Sc Hg;</hi> -nto <hi rend="italic">K</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="HnMon_2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">299</biblScope></bibl><seg type="original" xml:lang="de">Die Worte teilweise = CHn cor 5, 1.—<hi rend="italic">Vgl. Gl</hi> Gewährleisten 2a; Anefang 16e. 20d</seg><seg type="translation" xml:lang="en" source="#claude">The words partly = CHn cor 5, 1.—<hi rend="italic">Cf. Gl</hi> Gewährleisten 2a; Anefang 16e. 20d</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="HnMon_2.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">299</biblScope></bibl><seg type="original" xml:lang="de">Strafgericht; <hi rend="italic">s</hi>. folg. Z.</seg><seg type="translation" xml:lang="en" source="#claude">Criminal court; <hi rend="italic">see</hi> next l.</seg></note>
