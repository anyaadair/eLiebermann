      <div type="clause" n="9.11">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 9.11</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 9.11" corresp="#wit-lat"><pb n="556" ed="#liebermann"/>Soca uero placitorum alia<ptr type="liebermannNote" n="1" target="#Hn_9-11.lnote.oe.1"/> proprie pertinet ad fiscum regium<ptr type="liebermannNote" n="2" target="#Hn_9-11.lnote.oe.2"/> et singulariter<ptr type="liebermannNote" n="a" target="#Hn_9-11.lnote.oe.a"/>, alia participacione<ptr type="liebermannNote" n="b" target="#Hn_9-11.lnote.oe.b"/>, alia pertinet<ptr type="liebermannNote" n="3" target="#Hn_9-11.lnote.oe.3"/> uicecomitibus et ministris regiis in<ptr type="liebermannNote" n="c" target="#Hn_9-11.lnote.oe.c"/> firma sua, alia pertinet<ptr type="liebermannNote" n="3" target="#Hn_9-11.lnote.oe.3"/> baronibus socam<ptr type="liebermannNote" n="4" target="#Hn_9-11.lnote.oe.4"/> et sacam habentibus<ptr type="liebermannNote" n="d" target="#Hn_9-11.lnote.oe.d"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 556 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-11.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 10, 1 solus super omnes</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 10, 1 solus super omnes</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-11.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">z. B.</hi> 11, 1<hi rend="italic">a</hi>: Christo et regi; <hi rend="italic">vgl.</hi> 11, 15 <hi rend="italic">ff.</hi> 21</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">e.g.</hi> 11, 1<hi rend="italic">a</hi>: Christo et regi; <hi rend="italic">cf.</hi> 11, 15 <hi rend="italic">ff.</hi> 21</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-11.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de">innerhalb (kraft) des durch sie dem Fiscus abgepachteten Amtes; <hi rend="italic">vgl.</hi> 10, 4</seg><seg type="translation" xml:lang="en" source="#claude">within (by virtue of) the office which they farm from the fisc; <hi rend="italic">cf.</hi> 10, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-11.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Gerichtsbarkeit sammt Einkünften genossen auch Städte und Afterlehnsleute</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Jurisdiction together with its revenues was enjoyed by towns and sub-vassals too</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-11.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de">alie pr. pertinent <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">alie pr. pertinent <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-11.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert vom Corr. aus</hi> regnum <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the corrector from regnum <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-11.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de">-nent <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nent <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-11.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de">socham et sacham <hi rend="italic">Lond Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">socham et sacham <hi rend="italic">Lond</hi> edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-11.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">317</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Justizertrag 8—<hi rend="italic">alie</hi>{1} <hi rend="italic">pr. pertinent</hi>—10 <hi rend="italic">legis</hi>{7} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Justizertrag 8—<hi rend="italic">alie</hi>{1} <hi rend="italic">pr. pertinent</hi>—10 <hi rend="italic">legis</hi>{7} Rs</seg></note>
      </div>
