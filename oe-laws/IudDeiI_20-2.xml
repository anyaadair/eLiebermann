      <div type="clause" n="20.2">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 20.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 20.2" corresp="#wit-lat"><pb n="404" ed="#liebermann"/>ut innocentes<ptr type="liebermannNote" n="34" target="#IudDeiI_20-2.lnote.oe.34"/> a crimine furti<ptr type="liebermannNote" n="35" target="#IudDeiI_20-2.lnote.oe.35"/> — uel<ptr type="liebermannNote" n="36" target="#IudDeiI_20-2.lnote.oe.36"/> homicidii uel<ptr type="liebermannNote" n="37" target="#IudDeiI_20-2.lnote.oe.37"/> adulterii<ptr type="liebermannNote" n="38" target="#IudDeiI_20-2.lnote.oe.38"/> aut alterius naeui —, cuius examinationem agimus, more aquae in se recipiant et in<ptr type="liebermannNote" n="39" target="#IudDeiI_20-2.lnote.oe.39"/> profundum pertrahant, conscios<ptr type="liebermannNote" n="40" target="#IudDeiI_20-2.lnote.oe.40"/> autem huius criminis a se repellant atque reiciant nec patiantur recipere corpus, quod ab onere<ptr type="liebermannNote" n="41" target="#IudDeiI_20-2.lnote.oe.41"/> bonitatis euacuatum uentus iniquitatis alleuauit et in[ane<ptr type="liebermannNote" n="42" target="#IudDeiI_20-2.lnote.oe.42"/>] constituit;</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">vgl. u. 22, 3;</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 404 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_20-2.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi> -tem <hi rend="italic">Ci H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tem written above Ci H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_20-2.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">f.—neui <hi rend="italic">am Rande H</hi></seg><seg type="translation" xml:lang="en" source="#claude">f.—neui in the margin H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_20-2.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">uel—naeui <hi rend="italic">fehlt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel—naeui lacking in Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_20-2.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">aut ad. uel al. <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">aut ad. uel al. Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_20-2.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">uel ueneficii</hi> <hi rend="italic">fügt zu Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">uel ueneficii</hi> added by Vt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_20-2.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">in prof.—20, 3 <hi rend="italic">zum Theil wörtlich gleich</hi> 22, 3 <hi rend="italic">ff.</hi></seg><seg type="translation" xml:lang="en" source="#claude">in prof.—20, 3 partly verbally identical with 22, 3ff.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_20-2.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">-um <hi rend="italic">übergeschr. Ci H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-um written above Ci H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_20-2.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">honore <hi rend="italic">Ch Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">honore Ch Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_20-2.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so nur Co;</hi> in hanc <hi rend="italic">alle übrigen Hss. Edd.; aber</hi> ab onere bonitatis … inane <hi rend="italic">auch</hi> 22, 4</seg><seg type="translation" xml:lang="en" source="#claude">thus only Co; in hanc all the other MSS and edd.; but ab onere bonitatis … inane also 22, 4</seg></note>
      </div>
