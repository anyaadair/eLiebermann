    <body>
      <div type="clause" n="62.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 62.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="62.1" corresp="#wit-e"><pb n="82" ed="#liebermann"/>Gif hit forad<ptr type="liebermannNote" n="26" target="#Af_62-1.lnote.oe.26"/> sie, sio bot eac bið XXX scill.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="62.1" corresp="#wit-h"><pb n="82" ed="#liebermann"/>Gif hit forod<ptr type="liebermannNote" n="11" target="#Af_62-1.lnote.oe.11"/> sy<ptr type="liebermannNote" n="10" target="#Af_62-1.lnote.oe.10"/>, seo<ptr type="liebermannNote" n="12" target="#Af_62-1.lnote.oe.12"/> bot bið eac XXX scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="62.1" corresp="#wit-b-no-prol"><pb n="82" ed="#liebermann"/>Gyf hit forad sy, seo bot bið XXX scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="62.1" corresp="#wit-q"><pb n="83" ed="#liebermann"/>Si frangatur, ęque sit emendatio XXX solid.<ptr type="liebermannNote" n="26" target="#Af_62-1.lnote.oe.26-2"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="88" ed="#attenborough"/>Gif hit forad sie, sio bot eac bið XXX scill.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="65.1" corresp="#wit-e"><pb n="356" ed="#jurasinski-and-oliver"/>Gif hit forad sie, sio bot eac bið XXX scill.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="83" ed="#liebermann"/>Wenn es zerbrochen<ptr type="liebermannNote" n="1" target="#Af_62-1.lnote.de.1"/> ist, ist die Busse ebenfalls 30 Schilling.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If it is broken, the compensation is likewise 30 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="89" ed="#attenborough"/>If it is fractured, 30 shillings shall also be the compensation [to be paid].</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="357" ed="#jurasinski-and-oliver"/>If it is broken, the compensation is likewise 30 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_62-1.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">forod sy, seo bot biþ eac <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">forod sy, seo bot biþ eac Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_62-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> forad</seg><seg type="translation" xml:lang="en" source="#claude">altered to forad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_62-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_62-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_62-1.lnote.oe.26-2" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">emendetur <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">emendetur added by Hk</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_62-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl.</hi> Gliederbussen 12</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf.</hi> Gliederbussen 12</seg></note>
      </div>
    </body>
