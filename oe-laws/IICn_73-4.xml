        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_73-4.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">213</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Benutzt durch Hn 14, 6.—<hi rend="italic">Vgl. Gl</hi> eheliches Güterrecht 3.h; Heergewäte 8</seg><seg type="translation" xml:lang="en" source="#claude">Used by Hn 14, 6.—<hi rend="italic">Cf. Gl</hi> eheliches Güterrecht 3.h; Heergewäte 8</seg></note>
