      <div type="clause" n="8">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 8" corresp="#wit-lat"><pb n="423" ed="#liebermann"/>(Oratio.<ptr type="liebermannNote" n="18" target="#IudDeiXIII_8.lnote.oe.18"/>) Domine<ptr type="liebermannNote" n="19" target="#IudDeiXIII_8.lnote.oe.19"/> Deus omnipotens, qui baptismum in aqua fieri iussisti et per lauacrum regenerationis humano generi remissionem peccatorum donare dignatus es, sanctifica, quesumus, hanc aquam, quam<ptr type="liebermannNote" n="20" target="#IudDeiXIII_8.lnote.oe.20"/> in tuo nomine benedicimus, et iustum in ea discerne iudicium, qui solus es iustus iudex et fortis, ut, si reus<ptr type="liebermannNote" n="21" target="#IudDeiXIII_8.lnote.oe.21"/> sit homo iste de praenominata re, aqua, quę in baptismo eum accepit<ptr type="liebermannNote" n="22" target="#IudDeiXIII_8.lnote.oe.22"/>, nunc non recipiat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 423 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_8.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Tr; fehlt Vt2 Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Tr; omitted in Vt2 Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_8.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">8 = <hi rend="italic">Zeu.</hi> 648&lt;sub&gt;30&lt;/sub&gt;. 702&lt;sub&gt;24&lt;/sub&gt;</seg><seg type="translation" xml:lang="en" source="#claude">8 = Zeu. 648&lt;sub&gt;30&lt;/sub&gt;. 702&lt;sub&gt;24&lt;/sub&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_8.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">q. in t. n. b. <hi rend="italic">fehlt Zeu</hi> 702&lt;sub&gt;26&lt;/sub&gt;</seg><seg type="translation" xml:lang="en" source="#claude">q. in t. n. b. omitted in Zeu 702&lt;sub&gt;26&lt;/sub&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_8.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">est, <hi rend="italic">darüber roth</hi> [re]i sunt, <hi rend="italic">und so oft Plural übergeschr. Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">est, above it in red [re]i sunt, and the plural is often written above in this way Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_8.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">susc. <hi rend="italic">Tr und einige Hss. Zeu.’s</hi></seg><seg type="translation" xml:lang="en" source="#claude">susc. Tr and some of Zeu.’s MSS</seg></note>
      </div>
