    <body>
      <div type="clause" n="28.2">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 28.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="28.2" corresp="#wit-e"><pb n="102" ed="#liebermann"/>Gif he onsacan<ptr type="liebermannNote" n="1" target="#Ine_28-2.lnote.oe.1-3"/> wille, do he ðæt be ðam féo ⁊ be ðam wite.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="28.2" corresp="#wit-h"><pb n="102" ed="#liebermann"/>Gif he onsacan wille, dó he ðæt be þam (were<ptr type="liebermannNote" n="1" target="#Ine_28-2.lnote.oe.1-2"/>) ⁊ be ðam wite.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="28.2" corresp="#wit-b-no-prol"><pb n="102" ed="#liebermann"/>Gyf he ætsacan wylle, do he þ<hi rend="italic">æt</hi> be ðam feo ⁊ be ðam wite.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="28.2" corresp="#wit-q"><pb n="103" ed="#liebermann"/>Si negare uelit, abneget<ptr type="liebermannNote" n="1" target="#Ine_28-2.lnote.oe.1"/> secundum modum pecunię et witę.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="44" ed="#attenborough"/>Gif he onsacan<ptr type="editorNote" n="9" target="#Ine_28-2.attnote.fn.9"/> wille, do he ðæt be ðam féo<ptr type="editorNote" n="10" target="#Ine_28-2.attnote.fn.10"/> ⁊ be ðam wite.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="28.2" corresp="#wit-e"><pb n="394" ed="#jurasinski-and-oliver"/>Gif he onsacan wille, do he ðæt be ðam féo ⁊ be ðam wite.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="103" ed="#liebermann"/>Falls er [die Schuld an der Flucht des Diebes] leugnen will, thue er das [durch Eid] in Höhe<ptr type="liebermannNote" n="1" target="#Ine_28-2.lnote.de.1"/> des [gestohlenen] Gutes<ptr type="liebermannNote" n="2" target="#Ine_28-2.lnote.de.2"/> und in Höhe des Strafgeldes.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he wishes to deny [the blame for the thief’s escape], let him do so [by an oath] to the amount of the [stolen] goods and to the amount of the fine.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="45" ed="#attenborough"/>If he [the captor] wishes to deny his culpability, he must render an oath equivalent to the value of the stolen goods and the fine.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="403" ed="#whitelock"/>If he wishes to deny it, he is to do so by [an oath corresponding to] the property and the fine.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="395" ed="#jurasinski-and-oliver"/>If he wishes to deny [his culpability], let him do so [by swearing an oath in the amount of] the [stolen] property and the fine.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_28-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">103</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt T;</hi> sec. m. p. et w. abn. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in T; sec. m. p. et w. abn. R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_28-2.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">102</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_28-2.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">102</biblScope></bibl><seg type="original" xml:lang="de">ætsacan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ætsacan Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_28-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">73</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nach Maurer aaO. wäre die erste Klammer zu streichen und Subjekt der Dieb</seg><seg type="translation" xml:lang="en" source="#claude">According to Maurer loc. cit. the first bracket would have to be deleted and the thief would be the subject</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_28-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">73</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Eidesschwere 3. — ‘Wergeldes’ Hcor. falsch, wohl nach 36</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Eidesschwere 3. — ‘of the wergild’ Hcor., wrongly, probably after 36</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_28-2.attnote.fn.9" n="9" source="#attenborough"><bibl><biblScope unit="page">44</biblScope></bibl><label>onsacan</label><seg type="original" xml:lang="en"><hi rend="italic">ætsacan</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_28-2.attnote.fn.10" n="10" source="#attenborough"><bibl><biblScope unit="page">44</biblScope></bibl><label>féo</label><seg type="original" xml:lang="en"><hi rend="italic">were</hi>. H*. <hi rend="italic">secundum modum pecunię et witę</hi>. Quad.</seg></note>
      </div>
