    <body>
      <div type="clause" n="29.1b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 29.1b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 29.1b" corresp="#wit-lat"><pb n="563" ed="#liebermann"/>Unde nec in hundreto<ptr type="liebermannNote" n="11" target="#Hn_29-1b.lnote.oe.11"/> uel comitatu<ptr type="liebermannNote" n="12" target="#Hn_29-1b.lnote.oe.12"/> peccuniam suam uel dominorum suorum forisfaciunt, si<ptr type="liebermannNote" n="13" target="#Hn_29-1b.lnote.oe.13"/> iusticiam<ptr type="liebermannNote" n="d" target="#Hn_29-1b.lnote.oe.d"/> sine iudicio dimittunt<ptr type="liebermannNote" n="14" target="#Hn_29-1b.lnote.oe.14"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 563 (two independent readings of the page images, differences settled against the page); Liebermann’s Erklärung (Gesetze III p. 320) has ‘sel’ (an l for d; read ‘sed’); transcribed as printed</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-1b.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">den königlichen Gerichtshalter im Stich lassen, indem sie kein Urtheil finden</seg><seg type="translation" xml:lang="en" source="#claude">leave the king’s presiding judge in the lurch by finding no judgment</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-1b.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">-edo <hi rend="italic">Lond stets</hi></seg><seg type="translation" xml:lang="en" source="#claude">-edo Lond throughout</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-1b.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">comm. <hi rend="italic">Co meist</hi></seg><seg type="translation" xml:lang="en" source="#claude">comm. Co mostly</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-1b.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">set <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">set K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-1b.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">-tant <hi rend="italic">Sc Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tant Sc edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-1b.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de">Stubbs (<hi rend="italic">Lect</hi>. 168) versteht zu weitgehend: ‘their <hi rend="spaced">attendance</hi> is not compulsory on penalty’—<hi rend="italic">sel</hi>{13}—<hi rend="italic">-tant</hi>{14}—29, 1c <hi rend="italic">Sed cummo</hi>.{15}—<hi rend="italic">cum</hi>{18} <hi rend="italic">s. i. -masset</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">Stubbs (<hi rend="italic">Lect</hi>. 168) interprets too broadly: ‘their <hi rend="italic">attendance</hi> is not compulsory on penalty’ — <hi rend="italic">sel</hi>{13} — <hi rend="italic">-tant</hi>{14} — 29, 1c <hi rend="italic">Sed cummo</hi>.{15} — <hi rend="italic">cum</hi>{18} <hi rend="italic">s. i. -masset</hi> Rs</seg></note>
      </div>
