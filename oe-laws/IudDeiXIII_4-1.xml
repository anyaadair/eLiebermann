      <div type="clause" n="4.1">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 4.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 4.1" corresp="#wit-lat"><pb n="422–423" ed="#liebermann"/>Postea uero communicet illos quos uult mittere<ptr type="liebermannNote" n="15" target="#IudDeiXIII_4-1.lnote.oe.15"/> in aquam et (dum<ptr type="liebermannNote" n="16" target="#IudDeiXIII_4-1.lnote.oe.16"/> communicauerint) dicat (sacerdos<ptr type="liebermannNote" n="1" target="#IudDeiXIII_4-1.lnote.oe.1"/>) per singulos: Corpus<ptr type="liebermannNote" n="a" target="#IudDeiXIII_4-1.lnote.oe.a"/> domini nostri Iesu<ptr type="liebermannNote" n="2" target="#IudDeiXIII_4-1.lnote.oe.2"/> Christi sit tibi ad probationem hodie!</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 422–423 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_4-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">422</biblScope></bibl><seg type="original" xml:lang="de">in a. m. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">in a. m. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_4-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">422</biblScope></bibl><seg type="original" xml:lang="de">d. c. <hi rend="italic">aus Tr, fehlt Mg Vt2 Zeu.</hi> 653</seg><seg type="translation" xml:lang="en" source="#claude">d. c. from Tr, omitted in Mg Vt2 Zeu. 653</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_4-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">et sanguis <hi rend="italic">fügt zu Zeu.</hi> 653&lt;sub&gt;25&lt;/sub&gt;; <hi rend="italic">vgl.</hi> I 3, 3. 16, <hi rend="italic">o. S.</hi> 402 <hi rend="italic">f. und o.</hi> 2, 1&lt;sup&gt;<hi rend="italic">d</hi>&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude">et sanguis added by Zeu. 653&lt;sub&gt;25&lt;/sub&gt;; cf. I 3, 3. 16, above p. 402 f. and above 2, 1&lt;sup&gt;d&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_4-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Mg Zeumer</hi> 653;. hoc modo <hi rend="italic">Vt2, vgl. Zeumer</hi> 620&lt;sub&gt;11&lt;/sub&gt;. 622&lt;sub&gt;33&lt;/sub&gt;</seg><seg type="translation" xml:lang="en" source="#claude">omitted in Mg Zeumer 653;. hoc modo Vt2, cf. Zeumer 620&lt;sub&gt;11&lt;/sub&gt;. 622&lt;sub&gt;33&lt;/sub&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_4-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">Iesu Christi — hodie <hi rend="italic">fehlt Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">Iesu Christi — hodie omitted in Mg</seg></note>
      </div>
