    <body>
      <div type="clause" n="23">
        <head><ref type="lawCode" target="law:VAtr">V Atr</ref> 23</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="23" corresp="#wit-g"><pb n="242" ed="#liebermann"/>⁊ æghwylc unriht aweorpe man georne of þysan earde, þæs þe man gedon mæge.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="23" corresp="#wit-g2"><pb n="242" ed="#liebermann"/>⁊ æghwylc unriht aweorpe man georne of þisan earde, þæs þe man gedon<ptr type="liebermannNote" n="3" target="#VAtr_23.lnote.oe.3"/> mæge.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="23" corresp="#wit-d"><pb n="243" ed="#liebermann"/>⁊ æghwilc unriht awurpe man georne of þisu<hi rend="italic">m</hi> earde, þæs man don mæge.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="23" corresp="#wit-d"><pb n="86" ed="#robertson"/>⁊ æghwilc unriht awurpe man georne of þisum earde þæs<ptr type="editorNote" n="1" target="#VAtr_23.robnote.fn.1"/> man don<ptr type="editorNote" n="2" target="#VAtr_23.robnote.fn.2"/> mæge.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g"><pb n="154" ed="#rabin-doml"/>And æghwylc unriht aweorpe man georne of þysan earde, þæs þe man gedon mæge.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="243" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#VAtr_23.lnote.de.1"/> jedes Unrecht entferne man eifrig aus diesem Lande, soweit als man es zu thun vermag.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let every injustice be eagerly cast out of this country, as far as it can be done.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d"><ptr type="editorNote" n="1" target="#VAtr_23.robnote.n.1"/><pb n="87" ed="#robertson"/>And every injustice shall be zealously cast out from this land as far as is possible.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-g"><pb n="450" ed="#whitelock"/>And every injustice is to be zealously cast out from this country, as far as it can be done.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g"><pb n="155" ed="#rabin-doml"/>And all injustice is to be banished from this land as much as possible.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VIAtr_28-1">VI Atr 28.1</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="342"><label>expanded</label> <ref target="clause:VIAtr_28">VI Atr 28–30</ref> <quote>V 23 – 25, VI 28 – 30 (again expanded)</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="340"><label>compared</label> <ref target="clause:VIIIAtr_39">VIII Atr 39–42</ref> <quote>39 – 42, as compared with V 23 – 25 (VI 28:1–3)</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="VAtr_23.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">242</biblScope></bibl><seg type="original" xml:lang="de">ge <hi rend="italic">radirt</hi></seg><seg type="translation" xml:lang="en" source="#claude">ge erased</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_23.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">173</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">= VI 28, 1 = I Cn 19, 2. Ähnlich <hi rend="italic">o</hi>. 1, 1; <hi rend="italic">u</hi>. 33</seg><seg type="translation" xml:lang="en" source="#claude">= VI 28, 1 = I Cn 19, 2. Similarly <hi rend="italic">above</hi> 1, 1; <hi rend="italic">below</hi> 33</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VAtr_23.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">330</biblScope></bibl><seg type="original" xml:lang="en">Cf. VI Atr. 28, 1; I Cn. 19, 2.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="VAtr_23.robnote.fn.1" n="1" source="#robertson"><bibl><biblScope unit="page">86</biblScope></bibl><label>þæs</label><seg type="original" xml:lang="en"><hi rend="italic">þæsþe</hi> G, G₂.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="VAtr_23.robnote.fn.2" n="2" source="#robertson"><bibl><biblScope unit="page">86</biblScope></bibl><label>don</label><seg type="original" xml:lang="en"><hi rend="italic">gedon</hi> G, G₂.</seg></note>
      </div>
