      <div type="clause" n="5.18a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.18a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.18a" corresp="#wit-lat"><pb n="550" ed="#liebermann"/>Nos<ptr type="liebermannNote" n="h" target="#Hn_5-18a.lnote.oe.h"/><ptr type="liebermannNote" n="20" target="#Hn_5-18a.lnote.oe.20"/> uero a communione nequaquam prohibere<ptr type="liebermannNote" n="21" target="#Hn_5-18a.lnote.oe.21"/> possumus — quamuis hec prohibitio non sit mortalis, set medicinalis — nisi uel sponte confessum uel iudicio<ptr type="liebermannNote" n="22" target="#Hn_5-18a.lnote.oe.22"/> conuictum; hic<ptr type="liebermannNote" n="23" target="#Hn_5-18a.lnote.oe.23"/> enim talis est nominabilis<ptr type="liebermannNote" n="24" target="#Hn_5-18a.lnote.oe.24"/>, ut ait apostolus, qui confitetur uel<ptr type="liebermannNote" n="25" target="#Hn_5-18a.lnote.oe.25"/> ordine iudiciario conuincitur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 550 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-18a.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Gr.</hi> C. II q. 1 c. 18</seg><seg type="translation" xml:lang="en" source="#claude">Gr. C. II q. 1 c. 18</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-18a.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">Non <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Non Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-18a.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-18a.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">confessum <hi rend="italic">nochmals Sc, aber vom Corr. unterpunctirt</hi></seg><seg type="translation" xml:lang="en" source="#claude">confessum again in Sc, but subpuncted by the corrector</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-18a.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">hinc <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">hinc Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-18a.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">abominabilis <hi rend="italic">empfiehlt Somner; aber</hi> nominatio <hi rend="italic">Aug.</hi></seg><seg type="translation" xml:lang="en" source="#claude">abominabilis recommended by Somner; but nominatio Aug.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-18a.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">u. o. <hi rend="italic">doppelt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. o. twice Co</seg></note>
      </div>
