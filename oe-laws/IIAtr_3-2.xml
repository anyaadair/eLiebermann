    <body>
      <div type="clause" n="3.2">
        <head><ref type="lawCode" target="law:IIAtr">II Atr</ref> 3.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.2" corresp="#wit-b"><pb n="222" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="8" target="#IIAtr_3-2.lnote.oe.8"/> he his scip upp<ptr type="liebermannNote" n="14" target="#IIAtr_3-2.lnote.oe.14"/> getogen hæbbe oððon hulc geworhtne oððon<ptr type="liebermannNote" n="15" target="#IIAtr_3-2.lnote.oe.15"/> geteld geslagen: þ<hi rend="italic">æt</hi> he ðær frið hæbbe ⁊ ealle his æhta.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3.2" corresp="#wit-q"><pb n="222" ed="#liebermann"/>Si nauem suam<ptr type="liebermannNote" n="12" target="#IIAtr_3-2.lnote.oe.12"/> extraxerit uel tuguriolum congerat uel papilionem<ptr type="liebermannNote" n="13" target="#IIAtr_3-2.lnote.oe.13"/> tendat, habeat inibi pacem et tota pecunia sua.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="3.2" corresp="#wit-b"><pb n="56" ed="#robertson"/>Gyf he his scip upp getogen hæbbe oððon hulc geworhtne oððon<ptr type="editorNote" n="4" target="#IIAtr_3-2.robnote.fn.4"/> geteld geslagen—þæt he ðær frið hæbbe ⁊ ealle his æhta.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="223" ed="#liebermann"/>Wenn er sein Schiff ans Land gezogen, oder [gesondert<ptr type="liebermannNote" n="1" target="#IIAtr_3-2.lnote.de.1"/>] eine Hütte aufgerichtet oder ein Zelt aufgeschlagen hat: dass er und alle seine Güter dort Friedensschutz geniesse [vor diesem Heere].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he has drawn his ship up onto land, or put up a hut [separately], or pitched a tent: that he and all his goods have protection there [from this army].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="57" ed="#robertson"/>If he has drawn his ship ashore or built a hut or pitched a tent, protection shall be afforded to himself and to all his goods.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-b"><pb n="442" ed="#whitelock"/>If he has drawn his ship ashore or built a shed or pitched a tent, he and all his goods are to enjoy peace there.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_3-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">222</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt R</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_3-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">222</biblScope></bibl><seg type="original" xml:lang="de">papillo. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">papillo. R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_3-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">222</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_3-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">222</biblScope></bibl><seg type="original" xml:lang="de">uppe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">uppe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_3-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">222</biblScope></bibl><seg type="original" xml:lang="de">oþþe on <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">oþþe on Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAtr_3-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">152</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Im Ggs. zum Wohnen unter dem von den Nordleuten angegriffenen Volke 3, 3</seg><seg type="translation" xml:lang="en" source="#claude">In contrast to living among the people attacked by the Northmen 3, 3</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAtr_3-2.robnote.fn.4" n="4" source="#robertson"><bibl><biblScope unit="page">56</biblScope></bibl><label>oððon</label><seg type="original" xml:lang="en"><hi rend="italic">oððe on</hi> Ld.</seg></note>
      </div>
    </body>
