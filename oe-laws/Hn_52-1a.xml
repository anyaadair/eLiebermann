      <div type="clause" n="52.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 52.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 52.1a" corresp="#wit-lat"><pb n="573" ed="#liebermann"/>Si non fuerit<ptr type="liebermannNote" n="53" target="#Hn_52-1a.lnote.oe.53"/> ante<ptr type="liebermannNote" n="54" target="#Hn_52-1a.lnote.oe.54"/> submonitus nec ad hoc uenerit<ptr type="liebermannNote" n="55" target="#Hn_52-1a.lnote.oe.55"/>, debet per<ptr type="liebermannNote" n="o" target="#Hn_52-1a.lnote.oe.o"/> iudicium recti<ptr type="liebermannNote" n="56" target="#Hn_52-1a.lnote.oe.56"/> uadium<ptr type="liebermannNote" n="57" target="#Hn_52-1a.lnote.oe.57"/> iusticie dare et plegios etiam, si opus sit, inuenire.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 573 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_52-1a.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">laut Spruch der Urtheilfinder (<hi rend="italic">vgl.</hi> 52, 1<hi rend="italic">c</hi>) Pfand für künftige Urtheilserfüllung dem Königsrichter geben [<hi rend="italic">obwohl nicht hierzu vorgeladen</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">give the king’s justice, by the sentence of the judgment-finders (cf. 52, 1c), a pledge for future fulfilment of the judgment [although not summoned for this]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_52-1a.lnote.oe.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">-rat <hi rend="italic">Lond Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rat Lond edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_52-1a.lnote.oe.54" n="54" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">-tea <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tea Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_52-1a.lnote.oe.55" n="55" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">ueniat <hi rend="italic">Lond Edd.;</hi> -rat <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">ueniat Lond edd.; -rat Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_52-1a.lnote.oe.56" n="56" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">regi <hi rend="italic">K Co Or;</hi> regi ad <hi rend="italic">Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">regi K Co Or; regi ad Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_52-1a.lnote.oe.57" n="57" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">uadimonium</hi> <hi rend="italic">Lond</hi> [<hi rend="italic">besser?</hi>]</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">uadimonium</hi> Lond [better?]</seg></note>
      </div>
