      <div type="clause" n="Prooem 2">
        <head><ref type="lawCode" target="law:ConsCn">Cons Cn</ref> Prooem 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Cons Cn Prooem 2" corresp="#wit-lat"><pb n="618" ed="#liebermann"/>Postquam autem Cnutum<ptr type="liebermannNote" n="4" target="#ConsCn_Prooem-2.lnote.oe.4"/> regem iustissimum<ptr type="liebermannNote" n="m" target="#ConsCn_Prooem-2.lnote.oe.m"/> totam Angliam obtinere contigit, rationabili consideratione decreuit, quatinus sicut uno rege, ita et una<ptr type="liebermannNote" n="n" target="#ConsCn_Prooem-2.lnote.oe.n"/> lege uniuersum Anglie regnum regeretur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 618 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ConsCn_Prooem-2.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">618</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Anm. e</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. note e</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ConsCn_Prooem-2.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">618</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übertrieben: vgl. II Cn</hi> 12. 14 <hi rend="italic">f.</hi> 71, 2 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">exaggerated: cf. II Cn 12. 14 f. 71, 2 f.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ConsCn_Prooem-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">618</biblScope></bibl><seg type="original" xml:lang="de">Chn. <hi rend="italic">stets Hr; verb. aus</hi> Chutum <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">Chn. throughout Hr; corrected from Chutum Cb</seg></note>
      </div>
