      <div type="clause" n="5.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.1" corresp="#wit-lat"><pb n="548" ed="#liebermann"/>In causis omnibus, ecclesiasticis et secularibus, legaliter et ordine pertractandis, alii sunt accusatores<ptr type="liebermannNote" n="d" target="#Hn_5-1.lnote.oe.d"/>, alii defensores<ptr type="liebermannNote" n="31" target="#Hn_5-1.lnote.oe.31"/>, alii testes, alii iudices, in omni discussione<ptr type="liebermannNote" n="32" target="#Hn_5-1.lnote.oe.32"/> probitatis ydonei nullaque simul<ptr type="liebermannNote" n="33" target="#Hn_5-1.lnote.oe.33"/> exactione<ptr type="liebermannNote" n="dd" target="#Hn_5-1.lnote.oe.dd"/> permixti<ptr type="liebermannNote" n="e" target="#Hn_5-1.lnote.oe.e"/><ptr type="liebermannNote" n="34" target="#Hn_5-1.lnote.oe.34"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 548 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch Gratian</hi> C. 4 q. 4 c. 1; <hi rend="italic">er und Pan. haben auch</hi> 5, 1<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">also Gratian C. 4 q. 4 c. 1; he and Pan. also have 5, 1a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-1.lnote.oe.dd" n="dd" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">in keinem Process</seg><seg type="translation" xml:lang="en" source="#claude">in no lawsuit</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-1.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Ivo</hi> Decr. VI 337: De non permiscendis personis causae</seg><seg type="translation" xml:lang="en" source="#claude">cf. Ivo Decr. VI 337: De non permiscendis personis causae</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-1.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">-nsso. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nsso. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-1.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">dissc. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">dissc. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-1.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">sunt <hi rend="italic">Edd.</hi> [<hi rend="italic">falsch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">sunt Edd. [wrong]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-1.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">-xte <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-xte Lond</seg></note>
