        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 9.9" corresp="#wit-lat"><pb n="555" ed="#liebermann"/>Nemo autem<ptr type="liebermannNote" n="39" target="#Hn_9-9.lnote.oe.39"/> stultus aut inprobus debet esse iudex, set optimates<ptr type="liebermannNote" n="v" target="#Hn_9-9.lnote.oe.v"/> quique secundum modum suum, qui non personam<ptr type="liebermannNote" n="vv" target="#Hn_9-9.lnote.oe.vv"/> sed opera diiudicent per legem prouincie.</ab>
