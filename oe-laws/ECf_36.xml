      <div type="clause" n="36">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 36</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 36"><pb n="666" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_36.lnote.oe.erkl-clause"/><ptr type="liebermannNote" n="e" target="#ECf_36.lnote.la.fn.e"/><ptr type="liebermannNote" n="13" target="#ECf_36.lnote.la.13"/><hi rend="spaced">De latronibus interfectis pro</hi><ptr type="liebermannNote" n="14" target="#ECf_36.lnote.la.14"/> <hi rend="spaced">latrocinio</hi><ptr type="liebermannNote" n="15" target="#ECf_36.lnote.la.15"/>. Si post iusticiam<ptr type="liebermannNote" n="f" target="#ECf_36.lnote.la.fn.f"/> factam fecerit aliquis clamorem ad iusticiarium, quod iniuste interfectus sit<ptr type="liebermannNote" n="16" target="#ECf_36.lnote.la.16"/> et quod iniuste iacet inter latrones, et si<ptr type="liebermannNote" n="17" target="#ECf_36.lnote.la.17"/> dixerit, quod<ptr type="liebermannNote" n="18" target="#ECf_36.lnote.la.18"/> uelit<ptr type="liebermannNote" n="19" target="#ECf_36.lnote.la.19"/> illud<ptr type="liebermannNote" n="20" target="#ECf_36.lnote.la.20"/> diracionari<ptr type="liebermannNote" n="21" target="#ECf_36.lnote.la.21"/>, det<ptr type="liebermannNote" n="22" target="#ECf_36.lnote.la.22"/> uadimonium et plegios<ptr type="liebermannNote" n="23" target="#ECf_36.lnote.la.23"/>.</ab>
        <note type="comparison" source="#liebermann" n="666"><label>printed alongside</label> <ref target="clause:ECfRetr_36">ECf retr 36</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 666 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">alles Folgende scheint Nachtrag des Verfassers</hi></seg><seg type="translation" xml:lang="en" source="#claude">all that follows seems to be a later addition by the author</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Hinrichtung; vgl. o. S.</hi> 591<hi rend="superscript">i</hi></seg><seg type="translation" xml:lang="en" source="#claude">execution; cf. above, p. 591, note i</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">D. l. i. p. l. <hi rend="italic">Rubrik Pl S; im Text, nicht Überschrift Rl Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">D. l. i. p. l. as a rubric Pl S; in the text, not as a heading, Rl Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">p. l. <hi rend="italic">fehlt Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. l. lacking in Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">uel iniuste <hi rend="italic">fügt zu Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hr adds uel iniuste</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">quis <hi rend="italic">fügt zu Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hr adds quis</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">hoc <hi rend="italic">fügt zu Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hr adds hoc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">uoluerit <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">uoluerit Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">hoc <hi rend="italic">Hk; fehlt S Cl Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">hoc Hk; lacking in S Cl Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">-re <hi rend="italic">Cl;</hi> disracionare <hi rend="italic">S;</hi> deratiocinari <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-re Cl; disracionare S; deratiocinari Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">ut <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">ut Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">666</biblScope></bibl><seg type="original" xml:lang="de">-geos <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-geos Hk</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Of thieves killed for theft. If, after justice has been done, anyone makes a complaint to the justiciar that [a man] was killed unjustly and that he lies unjustly among thieves, and if he says that he wishes to deraign (prove) it, let him give a gage and pledges.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">350</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Hingerichtete 5; Grab 3.a; Prozessualpfand 8. 9 — c. 36 steht hinter 39,2 Rs</seg><seg type="translation" xml:lang="en" source="#claude">Cf. <hi rend="italic">Gl</hi> Hingerichtete 5; Grab 3.a; Prozessualpfand 8. 9 — c. 36 stands after 39,2 in Rs</seg></note>
      </div>
    </body>
  </text>
