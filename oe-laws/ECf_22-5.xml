    <body>
      <div type="clause" n="22.5">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 22.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 22.5"><pb n="648" ed="#liebermann"/>Et illi qui non<ptr type="liebermannNote" n="5" target="#ECf_22-5.lnote.la.5"/> habent consuetudines quas supra diximus, ante iusticiam<ptr type="liebermannNote" n="b" target="#ECf_22-5.lnote.la.fn.b"/> regis faciant rectum<ptr type="liebermannNote" n="6" target="#ECf_22-5.lnote.la.6"/> in hundredo<ptr type="liebermannNote" n="7" target="#ECf_22-5.lnote.la.7"/> uel in <ptr type="liebermannNote" n="*" target="#ECf_22-5.lnote.la.star"/>wapentagiis<ptr type="liebermannNote" n="8" target="#ECf_22-5.lnote.la.8"/> uel in syris<ptr type="liebermannNote" n="9" target="#ECf_22-5.lnote.la.9"/>.</ab>
        <note type="comparison" source="#liebermann" n="648"><label>printed alongside</label> <ref target="clause:ECfRetr_22-5">ECf retr 22.5</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 648 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “habent” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-5.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 9, 3. 23, 4<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 9, 3. 23, 4, note b</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-5.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">id est lestis <hi rend="italic">überschr. Hd.</hi> 13. <hi rend="italic">Jhs. Cb zur Retr., irrig Kentisch</hi> lathe <hi rend="italic">mit Angloskandinav.</hi> wapentake <hi rend="italic">gleichsetzend</hi></seg><seg type="translation" xml:lang="en" source="#claude">id est lestis written above in a 13th-century hand Cb, to the Retr., wrongly equating Kentish lathe with Anglo-Scandinavian wapentake</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-5.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">co. n. h. <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">co. n. h. Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-5.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">eciam <hi rend="italic">fügt zu S</hi></seg><seg type="translation" xml:lang="en" source="#claude">S adds eciam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-5.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">-dis <hi rend="italic">Hr;</hi> uel in comitatibus <hi rend="italic">fügt zu Hr Ad</hi> (<hi rend="italic">nicht Do</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">-dis Hr; Hr Ad add uel in comitatibus (not Do)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-5.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">wapintachiis <hi rend="italic">Hr;</hi> wantapen., <hi rend="italic">aber</hi> nta <hi rend="italic">unterstrichen Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">wapintachiis Hr; wantapen., but nta underlined Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-5.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">schiris <hi rend="italic">S;</hi> shiris <hi rend="italic">Ad;</hi> siris <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">schiris S; shiris Ad; siris Hr</seg></note>
      </div>
    </body>
  </text>
