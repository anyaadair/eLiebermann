    <body>
      <div type="clause" n="25.1">
        <head><ref type="lawCode" target="law:IIAs">II As</ref> 25.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="25.1" corresp="#wit-h"><pb n="164" ed="#liebermann"/>Ond<ptr type="liebermannNote" n="3" target="#IIAs_25-1.lnote.oe.3"/> se biscop amonige þa oferhyrnesse<ptr type="liebermannNote" n="8" target="#IIAs_25-1.lnote.oe.8"/> æt þam gerefan, þe hit on his folgoþe sy.<ptr type="liebermannNote" n="8" target="#IIAs_25-1.lnote.oe.8"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="25.1" corresp="#wit-ld"><pb n="164" ed="#liebermann"/>⁊ se bisceope<ptr type="liebermannNote" n="1" target="#IIAs_25-1.lnote.oe.1"/> amanige ða oferhyrnysse æt ðæm gerefan, ðe on his folgoþe sy.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="25.1" corresp="#wit-q"><pb n="165" ed="#liebermann"/>Et episcopus admoneat<ptr type="liebermannNote" n="20" target="#IIAs_25-1.lnote.oe.20"/> ouerhyrnessam<ptr type="liebermannNote" n="17" target="#IIAs_25-1.lnote.oe.17"/> illam a preposito, in cuius hoc mannitione<ptr type="liebermannNote" n="21" target="#IIAs_25-1.lnote.oe.21"/> sit.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="25.1" corresp="#wit-h"><pb n="140" ed="#attenborough"/>Ond se biscop amonige þa oferhyrnesse æt þam gerefan, þe hit on his folgoþe sy.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="165" ed="#liebermann"/>Und derjenige Bischof treibe diese Ungehorsamsbusse von dem Vogte<ptr type="liebermannNote" n="1" target="#IIAs_25-1.lnote.de.1"/> ein, der es in dessen<ptr type="liebermannNote" n="2" target="#IIAs_25-1.lnote.de.2"/> Amtsbezirk<ptr type="liebermannNote" n="3" target="#IIAs_25-1.lnote.de.3"/> ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let the bishop in whose district it is exact this disobedience-fine from the reeve.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="141" ed="#attenborough"/>And the fine for insubordination shall be exacted from the reeve by the bishop, within whose diocese the offence is perpetrated.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="422" ed="#whitelock"/>And the bishop in whose diocese it lies is to exact the fine for disobedience from the reeve.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IIIEg_3">III Eg 3</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">164</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">164</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">164</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">165</biblScope></bibl><seg type="original" xml:lang="de">adm. — mans. sit <hi rend="italic">überspringt K;</hi> -net <hi rend="italic">Or;</hi> moneat <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">K skips adm. — mans. sit; -net Or; moneat MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">165</biblScope></bibl><seg type="original" xml:lang="de">-hir- <hi rend="italic">R;</hi> -her- <hi rend="italic">KM</hi></seg><seg type="translation" xml:lang="en" source="#claude">-hir- R; -her- KM</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">165</biblScope></bibl><seg type="original" xml:lang="de">manit. <hi rend="italic">MHkBr;</hi> mansione <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">manit. MHkBr; mansione Or</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_25-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">107</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Ebenso III Eg 3; <hi rend="italic">vgl. Gl</hi> Vogt 9. 24; Bischof 10 a. 8 c</seg><seg type="translation" xml:lang="en" source="#claude">Likewise III Eg 3; <hi rend="italic">cf. Gl</hi> Vogt 9. 24; Bischof 10 a. 8 c</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_25-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">107</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Bessere Übs.: ‘in dessen Diözese es ist’ — ich hatte die Agsä. Redensart (<hi rend="italic">s. Wb</hi> 183 Sp. 1 D) verkannt — gegen Q (<hi rend="italic">mannitio,</hi> Frankolatein [Brunner II 330]: ‘weltlicher Amtsbezirk’) und Toller (‘reeve in whose service’). Es soll nämlich bestimmt werden, welcher <hi rend="spaced">Bischof</hi> fungiert, nicht welcher Vogt gestraft wird</seg><seg type="translation" xml:lang="en" source="#claude">A better translation is ‘in whose diocese it is’ — I had misunderstood the A.-S. idiom (see <hi rend="italic">Wb</hi> 183 col. 1 D) — against Q (<hi rend="italic">mannitio,</hi> Franco-Latin [Brunner II 330]: ‘secular administrative district’) and Toller (‘reeve in whose service’). For the purpose is to determine which <hi rend="italic">bishop</hi> acts, not which reeve is punished</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_25-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">107</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgoð</hi> ‘Amt eines Bischofs’: Urk. a. 967 Bi 1206</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">folgoð</hi> ‘office of a bishop’: charter a. 967 Bi 1206</seg></note>
      </div>
    </body>
