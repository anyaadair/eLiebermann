    <body>
      <div type="clause" n="65.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 65.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="65.1" corresp="#wit-g-a"><pb n="352" ed="#liebermann"/>To cyricbote sceal eall folc fylstan mid rihte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="65.1" corresp="#wit-b"><pb n="352" ed="#liebermann"/>To cyricbote sceal [eall<ptr type="liebermannNote" n="4" target="#IICn_65-1.lnote.oe.4"/>] folc fylstan mid rihte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="65.1" corresp="#wit-a"><pb n="352" ed="#liebermann"/>To cyricbote<ptr type="liebermannNote" n="5" target="#IICn_65-1.lnote.oe.5"/> sceal eall folc fyl[s]tan<ptr type="liebermannNote" n="6" target="#IICn_65-1.lnote.oe.6"/> mid rihte.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="65.1" corresp="#wit-q"><pb n="353" ed="#liebermann"/>Ad refectionem ęcclesię debet omnis populus secundum rectum<ptr type="liebermannNote" n="20" target="#IICn_65-1.lnote.oe.20"/> subuenire.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="65.1" corresp="#wit-cons-cn"><pb n="353" ed="#liebermann"/>Monasteriorum etiam refectionibus uniuersi Christiani iuste laborare debent.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="65.1" corresp="#wit-b"><pb n="206" ed="#robertson"/>To cyricbote sceal eall<ptr type="editorNote" n="5" target="#IICn_65-1.robnote.fn.5"/> folc fylstan mid rihte.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="286" ed="#rabin-doml"/>To cyricbote sceal eall folc fylstan mid rihte.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="353" ed="#liebermann"/>Zur Kirchen[bau]herstellung<ptr type="liebermannNote" n="1" target="#IICn_65-1.lnote.de.1"/> soll alles Volk gesetzmässig helfen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Toward the repair of [the fabric of] churches all the people shall lawfully help.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="207" ed="#robertson"/>The whole nation, in accordance with the law, shall assist in the repair of churches<ptr type="editorNote" n="1" target="#IICn_65-1.robnote.n.1"/>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="471" ed="#whitelock"/>All people should by rights help to repair the church.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="287" ed="#rabin-doml"/>As is just, the whole realm shall contribute to the upkeep of churches.</ab>
        <note type="editorial">BR: added from Gesetze I p. 353, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_65-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">352</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. am Rande</hi></seg><seg type="translation" xml:lang="en" source="#claude">in the margin in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_65-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">353</biblScope></bibl><seg type="original" xml:lang="de">legem <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">legem Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_65-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">352</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert aus</hi> cricb.</seg><seg type="translation" xml:lang="en" source="#claude">corrected from cricb.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_65-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">352</biblScope></bibl><seg type="original" xml:lang="de">fyltan</seg><seg type="translation" xml:lang="en" source="#claude">fyltan</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_65-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">211</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Kirchenbau 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Kirchenbau 1</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_65-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">358</biblScope></bibl><seg type="original" xml:lang="en">Cf. I Edm. 5; Birch, no. 599, where one condition attached to a grant of land made by the Bishop of Winchester to a certain Beornulf in 902 is that every year help shall be given <hi rend="italic">to þære cyrican bóte</hi>.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_65-1.robnote.fn.5" n="5" source="#robertson"><bibl><biblScope unit="page">206</biblScope></bibl><label>eall</label><seg type="original" xml:lang="en">G, A, Ld; written in the margin in 16th cent. in B.</seg></note>
      </div>
