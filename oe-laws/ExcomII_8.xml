        <note type="liebermannNote" subtype="textual" xml:id="ExcomII_8.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">434</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. o.</hi> 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. above 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomII_8.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">434</biblScope></bibl><seg type="original" xml:lang="de">8 <hi rend="italic">ist aus Regino</hi> II 416 <hi rend="italic">oder dessen Vorlage eingeschoben; fehlt Reg</hi> 415</seg><seg type="translation" xml:lang="en" source="#claude">8 <hi rend="italic">is interpolated from Regino</hi> II 416 <hi rend="italic">or his source; omitted in Reg</hi> 415</seg></note>
