      <div type="clause" n="6">
        <head>Af Rb 6</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6" corresp="#wit-e"><pb n="16" ed="#liebermann"/>VII. Be circan<ptr type="liebermannNote" n="7" target="#Rubrics-Af_6.lnote.oe.7"/> stale.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6" corresp="#wit-ot-frag"><pb n="16" ed="#liebermann"/>… an stale.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6" corresp="#wit-g-prol"><pb n="16" ed="#liebermann"/>VII. Be cyricena stale.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6" corresp="#wit-h"><pb n="17" ed="#liebermann"/>VII. Be circean stale.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6" corresp="#wit-q"><pb n="17" ed="#liebermann"/>De furatis in ecclesia.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="188" ed="#jurasinski-and-oliver"/>VII Be circan stale</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="188" ed="#jurasinski-and-oliver"/>Be ða<hi rend="italic">m</hi> ðe steleð on cirice<hi rend="italic">an</hi></ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="17" ed="#liebermann"/>Von Kirchenbestehlung.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of theft from a church.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="189" ed="#jurasinski-and-oliver"/>Concerning theft from a church</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="189" ed="#jurasinski-and-oliver"/>Concerning one who steals in a church</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_6.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de">cyricena <hi rend="italic">Ld;</hi> cyrecyna stæle <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyricena Ld; cyrecyna stæle So</seg></note>
      </div>
