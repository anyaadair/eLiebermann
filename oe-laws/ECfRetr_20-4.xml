      <div type="clause" n="20.4">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 20.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 20.4"><pb n="646" ed="#liebermann"/>Quod<ptr type="liebermannNote" n="16" target="#ECfRetr_20-4.lnote.la.16"/> si facere non posset, <hi rend="bold">ipse cum friborgo</hi><ptr type="liebermannNote" n="17" target="#ECfRetr_20-4.lnote.la.17"/> suo damnum restauraret<ptr type="liebermannNote" n="c" target="#ECfRetr_20-4.lnote.la.fn.c"/><ptr type="liebermannNote" n="18" target="#ECfRetr_20-4.lnote.la.18"/> de proprio <hi rend="bold">male</hi>factoris, quantum duraret<ptr type="liebermannNote" n="19" target="#ECfRetr_20-4.lnote.la.19"/>; <hi rend="bold">quo deficiente,</hi> de suo <hi rend="bold">et friborgi</hi><ptr type="liebermannNote" n="20" target="#ECfRetr_20-4.lnote.la.20"/> <hi rend="bold">sui perficeret;</hi> et erga iusticiam emendarent<ptr type="liebermannNote" n="21" target="#ECfRetr_20-4.lnote.la.21"/>, secundum quod legaliter iudicatum<ptr type="liebermannNote" n="22" target="#ECfRetr_20-4.lnote.la.22"/> eis<ptr type="liebermannNote" n="23" target="#ECfRetr_20-4.lnote.la.23"/> fuisset.</ab>
        <note type="comparison" source="#liebermann" n="646"><label>printed alongside</label> <ref target="clause:ECf_20-4">ECf 20.4</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 646 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-4.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">den Plural bestätigt</hi> Wl art. 8 <hi rend="italic">gegen den Retractator, dem Kemble</hi> Saxons 250 <hi rend="italic">folgt</hi></seg><seg type="translation" xml:lang="en" source="#claude">Wl art. 8 confirms the plural, against the Retractator, whom Kemble, Saxons 250, follows</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-4.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">Qui <hi rend="italic">Hv;</hi> Quid <hi rend="italic">Va K Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Qui Hv; Quid Va K Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-4.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">frithb. <hi rend="italic">Hv;</hi> fridb. <hi rend="italic">Lb Va;</hi> fridburgo <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">frithb. Hv; fridb. Lb Va; fridburgo Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-4.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">-uret <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uret Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-4.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">distaret <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">distaret Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-4.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">fridb. <hi rend="italic">Lb Va Ph;</hi> frithb. <hi rend="italic">Hv L</hi></seg><seg type="translation" xml:lang="en" source="#claude">fridb. Lb Va Ph; frithb. Hv L</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-4.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">-ret <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ret Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-4.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">eis iud. <hi rend="italic">Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">eis iud. Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-4.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Hv</seg></note>
