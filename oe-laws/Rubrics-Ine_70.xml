    <body>
      <div type="clause" n="70">
        <head>Ine Rb 70</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="70" corresp="#wit-e"><pb n="26" ed="#liebermann"/>CXIIII. Be<ptr type="liebermannNote" n="**" target="#Rubrics-Ine_70.lnote.oe.star2"/> twyhyndum were.<ptr type="liebermannNote" n="7" target="#Rubrics-Ine_70.lnote.oe.7"/><ptr type="liebermannNote" n="***" target="#Rubrics-Ine_70.lnote.oe.star3"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="70" corresp="#wit-g-prol"><pb n="26" ed="#liebermann"/>CXIIII. Be twyhyndum were.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="70" corresp="#wit-h"><pb n="27" ed="#liebermann"/>CXIIII. Be twyhyndum were.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="70" corresp="#wit-q"><pb n="27" ed="#liebermann"/>De tƿyhyndi<ptr type="liebermannNote" n="11" target="#Rubrics-Ine_70.lnote.oe.11"/> wéra.<ptr type="liebermannNote" n="12" target="#Rubrics-Ine_70.lnote.oe.12"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="216" ed="#jurasinski-and-oliver"/>CXIIII Be twyhundum were</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="216" ed="#jurasinski-and-oliver"/>Be twyhindum were</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="27" ed="#liebermann"/>Über<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_70.lnote.de.1"/> Wergeld<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_70.lnote.de.2"/> von 200 [Schilling].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning a wergeld of 200 [shillings].</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="217" ed="#jurasinski-and-oliver"/>Concerning a [man whose] wer [is] 200</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="217" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_70.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">26</biblScope></bibl><seg type="original" xml:lang="de">Be werum <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Be werum Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_70.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">26</biblScope></bibl><seg type="original" xml:lang="de">fære <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">fære So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_70.lnote.oe.star3" n="***" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">26</biblScope></bibl><seg type="original" xml:lang="de">Be fostre <hi rend="italic">fügt zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Be fostre added by Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_70.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">27</biblScope></bibl><seg type="original" xml:lang="de">w. t. <hi rend="italic">Br</hi>; tƿih. <hi rend="italic">T</hi>; þih. <hi rend="italic">Hk</hi>; hominis <hi rend="italic">fügt zu Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">w. t. Br; tƿih. T; þih. Hk; hominis added by Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_70.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">27</biblScope></bibl><seg type="original" xml:lang="de">vel VIhindi vel XIIhindi (v. VIh. v. XIIh. <hi rend="italic">fehlt Br</hi>) [70, 1] De X hidis [hind. <hi rend="italic">Hk Br</hi>] quod debeat reddi ad corredium <hi rend="italic">fügt zu Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">vel VIhindi vel XIIhindi (v. VIh. v. XIIh. lacking in Br) [70, 1] De X hidis [hind. Hk Br] quod debeat reddi ad corredium added by Hk Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_70.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘Von Wergeldern’ Ld; durch Schreibfehler ‘Reise, Fahrt’ So</seg><seg type="translation" xml:lang="en" source="#claude">‘Of wergilds’ Ld; through a scribal error ‘journey, travel’ So</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_70.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Oder ‘einen Mann von 200 [Sch. Wergeld]’. — Als Rb für 70, 1: ‘Von Beköstigung, Naturalrente’ Ld, wohl aus Ine-Text</seg><seg type="translation" xml:lang="en" source="#claude">Or ‘a man of 200 [shill. wergild]’. — As Rb for 70, 1: ‘Of provisions, rent in kind’ Ld, probably from the text of Ine</seg></note>
      </div>
    </body>
