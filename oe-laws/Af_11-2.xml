    <body>
      <div type="clause" n="11.2">
        <head><ref type="lawCode" target="law:Af">Af</ref> 11.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11.2" corresp="#wit-e"><pb n="56" ed="#liebermann"/>Gif he mid gehæme, mid LX scill. gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11.2" corresp="#wit-h"><pb n="56" ed="#liebermann"/>Gif he mid gehæme, mid LX scll' hit gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11.2" corresp="#wit-b-no-prol"><pb n="57" ed="#liebermann"/>Gyf he mid gehæme, syxti scill' gebete.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="11.2" corresp="#wit-q"><pb n="57" ed="#liebermann"/>Si<ptr type="liebermannNote" n="14" target="#Af_11-2.lnote.oe.14"/> concubuerit<ptr type="liebermannNote" n="15" target="#Af_11-2.lnote.oe.15"/>, LX<ptr type="liebermannNote" n="16" target="#Af_11-2.lnote.oe.16"/> solid. emendet.<ptr type="liebermannNote" n="17" target="#Af_11-2.lnote.oe.17"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="70" ed="#attenborough"/>Gif he mid gehæme, mid LX scill. gebete<ptr type="editorNote" n="8" target="#Af_11-2.attnote.fn.8"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="13.2" corresp="#wit-e"><pb n="306" ed="#jurasinski-and-oliver"/>Gif he mid gehæme, mid LX scill gebete.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="57" ed="#liebermann"/>Wenn er [sie] beschläft<ptr type="liebermannNote" n="1" target="#Af_11-2.lnote.de.1"/>, büsse er [ihr<ptr type="liebermannNote" n="2" target="#Af_11-2.lnote.de.2"/>] mit 60 Schill.<ptr type="liebermannNote" n="3" target="#Af_11-2.lnote.de.3"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he lies with [her], let him pay [her] 60 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="71" ed="#attenborough"/>If he lies with her, he shall pay [her]<ptr type="editorNote" n="1" target="#Af_11-2.attnote.n.1"/> 60 shillings<ptr type="editorNote" n="2" target="#Af_11-2.attnote.n.2"/> compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="307" ed="#jurasinski-and-oliver"/>If he has intercourse with her, let him recompense with 60 shillings.</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="307"><label>contradicts</label> <ref target="clause:Af_10">Af 10</ref> <quote>This contradicts the 40-shilling fine established in §12.</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="270"><ref target="clause:Af_26">Af 26</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">57</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dieser Satz fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">this sentence lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">57</biblScope></bibl><seg type="original" xml:lang="de">cum illa habeat rem <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">cum illa habeat rem Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">57</biblScope></bibl><seg type="original" xml:lang="de">em. LX s. <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">em. LX s. Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">57</biblScope></bibl><seg type="original" xml:lang="de">ei <hi rend="italic">fügt zu Hk Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei added by Hk Brti</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_11-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Da die Formel wie in 11 lautet, nur eine Steigerung der Missetat ausgedrückt wird, ist als Empfängerin auch hier die Genotzüchtigte zu denken. Dies folgt noch deutlicher aus 11, 4</seg><seg type="translation" xml:lang="en" source="#claude">Since the formula is the same as in 11 and only an aggravation of the offence is expressed, here too the recipient is to be understood as the woman raped. This follows still more clearly from 11, 4</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_11-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">54</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nebenher geht Strafgeld für den Richter: 60 Schill. beträgt es für Notzucht (<hi rend="italic">s. d. Gl</hi> 6) an der Sklavin</seg><seg type="translation" xml:lang="en" source="#claude">Alongside this goes a fine to the judge: for rape (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 6) of a female slave it amounts to 60 shill.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_11-2.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">54</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nur bei nicht handhafter Tat. Strenger wird Notzucht (<hi rend="italic">s. Gl</hi> 7—11) sonst gestraft</seg><seg type="translation" xml:lang="en" source="#claude">Only where the offender is not caught in the act. Rape (see <hi rend="italic">Gl</hi> 7—11) is otherwise punished more severely</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_11-2.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">70</biblScope></bibl><label>gebete</label><seg type="original" xml:lang="en"><hi rend="italic">hit gebete</hi>. H.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_11-2.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">195</biblScope></bibl><seg type="original" xml:lang="en">So Liebermann.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_11-2.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">195</biblScope></bibl><seg type="original" xml:lang="en">In addition to the legal fine (Liebermann).</seg></note>
      </div>
    </body>
