        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 4" corresp="#wit-du" ana="#glossed"><pb n="410" ed="#liebermann"/><seg type="glossed"><seg type="base">Deus<ptr type="liebermannNote" n="25" target="#IudDeiIV_4.lnote.oe.25"/>,</seg><gloss xml:lang="ang">God,</gloss></seg> <seg type="glossed"><seg type="base">iudex</seg><gloss xml:lang="ang">doeme</gloss></seg> <seg type="glossed"><seg type="base">iustus,</seg><gloss xml:lang="ang">soðfæst,</gloss></seg> <seg type="glossed"><seg type="base">fortis</seg><gloss xml:lang="ang">strong</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">patiens,</seg><gloss xml:lang="ang">giðyldig,</gloss></seg> <seg type="glossed"><seg type="base">quia</seg><gloss xml:lang="ang">f<hi rend="italic">or</hi>ðon</gloss></seg> <seg type="glossed"><seg type="base">[a]uctor<ptr type="liebermannNote" n="26" target="#IudDeiIV_4.lnote.oe.26"/></seg><gloss xml:lang="ang">ricsand</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">amator</seg><gloss xml:lang="ang">lvfend</gloss></seg> <seg type="glossed"><seg type="base">es</seg><gloss xml:lang="ang">arð</gloss></seg> <seg type="glossed"><seg type="base">pacis</seg><gloss xml:lang="ang">sibbes</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">iudicas</seg><gloss xml:lang="ang">doemest</gloss></seg> <seg type="glossed"><seg type="base">aequitate<ptr type="liebermannNote" n="27" target="#IudDeiIV_4.lnote.oe.27"/>,</seg><gloss xml:lang="ang">rehtnise,</gloss></seg> <seg type="glossed"><seg type="base">iudica</seg><gloss xml:lang="ang">gidoem</gloss></seg> <seg type="glossed"><seg type="base">quod</seg><gloss xml:lang="ang">þ<hi rend="italic">æt</hi>te</gloss></seg> <seg type="glossed"><seg type="base">iustum</seg><gloss xml:lang="ang">soð'</gloss></seg> <seg type="glossed"><seg type="base">est,</seg><gloss xml:lang="ang">is</gloss></seg> <seg type="glossed"><seg type="base">Domine,</seg><gloss xml:lang="ang">Driht<hi rend="italic">en</hi>,</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">rectum</seg><gloss xml:lang="ang">reht'</gloss></seg> <seg type="glossed"><seg type="base">iudicium</seg><gloss xml:lang="ang">dom</gloss></seg> <seg type="glossed"><seg type="base">tuum,</seg><gloss xml:lang="ang">ðin',</gloss></seg></ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Ps. 118, 137</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 410 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">c.</hi> 4 = <hi rend="italic">Zeu.</hi> 605 <hi rend="italic">b, auch u.</hi> XII 16; <hi rend="italic">vgl. o.</hi> II 3</seg><seg type="translation" xml:lang="en" source="#claude">c. 4 = Zeu. 605b, also below XII 16; cf. above II 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Zeu.;</hi> uetor <hi rend="italic">oder</hi> uctor <hi rend="italic">Du;</hi> rector <hi rend="italic">las Stev.</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Zeu.; uetor or uctor Du; Stev. read rector</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">-tem <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tem Zeu.</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-du">O God, just judge, strong and patient, since you are the [author] and lover of peace and judge with equity, judge what is just, Lord, and your right judgment,</ab>
