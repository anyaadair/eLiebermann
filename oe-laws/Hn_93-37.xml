        <note type="liebermannNote" subtype="textual" xml:id="Hn_93-37.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">610</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus</hi> Lex Sal. 17, 4; <hi rend="italic">vgl. folgende Anm. h</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">from</hi> Lex Sal. 17, 4; <hi rend="italic">cf. following note h</hi></seg></note>
