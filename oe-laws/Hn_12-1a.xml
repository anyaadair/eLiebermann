        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-1a.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">em. n. p. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">em. n. p. Lond</seg></note>
