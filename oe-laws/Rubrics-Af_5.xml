    <body>
      <div type="clause" n="5">
        <head>Af Rb 5</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5" corresp="#wit-e"><pb n="16" ed="#liebermann"/>VI. Be circena<ptr type="liebermannNote" n="3" target="#Rubrics-Af_5.lnote.oe.3"/> friðe.<ptr type="liebermannNote" n="6" target="#Rubrics-Af_5.lnote.oe.6"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5" corresp="#wit-ot-frag"><pb n="16" ed="#liebermann"/>… friðe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5" corresp="#wit-g-prol"><pb n="16" ed="#liebermann"/>VI. Be cyricena fryþe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5" corresp="#wit-h"><pb n="17" ed="#liebermann"/>VI. Be circena friðe.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5" corresp="#wit-q"><pb n="17" ed="#liebermann"/>De pace ecclesiarum.<ptr type="liebermannNote" n="5" target="#Rubrics-Af_5.lnote.oe.5"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="186" ed="#jurasinski-and-oliver"/>VI Be circena friðe</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="186" ed="#jurasinski-and-oliver"/>Be ciricene friðe</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="17" ed="#liebermann"/>Vom [Asyl]frieden der Kirchen.<ptr type="liebermannNote" n="1" target="#Rubrics-Af_5.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of the [sanctuary-]peace of churches.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="187" ed="#jurasinski-and-oliver"/>Concerning churches’ peace</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="187" ed="#jurasinski-and-oliver"/>Concerning church peace</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_5.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">17</biblScope></bibl><seg type="original" xml:lang="de">et earum libertate <hi rend="italic">fügt Br zu.</hi> De furatis die festo <hi rend="italic">fügt Hk Br zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">et earum libertate added by Br. De furatis die festo added by Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_5.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de">cyrec. <hi rend="italic">So;</hi> cyric. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyrec. So; cyric. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_5.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de">fryðe <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fryðe So Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_5.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">40</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘Privileg Schutz zu verleihen’, nicht ‘Kirchenfrieden’. — Quadr spät. Rezension fügt hier (und öfter, wo nicht weiter bemerkt) eine selbständig gebildete Rubrik hinzu</seg><seg type="translation" xml:lang="en" source="#claude">‘Privilege of granting protection’, not ‘peace of the church’. — Quadr’s later recension adds here (and often, where not further noted) a rubric of its own devising</seg></note>
      </div>
