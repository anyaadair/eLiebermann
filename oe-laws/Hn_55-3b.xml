      <div type="clause" n="55.3b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 55.3b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 55.3b" corresp="#wit-lat"><pb n="575" ed="#liebermann"/>Set fides habeatur dominis omnibus, salua fide precedencium, et magis ei cuius ligius<ptr type="liebermannNote" n="c" target="#Hn_55-3b.lnote.oe.c"/> est; et eius<ptr type="liebermannNote" n="g" target="#Hn_55-3b.lnote.oe.g"/> licencia sit, si quis<ptr type="liebermannNote" n="18" target="#Hn_55-3b.lnote.oe.18"/> eius<ptr type="liebermannNote" n="g" target="#Hn_55-3b.lnote.oe.g"/> (aliquem<ptr type="liebermannNote" n="19" target="#Hn_55-3b.lnote.oe.19"/>) alium sibi dominum<ptr type="liebermannNote" n="h" target="#Hn_55-3b.lnote.oe.h"/> faciat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 575 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-3b.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 43, 6; <hi rend="italic">vgl.</hi> 55, 3<hi rend="italic">b</hi>. 61, 6<hi rend="italic">b</hi>. 82, 5</seg><seg type="translation" xml:lang="en" source="#claude">as 43, 6; cf. 55, 3<hi rend="italic">b</hi>. 61, 6<hi rend="italic">b</hi>. 82, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-3b.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">des</hi> Ligius</seg><seg type="translation" xml:lang="en" source="#claude">of the ligius</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-3b.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dem Angelsächsischen Verbot eigenmächtigen Herrensuchens, wie</hi> II Cn. 28, <hi rend="italic">das Allen vergleicht, ist fremd das Beibehalten des bisherigen wie der</hi> Ligius</seg><seg type="translation" xml:lang="en" source="#claude">the retention of the previous [lord], as with the ligius, is foreign to the Anglo-Saxon prohibition of seeking a lord on one’s own authority, as in II Cn. 28, which Allen compares</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-3b.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">hominum <hi rend="italic">ergänzt ohne Hss. Wi Tho.</hi> [<hi rend="italic">nicht nöthig</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">hominum supplied without MSS Wi Tho. [not necessary]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-3b.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht in Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">not in Sc Hg</seg></note>
      </div>
    </body>
