      <div type="clause" n="7.3">
        <head><ref type="lawCode" target="law:IIIAs">III As</ref> 7.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7.3" corresp="#wit-q"><pb n="170" ed="#liebermann"/>Et si dominus<ptr type="liebermannNote" n="50" target="#IIIAs_7-3.lnote.oe.50"/><ptr type="liebermannNote" n="a" target="#IIIAs_7-3.lnote.oe.a"/> uel prepositus uel aliquis homo<ptr type="liebermannNote" n="51" target="#IIIAs_7-3.lnote.oe.51"/> hoc infringat uel abhinc exeat, sit dignus eorum que<ptr type="liebermannNote" n="52" target="#IIIAs_7-3.lnote.oe.52"/> apud Greateleiam<ptr type="liebermannNote" n="53" target="#IIIAs_7-3.lnote.oe.53"/> dicta sunt, nisi regi<ptr type="liebermannNote" n="b" target="#IIIAs_7-3.lnote.oe.b"/> placeat (magis<ptr type="liebermannNote" n="54" target="#IIIAs_7-3.lnote.oe.54"/>) alia iusticia.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="7.3" corresp="#wit-q"><pb n="144" ed="#attenborough"/>Et si [dominus vel]<ptr type="editorNote" n="16" target="#IIIAs_7-3.attnote.fn.16"/> præpositus vel aliquis homo hoc infringat vel abhinc exeat, sit dignus eorum quæ apud Greateleiam dicta sunt, nisi regi [magis]<ptr type="editorNote" n="16" target="#IIIAs_7-3.attnote.fn.16"/> placeat alia iustitia.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="145" ed="#attenborough"/>And if a lord or a reeve or any man breaks this decree or departs from it, he shall suffer the penalties declared at Grately, unless the king prefers to inflict a different penalty.</ab>
        <note type="comparison" source="#liebermann" n="170"><ref target="clause:IIAs_3">II As 3</ref>; <ref target="clause:IIAs_25-2">II As 25.2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. II As. 3; 25, 2</note>
        <note type="comparedBy" source="#wormald-mel" n="316"><ref target="clause:IIIEg_1-1">III Eg 1.1–4</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="316"><ref target="clause:IIIEg_5">III Eg 5–5.2</ref></note>
        <note type="editorial">Latin only; no German translation in Liebermann. ‘dominus uel’ is missing from K and written above the line in Co. Liebermann compares II As 25.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_7-3.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">dominus uel <hi rend="italic">fehlt K; übergeschr. Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">dominus uel lacking in K; written above Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_7-3.lnote.oe.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt TMHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in TMHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_7-3.lnote.oe.52" n="52" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">qui <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_7-3.lnote.oe.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">Gra. <hi rend="italic">K;</hi> Grade. <hi rend="italic">Co Or;</hi> Greatt. <hi rend="italic">TM</hi></seg><seg type="translation" xml:lang="en" source="#claude">Gra. K; Grade. Co Or; Greatt. TM</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_7-3.lnote.oe.54" n="54" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond;</hi> m. pl. <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond; m. pl. MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_7-3.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">112</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Schmid meint, II As 3 werde hier zitiert</seg><seg type="translation" xml:lang="en" source="#claude">Schmid thinks that II As 3 is cited here</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_7-3.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">112</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Begnadigung 8</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Begnadigung 8</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_7-3.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">144</biblScope></bibl><label>sua</label><seg type="original" xml:lang="en">Br, M.</seg></note>
      </div>
    </body>
