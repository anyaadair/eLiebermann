      <div type="clause" n="15.1">
        <head><ref type="lawCode" target="law:VIAtr">VI Atr</ref> 15.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="15.1"><pb n="250" ed="#liebermann"/>[Not in D]</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15.1" corresp="#wit-k"><pb n="250" ed="#liebermann"/>ne cyricþén ne utige butan biscopes geþehte.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="15[b]" corresp="#wit-k"><pb n="96" ed="#robertson"/>ne cyricþén ne utige butan biscopes geþehte.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-k"><pb n="166" ed="#rabin-doml"/>Ne cyricþen ne utige butan biscopes geþehte.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="250" ed="#liebermann"/>oder vertreibe den Altarpriester ohne des Bischofs Beistimmung.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">or expel the altar-priest without the bishop's consent.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-k"><pb n="97" ed="#robertson"/>or turn out a minister of the church without the bishop's consent.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-k"><pb n="167" ed="#rabin-doml"/>Nor may a cleric be expelled without the bishop’s permission.</ab>
        <note type="comparison" source="#liebermann" n="250">[?]</note>
        <note type="comparisonPrinted" source="#liebermann">ebd. [?]</note>
        <note type="comparisonIncomplete">Some of Liebermann’s notes here are cut off in the gutter of the scan used, and are still to be completed.</note>
