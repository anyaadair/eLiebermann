    <body>
      <div type="clause" n="12.1">
        <head>Cn 1018 12.1</head>
        <ab type="editionText" xml:lang="ang" source="#kennedy" n="12.1" corresp="#wit-d"><pb n="75" ed="#kennedy"/>Ne on ðæs wifes nydmagan þe he silf ær hæfde. ne on his gefæderan. ne on gehalgodre nunnan.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-d"><pb n="216" ed="#rabin-doml"/>ne on ðæs wifes nydmagan þe he silf ær hæfde, ne on his gefæderan, ne on gehalgodre nunnan.</ab>
        <ab type="translation" xml:lang="en" source="#kennedy" corresp="#wit-d"><pb n="75" ed="#kennedy"/>Nor a close kinsman of his former wife, nor his godmother, nor a professed nun.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-d"><pb n="217" ed="#rabin-doml"/>nor a close relative of his first wife, his godmother, or a professed nun.</ab>
      </div>
    </body>
