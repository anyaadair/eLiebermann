      <div type="clause" n="4.1">
        <head><ref type="lawCode" target="law:Duel">Duel</ref> 4.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Duel 4.1" corresp="#wit-lat"><pb n="431" ed="#liebermann"/>Accipe hunc baculum ad hoc duellum<ptr type="liebermannNote" n="14" target="#Duel_4-1.lnote.oe.14"/> pręparatum, cum quo ualeas<ptr type="liebermannNote" n="15" target="#Duel_4-1.lnote.oe.15"/> tibi rebellantem<ptr type="liebermannNote" n="16" target="#Duel_4-1.lnote.oe.16"/> prosternere et insurgentem<ptr type="liebermannNote" n="17" target="#Duel_4-1.lnote.oe.17"/> conterere habeasque uictoriam in nomine Patris et<ptr type="liebermannNote" n="18" target="#Duel_4-1.lnote.oe.18"/> Filii et Spiritus sancti! Amen.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 431 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_4-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">bellum <hi rend="italic">Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">bellum Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_4-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">ualetis <hi rend="italic">Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">ualetis Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_4-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">r. p. et <hi rend="italic">fehlt Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. p. et missing in Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_4-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">-tes terrere <hi rend="italic">Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tes terrere Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_4-1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">et — Amen <hi rend="italic">fehlt Ta Gl</hi></seg><seg type="translation" xml:lang="en" source="#claude">et — Amen missing in Ta Gl</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">Receive this staff, prepared for this duel, with which you may be able to lay low the one who rebels against you and to crush the one who rises up, and may you have the victory, in the name of the Father and of the Son and of the Holy Spirit! Amen.</ab>
      </div>
    </body>
