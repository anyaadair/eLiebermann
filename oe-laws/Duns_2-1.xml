        <note type="liebermannNote" subtype="erklaerung" xml:id="Duns_2-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">218</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Wb</hi> standan 8</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Wb</hi> standan 8</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Duns_2-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">218</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Beweis 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Beweis 4</seg></note>
