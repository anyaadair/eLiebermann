    <body>
      <div type="clause" n="35.1c">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 35.1c</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 35.1c"><pb n="665" ed="#liebermann"/>Et<ptr type="liebermannNote" n="11" target="#ECf_35-1c.lnote.la.11"/> quia<ptr type="liebermannNote" n="e" target="#ECf_35-1c.lnote.la.fn.e"/> heredem<ptr type="liebermannNote" n="12" target="#ECf_35-1c.lnote.la.12"/> putabat<ptr type="liebermannNote" n="13" target="#ECf_35-1c.lnote.la.13"/> eum facere<ptr type="liebermannNote" n="14" target="#ECf_35-1c.lnote.la.14"/>, nominauit<ptr type="liebermannNote" n="15" target="#ECf_35-1c.lnote.la.15"/> aþeling<ptr type="liebermannNote" n="16" target="#ECf_35-1c.lnote.la.16"/>, quod nos<ptr type="liebermannNote" n="5" target="#ECf_35-1c.lnote.la.5"/> dicimus domicellum<ptr type="liebermannNote" n="f" target="#ECf_35-1c.lnote.la.fn.f"/>, sed nos de pluribus, quia filios baronum uocamus domicellos, Angli autem<ptr type="liebermannNote" n="17" target="#ECf_35-1c.lnote.la.17"/> nullum<ptr type="liebermannNote" n="18" target="#ECf_35-1c.lnote.la.18"/> preter filios<ptr type="liebermannNote" n="19" target="#ECf_35-1c.lnote.la.19"/> regum<ptr type="liebermannNote" n="20" target="#ECf_35-1c.lnote.la.20"/>.</ab>
        <note type="comparison" source="#liebermann" n="665"><label>printed alongside</label> <ref target="clause:ECfRetr_35-1c">ECf retr 35.1c</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 665 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1c.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">diese Absicht combinirt vielleicht Verf. nur; zum</hi> Æþeling <hi rend="italic">war Eadgar als eines Königs legitimer Sohnessohn (nicht Sohn) geboren; Ernennung dazu mit daraus folgendem Thronfolgeanspruch (den Zeitgenossen vielmehr aus der Geburt ableiten) erfindet wohl der Verf., wenn er nicht, wie aus dem Folgenden wahrscheinlicher, blosses Nennen meint. [Nicht etwa die Verwandtschaft mit dem ‘ernennenden’ Bekenner will Verf., ‘gleichgültig gegen Abstammung von anderem König’ (HECK) betonen]</hi></seg><seg type="translation" xml:lang="en" source="#claude">the author perhaps only infers this intention; Edgar was born an Æþeling as a king’s legitimate grandson (not son); the author probably invents a nomination to it, with a resulting claim to the succession (which contemporaries rather derive from birth), unless he means mere naming, as is more likely from what follows. [The author does not mean to stress the relationship with the ‘nominating’ Confessor, ‘indifferent to descent from another king’ (HECK)]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1c.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Altfranz.</hi> doncel; <hi rend="italic">vgl. Littré</hi> damoiseau; <hi rend="italic">Skeat</hi> damsel. <hi rend="italic">Laut Ducange kann</hi> domicellus: Königssohn, <hi rend="italic">doch nicht bloss ihn, bedeuten. — Zum Retr. setzt Co</hi> id est damisel <hi rend="italic">mit männlichem Sinn; sonst ist es im Mittelenglischen, wie jetzt</hi> damsel, <hi rend="italic">nur Femininum:</hi> Jungfer</seg><seg type="translation" xml:lang="en" source="#claude">Old French doncel; cf. Littré, damoiseau; Skeat, damsel. According to Ducange domicellus can mean king’s son, but not only that. — In the Retr. Co adds id est damisel, in a masculine sense; otherwise in Middle English it is, like damsel now, only feminine: maiden</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1c.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1c.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">Quia uero her. <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">Quia uero her. S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1c.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cl;</hi> p. f. e. h. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cl; p. f. e. h. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1c.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">-auit <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-auit Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1c.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">regem <hi rend="italic">fügt zu Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cl adds regem</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1c.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">eum <hi rend="italic">fügt zu S Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">S Hr add eum</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1c.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">adþ. <hi rend="italic">Rl;</hi> adel. <hi rend="italic">Hk;</hi> adl. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">adþ. Rl; adel. Hk; adl. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1c.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">uero <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">uero Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1c.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">nullos <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">nullos Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1c.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">filium <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">filium Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1c.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">regis <hi rend="italic">Cl;</hi> uocant <hi rend="italic">fügt zu S</hi></seg><seg type="translation" xml:lang="en" source="#claude">regis Cl; S adds uocant</seg></note>
      </div>
