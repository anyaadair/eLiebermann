    <body>
      <div type="clause" n="6.2">
        <head><ref type="lawCode" target="law:WlArt">Wl art</ref> 6.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-h"><pb n="487" ed="#liebermann"/>Si quis<ptr type="liebermannNote" n="l" target="#WlArt_6-2.lnote.oe.l"/> eorum uictus fuerit, emendet XL<ptr type="liebermannNote" n="60" target="#WlArt_6-2.lnote.oe.60"/><ptr type="liebermannNote" n="m" target="#WlArt_6-2.lnote.oe.m"/> solidos<ptr type="liebermannNote" n="61" target="#WlArt_6-2.lnote.oe.61"/> regi.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="6.2" corresp="#wit-h"><pb n="240" ed="#robertson"/>Si quis eorum victus fuerit, emendet XL solidos regi.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-h"><pb n="241" ed="#robertson"/>If either of them is defeated, he shall pay 40 shillings to the King.</ab>
        <note type="comparison" source="#liebermann" n="487"><ref target="clause:WiLad_2-2">Wl lad 2.2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 2, 2</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:WiLad_2-2">Wl lad 2.2</ref></note>
        <note type="editorial">Added October 2026 from Robertson pp. 240–241 (text and translation); Liebermann’s text added from Gesetze I p. 487, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_6-2.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">487</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlerhafte Abweichung von</hi> Wl lad</seg><seg type="translation" xml:lang="en" source="#claude">erroneous departure from Wl lad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_6-2.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">487</biblScope></bibl><seg type="original" xml:lang="de">LX [<hi rend="italic">wie Wl lad</hi> 2, 2], <hi rend="italic">aber auf Rasur</hi> [<hi rend="italic">also gebessert aus eigenem Wissen</hi>] <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">LX [as Wl lad 2, 2], but on an erasure [thus corrected from his own knowledge] Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_6-2.lnote.oe.60" n="60" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">487</biblScope></bibl><seg type="original" xml:lang="de">r. XL [LX <hi rend="italic">Cb</hi>] s. <hi rend="italic">T Cb Hv Retr Ra Vi Va Ph Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. XL [LX <hi rend="italic">Cb</hi>] s. <hi rend="italic">T Cb Hv Retr Ra Vi Va Ph Pl</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_6-2.lnote.oe.61" n="61" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">487</biblScope></bibl><seg type="original" xml:lang="de">-dis <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dis <hi rend="italic">Rl</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_6-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">281</biblScope></bibl><seg type="original" xml:lang="de">Die Zahlung traf nach Wl lad nur den Normannen</seg><seg type="translation" xml:lang="en" source="#claude">According to Wl lad the payment fell only on the Norman</seg></note>
      </div>
    </body>
