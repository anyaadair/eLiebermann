  <text>
    <body>
      <div type="clause" n="10.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 10.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 10.1"><pb n="634" ed="#liebermann"/>Iste uero denarius debet<ptr type="liebermannNote" n="13" target="#ECfRetr_10-1.lnote.la.13"/> submoneri in <hi rend="bold">solennitate</hi> apostolorum<ptr type="liebermannNote" n="14" target="#ECfRetr_10-1.lnote.la.14"/> Petri et Pauli <hi rend="bold">et colligi ante</hi><ptr type="liebermannNote" n="15" target="#ECfRetr_10-1.lnote.la.15"/> festiuitatem <hi rend="bold">que dicitur</hi> Ad uincula<ptr type="liebermannNote" n="16" target="#ECfRetr_10-1.lnote.la.16"/><hi rend="bold">, ita ut</hi><ptr type="liebermannNote" n="17" target="#ECfRetr_10-1.lnote.la.17"/> ultra <hi rend="bold">illum</hi><ptr type="liebermannNote" n="18" target="#ECfRetr_10-1.lnote.la.18"/> <hi rend="bold">diem</hi> non detineatur.</ab>
        <note type="comparison" source="#liebermann" n="634"><label>printed alongside</label> <ref target="clause:ECf_10-1">ECf 10.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 634 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-1.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">debeat <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">debeat Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-1.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">sanctorum <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">sanctorum Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-1.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">ad <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-1.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">sancti Petri <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds sancti Petri</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-1.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">Db; fehlt Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod Db; lacking in Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-1.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">alium <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">alium Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">This penny ought to be called for at the solemnity of the apostles Peter and Paul and collected before the feast which is called Ad Vincula, so that it is not withheld beyond that day.</ab>
      </div>
