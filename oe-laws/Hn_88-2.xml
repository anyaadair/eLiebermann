      <div type="clause" n="88.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 88.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 88.2" corresp="#wit-lat"><pb n="602" ed="#liebermann"/>Tractandum uero est in agendis huiusmodi<ptr type="liebermannNote" n="39" target="#Hn_88-2.lnote.oe.39"/> de modo portacionis uel posicionis<ptr type="liebermannNote" n="p" target="#Hn_88-2.lnote.oe.p"/> armorum<ptr type="liebermannNote" n="40" target="#Hn_88-2.lnote.oe.40"/>, de loco posicionis<ptr type="liebermannNote" n="p" target="#Hn_88-2.lnote.oe.p"/>, de eo qui posuit, quid, quomodo contigerit<ptr type="liebermannNote" n="41" target="#Hn_88-2.lnote.oe.41"/>.</ab>
        <note type="comparison" source="#wormald-mel" n="413"><label>generalizes</label> <ref target="clause:Af_36">Af 36–36.2</ref> <quote>Alfred's law on clumsy spear-carriers ... was prefaced: 'In ... legal proceedings of this kind consideration must be given to the manner of carrying'</quote></note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 602 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-2.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">Hinlegung (Fortstellung). <hi rend="italic">Vgl.</hi> 90, 11<hi rend="italic">c</hi></seg><seg type="translation" xml:lang="en" source="#claude">placing (setting aside). <hi rend="italic">Cf.</hi> 90, 11<hi rend="italic">c</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-2.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by <hi rend="italic">Co Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-2.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">a. de l. p. <hi rend="italic">überspringt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. de l. p. omitted by K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-2.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">conting. <hi rend="italic">Sc;</hi> contingeit <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">conting. Sc; contingeit Hg</seg></note>
