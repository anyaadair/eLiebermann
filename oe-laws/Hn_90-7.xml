      <div type="clause" n="90.7">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 90.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 90.7" corresp="#wit-lat"><pb n="606" ed="#liebermann"/>Si homo cadat ab arbore uel<ptr type="liebermannNote" n="4" target="#Hn_90-7.lnote.oe.4"/> quolibet mechanico<ptr type="liebermannNote" n="c" target="#Hn_90-7.lnote.oe.c"/> super aliquem, ut inde moriatur<ptr type="liebermannNote" n="d" target="#Hn_90-7.lnote.oe.d"/> uel debilitetur<ptr type="liebermannNote" n="d" target="#Hn_90-7.lnote.oe.d"/>, si<ptr type="liebermannNote" n="5" target="#Hn_90-7.lnote.oe.5"/> certificare ualeat, quod amplius<ptr type="liebermannNote" n="e" target="#Hn_90-7.lnote.oe.e"/> non potuit, antiquis<ptr type="liebermannNote" n="6" target="#Hn_90-7.lnote.oe.6"/> institucionibus habeatur innoxius.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 606 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-7.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">‘qualibet arte uel ratione’ <hi rend="italic">DUCANGE; wohl eher:</hi> menschliche (nicht natürliche) Vorrichtung, Kunstbau</seg><seg type="translation" xml:lang="en" source="#claude">‘qualibet arte uel ratione’ DUCANGE; more probably: a human (not natural) contrivance, an artificial structure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-7.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">der, auf welchen jener fiel</hi></seg><seg type="translation" xml:lang="en" source="#claude">the person on whom the other fell</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-7.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere oder verstehe</hi> alias: anders</seg><seg type="translation" xml:lang="en" source="#claude">emend or understand alias: otherwise</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-7.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">u. q. m. s. a. <hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. q. m. s. a. missing K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-7.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">etiam <hi rend="italic">Wh;</hi> scīficare <hi rend="italic">statt</hi> si c. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">etiam Wh; scīficare instead of si c. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-7.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">aliquis <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">aliquis K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-7.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Absicht 7d</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Absicht 7d</seg></note>
      </div>
