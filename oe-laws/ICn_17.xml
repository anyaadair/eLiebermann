        <note type="liebermannNote" subtype="textual" xml:id="ICn_17.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">296</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_17.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">296</biblScope></bibl><seg type="original" xml:lang="de">Twelfta dæg <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Twelfta dæg Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_17.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">296</biblScope></bibl><seg type="original" xml:lang="de">-gesima <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gesima Ld</seg></note>
