    <body>
      <div type="clause" n="7.3">
        <head><ref type="lawCode" target="law:IVAtr">IV Atr</ref> 7.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.3" corresp="#wit-q"><pb n="236" ed="#liebermann"/>Et portireue qui falsi huius consentanei fuerint, eiusdem censure digni sint<ptr type="liebermannNote" n="8" target="#IVAtr_7-3.lnote.oe.8"/> cum falsis monetariis, nisi rex indulgeat eis, uel se possint<ptr type="liebermannNote" n="9" target="#IVAtr_7-3.lnote.oe.9"/> adlegiare eodem cyrað<ptr type="liebermannNote" n="10" target="#IVAtr_7-3.lnote.oe.10"/> uel ordalio predicto.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="7.3" corresp="#wit-q"><pb n="76" ed="#robertson"/>Et portirevae qui falsi huius consentanei<ptr type="editorNote" n="8" target="#IVAtr_7-3.robnote.fn.8"/> fuerint, eiusdem censurae digni sint<ptr type="editorNote" n="9" target="#IVAtr_7-3.robnote.fn.9"/> cum falsis monetariis, nisi rex indulgeat eis vel se possint<ptr type="editorNote" n="10" target="#IVAtr_7-3.robnote.fn.10"/> adlegiare eodem cyrað<ptr type="editorNote" n="11" target="#IVAtr_7-3.robnote.fn.11"/> vel ordalio praedicto.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="237" ed="#liebermann"/>Und Stadtvögte<ptr type="liebermannNote" n="1" target="#IVAtr_7-3.lnote.de.1"/>, welche Mitwisser obiger Fälschung sind, seien desselben<ptr type="liebermannNote" n="2" target="#IVAtr_7-3.lnote.de.2"/> Strafurtheils mit den Falschmünzern theilhaftig, ausser wenn der König ihrer schonen will, oder sie sich unschuldig erweisen können durch jenen Eid mit [vom Richter] erkorenen<ptr type="liebermannNote" n="3" target="#IVAtr_7-3.lnote.de.3"/> Helfern oder durch vorgenanntes Ordal.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And town-reeves who are privy to the above forgery, let them be subject to the same sentence as the false moneyers, unless the king is willing to spare them, or they can prove themselves innocent by that oath with helpers chosen [by the judge] or by the aforesaid ordeal.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q"><ptr type="editorNote" n="1" target="#IVAtr_7-3.robnote.n.1"/><pb n="77" ed="#robertson"/>And town-reeves who have been accessories to such a fraud shall be liable to the same punishment as coiners, unless the king pardon them, or they can clear themselves by a similar oath of nominated jurors<ptr type="editorNote" n="2" target="#IVAtr_7-3.robnote.n.2"/>, or by the ordeal specified above<ptr type="editorNote" n="3" target="#IVAtr_7-3.robnote.n.3"/>.</ab>
        <note type="comparison" source="#liebermann" n="237"><ref target="clause:IVAtr_5-2">IV Atr 5.2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. 5, 2</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_8-2">II Cn 8.2</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="358"><ref target="clause:IICn_8-2">II Cn 8.2</ref></note>
        <note type="editorial">Liebermann compares IV Atr 5.2.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_7-3.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">236</biblScope></bibl><seg type="original" xml:lang="de">sunt <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">sunt R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_7-3.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">236</biblScope></bibl><seg type="original" xml:lang="de">-sit <hi rend="italic">RT</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sit RT</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_7-3.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">236</biblScope></bibl><seg type="original" xml:lang="de">cir. <hi rend="italic">R;</hi> syrað <hi rend="italic">MHk;</hi> sirath <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">cir. R; syrað MHk; sirath Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_7-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">166</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Hieraus II Cn 8, 2, allgemeiner: <hi rend="italic">gerefan</hi></seg><seg type="translation" xml:lang="en" source="#claude">From this II Cn 8, 2, more generally: <hi rend="italic">gerefan</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_7-3.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">166</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">þæs ilcan domes weorðe</hi> las Original. <hi rend="italic">Vgl. Gl</hi> Mitwissen 8; Amtsvergehen 4; Begünstigung 8c</seg><seg type="translation" xml:lang="en" source="#claude">The original read <hi rend="italic">þæs ilcan domes weorðe</hi>. <hi rend="italic">Cf. Gl</hi> Mitwissen 8; Amtsvergehen 4; Begünstigung 8c</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_7-3.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">166</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">cyreað</hi> (<hi rend="italic">s. Gl</hi> Auswahleid) übernimmt Q auch sonst</seg><seg type="translation" xml:lang="en" source="#claude">Q takes over <hi rend="italic">cyreað</hi> (<hi rend="italic">see Gl</hi> Auswahleid) elsewhere too</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_7-3.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">326</biblScope></bibl><seg type="original" xml:lang="en">Cf. II Cn. 8, 2.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_7-3.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">326</biblScope></bibl><seg type="original" xml:lang="en">Cf. II As. 9. No oath of nominated compurgators is mentioned elsewhere in IV Atr. Liebermann suggests that <hi rend="italic">eodem</hi> may be a false translation of <hi rend="italic">þam</hi>.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_7-3.robnote.n.3" n="3" source="#robertson"><bibl><biblScope unit="page">326</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e.</hi> in 5, 2.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_7-3.robnote.fn.8" n="8" source="#robertson"><bibl><biblScope unit="page">76</biblScope></bibl><label>consentanei</label><seg type="original" xml:lang="en"><hi rend="italic">falso cons.</hi> Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_7-3.robnote.fn.9" n="9" source="#robertson"><bibl><biblScope unit="page">76</biblScope></bibl><label>sint</label><seg type="original" xml:lang="en"><hi rend="italic">sunt</hi> R, T.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_7-3.robnote.fn.10" n="10" source="#robertson"><bibl><biblScope unit="page">76</biblScope></bibl><label>possint</label><seg type="original" xml:lang="en"><hi rend="italic">possit</hi> R, T.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_7-3.robnote.fn.11" n="11" source="#robertson"><bibl><biblScope unit="page">76</biblScope></bibl><label>cyrað</label><seg type="original" xml:lang="en"><hi rend="italic">cir.</hi> R; <hi rend="italic">syrað</hi> M, Hk; <hi rend="italic">sirath</hi> Br.</seg></note>
      </div>
