        <head><ref type="lawCode" target="law:Hn">Hn</ref> 8.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 8.7" corresp="#wit-lat"><pb n="554" ed="#liebermann"/>Et si<ptr type="liebermannNote" n="30" target="#Hn_8-7.lnote.oe.30"/> quid professioni<ptr type="liebermannNote" n="kk" target="#Hn_8-7.lnote.oe.kk"/> nostre congruum precedencium uel sequencium capitula docuerint<ptr type="liebermannNote" n="31" target="#Hn_8-7.lnote.oe.31"/>, siue<ptr type="liebermannNote" n="32" target="#Hn_8-7.lnote.oe.32"/> iure<ptr type="liebermannNote" n="ll" target="#Hn_8-7.lnote.oe.ll"/> naturali uel legali uel morali gaudeant instituto, et hoc licet multa<ptr type="liebermannNote" n="m" target="#Hn_8-7.lnote.oe.m"/> compositorum<ptr type="liebermannNote" n="33" target="#Hn_8-7.lnote.oe.33"/> uarietate minus plene peregerim, bonam<ptr type="liebermannNote" n="34" target="#Hn_8-7.lnote.oe.34"/> saltem uoluntatem<ptr type="liebermannNote" n="n" target="#Hn_8-7.lnote.oe.n"/> ubique pretendo.</ab>
        <note type="comparison" source="#wormald-mel" n="413"><label>cf.</label> Quadr Ded. 24 <quote>He hoped that his work might profit 'professioni nostrae'</quote></note>
