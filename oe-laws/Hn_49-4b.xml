      <div type="clause" n="49.4b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 49.4b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 49.4b" corresp="#wit-lat"><pb n="572" ed="#liebermann"/>Inducie enim [non<ptr type="liebermannNote" n="39" target="#Hn_49-4b.lnote.oe.39"/>] modice<ptr type="liebermannNote" n="40" target="#Hn_49-4b.lnote.oe.40"/> ad querendum dande<ptr type="liebermannNote" n="41" target="#Hn_49-4b.lnote.oe.41"/> sunt, ne aliquid<ptr type="liebermannNote" n="42" target="#Hn_49-4b.lnote.oe.42"/> agi propere a quacunque parte uideatur: quia multa per surrepcionem eueniunt<ptr type="liebermannNote" n="h" target="#Hn_49-4b.lnote.oe.h"/><ptr type="liebermannNote" n="43" target="#Hn_49-4b.lnote.oe.43"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 572 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-4b.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">näher zu Ivo</hi> Pan. IV 103 <hi rend="italic">als Ps.-Isidor</hi> (proueniunt)</seg><seg type="translation" xml:lang="en" source="#claude">closer to Ivo Pan. IV 103 than to Pseudo-Isidore (proueniunt)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-4b.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hss., ergänzt aus Pseudo-Isidor</hi> (= <hi rend="italic">Ivo</hi> = <hi rend="italic">Gratian C.</hi> 3 <hi rend="italic">q.</hi> 3 <hi rend="italic">c.</hi> 3)</seg><seg type="translation" xml:lang="en" source="#claude">missing in the MSS, supplied from Pseudo-Isidore (= Ivo = Gratian C. 3 q. 3 c. 3)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-4b.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">dominice <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">dominice K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-4b.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">-di <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-di Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-4b.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">quid <hi rend="italic">Sc;</hi> ad <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">quid Sc; ad Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-4b.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">-nerint <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nerint Co Or</seg></note>
