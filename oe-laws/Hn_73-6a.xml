      <div type="clause" n="73.6a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 73.6a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 73.6a" corresp="#wit-lat"><pb n="591" ed="#liebermann"/>De<ptr type="liebermannNote" n="22" target="#Hn_73-6a.lnote.oe.22"/> adulterio<ptr type="liebermannNote" n="f" target="#Hn_73-6a.lnote.oe.f"/> uel fornicatione<ptr type="liebermannNote" n="g" target="#Hn_73-6a.lnote.oe.g"/> uel nunne<ptr type="liebermannNote" n="h" target="#Hn_73-6a.lnote.oe.h"/><ptr type="liebermannNote" n="23" target="#Hn_73-6a.lnote.oe.23"/> concubitu similiter peniteat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 591 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_73-6a.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">591</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 11, 5. 21</seg><seg type="translation" xml:lang="en" source="#claude">cf. 11, 5. 21</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_73-6a.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">591</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ps.-Egbert</hi> 7: Si episcopus quis fornicationem commiserit uel adulterauerit, . . ieiunet prout homicida; <hi rend="italic">also meint Hn hier nicht Romreisen und denkt nicht etwa an Austreibung fremder Hurer</hi> II Cn 55</seg><seg type="translation" xml:lang="en" source="#claude">Ps.-Egbert 7: Si episcopus quis fornicationem commiserit uel adulterauerit, . . ieiunet prout homicida; so Hn does not mean journeys to Rome here, nor is he thinking, say, of the expulsion of foreign fornicators, II Cn 55</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_73-6a.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">591</biblScope></bibl><seg type="original" xml:lang="de">n. c. <hi rend="italic">aus Af Rb.</hi> 8?</seg><seg type="translation" xml:lang="en" source="#claude">n. c. from Af Rb. 8?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_73-6a.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">591</biblScope></bibl><seg type="original" xml:lang="de">Et <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_73-6a.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">591</biblScope></bibl><seg type="original" xml:lang="de">nimio, <hi rend="italic">die</hi> i-<hi rend="italic">Striche vom Corr. Sc;</hi> numie <hi rend="italic">Co;</hi> nunii <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">nimio, the i-strokes by the corrector, Sc; numie Co; nunii Or</seg></note>
      </div>
    </body>
