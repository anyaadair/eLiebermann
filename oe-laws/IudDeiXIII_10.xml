      <div type="clause" n="10">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 10</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei XIII 10" corresp="#wit-lat"><pb n="423" ed="#liebermann"/>Postea<ptr type="liebermannNote" n="29" target="#IudDeiXIII_10.lnote.oe.29"/> coniuret aquam, ubi illos immittat<ptr type="liebermannNote" n="30" target="#IudDeiXIII_10.lnote.oe.30"/> (dicens<ptr type="liebermannNote" n="18" target="#IudDeiXIII_10.lnote.oe.18"/> ita:)</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 423 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_10.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Tr; fehlt Vt2 Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Tr; omitted in Vt2 Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_10.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">uero <hi rend="italic">fügt zu Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">uero added by Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_10.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">undeutlich, vielleicht</hi> mittit? inicit? <hi rend="italic">Vt2;</hi> inmittit <hi rend="italic">Zeu.</hi> 653&lt;sub&gt;30&lt;/sub&gt; <hi rend="italic">hier zunächst stehend</hi></seg><seg type="translation" xml:lang="en" source="#claude">indistinct, perhaps mittit? inicit? Vt2; inmittit Zeu. 653&lt;sub&gt;30&lt;/sub&gt;, which stands closest here</seg></note>
      </div>
