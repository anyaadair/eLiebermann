      <div type="clause" n="75.1">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 75.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-h"><seg type="part" corresp="#part-a"><pb n="7" ed="#liebermann"/>Ðare<ptr type="liebermannNote" n="5" target="#Abt_75-1-a.lnote.oe.5"/> oþre XX scll'<ptr type="liebermannNote" n="2" target="#Abt_75-1-a.lnote.oe.2"/>,</seg> <seg type="part" corresp="#part-b"><pb n="7" ed="#liebermann"/>ðare þriddan XII scll',</seg> <seg type="part" corresp="#part-c"><pb n="7" ed="#liebermann"/>þare feorðan VI scll'.</seg></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-h"><seg type="part" corresp="#part-a"><pb n="14" ed="#attenborough"/>Ðare oþre XX scll',</seg> <seg type="part" corresp="#part-b"><pb n="14" ed="#attenborough"/>ðare þriddan XII scll',</seg> <seg type="part" corresp="#part-c"><pb n="14" ed="#attenborough"/>þare feorðan VI scll'.</seg></ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" corresp="#wit-h" n="74.1–74.3"><seg type="part" n="74.1" corresp="#part-a"><pb n="76" ed="#oliver"/>Ðare oþre, XX scƚƚ.</seg> <seg type="part" n="74.2" corresp="#part-b"><pb n="76" ed="#oliver"/>Ðare þriddan, XII scƚƚ.</seg> <seg type="part" n="74.3" corresp="#part-c"><pb n="76" ed="#oliver"/>Þare feorðan, VI scƚƚ.</seg></ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><seg type="part" corresp="#part-a"><pb n="7" ed="#liebermann"/>[das] über die [an Range<ptr type="liebermannNote" n="4" target="#Abt_75-1-a.lnote.de.4"/>] zweite mit 20 Schll.,</seg> <seg type="part" corresp="#part-b"><pb n="7" ed="#liebermann"/>[das] über die dritte mit 12 Schll.,</seg> <seg type="part" corresp="#part-c"><pb n="7" ed="#liebermann"/>[das] über die vierte mit 6 Schll.<ptr type="liebermannNote" n="5" target="#Abt_75-1-c.lnote.de.5"/> [an ihren Vormund<ptr type="liebermannNote" n="6" target="#Abt_75-1-c.lnote.de.6"/>].</seg></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman"><seg type="part" corresp="#part-a">[that] over the second [in rank] with 20 shillings,</seg> <seg type="part" corresp="#part-b">[that] over the third with 12 shillings,</seg> <seg type="part" corresp="#part-c">[that] over the fourth with 6 shillings [to her guardian].</seg></ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><seg type="part" corresp="#part-a"><pb n="15" ed="#attenborough"/>For violation of the <hi rend="italic">mund</hi> of a widow of the second class, 20 shillings;</seg> <seg type="part" corresp="#part-b"><pb n="15" ed="#attenborough"/>of the third class, 12 shillings;</seg> <seg type="part" corresp="#part-c"><pb n="15" ed="#attenborough"/>of the fourth class, 6 shillings.</seg></ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h"><seg type="part" corresp="#part-a"><pb n="392" ed="#whitelock"/>that over one of the second class, with 20 shillings;</seg> <seg type="part" corresp="#part-b"><pb n="392" ed="#whitelock"/>over one of the third class, with 12 shillings;</seg> <seg type="part" corresp="#part-c"><pb n="392" ed="#whitelock"/>over one of the fourth, with six shillings.</seg></ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h"><seg type="part" corresp="#part-a"><pb n="77" ed="#oliver"/>[For a widow] of the second [rank], 20 shillings.</seg> <seg type="part" corresp="#part-b"><pb n="77" ed="#oliver"/>[For a widow] of the third [rank], 12 shillings.</seg> <seg type="part" corresp="#part-c"><pb n="77" ed="#oliver"/>[For a widow] of the fourth [rank], 6 shillings.</seg></ab>
        <note type="concordance"><seg type="edition">Oliver 74.1, 74.2, 74.3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Abt_75-1-a.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">7</biblScope></bibl><seg type="original" xml:lang="de">Ð <hi rend="italic">Initiale</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ð initial</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Abt_75-1-a.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">7</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so ohne</hi> i</seg><seg type="translation" xml:lang="en" source="#claude">so, without i</seg><note type="remark" resp="#claude">One footnote serves four places on p. 7: Abt 67.1, 70, 73 and 75.1.</note></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_75-1-a.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">14</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Diese Mundsumme kommt sonst nicht vor, während die nächste die des Adels laut <hi rend="italic">o.</hi> 13f. darstellt; nur drei Mundsummen (und, wenn die Königsfamilie als Ein Stand gilt, nur drei Stände) scheidet das Kentische Recht sonst. Dürfte man XXV emendieren, so wäre das Verhältnis glatter 8 : 4 : (abgerundet) 2 : 1</seg><seg type="translation" xml:lang="en" source="#claude">This sum for mund does not occur elsewhere, whereas the next is that of the nobility, as shown <hi rend="italic">above</hi> 13f.; otherwise Kentish law distinguishes only three sums for mund (and, if the royal family counts as a single rank, only three ranks). If XXV could be emended, the ratio would be a smoother 8 : 4 : (rounded) 2 : 1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_75-1-c.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">14</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Die Mund des Gemeinfreien; <hi rend="italic">o.</hi> 15</seg><seg type="translation" xml:lang="en" source="#claude">The mund of the common freeman; <hi rend="italic">above</hi> 15</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_75-1-c.lnote.de.6" n="6" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">14</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Sippe 10. 14a. 15. 19A</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Sippe 10. 14a. 15. 19A</seg></note>
      </div>
    </body>
