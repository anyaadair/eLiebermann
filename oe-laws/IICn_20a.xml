        <note type="liebermannNote" subtype="textual" xml:id="IICn_20a.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod Cb</seg></note>
