      <div type="clause" n="4">
        <head><ref type="lawCode" target="law:IudDeiXIV">Iud Dei XIV</ref> 4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIV 4" corresp="#wit-lat"><pb n="425" ed="#liebermann"/>Item<ptr type="liebermannNote" n="41" target="#IudDeiXIV_4.lnote.oe.41"/> exorcismus<ptr type="liebermannNote" n="42" target="#IudDeiXIV_4.lnote.oe.42"/> (panis<ptr type="liebermannNote" n="43" target="#IudDeiXIV_4.lnote.oe.43"/> et casei.) Exorcizo<ptr type="liebermannNote" n="44" target="#IudDeiXIV_4.lnote.oe.44"/> te, maledicte diabole et<ptr type="liebermannNote" n="45" target="#IudDeiXIV_4.lnote.oe.45"/> immundissime draco<ptr type="liebermannNote" n="46" target="#IudDeiXIV_4.lnote.oe.46"/>, basilisce, serpens noxie, per uerbum ueritatis et signum claritatis Iesu Christi, per Deum omnipotentem et per Iesum Nazarenum, agnum immaculatum ab Altissimo genitum<ptr type="liebermannNote" n="47" target="#IudDeiXIV_4.lnote.oe.47"/> et de Spiritu sancto conceptum, ex Maria uirgine natum<ptr type="liebermannNote" n="48" target="#IudDeiXIV_4.lnote.oe.48"/>, quem Gabriel archangelus<ptr type="liebermannNote" n="49" target="#IudDeiXIV_4.lnote.oe.49"/> annunciauit uenturum, quem Iohannes uidens<ptr type="liebermannNote" n="50" target="#IudDeiXIV_4.lnote.oe.50"/>, exclamauit dicens: ‘Hic<ptr type="liebermannNote" n="51" target="#IudDeiXIV_4.lnote.oe.51"/> est filius Dei, qui tollit peccata mundi’, ut nullo modo tu pręsumas sancto<ptr type="liebermannNote" n="52" target="#IudDeiXIV_4.lnote.oe.52"/> communicare.</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Luc. 1, 19; Ioh. 1, 29</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 425 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_4.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Vt Tr Mg;</hi> Alia <hi rend="italic">Ei; fehlt Ma Bb</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Vt Tr Mg; Alia Ei; omitted in Ma Bb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_4.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Tr Mg Bb;</hi> -isatio <hi rend="italic">Vt; fehlt Ma Ei</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Tr Mg Bb; -isatio Vt; omitted in Ma Ei</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_4.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">p. et c. <hi rend="italic">nur Tr Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. et c. only Tr Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_4.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ähnlich Zeu.</hi> 629. 631. 646. 666. 670. 687. 690</seg><seg type="translation" xml:lang="en" source="#claude">similarly Zeu. 629. 631. 646. 666. 670. 687. 690</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_4.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ei Bb</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Ei Bb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_4.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">-cho <hi rend="italic">Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cho Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_4.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">procreatum <hi rend="italic">Bb</hi></seg><seg type="translation" xml:lang="en" source="#claude">procreatum Bb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_4.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_4.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">ang. <hi rend="italic">Bb</hi></seg><seg type="translation" xml:lang="en" source="#claude">ang. Bb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_4.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_4.lnote.oe.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">Ecce agnus</hi> <hi rend="italic">statt</hi> Hic est f. <hi rend="italic">Bb</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ecce agnus</hi> instead of Hic est f. Bb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_4.lnote.oe.52" n="52" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">c. s. <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. s. Zeu.</seg></note>
      </div>
