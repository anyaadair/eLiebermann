    <body>
      <div type="clause" n="6">
        <head><ref type="lawCode" target="law:Duel">Duel</ref> 6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Duel 6" corresp="#wit-lat"><pb n="431" ed="#liebermann"/>Oratio<ptr type="liebermannNote" n="28" target="#Duel_6.lnote.oe.28"/>. Confortator<ptr type="liebermannNote" n="b" target="#Duel_6.lnote.oe.b"/> et corroborator sustentamentumque tuorum fidelium, Adonay indeficiens, interminabilis, inenarrabilis, pater ęterne Deus, qui gentes magnas<ptr type="liebermannNote" n="29" target="#Duel_6.lnote.oe.29"/> et<ptr type="liebermannNote" n="30" target="#Duel_6.lnote.oe.30"/> reges fortes coram populo tuo Israel destruxisti<ptr type="liebermannNote" n="31" target="#Duel_6.lnote.oe.31"/> et<ptr type="liebermannNote" n="32" target="#Duel_6.lnote.oe.32"/> uicisti, quique puero tuo Dauid<ptr type="liebermannNote" n="c" target="#Duel_6.lnote.oe.c"/> de gigante<ptr type="liebermannNote" n="33" target="#Duel_6.lnote.oe.33"/> te<ptr type="liebermannNote" n="34" target="#Duel_6.lnote.oe.34"/> blasphemante atque in sua uirtute confidente triumphare concessisti, te supplices exoramus,</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">I Reg. 17, 45</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 431 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_6.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Auch diese Formel</hi> [<hi rend="italic">oder wohl nur ihr Anfang?</hi>] <hi rend="italic">steht in</hi> Benedictio peræ et baculi <hi rend="italic">ed. Henderson p.</hi> *207.</seg><seg type="translation" xml:lang="en" source="#claude">This formula too [or probably only its beginning?] appears in Benedictio peræ et baculi ed. Henderson p. *207.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_6.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Mit David’s Beispiel rechtfertigte die Kirche den Zweikampf auch sonst; vgl. unter Edward I.</hi> Mirror of justices III 23 (<hi rend="italic">ed. Whittaker for Selden soc. p.</hi> 109): sur le garaunt del combat … David, … est usage tenu pur lei en Engleterre, issi qe proeve de felonie e en autres cas se face par cumbat.</seg><seg type="translation" xml:lang="en" source="#claude">The Church also justified judicial combat by David’s example elsewhere; cf., under Edward I, Mirror of justices III 23 (ed. Whittaker for Selden soc. p. 109): sur le garaunt del combat … David, … est usage tenu pur lei en Engleterre, issi qe proeve de felonie e en autres cas se face par cumbat.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_6.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Gl; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Gl; missing in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_6.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">-nos <hi rend="italic">Gl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nos Gl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_6.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Mg;</hi> regesque <hi rend="italic">statt</hi> et r. <hi rend="italic">Tr Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Mg; regesque instead of et r. Tr Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_6.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">dedux. <hi rend="italic">Hm Ta</hi></seg><seg type="translation" xml:lang="en" source="#claude">dedux. Hm Ta</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_6.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">et u. <hi rend="italic">fehlt Tr Mg Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">et u. missing in Tr Mg Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_6.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">gyg. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">gyg. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_6.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Mg</seg></note>
      </div>
