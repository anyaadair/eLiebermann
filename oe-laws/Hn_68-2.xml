        <head><ref type="lawCode" target="law:Hn">Hn</ref> 68.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 68.2" corresp="#wit-lat"><pb n="586" ed="#liebermann"/>Alternantur enim omnia: loco — ut si in ecclesia<ptr type="liebermannNote" n="u" target="#Hn_68-2.lnote.oe.u"/> uel domo regis uel in expedicione<ptr type="liebermannNote" n="v" target="#Hn_68-2.lnote.oe.v"/> uel familia<ptr type="liebermannNote" n="v" target="#Hn_68-2.lnote.oe.v"/> uel ciuitate<ptr type="liebermannNote" n="w" target="#Hn_68-2.lnote.oe.w"/> uel huiusmodi<ptr type="liebermannNote" n="32" target="#Hn_68-2.lnote.oe.32"/> perpetua pacis habitatione proueniat —, tempore — si dies festus<ptr type="liebermannNote" n="x" target="#Hn_68-2.lnote.oe.x"/> sit, si rex in<ptr type="liebermannNote" n="y" target="#Hn_68-2.lnote.oe.y"/> hostico<ptr type="liebermannNote" n="33" target="#Hn_68-2.lnote.oe.33"/> uel in ipso sit<ptr type="liebermannNote" n="34" target="#Hn_68-2.lnote.oe.34"/> comitatu —, persona, si seruiens<ptr type="liebermannNote" n="v" target="#Hn_68-2.lnote.oe.v"/> regis sit uel alterius domini prepositus aut minister uel quo[quo]modo<ptr type="liebermannNote" n="35" target="#Hn_68-2.lnote.oe.35"/> securam pacis tranquillitatem preferat<ptr type="liebermannNote" n="36" target="#Hn_68-2.lnote.oe.36"/> siue per breue<ptr type="liebermannNote" n="v" target="#Hn_68-2.lnote.oe.v"/> siue per aliud.</ab>
