        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15" corresp="#wit-h"><pb n="21" ed="#liebermann"/>LIX. Be herge.<ptr type="liebermannNote" n="12" target="#Rubrics-Ine_15.lnote.oe.12"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="15" corresp="#wit-q"><pb n="21" ed="#liebermann"/>Dé<ptr type="liebermannNote" n="20" target="#Rubrics-Ine_15.lnote.oe.20"/> hérege<ptr type="liebermannNote" n="21" target="#Rubrics-Ine_15.lnote.oe.21"/>, id est exercitu.<ptr type="liebermannNote" n="22" target="#Rubrics-Ine_15.lnote.oe.22"/></ab>
