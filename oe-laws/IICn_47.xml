        <note type="liebermannNote" subtype="textual" xml:id="IICn_47.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">344</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">spät übergeschr.</hi> [<hi rend="italic">vgl. Cons.</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">written above at a late date [cf. Cons.]</seg></note>
