        <dictScrap type="liebermann"><hi rend="bold">sear[o]</hi> <hi rend="bold">1</hi>) <hi rend="italic">Trug, listige Verdrehung; <ref type="abbreviation" target="gram:Dativ"><abbr>dt</abbr></ref> <ref type="abbreviation" target="gram:Instrumental"><abbr>instr</abbr></ref>. Sinnes:</hi> searw[a?] þ[æt] bewinde <hi rend="italic"><ref type="abbreviation" target="gram:oder"><abbr>oder</abbr></ref></hi> searw[e] að b- <ref type="lawCode" target="law:Northu">Northu</ref> 40 <hi rend="bold">2</hi>) <hi rend="italic"><ref type="abbreviation" target="gram:Plural"><abbr>pl</abbr></ref> <ref type="abbreviation" target="gram:accusativus"><abbr>ac</abbr></ref>:</hi> þurh searwa <hi rend="italic">durch Nachstellungen,</hi> per insidias <hi rend="italic"><ref type="abbreviation" target="gram:ubersetzend"><abbr>übsnd</abbr></ref>,</hi> <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 13; syrwa <ref type="lawCode" target="law:Ld">Ld</ref>; <hi rend="italic"><ref type="abbreviation" target="gram:ersetzt"><abbr>ersetzt</abbr></ref></hi> [<hi rend="italic">wie zu</hi> hlafords~] <hi rend="italic"><ref type="abbreviation" target="gram:durch"><abbr>durch</abbr></ref></hi> syrwunge <ref type="lawCode" target="law:H">H</ref>. — <hi rend="italic"><ref type="abbreviation" target="gram:Derivativ"><abbr>Der.</abbr></ref>:</hi> <ref type="entry" target="entry:hlafordsearo">hlafords~</ref>, <hi rend="italic"><ref type="abbreviation" target="gram:wofur"><abbr>wofür</abbr></ref></hi> hlafordswice <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:Rb">Rb</ref> 4 <ref type="lawCode" target="law:H">H</ref></dictScrap>
        <dictScrap type="senses">
