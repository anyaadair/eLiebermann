      <div type="clause" n="59.11">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.11</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.11" corresp="#wit-lat"><pb n="579" ed="#liebermann"/>Nullius contramandationem<ptr type="liebermannNote" n="6" target="#Hn_59-11.lnote.oe.6"/> neccesse est recipi<ptr type="liebermannNote" n="b" target="#Hn_59-11.lnote.oe.b"/>, si dominus placitat<ptr type="liebermannNote" n="7" target="#Hn_59-11.lnote.oe.7"/> contra suum<ptr type="liebermannNote" n="8" target="#Hn_59-11.lnote.oe.8"/> hominem de proprio<ptr type="liebermannNote" n="bb" target="#Hn_59-11.lnote.oe.bb"/> placito<ptr type="liebermannNote" n="9" target="#Hn_59-11.lnote.oe.9"/> suo, nisi<ptr type="liebermannNote" n="10" target="#Hn_59-11.lnote.oe.10"/> forte domini — si unum dominum<ptr type="liebermannNote" n="c" target="#Hn_59-11.lnote.oe.c"/> inde<ptr type="liebermannNote" n="11" target="#Hn_59-11.lnote.oe.11"/> habeant<ptr type="liebermannNote" n="12" target="#Hn_59-11.lnote.oe.12"/> — uel iusticie regis<ptr type="liebermannNote" n="13" target="#Hn_59-11.lnote.oe.13"/>, si placitum aliquo modo pertineat ei.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 579 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-11.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">umgekehrt</hi> dominus contra hominem respectare potest 33, 3</seg><seg type="translation" xml:lang="en" source="#claude">conversely, dominus contra hominem respectare potest 33, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-11.lnote.oe.bb" n="bb" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 46, 1&lt;sup&gt;<hi rend="italic">m</hi>&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude">cf. 46, 1&lt;sup&gt;<hi rend="italic">m</hi>&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-11.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wenn der Oberlehnsherr auch Oberherr über das zwischen Lehnsherr und Mann streitige Object ist</hi></seg><seg type="translation" xml:lang="en" source="#claude">if the overlord is also overlord of the object in dispute between lord and man</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-11.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de">cōmendaci. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">cōmendaci. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-11.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de">-tet <hi rend="italic">Co Or Sl Tw</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tet Co Or Sl Tw</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-11.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de">h. s. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. s. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-11.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de">s. p. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. p. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-11.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de">ubi <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">ubi K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-11.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-11.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de">-ent <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ent Lond</seg></note>
