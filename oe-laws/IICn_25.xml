        <note type="liebermannNote" subtype="textual" xml:id="IICn_25.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de">quidem q. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">quidem q. R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_25.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt RTHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in RTHk</seg></note>
