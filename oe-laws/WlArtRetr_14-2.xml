      <div type="clause" n="14.2">
        <head><ref type="lawCode" target="law:WlArtRetr">Wl art retr</ref> 14.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-lond"><pb n="491" ed="#liebermann"/>Et qui iuste uenire debent et uoluerint<ptr type="liebermannNote" n="38" target="#WlArtRetr_14-2.lnote.oe.38"/>, summoneantur<ptr type="liebermannNote" n="39" target="#WlArtRetr_14-2.lnote.oe.39"/> semel; et si secundo non uenerint<ptr type="liebermannNote" n="40" target="#WlArtRetr_14-2.lnote.oe.40"/>, accipiatur unus<ptr type="liebermannNote" n="41" target="#WlArtRetr_14-2.lnote.oe.41"/> bos; et si tertio, alius bos;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 491 (two independent readings of the page images, differences settled against the page); Liebermann’s print has ‘uoluerint’ (u for n; read ‘noluerint’); transcribed as printed; Robertson does not print this clause separately</note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_14-2.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">-runt <hi rend="italic">K2 Co Or Se</hi></seg><seg type="translation" xml:lang="en" source="#claude">-runt K2 Co Or Se</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_14-2.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">sumoniantur <hi rend="italic">Co Or;</hi> -niatur <hi rend="italic">K2;</hi> -neatur <hi rend="italic">Hg Se</hi></seg><seg type="translation" xml:lang="en" source="#claude">sumoniantur Co Or; -niatur K2; -neatur Hg Se</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_14-2.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">-rit <hi rend="italic">K2 Co Or;</hi> ueniunt <hi rend="italic">Se</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rit K2 Co Or; ueniunt Se</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_14-2.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">b. u. <hi rend="italic">K2 Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">b. u. K2 Co Or</seg></note>
