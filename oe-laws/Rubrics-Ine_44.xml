        <head>Ine Rb 44</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-e"><pb n="24" ed="#liebermann"/>LXXXVIII. Be<ptr type="liebermannNote" n="3" target="#Rubrics-Ine_44.lnote.oe.3"/> wuda onfenge butan leafe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-g-prol"><pb n="24" ed="#liebermann"/>LXXXVIII. Be wuda onfenge butan leafe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-h"><pb n="25" ed="#liebermann"/>LXXXVIII. Be wuda onfenge<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_44.lnote.oe.2"/> buton<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_44.lnote.oe.2"/> leafe.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="44" corresp="#wit-q"><pb n="25" ed="#liebermann"/>De<ptr type="liebermannNote" n="7" target="#Rubrics-Ine_44.lnote.oe.7"/> apprehenso<ptr type="liebermannNote" n="8" target="#Rubrics-Ine_44.lnote.oe.8"/> nemore sine licentia.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="210" ed="#jurasinski-and-oliver"/>LXXXVIII Be wuda onfenga butan leafe</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="210" ed="#jurasinski-and-oliver"/>Be wude andfenge</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="25" ed="#liebermann"/>Über Wegnahme von Waldholz ohne Erlaubniss.<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_44.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning the taking of timber without permission.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="211" ed="#jurasinski-and-oliver"/>Concerning taking wood without permission</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="211" ed="#jurasinski-and-oliver"/>Concerning taking wood</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_44.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">24</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">diese Rb. fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">this rubric lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_44.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">Qui lignum truncaverit [De ligno truncato <hi rend="italic">Br</hi>], sub quo XXX porci stare possint [possit <hi rend="italic">Hk</hi>] <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Qui lignum truncaverit [De ligno truncato Br], sub quo XXX porci stare possint [possit Hk] Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_44.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">n. a. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">n. a. T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_44.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_44.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Q spät. Rez. vervollständigt die Rb aus seinem Text</seg><seg type="translation" xml:lang="en" source="#claude">The later recension of Q completes the Rb from its own text</seg><note type="remark" resp="#claude">On several rubrics: Ine Rb 40. 43f. 46—50. 54. 56f. 58. 61f. 67. 70f.</note></note>
