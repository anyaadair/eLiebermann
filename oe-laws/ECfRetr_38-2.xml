      <div type="clause" n="38.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 38.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 38.2"><pb n="669" ed="#liebermann"/>Si quis <hi rend="bold">hominum</hi> aliter<ptr type="liebermannNote" n="1" target="#ECfRetr_38-2.lnote.la.1"/> <hi rend="spaced">emeret</hi><ptr type="liebermannNote" n="2" target="#ECfRetr_38-2.lnote.la.2"/>, quod stulte <hi rend="spaced">emisset</hi> <hi rend="bold">(cito</hi><ptr type="liebermannNote" n="3" target="#ECfRetr_38-2.lnote.la.3"/><hi rend="bold">)</hi> perdet<ptr type="liebermannNote" n="4" target="#ECfRetr_38-2.lnote.la.4"/>; et<ptr type="liebermannNote" n="5" target="#ECfRetr_38-2.lnote.la.5"/> forisfacturam! Postea <hi rend="spaced">inquisisset</hi> iusticia<ptr type="liebermannNote" n="6" target="#ECfRetr_38-2.lnote.la.6"/> per lagamannos<ptr type="liebermannNote" n="7" target="#ECfRetr_38-2.lnote.la.7"/> et per meliores homines de burgo uel <hi rend="bold">de</hi><ptr type="liebermannNote" n="8" target="#ECfRetr_38-2.lnote.la.8"/> uilla uel de<ptr type="liebermannNote" n="9" target="#ECfRetr_38-2.lnote.la.9"/> hundredo, ubi <hi rend="spaced">mansisset</hi> emtor <hi rend="bold">et</hi> de<ptr type="liebermannNote" n="10" target="#ECfRetr_38-2.lnote.la.10"/> quali uita <hi rend="spaced">fuisset</hi>, et si <hi rend="bold">unquam</hi> <hi rend="spaced">audissent</hi> eum calumniari de exlegalitate.</ab>
        <note type="comparison" source="#liebermann" n="669"><label>printed alongside</label> <ref target="clause:ECf_38-2">ECf 38.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 669 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-2.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">an den Kläger im Anefang; denn solcher Process, mit Voraussetzung, dass der Gegenstand nicht bloss in falscher Handelsform erworben, sondern von jemandem gestohlen war, konnte allein zum Reinigungseide und zur Friedloslegung des ausbleibenden Gewähren führen</hi></seg><seg type="translation" xml:lang="en" source="#claude">to the claimant in the vouching process (Anefang); for such a suit, presupposing that the object had not merely been acquired in an improper form of trade but had been stolen from someone, could only lead to an oath of purgation and to the outlawing of the warrantor who failed to appear</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-2.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier nur Leumundszeugen</hi></seg><seg type="translation" xml:lang="en" source="#claude">here only character witnesses</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-2.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">Gesetzwidrigkeit, <hi rend="italic">aus nordöstlichem Frankreich bezeugt von Ducange</hi></seg><seg type="translation" xml:lang="en" source="#claude">unlawfulness; attested from north-eastern France by Ducange</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-2.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">alter <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">alter Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-2.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">e. q. s. <hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. q. s. lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-2.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Lb Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Lb Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-2.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">perderet <hi rend="italic">Cb Lb Hv Ph Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">perderet Cb Lb Hv Ph Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-2.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">et f. <hi rend="italic">fehlt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">et f. lacking in Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-2.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv;</hi> -am <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv; -am Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-2.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">lagem. <hi rend="italic">Cb Lond;</hi> lakem. <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lagem. Cb Lond; lakem. Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-2.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-2.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Hv;</hi> -eto <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Hv; -eto Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-2.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">qualis uite <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">qualis uite Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">If any man bought otherwise, he shall (quickly) lose what he had foolishly bought; and [pay] the forfeiture! Afterwards the justice was to inquire through the lawmen and through the better men of the borough or of the village or of the hundred where the buyer had lived, and of what sort of life he had been, and whether they had ever heard him accused of lawlessness.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-2.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">350</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">de</hi><hi rend="superscript">8. 9</hi> fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">de</hi><hi rend="superscript">8. 9</hi> lacking Rs</seg></note>
      </div>
    </body>
  </text>
