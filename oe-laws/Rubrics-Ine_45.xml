        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="45" corresp="#wit-q"><pb n="25" ed="#liebermann"/>De burgi<ptr type="liebermannNote" n="9" target="#Rubrics-Ine_45.lnote.oe.9"/> fractura.</ab>
