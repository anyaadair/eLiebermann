    <body>
      <div type="clause" n="31.1a">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 31.1a</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="31.1a" corresp="#wit-g-a"><pb n="336" ed="#liebermann"/>⁊ gyf<ptr type="liebermannNote" n="1" target="#IICn_31-1a.lnote.oe.1-4"/> man þone<ptr type="liebermannNote" n="2" target="#IICn_31-1a.lnote.oe.2-4"/> hlaford teo, þ<hi rend="italic">æt</hi> he be his ræde ut hleope<ptr type="liebermannNote" n="3" target="#IICn_31-1a.lnote.oe.3-3"/>, ladige hine mid V þegnu<hi rend="italic">m</hi> ⁊ beo him sylf syxta.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="31.1a" corresp="#wit-b"><pb n="336" ed="#liebermann"/>⁊ gyf hi<ptr type="liebermannNote" n="1" target="#IICn_31-1a.lnote.oe.1-2"/> ðone laford teo, þ<hi rend="italic">æt</hi> he be his rǽde ut leope, ladige hine mid fíf ðegnu<hi rend="italic">m</hi> ⁊ beo hi<hi rend="italic">m</hi> syl[f<ptr type="liebermannNote" n="2" target="#IICn_31-1a.lnote.oe.2-2"/>] syxta.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="31.1a" corresp="#wit-a"><pb n="336" ed="#liebermann"/>And gyf man þonne<ptr type="liebermannNote" n="1" target="#IICn_31-1a.lnote.oe.1-5"/> hlaford teo, þ<hi rend="italic">æt</hi> he be his rede ut hleape<ptr type="liebermannNote" n="2" target="#IICn_31-1a.lnote.oe.2-5"/>, ladige hine mid fif þegnum ⁊ beo him sylf syxta.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="31.1a" corresp="#wit-q"><pb n="337" ed="#liebermann"/>Et<ptr type="liebermannNote" n="1" target="#IICn_31-1a.lnote.oe.1-3"/> si dominus accusetur, quod eius<ptr type="liebermannNote" n="2" target="#IICn_31-1a.lnote.oe.2-3"/> consilio (suo<ptr type="liebermannNote" n="3" target="#IICn_31-1a.lnote.oe.3-2"/>) fugerit<ptr type="liebermannNote" n="4" target="#IICn_31-1a.lnote.oe.4"/>, adlegiet se cum V táinis (id est nobilibus) et ipse<ptr type="liebermannNote" n="5" target="#IICn_31-1a.lnote.oe.5"/> (idem) sit sextus.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="31.1a" corresp="#wit-inst-cn"><pb n="337" ed="#liebermann"/>Et si ipse dominus calumniatus fuerit, quod eum sponte fugere permiserit, si ille est<ptr type="liebermannNote" n="1" target="#IICn_31-1a.lnote.oe.1-6"/> liberalis, id est þegen, acceptis quinque similibus purget se.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="31.1a" corresp="#wit-cons-cn"><pb n="337" ed="#liebermann"/>Si uero ipse dominus accusatus fuerit, illum suo consilio effugisse, purget se cum quinque suis paribus et ipse sit sextus.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="31a.1a" corresp="#wit-b"><pb n="192" ed="#robertson"/>⁊ gyf hi<ptr type="editorNote" n="7" target="#IICn_31-1a.robnote.fn.7"/> ðone laford teon<ptr type="editorNote" n="8" target="#IICn_31-1a.robnote.fn.8"/>, þæt he be his rǽde ut leope, ladige hine mid fif ðegnum ⁊ beo him sylf syxta.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="272" ed="#rabin-doml"/>And gyf man þone hlaford teo, þæt he be his ræde ut hleope, ladige hine mid V þegnum, and beo him sylf syxta.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="336" ed="#liebermann"/>, 1<hi rend="italic">a</hi>.<ptr type="liebermannNote" n="1" target="#IICn_31-1a.lnote.de.1"/> Und wenn der Herr beschuldigt wird, dass auf seinen Rath jener entflohen sei<ptr type="liebermannNote" n="2" target="#IICn_31-1a.lnote.de.2"/>, reinige er sich mit fünf Thegnas und sei selbst Sechster [im Eide].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if the lord is accused of the man having escaped on his advice, let him clear himself with five thegns and be himself the sixth [in the oath].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="193" ed="#robertson"/>And if the lord is accused of advising him to escape, he shall clear himself with [the help of] five thegns, himself making a sixth.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="467" ed="#whitelock"/>And if the lord is then accused, that it was by his advice that he ran away, he is to clear himself with five thegns, and be himself the sixth.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="273" ed="#rabin-doml"/>And if the lord is accused of advising him to escape, he must exonerate himself with the support of five thanes, and himself will make the sixth.</ab>
        <note type="comparison" source="#liebermann" n="336"><ref target="clause:IAtr_1-12">I Atr 1.12</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. I Atr. 1, 12</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_52-2">Leis Wl 52.2</ref></note>
        <note type="editorial">Liebermann compares I Atr 1.12.; BR: added from Gesetze I p. 337, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">man: hi B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-1a.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">d. i. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. i. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-1a.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">aufug. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">aufug. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-1a.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-1a.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auf Rasur;</hi> teo <hi rend="italic">später geändert</hi> teon</seg><seg type="translation" xml:lang="en" source="#claude">on an erasure; teo later altered to teon</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-1a.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de">f <hi rend="italic">im</hi> 16. <hi rend="italic">Jh. zugefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">f added in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-1a.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-1a.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so K Hn.</hi> 41, 6; c. s. <hi rend="italic">Dm R T</hi></seg><seg type="translation" xml:lang="en" source="#claude">so K Hn. 41, 6; c. s. Dm R T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-1a.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-1a.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">fugit <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">fugit K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-1a.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer K; eingeklammertes übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">the words before the bracket K; the bracketed words the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-1a.lnote.oe.1-4" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-1a.lnote.oe.2-4" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de">þonne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þonne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-1a.lnote.oe.3-3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de">hleape, hladide h. m. fif þ. be h. s. sixta <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hleape, hladide h. m. fif þ. be h. s. sixta Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-1a.lnote.oe.1-5" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 21</seg><seg type="translation" xml:lang="en" source="#claude">see above 21</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-1a.lnote.oe.2-5" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-1a.lnote.oe.1-6" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">l. e. <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">l. e. H</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_31-1a.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">207</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Nur in den Worten identisch mit <hi rend="italic">o</hi>. c. 30, 7, das aber vom Gefolgsmann handelt</seg><seg type="translation" xml:lang="en" source="#claude">Identical only in wording with <hi rend="italic">above</hi> c. 30, 7, which, however, deals with the retainer</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_31-1a.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">207</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘entspringt’ A.—Der Zusatz in Inst ist nur gefolgert aus dem Stande der Eideshelfer</seg><seg type="translation" xml:lang="en" source="#claude">‘escapes’ A. — The addition in Inst is merely inferred from the rank of the oath-helpers</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_31-1a.robnote.fn.7" n="7" source="#robertson"><bibl><biblScope unit="page">192</biblScope></bibl><label>hi</label><seg type="original" xml:lang="en"><hi rend="italic">man</hi> G, A, Ld; <hi rend="italic">hi</hi> written on an erasure in B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_31-1a.robnote.fn.8" n="8" source="#robertson"><bibl><biblScope unit="page">192</biblScope></bibl><label>teon</label><seg type="original" xml:lang="en"><hi rend="italic">n</hi> added later to earlier <hi rend="italic">teo</hi> in B.</seg></note>
