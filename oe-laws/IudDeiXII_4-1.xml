      <div type="clause" n="4.1">
        <head><ref type="lawCode" target="law:IudDeiXII">Iud Dei XII</ref> 4.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XII 4.1" corresp="#wit-lat"><pb n="420" ed="#liebermann"/>Interdico tam<ptr type="liebermannNote" n="22" target="#IudDeiXII_4-1.lnote.oe.22"/> tibi<ptr type="liebermannNote" n="23" target="#IudDeiXII_4-1.lnote.oe.23"/> quam et omnibus astantibus, o homo, per Patrem et Filium et Spiritum sanctum et<ptr type="liebermannNote" n="24" target="#IudDeiXII_4-1.lnote.oe.24"/> per tremendum diem iuditii, per ministerium<ptr type="liebermannNote" n="25" target="#IudDeiXII_4-1.lnote.oe.25"/> baptismatis, per uenerationem omnium sanctorum,</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 420 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_4-1.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de">tam <hi rend="italic">und</hi> quam et <hi rend="italic">roth ausgestrichen, über letzterem</hi> coram <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">tam and quam et struck through in red, coram written above the latter Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_4-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de">uobis <hi rend="italic">roth übergeschr., und so Plural öfter Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">uobis written above in red, and so the plural frequently Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_4-1.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_4-1.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so hier und</hi> 650 <hi rend="italic">Zeu., besser</hi> 704 mysterium</seg><seg type="translation" xml:lang="en" source="#claude">so here and 650 Zeu., better 704 mysterium</seg></note>
      </div>
