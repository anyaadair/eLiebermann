      <div type="clause" n="70.14a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 70.14a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 70.14a" corresp="#wit-lat"><pb n="589" ed="#liebermann"/>Si<ptr type="liebermannNote" n="g" target="#Hn_70-14a.lnote.oe.g"/> nondum uiuus sit, dimidia wera soluatur parentibus ex parte patris<ptr type="liebermannNote" n="d" target="#Hn_70-14a.lnote.oe.d"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 589 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-14a.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Wergeld der Frau folgt dem ihres Vaters</hi> (<hi rend="italic">nicht ihres Mannes</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">The woman’s wergild follows that of her father (not that of her husband)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-14a.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">noch ohne diese kirchliche Unterscheidung der Beseelung</hi> (<hi rend="italic">vgl.</hi> 70, 16<hi rend="italic">b</hi>) <hi rend="italic">hat Af</hi> 9: partus dimidio</seg><seg type="translation" xml:lang="en" source="#claude">Af 9, still without this ecclesiastical distinction of ensoulment (cf. 70, 16<hi rend="italic">b</hi>), has: partus dimidio</seg></note>
      </div>
    </body>
