    <body>
      <div type="clause" n="34.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 34.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 34.2"><pb n="662" ed="#liebermann"/>Eadwardus<ptr type="liebermannNote" n="21" target="#ECfRetr_34-2.lnote.la.21"/> <hi rend="bold">enim,</hi> filius eius <hi rend="bold">heres</hi><ptr type="liebermannNote" n="22" target="#ECfRetr_34-2.lnote.la.22"/><hi rend="bold">, scilicet</hi> de<ptr type="liebermannNote" n="23" target="#ECfRetr_34-2.lnote.la.23"/> uxore <hi rend="bold">legitima</hi> natus, regnauit<ptr type="liebermannNote" n="24" target="#ECfRetr_34-2.lnote.la.24"/> annis quatuor*, ebdomadibus<ptr type="liebermannNote" n="25" target="#ECfRetr_34-2.lnote.la.25"/> sexdecim minus. Quo occiso innocente sue dolo nouerce, propter innocentem uitam <hi rend="bold">eius,</hi> castam et elemosinis plenam, interfectionem<ptr type="liebermannNote" n="26" target="#ECfRetr_34-2.lnote.la.26"/> eius <hi rend="bold">immeritam</hi> pro martyrio reputauerunt<ptr type="liebermannNote" n="27" target="#ECfRetr_34-2.lnote.la.27"/> ei et sanctum <hi rend="bold">habuerunt.</hi></ab>
        <note type="comparison" source="#liebermann" n="662"><label>printed alongside</label> <ref target="clause:ECf_34-2">ECf 34.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 662 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">Liebermann prints a small raised asterisk after “quatuor” (not one of his starred notes) and gives in the outer margin of the ECf retr column the dates 975–78.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECfRetr_34-2.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielmehr</hi> III</seg><seg type="translation" xml:lang="en" source="#claude">rather III</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECfRetr_34-2.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">d. n. s. <hi rend="italic">vielleicht aus Will. Malm.</hi> Reg. II 162</seg><seg type="translation" xml:lang="en" source="#claude">d. n. s. perhaps from Will. Malm., Reg. II 162</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECfRetr_34-2.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">die gläubigen Engländer trennt der also wohl fremde Verf. von sich</hi></seg><seg type="translation" xml:lang="en" source="#claude">the author, who is thus probably a foreigner, separates the believing English from himself</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">Ed. <hi rend="italic">stets Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ed. always Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">herilis <hi rend="italic">Cb Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">herilis Cb Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">na. de l. u. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">na. de l. u. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">regnum tenuit <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">regnum tenuit Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">ebdomadis <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">ebdomadis Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">-nis <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nis Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">ei comput. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei comput. Cb</seg></note>
      </div>
