      <div type="clause" n="30.4b">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 30.4b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 30.4b"><pb n="653" ed="#liebermann"/>Quamobrem potest conici<ptr type="liebermannNote" n="14" target="#ECfRetr_30-4b.lnote.la.14"/>, quod hac<ptr type="liebermannNote" n="1" target="#ECfRetr_30-4b.lnote.la.1"/> de<ptr type="liebermannNote" n="15" target="#ECfRetr_30-4b.lnote.la.15"/> causa totus ille<ptr type="liebermannNote" n="16" target="#ECfRetr_30-4b.lnote.la.16"/> conuentus dicitur wapentac, eo<ptr type="liebermannNote" n="1" target="#ECfRetr_30-4b.lnote.la.1"/> quod per tactum<ptr type="liebermannNote" n="17" target="#ECfRetr_30-4b.lnote.la.17"/> armorum suorum ad<ptr type="liebermannNote" n="18" target="#ECfRetr_30-4b.lnote.la.18"/> inuicem confederati sunt<ptr type="liebermannNote" n="19" target="#ECfRetr_30-4b.lnote.la.19"/>.</ab>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 653 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann prints 30, 4a and 30, 4b, which ECf lacks, in the larger type of the ECf column.</note>
        <note type="editorial">There is no note 13 in the ECf retr column of this page: Liebermann’s numbering goes from 12 to 14.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-4b.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-4b.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">coñici <hi rend="italic">Lb;</hi> coniici <hi rend="italic">Va;</hi> cognosci <hi rend="italic">Lond Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">coñici Lb; coniici Va; cognosci Lond Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-4b.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-4b.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">c. i. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. i. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-4b.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">-tus <hi rend="italic">Hv;</hi> conta. (<hi rend="italic">geänd. aus</hi> tactum <hi rend="italic">Cb</hi>) <hi rend="italic">Cb Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tus Hv; conta. (altered from tactum Cb) Cb Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-4b.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">conf. s. ad inu. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">conf. s. ad inu. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-4b.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">sint <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">sint Cb</seg></note>
      </div>
