      <div type="clause" n="34.1">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 34.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="34.1" corresp="#wit-e"><pb n="104" ed="#liebermann"/>Gif his wergield<ptr type="liebermannNote" n="1" target="#Ine_34-1.lnote.oe.1-4"/> sie CC scill., gebete mid L<ptr type="liebermannNote" n="2" target="#Ine_34-1.lnote.oe.2-3"/> scill., ⁊ ðy<ptr type="liebermannNote" n="3" target="#Ine_34-1.lnote.oe.3-3"/> ilcan ryhte do man be ðam<ptr type="liebermannNote" n="4" target="#Ine_34-1.lnote.oe.4-3"/> deorborenran.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="34.1" corresp="#wit-h"><pb n="104" ed="#liebermann"/>Gif his wergild sy<ptr type="liebermannNote" n="1" target="#Ine_34-1.lnote.oe.1-3"/> CC scll', gebete mid L scll', ⁊ þa<ptr type="liebermannNote" n="2" target="#Ine_34-1.lnote.oe.2-2"/> ilcan<ptr type="liebermannNote" n="3" target="#Ine_34-1.lnote.oe.3-2"/> ryhte do mon<ptr type="liebermannNote" n="4" target="#Ine_34-1.lnote.oe.4-2"/> be ðam diorborenran.<ptr type="liebermannNote" n="5" target="#Ine_34-1.lnote.oe.5-2"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="34.1" corresp="#wit-b-no-prol"><pb n="104" ed="#liebermann"/>Gyf his<ptr type="liebermannNote" n="1" target="#Ine_34-1.lnote.oe.1"/> wergyld sy twa hund scill', gebete mid fiftig scill', ⁊ ða ilcan rihte dó man be ðam deorborenran.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="34.1" corresp="#wit-q"><pb n="105" ed="#liebermann"/>Si eius<ptr type="liebermannNote" n="1" target="#Ine_34-1.lnote.oe.1-2"/> weregildum sit<ptr type="liebermannNote" n="2" target="#Ine_34-1.lnote.oe.2"/> CC<ptr type="liebermannNote" n="3" target="#Ine_34-1.lnote.oe.3"/> solidorum, emendet<ptr type="liebermannNote" n="4" target="#Ine_34-1.lnote.oe.4"/> L sol., et idem rectum fiat de<ptr type="liebermannNote" n="5" target="#Ine_34-1.lnote.oe.5"/> carius genitis.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="46" ed="#attenborough"/>Gif his wergield sie CC scill., gebete mid L scill., ⁊ ðy<ptr type="editorNote" n="16" target="#Ine_34-1.attnote.fn.16"/> ilcan ryhte do man be ðam deorborenran.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="34.1" corresp="#wit-e"><pb n="400" ed="#jurasinski-and-oliver"/>Gif his wergield sie CC sciƚƚ, gebete mid L sciƚƚ, ⁊ ðy ilcan ryhte do man be ðæm deorborenran.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="105" ed="#liebermann"/>wenn dessen Wergeld 200 Schill. ist, büsse er [sie] mit 50 Schill.<ptr type="liebermannNote" n="1" target="#Ine_34-1.lnote.de.1"/>, und mit<ptr type="liebermannNote" n="2" target="#Ine_34-1.lnote.de.2"/> demselben Rechtsmasse verfahre man bei dem adligeren<ptr type="liebermannNote" n="3" target="#Ine_34-1.lnote.de.3"/> [Erschlagenen].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">if his wergeld is 200 shillings, let him pay [for it] with 50 shillings, and let the same measure of law be applied in the case of a [slain man] of nobler birth.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="47" ed="#attenborough"/>If his [the slain man's] wergeld is 200 shillings, he must pay 50 shillings compensation; and in the case of a man of nobler birth the proportion [between the compensation and the wergeld] shall be the same.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="403" ed="#whitelock"/>If his wergild is 200 shillings, he is to pay 50 shillings compensation; and one is to proceed with the same proportion in the case of the nobler born.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="401" ed="#jurasinski-and-oliver"/>If his wergild is 200 shillings, let him compensate with 50 shillings and the same law applies to someone nobly born.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_34-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">s <hi rend="italic">später auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">s later on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_34-1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">105</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> w. e. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Lond; w. e. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_34-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">105</biblScope></bibl><seg type="original" xml:lang="de">est <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">est MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_34-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">105</biblScope></bibl><seg type="original" xml:lang="de">C <hi rend="italic">Lond, verbessert</hi> CC <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">C Lond, corrected to CC Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_34-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">105</biblScope></bibl><seg type="original" xml:lang="de">cum <hi rend="italic">fügt zu Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">cum added by Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_34-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">105</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt KT</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in KT</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_34-1.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_34-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">a <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">a on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_34-1.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">i <hi rend="italic">geänd. in</hi> y</seg><seg type="translation" xml:lang="en" source="#claude">i altered to y</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_34-1.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_34-1.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> deorb.</seg><seg type="translation" xml:lang="en" source="#claude">altered to deorb.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_34-1.lnote.oe.1-4" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">-gylde sy twa hund <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gylde sy twa hund Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_34-1.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">fiftig <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fiftig Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_34-1.lnote.oe.3-3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">ða yl. riht <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ða yl. riht Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_34-1.lnote.oe.4-3" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">ðem <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðem Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_34-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">74</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">quartam partem compositionis</hi> versteht Hn 87, 8 richtig. Anders Af 29</seg><seg type="translation" xml:lang="en" source="#claude">Hn 87, 8 rightly understands it as <hi rend="italic">quartam partem compositionis</hi>. Af 29 is different</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_34-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">74</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Hcor. B. Q modernisieren: ‘dieselben Rechtsvorschriften übe’, da Instrum. erstarb; <hi rend="italic">rihte</hi> als Plural ist für spätere Sprache möglich</seg><seg type="translation" xml:lang="en" source="#claude">Hcor. B. Q modernise: ‘let him practise the same legal rules’, since the instrumental had died out; <hi rend="italic">rihte</hi> as a plural is possible in the later language</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_34-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">74</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Wergeld 4. a; Stand 5. 11</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Wergeld 4. a; Stand 5. 11</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_34-1.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">46</biblScope></bibl><label>ðy</label><seg type="original" xml:lang="en"><hi rend="italic">ða</hi>. H &amp; B.</seg></note>
      </div>
