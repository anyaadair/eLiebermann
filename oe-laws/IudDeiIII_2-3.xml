      <div type="clause" n="2.3">
        <head><ref type="lawCode" target="law:IudDeiIII">Iud Dei III</ref> 2.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei III 2.3" corresp="#wit-lat"><pb n="408" ed="#liebermann"/>sed qui reus<ptr type="liebermannNote" n="48" target="#IudDeiIII_2-3.lnote.oe.48"/> et conscius<ptr type="liebermannNote" n="49" target="#IudDeiIII_2-3.lnote.oe.49"/> est rei praefatae, ad<ptr type="liebermannNote" n="50" target="#IudDeiIII_2-3.lnote.oe.50"/> hoc pabulum<ptr type="liebermannNote" n="51" target="#IudDeiIII_2-3.lnote.oe.51"/> sanctificati panis uel casei, et presertim per dominici corporis et sanguinis communionem, quam accepit<ptr type="liebermannNote" n="52" target="#IudDeiIII_2-3.lnote.oe.52"/>, tremat et tremendo<ptr type="liebermannNote" n="53" target="#IudDeiIII_2-3.lnote.oe.53"/> palleat<ptr type="liebermannNote" n="54" target="#IudDeiIII_2-3.lnote.oe.54"/>, et nutabundus<ptr type="liebermannNote" n="55" target="#IudDeiIII_2-3.lnote.oe.55"/> in omnibus membris appareat<ptr type="liebermannNote" n="54" target="#IudDeiIII_2-3.lnote.oe.54"/>;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 408 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-3.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">-i <hi rend="italic">übergeschr. Rj H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-i written above in Rj H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-3.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">-i sunt <hi rend="italic">übergeschr. Rj H;</hi> uel — ae sunt <hi rend="italic">übergeschr. Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">-i sunt written above in Rj H; uel — ae sunt written above in Vt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-3.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">ad hoc <hi rend="italic">fehlt Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad hoc omitted in Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-3.lnote.oe.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">parabolum <hi rend="italic">Ch Ca Par</hi></seg><seg type="translation" xml:lang="en" source="#claude">parabolum Ch Ca Par</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-3.lnote.oe.52" n="52" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">-erunt -n <hi rend="italic">übergeschr. Rj H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-erunt -n written above in Rj H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-3.lnote.oe.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">si caseum hunc gustauerit, tremulet <hi rend="italic">Zeu.</hi> 643; palleat, tremiscat 646; contremiscat 681</seg><seg type="translation" xml:lang="en" source="#claude">si caseum hunc gustauerit, tremulet Zeu. 643; palleat, tremiscat 646; contremiscat 681</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-3.lnote.oe.54" n="54" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">-n <hi rend="italic">übergeschr. Rj H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-n written above in Rj H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-3.lnote.oe.55" n="55" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">mut. <hi rend="italic">Ch Par;</hi> -i <hi rend="italic">übergeschr. Rj H</hi></seg><seg type="translation" xml:lang="en" source="#claude">mut. Ch Par; -i written above in Rj H</seg></note>
      </div>
