    <body>
      <div type="clause" n="12.3">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 12.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 12.3"><pb n="638" ed="#liebermann"/>qui scienter fregerit eam<ptr type="liebermannNote" n="17" target="#ECf_12-3.lnote.la.17"/>: X<ptr type="liebermannNote" n="18" target="#ECf_12-3.lnote.la.18"/> et VIII<ptr type="liebermannNote" n="h" target="#ECf_12-3.lnote.la.fn.h"/> hundreta<ptr type="liebermannNote" n="a" target="#ECf_12-3.lnote.oe.erkl-a"/> in<ptr type="liebermannNote" n="19" target="#ECf_12-3.lnote.la.19"/> Denelaga<ptr type="liebermannNote" n="20" target="#ECf_12-3.lnote.la.20"/>, et corpus suum in misericordia<ptr type="liebermannNote" n="21" target="#ECf_12-3.lnote.la.21"/> regis; lege<ptr type="liebermannNote" n="22" target="#ECf_12-3.lnote.la.22"/> Anglorum suum<ptr type="liebermannNote" n="23" target="#ECf_12-3.lnote.la.23"/> were, id est pretium suum. Et manbote de occisis erga dominos, quorum homines erant<ptr type="liebermannNote" n="24" target="#ECf_12-3.lnote.la.24"/> interfecti.</ab>
        <note type="comparison" source="#liebermann" n="638"><label>printed alongside</label> <ref target="clause:ECfRetr_12-3">ECf retr 12.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 638 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-3.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">18 × 8 £ = 144 £; <hi rend="italic">wie Leis Wl</hi> 2, 2; <hi rend="italic">vgl. jedoch unten</hi></seg><seg type="translation" xml:lang="en" source="#claude">18 × £8 = £144; as Leis Wl 2, 2; but cf. below</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-3.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-3.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">scd’ XII <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">scd’ XII Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-3.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">etiam <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">etiam Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-3.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">-gha <hi rend="italic">Rl;</hi> -lahge <hi rend="italic">Hk;</hi> Dan. <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gha Rl; -lahge Hk; Dan. Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-3.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">-diam <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-diam Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-3.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">autem <hi rend="italic">fügt zu Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hr adds autem</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-3.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">suorum <hi rend="italic">Rl Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">suorum Rl Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-3.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">i. e. <hi rend="italic">S; fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. e. S; lacking in Hr</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">whoever knowingly breaks it: ten and eight hundreds in the Danelaw, and his body in the king's mercy; by the law of the English, his wergild (<hi rend="italic">were</hi>), that is, his price. And manbot for those slain, to the lords whose men had been killed.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-3.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">345</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> hundert 6 [in Denalagu wird sehr oft ein Manor bewertet zu 8 oder 4 ₤; Round <hi rend="italic">Feudal Engl.</hi> 72; Stenton <hi rend="italic">Manor in Danelaw</hi> 33]; Misericordia 6. 9c; Stand 21c. d; Wergeld 30; Mannbusse 1. 6</seg><seg type="translation" xml:lang="en" source="#claude">Cf. Gl hundert 6 [in the Danelaw a manor is very often valued at 8 or 4 ₤; Round <hi rend="italic">Feudal Engl.</hi> 72; Stenton <hi rend="italic">Manor in Danelaw</hi> 33]; Misericordia 6. 9c; Stand 21c. d; Wergeld 30; Mannbusse 1. 6</seg></note>
      </div>
    </body>
