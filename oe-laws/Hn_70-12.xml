      <div type="clause" n="70.12">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 70.12</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 70.12" corresp="#wit-lat"><pb n="588" ed="#liebermann"/>Si<ptr type="liebermannNote" n="38" target="#Hn_70-12.lnote.oe.38"/> mulier homicidium faciat, in eam<ptr type="liebermannNote" n="v" target="#Hn_70-12.lnote.oe.v"/> uel in progeniem uel parentes<ptr type="liebermannNote" n="w" target="#Hn_70-12.lnote.oe.w"/> eius uindicetur<ptr type="liebermannNote" n="39" target="#Hn_70-12.lnote.oe.39"/> — uel inde componat —, non in uirum suum uel<ptr type="liebermannNote" n="40" target="#Hn_70-12.lnote.oe.40"/> clientelam<ptr type="liebermannNote" n="x" target="#Hn_70-12.lnote.oe.x"/> innocentem.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 588 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-12.lnote.oe.v" n="v" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Blutsverwandtenkreis der auswärts verheiratheten Frau büsst also deren Schuld, wie</hi> Wif 7 <hi rend="italic">und im Norden; solche Entlastung der Sippe des Ehemannes scheint zu weitgehend Vinogradoff</hi> Zeitschr. f. Socialgesch. 7 (1900) 36</seg><seg type="translation" xml:lang="en" source="#claude">The blood-kindred of a woman married outside it thus pays compensation for her guilt, as in Wif 7 and in the North; such relief of the husband’s kindred seems to Vinogradoff to go too far, Zeitschr. f. Socialgesch. 7 (1900) 36</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-12.lnote.oe.w" n="w" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">angeborene Sippe</seg><seg type="translation" xml:lang="en" source="#claude">kindred by birth</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-12.lnote.oe.x" n="x" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 88, 9<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 88, 9<hi rend="italic">b</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-12.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">Similiter <hi rend="italic">statt</hi> Si m. <hi rend="italic">Lond</hi>; Simil. si m. <hi rend="italic">falsch Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">Similiter instead of Si m. Lond; Simil. si m. wrongly Wi Tho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-12.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">-cet <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cet Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-12.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">set <hi rend="italic">Sc Hg</hi>; seu <hi rend="italic">gegen Hss. Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">set Sc Hg; seu against the MSS Wi Tho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-12.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Sippe 10; Blutrache 5f.—<hi rend="italic">Similiter</hi>{38} <hi rend="italic">ho</hi>. Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Sippe 10; Blutrache 5f.—<hi rend="italic">Similiter</hi>{38} <hi rend="italic">ho</hi>. Rs</seg></note>
      </div>
