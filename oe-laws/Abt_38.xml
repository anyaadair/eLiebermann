    <body>
      <div type="clause" n="38">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 38</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="38" corresp="#wit-h"><pb n="5" ed="#liebermann"/>Gif eaxle gelæmed weorþeð, XXX scill' gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-h"><pb n="8" ed="#attenborough"/>Gif eaxle gelæmed weorþeð, XXX scill' gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="37" corresp="#wit-h"><pb n="70" ed="#oliver"/>Gif eaxle gelæmed weorþeð, XXX sciƚƚ gebete.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="5" ed="#liebermann"/>Wenn die Achsel gelähmt<ptr type="liebermannNote" n="1" target="#Abt_38.lnote.de.1"/> wird, büsse er 30 Schill.<ptr type="liebermannNote" n="2" target="#Abt_38.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the shoulder is lamed, let him pay 30 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="9" ed="#attenborough"/>If a shoulder is disabled, 30 shillings shall be paid as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h"><pb n="71" ed="#oliver"/>If a shoulder becomes lamed, let him pay [with] 30 shillings.</ab>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_38.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">10</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd.</hi> 8 G; Wilda 747</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid.</hi> 8 G; Wilda 747</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_38.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">10</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">scillingum</hi> war Editionsfehler Früherer</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">scillingum</hi> was an error made by earlier editors</seg></note>
      </div>
    </body>
