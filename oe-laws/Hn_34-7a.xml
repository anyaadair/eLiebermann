      <div type="clause" n="34.7a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 34.7a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 34.7a" corresp="#wit-lat"><pb n="566" ed="#liebermann"/>Cum autem<ptr type="liebermannNote" n="8" target="#Hn_34-7a.lnote.oe.8"/> hoc ubique notandum<ptr type="liebermannNote" n="g" target="#Hn_34-7a.lnote.oe.g"/> sit, in domino<ptr type="liebermannNote" n="f" target="#Hn_34-7a.lnote.oe.f"/> et magistro maxime detestandum erit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 566 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-7a.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 59, 13</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 59, 13</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-7a.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">zu tadeln ist, [<hi rend="italic">bei Verleumdung</hi>] gegen Herrn</seg><seg type="translation" xml:lang="en" source="#claude">is to be censured, [<hi rend="italic">in the case of slander</hi>] against a lord</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-7a.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">h. a. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. a. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-7a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Vassallität 16a; Verleumdung 3. a.—34, 8 <hi rend="italic">extiterit</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Vassallität 16a; Verleumdung 3. a.—34, 8 <hi rend="italic">extiterit</hi> Rs</seg></note>
