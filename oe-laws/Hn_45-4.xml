        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 45.4" corresp="#wit-lat"><pb n="570" ed="#liebermann"/>Et de<ptr type="liebermannNote" n="i" target="#Hn_45-4.lnote.oe.i"/> nemore inoperato per<ptr type="liebermannNote" n="16" target="#Hn_45-4.lnote.oe.16"/> tihlam<ptr type="liebermannNote" n="17" target="#Hn_45-4.lnote.oe.17"/> nemo respondeat, nisi sit ibi captus uel sit homo eius cuius est nemus.</ab>
