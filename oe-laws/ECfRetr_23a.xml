    <body>
      <div type="clause" n="23a">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 23a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 23a"><pb n="648" ed="#liebermann"/><hi rend="bold">Ueruntamen</hi> si cui <hi rend="bold">damnum illatum</hi><ptr type="liebermannNote" n="30" target="#ECfRetr_23a.lnote.la.30"/> <hi rend="bold">fuerit, (et</hi><ptr type="liebermannNote" n="31" target="#ECfRetr_23a.lnote.la.31"/><hi rend="bold">)</hi> ad iusticiam de eo clamorem fecerit, quod <hi rend="bold">ipsius</hi> consilio <hi rend="bold">malum</hi> factum<ptr type="liebermannNote" n="32" target="#ECfRetr_23a.lnote.la.32"/> <hi rend="bold">fuerit,</hi> cum<ptr type="liebermannNote" n="33" target="#ECfRetr_23a.lnote.la.33"/> duobus legalibus uicinis suis<ptr type="liebermannNote" n="13" target="#ECfRetr_23a.lnote.la.13"/> purgabit se sacramento de consilio et facto.</ab>
        <note type="comparison" source="#liebermann" n="648"><label>printed alongside</label> <ref target="clause:ECf_23a">ECf 23a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 648 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_23a.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">f. i. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. i. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_23a.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. Cb; fehlt</hi> [<hi rend="italic">ursprünglicher</hi>] <hi rend="italic">Lb Ph Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above Cb; lacking [more original] Lb Ph Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_23a.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">non <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds non</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_23a.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_23a.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
      </div>
    </body>
