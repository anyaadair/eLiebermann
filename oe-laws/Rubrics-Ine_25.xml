      <div type="clause" n="25">
        <head>Ine Rb 25</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="25" corresp="#wit-e"><pb n="22" ed="#liebermann"/>LXVIIII. Be ciepemonna<ptr type="liebermannNote" n="4" target="#Rubrics-Ine_25.lnote.oe.4"/> fore uppe on londe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="25" corresp="#wit-g-prol"><pb n="22" ed="#liebermann"/>LXVIIII. Be cypmanna fóre úp on land.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="25" corresp="#wit-h"><pb n="23" ed="#liebermann"/>LXVIIII. Be cypemonna<ptr type="liebermannNote" n="7" target="#Rubrics-Ine_25.lnote.oe.7"/> fóre<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_25.lnote.oe.2"/> upp on<ptr type="liebermannNote" n="8" target="#Rubrics-Ine_25.lnote.oe.8"/> lond stryne.<ptr type="liebermannNote" n="9" target="#Rubrics-Ine_25.lnote.oe.9-2"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="25" corresp="#wit-q"><pb n="23" ed="#liebermann"/>De mercatoribus patriantibus.<ptr type="liebermannNote" n="9" target="#Rubrics-Ine_25.lnote.oe.9"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="204" ed="#jurasinski-and-oliver"/>LXVIIII Be ciepemonna fore uppe on londe</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="204" ed="#jurasinski-and-oliver"/>Be cypmanna fare uppe land</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="23" ed="#liebermann"/>Über das Reisen<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_25.lnote.de.1"/> von Kaufleuten aufwärts im Lande.<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_25.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning the travelling of merchants up-country.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="205" ed="#jurasinski-and-oliver"/>Concerning merchants’ traveling in the countryside</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="205" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_25.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de">cypmanna on lande <hi rend="italic">ohne</hi> f. u. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cypmanna on lande without f. u. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_25.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">aliquid ementibus <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">aliquid ementibus Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_25.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> -manna</seg><seg type="translation" xml:lang="en" source="#claude">altered -manna</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_25.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_25.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">n <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">n on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_25.lnote.oe.9-2" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">st <hi rend="italic">auf Rasur; irrig vom Zeilenende der Rubrik</hi> LXXI <hi rend="italic">vorweggenommen</hi></seg><seg type="translation" xml:lang="en" source="#claude">st on an erasure; anticipated in error from the end of the line of rubric LXXI</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_25.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Das aus 27 verschobene <hi rend="italic">stryne</hi> in H erklärte sich ein Abschreiber vielleicht als gleich <hi rend="italic">strene</hi> ‘aus Gewinn[sucht]’</seg><seg type="translation" xml:lang="en" source="#claude">The <hi rend="italic">stryne</hi> in H, displaced from 27, was perhaps understood by a copyist as equivalent to <hi rend="italic">strene</hi>, ‘out of [desire for] gain’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_25.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">G H Q lesen Acc.: ‘ins (aufs) Land’</seg><seg type="translation" xml:lang="en" source="#claude">G H Q read the acc.: ‘into (on to) the land’</seg></note>
      </div>
