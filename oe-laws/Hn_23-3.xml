      <div type="clause" n="23.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 23.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 23.3" corresp="#wit-lat"><pb n="561" ed="#liebermann"/>Idem<ptr type="liebermannNote" n="35" target="#Hn_23-3.lnote.oe.35"/> dicimus<ptr type="liebermannNote" n="k" target="#Hn_23-3.lnote.oe.k"/> de commissis monacho, monache, sponse, pueris, seruo, ancille sine<ptr type="liebermannNote" n="36" target="#Hn_23-3.lnote.oe.36"/> legittima prelatorum<ptr type="liebermannNote" n="l" target="#Hn_23-3.lnote.oe.l"/> suorum<ptr type="liebermannNote" n="37" target="#Hn_23-3.lnote.oe.37"/> licencia.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 561 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_23-3.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">561</biblScope></bibl><seg type="original" xml:lang="de">so Anvertrautes ist nicht einklagbar, <hi rend="italic">wie</hi> 45, 2 <hi rend="italic">f. ausführt</hi></seg><seg type="translation" xml:lang="en" source="#claude">things so entrusted cannot be sued for, as 45, 2 f. explains</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_23-3.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">561</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">gemäss reiferer Kanonistik ändert auch</hi> Inst. Cn., <hi rend="italic">o. S.</hi> 61 <hi rend="italic">Ælfreds</hi> Herrn des Mönches <hi rend="italic">in</hi> prælatus</seg><seg type="translation" xml:lang="en" source="#claude">in accordance with more developed canon law, Inst. Cn. too, <hi rend="italic">above</hi> p. 61, alters Ælfred’s lord of the monk into prælatus</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_23-3.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">561</biblScope></bibl><seg type="original" xml:lang="de">Deinde decimus <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Deinde decimus Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_23-3.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">561</biblScope></bibl><seg type="original" xml:lang="de">siue <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">siue Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_23-3.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">561</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_23-3.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Anvertrautes 4; mündig 13.—{35}<hi rend="italic">dec</hi>.—23, 4 <hi rend="italic">-int</hi>{30} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Anvertrautes 4; mündig 13.—{35}<hi rend="italic">dec</hi>.—23, 4 <hi rend="italic">-int</hi>{30} Rs</seg></note>
      </div>
