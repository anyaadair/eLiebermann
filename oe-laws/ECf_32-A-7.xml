    <body>
      <div type="clause" n="32 A 7">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 32 A 7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 32 A 7"><pb n="655" ed="#liebermann"/>Hanc legem inuenit Arturus<ptr type="liebermannNote" n="17" target="#ECf_32-A-7.lnote.la.17"/>, qui<ptr type="liebermannNote" n="m" target="#ECf_32-A-7.lnote.la.fn.m"/> quondam fuit inclitissimus rex Britonum<ptr type="liebermannNote" n="1" target="#ECf_32-A-7.lnote.la.1"/>, et ita consolidauit et confederauit regnum Britannie<ptr type="liebermannNote" n="1" target="#ECf_32-A-7.lnote.la.1"/> uniuersum semper in unum; huius legis<ptr type="liebermannNote" n="n" target="#ECf_32-A-7.lnote.la.fn.n"/> auctoritate expulit Arturus<ptr type="liebermannNote" n="17" target="#ECf_32-A-7.lnote.la.17"/> predictus Saracenos<ptr type="liebermannNote" n="o" target="#ECf_32-A-7.lnote.la.fn.o"/> et inimicos a regno.</ab>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 655 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">This passage is not part of ECf or ECf retr: it is one of the additions of the London collection (Leges Anglorum s. XIII in. Londoniis collectae), which Liebermann prints in smaller type across the page as an insertion into ECf retr. 32 (32 A–E, pp. 655–660). The dictionary cites it as “ECf 32 A …”, so it is kept with ECf here.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_32-A-7.lnote.la.fn.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">den Namen schöpft der Londoner aus</hi> Galfr. v. Monmouth, <hi rend="italic">den er</hi> 32 D <hi rend="italic">abschreibt</hi></seg><seg type="translation" xml:lang="en" source="#claude">the Londoner takes the name from Geoffrey of Monmouth, whom he copies at 32 D</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_32-A-7.lnote.la.fn.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dieselbe Phrase zu anderer Fabel u.</hi> 32 A 14</seg><seg type="translation" xml:lang="en" source="#claude">the same phrase for another fable below, 32 A 14</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_32-A-7.lnote.la.fn.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de">Saracenen <hi rend="italic">nennt Franz. Literatur um</hi> 1200 <hi rend="italic">die Heiden aller Länder</hi></seg><seg type="translation" xml:lang="en" source="#claude">French literature around 1200 calls the heathen of all lands Saracens</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-A-7.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de">Arthu. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Arthu. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-A-7.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de">Bryt. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Bryt. Ld</seg></note>
      </div>
