ef>, <ref type="entry" target="entry:tholian">þolian</ref>, (<ref type="entry" target="entry:bethurfan">be</ref>)<ref type="entry" target="entry:thurfan">þurfan</ref>, (<ref type="entry" target="entry:geunnan">ge</ref>)<ref type="entry" target="entry:unnan">unnan</ref>, <ref type="entry" target="entry:warnian">warnian</ref>, unwarnod, <ref type="entry" target="entry:wealdan">wealdan</ref>, <ref type="entry" target="entry:weardian">weardian</ref>, (be)<ref type="entry" target="entry:weddian">weddian</ref>, <ref type="entry" target="entry:wenan">wenan</ref>, <ref type="entry" target="entry:weordian">weorðian</ref>, (<ref type="entry" target="entry:forw-ie-rnan">for</ref>)<ref type="entry" target="entry:w-ie-rnan">wiernan</ref>, <ref type="entry" target="entry:wilnian">wilnian</ref>, wyrcean | <hi rend="italic"><ref type="abbreviation" target="gram:dafur"><abbr>dafür</abbr></ref> <ref type="abbreviation" target="gram:spater"><abbr>spät.</abbr></ref> <ref type="abbreviation" target="gram:accusativus"><abbr>ac</abbr></ref> bei</hi> ætsacan, onfon, onlænan, swicean, þolian | <hi rend="italic"><ref type="abbreviation" target="gram:neben"><abbr>neben</abbr></ref> <ref type="abbreviation" target="gram:accusativus"><abbr>ac</abbr></ref> <ref type="abbreviation" target="gram:siehe"><abbr>s.</abbr></ref></hi> (<ref type="entry" target="entry:forg-ie-man">for</ref>)<ref type="entry" target="entry:g-ie-man">gieman</ref>, <ref type="entry" target="entry:geunnan">geunnan</ref></sense>
          <sense n="6"><hi rend="italic">der Zeit: <ref type="abbreviation" target="gram:siehe"><abbr>s.</abbr></ref></hi> <ref type="entry" target="entry:daeg">dæg</ref>, <ref type="entry" target="entry:niht">niht</ref>, <ref type="entry" target="entry:sumor">sumor</ref>, <ref type="entry" target="entry:winter">winter</ref>, wucu</sense>
          <sense n="7"><hi rend="italic">bei</hi> beon [<hi rend="italic"><ref type="abbreviation" target="gram:sieheDN"><abbr>s. d. n.</abbr></ref></hi> 21] <hi rend="italic"><ref type="abbreviation" target="gram:Genitiv"><abbr>gn</abbr></ref> der Beschaffenheit, des Gehörens, Preises</hi></sense>
          <sense n="8"><hi rend="italic">der Quantität: <ref type="abbreviation" target="gram:siehe"><abbr>s.</abbr></ref></hi> þæs þe <hi rend="italic">soweit wie</hi> [<hi rend="italic"><ref type="abbreviation" target="gram:conjunctio"><abbr>cj</abbr></ref></hi>]; ænes <hi rend="italic">einmal;</hi> angieldes <hi rend="italic">einfach</hi></sense>
          <sense n="9"><hi rend="italic">des Motivs: <ref type="abbreviation" target="gram:siehe"><abbr>s.</abbr></ref></hi> heorte, nedes, (un)þances, agenes þances <ref type="lawCode" target="law:IICn">II Cn</ref> 74, (un)gewealdes, un(ge-, self-)willes; heora unwilles <hi rend="italic">gegen ihren Willen</hi></sense>
          <sense n="10"><hi rend="italic">instrumentalisch ‘vermittelst, <ref type="abbreviation" target="gram:durch"><abbr>durch</abbr></ref>’:</hi> wordes ⁊ weorces (dæde) <hi rend="italic"><ref type="abbreviation" target="gram:siehe"><abbr>s.</abbr></ref></hi> <ref type="entry" target="entry:word">word</ref></sense>
          <sense n="11"><hi rend="italic">adjectivisch:</hi> anre nihtes þiefðe <ref type="lawCode" target="law:Ine">Ine</ref> <ref type="lawCode" target="law:Rb">Rb</ref> 73</sense>
          <sense n="12"><hi rend="italic">praepositional ‘<ref type="abbreviation" target="gram:fur"><abbr>für</abbr></ref>’:</hi> his deaðes wer <ref type="lawCode" target="law:Ine">Ine</ref> 27; þæs (<hi rend="italic">‘<ref type="abbreviation" target="gram:dafur"><abbr>dafür</abbr></ref>’</hi>) <ref type="entry" target="entry:tima">tima</ref> <hi rend="italic"><ref type="abbreviation" target="gram:sieheDort"><abbr>s. d.</abbr></ref></hi></sense>
