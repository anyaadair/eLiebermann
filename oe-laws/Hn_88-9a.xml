      <div type="clause" n="88.9a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 88.9a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 88.9a" corresp="#wit-lat"><pb n="603" ed="#liebermann"/>Si autem inueritare<ptr type="liebermannNote" n="21" target="#Hn_88-9a.lnote.oe.21"/> possit<ptr type="liebermannNote" n="h" target="#Hn_88-9a.lnote.oe.h"/>, quod non rogatus<ptr type="liebermannNote" n="22" target="#Hn_88-9a.lnote.oe.22"/> cum eo uenerit<ptr type="liebermannNote" n="i" target="#Hn_88-9a.lnote.oe.i"/>, si qui<ptr type="liebermannNote" n="23" target="#Hn_88-9a.lnote.oe.23"/> inimici sui<ptr type="liebermannNote" n="i" target="#Hn_88-9a.lnote.oe.i"/> perimant<ptr type="liebermannNote" n="24" target="#Hn_88-9a.lnote.oe.24"/> eum<ptr type="liebermannNote" n="i" target="#Hn_88-9a.lnote.oe.i"/><ptr type="liebermannNote" n="25" target="#Hn_88-9a.lnote.oe.25"/>, qui<ptr type="liebermannNote" n="n" target="#Hn_88-9a.lnote.oe.n"/> nec ei<ptr type="liebermannNote" n="h" target="#Hn_88-9a.lnote.oe.h"/><ptr type="liebermannNote" n="26" target="#Hn_88-9a.lnote.oe.26"/> consanguinitate uel affinitate iunctus<ptr type="liebermannNote" n="27" target="#Hn_88-9a.lnote.oe.27"/> sit, iustum est, ut<ptr type="liebermannNote" n="28" target="#Hn_88-9a.lnote.oe.28"/> sicut peccauerint<ptr type="liebermannNote" n="29" target="#Hn_88-9a.lnote.oe.29"/> luant, et in eos uindicetur a parentibus et dominis; aut inde componant:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 603 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9a.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verklagter gemeint</hi></seg><seg type="translation" xml:lang="en" source="#claude">the accused is meant</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9a.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Erschlagener gemeint</hi></seg><seg type="translation" xml:lang="en" source="#claude">the slain man is meant</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9a.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wenn Erschlagener nur Dienstmann des Verklagten, also nicht von dessen Feinden verfolgbar war, vielmehr eigenen Feinden zum Opfer fiel</hi></seg><seg type="translation" xml:lang="en" source="#claude">if the slain man was only a servant of the accused, and so could not be pursued by the latter’s enemies, but rather fell victim to his own enemies</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9a.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">-ate <hi rend="italic">Lond;</hi> inuitare <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ate Lond; inuitare Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9a.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">c. eo rog. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. eo rog. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9a.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">que <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">que Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9a.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">-at <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-at Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9a.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9a.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9a.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">uinctus <hi rend="italic">Lond;</hi> iuncti sunt <hi rend="italic">gegen Hss. Wi</hi> [<hi rend="italic">falsch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">uinctus Lond; iuncti sunt Wi, against the MSS [wrong]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9a.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9a.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">-runt <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-runt Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Gefährdeeid 2; Gefolge 22c—<hi rend="italic">-ate</hi>{21}—<hi rend="italic">c. eo r</hi>.{22}—<hi rend="italic">-runt</hi>{29}—88, 9b <hi rend="italic">super his iudic</hi>.{33}—88, 10 <hi rend="italic">assalliat</hi>{31} <hi rend="italic">c. ut p</hi>. Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Gefährdeeid 2; Gefolge 22c—<hi rend="italic">-ate</hi>{21}—<hi rend="italic">c. eo r</hi>.{22}—<hi rend="italic">-runt</hi>{29}—88, 9b <hi rend="italic">super his iudic</hi>.{33}—88, 10 <hi rend="italic">assalliat</hi>{31} <hi rend="italic">c. ut p</hi>. Rs</seg></note>
      </div>
