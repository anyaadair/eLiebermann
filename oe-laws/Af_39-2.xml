    <body>
      <div type="clause" n="39.2">
        <head><ref type="lawCode" target="law:Af">Af</ref> 39.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="39.2" corresp="#wit-e"><pb n="72" ed="#liebermann"/>Gif syxhyndum þissa hwæðer<ptr type="liebermannNote" n="11" target="#Af_39-2.lnote.oe.11"/> gelimpe<ptr type="liebermannNote" n="12" target="#Af_39-2.lnote.oe.12"/>, ðriefealdlice [arise<ptr type="liebermannNote" n="*" target="#Af_39-2.lnote.oe.star"/> be ðære cierliscan<ptr type="liebermannNote" n="13" target="#Af_39-2.lnote.oe.13"/> bote, twelfhyndum men twyfealdlice<ptr type="liebermannNote" n="14" target="#Af_39-2.lnote.oe.14"/>] be þæs syxhyndan<ptr type="liebermannNote" n="15" target="#Af_39-2.lnote.oe.15"/> bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="39.2" corresp="#wit-h"><pb n="72" ed="#liebermann"/>Gif syxhyndum men ðissa<ptr type="liebermannNote" n="10" target="#Af_39-2.lnote.oe.10"/> hwæðer gelimpe, ðrifealdlice<ptr type="liebermannNote" n="11" target="#Af_39-2.lnote.oe.11-2"/> arise be ðære cierliscan bote, XIIhyndum men twyfealdlice be ðæs syxhyndan bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="39.2" corresp="#wit-b-no-prol"><pb n="72" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="2" target="#Af_39-2.lnote.oe.2"/> VIhyndu<hi rend="italic">m<ptr type="liebermannNote" n="3" target="#Af_39-2.lnote.oe.3"/></hi> ðissa hweðer gelimpe, ðryfealdlice arise bæ ðære cyrliscan bote, twelfhyndu<hi rend="italic">m</hi> m<hi rend="italic">en</hi> twifealdlice be ðæs syxhyndu<hi rend="italic">m<ptr type="liebermannNote" n="4" target="#Af_39-2.lnote.oe.4"/></hi> bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="39.2" corresp="#wit-q"><pb n="73" ed="#liebermann"/>Si horum aliquid accidat homini sixhindo, tripliciter exurgat emendatio super emendationem rustici, tƿelfhindo<ptr type="liebermannNote" n="13" target="#Af_39-2.lnote.oe.13-2"/> dupliciter a<ptr type="liebermannNote" n="14" target="#Af_39-2.lnote.oe.14-2"/> sixhindo.<ptr type="liebermannNote" n="15" target="#Af_39-2.lnote.oe.15-2"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="80–82" ed="#attenborough"/>Gif syxhyndum<ptr type="editorNote" n="25" target="#Af_39-2.attnote.fn.25"/> ðissa hwæðer gelimpe, ðriefealdlice [arise be ðære cierliscan bote, twelfhyndum men twyfealdlice]<ptr type="editorNote" n="1" target="#Af_39-2.attnote.fn.1"/> be þæs syxhyndan<ptr type="editorNote" n="2" target="#Af_39-2.attnote.fn.2"/> bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="40.2" corresp="#wit-e"><pb n="338" ed="#jurasinski-and-oliver"/>Gif syxhundum ðissa hwæðer gelimpe, ðriefealdlice [arise be ðære cierliscan bote, twelfhyndum men twyfealdlice] be þæs syxhyndan bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="73" ed="#liebermann"/>Wenn einer dieser beiden<ptr type="liebermannNote" n="1" target="#Af_39-2.lnote.de.1"/> [Hausfriedensbrüche] einem 600-[Schilling-]Manne<ptr type="liebermannNote" n="2" target="#Af_39-2.lnote.de.2"/> angethan wird, steige (die Busse<ptr type="liebermannNote" n="3" target="#Af_39-2.lnote.de.3"/>) dreifach über die gemeinfreie<ptr type="liebermannNote" n="4" target="#Af_39-2.lnote.de.4"/> Busse; bei einem 1200-[Schilling-]Manne<ptr type="liebermannNote" n="5" target="#Af_39-2.lnote.de.5"/> zweifach über die Busse des 600-[Schilling-]Mannes.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If either of these two [breaches of house-peace] is done to a 600-[shilling] man, let (the compensation) rise threefold over the common freeman’s compensation; for a 1200-[shilling] man, twofold over the compensation of the 600-[shilling] man.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="81" ed="#attenborough"/>If either of these [offences] occurs in the house of a man whose wergeld is 600 shillings, the compensation shall be increased to three times that due to a commoner; if in the house of a man whose wergeld is 1200 shillings, [it shall be increased] to twice the compensation due to a man whose wergeld is 600 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="415" ed="#whitelock"/>If either of these things happens to a man of a six-hundred wergild, it is to amount to three-fold the compensation to a <hi rend="italic">ceorl</hi>; [if] to a man of a twelve-hundred wergild, to double that of the man of the six-hundred wergild.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="339" ed="#jurasinski-and-oliver"/>If, however, this happens to a [man whose wergild is] 600, three-fold [the compensation of a <hi rend="italic">ceorl</hi>]; for a [man whose wergild is] 1,200, twice the compensation of [a man whose wergild is] 600.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de">-re <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-re Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de">-mp ðryfealdlic <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-mp ðryfealdlic Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-2.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de">arise — twyf. <hi rend="italic">überspringt E, ergänzt aus H B Ld. Hinter</hi> arise <hi rend="italic">hat Ld</hi> [<hi rend="italic">vgl. Quadr.</hi>]: seo bote [<hi rend="italic">lies</hi> bot], <hi rend="italic">was laut H B vielleicht nicht Aelfredisch.</hi></seg><seg type="translation" xml:lang="en" source="#claude">arise — twyf. omitted by E, supplied from H B Ld. After arise Ld has [cf. Quadr.]: seo bote [read bot], which, to judge by H B, is perhaps not Ælfredian.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de">ceorl. bót <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ceorl. bót Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de">-lic <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lic Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de">-dum bót <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dum bót Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-2.lnote.oe.11-2" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">erstes</hi> i <hi rend="italic">auf Rasur, erstes</hi> e <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">first i on an erasure, first e written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-2.lnote.oe.13-2" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">73</biblScope></bibl><seg type="original" xml:lang="de">tƿelfhindi (tlefhindi <hi rend="italic">T;</hi> XIIhindi <hi rend="italic">Hk</hi>) hominis <hi rend="italic">R T Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">tƿelfhindi (tlefhindi T; XIIhindi Hk) hominis R T Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-2.lnote.oe.14-2" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">73</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-2.lnote.oe.15-2" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">73</biblScope></bibl><seg type="original" xml:lang="de">sex. <hi rend="italic">T Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">sex. T Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de">on <hi rend="italic">später eingefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">on inserted later</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. aus</hi> hund.</seg><seg type="translation" xml:lang="en" source="#claude">altered from hund.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_39-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘dergleichen’. <hi rend="italic">Vgl. Gl</hi> Staod 21h; Sechshunderter 6</seg><seg type="translation" xml:lang="en" source="#claude">Not ‘the like’. <hi rend="italic">Cf. Gl</hi> Staod 21h; Sechshunderter 6</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_39-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Inst. bringen dieselbe Einfügung zu Af 30</seg><seg type="translation" xml:lang="en" source="#claude">Inst. make the same insertion at Af 30</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_39-2.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘die Busse’ fügt zu Ld Q Inst.?</seg><seg type="translation" xml:lang="en" source="#claude">Ld Q Inst. add ‘the compensation’?</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_39-2.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Inst. zitieren ihre Zufügung zu Af 39</seg><seg type="translation" xml:lang="en" source="#claude">Inst. cite their addition to Af 39</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_39-2.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Inst. zitieren ihre Zufügung zu Af 31. — <hi rend="italic">Vgl. Gl</hi> Thegn 17a</seg><seg type="translation" xml:lang="en" source="#claude">Inst. cite their addition to Af 31. — <hi rend="italic">Cf. Gl</hi> Thegn 17a</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_39-2.attnote.fn.25" n="25" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>syxhyndum</label><seg type="original" xml:lang="en"><hi rend="italic">syxhyndum men</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_39-2.attnote.fn.1" n="1" source="#attenborough"><bibl><biblScope unit="page">82</biblScope></bibl><label>twyfealdlice</label><seg type="original" xml:lang="en">H, B, Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_39-2.attnote.fn.2" n="2" source="#attenborough"><bibl><biblScope unit="page">82</biblScope></bibl><label>syxhyndan</label><seg type="original" xml:lang="en"><hi rend="italic">syxhyndum</hi>. B.</seg></note>
