      <div type="clause" n="34.1a">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 34.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 34.1a"><pb n="661" ed="#liebermann"/><hi rend="bold">Rege uero ad flectendum ingrato existente, tandem</hi><ptr type="liebermannNote" n="36" target="#ECfRetr_34-1a.lnote.la.36"/> eum <hi rend="bold">prosecuti</hi><ptr type="liebermannNote" n="37" target="#ECfRetr_34-1a.lnote.la.37"/> sunt deprecantes, <hi rend="bold">quatinus</hi> pro anima regis Eadwardi<ptr type="liebermannNote" n="38" target="#ECfRetr_34-1a.lnote.la.38"/>, qui sibi<ptr type="liebermannNote" n="39" target="#ECfRetr_34-1a.lnote.la.39"/> <hi rend="bold">post diem suum</hi> con<pb n="662" ed="#liebermann"/>cesserat <hi rend="bold">coronam et</hi> regnum, et cuius erant leges, nec<ptr type="liebermannNote" n="1" target="#ECfRetr_34-1a.lnote.la.1"/> aliorum <hi rend="spaced">extraneorum</hi>, <hi rend="bold">exaudiendo</hi><ptr type="liebermannNote" n="2" target="#ECfRetr_34-1a.lnote.la.2"/> <hi rend="bold">concederet eis</hi><ptr type="liebermannNote" n="3" target="#ECfRetr_34-1a.lnote.la.3"/> <hi rend="bold">sub legibus perseuerare paternis</hi><ptr type="liebermannNote" n="4" target="#ECfRetr_34-1a.lnote.la.4"/>. <hi rend="bold">Unde</hi> consilio <hi rend="bold">habito,</hi> precatu baronum tandem adquieuit.<ptr type="liebermannNote" n="*" target="#ECfRetr_34-1a.lnote.la.star"/> Et<ptr type="liebermannNote" n="5" target="#ECfRetr_34-1a.lnote.la.5"/> <hi rend="bold">ex illo</hi><ptr type="liebermannNote" n="6" target="#ECfRetr_34-1a.lnote.la.6"/> <hi rend="bold">igitur</hi><ptr type="liebermannNote" n="7" target="#ECfRetr_34-1a.lnote.la.7"/> <hi rend="bold">die multa</hi><ptr type="liebermannNote" n="3" target="#ECfRetr_34-1a.lnote.la.3"/> auctoritate <hi rend="bold">uenerate</hi><ptr type="liebermannNote" n="9" target="#ECfRetr_34-1a.lnote.la.9"/> <hi rend="bold">per uniuersam</hi><ptr type="liebermannNote" n="10" target="#ECfRetr_34-1a.lnote.la.10"/> <hi rend="bold">Angliam, confirmate</hi><ptr type="liebermannNote" n="11" target="#ECfRetr_34-1a.lnote.la.11"/> <hi rend="bold">et corroborate (et</hi><ptr type="liebermannNote" n="12" target="#ECfRetr_34-1a.lnote.la.12"/> <hi rend="bold">obseruate)</hi> sunt <hi rend="bold">pre ceteris patrie legibus</hi> leges regis<ptr type="liebermannNote" n="13" target="#ECfRetr_34-1a.lnote.la.13"/> Eadwardi<ptr type="liebermannNote" n="14" target="#ECfRetr_34-1a.lnote.la.14"/>.</ab>
        <note type="comparison" source="#liebermann" n="661"><label>printed alongside</label> <ref target="clause:ECf_34-1a">ECf 34.1a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 661–662 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">After “multa” Liebermann prints the note number 3 (“fehlt Hv”), not 8, and no word in the text carries his note 8; the 3 is linked here as printed, and note 8 is given below.</note>
        <note type="editorial">Liebermann’s note 8 in the ECf retr column of p. 662 reads: “8) uisa <hi rend="italic">Hv</hi>” (uisa Hv).</note>
        <note type="editorial">The note on the London collection’s interpolation (*) is printed across the whole page; it is given with both columns.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Dc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">pers. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">pers. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">Ed. <hi rend="italic">Cb;</hi> Æd. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ed. Cb; Æd. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">ei <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">Thomas uero archiepiscopus§ et Mauricius episcopus scripserunt propriis manibus omnia ista predicta per preceptum predicti regis Willelmi <hi rend="italic">interpolirt Lond.</hi> — §) Cantuariensis <hi rend="italic">fügt zu Ld</hi> [<hi rend="italic">fehlerhaft</hi>]; <hi rend="italic">die beiden Namen beginnen die Zeugenliste einer Urkunde Wilhelms I., die in der Gildhalle copirt war</hi> (Lib. custum. 28); <hi rend="italic">daher wohl bringt sie der Londoner hier anachronistisch: Thomas von York sass</hi> 1070—1100, <hi rend="italic">Morix von London</hi> 1086—1107. <hi rend="italic">Diess verschlimmert der Lichfielder o. S.</hi> 627*</seg><seg type="translation" xml:lang="en" source="#claude">Lond interpolates Thomas uero archiepiscopus§ et Mauricius episcopus scripserunt propriis manibus omnia ista predicta per preceptum predicti regis Willelmi. — §) Ld adds Cantuariensis [wrongly]; the two names begin the witness list of a charter of William I which had been copied in the Guildhall (Lib. custum. 28); that is probably why the Londoner brings them in here, anachronistically: Thomas of York sat 1070–1100, Maurice of London 1086–1107. The Lichfield man makes this worse, above p. 627*</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">ne <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">ne Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">cogeret quam sub <hi rend="italic">nur Hv’s Ed. Sarile</hi></seg><seg type="translation" xml:lang="en" source="#claude">cogeret quam sub only Hv’s editor Sarile</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">patriis <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">patriis Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Ph Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Ph Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">illa <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">illa Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">ergo <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">ergo Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Lond adds et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">-sum regnum <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sum regnum Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">conf. et <hi rend="italic">aus Cb; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">conf. et from Cb; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">et obs. <hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">et obs. lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">Æd. r. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Æd. r. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">sancti <hi rend="italic">fügt zu Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Co adds sancti</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But when the king proved unwilling to be swayed, at length they pursued him with entreaties that, for the soul of King Edward, who had granted him the crown and the kingdom after his day, and whose laws they were, and not [those] of other strangers, he would hear them and grant them to continue under their fathers' laws. Whereupon, counsel having been taken, he at length yielded to the entreaty of the barons. And so from that day, venerated with great authority throughout all England, the laws of King Edward were confirmed and strengthened (and observed) before the other laws of the country.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-1a.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">349</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">uniuersum</hi><hi rend="superscript">10</hi> <hi rend="italic">regnum corr.</hi> (ohne <hi rend="italic">confi.</hi><hi rend="superscript">11</hi> <hi rend="italic">et</hi>) Rs.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">uniuersum</hi><hi rend="superscript">10</hi> <hi rend="italic">regnum corr.</hi> (without <hi rend="italic">confi.</hi><hi rend="superscript">11</hi> <hi rend="italic">et</hi>) Rs.</seg></note>
      </div>
