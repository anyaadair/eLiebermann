      <div type="clause" n="70.11">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 70.11</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 70.11" corresp="#wit-lat"><pb n="588" ed="#liebermann"/>Qui pacem facit<ptr type="liebermannNote" n="30" target="#Hn_70-11.lnote.oe.30"/> cum<ptr type="liebermannNote" n="31" target="#Hn_70-11.lnote.oe.31"/> aliquo de uulnere uel malo quod inflixerit, distincte<ptr type="liebermannNote" n="32" target="#Hn_70-11.lnote.oe.32"/> cum testibus et gratuita<ptr type="liebermannNote" n="33" target="#Hn_70-11.lnote.oe.33"/> parentum<ptr type="liebermannNote" n="q" target="#Hn_70-11.lnote.oe.q"/> eius unanimitate<ptr type="liebermannNote" n="r" target="#Hn_70-11.lnote.oe.r"/> finiat, ut ei scilicet et<ptr type="liebermannNote" n="s" target="#Hn_70-11.lnote.oe.s"/><ptr type="liebermannNote" n="34" target="#Hn_70-11.lnote.oe.34"/> non requiratur a<ptr type="liebermannNote" n="35" target="#Hn_70-11.lnote.oe.35"/> genitis<ptr type="liebermannNote" n="t" target="#Hn_70-11.lnote.oe.t"/> uel ingenitis<ptr type="liebermannNote" n="36" target="#Hn_70-11.lnote.oe.36"/>, quicquid postea<ptr type="liebermannNote" n="37" target="#Hn_70-11.lnote.oe.37"/> contingat:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 588 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-11.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">noch lebt also Theilnahme der Sippe an der Fehdesühne wie</hi> II Em. 7</seg><seg type="translation" xml:lang="en" source="#claude">the kindred’s participation in the settlement of a feud thus still survives, as in II Em. 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-11.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 88, 17</seg><seg type="translation" xml:lang="en" source="#claude">cf. 88, 17</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-11.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">auch späterhin</seg><seg type="translation" xml:lang="en" source="#claude">later on too</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-11.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">boren ⁊ unboren <hi rend="italic">in Urkunde XI. Jhs.; Earle</hi> Landchar. 275</seg><seg type="translation" xml:lang="en" source="#claude">boren ⁊ unboren in an 11th-cent. charter; Earle Landchar. 275</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-11.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">-iat <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iat <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-11.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">dē <hi rend="italic">Co Or</hi>; deliquo <hi rend="italic">statt</hi> c. a. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">dē Co Or; deliquo instead of c. a. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-11.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">districte <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">districte Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-11.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">granda <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">granda Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-11.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi>; sic <hi rend="italic">ohne Hss. Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Lond; sic Edd., without MS authority</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-11.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">agentis u. ingentis <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">agentis u. ingentis Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-11.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">gignendis <hi rend="italic">ohne Hss. Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">gignendis Wi Tho, without MS authority</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-11.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-11.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. u</hi>. 88, 17; <hi rend="italic">Gl</hi> Sippe 27a. Auch bei blosser Verwundung, nicht bloss Totschlag, empfängt des Verletzten Sippe Busse; bei and. Germ. Phillpotts <hi rend="italic">Kindred</hi> 192. Sühne mit Einzelnen bezeugt den Verfall des Geschlechtsverbandes; <hi rend="italic">ebd</hi>. 231.—Zur Anm.{t} füge hinzu: von <hi rend="italic">genitis et ingenitis</hi> spricht Verf. auch AGu Pro—<hi rend="italic">faciet</hi>{30}—<hi rend="italic">granta</hi>{33}—<hi rend="italic">et</hi>{34} fehlt—<hi rend="italic">postea</hi>{37} fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. below</hi> 88, 17; <hi rend="italic">Gl</hi> Sippe 27a. Even for mere wounding, and not only for homicide, the injured man’s kindred receives compensation; among other Germanic peoples, Phillpotts <hi rend="italic">Kindred</hi> 192. Settlement with individuals attests the decay of the kin association; <hi rend="italic">ibid</hi>. 231.—To note{t} add: the author also speaks of <hi rend="italic">genitis et ingenitis</hi> in AGu Pro—<hi rend="italic">faciet</hi>{30}—<hi rend="italic">granta</hi>{33}—<hi rend="italic">et</hi>{34} missing—<hi rend="italic">postea</hi>{37} missing Rs</seg></note>
      </div>
    </body>
