        <note type="liebermannNote" subtype="textual" xml:id="IICn_2-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">309</biblScope></bibl><seg type="original" xml:lang="de">quisquam pro m. a. m. condempnetur <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">quisquam pro m. a. m. condempnetur Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_2-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">das Folgende bis</hi> 8 <hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">what follows, as far as 8, lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_2-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> deteratur (<hi rend="italic">vgl.</hi> 15, 3) <hi rend="italic">oder</hi> destruatur</seg><seg type="translation" xml:lang="en" source="#claude">read deteratur (cf. 15, 3) or destruatur</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_2-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">308</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Ld Quadr.; Instituta; Consiliatio</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. Ld Quadr.; Instituta; Consiliatio</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_2-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">309</biblScope></bibl><seg type="original" xml:lang="de">autem <hi rend="italic">fügt zu T</hi></seg><seg type="translation" xml:lang="en" source="#claude">autem added by T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_2-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">309</biblScope></bibl><seg type="original" xml:lang="de">pen. pro <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">pen. pro R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_2-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">309</biblScope></bibl><seg type="original" xml:lang="de">id — prei. <hi rend="italic">fehlt KRHk; übergeschr. Dm; im Text T</hi></seg><seg type="translation" xml:lang="en" source="#claude">id — prei. lacking in KRHk; written above Dm; in the text T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_2-1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de">nec <hi rend="italic">K;</hi> ne <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">nec K; ne the others</seg></note>
