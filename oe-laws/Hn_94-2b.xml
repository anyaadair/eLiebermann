      <div type="clause" n="94.2b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 94.2b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 94.2b" corresp="#wit-lat"><pb n="611" ed="#liebermann"/>Differt autem in pluribus: si homines<ptr type="liebermannNote" n="8" target="#Hn_94-2b.lnote.oe.8"/> unius<ptr type="liebermannNote" n="f" target="#Hn_94-2b.lnote.oe.f"/> baronis pugnent<ptr type="liebermannNote" n="9" target="#Hn_94-2b.lnote.oe.9"/> cum sanguinem faciente uel<ptr type="liebermannNote" n="10" target="#Hn_94-2b.lnote.oe.10"/> non faciente, siue in presenti siue postea quandoque<ptr type="liebermannNote" n="11" target="#Hn_94-2b.lnote.oe.11"/> crauentur<ptr type="liebermannNote" n="12" target="#Hn_94-2b.lnote.oe.12"/> — non remanet wita<ptr type="liebermannNote" n="f" target="#Hn_94-2b.lnote.oe.f"/> domini.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 611 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2b.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">ouerseunessa; <hi rend="italic">für unblutigen Fall sagt schon</hi> 94, 1<hi rend="italic">a, die Eine Thatsache, dass beide Eines Herrn, genüge</hi></seg><seg type="translation" xml:lang="en" source="#claude">ouerseunessa; for the bloodless case 94, 1a already says that the single fact that both belong to one lord suffices</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2b.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">u. b. h. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. b. h. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2b.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">pung. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">pung. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2b.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">umgestellt aus</hi> siue in pr. s. po. uel non fa. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">transposed from siue in pr. s. po. uel non fa. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2b.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">qn̄ȝ <hi rend="italic">Sc;</hi> quoniam <hi rend="italic">Wh;</hi> quamquam <hi rend="italic">ohne Hss. Wi Tho; ausgeschrieben Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">qn̄ȝ Sc; quoniam Wh; quamquam without MS authority Wi Tho; written out in full Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2b.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">gr. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">gr. Lond</seg></note>
      </div>
