      <div type="clause" n="45.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 45.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 45.3" corresp="#wit-lat"><pb n="570" ed="#liebermann"/>Item si quis sponse<ptr type="liebermannNote" n="12" target="#Hn_45-3.lnote.oe.12"/> uel puero<ptr type="liebermannNote" n="f" target="#Hn_45-3.lnote.oe.f"/> uel puelle sine permissu<ptr type="liebermannNote" n="13" target="#Hn_45-3.lnote.oe.13"/> domini sui quamcunque<ptr type="liebermannNote" n="14" target="#Hn_45-3.lnote.oe.14"/> commendationem uel aliquam commutacionem uel traditionem fecerit, non opus est eos uel eorum dominos respondere<ptr type="liebermannNote" n="15" target="#Hn_45-3.lnote.oe.15"/> super hiis, si complaceat abnegare, quamdiu sub<ptr type="liebermannNote" n="h" target="#Hn_45-3.lnote.oe.h"/> uirga sunt.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 570 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-3.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie oben</hi> 23, 3</seg><seg type="translation" xml:lang="en" source="#claude">as above 23, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-3.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">sous la verge ‘<hi rend="italic">unter Autorität</hi>’</seg><seg type="translation" xml:lang="en" source="#claude">sous la verge ‘under authority’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-3.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">-nsse <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nsse Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-3.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">prom. <hi rend="italic">Co;</hi> prem., <hi rend="italic">geänd.</hi> prom. <hi rend="italic">K;</hi> promisso <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">prom. Co; prem., altered to prom. K; promisso Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-3.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">quac. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">quac. Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-3.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">s. h. r. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. h. r. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-3.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> mündig 13—<hi rend="italic">prom</hi>.{13}—<hi rend="italic">super his resp</hi>.{15} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> mündig 13—<hi rend="italic">prom</hi>.{13}—<hi rend="italic">super his resp</hi>.{15} Rs</seg></note>
