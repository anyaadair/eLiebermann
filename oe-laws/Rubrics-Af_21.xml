      <div type="clause" n="21">
        <head>Af Rb 21</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="21" corresp="#wit-e"><pb n="18" ed="#liebermann"/>XVIIII. Be preosta gefeohte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="21" corresp="#wit-ot-frag"><pb n="18" ed="#liebermann"/>… Be preosta gefeohte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="21" corresp="#wit-g-prol"><pb n="18" ed="#liebermann"/>XIX. Be preosta gefeohte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="21" corresp="#wit-h"><pb n="19" ed="#liebermann"/>XIX. Be preosta gefiohte.<ptr type="liebermannNote" n="7" target="#Rubrics-Af_21.lnote.oe.7"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="21" corresp="#wit-q"><pb n="19" ed="#liebermann"/>De rixa<ptr type="liebermannNote" n="4" target="#Rubrics-Af_21.lnote.oe.4"/> sacerdotum.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="192" ed="#jurasinski-and-oliver"/>XIX Be preosta gefeohte</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="192" ed="#jurasinski-and-oliver"/>Be preosta gefeohte</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="19" ed="#liebermann"/>Über Fechten<ptr type="liebermannNote" n="1" target="#Rubrics-Af_21.lnote.de.1"/> von Priestern.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning fighting by priests.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="193" ed="#jurasinski-and-oliver"/>Concerning fighting of priests</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="193" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_21.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">presbitero homicida <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">presbitero homicida Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_21.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">i <hi rend="italic">in</hi> e <hi rend="italic">geändert</hi></seg><seg type="translation" xml:lang="en" source="#claude">i altered to e</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_21.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nicht nur unter Priestern und nicht ohne Blut, wie Quadr, von spät. Rez. verbessert</seg><seg type="translation" xml:lang="en" source="#claude">Not only among priests and not without bloodshed, as Quadr has it, corrected by the later rec.</seg></note>
      </div>
    </body>
