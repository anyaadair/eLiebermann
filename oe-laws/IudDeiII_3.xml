        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei II 3" corresp="#wit-lat"><pb n="406" ed="#liebermann"/>Alia.<ptr type="liebermannNote" n="49" target="#IudDeiII_3.lnote.oe.49"/> Deus<ptr type="liebermannNote" n="50" target="#IudDeiII_3.lnote.oe.50"/>, iudex iustus, fortis, auctor et amator pacis, patiens et multum misericors<ptr type="liebermannNote" n="51" target="#IudDeiII_3.lnote.oe.51"/>, qui iudicas quod iustum est, et rectum iudicium tuum;</ab>
