      <div type="clause" n="2.2">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 2.2</head>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-hk"><pb n="493–495" ed="#liebermann"/>Et ki en Denelahe enfreint la pais le rei, set vint livres e quatre les amendes.</ab>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-i"><pb n="493–495" ed="#liebermann"/>Et<ptr type="liebermannNote" n="1" target="#LeisWl_2-2.lnote.oe.1"/> qui<ptr type="liebermannNote" n="2" target="#LeisWl_2-2.lnote.oe.2-2"/> en Danelae fruisse la pais le roi, VII vinz liverez e IIII les amendes<ptr type="liebermannNote" n="3" target="#LeisWl_2-2.lnote.oe.3"/>.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="493–495" ed="#liebermann"/>[2, 2]<ptr type="liebermannNote" n="2" target="#LeisWl_2-2.lnote.oe.2"/> Secundum Denelahe pena infracte pacis regie CXLIIII libr.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="2.2" corresp="#wit-hk"><pb n="252" ed="#robertson"/>Et ki en Denelahe enfreint la pais le rei, set vint livres e quatre les amendes.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="493–495" ed="#liebermann"/>2, 2. Und wer im Dänen-Rechtsgebiet den [Hand-]friedensschutz<ptr type="liebermannNote" n="1" target="#LeisWl_2-2.lnote.de.1"/> des Königs bricht: 144<ptr type="liebermannNote" n="2" target="#LeisWl_2-2.lnote.de.2"/> £ die Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">2, 2. And whoever in the Danish legal district breaks the [hand-]peace protection of the king: 144 £ the compensation.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-hk"><pb n="253" ed="#robertson"/>And he who, in the Danelaw, violates the King's Peace shall pay £144 as compensation.</ab>
        <note type="editorial">Added October 2026 from Robertson pp. 252–253 (text and translation); Liebermann’s text and German translation added from Gesetze I p. 493–495, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_2-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">493</biblScope></bibl><seg type="original" xml:lang="de">2, 2 <hi rend="italic">steht vor</hi> 2, 1</seg><seg type="translation" xml:lang="en" source="#claude">2, 2 stands before 2, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_2-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">494</biblScope></bibl><seg type="original" xml:lang="de">III. E <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">III. E Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_2-2.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">494</biblScope></bibl><seg type="original" xml:lang="de">que <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">que Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_2-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">494</biblScope></bibl><seg type="original" xml:lang="de">-dez <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dez Im</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_2-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">286</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Handfrieden 1a. 5C; Strafgeldfixum 24ff.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Handfrieden 1a. 5C; Strafgeldfixum 24ff.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_2-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">286</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Wb</hi>: <hi rend="italic">vint</hi>, <hi rend="italic">viginti</hi>; Agsä., Nord. <hi rend="italic">scoru</hi>; Napier <hi rend="italic">Lex</hi>. 56; K. Maurer in <hi rend="italic">Engl. Stud</hi>. 1896, 77</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Wb</hi>: <hi rend="italic">vint</hi>, <hi rend="italic">viginti</hi>; A.-S., Norse <hi rend="italic">scoru</hi>; Napier <hi rend="italic">Lex</hi>. 56; K. Maurer in <hi rend="italic">Engl. Stud</hi>. 1896, 77</seg></note>
      </div>
