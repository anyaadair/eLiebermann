    <body>
      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:WiLond">Wl Lond</ref> 5</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-orig"><pb n="486" ed="#liebermann"/>God eoƿ gehealde!</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-lond"><pb n="486" ed="#liebermann"/>Deus uos saluet!</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="5" corresp="#wit-original"><pb n="230" ed="#robertson"/>God eow gehealde.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="486" ed="#liebermann"/>5. Gott schütze euch!</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">5. God protect you!</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-original"><pb n="231" ed="#robertson"/>God keep you!</ab>
        <note type="editorial">Added October 2026 from Robertson pp. 230–231 (text and translation); Liebermann’s text and German translation added from Gesetze I p. 486, October 2026 (two independent readings of the page images)</note>
      </div>
    </body>
