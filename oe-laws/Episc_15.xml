  <text>
    <body>
      <div type="clause" n="15">
        <head><ref type="lawCode" target="law:Episc">Episc</ref> 15</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15" corresp="#wit-x"><pb n="479" ed="#liebermann"/>[Þ]y<ptr type="liebermannNote" n="3" target="#Episc_15.lnote.oe.3"/> we agan þearfe, þ<hi rend="italic">æt</hi> we ðam beorgan þe us scylan hyran; þonne gebide we þe mare gebeorh æt Godes agenum dome.<ptr type="liebermannNote" n="c" target="#Episc_15.lnote.oe.c"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="15" corresp="#wit-q"><ptr type="liebermannNote" n="22" target="#Episc_15.lnote.oe.22"/><pb n="479" ed="#liebermann"/>Et ideo opus est ut eis parcamus<ptr type="liebermannNote" n="23" target="#Episc_15.lnote.oe.23"/> qui nobis parere debent; et tunc manutenebimur [in<ptr type="liebermannNote" n="24" target="#Episc_15.lnote.oe.24"/>] Dei omnipotentis iudicio. Amen.<ptr type="liebermannNote" n="25" target="#Episc_15.lnote.oe.25"/></ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-x"><pb n="106" ed="#rabin-doml"/>Þy we agan þearfe þæt we ðam beorgan þe us scylan hyran; þonne gebide we þe mare gebeorh æt Godes agenum dome.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="479" ed="#liebermann"/>Darum haben wir nöthig, dass wir derer schonen, die uns gehorchen müssen: dann erwarten wir umsomehr Schutz bei Gottes eigenem Gericht.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Therefore we need to spare those who must obey us: then we may expect all the more protection at God's own judgment.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-x"><pb n="107" ed="#rabin-doml"/>Accordingly, we have an obligation to protect those compelled to serve us; then we may experience a greater protection at God's own judgment.</ab>
        <note type="editorial">The initial was left out for the rubricator in X. In X a further chapter (Bisceopes dægweorc) follows; in the Quadripartitus, Norðleod follows.</note>
        <note type="textual" source="#rabin-doml">Þy: y with a preceding space for a rubricated initial X</note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_15.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">479</biblScope></bibl><seg type="original" xml:lang="de">15 <hi rend="italic">nur in Lond; fehlt übrigen</hi></seg><seg type="translation" xml:lang="en" source="#claude">15 only in Lond; omitted in the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_15.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">479</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Or;</hi> parea. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Or; parea. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_15.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">479</biblScope></bibl><seg type="original" xml:lang="de">ut <hi rend="italic">K Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">ut K Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_15.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">479</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt Northleod, oben S.</hi> 459</seg><seg type="translation" xml:lang="en" source="#claude">there follows Northleod, above p. 459</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_15.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">479</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Initiale für den Rubricator ausgelassen</hi></seg><seg type="translation" xml:lang="en" source="#claude">initial left out for the rubricator</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_15.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">479</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt als ein ferneres Cap.</hi> Item: Bisceopes dægweorc, <hi rend="italic">ed. Thorpe</hi> 427</seg><seg type="translation" xml:lang="en" source="#claude">there follows, as a further cap., Item: Bisceopes dægweorc, ed. Thorpe 427</seg></note>
      </div>
