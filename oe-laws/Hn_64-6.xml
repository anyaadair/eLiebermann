      <div type="clause" n="64.6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 64.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 64.6" corresp="#wit-lat"><pb n="584" ed="#liebermann"/>Si quilibet rem in communi propriare<ptr type="liebermannNote" n="w" target="#Hn_64-6.lnote.oe.w"/><ptr type="liebermannNote" n="29" target="#Hn_64-6.lnote.oe.29"/> uelint sibi<ptr type="liebermannNote" n="30" target="#Hn_64-6.lnote.oe.30"/>, et utrimque<ptr type="liebermannNote" n="31" target="#Hn_64-6.lnote.oe.31"/> sint testes<ptr type="liebermannNote" n="x" target="#Hn_64-6.lnote.oe.x"/>, et furtiua dicatur: qui melius testimonium habebit, probationi propior<ptr type="liebermannNote" n="32" target="#Hn_64-6.lnote.oe.32"/> sit<ptr type="liebermannNote" n="y" target="#Hn_64-6.lnote.oe.y"/> et solus fracto<ptr type="liebermannNote" n="d" target="#Hn_64-6.lnote.oe.d"/> iuramento suam esse comprobet; et testes<ptr type="liebermannNote" n="x" target="#Hn_64-6.lnote.oe.x"/> eius plane<ptr type="liebermannNote" n="n" target="#Hn_64-6.lnote.oe.n"/> confirment.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 584 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-6.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">gestabt</seg><seg type="translation" xml:lang="en" source="#claude">formal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-6.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">schlicht</seg><seg type="translation" xml:lang="en" source="#claude">plainly</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-6.lnote.oe.w" n="w" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">im Anefang als sein ursprüngliches Eigen erweisen</seg><seg type="translation" xml:lang="en" source="#claude">prove in the process of attachment to be his original property</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-6.lnote.oe.x" n="x" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">Eideshelfer</seg><seg type="translation" xml:lang="en" source="#claude">oath-helpers</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-6.lnote.oe.y" n="y" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">‘still proof a benefit, not a burden’; <hi rend="italic">Maitland</hi> Sel. pleas man. 133</seg><seg type="translation" xml:lang="en" source="#claude">‘still proof a benefit, not a burden’; Maitland Sel. pleas man. 133</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-6.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">sibi p. u. <hi rend="italic">Co Or;</hi> propitiare [<hi rend="italic">falsch</hi>] <hi rend="italic">Wh Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">sibi p. u. Co Or; propitiare [wrong] Wh Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-6.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-6.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">utrum. sunt <hi rend="italic">Wh Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">utrum. sunt Wh Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-6.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">proprior <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">proprior K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-6.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de">Anders als <hi rend="italic">o. Gl</hi> Anefang 25. 26 fasst die eine Partei H. Meyer <hi rend="italic">Publizität</hi> 53{8} auf, nämlich als beklagten Besitzer: aber von ihm würde nicht <hi rend="italic">res furtiva dicatur</hi>—<hi rend="italic">sibi</hi>{30} fehlt—64, 6a <hi rend="italic">quaque</hi>{34}—<hi rend="italic">we</hi>.{36} Rs</seg><seg type="translation" xml:lang="en" source="#claude">Unlike <hi rend="italic">Gl</hi> Anefang 25. 26 above, H. Meyer <hi rend="italic">Publizität</hi> 53{8} takes the one party to be the defendant possessor: but of him one would not say <hi rend="italic">res furtiva dicatur</hi>—<hi rend="italic">sibi</hi>{30} missing—64, 6a <hi rend="italic">quaque</hi>{34}—<hi rend="italic">we</hi>.{36} Rs</seg></note>
      </div>
