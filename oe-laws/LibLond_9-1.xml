      <div type="clause" n="9.1">
        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 9.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 9.1" corresp="#wit-lat"><pb n="675" ed="#liebermann"/>nec<ptr type="liebermannNote" n="25" target="#LibLond_9-1.lnote.oe.25"/> ad<ptr type="liebermannNote" n="26" target="#LibLond_9-1.lnote.oe.26"/> aliquod<ptr type="liebermannNote" n="23" target="#LibLond_9-1.lnote.oe.23"/> mercatum faciendum<ptr type="liebermannNote" n="27" target="#LibLond_9-1.lnote.oe.27"/> nequit<ptr type="liebermannNote" n="28" target="#LibLond_9-1.lnote.oe.28"/> ciui preuenire nec magis in urbe perhendinare<ptr type="liebermannNote" n="p" target="#LibLond_9-1.lnote.oe.p"/> poterit<ptr type="liebermannNote" n="29" target="#LibLond_9-1.lnote.oe.29"/> quam<ptr type="liebermannNote" n="30" target="#LibLond_9-1.lnote.oe.30"/> XL<ptr type="liebermannNote" n="q" target="#LibLond_9-1.lnote.oe.q"/> dies<ptr type="liebermannNote" n="r" target="#LibLond_9-1.lnote.oe.r"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 675 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9-1.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">in aduentu suo <hi rend="italic">erklärt Cons Douai;</hi> a une venue <hi rend="italic">Ord</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cons Douai explain as in aduentu suo; a une venue Ord</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9-1.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">ne put nul marcheant Loereng remaindre en la cité plus de XL jurz (<hi rend="italic">Loorengs</hi> 500); non possunt ultra XL dies morari <hi rend="italic">London vor</hi> 1215 <hi rend="italic">p.</hi> 725. ‘<hi rend="italic">Durch Jahrhunderte bleiben diese Vorschriften auf dem Papiere bestehen; vgl.</hi> Libell of Engl. policye <hi rend="italic">ed. Hertzberg und Pauli</hi> 460 <hi rend="italic">ff.</hi>; Munim. Gildh. I 160’; <hi rend="italic">Höhlbaum</hi> Hans. Urkb. III <hi rend="italic">S.</hi> 383{5}; quarentena <hi rend="italic">heissen die</hi> 40 <hi rend="italic">Tage in Hs. Douai, ebd. S.</hi> 384. <hi rend="italic">Die</hi> Leges Angl. s. XIII. in. Lond. collectae <hi rend="italic">S.</hi> 13 <hi rend="italic">legen Ine das Verbot bei:</hi> Mercatores perhendinare possunt per spacium 40 dierum per [Britanniae] portus, nisi uento uel infirmitate uel legitimis causis impediantur. <hi rend="italic">Vgl. Schanz</hi> Handelspolitik I 383. 388. 395</seg><seg type="translation" xml:lang="en" source="#claude">ne put nul marcheant Loereng remaindre en la cité plus de XL jurz (Loorengs 500); non possunt ultra XL dies morari London before 1215 p. 725. ‘For centuries these regulations remained in force on paper; cf. Libell of Engl. policye ed. Hertzberg and Pauli 460 ff.; Munim. Gildh. I 160’; Höhlbaum Hans. Urkb. III p. 383{5}; in MS Douai the 40 days are called quarentena, ibid. p. 384. The Leges Angl. s. XIII. in. Lond. collectae p. 13 attribute the prohibition to Ine: Mercatores perhendinare possunt per spacium 40 dierum per [Britanniae] portus, nisi uento uel infirmitate uel legitimis causis impediantur. Cf. Schanz Handelspolitik I 383. 388. 395</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9-1.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">nisi eum impediat morbus aut debitum <hi rend="italic">u. s. w. fügt zu Cons.</hi> 716; si maladie de corps ne li desturbe ou s’il ne atende dette <hi rend="italic">Ord</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cons. 716 adds nisi eum impediat morbus aut debitum etc.; si maladie de corps ne li desturbe ou s’il ne atende dette Ord</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">-uid <hi rend="italic">Pl;</hi> q; <hi rend="italic">S, was</hi> quem [<hi rend="italic">falsch</hi>] <hi rend="italic">auflöste Thorpe</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uid Pl; q; S, which Thorpe expanded [wrongly] as quem</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9-1.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9-1.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Ai; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Ai; omitted in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9-1.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">facere <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">facere Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9-1.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">-dum. Nequid <hi rend="italic">Ai</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dum. Nequid Ai</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9-1.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9-1.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">quam <hi rend="italic">bis Ende fehlt PlS</hi></seg><seg type="translation" xml:lang="en" source="#claude">quam to the end omitted in PlS</seg></note>
      </div>
