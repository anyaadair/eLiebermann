    <body>
      <div type="clause" n="50.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 50.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="50.1" corresp="#wit-e"><pb n="80" ed="#liebermann"/>Monnes cinban<ptr type="liebermannNote" n="25" target="#Af_50-1.lnote.oe.25"/>, gif hit bið toclofen, geselle<ptr type="liebermannNote" n="26" target="#Af_50-1.lnote.oe.26"/> mon XII<ptr type="liebermannNote" n="27" target="#Af_50-1.lnote.oe.27"/> scill. to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="50.1" corresp="#wit-h"><pb n="80" ed="#liebermann"/>Monnes<ptr type="liebermannNote" n="4" target="#Af_50-1.lnote.oe.4"/> cínbán<ptr type="liebermannNote" n="11" target="#Af_50-1.lnote.oe.11"/>, gif hit bið toclofen, gesylle<ptr type="liebermannNote" n="12" target="#Af_50-1.lnote.oe.12"/> mon XII scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="50.1" corresp="#wit-b-no-prol"><pb n="80" ed="#liebermann"/>Monnes cinban, gyf hit bið toclofen, gesylle mon twelf scill' to bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="50.1" corresp="#wit-q"><pb n="81" ed="#liebermann"/>Si quis homini<ptr type="liebermannNote" n="22" target="#Af_50-1.lnote.oe.22"/> mentum frangat, duodecim<ptr type="liebermannNote" n="23" target="#Af_50-1.lnote.oe.23"/> sol. componat.<ptr type="liebermannNote" n="24" target="#Af_50-1.lnote.oe.24"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="86" ed="#attenborough"/>Monnes cinban, gif hit bið toclofen, geselle mon XII scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="54" corresp="#wit-e"><pb n="352" ed="#jurasinski-and-oliver"/>Monnes cinban, gif hit bið toclofen, geselle mon XII scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="81" ed="#liebermann"/>Eines Menschen Kinnbein<ptr type="liebermannNote" n="1" target="#Af_50-1.lnote.de.1"/>, wenn es zerspalten wird: zahle man 12 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">A person’s chin-bone, if it is split: let 12 shillings be paid as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="87" ed="#attenborough"/>If a man's chin-bone is broken in two, 12 shillings shall be given as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="353" ed="#jurasinski-and-oliver"/>A person’s chinbone, if it is shattered, let him be paid 12 shillings as compensation.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50-1.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">Man. cinn. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Man. cinn. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50-1.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">gesylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gesylle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50-1.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">twelf <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">twelf Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> cinn.</seg><seg type="translation" xml:lang="en" source="#claude">altered to cinn.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">ge <hi rend="italic">übergeschr.</hi>, y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">ge written above, y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50-1.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">mentum alii <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">mentum alii Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">co. XII s. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">co. XII s. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50-1.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">emendet <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">emendet Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_50-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Aus Abt 50; <hi rend="italic">vgl. Gl</hi> Kinn</seg><seg type="translation" xml:lang="en" source="#claude">From Abt 50; <hi rend="italic">cf. Gl</hi> Kinn</seg></note>
      </div>
