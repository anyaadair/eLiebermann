        <head><ref type="lawCode" target="law:Hn">Hn</ref> 76.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 76.5" corresp="#wit-lat"><pb n="593" ed="#liebermann"/>A<ptr type="liebermannNote" n="n" target="#Hn_76-5.lnote.oe.n"/> die illa qua wera uadiata est in uicesimum unum diem debet<ptr type="liebermannNote" n="36" target="#Hn_76-5.lnote.oe.36"/> (hoc<ptr type="liebermannNote" n="37" target="#Hn_76-5.lnote.oe.37"/>) halsfangum<ptr type="liebermannNote" n="34" target="#Hn_76-5.lnote.oe.34"/> reddi; inde<ptr type="liebermannNote" n="38" target="#Hn_76-5.lnote.oe.38"/> in XX unam noctem reddatur<ptr type="liebermannNote" n="39" target="#Hn_76-5.lnote.oe.39"/> manbota; inde in XX unam noctem fyhtƿite<ptr type="liebermannNote" n="40" target="#Hn_76-5.lnote.oe.40"/>; inde in XX<ptr type="liebermannNote" n="41" target="#Hn_76-5.lnote.oe.41"/> unam noctem ipsius were primum<ptr type="liebermannNote" n="12" target="#Hn_76-5.lnote.oe.12"/> gildum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 593 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-5.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 76, 7<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 76, 7<hi rend="italic">b</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-5.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-5.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de">halfang <hi rend="italic">Sc Hg;</hi> halfhang <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">halfang <hi rend="italic">Sc Hg;</hi> halfhang <hi rend="italic">Lond</hi></seg></note>
