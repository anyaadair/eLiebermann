      <div type="clause" n="3">
        <head><ref type="lawCode" target="law:IudDeiXIV">Iud Dei XIV</ref> 3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIV 3" corresp="#wit-lat"><pb n="425" ed="#liebermann"/>Oratio<ptr type="liebermannNote" n="31" target="#IudDeiXIV_3.lnote.oe.31"/>. Deus<ptr type="liebermannNote" n="32" target="#IudDeiXIV_3.lnote.oe.32"/>, qui liberasti Moysen<ptr type="liebermannNote" n="33" target="#IudDeiXIV_3.lnote.oe.33"/> de terra Ęgypti, Dauid de manu Saul regis, Ionam de uentre caeti, Petrum de uinculis, Paulum de fluctibus<ptr type="liebermannNote" n="34" target="#IudDeiXIV_3.lnote.oe.34"/>, Susannam de falso crimine, tres pueros de camino ignis ardentis<ptr type="liebermannNote" n="35" target="#IudDeiXIV_3.lnote.oe.35"/>, Danielem de lacu leonum, paralyticum de grabato<ptr type="liebermannNote" n="36" target="#IudDeiXIV_3.lnote.oe.36"/>, Lazarum de monumento,</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Ion. 2, 2; Dan. 3, 93; Marc. 2, 4</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 425 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_3.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Ma Tr;</hi> Alia <hi rend="italic">Ei Bb; fehlt Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Ma Tr; Alia Ei Bb; omitted in Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_3.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ähnlich Zeu.</hi> 630. 632. 666. 669 <hi rend="italic">f.</hi> 687 <hi rend="italic">f.</hi> 692</seg><seg type="translation" xml:lang="en" source="#claude">similarly Zeu. 630. 632. 666. 669 f. 687 f. 692</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_3.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">et Aaron <hi rend="italic">fügt zu Bb</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Aaron added in Bb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_3.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">-ctu <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ctu Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_3.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">-nte <hi rend="italic">Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nte Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_3.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">grabb. <hi rend="italic">Ma;</hi> -atto <hi rend="italic">Bb</hi></seg><seg type="translation" xml:lang="en" source="#claude">grabb. Ma; -atto Bb</seg></note>
