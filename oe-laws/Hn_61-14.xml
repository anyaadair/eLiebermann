      <div type="clause" n="61.14">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 61.14</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 61.14" corresp="#wit-lat"><pb n="582" ed="#liebermann"/>De omnibus et quibuscunque causis communibus<ptr type="liebermannNote" n="d" target="#Hn_61-14.lnote.oe.d"/> uel emendabilibus inplacitetur aliquis, si petierit, debet habere terminum requirendi et habendi<ptr type="liebermannNote" n="e" target="#Hn_61-14.lnote.oe.e"/> dominum suum, ubicunque sit<ptr type="liebermannNote" n="16" target="#Hn_61-14.lnote.oe.16"/>, ex competenti: modus enim in omnibus.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 582 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-14.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">nicht criminell</seg><seg type="translation" xml:lang="en" source="#claude">not criminal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-14.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 52, 1<hi rend="italic">b</hi>. 61, 16 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 52, 1<hi rend="italic">b</hi>. 61, 16 <hi rend="italic">f.</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-14.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">fit <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">fit Co Or</seg></note>
