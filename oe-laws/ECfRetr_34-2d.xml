    <body>
      <div type="clause" n="34.2d">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 34.2d</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 34.2d"><pb n="663" ed="#liebermann"/>Quo <hi rend="bold">defuncto,</hi> Haraldus<ptr type="liebermannNote" n="15" target="#ECfRetr_34-2d.lnote.la.15"/><ptr type="liebermannNote" n="*" target="#ECfRetr_34-2d.lnote.la.star"/>, falso<ptr type="liebermannNote" n="16" target="#ECfRetr_34-2d.lnote.la.16"/> pene<ptr type="liebermannNote" n="17" target="#ECfRetr_34-2d.lnote.la.17"/> ab omnibus putatus filius<ptr type="liebermannNote" n="18" target="#ECfRetr_34-2d.lnote.la.18"/>, successit<ptr type="liebermannNote" n="19" target="#ECfRetr_34-2d.lnote.la.19"/> et quinque annis regnauit††.</ab>
        <note type="comparison" source="#liebermann" n="663"><label>printed alongside</label> <ref target="clause:ECf_34-2d">ECf 34.2d</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 663 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">Liebermann prints “††” and gives in the outer margin of the ECf retr column the dates ††1035–39.</note>
        <note type="editorial">The note (*) is printed across the whole page; given with both columns.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2d.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">Harefot (Herewod <hi rend="italic">K</hi>), filius Chnuti et Elwyne <hi rend="italic">Lond;</hi> Haral. <hi rend="italic">S Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Harefot (Herewod K), filius Chnuti et Elwyne Lond; Haral. S Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2d.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Cnuts Vaterschaft bezweifeln</hi> Ann. Anglosax., Flor., Encom. Emmae</seg><seg type="translation" xml:lang="en" source="#claude">Cnut’s paternity is doubted by the Ann. Anglosax., Florence, and the Encom. Emmae</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2d.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielmehr</hi> IV</seg><seg type="translation" xml:lang="en" source="#claude">rather IV</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2d.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">Harol. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">Harol. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2d.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond;</hi> f. p. <hi rend="italic">fehlt Hv, wo</hi> illius</seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond; f. p. lacking in Hv, where illius</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2d.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Cb;</hi> fi. (pius <hi rend="italic">Lb Va Ph</hi>) pe. ab o. pu. s. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Cb; fi. (pius Lb Va Ph) pe. ab o. pu. s. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2d.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus K Co; fehlt Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">from K Co; lacking in Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2d.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">regnum suscepit <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">regnum suscepit Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">When he had died, Harold, falsely thought by almost everyone to be [his] son, succeeded and reigned five years††.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2d.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">349</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Haraldus</hi><hi rend="superscript">15</hi> <hi rend="italic">Herewod, f. C. et Eluiue</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Haraldus</hi><hi rend="superscript">15</hi> <hi rend="italic">Herewod, f. C. et Eluiue</hi> Rs</seg></note>
      </div>
    </body>
