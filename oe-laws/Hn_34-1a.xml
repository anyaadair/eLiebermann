      <div type="clause" n="34.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 34.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 34.1a" corresp="#wit-lat"><pb n="565" ed="#liebermann"/>In Denelaga: lahslite<ptr type="liebermannNote" n="26" target="#Hn_34-1a.lnote.oe.26"/>, nisi super sancta iurare poterit, quod melius<ptr type="liebermannNote" n="27" target="#Hn_34-1a.lnote.oe.27"/> et rectius nesciuit, siue in comitatu uel quouis placito regis fiat, de sua uel alterius causa, uel inter compares in curiis uel diuisis<ptr type="liebermannNote" n="o" target="#Hn_34-1a.lnote.oe.o"/> uel locis suis uel inter dominum et hominem suum: ubique<ptr type="liebermannNote" n="28" target="#Hn_34-1a.lnote.oe.28"/> sit interdictum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 565 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1a.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 9, 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 9, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1a.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">-slutes <hi rend="italic">Sc Hg;</hi> lathlite <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-slutes <hi rend="italic">Sc Hg;</hi> lathlite <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1a.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">r. et m. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. et m. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1a.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">utrique <hi rend="italic">Sc Hg;</hi> utique sit interdum <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">utrique <hi rend="italic">Sc Hg;</hi> utique sit interdum <hi rend="italic">Wh</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de">Am Rande spät: <hi rend="italic">Nota, ignoranciam posse excusare iusticiariis</hi> [!] <hi rend="italic">super voluntariis iudiciis</hi> Rs. Notiere als Quelle rechts: <hi rend="italic">ebd</hi>. 15, 1a und bessere die Interpunktion: setze <hi rend="italic">In Den</hi>. bis <hi rend="italic">nescivit</hi> als Parenthese.—<hi rend="italic">Vgl. Gl</hi> Gerechtigkeit 6; Gericht 11b.—<hi rend="italic">lahlites</hi>{26}—<hi rend="italic">re. et me</hi>.{27} Rs</seg><seg type="translation" xml:lang="en" source="#claude">In the margin, in a late hand: <hi rend="italic">Nota, ignoranciam posse excusare iusticiariis</hi> [!] <hi rend="italic">super voluntariis iudiciis</hi> Rs. Note as the source, on the right: <hi rend="italic">ibid</hi>. 15, 1a, and correct the punctuation: put <hi rend="italic">In Den</hi>. to <hi rend="italic">nescivit</hi> in parentheses.—<hi rend="italic">Cf. Gl</hi> Gerechtigkeit 6; Gericht 11b.—<hi rend="italic">lahlites</hi>{26}—<hi rend="italic">re. et me</hi>.{27} Rs</seg></note>
      </div>
