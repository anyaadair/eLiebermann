      <div type="clause" n="12.8">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 12.8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 12.8"><pb n="639" ed="#liebermann"/>Si <hi rend="bold">uero</hi> molendina<ptr type="liebermannNote" n="12" target="#ECfRetr_12-8.lnote.la.12"/>, piscaria uel alia quelibet opera <hi rend="bold">eis impedimentum facientia</hi> preparentur<ptr type="liebermannNote" n="13" target="#ECfRetr_12-8.lnote.la.13"/>, opera ipsa <hi rend="bold">protinus</hi><ptr type="liebermannNote" n="14" target="#ECfRetr_12-8.lnote.la.14"/> destruantur, <hi rend="bold">et</hi> chimini<ptr type="liebermannNote" n="15" target="#ECfRetr_12-8.lnote.la.15"/> et aque, <hi rend="bold">ut</hi><ptr type="liebermannNote" n="16" target="#ECfRetr_12-8.lnote.la.16"/> <hi rend="bold">fuerunt primitus,</hi> reparentur<ptr type="liebermannNote" n="17" target="#ECfRetr_12-8.lnote.la.17"/>; et forisfactura regis <hi rend="bold">non obliuiscatur.</hi></ab>
        <note type="comparison" source="#liebermann" n="639"><label>printed alongside</label> <ref target="clause:ECf_12-8">ECf 12.8</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 639 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-8.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds uel</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-8.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">-rantur <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rantur Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-8.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">penitus <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">penitus Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-8.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">chem. <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">chem. Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-8.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">ubi fuerint prius <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">ubi fuerint prius Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-8.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">raperentur <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">raperentur Ph</seg></note>
      </div>
