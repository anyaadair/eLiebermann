      <div type="clause" n="El. 47">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 47</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 47" corresp="#wit-e"><pb n="42" ed="#liebermann"/>Þam elðeodegan<ptr type="liebermannNote" n="1" target="#Af_El-to-47.lnote.oe.1"/> ⁊ utan cumenan ne læt ðu no<ptr type="liebermannNote" n="2" target="#Af_El-to-47.lnote.oe.2"/> uncuðlice<ptr type="liebermannNote" n="3" target="#Af_El-to-47.lnote.oe.3"/> wið hine, ne mid nanu<hi rend="italic">m</hi> unryhtu<hi rend="italic">m<ptr type="liebermannNote" n="4" target="#Af_El-to-47.lnote.oe.4"/></hi> þu hine ne drece.<ptr type="liebermannNote" n="5" target="#Af_El-to-47.lnote.oe.5"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 47" corresp="#wit-g-prol-only"><pb n="42" ed="#liebermann"/>Þam ælþeodegan ⁊ utan cymenan ne læt ðú ná úncuðlice wiþ ðone, ne mid nánum únrihtu<hi rend="italic">m</hi> þu hine ne drecce.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 47" corresp="#wit-h"><pb n="43" ed="#liebermann"/>Ðam ælþeodigan<ptr type="liebermannNote" n="1" target="#Af_El-to-47.lnote.oe.1-2"/> ⁊ uton<ptr type="liebermannNote" n="2" target="#Af_El-to-47.lnote.oe.2-2"/> cumenan ne læt ðu no<ptr type="liebermannNote" n="2" target="#Af_El-to-47.lnote.oe.2-2"/> uncuþlice wið hine, ne mid nanum unryhtum ðu hine ne drece.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 47" corresp="#wit-q"><pb n="43" ed="#liebermann"/>Peregrino molestus non eris<ptr type="liebermannNote" n="1" target="#Af_El-to-47.lnote.oe.1-3"/>, quia ipsi peregrini fuistis in terra Egypti.<ptr type="liebermannNote" n="2" target="#Af_El-to-47.lnote.oe.2-3"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 47" corresp="#wit-e"><pb n="260" ed="#jurasinski-and-oliver"/>Þam elðeodegan ⁊ utan cumenan ne læt ðu no uncuðlice wið hine, ne mid nanu<hi rend="italic">m</hi> unryhtu<hi rend="italic">m</hi> þu hine ne drece.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="43" ed="#liebermann"/>Dem<ptr type="liebermannNote" n="1" target="#Af_El-to-47.lnote.de.1"/> Fremden und von auswärts Gekommenen gegenüber benimm<ptr type="liebermannNote" n="2" target="#Af_El-to-47.lnote.de.2"/> du dich nicht unfreundlich, und belästige du ihn mit keinen Ungerechtigkeiten.<ptr type="liebermannNote" n="3" target="#Af_El-to-47.lnote.de.3"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Towards the foreigner and one who has come from outside do not behave unkindly, and do not trouble him with any injustices.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="261" ed="#jurasinski-and-oliver"/>The foreigner and he who has come from afar – do not deal unkindly with him, nor may you afflict him with wrongs.</ab>
        <note type="passageSource">Exodus 23,9</note>
        <note type="comparison" source="#liebermann" n="43">Exodus 23.9</note>
        <note type="comparisonPrinted" source="#liebermann">[Exodus 23, 9]</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_35-1">II Cn 35.1</ref></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="261"><label>related provision</label> <ref target="clause:Ine_20">Ine 20</ref> <quote>Ine §20 deals with "a person who has come from far off or a stranger" who is to be regarded as a thief if he strays off the road</quote></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="385"><label>cf.</label> <ref target="clause:Ine_20">Ine 20</ref> <quote>MP §47 suggests that the problem was the stealthy approach and not simply mistrust of outsiders</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-47.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">42</biblScope></bibl><seg type="original" xml:lang="de">ælþeodigan <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ælþeodigan So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-47.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">42</biblScope></bibl><seg type="original" xml:lang="de">na <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">na So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-47.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">42</biblScope></bibl><seg type="original" xml:lang="de">-lic <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lic So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-47.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">42</biblScope></bibl><seg type="original" xml:lang="de">-rih. <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rih. So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-47.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">42</biblScope></bibl><seg type="original" xml:lang="de">drecce <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">drecce Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-47.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">43</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-47.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">43</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-47.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">43</biblScope></bibl><seg type="original" xml:lang="de">scitis enim aduenarum animas <hi rend="italic">fügt Vulg. zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">scitis enim aduenarum animas added by Vulg.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-47.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">43</biblScope></bibl><seg type="original" xml:lang="de">Egipti <hi rend="italic">R. Es folgt Ex.</hi> 23,10<hi rend="italic">ff. in Vulg.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Egipti R. Ex. 23,10ff. follows in Vulg.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-47.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">47</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o.</hi> 33¹</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 33¹</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-47.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">47</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘Auswärtigen lasse nicht unberichtet’ Schmid. <hi rend="italic">Lætan</hi> aber heisst (md. <hi rend="italic">lâzen</hi>) ‘sich gebärden’ (Toller 613b V; Grein <hi rend="italic">Glossar</hi> 165, 4); <hi rend="italic">uncouth</hi> noch ‘seltsam, unheimlich’</seg><seg type="translation" xml:lang="en" source="#claude">‘leave not the foreigner uninformed’ Schmid. But <hi rend="italic">lætan</hi> (Middle German <hi rend="italic">lâzen</hi>) means ‘to behave’ (Toller 613b V; Grein <hi rend="italic">Glossar</hi> 165, 4); <hi rend="italic">uncouth</hi> still means ‘strange, uncanny’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-47.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">47</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Hier, anders als o. 33³, bleibt Ägypten fort. Ebenso die Ruhe fürs Saatland im 7. Jahre, für Vieh und Knecht am 7. Tage; über letzteren <hi rend="italic">o.</hi> El 3³</seg><seg type="translation" xml:lang="en" source="#claude">Here, unlike above 33³, Egypt is left out. So too the rest for the sown land in the 7th year, and for cattle and servant on the 7th day; on the latter <hi rend="italic">above</hi> El 3³</seg></note>
      </div>
