      <div type="clause" n="89.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 89.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 89.3" corresp="#wit-lat"><pb n="605" ed="#liebermann"/>Liber qui se uadii loco in alterius potestate commiserit et ibi constitutus dampnum aliquod<ptr type="liebermannNote" n="14" target="#Hn_89-3.lnote.oe.14"/> cuilibet fecerit: [qui<ptr type="liebermannNote" n="15" target="#Hn_89-3.lnote.oe.15"/>] eum in locum uadii suscepit aut dampnum soluat aut hominem<ptr type="liebermannNote" n="16" target="#Hn_89-3.lnote.oe.16"/> in mallo<ptr type="liebermannNote" n="17" target="#Hn_89-3.lnote.oe.17"/> productum dimittat, perdens<ptr type="liebermannNote" n="c" target="#Hn_89-3.lnote.oe.c"/> simul<ptr type="liebermannNote" n="18" target="#Hn_89-3.lnote.oe.18"/> debitum, propter quod eum in uadio suscepit<ptr type="liebermannNote" n="19" target="#Hn_89-3.lnote.oe.19"/>; et qui dampnum fecit, dimissus<ptr type="liebermannNote" n="20" target="#Hn_89-3.lnote.oe.20"/> iuxta qualitatem culpe cogatur emendare.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 605 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_89-3.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Gläubiger verliert, falls er nicht für die spätere Schuld des Selbstverknechteten haften will, den Anspruch auf ihn auch nach</hi> Ine 62</seg><seg type="translation" xml:lang="en" source="#claude">the creditor, if he is unwilling to be liable for the later debt of the man who has enslaved himself, loses his claim on him, also according to Ine 62</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_89-3.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">al. — dampnum <hi rend="italic">überspringt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">Sc Hg skip al. — dampnum</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_89-3.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">in e. quem in <hi rend="italic">Hss.; gebessert Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">in e. quem in MSS; corrected by Tho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_89-3.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">in malo aut <hi rend="italic">fügt zu Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">Sc Hg add in malo aut</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_89-3.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">malo <hi rend="italic">Lond Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">malo Lond Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_89-3.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">suum <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">suum K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_89-3.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">-perit <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-perit Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_89-3.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">dem. <hi rend="italic">Edd.; Capit.</hi></seg><seg type="translation" xml:lang="en" source="#claude">dem. Edd.; Capit.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_89-3.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. 4f—<hi rend="italic">qui</hi>{15} fehlt—<hi rend="italic">in eum quem in l</hi>.—89, 3a <hi rend="italic">-uit</hi>{22} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. 4f—<hi rend="italic">qui</hi>{15} missing—<hi rend="italic">in eum quem in l</hi>.—89, 3a <hi rend="italic">-uit</hi>{22} Rs</seg></note>
      </div>
