      <div type="clause" n="6.2a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 6.2a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 6.2a" corresp="#wit-lat"><pb n="552" ed="#liebermann"/>preter<ptr type="liebermannNote" n="l" target="#Hn_6-2a.lnote.oe.l"/> [hoc<ptr type="liebermannNote" n="23" target="#Hn_6-2a.lnote.oe.23"/>] tremendum regie maiestatis<ptr type="liebermannNote" n="24" target="#Hn_6-2a.lnote.oe.24"/> titulamus<ptr type="liebermannNote" n="25" target="#Hn_6-2a.lnote.oe.25"/> imperium, quod preesse iugiter<ptr type="liebermannNote" n="m" target="#Hn_6-2a.lnote.oe.m"/> legibus<ptr type="liebermannNote" n="26" target="#Hn_6-2a.lnote.oe.26"/> ac salubriter frequentamus<ptr type="liebermannNote" n="27" target="#Hn_6-2a.lnote.oe.27"/> (celebramus) aduertendum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 552 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-2a.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> super 9, 10<hi rend="italic">a</hi>: ‘ausser und über den drei Volksrechten zeichnen wir das königliche Bannrecht aus’</seg><seg type="translation" xml:lang="en" source="#claude">cf. super 9, 10a: ‘besides and above the three folk-laws we distinguish the king's right of ban’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-2a.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">iug. ac sa. fr. adu. <hi rend="italic">auch</hi> 83, 1; <hi rend="italic">zu</hi> celebrare <hi rend="italic">vgl.</hi> Quadr. Arg. 2</seg><seg type="translation" xml:lang="en" source="#claude">iug. ac sa. fr. adu. also 83, 1; for celebrare cf. Quadr. Arg. 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-2a.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so K, fehlt Sc Hg Co Or Wh Tho.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so K, lacking in Sc Hg Co Or Wh Tho.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-2a.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">mages. <hi rend="italic">K Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">mages. K Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-2a.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">titisl. <hi rend="italic">Edd., gegen alle Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">titisl. edd., against all MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-2a.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">legimus <hi rend="italic">Lond Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">legimus Lond edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-2a.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">fr. <hi rend="italic">Co Or Gi;</hi> frequenteramus <hi rend="italic">K;</hi> cel. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">fr. Co Or Gi; frequenteramus K; cel. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-2a.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">315</biblScope></bibl><seg type="original" xml:lang="de">‘Banngewalt, Befehl im Verwaltungswege’ des Königs (<hi rend="italic">s. d. Gl</hi> 15; Königsgericht 13), nicht bloss (mit Pol Mai I 85f.) Billigkeitsjustiz der Curia regis.—<hi rend="italic">hec</hi>{28}—<hi rend="italic">fr</hi>.{27} <hi rend="italic">adu</hi>. ohne <hi rend="italic">ecl</hi>. Rs</seg><seg type="translation" xml:lang="en" source="#claude">The king’s ‘power of ban, command by administrative process’ (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 15; Königsgericht 13), not merely (with Pol Mai I 85f.) equitable jurisdiction of the Curia regis.—<hi rend="italic">hec</hi>{28}—<hi rend="italic">fr</hi>.{27} <hi rend="italic">adu</hi>. without <hi rend="italic">ecl</hi>. Rs</seg></note>
      </div>
    </body>
