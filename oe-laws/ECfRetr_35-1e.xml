  <text>
    <body>
      <div type="clause" n="35.1e">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 35.1e</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 35.1e"><pb n="665" ed="#liebermann"/>Unde<ptr type="liebermannNote" n="24" target="#ECfRetr_35-1e.lnote.la.24"/> etiam Occidentales Saxones<ptr type="liebermannNote" n="25" target="#ECfRetr_35-1e.lnote.la.25"/>, scilicet<ptr type="liebermannNote" n="26" target="#ECfRetr_35-1e.lnote.la.26"/> Execestrenses<ptr type="liebermannNote" n="27" target="#ECfRetr_35-1e.lnote.la.27"/>, habent in prouerbio summi despectus hinderling<ptr type="liebermannNote" n="28" target="#ECfRetr_35-1e.lnote.la.28"/>, id est ab<ptr type="liebermannNote" n="29" target="#ECfRetr_35-1e.lnote.la.29"/> omni honestate<ptr type="liebermannNote" n="30" target="#ECfRetr_35-1e.lnote.la.30"/> deiectum<ptr type="liebermannNote" n="31" target="#ECfRetr_35-1e.lnote.la.31"/> <hi rend="bold">uel retrocedens</hi><ptr type="liebermannNote" n="i" target="#ECfRetr_35-1e.lnote.la.fn.i"/> <hi rend="bold">imago.</hi></ab>
        <note type="comparison" source="#liebermann" n="665"><label>printed alongside</label> <ref target="clause:ECf_35-1e">ECf 35.1e</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 665 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35-1e.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">das Suffix ist in</hi> æþeling <hi rend="italic">nur</hi> -ing <hi rend="italic">nicht (wie in</hi> hinderling) -ling; <hi rend="italic">den Irrthum des Verfassers veranlasste vielleicht</hi> [ge]lic: similitudo <hi rend="italic">oder</hi> likning: Abbild. <hi rend="italic">Da Verf. damaliges</hi> hinderling (entartet, niedrig, unecht), <hi rend="italic">das auch bei Orm vorkommt, aus Exeter citirt, so hörte er dort Gebürtige; es lebt noch in Devonshire.</hi></seg><seg type="translation" xml:lang="en" source="#claude">the suffix in æþeling is only -ing, not (as in hinderling) -ling; the author’s error was perhaps caused by [ge]lic: similitudo, or likning: image. Since the author quotes the hinderling of his day (degenerate, base, spurious), which also occurs in Orm, from Exeter, he heard people born there; it still lives in Devonshire.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35-1e.lnote.la.fn.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Retr. denkt irrig an</hi> hind (rückwärts) <hi rend="italic">oder</hi> hinder (hinterer)</seg><seg type="translation" xml:lang="en" source="#claude">the Retr. wrongly thinks of hind (backwards) or hinder (rear)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35-1e.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">am Rande</hi> Quid sit hinderling <hi rend="italic">roth Cb;</hi> U. et <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">in the margin Quid sit hinderling in red Cb; U. et Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35-1e.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">-ni <hi rend="italic">Cb;</hi> -nidi <hi rend="italic">Lb K;</hi> -nidj <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ni Cb; -nidi Lb K; -nidj Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35-1e.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35-1e.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">Exces. <hi rend="italic">Va;</hi> Cestr. <hi rend="italic">Hv;</hi> Exceces. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Exces. Va; Cestr. Hv; Exceces. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35-1e.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">edeling <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">edeling Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35-1e.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35-1e.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">potestate <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">potestate Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35-1e.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">-tus <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tus Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Whence also the West Saxons, namely the men of Exeter, have as a proverb of the utmost contempt <hi rend="italic">hinderling</hi>, that is, one cast down from all honour, or a backward-going image.</ab>
      </div>
    </body>
  </text>
