    <body>
      <div type="clause" n="19.1">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 19.1</head>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-hk"><ptr type="liebermannNote" n="a" target="#LeisWl_19-1.lnote.oe.a"/><pb n="504–505" ed="#liebermann"/>. . . . . . . . . . . . . . . .</ab>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-i"><pb n="504–505" ed="#liebermann"/>E si la pur[n]ele<ptr type="liebermannNote" n="29" target="#LeisWl_19-1.lnote.oe.29"/> i est remis<ptr type="liebermannNote" n="l" target="#LeisWl_19-1.lnote.oe.l"/>, si ne rendra lui<ptr type="liebermannNote" n="m" target="#LeisWl_19-1.lnote.oe.m"/> que la meité.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="504–505" ed="#liebermann"/>Quodsi pupilla forte remanserit, dabit dimidium tanti.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="19.1" corresp="#wit-i"><pb n="262" ed="#robertson"/>E si la pur[n]ele i est remis, si ne rendra lui que la meité.]</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="504–505" ed="#liebermann"/>19, 1. Wenn jedoch der Augapfel<ptr type="liebermannNote" n="1" target="#LeisWl_19-1.lnote.de.1"/> darin geblieben<ptr type="liebermannNote" n="2" target="#LeisWl_19-1.lnote.de.2"/> ist, so braucht er ihm nur die Hälfte zu geben.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">19, 1. If, however, the eyeball has remained in it, then he need give him only half.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-i"><pb n="263" ed="#robertson"/>And if [he destroys the sight] without displacing the pupil, he shall pay only half that sum.]</ab>
        <note type="comparison" source="#liebermann" n="505"><ref target="clause:Af_47-1">Af 47.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 47, 1</note>
        <note type="editorial">Added October 2026 from Robertson pp. 262–263 (text and translation); 18.2–19.1 are from I (not in Hk) (Robertson).; Liebermann’s text and German translation added from Gesetze I p. 504–505, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_19-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze aus IL</hi></seg><seg type="translation" xml:lang="en" source="#claude">supply from IL</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_19-1.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">remese <hi rend="italic">bessert Littré, Dict. s. v.</hi> prunelle</seg><seg type="translation" xml:lang="en" source="#claude">remese emended by Littré, Dict. s. v. prunelle</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_19-1.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">schlechtes Französisch, nicht original SU.</hi></seg><seg type="translation" xml:lang="en" source="#claude">bad French, not original SU.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_19-1.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">purvele <hi rend="italic">I</hi></seg><seg type="translation" xml:lang="en" source="#claude">purvele <hi rend="italic">I</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_19-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">289</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. 2e; nicht ‘Sehkraft’ (Riley)</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. 2e; not ‘eyesight’ (Riley)</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_19-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">289</biblScope></bibl><seg type="original" xml:lang="de">nicht ‘restored, wiederhergestellt’ (Riley, Schmid), falsch von <hi rend="italic">remettre</hi> abgeleitet</seg><seg type="translation" xml:lang="en" source="#claude">not ‘restored, wiederhergestellt’ (Riley, Schmid), wrongly derived from <hi rend="italic">remettre</hi></seg></note>
      </div>
    </body>
