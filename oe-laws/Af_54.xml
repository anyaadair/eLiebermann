      <div type="clause" n="54">
        <head><ref type="lawCode" target="law:Af">Af</ref> 54</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="54" corresp="#wit-e"><pb n="82" ed="#liebermann"/>Gif se earm<ptr type="liebermannNote" n="1" target="#Af_54.lnote.oe.1"/> bið forad bufan<ptr type="liebermannNote" n="2" target="#Af_54.lnote.oe.2"/> elmbogan, þær<ptr type="liebermannNote" n="3" target="#Af_54.lnote.oe.3"/> sculon XV<ptr type="liebermannNote" n="4" target="#Af_54.lnote.oe.4"/> scill. to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="54" corresp="#wit-h"><pb n="82" ed="#liebermann"/>Gif se earm bið forod bufon<ptr type="liebermannNote" n="1" target="#Af_54.lnote.oe.1-2"/> (þæm<ptr type="liebermannNote" n="2" target="#Af_54.lnote.oe.2-2"/>) elbogan<ptr type="liebermannNote" n="3" target="#Af_54.lnote.oe.3-2"/>, þær sculon XV scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="54" corresp="#wit-b-no-prol"><pb n="82" ed="#liebermann"/>Gyf se earm bið forad bufan ðam elbogan, ðær sculon fiftyne scill' to bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="54" corresp="#wit-q"><pb n="83" ed="#liebermann"/>Si brachium homini fractum<ptr type="liebermannNote" n="1" target="#Af_54.lnote.oe.1-3"/> sit supra cubitum, XV solid.<ptr type="liebermannNote" n="2" target="#Af_54.lnote.oe.2-3"/> emendandum.<ptr type="liebermannNote" n="3" target="#Af_54.lnote.oe.3-3"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="88" ed="#attenborough"/>Gif se earm bið forad bufan elmbogan<ptr type="editorNote" n="3" target="#Af_54.attnote.fn.3"/>, þær sculon XV scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="58" corresp="#wit-e"><pb n="354" ed="#jurasinski-and-oliver"/>Gif se earm bið forad bufan elmbogan, þær sculon XV scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="83" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_54.lnote.de.1"/> der Arm<ptr type="liebermannNote" n="2" target="#Af_54.lnote.de.2"/> zerbrochen ist oberhalb des Ellenbogens, da gehören 15 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the arm is broken above the elbow, 15 shillings are due as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="89" ed="#attenborough"/>If the arm is fractured above the elbow, 15 shillings must be paid as compensation for it.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="355" ed="#jurasinski-and-oliver"/>If the arm is broken above the elbow, 15 shillings are due as compensation.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_54.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">earme <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">earme Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_54.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">fügt zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm added by Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_54.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">ðæs <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæs Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_54.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">fyftyne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fyftyne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_54.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_54.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_54.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rasur hinter</hi> el</seg><seg type="translation" xml:lang="en" source="#claude">erasure after el</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_54.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">sit fr. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit fr. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_54.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">est <hi rend="italic">fügt zu Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">est added by Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_54.lnote.oe.3-3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">-ndetur <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ndetur Lond</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_54.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Aus Abt 53a, wo 6 Kent. Schill. = 15 Westsä.</seg><seg type="translation" xml:lang="en" source="#claude">From Abt 53a, where 6 Kentish shill. = 15 West Saxon</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_54.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Arm 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Arm 2</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_54.attnote.fn.3" n="3" source="#attenborough"><bibl><biblScope unit="page">88</biblScope></bibl><label>elmbogan</label><seg type="original" xml:lang="en"><hi rend="italic">(þæm) elbogan</hi>. H*. <hi rend="italic">ðam elbogan</hi>. B.</seg></note>
      </div>
