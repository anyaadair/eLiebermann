      <div type="clause" n="14">
        <head><ref type="lawCode" target="law:ExcomI">Excom I</ref> 14</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom I 14" corresp="#wit-ti"><pb n="433" ed="#liebermann"/>Debent<ptr type="liebermannNote" n="q" target="#ExcomI_14.lnote.oe.q"/> autem<ptr type="liebermannNote" n="33" target="#ExcomI_14.lnote.oe.33"/> XII sacerdotes episcopum circumstare et lucernas<ptr type="liebermannNote" n="r" target="#ExcomI_14.lnote.oe.r"/> ardentes in manibus tenere, quas in conclusione anathematis uel excommunicationis proicere<ptr type="liebermannNote" n="s" target="#ExcomI_14.lnote.oe.s"/> debent in terra<ptr type="liebermannNote" n="34" target="#ExcomI_14.lnote.oe.34"/> et pedibus<ptr type="liebermannNote" n="35" target="#ExcomI_14.lnote.oe.35"/> conculcare<ptr type="liebermannNote" n="t" target="#ExcomI_14.lnote.oe.t"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 433 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_14.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Wasserschleben bemerkt zu Regino:</hi> ‘[Gratian] C. XI q 3 c. 106; correctores Romani adnotant ad hunc locum, caput nostrum in canonum quadam collectione incerti auctoris adscribi Zachariae [741—52] papae’. <hi rend="italic">Friedberg</hi> Decr. Gratiani <hi rend="italic">erklärt dieses Citat nicht.</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Wasserschleben remarks on Regino:</hi> ‘[Gratian] C. XI q 3 c. 106; correctores Romani adnotant ad hunc locum, caput nostrum in canonum quadam collectione incerti auctoris adscribi Zachariae [741—52] papae’. <hi rend="italic">Friedberg</hi> Decr. Gratiani <hi rend="italic">does not explain this citation.</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_14.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 11, 5. II 8. III 4. IV 8. V 9. VI 18. VII 23. VIII 4. IX 3. X 9. XI 10. XII 5. XIII 3. <hi rend="italic">Reg</hi> 416. <hi rend="italic">Alet Gem</hi> 1. 2 <hi rend="italic">Leo Rot Rem Sen</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 11, 5. II 8. III 4. IV 8. V 9. VI 18. VII 23. VIII 4. IX 3. X 9. XI 10. XII 5. XIII 3. <hi rend="italic">Reg</hi> 416. <hi rend="italic">Alet Gem</hi> 1. 2 <hi rend="italic">Leo Rot Rem Sen</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_14.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Reg</hi> 416</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf. Reg</hi> 416</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_14.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> VI 18</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> VI 18</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_14.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de">enim <hi rend="italic">einige Reg.-Hss. Vb</hi></seg><seg type="translation" xml:lang="en" source="#claude">enim <hi rend="italic">some Reg. MSS, Vb</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_14.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de">terram <hi rend="italic">Reg</hi></seg><seg type="translation" xml:lang="en" source="#claude">terram <hi rend="italic">Reg</hi></seg></note>
