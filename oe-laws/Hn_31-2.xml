      <div type="clause" n="31.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 31.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 31.2" corresp="#wit-lat"><pb n="564" ed="#liebermann"/>Si inter iudices<ptr type="liebermannNote" n="a" target="#Hn_31-2.lnote.oe.a"/> studia diuersa<ptr type="liebermannNote" n="1" target="#Hn_31-2.lnote.oe.1"/> sint, ut alii sic<ptr type="liebermannNote" n="2" target="#Hn_31-2.lnote.oe.2"/>, alii aliter fuisse<ptr type="liebermannNote" n="3" target="#Hn_31-2.lnote.oe.3"/> contendant, uincat sententia meliorum<ptr type="liebermannNote" n="b" target="#Hn_31-2.lnote.oe.b"/>, et cui iusticia<ptr type="liebermannNote" n="c" target="#Hn_31-2.lnote.oe.c"/> magis acquieuerit<ptr type="liebermannNote" n="4" target="#Hn_31-2.lnote.oe.4"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 564 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">Urtheilfinder; <hi rend="italic">vgl.</hi> 5, 6</seg><seg type="translation" xml:lang="en" source="#claude">Doomsmen; cf. 5, 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-2.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">der an Rang Höchsten. <hi rend="italic">Hier ist</hi> III Atr. 13, 2 <hi rend="italic">wohl nicht benutzt</hi></seg><seg type="translation" xml:lang="en" source="#claude">of those highest in rank. III Atr. 13, 2 has probably not been used here</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-2.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">königliche Gerichtshalter</seg><seg type="translation" xml:lang="en" source="#claude">the king’s presiding judge</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">-rss. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rss. <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. vom Corr. aus</hi> si <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the corrector from si Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">doppelt Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">written twice in Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. vom Corr. aus</hi> acquietauerit <hi rend="italic">Sc;</hi> adq. <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the corrector from acquietauerit Sc; adq. K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Urteilfinder 12.—31, 3 am Rande spät: <hi rend="italic">Nota, episcopos, comites et alios magnates debere sequi comitatus</hi> [‘Gerichtsfolge leisten zum Grafschaftsgericht’; <hi rend="italic">s. d. Gl</hi> 6 ff.]—<hi rend="italic">Int. de. co</hi>.{8} <hi rend="italic">ep</hi>. Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Urteilfinder 12. — 31, 3 in the margin, in a late hand: <hi rend="italic">Nota, episcopos, comites et alios magnates debere sequi comitatus</hi> [‘do suit at the shire court’; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 6 ff.] — <hi rend="italic">Int. de. co</hi>.{8} <hi rend="italic">ep</hi>. Rs</seg></note>
      </div>
