    <body>
      <div type="clause" n="22.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 22.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 22.2"><pb n="647" ed="#liebermann"/><ptr type="liebermannNote" n="41" target="#ECfRetr_22-2.lnote.la.41"/><hi rend="bold"><hi rend="spaced">Quid sit</hi></hi><ptr type="liebermannNote" n="32" target="#ECfRetr_22-2.lnote.la.32"/> <hi rend="bold"><hi rend="spaced">tol</hi></hi><ptr type="liebermannNote" n="42" target="#ECfRetr_22-2.lnote.la.42"/><hi rend="bold"><hi rend="spaced">.</hi></hi> Tol<ptr type="liebermannNote" n="43" target="#ECfRetr_22-2.lnote.la.43"/>, quod nos <hi rend="bold">dicimus</hi> theloneum<ptr type="liebermannNote" n="44" target="#ECfRetr_22-2.lnote.la.44"/>, <hi rend="bold">est</hi> scilicet<ptr type="liebermannNote" n="10" target="#ECfRetr_22-2.lnote.la.10"/>, <hi rend="bold">quod habet</hi><ptr type="liebermannNote" n="45" target="#ECfRetr_22-2.lnote.la.45"/> libertatem uendendi et<ptr type="liebermannNote" n="46" target="#ECfRetr_22-2.lnote.la.46"/> emendi in terra sua.</ab>
        <note type="comparison" source="#liebermann" n="647"><label>printed alongside</label> <ref target="clause:ECf_22-2">ECf 22.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 647 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-2.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">neben</hi> Freiheit vom Zoll am Markt auf eigenem Boden <hi rend="italic">auch</hi> Empfang dieses Zolls</seg><seg type="translation" xml:lang="en" source="#claude">besides freedom from toll at the market on one’s own land, also the receipt of this toll</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-2.lnote.la.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">De thol <hi rend="italic">Sp Co; nur</hi> Thol <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">De thol Sp Co; only Thol K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-2.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">est <hi rend="italic">Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">est Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-2.lnote.la.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">toll <hi rend="italic">Cb;</hi> thol <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">toll Cb; thol Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-2.lnote.la.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">toll <hi rend="italic">Cb;</hi> Thol <hi rend="italic">K Sp;</hi> Thol q. dicitur <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">toll Cb; Thol K Sp; Thol q. dicitur Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-2.lnote.la.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">-nium <hi rend="italic">Sp;</hi> theolon. <hi rend="italic">Wi;</hi> thol. <hi rend="italic">Ph;</hi> tel. est qui h. potestatem u. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nium Sp; theolon. Wi; thol. Ph; tel. est qui h. potestatem u. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-2.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-2.lnote.la.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">habeat <hi rend="italic">Cb Lb Sp Wi Ph Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">habeat Cb Lb Sp Wi Ph Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-2.lnote.la.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">et em. <hi rend="italic">fehlt Lb Va Wi L Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">et em. lacking in Lb Va Wi L Ph</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">What toll is. Toll, which we call <hi rend="italic">theloneum</hi>, is namely that he has the liberty of selling and buying in his land.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-2.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">thelonium</hi><hi rend="superscript">44</hi> — <hi rend="italic">habeat</hi><hi rend="superscript">45</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">thelonium</hi><hi rend="superscript">44</hi> — <hi rend="italic">habeat</hi><hi rend="superscript">45</hi> Rs</seg></note>
      </div>
    </body>
  </text>
