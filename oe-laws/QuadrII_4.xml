    <body>
      <div type="clause" n="4">
        <head><ref type="lawCode" target="law:QuadrII">Quadr II</ref> 4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr II 4" corresp="#wit-lat"><ptr type="liebermannNote" n="10" target="#QuadrII_4.lnote.oe.10"/><pb n="544" ed="#liebermann"/>Idem rex et<ptr type="liebermannNote" n="11" target="#QuadrII_4.lnote.oe.11"/> dominus noster ita scripsit apostolico Paschali<ptr type="liebermannNote" n="12" target="#QuadrII_4.lnote.oe.12"/> de inuestituris ecclesiarum et datione baculorum, unde iam pridem, a diebus Willelmi<ptr type="liebermannNote" n="b" target="#QuadrII_4.lnote.oe.b"/>, fratris eius, agebatur cum beatissimo Cantuariorum archiepiscopo Anselmo, pro quo tot incommoda sustinere, tot pro nomine Ihesu contumelias<ptr type="liebermannNote" n="13" target="#QuadrII_4.lnote.oe.13"/> pati, totiens<ptr type="liebermannNote" n="c" target="#QuadrII_4.lnote.oe.c"/> meruit exulare.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 544 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_4.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">544</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Anselm stritt über die Investitur nicht mit Wilhelm II., sondern erst mit Heinrich</hi></seg><seg type="translation" xml:lang="en" source="#claude">Anselm’s dispute over investiture was not with William II, but only with Henry</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_4.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">544</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zweimal:</hi> 1097—1100 <hi rend="italic">und</hi> 1103—1106; <hi rend="italic">er starb</hi> 1109</seg><seg type="translation" xml:lang="en" source="#claude">twice: 1097—1100 and 1103—1106; he died in 1109</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_4.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">544</biblScope></bibl><seg type="original" xml:lang="de">XV. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">XV. <hi rend="italic">Hk</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_4.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">544</biblScope></bibl><seg type="original" xml:lang="de">et do. no. <hi rend="italic">fehlt Hk;</hi> et do. <hi rend="italic">fehlt M</hi></seg><seg type="translation" xml:lang="en" source="#claude">et do. no. missing in Hk; et do. missing in M</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_4.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">544</biblScope></bibl><seg type="original" xml:lang="de">Pascali <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">Pascali <hi rend="italic">T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_4.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">544</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dies copirt Br</hi> 999, 32</seg><seg type="translation" xml:lang="en" source="#claude">Br copies this 999, 32</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_4.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">312</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Investiturstreit. Wilhelm I. investierte den Abt von Le Mans; Davis <hi rend="italic">Reg. Agnorm</hi>. n. 107. Mit dem gepriesenen Bekehrten 4, 1 meint Verf. vielleicht Gerhard von York [und sich selbst?] nach dem Übertritt von des Königs Partei zu der Anselms. Diese Bekehrung schildert deutlicher <hi rend="italic">u</hi>. 17</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Investiturstreit. William I invested the abbot of Le Mans; Davis <hi rend="italic">Reg. Agnorm</hi>. n. 107. By the praised convert in 4, 1 the author perhaps means Gerard of York [and himself?], after his going over from the king’s party to Anselm’s. This conversion is described more clearly <hi rend="italic">below</hi> 17</seg></note>
      </div>
