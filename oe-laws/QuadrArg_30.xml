        <head><ref type="lawCode" target="law:QuadrArg">Quadr Arg</ref> 30</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Arg 30" corresp="#wit-lat"><pb n="535" ed="#liebermann"/>Huius igitur<ptr type="liebermannNote" n="9" target="#QuadrArg_30.lnote.oe.9"/> operis primum<ptr type="liebermannNote" n="h" target="#QuadrArg_30.lnote.oe.h"/> librum transtuli; secundum<ptr type="liebermannNote" n="i" target="#QuadrArg_30.lnote.oe.i"/> collegi et, amplius euagatus, quarundam causarum necessaria capitula, cotidianis<ptr type="liebermannNote" n="k" target="#QuadrArg_30.lnote.oe.k"/> decertationibus<ptr type="liebermannNote" n="10" target="#QuadrArg_30.lnote.oe.10"/> apta, subiunxi,</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 535 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_30.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">535</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">d. h.</hi> leges Anglicas <hi rend="italic">laut</hi> 32</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">i.e.</hi> leges Anglicas <hi rend="italic">according to</hi> 32</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_30.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">535</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> II 17, <hi rend="italic">u. S.</hi> 545, <hi rend="italic">Z.</hi> 3 <hi rend="italic">v. u.</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> II 17, <hi rend="italic">below p.</hi> 545, <hi rend="italic">l.</hi> 3 <hi rend="italic">from bottom</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_30.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">535</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">betreffend u. a. Cölibat, Investitur der Bischöfe und Gerhard von York; vgl. u. S.</hi> 542—6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">concerning, among other things, celibacy, the investiture of bishops and Gerard of York; cf. below pp.</hi> 542—6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_30.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">535</biblScope></bibl><seg type="original" xml:lang="de">ergo <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">ergo <hi rend="italic">T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_30.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">535</biblScope></bibl><seg type="original" xml:lang="de">detractationibus <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">detractationibus <hi rend="italic">T</hi></seg></note>
