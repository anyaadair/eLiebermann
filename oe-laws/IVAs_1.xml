    <body>
      <div type="clause" n="1">
        <head><ref type="lawCode" target="law:IVAs">IV As</ref> 1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1" corresp="#wit-q"><pb n="171" ed="#liebermann"/>Hęc sunt iudicia<ptr type="liebermannNote" n="a" target="#IVAs_1.lnote.oe.a"/>, quę sapientes Exonie<ptr type="liebermannNote" n="1" target="#IVAs_1.lnote.oe.1"/><ptr type="liebermannNote" n="b" target="#IVAs_1.lnote.oe.b"/> consilio Æþelstani<ptr type="liebermannNote" n="2" target="#IVAs_1.lnote.oe.2"/> regis instituerunt et item<ptr type="liebermannNote" n="3" target="#IVAs_1.lnote.oe.3"/> apud Fefresham<ptr type="liebermannNote" n="4" target="#IVAs_1.lnote.oe.4"/><ptr type="liebermannNote" n="c" target="#IVAs_1.lnote.oe.c"/> et tertia<ptr type="liebermannNote" n="5" target="#IVAs_1.lnote.oe.5"/> uice apud Þunresfelde<ptr type="liebermannNote" n="6" target="#IVAs_1.lnote.oe.6"/><ptr type="liebermannNote" n="d" target="#IVAs_1.lnote.oe.d"/>, ubi totum<ptr type="liebermannNote" n="7" target="#IVAs_1.lnote.oe.7"/> hoc diffinitum<ptr type="liebermannNote" n="8" target="#IVAs_1.lnote.oe.8"/> simul et confirmatum est.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="1" corresp="#wit-q"><pb n="146" ed="#attenborough"/>[Ubi hæc judicia fuerunt instituta.]<ptr type="editorNote" n="4" target="#IVAs_1.attnote.fn.4"/> Hæc sunt iudicia quæ sapientes Exoniæ consilio Æþelstani regis instituerunt et item<ptr type="editorNote" n="5" target="#IVAs_1.attnote.fn.5"/> apud Fefresham<ptr type="editorNote" n="6" target="#IVAs_1.attnote.fn.6"/> et tertia vice apud Ðunresfelde, ubi totum<ptr type="editorNote" n="7" target="#IVAs_1.attnote.fn.7"/> hoc definitum<ptr type="editorNote" n="8" target="#IVAs_1.attnote.fn.8"/> simul et confirmatum est.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="147" ed="#attenborough"/>These are the ordinances which the councillors established at Exeter<ptr type="editorNote" n="1" target="#IVAs_1.attnote.n.1"/> by the advice of King Æthelstan, and again at Faversham<ptr type="editorNote" n="2" target="#IVAs_1.attnote.n.2"/>, and on a third occasion at Thundersfield(?)<ptr type="editorNote" n="3" target="#IVAs_1.attnote.n.3"/> where all these provisions were drawn up, and ratified.</ab>
        <note type="editorial">Latin only; no German translation in Liebermann.; V: page of the modern editor’s text / translation, checked against Attenborough (our double-read transcription), October 2026 (e.g. was “(empty)”, now “146 / 147”; 21 rows of IV As)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">Ox. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ox. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">Aels. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Aels. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">iterum <hi rend="italic">TMHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">iterum TMHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">Fres. <hi rend="italic">R;</hi> Faur. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Fres. R; Faur. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">terciam <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">terciam R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">Þundresfeldium <hi rend="italic">RTM</hi></seg><seg type="translation" xml:lang="en" source="#claude">Þundresfeldium RTM</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">defin. <hi rend="italic">RTHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">defin. RTHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">113</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Aus <hi rend="italic">domas . . gesetton;</hi> VI As Pro</seg><seg type="translation" xml:lang="en" source="#claude">From <hi rend="italic">domas . . gesetton;</hi> VI As Pro</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">113</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">V As</seg><seg type="translation" xml:lang="en" source="#claude">V As</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">113</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Auf die Favershamer Beschlüsse antwortet III As</seg><seg type="translation" xml:lang="en" source="#claude">III As is the reply to the Faversham decrees</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">113</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Dieselbe Reihe, nur Greatley davor, bietet VI As 10</seg><seg type="translation" xml:lang="en" source="#claude">VI As 10 gives the same series, only with Greatley before it</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAs_1.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">210</biblScope></bibl><seg type="original" xml:lang="en">See V Æthelstan, Pr. § 1.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAs_1.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">210</biblScope></bibl><seg type="original" xml:lang="en">See III As. cap. 2; VI As. cap. 10.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAs_1.attnote.n.3" n="3" source="#attenborough"><bibl><biblScope unit="page">210</biblScope></bibl><seg type="original" xml:lang="en">Thundersfield in Surrey? In VI As. cap. 10 reference is made to the same three councils together with that held at Grately.<lb type="paragraph"/>Cf. also VI As. Preamble.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_1.attnote.fn.4" n="4" source="#attenborough"><bibl><biblScope unit="page">146</biblScope></bibl><label>instituta</label><seg type="original" xml:lang="en">The titles are taken from Brompton.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_1.attnote.fn.5" n="5" source="#attenborough"><bibl><biblScope unit="page">146</biblScope></bibl><label>item</label><seg type="original" xml:lang="en"><hi rend="italic">iterum</hi> (where no MS authority is stated the variant is common to MSS other than those of the London group).</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_1.attnote.fn.6" n="6" source="#attenborough"><bibl><biblScope unit="page">146</biblScope></bibl><label>Fefresham</label><seg type="original" xml:lang="en"><hi rend="italic">Favr-</hi>. Lond.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_1.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">146</biblScope></bibl><label>totum</label><seg type="original" xml:lang="en">om. M, Hk, Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_1.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">146</biblScope></bibl><label>definitum</label><seg type="original" xml:lang="en"><hi rend="italic">diff-</hi>. Lond.</seg></note>
      </div>
