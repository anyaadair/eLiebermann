        <dictScrap type="liebermann"><hi rend="bold">weotuma</hi> <hi rend="italic">Wittum, Preis bei der Heirat, gezahlt <ref type="abbreviation" target="gram:vom"><abbr>vom</abbr></ref> Bräutigam <ref type="abbreviation" target="gram:ursprunglich"><abbr>ursprüngl.</abbr></ref> an den Brautvormund, <ref type="abbreviation" target="gram:spater"><abbr>später</abbr></ref> <ref type="abbreviation" target="gram:durch"><abbr>durch</abbr></ref> diesen der Braut zur Mitgift geschenkt, alsdann Witwenversorgung</hi> [<hi rend="italic"><ref type="abbreviation" target="gram:vergleiche"><abbr>vgl</abbr></ref>. </hi><ref type="bibl" target="bib:CitBrunnerEnc"><hi rend="italic">Brunner in Holtzendorff,</hi> Encyclop. Rechtswiss. (1902) 254</ref>]; se ~ <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 12 (wit~ <ref type="lawCode" target="law:G">G</ref> <ref type="lawCode" target="law:H">H</ref>; ~toma <ref type="lawCode" target="law:So">So</ref> <ref type="lawCode" target="law:Ld">Ld</ref>), <hi rend="italic"><ref type="abbreviation" target="gram:identificirt"><abbr>identificirt</abbr></ref> <ref type="abbreviation" target="gram:mit"><abbr>mit</abbr></ref></hi> pretium pudicitiae | <hi rend="italic"><ref type="abbreviation" target="gram:Dativ"><abbr>dt</abbr></ref>:</hi> æfter ~an 29, iuxta modum dotis <hi rend="italic"><ref type="abbreviation" target="gram:ubersetzend"><abbr>übsnd</abbr></ref>;</hi> ~toman <ref type="lawCode" target="law:So">So</ref> <ref type="lawCode" target="law:Ld">Ld</ref>; <hi rend="italic"><ref type="abbreviation" target="gram:geandertAus"><abbr>geänd. aus</abbr></ref></hi> witoman <ref type="lawCode" target="law:G">G</ref></dictScrap>
        <xr type="lawCode"><ref target="clause:Af_El-to-12">Af El 12</ref></xr>
