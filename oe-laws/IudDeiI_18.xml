      <div type="clause" n="18">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 18</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 18" corresp="#wit-lat"><pb n="404" ed="#liebermann"/>Post<ptr type="liebermannNote" n="6" target="#IudDeiI_18.lnote.oe.6"/> communionem<ptr type="liebermannNote" n="7" target="#IudDeiI_18.lnote.oe.7"/>. Perceptis, domine Deus noster, sacris<ptr type="liebermannNote" n="8" target="#IudDeiI_18.lnote.oe.8"/> muneribus, <ptr type="liebermannNote" n="9" target="#IudDeiI_18.lnote.oe.9"/>suppliciter deprecamur, ut huius participatio sacramenti et a propriis nos<ptr type="liebermannNote" n="10" target="#IudDeiI_18.lnote.oe.10"/> reatibus indesinenter expediat et in<ptr type="liebermannNote" n="11" target="#IudDeiI_18.lnote.oe.11"/> famulis<ptr type="liebermannNote" n="12" target="#IudDeiI_18.lnote.oe.12"/> tuis<ptr type="liebermannNote" n="13" target="#IudDeiI_18.lnote.oe.13"/> ueritatis<ptr type="liebermannNote" n="14" target="#IudDeiI_18.lnote.oe.14"/> sententiam declaret. Per<ptr type="liebermannNote" n="15" target="#IudDeiI_18.lnote.oe.15"/> dominum<ptr type="liebermannNote" n="16" target="#IudDeiI_18.lnote.oe.16"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 404 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_18.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">Ad <hi rend="italic">Ps;</hi> Ad complendum <hi rend="italic">Rj Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad Ps; Ad complendum Rj Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_18.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">Postcommunio <hi rend="italic">Ci Ca H Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Postcommunio Ci Ca H Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_18.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">mu. sa. <hi rend="italic">Al;</hi> sacramentis <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">mu. sa. Al; sacramentis Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_18.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">te <hi rend="italic">fügt zu Al Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">te added by Al Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_18.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">r. nos <hi rend="italic">Al</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. nos Al</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_18.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">hoc <hi rend="italic">fügt zu Al;</hi> hoc, <hi rend="italic">übergeschr.</hi> uel his <hi rend="italic">Ch; auch im Folgenden setzt Ch in den Text den Singular und darüber Plural, was ich fortan nicht bemerke</hi></seg><seg type="translation" xml:lang="en" source="#claude">hoc added by Al; hoc, with uel his written above, Ch; in what follows, too, Ch puts the singular in the text and the plural above it, which I shall not record henceforth</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_18.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">famulo tuo <hi rend="italic">Al Ma Co; übergeschr.</hi> -lo -o <hi rend="italic">Rj;</hi> uel -o <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">famulo tuo Al Ma Co; -lo -o written above Rj; uel -o H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_18.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi> uel -o <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel -o written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_18.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">s. u. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. u. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_18.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">P. d. <hi rend="italic">fehlt Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">P. d. lacking in Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_18.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr</seg></note>
