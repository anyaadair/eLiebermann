      <div type="clause" n="22">
        <head><ref type="lawCode" target="law:IIAs">II As</ref> 22</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22" corresp="#wit-h"><pb n="162" ed="#liebermann"/>⁊ ne underfó nan mon<ptr type="liebermannNote" n="4" target="#IIAs_22.lnote.oe.4"/> oþres<ptr type="liebermannNote" n="8" target="#IIAs_22.lnote.oe.8"/> monnes<ptr type="liebermannNote" n="4" target="#IIAs_22.lnote.oe.4"/> mon<ptr type="liebermannNote" n="4" target="#IIAs_22.lnote.oe.4"/>, buton<ptr type="liebermannNote" n="4" target="#IIAs_22.lnote.oe.4"/> his leafe þe he ær folgode.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22" corresp="#wit-ld"><pb n="162" ed="#liebermann"/>Be ðon ðe oþres mannes man underfehþ. Ne underfó nan man oþres mannes man, butan ðæs leafe ðe he ær folgode.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22" corresp="#wit-ot"><pb n="162" ed="#liebermann"/>⁊ ne . . . nan man oðres . . . man, butan þæs leafe þe he : : folgode.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="22" corresp="#wit-q"><pb n="163" ed="#liebermann"/>Ne quis recipiat<ptr type="liebermannNote" n="12" target="#IIAs_22.lnote.oe.12"/> alterius hominem sine<ptr type="liebermannNote" n="13" target="#IIAs_22.lnote.oe.13"/> licentia. Et nemo recipiat alterius hominem sine<ptr type="liebermannNote" n="14" target="#IIAs_22.lnote.oe.14"/> licentia eius cui antea seruiuit.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="22" corresp="#wit-h"><pb n="138" ed="#attenborough"/>[Be ðon ðe oþres mannes man underfehþ.]<ptr type="editorNote" n="12" target="#IIAs_22.attnote.fn.12"/> ⁊ ne underfó nan mon oþres monnes mon, buton his<ptr type="editorNote" n="13" target="#IIAs_22.attnote.fn.13"/> leafe þe he ær folgode.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="163" ed="#liebermann"/>(Von dem, der den Untergebenen eines anderen Mannes [als Vasallen] aufnimmt. <hi rend="italic">Ld</hi>) Und<ptr type="liebermannNote" n="1" target="#IIAs_22.lnote.de.1"/> niemand nehme den Untergebenen eines anderen [zum Vasallen] auf, ohne dessen Erlaubniss, dem dieser früher commendirt war.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">(Of him who takes another man's dependant [as his vassal]. Ld) And let no one take another's dependant [as his vassal] without the permission of the one to whom he was previously commended.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="139" ed="#attenborough"/>And no one shall receive a man who is subject to another, without the permission of him whom he has been serving.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="422" ed="#whitelock"/>And no one is to receive the man of another man, without the permission of him whom he served before.</ab>
        <note type="comparison" source="#liebermann" n="163"><ref target="clause:IIEw_7">II Ew 7</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. II Ew. 7</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IIIAs_4">III As 4</ref>; <ref target="clause:VAs_1">V As 1</ref>; <ref target="clause:IICn_28">II Cn 28</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="286"><ref target="clause:AGu_4">AGu 4–5</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="296"><ref target="clause:VAs_1">V As 1–1.1</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="358"><ref target="clause:IICn_28">II Cn 28–28.1</ref></note>
        <note type="comparedBy" source="#whitelock" n="465"><ref target="clause:IICn_28">II Cn 28</ref></note>
        <note type="editorial">Liebermann compares II Ew 7.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">162</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">162</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">163</biblScope></bibl><seg type="original" xml:lang="de">acc. <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">acc. MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">163</biblScope></bibl><seg type="original" xml:lang="de">s. l. <hi rend="italic">fehlt Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. l. lacking in Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">163</biblScope></bibl><seg type="original" xml:lang="de">si non <hi rend="italic">M</hi></seg><seg type="translation" xml:lang="en" source="#claude">si non M</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_22.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">106</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Wiederholt III 4</seg><seg type="translation" xml:lang="en" source="#claude">Repeated in III 4</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_22.attnote.fn.12" n="12" source="#attenborough"><bibl><biblScope unit="page">138</biblScope></bibl><label>underfehþ</label><seg type="original" xml:lang="en">Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_22.attnote.fn.13" n="13" source="#attenborough"><bibl><biblScope unit="page">138</biblScope></bibl><label>his</label><seg type="original" xml:lang="en"><hi rend="italic">ðæs</hi>. Ld, Ot.</seg></note>
