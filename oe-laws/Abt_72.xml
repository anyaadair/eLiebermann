  <text>
    <body>
      <div type="clause" n="72">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 72</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="72" corresp="#wit-h"><pb n="7" ed="#liebermann"/>Gif þare mycclan taan nægl of weorþeð, XXX scætta to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-h"><pb n="14" ed="#attenborough"/>Gif þare mycclan taan nægl of weorþeð, XXX scætta to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="71" corresp="#wit-h"><pb n="76" ed="#oliver"/>Gif þare mycclan taan næge of weorþeð, XXX scætta to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="7" ed="#liebermann"/>Wenn der grossen<ptr type="liebermannNote" n="1" target="#Abt_72.lnote.de.1"/> Zehe<ptr type="liebermannNote" n="2" target="#Abt_72.lnote.de.2"/> Nagel ab[gehauen] wird, 30 Skätte<ptr type="liebermannNote" n="3" target="#Abt_72.lnote.de.3"/> zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the nail of the big toe is [cut] off, 30 sceattas as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="15" ed="#attenborough"/>If the nail of the big toe is knocked off, 30 sceattas shall be paid as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h"><pb n="77" ed="#oliver"/>If the big toenail becomes [struck] off, 30 sceattas as restitution.<ptr type="editorNote" n="d" target="#Abt_72.olinote.n.d"/></ab>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_72.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">13</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">mycelan</hi> Lesefehler</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">mycelan</hi> is a misreading</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_72.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">13</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aa</hi> für <hi rend="italic">ā</hi> ist archaische Schreibart, wie <hi rend="italic">oo</hi> für <hi rend="italic">ō:</hi> <hi rend="italic">u.</hi> 87; <hi rend="italic">s.</hi> Einl. 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">aa</hi> for <hi rend="italic">ā</hi> is an archaic spelling, like <hi rend="italic">oo</hi> for <hi rend="italic">ō:</hi> <hi rend="italic">below</hi> 87; <hi rend="italic">see</hi> Introd. 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_72.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">13</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Die Hälfte von 3 Schilling für Daumennagel <hi rend="italic">o.</hi> 54, 1</seg><seg type="translation" xml:lang="en" source="#claude">Half of the 3 shillings for a thumbnail, <hi rend="italic">above</hi> 54, 1</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Abt_72.olinote.n.d" n="d" source="#oliver"><bibl><biblScope unit="page">77</biblScope></bibl><label>restitution.</label><seg type="original" xml:lang="en">At 20 <hi rend="italic">sceattas</hi> to the shilling, this represents half the sum for the 3-shilling thumbnail.</seg></note>
      </div>
    </body>
