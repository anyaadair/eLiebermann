    <body>
      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:IIIAs">III As</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.1" corresp="#wit-q"><pb n="170" ed="#liebermann"/>Unde, karissime domine, primum est de decima<ptr type="liebermannNote" n="14" target="#IIIAs_1-1.lnote.oe.14"/><ptr type="liebermannNote" n="a" target="#IIIAs_1-1.lnote.oe.a"/> nostra, ad quod<ptr type="liebermannNote" n="15" target="#IIIAs_1-1.lnote.oe.15"/> multum<ptr type="liebermannNote" n="5" target="#IIIAs_1-1.lnote.oe.5"/> (ualde) cupidi sumus et uoluntarii, et tibi suppliciter<ptr type="liebermannNote" n="16" target="#IIIAs_1-1.lnote.oe.16"/> gratias<ptr type="liebermannNote" n="17" target="#IIIAs_1-1.lnote.oe.17"/> reddimus<ptr type="liebermannNote" n="5" target="#IIIAs_1-1.lnote.oe.5"/> (agimus) admonitionis tue.</ab>
        <ab type="editionText" xml:lang="la" source="#attenborough" n="1.1" corresp="#wit-q"><pb n="142" ed="#attenborough"/>Unde, karissime Domine, primum est de decima nostra, ad quod multum<ptr type="editorNote" n="16" target="#IIIAs_1-1.attnote.fn.16"/> cupidi sumus et voluntarii, et tibi suppliciter<ptr type="editorNote" n="17" target="#IIIAs_1-1.attnote.fn.17"/> gratias reddimus<ptr type="editorNote" n="18" target="#IIIAs_1-1.attnote.fn.18"/> admonitionis tue.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="143" ed="#attenborough"/>The first [of the provisions] most beloved lord! relates to our tithes<ptr type="editorNote" n="1" target="#IIIAs_1-1.attnote.n.0"/>, for the [payment of] which we are very eager and desirous; and we humbly return thanks to you for your injunction.</ab>
        <note type="comparison" source="#liebermann" n="170">I As [?]</note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. I As. [?]</note>
        <note type="comparisonIncomplete">Some of Liebermann’s notes here are cut off in the gutter of the scan used, and are still to be completed.</note>
        <note type="editorial">Latin only; no German translation in Liebermann. Liebermann compares I As.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_1-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> n. d. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Lond; n. d. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_1-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">quam <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">quam T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_1-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond; (eingeklammertes) übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket Lond; (the bracketed words) the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_1-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">-plices <hi rend="italic">M</hi></seg><seg type="translation" xml:lang="en" source="#claude">-plices M</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_1-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">r. g. <hi rend="italic">Jl</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. g. Jl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_1-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">111</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">II As enthält nichts von Zehnten. <hi rend="italic">Vgl. o.</hi> S. 96 letzte Z.; S. 97 Z. 5</seg><seg type="translation" xml:lang="en" source="#claude">II As contains nothing about tithes. <hi rend="italic">Cf. above</hi> p. 96 last l.; p. 97 l. 5</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIAs_1-1.attnote.n.0" n="0" source="#attenborough"><bibl><biblScope unit="page">209</biblScope></bibl><seg type="original" xml:lang="en">See I As. Preamble.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_1-1.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">142</biblScope></bibl><label>multum</label><seg type="original" xml:lang="en"><hi rend="italic">quod valde</hi>. Br, M, etc.; <hi rend="italic">quam v-</hi>. T.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_1-1.attnote.fn.17" n="17" source="#attenborough"><bibl><biblScope unit="page">142</biblScope></bibl><label>suppliciter</label><seg type="original" xml:lang="en"><hi rend="italic">supplices</hi>. M.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_1-1.attnote.fn.18" n="18" source="#attenborough"><bibl><biblScope unit="page">142</biblScope></bibl><label>reddimus</label><seg type="original" xml:lang="en"><hi rend="italic">agimus</hi>. Br, M.</seg></note>
      </div>
    </body>
