      <div type="clause" n="18.1a">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 18.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 18.1a"><pb n="644" ed="#liebermann"/><ptr type="liebermannNote" n="3" target="#ECf_18-1a.lnote.la.3"/>Ipse<ptr type="liebermannNote" n="a" target="#ECf_18-1a.lnote.la.fn.a"/> tamen<ptr type="liebermannNote" n="4" target="#ECf_18-1a.lnote.la.4"/> liberatus<ptr type="liebermannNote" n="5" target="#ECf_18-1a.lnote.la.5"/> faciat rectum cui forisfecit<ptr type="liebermannNote" n="6" target="#ECf_18-1a.lnote.la.6"/> pro omni<ptr type="liebermannNote" n="7" target="#ECf_18-1a.lnote.la.7"/> posse suo.</ab>
        <note type="comparison" source="#liebermann" n="644"><label>printed alongside</label> <ref target="clause:ECfRetr_18-1a">ECf retr 18.1a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 644 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-1a.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 18a</seg><seg type="translation" xml:lang="en" source="#claude">cf. 18a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-1a.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">Et ipse <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et ipse Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-1a.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-1a.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">delib. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">delib. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-1a.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl;</hi> -cerit <hi rend="italic">S Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl; -cerit S Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-1a.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Yet let the man freed do right to him against whom he offended, to the utmost of his power.</ab>
      </div>
