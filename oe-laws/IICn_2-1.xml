        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_2-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">202</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Übersetzt durch Leis Wl 40</seg><seg type="translation" xml:lang="en" source="#claude">Translated by Leis Wl 40</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_2-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">202</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">latrocinium</hi> zählt Inst zu kleinen Verbrechen, wahrscheinlich kleinen Diebstahl (<hi rend="italic">s. d. Gl</hi> 9b) meinend.—Zu A's <hi rend="italic">lythum vgl. Wb: th</hi> für <hi rend="italic">t</hi>; Form 13. Jhs. <hi rend="italic">lutthle</hi> bei Mätzner 297b Z. 8 v. u.</seg><seg type="translation" xml:lang="en" source="#claude">Inst counts <hi rend="italic">latrocinium</hi> among minor crimes, probably meaning petty theft (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 9b). — On A’s <hi rend="italic">lythum cf. Wb: th</hi> for <hi rend="italic">t</hi>; a 13th-cent. form <hi rend="italic">lutthle</hi> in Mätzner 297b l. 8 from the bottom</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_2-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">202</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Den Zusatz in Inst benutzt Ps Cn for 10.—Ersatz der Todesstrafe durch Verstümmelung <hi rend="italic">s. u</hi>. 30, 5⁵; Seelenauslösung durch Christus <hi rend="italic">o</hi>. I 18, 3</seg><seg type="translation" xml:lang="en" source="#claude">The addition in Inst is used by Ps Cn for 10. — Replacement of the death penalty by mutilation, <hi rend="italic">see below</hi> 30, 5⁵; redemption of souls by Christ, <hi rend="italic">above</hi> I 18, 3</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_2-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="en">Cf. VI Atr. 10.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_2-1.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="en">Cf. 30, 5.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_2-1.robnote.n.3" n="3" source="#robertson"><bibl><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="en">Cf. I, 18, 3.</seg></note>
