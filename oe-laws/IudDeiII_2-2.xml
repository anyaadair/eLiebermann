        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei II 2.2" corresp="#wit-lat"><pb n="406" ed="#liebermann"/>Deus, qui ab<ptr type="liebermannNote" n="17" target="#IudDeiII_2-2.lnote.oe.17"/> incendio fornacis Chaldaicis<ptr type="liebermannNote" n="18" target="#IudDeiII_2-2.lnote.oe.18"/>, plerisque<ptr type="liebermannNote" n="19" target="#IudDeiII_2-2.lnote.oe.19"/> succensis, tres<ptr type="liebermannNote" n="20" target="#IudDeiII_2-2.lnote.oe.20"/> pueros tuos inlaesos<ptr type="liebermannNote" n="21" target="#IudDeiII_2-2.lnote.oe.21"/> eduxisti;</ab>
