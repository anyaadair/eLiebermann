      <div type="clause" n="36.1e">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 36.1e</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 36.1e" corresp="#wit-lat"><pb n="566" ed="#liebermann"/>Quod autem in pacacionem<ptr type="liebermannNote" n="40" target="#Hn_36-1e.lnote.oe.40"/> hoc modo datur, aliquando competenter retineri potest, aliquando<ptr type="liebermannNote" n="41" target="#Hn_36-1e.lnote.oe.41"/> non potest<ptr type="liebermannNote" n="v" target="#Hn_36-1e.lnote.oe.v"/>:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 566 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-1e.lnote.oe.v" n="v" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">es ziemt sich für den obsiegenden Kläger, das Sühnegeschenk des Beklagten ihm zurückzugeben, an dem Achtungserweise sich genügen zu lassen; dagegen das Bussgeld darf er behalten</seg><seg type="translation" xml:lang="en" source="#claude">it is fitting for the successful plaintiff to give the defendant’s gift of atonement back to him and to be content with the mark of respect; the compensation money, on the other hand, he may keep</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-1e.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">pacc. <hi rend="italic">Sc;</hi> paccionem <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">pacc. Sc; paccionem Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-1e.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">a. n. p. <hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. n. p. missing K Co Or Gi</seg></note>
      </div>
