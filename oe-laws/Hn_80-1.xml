      <div type="clause" n="80.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 80.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 80.1" corresp="#wit-lat"><pb n="596" ed="#liebermann"/>Si<ptr type="liebermannNote" n="5" target="#Hn_80-1.lnote.oe.5"/> in domo<ptr type="liebermannNote" n="a" target="#Hn_80-1.lnote.oe.a"/> uel in curia uel in burgo uel in<ptr type="liebermannNote" n="6" target="#Hn_80-1.lnote.oe.6"/> castello uel excercitu uel hostico<ptr type="liebermannNote" n="7" target="#Hn_80-1.lnote.oe.7"/> regis faciat aliquis homicidium, sit in misericordia regis de peccunia uel membris.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 596 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht aus Cnut; vgl.</hi> 10, 1. 12, 3. 13, 1; 7 <hi rend="italic">f.</hi> 16. 80, 7</seg><seg type="translation" xml:lang="en" source="#claude">perhaps from Cnut; cf. 10, 1. 12, 3. 13, 1; 7 f. 16. 80, 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg K Or Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing Sc Hg K Or Edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de">-tio <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tio Lond</seg></note>
