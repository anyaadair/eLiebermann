    <body>
      <div type="clause" n="1.11">
        <head><ref type="lawCode" target="law:IAtr">I Atr</ref> 1.11</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.11" corresp="#wit-h"><pb n="218" ed="#liebermann"/>Gif he ðonne betyhtled wurðe ⁊ he utt<ptr type="liebermannNote" n="1" target="#IAtr_1-11.lnote.oe.1"/> oþhleape, gylde se hlaford þæs mannes were þa<hi rend="italic">m</hi> cyninge.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.11" corresp="#wit-b"><pb n="218" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="1" target="#IAtr_1-11.lnote.oe.1-2"/> he ðonne betyhtlad wurðe ⁊ he ut<ptr type="liebermannNote" n="17" target="#IAtr_1-11.lnote.oe.17"/> oðhleape, gylde se hlaford<ptr type="liebermannNote" n="18" target="#IAtr_1-11.lnote.oe.18"/> ðæs mannes were ðam<ptr type="liebermannNote" n="4" target="#IAtr_1-11.lnote.oe.4"/> cynge.<ptr type="liebermannNote" n="19" target="#IAtr_1-11.lnote.oe.19"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.11" corresp="#wit-q"><pb n="219" ed="#liebermann"/>Sin autem accusetur aliquis et aufugiat, emendet dominus regi weram hominis accusati.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="1.11" corresp="#wit-b"><pb n="54" ed="#robertson"/>Gyf he ðonne betyhtlad wurðe ⁊ he ut oðhleape<ptr type="editorNote" n="2" target="#IAtr_1-11.robnote.fn.2"/>, gylde se hlaford ðæs mannes were ðam cynge.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="219" ed="#liebermann"/>Wenn [deren] einer angeklagt wird, er jedoch hinaus entflieht, zahle der Herr<ptr type="liebermannNote" n="1" target="#IAtr_1-11.lnote.de.1"/> dem König das Wergeld dieses Untergebenen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If [one of them] is accused, but escapes, let the lord pay the king the wergild of that dependant.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="55" ed="#robertson"/>And if a man is accused and escapes, the lord shall pay his wergeld to the king.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_31-1">II Cn 31.1</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="358"><ref target="clause:IICn_31-1">II Cn 31.1–2</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-11.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">am Rande</hi></seg><seg type="translation" xml:lang="en" source="#claude">in the margin</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-11.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-11.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">utleape, gyld <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">utleape, gyld Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-11.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">-rde <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rde Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-11.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-11.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">cyng <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyng Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IAtr_1-11.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">148</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Der Herr haftet dem Strafrichter als Bürge, muss also auch dem Kläger Ersatzgeld zahlen wie o. 1, 7</seg><seg type="translation" xml:lang="en" source="#claude">The lord is liable as surety to the judge who imposes the fine, and must therefore also pay the accuser restitution, as above 1, 7</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IAtr_1-11.robnote.fn.2" n="2" source="#robertson"><bibl><biblScope unit="page">54</biblScope></bibl><label>oðhleape</label><seg type="original" xml:lang="en"><hi rend="italic">uthleape</hi> Ld.</seg></note>
      </div>
    </body>
