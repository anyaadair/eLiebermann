    <body>
      <div type="clause" n="35.1b">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 35.1b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 35.1b"><pb n="665" ed="#liebermann"/>Propter quem misit rex Eadwardus, auunculus<ptr type="liebermannNote" n="4" target="#ECfRetr_35-1b.lnote.la.4"/> eius, et fecit eum uenire<ptr type="liebermannNote" n="5" target="#ECfRetr_35-1b.lnote.la.5"/> ad se†. <hi rend="bold">Qui postquam</hi> uenit<ptr type="liebermannNote" n="6" target="#ECfRetr_35-1b.lnote.la.6"/>, non <hi rend="bold">multum</hi> <hi rend="spaced">postea</hi><ptr type="liebermannNote" n="7" target="#ECfRetr_35-1b.lnote.la.7"/> <hi rend="spaced">uixit</hi>, et uxor <hi rend="bold">illius</hi><ptr type="liebermannNote" n="8" target="#ECfRetr_35-1b.lnote.la.8"/> <hi rend="bold">in breui temporis</hi><ptr type="liebermannNote" n="6" target="#ECfRetr_35-1b.lnote.la.6"/> <hi rend="bold">curriculo defuncta est.</hi> Rex <hi rend="bold">uero</hi> Eadwardus Eadgarum, filium <hi rend="bold">eorum,</hi> secum retinuit et<ptr type="liebermannNote" n="9" target="#ECfRetr_35-1b.lnote.la.9"/> pro filio nutriuit.</ab>
        <note type="comparison" source="#liebermann" n="665"><label>printed alongside</label> <ref target="clause:ECf_35-1b">ECf 35.1b</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 665 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">Liebermann prints “†” after “ad se” and gives in the outer margin the date †1057.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECfRetr_35-1b.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">Eadward Ætheling</seg><seg type="translation" xml:lang="en" source="#claude">Edward Ætheling</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECfRetr_35-1b.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vatersbruder</hi></seg><seg type="translation" xml:lang="en" source="#claude">father’s brother</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECfRetr_35-1b.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">lebte noch nach</hi> 1126; <hi rend="italic">Stubbs</hi> Will. Malm. II <hi rend="italic">p.</hi> cxiv</seg><seg type="translation" xml:lang="en" source="#claude">still alive after 1126; Stubbs, Will. Malm. II p. cxiv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35-1b.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">ei. au. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei. au. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35-1b.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">uenisse <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">uenisse Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35-1b.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35-1b.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35-1b.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">Va Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius Va Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35-1b.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">et p. f. n. <hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">et p. f. n. lacking in Cb</seg></note>
      </div>
