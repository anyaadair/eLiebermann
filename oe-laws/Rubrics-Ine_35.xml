      <div type="clause" n="35">
        <head>Ine Rb 35</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35" corresp="#wit-e"><pb n="22" ed="#liebermann"/>LXXVIIII. Be þeofslihte<ptr type="liebermannNote" n="13" target="#Rubrics-Ine_35.lnote.oe.13"/>, þæt he mote aðe gecyðan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35" corresp="#wit-g-prol"><pb n="22" ed="#liebermann"/>LXXVIIII. Be ðeofslihte, þ<hi rend="italic">æt</hi> he þ<hi rend="italic">æt</hi> móte aðe gecyþan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35" corresp="#wit-h"><pb n="23" ed="#liebermann"/>LXXVIIII. Be þeofslyhte, þæt he<ptr type="liebermannNote" n="22" target="#Rubrics-Ine_35.lnote.oe.22"/> mott þæt<ptr type="liebermannNote" n="23" target="#Rubrics-Ine_35.lnote.oe.23"/> mid aðe gecyðan.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="35" corresp="#wit-q"><pb n="23" ed="#liebermann"/>De<ptr type="liebermannNote" n="25" target="#Rubrics-Ine_35.lnote.oe.25"/> furicidio, quod iuramento comprobari liceat.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="206" ed="#jurasinski-and-oliver"/>LXXVIIII Be þeofslihte, þæt he mote aðe gecyðan</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="206" ed="#jurasinski-and-oliver"/>Be ðeof slihte</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="23" ed="#liebermann"/>Von Erschlagung eines Diebes, dass der [Thäter] durch Eid [solches] beweisen dürfe.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of the slaying of a thief: that the [slayer] may prove [it] by oath.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="207" ed="#jurasinski-and-oliver"/>Concerning killing a thief, that he may declare on oath</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="207" ed="#jurasinski-and-oliver"/>Concerning killing a thief</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_35.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de">-slyhte <hi rend="italic">ohne</hi> þæt — gecyðan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-slyhte without þæt — gecyðan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_35.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">De interficiente furem <hi rend="italic">Br</hi>; Qui furem occiderit <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">De interficiente furem Br; Qui furem occiderit Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_35.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_35.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">später übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above later</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_35.lnote.de.0" n="0" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">þæt mid</hi> in Hcor ist spätere Stilerleichterung</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">þæt mid</hi> in Hcor is a later stylistic simplification</seg></note>
      </div>
