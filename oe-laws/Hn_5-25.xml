      <div type="clause" n="5.25">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.25</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.25" corresp="#wit-lat"><ptr type="liebermannNote" n="e" target="#Hn_5-25.lnote.oe.e"/><pb n="551" ed="#liebermann"/>Quidam<ptr type="liebermannNote" n="8" target="#Hn_5-25.lnote.oe.8"/> ad repellenda imperitorum<ptr type="liebermannNote" n="9" target="#Hn_5-25.lnote.oe.9"/> machinamenta et suas responsiones<ptr type="liebermannNote" n="10" target="#Hn_5-25.lnote.oe.10"/> preparandas et testes confirmandos et consilia<ptr type="liebermannNote" n="11" target="#Hn_5-25.lnote.oe.11"/> querenda annum et sex menses concedi mandauerunt, quidam<ptr type="liebermannNote" n="12" target="#Hn_5-25.lnote.oe.12"/> annum — in quo plurimi concordant —; minus uero quam sex menses non repperi<ptr type="liebermannNote" n="13" target="#Hn_5-25.lnote.oe.13"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 551 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-25.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch Ivo</hi> Decr. V 296; <hi rend="italic">Gr.</hi> C. 3 q. 3 c. 2 <hi rend="italic">aus Ps.-Is.</hi> 489</seg><seg type="translation" xml:lang="en" source="#claude">also Ivo Decr. V 296; Gr. C. 3 q. 3 c. 2 from Ps.-Is. 489</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-25.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">Quidē ad replenda <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">Quidē ad replenda Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-25.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Ps.-Is.;</hi> impedimentorum <hi rend="italic">Ivo; meinte Verf. oder Archetyp</hi> impetitorum?</seg><seg type="translation" xml:lang="en" source="#claude">so Ps.-Is.; impedimentorum Ivo; did the author or the archetype mean impetitorum?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-25.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">repens. <hi rend="italic">Lond;</hi> ℞ones <hi rend="italic">Sc Hg;</hi> rationes <hi rend="italic">Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">repens. Lond; ℞ones Sc Hg; rationes edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-25.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">consimilia <hi rend="italic">Hg Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">consimilia Hg Lond</seg></note>
