        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_15.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">Qui de <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Qui de Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_15.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">hereg <hi rend="italic">Hk;</hi> herethaynes ducentibus exercitum <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">hereg Hk; herethaynes ducentibus exercitum Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_15.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">De fure in vinculis regis <hi rend="italic">fügt zu Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">De fure in vinculis regis added by Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_15.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> herege</seg><seg type="translation" xml:lang="en" source="#claude">altered herege</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_15.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Q schreibt stammhaftes <hi rend="italic">g</hi> des deklinierten <hi rend="italic">here</hi> dem Nom. zu</seg><seg type="translation" xml:lang="en" source="#claude">Q attributes to the nom. the stem-final <hi rend="italic">g</hi> of the inflected forms of <hi rend="italic">here</hi></seg></note>
