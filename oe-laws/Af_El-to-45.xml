    <body>
      <div type="clause" n="El. 45">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 45</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 45" corresp="#wit-e"><pb n="40" ed="#liebermann"/>Soðfæstne<ptr type="liebermannNote" n="37" target="#Af_El-to-45.lnote.oe.37"/> man ⁊ unscyldigne ne ácwele<ptr type="liebermannNote" n="38" target="#Af_El-to-45.lnote.oe.38"/> ðu<ptr type="liebermannNote" n="16" target="#Af_El-to-45.lnote.oe.16"/> þone næfre.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 45" corresp="#wit-g-prol-only"><pb n="40" ed="#liebermann"/>Soðfæstne mann ⁊ unscyldigne ne ácwelle þu ðæne<ptr type="liebermannNote" n="2" target="#Af_El-to-45.lnote.oe.2-2"/> næfre.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 45" corresp="#wit-h"><pb n="41" ed="#liebermann"/>Soðfæstne mon<ptr type="liebermannNote" n="2" target="#Af_El-to-45.lnote.oe.2"/> ond<ptr type="liebermannNote" n="2" target="#Af_El-to-45.lnote.oe.2"/> unscyldigne ne acwel<ptr type="liebermannNote" n="15" target="#Af_El-to-45.lnote.oe.15"/> ðu ðone næfre.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 45" corresp="#wit-q"><pb n="41" ed="#liebermann"/>Insontem et iustum non occides; quia auorsor<ptr type="liebermannNote" n="12" target="#Af_El-to-45.lnote.oe.12"/> impium.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 45" corresp="#wit-e"><pb n="258" ed="#jurasinski-and-oliver"/>Soðfæstne man ⁊ unscyldigne ne ácwele ðu þone næfre.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="41" ed="#liebermann"/>Einen gerechten<ptr type="liebermannNote" n="1" target="#Af_El-to-45.lnote.de.1"/> und unschuldigen Mann, den tödte du niemals.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">A righteous and innocent man, never kill him.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="259" ed="#jurasinski-and-oliver"/>A truthful and guiltless man – never slay him.</ab>
        <note type="passageSource">Exodus 23,7</note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-45.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">Suþf. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Suþf. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-45.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">cwæle <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cwæle So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-45.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-45.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geändert in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-45.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt Rasur eines Buchst.</hi></seg><seg type="translation" xml:lang="en" source="#claude">followed by an erasure of one letter</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-45.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de">auersatur impio <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">auersatur impio T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-45.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">über</hi> æ</seg><seg type="translation" xml:lang="en" source="#claude">o above æ</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-45.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">47</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘wahrhaften’ Schmid, silbenhaft richtig. Aber das Kompositum bezeichnet das Richtige im Handeln öfter als das im Reden und übersetzt häufig <hi rend="italic">justus</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘truthful’ Schmid, literally correct. But the compound denotes rightness in action more often than in speech, and frequently translates <hi rend="italic">justus</hi></seg></note>
      </div>
    </body>
