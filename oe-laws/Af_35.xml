    <body>
      <div type="clause" n="35">
        <head><ref type="lawCode" target="law:Af">Af</ref> 35</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35" corresp="#wit-e"><pb n="68" ed="#liebermann"/>XXXII. Gif mon cierliscne<ptr type="liebermannNote" n="26" target="#Af_35.lnote.oe.26"/> mon gebinde unsynnigne<ptr type="liebermannNote" n="27" target="#Af_35.lnote.oe.27"/>, gebete mid X scill.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35" corresp="#wit-h"><pb n="68" ed="#liebermann"/>XXXII. Gif mon<ptr type="liebermannNote" n="11" target="#Af_35.lnote.oe.11"/> cierliscne mon<ptr type="liebermannNote" n="12" target="#Af_35.lnote.oe.12"/> gebinde unsynnigne, gebete mid X scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35" corresp="#wit-b-no-prol"><pb n="69" ed="#liebermann"/>Be ceorlisces mannes bindelan. Gyf mon ceorliscne mon gebinde unscyldigne, gebete mid tyn scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="35" corresp="#wit-q"><pb n="69" ed="#liebermann"/>Si quis hominem cirliscum<ptr type="liebermannNote" n="9" target="#Af_35.lnote.oe.9"/> iniuste ligauerit, decem sol. emendet.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="78" ed="#attenborough"/>[Be ceorlisces mannes bindelan.] Gif mon cierliscne mon gebinde unsynnigne<ptr type="editorNote" n="15" target="#Af_35.attnote.fn.15"/>, gebete mid X scill.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="36" corresp="#wit-e"><pb n="328" ed="#jurasinski-and-oliver"/>{XXXII} Gif mon cierliscne mon gebinde unsynnigne, gebete mid X scill.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="69" ed="#liebermann"/>Wenn jemand einen nichtschuldigen<ptr type="liebermannNote" n="1" target="#Af_35.lnote.de.1"/> gemeinfreien Mann bindet, büsse er [ihm] mit 10 Schill.<ptr type="liebermannNote" n="2" target="#Af_35.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone binds an innocent common freeman, let him pay [him] 10 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="79" ed="#attenborough"/>If anyone lays bonds on an unoffending commoner, he shall pay 10 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="329" ed="#jurasinski-and-oliver"/>If someone binds an innocent <hi rend="italic">ceorl</hi>, let [the man who bound him] compensate with 10 shillings.1</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_60">II Cn 60</ref></note>
        <note type="comparison" source="#wormald-mel" n="281"><label>possibly influenced by</label> <ref target="clause:Abt_24">Abt 24</ref> <quote>Other possible effects of Æthelberht's influence are that Alfred had much more to say than Ine about ... binding of freemen (n. 86: Af 35 – 35:6; Abt 24)</quote></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="329"><label>cf.</label> <ref target="clause:Abt_24">Abt 24</ref> <quote>Æthelberht §25 [L24] stipulates a fine of 20 shilllings for binding a free man</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="272"><label>cross-reference</label> <ref target="clause:Af_2-1">Af 2.1</ref> <quote>Af. 2:1 (ref. Af 35, 35:6, 44 – 77)</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="361"><label>influence (per Liebermann)</label> <ref target="clause:IICn_60">II Cn 60</ref> <quote>Liebermann adduces only Af 35 as an influence on II Cn 60</quote></note>
        <note type="comparedBy" source="#whitelock" n="471"><label>cf.</label> <ref target="clause:IICn_60">II Cn 60</ref> <quote>cf. Alfred 35, but here binding costs only ten shillings</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">cyr. <hi rend="italic">So;</hi> ceor. man <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyr. So; ceor. man Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">unscyldigne, g. myd tyn <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">unscyldigne, g. myd tyn Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.; geänd.</hi> man</seg><seg type="translation" xml:lang="en" source="#claude">written above; altered man</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de">cyrl. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyrl. Hk</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_35.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">B modernisiert</seg><seg type="translation" xml:lang="en" source="#claude">B modernises</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_35.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> binden; Ehrenkränkung 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> binden; Ehrenkränkung 1</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_35.attnote.fn.15" n="15" source="#attenborough"><bibl><biblScope unit="page">78</biblScope></bibl><label>unsynnigne</label><seg type="original" xml:lang="en"><hi rend="italic">unscyldigne</hi>. B &amp; Ld.</seg></note>
      </div>
