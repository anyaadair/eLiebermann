      <div type="clause" n="6.3">
        <head><ref type="lawCode" target="law:Duel">Duel</ref> 6.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Duel 6.3" corresp="#wit-lat"><pb n="431" ed="#liebermann"/>quatinus, te adiuuante, hostem<ptr type="liebermannNote" n="38" target="#Duel_6-3.lnote.oe.38"/> prosternere atque uictoriam capessere<ptr type="liebermannNote" n="39" target="#Duel_6-3.lnote.oe.39"/> mereatur tibique soli<ptr type="liebermannNote" n="40" target="#Duel_6-3.lnote.oe.40"/>, Deo omnipotenti, bello<ptr type="liebermannNote" n="41" target="#Duel_6-3.lnote.oe.41"/> triumphaliter peracto<ptr type="liebermannNote" n="42" target="#Duel_6-3.lnote.oe.42"/>, gratias et laudes referat. Per Christum<ptr type="liebermannNote" n="43" target="#Duel_6-3.lnote.oe.43"/> dominum<ptr type="liebermannNote" n="44" target="#Duel_6-3.lnote.oe.44"/> nostrum. Respon. Amen.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 431 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_6-3.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">h. p. a. <hi rend="italic">fehlt Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. p. a. missing in Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_6-3.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">-scere <hi rend="italic">Mg Hm Ta Gl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-scere Mg Hm Ta Gl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_6-3.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">D. s. <hi rend="italic">Tr Mg Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">D. s. Tr Mg Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_6-3.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">b. t. p. <hi rend="italic">fehlt Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">b. t. p. missing in Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_6-3.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added in Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_6-3.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr Mg Ym Gl</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Tr Mg Ym Gl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_6-3.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">d. n. R. A. <hi rend="italic">nur Hm; nur</hi> dom. <hi rend="italic">Ym; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. n. R. A. only in Hm; only dom. Ym; missing in the others</seg></note>
