    <body>
      <div type="clause" n="72.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 72.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="72.1" corresp="#wit-g-a"><pb n="358" ed="#liebermann"/>And gif se bonda, ær he dead wære, beclypod<ptr type="liebermannNote" n="**" target="#IICn_72-1.lnote.oe.star2"/><ptr type="liebermannNote" n="23" target="#IICn_72-1.lnote.oe.23"/>, þonn<hi rend="italic">e</hi> <hi rend="italic">and</hi>- wyrdan<ptr type="liebermannNote" n="1" target="#IICn_72-1.lnote.oe.1-3"/> þa yrfenuman, swa he sylf sceolde, þeah he lif hæfde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="72.1" corresp="#wit-b"><pb n="358" ed="#liebermann"/>And gyf se bunda, ær he dead wære, wære beclypad, ðonne andwyrde<ptr type="liebermannNote" n="1" target="#IICn_72-1.lnote.oe.1-2"/> ða yrfnumen, swa he sylf sceolde, ðeah he lif hæfde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="72.1" corresp="#wit-a"><pb n="358" ed="#liebermann"/>And gif se bonda, ær he dead wære, beclypad wære, þon<hi rend="italic">ne</hi> andwirdan þa erfenumen, swa he sylf sceolde, þeah he lif hafde.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="72.1" corresp="#wit-q"><pb n="359" ed="#liebermann"/>Et si compellatus in uita sua fuerat in aliquo, respondeant heredes eius, sicut idem deberet, si uiueret.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="72.1" corresp="#wit-inst-cn"><pb n="359" ed="#liebermann"/>Si autem uir<ptr type="liebermannNote" n="20" target="#IICn_72-1.lnote.oe.20"/> ante mortem proclamatus de talibus fuit, oportet ut (eius<ptr type="liebermannNote" n="1" target="#IICn_72-1.lnote.oe.1-4"/>) heredes<ptr type="liebermannNote" n="2" target="#IICn_72-1.lnote.oe.2"/> secundum iusticiam respondeant, sicut ipse deberet, si uiueret.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="72.1" corresp="#wit-cons-cn"><pb n="359" ed="#liebermann"/>Quodsi uir ante obitum (suum) calumpniatus fuerit, illo mortuo, respondeant heredes sui calumpniis, ut ipse deberet.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="72.1" corresp="#wit-b"><pb n="210" ed="#robertson"/>And gyf se bunda, ær he dead wære, wære beclypad, ðonne andwyrde ða yrfnumen swa he sylf sceolde, ðeah he lif hæfde.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="290" ed="#rabin-doml"/>And gif se bonda, ær he dead wære, beclypod wære þonne andwyrdan þa yrfenuman swa he sylf sceolde, þeah he lif hæfde.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="359" ed="#liebermann"/>Wenn jedoch jener Hofbesitzer, bevor er todt war, verklagt worden ist<ptr type="liebermannNote" n="1" target="#IICn_72-1.lnote.de.1"/>, dann müssen die Erbnehmer sich verantworten, wie er selbst müsste, wenn er Leben hätte.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If, however, that householder was accused before he was dead, then the heirs must answer, as he himself would have to if he had life.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="211" ed="#robertson"/>And if the householder had been cited before his death, then his heirs shall answer the charge, as he himself would have done, had he been alive.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="472" ed="#whitelock"/>And if the householder was cited before he died, then the heirs are to answer as he would have had to, if he were alive.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="291" ed="#rabin-doml"/>And if a claim had been made against the householder before he died, then his heirs shall respond to the claim as he himself would have had he lived.</ab>
        <note type="comparison" source="#liebermann" n="359"><ref target="clause:IIIAtr_14">III Atr 14</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd.</note>
        <note type="editorial">G omits ‘wære’ after ‘beclypod’; Liebermann supplies it from the other MSS. Liebermann compares III Atr 14.; BR: added from Gesetze I p. 359, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">beclypod wære: beclypod G</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_72-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">359</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_72-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">eius calumpniatori <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius calumpniatori Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_72-1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_72-1.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">358</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> wære <hi rend="italic">aus übrigen</hi></seg><seg type="translation" xml:lang="en" source="#claude">supply wære from the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_72-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">358</biblScope></bibl><seg type="original" xml:lang="de">-ped wære, ðonn andwirdan ða yrfenamen <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ped wære, ðonn andwirdan ða yrfenamen Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_72-1.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de">⁊ wyrdan <hi rend="italic">G</hi></seg><seg type="translation" xml:lang="en" source="#claude">⁊ wyrdan G</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_72-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">359</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">fügt zu S</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius added by S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_72-1.lnote.oe.1-4" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_72-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">heres s. i. respondeat <hi rend="italic">Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">heres s. i. respondeat Lb S</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_72-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">212</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Über Q's <hi rend="italic">in aliquo s. o</hi>. 72²</seg><seg type="translation" xml:lang="en" source="#claude">On Q’s <hi rend="italic">in aliquo see above</hi> 72²</seg></note>
      </div>
