      <div type="clause" n="21.6">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 21.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 21.6" corresp="#wit-lat"><pb n="405" ed="#liebermann"/>Adiurata autem per nomen Christi, praecipimus tibi, ut nobis per<ptr type="liebermannNote" n="6" target="#IudDeiI_21-6.lnote.oe.6"/> nomen eius oboedias<ptr type="liebermannNote" n="7" target="#IudDeiI_21-6.lnote.oe.7"/>, cui omnis creatura seruit<ptr type="liebermannNote" n="8" target="#IudDeiI_21-6.lnote.oe.8"/>, quem Cherubin et<ptr type="liebermannNote" n="9" target="#IudDeiI_21-6.lnote.oe.9"/> Seraphin conlaudant<ptr type="liebermannNote" n="10" target="#IudDeiI_21-6.lnote.oe.10"/>, dicentes: ‘Sanctus sanctus sanctus dominus Deus exercituum’, qui etiam regnat et dominatur per infinita<ptr type="liebermannNote" n="11" target="#IudDeiI_21-6.lnote.oe.11"/> secula seculorum. Amen.<ptr type="liebermannNote" n="12" target="#IudDeiI_21-6.lnote.oe.12"/></ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Isai. 6, 3</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 405 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-6.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">pro nomine <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">pro nomine Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-6.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Rj H</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Rj H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-6.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">deseruit <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">deseruit Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-6.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">et S. <hi rend="italic">fehlt Pt Rj Ca</hi></seg><seg type="translation" xml:lang="en" source="#claude">et S. omitted in Pt Rj Ca</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-6.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">laudant <hi rend="italic">meist bei Zeu., aber S. Germ. u. a.</hi> conl.</seg><seg type="translation" xml:lang="en" source="#claude">laudant mostly in Zeu., but S. Germ. and others have conl.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-6.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">omnia <hi rend="italic">statt</hi> inf.—Amen. <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">omnia instead of inf.—Amen. Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-6.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ps Pt</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Ps Pt</seg></note>
      </div>
