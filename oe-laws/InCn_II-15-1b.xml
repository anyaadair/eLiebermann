      <div type="clause" n="II 15.1b">
        <head><ref type="lawCode" target="law:InCn">In Cn</ref> II 15.1b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="In Cn II 15.1b" corresp="#wit-lat"><pb n="612" ed="#liebermann"/>In lege eorum<ptr type="liebermannNote" n="e" target="#InCn_II-15-1b.lnote.oe.e"/> liberalis hominis lahslit uocant X dimidię marcę, hoc est V marcę<ptr type="liebermannNote" n="f" target="#InCn_II-15-1b.lnote.oe.f"/>; hominis alodium<ptr type="liebermannNote" n="6" target="#InCn_II-15-1b.lnote.oe.6"/> (bocland<ptr type="liebermannNote" n="7" target="#InCn_II-15-1b.lnote.oe.7"/>) habentis sex dimidię marcę, hoc est tres marcę; uillani lahslit, quem<ptr type="liebermannNote" n="8" target="#InCn_II-15-1b.lnote.oe.8"/> Angli uocant ceorlman<ptr type="liebermannNote" n="9" target="#InCn_II-15-1b.lnote.oe.9"/> XII orę<ptr type="liebermannNote" n="10" target="#InCn_II-15-1b.lnote.oe.10"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 612 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_II-15-1b.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">612</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nämlich</hi> Danorum. <hi rend="italic">Diese Busssätze zahlen bezw.</hi> cyninges þegn [liberalis <hi rend="italic">setzen Inst. oft für</hi> þegn], landagende, cyrlisc man <hi rend="italic">nach</hi> Northu. 51 <hi rend="italic">ff., o. S.</hi> 383, <hi rend="italic">deren Benutzung hierfür auch Steenstrup</hi> Danelag 267 <hi rend="italic">annimmt</hi></seg><seg type="translation" xml:lang="en" source="#claude">namely Danorum. These rates of compensation are paid respectively by the cyninges þegn [the Inst. often put liberalis for þegn], the landagende and the cyrlisc man according to Northu. 51 ff., above p. 383, which Steenstrup Danelag 267 also assumes to have been used here</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_II-15-1b.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">612</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 12. <hi rend="italic">Jahrh.</hi> 1 <hi rend="italic">Mark</hi> = ⅔ <hi rend="italic">Pfund</hi></seg><seg type="translation" xml:lang="en" source="#claude">in the 12th cent. 1 mark = ⅔ pound</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_II-15-1b.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">612</biblScope></bibl><seg type="original" xml:lang="de">h. a. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. a. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_II-15-1b.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">612</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur H, übergeschr., fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">only H, written above, missing in the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_II-15-1b.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">612</biblScope></bibl><seg type="original" xml:lang="de">quam <hi rend="italic">CbLb</hi></seg><seg type="translation" xml:lang="en" source="#claude">quam CbLb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_II-15-1b.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">612</biblScope></bibl><seg type="original" xml:lang="de">cherlman <hi rend="italic">CbLb</hi></seg><seg type="translation" xml:lang="en" source="#claude">cherlman CbLb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_II-15-1b.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">612</biblScope></bibl><seg type="original" xml:lang="de">hore <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">hore Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_II-15-1b.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">332</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Rechtsbruchbusse 5. 8a; Thegn 22; gemeinfrei 9b; Ör 4b; Halbmark 3; Allod 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Rechtsbruchbusse 5. 8a; Thegn 22; gemeinfrei 9b; Ör 4b; Halbmark 3; Allod 1</seg></note>
      </div>
