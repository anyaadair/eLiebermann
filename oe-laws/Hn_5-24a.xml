      <div type="clause" n="5.24a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.24a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.24a" corresp="#wit-lat"><pb n="551" ed="#liebermann"/>Appellantem<ptr type="liebermannNote" n="c" target="#Hn_5-24a.lnote.oe.c"/> autem et uiciatam<ptr type="liebermannNote" n="5" target="#Hn_5-24a.lnote.oe.5"/> causam appellacionis remedio<ptr type="liebermannNote" n="6" target="#Hn_5-24a.lnote.oe.6"/> subleuantem non debet afflictio uel detentionis iniuriari<ptr type="liebermannNote" n="d" target="#Hn_5-24a.lnote.oe.d"/><ptr type="liebermannNote" n="7" target="#Hn_5-24a.lnote.oe.7"/> custodia.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 551 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-24a.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ivo</hi> Pan. IV 121; <hi rend="italic">Gratian</hi> C. 2 q. 6 c. 2</seg><seg type="translation" xml:lang="en" source="#claude">Ivo Pan. IV 121; Gratian C. 2 q. 6 c. 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-24a.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">activischen Sinnes; nicht mit Somner:</hi> appellans et subleuans afflictionis iniuriari custodiā</seg><seg type="translation" xml:lang="en" source="#claude">in an active sense; not, with Somner: appellans et subleuans afflictionis iniuriari custodiā</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-24a.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">uisitatam <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">uisitatam Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-24a.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">-dium <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dium Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-24a.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">in iuriali <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">in iuriali Lond</seg></note>
