    <body>
      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-g-a"><pb n="308" ed="#liebermann"/>⁊ heonon<ptr type="liebermannNote" n="9" target="#IICn_1-1.lnote.oe.9"/> forð læte manna gehwylcne, ge earmne<ptr type="liebermannNote" n="10" target="#IICn_1-1.lnote.oe.10"/> ge eadigne<ptr type="liebermannNote" n="11" target="#IICn_1-1.lnote.oe.11"/>, folcrihtes weorðne<ptr type="liebermannNote" n="12" target="#IICn_1-1.lnote.oe.12"/>, and hi<hi rend="italic">m</hi> man rihte domas<ptr type="liebermannNote" n="13" target="#IICn_1-1.lnote.oe.13"/> deme.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-b"><pb n="308" ed="#liebermann"/>⁊ héonon forþ<ptr type="liebermannNote" n="2" target="#IICn_1-1.lnote.oe.2-2"/> lǽte manna gehwylcne, ge earmne ge eadigne, folcrihtes weorðe, ⁊ him man rihte domas deme.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-a"><pb n="308" ed="#liebermann"/>⁊ heonan forð læte manna gehwylcne, ge earmne ge eadigene, folcrihtes wyrðe, ⁊ him man rihte domes<ptr type="liebermannNote" n="2" target="#IICn_1-1.lnote.oe.2-4"/> deme.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-d-frags"><pb n="308" ed="#liebermann"/>[1, 1] ⁊ heonan forð læte manna gehwilcne, ge earmne ge eadigne, folcrihtes wurðe beon.<ptr type="liebermannNote" n="2" target="#IICn_1-1.lnote.oe.2-3"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.1" corresp="#wit-q"><pb n="309" ed="#liebermann"/>Et amodo reputetur omnis homo publica dignus rectitudine, pauper, diues<ptr type="liebermannNote" n="3" target="#IICn_1-1.lnote.oe.3"/>, quicumque sit, et eis iusta<ptr type="liebermannNote" n="4" target="#IICn_1-1.lnote.oe.4"/> iudicia iudicentur.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.1" corresp="#wit-inst-cn"><pb n="309" ed="#liebermann"/>recte leges<ptr type="liebermannNote" n="6" target="#IICn_1-1.lnote.oe.6"/> diuiti<ptr type="liebermannNote" n="7" target="#IICn_1-1.lnote.oe.7"/> et pauperi teneantur.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.1" corresp="#wit-cons-cn"><pb n="309" ed="#liebermann"/>[1, 1] Amodo paciamur hominem quemque, miserum tam quam felicem, puplica rectitudine dignum esse, et ut illi iustum iudicium iudicetur.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="1.1" corresp="#wit-b"><pb n="174" ed="#robertson"/>⁊ héonon forð lǽte manna gehwylcne, ge earmne ge eadigne, folcrihtes weorð<ptr type="editorNote" n="7" target="#IICn_1-1.robnote.fn.7"/>e ⁊ him man rihte domas deme.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="254" ed="#rabin-doml"/>And heonon forð læte manna gehwylcne, ge earmne ge eadigne, folcrihtes weorðne and him man rihte domas deme.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="309" ed="#liebermann"/>und hinfort jeden Menschen, so armen wie reichen, Landrechtes theilhaftig (sein <hi rend="italic">D</hi>) lasse, und man ihm gerechte Urtheile ertheile.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">and that henceforth every person, poor as well as rich, be allowed (to be, D) entitled to folk-right, and just judgments be given him.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_1-1.robnote.n.1"/><pb n="175" ed="#robertson"/>And henceforth all men, both poor and rich, shall be regarded as entitled to the benefit of the law, and just decisions shall be pronounced on their behalf.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="255" ed="#rabin-doml"/>And henceforth, all people, both rich and poor, shall be granted their legal rights and just rulings shall be issued for them.</ab>
        <note type="comparison" source="#liebermann" n="309"><ref target="clause:VIAtr_8-1">VI Atr 8.1</ref>; <ref target="clause:IIIEg_1-1">III Eg 1.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">VI Atr. 8, 1 | *III Eg. 1, 1</note>
        <note type="comparison" source="#wormald-mel" n="319"><label>=</label> <ref target="clause:VIAtr_8-1">VI Atr 8.1</ref> <quote>VI Atr 8:1 = II Cn 1:1</quote></note>
        <note type="comparison" source="#wormald-mel" n="357"><label>source (roman)</label> <ref target="clause:IIIEg_1-1">III Eg 1.1</ref> <quote>Table 5.4, II Cn 1:1: Cn 1018 3:1  VI Atr 8:1, III Eg 1:1</quote></note>
        <note type="comparison" source="#wormald-mel" n="357"><label>source (roman)</label> <ref target="clause:VIAtr_8-1">VI Atr 8.1</ref> <quote>Table 5.4, II Cn 1:1: Cn 1018 3:1  VI Atr 8:1, III Eg 1:1</quote></note>
        <note type="comparison" source="#wormald-mel" n="357"><label>source (roman)</label> <ref target="clause:Cn-1018_part-010">Cn 1018 3.1</ref> <quote>Table 5.4, II Cn 1:1: Cn 1018 3:1  VI Atr 8:1, III Eg 1:1</quote></note>
        <note type="editorial">Liebermann compares VI Atr 8.1; III Eg 1.1.; BR: added from Gesetze I p. 309, October 2026 (MS Cons)</note>
