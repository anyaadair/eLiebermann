    <body>
      <div type="clause" n="31">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 31</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 31"><pb n="653" ed="#liebermann"/>Erant etiam<ptr type="liebermannNote" n="9" target="#ECf_31.lnote.la.9"/> alie potestates super wapentagiis<ptr type="liebermannNote" n="10" target="#ECf_31.lnote.la.10"/>, quas <ptr type="liebermannNote" n="c" target="#ECf_31.lnote.la.fn.c"/>trehingas<ptr type="liebermannNote" n="11" target="#ECf_31.lnote.la.11"/> uocabant<ptr type="liebermannNote" n="12" target="#ECf_31.lnote.la.12"/>, scilicet super<ptr type="liebermannNote" n="13" target="#ECf_31.lnote.la.13"/> terciam<ptr type="liebermannNote" n="a" target="#ECf_31.lnote.oe.erkl-a"/> partem prouincie<ptr type="liebermannNote" n="d" target="#ECf_31.lnote.la.fn.d"/>.</ab>
        <note type="comparison" source="#liebermann" n="653"><label>printed alongside</label> <ref target="clause:ECfRetr_31">ECf retr 31</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 653 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Aspiration der Initiale, aus Nord.</hi> þriðjungr, <hi rend="italic">in einigen Hss. an mehreren Stellen, stand im Orig. vielleicht stets</hi></seg><seg type="translation" xml:lang="en" source="#claude">the aspiration of the initial, from Norse þriðjungr, in some MSS in several places, perhaps stood always in the original</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Grafschaft; vgl.</hi> 5, 3. 9</seg><seg type="translation" xml:lang="en" source="#claude">shire; cf. 5, 3. 9</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">-gias <hi rend="italic">Rl;</hi> -tagia <hi rend="italic">Hk;</hi> -tachia <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gias Rl; -tagia Hk; -tachia Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">-higgas <hi rend="italic">Rl S;</hi> tres higgas <hi rend="italic">Hr;</hi> tringas <hi rend="italic">Ad;</hi> dingas <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-higgas Rl S; tres higgas Hr; tringas Ad; dingas Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">uocant <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">uocant Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk Ad Do</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">There were also other authorities over the wapentakes, which they called <hi rend="italic">trehingas</hi> (ridings), namely over the third part of the province.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">348</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Riding 1. 4; Fritzner <hi rend="italic">Ordbog</hi> 1040. Wilhelm II. eximiert S. Mary's York von Gerichtsfolge zum <hi rend="italic">trithing;</hi> Davis <hi rend="italic">Reg. Agnorm.</hi> *313. — <hi rend="italic">Item de</hi><hi rend="superscript">26</hi> <hi rend="italic">tr. et ledis</hi> (ohne <hi rend="italic">wap.</hi><hi rend="superscript">22</hi> bis <hi rend="italic">hundredum</hi>). <hi rend="italic">Er. et.</hi><hi rend="superscript">20</hi> <hi rend="italic">et a.</hi> Rs. — Verf. strich wohl selbst bessernd <hi rend="italic">super</hi><hi rend="superscript">18</hi> gemäss adow Hk Retr</seg><seg type="translation" xml:lang="en" source="#claude">Cf. <hi rend="italic">Gl</hi> Riding 1. 4; Fritzner <hi rend="italic">Ordbog</hi> 1040. William II exempts St Mary's York from suit to the <hi rend="italic">trithing</hi>; Davis <hi rend="italic">Reg. Agnorm.</hi> *313. — <hi rend="italic">Item de</hi><hi rend="superscript">26</hi> <hi rend="italic">tr. et ledis</hi> (without <hi rend="italic">wap.</hi><hi rend="superscript">22</hi> to <hi rend="italic">hundredum</hi>). <hi rend="italic">Er. et.</hi><hi rend="superscript">20</hi> <hi rend="italic">et a.</hi> Rs. — The author probably himself struck out <hi rend="italic">super</hi><hi rend="superscript">18</hi> as a correction, following adow Hk Retr</seg></note>
      </div>
    </body>
  </text>
