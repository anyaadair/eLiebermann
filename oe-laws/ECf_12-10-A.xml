      <div type="clause" n="12.10 A">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 12.10 A</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 12.10 A"><pb n="639" ed="#liebermann"/>Uerum quod modo comitatus<ptr type="liebermannNote" n="1" target="#ECf_12-10-A.lnote.la.1"/> uocatur<ptr type="liebermannNote" n="2" target="#ECf_12-10-A.lnote.la.2"/>, olim apud Britones<ptr type="liebermannNote" n="i" target="#ECf_12-10-A.lnote.la.fn.i"/> temporibus Romanorum in regno isto Britannie uocabatur consulatus.</ab>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 639 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">This passage is not part of ECf or ECf retr: it is one of the additions of the London collection (Leges Anglorum s. XIII in. Londoniis collectae), which Liebermann prints in smaller type across the page, under ECf retr. 12, 10, and numbers 12, 10 A ff. The dictionary cites it as “ECf 12, 10 A …”, so it is kept with ECf here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-10-A.lnote.la.fn.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt</hi> ECf. 32 A</seg><seg type="translation" xml:lang="en" source="#claude">repeated at ECf. 32 A</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-10-A.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K; am Rande Co;</hi> u. c. <hi rend="italic">Or Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K; in the margin Co; u. c. Or Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-10-A.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">uocatus <hi rend="italic">K Co; geänd.</hi> -tur <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">uocatus K Co; altered to -tur Co</seg></note>
      </div>
    </body>
