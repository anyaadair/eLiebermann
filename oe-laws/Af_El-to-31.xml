      <div type="clause" n="El. 31">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 31</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 31" corresp="#wit-e"><pb n="38" ed="#liebermann"/>⁊<ptr type="liebermannNote" n="11" target="#Af_El-to-31.lnote.oe.11"/> se ðe hæme mid netene<ptr type="liebermannNote" n="15" target="#Af_El-to-31.lnote.oe.15"/>, swelte<ptr type="liebermannNote" n="16" target="#Af_El-to-31.lnote.oe.16"/> he deaðe.<ptr type="liebermannNote" n="17" target="#Af_El-to-31.lnote.oe.17"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 31" corresp="#wit-g-prol-only"><pb n="38" ed="#liebermann"/>And se ðe hæme …<ptr type="liebermannNote" n="3" target="#Af_El-to-31.lnote.oe.3"/> nietene, swelte se deaðe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 31" corresp="#wit-h"><pb n="39" ed="#liebermann"/>And se þe hæme mid nytene, swelte se deaþe.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 31" corresp="#wit-q"><pb n="39" ed="#liebermann"/>Qui coierit cum iumento, morte moriatur.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 31" corresp="#wit-e"><pb n="254" ed="#jurasinski-and-oliver"/>⁊ se ðe hæme mid netene, swelte he deaðe.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="39" ed="#liebermann"/>Und wer mit Vieh sich gattet, er sterbe Todes.<ptr type="liebermannNote" n="1" target="#Af_El-to-31.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And whoever couples with a beast, let him die the death.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="255" ed="#jurasinski-and-oliver"/>He who lies with cattle, let him die [the] death.</ab>
        <note type="passageSource">Exodus 22,19</note>
        <note type="comparison" source="#liebermann" n="39">Exodus 22.19</note>
        <note type="comparisonPrinted" source="#liebermann">[22, 19]</note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-31.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">38</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt So</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-31.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">38</biblScope></bibl><seg type="original" xml:lang="de">nyt. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">nyt. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-31.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">38</biblScope></bibl><seg type="original" xml:lang="de">swelt se <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">swelt se So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-31.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">38</biblScope></bibl><seg type="original" xml:lang="de">deaþ <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">deaþ So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-31.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">38</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Loch; am Rande neu:</hi> mid</seg><seg type="translation" xml:lang="en" source="#claude">hole; in the margin, in a later hand: mid</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-31.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">46</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Bestialität</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Bestialität</seg></note>
      </div>
