      <div type="clause" n="29.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 29.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 29.2" corresp="#wit-lat"><pb n="563" ed="#liebermann"/>Qui<ptr type="liebermannNote" n="g" target="#Hn_29-2.lnote.oe.g"/> ad hundretum<ptr type="liebermannNote" n="21" target="#Hn_29-2.lnote.oe.21"/> submonitus<ptr type="liebermannNote" n="17" target="#Hn_29-2.lnote.oe.17"/> sine aliqua et uera necessitatis causa uenire noluerit, capiatur de suo triginta den. ualens prima et secunda uice et<ptr type="liebermannNote" n="22" target="#Hn_29-2.lnote.oe.22"/> hundreti<ptr type="liebermannNote" n="23" target="#Hn_29-2.lnote.oe.23"/> namium<ptr type="liebermannNote" n="24" target="#Hn_29-2.lnote.oe.24"/> sit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 563 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-2.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">Verklagter; <hi rend="italic">wiederholt</hi> 51, 1</seg><seg type="translation" xml:lang="en" source="#claude">The defendant; repeated 51, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">summo. <hi rend="italic">stets Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">summo. Lond throughout</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">hon. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">hon. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-2.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">fügt vom Corr. übergeschr. zu Sc;</hi> in <hi rend="italic">Hg Tho.</hi></seg><seg type="translation" xml:lang="en" source="#claude">in added above the line by the corrector Sc; in Hg Tho.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-2.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">-edo <hi rend="italic">Wi Tho. gegen Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-edo Wi Tho. against the MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-2.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert vom Corr. aus</hi> nami <hi rend="italic">Sc;</hi> manu <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the corrector from nami Sc; manu Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Gerichtsversäumnis 5. a. 8; Hundred 18. c. 31b. Die Vorladung in 29, 1c bezweckte Urteilfindung, hier, wie in Hu, Reinigung von Klage, laut 29, 2a; 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Gerichtsversäumnis 5. a. 8; Hundred 18. c. 31b. The summons in 29, 1c was for the finding of judgment; here, as in Hu, it is for clearing oneself of a charge, according to 29, 2a; 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-2.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de">Die Obrigkeit, nicht der Kläger, erhält das Abgepfändete; <hi rend="italic">vgl. Gl</hi> Prozessualpfand 12.—29, 2a <hi rend="italic">sais</hi>.{25} Rs</seg><seg type="translation" xml:lang="en" source="#claude">The authorities, not the plaintiff, receive what is distrained; <hi rend="italic">cf. Gl</hi> Prozessualpfand 12. — 29, 2a <hi rend="italic">sais</hi>.{25} Rs</seg></note>
      </div>
