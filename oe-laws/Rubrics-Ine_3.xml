        <head>Ine Rb 3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3" corresp="#wit-e"><pb n="20" ed="#liebermann"/>XLVII. Be sunnan dæges weorcum.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3" corresp="#wit-ot-frag"><pb n="20" ed="#liebermann"/>… dæges weorcum.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3" corresp="#wit-g-prol"><pb n="20" ed="#liebermann"/>XLVII. Be Sunnan dæges wyrcum.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3" corresp="#wit-h"><pb n="21" ed="#liebermann"/>XLVII. Be sunnon<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_3.lnote.oe.2"/> dæges weorcum.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3" corresp="#wit-q"><pb n="21" ed="#liebermann"/>De opere diei dominicæ.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="200" ed="#jurasinski-and-oliver"/>XLVII Be sunnan dæges weorcum</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="21" ed="#liebermann"/>Von Sonntagsarbeiten.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of Sunday work.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="201" ed="#jurasinski-and-oliver"/>Concerning working on Sunday</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_3.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
