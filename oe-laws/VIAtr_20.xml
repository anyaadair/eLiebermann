    <body>
      <div type="clause" n="20">
        <head><ref type="lawCode" target="law:VIAtr">VI Atr</ref> 20</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="20" corresp="#wit-k"><pb n="252" ed="#liebermann"/>K. ⁊ saulsceat is rihtast, þ<hi rend="italic">æt</hi> man symble gelæste aa æt openum græfe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="20" corresp="#wit-d-incomplete"><pb n="252" ed="#liebermann"/>⁊ sawlsceat is rihtast, þ<hi rend="italic">æt</hi> man gelæste æt ða<hi rend="italic">m</hi> openu<hi rend="italic">m</hi> græfe.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="20" corresp="#wit-k"><pb n="96" ed="#robertson"/>⁊ saulsceat is rihtast þæt man symble<ptr type="editorNote" n="3" target="#VIAtr_20.robnote.fn.3"/> gelæste aa<ptr type="editorNote" n="3" target="#VIAtr_20.robnote.fn.3"/> æt openum<ptr type="editorNote" n="4" target="#VIAtr_20.robnote.fn.4"/> græfe.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-k"><pb n="168" ed="#rabin-doml"/>And saulsceat is rihtast, þæt man symble gelæste aa æt openum græfe.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="253" ed="#liebermann"/>Und Seelengeld ist am richtigsten, dass man immer<ptr type="liebermannNote" n="1" target="#VIAtr_20.lnote.de.1"/> sofort entrichte beim offenen Grabe.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And as for soul-scot, it is most right that it always be paid at once at the open grave.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-k"><ptr type="editorNote" n="1" target="#VIAtr_20.robnote.n.1"/><pb n="97" ed="#robertson"/>And it is best that payment for the souls of the dead should always be rendered before the grave is closed.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-k"><pb n="169" ed="#rabin-doml"/>And it is most appropriate that dues for the souls of the dead always be paid while the grave is yet open.</ab>
        <note type="comparison" source="#liebermann" n="253"><ref target="clause:VAtr_12">V Atr 12</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 12</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VIIIAtr_13">VIII Atr 13</ref>; <ref target="clause:ICn_13">I Cn 13</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="356"><label>quoted verbatim (bold in Wormald's table)</label> <ref target="clause:ICn_13">I Cn 13</ref> <quote>Table 5.4, I Cn 13: Cn 1018 13:6  VIII Atr 13, VI Atr 20</quote></note>
        <note type="comparedBy" source="#wormald-ppmel" n="24"><label>parallel versions</label> <ref target="clause:ICn_13">I Cn 13–13.1</ref> <quote>the apparently chronological order of the laws of Æthelred and Cnut as cited above may conceal the stages whereby Wulfstan's ideas evolved</quote></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VIAtr_20.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">176</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aa</hi> nur V Atr Hs. G 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">aa</hi> only in V Atr MS G 2</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VIAtr_20.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">333</biblScope></bibl><seg type="original" xml:lang="en">Cf. V, 12.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="VIAtr_20.robnote.fn.3" n="3" source="#robertson"><bibl><biblScope unit="page">96</biblScope></bibl><label>⁊</label><seg type="original" xml:lang="en">Om. D.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="VIAtr_20.robnote.fn.4" n="4" source="#robertson"><bibl><biblScope unit="page">96</biblScope></bibl><label>openum</label><seg type="original" xml:lang="en"><hi rend="italic">ðam op.</hi> D.</seg></note>
      </div>
