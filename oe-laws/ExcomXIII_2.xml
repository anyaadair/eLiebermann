      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:ExcomXIII">Excom XIII</ref> 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom XIII 2" corresp="#wit-ym"><ptr type="liebermannNote" n="a" target="#ExcomXIII_2.lnote.oe.a"/><pb n="441" ed="#liebermann"/>Ex auctoritate Dei, patris omnipotentis et filii et Spiritus sancti, et sanctorum apostolorum et sanctorum canonum<ptr type="liebermannNote" n="d" target="#ExcomXIII_2.lnote.oe.d"/> et nostri ministerii<ptr type="liebermannNote" n="e" target="#ExcomXIII_2.lnote.oe.e"/>,</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Gemmetic.</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 441 (two independent readings of the page images, differences settled against the page); Liebermann prints in smaller type: Ex auctoritate Dei, patris omnipotentis et filii et Spiritus sancti, et sanctorum apostolorum et sanctorum canonum et nostri ministerii,</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXIII_2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ich drucke klein was gleich lautet mit</hi> Gem 2 (<hi rend="italic">vgl. o. S.</hi> 432ᵃ). XIII <hi rend="italic">steht</hi> IX. XII <hi rend="italic">zunächst.</hi></seg><seg type="translation" xml:lang="en" source="#claude">I print in small type what agrees verbatim with Gem 2 (cf. above p. 432ᵃ). XIII is closest to IX and XII.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXIII_2.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> III 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> III 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXIII_2.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> I 11, 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> I 11, 1</seg></note>
      </div>
