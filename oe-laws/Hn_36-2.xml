      <div type="clause" n="36.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 36.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 36.2" corresp="#wit-lat"><pb n="566" ed="#liebermann"/>Si quis<ptr type="liebermannNote" n="w" target="#Hn_36-2.lnote.oe.w"/> alii malefactum suum emendauerit uel dampnum suum restituerit, et postmodum ex eius amicitia consequenda aliquid ei cum iuramento pacis offerat, ad laudem est ei<ptr type="liebermannNote" n="x" target="#Hn_36-2.lnote.oe.x"/> cui offertur, si<ptr type="liebermannNote" n="42" target="#Hn_36-2.lnote.oe.42"/> totum reddat<ptr type="liebermannNote" n="x" target="#Hn_36-2.lnote.oe.x"/> et non contumelie<ptr type="liebermannNote" n="y" target="#Hn_36-2.lnote.oe.y"/> sue suggestionem retineat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 566 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-2.lnote.oe.w" n="w" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Beklagter</hi></seg><seg type="translation" xml:lang="en" source="#claude">defendant</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-2.lnote.oe.x" n="x" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Kläger</hi></seg><seg type="translation" xml:lang="en" source="#claude">plaintiff</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-2.lnote.oe.y" n="y" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 39</seg><seg type="translation" xml:lang="en" source="#claude">cf. 39</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-2.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">quod t. r., non etiam co. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod t. r., non etiam co. Lond</seg></note>
