      <div type="clause" n="77.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 77.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="77.1" corresp="#wit-g-a"><pb n="364" ed="#liebermann"/>⁊ gyf<ptr type="liebermannNote" n="16" target="#IICn_77-1.lnote.oe.16"/> he bocland hæbbe, ga þ<hi rend="italic">æt</hi> þam cingce<ptr type="liebermannNote" n="17" target="#IICn_77-1.lnote.oe.17"/> to handa.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="77.1" corresp="#wit-a"><pb n="364" ed="#liebermann"/>⁊ gif he bocland hæbbe, ga þ<hi rend="italic">æt</hi> þa<hi rend="italic">m</hi> cyninge to hande.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="77.1" corresp="#wit-q"><pb n="365" ed="#liebermann"/>Et si terram hereditariam<ptr type="liebermannNote" n="11" target="#IICn_77-1.lnote.oe.11"/> habeat, ipsa in manum<ptr type="liebermannNote" n="12" target="#IICn_77-1.lnote.oe.12"/> regis transeat.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="77.1" corresp="#wit-inst-cn"><pb n="365" ed="#liebermann"/>Si autem habuerit<ptr type="liebermannNote" n="14" target="#IICn_77-1.lnote.oe.14"/> alodium, sit regis.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="77.1" corresp="#wit-cons-cn"><pb n="365" ed="#liebermann"/>[77, 1] Qui si liberam terram habeat, cadat hec in ius regis.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="77.1" corresp="#wit-b"><pb n="214" ed="#robertson"/>[⁊ gyf he bocland hæbbe, ga þæt þam cingce to handa.]<ptr type="editorNote" n="11" target="#IICn_77-1.robnote.fn.11"/></ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="294" ed="#rabin-doml"/>And gyf he bocland hæbbe, ga þæt þam cingce to handa.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="365" ed="#liebermann"/>Und wenn derselbe Land durch [königliches] Privileg besitzt, falle<ptr type="liebermannNote" n="1" target="#IICn_77-1.lnote.de.1"/> dies dem König in die Hand.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if he holds land by [royal] charter, let it fall into the king's hand.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_77-1.robnote.n.1"/><pb n="215" ed="#robertson"/>[And if he has land held by title-deed it shall pass into the king's hands.]</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="473" ed="#whitelock"/>And if he has bookland, that is to pass into the king’s possession.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="295" ed="#rabin-doml"/>And if he holds land by charter, it shall pass into the hands of the king.</ab>
        <note type="editorial">BR: added from Gesetze I p. 365, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">omitted B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_77-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">365</biblScope></bibl><seg type="original" xml:lang="de">inhered. <hi rend="italic">Dm</hi>; <hi rend="spaced">bocland</hi> <hi rend="italic">Hn</hi></seg><seg type="translation" xml:lang="en" source="#claude">inhered. Dm; <hi rend="italic">bocland</hi> Hn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_77-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">365</biblScope></bibl><seg type="original" xml:lang="de">manus <hi rend="italic">K</hi>; <hi rend="italic">Leges Angl. in ECf.</hi> 32 <hi rend="italic">B</hi> 2</seg><seg type="translation" xml:lang="en" source="#claude">manus K; Leges Angl. in ECf. 32 B 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_77-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">364</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_77-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">364</biblScope></bibl><seg type="original" xml:lang="de">cyningc to hande <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyningc to hande Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_77-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">365</biblScope></bibl><seg type="original" xml:lang="de">haberet <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">haberet Cb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_77-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">213</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. 13, 1¹</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 13, 1¹</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_77-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">359</biblScope></bibl><seg type="original" xml:lang="en">Cf. cap. 13, 1.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_77-1.robnote.fn.11" n="11" source="#robertson"><bibl><biblScope unit="page">214</biblScope></bibl><label>handa</label><seg type="original" xml:lang="en">G, A, Ld; om. B.</seg></note>
      </div>
    </body>
