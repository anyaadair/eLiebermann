      <div type="clause" n="5.26">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.26</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.26" corresp="#wit-lat"><pb n="551" ed="#liebermann"/>Quodsi<ptr type="liebermannNote" n="14" target="#Hn_5-26.lnote.oe.14"/> episcopi<ptr type="liebermannNote" n="f" target="#Hn_5-26.lnote.oe.f"/> uel clerici ui uel timore eiecti<ptr type="liebermannNote" n="15" target="#Hn_5-26.lnote.oe.15"/> uel suis rebus exspoliati fuerint, prius eis omnia sua legaliter reddantur, et tantum temporis spacium habeant, quanto dissaisiati<ptr type="liebermannNote" n="g" target="#Hn_5-26.lnote.oe.g"/><ptr type="liebermannNote" n="16" target="#Hn_5-26.lnote.oe.16"/> fuisse<ptr type="liebermannNote" n="17" target="#Hn_5-26.lnote.oe.17"/> uidebuntur, antequam ad iudicium (canonice<ptr type="liebermannNote" n="18" target="#Hn_5-26.lnote.oe.18"/>) uocentur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 551 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-26.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Ps.-Is.</hi> 184. 237; <hi rend="italic">auch Ivo</hi> Decr. V 335. 249; <hi rend="italic">Gr.</hi> C. 2 q. 2 c. 3; C. 3 q. 2 c. 6</seg><seg type="translation" xml:lang="en" source="#claude">from Ps.-Is. 184. 237; also Ivo Decr. V 335. 249; Gr. C. 2 q. 2 c. 3; C. 3 q. 2 c. 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-26.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vg. o.</hi> 5, 3</seg><seg type="translation" xml:lang="en" source="#claude">cf. above 5, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-26.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">Et si <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et si Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-26.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">doppelt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">written twice Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-26.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">-sati <hi rend="italic">Sc;</hi> disseisiate <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sati Sc; disseisiate Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-26.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">esse <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">esse K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-26.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vom Corr. übergeschr. Sc; im Text Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above by the corrector Sc; in the text Hg</seg></note>
      </div>
