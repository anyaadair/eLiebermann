        <head><ref type="lawCode" target="law:Hn">Hn</ref> 75.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 75.5" corresp="#wit-lat"><pb n="592" ed="#liebermann"/>Qui aliquem de parentibus<ptr type="liebermannNote" n="h" target="#Hn_75-5.lnote.oe.h"/> suis occidet<ptr type="liebermannNote" n="14" target="#Hn_75-5.lnote.oe.14"/>, dignis apud Deum penitencie fructibus emendet; et in modo penitencie sit, si sponte<ptr type="liebermannNote" n="15" target="#Hn_75-5.lnote.oe.15"/> uel casu perpetrauerit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 592 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-5.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 68, 9</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 68, 9</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-5.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de">-dat, dingn. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dat, dingn. <hi rend="italic">Sc Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-5.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de">c. uel s. perpetrauit <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. uel s. perpetrauit <hi rend="italic">Lond</hi></seg></note>
