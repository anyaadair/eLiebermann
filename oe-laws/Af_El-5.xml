        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El.5" corresp="#wit-e"><pb n="28" ed="#liebermann"/>Ne sleah<ptr type="liebermannNote" n="8" target="#Af_El-5.lnote.oe.8"/> ðu.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El.5" corresp="#wit-g-prol-only"><pb n="28" ed="#liebermann"/>Ne sleah ðu.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El.5" corresp="#wit-h"><pb n="29" ed="#liebermann"/>Ne sleah þu.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El.5" corresp="#wit-q"><pb n="29" ed="#liebermann"/>Non occides.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 5" corresp="#wit-e"><pb n="228" ed="#jurasinski-and-oliver"/>Ne sleah ðu.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="29" ed="#liebermann"/>Tödte du nicht.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Do not kill.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="229" ed="#jurasinski-and-oliver"/>Do not kill.</ab>
