      <div type="clause" n="4">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 4" corresp="#wit-lat"><ptr type="liebermannNote" n="32" target="#Hn_4.lnote.oe.32"/><pb n="547" ed="#liebermann"/>De generibus causarum. (De causarum liberatione.<ptr type="liebermannNote" n="33" target="#Hn_4.lnote.oe.33"/>) Genera<ptr type="liebermannNote" n="h" target="#Hn_4.lnote.oe.h"/> causarum tria sunt: deliberatiuum de faciendo et non faciendo, demonstratiuum de laude uel<ptr type="liebermannNote" n="34" target="#Hn_4.lnote.oe.34"/> uituperio, iudiciale de pena uel<ptr type="liebermannNote" n="35" target="#Hn_4.lnote.oe.35"/> merito.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 547 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_4.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">547</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dieselbe Isidor-Stelle benutzt, aber bald mehr bald minder vollständig als Hn, Quadr.,</hi> Ded. 29 <hi rend="italic">ff., o. S.</hi> 531 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">the same passage of Isidore is used, but sometimes more and sometimes less completely than in Hn, by Quadr., Ded. 29 ff., above p. 531 f.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_4.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">547</biblScope></bibl><seg type="original" xml:lang="de">C. V. De g. c. <hi rend="italic">K Co Or Gi;</hi> c. l. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">C. V. De g. c. K Co Or Gi; c. l. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_4.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">547</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> libra. <hi rend="italic">oder</hi> delib.</seg><seg type="translation" xml:lang="en" source="#claude">read libra. or delib.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_4.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">547</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_4.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">547</biblScope></bibl><seg type="original" xml:lang="de">u. m. <hi rend="italic">übergeschr. im</hi> 13. <hi rend="italic">Jh. Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. m. written above in the 13th cent. Sc</seg></note>
      </div>
