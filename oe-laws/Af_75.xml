      <div type="clause" n="75">
        <head><ref type="lawCode" target="law:Af">Af</ref> 75</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="75" corresp="#wit-e"><pb n="86" ed="#liebermann"/>Gif mon ða greatan sinwe forslea, gif hie<ptr type="liebermannNote" n="14" target="#Af_75.lnote.oe.14"/> mon gelacnian mæge, þæt hio<ptr type="liebermannNote" n="15" target="#Af_75.lnote.oe.15"/> hal sie, geselle XII scill. to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="75" corresp="#wit-h"><pb n="86" ed="#liebermann"/>Gif mon<ptr type="liebermannNote" n="1" target="#Af_75.lnote.oe.1"/> ða greatan sinwe forslea, gif hine<ptr type="liebermannNote" n="10" target="#Af_75.lnote.oe.10"/> mon<ptr type="liebermannNote" n="1" target="#Af_75.lnote.oe.1"/> gelacnian<ptr type="liebermannNote" n="11" target="#Af_75.lnote.oe.11"/> mæge, þæt heo<ptr type="liebermannNote" n="3" target="#Af_75.lnote.oe.3"/> hal sy<ptr type="liebermannNote" n="2" target="#Af_75.lnote.oe.2"/>, gesylle<ptr type="liebermannNote" n="2" target="#Af_75.lnote.oe.2"/> XII scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="75" corresp="#wit-b-no-prol"><pb n="86" ed="#liebermann"/>Gyf mon ða greatan synewe forsléa, gyf hine man gelacnian mæge, þ<hi rend="italic">æt</hi> he<ptr type="liebermannNote" n="5" target="#Af_75.lnote.oe.5"/> hal sy, gesylle twelf scill' to bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="75" corresp="#wit-q"><pb n="87" ed="#liebermann"/>Si grossi nerui truncentur alicui, ut sanari<ptr type="liebermannNote" n="13" target="#Af_75.lnote.oe.13"/> possint, XII<ptr type="liebermannNote" n="14" target="#Af_75.lnote.oe.14-2"/> solid. culpa sit.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="92" ed="#attenborough"/>Gif mon ða greatan sinwe<ptr type="editorNote" n="4" target="#Af_75.attnote.fn.4"/> forslea, gif hie<ptr type="editorNote" n="5" target="#Af_75.attnote.fn.5"/> mon gelacnian mæge, þæt hio<ptr type="editorNote" n="6" target="#Af_75.attnote.fn.6"/> hal sie, geselle XII scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="78" corresp="#wit-e"><pb n="362" ed="#jurasinski-and-oliver"/>Gif mon ða greatan sinwe forslea, gif hie mon gelacnian mæge, þæt hio hal sie, geselle XII scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="87" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_75.lnote.de.1"/> jemand die ‘grosse’ Sehne<ptr type="liebermannNote" n="2" target="#Af_75.lnote.de.2"/> zerschlägt — vorausgesetzt, man könne sie<ptr type="liebermannNote" n="3" target="#Af_75.lnote.de.3"/> curiren<ptr type="liebermannNote" n="4" target="#Af_75.lnote.de.4"/>, so dass sie<ptr type="liebermannNote" n="3" target="#Af_75.lnote.de.3"/> heil werde —, gebe er 12 Schill.<ptr type="liebermannNote" n="5" target="#Af_75.lnote.de.5"/> zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone severs the ‘great’ sinew — provided it can be treated so that it becomes whole —, let him give 12 shillings as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="93" ed="#attenborough"/>If the large sinew is damaged, and if it can be treated medically so as to make it sound, 12 shillings shall be given as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="363" ed="#jurasinski-and-oliver"/>If someone injures the greater sinew, if he can be healed so that it is sound, let him pay 12 shillings as compensation.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_75.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">hine</hi> <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">hine</hi> Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_75.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">he</hi> hál sy, gesylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">he</hi> hál sy, gesylle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_75.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geändert in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_75.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rasur vor</hi> ne</seg><seg type="translation" xml:lang="en" source="#claude">erasure before ne</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_75.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rasur vor</hi> an</seg><seg type="translation" xml:lang="en" source="#claude">erasure before an</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_75.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_75.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_75.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">87</biblScope></bibl><seg type="original" xml:lang="de">non <hi rend="italic">fügt zu Lond THkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">non added by Lond THkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_75.lnote.oe.14-2" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">87</biblScope></bibl><seg type="original" xml:lang="de">XX <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">XX K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_75.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dahinter ein Buchstabe radirt</hi></seg><seg type="translation" xml:lang="en" source="#claude">a letter erased after it</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_75.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Sehne</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Sehne</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_75.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘<hi rend="spaced">Die</hi> grosse (kleine Af 76) Sehne’ scheint wegen des Artikels und Gegensatzes Terminus technicus, trotz Q Inst., welche ‘die grossen (kleinen) Sehnen’ allgemein verstehen. [Nicht ‘Achillessehne’, die <hi rend="italic">hóhsinu</hi> heisst nach Ed. Sievers (Brief Juni 1897).] Dass eine Sehne am Bein (<hi rend="italic">tibiarum</hi> Hn 93, 35) gemeint ist, beweist 75, 1</seg><seg type="translation" xml:lang="en" source="#claude">‘<hi rend="italic">The</hi> great (small, Af 76) sinew’ seems, because of the article and the contrast, to be a technical term, despite Q Inst., which understand ‘the great (small) sinews’ in general. [Not the ‘Achilles tendon’, which is called <hi rend="italic">hóhsinu</hi>, according to Ed. Sievers (letter, June 1897).] That a sinew of the leg (<hi rend="italic">tibiarum</hi> Hn 93, 35) is meant is proved by 75, 1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_75.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘ihn’ H cor. B Inst., in nächster Zeile ‘er’</seg><seg type="translation" xml:lang="en" source="#claude">‘him’ H cor. B Inst., in the next line ‘he’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_75.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl.</hi> Ggs. Af 69</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf.</hi> by contrast Af 69</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_75.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Abt 64 setzt zwar für Oberschenkelbruch ohne folgende Lähmung auch 12 Schill. Allein da für diesen Bussbetrag Af zumeist 30 Westsächs. Schill. einführt, spricht dies eher dagegen, dass Af die Oberschenkelsehne gemeint habe</seg><seg type="translation" xml:lang="en" source="#claude">Abt 64 does indeed also fix 12 shill. for a fracture of the thigh not followed by lameness. But since for this amount of compensation Af mostly introduces 30 West Saxon shill., this tells rather against Af’s having meant the thigh sinew</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_75.attnote.fn.4" n="4" source="#attenborough"><bibl><biblScope unit="page">92</biblScope></bibl><label>sinwe</label><seg type="original" xml:lang="en"><hi rend="italic">synewe</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_75.attnote.fn.5" n="5" source="#attenborough"><bibl><biblScope unit="page">92</biblScope></bibl><label>hie</label><seg type="original" xml:lang="en"><hi rend="italic">hine</hi>. B &amp; H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_75.attnote.fn.6" n="6" source="#attenborough"><bibl><biblScope unit="page">92</biblScope></bibl><label>hio</label><seg type="original" xml:lang="en"><hi rend="italic">he</hi>. B. <hi rend="italic">heo</hi>. H.</seg></note>
      </div>
