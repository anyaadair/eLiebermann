      <div type="clause" n="2.7">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 2.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 2.7"><pb n="629" ed="#liebermann"/>Et si est<ptr type="liebermannNote" n="5" target="#ECf_2-7.lnote.la.5"/> qui pro pietate ad celebrationem sancti adueniat<ptr type="liebermannNote" n="6" target="#ECf_2-7.lnote.la.6"/>, cum pace moretur et abscedat<ptr type="liebermannNote" n="7" target="#ECf_2-7.lnote.la.7"/>.</ab>
        <note type="comparison" source="#liebermann" n="629"><label>printed alongside</label> <ref target="clause:ECfRetr_2-7">ECf retr 2.7</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 629 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-7.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">Omnis qui <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">Omnis qui Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-7.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">-nerit <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nerit Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-7.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">disc. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">disc. Hk</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And if there is anyone who out of piety comes to the celebration of a saint, let him stay and depart in peace.</ab>
      </div>
    </body>
