        <dictScrap type="liebermann"><hi rend="bold">Engla lag[u]</hi> <hi rend="italic">Recht der Engländer, <ref type="abbreviation" target="gram:imGegensatzZu"><abbr>im Ggs. zu</abbr></ref></hi> Dena lagu <hi rend="italic">und deren Gebiete</hi> [<hi rend="italic"><ref type="abbreviation" target="gram:vielleicht"><abbr>vielleicht</abbr></ref> <ref type="abbreviation" target="gram:Gegensatz"><abbr>Ggs.</abbr></ref> <ref type="abbreviation" target="gram:auch"><abbr>auch</abbr></ref> zu Kent <ref type="abbreviation" target="gram:nur"><abbr>nur</abbr></ref></hi> <ref type="lawCode" target="law:Grith">Grið</ref> 11]; on ~ge <ref type="lawCode" target="law:VAtr">V Atr</ref> 30 = <ref type="lawCode" target="law:VIAtr">VI</ref> 37 (Æn-). <ref type="lawCode" target="law:VIIIAtr">VIII</ref> 5,1 = <ref type="lawCode" target="law:ICn">I Cn</ref> 3,2. <ref type="lawCode" target="law:IICn">II</ref> 15,1; 2. 62. 65 (~le <ref type="lawCode" target="law:B">B</ref>). <ref type="lawCode" target="law:Ath">Að</ref> 2 | in Anglorum lege <hi rend="italic"><ref type="abbreviation" target="gram:ubersetzt"><abbr>übs</abbr></ref></hi> <ref type="lawCode" target="law:Quadr">Q</ref> <hi rend="italic"><ref type="abbreviation" target="gram:uberall"><abbr>überall</abbr></ref>, <ref type="abbreviation" target="gram:zumBeispiel"><abbr>z. B.</abbr></ref></hi> <ref type="lawCode" target="law:ICn">I Cn</ref> 3,2 | ~gum Geþyncðo 1; in Anglorum laga <ref type="lawCode" target="law:Quadr">Q</ref>; æfter ~ge <ref type="lawCode" target="law:IAtr">I Atr</ref> Pro (Æn- <ref type="lawCode" target="law:Ld">Ld</ref>); <hi rend="italic">diesen Sinn</hi> (<hi rend="italic">nicht, wie in</hi> <ref type="lawCode" target="law:WlArt">Wl art</ref> 4, Anglorum lex: <hi rend="italic">‘Landrecht bestehend seit vor</hi> 1066’) <hi rend="italic">hat</hi> Anglorum laga <ref type="lawCode" target="law:Hn">Hn</ref> 66,6. 79,6 (<hi rend="italic"><ref type="abbreviation" target="gram:aus"><abbr>aus</abbr></ref></hi> <ref type="lawCode" target="law:IICn">II Cn</ref> 65. <ref type="lawCode" target="law:I">I</ref> 3,2). <ref type="lawCode" target="law:ECf">ECf</ref> 10. 12,3; 5. <hi rend="italic">Synonym:</hi> mid Englum <hi rend="italic"><ref type="abbreviation" target="gram:siehe"><abbr>s.</abbr></ref></hi> Engle</dictScrap>
