      <div type="clause" n="44">
        <head>Af Rb 44</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-e"><pb n="20" ed="#liebermann"/>XL. Be<ptr type="liebermannNote" n="**" target="#Rubrics-Af_44.lnote.oe.star2"/> heafodwunde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-ot-frag"><pb n="20" ed="#liebermann"/>… afodwunde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-g-prol"><pb n="20" ed="#liebermann"/>XL. Be heafodwunde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-h"><pb n="21" ed="#liebermann"/>XL. Be heafodwunde.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="44" corresp="#wit-q"><pb n="21" ed="#liebermann"/>De plaga<ptr type="liebermannNote" n="2" target="#Rubrics-Af_44.lnote.oe.2"/> in<ptr type="liebermannNote" n="3" target="#Rubrics-Af_44.lnote.oe.3"/> capite.<ptr type="liebermannNote" n="4" target="#Rubrics-Af_44.lnote.oe.4"/><ptr type="liebermannNote" n="5" target="#Rubrics-Af_44.lnote.oe.5"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="198" ed="#jurasinski-and-oliver"/>XL Be heafodwunde</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="198" ed="#jurasinski-and-oliver"/>Be heafodwunde oðre liman</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="21" ed="#liebermann"/>Von Kopfverwundung.<ptr type="liebermannNote" n="1" target="#Rubrics-Af_44.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of a head-wound.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="199" ed="#jurasinski-and-oliver"/>Concerning a head-wound</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="199" ed="#jurasinski-and-oliver"/>Concerning a headwound and [wounds to] another limb</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_44.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">plagis <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">plagis Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_44.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">corporalibus <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">corporalibus Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_44.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">vel in ceteris partibus corporis <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">vel in ceteris partibus corporis added by Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_44.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt T zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_44.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">20</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Statt Rb.</hi> [44—47 ff.] Be wundum <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Instead of the rubrics [44—47 ff.] Be wundum Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_44.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Alle folgenden Kapitel fasst logischer schon hier zusammen Q spät. Rez. = Ld</seg><seg type="translation" xml:lang="en" source="#claude">Q later rec. = Ld, more logically, already combines all the following chapters here</seg></note>
      </div>
