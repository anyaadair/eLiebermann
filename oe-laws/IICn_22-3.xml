    <body>
      <div type="clause" n="22.3">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 22.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.3" corresp="#wit-g-a"><pb n="326" ed="#liebermann"/>⁊ ne beo æfre ænig forað forgyfen.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.3" corresp="#wit-b"><pb n="326" ed="#liebermann"/>⁊ ne beo ænig forað forgyfen.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.3" corresp="#wit-a"><pb n="326" ed="#liebermann"/>⁊ ne beo æfre ænig forað forgifen.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="22.3" corresp="#wit-q"><pb n="327" ed="#liebermann"/>Et nullum<ptr type="liebermannNote" n="1" target="#IICn_22-3.lnote.oe.1-2"/> umquam<ptr type="liebermannNote" n="2" target="#IICn_22-3.lnote.oe.2-2"/> anteiuramentum condonetur.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="22.3" corresp="#wit-inst-cn"><pb n="327" ed="#liebermann"/>Nec ei perdonetur<ptr type="liebermannNote" n="1" target="#IICn_22-3.lnote.oe.1-3"/> aliquod preiuramentum.<ptr type="liebermannNote" n="2" target="#IICn_22-3.lnote.oe.2-3"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="22.3" corresp="#wit-cons-cn"><pb n="327" ed="#liebermann"/>Nec unquam aliquod preiuramentum condonetur.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="22.3" corresp="#wit-b"><pb n="184" ed="#robertson"/>⁊ ne beo<ptr type="editorNote" n="15" target="#IICn_22-3.robnote.fn.15"/> ænig forað forgyfen.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="264" ed="#rabin-doml"/>And ne beo æfre ænig forað forgyfen.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="326" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#IICn_22-3.lnote.de.1"/> niemals werde ein Klageeid erlassen.<ptr type="liebermannNote" n="2" target="#IICn_22-3.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let no fore-oath ever be remitted.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="185" ed="#robertson"/>And there shall be no remission with regard to any oath of accusation<ptr type="editorNote" n="1" target="#IICn_22-3.robnote.n.1"/>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="465" ed="#whitelock"/>And no preliminary oath is ever to be remitted.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="265" ed="#rabin-doml"/>And an oath of accusation can never be waived.</ab>
        <note type="comparison" source="#liebermann" n="326"><ref target="clause:IIAs_23-2">II As 23.2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. II As. 23, 2</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Gethyn_4">Geþyncðo 4</ref></note>
        <note type="editorial">Liebermann compares II As 23.2.; BR: added from Gesetze I p. 327, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">æfre: omitted B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-3.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">327</biblScope></bibl><seg type="original" xml:lang="de">nunq. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">nunq. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-3.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">327</biblScope></bibl><seg type="original" xml:lang="de">p. a. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. a. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-3.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">327</biblScope></bibl><seg type="original" xml:lang="de">u. n. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. n. R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-3.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">327</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-3.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">327</biblScope></bibl><seg type="original" xml:lang="de">condon. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">condon. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-3.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">327</biblScope></bibl><seg type="original" xml:lang="de">sacramentum <hi rend="italic">Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">sacramentum Lb S</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_22-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">205</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Benutzt durch Hn 64, 9</seg><seg type="translation" xml:lang="en" source="#claude">Used by Hn 64, 9</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_22-3.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">205</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Brunner II 345 denkt nur an ein Erlassen durch den Prozessgegner. Doch geschah es missbräuchlich vielleicht auch durch das Gericht, das vor einem mächtigen Kläger sich demütigte. <hi rend="italic">Vgl. Gl</hi> Klageeid 3. d. 4</seg><seg type="translation" xml:lang="en" source="#claude">Brunner II 345 thinks only of remission by the opposing party. But it was perhaps also done, as an abuse, by the court, abasing itself before a powerful plaintiff. <hi rend="italic">Cf. Gl</hi> Klageeid 3. d. 4</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_22-3.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">355</biblScope></bibl><seg type="original" xml:lang="en">For previous exceptions to this rule, see V As. 2; III Edm. 6, 2.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_22-3.robnote.fn.15" n="15" source="#robertson"><bibl><biblScope unit="page">184</biblScope></bibl><label>beo</label><seg type="original" xml:lang="en"><hi rend="italic">ne b. æfre</hi> G, A, Ld.</seg></note>
      </div>
    </body>
  </text>
