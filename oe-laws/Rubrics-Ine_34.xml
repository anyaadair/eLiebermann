        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="34" corresp="#wit-e"><pb n="22" ed="#liebermann"/>LXXVIII. Be monslihte.<ptr type="liebermannNote" n="12" target="#Rubrics-Ine_34.lnote.oe.12"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="34" corresp="#wit-g-prol"><pb n="22" ed="#liebermann"/>LXXVIII. Be manslihte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="34" corresp="#wit-h"><pb n="23" ed="#liebermann"/>LXXVIII. Be monslyhte.<ptr type="liebermannNote" n="21" target="#Rubrics-Ine_34.lnote.oe.21"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="34" corresp="#wit-q"><pb n="23" ed="#liebermann"/>De<ptr type="liebermannNote" n="23" target="#Rubrics-Ine_34.lnote.oe.23"/> homicidio.<ptr type="liebermannNote" n="24" target="#Rubrics-Ine_34.lnote.oe.24"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="206" ed="#jurasinski-and-oliver"/>LXXVIII Be monslihte</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="206" ed="#jurasinski-and-oliver"/>Be manslihte</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="23" ed="#liebermann"/>Von Todtschlag.<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_34.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of manslaughter.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="207" ed="#jurasinski-and-oliver"/>Concerning killing a man</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="207" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_34.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de">manslyhte <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">manslyhte Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_34.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">Qui [De presente ubi <hi rend="italic">Br</hi>] fuerit in collegio, ubi [in coll. u. <hi rend="italic">fehlt Br</hi>] aliquis sit [fuerit <hi rend="italic">Br</hi>] occisus <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Qui [De presente ubi Br] fuerit in collegio, ubi [in coll. u. lacking in Br] aliquis sit [fuerit Br] occisus Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_34.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">-do <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">-do Dm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_34.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> manns.</seg><seg type="translation" xml:lang="en" source="#claude">altered manns.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_34.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Q spät. Rez. vervollständigt aus seinem Text die Rb</seg><seg type="translation" xml:lang="en" source="#claude">The later recension of Q completes the Rb from its own text</seg></note>
