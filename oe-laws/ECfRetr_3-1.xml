    <body>
      <div type="clause" n="3.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 3.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 3.1"><pb n="629" ed="#liebermann"/>Iustum<ptr type="liebermannNote" n="35" target="#ECfRetr_3-1.lnote.la.35"/> est enim ut ubique <hi rend="bold">Deus pre</hi><ptr type="liebermannNote" n="c" target="#ECfRetr_3-1.lnote.la.fn.c"/> <hi rend="bold">ceteris</hi> honoretur.</ab>
        <note type="comparison" source="#liebermann" n="629"><label>printed alongside</label> <ref target="clause:ECf_3-1">ECf 3.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 629 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_3-1.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Retr. wahrt</hi> (<hi rend="italic">klerikaler, auch</hi> 3, 1) <hi rend="italic">dem Bischof Priorität, wie u.</hi> 3. 6a</seg><seg type="translation" xml:lang="en" source="#claude">the Retractator (more clerical, also at 3, 1) keeps the priority for the bishop, as below, 3. 6a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_3-1.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">Iustitia enim est ut D. u. p. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Iustitia enim est ut D. u. p. Hv</seg></note>
      </div>
    </body>
