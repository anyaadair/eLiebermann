      <div type="clause" n="19.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 19.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19.1" corresp="#wit-e"><pb n="60" ed="#liebermann"/>Gif hi<ptr type="liebermannNote" n="12" target="#Af_19-1.lnote.oe.12"/> hie<ptr type="liebermannNote" n="10" target="#Af_19-1.lnote.oe.10"/> ne gesamnien<ptr type="liebermannNote" n="13" target="#Af_19-1.lnote.oe.13"/>, gielde<ptr type="liebermannNote" n="14" target="#Af_19-1.lnote.oe.14"/> se ðæs wæpnes onlah<ptr type="liebermannNote" n="15" target="#Af_19-1.lnote.oe.15"/> þæs weres<ptr type="liebermannNote" n="16" target="#Af_19-1.lnote.oe.16"/> ðriddan dæl ⁊<ptr type="liebermannNote" n="17" target="#Af_19-1.lnote.oe.17"/> þæs wites ðriddan dæl.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19.1" corresp="#wit-h"><pb n="60" ed="#liebermann"/>Gif hy heo gesomnian<ptr type="liebermannNote" n="6" target="#Af_19-1.lnote.oe.6"/> nellen, gilde se ðæs wæpnes onlah<ptr type="liebermannNote" n="7" target="#Af_19-1.lnote.oe.7"/> ðæs weres ðriddan dæl ⁊ ðæs wites ðriddan dæl.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19.1" corresp="#wit-b-no-prol"><pb n="60" ed="#liebermann"/>Gyf heo hi ne gesamnian, gylde se ðæs wæpnes onlænde þæs weres ðridda<ptr type="liebermannNote" n="3" target="#Af_19-1.lnote.oe.3"/> dæll.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="19.1" corresp="#wit-q"><pb n="61" ed="#liebermann"/>Si<ptr type="liebermannNote" n="14" target="#Af_19-1.lnote.oe.14-2"/> insimulari noluerint<ptr type="liebermannNote" n="15" target="#Af_19-1.lnote.oe.15-2"/>, reddat qui arma prestitit<ptr type="liebermannNote" n="16" target="#Af_19-1.lnote.oe.16-2"/> terciam partem ipsius were.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="72" ed="#attenborough"/>Gif hi hie ne gesamnien<ptr type="editorNote" n="20" target="#Af_19-1.attnote.fn.20"/>, gielde se ðæs wæpnes onlah<ptr type="editorNote" n="21" target="#Af_19-1.attnote.fn.21"/> þæs weres ðriddan dæl ⁊ þæs wites ðriddan dæl.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="22.1" corresp="#wit-e"><pb n="312" ed="#jurasinski-and-oliver"/>Gif hi hie ne gesamnien, gielde se ðæs wæpnes onlah þæs weres ðriddan dæl ⁊ þæs wites ðriddan dæl.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="61" ed="#liebermann"/>Falls sie sich nicht zusammenthun<ptr type="liebermannNote" n="1" target="#Af_19-1.lnote.de.1"/>, bezahle der, welcher die Waffe darlieh<ptr type="liebermannNote" n="2" target="#Af_19-1.lnote.de.2"/>, des Wergelds dritten Theil und<ptr type="liebermannNote" n="3" target="#Af_19-1.lnote.de.3"/> des Strafgelds dritten Theil.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If they do not join together, let the one who lent the weapon pay a third of the wergeld and a third of the fine.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="73" ed="#attenborough"/>If they do not combine [voluntarily], he who lent the weapon shall pay one-third of the wergeld and one-third of the fine.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="412" ed="#whitelock"/>If they do not join, he who lent the weapon is to pay a third part of the wergild and a third part of the fine.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="313" ed="#jurasinski-and-oliver"/>If they do not want to, let him who loaned the weapon pay a third of the <hi rend="italic">wer</hi> and a third of the fine.</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="313"><label>cf.</label> <ref target="clause:Abt_20">Abt 20</ref> <quote>Æthelberht §23.2 [L20] requires that the man who loaned the weapon pay 20 shillings.</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt So</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">hi <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hi Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">gesom. <hi rend="italic">So;</hi> gesomnian <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gesom. So; gesomnian Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">gylde <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gylde So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">onlág <hi rend="italic">So;</hi> onlænde <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">onlág So; onlænde Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">wæres þridda dæle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wæres þridda dæle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">⁊ þ. w. ð. d. <hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">⁊ þ. w. ð. d. lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a, <hi rend="italic">Rasur hinter</hi> i</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a, erasure after i</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> wæs onlan</seg><seg type="translation" xml:lang="en" source="#claude">altered to wæs onlan</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-1.lnote.oe.14-2" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">61</biblScope></bibl><seg type="original" xml:lang="de">Sin sim. <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Sin sim. Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-1.lnote.oe.15-2" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">61</biblScope></bibl><seg type="original" xml:lang="de">-rit <hi rend="italic">R;</hi> nolint <hi rend="italic">Lond T</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rit R; nolint Lond T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-1.lnote.oe.16-2" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">61</biblScope></bibl><seg type="original" xml:lang="de">-terit <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">-terit Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_19-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">55</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘zusammentun wollen’ H Q. Eigenes Mittellatein bildet sich Q; <hi rend="italic">insimul</hi> für <hi rend="italic">simul</hi> zitiert Ducange aus dem Frankenreich. <hi rend="italic">S. Gl</hi> Haftung 4c</seg><seg type="translation" xml:lang="en" source="#claude">‘wish to join together’ H Q. Q forms his own Medieval Latin; Ducange cites <hi rend="italic">insimul</hi> for <hi rend="italic">simul</hi> from the Frankish kingdom. <hi rend="italic">See Gl</hi> Haftung 4c</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_19-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">55</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">H cor. scheint seine Änderung nicht vollendet zu haben</seg><seg type="translation" xml:lang="en" source="#claude">H cor. seems not to have completed his alteration</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_19-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">55</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Die letzten Worte überspringen B Q</seg><seg type="translation" xml:lang="en" source="#claude">B Q omit the last words</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_19-1.attnote.fn.20" n="20" source="#attenborough"><bibl><biblScope unit="page">72</biblScope></bibl><label>gesamnien</label><seg type="original" xml:lang="en"><hi rend="italic">ges. nellen</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_19-1.attnote.fn.21" n="21" source="#attenborough"><bibl><biblScope unit="page">72</biblScope></bibl><label>onlah</label><seg type="original" xml:lang="en"><hi rend="italic">onlænde</hi>. B &amp; Ld.</seg></note>
      </div>
