      <div type="clause" n="92.11">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 92.11</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 92.11" corresp="#wit-lat"><pb n="608" ed="#liebermann"/>Si hundretum de aliquo probare<ptr type="liebermannNote" n="24" target="#Hn_92-11.lnote.oe.24"/> uelit, quod Francigena<ptr type="liebermannNote" n="h" target="#Hn_92-11.lnote.oe.h"/> murdrumque<ptr type="liebermannNote" n="25" target="#Hn_92-11.lnote.oe.25"/> non fuerit, XII melioribus hominibus hundreti (ipsius<ptr type="liebermannNote" n="26" target="#Hn_92-11.lnote.oe.26"/>) iurantibus hoc credatur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 608 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-11.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 92, 6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">see above</hi> 92, 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-11.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-11.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Co Or;</hi> murdrum qꝫ <hi rend="italic">Sc K;</hi> -m quod <hi rend="italic">Edd. gegen Hss.;</hi> quod <hi rend="italic">empfiehlt zu streichen Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Co Or; murdrum qꝫ Sc K; -m quod edd. against the MSS; Tho recommends deleting quod</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-11.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-11.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Hundred 21b; <hi rend="italic">o</hi>. 48, 2a—<hi rend="italic">probare</hi> fehlt—<hi rend="italic">ipsius</hi>{28} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Hundred 21b; <hi rend="italic">above</hi> 48, 2a—<hi rend="italic">probare</hi> missing—<hi rend="italic">ipsius</hi>{28} Rs</seg></note>
      </div>
