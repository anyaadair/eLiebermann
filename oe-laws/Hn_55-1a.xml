      <div type="clause" n="55.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 55.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 55.1a" corresp="#wit-lat"><pb n="575" ed="#liebermann"/>Et si<ptr type="liebermannNote" n="4" target="#Hn_55-1a.lnote.oe.4"/> residens est ad remocius<ptr type="liebermannNote" n="5" target="#Hn_55-1a.lnote.oe.5"/> manerium eiusdem honoris<ptr type="liebermannNote" n="b" target="#Hn_55-1a.lnote.oe.b"/> unde tenet, ibit<ptr type="liebermannNote" n="6" target="#Hn_55-1a.lnote.oe.6"/> ad placitum, si dominus suus<ptr type="liebermannNote" n="7" target="#Hn_55-1a.lnote.oe.7"/> submoneat eum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 575 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-1a.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">Grossbaronie (<hi rend="italic">Mehrheit von Lehen, dauernd in Einer Herrschaft geeint</hi>). <hi rend="italic">Der Vasall erscheine vor herrschaftlichem Gericht auch ausserhalb des Manors, aber nicht des Honors, dessen Hintersasse er ist. Nur wenn der Gegner zum anderen Honor gehört, folge er der herrschaftlichen Ladung auch dorthin. Das Wort</hi> Honor <hi rend="italic">kommt schon unter Wilhelm II. vor; Round</hi> Feudal Engl. 309</seg><seg type="translation" xml:lang="en" source="#claude">Great barony (a number of fiefs permanently united in one lordship). The vassal is to appear before the seignorial court even outside the manor, but not outside the honour of which he is a tenant. Only if his opponent belongs to another honour is he to follow the seignorial summons there as well. The word Honor occurs as early as under William II; Round Feudal Engl. 309</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-1a.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ob</hi> Etsi?</seg><seg type="translation" xml:lang="en" source="#claude">perhaps Etsi?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-1a.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">-ociorem <hi rend="italic">K;</hi> -ocionem <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ociorem K; -ocionem Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-1a.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">ibi <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">ibi K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-1a.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-1a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Honor—<hi rend="italic">remociorem</hi>{6}—<hi rend="italic">ibi</hi>{9}—55, 1b <hi rend="italic">feudos</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Honor—<hi rend="italic">remociorem</hi>{6}—<hi rend="italic">ibi</hi>{9}—55, 1b <hi rend="italic">feudos</hi> Rs</seg></note>
      </div>
