        <note type="liebermannNote" subtype="textual" xml:id="IIAs_19.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">161</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> simplex <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Lond; simplex the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_19.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">161</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> ille ter uel s. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Lond; ille ter uel s. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_19.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">161</biblScope></bibl><seg type="original" xml:lang="de">seruam <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">seruam K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_19.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">161</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Or;</hi> d. [dimidiata <hi rend="italic">RMHkBr</hi>] w. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Or; d. [dimidiata RMHkBr] w. the others</seg></note>
