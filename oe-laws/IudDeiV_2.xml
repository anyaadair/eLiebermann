      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:IudDeiV">Iud Dei V</ref> 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei V 2" corresp="#wit-du"><pb n="411" ed="#liebermann"/>✠ Adiuro<ptr type="liebermannNote" n="29" target="#IudDeiV_2.lnote.oe.29"/> te, creaturæ<ptr type="liebermannNote" n="30" target="#IudDeiV_2.lnote.oe.30"/> ferri, per Deum, Patrem et Filium et Spiritum sanctum, et per<ptr type="liebermannNote" n="c" target="#IudDeiV_2.lnote.oe.c"/> tremendum diem iudicii et per XII apostolos et per septuaginta<ptr type="liebermannNote" n="31" target="#IudDeiV_2.lnote.oe.31"/> discipulos et per XII prophetas et per XXIIII seniores, qui assidue Deum laudant, et per CXLIIII milia, qui secuntur Agnum, et per omnia agmina sanctorum angelorum et archangelorum, thrones<ptr type="liebermannNote" n="33" target="#IudDeiV_2.lnote.oe.33"/>, dominationes principatum<ptr type="liebermannNote" n="34" target="#IudDeiV_2.lnote.oe.34"/> et potestatum, uirtutum, Cherubim atque Seraphin, et per omnia milia sanctorum martyrum tuorum<ptr type="liebermannNote" n="36" target="#IudDeiV_2.lnote.oe.36"/>, uirginum et confessorum;</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei V 2" corresp="#wit-gl"><pb n="411" ed="#liebermann"/>wuðwuto, ða ðe givunvlice God heriað, ⁊ ðerh hvndfeor:::<ptr type="liebermannNote" n="32" target="#IudDeiV_2.lnote.oe.32"/> ðusendo, ða ðe fylgað lomb, ⁊ ðerh alle hergia haligra engla ⁊ . hehangla, hehsedlo, ricsares aldorm<hi rend="italic">onna</hi> ⁊ mæht<hi rend="italic">a</hi>, mægna, Cer' ⁊ æc Se', ⁊ ðerh alle ðvsenda<ptr type="liebermannNote" n="35" target="#IudDeiV_2.lnote.oe.35"/> haligra ðrevara ðinra, hehstaldra ⁊ ond<hi rend="italic">etra</hi>;</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Luc. 10, 1; Apoc. 4, 10; 7, 4; Colos. 1, 16; Rom. 8, 38</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 411 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_2.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. u.</hi> VII 23, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. below VII 23, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_2.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">identisch bis</hi> perpetrauit <hi rend="italic">mit</hi> I 22, <hi rend="italic">wo nur</hi> aqua <hi rend="italic">statt</hi> ferrum</seg><seg type="translation" xml:lang="en" source="#claude">identical up to perpetrauit with I 22, where only aqua instead of ferrum</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_2.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> -ra</seg><seg type="translation" xml:lang="en" source="#claude">read -ra</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_2.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> duos <hi rend="italic">aus I</hi></seg><seg type="translation" xml:lang="en" source="#claude">supply duos from I</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_2.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">drei Buchstaben verschwunden, über</hi> IIII <hi rend="italic">keine Glosse</hi></seg><seg type="translation" xml:lang="en" source="#claude">three letters vanished; no gloss above IIII</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_2.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de">thronorum, dominationum <hi rend="italic">I</hi></seg><seg type="translation" xml:lang="en" source="#claude">thronorum, dominationum I</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_2.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de">-tuum <hi rend="italic">I</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tuum I</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_2.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert aus</hi> ðusende</seg><seg type="translation" xml:lang="en" source="#claude">corrected from ðusende</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_2.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt I besser</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in I, better</seg></note>
      </div>
