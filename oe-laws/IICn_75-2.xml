    <body>
      <div type="clause" n="75.2">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 75.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="75.2" corresp="#wit-g-a"><pb n="362" ed="#liebermann"/>⁊ wite se oðer, þe þ<hi rend="italic">æt</hi> weorc<ptr type="liebermannNote" n="17" target="#IICn_75-2.lnote.oe.17"/> geworhte, þ<hi rend="italic">æt</hi> he<ptr type="liebermannNote" n="18" target="#IICn_75-2.lnote.oe.18"/> hit bete, swa swa lagan<ptr type="liebermannNote" n="19" target="#IICn_75-2.lnote.oe.19"/><ptr type="liebermannNote" n="***" target="#IICn_75-2.lnote.oe.star3"/> tæcean.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="75.2" corresp="#wit-b"><pb n="362" ed="#liebermann"/>And wite se oðer, þe þ<hi rend="italic">æt</hi> weorc geweorhte<ptr type="liebermannNote" n="5" target="#IICn_75-2.lnote.oe.5"/>, þ<hi rend="italic">æt</hi> he hit bete, swa swa lagu tæce.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="75.2" corresp="#wit-a"><pb n="362" ed="#liebermann"/>⁊ wite se oðor, þe þ<hi rend="italic">æt</hi> weorc geworhte, þ<hi rend="italic">æt</hi> he hit bete, swa swa lage tæce.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="75.2" corresp="#wit-q"><pb n="363" ed="#liebermann"/>Et uideat alius, ut quod forisfecit emendet sic<ptr type="liebermannNote" n="11" target="#IICn_75-2.lnote.oe.11-2"/>, sicut lex edocebit.<ptr type="liebermannNote" n="12" target="#IICn_75-2.lnote.oe.12-2"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="75.2" corresp="#wit-inst-cn"><pb n="363" ed="#liebermann"/>Et malefactor malum<ptr type="liebermannNote" n="11" target="#IICn_75-2.lnote.oe.11-3"/> quod fecit emendet, secundum<ptr type="liebermannNote" n="12" target="#IICn_75-2.lnote.oe.12-3"/> quod lex docet.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="75.2" corresp="#wit-cons-cn"><pb n="363" ed="#liebermann"/>[75, 2] malefacti autem perpetratorem (facti) dampnum perpetratum corrigere secundum legis institutum.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="75.2" corresp="#wit-b"><pb n="212" ed="#robertson"/>And wite se oðer þe þæt weorc geweorhte, þæt he hit bete, swa swa lagu tæce<ptr type="editorNote" n="11" target="#IICn_75-2.robnote.fn.11"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="292" ed="#rabin-doml"/>And wite se oðer, þe þæt weorc geworhte, þæt he hit bete swa swa lagan tæcean.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="363" ed="#liebermann"/>Und der andere, der die [Misse]that verübt hat, begreife<ptr type="liebermannNote" n="1" target="#IICn_75-2.lnote.de.1"/>, dass er sie büsse, so wie die Rechtssatzung vorschreibt (-ungen vorschreiben <hi rend="italic">G</hi>).</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let the other, who committed the [mis]deed, understand that he must atone for it as the law prescribes (the laws prescribe, G).</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="213" ed="#robertson"/>And the other who wrought the mischief shall see to it that he pays compensation for it, according as the law directs.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="473" ed="#whitelock"/>And the other, who did the deed, is to understand that he is to pay compensation for it as the laws direct.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="293" ed="#rabin-doml"/>And the other who committed the crime shall be sure to make amends for it just as the law decrees.</ab>
        <note type="editorial">G's ‘lagan’ was altered from ‘laga’ (compare 83); the other MSS have the singular.; BR: added from Gesetze I p. 363, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">lagan tæcean: later revised to laga tæcean G; lagu tæce AB</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_75-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">363</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_75-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">363</biblScope></bibl><seg type="original" xml:lang="de">patra. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">patra. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_75-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">362</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. o.</hi> 30, 5</seg><seg type="translation" xml:lang="en" source="#claude">cf. above 30, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_75-2.lnote.oe.11-2" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">363</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt KHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in KHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_75-2.lnote.oe.12-2" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">363</biblScope></bibl><seg type="original" xml:lang="de">doc. <hi rend="italic">HkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">doc. HkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_75-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">362</biblScope></bibl><seg type="original" xml:lang="de">-rce <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rce Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_75-2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">362</biblScope></bibl><seg type="original" xml:lang="de">ðe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_75-2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">362</biblScope></bibl><seg type="original" xml:lang="de">lage tæce <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lage tæce Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_75-2.lnote.oe.star3" n="***" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">362</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geändert</hi> laga [<hi rend="italic">vgl.</hi> 83] <hi rend="italic">G; Singular übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">altered laga [cf. 83] G; singular the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_75-2.lnote.oe.11-3" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">363</biblScope></bibl><seg type="original" xml:lang="de">male <hi rend="italic">Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">male Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_75-2.lnote.oe.12-3" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">363</biblScope></bibl><seg type="original" xml:lang="de">s. q. l. d. <hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. q. l. d. lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_75-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">213</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Bessere Übs.: ‘sorge, beachte’; Q <hi rend="italic">videat</hi> wohl durch Gleichklang auch sonst; <hi rend="italic">s. Wb: witan</hi></seg><seg type="translation" xml:lang="en" source="#claude">Better transl.: ‘take care, see to it’; Q's <hi rend="italic">videat</hi>, here as elsewhere, is probably due to the similarity of sound; <hi rend="italic">see Wb: witan</hi></seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_75-2.robnote.fn.11" n="11" source="#robertson"><bibl><biblScope unit="page">212</biblScope></bibl><label>tæce</label><seg type="original" xml:lang="en"><hi rend="italic">lagan</hi> (later changed to <hi rend="italic">laga</hi>) <hi rend="italic">tæcean</hi> G.</seg></note>
      </div>
    </body>
