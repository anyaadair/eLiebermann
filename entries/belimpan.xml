n, passen</hi> (to <hi rend="italic">zu</hi>) <ref type="lawCode" target="law:Af">Af</ref> 6. 6,1. 31,1 (<hi rend="italic"><ref type="abbreviation" target="gram:auchOhne"><abbr>auch ohne</abbr></ref></hi> hit) | <hi rend="italic"><ref type="abbreviation" target="gram:mit"><abbr>mit</abbr></ref> <ref type="abbreviation" target="gram:Dativ"><abbr>dt</abbr></ref>: es glückt mir</hi> <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 49,2 <ref type="lawCode" target="law:Ld">Ld</ref>; spowan <hi rend="italic">älter.</hi> — <hi rend="italic"><ref type="abbreviation" target="gram:ersetztDurch"><abbr>Ersetzt durch</abbr></ref></hi> <ref type="entry" target="entry:gelimpan">gelimpan</ref>, <ref type="entry" target="entry:tobelimpan">tobelimpan</ref> <hi rend="italic"><ref type="abbreviation" target="gram:sieheDort"><abbr>s. d.</abbr></ref></hi> — <hi rend="italic"><ref type="abbreviation" target="gram:Derivativ"><abbr>Der.</abbr></ref>:</hi> <ref type="entry" target="entry:tobelimpan">tob~</ref></dictScrap>
