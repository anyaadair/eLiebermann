      <div type="clause" n="63">
        <head><ref type="lawCode" target="law:Af">Af</ref> 63</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="63" corresp="#wit-e"><pb n="82" ed="#liebermann"/>Gif se sconca<ptr type="liebermannNote" n="27" target="#Af_63.lnote.oe.27"/> bið þyrel beneoðan cneowe, ðær sculon XII<ptr type="liebermannNote" n="28" target="#Af_63.lnote.oe.28"/> scill. to<ptr type="liebermannNote" n="17" target="#Af_63.lnote.oe.17"/> bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="63" corresp="#wit-h"><pb n="82" ed="#liebermann"/>Gif se sconca<ptr type="liebermannNote" n="1" target="#Af_63.lnote.oe.1"/> bið þyrel<ptr type="liebermannNote" n="10" target="#Af_63.lnote.oe.10"/> beneoðan<ptr type="liebermannNote" n="13" target="#Af_63.lnote.oe.13"/> cneowe, þær<ptr type="liebermannNote" n="14" target="#Af_63.lnote.oe.14"/> sculon XII scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="63" corresp="#wit-b-no-prol"><pb n="82" ed="#liebermann"/>Gyf se scanca bið ðurl<ptr type="liebermannNote" n="5" target="#Af_63.lnote.oe.5"/> beneoðan cneowe<ptr type="liebermannNote" n="6" target="#Af_63.lnote.oe.6"/>, ðær sculon twelf scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="63" corresp="#wit-q"><pb n="83" ed="#liebermann"/>Si crus transforetur<ptr type="liebermannNote" n="27" target="#Af_63.lnote.oe.27-2"/> alicui sub<ptr type="liebermannNote" n="28" target="#Af_63.lnote.oe.28-2"/> genu, duodecim sol. emendetur.<ptr type="liebermannNote" n="29" target="#Af_63.lnote.oe.29"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="88" ed="#attenborough"/>Gif se sconca bið þyrel beneoðan cneowe<ptr type="editorNote" n="17" target="#Af_63.attnote.fn.17"/>, ðær sculon XII scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="66" corresp="#wit-e"><pb n="356" ed="#jurasinski-and-oliver"/>Gif se sconca bið þyrel beneoðan cneowe, ðær sculon XII scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="83" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_63.lnote.de.1"/> der Schenkel unterhalb des Knies durchstochen ist, da gehören 12 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the shank below the knee is pierced, 12 shillings are due as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="89" ed="#attenborough"/>If the shin is pierced below the knee, 12 shillings must be paid as compensation for it.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="357" ed="#jurasinski-and-oliver"/>If the lower leg is pierced below the knee, 12 shillings shall be the compensation.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_63.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">scanca biþ ðyrl <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">scanca biþ ðyrl Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_63.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">twelf <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">twelf Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_63.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">to b. <hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">to b. lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_63.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_63.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_63.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zweites</hi> e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">second e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_63.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">þ. s. XII <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">þ. s. XII on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_63.lnote.oe.27-2" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">transpungatur <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">transpungatur Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_63.lnote.oe.28-2" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">supra <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">supra Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_63.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">-ndet <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ndet T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_63.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> ðyrl</seg><seg type="translation" xml:lang="en" source="#claude">altered to ðyrl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_63.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">cweowe <hi rend="italic">B</hi></seg><seg type="translation" xml:lang="en" source="#claude">cweowe B</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_63.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Unterschenkel</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Unterschenkel</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_63.attnote.fn.17" n="17" source="#attenborough"><bibl><biblScope unit="page">88</biblScope></bibl><label>cneowe</label><seg type="original" xml:lang="en"><hi rend="italic">cweowe</hi>. B.</seg></note>
      </div>
