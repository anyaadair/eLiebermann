      <div type="clause" n="79.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 79.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 79.2" corresp="#wit-lat"><pb n="595" ed="#liebermann"/>Si quis in<ptr type="liebermannNote" n="21" target="#Hn_79-2.lnote.oe.21"/> nuncium regis<ptr type="liebermannNote" n="h" target="#Hn_79-2.lnote.oe.h"/> eat et breue eius<ptr type="liebermannNote" n="32" target="#Hn_79-2.lnote.oe.32"/> deferat, qui eum innocentem occiderit, in misericordia<ptr type="liebermannNote" n="i" target="#Hn_79-2.lnote.oe.i"/> regis erit. Et si commodum aliquod facere promiserat, hoc componat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 595 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-2.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 10, 1. 13, 1; Ine 33 <hi rend="italic">befriedet den Königsboten über dessen Stand hinaus</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 10, 1. 13, 1; Ine 33 gives the king’s messenger a protection beyond that of his rank</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-2.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">ex regie dispensationis beneficio tam uite quam membrorum suorum eius pendet iudicium; <hi rend="italic">Glanvilla</hi> XIV 1, 2</seg><seg type="translation" xml:lang="en" source="#claude">ex regie dispensationis beneficio tam uite quam membrorum suorum eius pendet iudicium; Glanvilla XIV 1, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-2.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">regis <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">regis Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">327</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Bote 2; Königsdienst 6; Misericordia 6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Bote 2; Königsdienst 6; Misericordia 6</seg></note>
      </div>
