      <div type="clause" n="24">
        <head><ref type="lawCode" target="law:QuadrArg">Quadr Arg</ref> 24</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Arg 24" corresp="#wit-lat"><pb n="534–535" ed="#liebermann"/>Huius<ptr type="liebermannNote" n="z" target="#QuadrArg_24.lnote.oe.z"/> pacem et iusticiam fedis grauionum<ptr type="liebermannNote" n="zz" target="#QuadrArg_24.lnote.oe.zz"/> improbitatibus et malis utinam necessitatibus sine pretio subrogamus.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 534–535 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_24.lnote.oe.z" n="z" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">534</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Heinrichs I.</hi> ‘kostenlose [<hi rend="italic">Lüge!</hi>] Polizei und Justiz sehen wir an Stelle bisheriger Unredlichkeit der Gerefan’; <hi rend="italic">vgl. oben</hi> 22&lt;sup&gt;u&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude">Henry I’s ‘peace-keeping and justice free of charge [a lie!] we see replacing the former dishonesty of the Gerefan’; cf. above 22&lt;sup&gt;u&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_24.lnote.oe.zz" n="zz" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">534</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Hn 7, 2: grauionum prauitas</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> Hn 7, 2: grauionum prauitas</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_24.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">312</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Vogt 1g. 11c</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Vogt 1g. 11c</seg></note>
      </div>
