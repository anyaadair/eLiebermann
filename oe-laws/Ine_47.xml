    <body>
      <div type="clause" n="47">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 47</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47" corresp="#wit-e"><pb n="110" ed="#liebermann"/>XCI. Gif mon forstolenne<ptr type="liebermannNote" n="6" target="#Ine_47.lnote.oe.6"/> ceap befehð, ne mot hine mon tieman<ptr type="liebermannNote" n="7" target="#Ine_47.lnote.oe.7-2"/> to ðeowum men.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47" corresp="#wit-h"><pb n="110" ed="#liebermann"/>XCI. Gif mon<ptr type="liebermannNote" n="4" target="#Ine_47.lnote.oe.4"/> forstolenne ceap befehð, ne mot hine mon<ptr type="liebermannNote" n="4" target="#Ine_47.lnote.oe.4"/> tymon<ptr type="liebermannNote" n="4" target="#Ine_47.lnote.oe.4"/> to þeowan men.<ptr type="liebermannNote" n="7" target="#Ine_47.lnote.oe.7"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47" corresp="#wit-b-no-prol"><pb n="110" ed="#liebermann"/>Gyf mon forstolene ceap befehð, ne mot híne mon tymon to ðeowan men.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="47" corresp="#wit-q"><pb n="111" ed="#liebermann"/>Si aliquid<ptr type="liebermannNote" n="8" target="#Ine_47.lnote.oe.8"/> furtiuum intercietur, non debet aduocari ad seruum.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="52" ed="#attenborough"/>Gif mon forstolenne<ptr type="editorNote" n="1" target="#Ine_47.attnote.fn.1"/> ceap befehð, ne mot hine mon tieman to ðeowum men.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="49" corresp="#wit-e"><pb n="412" ed="#jurasinski-and-oliver"/>{XCI} Gif mon forstolenne ceap befehð, ne mot hine mon tieman to ðeowum men.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="111" ed="#liebermann"/>Wenn jemand gestohlenes Vieh im Anefang ertappt, so darf der [verklagte] Mann es nicht zur Gewähr auf einen unfreien<ptr type="liebermannNote" n="1" target="#Ine_47.lnote.de.1"/> Mann ziehen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone seizes stolen livestock by attachment, the [accused] man may not vouch it to warranty upon an unfree man.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="53" ed="#attenborough"/>If a stolen chattel is attached, a slave may not be vouched to warranty<ptr type="editorNote" n="1" target="#Ine_47.attnote.n.1"/> for it.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="405" ed="#whitelock"/>If anyone attaches stolen cattle, [the accused] may not vouch a slave to warranty.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="413" ed="#jurasinski-and-oliver"/>If someone captures stolen livestock, a slave cannot be vouched to warranty for it.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_47.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">111</biblScope></bibl><seg type="original" xml:lang="de">quid <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">quid Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_47.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_47.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> menn</seg><seg type="translation" xml:lang="en" source="#claude">altered to menn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_47.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de">-lene c. befeꝥ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lene c. befeꝥ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_47.lnote.oe.7-2" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de">tyman <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">tyman Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_47.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">77</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Anefang 14; unfrei 21c</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Anefang 14; unfrei 21c</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_47.attnote.fn.1" n="1" source="#attenborough"><bibl><biblScope unit="page">52</biblScope></bibl><label>forstolenne</label><seg type="original" xml:lang="en"><hi rend="italic">forstolene</hi>. B &amp; Ld.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_47.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">190</biblScope></bibl><seg type="original" xml:lang="en">By him in whose possession it is attached. The disability was removed later; see II As. cap. 24.</seg></note>
      </div>
