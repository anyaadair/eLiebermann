    <body>
      <div type="clause" n="35.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 35.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35.1" corresp="#wit-e"><pb n="68" ed="#liebermann"/>Gif hine mon beswinge, mid XX<ptr type="liebermannNote" n="28" target="#Af_35-1.lnote.oe.28"/> scill. gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35.1" corresp="#wit-h"><pb n="68" ed="#liebermann"/>Gif hine mon<ptr type="liebermannNote" n="12" target="#Af_35-1.lnote.oe.12"/> beswinge, mid XX scll' gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35.1" corresp="#wit-b-no-prol"><pb n="69" ed="#liebermann"/>Gyf hine man beswinge, mid twentig scill' gebete.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="35.1" corresp="#wit-q"><pb n="69" ed="#liebermann"/>Si<ptr type="liebermannNote" n="10" target="#Af_35-1.lnote.oe.10"/> eum uerberet, uiginti sol. emendet.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="78" ed="#attenborough"/>Gif hine mon beswinge, mid XX scill. gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="36.1" corresp="#wit-e"><pb n="328" ed="#jurasinski-and-oliver"/>Gif hine mon beswinge, mid XX scill gebete.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="69" ed="#liebermann"/>Wenn jemand ihn prügelt, büsse er mit 20 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone flogs him, let him pay 20 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="79" ed="#attenborough"/>If anyone scourges him, he shall pay 20 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="414" ed="#whitelock"/>If anyone scourges him, he is to pay him 20 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="329" ed="#jurasinski-and-oliver"/>If someone flogs [an innocent ceorl], let him pay with 20 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-1.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">tweontig <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">tweontig Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de">35, 1 <hi rend="italic">setzt hinter</hi> 35, 2 <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">35, 1 placed after 35, 2 by Lond</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_35-1.lnote.de.0" n="0" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl ebd.;</hi> Prügel 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl ibid.;</hi> Prügel 1</seg></note>
