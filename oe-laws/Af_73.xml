      <div type="clause" n="73">
        <head><ref type="lawCode" target="law:Af">Af</ref> 73</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="73" corresp="#wit-e"><pb n="86" ed="#liebermann"/>Gif mon oðrum ða sculdru forslea, geselle<ptr type="liebermannNote" n="2" target="#Af_73.lnote.oe.2"/> him mon XX scill. to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="73" corresp="#wit-h"><pb n="86" ed="#liebermann"/>Gif mon<ptr type="liebermannNote" n="1" target="#Af_73.lnote.oe.1"/> oþrum þa sculdru<ptr type="liebermannNote" n="8" target="#Af_73.lnote.oe.8"/> forslea, gesylle<ptr type="liebermannNote" n="2" target="#Af_73.lnote.oe.2-2"/> him mon XX scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="73" corresp="#wit-b-no-prol"><pb n="86" ed="#liebermann"/>Gyf man oðru<hi rend="italic">m</hi> ða sculdru forslea, gesylle him mon XX scill' to bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="73" corresp="#wit-q"><pb n="87" ed="#liebermann"/>Si quis alii<ptr type="liebermannNote" n="7" target="#Af_73.lnote.oe.7"/> (homini) scapulam truncauerit, XX sol.<ptr type="liebermannNote" n="8" target="#Af_73.lnote.oe.8-2"/> multetur.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="92" ed="#attenborough"/>Gif mon oðrum ða sculdru forslea, geselle him mon XX scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="77" corresp="#wit-e"><pb n="362" ed="#jurasinski-and-oliver"/>Gif mon oðrum ða sculdru forslea, geselle him mon mid XX scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="87" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_73.lnote.de.1"/> jemand einem anderen die Schultern<ptr type="liebermannNote" n="2" target="#Af_73.lnote.de.2"/> zerschlägt, gebe er ihm 20 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone smashes another’s shoulders, let him give him 20 shillings as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="93" ed="#attenborough"/>If anyone smashes another's shoulder<ptr type="editorNote" n="1" target="#Af_73.attnote.n.1"/>, 20 shillings shall be given to him as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="363" ed="#jurasinski-and-oliver"/>If someone injures another in the shoulder, let him be paid 20 shillings as compensation.</ab>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="355"><ref target="clause:Af_53">Af 53</ref></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="361"><ref target="clause:Af_68">Af 68</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_73.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">gesylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gesylle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_73.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geändert in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_73.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">letztes</hi> u <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">last u on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_73.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_73.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">87</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> al. <hi rend="italic">Lond Hn</hi> 93, 33; <hi rend="italic">nur</hi> ho. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">only al. Lond Hn 93, 33; only ho. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_73.lnote.oe.8-2" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">87</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt R</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in R</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_73.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Schulter</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Schulter</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_73.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Der Plural des Or. wird von Inst. als Pl. ‘Schultern’ verstanden. Dieser Sinn ist auch sonst nachweisbar. Doch wird auch der Sing. <hi rend="italic">scapula</hi> durch den Plural <hi rend="italic">sculdra</hi> glossiert (Toller, <hi rend="italic">Dict.</hi>, Ælfric ed. Zupitza 298) und daher hier verstanden von Q und den Neueren. Da regelmässig ein Mensch nur an Einer Schulter verwundet wird, Af 74 vom Herausziehen Eines Knochens redet und nirgends von Verwundung beider rechts und links befindlicher Glieder spricht, scheint Af zu verstehen: ‘eine der beiden Schultern’</seg><seg type="translation" xml:lang="en" source="#claude">The plural of the Or. is understood by Inst. as a plural, ‘shoulders’. This sense is attested elsewhere too. But the singular <hi rend="italic">scapula</hi> is also glossed by the plural <hi rend="italic">sculdra</hi> (Toller, <hi rend="italic">Dict.</hi>, Ælfric ed. Zupitza 298), and it is therefore understood in that way here by Q and the moderns. Since as a rule a man is wounded in only one shoulder, and Af 74 speaks of the extraction of one bone and nowhere speaks of wounding of both limbs, right and left, Af seems to mean: ‘one of the two shoulders’</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_73.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">200</biblScope></bibl><seg type="original" xml:lang="en">For the use of the plural (<hi rend="italic">ða sculdru</hi>), see Liebermann’s note (<hi rend="smallcaps">iii</hi>. p. 62).</seg></note>
      </div>
