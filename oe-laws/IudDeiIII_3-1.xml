        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_3-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ch Ca</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Ch Ca</seg></note>
