  <text>
    <body>
      <div type="clause" n="7.1">
        <head><ref type="lawCode" target="law:Duns">Duns</ref> 7.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.1" corresp="#wit-b"><pb n="378" ed="#liebermann"/>Oðre ungesawene ðing man<ptr type="liebermannNote" n="5" target="#Duns_7-1.lnote.oe.5"/> mot mid aðe gewyrðan, ⁊ syððan be ðam gyldan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.1" corresp="#wit-q"><pb n="379" ed="#liebermann"/>Cetere res ungesaƿene<ptr type="liebermannNote" n="13" target="#Duns_7-1.lnote.oe.13"/> (id est non uise) possunt<ptr type="liebermannNote" n="14" target="#Duns_7-1.lnote.oe.14"/> iuramento comprobari et secundum hoc reddi. Capra duos d.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="379" ed="#liebermann"/>Andere, unsichtbare [abstracte<ptr type="liebermannNote" n="1" target="#Duns_7-1.lnote.de.1"/>] Sachen dürfen [vom Kläger] durch Eid bewerthet<ptr type="liebermannNote" n="2" target="#Duns_7-1.lnote.de.2"/> und [ihm] dann demgemäss bezahlt werden.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Other, unseen [abstract] things may be valued by oath [by the plaintiff] and then paid [to him] accordingly.</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-b">Other unseen things [i.e. not on the above list?] may be valued [by the plaintiff] by [taking an] oath, and paid out accordingly.</ab>
        <note type="editorial">U: translator unrecorded: check; The Quadripartitus's ‘Capra duos d.’ at the end of this clause belongs to 7 in the OE (see the note there).</note>
        <note type="liebermannNote" subtype="textual" xml:id="Duns_7-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">378</biblScope></bibl><seg type="original" xml:lang="de">mon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duns_7-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">379</biblScope></bibl><seg type="original" xml:lang="de">-seƿ. <hi rend="italic">T M Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-seƿ. T M Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duns_7-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">379</biblScope></bibl><seg type="original" xml:lang="de">-sint <hi rend="italic">M Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sint M Hk</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Duns_7-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">219</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Archiv</hi> (<hi rend="italic">o</hi>. Pro⁶) 288f.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Archiv</hi> (<hi rend="italic">above</hi> Pro⁶) 288f.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Duns_7-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">219</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Taxe 7. Q übs. besser <hi rend="italic">adpreciare</hi> AGu 3. Er meint hier wohl, dass der Eid zugleich beweist</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Taxe 7. Q translates better at AGu 3: <hi rend="italic">adpreciare</hi>. Here he probably means that the oath at the same time constitutes proof</seg></note>
      </div>
