abbr></ref> 31; a; 1. 32; <ref type="lawCode" target="law:retr">retr</ref>. 30. 30,4a; b. <ref type="lawCode" target="law:Lond">Lond</ref> <ref type="lawCode" target="law:ECf">ECf</ref> 32 <ref type="lawCode" target="law:MsA">A</ref> 1; 12; <hi rend="italic"><ref type="abbreviation" target="gram:Variante"><abbr>Var.</abbr></ref> in</hi> <ref type="lawCode" target="law:ECf">ECf</ref>: <hi rend="italic"><ref type="abbreviation" target="gram:fur"><abbr>für</abbr></ref> erstes</hi> a: e; <hi rend="italic"><ref type="abbreviation" target="gram:fur"><abbr>für</abbr></ref> zweites</hi> a: o; <hi rend="italic"><ref type="abbreviation" target="gram:fur"><abbr>für</abbr></ref></hi> e: i; <hi rend="italic"><ref type="abbreviation" target="gram:fur"><abbr>für</abbr></ref></hi> g: c, ch, cc; <hi rend="italic">Endung</hi> ium <hi rend="italic"><ref type="abbreviation" target="gram:fehlt"><abbr>fehlt</abbr></ref> <ref type="abbreviation" target="gram:oder"><abbr>od</abbr></ref>. fem.</hi> ~ia | <hi rend="italic">sachlich (<ref type="abbreviation" target="gram:irrig"><abbr>irrig</abbr></ref>) verglichen <ref type="abbreviation" target="gram:mit"><abbr>mit</abbr></ref></hi> lathe <ref type="lawCode" target="law:ECf">ECf</ref> 22,5*. 32 <ref type="lawCode" target="law:retr">retr</ref>* | <hi rend="italic">etymologisch <ref type="abbreviation" target="gram:erklart"><abbr>erklärt</abbr></ref> <ref type="abbreviation" target="gram:aus"><abbr>aus</abbr></ref></hi> wapna <hi rend="italic">und</hi> (<hi rend="italic"><ref type="abbreviation" target="gram:irrig"><abbr>irrig</abbr></ref></hi>) taccare 30,4 <hi rend="italic"><ref type="abbreviation" target="gram:oder"><abbr>oder</abbr></ref></hi> tac <ref type="lawCode" target="law:retr">retr</ref> 30,4a; b</dictScrap>
