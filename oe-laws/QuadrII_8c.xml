      <div type="clause" n="8c">
        <head><ref type="lawCode" target="law:QuadrII">Quadr II</ref> 8c</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr II 8c" corresp="#wit-lat"><pb n="545" ed="#liebermann"/>Sed cum episcopi<ptr type="liebermannNote" n="5" target="#QuadrII_8c.lnote.oe.5"/> (ipsi<ptr type="liebermannNote" n="e" target="#QuadrII_8c.lnote.oe.e"/>) nullatenus adquiescerent, Willelmus Giffardus<ptr type="liebermannNote" n="6" target="#QuadrII_8c.lnote.oe.6"/>, Wintoniensis electus episcopus et sacrandorum unus, Romam petiit<ptr type="liebermannNote" n="f" target="#QuadrII_8c.lnote.oe.f"/>, et beatissimum archiepiscopum suum Anselmum reduxit<ptr type="liebermannNote" n="7" target="#QuadrII_8c.lnote.oe.7"/>; ubi diuinam et apostolicam benedictionem meruit et eternam sibi gloriam<ptr type="liebermannNote" n="8" target="#QuadrII_8c.lnote.oe.8"/> per secula cumulauit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 545 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8c.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">die Ministranten waren für York bereit</hi> (<hi rend="italic">Liebermann</hi> Hist. Aufs. dem And. an Waitz; <hi rend="italic">S. A. p.</hi> 35). <hi rend="italic">Verf. will entweder den ganzen Episcopat rein waschen oder, wenn</hi> ipsi <hi rend="italic">richtig, den Roger. Nur Reinhelm und Wilhelm lehnten Weihe durch York ab</hi></seg><seg type="translation" xml:lang="en" source="#claude">the assisting clergy were ready for York (Liebermann Hist. Aufs. dem And. an Waitz; offprint p. 35). The author wishes to clear either the whole episcopate or, if ipsi is correct, Roger. Only Reinhelm and William refused consecration by York</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8c.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Wilhelm begleitete Anselm nach Rom, aber zurück nicht bis England, sondern höchstens vielleicht bis Lyon, Dec.</hi> 1103</seg><seg type="translation" xml:lang="en" source="#claude">William accompanied Anselm to Rome, but on the way back went not as far as England but at most perhaps as far as Lyon, Dec. 1103</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8c.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de">ep. <hi rend="italic">T;</hi> <hi rend="spaced">ipsi</hi> <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">ep. T; <hi rend="italic">ipsi</hi> MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8c.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de">Girardus Wintoniensium lectus <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Girardus Wintoniensium lectus MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8c.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt T</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8c.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de">gloria <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">gloria Hk</seg></note>
      </div>
