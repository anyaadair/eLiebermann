      <div type="clause" n="5.4">
        <head><ref type="lawCode" target="law:Af">Af</ref> 5.4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.4" corresp="#wit-e"><pb n="52" ed="#liebermann"/>Eac cirican<ptr type="liebermannNote" n="3" target="#Af_5-4.lnote.oe.3"/> frið:<ptr type="liebermannNote" n="22" target="#Af_5-4.lnote.oe.22"/> gif hwelc<ptr type="liebermannNote" n="23" target="#Af_5-4.lnote.oe.23"/> mon cirican<ptr type="liebermannNote" n="3" target="#Af_5-4.lnote.oe.3"/> gesece<ptr type="liebermannNote" n="*" target="#Af_5-4.lnote.oe.star"/> for ðara<ptr type="liebermannNote" n="24" target="#Af_5-4.lnote.oe.24"/> gylta hwylcum<ptr type="liebermannNote" n="25" target="#Af_5-4.lnote.oe.25"/>, þara<ptr type="liebermannNote" n="24" target="#Af_5-4.lnote.oe.24"/> ðe ær geypped nære, ⁊ hine ðær on Godes naman<ptr type="liebermannNote" n="26" target="#Af_5-4.lnote.oe.26"/> geandette<ptr type="liebermannNote" n="27" target="#Af_5-4.lnote.oe.27"/>, sie<ptr type="liebermannNote" n="28" target="#Af_5-4.lnote.oe.28"/> hit healf forgifen.<ptr type="liebermannNote" n="29" target="#Af_5-4.lnote.oe.29"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.4" corresp="#wit-h"><pb n="52" ed="#liebermann"/>Eac cyrican<ptr type="liebermannNote" n="6" target="#Af_5-4.lnote.oe.6"/> friþ: gif hwylc mon<ptr type="liebermannNote" n="3" target="#Af_5-4.lnote.oe.3-2"/> cirican<ptr type="liebermannNote" n="6" target="#Af_5-4.lnote.oe.6"/> gesece for þæra gylta hwylcum<ptr type="liebermannNote" n="7" target="#Af_5-4.lnote.oe.7"/>, þæra<ptr type="liebermannNote" n="5" target="#Af_5-4.lnote.oe.5"/> ðe ær geypped nære, ond<ptr type="liebermannNote" n="3" target="#Af_5-4.lnote.oe.3-2"/> hine ðær on Godes noman<ptr type="liebermannNote" n="3" target="#Af_5-4.lnote.oe.3-2"/> geondette<ptr type="liebermannNote" n="3" target="#Af_5-4.lnote.oe.3-2"/>, sy<ptr type="liebermannNote" n="7" target="#Af_5-4.lnote.oe.7"/> hit healf forgifen.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.4" corresp="#wit-b-no-prol"><pb n="53" ed="#liebermann"/>Eac cyricean frið:<ptr type="liebermannNote" n="3" target="#Af_5-4.lnote.oe.3-3"/> gyf hwylc man cyricean geséce for ðara gylta hwylcu<hi rend="italic">m</hi>, þæra ðe ær geypped nǽre, ⁊ hine ðær on Godes naman geandette, sy hit healf forgyfen.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.4" corresp="#wit-q"><pb n="53" ed="#liebermann"/>Item.<ptr type="liebermannNote" n="7" target="#Af_5-4.lnote.oe.7-2"/> Qui ad ecclesiam confugiet<ptr type="liebermannNote" n="8" target="#Af_5-4.lnote.oe.8"/> pro quacumque culpa, quę nondum<ptr type="liebermannNote" n="9" target="#Af_5-4.lnote.oe.9"/> propalata<ptr type="liebermannNote" n="10" target="#Af_5-4.lnote.oe.10"/> sit, et eam in nomine Domini gratis confitebitur<ptr type="liebermannNote" n="11" target="#Af_5-4.lnote.oe.11"/>, dimidium forisfacti<ptr type="liebermannNote" n="12" target="#Af_5-4.lnote.oe.12"/> condonetur ei.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="66" ed="#attenborough"/>Eac cirican frið<ptr type="editorNote" n="14" target="#Af_5-4.attnote.fn.14"/>: gif hwelc mon cirican gesece<ptr type="editorNote" n="15" target="#Af_5-4.attnote.fn.15"/> for ðara gylta hwylcum, þara ðe ær geypped nære, ⁊ hine ðær on Godes naman geandette, sie hit healf forgifen.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="5.4" corresp="#wit-e"><pb n="298" ed="#jurasinski-and-oliver"/>Eac cirican frið: gif hwelce mon cirican gesece for ðara gylta hwylcum, þara ðe ær geypped nære, ⁊ hine ðær on Godes naman geandette, sie hit healf forgifen.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="53" ed="#liebermann"/>Ferner Kirchenprivileg: wenn jemand eine Kirche aufsucht<ptr type="liebermannNote" n="1" target="#Af_5-4.lnote.de.1"/>, wegen einer jener Verschuldungen, die<ptr type="liebermannNote" n="2" target="#Af_5-4.lnote.de.2"/> früher nicht offenbar war, und sie dort in Gottes Namen bekennt, sei es halb vergeben.<ptr type="liebermannNote" n="3" target="#Af_5-4.lnote.de.3"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Further, a church privilege: if someone seeks a church on account of any of those offences which was not previously disclosed, and confesses it there in God’s name, let it be half forgiven.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="67" ed="#attenborough"/>The privilege of sanctuary belonging to a church includes also the following: if anyone takes refuge in a church, because of any offence which up to that time had been kept secret, and there confesses his sin in God's name, half the punishment shall be remitted him.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="411" ed="#whitelock"/>Further sanctuary of the church: if any man has recourse to the church on account of any crime which has not been discovered, and there confesses himself in God’s name, it is to be half remitted.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="299" ed="#jurasinski-and-oliver"/>Likewise church sanctuary: if some man seeks out the church for whatever offense that had not previously been discovered, and he there confesses himself in God’s name, let it be forgiven by half.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-4.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">cyr. <hi rend="italic">So;</hi> cyricean <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyr. So; cyricean Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-4.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">fryðe is <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fryðe is So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-4.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">hwilc <hi rend="italic">So;</hi> hwylce man <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hwilc So; hwylce man Ld</seg></note>
