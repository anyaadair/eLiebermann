      <div type="clause" n="12.1">
        <head><ref type="lawCode" target="law:IudDeiVII">Iud Dei VII</ref> 12.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei VII 12.1" corresp="#wit-lat"><pb n="413" ed="#liebermann"/>Adiuro<ptr type="liebermannNote" n="c" target="#IudDeiVII_12-1.lnote.oe.c"/> te (uos<ptr type="liebermannNote" n="1" target="#IudDeiVII_12-1.lnote.oe.1"/>) per omnipotentem Deum, qui creauit cęlum et terram et omnes creaturas, et per sanctam crucem, qua passus est et omne humanum genus de diaboli<ptr type="liebermannNote" n="2" target="#IudDeiVII_12-1.lnote.oe.2"/> captiuitate redemit, et per sanctam uirginem Mariam et per totum angelorum agmen ac archangelorum et per magnificos prophetas ac patriarchas;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 413 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_12-1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">413</biblScope></bibl><seg type="original" xml:lang="de">12, 1—4 <hi rend="italic">nur stückweise identisch mit</hi> I 2, 1. X 13.</seg><seg type="translation" xml:lang="en" source="#claude">12, 1—4 only partly identical with I 2, 1. X 13.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_12-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">413</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Plural übergeschr. Ci Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">plural written above Ci Vt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_12-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">413</biblScope></bibl><seg type="original" xml:lang="de">-buli <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">-buli Ci</seg></note>
      </div>
