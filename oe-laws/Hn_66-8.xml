      <div type="clause" n="66.8">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 66.8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 66.8" corresp="#wit-lat"><pb n="586" ed="#liebermann"/>Si quis furti<ptr type="liebermannNote" n="5" target="#Hn_66-8.lnote.oe.5"/> uel huiusmodi periculosa capitalium compellacione pulsetur, secundum legem<ptr type="liebermannNote" n="6" target="#Hn_66-8.lnote.oe.6"/> Westsexe<ptr type="liebermannNote" n="7" target="#Hn_66-8.lnote.oe.7"/> anteiuramentum<ptr type="liebermannNote" n="e" target="#Hn_66-8.lnote.oe.e"/> a compellante habeat<ptr type="liebermannNote" n="8" target="#Hn_66-8.lnote.oe.8"/>, et alter<ptr type="liebermannNote" n="9" target="#Hn_66-8.lnote.oe.9"/> se sexto<ptr type="liebermannNote" n="f" target="#Hn_66-8.lnote.oe.f"/> decime<ptr type="liebermannNote" n="10" target="#Hn_66-8.lnote.oe.10"/> sue purgetur, sicut accusator precesserit, secundum meritum concausaucium et cause modum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 586 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-8.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">einfachen Voreid des Klägers (<hi rend="italic">d. h. mit zwei Helfern; Inst. Cn. II</hi> 22, 1<hi rend="italic">a</hi>, <hi rend="italic">oben S.</hi> 325), <hi rend="italic">der ein Privater, im Gegensatz zu</hi> 66, 9</seg><seg type="translation" xml:lang="en" source="#claude">simple fore-oath of the plaintiff (i.e. with two helpers; Inst. Cn. II 22, 1<hi rend="italic">a</hi>, above p. 325), who is a private person, in contrast to 66, 9</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-8.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 67, 1<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 67, 1<hi rend="italic">b</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-8.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">-tim <hi rend="italic">Sc Hg</hi>; -tum <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tim Sc Hg; -tum Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-8.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">de <hi rend="italic">fügt zu K</hi></seg><seg type="translation" xml:lang="en" source="#claude">de <hi rend="italic">added by K</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-8.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">Wess. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Wess. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-8.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">-atur <hi rend="italic">ohne Hss. Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">-atur Wi Tho without MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-8.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">aliter <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">aliter K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-8.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">d. s. <hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. s. missing K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-8.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Zehnerschaft 27a; Eideshelfer 28—<hi rend="italic">aliter</hi>{9}—<hi rend="italic">d</hi>.{10} <hi rend="italic">s</hi>. fehlt Rs; statt <hi rend="italic">precesserit</hi> meinte Verf. wohl <hi rend="italic">proc</hi>.—66, 9a <hi rend="italic">eleg</hi>.{18} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Zehnerschaft 27a; Eideshelfer 28—<hi rend="italic">aliter</hi>{9}—<hi rend="italic">d</hi>.{10} <hi rend="italic">s</hi>. missing Rs; instead of <hi rend="italic">precesserit</hi> the author probably meant <hi rend="italic">proc</hi>.—66, 9a <hi rend="italic">eleg</hi>.{18} Rs</seg></note>
      </div>
