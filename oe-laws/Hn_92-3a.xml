        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 92.3a" corresp="#wit-lat"><pb n="607" ed="#liebermann"/>Si mortuus sit interim naturali morte sua, ostendant et aduocent ad tumulum eius<ptr type="liebermannNote" n="q" target="#Hn_92-3a.lnote.oe.q"/> — si parentes uel amantes non habeat, qui<ptr type="liebermannNote" n="r" target="#Hn_92-3a.lnote.oe.r"/> eum<ptr type="liebermannNote" n="37" target="#Hn_92-3a.lnote.oe.37"/> innoxiare<ptr type="liebermannNote" n="38" target="#Hn_92-3a.lnote.oe.38"/> uelint<ptr type="liebermannNote" n="39" target="#Hn_92-3a.lnote.oe.39"/> —; et emendetur de peccunia illius<ptr type="liebermannNote" n="q" target="#Hn_92-3a.lnote.oe.q"/> et hundreti, sicut fieret in uiuente<ptr type="liebermannNote" n="40" target="#Hn_92-3a.lnote.oe.40"/> non<ptr type="liebermannNote" n="s" target="#Hn_92-3a.lnote.oe.s"/> habito.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 607 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-3a.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">des Mörders</hi></seg><seg type="translation" xml:lang="en" source="#claude">of the murderer</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-3a.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 74, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. 74, 1</seg></note>
