      <div type="clause" n="54.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 54.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 54.1" corresp="#wit-lat"><pb n="574" ed="#liebermann"/>Si aliqui fuerint ita socii, ut peccuniam suam posuerint<ptr type="liebermannNote" n="35" target="#Hn_54-1.lnote.oe.35"/> in communi, et a societate et<ptr type="liebermannNote" n="36" target="#Hn_54-1.lnote.oe.36"/> communitate illa discedere uoluerint<ptr type="liebermannNote" n="37" target="#Hn_54-1.lnote.oe.37"/>, afferant<ptr type="liebermannNote" n="38" target="#Hn_54-1.lnote.oe.38"/> coram testibus quicquid<ptr type="liebermannNote" n="39" target="#Hn_54-1.lnote.oe.39"/> habent, in commune<ptr type="liebermannNote" n="40" target="#Hn_54-1.lnote.oe.40"/> diuidendum<ptr type="liebermannNote" n="41" target="#Hn_54-1.lnote.oe.41"/>, ut, si opus est, super sancta iurent, quod amplius non habeant<ptr type="liebermannNote" n="42" target="#Hn_54-1.lnote.oe.42"/>; et adquisicionem et adquisitum, sicut rectum est et pactum fecerunt, diuidant inter<ptr type="liebermannNote" n="43" target="#Hn_54-1.lnote.oe.43"/> se.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 574 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_54-1.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">574</biblScope></bibl><seg type="original" xml:lang="de">-runt <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">-runt Wh</seg></note>
