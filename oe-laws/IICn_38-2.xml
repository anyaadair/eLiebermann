    <body>
      <div type="clause" n="38.2">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 38.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="38.2" corresp="#wit-g-a"><pb n="338" ed="#liebermann"/>⁊ godcunde bote sece mann<ptr type="liebermannNote" n="19" target="#IICn_38-2.lnote.oe.19"/> symle georne be boctæcinge<ptr type="liebermannNote" n="20" target="#IICn_38-2.lnote.oe.20"/>, ⁊ woruldcunde bote sece man be woruldlage.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="38.2" corresp="#wit-b"><pb n="338" ed="#liebermann"/>⁊ godcunde bote sece man georne ⁊ symble be boctale, ⁊ woruldbote sece man be woruldlage.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="38.2" corresp="#wit-a"><pb n="338" ed="#liebermann"/>And godcunde bote sec<ptr type="liebermannNote" n="1" target="#IICn_38-2.lnote.oe.1"/> mann symle georne be boctale, ⁊ for<ptr type="liebermannNote" n="7" target="#IICn_38-2.lnote.oe.7"/> woruldcunde bote sece mann be weorldlage.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="38.2" corresp="#wit-q"><pb n="339" ed="#liebermann"/>Et Deo<ptr type="liebermannNote" n="16" target="#IICn_38-2.lnote.oe.16"/> gratam emendationem sedulo perquiramus de scripturis sanctis et secularem iuxta legem seculi.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="38.2" corresp="#wit-cons-cn"><pb n="339" ed="#liebermann"/>Diuinaque correctio ex librorum decretis et secularis ex seculari lege inquiratur.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="38.2" corresp="#wit-b"><pb n="194" ed="#robertson"/>⁊ godcunde bote sece man georne<ptr type="editorNote" n="6" target="#IICn_38-2.robnote.fn.6"/> ⁊ symble<ptr type="editorNote" n="7" target="#IICn_38-2.robnote.fn.7"/> be boctale<ptr type="editorNote" n="8" target="#IICn_38-2.robnote.fn.8"/>, ⁊ woruldbote<ptr type="editorNote" n="9" target="#IICn_38-2.robnote.fn.9"/> sece man be woruldlage.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="276" ed="#rabin-doml"/>And godcunde bote sece mann symle georne be boctæcinge, and woruldcunde bote sece man be woruldlage.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="339" ed="#liebermann"/>Und geistliche<ptr type="liebermannNote" n="1" target="#IICn_38-2.lnote.de.1"/> Busse erstrebe man immer (und <hi rend="italic">B</hi>) eifrig gemäss [kanonischer] Bücher-Anweisung<ptr type="liebermannNote" n="2" target="#IICn_38-2.lnote.de.2"/> (-Aussage <hi rend="italic">B A</hi>), und (um<ptr type="liebermannNote" n="2" target="#IICn_38-2.lnote.de.2"/> <hi rend="italic">A</hi>) weltliche Busse erstrebe man gemäss staatlichem Rechte.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let spiritual atonement always be sought eagerly according to the teaching (the word, B A) of the [canonical] books, and let secular compensation be sought according to secular law.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_38-2.robnote.n.1"/><pb n="195" ed="#robertson"/>And ecclesiastical amends shall always be diligently exacted in accordance with the directions contained in the canon law, and secular amends in accordance with secular law.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="467" ed="#whitelock"/>And ecclesiastical amends are always to be diligently demanded according to the instruction in books [of penance] and secular amends according to the secular law.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="277" ed="#rabin-doml"/>And spiritual penance shall always be assessed according to canon law, and secular penalties according to the civil law.</ab>
        <note type="comparison" source="#wormald-mel" n="359"><label>source (roman)</label> <ref target="clause:VIAtr_52">VI Atr 52</ref> <quote>Table 5.4, II Cn 38:2: VI Atr 52</quote></note>
        <note type="editorial">A's ‘for’ before ‘woruldcunde’ is Middle English.; BR: added from Gesetze I p. 339, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">symle georne: georne and symble B</note>
        <note type="textual" source="#rabin-doml">boctæcinge: boctale AB</note>
        <note type="textual" source="#rabin-doml">and woruldcunde: and for woruldcunde A; and woruldbote B</note>
        <note type="textual" source="#rabin-doml">bote: omitted B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_38-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">339</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_38-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">339</biblScope></bibl><seg type="original" xml:lang="de">g. D. <hi rend="italic">K;</hi> ideo <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">g. D. K; ideo Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_38-2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">338</biblScope></bibl><seg type="original" xml:lang="de">man <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">man Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_38-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">338</biblScope></bibl><seg type="original" xml:lang="de">boctale ⁊ for w. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">boctale ⁊ for w. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_38-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">338</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_38-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">338</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Mittelenglisch</hi></seg><seg type="translation" xml:lang="en" source="#claude">Middle English</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_38-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">208</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">godcunde bote sece man to scrifte</hi>, <hi rend="italic">leodbiscope</hi>, <hi rend="italic">arcebiscope</hi>, <hi rend="italic">papan</hi>, <hi rend="italic">Gode; Hom. n</hi>. Wulfstan 275</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">godcunde bote sece man to scrifte</hi>, <hi rend="italic">leodbiscope</hi>, <hi rend="italic">arcebiscope</hi>, <hi rend="italic">papan</hi>, <hi rend="italic">Gode; Hom. n</hi>. Wulfstan 275</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_38-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">208</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">boca tæcing s</hi>. VIII Atr 28. <hi rend="italic">Boctæcing</hi> und -<hi rend="italic">talu</hi> zitiert Toller nur hierher und nimmt die Komposita als synonym. Vielleicht zeigte schon Archetyp beide Lesungen; <hi rend="italic">s</hi>. Einl. 3.—Q versteht ‘Bibel’ zu eng</seg><seg type="translation" xml:lang="en" source="#claude">On <hi rend="italic">boca tæcing see</hi> VIII Atr 28. Toller cites <hi rend="italic">Boctæcing</hi> and -<hi rend="italic">talu</hi> only for this passage and takes the compounds as synonymous. Perhaps the archetype already had both readings; <hi rend="italic">see</hi> Introduction 3. — Q understands ‘Bible’ too narrowly</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_38-2.lnote.de.3" n="3" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">208</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">[bessere ² letzter Z. in ³] <hi rend="italic">for</hi> hinter ‘besorgt sein um’ wird schon Agsä. (Koch-Zupitza II § 407f.; Mätzner <hi rend="italic">Engl. Gram</hi>. II a 438), dagegen hinter <hi rend="italic">secan</hi> erst seit 14. Jh. nachgewiesen</seg><seg type="translation" xml:lang="en" source="#claude">[correct ² in the last line to ³] <hi rend="italic">for</hi> after ‘be concerned about’ is attested already in A.-S. (Koch-Zupitza II § 407f.; Mätzner <hi rend="italic">Engl. Gram</hi>. II a 438), but after <hi rend="italic">secan</hi> only from the 14th cent.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_38-2.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">356</biblScope></bibl><seg type="original" xml:lang="en">Cf. Wulfstan, p. 275.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_38-2.robnote.fn.6" n="6" source="#robertson"><bibl><biblScope unit="page">194</biblScope></bibl><label>georne</label><seg type="original" xml:lang="en"><hi rend="italic">symle g.</hi> G, A, Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_38-2.robnote.fn.7" n="7" source="#robertson"><bibl><biblScope unit="page">194</biblScope></bibl><label>symble</label><seg type="original" xml:lang="en">⁊ <hi rend="italic">s.</hi> om. G, A, Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_38-2.robnote.fn.8" n="8" source="#robertson"><bibl><biblScope unit="page">194</biblScope></bibl><label>boctale</label><seg type="original" xml:lang="en"><hi rend="italic">boctæcinge</hi> G.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_38-2.robnote.fn.9" n="9" source="#robertson"><bibl><biblScope unit="page">194</biblScope></bibl><label>woruldbote</label><seg type="original" xml:lang="en"><hi rend="italic">woruldcunde bote</hi> G; <hi rend="italic">for w. b.</hi> A, Ld.</seg></note>
      </div>
