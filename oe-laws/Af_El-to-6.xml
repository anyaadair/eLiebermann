    <body>
      <div type="clause" n="El. 6">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 6</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 6" corresp="#wit-e"><pb n="28" ed="#liebermann"/>Ne lige<ptr type="liebermannNote" n="9" target="#Af_El-to-6.lnote.oe.9"/> ðu dearnenga.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 6" corresp="#wit-g-prol-only"><pb n="28" ed="#liebermann"/>Ne lige ðu dearnunga.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 6" corresp="#wit-h"><pb n="29" ed="#liebermann"/>Ne lige þu deornunga.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 6" corresp="#wit-q"><pb n="29" ed="#liebermann"/>Non mechaberis.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 6" corresp="#wit-e"><pb n="228" ed="#jurasinski-and-oliver"/>Ne lige ðu dearnenga.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="29" ed="#liebermann"/>Buhle du nicht ausserehelich.<ptr type="liebermannNote" n="1" target="#Af_El-to-6.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Do not fornicate outside marriage.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="229" ed="#jurasinski-and-oliver"/>Do not fornicate.</ab>
        <note type="passageSource">Exodus 20,14</note>
        <note type="comparison" source="#liebermann" n="29">Exodus 20.14</note>
        <note type="comparisonPrinted" source="#liebermann">[20, 14]</note>
        <note type="comparison" source="#jurasinski-and-oliver" n="229"><label>same idiom</label> <ref target="clause:Ine_27">Ine 27</ref> <quote>The sense here is certainly "do not commit adultery," conveyed with an idiom that occurs in §27 of Ine's laws.</quote></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="269"><ref target="clause:Af_El-to-49-5">Af El 49.5</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-6.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">28</biblScope></bibl><seg type="original" xml:lang="de">ligge þu dearninga <hi rend="italic">So;</hi> licge ðu dearnunga <hi rend="italic">Ld, wo</hi> 7 <hi rend="italic">vor</hi> 6 <hi rend="italic">steht</hi></seg><seg type="translation" xml:lang="en" source="#claude">ligge þu dearninga So; licge ðu dearnunga Ld, where 7 stands before 6</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-6.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">43</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘ehebrecherisch’ Frühere. Allein <hi rend="italic">s. o.</hi> zu Ine Rb 27. Ælfric 209 verpönt ausdrücklich jeden unehelichen Beischlaf; <hi rend="italic">vgl. Gl</hi> Unzucht 6</seg><seg type="translation" xml:lang="en" source="#claude">‘adulterously’ earlier scholars. But <hi rend="italic">see above</hi> on Ine Rb 27. Ælfric 209 expressly proscribes all extramarital intercourse; <hi rend="italic">cf. Gl</hi> Unzucht 6</seg></note>
      </div>
    </body>
