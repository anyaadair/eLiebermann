  <text>
    <body>
      <div type="clause" n="22.2">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 22.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 22.2"><pb n="647" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_22-2.lnote.oe.erkl-clause"/>Tol<ptr type="liebermannNote" n="29" target="#ECf_22-2.lnote.la.29"/>, quod nos uocamus theloneum, scilicet<ptr type="liebermannNote" n="30" target="#ECf_22-2.lnote.la.30"/> libertatem<ptr type="liebermannNote" n="e" target="#ECf_22-2.lnote.la.fn.e"/> uendendi<ptr type="liebermannNote" n="31" target="#ECf_22-2.lnote.la.31"/> et emendi in terra sua.</ab>
        <note type="comparison" source="#liebermann" n="647"><label>printed alongside</label> <ref target="clause:ECfRetr_22-2">ECf retr 22.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 647 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-2.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">neben</hi> Freiheit vom Zoll am Markt auf eigenem Boden <hi rend="italic">auch</hi> Empfang dieses Zolls</seg><seg type="translation" xml:lang="en" source="#claude">besides freedom from toll at the market on one’s own land, also the receipt of this toll</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-2.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">toll <hi rend="italic">Hk;</hi> theol <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">toll Hk; theol Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-2.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">secundum <hi rend="italic">Ad;</hi> in <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">secundum Ad; in Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-2.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">em. et uc. <hi rend="italic">S;</hi> em. uel u. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">em. et uc. S; em. uel u. Hr</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Toll (<hi rend="italic">Tol</hi>), which we call <hi rend="italic">theloneum</hi>, namely the liberty of selling and buying in his land.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-2.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Zollabgabe 5b-f</seg><seg type="translation" xml:lang="en" source="#claude">Cf. <hi rend="italic">Gl</hi> Zollabgabe 5b-f</seg></note>
      </div>
    </body>
  </text>
