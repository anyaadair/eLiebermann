      <div type="clause" n="4.1">
        <head><ref type="lawCode" target="law:IudDeiII">Iud Dei II</ref> 4.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei II 4.1" corresp="#wit-lat"><pb n="407" ed="#liebermann"/>ita ut, si<ptr type="liebermannNote" n="27" target="#IudDeiII_4-1.lnote.oe.27"/> innocens<ptr type="liebermannNote" n="28" target="#IudDeiII_4-1.lnote.oe.28"/> de<ptr type="liebermannNote" n="29" target="#IudDeiII_4-1.lnote.oe.29"/> hoc furto<ptr type="liebermannNote" n="30" target="#IudDeiII_4-1.lnote.oe.30"/> — uel homicidio uel<ptr type="liebermannNote" n="31" target="#IudDeiII_4-1.lnote.oe.31"/> adulterio uel<ptr type="liebermannNote" n="32" target="#IudDeiII_4-1.lnote.oe.32"/> maleficio —, unde purgatio quaerenda est, in hoc ignitum et<ptr type="liebermannNote" n="33" target="#IudDeiII_4-1.lnote.oe.33"/> tua benedictione sanctificatum ferrum<ptr type="liebermannNote" n="34" target="#IudDeiII_4-1.lnote.oe.34"/> (uel<ptr type="liebermannNote" n="35" target="#IudDeiII_4-1.lnote.oe.35"/> in hanc aquam feruidam et<ptr type="liebermannNote" n="36" target="#IudDeiII_4-1.lnote.oe.36"/> tua benedictione sanctificatam) manus<ptr type="liebermannNote" n="37" target="#IudDeiII_4-1.lnote.oe.37"/> — uel pedes<ptr type="liebermannNote" n="a" target="#IudDeiII_4-1.lnote.oe.a"/> — inmiserit, tua benignissima<ptr type="liebermannNote" n="38" target="#IudDeiII_4-1.lnote.oe.38"/> miseratione inlesus<ptr type="liebermannNote" n="39" target="#IudDeiII_4-1.lnote.oe.39"/> appareat;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 407 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi> -em (<hi rend="italic">so</hi>) -nt <hi rend="italic">H;</hi> u. p. <hi rend="italic">fehlt gemäss Engl. Recht</hi> (<hi rend="italic">s. o.</hi> 1ᵉ) <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above -em (sic) -nt H; u. p. omitted in accordance with English law (see above 1ᵉ) Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-1.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">hic, <hi rend="italic">darüber</hi> hi <hi rend="italic">fügt zu Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">hic, with hi above it, added in Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-1.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-tes <hi rend="italic">übergeschr. Vt H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tes written above in Vt H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-1.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">de — malef. <hi rend="italic">am Rande;</hi> cuius inquisitio agitur et <hi rend="italic">im Texte H;</hi> ab hac re <hi rend="italic">statt</hi> de — maleficio <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">de — malef. in the margin; cuius inquisitio agitur et in the text H; ab hac re instead of de — maleficio Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-1.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">sacrilegio <hi rend="italic">darüber Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">sacrilegio above it Vt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-1.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">aut <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">aut Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-1.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">seu <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">seu Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-1.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Punkte unter</hi> et, <hi rend="italic">darüber</hi> ferrum <hi rend="italic">Ci;</hi> ferrum et t. b. s. ma. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">dots under et, and ferrum above it Ci; ferrum et t. b. s. ma. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-1.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Punkte unter</hi> f. <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">dots under f. Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-1.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">uel in h. a. f. <hi rend="italic">fehlt Rj Ch Vt Ci</hi> (<hi rend="italic">obwohl Einschaltungszeichen im Texte Ci</hi>) <hi rend="italic">Ca Tr Co;</hi> uel in h. a. <hi rend="spaced">ignitam</hi> <hi rend="italic">am Rande H</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel in h. a. f. omitted in Rj Ch Vt Ci (although there is an insertion mark in the text in Ci) Ca Tr Co; uel in h. a. <hi rend="italic">ignitam</hi> in the margin in H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-1.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">et t. b. s. <hi rend="italic">fehlt Rj Ch Ci Ca H Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">et t. b. s. omitted in Rj Ch Ci Ca H Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-1.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-um <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-um written above in H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-1.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">benissima <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">benissima Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-1.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-i -nt <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-i -nt written above in H</seg></note>
      </div>
    </body>
