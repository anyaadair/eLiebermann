      <div type="clause" n="9.10a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 9.10a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 9.10a" corresp="#wit-lat"><pb n="555" ed="#liebermann"/>Legis<ptr type="liebermannNote" n="x" target="#Hn_9-10a.lnote.oe.x"/> etiam Anglice trina est<ptr type="liebermannNote" n="43" target="#Hn_9-10a.lnote.oe.43"/> particio, et<ptr type="liebermannNote" n="44" target="#Hn_9-10a.lnote.oe.44"/> ad eandem distantiam; supersunt<ptr type="liebermannNote" n="y" target="#Hn_9-10a.lnote.oe.y"/> regis<ptr type="liebermannNote" n="45" target="#Hn_9-10a.lnote.oe.45"/> placita curie, que usus et consuetudines suas una<ptr type="liebermannNote" n="z" target="#Hn_9-10a.lnote.oe.z"/> semper immobilitate seruat<ptr type="liebermannNote" n="46" target="#Hn_9-10a.lnote.oe.46"/> ubique.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 555 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-10a.lnote.oe.x" n="x" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. o.</hi> 6, 2<hi rend="italic">a</hi>&lt;sup&gt;l&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf. above</hi> 6, 2<hi rend="italic">a</hi>&lt;sup&gt;l&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-10a.lnote.oe.y" n="y" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. o.</hi> 6, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf. above</hi> 6, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-10a.lnote.oe.z" n="z" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">in unveränderlicher Einheit aller Orten [<hi rend="italic">im Gegensatz zur provinciellen Verschiedenheit der Volksrechte</hi>]; <hi rend="italic">diesen Satz schalten</hi> Leges Angl. Lond. coll. <hi rend="italic">ein zu</hi> E Cf. 32 B. 13</seg><seg type="translation" xml:lang="en" source="#claude">in unchanging unity everywhere [<hi rend="italic">in contrast to the provincial diversity of the folk-laws</hi>]; this sentence is inserted by Leges Angl. Lond. coll. into E Cf. 32 B. 13</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-10a.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">p. (partio <hi rend="italic">K Co</hi>) est ad ean. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. (partio <hi rend="italic">K Co</hi>) est ad ean. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-10a.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">est <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">est <hi rend="italic">Sc Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-10a.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">p. r. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. r. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-10a.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">cons. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">cons. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-10a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">317</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Königsgericht 13—<hi rend="italic">parcio</hi>{43} <hi rend="italic">est ad c</hi>.—<hi rend="italic">p. r</hi>.{45}—<hi rend="italic">conseruat</hi>{46} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Königsgericht 13—<hi rend="italic">parcio</hi>{43} <hi rend="italic">est ad c</hi>.—<hi rend="italic">p. r</hi>.{45}—<hi rend="italic">conseruat</hi>{46} Rs</seg></note>
      </div>
