        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-4.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">Pfand für Annahme (Erfüllung) oder Schelte [<hi rend="italic">nicht</hi> für Processverfolgung oder Vertheidigung]</seg><seg type="translation" xml:lang="en" source="#claude">pledge for accepting (fulfilling) or challenging the judgment [<hi rend="italic">not</hi> for prosecuting or defending the suit]</seg></note>
