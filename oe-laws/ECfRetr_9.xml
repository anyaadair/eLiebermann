      <div type="clause" n="9">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 9</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 9"><pb n="633" ed="#liebermann"/><hi rend="spaced">De his<ptr type="liebermannNote" n="11" target="#ECfRetr_9.lnote.la.11"/> qui ad<ptr type="liebermannNote" n="12" target="#ECfRetr_9.lnote.la.12"/> iudicium ferri uel aque iudicati sunt <hi rend="bold">in</hi><ptr type="liebermannNote" n="13" target="#ECfRetr_9.lnote.la.13"/> iusticia regis.</hi> Die<ptr type="liebermannNote" n="14" target="#ECfRetr_9.lnote.la.14"/> illo quo<ptr type="liebermannNote" n="15" target="#ECfRetr_9.lnote.la.15"/> iudicium fieri <hi rend="bold">debet, ueniat illuc</hi> minister<ptr type="liebermannNote" n="16" target="#ECfRetr_9.lnote.la.16"/> episcopi cum clericis suis et <hi rend="bold">similiter</hi> iusticia regis cum legalibus hominibus prouincie illius, <hi rend="bold">qui</hi><ptr type="liebermannNote" n="17" target="#ECfRetr_9.lnote.la.17"/> uideant et audiant, <hi rend="bold">ut</hi> eque<ptr type="liebermannNote" n="18" target="#ECfRetr_9.lnote.la.18"/> omnia fiant.</ab>
        <note type="comparison" source="#liebermann" n="633"><label>printed alongside</label> <ref target="clause:ECf_9">ECf 9</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 633 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">illis <hi rend="italic">Hv Pl S;</hi> iis <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">illis Hv Pl S; iis Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">iud. faciunt, a. uidelicet siue f. calidi <hi rend="italic">Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">iud. faciunt, a. uidelicet siue f. calidi Pl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Cb Dc Lond;</hi> per iusticiam <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Cb Dc Lond; per iusticiam the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">De <hi rend="italic">K Co;</hi> De i. de quo <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">De K Co; De i. de quo Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">qui in iud. <hi rend="italic">Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui in iud. Dc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">episcopus <hi rend="italic">statt</hi> m. e. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">episcopus instead of m. e. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">beginnt Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">Db begins</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">o. e. faciant <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">o. e. faciant Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Of those who have been adjudged to the ordeal of iron or of water in the king's justice. On the day on which the ordeal is to take place, let the bishop's officer come there with his clerics, and likewise the king's justice with the lawful men of that province, to see and hear that all things are done fairly.</ab>
      </div>
    </body>
