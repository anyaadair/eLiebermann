      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 5"><pb n="630" ed="#liebermann"/><hi rend="spaced">De reis ad ecclesiam fugientibus.</hi> Quicumque<ptr type="liebermannNote" n="4" target="#ECfRetr_5.lnote.la.4"/> reus uel noxius ad ecclesiam <hi rend="bold">causa</hi><ptr type="liebermannNote" n="5" target="#ECfRetr_5.lnote.la.5"/> praesidii confugerit, ex quo atrium<ptr type="liebermannNote" n="6" target="#ECfRetr_5.lnote.la.6"/> <hi rend="bold">ecclesie tenuerit,</hi> a<ptr type="liebermannNote" n="7" target="#ECfRetr_5.lnote.la.7"/> nemine insequente <hi rend="bold">nullatenus</hi><ptr type="liebermannNote" n="8" target="#ECfRetr_5.lnote.la.8"/> apprehendatur<ptr type="liebermannNote" n="9" target="#ECfRetr_5.lnote.la.9"/> nisi per pontificem uel ministros<ptr type="liebermannNote" n="11" target="#ECfRetr_5.lnote.la.11"/> eius.</ab>
        <note type="comparison" source="#liebermann" n="630"><label>printed alongside</label> <ref target="clause:ECf_5">ECf 5</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 630 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">There is no note 10 in the ECf retr column of this page: Liebermann’s numbering goes from 9 to 11.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_5.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">Ubicumque <hi rend="italic">Hv Lb Va Ph Kn Cc Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ubicumque Hv Lb Va Ph Kn Cc Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_5.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">p. c. <hi rend="italic">Cb Lb Va Sp Ph Cc</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. c. Cb Lb Va Sp Ph Cc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_5.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">aditum <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">aditum Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_5.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">ab aliquo <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">ab aliquo Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_5.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">ullat. <hi rend="italic">Cb besser</hi></seg><seg type="translation" xml:lang="en" source="#claude">ullat. Cb, better</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_5.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">depr. n. p. p. u. per m. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">depr. n. p. p. u. per m. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_5.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">-trum <hi rend="italic">K Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-trum K Ld</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Of guilty men fleeing to church. Whoever, guilty or culpable, flees to a church for the sake of protection, from the moment he has reached the churchyard of the church, let him by no means be seized by anyone pursuing him, except by the bishop or his officers.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_5.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">344</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ubicumque</hi><hi rend="superscript">4</hi> — <hi rend="italic">p. c.</hi><hi rend="superscript">5</hi> — <hi rend="italic">ullat.</hi><hi rend="superscript">8</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ubicumque</hi><hi rend="superscript">4</hi> — <hi rend="italic">p. c.</hi><hi rend="superscript">5</hi> — <hi rend="italic">ullat.</hi><hi rend="superscript">8</hi> Rs</seg></note>
      </div>
