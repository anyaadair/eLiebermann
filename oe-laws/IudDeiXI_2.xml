      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:IudDeiXI">Iud Dei XI</ref> 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XI 2" corresp="#wit-lat"><pb n="419" ed="#liebermann"/>Benedic<ptr type="liebermannNote" n="5" target="#IudDeiXI_2.lnote.oe.5"/>, Domine, per potencię tuę uirtutem hoc genus metalli, ut in eo propter nomen sanctum tuum, omni demonum falsitate procul remota, omnique fascinatione et fallacia infidelium sublata<ptr type="liebermannNote" n="6" target="#IudDeiXI_2.lnote.oe.6"/>, uerissimi iudicii<ptr type="liebermannNote" n="7" target="#IudDeiXI_2.lnote.oe.7"/> tui fidelibus tuis ueritas patefiat;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 419 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXI_2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">419</biblScope></bibl><seg type="original" xml:lang="de">2—2, 1 = <hi rend="italic">Zeu.</hi> 698 (7); <hi rend="italic">theilweise gleich</hi> IX 1 <hi rend="italic">oben</hi></seg><seg type="translation" xml:lang="en" source="#claude">2—2, 1 = Zeu. 698 (7); partly identical with IX 1 above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXI_2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">419</biblScope></bibl><seg type="original" xml:lang="de">sull. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">sull. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXI_2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">419</biblScope></bibl><seg type="original" xml:lang="de">-itii <hi rend="italic">Ll</hi></seg><seg type="translation" xml:lang="en" source="#claude">-itii Ll</seg></note>
