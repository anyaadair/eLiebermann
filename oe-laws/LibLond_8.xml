      <div type="clause" n="8">
        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 8" corresp="#wit-lat"><ptr type="liebermannNote" n="48" target="#LibLond_8.lnote.oe.48"/><pb n="674" ed="#liebermann"/>Mercator<ptr type="liebermannNote" n="s" target="#LibLond_8.lnote.oe.s"/> itaque<ptr type="liebermannNote" n="49" target="#LibLond_8.lnote.oe.49"/> foranus<ptr type="liebermannNote" n="50" target="#LibLond_8.lnote.oe.50"/> postquam<ptr type="liebermannNote" n="51" target="#LibLond_8.lnote.oe.51"/> ciuitatem introierit, quocumque placuerit ei<ptr type="liebermannNote" n="t" target="#LibLond_8.lnote.oe.t"/>, hospitetur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 674 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">8. 8, 1; 4 <hi rend="italic">ff.</hi> 9. 9, 1 <hi rend="italic">auch in</hi> Cons. 715 <hi rend="italic">f.</hi>, <hi rend="italic">in</hi> Douai <hi rend="italic">und, mit</hi> 8, 2 <hi rend="italic">f.</hi>, <hi rend="italic">Französ. in</hi> Ord</seg><seg type="translation" xml:lang="en" source="#claude">8. 8, 1; 4 ff. 9. 9, 1 also in Cons. 715 f., in Douai and, together with 8, 2 f., in French in Ord</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">in domo ciuis <hi rend="italic">fügt beschränkend hinzu Douai. Vgl.</hi> Lei as Loorengs 501: [Les] humes l’empereur d’Alemaigne . . poent herbergier dedenz les murs de la cité de Lundres la u il voldrunt</seg><seg type="translation" xml:lang="en" source="#claude">Douai adds, as a restriction, in domo ciuis. Cf. Lei as Loorengs 501: [Les] humes l’empereur d’Alemaigne . . poent herbergier dedenz les murs de la cité de Lundres la u il voldrunt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">Item de Londonia <hi rend="italic">überschreibt PlS</hi></seg><seg type="translation" xml:lang="en" source="#claude">PlS has the heading Item de Londonia</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Horn Cons</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Horn Cons</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">-neus <hi rend="italic">Horn Cons Douai;</hi> extraneus <hi rend="italic">Alb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-neus Horn Cons Douai; extraneus Alb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8.lnote.oe.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">ubi uoluerit in ciuitate <hi rend="italic">statt</hi> po.—ei <hi rend="italic">Cons</hi> (<hi rend="italic">ähnliche Stilvarianten in Cons. bemerke ich fortan nicht</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">ubi uoluerit in ciuitate instead of po.—ei Cons (similar stylistic variants in Cons. I shall not note from now on)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. London 37. aff.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. London 37. aff.</seg></note>
      </div>
