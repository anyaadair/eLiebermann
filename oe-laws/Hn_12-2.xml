        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Königsschutz 5b. 8; Rechtssperrung 6—<hi rend="italic">griðbriche</hi>{11}, <hi rend="italic">streb</hi>.—<hi rend="italic">borgb</hi>.{h} zu emendieren ist richtig—<hi rend="italic">flymen</hi>.{16} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Königsschutz 5b. 8; Rechtssperrung 6—<hi rend="italic">griðbriche</hi>{11}, <hi rend="italic">streb</hi>.—the emendation to <hi rend="italic">borgb</hi>.{h} is correct—<hi rend="italic">flymen</hi>.{16} Rs</seg></note>
