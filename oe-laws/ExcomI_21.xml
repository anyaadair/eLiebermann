      <div type="clause" n="21">
        <head><ref type="lawCode" target="law:ExcomI">Excom I</ref> 21</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom I 21" corresp="#wit-ti"><pb n="433" ed="#liebermann"/>Seniori<ptr type="liebermannNote" n="cc" target="#ExcomI_21.lnote.oe.cc"/> etiam eius<ptr type="liebermannNote" n="50" target="#ExcomI_21.lnote.oe.50"/> ipsa excommunicatio debet nota fieri<ptr type="liebermannNote" n="51" target="#ExcomI_21.lnote.oe.51"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 433 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_21.lnote.oe.__1" n="* 1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Responsen vgl.</hi> 13. <hi rend="italic">Ebenso wie</hi> 11, 3 <hi rend="italic">f. lautet</hi> V 7 <hi rend="italic">b, c</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">For the responses cf.</hi> 13. V 7 <hi rend="italic">b, c reads the same as</hi> 11, 3 <hi rend="italic">f.</hi></seg><note type="remark" resp="#claude">marker not found in the text</note></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_21.lnote.oe.__2" n="* 2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vom Buchbinder verschnitten Ti</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cut away by the bookbinder Ti</hi></seg><note type="remark" resp="#claude">marker not found in the text</note></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_21.lnote.oe.__3" n="* 3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 14</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 14</seg><note type="remark" resp="#claude">marker not found in the text</note></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_21.lnote.oe.__4" n="* 4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. o.</hi> 11, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf. above</hi> 11, 2</seg><note type="remark" resp="#claude">marker not found in the text</note></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_21.lnote.oe.cc" n="cc" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Capit. Karolomanni <hi rend="italic">a.</hi> 884, <hi rend="italic">c.</hi> 5 (<hi rend="italic">ed.</hi> Mon. Germ., Leg. s. II, <hi rend="italic">t.</hi> II <hi rend="italic">p.</hi> 373) Excommunicationem debebit episcopus seniori illius notam facere et coepiscopis. <hi rend="italic">Das Wort</hi> senior <hi rend="italic">beweist Fränkischen Ursprung; s. o. S.</hi> 420{a}.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> Capit. Karolomanni <hi rend="italic">a.</hi> 884, <hi rend="italic">c.</hi> 5 (<hi rend="italic">ed.</hi> Mon. Germ., Leg. s. II, <hi rend="italic">t.</hi> II <hi rend="italic">p.</hi> 373) Excommunicationem debebit episcopus seniori illius notam facere et coepiscopis. <hi rend="italic">The word</hi> senior <hi rend="italic">proves Frankish origin; see above p.</hi> 420{a}.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_21.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de">e. i. <hi rend="italic">fehlt Bal</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. i. <hi rend="italic">omitted in Bal</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_21.lnote.oe.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nach</hi> Satisfactio .. anathematizati <hi rend="italic">folgt</hi> Leo (<hi rend="italic">welches Stück in Ti Mart vorangeht</hi>) <hi rend="italic">Vb</hi>.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">after</hi> Satisfactio .. anathematizati <hi rend="italic">there follows</hi> Leo (<hi rend="italic">a piece which comes before it in Ti Mart</hi>) <hi rend="italic">Vb</hi>.</seg></note>
      </div>
