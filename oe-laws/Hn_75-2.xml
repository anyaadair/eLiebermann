      <div type="clause" n="75.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 75.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 75.2" corresp="#wit-lat"><pb n="592" ed="#liebermann"/>Quisquis itaque de morte<ptr type="liebermannNote" n="c" target="#Hn_75-2.lnote.oe.c"/> domini sui per<ptr type="liebermannNote" n="3" target="#Hn_75-2.lnote.oe.3"/> se uel per<ptr type="liebermannNote" n="4" target="#Hn_75-2.lnote.oe.4"/> susceptam uel<ptr type="liebermannNote" n="5" target="#Hn_75-2.lnote.oe.5"/> suspectam personam aliqua rerum accione uel subintroduccione tractabit, uite sue culpa<ptr type="liebermannNote" n="d" target="#Hn_75-2.lnote.oe.d"/> sit et omnium que habebit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 592 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-2.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 43, 7</seg><seg type="translation" xml:lang="en" source="#claude">cf. 43, 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-2.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Af</hi> 4, 2?</seg><seg type="translation" xml:lang="en" source="#claude">from Af 4, 2?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de">pro <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">pro Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
