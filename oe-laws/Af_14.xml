      <div type="clause" n="14">
        <head><ref type="lawCode" target="law:Af">Af</ref> 14</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="14" corresp="#wit-e"><pb n="58" ed="#liebermann"/>XIIII. Gif mon sie<ptr type="liebermannNote" n="1" target="#Af_14.lnote.oe.1"/> dumb oððe déaf<ptr type="liebermannNote" n="2" target="#Af_14.lnote.oe.2"/> geboren, þæt he<ptr type="liebermannNote" n="3" target="#Af_14.lnote.oe.3"/> ne mæge<ptr type="liebermannNote" n="*" target="#Af_14.lnote.oe.star"/> synna onsecggan<ptr type="liebermannNote" n="4" target="#Af_14.lnote.oe.4"/> ne geandettan<ptr type="liebermannNote" n="5" target="#Af_14.lnote.oe.5"/>, bete se fæder his misdæda.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="14" corresp="#wit-h"><pb n="58" ed="#liebermann"/>XIIII. Gif mon<ptr type="liebermannNote" n="1" target="#Af_14.lnote.oe.1-2"/> sy<ptr type="liebermannNote" n="2" target="#Af_14.lnote.oe.2-2"/> dumb oððe deaf geboren, ðæt he ne mæge synne onsæcgan<ptr type="liebermannNote" n="3" target="#Af_14.lnote.oe.3-2"/> ne geondettan<ptr type="liebermannNote" n="1" target="#Af_14.lnote.oe.1-2"/>, bete se fæder his misdæda.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="14" corresp="#wit-b-no-prol"><pb n="58" ed="#liebermann"/>Be du<hi rend="italic">m</hi>bra manna dædu<hi rend="italic">m</hi>. Gyf mon sy dumb oððe deaf <hi rend="italic">ge</hi>boren, þ<hi rend="italic">æt</hi> he ne mæge his synna <hi rend="italic">ge</hi>andettan ne ætsacan, bete se fæder his misdǽda.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="14" corresp="#wit-q"><pb n="59" ed="#liebermann"/>Si quis surdus sit<ptr type="liebermannNote" n="1" target="#Af_14.lnote.oe.1-3"/> aut mutus natus, ut<ptr type="liebermannNote" n="2" target="#Af_14.lnote.oe.2-3"/> non possit peccata<ptr type="liebermannNote" n="3" target="#Af_14.lnote.oe.3-3"/> sua negare<ptr type="liebermannNote" n="4" target="#Af_14.lnote.oe.4-2"/> uel confiteri, emendet pater eius forisfacta sua.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="70" ed="#attenborough"/>[Be dumbra manna dædum.] Gif mon sie dumb oððe déaf geboren, þæt he ne mæge [his]<ptr type="editorNote" n="24" target="#Af_14.attnote.fn.24"/> synna<ptr type="editorNote" n="25" target="#Af_14.attnote.fn.25"/> onsecggan<ptr type="editorNote" n="26" target="#Af_14.attnote.fn.26"/> ne geandettan, bete se fæder his misdæda.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="16" corresp="#wit-e"><pb n="310" ed="#jurasinski-and-oliver"/>{XIIII} Gif mon sie dumb oððe déaf geboren, þæt he ne mæge synna onsecggan ne geandettan, bete se fæder his misdæda.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="59" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_14.lnote.de.1"/> ein Mensch stumm oder<ptr type="liebermannNote" n="2" target="#Af_14.lnote.de.2"/> taub geboren ist, so dass er Beschuldigungen weder abzuleugnen noch zu bekennen vermag, so büsse der Vater<ptr type="liebermannNote" n="3" target="#Af_14.lnote.de.3"/> dessen Missethaten.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a person is born dumb or deaf, so that he can neither deny nor confess accusations, let the father make amends for his misdeeds.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="71" ed="#attenborough"/>If anyone is born dumb or<ptr type="editorNote" n="1" target="#Af_14.attnote.n.1"/> deaf, so that he can neither deny nor confess his wrongdoings, his father shall pay compensation for his misdeeds.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="412" ed="#whitelock"/>If anyone is born dumb, or deaf, so that he cannot deny sins or confess them, the father is to pay compensation for his misdeeds.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="311" ed="#jurasinski-and-oliver"/>If a person is born dumb or deaf, so that he cannot deny nor confess his offenses, let the father compensate for his misdeeds.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_14.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">58</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_14.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">58</biblScope></bibl><seg type="original" xml:lang="de">deafe <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">deafe So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_14.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">58</biblScope></bibl><seg type="original" xml:lang="de">hene <hi rend="italic">geänd. aus</hi> hine <hi rend="italic">E</hi></seg><seg type="translation" xml:lang="en" source="#claude">hene altered from hine E</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_14.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">58</biblScope></bibl><seg type="original" xml:lang="de">his <hi rend="italic">fügt zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">his added by Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_14.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">58</biblScope></bibl><seg type="original" xml:lang="de">onsæcgan <hi rend="italic">So;</hi> geond. ne onsecgan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">onsæcgan So; geond. ne onsecgan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_14.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">58</biblScope></bibl><seg type="original" xml:lang="de">geond. <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">geond. So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_14.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">58</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geändert in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_14.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">58</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_14.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">58</biblScope></bibl><seg type="original" xml:lang="de">æ <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">æ on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_14.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">59</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond;</hi> aut sit <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond; aut sit Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_14.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">59</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_14.lnote.oe.3-3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">59</biblScope></bibl><seg type="original" xml:lang="de">neg. vel c. p. sua <hi rend="italic">Hk Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">neg. vel c. p. sua Hk Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_14.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">59</biblScope></bibl><seg type="original" xml:lang="de">c. v. n. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. v. n. Lond</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_14.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">54</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Hn 78, 6, Q ausschreibend, versteht richtig ‘taubstumm’; vór Taubstummenlehre blieb jedes taube Kind auch stumm. <hi rend="italic">Geboren stum</hi> bed. auch im Sachsenspiegel I 4: ‘taubstumm’. <hi rend="italic">Vgl. Gl</hi> Taubheit 2</seg><seg type="translation" xml:lang="en" source="#claude">Hn 78, 6, copying Q, rightly understands ‘deaf and dumb’; before the teaching of the deaf and dumb, every deaf child remained dumb as well. <hi rend="italic">Geboren stum</hi> also means ‘deaf and dumb’ in the Sachsenspiegel I 4. <hi rend="italic">Cf. Gl</hi> Taubheit 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_14.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">54</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘oder’ wie mlat. <hi rend="italic">vel</hi> = ‘und’. — B modernisiert <hi rend="italic">ætsacan</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘or’, like Med. Lat. <hi rend="italic">vel</hi>, = ‘and’. — B modernises <hi rend="italic">ætsacan</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_14.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">54</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> mündig 17</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> mündig 17</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_14.attnote.fn.24" n="24" source="#attenborough"><bibl><biblScope unit="page">70</biblScope></bibl><label>his</label><seg type="original" xml:lang="en">B, Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_14.attnote.fn.25" n="25" source="#attenborough"><bibl><biblScope unit="page">70</biblScope></bibl><label>synna</label><seg type="original" xml:lang="en"><hi rend="italic">synne</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_14.attnote.fn.26" n="26" source="#attenborough"><bibl><biblScope unit="page">70</biblScope></bibl><label>onsecggan</label><seg type="original" xml:lang="en"><hi rend="italic">ætsacan</hi>. B.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_14.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">195</biblScope></bibl><seg type="original" xml:lang="en">According to Liebermann, <hi rend="italic">oððe</hi> should be translated ‘and.’</seg></note>
      </div>
