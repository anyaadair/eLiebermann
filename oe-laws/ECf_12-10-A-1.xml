    <body>
      <div type="clause" n="12.10 A 1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 12.10 A 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 12.10 A 1"><pb n="639" ed="#liebermann"/>Et<ptr type="liebermannNote" n="3" target="#ECf_12-10-A-1.lnote.la.3"/> qui modo dicuntur comites<ptr type="liebermannNote" n="4" target="#ECf_12-10-A-1.lnote.la.4"/>, qui tercium denarium<ptr type="liebermannNote" n="k" target="#ECf_12-10-A-1.lnote.la.fn.k"/> super forisfacturam habent, tunc temporis consules<ptr type="liebermannNote" n="l" target="#ECf_12-10-A-1.lnote.la.fn.l"/> uocabantur.</ab>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 639 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">This passage is not part of ECf or ECf retr: it is one of the additions of the London collection (Leges Anglorum s. XIII in. Londoniis collectae), which Liebermann prints in smaller type across the page, under ECf retr. 12, 10, and numbers 12, 10 A ff. The dictionary cites it as “ECf 12, 10 A …”, so it is kept with ECf here.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_12-10-A-1.lnote.la.fn.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus</hi> ECf. 27, 2<hi rend="italic">h</hi></seg><seg type="translation" xml:lang="en" source="#claude">from ECf. 27, 2, note h</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_12-10-A-1.lnote.la.fn.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus</hi> ECf. retr. 32</seg><seg type="translation" xml:lang="en" source="#claude">from ECf. retr. 32</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-10-A-1.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">12, 10 A 1 <hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">12, 10 A 1 lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-10-A-1.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">comitates <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">comitates K</seg></note>
