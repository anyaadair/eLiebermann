      <div type="clause" n="12">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 12</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="12" corresp="#wit-e"><pb n="94" ed="#liebermann"/>LVI.<ptr type="liebermannNote" n="*" target="#Ine_12.lnote.oe.star-2"/> Gif ðeof sie<ptr type="liebermannNote" n="10" target="#Ine_12.lnote.oe.10"/> gefongen, swelte<ptr type="liebermannNote" n="11" target="#Ine_12.lnote.oe.11"/> he deaðe, oððe his lif be his were man<ptr type="liebermannNote" n="12" target="#Ine_12.lnote.oe.12"/> aliese.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="12" corresp="#wit-bu"><pb n="94" ed="#liebermann"/>LVI. . . . sie gefongen, swelte he deaðe, oððe . . . be his were monn<ptr type="liebermannNote" n="1" target="#Ine_12.lnote.oe.1"/> aliese.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="12" corresp="#wit-h"><pb n="94" ed="#liebermann"/>LVI. Gif þeof sy<ptr type="liebermannNote" n="5" target="#Ine_12.lnote.oe.5"/> gefongen<ptr type="liebermannNote" n="1" target="#Ine_12.lnote.oe.1-2"/>, swylte<ptr type="liebermannNote" n="5" target="#Ine_12.lnote.oe.5"/> he deaðe oþþe his lif be his were alyse.<ptr type="liebermannNote" n="5" target="#Ine_12.lnote.oe.5"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="12" corresp="#wit-b-no-prol"><pb n="95" ed="#liebermann"/>Be gefangenu<hi rend="italic">m</hi> ðeofu<hi rend="italic">m</hi>. Gyf ðeof sy gefongen, swylte he deaðe, oððe his lif be his were mon alyse.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="12" corresp="#wit-q"><pb n="95" ed="#liebermann"/>Si<ptr type="liebermannNote" n="*" target="#Ine_12.lnote.oe.star"/> fur capiatur, mortem<ptr type="liebermannNote" n="14" target="#Ine_12.lnote.oe.14"/> patiatur uel<ptr type="liebermannNote" n="15" target="#Ine_12.lnote.oe.15"/> uitam suam weregildo suo<ptr type="liebermannNote" n="16" target="#Ine_12.lnote.oe.16"/> redimat.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="40" ed="#attenborough"/>[Be gefangenum ðeofum.] Gif ðeof sie gefongen, swelte he deaðe, oððe his lif be his were man aliese.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="12" corresp="#wit-e"><pb n="378" ed="#jurasinski-and-oliver"/>{LVI} Gif ðeof sie gefongen, swelte he deaðe, oððe his lif be his were man aliese.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="95" ed="#liebermann"/>Wenn ein Dieb [handhaft<ptr type="liebermannNote" n="1" target="#Ine_12.lnote.de.1"/>] gefangen wird, erleide er den Tod, oder man löse sein Leben durch sein Wergeld aus.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a thief is caught [red-handed], let him suffer death, or let his life be redeemed by his wergeld.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="41" ed="#attenborough"/>If a thief is taken<ptr type="editorNote" n="1" target="#Ine_12.attnote.n.1"/> he shall die the death, or his life shall be redeemed by the payment of his wergeld.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="401" ed="#whitelock"/>If a thief is caught [in the act], he is to die the death, or his life is to be redeemed by his wergild.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="379" ed="#jurasinski-and-oliver"/>If a thief is caught, let him suffer death, or his life can be redeemed by [payment of] his wergild.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:App-AGu_2">App AGu 2</ref></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="379"><label>cf.</label> <ref target="clause:Wi_26">Wi 26</ref> <quote>Wihtred §21 [L26] allows three options: death, redemption by monetary payment, and sale over the sea.</quote></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="379"><label>prohibits (contrast)</label> <ref target="clause:Ine_11">Ine 11</ref> <quote>But Ine §11 prohibits the last for the kingdom of the West Saxons.</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="102"><label>textual borrowings</label> <ref target="clause:Wi_25">Wi 25–28</ref> <quote>finishes with a set of clauses on the killing or capture of thieves with no obvious rationale in this setting save as textual borrowings from Ine</quote></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="49"><label>echoes (per Wormald; doubted)</label> <ref target="clause:Wi_25">Wi 25</ref> <quote>How Ine §12 and Wihtred §20 [L25] entered this list is unclear, as they seem at odds with one another and show no similarities in phrasing.</quote></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="394"><label>cf.</label> <ref target="clause:Ine_28">Ine 28</ref> <quote>Hapax legomenon. Cf. §12.</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_12.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">95</biblScope></bibl><seg type="original" xml:lang="de">Si fur c., m. patiatur <hi rend="italic">auch App. A Gu.</hi> (<hi rend="italic">s. o. S.</hi> 93*) 2.</seg><seg type="translation" xml:lang="en" source="#claude">Si fur c., m. patiatur also App. A Gu. (see above p. 93*) 2.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_12.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">95</biblScope></bibl><seg type="original" xml:lang="de">m. p. <hi rend="italic">fehlt Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">m. p. lacking in Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_12.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">95</biblScope></bibl><seg type="original" xml:lang="de">aut <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">aut Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_12.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">95</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_12.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">94</biblScope></bibl><seg type="original" xml:lang="de">monna l. <hi rend="italic">oder</hi> læse <hi rend="italic">Bu</hi></seg><seg type="translation" xml:lang="en" source="#claude">monna l. or læse Bu</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_12.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">94</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_12.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">94</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_12.lnote.oe.star-2" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">94</biblScope></bibl><seg type="original" xml:lang="de">12 <hi rend="italic">setzt hinter</hi> 13 <hi rend="italic">und vereint mit</hi> 13, 1 <hi rend="italic">zu einem Capitel Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ld places 12 after 13 and combines it with 13, 1 into one chapter</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_12.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">94</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_12.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">94</biblScope></bibl><seg type="original" xml:lang="de">swelt <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">swelt Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_12.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">94</biblScope></bibl><seg type="original" xml:lang="de">mon alyse <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mon alyse Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_12.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">70</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Wergeld 29; handhaft 13; Diebstahl 12; busslos 5C; Todesstrafe 3h</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Wergeld 29; handhaft 13; Diebstahl 12; busslos 5C; Todesstrafe 3h</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_12.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">184</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e.</hi> taken in the act (cf. note 1 to cap. 7 above).</seg></note>
      </div>
