        <note type="liebermannNote" subtype="textual" xml:id="Hn_20.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">319</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Justizertrag 8.—<hi rend="italic">De socna ohne</hi> et{8} et t.—20, 1 <hi rend="italic">vero</hi>{9} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Justizertrag 8.—<hi rend="italic">De socna</hi> without et{8} et t.—20, 1 <hi rend="italic">vero</hi>{9} Rs</seg></note>
