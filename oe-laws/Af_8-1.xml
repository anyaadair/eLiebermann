      <div type="clause" n="8.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 8.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8.1" corresp="#wit-e"><pb n="54" ed="#liebermann"/>Gif hio<ptr type="liebermannNote" n="15" target="#Af_8-1.lnote.oe.15"/> leng libbe<ptr type="liebermannNote" n="16" target="#Af_8-1.lnote.oe.16"/> ðonne se ðe hie<ptr type="liebermannNote" n="17" target="#Af_8-1.lnote.oe.17"/> utlædde<ptr type="liebermannNote" n="18" target="#Af_8-1.lnote.oe.18"/>, nage hio<ptr type="liebermannNote" n="15" target="#Af_8-1.lnote.oe.15"/> his<ptr type="liebermannNote" n="19" target="#Af_8-1.lnote.oe.19"/> ierfes<ptr type="liebermannNote" n="20" target="#Af_8-1.lnote.oe.20"/> owiht.<ptr type="liebermannNote" n="21" target="#Af_8-1.lnote.oe.21"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8.1" corresp="#wit-h"><pb n="54" ed="#liebermann"/>Gif heo<ptr type="liebermannNote" n="8" target="#Af_8-1.lnote.oe.8"/> leng libbe ðonne se<ptr type="liebermannNote" n="9" target="#Af_8-1.lnote.oe.9"/> þe<ptr type="liebermannNote" n="2" target="#Af_8-1.lnote.oe.2"/> heo<ptr type="liebermannNote" n="8" target="#Af_8-1.lnote.oe.8"/> útlædde, nage heo<ptr type="liebermannNote" n="8" target="#Af_8-1.lnote.oe.8"/> his yrfes awuht.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8.1" corresp="#wit-b-no-prol"><pb n="55" ed="#liebermann"/>Gyf heo leng libbe þonne se ðe héo utlæde, nage heo yrfes<ptr type="liebermannNote" n="2" target="#Af_8-1.lnote.oe.2-2"/> nawiht.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="8.1" corresp="#wit-q"><pb n="55" ed="#liebermann"/>Si ipsa diutius uiuat quam<ptr type="liebermannNote" n="6" target="#Af_8-1.lnote.oe.6"/> qui eam abduxit, nichil de pecunia eius habeat.<ptr type="liebermannNote" n="7" target="#Af_8-1.lnote.oe.7"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="68" ed="#attenborough"/>Gif hio leng libbe ðonne se ðe hie utlædde, nage hio his ierfes owiht<ptr type="editorNote" n="14" target="#Af_8-1.attnote.fn.14"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="9.1" corresp="#wit-e"><pb n="302" ed="#jurasinski-and-oliver"/>Gif hio leng libbe ðonne se ðe hie utlædde, nage hio his ierfes owiht.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="55" ed="#liebermann"/>Falls sie länger lebt als er, der sie entführt hat, erhalte sie nichts von seinem Erbe.<ptr type="liebermannNote" n="1" target="#Af_8-1.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If she lives longer than he who abducted her, let her receive nothing of his estate.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="69" ed="#attenborough"/>If she lives longer than he who abducted her, she shall inherit nothing of his property.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="411" ed="#whitelock"/>If she outlives him who brought her out, she is to have nothing of his inheritance.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="303" ed="#jurasinski-and-oliver"/>If she outlives the man who took her out, she does not own any of his inheritance.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">heo <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">heo Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">lybbe <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">lybbe So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">hi <hi rend="italic">So;</hi> heo <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hi So; heo Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">utlæde <hi rend="italic">Ld;</hi> utalædde <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">utlæde Ld; utalædde So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">yr. <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">yr. So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">nawiht <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">nawiht Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rasur zwischen</hi> s <hi rend="italic">und</hi> e</seg><seg type="translation" xml:lang="en" source="#claude">erasure between s and e</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">55</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">55</biblScope></bibl><seg type="original" xml:lang="de">sicut <hi rend="italic">fügt zu Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">sicut added by Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">55</biblScope></bibl><seg type="original" xml:lang="de">yrfer</seg><seg type="translation" xml:lang="en" source="#claude">yrfer</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_8-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘Fahrnis’ zu eng Q; <hi rend="italic">vgl. Gl</hi> Nonne 10a; eheliches Güterrecht 3e</seg><seg type="translation" xml:lang="en" source="#claude">‘movables’ Q, too narrow; <hi rend="italic">cf. Gl</hi> Nonne 10a; eheliches Güterrecht 3e</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_8-1.attnote.fn.14" n="14" source="#attenborough"><bibl><biblScope unit="page">68</biblScope></bibl><label>owiht</label><seg type="original" xml:lang="en"><hi rend="italic">awuht</hi>. H. <hi rend="italic">heo yrfer nawiht</hi>. B.</seg></note>
      </div>
