        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-4.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">= 23, 2; <hi rend="italic">Gegensatz:</hi> 37, 2&lt;sup&gt;<hi rend="italic">b.d</hi>&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude">= 23, 2; contrast: 37, 2&lt;sup&gt;<hi rend="italic">b.d</hi>&lt;/sup&gt;</seg></note>
