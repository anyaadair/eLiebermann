      <div type="clause" n="82.9a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 82.9a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 82.9a" corresp="#wit-lat"><pb n="599" ed="#liebermann"/>Pensandum autem est per uisum accusantibus, uisum concubitus<ptr type="liebermannNote" n="30" target="#Hn_82-9a.lnote.oe.30"/> propensius aduertendum, ut scilicet ipsas coeuntium naturas<ptr type="liebermannNote" n="h" target="#Hn_82-9a.lnote.oe.h"/> uiderint<ptr type="liebermannNote" n="31" target="#Hn_82-9a.lnote.oe.31"/> commisceri.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 599 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-9a.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">Geschlechtsglieder <hi rend="italic">DUCANGE, dies anführend</hi></seg><seg type="translation" xml:lang="en" source="#claude">genitals, Ducange, citing this passage</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-9a.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">-tum <hi rend="italic">empfiehlt Tho</hi> [<hi rend="italic">unnöthig</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">Tho recommends -tum [unnecessary]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-9a.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">-rit <hi rend="italic">K Sl Tw</hi>; uident <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rit K Sl Tw; uident Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-9a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Zeugen 7a—am Rande spät: <hi rend="italic">Nota: restat testimonio perhibendum inter coeuntes</hi>—<hi rend="italic">uiderit</hi>{31}—83 <hi rend="italic">Q. cuique l</hi>.{33} <hi rend="italic">in neg. se d. p. c. d</hi>. ohne <hi rend="italic">suum</hi>{36} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Zeugen 7a—in the margin, in a late hand: <hi rend="italic">Nota: restat testimonio perhibendum inter coeuntes</hi>—<hi rend="italic">uiderit</hi>{31}—83 <hi rend="italic">Q. cuique l</hi>.{33} <hi rend="italic">in neg. se d. p. c. d</hi>. without <hi rend="italic">suum</hi>{36} Rs</seg></note>
