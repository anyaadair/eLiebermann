    <body>
      <div type="clause" n="5.1">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 5.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-hk"><pb n="496–497" ed="#liebermann"/>e pur [un<ptr type="liebermannNote" n="2" target="#LeisWl_5-1.lnote.oe.2"/>] por[c] I den. e pur I berbiz I den. e issi tresque a VIII pur chascune I den.; ne ja tant n’i averad, ne durrad que VIII den.;</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-i"><pb n="496–497" ed="#liebermann"/>e pur un porc [un<ptr type="liebermannNote" n="25" target="#LeisWl_5-1.lnote.oe.25"/>] den.<ptr type="liebermannNote" n="23" target="#LeisWl_5-1.lnote.oe.23"/> e pur un berbiz<ptr type="liebermannNote" n="17" target="#LeisWl_5-1.lnote.oe.17"/> I den.<ptr type="liebermannNote" n="23" target="#LeisWl_5-1.lnote.oe.23"/> e isi<ptr type="liebermannNote" n="26" target="#LeisWl_5-1.lnote.oe.26"/> tresque uit pur chascun [un<ptr type="liebermannNote" n="25" target="#LeisWl_5-1.lnote.oe.25"/>] den.<ptr type="liebermannNote" n="23" target="#LeisWl_5-1.lnote.oe.23"/>; ne<ptr type="liebermannNote" n="27" target="#LeisWl_5-1.lnote.oe.27"/> ja tant n’i<ptr type="liebermannNote" n="28" target="#LeisWl_5-1.lnote.oe.28"/> avrad, ne durrad que oit d’.<ptr type="liebermannNote" n="23" target="#LeisWl_5-1.lnote.oe.23"/>;</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="496–497" ed="#liebermann"/>pro oue denarium, pro porco II<ptr type="liebermannNote" n="f" target="#LeisWl_5-1.lnote.oe.f"/> den., pro boue uel equo IIII d.; ita tamen ut ultra VIII denar. non tribuat, quotquot aueria sibi restitui pecierit.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="5.1" corresp="#wit-hk"><pb n="256" ed="#robertson"/>e pur [un] por[c] I den., e pur I berbiz I den., e issi tresque a VIII, pur chascune I den., ne ja tant n'i averad ne durrad que VIII den.;</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="496–497" ed="#liebermann"/>5, 1. und für 1 Schwein 1 Pfennig und für 1 Schaf<ptr type="liebermannNote" n="g" target="#LeisWl_5-1.lnote.de1.g"/> 1 Pfennig (für Ochs oder Pferd 4 Pfennig <hi rend="italic">L</hi>) und so [weiter] bis auf 8 für jedes 1 Pfennig; mag dabei ihrer noch so viel sein, er braucht nur 8 Pfennig zu geben</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">5, 1. and for 1 pig 1 penny and for 1 sheep 1 penny (for ox or horse 4 pennies <hi rend="italic">L</hi>) and so [on] up to 8, for each 1 penny; however many of them there be, he need only give 8 pennies</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-hk"><pb n="257" ed="#robertson"/>And for a pig, 1 penny, and for a sheep, 1 penny, and so on up to 8, for each 1 penny; however many there are, he shall not give more than 8 pence.</ab>
        <note type="comparison" source="#liebermann" n="497"><ref target="clause:LeisWl_5">Leis Wl 5</ref></note>
        <note type="comparisonPrinted" source="#liebermann">vgl. o. 5</note>
        <note type="editorial">Added October 2026 from Robertson pp. 256–257 (text and translation); Liebermann’s text and German translation added from Gesetze I p. 496–497, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_5-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">496</biblScope></bibl><seg type="original" xml:lang="de">IIII pors <hi rend="italic">Hk; gebessert aus IL</hi></seg><seg type="translation" xml:lang="en" source="#claude">IIII pors Hk; corrected from IL</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_5-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">496</biblScope></bibl><seg type="original" xml:lang="de">berbz <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">berbz Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_5-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">496</biblScope></bibl><seg type="original" xml:lang="de">d. <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. Im</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_5-1.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">496</biblScope></bibl><seg type="original" xml:lang="de">IIII <hi rend="italic">I</hi></seg><seg type="translation" xml:lang="en" source="#claude">IIII I</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_5-1.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">496</biblScope></bibl><seg type="original" xml:lang="de">isistre que <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">isistre que Im</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_5-1.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">496</biblScope></bibl><seg type="original" xml:lang="de">de <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">de Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_5-1.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">496</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">in Im</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_5-1.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">497</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Schreibfehler</hi> (<hi rend="italic">aus</hi> ū, <hi rend="italic">d. i.</hi> unum?) <hi rend="italic">oder, wie das Folgende, absichtliches Abweichen von</hi> Leis. <hi rend="italic">Für ein Pferd fordert</hi> 15 <hi rend="italic">Pfennig</hi> Forfang <hi rend="italic">o. S.</hi> 391</seg><seg type="translation" xml:lang="en" source="#claude">Scribal error (from ū, i.e. unum?) or, like what follows, deliberate departure from Leis. For a horse Forfang above p. 391 demands 15 pence</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="LeisWl_5-1.lnote.de1.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">497</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur dies wie</hi> Forfang 3, 1</seg><seg type="translation" xml:lang="en" source="#claude">only this, as in Forfang 3, 1</seg></note>
      </div>
    </body>
