  <text>
    <body>
      <div type="clause" n="24">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 24</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="24" corresp="#wit-h"><pb n="4" ed="#liebermann"/>Gif man frigne man gebindeþ<ptr type="liebermannNote" n="4" target="#Abt_24.lnote.oe.4"/>, XX scill' gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-h"><pb n="6" ed="#attenborough"/>Gif man frigne man gebindeþ<ptr type="editorNote" n="1" target="#Abt_24.attnote.fn.1"/>, XX scill' gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="25" corresp="#wit-h"><pb n="66" ed="#oliver"/>Gif man frigne man geb[inde]þ,<ptr type="editorNote" n="f" target="#Abt_24.olinote.fn.f"/> XX scilƚ gebete.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="4" ed="#liebermann"/>Wenn jemand einen freien Mann bindet<ptr type="liebermannNote" n="1" target="#Abt_24.lnote.de.1"/>, büsse er [ihm] 20 Schilling.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone binds a free man, let him pay [him] 20 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="7" ed="#attenborough"/>If a man lays bonds on a freeman, he shall pay 20 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h"><pb n="392" ed="#whitelock"/>If anyone binds a free man, he is to pay 20 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h"><pb n="67" ed="#oliver"/>If a person binds a freeman, let him pay [with] 20 shillings.</ab>
        <note type="comparedBy" source="#wormald-mel" n="281"><ref target="clause:Af_35">Af 35–35.6</ref></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="329"><ref target="clause:Af_35">Af 35</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="359"><ref target="clause:IICn_60">II Cn 60</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Abt_24.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">4</biblScope></bibl><seg type="original" xml:lang="de">nd <hi rend="italic">theilweise durchlöchert</hi></seg><seg type="translation" xml:lang="en" source="#claude">nd partly holed</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_24.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">8</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Binden 1aff. Hier ist wohl wie in der Bewaffnung des Gegners <hi rend="italic">o.</hi> 18ff. an gemeinschaftliche (<hi rend="italic">s. d. Gl</hi>) Missetat gedacht</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Binden 1aff. Here, as with the arming of the opponent <hi rend="italic">above</hi> 18ff., a joint (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi>) offence is probably in view</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Abt_24.attnote.fn.1" n="1" source="#attenborough"><bibl><biblScope unit="page">6</biblScope></bibl><label>gebindeþ</label><seg type="original" xml:lang="en">em. Hickes. <hi rend="italic">gebi...eð</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Abt_24.olinote.fn.f" n="f" source="#oliver"><bibl><biblScope unit="page">66</biblScope></bibl><label>geb[inde]þ,</label><seg type="original" xml:lang="en">Thus restored by Liebermann, presumably on the model of §81. The lower part of all characters is still visible.</seg></note>
      </div>
    </body>
