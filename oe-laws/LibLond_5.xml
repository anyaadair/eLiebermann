    <body>
      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 5" corresp="#wit-lat"><ptr type="liebermannNote" n="14" target="#LibLond_5.lnote.oe.14"/><pb n="674" ed="#liebermann"/>Ciuis<ptr type="liebermannNote" n="15" target="#LibLond_5.lnote.oe.15"/> iterum<ptr type="liebermannNote" n="16" target="#LibLond_5.lnote.oe.16"/> si<ptr type="liebermannNote" n="17" target="#LibLond_5.lnote.oe.17"/> ad folches-imot<ptr type="liebermannNote" n="18" target="#LibLond_5.lnote.oe.18"/> uel ad husting<ptr type="liebermannNote" n="19" target="#LibLond_5.lnote.oe.19"/> sine inuitatione placitandi<ptr type="liebermannNote" n="20" target="#LibLond_5.lnote.oe.20"/> uenerit, non habet<ptr type="liebermannNote" n="f" target="#LibLond_5.lnote.oe.f"/> ibi alicui de qualibet querela respondere nisi gratis<ptr type="liebermannNote" n="21" target="#LibLond_5.lnote.oe.21"/> uoluerit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 674 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_5.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">braucht. <hi rend="italic">Vgl.</hi> Hn 46, 2. 48, 1. 50, 3</seg><seg type="translation" xml:lang="en" source="#claude">need. Cf. Hn 46, 2. 48, 1. 50, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_5.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">Item de Lond(oniensibus <hi rend="italic">Pl</hi>) <hi rend="italic">überschr. Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">Item de Lond(oniensibus Pl) as heading Pl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_5.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">Siues <hi rend="italic">Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">Siues Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_5.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">London. <hi rend="italic">statt</hi> it. <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">London. instead of it. Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_5.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co;</hi> ad f. u. ad h. si <hi rend="italic">Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Co; ad f. u. ad h. si Pl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_5.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">folkysmot <hi rend="italic">Horn;</hi> folkesmot <hi rend="italic">Co;</hi> folkemot (-th <hi rend="italic">S</hi>) <hi rend="italic">PlS;</hi> curiam <hi rend="italic">Alb</hi></seg><seg type="translation" xml:lang="en" source="#claude">folkysmot Horn; folkesmot Co; folkemot (-th S) PlS; curiam Alb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_5.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">-teng <hi rend="italic">PlS;</hi> -tengum <hi rend="italic">Co Horn Alb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-teng PlS; -tengum Co Horn Alb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_5.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">euenerit pl. <hi rend="italic">Pl;</hi> non summonitus <hi rend="italic">fügt zu Alb</hi></seg><seg type="translation" xml:lang="en" source="#claude">euenerit pl. Pl; non summonitus added by Alb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_5.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Pl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_5.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. London 24. 25; Husting 3; Vorladung 5a; Klage 14aff.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. London 24. 25; Husting 3; Vorladung 5a; Klage 14aff.</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">Again, if a citizen comes to the <hi rend="italic">folches-imot</hi> (folkmoot) or to the husting without a summons to plead, he need not answer anyone there on any complaint, unless he freely wishes to.</ab>
      </div>
    </body>
