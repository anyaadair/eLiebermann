        <note type="liebermannNote" subtype="textual" xml:id="Af_10.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_10.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">And þ<hi rend="italic">æt</hi> sy on cwycæhtum feogodum, ⁊ mon nænigne mon on þ<hi rend="italic">æt</hi> ne sylle <hi rend="italic">fügt Ld hier statt hinter</hi> 18, 1 <hi rend="italic">zu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">And þ<hi rend="italic">æt</hi> sy on cwycæhtum feogodum, ⁊ mon nænigne mon on þ<hi rend="italic">æt</hi> ne sylle added by Ld here instead of after 18, 1.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_10.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
