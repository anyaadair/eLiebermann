    <body>
      <div type="clause" n="30.3">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 30.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="30.3" corresp="#wit-g-a"><pb n="332" ed="#liebermann"/>And gif heo<ptr type="liebermannNote" n="13" target="#IICn_30-3.lnote.oe.13"/> þone að syllan ne durren<ptr type="liebermannNote" n="14" target="#IICn_30-3.lnote.oe.14"/>, gange he to þam þryfealdan ordale.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="30.3" corresp="#wit-b"><pb n="332" ed="#liebermann"/>Be ordale. ⁊ gyf hi ðonne<ptr type="liebermannNote" n="2" target="#IICn_30-3.lnote.oe.2"/> að syllan ne durran, gange he to ðam ðrifealdan ordale.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="30.3" corresp="#wit-a"><pb n="332" ed="#liebermann"/>⁊ gif hig þonne<ptr type="liebermannNote" n="1" target="#IICn_30-3.lnote.oe.1"/> að syllan ne durren, gange he to þan þryfea[l]dan<ptr type="liebermannNote" n="3" target="#IICn_30-3.lnote.oe.3"/> ordale.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="30.3" corresp="#wit-q"><pb n="333" ed="#liebermann"/>Et si iurare non<ptr type="liebermannNote" n="4" target="#IICn_30-3.lnote.oe.4"/> audeant<ptr type="liebermannNote" n="5" target="#IICn_30-3.lnote.oe.5"/>, eat ad triplex ordalium (id<ptr type="liebermannNote" n="6" target="#IICn_30-3.lnote.oe.6"/> est iudicium uel examen).</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="30.3" corresp="#wit-inst-cn"><pb n="333" ed="#liebermann"/>Quodsi non audent<ptr type="liebermannNote" n="7" target="#IICn_30-3.lnote.oe.7"/> sacramentum facere, eat<ptr type="liebermannNote" n="8" target="#IICn_30-3.lnote.oe.8"/> ad triplex iudicium.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="30.3" corresp="#wit-cons-cn"><pb n="333" ed="#liebermann"/>Quodsi ipsi illud iuramentum facere non audeant, calumpniatus triplex Dei iudicium adeat.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="30.3" corresp="#wit-b"><pb n="190" ed="#robertson"/>Be ordale. ⁊ gyf hi ðonne<ptr type="editorNote" n="4" target="#IICn_30-3.robnote.fn.4"/> að syllan ne durran, gange he to ðam ðrifealdan ordale.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="270" ed="#rabin-doml"/>And gif heo þone að syllan ne durren, gange he to þam þryfealdan ordale.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="332" ed="#liebermann"/>(Vom Ordal. <hi rend="italic">B</hi>) Wenn sie [Herr und Helfer] jedoch den Eid nicht zu leisten wagen, schreite [Verklagt]er zum dreifachen Ordal.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">(Of the ordeal. B) But if they [the lord and helpers] do not dare to give the oath, let [the accused] go to the threefold ordeal.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="191" ed="#robertson"/>Concerning the ordeal. If they dare not give the oath, he (the accused) shall go to the triple ordeal.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="466" ed="#whitelock"/>And if, however, they dare not give that oath, he is to go to the three-fold ordeal.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="271" ed="#rabin-doml"/>And if the accused dare not take the oath, he is to undergo the threefold ordeal.</ab>
        <note type="comparison" source="#liebermann" n="332"><ref target="clause:IAtr_1-4">I Atr 1.4</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 1, 4</note>
        <note type="comparison" source="#wormald-mel" n="367"><label>parallel</label> <ref target="clause:IAtr_1-4">I Atr 1.4</ref> <quote>I Atr 1:1,4/II Cn 30:1,3,3a</quote></note>
        <note type="editorial">In G, ‘durren’ was changed to ‘durran’. Liebermann compares I Atr 1.4.; BR: added from Gesetze I p. 333, October 2026 (MS Cons); AY: corrected against Rabin p. 270, October 2026 (was “∅”, now “| beo he: beo him B; beo A | his wites: þæs A | eft: omitted B”)</note>
        <note type="textual" source="#rabin-doml">B adds rubric Be ordale</note>
        <note type="textual" source="#rabin-doml">beo he: beo him B; beo A</note>
        <note type="textual" source="#rabin-doml">his wites: þæs A</note>
        <note type="textual" source="#rabin-doml">eft: omitted B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-3.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">332</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">333</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt T</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-3.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">333</biblScope></bibl><seg type="original" xml:lang="de">-eat <hi rend="italic">KT;</hi> -erat <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-eat KT; -erat Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-3.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">333</biblScope></bibl><seg type="original" xml:lang="de">id — ex. <hi rend="italic">aus Dm TR; fehlt KHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">id — ex. from Dm TR; lacking in KHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-3.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">332</biblScope></bibl><seg type="original" xml:lang="de">hig <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hig Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-3.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">332</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geändert in</hi> durran <hi rend="italic">G</hi></seg><seg type="translation" xml:lang="en" source="#claude">altered to durran G</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-3.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">332</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-3.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">332</biblScope></bibl><seg type="original" xml:lang="de">-adan <hi rend="italic">A</hi></seg><seg type="translation" xml:lang="en" source="#claude">-adan A</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-3.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">333</biblScope></bibl><seg type="original" xml:lang="de">-eat <hi rend="italic">Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">-eat Lb S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-3.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">333</biblScope></bibl><seg type="original" xml:lang="de">eant <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">eant Cb</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_30-3.robnote.fn.4" n="4" source="#robertson"><bibl><biblScope unit="page">190</biblScope></bibl><label>ðonne</label><seg type="original" xml:lang="en"><hi rend="italic">þone</hi> G, Ld.</seg></note>
      </div>
