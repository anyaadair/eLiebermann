        <head><ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 3.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 3.2" corresp="#wit-du" ana="#glossed"><pb n="410" ed="#liebermann"/><seg type="glossed"><seg type="base">tu,</seg><gloss xml:lang="ang">ðv,</gloss></seg> <seg type="glossed"><seg type="base">Domine,</seg><gloss xml:lang="ang">Driht<hi rend="italic">en</hi>,</gloss></seg> <seg type="glossed"><seg type="base">quesumus,</seg><gloss xml:lang="ang">ve bid<hi rend="italic">dað</hi>,</gloss></seg> <seg type="glossed"><seg type="base">mittere</seg><gloss xml:lang="ang">gisende</gloss></seg> <seg type="glossed"><seg type="base">digneris</seg><gloss xml:lang="ang">ðv gimeodvm<hi rend="italic">ia</hi></gloss></seg> <seg type="glossed"><seg type="base">Spiritum</seg><gloss xml:lang="ang">Gast</gloss></seg> <seg type="glossed"><seg type="base">tuum</seg><gloss xml:lang="ang">ðin</gloss></seg> <seg type="glossed"><seg type="base">sanctum</seg><gloss xml:lang="ang">halig</gloss></seg> <seg type="glossed"><seg type="base">ex</seg><gloss xml:lang="ang">of</gloss></seg> <seg type="glossed"><seg type="base">summa</seg><gloss xml:lang="ang">he[<hi rend="italic">sta</hi>]<ptr type="liebermannNote" n="4" target="#IudDeiIV_3-2.lnote.oe.4"/></gloss></seg> <seg type="glossed"><seg type="base">cœli</seg><gloss xml:lang="ang">heofnes</gloss></seg> <seg type="glossed"><seg type="base">arce</seg><gloss xml:lang="ang">hrofe <hi rend="italic">uel<ptr type="liebermannNote" n="5" target="#IudDeiIV_3-2.lnote.oe.5"/></hi></gloss></seg> <seg type="glossed"><seg type="base">super</seg><gloss xml:lang="ang">of<hi rend="italic">er</hi></gloss></seg> <seg type="glossed"><seg type="base">hanc</seg><gloss xml:lang="ang">ðas</gloss></seg> <seg type="glossed"><seg type="base">creaturam</seg><gloss xml:lang="ang">gisceæft</gloss></seg> <seg type="glossed"><seg type="base">aque,</seg><gloss xml:lang="ang">vætres,</gloss></seg> <seg type="glossed"><seg type="base">quę</seg><gloss xml:lang="ang">ðio</gloss></seg> <seg type="glossed"><seg type="base">ab</seg><gloss xml:lang="ang">fro<hi rend="italic">m</hi></gloss></seg> <seg type="glossed"><seg type="base">igne</seg><gloss xml:lang="ang">fyre</gloss></seg> <seg type="glossed"><seg type="base">feruescere<ptr type="liebermannNote" n="6" target="#IudDeiIV_3-2.lnote.oe.6"/></seg><gloss xml:lang="ang">givalla</gloss></seg> <seg type="glossed"><seg type="base">uidetur,</seg><gloss xml:lang="ang">bið gisene,</gloss></seg> <seg type="glossed"><seg type="base">qui</seg><gloss xml:lang="ang">se ðe</gloss></seg> <seg type="glossed"><seg type="base">rectum</seg><gloss xml:lang="ang">reht</gloss></seg> <seg type="glossed"><seg type="base">per</seg><gloss xml:lang="ang">ðerh</gloss></seg> <seg type="glossed"><seg type="base">eam</seg><gloss xml:lang="ang">hia<ptr type="liebermannNote" n="7" target="#IudDeiIV_3-2.lnote.oe.7"/></gloss></seg> <seg type="glossed"><seg type="base">iudicium</seg><gloss xml:lang="ang">dom</gloss></seg> <seg type="glossed"><seg type="base">super</seg><gloss xml:lang="ang">of<hi rend="italic">er</hi></gloss></seg> <seg type="glossed"><seg type="base">hunc</seg><gloss xml:lang="ang">ðiosne</gloss></seg> <seg type="glossed"><seg type="base">hominem,</seg><gloss xml:lang="ang">monno</gloss></seg> <seg type="glossed"><seg type="base">nomine<ptr type="liebermannNote" n="8" target="#IudDeiIV_3-2.lnote.oe.8"/></seg><gloss xml:lang="ang">nome ·</gloss></seg> ill<hi rend="italic">um</hi>, <seg type="glossed"><seg type="base">comprobet</seg><gloss xml:lang="ang">gicostia</gloss></seg> <seg type="glossed"><seg type="base">ac</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">manifestet,</seg><gloss xml:lang="ang">ædeava,</gloss></seg> <seg type="glossed"><seg type="base">qui<ptr type="liebermannNote" n="10" target="#IudDeiIV_3-2.lnote.oe.10"/></seg><gloss xml:lang="ang">se ðe <hi rend="italic">uel<ptr type="liebermannNote" n="9" target="#IudDeiIV_3-2.lnote.oe.9"/></hi> ðu ðe</gloss></seg> <seg type="glossed"><seg type="base">uiuis</seg><gloss xml:lang="ang">liofas</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">regnas</seg><gloss xml:lang="ang">ricsas</gloss></seg> <seg type="glossed"><seg type="base">Deus.</seg><gloss xml:lang="ang">God.</gloss></seg></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 410 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">lesbar nur</hi> he; <hi rend="italic">dahinter zwei Buchstaben unlesbar; vgl. Lind.</hi> § 64</seg><seg type="translation" xml:lang="en" source="#claude">only he legible; after it two letters illegible; cf. Lind. § 64</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wollte Glossator statt</hi> hrofe (‘<hi rend="italic">Dache</hi>’) <hi rend="italic">ein besser</hi> arce <hi rend="italic">entsprechendes Wort einsetzen?</hi></seg><seg type="translation" xml:lang="en" source="#claude">did the glossator mean to substitute for hrofe (‘roof’) a word corresponding better to arce?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">atque calescere <hi rend="italic">fügt zu Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">atque calescere added by Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Glossator setzt, ohne auf das Genus von</hi> wæter <hi rend="italic">zu achten, Femininum; ebenso</hi> 4, 3</seg><seg type="translation" xml:lang="en" source="#claude">the glossator, without heeding the gender of wæter, uses the feminine; likewise 4, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auf</hi> vel <hi rend="italic">folgt Verbesserung</hi></seg><seg type="translation" xml:lang="en" source="#claude">vel is followed by a correction</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">qui u. et r. D. <hi rend="italic">fehlt Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui u. et r. D. omitted in Zeu.</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-du">you, Lord, we beseech, deign to send your Holy Spirit from the highest citadel of heaven upon this creature of water, which is seen to boil from the fire, that he may through it prove and make manifest a right judgment upon this man, N. by name, [you] who live and reign, God.</ab>
      </div>
