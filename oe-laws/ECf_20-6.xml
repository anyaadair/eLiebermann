    <body>
      <div type="clause" n="20.6">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 20.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 20.6"><pb n="646" ed="#liebermann"/>Et si aliquando<ptr type="liebermannNote" n="32" target="#ECf_20-6.lnote.la.32"/> potuerint<ptr type="liebermannNote" n="33" target="#ECf_20-6.lnote.la.33"/> eum<ptr type="liebermannNote" n="34" target="#ECf_20-6.lnote.la.34"/> recuperare, aut<ptr type="liebermannNote" n="35" target="#ECf_20-6.lnote.la.35"/> adducent eum ad iusticiam<ptr type="liebermannNote" n="f" target="#ECf_20-6.lnote.la.fn.f"/>, si potuerint<ptr type="liebermannNote" n="36" target="#ECf_20-6.lnote.la.36"/>, aut<ptr type="liebermannNote" n="37" target="#ECf_20-6.lnote.la.37"/> dicent iusticie<ptr type="liebermannNote" n="f" target="#ECf_20-6.lnote.la.fn.f"/>, ubi sit.</ab>
        <note type="comparison" source="#liebermann" n="646"><label>printed alongside</label> <ref target="clause:ECfRetr_20-6">ECf retr 20.6</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 646 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-6.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">Richter</seg><seg type="translation" xml:lang="en" source="#claude">judge</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-6.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">quando <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">quando Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-6.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">poterint <hi rend="italic">Rl;</hi> poterunt <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">poterint Rl; poterunt Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-6.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt S</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-6.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt S Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in S Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-6.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">poterint <hi rend="italic">Rl Hr;</hi> poterunt <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">poterint Rl Hr; poterunt Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-6.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel Ad Do</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And if at any time they can recover him, either they shall bring him to the justice, if they can, or they shall tell the justice where he is.</ab>
      </div>
