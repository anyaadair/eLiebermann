      <div type="clause" n="49">
        <head>Ine Rb 49</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="49" corresp="#wit-e"><pb n="24" ed="#liebermann"/>XCIII. Be unaliefedes<ptr type="liebermannNote" n="7" target="#Rubrics-Ine_49.lnote.oe.7"/> mæstennes onfenge.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="49" corresp="#wit-g-prol"><pb n="24" ed="#liebermann"/>XCIII. Be unalyfedes mæstenes onfenge.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="49" corresp="#wit-h"><pb n="25" ed="#liebermann"/>XCIII. Be unalyfedes mæstenes onfenge.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="49" corresp="#wit-q"><pb n="25" ed="#liebermann"/>De<ptr type="liebermannNote" n="14" target="#Rubrics-Ine_49.lnote.oe.14"/> pasnagio.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="210" ed="#jurasinski-and-oliver"/>XCIII Be unaliefedes mæstennes onfenge</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="210" ed="#jurasinski-and-oliver"/>Be unalefedu<hi rend="italic">m</hi> mæstenu<hi rend="italic">m</hi> andfencge</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="25" ed="#liebermann"/>Von<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_49.lnote.de.1"/> Anmassung unerlaubter Mast.<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_49.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of taking unpermitted pannage.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="211" ed="#jurasinski-and-oliver"/>Concerning the capture of swine eating mast without permission</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="211" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_49.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">24</biblScope></bibl><seg type="original" xml:lang="de">unalyf. mæstenes onfeng <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">unalyf. mæstenes onfeng Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_49.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">Si quis obviet [De obviante <hi rend="italic">Br</hi>] porco in pasnagio suo sine licentia. [sine l. <hi rend="italic">fehlt Br</hi>]. De pasnagio capiendo [49,3] <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Si quis obviet [De obviante Br] porco in pasnagio suo sine licentia. [sine l. lacking in Br]. De pasnagio capiendo [49,3] Hk Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_49.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Q spät. Rez. vervollständigt die Rb aus seinem Text</seg><seg type="translation" xml:lang="en" source="#claude">The later recension of Q completes the Rb from its own text</seg><note type="remark" resp="#claude">On several rubrics: Ine Rb 40. 43f. 46—50. 54. 56f. 58. 61f. 67. 70f.</note></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_49.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘Abfangen auf u. M.’; <hi rend="italic">vgl.</hi> 44 <hi rend="italic">wuda onfeng</hi></seg><seg type="translation" xml:lang="en" source="#claude">Not ‘interception on unlawful mast’; <hi rend="italic">cf.</hi> 44 <hi rend="italic">wuda onfeng</hi></seg></note>
      </div>
