    <body>
      <div type="clause" n="84.3">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 84.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="84.3" corresp="#wit-g-a"><pb n="368" ed="#liebermann"/>Utan<ptr type="liebermannNote" n="20" target="#IICn_84-3.lnote.oe.20"/> þonne ealle anmodre heortan georne urum Drihtne cweman mid rihte ⁊ heonon<ptr type="liebermannNote" n="21" target="#IICn_84-3.lnote.oe.21"/> forð symle scyldan us georne wið þone hatan bryne, þe wealleð<ptr type="liebermannNote" n="22" target="#IICn_84-3.lnote.oe.22"/> on helle.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="84.3" corresp="#wit-b"><pb n="368" ed="#liebermann"/>Uton ðonne ealle anmodre heortan georne uru<hi rend="italic">m</hi> Drihtene cweman mid rihte ⁊ heonon forð mid rihte symble scyldan us georne wið ðone hatan bryne, ðe weallað on helle.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="84.3" corresp="#wit-a"><pb n="368" ed="#liebermann"/>Uton þonne ealle anmodre heortan georne uru<hi rend="italic">m</hi> Drihtne cweman mid rihte ⁊ henan forð symle scyldan us georne wið þonne<ptr type="liebermannNote" n="3" target="#IICn_84-3.lnote.oe.3-2"/> hatan bryne, þe weallað on helle.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="84.3" corresp="#wit-q"><pb n="369" ed="#liebermann"/>Satagamus<ptr type="liebermannNote" n="9" target="#IICn_84-3.lnote.oe.9"/> omnes uniformi corde semper Creatori nostro digne placere et amodo simul prouideamus<ptr type="liebermannNote" n="10" target="#IICn_84-3.lnote.oe.10"/> nobis a sempiternis ignibus et gehennę cruciatibus.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="84.3" corresp="#wit-cons-cn"><pb n="369" ed="#liebermann"/>Omnes itaque unanimi corde diligenter Deo [nostro] cum iusticia acceptemu[r] et acceptum seruicium faciamus et amodo semper proteg[a]mus nos a feruente incendio, quod feruet in inferno.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="84.3" corresp="#wit-b"><pb n="216" ed="#robertson"/>Uton ðonne ealle anmodre heortan georne urum Drihtene cweman mid rihte ⁊ heononforð mid rihte<ptr type="editorNote" n="13" target="#IICn_84-3.robnote.fn.13"/> symble scyldan us georne wið ðone hatan bryne ðe weallað on helle.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="298" ed="#rabin-doml"/>Utan þonne ealle anmodre heortan georne urum Drihtne cweman mid rihte and heononforð symle scyldan us georne wið þone hatan bryne, þe wealleð on helle.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="369" ed="#liebermann"/>So lasst uns denn alle einmüthigen Herzens willig nach Recht unserem Herrgott wohlgefällig sein und hinfort immer<ptr type="liebermannNote" n="1" target="#IICn_84-3.lnote.de.1"/> uns eifrig schirmen vor dem heissen<ptr type="liebermannNote" n="2" target="#IICn_84-3.lnote.de.2"/> Brande, der in der Hölle wallt.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">So let us then all, with one heart, willingly and rightly be pleasing to our Lord God, and henceforth always eagerly shield ourselves from the hot fire that seethes in hell.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_84-3.robnote.n.1"/><pb n="217" ed="#robertson"/>Let us all then, with humble heart, be zealous in pleasing our Lord aright, and henceforth, by doing what is right, always zealously guard ourselves from the hot fire which surges in hell.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="299" ed="#rabin-doml"/>Therefore, let us all, with a humble heart, zealously strive to please our Lord rightly, and henceforth always virtuously guard ourselves assiduously from the blazing fire that rages in hell.</ab>
        <note type="editorial">BR: added from Gesetze I p. 369, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">heononforð: B adds mid rihte</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-3.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">369</biblScope></bibl><seg type="original" xml:lang="de">suo <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">suo Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-3.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">369</biblScope></bibl><seg type="original" xml:lang="de">-mus <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-mus Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">369</biblScope></bibl><seg type="original" xml:lang="de">et — fac. <hi rend="italic">vielleicht Glosse</hi></seg><seg type="translation" xml:lang="en" source="#claude">et — fac. perhaps a gloss</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-3.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">369</biblScope></bibl><seg type="original" xml:lang="de">-gemus <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gemus Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-3.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">369</biblScope></bibl><seg type="original" xml:lang="de">Sat. — placere <hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">Sat. — placere lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-3.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">369</biblScope></bibl><seg type="original" xml:lang="de">preuid. <hi rend="italic">Dm TR</hi></seg><seg type="translation" xml:lang="en" source="#claude">preuid. Dm TR</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-3.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de">Uton <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Uton Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-3.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de">henan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">henan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-3.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de">-laþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-laþ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-3.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_84-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">214</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Q's Übs. <hi rend="italic">simul</hi> erklärt der Gleichklang; wie <hi rend="italic">o</hi>. 11¹</seg><seg type="translation" xml:lang="en" source="#claude">Q's transl. <hi rend="italic">simul</hi> is explained by the similarity of sound; as <hi rend="italic">above</hi> 11¹</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_84-3.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">214</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Mit Hölle droht in denselben Worten I 6, 1, ähnlich I 7. 18. 25</seg><seg type="translation" xml:lang="en" source="#claude">Hell is threatened in the same words in I 6, 1, and similarly in I 7. 18. 25</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_84-3.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">359</biblScope></bibl><seg type="original" xml:lang="en">Cf. I Cn. 6, 1; 25.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_84-3.robnote.fn.13" n="13" source="#robertson"><bibl><biblScope unit="page">216</biblScope></bibl><label>rihte</label><seg type="original" xml:lang="en"><hi rend="italic">m. r.</hi> om. G, A, Ld.</seg></note>
      </div>
