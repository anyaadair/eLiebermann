        <note type="liebermannNote" subtype="textual" xml:id="IICn_20a.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de">hiis <hi rend="italic">Cb Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">hiis Cb Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_20a.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de">hiis <hi rend="italic">Cb Di Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">hiis Cb Di Lb</seg></note>
