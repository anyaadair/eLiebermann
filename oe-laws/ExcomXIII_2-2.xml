      <div type="clause" n="2.2">
        <head><ref type="lawCode" target="law:ExcomXIII">Excom XIII</ref> 2.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom XIII 2.2" corresp="#wit-ym"><pb n="441" ed="#liebermann"/>ut non habeant partem cum Deo<ptr type="liebermannNote" n="2" target="#ExcomXIII_2-2.lnote.oe.2"/> neque cum sanctis eius<ptr type="liebermannNote" n="3" target="#ExcomXIII_2-2.lnote.oe.3"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 441 (two independent readings of the page images, differences settled against the page); Liebermann prints in smaller type: ut non habeant partem cum Deo neque cum sanctis eius.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXIII_2-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de">neque cum angelis eius <hi rend="italic">fügt zu Gem</hi></seg><seg type="translation" xml:lang="en" source="#claude">Gem adds neque cum angelis eius</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXIII_2-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de">quorum contemtores esse probantur <hi rend="italic">Gem</hi></seg><seg type="translation" xml:lang="en" source="#claude">quorum contemtores esse probantur Gem</seg></note>
