      <div type="clause" n="41.12">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 41.12</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 41.12" corresp="#wit-lat"><pb n="568" ed="#liebermann"/>Si iam recesserat, iuret, si<ptr type="liebermannNote" n="h" target="#Hn_41-12.lnote.oe.h"/> opus sit, quod nichil<ptr type="liebermannNote" n="24" target="#Hn_41-12.lnote.oe.24"/> inde<ptr type="liebermannNote" n="25" target="#Hn_41-12.lnote.oe.25"/> audierat, nec eius uelle nec<ptr type="liebermannNote" n="26" target="#Hn_41-12.lnote.oe.26"/> posse fuerit nec ob hoc eum dimiserit, nec<ptr type="liebermannNote" n="28" target="#Hn_41-12.lnote.oe.28"/> cum<ptr type="liebermannNote" n="i" target="#Hn_41-12.lnote.oe.i"/> eo crauatus<ptr type="liebermannNote" n="29" target="#Hn_41-12.lnote.oe.29"/> sit, set legittimo testimonio dimisit eum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 568 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-12.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 41, 9</seg><seg type="translation" xml:lang="en" source="#claude">as 41, 9</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-12.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">und nicht [<hi rend="italic">schon, während der Übelthäter</hi>] bei ihm [<hi rend="italic">dem Herrn, gewesen, derselbe</hi>] verklagt ward [<hi rend="italic">vgl.</hi> II Cn. 28, 1]</seg><seg type="translation" xml:lang="en" source="#claude">and had not [already, while the wrongdoer was] with him [the lord, the same man] been accused [cf. II Cn. 28, 1]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-12.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">nil <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">nil Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-12.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">in die <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">in die Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-12.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">uel p. fuerat <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel p. fuerat Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-12.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">nec — di. eum <hi rend="italic">überspringt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">nec — di. eum omitted by K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-12.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">curu., <hi rend="italic">corr.</hi> crau. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">curu., corrected to crau. Sc</seg></note>
      </div>
