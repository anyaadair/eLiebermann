    <body>
      <div type="clause" n="2.1">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 2.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 2.1" corresp="#wit-lat"><pb n="401–402" ed="#liebermann"/>Adiuro<ptr type="liebermannNote" n="18" target="#IudDeiI_2-1.lnote.oe.18"/> uos<ptr type="liebermannNote" n="19" target="#IudDeiI_2-1.lnote.oe.19"/> N<ptr type="liebermannNote" n="20" target="#IudDeiI_2-1.lnote.oe.20"/> per Patrem et Filium et<ptr type="liebermannNote" n="21" target="#IudDeiI_2-1.lnote.oe.21"/> Spiritum sanctum et per uestram<ptr type="liebermannNote" n="22" target="#IudDeiI_2-1.lnote.oe.22"/> christianitatem, quam<ptr type="liebermannNote" n="23" target="#IudDeiI_2-1.lnote.oe.23"/> suscepistis<ptr type="liebermannNote" n="24" target="#IudDeiI_2-1.lnote.oe.24"/>, et per unigenitum Dei Filium et per sanctam<ptr type="liebermannNote" n="25" target="#IudDeiI_2-1.lnote.oe.25"/> Trinitatem et per sanctum euangelium et per<ptr type="liebermannNote" n="26" target="#IudDeiI_2-1.lnote.oe.26"/> istas<ptr type="liebermannNote" n="27" target="#IudDeiI_2-1.lnote.oe.27"/> sanctas<ptr type="liebermannNote" n="26" target="#IudDeiI_2-1.lnote.oe.26"/> reliquias, quae in ista<ptr type="liebermannNote" n="28" target="#IudDeiI_2-1.lnote.oe.28"/> ecclesia sunt, et<ptr type="liebermannNote" n="29" target="#IudDeiI_2-1.lnote.oe.29"/> per illud baptismum, quo uos<ptr type="liebermannNote" n="30" target="#IudDeiI_2-1.lnote.oe.30"/> sacerdos regenerauit, ut non presumatis<ptr type="liebermannNote" n="1" target="#IudDeiI_2-1.lnote.oe.1"/> ullo modo communicare<ptr type="liebermannNote" n="2" target="#IudDeiI_2-1.lnote.oe.2"/> neque accedere<ptr type="liebermannNote" n="3" target="#IudDeiI_2-1.lnote.oe.3"/> ad altare<ptr type="liebermannNote" n="4" target="#IudDeiI_2-1.lnote.oe.4"/>, si hoc<ptr type="liebermannNote" n="5" target="#IudDeiI_2-1.lnote.oe.5"/> fecistis<ptr type="liebermannNote" n="6" target="#IudDeiI_2-1.lnote.oe.6"/> aut consensistis<ptr type="liebermannNote" n="6" target="#IudDeiI_2-1.lnote.oe.6"/> aut scitis<ptr type="liebermannNote" n="7" target="#IudDeiI_2-1.lnote.oe.7"/>, quis hoc egerit.<ptr type="liebermannNote" n="a" target="#IudDeiI_2-1.lnote.oe.a"/></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 401–402 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">Adiuro—egerit = <hi rend="italic">Zeu.</hi> 697 (5); <hi rend="italic">unten</hi> VI. X 13. XIII 3, 1</seg><seg type="translation" xml:lang="en" source="#claude">Adiuro—egerit = Zeu. 697 (5); below VI. X 13. XIII 3, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">te <hi rend="italic">Vt;</hi> uel te <hi rend="italic">schwarz übergeschr. H;</hi> te, <hi rend="italic">übergeschr.</hi> uos <hi rend="italic">Ci; stets Sing. Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">te Vt; uel te written above in black H; te, with uos written above, Ci; always singular Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">nōn (<hi rend="italic">d. i</hi> nomen) <hi rend="italic">Rj; fehlt Ch Vt;</hi> homo <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">nōn (i.e. nomen) Rj; omitted in Ch Vt; homo Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zu Anfang von Co fehlt das in</hi> 2, 1 <hi rend="italic">Folgende</hi></seg><seg type="translation" xml:lang="en" source="#claude">at the beginning of Co what follows in 2, 1 is missing</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">tuam <hi rend="italic">übergeschr. H;</hi> tuam, <hi rend="italic">darüber</hi> uestram, <hi rend="italic">und so stets Sing. und über der Zeile Plural Ci;</hi> ueram <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">tuam written above H; tuam, with uestram above it, and so throughout singular with plural above the line, Ci; ueram Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">in baptismo <hi rend="italic">fügt mit Fränk. Hss. zu</hi> X (<hi rend="italic">nicht</hi> VI. XIII); <hi rend="italic">aber</hi> baptismum <hi rend="italic">folgt zwei Zeilen weiter; hier also ‘Glaube’, wie</hi> VII 12, 3: bapt. et Christianismum</seg><seg type="translation" xml:lang="en" source="#claude">in baptismo added by X (not VI. XIII), with Frankish MSS; but baptismum follows two lines further on; here, therefore, ‘faith’, as in VII 12, 3: bapt. et Christianismum</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">-ti <hi rend="italic">übergeschr. H;</hi> acc. <hi rend="italic">Vt2</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ti written above H; acc. Vt2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">s. eu. et per s. Tr. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. eu. et per s. Tr. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Mg Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Mg Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ci Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Ci Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">‘aller Welt’</hi> VI. X</seg><seg type="translation" xml:lang="en" source="#claude">‘of the whole world’ VI. X</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">et—regenerauit <hi rend="italic">fehlt Zeu.</hi> 697 (5); <hi rend="italic">unten</hi> VI; et per sacrum corpus et sanguinem domini nostri Iesu Christi <hi rend="italic">statt</hi> et—regen. XIII</seg><seg type="translation" xml:lang="en" source="#claude">et—regenerauit omitted in Zeu. 697 (5); below VI; et per sacrum corpus et sanguinem domini nostri Iesu Christi instead of et—regen. XIII</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">te <hi rend="italic">übergeschr. Vt H</hi></seg><seg type="translation" xml:lang="en" source="#claude">te written above Vt H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Denke hinzu, hier oder (laut</hi> X 21) <hi rend="italic">nach</hi> 22, <hi rend="italic">den Voreid des Klägers und den Unschuldseid des Verklagten, nach</hi> II As. 23. 23, 2, <hi rend="italic">o. S.</hi> 162. <hi rend="italic">Den Voreid setzt vor die oben c.</hi> 1 <hi rend="italic">erwähnten drei Fasttage</hi> XVI 1.</seg><seg type="translation" xml:lang="en" source="#claude">Understand here, or (according to X 21) after 22, the plaintiff's fore-oath and the accused's oath of innocence, following II As. 23. 23, 2, above p. 162. XVI 1 places the fore-oath before the three fast days mentioned above in c. 1.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">-mas <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-mas written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">cum. <hi rend="italic">Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">cum. Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">ad al. ac. <hi rend="italic">Ca H</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad al. ac. Ca H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">hodie <hi rend="italic">fügt zu</hi> XIII</seg><seg type="translation" xml:lang="en" source="#claude">hodie added by XIII</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">uos hęc XIII</seg><seg type="translation" xml:lang="en" source="#claude">uos hęc XIII</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">-ti <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ti written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">scis <hi rend="italic">übergeschr. H;</hi> scisti (-stis) <hi rend="italic">Ci Co;</hi> scistis <hi rend="italic">Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">scis written above H; scisti (-stis) Ci Co; scistis Vt</seg></note>
      </div>
