    <body>
      <div type="clause" n="39">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 39</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 39" corresp="#wit-lat"><ptr type="liebermannNote" n="26" target="#Hn_39.lnote.oe.26"/><pb n="567" ed="#liebermann"/>De forisfactura sanguinis. In quibusdam locis qui<ptr type="liebermannNote" n="27" target="#Hn_39.lnote.oe.27"/> blodwitam<ptr type="liebermannNote" n="28" target="#Hn_39.lnote.oe.28"/>, id est forisfacturam sanguinis, fecerit<ptr type="liebermannNote" n="29" target="#Hn_39.lnote.oe.29"/> solummodo reus est, in<ptr type="liebermannNote" n="f" target="#Hn_39.lnote.oe.f"/> quibusdam etiam qui patitur<ptr type="liebermannNote" n="30" target="#Hn_39.lnote.oe.30"/>, ut nec agens inpunitate<ptr type="liebermannNote" n="31" target="#Hn_39.lnote.oe.31"/> superbiat nec contumeliatus<ptr type="liebermannNote" n="g" target="#Hn_39.lnote.oe.g"/> fedis<ptr type="liebermannNote" n="32" target="#Hn_39.lnote.oe.32"/> emendacionibus assuescat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 567 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_39.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt</hi> 84</seg><seg type="translation" xml:lang="en" source="#claude">repeated 84</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_39.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 36, 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. 36, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_39.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">trotz Capitelbeginn fehlt diese Rubrik sammt Nummer Lond, so dass die späteren Nummern mit Edd. stimmen;</hi> 40 <hi rend="italic">stellt vor</hi> 39, <hi rend="italic">aber mit Umstellungsvermerk, Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">despite the beginning of a chapter this rubric, together with its number, is missing in Lond, so that the later numbers agree with Edd.; Hg places 40 before 39, but with a transposition mark</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_39.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">quid <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">quid Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_39.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">-wyt. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-wyt. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_39.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">fecit <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">fecit Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_39.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_39.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">te <hi rend="italic">verschneidet Buchbinder vom Rande K; ebenso</hi> nec contume, emenda, assuescat</seg><seg type="translation" xml:lang="en" source="#claude">te cut off from the margin by the binder K; likewise nec contume, emenda, assuescat</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_39.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">sedis <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">sedis Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_39.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Busse 3; Ehrenbezeigung 2a; Ehrenkränkung 6a.—{29}<hi rend="italic">fecit</hi>—40. <hi rend="italic">De infraccione pontis</hi>{35} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Busse 3; Ehrenbezeigung 2a; Ehrenkränkung 6a.—{29}<hi rend="italic">fecit</hi>—40. <hi rend="italic">De infraccione pontis</hi>{35} Rs</seg></note>
      </div>
