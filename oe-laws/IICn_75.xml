        <note type="editorial">G reads ‘læte riht’ (so also the Consiliatio); Liebermann thinks ‘wille’ of the other MSS was perhaps glossed in the archetype. G's ‘þe[ah]’ was corrected from ‘þe’. ‘eac’ is supplied from the other MSS.; BR: added from Gesetze I p. 363, October 2026 (MS Cons); AY: corrected against Rabin p. 292 / 293, October 2026 (was “|”, now “∅”)</note>
        <note type="textual" source="#rabin-doml">B adds rubric Be ðam þæt man his spere to oðres mannes dure sette</note>
        <note type="textual" source="#rabin-doml">ic læte riht: wille A; ic nelle with læte riht added above the line B</note>
        <note type="textual" source="#rabin-doml">þeah: þe B</note>
        <note type="textual" source="#rabin-doml">his spere: his agen spere B</note>
        <note type="textual" source="#rabin-doml">and hwylcne: and he hwylcne B</note>
        <note type="textual" source="#rabin-doml">hearm: hearm eac AB</note>
        <note type="textual" source="#rabin-doml">eac: omitted G</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_75.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">363</biblScope></bibl><seg type="original" xml:lang="de">autem c., ut si <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">autem c., ut si Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_75.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">363</biblScope></bibl><seg type="original" xml:lang="de">causam rei h'piā ibi ag. l. s. foris ex. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">causam rei h'piā ibi ag. l. s. foris ex. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_75.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">363</biblScope></bibl><seg type="original" xml:lang="de">cusp. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">cusp. Hr</seg></note>
