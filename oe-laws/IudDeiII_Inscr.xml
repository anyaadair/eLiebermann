      <div type="clause" n="Inscr.">
        <head><ref type="lawCode" target="law:IudDeiII">Iud Dei II</ref> Inscr.</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei II Inscr." corresp="#wit-lat"><pb n="406" ed="#liebermann"/>Incipit adiuratio<ptr type="liebermannNote" n="1" target="#IudDeiII_Inscr.lnote.oe.1"/> ferri<ptr type="liebermannNote" n="2" target="#IudDeiII_Inscr.lnote.oe.2"/> uel<ptr type="liebermannNote" n="b" target="#IudDeiII_Inscr.lnote.oe.b"/> aquae feruentis.<ptr type="liebermannNote" n="3" target="#IudDeiII_Inscr.lnote.oe.3"/></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 406 (two independent readings of the page images, differences settled against the page); Liebermann’s heading: [II.]; F: corrected against Liebermann, Gesetze I (date at the head of the text); Wormald, Making of English Law I; Whitelock, English Historical Documents I, October 2026 (was “c. 850–c. 975 (Liebermann)”, now “c. 850–c. 975 (Liebermann, I p. 406)”)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_Inscr.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Fortsetzung (laut</hi> prediximus II 1, 1, <hi rend="italic">welches Wort sich auf</hi> I 23, 1 <hi rend="italic">bezieht) zu</hi> I. <hi rend="italic">Vgl. S.</hi> 401ᶜ.</seg><seg type="translation" xml:lang="en" source="#claude">Continuation (according to prediximus II 1, 1, which word refers to I 23, 1) of I. Cf. p. 401ᶜ.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_Inscr.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Eisen und Heisswasser haben (vgl.</hi> 3, 5) <hi rend="italic">meist Eine Formel; Zeu.</hi> 602₇</seg><seg type="translation" xml:lang="en" source="#claude">Iron and hot water mostly have (cf. 3, 5) a single formula; Zeu. 602₇</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_Inscr.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">-ati <hi rend="italic">Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ati Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_Inscr.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">aq. feru. uel ferri <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">aq. feru. uel ferri Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_Inscr.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">ad iudicium <hi rend="italic">fügt zu Rj Ch Vt Ci Ca H</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad iudicium added by Rj Ch Vt Ci Ca H</seg></note>
      </div>
    </body>
