  <text>
    <body>
      <div type="clause" n="8.2">
        <head><ref type="lawCode" target="law:IIIAtr">III Atr</ref> 8.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8.2" corresp="#wit-h"><pb n="230" ed="#liebermann"/>⁊ ælc mynetere þe betihtlad sí, bicge him láh mid XII oran.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="8.2" corresp="#wit-q"><pb n="230" ed="#liebermann"/>Et omnis monetarius qui infamis sit, redimat sibi lagam XII oris.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="8.2" corresp="#wit-h"><pb n="68" ed="#robertson"/>⁊ ælc mynetere þe betihtlad sí, bicge him láh mid XII oran.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="231" ed="#liebermann"/>Und jeder Münzer, der bescholten ist, kaufe sich Rechtsschutz mit 12 Ör.<ptr type="liebermannNote" n="1" target="#IIIAtr_8-2.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let every moneyer who is of bad repute buy himself legal protection with 12 ores.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-h"><ptr type="editorNote" n="1" target="#IIIAtr_8-2.robnote.n.0"/><pb n="69" ed="#robertson"/>And every moneyer who is accused shall pay 12 ores in order to obtain the benefit of the law.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h"><pb n="446" ed="#whitelock"/>And every moneyer who is accused is to buy for himself [the benefit of] law with 12 ores.</ab>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIIAtr_8-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">160</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. o</hi>. 3, 3¹; <hi rend="italic">Gl</hi> bescholten 10a</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. above</hi> 3, 3¹; <hi rend="italic">Gl</hi> bescholten 10a</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIAtr_8-2.robnote.n.0" n="0" source="#robertson"><bibl><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="en">Cf. 3, 3.</seg></note>
      </div>
    </body>
