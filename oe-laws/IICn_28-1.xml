      <div type="clause" n="28.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 28.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="28.1" corresp="#wit-g-a"><pb n="330" ed="#liebermann"/>And nan man his men fra<hi rend="italic">m</hi> him ne tæce, ær<ptr type="liebermannNote" n="12" target="#IICn_28-1.lnote.oe.12"/> he clæne sý ælcere<ptr type="liebermannNote" n="13" target="#IICn_28-1.lnote.oe.13"/> spræce, þe he ær beclypod<ptr type="liebermannNote" n="14" target="#IICn_28-1.lnote.oe.14"/> wæs.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="28.1" corresp="#wit-b"><pb n="330" ed="#liebermann"/>⁊ nan man his men fra<hi rend="italic">m</hi> him ne tǽce, ær hé clǽne sy æt ælcere spǽce, ðe he ær beclypad wæs.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="28.1" corresp="#wit-a"><pb n="330" ed="#liebermann"/>And nan man his men fram him ne tace, ær he clæne sy ælcere sprece, þe he ær beclyped wæs.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="28.1" corresp="#wit-q"><pb n="331" ed="#liebermann"/>Et nemo suum hominem a se dimittat, priusquam mundus sit in causis omnibus, quibus fuerat<ptr type="liebermannNote" n="6" target="#IICn_28-1.lnote.oe.6"/> ante compellatus (ante fuerit accusatus).</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="28.1" corresp="#wit-inst-cn"><pb n="331" ed="#liebermann"/>Nullus repellat a se seruientem suum, antequam sit purgatus de omni calumnia, unde fuit<ptr type="liebermannNote" n="6" target="#IICn_28-1.lnote.oe.6-2"/> prius calumniatus.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="28.1" corresp="#wit-cons-cn"><pb n="331" ed="#liebermann"/>Neque quisquam suum seruientem licenciet, donec mundus sit ab omni precedente querimonia.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="28.1" corresp="#wit-b"><pb n="188" ed="#robertson"/>⁊ nan man his men fram him ne tǽce, ær hé clǽne sy æt<ptr type="editorNote" n="1" target="#IICn_28-1.robnote.fn.1"/> ælcere spǽce ðe he ær beclypad wæs.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="268" ed="#rabin-doml"/>And nan man his men fram him ne tæce ær he clæne sy ælcere spræce þe he ær beclypod wæs.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><ptr type="liebermannNote" n="1" target="#IICn_28-1.lnote.de.1"/><pb n="330" ed="#liebermann"/>Und niemand weise seinen Untergebenen von sich, bevor dieser von jeder Klage rein sei, womit er früher beklagt gewesen ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let no one dismiss his man from him before he is clear of every charge on which he was previously accused.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_28-1.robnote.n.1"/><pb n="189" ed="#robertson"/>And no-one shall dismiss one of his men from his service until he is quit of every accusation which has been brought against him.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="465" ed="#whitelock"/>And no one is to dismiss his man, before he is cleared of every charge with which he had been accused.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="269" ed="#rabin-doml"/>And no one is to release one of his followers from service unless he has been shown to be innocent of any accusation that has been brought against him.</ab>
        <note type="comparison" source="#liebermann" n="330"><ref target="clause:IIAs_22-2">II As 22.2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 22, 2</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_48-1">Leis Wl 48.1</ref></note>
        <note type="editorial">Liebermann compares II As 22.2.; BR: added from Gesetze I p. 331, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_28-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">331</biblScope></bibl><seg type="original" xml:lang="de">se. su. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">se. su. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_28-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">331</biblScope></bibl><seg type="original" xml:lang="de">licenceat <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">licenceat Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_28-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">331</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_28-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">331</biblScope></bibl><seg type="original" xml:lang="de">f. a. c. <hi rend="italic">K;</hi> a. f. a. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. a. c. K; a. f. a. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_28-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">330</biblScope></bibl><seg type="original" xml:lang="de">ære <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ære Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_28-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">330</biblScope></bibl><seg type="original" xml:lang="de">æt [<hi rend="italic">vgl. B</hi>] ælcre <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">æt [cf. B] ælcre Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_28-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">330</biblScope></bibl><seg type="original" xml:lang="de">-ped <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ped Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_28-1.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">331</biblScope></bibl><seg type="original" xml:lang="de">pr. c. f. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">pr. c. f. Cb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_28-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">206</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Benutzt durch Hn 8, 5, übersetzt durch Leis Wl 48</seg><seg type="translation" xml:lang="en" source="#claude">Used by Hn 8, 5, translated by Leis Wl 48</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_28-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">355</biblScope></bibl><seg type="original" xml:lang="en">Cf. II As. 22, 2.</seg></note>
