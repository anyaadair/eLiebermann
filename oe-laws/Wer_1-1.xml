    <body>
      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:Wer">Wer</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-h"><pb n="392" ed="#liebermann"/>Twyhyndes mannes wer is twa hund scill'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-b"><pb n="392" ed="#liebermann"/>Twyhyndes mannes wer is twa hund scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.1" corresp="#wit-q"><pb n="393" ed="#liebermann"/>Tƿihindi<ptr type="liebermannNote" n="4" target="#Wer_1-1.lnote.oe.4"/> hominis wera est tƿa hund<ptr type="liebermannNote" n="3" target="#Wer_1-1.lnote.oe.3"/> scill. (id est ducenti sol. ex<ptr type="liebermannNote" n="5" target="#Wer_1-1.lnote.oe.5"/> V<ptr type="liebermannNote" n="6" target="#Wer_1-1.lnote.oe.6"/> scilicet denariis<ptr type="liebermannNote" n="**" target="#Wer_1-1.lnote.oe.star2"/>, qui faciunt IIII libras et XL denarios).</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="393" ed="#liebermann"/>Wergeld eines 200-Menschen ist 200<ptr type="liebermannNote" n="1" target="#Wer_1-1.lnote.de.1"/> Schilling<ptr type="liebermannNote" n="2" target="#Wer_1-1.lnote.de.2"/>.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">The wergild of a two-hundred man is 200 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#wormald" corresp="#wit-h">A two-hundred man's wergeld is 200 shillings</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_8">Leis Wl 8</ref></note>
        <note type="editorial">U: translator probably Wormald, The Making of English Law (named in the original spreadsheet’s sub-header rows): check</note>
        <note type="liebermannNote" subtype="textual" xml:id="Wer_1-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">393</biblScope></bibl><seg type="original" xml:lang="de">Twifhyndi <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">Twifhyndi T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Wer_1-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">393</biblScope></bibl><seg type="original" xml:lang="de">-hínd <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-hínd MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Wer_1-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">393</biblScope></bibl><seg type="original" xml:lang="de">ex — den. <hi rend="italic">fehlt R</hi></seg><seg type="translation" xml:lang="en" source="#claude">ex — den. omitted in R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Wer_1-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">393</biblScope></bibl><seg type="original" xml:lang="de">XV <hi rend="italic">statt</hi> ex V <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">XV instead of ex V T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Wer_1-1.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">393</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Westsächsisch; vgl.</hi> Af. Rb. 31, <hi rend="italic">o. S.</hi> 19, <hi rend="italic">Sp.</hi> 2</seg><seg type="translation" xml:lang="en" source="#claude">West Saxon; cf. Af. Rb. 31, above p. 19, col. 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Wer_1-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">231</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Gl ebd</hi>. 4 ff.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Gl ibid</hi>. 4 ff.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Wer_1-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">231</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Die <hi rend="italic">40 den</hi>. des Q lässt Hn fort; <hi rend="italic">ebd</hi>. 4b</seg><seg type="translation" xml:lang="en" source="#claude">Hn omits the <hi rend="italic">40 den</hi>. of Q; <hi rend="italic">ibid</hi>. 4b</seg></note>
      </div>
