      <div type="clause" n="12a">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 12a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 12a"><pb n="637" ed="#liebermann"/>alia die<ptr type="liebermannNote" n="17" target="#ECfRetr_12a.lnote.la.17"/> qua primum coronatus est — <hi rend="bold">que</hi><ptr type="liebermannNote" n="18" target="#ECfRetr_12a.lnote.la.18"/> dies <hi rend="bold">tenet</hi> octo —; in<ptr type="liebermannNote" n="19" target="#ECfRetr_12a.lnote.la.19"/> natale Domini dies octo, <hi rend="bold">in</hi><ptr type="liebermannNote" n="20" target="#ECfRetr_12a.lnote.la.20"/> pascha dies octo, <hi rend="bold">in</hi> pentecoste<ptr type="liebermannNote" n="21" target="#ECfRetr_12a.lnote.la.21"/> dies<ptr type="liebermannNote" n="22" target="#ECfRetr_12a.lnote.la.22"/> octo;</ab>
        <note type="comparison" source="#liebermann" n="637"><label>printed alongside</label> <ref target="clause:ECf_12a">ECf 12a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 637 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12a.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">de <hi rend="italic">Hv;</hi> qua <hi rend="italic">fehlt Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">de Hv; qua lacking in Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12a.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">qm̄ d. tenent <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">qm̄ d. tenent Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12a.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">in na. D. d. o., in pa. d. o. <hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">in na. D. d. o., in pa. d. o. lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12a.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">pasche <hi rend="italic">Hv;</hi> paschale <hi rend="italic">Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">pasche Hv; paschale Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12a.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">-ten <hi rend="italic">Lb Hv K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ten Lb Hv K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12a.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">d. o. <hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. o. lacking in Hv</seg></note>
