  <text>
    <body>
      <div type="clause" n="13.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 13.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 13.1"><pb n="640" ed="#liebermann"/><ptr type="liebermannNote" n="10" target="#ECfRetr_13-1.lnote.la.10"/>Diuisiones<ptr type="liebermannNote" n="11" target="#ECfRetr_13-1.lnote.la.11"/> hundredorum — wapentagiorum — comitibus, uicecomitibus cum<ptr type="liebermannNote" n="12" target="#ECfRetr_13-1.lnote.la.12"/> iudicio comitatus.<ptr type="liebermannNote" n="*" target="#ECfRetr_13-1.lnote.la.star"/></ab>
        <note type="comparison" source="#liebermann" n="640"><label>printed alongside</label> <ref target="clause:ECf_13-1">ECf 13.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 640 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_13-1.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">Diuisiones hundredorum <hi rend="italic">roth Cb Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Diuisiones hundredorum in red Cb Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_13-1.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">uero <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds uero</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_13-1.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">erunt <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">erunt Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_13-1.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier schaltet Lond s. XIII. in. ein in die Retr.:</hi></seg><seg type="translation" xml:lang="en" source="#claude">here Lond s. XIII. in. inserts into the Retr.:</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">The boundaries of hundreds — of wapentakes — to the earls, sheriffs, under the judgment of the shire.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_13-1.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">345</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="superscript">10</hi><hi rend="italic">D. h.</hi> rot Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="superscript">10</hi><hi rend="italic">D. h.</hi> in red in Rs</seg></note>
      </div>
    </body>
