  <text>
    <body>
      <div type="clause" n="35.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 35.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 35.1"><pb n="664" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_35-1.lnote.oe.erkl-clause"/>Et ipse Ædwardus<ptr type="liebermannNote" n="16" target="#ECf_35-1.lnote.la.16"/> accepit ibi<ptr type="liebermannNote" n="c" target="#ECf_35-1.lnote.la.fn.c"/> uxorem ex<ptr type="liebermannNote" n="17" target="#ECf_35-1.lnote.la.17"/> nobili genere, de qua ortus est ei Eadgarus<ptr type="liebermannNote" n="18" target="#ECf_35-1.lnote.la.18"/> aðeling<ptr type="liebermannNote" n="19" target="#ECf_35-1.lnote.la.19"/> et Margareta<ptr type="liebermannNote" n="cc" target="#ECf_35-1.lnote.la.fn.cc"/> regina<ptr type="liebermannNote" n="**" target="#ECf_35-1.lnote.la.star2"/> Scotie et Cristina<ptr type="liebermannNote" n="20" target="#ECf_35-1.lnote.la.20"/> soror eius.<ptr type="liebermannNote" n="***" target="#ECf_35-1.lnote.la.ststst"/></ab>
        <note type="comparison" source="#liebermann" n="664"><label>printed alongside</label> <ref target="clause:ECfRetr_35-1">ECf retr 35.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 664 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">The starred notes (*, **, ***) are printed across the whole page; they are given with both columns.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielmehr in Ungarn: Agathe</hi></seg><seg type="translation" xml:lang="en" source="#claude">rather in Hungary: Agatha</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1.lnote.la.fn.cc" n="cc" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">† 1093</seg><seg type="translation" xml:lang="en" source="#claude">† 1093</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1.lnote.la.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">domina Albanie <hi rend="italic">statt</hi> r. S. <hi rend="italic">Lond, damit Schottland von England abhängig scheine; wie</hi> 35, 1 A 2</seg><seg type="translation" xml:lang="en" source="#claude">domina Albanie instead of r. S. Lond, so that Scotland should appear dependent on England; as in 35, 1 A 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1.lnote.la.ststst" n="***" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier interpolirt Lond:</hi> [35, 1 A–A 2]</seg><seg type="translation" xml:lang="en" source="#claude">here Lond interpolates: [35, 1 A–A 2]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">Ed. <hi rend="italic">Hk S Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ed. Hk S Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt S Hr Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in S Hr Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">Ed. <hi rend="italic">Hk;</hi> Æd. <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ed. Hk; Æd. S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">adþe. <hi rend="italic">Rl;</hi> eþe. <hi rend="italic">S;</hi> ade. <hi rend="italic">Cl Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">adþe. Rl; eþe. S; ade. Cl Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">-iana <hi rend="italic">Hr;</hi> Christiana <hi rend="italic">S Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iana Hr; Christiana S Cl</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And this Edward took a wife there of noble family, of whom were born to him Edgar <hi rend="italic">aðeling</hi> (prince) and Margaret, queen of Scotland, and Christina her sister.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">350</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Eadgar Ætheling — <hi rend="italic">eadel.</hi><hi rend="superscript">23</hi> — <hi rend="italic">postea</hi><hi rend="superscript">17</hi> <hi rend="italic">domina Albanie</hi> — <hi rend="italic">Christiana</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">Cf. <hi rend="italic">Gl</hi> Eadgar Ætheling — <hi rend="italic">eadel.</hi><hi rend="superscript">23</hi> — <hi rend="italic">postea</hi><hi rend="superscript">17</hi> <hi rend="italic">domina Albanie</hi> — <hi rend="italic">Christiana</hi> Rs</seg></note>
      </div>
    </body>
