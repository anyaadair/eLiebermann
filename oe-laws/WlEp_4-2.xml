    <body>
      <div type="clause" n="4.2">
        <head><ref type="lawCode" target="law:WlEp">Wl ep</ref> 4.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-lat"><pb n="485" ed="#liebermann"/>Iudicium<ptr type="liebermannNote" n="h" target="#WlEp_4-2.lnote.oe.h"/> uero in nullo<ptr type="liebermannNote" n="22" target="#WlEp_4-2.lnote.oe.22"/> loco portetur nisi in episcopali sede aut in illo<ptr type="liebermannNote" n="23" target="#WlEp_4-2.lnote.oe.23"/> loco, quem ad<ptr type="liebermannNote" n="24" target="#WlEp_4-2.lnote.oe.24"/> hoc episcopus constituerit<ptr type="liebermannNote" n="25" target="#WlEp_4-2.lnote.oe.25"/>.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="4.2" corresp="#wit-lp"><pb n="236" ed="#robertson"/>Iudicium vero in nullo loco portetur nisi in episcopali sede aut in illo loco quem episcopus ad hoc constituerit.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-lp"><pb n="237" ed="#robertson"/>Trial by ordeal, likewise, shall not take place anywhere except at the bishop's see or at the place appointed for the purpose by the bishop.</ab>
        <note type="editorial">Added October 2026 from Robertson pp. 236–237 (text and translation); Liebermann’s text added from Gesetze I p. 485, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="WlEp_4-2.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">485</biblScope></bibl><seg type="original" xml:lang="de">Eisenordal</seg><seg type="translation" xml:lang="en" source="#claude">ordeal of iron</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlEp_4-2.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">485</biblScope></bibl><seg type="original" xml:lang="de">-lum locum <hi rend="italic">Spelman</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lum locum Spelman</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlEp_4-2.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">485</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ry</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Ry</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlEp_4-2.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">485</biblScope></bibl><seg type="original" xml:lang="de">ep. ad hoc <hi rend="italic">Ry</hi></seg><seg type="translation" xml:lang="en" source="#claude">ep. ad hoc Ry</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlEp_4-2.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">485</biblScope></bibl><seg type="original" xml:lang="de">In qua uidelicet matre ecclesia canonici Deo seruientes caste uiuant <hi rend="italic">etc. fügt hinzu</hi> (<hi rend="italic">aus Lc?</hi>) <hi rend="italic">Wilkins</hi> Leg. Anglosax. 231</seg><seg type="translation" xml:lang="en" source="#claude">In qua uidelicet matre ecclesia canonici Deo seruientes caste uiuant etc. added (from Lc?) by Wilkins Leg. Anglosax. 231</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlEp_4-2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">275</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Ordal 28a-c</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Ordal 28a-c</seg></note>
      </div>
