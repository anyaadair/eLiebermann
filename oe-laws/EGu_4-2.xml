    <body>
      <div type="clause" n="4.2">
        <head><ref type="lawCode" target="law:EGu">EGu</ref> 4.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4.2" corresp="#wit-h"><pb n="130" ed="#liebermann"/>Gif gehadod man hine forwyrce mid deaþscylde<ptr type="liebermannNote" n="29" target="#EGu_4-2.lnote.oe.29"/>, gewilde<ptr type="liebermannNote" n="30" target="#EGu_4-2.lnote.oe.30"/> hine man<ptr type="liebermannNote" n="28" target="#EGu_4-2.lnote.oe.28"/> ⁊ healde to bisceopes dome.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4.2" corresp="#wit-b"><pb n="130" ed="#liebermann"/>⁊ gyf gehadod man hine forwyrce mid deaðscylde, gewylde hine man ⁊ healde to bisceopes dome.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="4.2" corresp="#wit-q"><pb n="131" ed="#liebermann"/>Et si ordinatus homo se forisfaciat in morte puniendis<ptr type="liebermannNote" n="26" target="#EGu_4-2.lnote.oe.26"/> (plectendis) actibus, exsuperetur et episcopi iudicio reseruetur.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="4.2" corresp="#wit-h"><pb n="104" ed="#attenborough"/>Gif<ptr type="editorNote" n="14" target="#EGu_4-2.attnote.fn.14"/> gehadod man hine forwyrce mid deaþscylde, gewilde hine man ⁊ healde to bisceopes dome.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-h"><pb n="4" ed="#rabin-doml"/>Gif gehadod man hine forwyrce mid deaþscylde, gewilde hine man and healde to bisceopes dome.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="131" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#EGu_4-2.lnote.de.1"/> ein geweihter Mann sich [sein Leben] verwirkt<ptr type="liebermannNote" n="2" target="#EGu_4-2.lnote.de.2"/> durch Todes [würdige<ptr type="liebermannNote" n="3" target="#EGu_4-2.lnote.de.3"/>] Schuld, ergreife<ptr type="liebermannNote" n="4" target="#EGu_4-2.lnote.de.4"/> und bewahre man ihn für des Bischofs Urtheilspruch.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If an ordained man forfeits [his life] by a crime [deserving] death, let him be seized and kept for the bishop’s judgment.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="105" ed="#attenborough"/>If a man in orders places his life in jeopardy by committing a capital crime, he shall be arrested, and his case shall be reserved for the bishop's decision.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-h"><pb n="5" ed="#rabin-doml"/>If a man in orders compromises himself with a capital crime, he is to be arrested and held for the bishop’s judgment.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_43">II Cn 43</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="359"><ref target="clause:IICn_43">II Cn 43–44</ref></note>
        <note type="textual" source="#rabin-doml">Gif: And B</note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_4-2.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">131</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond;</hi> (<hi rend="italic">eingeklammertes</hi>) <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket Lond; (the bracketed words) the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_4-2.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">130</biblScope></bibl><seg type="original" xml:lang="de">deaþe sc. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">deaþe sc. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_4-2.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">130</biblScope></bibl><seg type="original" xml:lang="de">gewylde <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gewylde Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_4-2.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">130</biblScope></bibl><seg type="original" xml:lang="de">mon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mon Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_4-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">90</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Wiederholt (mit hier unpassendem Zusatze, aus 4, 1 Ende?) II Cn 43</seg><seg type="translation" xml:lang="en" source="#claude">Repeated in II Cn 43 (with an addition unsuited to this place, from the end of 4, 1?)</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_4-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">90</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Wb forwyrcan</hi> 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Wb forwyrcan</hi> 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_4-2.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">90</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">heafodgylt</hi> Northu 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">heafodgylt</hi> Northu 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_4-2.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">90</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">verhafte, <hi rend="italic">s. Wb gewieldan.</hi> — Statt letzten Wortes der Übs. ‘Urteilspruch’ bessere: ‘Entscheidung’, nämlich zwischen möglichen Strafarten; <hi rend="italic">vgl. Gl</hi> Bischof 9n; Geistliches Gericht 9. g</seg><seg type="translation" xml:lang="en" source="#claude">verhafte [arrest], <hi rend="italic">see Wb gewieldan.</hi> — For the last word of the translation, ‘Urteilspruch’ [judgment], read instead: ‘Entscheidung’ [decision], namely between possible kinds of punishment; <hi rend="italic">cf. Gl</hi> Bischof 9n; Geistliches Gericht 9. g</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="EGu_4-2.attnote.fn.14" n="14" source="#attenborough"><bibl><biblScope unit="page">104</biblScope></bibl><label>Gif</label><seg type="original" xml:lang="en"><hi rend="italic">⁊ gyf</hi>. B.</seg></note>
      </div>
    </body>
