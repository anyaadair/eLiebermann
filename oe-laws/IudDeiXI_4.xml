      <div type="clause" n="4">
        <head><ref type="lawCode" target="law:IudDeiXI">Iud Dei XI</ref> 4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XI 4" corresp="#wit-lat"><ptr type="liebermannNote" n="17" target="#IudDeiXI_4.lnote.oe.17"/><pb n="419" ed="#liebermann"/>Benedictio<ptr type="liebermannNote" n="18" target="#IudDeiXI_4.lnote.oe.18"/> ferri feruentis. Deus<ptr type="liebermannNote" n="19" target="#IudDeiXI_4.lnote.oe.19"/> omnipotens, Deus Abraham, Deus Ysáác, Deus Iacob, Deus omnium bene uiuentium, Deus, origo et manifestatio omnis iustitię<ptr type="liebermannNote" n="20" target="#IudDeiXI_4.lnote.oe.20"/>, qui solus<ptr type="liebermannNote" n="21" target="#IudDeiXI_4.lnote.oe.21"/> es iustus iudex, fortis et patiens<ptr type="liebermannNote" n="22" target="#IudDeiXI_4.lnote.oe.22"/>,</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Ps. 7, 12</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 419 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXI_4.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">419</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bei Zeumer steht</hi> 5 <hi rend="italic">vor</hi> 4</seg><seg type="translation" xml:lang="en" source="#claude">in Zeumer 5 comes before 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXI_4.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">419</biblScope></bibl><seg type="original" xml:lang="de">Alia <hi rend="italic">statt</hi> B. f. f. <hi rend="italic">Zeu.; Überschrift fehlt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Alia instead of B. f. f. Zeu.; heading omitted in Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXI_4.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">419</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Vt2 Tr Mg. Zeu.</hi> 649 = 701 (14); Q[uesumu]s <hi rend="italic">Ll Tb</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Vt2 Tr Mg. Zeu. 649 = 701 (14); Q[uesumu]s Ll Tb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXI_4.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">419</biblScope></bibl><seg type="original" xml:lang="de">-icię <hi rend="italic">Tb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-icię Tb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXI_4.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">419</biblScope></bibl><seg type="original" xml:lang="de">es so. <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">es so. Zeu.</seg></note>
