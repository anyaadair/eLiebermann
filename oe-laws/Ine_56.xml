        <note type="liebermannNote" subtype="textual" xml:id="Ine_56.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">115</biblScope></bibl><seg type="original" xml:lang="de">t. a. <hi rend="italic">fehlt Lond;</hi> -tis <hi rend="italic">Br;</hi> coag. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. a. lacking in Lond; -tis Br; coag. R</seg></note>
