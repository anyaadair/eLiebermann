        <note type="liebermannNote" subtype="textual" xml:id="IICn_29.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">331</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. nur Dm; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above only in Dm; lacking in the others</seg></note>
