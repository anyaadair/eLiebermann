    <body>
      <div type="clause" n="10.2">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 10.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 10.2"><pb n="634" ed="#liebermann"/>Si quis uero<ptr type="liebermannNote" n="12" target="#ECf_10-2.lnote.la.12"/> eum detinuerit, ad iusticiam<ptr type="liebermannNote" n="13" target="#ECf_10-2.lnote.la.13"/> regis clamor deferatur<ptr type="liebermannNote" n="e" target="#ECf_10-2.lnote.la.fn.e"/>, quoniam ille denarius elemosina regis<ptr type="liebermannNote" n="a" target="#ECf_10-2.lnote.oe.erkl-a"/> est, et iusticia<ptr type="liebermannNote" n="14" target="#ECf_10-2.lnote.la.14"/> regis faciat<ptr type="liebermannNote" n="15" target="#ECf_10-2.lnote.la.15"/> reddere denarium et forisfacturam<ptr type="liebermannNote" n="16" target="#ECf_10-2.lnote.la.16"/> episcopi<ptr type="liebermannNote" n="17" target="#ECf_10-2.lnote.la.17"/> et regis.</ab>
        <note type="comparison" source="#liebermann" n="634"><label>printed alongside</label> <ref target="clause:ECfRetr_10-2">ECf retr 10.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 634 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-2.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 6a</seg><seg type="translation" xml:lang="en" source="#claude">cf. 6a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-2.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-2.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">domini <hi rend="italic">fügt zu Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad Do add domini</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-2.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">domini <hi rend="italic">fügt zu Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Do adds domini</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-2.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">r. f. <hi rend="italic">S;</hi> faciet <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. f. S; faciet Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-2.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-2.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">r. et ep. <hi rend="italic">S Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. et ep. S Ad Do</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But if anyone withholds it, let complaint be brought to the king's justice, since that penny is the king's alms; and let the king's justice make him render the penny and the fine of the bishop and of the king.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-2.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">345</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd.</hi> 5. 8. 10e. 18; Kirchenstaatsrecht 20f. — ECf, obwohl klerikal-hierarchisch, erwähnt keineswegs den Papst; <hi rend="italic">s. d.</hi> 7. <hi rend="italic">Vgl.</hi> Böhmer <hi rend="italic">Ki. u. Staat</hi> 136. Wilhelm I. setzt den Peterspfennig in Wells durch; Davis <hi rend="italic">Reg. Agn.</hi> 187</seg><seg type="translation" xml:lang="en" source="#claude">Ibid. 5. 8. 10e. 18; Kirchenstaatsrecht 20f. — ECf, though clerical-hierarchical, does not mention the pope at all; s. s.v. 7. Cf. Böhmer <hi rend="italic">Ki. u. Staat</hi> 136. William I enforces Peter’s Pence at Wells; Davis <hi rend="italic">Reg. Agn.</hi> 187</seg></note>
      </div>
    </body>
