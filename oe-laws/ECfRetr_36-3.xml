      <div type="clause" n="36.3">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 36.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 36.3"><pb n="667" ed="#liebermann"/>Et tunc<ptr type="liebermannNote" n="10" target="#ECfRetr_36-3.lnote.la.10"/> primum <hi rend="bold">ostendat,</hi> quo<ptr type="liebermannNote" n="11" target="#ECfRetr_36-3.lnote.la.11"/> latrocinio et qua ratione interfectus sit<ptr type="liebermannNote" n="12" target="#ECfRetr_36-3.lnote.la.12"/>. <hi rend="bold">Quod</hi>si <hi rend="bold">re</hi>cognouerit, quod uiuus captus <hi rend="bold">sit,</hi> nominet iusticiarium<ptr type="liebermannNote" n="13" target="#ECfRetr_36-3.lnote.la.13"/> et iudices<ptr type="liebermannNote" n="14" target="#ECfRetr_36-3.lnote.la.14"/> et de uicinis testes<ptr type="liebermannNote" n="15" target="#ECfRetr_36-3.lnote.la.15"/> legales. <hi rend="bold">Qui</hi> si warantizauerint<ptr type="liebermannNote" n="16" target="#ECfRetr_36-3.lnote.la.16"/>, quod <hi rend="bold">recte</hi><ptr type="liebermannNote" n="17" target="#ECfRetr_36-3.lnote.la.17"/> sit<ptr type="liebermannNote" n="18" target="#ECfRetr_36-3.lnote.la.18"/> facta iusticia de <hi rend="bold">ipso secundum</hi> <hi rend="spaced">suum</hi><ptr type="liebermannNote" n="19" target="#ECfRetr_36-3.lnote.la.19"/> latrocinium, quietus erit<ptr type="liebermannNote" n="20" target="#ECfRetr_36-3.lnote.la.20"/> interfector <hi rend="bold">illius;</hi> ipsi <hi rend="bold">uero</hi> qui clamorem<ptr type="liebermannNote" n="21" target="#ECfRetr_36-3.lnote.la.21"/> fecerant, <hi rend="bold">emendent</hi> sua uadimonia.</ab>
        <note type="comparison" source="#liebermann" n="667"><label>printed alongside</label> <ref target="clause:ECf_36-3">ECf 36.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 667 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">der, wie nach</hi> Ine 21 <hi rend="italic">zum Beweise nähere, Todtschläger</hi></seg><seg type="translation" xml:lang="en" source="#claude">the killer, who, as by Ine 21, is nearer to the proof</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">gesteht</seg><seg type="translation" xml:lang="en" source="#claude">confesses</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">Urtheilfinder</seg><seg type="translation" xml:lang="en" source="#claude">judgement-finders</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Umstand des Gerichts, welches jenen hingerichtet hatte (wohl nicht Eideshelfer oder Zeugen, die gegen ihn ausgesagt hatten)</hi></seg><seg type="translation" xml:lang="en" source="#claude">the bystanders of the court which had executed him (probably not oath-helpers or witnesses who had testified against him)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Klagepfand, als Strafgeld dem Richter für falsche Klage verfallen</hi></seg><seg type="translation" xml:lang="en" source="#claude">the pledge given with the claim, forfeit to the judge as a fine for a false claim</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">tum <hi rend="italic">Lb Va; fehlt K, wo</hi> primo</seg><seg type="translation" xml:lang="en" source="#claude">tum Lb Va; lacking in K, where primo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">est <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">est Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">-ciam <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ciam Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">-cem <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cem Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">l. t. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">l. t. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">-rit <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rit Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">sit r. i. f. de illo <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit r. i. f. de illo Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">f. sit <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. sit Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">sit <hi rend="italic">Lb Va Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit Lb Va Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">uadimonia dederunt <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">uadimonia dederunt Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And then first let him show for what theft and for what reason he was killed. But if he acknowledges that he was taken alive, let him name the justiciar and the judges and lawful witnesses from the neighbours. If they warrant that justice was rightly done on him according to his theft, his slayer shall be quit; but those who had made the complaint, let them pay for (i.e. forfeit) their gages.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_36-3.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">350</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">tunc</hi><hi rend="superscript">10</hi> fehlt — <hi rend="italic">f. sit</hi><hi rend="superscript">18</hi> — <hi rend="italic">emendet s. u. Q.</hi><hi rend="superscript">22</hi> <hi rend="italic">i. def.</hi> vom Schreiber am Rande nachgetr. Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">tunc</hi><hi rend="superscript">10</hi> lacking — <hi rend="italic">f. sit</hi><hi rend="superscript">18</hi> — <hi rend="italic">emendet s. u. Q.</hi><hi rend="superscript">22</hi> <hi rend="italic">i. def.</hi> added in the margin by the scribe in Rs</seg></note>
      </div>
    </body>
