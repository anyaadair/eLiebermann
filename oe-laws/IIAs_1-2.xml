    <body>
      <div type="clause" n="1.2">
        <head><ref type="lawCode" target="law:IIAs">II As</ref> 1.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.2" corresp="#wit-h"><pb n="150" ed="#liebermann"/>Gif he hine þonne<ptr type="liebermannNote" n="5" target="#IIAs_1-2.lnote.oe.5"/> werian<ptr type="liebermannNote" n="9" target="#IIAs_1-2.lnote.oe.9-2"/> wille oððe oðfleo<ptr type="liebermannNote" n="10" target="#IIAs_1-2.lnote.oe.10-2"/>, ðonne ne sparige hine mon.<ptr type="liebermannNote" n="2" target="#IIAs_1-2.lnote.oe.2"/><ptr type="liebermannNote" n="***" target="#IIAs_1-2.lnote.oe.star3"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.2" corresp="#wit-b"><pb n="150" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="8" target="#IIAs_1-2.lnote.oe.8"/> he hine ðænne<ptr type="liebermannNote" n="9" target="#IIAs_1-2.lnote.oe.9"/> werian wylle<ptr type="liebermannNote" n="10" target="#IIAs_1-2.lnote.oe.10"/> oððe fleo<ptr type="liebermannNote" n="11" target="#IIAs_1-2.lnote.oe.11"/>, ðænne<ptr type="liebermannNote" n="9" target="#IIAs_1-2.lnote.oe.9"/> ne sparie<ptr type="liebermannNote" n="12" target="#IIAs_1-2.lnote.oe.12"/> hine man<ptr type="liebermannNote" n="13" target="#IIAs_1-2.lnote.oe.13"/> ær ðam<ptr type="liebermannNote" n="7" target="#IIAs_1-2.lnote.oe.7"/> [oþer<ptr type="liebermannNote" n="14" target="#IIAs_1-2.lnote.oe.14"/> . . . . .</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.2" corresp="#wit-so"><pb n="150" ed="#liebermann"/>Gif he hine þon<hi rend="italic">ne</hi> werian wille oððe fleon, þonne ne sparige hine mon ær ðam oder<ptr type="liebermannNote" n="3" target="#IIAs_1-2.lnote.oe.3"/> æfter.<ptr type="liebermannNote" n="4" target="#IIAs_1-2.lnote.oe.4"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.2" corresp="#wit-q"><pb n="151" ed="#liebermann"/>Si se<ptr type="liebermannNote" n="11" target="#IIAs_1-2.lnote.oe.11-2"/> uelit defendere uel pugnare<ptr type="liebermannNote" n="10" target="#IIAs_1-2.lnote.oe.10-3"/> (aufugere), tunc non<ptr type="liebermannNote" n="12" target="#IIAs_1-2.lnote.oe.12-2"/> parcatur ei postea.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="1.2" corresp="#wit-h"><pb n="126" ed="#attenborough"/>Gif he hine þonne<ptr type="editorNote" n="8" target="#IIAs_1-2.attnote.fn.8"/> werian wille oððe oðfleo<ptr type="editorNote" n="9" target="#IIAs_1-2.attnote.fn.9"/>, ðonne<ptr type="editorNote" n="8" target="#IIAs_1-2.attnote.fn.8"/> ne sparige hine mon<ptr type="editorNote" n="10" target="#IIAs_1-2.attnote.fn.10"/>.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="151" ed="#liebermann"/>Wenn jener [Ertappte<ptr type="liebermannNote" n="1" target="#IIAs_1-2.lnote.de.1"/>] sich aber wehren will oder entflieht (fliehen<ptr type="liebermannNote" n="2" target="#IIAs_1-2.lnote.de.2"/> <hi rend="italic">So Ld</hi>), schone man ihn nicht (vor dem [12. Jahre] oder später <hi rend="italic">B So</hi>).</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">But if that [caught person] is willing to defend himself or escapes (to flee, So Ld), let him not be spared (before [the 12th year] or later, B So).</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="127" ed="#attenborough"/>If, however, he [the thief] tries to defend himself, or if he takes to flight, he shall not be spared<ptr type="editorNote" n="1" target="#IIAs_1-2.attnote.n.1"/>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="418" ed="#whitelock"/>If, however, he [the thief] wishes to defend himself or to escape, he is not to be spared<ptr type="editorNote" n="3" target="#IIAs_1-2.whinote.n.3"/> whether younger or older [than twelve].</ab>
        <note type="editorial">In B, ‘oþer gif’ is written over an erasure on half a line in a 16th-c. hand; Liebermann supplies ‘efter’ from So and Quadr.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de">ðonne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðonne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de">wille <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wille Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de">fleon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fleon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de">sparige <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sparige Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de">mon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auf halber Zeile Rasur im</hi> 16. <hi rend="italic">Jh.:</hi> Oþer gif <hi rend="italic">B; ebenso Ld; ergänze</hi> efter <hi rend="italic">aus So Quadr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">an erasure over half a line in the 16th cent.: Oþer gif B; likewise Ld; supply efter from So Quadr.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.9-2" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rasur hinter</hi> i</seg><seg type="translation" xml:lang="en" source="#claude">erasure after i</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.10-2" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dahinter ein Buchst. radirt</hi></seg><seg type="translation" xml:lang="en" source="#claude">followed by an erased letter</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.star3" n="***" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> ær ðam oðer æfter <hi rend="italic">aus So, zum Theil B Quadr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">supply ær ðam oðer æfter from So, partly B Quadr.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.11-2" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">151</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> u. se <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Lond; u. se the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.10-3" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">151</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond;</hi> (<hi rend="italic">eingeklammertes</hi>) <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket Lond; (the bracketed words) the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.12-2" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">151</biblScope></bibl><seg type="original" xml:lang="de">ei po. n. pa. <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei po. n. pa. Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">am Rande</hi></seg><seg type="translation" xml:lang="en" source="#claude">in the margin</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_1-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">102</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Die H fehlenden letzten 4 Wörter sind zum Sinne notwendig: es handelt sich um den weniger als 12 Jahr alten; sonst wäre ja 1, 2 nur Wiederholung von 1. Derselbe Sinn VI 12, 1. [Nicht hierher gehört der Sinn <hi rend="italic">ær oððe æfter</hi> ‘früher oder später, jemals, immer’ im Epos <hi rend="italic">Crist</hi> 1692]</seg><seg type="translation" xml:lang="en" source="#claude">The last 4 words, lacking in H, are necessary to the sense: the case concerns one less than 12 years old; otherwise 1, 2 would merely repeat 1. The same sense VI 12, 1. [The sense of <hi rend="italic">ær oððe æfter</hi> ‘earlier or later, ever, always’ in the epic <hi rend="italic">Crist</hi> 1692 does not belong here]</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_1-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">102</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">In Q steht ausnahmsweise die Klasse Lond, der auch Hn 53, 1 <hi rend="italic">repugnet</hi> folgt, dem Original ferner. — Die Lesung B wird wiederholt VI 12, 1</seg><seg type="translation" xml:lang="en" source="#claude">In Q the class Lond, which Hn 53, 1 <hi rend="italic">repugnet</hi> also follows, exceptionally stands further from the original. — B's reading is repeated VI 12, 1</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIAs_1-2.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">207</biblScope></bibl><seg type="original" xml:lang="en">The words added in So (p. 126, n. 10) mean, according to Liebermann, ‘whether he is younger or older than twelve.’</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_1-2.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">126</biblScope></bibl><label>þonne</label><seg type="original" xml:lang="en"><hi rend="italic">ðænne</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_1-2.attnote.fn.9" n="9" source="#attenborough"><bibl><biblScope unit="page">126</biblScope></bibl><label>oðfleo</label><seg type="original" xml:lang="en"><hi rend="italic">fleo</hi>. B. <hi rend="italic">fleon</hi>. Ld, So.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_1-2.attnote.fn.10" n="10" source="#attenborough"><bibl><biblScope unit="page">126</biblScope></bibl><label>mon</label><seg type="original" xml:lang="en">B &amp; Ld add <hi rend="italic">ær ðam oþer</hi>. So, <hi rend="italic">ær ðam oder æfter</hi>.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IIAs_1-2.whinote.n.3" n="3" source="#whitelock"><bibl><biblScope unit="page">418</biblScope></bibl><label>spared</label><seg type="original" xml:lang="en">the rest, omitted in <hi rend="italic">Textus Roffensis,</hi> is in Otho B. xi.</seg></note>
      </div>
    </body>
  </text>
