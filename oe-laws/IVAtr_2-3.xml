    <body>
      <div type="clause" n="2.3">
        <head><ref type="lawCode" target="law:IVAtr">IV Atr</ref> 2.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2.3" corresp="#wit-q"><pb n="232" ed="#liebermann"/>In ebdomada pan̄<ptr type="liebermannNote" n="15" target="#IVAtr_2-3.lnote.oe.15"/> telon̄<ptr type="liebermannNote" n="16" target="#IVAtr_2-3.lnote.oe.16"/> III diebus: die Dominica et<ptr type="liebermannNote" n="17" target="#IVAtr_2-3.lnote.oe.17"/> die Martis et<ptr type="liebermannNote" n="17" target="#IVAtr_2-3.lnote.oe.17"/> die Iouis.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="2.3" corresp="#wit-q"><pb n="70" ed="#robertson"/>In ebdomada pan̄'<ptr type="editorNote" n="17" target="#IVAtr_2-3.robnote.fn.17"/> telon̄<ptr type="editorNote" n="18" target="#IVAtr_2-3.robnote.fn.18"/> III diebus: die Dominica et<ptr type="editorNote" n="19" target="#IVAtr_2-3.robnote.fn.19"/> die Martis et<ptr type="editorNote" n="19" target="#IVAtr_2-3.robnote.fn.19"/> die Iovis.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="233" ed="#liebermann"/>An drei Tagen der<ptr type="liebermannNote" n="1" target="#IVAtr_2-3.lnote.de.1"/> Woche Tuchzoll<ptr type="liebermannNote" n="2" target="#IVAtr_2-3.lnote.de.2"/> [Verkauf Fremder]: Sonntag<ptr type="liebermannNote" n="3" target="#IVAtr_2-3.lnote.de.3"/> und Dienstag und Donnerstag.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">On three days of the week cloth-toll [sale by foreigners]: Sunday and Tuesday and Thursday.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q"><pb n="71" ed="#robertson"/>On three days of the week toll for cloth<ptr type="editorNote" n="1" target="#IVAtr_2-3.robnote.n.1"/> [is paid]—on Sunday and Tuesday and Thursday<ptr type="editorNote" n="2" target="#IVAtr_2-3.robnote.n.2"/>.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_2-3.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">232</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so RT;</hi> panū <hi rend="italic">M</hi></seg><seg type="translation" xml:lang="en" source="#claude">so RT; panū M</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_2-3.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">232</biblScope></bibl><seg type="original" xml:lang="de">thelonium detur <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">thelonium detur Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_2-3.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">232</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in MHkBr</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_2-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">163</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Das Original hatte wohl *<hi rend="italic">claðtoll</hi>, was Q silbenweise übertrug.—<hi rend="italic">Vgl. Gl</hi> Tuch 2a</seg><seg type="translation" xml:lang="en" source="#claude">The original probably had *<hi rend="italic">claðtoll</hi>, which Q rendered syllable by syllable.—<hi rend="italic">Cf. Gl</hi> Tuch 2a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_2-3.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">163</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Das Original hatte wohl *<hi rend="italic">claðtoll</hi>, was Q silbenweise übertrug.—<hi rend="italic">Vgl. Gl</hi> Tuch 2a</seg><seg type="translation" xml:lang="en" source="#claude">The original probably had *<hi rend="italic">claðtoll</hi>, which Q rendered syllable by syllable.—<hi rend="italic">Cf. Gl</hi> Tuch 2a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_2-3.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">163</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Dafür hat <hi rend="italic">die Lune, Martis, Mercurii</hi> das Londoner Fremdenrecht 12. Jhs. bei Höhlbaum <hi rend="italic">Hans. Urkb</hi>. III S. 383; <hi rend="italic">s. Gl</hi> Sonntag 6b</seg><seg type="translation" xml:lang="en" source="#claude">Instead, the London law for foreigners of the 12th cent. has <hi rend="italic">die Lune, Martis, Mercurii</hi>, in Höhlbaum <hi rend="italic">Hans. Urkb</hi>. III p. 383; <hi rend="italic">see Gl</hi> Sonntag 6b</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_2-3.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="en">Liebermann suggests that the original may have read *<hi rend="italic">claðtoll</hi>.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_2-3.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="en">Cf. the twelfth-century regulation: <hi rend="italic">Mercatores qui Lond' redeunt et afferunt pannos de lino et de lana non debent vendere nisi tantum</hi> <hi rend="smallcaps">iii</hi> <hi rend="italic">diebus in ebdomada, scilicet lune</hi>, <hi rend="italic">martis</hi>, <hi rend="italic">mercurii</hi> (see <hi rend="italic">E.H.R.</hi>, 1902, p. 717).<lb type="paragraph"/>Sunday trading was forbidden in E. and G. 7; II As. 24, 1, but these decrees were afterwards abrogated, cf. IV As. 2; VI As. 10. In later times Sunday trading was again forbidden, cf. V Atr. 13, 1; VI, 22, 1; 44; VIII, 17; I Cn. 15. In the passage quoted above Monday takes the place of Sunday.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_2-3.robnote.fn.17" n="17" source="#robertson"><bibl><biblScope unit="page">70</biblScope></bibl><label>pan̄'</label><seg type="original" xml:lang="en">R, T; <hi rend="italic">panū</hi> M; <hi rend="italic">panum</hi> Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_2-3.robnote.fn.18" n="18" source="#robertson"><bibl><biblScope unit="page">70</biblScope></bibl><label>telon̄</label><seg type="original" xml:lang="en"><hi rend="italic">thelonium detur</hi> Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_2-3.robnote.fn.19" n="19" source="#robertson"><bibl><biblScope unit="page">70</biblScope></bibl><label>et</label><seg type="original" xml:lang="en">Om. M, Hk, Br.</seg></note>
      </div>
    </body>
