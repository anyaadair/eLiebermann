        <note type="liebermannNote" subtype="textual" xml:id="Af_5-4.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">-gyfen <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gyfen So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-4.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rasur vor</hi> an</seg><seg type="translation" xml:lang="en" source="#claude">erasure before an</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-4.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-4.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-4.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-4.lnote.oe.7-2" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">53</biblScope></bibl><seg type="original" xml:lang="de">tem <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">tem R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-4.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">53</biblScope></bibl><seg type="original" xml:lang="de">-iat <hi rend="italic">Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iat Brti</seg></note>
