      <div type="clause" n="19.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 19.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 19.2" corresp="#wit-lat"><pb n="559–560" ed="#liebermann"/>Omnium terrarum, quas rex in dominio<ptr type="liebermannNote" n="s" target="#Hn_19-2.lnote.oe.s"/> suo habet, socnam<ptr type="liebermannNote" n="1" target="#Hn_19-2.lnote.oe.1"/> pariter habet; quarundam uero terrarum (suarum<ptr type="liebermannNote" n="2" target="#Hn_19-2.lnote.oe.2"/>) maneria dedit, et<ptr type="liebermannNote" n="3" target="#Hn_19-2.lnote.oe.3"/> soknam simul<ptr type="liebermannNote" n="a" target="#Hn_19-2.lnote.oe.a"/> singularem uel<ptr type="liebermannNote" n="4" target="#Hn_19-2.lnote.oe.4"/> communem; quarundam terrarum maneria dedit, set socnam<ptr type="liebermannNote" n="1" target="#Hn_19-2.lnote.oe.1"/> sibi retinuit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 559–560 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_19-2.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">unausgeliehen</seg><seg type="translation" xml:lang="en" source="#claude">not granted out</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_19-2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">‘sowohl die dem König allein gehörige, wie die mit anderen getheilte’; <hi rend="italic">vgl.</hi> 9, 11. 20, 1. 21</seg><seg type="translation" xml:lang="en" source="#claude">‘both what belongs to the king alone and what is shared with others’; cf. 9, 11. 20, 1. 21</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_19-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">sokn. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sokn. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_19-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht in Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">not in Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_19-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">et — dedit <hi rend="italic">überspringt Sc Hg; ohne Hss. setzen nur</hi> sing. et com. <hi rend="italic">hinter</hi> retin. <hi rend="italic">Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Sc Hg skip et — dedit; Edd., without MS authority, place only sing. et com. after retin.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_19-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">et comu. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">et comu. Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_19-2.lnote.oe.a-2" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">319</biblScope></bibl><seg type="original" xml:lang="de">‘hohe und niedere Gerichtsbarkeit’ Maitland <hi rend="italic">Domesday</hi> 82; auch 21. 25, 1f. steht <hi rend="italic">communis causa</hi> in Ggs. zu Kriminaljustiz. Streiche I S. 560 Anm. <hi rend="italic">a</hi>, obwohl ihrem Inhalt auch Stubbs (<hi rend="italic">Lect</hi>. 158) beistimmt.—<hi rend="italic">et</hi>{3} <hi rend="italic">socnam simul</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">‘high and low jurisdiction’ Maitland <hi rend="italic">Domesday</hi> 82; in 21. 25, 1f. too, <hi rend="italic">communis causa</hi> stands in contrast to criminal justice. Delete I p. 560 n. <hi rend="italic">a</hi>, although Stubbs (<hi rend="italic">Lect</hi>. 158) also agrees with its content.—<hi rend="italic">et</hi>{3} <hi rend="italic">socnam simul</hi> Rs</seg></note>
      </div>
    </body>
