      <div type="clause" n="83.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 83.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 83.1" corresp="#wit-lat"><pb n="599" ed="#liebermann"/>Unicuique licet se defendere<ptr type="liebermannNote" n="i" target="#Hn_83-1.lnote.oe.i"/>, si quis eum assaliat<ptr type="liebermannNote" n="37" target="#Hn_83-1.lnote.oe.37"/>, in omni loco uel negotio: excepto contra dominum, quem tollerandum<ptr type="liebermannNote" n="k" target="#Hn_83-1.lnote.oe.k"/><ptr type="liebermannNote" n="38" target="#Hn_83-1.lnote.oe.38"/>, non<ptr type="liebermannNote" n="l" target="#Hn_83-1.lnote.oe.l"/> occidendum, iugiter<ptr type="liebermannNote" n="m" target="#Hn_83-1.lnote.oe.m"/> ac salubriter frequentamus aduertendum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 599 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-1.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 80, 7<hi rend="italic">b</hi>. 87, 6. 88, 4; 19; <hi rend="italic">vgl.</hi> 83, 6</seg><seg type="translation" xml:lang="en" source="#claude">as 80, 7<hi rend="italic">b</hi>. 87, 6. 88, 4; 19; cf. 83, 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-1.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 43, 9</seg><seg type="translation" xml:lang="en" source="#claude">cf. 43, 9</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-1.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 75, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. 75, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-1.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">diese Phrase auch</hi> 6, 2<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">this phrase also 6, 2<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-1.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">-alli. <hi rend="italic">Co Or</hi>; -ailli. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-alli. Co Or; -ailli. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-1.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus the MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Vassallität 8b. c; Notwehr 7c; Levita <hi rend="italic">Recht der Notwehr</hi> 99 mit Recht gegen Bar (<hi rend="italic">Beweisurteil</hi> 80), der meint, nur Verteidigung gegen <hi rend="spaced">Fehde</hi> zessiere vor dem Herrn.—Nicht Notwehr betrifft 83, 1a.—Der kanonistische Ausdruck <hi rend="italic">tolerandum</hi> auch <hi rend="italic">o</hi>. 5, 18b—83, 1a <hi rend="italic">-lentem</hi>{39}; der Nachsatz fehlt auch <hi rend="italic">o</hi>. 70, 10</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Vassallität 8b. c; Notwehr 7c; Levita <hi rend="italic">Recht der Notwehr</hi> 99, rightly against Bar (<hi rend="italic">Beweisurteil</hi> 80), who thinks that only defence against <hi rend="italic">feud</hi> ceases to apply in the case of the lord.—83, 1a does not concern self-defence.—The canonistic expression <hi rend="italic">tolerandum</hi> also <hi rend="italic">above</hi> 5, 18b—83, 1a <hi rend="italic">-lentem</hi>{39}; the apodosis is also missing <hi rend="italic">above</hi> 70, 10</seg></note>
      </div>
