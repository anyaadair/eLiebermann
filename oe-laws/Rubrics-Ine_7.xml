      <div type="clause" n="7">
        <head>Ine Rb 7</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7" corresp="#wit-e"><pb n="20" ed="#liebermann"/>LI. Be stale.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7" corresp="#wit-ot-frag"><pb n="20" ed="#liebermann"/>…</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7" corresp="#wit-g-prol"><pb n="20" ed="#liebermann"/>LI. Be stale.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7" corresp="#wit-h"><pb n="21" ed="#liebermann"/>LI. Be stale.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7" corresp="#wit-q"><pb n="21" ed="#liebermann"/>De furto.<ptr type="liebermannNote" n="13" target="#Rubrics-Ine_7.lnote.oe.13"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="200" ed="#jurasinski-and-oliver"/>LI Be stale</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="200" ed="#jurasinski-and-oliver"/>Be stale</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="21" ed="#liebermann"/>Vom Diebstahl.<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_7.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of theft.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="201" ed="#jurasinski-and-oliver"/>Concerning stealing</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="201" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_7.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">sciente vel nesciente familia <hi rend="italic">fügt zu Hk;</hi> viri, unde uxor nesciat neque liberi <hi rend="italic">fügt zu Br.</hi> Qua etate cavendum sit a furto [est de f. <hi rend="italic">Br</hi>] <hi rend="italic">fügt zu Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">sciente vel nesciente familia added by Hk; viri, unde uxor nesciat neque liberi added by Br. Qua etate cavendum sit a furto [est de f. Br] added by Hk Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_7.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Q spät. Rez. gibt aus seinem Text Rb auch zu 7, 2</seg><seg type="translation" xml:lang="en" source="#claude">The later recension of Q also supplies, from its own text, a Rb for 7, 2</seg></note>
      </div>
