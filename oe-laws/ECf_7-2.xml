  <text>
    <body>
      <div type="clause" n="7.2">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 7.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 7.2"><pb n="632" ed="#liebermann"/><ptr type="liebermannNote" n="9" target="#ECf_7-2.lnote.la.9"/>Qui uaccas<ptr type="liebermannNote" n="10" target="#ECf_7-2.lnote.la.10"/> plures habuerit, uitulum decimum; qui unam uel duas<ptr type="liebermannNote" n="11" target="#ECf_7-2.lnote.la.11"/>, de uitulis<ptr type="liebermannNote" n="12" target="#ECf_7-2.lnote.la.12"/> singulis obolos<ptr type="liebermannNote" n="13" target="#ECf_7-2.lnote.la.13"/> singulos.</ab>
        <note type="comparison" source="#liebermann" n="632"><label>printed alongside</label> <ref target="clause:ECfRetr_7-2">ECf retr 7.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 632 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-2.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">Et qui <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et qui Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-2.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">p. u. <hi rend="italic">Hr Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. u. Hr Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-2.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">habuerit <hi rend="italic">fügt zu Ad Do No</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad Do No add habuerit</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-2.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt S;</hi> s. u. <hi rend="italic">Hr Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in S; s. u. Hr Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-2.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">s. o. <hi rend="italic">Hk Hr;</hi> singulum obolum <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. o. Hk Hr; singulum obolum Ad Do</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">He who has several cows, the tenth calf; he who has one or two, for each calf a halfpenny.</ab>
      </div>
    </body>
  </text>
