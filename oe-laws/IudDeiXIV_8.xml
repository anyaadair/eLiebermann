    <body>
      <div type="clause" n="8">
        <head><ref type="lawCode" target="law:IudDeiXIV">Iud Dei XIV</ref> 8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIV 8" corresp="#wit-lat"><pb n="426" ed="#liebermann"/>(Item<ptr type="liebermannNote" n="31" target="#IudDeiXIV_8.lnote.oe.31"/>) Benedictio<ptr type="liebermannNote" n="32" target="#IudDeiXIV_8.lnote.oe.32"/> panis et casei. Deus<ptr type="liebermannNote" n="33" target="#IudDeiXIV_8.lnote.oe.33"/> angelorum, Deus<ptr type="liebermannNote" n="34" target="#IudDeiXIV_8.lnote.oe.34"/> archangelorum, Deus<ptr type="liebermannNote" n="35" target="#IudDeiXIV_8.lnote.oe.35"/> patriarcharum<ptr type="liebermannNote" n="36" target="#IudDeiXIV_8.lnote.oe.36"/>, Deus prophetarum, pariter et apostolorum, Deus martyrum, Deus confessorum<ptr type="liebermannNote" n="37" target="#IudDeiXIV_8.lnote.oe.37"/>, Deus uirginum, Deus pater domini nostri Iesu Christi, qui in mundi exordio hominem ad imaginem et similitudinem tuam propria uoluntate creasti<ptr type="liebermannNote" n="38" target="#IudDeiXIV_8.lnote.oe.38"/> et uetuisti, ut non tangeret pomum, quo transgresso, pręuaricationis tam diu poenas luit<ptr type="liebermannNote" n="39" target="#IudDeiXIV_8.lnote.oe.39"/>, quousque inmensa tua diuinitas in homine assumpto tulit e uinculo seruum restituitque genus humanum per<ptr type="liebermannNote" n="40" target="#IudDeiXIV_8.lnote.oe.40"/> tuam clementiam, rogo<ptr type="liebermannNote" n="41" target="#IudDeiXIV_8.lnote.oe.41"/>, inclina, Domine<ptr type="liebermannNote" n="42" target="#IudDeiXIV_8.lnote.oe.42"/>, aurem tuam ad preces humilitatis nostrae et ostende nobis misericordiam tuam,</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Gen. 1, 27;; 2, 17</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 426 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur Vt Tr; fehlt übrigen</hi></seg><seg type="translation" xml:lang="en" source="#claude">only Vt Tr; omitted in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Tr Mg Ei;</hi> Oratio <hi rend="italic">Ma; fehlt Vt Bb</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Tr Mg Ei; Oratio Ma; omitted in Vt Bb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus vier ferneren Hss., deren Varianten ich fortlasse, druckt</hi> 8 <hi rend="italic">Zeumer</hi> 699₈</seg><seg type="translation" xml:lang="en" source="#claude">Zeumer 699₈ prints 8 from four further MSS, whose variants I omit</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Bb</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Bb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de">D. p. <hi rend="italic">fehlt Bb</hi></seg><seg type="translation" xml:lang="en" source="#claude">D. p. omitted in Bb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de">prop., D. pa. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">prop., D. pa. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Vt;</hi> et <hi rend="italic">ohne</hi> Deus <hi rend="italic">Hss. Zeumer</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added in Vt; et without Deus MSS Zeumer</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Vt Tr Mg Ma;</hi> <hi rend="spaced">formasti preceptumque dedisti ut uetitum non</hi> <hi rend="italic">Zeumer</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Vt Tr Mg Ma; <hi rend="italic">formasti preceptumque dedisti ut uetitum non</hi> Zeumer</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de">p. t. c. <hi rend="italic">fehlt Bb</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. t. c. omitted in Bb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">regno</hi> <hi rend="italic">Bb Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">regno</hi> Bb Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr Bb;</hi> ad me <hi rend="italic">fügt zu Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr Bb; ad me added in Tr</seg></note>
      </div>
    </body>
