        <note type="liebermannNote" subtype="textual" xml:id="ICn_17.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">297</biblScope></bibl><seg type="original" xml:lang="de">iu. <hi rend="italic">K</hi>; ex. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">iu. K; ex. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_17.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">297</biblScope></bibl><seg type="original" xml:lang="de">i. l. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. l. K</seg></note>
