        <note type="editorNote" subtype="footnote" xml:id="Ine_39.attnote.fn.11" n="11" source="#attenborough"><bibl><biblScope unit="page">48</biblScope></bibl><label>geahsige</label><seg type="original" xml:lang="en"><hi rend="italic">geacsige</hi>. B. <hi rend="italic">geaxie</hi>. H.</seg></note>
