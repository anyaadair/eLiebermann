        <head><ref type="lawCode" target="law:Hn">Hn</ref> 57.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 57.7" corresp="#wit-lat"><pb n="576" ed="#liebermann"/>Quodsi de manifestis<ptr type="liebermannNote" n="o" target="#Hn_57-7.lnote.oe.o"/> et confessis agatur, ubi quis peccauit, ibi rectum faciat, uel de<ptr type="liebermannNote" n="25" target="#Hn_57-7.lnote.oe.25"/> suo<ptr type="liebermannNote" n="p" target="#Hn_57-7.lnote.oe.p"/> ad ualens forisfacti pro inborgo<ptr type="liebermannNote" n="q" target="#Hn_57-7.lnote.oe.q"/> retineatur<ptr type="liebermannNote" n="26" target="#Hn_57-7.lnote.oe.26"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 576 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-7.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 57, 4; 6</seg><seg type="translation" xml:lang="en" source="#claude">cf. 57, 4; 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-7.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">seiner Habe; <hi rend="italic">vgl.</hi> 41, 14</seg><seg type="translation" xml:lang="en" source="#claude">his property; cf. 41, 14</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-7.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ebenso</hi> 82, 2<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">likewise 82, 2<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-7.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">de s. ad u. <hi rend="italic">fehlt K Co Or Gi; statt dessen</hi> non habet <hi rend="italic">Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">de s. ad u. missing K Co Or Gi; instead non habet Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-7.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">-antur <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-antur Sc Hg</seg></note>
