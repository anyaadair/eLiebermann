        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 17" corresp="#wit-lat"><pb n="404" ed="#liebermann"/>Antiphona<ptr type="liebermannNote" n="1" target="#IudDeiI_17.lnote.oe.1"/> post communionem. Iustus<ptr type="liebermannNote" n="2" target="#IudDeiI_17.lnote.oe.2"/> Dominus et iustitiam<ptr type="liebermannNote" n="3" target="#IudDeiI_17.lnote.oe.3"/> dilexit, aequitatem<ptr type="liebermannNote" n="4" target="#IudDeiI_17.lnote.oe.4"/> uidit<ptr type="liebermannNote" n="5" target="#IudDeiI_17.lnote.oe.5"/> uultus eius.</ab>
