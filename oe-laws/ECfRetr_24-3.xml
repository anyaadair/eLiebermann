      <div type="clause" n="24.3">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 24.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 24.3"><pb n="650" ed="#liebermann"/>Et si dominus, in cuius terra inuentum est<ptr type="liebermannNote" n="1" target="#ECfRetr_24-3.lnote.la.1"/>, non habet consuetudines suas, scilicet<ptr type="liebermannNote" n="2" target="#ECfRetr_24-3.lnote.la.2"/> saca<ptr type="liebermannNote" n="3" target="#ECfRetr_24-3.lnote.la.3"/> et soca, omnia <hi rend="bold">tradat</hi><ptr type="liebermannNote" n="4" target="#ECfRetr_24-3.lnote.la.4"/> prefecto<ptr type="liebermannNote" n="5" target="#ECfRetr_24-3.lnote.la.5"/> hundredi, si<ptr type="liebermannNote" n="6" target="#ECfRetr_24-3.lnote.la.6"/> habere uoluerit, cum bonis testibus.</ab>
        <note type="comparison" source="#liebermann" n="650"><label>printed alongside</label> <ref target="clause:ECf_24-3">ECf 24.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 650 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-3.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">private Gerichtsbarkeit, <hi rend="italic">hier im Gegensatz zu</hi> hundred; <hi rend="italic">doch besass mancher Baron eine Hundertschaft ganz</hi></seg><seg type="translation" xml:lang="en" source="#claude">private jurisdiction, here in contrast to hundred; but many a baron possessed a whole hundred</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-3.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">fuerit <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">fuerit Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-3.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-3.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">sacha et socha <hi rend="italic">Lb Va K;</hi> sach’ et soch’ <hi rend="italic">Cb;</hi> sake et soke <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">sacha et socha Lb Va K; sach’ et soch’ Cb; sake et soke Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-3.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">tradet <hi rend="italic">Cb Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">tradet Cb Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-3.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">h. p. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. p. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-3.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">c. b. t., si h. u. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. b. t., si h. u. Cb</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And if the lord in whose land it was found does not have his customs, namely sake and soke, let him hand over everything to the reeve of the hundred, if he wishes to have it, with good witnesses.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-3.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">sache</hi><hi rend="superscript">8</hi> <hi rend="italic">et soche o. tradet</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">sache</hi><hi rend="superscript">8</hi> <hi rend="italic">et soche o. tradet</hi> Rs</seg></note>
      </div>
    </body>
