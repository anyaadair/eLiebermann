      <div type="clause" n="9.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 9.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 9.1"><pb n="633" ed="#liebermann"/>Barones <hi rend="bold">uero,</hi> qui suam habent<ptr type="liebermannNote" n="4" target="#ECfRetr_9-1.lnote.la.4"/> curiam de suis<ptr type="liebermannNote" n="28" target="#ECfRetr_9-1.lnote.la.28"/> hominibus, uideant ut <hi rend="bold">sic</hi> de eis agant<ptr type="liebermannNote" n="29" target="#ECfRetr_9-1.lnote.la.29"/>, quatinus erga Deum<ptr type="liebermannNote" n="30" target="#ECfRetr_9-1.lnote.la.30"/> reatum non incurrant et<ptr type="liebermannNote" n="31" target="#ECfRetr_9-1.lnote.la.31"/> regem non offendant.</ab>
        <note type="comparison" source="#liebermann" n="633"><label>printed alongside</label> <ref target="clause:ECf_9-1">ECf 9.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 633 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9-1.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9-1.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">ho. su. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">ho. su. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9-1.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">faciant <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">faciant Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9-1.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">Dominum <hi rend="italic">Dc K Or</hi> [<hi rend="italic">vgl.</hi> ECf. 32 A 15]</seg><seg type="translation" xml:lang="en" source="#claude">Dominum Dc K Or [cf. ECf. 32 A 15]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9-1.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">nec r. o. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">nec r. o. Hv</seg></note>
      </div>
