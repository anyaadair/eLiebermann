    <body>
      <div type="clause" n="I Cn 6">
        <head>Quadr Rb I Cn 6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Rb I Cn 6" corresp="#wit-lat"><pb n="536" ed="#liebermann"/>Exortatio<ptr type="liebermannNote" n="7" target="#Quadr-Rb_I-Cn-6.lnote.la.7"/> singulorum et maxime prelatorum, ut<ptr type="liebermannNote" n="8" target="#Quadr-Rb_I-Cn-6.lnote.la.8"/> legitime<ptr type="liebermannNote" n="9" target="#Quadr-Rb_I-Cn-6.lnote.la.9"/> uiuant et in oratione perseuerent pro<ptr type="liebermannNote" n="10" target="#Quadr-Rb_I-Cn-6.lnote.la.10"/> necesse<ptr type="liebermannNote" n="11" target="#Quadr-Rb_I-Cn-6.lnote.la.11"/> communi, pro dilectione Dei<ptr type="liebermannNote" n="12" target="#Quadr-Rb_I-Cn-6.lnote.la.12"/>, pro<ptr type="liebermannNote" n="a" target="#Quadr-Rb_I-Cn-6.lnote.la.fn.a"/><ptr type="liebermannNote" n="13" target="#Quadr-Rb_I-Cn-6.lnote.la.13"/> timore penarum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 536 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">An exhortation to each one, and above all to prelates, that they live lawfully and persevere in prayer for the common need, for the love of God, for fear of punishments.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-6.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">De exhortatione <hi rend="italic">LondBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">De exhortatione LondBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-6.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">ut — Dei <hi rend="italic">fehlt R</hi></seg><seg type="translation" xml:lang="en" source="#claude">ut — Dei lacking in R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-6.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">legitt. <hi rend="italic">stets T;</hi> bene <hi rend="italic">Br, wo</hi> et — sacerdotum <hi rend="italic">fehlt</hi></seg><seg type="translation" xml:lang="en" source="#claude">legitt. always T; bene Br, where et — sacerdotum is lacking</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-6.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">pro — penarum <hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">pro — penarum lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-6.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">necessitate <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">necessitate Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-6.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">et proximi <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Lond adds et proximi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-6.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus dem Angelsächsischen Texte Cnuts</hi></seg><seg type="translation" xml:lang="en" source="#claude">from the Old English text of Cnut</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-6.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">et pro <hi rend="italic">T;</hi> De tim. p. <hi rend="italic">zu</hi> 6, 3 <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">et pro T; De tim. p. at 6, 3 R</seg></note>
      </div>
