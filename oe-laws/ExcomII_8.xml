        <head><ref type="lawCode" target="law:ExcomII">Excom II</ref> 8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom II 8" corresp="#wit-lat"><ptr type="liebermannNote" n="m" target="#ExcomII_8.lnote.oe.m"/><pb n="434" ed="#liebermann"/>Et sicut<ptr type="liebermannNote" n="n" target="#ExcomII_8.lnote.oe.n"/> hee lucerne de manibus nostris proiecte hodie extinguuntur<ptr type="liebermannNote" n="32" target="#ExcomII_8.lnote.oe.32"/>, sic eius<ptr type="liebermannNote" n="33" target="#ExcomII_8.lnote.oe.33"/> lucerna in eternum<ptr type="liebermannNote" n="l" target="#ExcomII_8.lnote.oe.l"/> extinguatur,</ab>
