      <div type="clause" n="II Cn">
        <head>Quadr I II Cn</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr I II Cn" corresp="#wit-lat"><pb n="538" ed="#liebermann"/><ptr type="liebermannNote" n="65" target="#Quadr-I_II-Cn.lnote.la.65"/>Edictum<ptr type="liebermannNote" n="d" target="#Quadr-I_II-Cn.lnote.la.fn.d"/> regis in opprimendis uitiis et augendis uirtutibus. Hæc est institutio legum secularium, — — uelle sit. Amen; <hi rend="italic">s. o. S</hi>. 309—371.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 538 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-I_II-Cn.lnote.la.65" n="65" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so nur R;</hi> Institutio secularium legum <hi rend="italic">roth Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus only R; Institutio secularium legum in red Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-I_II-Cn.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">benutzt</hi> Arg. 3; Rubr. II Pr., <hi rend="italic">o. S.</hi> 532; 536</seg><seg type="translation" xml:lang="en" source="#claude">used in Arg. 3; Rubr. II Pr., above p. 532; 536</seg></note>
