      <div type="clause" n="11.4">
        <head><ref type="lawCode" target="law:Af">Af</ref> 11.4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11.4" corresp="#wit-e"><pb n="56" ed="#liebermann"/>Gif hie<ptr type="liebermannNote" n="11" target="#Af_11-4.lnote.oe.11"/> mon teo, geladiege<ptr type="liebermannNote" n="17" target="#Af_11-4.lnote.oe.17"/> hie<ptr type="liebermannNote" n="11" target="#Af_11-4.lnote.oe.11"/> be sixtegum hida<ptr type="liebermannNote" n="18" target="#Af_11-4.lnote.oe.18"/>, oððe ðolige be healfre<ptr type="liebermannNote" n="19" target="#Af_11-4.lnote.oe.19"/> þære bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11.4" corresp="#wit-h"><pb n="56" ed="#liebermann"/>Gif mon<ptr type="liebermannNote" n="1" target="#Af_11-4.lnote.oe.1"/> teo hy<ptr type="liebermannNote" n="10" target="#Af_11-4.lnote.oe.10"/>, geladige hy<ptr type="liebermannNote" n="4" target="#Af_11-4.lnote.oe.4"/> be LX hida, oþþe ðolie be healfre ðære bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11.4" corresp="#wit-b-no-prol"><pb n="57" ed="#liebermann"/>Gyf hi man téo, gehladige<ptr type="liebermannNote" n="5" target="#Af_11-4.lnote.oe.5"/> hí be sixtigu<hi rend="italic">m</hi> hidu<hi rend="italic">m</hi>, oððe þolie be healfere bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="11.4" corresp="#wit-q"><pb n="57" ed="#liebermann"/>Si accusetur inde, adlegiet se per LX hidas, uel dimidium emendationis amittat.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="70" ed="#attenborough"/>Gif hie mon teo, geladiege<ptr type="editorNote" n="11" target="#Af_11-4.attnote.fn.11"/> hie be sixtegum hida<ptr type="editorNote" n="12" target="#Af_11-4.attnote.fn.12"/>, oððe ðolige<ptr type="editorNote" n="13" target="#Af_11-4.attnote.fn.13"/> be healfre þære bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="13.4" corresp="#wit-e"><pb n="308" ed="#jurasinski-and-oliver"/>Gif he mon teo, geladie (ge)hie be sixtegum hida, oððe ðolige be healfe þære bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="57" ed="#liebermann"/>Wenn sie [solch früherer<ptr type="liebermannNote" n="1" target="#Af_11-4.lnote.de.1"/> Unkeuschheit] geziehen wird, reinige sie sich mit [Eid von] 60<ptr type="liebermannNote" n="2" target="#Af_11-4.lnote.de.2"/> Hiden, oder gehe [des Empfangs] jener Busse um die Hälfte verlustig.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If she is accused [of such earlier unchastity], let her clear herself with [an oath of] 60 hides, or lose half of that compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="71" ed="#attenborough"/>If she is accused [of having previously lain with a man], she shall clear herself by [an oath of] 60 hides, or lose half the compensation due to her.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="309" ed="#jurasinski-and-oliver"/>If she is accused [of having lain with another man], let her clear herself by [an oath in the value of] sixty hides, or forfeit half the compensation.</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="309"><label>cf. (term)</label> <ref target="clause:Af_El-to-28">Af El 28</ref> <quote>The term geladian only appears in legal texts; cf. MP §28.</quote></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="309"><label>cf.</label> <ref target="clause:Af_18-1">Af 18.1</ref> <quote>Cf. Alfred §21.</quote></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="309"><label>cf.</label> <ref target="clause:Ine_14">Ine 14</ref> <quote>The practice is otherwise limited to the laws of Ine [...] (See Ine §14 and n.)</quote></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="251"><ref target="clause:Af_El-to-28">Af El 28</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-4.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">hi <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hi Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-4.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">geladie <hi rend="italic">So;</hi> geladige <hi rend="italic">Ld;</hi> geladie ge (<hi rend="italic">statt</hi> geladige?) <hi rend="italic">E</hi></seg><seg type="translation" xml:lang="en" source="#claude">geladie So; geladige Ld; geladie ge (for geladige?) E</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-4.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">hidum <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hidum Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-4.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">healfne <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">healfne So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-4.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-4.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">am Rande</hi></seg><seg type="translation" xml:lang="en" source="#claude">in the margin</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-4.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-4.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">57</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_11-4.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">54</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Gegenklage (<hi rend="italic">s. d. Gl</hi>) behauptet nicht etwa die freiwillige Preisgabe des Mädchens im jetzigen Falle, sondern Verlust ihrer Jungfrauschaft (<hi rend="italic">s. d. Gl</hi> 3) in einem früheren</seg><seg type="translation" xml:lang="en" source="#claude">The countercharge (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi>) does not, say, allege the girl’s voluntary surrender in the present case, but the loss of her virginity (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 3) on an earlier occasion</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_11-4.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">54</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Eideshufen 10. Die letzten Worte wiederholen 11, 3</seg><seg type="translation" xml:lang="en" source="#claude">See <hi rend="italic">Gl</hi> Eideshufen 10. The last words repeat 11, 3</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_11-4.attnote.fn.11" n="11" source="#attenborough"><bibl><biblScope unit="page">70</biblScope></bibl><label>geladiege</label><seg type="original" xml:lang="en"><hi rend="italic">gehladige</hi>. B. <hi rend="italic">geladige</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_11-4.attnote.fn.12" n="12" source="#attenborough"><bibl><biblScope unit="page">70</biblScope></bibl><label>hida</label><seg type="original" xml:lang="en"><hi rend="italic">hidum</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_11-4.attnote.fn.13" n="13" source="#attenborough"><bibl><biblScope unit="page">70</biblScope></bibl><label>ðolige</label><seg type="original" xml:lang="en"><hi rend="italic">ðolie</hi>. B, H.</seg></note>
      </div>
