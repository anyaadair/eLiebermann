    <body>
      <div type="clause" n="14.4">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 14.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 14.4" corresp="#wit-lat"><pb n="559" ed="#liebermann"/>Et thaini<ptr type="liebermannNote" n="14" target="#Hn_14-4.lnote.oe.14"/> regis releuacio cum Dacis, qui socam suam<ptr type="liebermannNote" n="e" target="#Hn_14-4.lnote.oe.e"/> habeat<ptr type="liebermannNote" n="15" target="#Hn_14-4.lnote.oe.15"/>: III<ptr type="liebermannNote" n="d" target="#Hn_14-4.lnote.oe.d"/> libre.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 559 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_14-4.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> IIII <hi rend="italic">aus Cnut</hi></seg><seg type="translation" xml:lang="en" source="#claude">read IIII, from Cnut</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_14-4.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Angelsächs. Text</hi></seg><seg type="translation" xml:lang="en" source="#claude">from the Anglo-Saxon text</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_14-4.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">iusticiam habeat, duo equi, unus cum sella alius <hi rend="italic">fügt ein</hi> [<hi rend="italic">eine folgende Zeile voraufnehmend</hi>], <hi rend="italic">will es aber gestrichen haben,</hi> Uacat <hi rend="italic">über die Zeile setzend, Schreiber Sc; letzteres Wort ersetzt durch</hi> citra <hi rend="italic">und druckt die Zeile im Text Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">iusticiam habeat, duo equi, unus cum sella alius inserted [anticipating a following line] by the scribe of Sc, who however wants it deleted, writing Uacat above the line; Wh replaces the latter word by citra and prints the line in the text</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_14-4.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">-ant <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ant Wh</seg></note>
      </div>
