    <body>
      <div type="clause" n="18.2">
        <head><ref type="lawCode" target="law:Af">Af</ref> 18.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="18.2" corresp="#wit-e"><pb n="60" ed="#liebermann"/>Gif hio<ptr type="liebermannNote" n="*" target="#Af_18-2.lnote.oe.star"/> sie syxhyndu<ptr type="liebermannNote" n="2" target="#Af_18-2.lnote.oe.2"/>, hundteontig scill. geselle þa<hi rend="italic">m</hi> byrgean.<ptr type="liebermannNote" n="3" target="#Af_18-2.lnote.oe.3"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="18.2" corresp="#wit-h"><pb n="60" ed="#liebermann"/>Gif heo<ptr type="liebermannNote" n="3" target="#Af_18-2.lnote.oe.3-2"/> sy<ptr type="liebermannNote" n="1" target="#Af_18-2.lnote.oe.1"/> syxhynde, C scll' gebete ðam þe<ptr type="liebermannNote" n="4" target="#Af_18-2.lnote.oe.4"/> hit gebyrie.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="18.2" corresp="#wit-b-no-prol"><pb n="60" ed="#liebermann"/>Gyf héo sy sixhynde, hundteontig scill' g<hi rend="italic">e</hi>sylle ðam<ptr type="liebermannNote" n="1" target="#Af_18-2.lnote.oe.1-2"/> to gebyrian.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="18.2" corresp="#wit-q"><pb n="61" ed="#liebermann"/>Si est<ptr type="liebermannNote" n="4" target="#Af_18-2.lnote.oe.4-2"/> VI hynda, C solid. emendetur marito.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="72" ed="#attenborough"/>Gif hio<ptr type="editorNote" n="15" target="#Af_18-2.attnote.fn.15"/> sie syxhyndu, hundteontig scill. geselle<ptr type="editorNote" n="16" target="#Af_18-2.attnote.fn.16"/> þam byrgean<ptr type="editorNote" n="17" target="#Af_18-2.attnote.fn.17"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="21.1" corresp="#wit-e"><pb n="312" ed="#jurasinski-and-oliver"/>Gif hio sie syxhynda, hundteonig scill geselle þa<hi rend="italic">m</hi> byrgean.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="61" ed="#liebermann"/>Wenn sie 600 [Sch. Wergeld werth] ist, gebe sie<ptr type="liebermannNote" n="1" target="#Af_18-2.lnote.de.1"/> jenem Bürgen 100 Schilling.<ptr type="liebermannNote" n="2" target="#Af_18-2.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If she is [worth] 600 [shillings’ wergeld], let her give that surety 100 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="73" ed="#attenborough"/>If her wergeld is 600 shillings, she shall pay 100 shillings to the surety [of the marriage].</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="412" ed="#whitelock"/>If she is a woman of a six-hundred wergild, 100 shillings are to be given to the surety.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="313" ed="#jurasinski-and-oliver"/>If she is [of] 600 [rank], let her compensate the guarantor with 100 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_18-2.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">þonne <hi rend="italic">fügt zu So</hi></seg><seg type="translation" xml:lang="en" source="#claude">þonne added by So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_18-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">six. <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">six. So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_18-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">bir. <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">bir. So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_18-2.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_18-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_18-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">þe h. g. <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">þe h. g. on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_18-2.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">61</biblScope></bibl><seg type="original" xml:lang="de">enim <hi rend="italic">R T</hi></seg><seg type="translation" xml:lang="en" source="#claude">enim R T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_18-2.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">ðe hit <hi rend="italic">im</hi> 16. <hi rend="italic">Jh. zugefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðe hit added in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_18-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">55</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘der Verführer’, wie Price-Thorpe auch 18, 3 versteht</seg><seg type="translation" xml:lang="en" source="#claude">Not ‘the seducer’, as Price-Thorpe understand it, also in 18, 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_18-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">55</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Stand 21 s. t</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Stand 21 s. t</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_18-2.attnote.fn.15" n="15" source="#attenborough"><bibl><biblScope unit="page">72</biblScope></bibl><label>hio</label><seg type="original" xml:lang="en"><hi rend="italic">hio þonne</hi>. So.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_18-2.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">72</biblScope></bibl><label>geselle</label><seg type="original" xml:lang="en"><hi rend="italic">gebete</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_18-2.attnote.fn.17" n="17" source="#attenborough"><bibl><biblScope unit="page">72</biblScope></bibl><label>byrgean</label><seg type="original" xml:lang="en"><hi rend="italic">þe hit gebyrie</hi>. H. <hi rend="italic">to gebyrian</hi>. B.</seg><note type="remark" resp="#claude">The number 17 is printed 2 times on the page (18.2, 18.3), with one footnote.</note></note>
      </div>
    </body>
