        <head><ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 3.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 3.3" corresp="#wit-du" ana="#glossed"><pb n="410" ed="#liebermann"/><seg type="glossed"><seg type="base">Te,</seg><gloss xml:lang="ang">Ðec,</gloss></seg> <seg type="glossed"><seg type="base">domine</seg><gloss xml:lang="ang">driht<hi rend="italic">en</hi></gloss></seg> <seg type="glossed"><seg type="base">Deus,</seg><gloss xml:lang="ang">God,</gloss></seg> <seg type="glossed"><seg type="base">supplices</seg><gloss xml:lang="ang">eðmodlic<hi rend="italic">e</hi> <hi rend="italic">uel<ptr type="liebermannNote" n="11" target="#IudDeiIV_3-3.lnote.oe.11"/></hi></gloss></seg> <seg type="glossed"><seg type="base">deprecamur,</seg><gloss xml:lang="ang">ve biddað,</gloss></seg> <seg type="glossed"><seg type="base">qui</seg><gloss xml:lang="ang">ða<ptr type="liebermannNote" n="12" target="#IudDeiIV_3-3.lnote.oe.12"/> ðe</gloss></seg> <seg type="glossed"><seg type="base">in</seg><gloss xml:lang="ang">in</gloss></seg> <seg type="glossed"><seg type="base">Chana</seg><gloss xml:lang="ang">Chan'</gloss></seg> <seg type="glossed"><seg type="base">Galiléǽ</seg><gloss xml:lang="ang">Gali'</gloss></seg> <seg type="glossed"><seg type="base">ex</seg><gloss xml:lang="ang">of</gloss></seg> <seg type="glossed"><seg type="base">aqua</seg><gloss xml:lang="ang">vætre</gloss></seg> <seg type="glossed"><seg type="base">uinum</seg><gloss xml:lang="ang">win</gloss></seg> <seg type="glossed"><seg type="base">fecisti</seg><gloss xml:lang="ang">worhtest</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">tres</seg><gloss xml:lang="ang">ðrio</gloss></seg> <seg type="glossed"><seg type="base">pueros</seg><gloss xml:lang="ang">cnæhtas</gloss></seg> <seg type="glossed"><seg type="base">Sidrac,</seg><gloss xml:lang="ang">Sið',</gloss></seg> <seg type="glossed"><seg type="base">Misac</seg><gloss xml:lang="ang">Mis'</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">Abdenago</seg><gloss xml:lang="ang">Abdi'</gloss></seg> <seg type="glossed"><seg type="base">de</seg><gloss xml:lang="ang">of</gloss></seg> <seg type="glossed"><seg type="base">camino</seg><gloss xml:lang="ang">ofone</gloss></seg> <seg type="glossed"><seg type="base">ignis</seg><gloss xml:lang="ang">fyres</gloss></seg> <seg type="glossed"><seg type="base">ardentis</seg><gloss xml:lang="ang">biornendos</gloss></seg> <seg type="glossed"><seg type="base">inlaesos</seg><gloss xml:lang="ang">unascendado</gloss></seg> <seg type="glossed"><seg type="base">eduxisti</seg><gloss xml:lang="ang">gilæddest</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">Susannam</seg><gloss xml:lang="ang">þ<hi rend="italic">æt<ptr type="liebermannNote" n="13" target="#IudDeiIV_3-3.lnote.oe.13"/></hi> vif</gloss></seg> <seg type="glossed"><seg type="base">de</seg><gloss xml:lang="ang">of</gloss></seg> <seg type="glossed"><seg type="base">falso</seg><gloss xml:lang="ang">leasum</gloss></seg> <seg type="glossed"><seg type="base">crimine</seg><gloss xml:lang="ang">synne</gloss></seg> <seg type="glossed"><seg type="base">liberasti,</seg><gloss xml:lang="ang">alesdest,</gloss></seg> <seg type="glossed"><seg type="base">caeco</seg><gloss xml:lang="ang">blindu<hi rend="italic">m</hi></gloss></seg> <seg type="glossed"><seg type="base">nato</seg><gloss xml:lang="ang">giboren<hi rend="italic">um</hi></gloss></seg> <seg type="glossed"><seg type="base">oculos</seg><gloss xml:lang="ang">ego</gloss></seg> <seg type="glossed"><seg type="base">aperuisti,</seg><gloss xml:lang="ang">untyndest,</gloss></seg> <seg type="glossed"><seg type="base">Lazarum<ptr type="liebermannNote" n="14" target="#IudDeiIV_3-3.lnote.oe.14"/></seg><gloss xml:lang="ang">Lazaru<hi rend="italic">m</hi></gloss></seg> <seg type="glossed"><seg type="base">a</seg><gloss xml:lang="ang">from</gloss></seg> <seg type="glossed"><seg type="base">monumento</seg><gloss xml:lang="ang">byrgenne</gloss></seg> <seg type="glossed"><seg type="base">suscitasti</seg><gloss xml:lang="ang">awoehtest</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">Petro</seg><gloss xml:lang="ang">Petre</gloss></seg> <seg type="glossed"><seg type="base">mergenti</seg><gloss xml:lang="ang">ðæm drencende</gloss></seg> <seg type="glossed"><seg type="base">manum</seg><gloss xml:lang="ang">hond</gloss></seg> <seg type="glossed"><seg type="base">porrexisti,</seg><gloss xml:lang="ang">girahtest<ptr type="liebermannNote" n="15" target="#IudDeiIV_3-3.lnote.oe.15"/>,</gloss></seg></ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Ioan. 2, 11; Dan. 3, 12; Dan. 13, 6; Ioan. 9, 19; Ioan. 11, 1; Matth. 14, 3</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 410 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-3.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbesserndes Synonym fehlt</hi></seg><seg type="translation" xml:lang="en" source="#claude">correcting synonym missing</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-3.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Glossator missversteht</hi> qui <hi rend="italic">als Plural</hi></seg><seg type="translation" xml:lang="en" source="#claude">the glossator misunderstands qui as a plural</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-3.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">für</hi> Susanna <hi rend="italic">setzt Glossator ‘das Weib’ auch</hi> 4, 2</seg><seg type="translation" xml:lang="en" source="#claude">for Susanna the glossator puts ‘the woman’, also 4, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-3.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">quatriduanum <hi rend="italic">fügt zu Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">quatriduanum added by Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-3.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">über</hi> a [<hi rend="italic">das hier</hi> u <hi rend="italic">gleicht</hi>] <hi rend="italic">vgl. Lind. p.</hi> 30</seg><seg type="translation" xml:lang="en" source="#claude">above a [which here resembles u]; cf. Lind. p. 30</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-du">You, Lord God, we humbly beseech, who in Cana of Galilee made wine from water, and led the three boys Sidrac, Misac and Abdenago out of the furnace of burning fire unharmed, and freed Susanna from a false charge, opened the eyes of the man born blind, raised Lazarus from the tomb and stretched out your hand to Peter as he was sinking,</ab>
      </div>
    </body>
