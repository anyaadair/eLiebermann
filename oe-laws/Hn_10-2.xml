      <div type="clause" n="10.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 10.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 10.2" corresp="#wit-lat"><pb n="556" ed="#liebermann"/>Omnes<ptr type="liebermannNote" n="u" target="#Hn_10-2.lnote.oe.u"/> herestrete<ptr type="liebermannNote" n="36" target="#Hn_10-2.lnote.oe.36"/> omnino regis sunt; et omnia qualstowa<ptr type="liebermannNote" n="37" target="#Hn_10-2.lnote.oe.37"/>, id est occidendorum<ptr type="liebermannNote" n="v" target="#Hn_10-2.lnote.oe.v"/> loca, totaliter regis sunt in soca sua.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 556 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_10-2.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 10, 1&lt;sup&gt;m&lt;/sup&gt;: stretbreche; 12, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 10, 1&lt;sup&gt;m&lt;/sup&gt;: stretbreche; 12, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_10-2.lnote.oe.v" n="v" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de">cwal-stow: <hi rend="italic">Hinrichtungsort</hi></seg><seg type="translation" xml:lang="en" source="#claude">cwal-stow: <hi rend="italic">place of execution</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_10-2.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de">-strate <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-strate <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_10-2.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de">gwa. <hi rend="italic">K Co Or Gi Sp.</hi></seg><seg type="translation" xml:lang="en" source="#claude">gwa. <hi rend="italic">K Co Or Gi Sp.</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_10-2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Strasse 10; Hinrichtungsort. Zum Worte <hi rend="italic">vgl. cwalhus, qualesið</hi> im 12. Jh. bei Mätzner <hi rend="italic">Wb</hi>. Schreibung <hi rend="italic">qu-</hi> für <hi rend="italic">cw-</hi> ist Französisch; <hi rend="italic">vgl</hi>. Hein <hi rend="italic">Eadwines Sprache</hi> 23—<hi rend="italic">herestrate</hi>{36}—<hi rend="italic">qual</hi>.{37} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Strasse 10; Hinrichtungsort. On the word <hi rend="italic">cf. cwalhus, qualesið</hi> in the 12th cent. in Mätzner <hi rend="italic">Wb</hi>. The spelling <hi rend="italic">qu-</hi> for <hi rend="italic">cw-</hi> is French; <hi rend="italic">cf.</hi> Hein <hi rend="italic">Eadwines Sprache</hi> 23—<hi rend="italic">herestrate</hi>{36}—<hi rend="italic">qual</hi>.{37} Rs</seg></note>
