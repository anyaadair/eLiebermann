    <body>
      <div type="clause" n="1">
        <head><ref type="lawCode" target="law:QuadrArg">Quadr Arg</ref> 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Arg 1" corresp="#wit-lat"><pb n="532" ed="#liebermann"/>Leges<ptr type="liebermannNote" n="f" target="#QuadrArg_1.lnote.oe.f"/> quas dicunt Eadwardi<ptr type="liebermannNote" n="7" target="#QuadrArg_1.lnote.oe.7"/> regis ex Cnudi<ptr type="liebermannNote" n="8" target="#QuadrArg_1.lnote.oe.8"/> primum institutione<ptr type="liebermannNote" n="g" target="#QuadrArg_1.lnote.oe.g"/> diductas esse, sicut ab antiquis<ptr type="liebermannNote" n="h" target="#QuadrArg_1.lnote.oe.h"/> accepimus, compendiosa posteris brevitate transcurrimus.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 532 (two independent readings of the page images, differences settled against the page); Liebermann’s print has ‘brevitate’ with a v (elsewhere u); transcribed as printed</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_1.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">532</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dass Eadwards III. Verfassung auf Cnuts Gesetzen ruhte</hi> (<hi rend="italic">vgl. unten</hi> Arg. 9), <hi rend="italic">weiss auch Will. Malmesb.</hi> Reg. II 183; <hi rend="italic">dass sie ungeschrieben war, auch Herm. von S. Edmund, ed.</hi> Anglonorm. Geschq. S. 226</seg><seg type="translation" xml:lang="en" source="#claude">that Eadward III’s constitution rested on Cnut’s laws (cf. below Arg. 9) is also known to Will. Malmesb. Reg. II 183; that it was unwritten, also to Herm. of S. Edmund, ed. Anglonorm. Geschq. p. 226</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_1.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">532</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Hn</hi> 20, 3: Cnuti <hi rend="spaced">uel</hi> Edwardi legibus</seg><seg type="translation" xml:lang="en" source="#claude">cf. Hn 20, 3: Cnuti <hi rend="italic">uel</hi> Edwardi legibus</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_1.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">532</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">eine geschriebene Quelle hierfür ist nicht nachweisbar</hi></seg><seg type="translation" xml:lang="en" source="#claude">no written source for this can be traced</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">532</biblScope></bibl><seg type="original" xml:lang="de">Edw. <hi rend="italic">THk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Edw. THk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">532</biblScope></bibl><seg type="original" xml:lang="de">Cnuthi <hi rend="italic">Hk;</hi> Cnuthonis <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cnuthi Hk; Cnuthonis Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. u</hi>. 11; <hi rend="italic">Gl</hi> Eadwardi laga 4c</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See below</hi> 11; <hi rend="italic">Gl</hi> Eadwardi laga 4c</seg></note>
