      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 2" corresp="#wit-du"><pb n="409" ed="#liebermann"/>Exorcismus<ptr type="liebermannNote" n="26" target="#IudDeiIV_2.lnote.oe.26"/> aquæ ad furtum requirendum. Exorcizo te, creatura aque, in nomine Dei, patris omnipotentis, et in nomine Ie<hi rend="italic">s</hi>u<ptr type="liebermannNote" n="30" target="#IudDeiIV_2.lnote.oe.30"/> Chr<hi rend="italic">is</hi>t[i], filii eius, domini nostri, ut fias aqua exorcizata ad effugandam omnem potestatem inimici et omne fantasma diaboli,</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei IV 2" corresp="#wit-gl"><pb n="409" ed="#liebermann"/>Ic halsigo ðec, giscæft ⁊<ptr type="liebermannNote" n="27" target="#IudDeiIV_2.lnote.oe.27"/> æc, in nome God, fador<hi rend="italic">es</hi> allmæht<hi rend="italic">iges<ptr type="liebermannNote" n="28" target="#IudDeiIV_2.lnote.oe.28"/></hi>, ⁊ nome hæl<hi rend="italic">endes<ptr type="liebermannNote" n="29" target="#IudDeiIV_2.lnote.oe.29"/></hi> Crist<hi rend="italic">es</hi>, bearn<hi rend="italic">es</hi> his̄, drih<hi rend="italic">tnes</hi> us<hi rend="italic">es</hi>, þ<hi rend="italic">æt</hi>te giworðe vætre<ptr type="liebermannNote" n="31" target="#IudDeiIV_2.lnote.oe.31"/> gihalsad to fleanne ælc maeht fiondes ⁊ ælc scinelac divoles,</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 409 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">c.</hi> 2. 3 <hi rend="italic">gleich Zeu.</hi> 610<hi rend="italic">a. b</hi>, <hi rend="italic">wo</hi> aq. calidæ</seg><seg type="translation" xml:lang="en" source="#claude">c. 2. 3 equivalent to Zeu. 610a. b, where aq. calidæ</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">irrig wie</hi> atque V 2. 2, 3 <hi rend="italic">glossirt; richtig</hi> uætres 3, 2</seg><seg type="translation" xml:lang="en" source="#claude">wrongly glossed like atque V 2. 2, 3; correctly uætres 3, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch grosse Abkürzung zeigt Apostroph</hi></seg><seg type="translation" xml:lang="en" source="#claude">an apostrophe indicates even a large abbreviation</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">Iesus <hi rend="italic">glossirt durch ‘Heiland’</hi> 3. 4, 6. V 2, 1. VII 23 <hi rend="italic">A</hi></seg><seg type="translation" xml:lang="en" source="#claude">Iesus glossed by ‘Saviour’ 3. 4, 6. V 2, 1. VII 23 A</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">ihū xp̄e <hi rend="italic">Du</hi></seg><seg type="translation" xml:lang="en" source="#claude">ihū xp̄e Du</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
      </div>
