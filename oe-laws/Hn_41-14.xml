      <div type="clause" n="41.14">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 41.14</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 41.14" corresp="#wit-lat"><pb n="568" ed="#liebermann"/>Quod si inplacitatus in aliquo refragauerit, retineat ipsum<ptr type="liebermannNote" n="33" target="#Hn_41-14.lnote.oe.33"/> dominus uel de<ptr type="liebermannNote" n="l" target="#Hn_41-14.lnote.oe.l"/> suo quantum ad satisfaciendum sit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 568 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-14.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 57, 7</seg><seg type="translation" xml:lang="en" source="#claude">cf. 57, 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-14.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">do. uel ip. uel <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">do. uel ip. uel Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-14.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Gerichtsbarkeit 38b; Pfändung 8.—Lies <hi rend="italic">Quodsi</hi> in einem Wort—<hi rend="italic">r</hi>.{33} <hi rend="italic">do. uel ip. uel de</hi>—41, 15 <hi rend="italic">si etiam</hi>{35}—<hi rend="italic">fiat</hi>{37} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Gerichtsbarkeit 38b; Pfändung 8.—Read <hi rend="italic">Quodsi</hi> as one word—<hi rend="italic">r</hi>.{33} <hi rend="italic">do. uel ip. uel de</hi>—41, 15 <hi rend="italic">si etiam</hi>{35}—<hi rend="italic">fiat</hi>{37} Rs</seg></note>
