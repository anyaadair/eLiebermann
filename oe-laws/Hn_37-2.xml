      <div type="clause" n="37.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 37.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 37.2" corresp="#wit-lat"><pb n="567" ed="#liebermann"/>Si ƿudeheƿet<ptr type="liebermannNote" n="11" target="#Hn_37-2.lnote.oe.11"/>, id est nemoris cesio<ptr type="liebermannNote" n="12" target="#Hn_37-2.lnote.oe.12"/>, in parco<ptr type="liebermannNote" n="d" target="#Hn_37-2.lnote.oe.d"/> regis uel foresta<ptr type="liebermannNote" n="b" target="#Hn_37-2.lnote.oe.b"/><ptr type="liebermannNote" n="13" target="#Hn_37-2.lnote.oe.13"/> fiat, XX<ptr type="liebermannNote" n="14" target="#Hn_37-2.lnote.oe.14"/> manc.<ptr type="liebermannNote" n="e" target="#Hn_37-2.lnote.oe.e"/><ptr type="liebermannNote" n="15" target="#Hn_37-2.lnote.oe.15"/> emendetur, nisi prohibitio<ptr type="liebermannNote" n="16" target="#Hn_37-2.lnote.oe.16"/> propensior amplius exigat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 567 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_37-2.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 17</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 17</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_37-2.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> ECf. 8, 2; <hi rend="italic">anderer Sinn u.</hi> 40</seg><seg type="translation" xml:lang="en" source="#claude">cf. ECf. 8, 2; a different sense below 40</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_37-2.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">d. i.</hi> oferhyrness = 120 sol. <hi rend="italic">Westsächs.</hi> = 50 sol. <hi rend="italic">Normann.; vgl.</hi> 34, 3&lt;sup&gt;r&lt;/sup&gt;. 48, 1<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">i.e. oferhyrness = 120 sol. West Saxon = 50 sol. Norman; cf. 34, 3&lt;sup&gt;r&lt;/sup&gt;. 48, 1<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_37-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">ƿudheƿec <hi rend="italic">K Or;</hi> ƿudherec <hi rend="italic">Co; über</hi> ƿet <hi rend="italic">setzt Corr.</hi> ch <hi rend="italic">Sc;</hi> yndehoch <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">ƿudheƿec K Or; ƿudherec Co; over ƿet the corrector writes ch Sc; yndehoch Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_37-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">cesione <hi rend="italic">statt</hi> c. in <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">cesione instead of c. in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_37-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">-ste <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ste Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_37-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">XXX <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">XXX K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_37-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">mͣ. <hi rend="italic">Sc;</hi> mance <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">mͣ. Sc; mance Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_37-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">proposicio (-tis <hi rend="italic">Gi</hi>) <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">proposicio (-tis Gi) K Co Or Gi</seg></note>
      </div>
