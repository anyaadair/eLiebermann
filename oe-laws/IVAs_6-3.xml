      <div type="clause" n="6.3">
        <head><ref type="lawCode" target="law:IVAs">IV As</ref> 6.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6.3" corresp="#wit-q"><pb n="172" ed="#liebermann"/>Si autem<ptr type="liebermannNote" n="29" target="#IVAs_6-3.lnote.oe.29"/> fugiat (aufugiat), prosequatur<ptr type="liebermannNote" n="30" target="#IVAs_6-3.lnote.oe.30"/> eum<ptr type="liebermannNote" n="31" target="#IVAs_6-3.lnote.oe.31"/> omnis<ptr type="liebermannNote" n="32" target="#IVAs_6-3.lnote.oe.32"/> homo super<ptr type="liebermannNote" n="33" target="#IVAs_6-3.lnote.oe.33"/> uitam<ptr type="liebermannNote" n="34" target="#IVAs_6-3.lnote.oe.34"/> suam qui<ptr type="liebermannNote" n="35" target="#IVAs_6-3.lnote.oe.35"/><ptr type="liebermannNote" n="a" target="#IVAs_6-3.lnote.oe.a"/> uelit quod rex, et occidat eum cui obuiabit. Qui ei pepercerit uel eundem firmauerit<ptr type="liebermannNote" n="36" target="#IVAs_6-3.lnote.oe.36"/>, indignus sit<ptr type="liebermannNote" n="37" target="#IVAs_6-3.lnote.oe.37"/> omnium quę habebit et uitę<ptr type="liebermannNote" n="38" target="#IVAs_6-3.lnote.oe.38"/> suę, sicut<ptr type="liebermannNote" n="39" target="#IVAs_6-3.lnote.oe.39"/> fur, nisi se possit allegiare, quod nec furtum cum eo sciret nec<ptr type="liebermannNote" n="40" target="#IVAs_6-3.lnote.oe.40"/> facnum<ptr type="liebermannNote" n="41" target="#IVAs_6-3.lnote.oe.41"/><ptr type="liebermannNote" n="b" target="#IVAs_6-3.lnote.oe.b"/>, pro quo uite<ptr type="liebermannNote" n="1" target="#IVAs_6-3.lnote.oe.1"/> sue (mortis) reus esset.<ptr type="liebermannNote" n="42" target="#IVAs_6-3.lnote.oe.42"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="6.3" corresp="#wit-q"><pb n="148" ed="#attenborough"/>Si autem fugiat<ptr type="editorNote" n="16" target="#IVAs_6-3.attnote.fn.16"/> prosequatur<ptr type="editorNote" n="17" target="#IVAs_6-3.attnote.fn.17"/> eum omnis homo super vitam suam qui velit quod rex, et occidat eum cui obviabit. Qui ei pepercerit vel eundem firmaverit<ptr type="editorNote" n="18" target="#IVAs_6-3.attnote.fn.18"/>, indignus sit omnium quæ habebit et vitæ suæ, sicut fur, nisi se possit allegiare quod nec furtum cum eo sciret nec facnum<ptr type="editorNote" n="1" target="#IVAs_6-3.attnote.fn.1"/>, pro quo vitæ suæ<ptr type="editorNote" n="2" target="#IVAs_6-3.attnote.fn.2"/> reus esset.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="149" ed="#attenborough"/>If however he takes to flight, he shall be pursued to his death by all men who are willing to carry out the king's wishes<ptr type="editorNote" n="1" target="#IVAs_6-3.attnote.n.1"/>, and whoever shall meet him shall kill him. And he who spares or harbours him shall forfeit his life and all that he has as if he were a thief himself, unless he can prove that he was not aware of any theft or crime for which his [the fugitive’s] life was forfeit.</ab>
        <note type="comparison" source="#liebermann" n="172">Vor. S.</note>
        <note type="comparisonPrinted" source="#liebermann">ebd.</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VIAs_1-2">VI As 1.2</ref>; <ref target="clause:IICn_29">II Cn 29</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="358"><ref target="clause:IICn_29">II Cn 29</ref></note>
        <note type="editorial">Latin only; no German translation in Liebermann. Old English of the last part in H (row 852).</note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">auf. <hi rend="italic">statt</hi> aut. f. <hi rend="italic">RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">auf. instead of aut. f. RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">perseq. <hi rend="italic">RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">perseq. RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">ei <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">omnis — eum <hi rend="italic">überspringt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">omnis — eum skipped by K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt R</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">witam <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">witam MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">qui u. q. r. <hi rend="italic">fehlt Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui u. q. r. lacking in Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">firmabit <hi rend="italic">RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">firmabit RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt TMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in TMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">s. u. <hi rend="italic">RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. u. RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">s. fur <hi rend="italic">fehlt T</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. fur lacking in T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">aut <hi rend="italic">RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">aut RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so R;</hi> facinus <hi rend="italic">KTOr;</hi> factum <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus R; facinus KTOr; factum MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond; (eingeklammertes) übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket Lond; (bracketed words) the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">querat ut supra <hi rend="italic">fügt zu Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">querat ut supra added by Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">114</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Formelhaft für ‘Untertan in Königstreue’ auch V As 3; <hi rend="italic">s. d. Gl</hi> 6b; friedlos 11a</seg><seg type="translation" xml:lang="en" source="#claude">A formula for ‘subject in loyalty to the king’ also in V As 3; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 6b; friedlos 11a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-3.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">114</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Wb: facn</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Wb: facn</hi></seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAs_6-3.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">211</biblScope></bibl><seg type="original" xml:lang="en">Apparently a formula for describing a loyal subject; cf. V As. cap. 3: <hi rend="italic">for ealle þe willaþ ðæt he wile</hi>.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_6-3.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">148</biblScope></bibl><label>fugiat</label><seg type="original" xml:lang="en"><hi rend="italic">aufugiat</hi>.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_6-3.attnote.fn.17" n="17" source="#attenborough"><bibl><biblScope unit="page">148</biblScope></bibl><label>prosequatur</label><seg type="original" xml:lang="en"><hi rend="italic">persequatur</hi>. R, T, M, Hk.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_6-3.attnote.fn.18" n="18" source="#attenborough"><bibl><biblScope unit="page">148</biblScope></bibl><label>firmaverit</label><seg type="original" xml:lang="en"><hi rend="italic">firmabit</hi>. R, T, M, Hk.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_6-3.attnote.fn.1" n="1" source="#attenborough"><bibl><biblScope unit="page">150</biblScope></bibl><label>facnum</label><seg type="original" xml:lang="en"><hi rend="italic">facinus</hi>. K, T, Or. <hi rend="italic">factum</hi>. M, Hk.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_6-3.attnote.fn.2" n="2" source="#attenborough"><bibl><biblScope unit="page">150</biblScope></bibl><label>suæ</label><seg type="original" xml:lang="en"><hi rend="italic">mortis</hi>.</seg></note>
      </div>
