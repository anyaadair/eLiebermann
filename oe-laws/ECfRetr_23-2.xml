      <div type="clause" n="23.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 23.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 23.2"><pb n="648" ed="#liebermann"/><hi rend="bold">Quem</hi> nisi poterit<ptr type="liebermannNote" n="44" target="#ECfRetr_23-2.lnote.la.44"/> ad rectum habere, habebit terminum<ptr type="liebermannNote" n="45" target="#ECfRetr_23-2.lnote.la.45"/> mensis et unius diei.</ab>
        <note type="comparison" source="#liebermann" n="648"><label>printed alongside</label> <ref target="clause:ECf_23-2">ECf 23.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 648 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_23-2.lnote.la.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">ad r. p. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad r. p. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_23-2.lnote.la.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">predictum <hi rend="italic">fügt zu Lond;</hi> unius <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Lond adds predictum; Hv adds unius</seg></note>
      </div>
