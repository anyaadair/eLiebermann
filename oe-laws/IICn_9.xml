    <body>
      <div type="clause" n="9">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 9</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="9" corresp="#wit-g-a"><pb n="314" ed="#liebermann"/>And gemeta<ptr type="liebermannNote" n="20" target="#IICn_9.lnote.oe.20"/> ⁊ gewihta rihte man georne ⁊ ælces unrihtes heonon forð geswíce.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="9" corresp="#wit-b"><pb n="314" ed="#liebermann"/>Geméta ⁊ gewihta rihte man georne ⁊ ælces unrihtes<ptr type="liebermannNote" n="*" target="#IICn_9.lnote.oe.star"/> geswíce.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="9" corresp="#wit-a"><pb n="314" ed="#liebermann"/>And gemétta ⁊ gewyhta rihta<ptr type="liebermannNote" n="7" target="#IICn_9.lnote.oe.7"/> man georne ⁊ ælces unrihtes heonan forð geswicæ.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="9" corresp="#wit-q"><pb n="315" ed="#liebermann"/>Mensurę<ptr type="liebermannNote" n="16" target="#IICn_9.lnote.oe.16"/> et<ptr type="liebermannNote" n="17" target="#IICn_9.lnote.oe.17"/> pondera iustificentur, et omnis iniusticia<ptr type="liebermannNote" n="18" target="#IICn_9.lnote.oe.18"/> deinceps opprimatur.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="9" corresp="#wit-inst-cn"><pb n="315" ed="#liebermann"/>Mensurę et pondera per totum regnum Anglię ita corrigantur, ut sint recta<ptr type="liebermannNote" n="15" target="#IICn_9.lnote.oe.15"/> (unita).<ptr type="liebermannNote" n="16" target="#IICn_9.lnote.oe.16-2"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="9" corresp="#wit-cons-cn"><pb n="315" ed="#liebermann"/>Mensuras et pondera diligenter dirigamus et ab omni iniusto cessemus.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="9" corresp="#wit-b"><pb n="178" ed="#robertson"/>Geméta ⁊ gewihta rihte man georne ⁊ ælces unrihtes [heonan forð]<ptr type="editorNote" n="6" target="#IICn_9.robnote.fn.6"/> geswíce.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="258" ed="#rabin-doml"/>And gemeta and gewihta rihte man georne and ælces unrihtes heonon forð geswice.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="315" ed="#liebermann"/>Und Maasse und Gewichte mache man genau richtig<ptr type="liebermannNote" n="1" target="#IICn_9.lnote.de.1"/> und lasse hinfort von jedem Unrecht ab.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let measures and weights be carefully corrected, and let every injustice cease henceforth.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_9.robnote.n.1"/><pb n="179" ed="#robertson"/>Measures and weights shall be diligently corrected, and an end put to all unjust practices.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="259" ed="#rabin-doml"/>And weights and measures are to be assiduously made right, and all unlawful practices abolished henceforth.</ab>
        <note type="comparison" source="#liebermann" n="315"><ref target="clause:VIAtr_32-2">VI Atr 32.2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">VI Atr. 32, 2</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:WlArtRetr_7">Wl art retr 7</ref></note>
        <note type="comparison" source="#wormald-mel" n="358"><label>quoted verbatim (bold in Wormald's table)</label> <ref target="clause:VIAtr_32-2">VI Atr 32.2</ref> <quote>Table 5.4, II Cn 9: Cn 1018 21 (HomN L) VI Atr 32:2</quote></note>
        <note type="comparison" source="#wormald-mel" n="358"><label>quoted verbatim (bold in Wormald's table)</label> <ref target="clause:Cn-1018_part-058">Cn 1018 21</ref> <quote>Table 5.4, II Cn 9: Cn 1018 21 (HomN L) VI Atr 32:2</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="334"><ref target="clause:VIAtr_32">VI Atr 32–32.2</ref></note>
        <note type="comparedBy" source="#kennedy" n="59"><ref target="clause:Cn-1018_part-058">Cn 1018 21</ref></note>
        <note type="editorial">Liebermann compares VI Atr 32.2.; BR: added from Gesetze I p. 315, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">heonon forð: omitted B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_9.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">314</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hierher gehört</hi> heonan forð <hi rend="italic">aus folgender Zeile.</hi></seg><seg type="translation" xml:lang="en" source="#claude">heonan forð from the following line belongs here.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_9.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">315</biblScope></bibl><seg type="original" xml:lang="de">mensura <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">mensura Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_9.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">315</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus K; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">from K; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_9.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">315</biblScope></bibl><seg type="original" xml:lang="de">d. i. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. i. T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_9.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">314</biblScope></bibl><seg type="original" xml:lang="de">gemetta ⁊ gewyhta rihta <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gemetta ⁊ gewyhta rihta Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_9.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">314</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. II</hi> 11 smeaga</seg><seg type="translation" xml:lang="en" source="#claude">cf. II 11 smeaga</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_9.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">315</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">über</hi> r. <hi rend="italic">schreibt</hi> u. <hi rend="italic">H; nur</hi> u. <hi rend="italic">LbS; nur</hi> r. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">H writes u. above r.; only u. LbS; only r. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_9.lnote.oe.16-2" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">315</biblScope></bibl><seg type="original" xml:lang="de">10; 11; 11, 1 <hi rend="italic">fehlt</hi></seg><seg type="translation" xml:lang="en" source="#claude">10; 11; 11, 1 lacking</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_9.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">203</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘einheitlich’ Inst <hi rend="smallcaps">ii</hi>; <hi rend="italic">s. Gl</hi> Mass 6</seg><seg type="translation" xml:lang="en" source="#claude">‘uniform’ Inst <hi rend="smallcaps">ii</hi>; <hi rend="italic">see Gl</hi> Mass 6</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_9.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">353</biblScope></bibl><seg type="original" xml:lang="en">Cf. VI Atr. 32, 2.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_9.robnote.fn.6" n="6" source="#robertson"><bibl><biblScope unit="page">178</biblScope></bibl><label>forð</label><seg type="original" xml:lang="en">G, A, Ld; om. B, and inserted in cap. 10.</seg></note>
      </div>
