  <text>
    <body>
      <div type="clause" n="36.3">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 36.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 36.3"><pb n="667" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_36-3.lnote.oe.erkl-clause"/>Et tunc primum<ptr type="liebermannNote" n="8" target="#ECf_36-3.lnote.la.8"/> dicat<ptr type="liebermannNote" n="a" target="#ECf_36-3.lnote.la.fn.a"/>, quo latrocinio et qua ratione interfectus sit. Et si cognouerit<ptr type="liebermannNote" n="b" target="#ECf_36-3.lnote.la.fn.b"/><ptr type="liebermannNote" n="9" target="#ECf_36-3.lnote.la.9"/>, quod fuit captus uiuus, nominet iusticiarium et iudices<ptr type="liebermannNote" n="c" target="#ECf_36-3.lnote.la.fn.c"/> et testes<ptr type="liebermannNote" n="d" target="#ECf_36-3.lnote.la.fn.d"/> de uicinis legales. Et si ipsi warantizauerint<ptr type="liebermannNote" n="10" target="#ECf_36-3.lnote.la.10"/> eum, quod iuste sit<ptr type="liebermannNote" n="11" target="#ECf_36-3.lnote.la.11"/> facta iusticia de eo pro<ptr type="liebermannNote" n="12" target="#ECf_36-3.lnote.la.12"/> suo latrocinio, quietus erit interfector; et ipsi qui fecerunt<ptr type="liebermannNote" n="13" target="#ECf_36-3.lnote.la.13"/> clamorem, dabunt<ptr type="liebermannNote" n="14" target="#ECf_36-3.lnote.la.14"/> sua<ptr type="liebermannNote" n="15" target="#ECf_36-3.lnote.la.15"/> uadimonia<ptr type="liebermannNote" n="e" target="#ECf_36-3.lnote.la.fn.e"/>.</ab>
        <note type="comparison" source="#liebermann" n="667"><label>printed alongside</label> <ref target="clause:ECfRetr_36-3">ECf retr 36.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 667 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36-3.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">der, wie nach</hi> Ine 21 <hi rend="italic">zum Beweise nähere, Todtschläger</hi></seg><seg type="translation" xml:lang="en" source="#claude">the killer, who, as by Ine 21, is nearer to the proof</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36-3.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">gesteht</seg><seg type="translation" xml:lang="en" source="#claude">confesses</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36-3.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">Urtheilfinder</seg><seg type="translation" xml:lang="en" source="#claude">judgement-finders</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36-3.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Umstand des Gerichts, welches jenen hingerichtet hatte (wohl nicht Eideshelfer oder Zeugen, die gegen ihn ausgesagt hatten)</hi></seg><seg type="translation" xml:lang="en" source="#claude">the bystanders of the court which had executed him (probably not oath-helpers or witnesses who had testified against him)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36-3.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Klagepfand, als Strafgeld dem Richter für falsche Klage verfallen</hi></seg><seg type="translation" xml:lang="en" source="#claude">the pledge given with the claim, forfeit to the judge as a fine for a false claim</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36-3.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">primo <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">primo Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36-3.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">-uit <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uit Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36-3.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">-zia. <hi rend="italic">Rl;</hi> -zabunt <hi rend="italic">S;</hi> guarentizent <hi rend="italic">Hk;</hi> warent. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-zia. Rl; -zabunt S; guarentizent Hk; warent. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36-3.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">f. sit <hi rend="italic">Hk Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. sit Hk Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36-3.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">super <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">super Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36-3.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">-rat <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rat Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36-3.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">emendent <hi rend="italic">S;</hi> emendet <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">emendent S; emendet Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36-3.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">667</biblScope></bibl><seg type="original" xml:lang="de">u. sua <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. sua Hk</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And then first let him say for what theft and for what reason he was killed. And if he acknowledges that he was taken alive, let him name the justiciar and the judges and lawful witnesses from the neighbours. And if they warrant him that justice was justly done on him for his theft, the slayer shall be quit; and those who made the complaint shall give (i.e. forfeit) their gages.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_36-3.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">350</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Urteilfinder 4.a; Gericht 23; Gerichtszeugnis 5; gewährleisten 6 — <hi rend="italic">tunc</hi><hi rend="superscript">10</hi> fehlt — <hi rend="italic">f. sit</hi><hi rend="superscript">18</hi> — <hi rend="italic">emendet s. u. Q.</hi><hi rend="superscript">22</hi> <hi rend="italic">i. def.</hi> vom Schreiber am Rande nachgetr. Rs</seg><seg type="translation" xml:lang="en" source="#claude">Cf. <hi rend="italic">Gl</hi> Urteilfinder 4.a; Gericht 23; Gerichtszeugnis 5; gewährleisten 6 — <hi rend="italic">tunc</hi><hi rend="superscript">10</hi> lacking — <hi rend="italic">f. sit</hi><hi rend="superscript">18</hi> — <hi rend="italic">emendet s. u. Q.</hi><hi rend="superscript">22</hi> <hi rend="italic">i. def.</hi> added in the margin by the scribe in Rs</seg></note>
      </div>
    </body>
