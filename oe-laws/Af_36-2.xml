      <div type="clause" n="36.2">
        <head><ref type="lawCode" target="law:Af">Af</ref> 36.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-e"><seg type="part" corresp="#part-a"><pb n="70" ed="#liebermann"/>gif se ord sie<ptr type="liebermannNote" n="5" target="#Af_36-2-a.lnote.oe.5"/> ufor<ptr type="liebermannNote" n="*" target="#Af_36-2-a.lnote.oe.star"/> þonne hindeweard<ptr type="liebermannNote" n="6" target="#Af_36-2-a.lnote.oe.6"/> sceaft.</seg> <seg type="part" corresp="#part-b"><pb n="70" ed="#liebermann"/>Gif hie<ptr type="liebermannNote" n="7" target="#Af_36-2-b.lnote.oe.7"/> sien<ptr type="liebermannNote" n="8" target="#Af_36-2-b.lnote.oe.8"/> bu<ptr type="liebermannNote" n="9" target="#Af_36-2-b.lnote.oe.9"/> gelic, ord ⁊ hindeweard<ptr type="liebermannNote" n="10" target="#Af_36-2-b.lnote.oe.10"/> sceaft, þæt sie<ptr type="liebermannNote" n="11" target="#Af_36-2-b.lnote.oe.11"/> butan pleo.</seg></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-h"><seg type="part" corresp="#part-a"><pb n="70" ed="#liebermann"/>gif se ord sy<ptr type="liebermannNote" n="2" target="#Af_36-2-a.lnote.oe.2"/> þreo<ptr type="liebermannNote" n="3" target="#Af_36-2-a.lnote.oe.3"/> fingre ufor<ptr type="liebermannNote" n="4" target="#Af_36-2-a.lnote.oe.4"/> þonne hindeweard sceaft.</seg> <seg type="part" corresp="#part-b"><pb n="70" ed="#liebermann"/>Gif hy<ptr type="liebermannNote" n="2" target="#Af_36-2-b.lnote.oe.2"/> syn<ptr type="liebermannNote" n="2" target="#Af_36-2-b.lnote.oe.2"/> bú gelic, ord ⁊ hindeweard sceaft, ðæt sy<ptr type="liebermannNote" n="2" target="#Af_36-2-b.lnote.oe.2"/> buton<ptr type="liebermannNote" n="1" target="#Af_36-2-b.lnote.oe.1"/> pleo.</seg></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-b-no-prol"><seg type="part" corresp="#part-a"><pb n="70" ed="#liebermann"/>gyf se ord [si<ptr type="liebermannNote" n="3" target="#Af_36-2-a.lnote.oe.3-2"/>] ufor ðonne hindeweard sceaft. [Ac<ptr type="liebermannNote" n="4" target="#Af_36-2-a.lnote.oe.4-3"/>] gyf hi syn buta gelice, ord ⁊ hindeweard sceaft, þ<hi rend="italic">æt</hi> sy butan pleo.</seg></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-q"><seg type="part" corresp="#part-a"><pb n="71" ed="#liebermann"/>si acutum<ptr type="liebermannNote" n="4" target="#Af_36-2-a.lnote.oe.4-2"/> lancee sit<ptr type="liebermannNote" n="5" target="#Af_36-2-a.lnote.oe.5-2"/> altius tribus digitis quam cuspis.</seg> <seg type="part" corresp="#part-b"><pb n="71" ed="#liebermann"/>Si equaliter ferantur acies et cuspis, sine culpa reputetur.<ptr type="liebermannNote" n="6" target="#Af_36-2-b.lnote.oe.6"/></seg></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><seg type="part" corresp="#part-a"><pb n="80" ed="#attenborough"/>gif<ptr type="editorNote" n="4" target="#Af_36-2-a.attnote.fn.4"/> se ord sie ufor<ptr type="editorNote" n="5" target="#Af_36-2-a.attnote.fn.5"/> [þreo fingre]<ptr type="editorNote" n="6" target="#Af_36-2-a.attnote.fn.6"/> þonne hindeweard sceaft.</seg> <seg type="part" corresp="#part-b"><pb n="80" ed="#attenborough"/>Gif<ptr type="editorNote" n="7" target="#Af_36-2-b.attnote.fn.7"/> hie sien bu gelic<ptr type="editorNote" n="8" target="#Af_36-2-b.attnote.fn.8"/>, ord ⁊ hindeweard sceaft, þæt sie butan pleo.</seg></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e" n="37.2[b]–37.3"><seg type="part" n="37.2[b]" corresp="#part-a"><pb n="334" ed="#jurasinski-and-oliver"/>gif se ord sie ufor þonne hindeweard sceaft.</seg> <seg type="part" n="37.3" corresp="#part-b"><pb n="334" ed="#jurasinski-and-oliver"/>Gif hie sien bu gelic, ord ⁊ hindeweard sceaft, þæt sie butan pleo.</seg></ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><seg type="part" corresp="#part-a"><ptr type="liebermannNote" n="1" target="#Af_36-2-a.lnote.de.1"/><pb n="71" ed="#liebermann"/>vorausgesetzt, die Spitze sei (3<ptr type="liebermannNote" n="2" target="#Af_36-2-a.lnote.de.2"/> Finger) höher als hinterer<ptr type="liebermannNote" n="3" target="#Af_36-2-a.lnote.de.3"/> Schaft.</seg> <seg type="part" corresp="#part-b"><pb n="71" ed="#liebermann"/>Wenn sie gleich [hoch] sind, beides<ptr type="liebermannNote" n="4" target="#Af_36-2-b.lnote.de.4"/>, Spitze und hinterer Schaft, das gelte ohne gefährliche Absicht.</seg></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman"><seg type="part" corresp="#part-a">provided that the point is (3 fingers) higher than the rear shaft.</seg> <seg type="part" corresp="#part-b">If they are both equal [in height], point and rear shaft, let that count as without dangerous intent.</seg></ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><seg type="part" corresp="#part-a"><pb n="81" ed="#attenborough"/>supposing the point to be higher than the [other] end of the shaft, by the width of three fingers<ptr type="editorNote" n="1" target="#Af_36-2-a.attnote.n.1"/>.</seg> <seg type="part" corresp="#part-b"><pb n="81" ed="#attenborough"/>If they are both on a level, the point and the [other] end of the shaft, the man with the spear shall not be regarded as responsible for causing danger<ptr type="editorNote" n="2" target="#Af_36-2-b.attnote.n.2"/>.</seg></ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><seg type="part" corresp="#part-a"><pb n="415" ed="#whitelock"/>if the point is higher<ptr type="editorNote" n="2" target="#Af_36-2-a.whinote.n.2"/> than the butt end of the shaft. If they are both level, the point and the butt end, that is to be [considered] without risk.</seg></ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><seg type="part" corresp="#part-a"><pb n="335" ed="#jurasinski-and-oliver"/>if the point is higher than the shaft in the back.</seg> <seg type="part" corresp="#part-b"><pb n="335" ed="#jurasinski-and-oliver"/>If they are equal in height, the point and the shaft in the back, that shall not be considered danger[ous intention].</seg></ab>
        <note type="concordance"><seg type="edition">Jurasinski and Oliver 37.2[b], 37.3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">þry fingra <hi rend="italic">fügt zu So;</hi> ðry fingere <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þry fingra added by So; ðry fingere Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">hindw. <hi rend="italic">So;</hi> hindwearde sceafte <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hindw. So; hindwearde sceafte Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> ufon</seg><seg type="translation" xml:lang="en" source="#claude">altered to ufon</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">71</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">acies</hi> l. sit <hi rend="spaced">altior</hi> <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">acies</hi> l. sit <hi rend="italic">altior</hi> Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">71</biblScope></bibl><seg type="original" xml:lang="de">alt. <hi rend="spaced">feratur</hi> <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">alt. <hi rend="italic">feratur</hi> Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. zugefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">added in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.4-3" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">später eingefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">inserted later</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_36-2-a.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Die ersten 8 Wörter ständen logischer <hi rend="spaced">vor</hi> <hi rend="italic">getriowe.</hi> Schon B cor. empfindet das, indem er hier ‘und dies sei’ und ‘dagegen’ vor ‘wenn’ einführt</seg><seg type="translation" xml:lang="en" source="#claude">The first 8 words would stand more logically <hi rend="italic">before</hi> <hi rend="italic">getriowe.</hi> B cor. already senses this, introducing here ‘and let this be’ and ‘on the other hand’ before ‘if’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_36-2-a.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Diese Einschaltung stand zwar vielleicht schon am Rande des Archetyps, stammt aber wahrscheinlich nicht von Ælfred. Zwar die Form bietet keinen Gegengrund, wiewohl Wülfing, nur auf H cor. gestützt, sie bedenklich findet. Er möchte <hi rend="italic">þreofingre</hi> adverbial lesen; <hi rend="italic">Syntax</hi> 267. Dagegen kann in So <hi rend="italic">fingra</hi> Gen. von 3 abhängig sein; H cor. und Ld neigen zum Mittelenglischen. Aber bei diesem Zusatz müsste Af unter wagerecht auch die Lage umfassen, wenn Spitze 1 bis 2 Finger höher getragen ward</seg><seg type="translation" xml:lang="en" source="#claude">This insertion perhaps already stood in the margin of the archetype, but it probably does not derive from Ælfred. The form, it is true, offers no argument against it, although Wülfing, relying only on H cor., finds it questionable. He would read <hi rend="italic">þreofingre</hi> as an adverb; <hi rend="italic">Syntax</hi> 267. On the other hand, in So <hi rend="italic">fingra</hi> may be a gen. dependent on 3; H cor. and Ld tend towards Middle English. But with this addition Af would have to include under ‘horizontal’ the position in which the point was carried 1 to 2 fingers higher as well</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_36-2-a.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘Schaftende’. In seiner Gregor-Übers. sagt Ælfred (ed. Sweet 296): er erstach ihn nicht mit <hi rend="italic">þæs speres orde, ac mid hindeweardum þæm sceafte</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘Shaft-end’. In his translation of Gregory, Ælfred says (ed. Sweet 296): he did not stab him with <hi rend="italic">þæs speres orde, ac mid hindeweardum þæm sceafte</hi></seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_36-2-a.attnote.fn.4" n="4" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>gif</label><seg type="original" xml:lang="en"><hi rend="italic">⁊ þis beo, gif</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_36-2-a.attnote.fn.5" n="5" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>ufor</label><seg type="original" xml:lang="en"><hi rend="italic">ufon</hi>. H*.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_36-2-a.attnote.fn.6" n="6" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>fingre</label><seg type="original" xml:lang="en">H (cf. So, Ld).</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_36-2-a.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">197</biblScope></bibl><seg type="original" xml:lang="en">The words ‘supposing the point...fingers’ obviously belong to the preceding section; the spear point would thus be on a level with the face (see Pollock and Maitland, <hi rend="italic">Hist. of Eng. Law</hi>, <hi rend="smallcaps">i</hi>. p. 31).</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Af_36-2-a.whinote.n.2" n="2" source="#whitelock"><bibl><biblScope unit="page">415</biblScope></bibl><label>higher</label><seg type="original" xml:lang="en"><hi rend="italic">Textus RoJJetisis</hi> and <hi rend="italic">Quadripartitus</hi> add here: “three fingers”</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-b.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">hi <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hi Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-b.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">synd <hi rend="italic">So;</hi> syn <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">synd So; syn Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-b.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">bú <hi rend="italic">So;</hi> <hi rend="spaced">butu</hi> gelice <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">bú So; <hi rend="italic">butu</hi> gelice Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-b.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">hindw. <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hindw. So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-b.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">sy buton pleoh <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy buton pleoh Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-b.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-b.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-b.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">71</biblScope></bibl><seg type="original" xml:lang="de">sit <hi rend="italic">Hn</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit Hn</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_36-2-b.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Diese Neutra <hi rend="italic">bu</hi> und verstärkt <hi rend="italic">buta,</hi> obwohl <hi rend="italic">ord</hi> und <hi rend="italic">sceaft</hi> masc., bedeuten den Übergang zur Mittelengl. Partikel ‘sowohl — als auch’; Leas 19 in Grein <hi rend="italic">Agsä. Poesie</hi> II 142; Sievers <hi rend="italic">Gram.</hi> 324; Mätzner <hi rend="italic">Wb</hi> 191 b 4</seg><seg type="translation" xml:lang="en" source="#claude">These neuters <hi rend="italic">bu</hi> and, reinforced, <hi rend="italic">buta,</hi> although <hi rend="italic">ord</hi> and <hi rend="italic">sceaft</hi> are masc., mark the transition to the Middle English particle ‘both — and’; Leas 19 in Grein <hi rend="italic">Agsä. Poesie</hi> II 142; Sievers <hi rend="italic">Gram.</hi> 324; Mätzner <hi rend="italic">Wb</hi> 191 b 4</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_36-2-b.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>Gif</label><seg type="original" xml:lang="en"><hi rend="italic">(Ac) gyf</hi>. B*.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_36-2-b.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>gelic</label><seg type="original" xml:lang="en"><hi rend="italic">buta gelice</hi>. B.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_36-2-b.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">197</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">Butan pleo</hi>; lit. ‘without danger.’ Quadr. translates <hi rend="italic">sine culpa.</hi></seg></note>
