    <body>
      <div type="clause" n="5.2">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 5.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 5.2"><pb n="630" ed="#liebermann"/>Si latro est<ptr type="liebermannNote" n="28" target="#ECf_5-2.lnote.la.28"/> uel raptor, quod male ceperit<ptr type="liebermannNote" n="29" target="#ECf_5-2.lnote.la.29"/>, si<ptr type="liebermannNote" n="30" target="#ECf_5-2.lnote.la.30"/> ad manum est, reddat<ptr type="liebermannNote" n="f" target="#ECf_5-2.lnote.la.fn.f"/>.</ab>
        <note type="comparison" source="#liebermann" n="630"><label>printed alongside</label> <ref target="clause:ECfRetr_5-2">ECf retr 5.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 630 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5-2.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verf. vergisst Buss- und Strafgeld</hi></seg><seg type="translation" xml:lang="en" source="#claude">the author forgets compensation and fine</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5-2.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Cl Hr S Ad; fehlt Rl Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Cl Hr S Ad; lacking in Rl Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5-2.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">-rat <hi rend="italic">Hr;</hi> cepit <hi rend="italic">S Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rat Hr; cepit S Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5-2.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod S</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">If he is a thief or robber, let him return what he wrongly took, if it is at hand.</ab>
      </div>
    </body>
