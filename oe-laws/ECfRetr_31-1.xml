    <body>
      <div type="clause" n="31.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 31.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 31.1"><pb n="653" ed="#liebermann"/><hi rend="bold">Sicque</hi><ptr type="liebermannNote" n="1" target="#ECfRetr_31-1.lnote.la.1"/> quod Angli uocabant hundredum<ptr type="liebermannNote" n="34" target="#ECfRetr_31-1.lnote.la.34"/>, isti: wapentagium<ptr type="liebermannNote" n="35" target="#ECfRetr_31-1.lnote.la.35"/>; et quod<ptr type="liebermannNote" n="36" target="#ECfRetr_31-1.lnote.la.36"/> <hi rend="bold">Anglice</hi> uocabantur<ptr type="liebermannNote" n="37" target="#ECfRetr_31-1.lnote.la.37"/> tria uel quatuor uel plura hundreda<ptr type="liebermannNote" n="38" target="#ECfRetr_31-1.lnote.la.38"/>, isti uocabant<ptr type="liebermannNote" n="39" target="#ECfRetr_31-1.lnote.la.39"/> þrihinga<ptr type="liebermannNote" n="40" target="#ECfRetr_31-1.lnote.la.40"/>.</ab>
        <note type="comparison" source="#liebermann" n="653"><label>printed alongside</label> <ref target="clause:ECf_31-1">ECf 31.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 653 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-1.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt aus</hi> 30, 1</seg><seg type="translation" xml:lang="en" source="#claude">repeated from 30, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-1.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht etwa ein fester District</hi></seg><seg type="translation" xml:lang="en" source="#claude">not, say, a fixed district</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-1.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-1.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">-etum <hi rend="italic">Cb Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">-etum Cb Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-1.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">-tag <hi rend="italic">Va Hv;</hi> -tachium <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tag Va Hv; -tachium Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-1.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-1.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">-bant <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-bant Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-1.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">-eta <hi rend="italic">Cb Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">-eta Cb Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-1.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">uocant <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">uocant Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-1.lnote.la.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Cb Lb Db Lond;</hi> ðr. <hi rend="italic">Ld;</hi> dr. <hi rend="italic">Va;</hi> tr. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Cb Lb Db Lond; ðr. Ld; dr. Va; tr. Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And so what the English called a hundred, these a wapentake; and what were called in English three or four or more hundreds, these called a <hi rend="italic">þrihinga</hi>.</ab>
      </div>
    </body>
