        <head><ref type="lawCode" target="law:Hn">Hn</ref> 92.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 92.1" corresp="#wit-lat"><pb n="607" ed="#liebermann"/>Si quis uulneratus in alium hundretum eat et ibi moriatur, et<ptr type="liebermannNote" n="21" target="#Hn_92-1.lnote.oe.21"/> ad murdrum ueniat<ptr type="liebermannNote" n="m" target="#Hn_92-1.lnote.oe.m"/>, illic<ptr type="liebermannNote" n="28" target="#Hn_92-1.lnote.oe.28"/> persoluatur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 607 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-1.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">die Untersuchung</hi> ausläuft</seg><seg type="translation" xml:lang="en" source="#claude">the investigation ends up</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-1.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de">ibi <hi rend="italic">Lond;</hi> illīc <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">ibi Lond; illīc Sc</seg></note>
