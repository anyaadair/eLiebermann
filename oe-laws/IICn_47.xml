        <note type="liebermannNote" subtype="textual" xml:id="IICn_47.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">345</biblScope></bibl><seg type="original" xml:lang="de">-sime <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sime Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_47.lnote.oe.7-2" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">345</biblScope></bibl><seg type="original" xml:lang="de">al. m. m. f. aut ra. aut mu. duc., dup. <hi rend="italic">Di</hi></seg><seg type="translation" xml:lang="en" source="#claude">al. m. m. f. aut ra. aut mu. duc., dup. Di</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_47.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">209</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Wohl = <hi rend="italic">in folce</hi> Af 40, 2², ‘notorisch, handhaft’ im Ggs. zu 47, 1</seg><seg type="translation" xml:lang="en" source="#claude">Probably = <hi rend="italic">in folce</hi> Af 40, 2², ‘notorious, taken in the act’, in contrast to 47, 1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_47.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">209</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl</hi>. Busse 10b. Stehlen und Hauseinbruch nannte Af 5, 5. 40, 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf.</hi> Busse 10b. Af 5, 5. 40, 1 named theft and housebreaking</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_47.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">209</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Widerrechtliche Unzucht, nicht (da Missetat) ehelicher Beischlaf oder Hochzeit; <hi rend="italic">s. Gl</hi> Eheschliessung 13a</seg><seg type="translation" xml:lang="en" source="#claude">Unlawful fornication, not (since it is a misdeed) marital intercourse or a wedding; <hi rend="italic">see Gl</hi> Eheschliessung 13a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_47.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">209</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">archetype Glosse? <hi rend="italic">o</hi>. Einl. 3</seg><seg type="translation" xml:lang="en" source="#claude">Gloss in the archetype? <hi rend="italic">above</hi> Introduction 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_47.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">209</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Doppelung (<hi rend="italic">s. d. Gl</hi> 2) des Strafgeldes, das sonst für die genannten Missetaten verwirkt wäre (und nicht etwa bloss des Fastenbruch-Strafgeldes <hi rend="italic">o</hi>. 46), aber auch der an die verletzte Partei zu zahlenden Busse; <hi rend="italic">s. Gl</hi> Feiertag 9a</seg><seg type="translation" xml:lang="en" source="#claude">Doubling (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 2) of the fine that would otherwise be forfeited for the misdeeds named (and not merely of the fine for breaking the fast <hi rend="italic">above</hi> 46), but also of the compensation to be paid to the injured party; <hi rend="italic">see Gl</hi> Feiertag 9a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_47.lnote.de.6" n="6" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">209</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Von Af 5, 5 näher bezeichnet</seg><seg type="translation" xml:lang="en" source="#claude">Specified more precisely by Af 5, 5</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_47.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">357</biblScope></bibl><seg type="original" xml:lang="en">Cf. Af. 5, 5; 40, 2.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_47.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">357</biblScope></bibl><seg type="original" xml:lang="en">Cf. DB. <hi rend="smallcaps">i</hi>. 262 <hi rend="italic">b</hi>, 1.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_47.robnote.fn.1" n="1" source="#robertson"><bibl><biblScope unit="page">200</biblScope></bibl><label>twibote</label><seg type="original" xml:lang="en"><hi rend="italic">twybete</hi> G, A, Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_47.robnote.fn.2" n="2" source="#robertson"><bibl><biblScope unit="page">200</biblScope></bibl><label>eac</label><seg type="original" xml:lang="en">Om. G, A; written above the line in B.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IICn_47.whinote.n.4" n="4" source="#whitelock"><bibl><biblScope unit="page">469</biblScope></bibl><label>47</label><seg type="original" xml:lang="en">c.f. Alfred 5.5, 40.1f.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IICn_47.whinote.n.5" n="5" source="#whitelock"><bibl><biblScope unit="page">469</biblScope></bibl><label>robbery</label><seg type="original" xml:lang="en">Robbery is omitted in the Nero version and originally in <hi rend="italic">Quadripartitus</hi>.</seg></note>
