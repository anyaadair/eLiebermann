        <note type="liebermannNote" subtype="textual" xml:id="Ine_70-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">118</biblScope></bibl><seg type="original" xml:lang="de">es <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">es on an erasure</seg></note>
