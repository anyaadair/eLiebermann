    <body>
      <div type="clause" n="30.8">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 30.8</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="30.8" corresp="#wit-g-a"><pb n="334" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="15" target="#IICn_30-8.lnote.oe.15"/> seo<ptr type="liebermannNote" n="16" target="#IICn_30-8.lnote.oe.16"/> lad forðcume, beo he þæs weres wyrðe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="30.8" corresp="#wit-b"><pb n="334" ed="#liebermann"/>Gyf seo lád<ptr type="liebermannNote" n="3" target="#IICn_30-8.lnote.oe.3"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="30.8" corresp="#wit-a"><pb n="334" ed="#liebermann"/>Gif seo lad forðcyme, beo he þæs weres wyrðe.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="30.8" corresp="#wit-q"><pb n="335" ed="#liebermann"/>Si purgatio perficiatur<ptr type="liebermannNote" n="8" target="#IICn_30-8.lnote.oe.8"/>, sit wérę suę dignus.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="30.8" corresp="#wit-inst-cn"><pb n="335" ed="#liebermann"/>Si se purgauerit, illi<ptr type="liebermannNote" n="5" target="#IICn_30-8.lnote.oe.5"/> detur prętium latronis, id est ƿere.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="30.8" corresp="#wit-cons-cn"><pb n="335" ed="#liebermann"/>Que purgacio si perfecta fuerit, sit dominus dignus illa redempcione accipienda.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="30.8" corresp="#wit-b"><pb n="192" ed="#robertson"/>Gyf seo lád [forðcume, beo he þæs weres wyrðe.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="272" ed="#rabin-doml"/>Gyf seo lad forðcume, beo he þæs weres wyrðe.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="335" ed="#liebermann"/>Wenn diese Reinigung zu Stande kommt, so sei er zu jenem Wergeld [seines Untergebenen] berechtigt.<ptr type="liebermannNote" n="1" target="#IICn_30-8.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the clearing succeeds, let him be entitled to that wergild [of his dependant].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="193" ed="#robertson"/>If he succeeds in clearing himself, he shall be entitled to the wergeld.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="466" ed="#whitelock"/>And if the exculpation succeeds, he is to be entitled to the wergild.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="273" ed="#rabin-doml"/>If the exoneration is successful, he will be entitled to the wergild.</ab>
        <note type="comparison" source="#liebermann" n="335"><ref target="clause:IAtr_1-9">I Atr 1.9</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. I Atr. 1, 9</note>
        <note type="editorial">B skips a line here. Liebermann compares I Atr 1.9.; BR: added from Gesetze I p. 335, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">forðcume . . . wyrðe: omitted B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-8.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">335</biblScope></bibl><seg type="original" xml:lang="de">Que pu. si p. sit, dignus i. r. accipiendus est do. fugitiui, <hi rend="bold">et fideiussor soluet redemptionem</hi> <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Que pu. si p. sit, dignus i. r. accipiendus est do. fugitiui, <hi rend="bold">et fideiussor soluet redemptionem</hi> Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-8.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">334</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">eine Zeile übersprungen</hi></seg><seg type="translation" xml:lang="en" source="#claude">a line skipped</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-8.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">335</biblScope></bibl><seg type="original" xml:lang="de">offic. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">offic. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-8.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">334</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-8.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">334</biblScope></bibl><seg type="original" xml:lang="de">se lade <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">se lade Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-8.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">335</biblScope></bibl><seg type="original" xml:lang="de">d. i. <hi rend="italic">Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. i. Lb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_30-8.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">207</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Dass Bürge Wergeld des Verbrechers zahlt, fügt Cons Glosse, wohl aus 30, 6, ein; <hi rend="italic">vgl. Gl</hi> Bürgschaft 14a</seg><seg type="translation" xml:lang="en" source="#claude">That the surety pays the criminal's wergild is inserted as a gloss by Cons, probably from 30, 6; <hi rend="italic">cf. Gl</hi> Bürgschaft 14a</seg></note>
      </div>
