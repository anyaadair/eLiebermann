      <div type="clause" n="64.1e">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 64.1e</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 64.1e" corresp="#wit-lat"><pb n="584" ed="#liebermann"/>Continget etiam<ptr type="liebermannNote" n="1" target="#Hn_64-1e.lnote.oe.1"/> anteiuramentum non<ptr type="liebermannNote" n="c" target="#Hn_64-1e.lnote.oe.c"/> dari, non frangi<ptr type="liebermannNote" n="d" target="#Hn_64-1e.lnote.oe.d"/>, per alterum fieri: a<ptr type="liebermannNote" n="e" target="#Hn_64-1e.lnote.oe.e"/><ptr type="liebermannNote" n="2" target="#Hn_64-1e.lnote.oe.2"/> re ipsa, a persona, prelacione, nacione<ptr type="liebermannNote" n="f" target="#Hn_64-1e.lnote.oe.f"/>, merito.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 584 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1e.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">unterbleiben; <hi rend="italic">vgl.</hi> 63, 1 [‘nicht vom Gegner gegeben werde’; <hi rend="italic">Brunner</hi> DRG. II 427]</seg><seg type="translation" xml:lang="en" source="#claude">be omitted; cf. 63, 1 [‘not be tendered by the opponent’; Brunner DRG. II 427]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1e.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">gestabt</seg><seg type="translation" xml:lang="en" source="#claude">formal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1e.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">je nach Gegenstand, Person, Amtsrang</seg><seg type="translation" xml:lang="en" source="#claude">according to the matter, the person, rank of office</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1e.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 64, 2; 3<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 64, 2; 3<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1e.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">etenim <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">etenim Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1e.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Co Or</seg></note>
