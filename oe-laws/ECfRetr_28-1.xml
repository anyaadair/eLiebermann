  <text>
    <body>
      <div type="clause" n="28.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 28.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 28.1"><pb n="652" ed="#liebermann"/>Isti<ptr type="liebermannNote" n="1" target="#ECfRetr_28-1.lnote.la.1"/> inter uillas <hi rend="bold">et</hi> uicinas <hi rend="bold">causulas</hi><ptr type="liebermannNote" n="2" target="#ECfRetr_28-1.lnote.la.2"/> tractabant et secundum<ptr type="liebermannNote" n="3" target="#ECfRetr_28-1.lnote.la.3"/> forisfacturas emendationes <hi rend="bold">capiebant</hi> et concordationes <hi rend="bold">faciebant,</hi> uidelicet<ptr type="liebermannNote" n="4" target="#ECfRetr_28-1.lnote.la.4"/> de pascuis<ptr type="liebermannNote" n="5" target="#ECfRetr_28-1.lnote.la.5"/>, pratis, messibus<ptr type="liebermannNote" n="6" target="#ECfRetr_28-1.lnote.la.6"/>, et de <hi rend="bold">litigationibus</hi><ptr type="liebermannNote" n="7" target="#ECfRetr_28-1.lnote.la.7"/> inter uicinos et <hi rend="bold">innumerabilibus</hi> huiusmodi decertationibus, que <hi rend="bold">humanam</hi><ptr type="liebermannNote" n="13" target="#ECfRetr_28-1.lnote.la.13"/> <hi rend="bold">fragilitatem infestant et eam incessanter oppugnant</hi><ptr type="liebermannNote" n="14" target="#ECfRetr_28-1.lnote.la.14"/>.</ab>
        <note type="comparison" source="#liebermann" n="652"><label>printed alongside</label> <ref target="clause:ECf_28-1">ECf 28.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 652 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">There are no notes 8–12 in the ECf retr column of this page: Liebermann’s numbering goes from 7 to 13.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28-1.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">Item (<hi rend="italic">statt</hi> I. i.) <hi rend="italic">K;</hi> Item u. u. tales tr. <hi rend="italic">Hv</hi> (<hi rend="italic">ein Besserungsversuch</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">Item (instead of I. i.) K; Item u. u. tales tr. Hv (an attempt at improvement)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28-1.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">cas. <hi rend="italic">Lb Va Ph Lond</hi> (<hi rend="italic">anderer Besserungsversuch</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">cas. Lb Va Ph Lond (another attempt at improvement)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28-1.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">super <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">super Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28-1.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">scil. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">scil. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28-1.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">pra., pas. <hi rend="italic">Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">pra., pas. Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28-1.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">aruis <hi rend="italic">fügt zu Cb;</hi> m., negotiationibus et hu. d. in. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cb adds aruis; m., negotiationibus et hu. d. in. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28-1.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">ligat. <hi rend="italic">Va;</hi> litigion. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">ligat. Va; litigion. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28-1.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert aus</hi> humanis <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected from humanis Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28-1.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">impu. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">impu. Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">These dealt with petty cases between vills and neighbours, and took compensations according to the offences and made settlements, namely concerning pastures, meadows, harvests, and concerning lawsuits between neighbours and countless quarrels of this kind, which beset human frailty and assail it unceasingly.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28-1.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">casulas</hi><hi rend="superscript">2</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">casulas</hi><hi rend="superscript">2</hi> Rs</seg></note>
      </div>
    </body>
  </text>
