      <div type="clause" n="8.3a">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 8.3a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 8.3a"><pb n="632" ed="#liebermann"/>Sed postea instinctu diaboli <hi rend="bold">multi</hi> eam detinuerunt<ptr type="liebermannNote" n="**" target="#ECfRetr_8-3a.lnote.la.**"/>; et sacerdotes <hi rend="bold">locupletes</hi><ptr type="liebermannNote" n="43" target="#ECfRetr_8-3a.lnote.la.43"/> <hi rend="bold">negligentes</hi><ptr type="liebermannNote" n="44" target="#ECfRetr_8-3a.lnote.la.44"/> <hi rend="bold">nec</hi><ptr type="liebermannNote" n="45" target="#ECfRetr_8-3a.lnote.la.45"/> <hi rend="bold">curabant</hi> <pb n="633" ed="#liebermann"/><hi rend="bold">inire laborem</hi> ad perquirendas<ptr type="liebermannNote" n="1" target="#ECfRetr_8-3a.lnote.la.1"/> eas, <hi rend="bold">eo quod sufficienter habebant sue</hi><ptr type="liebermannNote" n="2" target="#ECfRetr_8-3a.lnote.la.2"/> <hi rend="bold">uite</hi><ptr type="liebermannNote" n="3" target="#ECfRetr_8-3a.lnote.la.3"/> <hi rend="bold">necessaria</hi> — multis <hi rend="bold">enim</hi> in<ptr type="liebermannNote" n="4" target="#ECfRetr_8-3a.lnote.la.4"/> locis<ptr type="liebermannNote" n="5" target="#ECfRetr_8-3a.lnote.la.5"/> modo<ptr type="liebermannNote" n="4" target="#ECfRetr_8-3a.lnote.la.4"/> sunt<ptr type="liebermannNote" n="6" target="#ECfRetr_8-3a.lnote.la.6"/> tres<ptr type="liebermannNote" n="7" target="#ECfRetr_8-3a.lnote.la.7"/> uel<ptr type="liebermannNote" n="8" target="#ECfRetr_8-3a.lnote.la.8"/> quatuor ecclesie, ubi tunc temporis una<ptr type="liebermannNote" n="9" target="#ECfRetr_8-3a.lnote.la.9"/> <hi rend="bold">tantum</hi> erat —; et sic ceperunt minui<ptr type="liebermannNote" n="10" target="#ECfRetr_8-3a.lnote.la.10"/>.</ab>
        <note type="comparison" source="#liebermann" n="632"><label>printed alongside</label> <ref target="clause:ECf_8-3a">ECf 8.3a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 632–633 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-3a.lnote.la.**" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">et adhuc detinent <hi rend="italic">fügt zu Cc</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cc adds et adhuc detinent</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-3a.lnote.la.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">n. l. <hi rend="italic">Hv K</hi></seg><seg type="translation" xml:lang="en" source="#claude">n. l. Hv K</seg></note>
