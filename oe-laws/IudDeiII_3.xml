        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">Item a. <hi rend="italic">Rj;</hi> a. oratio <hi rend="italic">Ch Co;</hi> Oratio <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Item a. Rj; a. oratio Ch Co; Oratio Tr</seg></note>
