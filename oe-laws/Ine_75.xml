        <note type="liebermannNote" subtype="textual" xml:id="Ine_75.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">122</biblScope></bibl><seg type="original" xml:lang="de">þ. h. <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">þ. h. So</seg></note>
