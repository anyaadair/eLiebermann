        <note type="editorNote" subtype="footnote" xml:id="VAs_Prol-to-1.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">152</biblScope></bibl><label>ærfe</label><seg type="original" xml:lang="en"><hi rend="italic">yrfe</hi>.</seg></note>
