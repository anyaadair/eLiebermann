      <div type="clause" n="El. 42">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 42</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 42" corresp="#wit-e"><pb n="40" ed="#liebermann"/>Gif ðe becume oðres mannes giemeléas<ptr type="liebermannNote" n="23" target="#Af_El-to-42.lnote.oe.23"/> fioh<ptr type="liebermannNote" n="24" target="#Af_El-to-42.lnote.oe.24"/> on hond<ptr type="liebermannNote" n="25" target="#Af_El-to-42.lnote.oe.25"/>, þeah hit sie<ptr type="liebermannNote" n="26" target="#Af_El-to-42.lnote.oe.26"/> ðin<ptr type="liebermannNote" n="27" target="#Af_El-to-42.lnote.oe.27"/> feond<ptr type="liebermannNote" n="28" target="#Af_El-to-42.lnote.oe.28"/>, gecyðe hit him.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 42" corresp="#wit-g-prol-only"><pb n="40" ed="#liebermann"/>Gif ðe becyme oðres mannes gymeleas feoh on handa<ptr type="liebermannNote" n="1" target="#Af_El-to-42.lnote.oe.1"/>, ðeah hyt sie ðin feond, gecyðe hit hym.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 42" corresp="#wit-h"><pb n="41" ed="#liebermann"/>Gif þe becume oþres monnes<ptr type="liebermannNote" n="2" target="#Af_El-to-42.lnote.oe.2"/> gymeleas fioh on hond<ptr type="liebermannNote" n="2" target="#Af_El-to-42.lnote.oe.2"/>, þeah hit sy<ptr type="liebermannNote" n="12" target="#Af_El-to-42.lnote.oe.12"/> ðin fiond, gecyþ hit him.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 42" corresp="#wit-q"><pb n="41" ed="#liebermann"/>Si occurreris boui inimici tui aut asino erranti, reduc ad eum. Si uideris asinum odientis te iacere sub onere<ptr type="liebermannNote" n="8" target="#Af_El-to-42.lnote.oe.8"/>, non pertransibis, sed subleuabis<ptr type="liebermannNote" n="9" target="#Af_El-to-42.lnote.oe.9"/> cum eo.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 42" corresp="#wit-e"><pb n="258" ed="#jurasinski-and-oliver"/>Gif ðe becume oðres mannes giemeleás fioh on hond, þeah hit sie ðin feond, gecyðe hit him.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="41" ed="#liebermann"/>Wenn dir aufsichtsloses<ptr type="liebermannNote" n="1" target="#Af_El-to-42.lnote.de.1"/> Vieh<ptr type="liebermannNote" n="2" target="#Af_El-to-42.lnote.de.2"/> eines anderen Mannes unter die Hand kommt, sei dieser gleich dein Feind, so melde es ihm.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If another man’s unattended livestock comes into your hand, even if he is your enemy, let him know of it.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="259" ed="#jurasinski-and-oliver"/>If another’s stray cattle should come into your possession, though it may belong to your foe, announce it to him.</ab>
        <note type="passageSource">Exodus 23,4</note>
        <note type="comparison" source="#liebermann" n="41">Exodus 23.4</note>
        <note type="comparisonPrinted" source="#liebermann">[23, 4]</note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-42.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">-se <hi rend="italic">So;</hi> gym. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-se So; gym. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-42.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">feoh <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">feoh So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-42.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">hand <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">hand So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-42.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-42.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">þine <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">þine So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-42.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">-de <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-de Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-42.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geändert in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-42.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-42.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de">hon. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">hon. R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-42.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de">sull. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">sull. T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-42.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geändert in</hi> hand</seg><seg type="translation" xml:lang="en" source="#claude">altered to hand</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-42.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">47</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘herumirrend’ Schmid</seg><seg type="translation" xml:lang="en" source="#claude">‘wandering about’ Schmid</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-42.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">47</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘Esel’ (<hi rend="italic">s. Gl</hi>) Vulg. Af unterdrückt dessen Erwähnung, und übergeht wohl darum Ex. 23, 5</seg><seg type="translation" xml:lang="en" source="#claude">‘ass’ (<hi rend="italic">see Gl</hi>) Vulg. Af suppresses the mention of it, and probably for that reason passes over Ex. 23, 5</seg></note>
      </div>
