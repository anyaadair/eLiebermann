    <body>
      <div type="clause" n="49">
        <head><ref type="lawCode" target="law:Af">Af</ref> 49</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="49" corresp="#wit-e"><pb n="80" ed="#liebermann"/>Gif mon oðrum ðone toð<ptr type="liebermannNote" n="13" target="#Af_49.lnote.oe.13"/> onforan<ptr type="liebermannNote" n="14" target="#Af_49.lnote.oe.14"/> heafde ófaslea, gebete þæt mid VIII<ptr type="liebermannNote" n="15" target="#Af_49.lnote.oe.15"/> scill.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="49" corresp="#wit-h"><pb n="80" ed="#liebermann"/>Gif mon<ptr type="liebermannNote" n="4" target="#Af_49.lnote.oe.4"/> oþrum ðone toð ofaslea onforan heafde, gebete<ptr type="liebermannNote" n="8" target="#Af_49.lnote.oe.8"/> ðæt mid VIII scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="49" corresp="#wit-b-no-prol"><pb n="80" ed="#liebermann"/>Gyf man oðrum ðone toð onforen heafde ofaslea, gebetað<ptr type="liebermannNote" n="4" target="#Af_49.lnote.oe.4-2"/> þ<hi rend="italic">æt</hi> mid eahta scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="49" corresp="#wit-q"><pb n="81" ed="#liebermann"/>Si quis alteri<ptr type="liebermannNote" n="11" target="#Af_49.lnote.oe.11"/> (homini) teþ<ptr type="liebermannNote" n="12" target="#Af_49.lnote.oe.12"/> onforen heued (primos dentes id est precisores) excusserit, VIII solid. culpa sit.<ptr type="liebermannNote" n="13" target="#Af_49.lnote.oe.13-2"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="86" ed="#attenborough"/>Gif mon oðrum ðone toð onforan heafde ófaslea, gebete<ptr type="editorNote" n="12" target="#Af_49.attnote.fn.12"/> þæt mid VIII scill.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="52" corresp="#wit-e"><pb n="352" ed="#jurasinski-and-oliver"/>Gif mon oðrum ðone toð onforan heafde ófaslea, gebete þæt mid VIII scill.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="81" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_49.lnote.de.1"/> jemand einem anderen den Zahn<ptr type="liebermannNote" n="2" target="#Af_49.lnote.de.2"/> vorn<ptr type="liebermannNote" n="3" target="#Af_49.lnote.de.3"/> am Kopf ausschlägt, büsse [er] das mit 8 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone knocks out another’s tooth at the front of the head, let him pay for it with 8 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="87" ed="#attenborough"/>If anyone knocks out another's front tooth<ptr type="editorNote" n="1" target="#Af_49.attnote.n.1"/>, he shall pay 8 shillings as compensation for it.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="353" ed="#jurasinski-and-oliver"/>If someone strikes out from another the tooth in the front of the head, let him compensate that with 8 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_49.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">toþe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">toþe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_49.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">onf. <hi rend="italic">ein Wort E</hi></seg><seg type="translation" xml:lang="en" source="#claude">onf. as one word E</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_49.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">eahta <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">eahta Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_49.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_49.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">ge <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">ge written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_49.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> alt. <hi rend="italic">Lond; nur</hi> ho. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">only alt. Lond; only ho. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_49.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">t. o. h. <hi rend="italic">nur Co übergeschr.; fehlt übrigen</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. o. h. written above only in Co; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_49.lnote.oe.13-2" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">fit <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">fit R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_49.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_49.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Q verstand die Lateinischen Zahnnamen richtig laut Hn 93, 6</seg><seg type="translation" xml:lang="en" source="#claude">Q understood the Latin names of the teeth correctly, according to Hn 93, 6</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_49.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Gemäss Abt 51, mit anderer Klassifikation und Busszahl. <hi rend="italic">Vgl. Gl</hi> Zahn 4</seg><seg type="translation" xml:lang="en" source="#claude">In accordance with Abt 51, with a different classification and amount of compensation. <hi rend="italic">Cf. Gl</hi> Zahn 4</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_49.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Nicht zu trennen <hi rend="italic">on foran</hi> oder gar <hi rend="italic">foranheafod:</hi> ‘Vorderkopf’ zu verstehen. Letzteres heisst ‘Stirn’. Gemeint ist einer der 8 <hi rend="italic">incisores,</hi> ein Schneide-, Mittelzahn</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">on foran</hi> is not to be separated, still less is <hi rend="italic">foranheafod:</hi> ‘forepart of the head’ to be understood. The latter means ‘forehead’. What is meant is one of the 8 <hi rend="italic">incisores,</hi> a cutting or middle tooth</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_49.attnote.fn.12" n="12" source="#attenborough"><bibl><biblScope unit="page">86</biblScope></bibl><label>gebete</label><seg type="original" xml:lang="en"><hi rend="italic">gebetað</hi>. B.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_49.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">199</biblScope></bibl><seg type="original" xml:lang="en">For a different classification of the teeth see Abt. cap. 51.</seg></note>
      </div>
    </body>
  </text>
