      <div type="clause" n="6.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 6.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 6.2" corresp="#wit-lat"><pb n="552" ed="#liebermann"/>Legis<ptr type="liebermannNote" n="i" target="#Hn_6-2.lnote.oe.i"/> etiam Anglice<ptr type="liebermannNote" n="20" target="#Hn_6-2.lnote.oe.20"/> trina est particio ad superiorem modum: alia enim Westsexia<ptr type="liebermannNote" n="21" target="#Hn_6-2.lnote.oe.21"/>, alia Mircena<ptr type="liebermannNote" n="k" target="#Hn_6-2.lnote.oe.k"/>, alia Denelaga<ptr type="liebermannNote" n="22" target="#Hn_6-2.lnote.oe.22"/> est; —</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 552 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-2.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ähnlich unten</hi> 9, 10<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">similarly below 9, 10a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-2.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Angelsächs. Genetiv, also aus nicht Latein. Tractate stammend</hi></seg><seg type="translation" xml:lang="en" source="#claude">Anglo-Saxon genitive, hence derived from a non-Latin tract</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">Angl' <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Angl' Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">Wets. <hi rend="italic">Sc Hg;</hi> -xe <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Wets. Sc Hg; -xe Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-2.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">Denl. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">Denl. Sc Hg</seg></note>
