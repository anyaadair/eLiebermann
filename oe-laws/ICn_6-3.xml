        <note type="editorNote" subtype="endnote" xml:id="ICn_6-3.robnote.n.3" n="3" source="#robertson"><bibl><biblScope unit="page">349</biblScope></bibl><seg type="original" xml:lang="en">Cf. caps. 7, 2 f.; 24; Procl. of 1020, cap. 15 f.; II Cn. 50–52, 1; 54–5.</seg></note>
