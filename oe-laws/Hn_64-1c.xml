      <div type="clause" n="64.1c">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 64.1c</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 64.1c" corresp="#wit-lat"><pb n="583" ed="#liebermann"/>In Hamtesira<ptr type="liebermannNote" n="40" target="#Hn_64-1c.lnote.oe.40"/> qui uerborum iurat obseruanciis<ptr type="liebermannNote" n="p" target="#Hn_64-1c.lnote.oe.p"/>, semel iuret, et in eo<ptr type="liebermannNote" n="q" target="#Hn_64-1c.lnote.oe.q"/> lapsus uel elapsus iudicetur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 583 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1c.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 64, 3</seg><seg type="translation" xml:lang="en" source="#claude">cf. 64, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1c.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de">entweder [<hi rend="italic">ohne Erholung</hi>] beweisfällig oder durchgekommen</seg><seg type="translation" xml:lang="en" source="#claude">either failed in his proof [without a fresh attempt] or cleared</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1c.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de">Hamptesyra <hi rend="italic">Sc Hg;</hi> Hamtesia <hi rend="italic">übr.;</hi> -scira <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hamptesyra Sc Hg; Hamtesia the rest; -scira Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1c.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de">Hampshire ist also dem Verf. besonders bekannt; <hi rend="italic">s. o</hi>. Einl. 6.—<hi rend="italic">Hamthe</hi>. Rs</seg><seg type="translation" xml:lang="en" source="#claude">Hampshire is thus especially familiar to the author; <hi rend="italic">see above</hi> Introduction 6.—<hi rend="italic">Hamthe</hi>. Rs</seg></note>
      </div>
