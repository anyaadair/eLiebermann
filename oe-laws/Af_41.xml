        <note type="liebermannNote" subtype="textual" xml:id="Af_41.lnote.oe.12-2" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">74</biblScope></bibl><seg type="original" xml:lang="de">fodbod, <hi rend="italic">aber erstes</hi> d <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">fodbod, but first d on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_41.lnote.oe.13-2" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">74</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hinter</hi> i <hi rend="italic">ein Buchstabe radirt</hi></seg><seg type="translation" xml:lang="en" source="#claude">a letter erased after i</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_41.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">75</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">bocland</hi> <hi rend="italic">statt</hi> t. t. (h.) <hi rend="italic">Hn</hi> 70, 21</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">bocland</hi> instead of t. t. (h.) Hn 70, 21</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_41.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">75</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> test. <hi rend="italic">Or; nur</hi> her. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">only test. Or; only her. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_41.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">75</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_41.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">75</biblScope></bibl><seg type="original" xml:lang="de">testis <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">testis Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_41.lnote.oe.7-3" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">75</biblScope></bibl><seg type="original" xml:lang="de">quid <hi rend="italic">Hk;</hi> quidem <hi rend="italic">Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">quid Hk; quidem Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_41.lnote.oe.8-2" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">75</biblScope></bibl><seg type="original" xml:lang="de">prohibuerit <hi rend="italic">statt</hi> pr. f. <hi rend="italic">THk;</hi> perhibuerit <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">prohibuerit instead of pr. f. THk; perhibuerit Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_41.lnote.oe.9-3" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">75</biblScope></bibl><seg type="original" xml:lang="de">-rint <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rint Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_41.lnote.oe.10-3" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">75</biblScope></bibl><seg type="original" xml:lang="de">-rint <hi rend="italic">Lond;</hi> <hi rend="spaced">dimiserunt</hi> <hi rend="italic">HkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rint Lond; <hi rend="italic">dimiserunt</hi> HkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_41.lnote.oe.11-3" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">75</biblScope></bibl><seg type="original" xml:lang="de">nec <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">nec R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_41.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">75</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">endet p.</hi>22; <hi rend="italic">dann ein Blatt ausgerissen</hi></seg><seg type="translation" xml:lang="en" source="#claude">ends p. 22; then a leaf torn out</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_41.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Bocland 8—13; Vorkaufsrecht; Sippe 28</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Bocland 8—13; Vorkaufsrecht; Sippe 28</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_41.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘Vorfahren’ H vielleicht aus Becwæð 1. Doch wie Af sprechen auch Latein. Urkk.: <hi rend="italic">prius propinqui tradiderunt mihi.</hi> — Präsens <hi rend="italic">ponimus</hi> in Q könnte richtig sein wegen der Inversion (Sievers <hi rend="italic">Gram.</hi> 360 Anm. 5), wenn nicht das folgende <hi rend="italic">moste</hi> ein vorangehendes Präteritum, von dem dies in Consecutio temporum abhängt, erforderte</seg><seg type="translation" xml:lang="en" source="#claude">‘ancestors’ H, perhaps from Becwæð 1. But Latin charters too speak as Af does: <hi rend="italic">prius propinqui tradiderunt mihi.</hi> — The present <hi rend="italic">ponimus</hi> in Q could be right because of the inversion (Sievers <hi rend="italic">Gram.</hi> 360 note 5), were it not that the following <hi rend="italic">moste</hi> requires a preceding preterite on which it depends by the sequence of tenses</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_41.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘verkaufen’ zu eng</seg><seg type="translation" xml:lang="en" source="#claude">‘sell’ too narrow</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_41.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Auch in Q braucht <hi rend="italic">testamentum</hi> nur <hi rend="italic">boc</hi> (<hi rend="italic">s. d. Gl</hi> 1b) zu meinen</seg><seg type="translation" xml:lang="en" source="#claude">In Q too <hi rend="italic">testamentum</hi> need mean only <hi rend="italic">boc</hi> (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1b)</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_41.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">nicht ‘ihnen’; <hi rend="italic">s. Gl bocland</hi> 8a</seg><seg type="translation" xml:lang="en" source="#claude">not ‘them’; <hi rend="italic">see Gl bocland</hi> 8a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_41.lnote.de.6" n="6" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Ellipse des Subjekts. Kläger ist es der <hi rend="italic">gerecce</hi> auch Hn 3</seg><seg type="translation" xml:lang="en" source="#claude">Ellipsis of the subject. The <hi rend="italic">gerecce</hi> is the plaintiff in Hn 3 too</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_41.lnote.de.7" n="7" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Königsgericht 8d; Witan 7c</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Königsgericht 8d; Witan 7c</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_41.lnote.de.8" n="8" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘als auch’ H; ‘Zeugniss’ hier = ‘Aufsicht’; <hi rend="italic">s. o.</hi> 34⁸</seg><seg type="translation" xml:lang="en" source="#claude">‘as well as’ H; ‘witness’ here = ‘supervision’; <hi rend="italic">see above</hi> 34⁸</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_41.attnote.fn.9" n="9" source="#attenborough"><bibl><biblScope unit="page">82</biblScope></bibl><label>boclande…</label><seg type="original" xml:lang="en">A page is here missing from B, which begins again at cap. 43 with the words <hi rend="italic">dagas to eastron</hi> etc.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_41.attnote.fn.10" n="10" source="#attenborough"><bibl><biblScope unit="page">82</biblScope></bibl><label>læfden</label><seg type="original" xml:lang="en"><hi rend="italic">⁊ him (þonne) his yldran læfdon</hi>. H*.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_41.attnote.fn.11" n="11" source="#attenborough"><bibl><biblScope unit="page">82</biblScope></bibl><label>moste</label><seg type="original" xml:lang="en"><hi rend="italic">mot</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_41.attnote.fn.12" n="12" source="#attenborough"><bibl><biblScope unit="page">82</biblScope></bibl><label>gewitnes</label><seg type="original" xml:lang="en"><hi rend="italic">gewitnesse</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_41.attnote.fn.13" n="13" source="#attenborough"><bibl><biblScope unit="page">82</biblScope></bibl><label>forbod</label><seg type="original" xml:lang="en"><hi rend="italic">fodbod</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_41.attnote.fn.14" n="14" source="#attenborough"><bibl><biblScope unit="page">82</biblScope></bibl><label>⁊</label><seg type="original" xml:lang="en"><hi rend="italic">ge</hi>. H.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_41.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">198</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">bocland</hi> was land acquired by title deed (often in reality a deed of purchase). The owner had the right of disposing of such estates by will. On this subject see Maitland, <hi rend="italic">Domesday Book and Beyond</hi>, p. 244 ff.; Pollock and Maitland, <hi rend="italic">History of English Law</hi>, <hi rend="smallcaps">i</hi>. p. 37 f.; Vinogradoff, <hi rend="italic">English Historical Review</hi>, vol. <hi rend="smallcaps">viii</hi>. 1 ff., and <hi rend="italic">Growth of the Manor</hi>, pp. 142—144, 244—248, 209.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Af_41.whinote.n.1" n="1" source="#whitelock"><bibl><biblScope unit="page">415</biblScope></bibl><label>declared</label><seg type="original" xml:lang="en">by whoever is contesting the alienation of the land</seg></note>
      </div>
