        <note type="liebermannNote" subtype="textual" xml:id="ICn_2-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">280</biblScope></bibl><seg type="original" xml:lang="de">cyninge <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyninge Ld</seg></note>
