    <body>
      <div type="clause" n="32 E 6">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 32 E 6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 32 E 6"><pb n="660" ed="#liebermann"/>Ita demum constituit et eis concessit bonus rex Edwardus<ptr type="liebermannNote" n="k" target="#ECf_32-E-6.lnote.la.fn.k"/>, propinquus uester<ptr type="liebermannNote" n="20" target="#ECf_32-E-6.lnote.la.20"/>, — qui fuit optimus filius pacis — per commune consilium tocius regni. Qua de causa possunt<ptr type="liebermannNote" n="21" target="#ECf_32-E-6.lnote.la.21"/> et debent predicti de cetero nobiscum cohabitare et remanere in regno sicut<ptr type="liebermannNote" n="l" target="#ECf_32-E-6.lnote.la.fn.l"/> coniurati fratres nostri et<ptr type="liebermannNote" n="22" target="#ECf_32-E-6.lnote.la.22"/> sicut proprii ciues regni.</ab>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 660 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">This passage is not part of ECf or ECf retr: it is one of the additions of the London collection (Leges Anglorum s. XIII in. Londoniis collectae), which Liebermann prints across the page as an insertion into ECf retr. 32 (32 A–E, pp. 655–660). The dictionary cites it as “ECf 32 E …”, so it is kept with ECf here.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_32-E-6.lnote.la.fn.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">660</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ebenso</hi> 32 A 8, <hi rend="italic">nicht ohne Widerspruch zu</hi> 13, 1 A 2</seg><seg type="translation" xml:lang="en" source="#claude">likewise 32 A 8, not without contradiction of 13, 1 A 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_32-E-6.lnote.la.fn.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">660</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ähnlich</hi> 32 C <hi rend="italic">ff.</hi></seg><seg type="translation" xml:lang="en" source="#claude">similarly 32 C ff.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-E-6.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">660</biblScope></bibl><seg type="original" xml:lang="de">noster <hi rend="italic">Co Or Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">noster Co Or Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-E-6.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">660</biblScope></bibl><seg type="original" xml:lang="de">-sint <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sint Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-E-6.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">660</biblScope></bibl><seg type="original" xml:lang="de">et c. r. nostri <hi rend="italic">am Rande in Kreide Co ohne</hi> s. p.; et—regni <hi rend="italic">fehlt Or Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">et c. r. nostri in the margin in chalk Co, without s. p.; et—regni lacking in Or Ld</seg></note>
      </div>
