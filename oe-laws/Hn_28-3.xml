        <head><ref type="lawCode" target="law:Hn">Hn</ref> 28.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 28.3" corresp="#wit-lat"><pb n="562" ed="#liebermann"/>Et diligencia testium et personarum omnium digna Dei auribus perscrutacione pensanda<ptr type="liebermannNote" n="38" target="#Hn_28-3.lnote.oe.38"/> est, ut ydonea sit et cui ab<ptr type="liebermannNote" n="39" target="#Hn_28-3.lnote.oe.39"/> aduersario<ptr type="liebermannNote" n="40" target="#Hn_28-3.lnote.oe.40"/> iure contradici non possit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 562 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_28-3.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">ps. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">ps. Sc Hg</seg></note>
