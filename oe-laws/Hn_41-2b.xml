      <div type="clause" n="41.2b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 41.2b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 41.2b" corresp="#wit-lat"><pb n="568" ed="#liebermann"/>Si ultra mare est, VI ebdomadas habeat et unam diem<ptr type="liebermannNote" n="6" target="#Hn_41-2b.lnote.oe.6"/> ad accessum et recessum maris, nisi uel occupacio seruicii regis uel ipsius egritudo<ptr type="liebermannNote" n="a" target="#Hn_41-2b.lnote.oe.a"/> uel tempestas<ptr type="liebermannNote" n="7" target="#Hn_41-2b.lnote.oe.7"/> uel aliquid<ptr type="liebermannNote" n="8" target="#Hn_41-2b.lnote.oe.8"/> competens amplius respectet.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 568 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2b.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 59, 1<hi rend="italic">a</hi>. 61, 6<hi rend="italic">f</hi>. <hi rend="italic">Zu Hu</hi> 7, 1 <hi rend="italic">schaltet Quadr.</hi> infirmitas monstrabilis <hi rend="italic">als echte Noth ein. Vgl. Glanvilla</hi> I 18; Très anc. cout. Norm. II 82</seg><seg type="translation" xml:lang="en" source="#claude">as 59, 1a. 61, 6f. In Hu 7, 1 Quadr. inserts infirmitas monstrabilis as a lawful excuse. Cf. Glanvilla I 18; Très anc. cout. Norm. II 82</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2b.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vom Corr. eingefügt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">inserted by the corrector Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2b.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">intempestas <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">intempestas Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2b.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">c. a. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. a. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2b.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Zugabe 1; Frist 15. 20; Sunne 2 B. E. H—<hi rend="italic">e. a</hi>.{8} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Zugabe 1; Frist 15. 20; Sunne 2 B. E. H—<hi rend="italic">e. a</hi>.{8} Rs</seg></note>
