      <div type="clause" n="44">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 44</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-e"><pb n="108" ed="#liebermann"/>LXXXVIII. Gif mon þon<hi rend="italic">ne</hi> aceorfe an<ptr type="liebermannNote" n="19" target="#Ine_44.lnote.oe.19"/> treow, þæt mæge XXX<ptr type="liebermannNote" n="13" target="#Ine_44.lnote.oe.13-2"/> swina undergestandan<ptr type="liebermannNote" n="20" target="#Ine_44.lnote.oe.20"/>, ⁊ wyrð undierne<ptr type="liebermannNote" n="21" target="#Ine_44.lnote.oe.21"/>, geselle LX scill.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-h"><pb n="108" ed="#liebermann"/>LXXXVIII. Gif mon<ptr type="liebermannNote" n="7" target="#Ine_44.lnote.oe.7"/> þonne aceorfe an treow, ðæt mæge XXX swina undergestondon<ptr type="liebermannNote" n="13" target="#Ine_44.lnote.oe.13"/>, ⁊ wyrð undirne, gesylle<ptr type="liebermannNote" n="14" target="#Ine_44.lnote.oe.14-2"/> LX scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-b-no-prol"><pb n="108" ed="#liebermann"/>Be wude andfenge. Gyf mon ðonne aceorfe an treow, þ<hi rend="italic">æt</hi> mæg<hi rend="italic">e</hi> ðrittig swina understandan, ⁊ wurð undyrne, gesylle syxtig scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="44" corresp="#wit-q"><pb n="109" ed="#liebermann"/>Si quis lignum unum<ptr type="liebermannNote" n="14" target="#Ine_44.lnote.oe.14"/> truncabit<ptr type="liebermannNote" n="15" target="#Ine_44.lnote.oe.15"/>, sub quo XXX porci stare possent<ptr type="liebermannNote" n="16" target="#Ine_44.lnote.oe.16"/>, et compareat, triginta sol. emendet (ad<ptr type="liebermannNote" n="17" target="#Ine_44.lnote.oe.17"/> witam).</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="50" ed="#attenborough"/>[Be wudu andfenge.] Gif mon þonne aceorfe an treow, þæt mæge XXX swina undergestandan<ptr type="editorNote" n="14" target="#Ine_44.attnote.fn.14"/>, ⁊ wyrð undierne, geselle LX scill.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="44.2" corresp="#wit-e"><pb n="408" ed="#jurasinski-and-oliver"/>{LXXXVIII} Gif mon þon<hi rend="italic">ne</hi> aceorfe an treow, þæt mæge XXX swina undergestandan, ⁊ wyrð undierne, geselle LX sciƚƚ.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="109" ed="#liebermann"/>Wenn jemand jedoch [auch<ptr type="liebermannNote" n="1" target="#Ine_44.lnote.de.1"/> nur] einen Baum abhaut, unter welchem 30 Schweine<ptr type="liebermannNote" n="2" target="#Ine_44.lnote.de.2"/> stehen können, und [es] wird kund, so zahle er [je] 60<ptr type="liebermannNote" n="3" target="#Ine_44.lnote.de.3"/> Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">But if someone cuts down [even only] one tree under which 30 pigs can stand, and [it] becomes known, let him pay [for each] 60 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="51" ed="#attenborough"/>If, however, anyone cuts down a tree that can shelter thirty swine, and it becomes known, he shall pay 60 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="404" ed="#whitelock"/>If, however, anyone cuts down a tree under which 30 swine could stand, and it becomes known, he is to pay 60 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="409" ed="#jurasinski-and-oliver"/>If, however, a man cuts down a tree under which thirty swine may stand and it becomes known, let him pay 60 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_44.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">109</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur Lond; fehlt übrigen</hi></seg><seg type="translation" xml:lang="en" source="#claude">only Lond; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_44.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">109</biblScope></bibl><seg type="original" xml:lang="de">-cauerit <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cauerit Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_44.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">109</biblScope></bibl><seg type="original" xml:lang="de">-sint <hi rend="italic">M Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sint M Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_44.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">109</biblScope></bibl><seg type="original" xml:lang="de">ad w. <hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad w. lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_44.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">108</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_44.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">108</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">beide</hi> o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">both o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_44.lnote.oe.14-2" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">108</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">y written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_44.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">108</biblScope></bibl><seg type="original" xml:lang="de">ænne treowe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ænne treowe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_44.lnote.oe.13-2" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">108</biblScope></bibl><seg type="original" xml:lang="de">þrittig <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þrittig Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_44.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">108</biblScope></bibl><seg type="original" xml:lang="de">underst. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">underst. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_44.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">108</biblScope></bibl><seg type="original" xml:lang="de">-dyrne, gesylle sixtig <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dyrne, gesylle sixtig Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_44.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">76</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Da Ine den unbestimmten Artikel nicht ausdrückt, übersetzt Q richtig <hi rend="italic">unum.</hi> Hier tritt also nicht Absorption ein. <hi rend="italic">Vgl. Gl</hi> Baum 3. a</seg><seg type="translation" xml:lang="en" source="#claude">Since Ine does not express the indefinite article, Q rightly translates <hi rend="italic">unum.</hi> Here, then, absorption does not take place. <hi rend="italic">Cf. Gl</hi> Baum 3. a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_44.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">76</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Mast 5. 6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Mast 5. 6</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_44.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">76</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘Zur Strafe’ fügt Q <hi rend="smallcaps">ii</hi> wohl richtig hinzu; <hi rend="italic">vgl.</hi> 43; seine irrige Zahl wohl aus 2 vorherigen XXX</seg><seg type="translation" xml:lang="en" source="#claude">Q <hi rend="smallcaps">ii</hi> adds ‘as a penalty’, probably rightly; <hi rend="italic">cf.</hi> 43; his erroneous number probably comes from the 2 preceding XXX</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_44.attnote.fn.14" n="14" source="#attenborough"><bibl><biblScope unit="page">50</biblScope></bibl><label>undergestandan</label><seg type="original" xml:lang="en"><hi rend="italic">understandan</hi>. B.</seg></note>
      </div>
    </body>
