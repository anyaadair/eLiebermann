      <div type="clause" n="3">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 3"><pb n="629" ed="#liebermann"/><ptr type="liebermannNote" n="27" target="#ECf_3.lnote.la.27"/>Ubicunque iustitia regis uel alia<ptr type="liebermannNote" n="28" target="#ECf_3.lnote.la.28"/> quelibet iustitia, cuiuscunque sit<ptr type="liebermannNote" n="e" target="#ECf_3.lnote.la.fn.e"/><ptr type="liebermannNote" n="18" target="#ECf_3.lnote.la.18"/>, tenuerit placita<ptr type="liebermannNote" n="29" target="#ECf_3.lnote.la.29"/> de<ptr type="liebermannNote" n="30" target="#ECf_3.lnote.la.30"/> iustitia, si minister episcopi<ptr type="liebermannNote" n="f" target="#ECf_3.lnote.la.fn.f"/> ibi<ptr type="liebermannNote" n="31" target="#ECf_3.lnote.la.31"/> fuerit et ostenderit causam<ptr type="liebermannNote" n="32" target="#ECf_3.lnote.la.32"/> sancte<ptr type="liebermannNote" n="18" target="#ECf_3.lnote.la.18"/> ecclesie, ipsa prius<ptr type="liebermannNote" n="g" target="#ECf_3.lnote.la.fn.g"/><ptr type="liebermannNote" n="33" target="#ECf_3.lnote.la.33"/> deducatur ad quem finem<ptr type="liebermannNote" n="34" target="#ECf_3.lnote.la.34"/> rationabilius<ptr type="liebermannNote" n="35" target="#ECf_3.lnote.la.35"/> poterit ipsa<ptr type="liebermannNote" n="36" target="#ECf_3.lnote.la.36"/> die.</ab>
        <note type="comparison" source="#liebermann" n="629"><label>printed alongside</label> <ref target="clause:ECfRetr_3">ECf retr 3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 629 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_3.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Baronialrichter oder Vorsteher von Grafschaft, Hundertschaft, Stadt</hi></seg><seg type="translation" xml:lang="en" source="#claude">a baron’s judge, or the head of a shire, hundred or town</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_3.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. u.</hi> 9</seg><seg type="translation" xml:lang="en" source="#claude">cf. below, 9</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_3.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 2, 9a; Hn 7, 3; <hi rend="italic">Heinrichs I. Privileg für den Dom von York a.</hi> 1110: si canonici clamorem fecerint in placitis regis, clamor eorum ante omnem causam terminetur; <hi rend="italic">Raine</hi> Historians of York III 36. <hi rend="italic">So schon ein Fränkisches</hi> Capitulare a. 755, c. 23</seg><seg type="translation" xml:lang="en" source="#claude">see above, 2, 9a; Hn 7, 3; Henry I’s privilege for York Minster, a. 1110: si canonici clamorem fecerint in placitis regis, clamor eorum ante omnem causam terminetur; Raine, Historians of York III 36. A Frankish Capitulare of 755, c. 23, already does the same</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_3.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">De iustitia sancte ecclesie <hi rend="italic">Rubrik aus Pl S</hi> [<hi rend="italic">Rubriken des</hi> Rubricator II <hi rend="italic">zum</hi> ECf. retr. <hi rend="italic">benutzend; siehe Anhang</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">De iustitia sancte ecclesie, rubric from Pl S [using the rubrics of Rubricator II to ECf. retr.; see the Appendix]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_3.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_3.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">aliqua <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">aliqua Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_3.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">-tum <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tum Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_3.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">uel iustitiam <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel iustitiam S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_3.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr S</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_3.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">tamen <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">tamen Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_3.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">ad finem <hi rend="italic">fügt zu Cl S Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cl S Ad add ad finem</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_3.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_3.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">p. r. <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. r. S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_3.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">illa <hi rend="italic">Ad Do;</hi> ipso <hi rend="italic">Cl;</hi> eo <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">illa Ad Do; ipso Cl; eo S</seg></note>
      </div>
