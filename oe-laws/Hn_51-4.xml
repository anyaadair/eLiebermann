        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 51.4" corresp="#wit-lat"><pb n="573" ed="#liebermann"/>Si uicecomes iniuste<ptr type="liebermannNote" n="26" target="#Hn_51-4.lnote.oe.26"/> aliquem namiet, conuictus noxa<ptr type="liebermannNote" n="27" target="#Hn_51-4.lnote.oe.27"/> causam suam perdat<ptr type="liebermannNote" n="28" target="#Hn_51-4.lnote.oe.28"/> et<ptr type="liebermannNote" n="29" target="#Hn_51-4.lnote.oe.29"/> dupliciter<ptr type="liebermannNote" n="30" target="#Hn_51-4.lnote.oe.30"/> emendet<ptr type="liebermannNote" n="31" target="#Hn_51-4.lnote.oe.31"/>, et regi sicut factum sit<ptr type="liebermannNote" n="32" target="#Hn_51-4.lnote.oe.32"/>.</ab>
