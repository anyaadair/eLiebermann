      <div type="clause" n="90.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 90.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 90.3" corresp="#wit-lat"><pb n="605" ed="#liebermann"/>Si quis puteum uel cisternam fodiat uel<ptr type="liebermannNote" n="i" target="#Hn_90-3.lnote.oe.i"/> factam<ptr type="liebermannNote" n="35" target="#Hn_90-3.lnote.oe.35"/> disclaudat<ptr type="liebermannNote" n="36" target="#Hn_90-3.lnote.oe.36"/>, et aliquid incidat, ut mortem uel debilitatem incurrat, eque<ptr type="liebermannNote" n="i" target="#Hn_90-3.lnote.oe.i"/> bonum restituat, mortuum uero<ptr type="liebermannNote" n="37" target="#Hn_90-3.lnote.oe.37"/> uel debile<ptr type="liebermannNote" n="38" target="#Hn_90-3.lnote.oe.38"/> ad<ptr type="liebermannNote" n="i" target="#Hn_90-3.lnote.oe.i"/> se recipiat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 605 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-3.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Angels. Af. El.</hi> 22 (<hi rend="italic">Frühere citiren</hi> Capit. Car. M. VI [<hi rend="italic">d. i.</hi> Bened. lev. II 16, <hi rend="italic">der aber nur der Vulgata, der Quelle auch Af’s, folgt</hi>]); <hi rend="italic">der Rest ist aus Quadr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">from the Anglo-Saxon Af. El. 22 (earlier writers cite Capit. Car. M. VI [i.e. Bened. lev. II 16, who, however, merely follows the Vulgate, which is also Af’s source]); the rest is from Quadr.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-3.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">-tum <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tum K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-3.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">-ludat <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ludat Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-3.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing K Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-3.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">-lem <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lem Sc Hg</seg></note>
