    <body>
      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 2" corresp="#wit-lat"><ptr type="liebermannNote" n="11" target="#IudDeiI_2.lnote.oe.11"/><pb n="401" ed="#liebermann"/>Cum<ptr type="liebermannNote" n="12" target="#IudDeiI_2.lnote.oe.12"/> autem ad communionem uenerint, antequam communicent<ptr type="liebermannNote" n="13" target="#IudDeiI_2.lnote.oe.13"/>, interroget<ptr type="liebermannNote" n="14" target="#IudDeiI_2.lnote.oe.14"/> eos<ptr type="liebermannNote" n="15" target="#IudDeiI_2.lnote.oe.15"/> sacerdos cum<ptr type="liebermannNote" n="16" target="#IudDeiI_2.lnote.oe.16"/> adiuratione et dicat<ptr type="liebermannNote" n="17" target="#IudDeiI_2.lnote.oe.17"/>:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 401 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2.lnote.oe.II_a" n="II a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Aufrechte</hi> (‘Antiqua’-)<hi rend="italic">Buchstabennoten beziehen sich auf</hi> Band II: Erklärungen.</seg><seg type="translation" xml:lang="en" source="#claude">Upright (‘Antiqua’, i.e. roman) letters used as note-markers refer to Band II: Erklärungen.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vorangeht die Messe</hi> 4—14, 2 <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">preceded by the mass 4—14, 2 Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">c. 2 <hi rend="italic">auch u.</hi> XIII 3</seg><seg type="translation" xml:lang="en" source="#claude">c. 2 also below XIII 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">-cet (<hi rend="italic">ergänze laut Zeu.</hi> 641 eos?) <hi rend="italic">Ps Rj, wie Zeu.</hi> 643. 655. 667. 689, <hi rend="italic">gegen die übrigen</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cet (supply eos? according to Zeu. 641) Ps Rj, as Zeu. 643. 655. 667. 689, against the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">adiuret <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">adiuret Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">s. e. <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. e. H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">ita <hi rend="italic">statt</hi> c.—di. <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">ita instead of c.—di. Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">hanc coniurationem <hi rend="italic">fügt zu Ch; vorher</hi> VII 12, 1—4 <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">hanc coniurationem added by Ch; preceded by VII 12, 1—4 Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">239</biblScope></bibl><seg type="original" xml:lang="de">Ich halte gegen Zeumer dies (= Zeumer 618. 620. 621. 622. 626. 643. 653. 655. 675. 685. 692; <hi rend="italic">communicat <hi rend="spaced">eos</hi></hi>, also desselben Sinnes 641) für ursprünglicher als <hi rend="italic">communicet</hi> (643₄₄. 655₄₂. 689₁₄. B XI)</seg><seg type="translation" xml:lang="en" source="#claude">Against Zeumer, I consider this (= Zeumer 618. 620. 621. 622. 626. 643. 653. 655. 675. 685. 692; <hi rend="italic">communicat <hi rend="italic">eos</hi></hi>, thus of the same sense, 641) more original than <hi rend="italic">communicet</hi> (643₄₄. 655₄₂. 689₁₄. B XI)</seg></note>
      </div>
