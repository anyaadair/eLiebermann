  <text>
    <body>
      <div type="clause" n="4">
        <head><ref type="lawCode" target="law:IVAs">IV As</ref> 4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="4" corresp="#wit-q"><pb n="172" ed="#liebermann"/>Et<ptr type="liebermannNote" n="a" target="#IVAs_4.lnote.oe.a"/> qui alterius hominem suscipiet<ptr type="liebermannNote" n="1" target="#IVAs_4.lnote.oe.1"/> (recipiet) intra mercam<ptr type="liebermannNote" n="2" target="#IVAs_4.lnote.oe.2"/> uel extra, quem<ptr type="liebermannNote" n="b" target="#IVAs_4.lnote.oe.b"/> pro malo suo dimittat et castigare non possit, reddat regi centum uiginti solidos et redeat<ptr type="liebermannNote" n="c" target="#IVAs_4.lnote.oe.c"/> intus unde exiuit et rectum faciat ei cui seruiuit<ptr type="liebermannNote" n="3" target="#IVAs_4.lnote.oe.3"/> antea.<ptr type="liebermannNote" n="4" target="#IVAs_4.lnote.oe.4"/></ab>
        <ab type="editionText" xml:lang="la" source="#attenborough" n="4" corresp="#wit-q"><pb n="148" ed="#attenborough"/>[De illo qui alterius hominem recepit.] Et qui alterius hominem suscipiet<ptr type="editorNote" n="3" target="#IVAs_4.attnote.fn.3"/> intra mercam vel extra, quem pro malo suo dimittat et castigare non possit, reddat regi centum viginti solidos, et redeat intus unde exivit, et rectum faciat ei cui servivit antea<ptr type="editorNote" n="4" target="#IVAs_4.attnote.fn.4"/>.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="149" ed="#attenborough"/>If anyone shall receive a man who has been in the service of another<ptr type="editorNote" n="1" target="#IVAs_4.attnote.n.1"/>, within or beyond the border<ptr type="editorNote" n="2" target="#IVAs_4.attnote.n.2"/>, whom the latter has dismissed for his wrongdoing, and whom he has not been able to punish, he shall pay 120 shillings to the king<ptr type="editorNote" n="3" target="#IVAs_4.attnote.n.3"/>; and the fugitive shall return to the place from which he came and render satisfaction to him in whose service he has been.</ab>
        <note type="comparison" source="#liebermann" n="172"><ref target="clause:VAs_1">V As 1</ref>; <ref target="clause:IIIAs_4">III As 4</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. V As. 1; III As. 4</note>
        <note type="comparison" source="#wormald-mel" n="296"><label>digest of; wording like</label> <ref target="clause:IIIAs_4">III As 4–4.1</ref> <quote>V 1:1, a new decision about those unjustly accused by their lords, echoed in IV 5, which uses the word 'hlafordsocnam' as in III 4:1</quote></note>
        <note type="comparison" source="#wormald-mel" n="296"><label>digest of; wording like</label> <ref target="clause:VAs_1">V As 1–1.1</ref> <quote>V 1:1, a new decision about those unjustly accused by their lords, echoed in IV 5, which uses the word 'hlafordsocnam' as in III 4:1</quote></note>
        <note type="editorial">Latin only; no German translation in Liebermann. Liebermann compares V As 1; III As 4.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_4.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond; (eingeklammertes) übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket Lond; (bracketed words) the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_4.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">mar. <hi rend="italic">RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">mar. RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_4.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">seruierat <hi rend="italic">RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">seruierat RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_4.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_4.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">113</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Die Worte <hi rend="italic">intra m. uel e.</hi> sind aus III 4</seg><seg type="translation" xml:lang="en" source="#claude">The words <hi rend="italic">intra m. uel e.</hi> are from III 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_4.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">113</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Q lässt das neue Subjekt ‘jener’, auch V 1, aus</seg><seg type="translation" xml:lang="en" source="#claude">Q omits the new subject ‘that man’, also V 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_4.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">113</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl.</hi> Gefolge 8a. d. 26d</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf.</hi> Gefolge 8a. d. 26d</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAs_4.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">210</biblScope></bibl><seg type="original" xml:lang="en">Cf. III As. cap. 4.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAs_4.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">210</biblScope></bibl><seg type="original" xml:lang="en">Presumably the border of his district (‘Provinzgrenze,’ Liebermann).</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAs_4.attnote.n.3" n="3" source="#attenborough"><bibl><biblScope unit="page">210</biblScope></bibl><seg type="original" xml:lang="en">Cf. V As. cap. 1; I Edw. cap. 2 § 1; II As. cap. 22, etc.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_4.attnote.fn.3" n="3" source="#attenborough"><bibl><biblScope unit="page">148</biblScope></bibl><label>suscipiet</label><seg type="original" xml:lang="en"><hi rend="italic">recipiet</hi>.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_4.attnote.fn.4" n="4" source="#attenborough"><bibl><biblScope unit="page">148</biblScope></bibl><label>antea</label><seg type="original" xml:lang="en"><hi rend="italic">servierat</hi>. R, T, M, Hk.</seg></note>
      </div>
    </body>
