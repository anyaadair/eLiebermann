        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1a.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">exce. <hi rend="italic">Hss. öfter</hi></seg><seg type="translation" xml:lang="en" source="#claude">exce. MSS frequently</seg></note>
