      <div type="clause" n="73">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 73</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="73" corresp="#wit-g-a"><pb n="360" ed="#liebermann"/>⁊ sitte ælc wuduwe werleas XII<ptr type="liebermannNote" n="2" target="#IICn_73.lnote.oe.2-2"/> monað, ceose syððan<ptr type="liebermannNote" n="3" target="#IICn_73.lnote.oe.3"/> þ<hi rend="italic">æt</hi> heo sylf wylle<ptr type="liebermannNote" n="4" target="#IICn_73.lnote.oe.4"/>.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="73" corresp="#wit-b"><pb n="360" ed="#liebermann"/>Be wydewan, þ<hi rend="italic">æt</hi> heo sitte XII monðas ceorlæs. And sitte ælc wuduwe werleas twelf monað ⁊ ceose heo syððan þ<hi rend="italic">æt</hi> heo sylf wille.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="73" corresp="#wit-a"><pb n="360" ed="#liebermann"/>And sitte ælc wuduwe werleas twelf monað, ceose siððan þ<hi rend="italic">æt</hi> hio silf wille.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="73" corresp="#wit-q"><pb n="361" ed="#liebermann"/>Et sit omnis uidua sine marito XII mensibus<ptr type="liebermannNote" n="1" target="#IICn_73.lnote.oe.1"/>; eligat postea, quem uelit.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="73" corresp="#wit-inst-cn"><pb n="361" ed="#liebermann"/>Et<ptr type="liebermannNote" n="3" target="#IICn_73.lnote.oe.3-2"/> uidua per<ptr type="liebermannNote" n="4" target="#IICn_73.lnote.oe.4-2"/> integrum annum sine uiro permaneat.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="73" corresp="#wit-cons-cn"><pb n="361" ed="#liebermann"/>Uidua uero per spacium unius anni se contineat in uiduitate sua; post eligat quod sibi placeat.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="73" corresp="#wit-b"><pb n="210" ed="#robertson"/>Be wydewan, þæt heo sitte XII monðas ceorlæs. And sitte ælc wuduwe werleas twelf monað ⁊<ptr type="editorNote" n="7" target="#IICn_73.robnote.fn.7"/> ceose heo<ptr type="editorNote" n="7" target="#IICn_73.robnote.fn.7"/> syððan þæt heo sylf wille.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="290" ed="#rabin-doml"/>And sitte ælc wuduwe werleas XII monað, ceose syððan þæt heo sylf wylle.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="360" ed="#liebermann"/>(Von der Wittwe, dass sie zwölf Monate gattenlos<ptr type="liebermannNote" n="1" target="#IICn_73.lnote.de.1"/> sitze. <hi rend="italic">B</hi>) Und<ptr type="liebermannNote" n="2" target="#IICn_73.lnote.de.2"/> jede<ptr type="liebermannNote" n="3" target="#IICn_73.lnote.de.3"/> Wittwe sitze gattenlos<ptr type="liebermannNote" n="4" target="#IICn_73.lnote.de.4"/> zwölf Monate lang, (und <hi rend="italic">B</hi>) wähle sie nachher, was<ptr type="liebermannNote" n="5" target="#IICn_73.lnote.de.5"/> sie selbst will.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">(Of the widow, that she should remain twelve months without a husband. B) And let every widow remain without a husband for twelve months; (and, B) afterwards let her choose what she herself wishes.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_73.robnote.n.1"/><pb n="211" ed="#robertson"/>Concerning widows, that they remain for a year without a husband. And every widow shall remain twelve months without a husband, and she shall afterwards choose what she herself desires.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><ptr type="editorNote" n="2" target="#IICn_73.whinote.n.2"/><pb n="472" ed="#whitelock"/>And each widow is to remain unmarried for 12 months; she is afterwards to choose what she herself will.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="291" ed="#rabin-doml"/>And every widow shall remain without a husband for twelve months, and afterward she shall choose as she herself desires.</ab>
        <note type="comparison" source="#liebermann" n="360"><ref target="clause:VIAtr_26-1">VI Atr 26.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. VI Atr. 26, 1</note>
        <note type="comparison" source="#wormald-mel" n="359"><label>quoted verbatim (bold in Wormald's table)</label> <ref target="clause:VIAtr_26-1">VI Atr 26.1</ref> <quote>Table 5.4, II Cn 73: Cn 1018 16:1 (Hom N L) VI Atr 26:1</quote></note>
        <note type="comparison" source="#wormald-mel" n="359"><label>quoted verbatim (bold in Wormald's table)</label> <ref target="clause:Cn-1018_part-050">Cn 1018 16.1</ref> <quote>Table 5.4, II Cn 73: Cn 1018 16:1 (Hom N L) VI Atr 26:1</quote></note>
        <note type="comparison" source="#wormald-mel" n="362"><label>relocated from</label> <ref target="clause:Cn-1018_part-049">Cn 1018 16–16.1</ref> <quote>II Cn 73/Cn 1018 16 – 16:1</quote></note>
        <note type="comparison" source="#whitelock" n="472"><label>from</label> <ref target="clause:VAtr_21-1">V Atr 21.1</ref> <quote>from VI Ethelred, 26.1 (= V Ethelred, 21.1)</quote></note>
        <note type="comparison" source="#whitelock" n="472"><label>from</label> <ref target="clause:VIAtr_26-1">VI Atr 26.1</ref> <quote>from VI Ethelred, 26.1 (= V Ethelred, 21.1)</quote></note>
        <note type="comparison" source="#kennedy" n="60"><label>appear again as</label> <ref target="clause:VIAtr_26">VI Atr 26</ref> <quote>VI Atr. 26 and 26.1, which appear again as II Cn. 73.</quote></note>
        <note type="comparison" source="#kennedy" n="60"><label>appear again as</label> <ref target="clause:VIAtr_26-1">VI Atr 26.1</ref> <quote>VI Atr. 26 and 26.1, which appear again as II Cn. 73.</quote></note>
        <note type="comparedBy" source="#kennedy" n="59"><ref target="clause:Cn-1018_part-049">Cn 1018 16–16.1</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="386"><ref target="clause:Wif_4">Wif 4</ref></note>
        <note type="comparedBy" source="#wormald-ppmel" n="70"><ref target="clause:CHnCor_3-to-3-1">CHn cor 3–4</ref></note>
        <note type="editorial">Liebermann compares VI Atr 26.1.; BR: added from Gesetze I p. 361, October 2026 (MS Cons); AY: corrected against Rabin p. 290, October 2026 (was “xii; ∅”, now “XII; | binnan: ðonne binnan ðæs B”); AZ: added from Rabin p. 290, October 2026 (Rabin’s note to the translation)</note>
        <note type="textual" source="#rabin-doml">B adds rubric Be wydewan þæt heo sitte XII monðas ceorlæs</note>
        <note type="textual" source="#rabin-doml">monað: monað and B</note>
        <note type="textual" source="#rabin-doml">ceose: ceose heo B</note>
        <note type="textual" source="#rabin-doml">binnan: ðonne binnan ðæs B</note>
        <note type="translator" source="#rabin-doml">morning gift: A gift, often in the form of money or land, from a newly married husband to his wife, supposedly given the morning after their first night together. The gift was considered the woman’s property and, in theory at least, was kept separate from the other aspects of the couple’s finances overseen by the husband.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">73. 74 <hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">73. 74 lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de">twelf <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">twelf Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de">siþ. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">siþ. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de">wille <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wille Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">uxor eius <hi rend="italic">fügt zu Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">uxor eius added by Lb S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">unum <hi rend="italic">statt</hi> p. i. <hi rend="italic">Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">unum instead of p. i. Lb S</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_73.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">212</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Das Wort <hi rend="italic">ceor[l]leas</hi> zitiert Toller <hi rend="italic">Suppl</hi>. nur hierher</seg><seg type="translation" xml:lang="en" source="#claude">Toller <hi rend="italic">Suppl</hi>. cites the word <hi rend="italic">ceor[l]leas</hi> only for this passage</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_73.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">212</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">73. 73, 1 benutzt durch Hn 11, 13, ohne 73a. <hi rend="italic">Vgl. Gl</hi> Ehe 3</seg><seg type="translation" xml:lang="en" source="#claude">73. 73, 1 used by Hn 11, 13, without 73a. <hi rend="italic">Cf. Gl</hi> Ehe 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_73.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">212</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Quelle kann auch V Atr 21, 1 sein</seg><seg type="translation" xml:lang="en" source="#claude">The source may also be V Atr 21, 1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_73.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">212</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">C paraphrasiert homiletisch wie VI Atr L</seg><seg type="translation" xml:lang="en" source="#claude">C paraphrases homiletically, like VI Atr L</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_73.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">212</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Nicht mit Q ‘wen’; <hi rend="italic">vgl. Gl</hi> Eheschliessung 16g</seg><seg type="translation" xml:lang="en" source="#claude">Not ‘whom’, with Q; <hi rend="italic">cf. Gl</hi> Eheschliessung 16g</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_73.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">358</biblScope></bibl><seg type="original" xml:lang="en">Cf. V Atr. 21, 1; VI, 26, 1.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_73.robnote.fn.7" n="7" source="#robertson"><bibl><biblScope unit="page">210</biblScope></bibl><label>⁊</label><seg type="original" xml:lang="en">Om. G, A, Ld.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IICn_73.whinote.n.2" n="2" source="#whitelock"><bibl><biblScope unit="page">472</biblScope></bibl><label>73</label><seg type="original" xml:lang="en">from VI Ethelred, 26.1 (= V Ethelred, 21.1)</seg></note>
