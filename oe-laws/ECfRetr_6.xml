    <body>
      <div type="clause" n="6">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 6"><pb n="631" ed="#liebermann"/><hi rend="spaced">De fractione<ptr type="liebermannNote" n="4" target="#ECfRetr_6.lnote.la.4"/> pacis ecclesie.</hi> Si quis <hi rend="bold">uero</hi><ptr type="liebermannNote" n="5" target="#ECfRetr_6.lnote.la.5"/> pacem<ptr type="liebermannNote" n="6" target="#ECfRetr_6.lnote.la.6"/> sancte<ptr type="liebermannNote" n="7" target="#ECfRetr_6.lnote.la.7"/> ecclesie <hi rend="bold">uiolenter</hi><ptr type="liebermannNote" n="8" target="#ECfRetr_6.lnote.la.8"/> <hi rend="bold">infregerit,</hi> episcoporum est iustitia.</ab>
        <note type="comparison" source="#liebermann" n="631"><label>printed alongside</label> <ref target="clause:ECf_6">ECf 6</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 631 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_6.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">hiis qui pacem e. fregerint <hi rend="italic">Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">hiis qui pacem e. fregerint Pl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_6.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">idem <hi rend="italic">fügt zu K Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">K Or add idem</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_6.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Cb Hv Ce;</hi> s. e. p. <hi rend="italic">Ph;</hi> s. p. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Cb Hv Ce; s. e. p. Ph; s. p. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_6.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Kn K Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Kn K Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_6.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">freg. uiol. <hi rend="italic">Hv;</hi> uiolauerit uel <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">freg. uiol. Hv; uiolauerit uel Lond</seg></note>
      </div>
