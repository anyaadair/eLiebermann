  <text>
    <body>
      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 2"><pb n="628" ed="#liebermann"/><hi rend="bold">De temporibus<ptr type="liebermannNote" n="12" target="#ECfRetr_2.lnote.la.12"/> et diebus pacis<ptr type="liebermannNote" n="14" target="#ECfRetr_2.lnote.la.14"/> (regis<ptr type="liebermannNote" n="15" target="#ECfRetr_2.lnote.la.15"/>).</hi> Ab Aduentu Domini usque ad octauas<ptr type="liebermannNote" n="16" target="#ECfRetr_2.lnote.la.16"/> Epiphanie pax Dei et<ptr type="liebermannNote" n="17" target="#ECfRetr_2.lnote.la.17"/> ecclesie per omne<ptr type="liebermannNote" n="18" target="#ECfRetr_2.lnote.la.18"/> regnum.</ab>
        <note type="comparison" source="#liebermann" n="628"><label>printed alongside</label> <ref target="clause:ECf_2">ECf 2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 628 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">There is no note 13 in the ECf retr column of this page: Liebermann’s numbering goes from 12 to 14.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">t. et <hi rend="italic">fehlt Cb Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. et lacking in Cb Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">domini <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds domini</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt besser Cb Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking, which is better, in Cb Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Cb Lb Sp;</hi> -uam <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Cb Lb Sp; -uam Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">sancte <hi rend="italic">fügt zu Sp Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Sp Lond add sancte</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">Anglie <hi rend="italic">fügt zu Cc</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cc adds Anglie</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Of the times and days of the (king's) peace. From the Advent of the Lord until the octave of Epiphany, the peace of God and of the Church throughout the whole kingdom.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">343</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">De diebus pacis</hi><hi rend="superscript">14</hi> überschr. Rs — <hi rend="italic">octabas</hi><hi rend="superscript">16</hi> — <hi rend="italic">et</hi><hi rend="superscript">17</hi> <hi rend="italic">sancte</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">De diebus pacis</hi><hi rend="superscript">14</hi> as heading in Rs — <hi rend="italic">octabas</hi><hi rend="superscript">16</hi> — <hi rend="italic">et</hi><hi rend="superscript">17</hi> <hi rend="italic">sancte</hi> Rs</seg></note>
      </div>
    </body>
