        <note type="liebermannNote" subtype="textual" xml:id="IICn_65.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">352</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. am Rande</hi></seg><seg type="translation" xml:lang="en" source="#claude">in the margin in the 16th cent.</seg></note>
