      <div type="clause" n="29">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 29</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 29"><pb n="652" ed="#liebermann"/>Cum autem cause maiores <hi rend="bold">erumpebant,</hi> referebantur ad <hi rend="bold">superiores eorum</hi> iusticiarios, quos supradicti<ptr type="liebermannNote" n="15" target="#ECfRetr_29.lnote.la.15"/> sapientes supra<ptr type="liebermannNote" n="16" target="#ECfRetr_29.lnote.la.16"/> eos<ptr type="liebermannNote" n="17" target="#ECfRetr_29.lnote.la.17"/> constituerant<ptr type="liebermannNote" n="18" target="#ECfRetr_29.lnote.la.18"/> — scilicet super<ptr type="liebermannNote" n="19" target="#ECfRetr_29.lnote.la.19"/> X decanos —, quos possumus <hi rend="bold">dicere centuriones uel</hi> centenarios, <hi rend="bold">eo quod</hi> super<ptr type="liebermannNote" n="19" target="#ECfRetr_29.lnote.la.19"/> centum friborgos<ptr type="liebermannNote" n="20" target="#ECfRetr_29.lnote.la.20"/> iudicabant.</ab>
        <note type="comparison" source="#liebermann" n="652"><label>printed alongside</label> <ref target="clause:ECf_29">ECf 29</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 652 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_29.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">Irrthum</seg><seg type="translation" xml:lang="en" source="#claude">an error</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_29.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">predi. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">predi. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_29.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">super <hi rend="italic">Ph Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">super Ph Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_29.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_29.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">-runt <hi rend="italic">Cb Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-runt Cb Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_29.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">supra <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">supra Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_29.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lb;</hi> frithb. <hi rend="italic">Hv;</hi> fridb. <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Lb; frithb. Hv; fridb. Ph</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But when greater cases broke out, they were referred to their superior justiciars, whom the above-mentioned wise men had set over them — that is, over ten deans —, whom we can call centurions or hundredmen (<hi rend="italic">centenarii</hi>), because they judged over a hundred frankpledges.</ab>
      </div>
