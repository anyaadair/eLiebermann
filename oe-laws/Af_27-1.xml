      <div type="clause" n="27.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 27.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="27.1" corresp="#wit-e"><pb n="66" ed="#liebermann"/>Gif he medrenmægas<ptr type="liebermannNote" n="15" target="#Af_27-1.lnote.oe.15"/> nage<ptr type="liebermannNote" n="16" target="#Af_27-1.lnote.oe.16"/>, gielden<ptr type="liebermannNote" n="10" target="#Af_27-1.lnote.oe.10"/> þa gegildan<ptr type="liebermannNote" n="17" target="#Af_27-1.lnote.oe.17"/> healfne, for healfne he fleo.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="27.1" corresp="#wit-h"><pb n="66" ed="#liebermann"/>Gif he medrenmages<ptr type="liebermannNote" n="8" target="#Af_27-1.lnote.oe.8"/> nage, gilden<ptr type="liebermannNote" n="5" target="#Af_27-1.lnote.oe.5"/> ða gegilden<ptr type="liebermannNote" n="5a" target="#Af_27-1.lnote.oe.5a"/> healfne, ond<ptr type="liebermannNote" n="2" target="#Af_27-1.lnote.oe.2"/> for healfne he fleo.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="27.1" corresp="#wit-b-no-prol"><pb n="67" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="3" target="#Af_27-1.lnote.oe.3"/> medrenmagas næbbe, gylden ða gegylden healfne, for healfne he fleo.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="27.1" corresp="#wit-q"><pb n="67" ed="#liebermann"/>Si nec maternam cognationem habeat, soluant<ptr type="liebermannNote" n="9" target="#Af_27-1.lnote.oe.9"/> congildones (eius<ptr type="liebermannNote" n="10" target="#Af_27-1.lnote.oe.10-2"/>) dimidiam compositionem<ptr type="liebermannNote" n="11" target="#Af_27-1.lnote.oe.11"/>, pro dimidia fugiat.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="76" ed="#attenborough"/>Gif he medrenmægas<ptr type="editorNote" n="21" target="#Af_27-1.attnote.fn.21"/> nage<ptr type="editorNote" n="22" target="#Af_27-1.attnote.fn.22"/>, gielden þa gegildan<ptr type="editorNote" n="23" target="#Af_27-1.attnote.fn.23"/> healfne, for<ptr type="editorNote" n="24" target="#Af_27-1.attnote.fn.24"/> healfne he fleo.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="32.1" corresp="#wit-e"><pb n="324" ed="#jurasinski-and-oliver"/>Gif he medrenmægas nage, gielden þa gegildan healfne, for healfne he fleo.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="67" ed="#liebermann"/>Wenn er mütterliche Verwandte nicht besitzt, sollen die Gildengenossen den halben [Theil] zahlen; für den [anderen] halben fliehe er.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he has no maternal kinsmen, let the guild-brothers pay half; for the [other] half let him flee.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="77" ed="#attenborough"/>If he has no maternal relatives, his associates shall pay half [the wergeld], and in default of payment of the [other] half, he shall be held personally responsible.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="414" ed="#whitelock"/>If he has no maternal kinsmen, the associates are to pay half, and for half he is to flee.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="325" ed="#jurasinski-and-oliver"/>If he has no maternal kin, let the associates pay half, for half let him flee.</ab>
        <note type="translator" source="#whitelock">Whitelock numbers this chapter 27.1 and gives Liebermann’s number, 27.1, in brackets.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">-magas <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-magas So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">næbbe</hi> <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">næbbe</hi> Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">gylden <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gylden So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">gegyl. <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gegyl. So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">ages <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">ages on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27-1.lnote.oe.5a" n="5a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zweites</hi> e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">second e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">67</biblScope></bibl><seg type="original" xml:lang="de">-uat <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uat T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27-1.lnote.oe.10-2" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">67</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">67</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">67</biblScope></bibl><seg type="original" xml:lang="de">he <hi rend="italic">im</hi> 16. <hi rend="italic">Jh. eingefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">he inserted in the 16th cent.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_27-1.attnote.fn.21" n="21" source="#attenborough"><bibl><biblScope unit="page">76</biblScope></bibl><label>medrenmægas</label><seg type="original" xml:lang="en"><hi rend="italic">medrenmages</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_27-1.attnote.fn.22" n="22" source="#attenborough"><bibl><biblScope unit="page">76</biblScope></bibl><label>nage</label><seg type="original" xml:lang="en"><hi rend="italic">næbbe</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_27-1.attnote.fn.23" n="23" source="#attenborough"><bibl><biblScope unit="page">76</biblScope></bibl><label>gegildan</label><seg type="original" xml:lang="en"><hi rend="italic">gegylden</hi>. B. <hi rend="italic">gegilden</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_27-1.attnote.fn.24" n="24" source="#attenborough"><bibl><biblScope unit="page">76</biblScope></bibl><label>for</label><seg type="original" xml:lang="en"><hi rend="italic">ond for</hi>. H.</seg></note>
      </div>
