        <head><ref type="lawCode" target="law:Hn">Hn</ref> 36.2a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 36.2a" corresp="#wit-lat"><pb n="566" ed="#liebermann"/>Satis enim esse debet, si ex iudicio forisfactum emendauit<ptr type="liebermannNote" n="w" target="#Hn_36-2a.lnote.oe.w"/> et pro habenda dileccione<ptr type="liebermannNote" n="43" target="#Hn_36-2a.lnote.oe.43"/> se ipsum ei<ptr type="liebermannNote" n="x" target="#Hn_36-2a.lnote.oe.x"/> quodammodo exposuit, ut et metuendus<ptr type="liebermannNote" n="x" target="#Hn_36-2a.lnote.oe.x"/> ostendatur — cui rectum fieri expediat — et eius esse meriti<ptr type="liebermannNote" n="44" target="#Hn_36-2a.lnote.oe.44"/>, cuius et<ptr type="liebermannNote" n="34" target="#Hn_36-2a.lnote.oe.34"/> amor prosit et odium officiat<ptr type="liebermannNote" n="45" target="#Hn_36-2a.lnote.oe.45"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 566 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-2a.lnote.oe.w" n="w" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Beklagter</hi></seg><seg type="translation" xml:lang="en" source="#claude">defendant</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-2a.lnote.oe.x" n="x" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Kläger</hi></seg><seg type="translation" xml:lang="en" source="#claude">plaintiff</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-2a.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-2a.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">dilacione <hi rend="italic">K Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">dilacione K Edd.</seg></note>
