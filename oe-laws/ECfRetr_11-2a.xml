    <body>
      <div type="clause" n="11.2a">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 11.2a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 11.2a"><pb n="636" ed="#liebermann"/>concessum est ei <hi rend="bold">(non lege</hi><ptr type="liebermannNote" n="11" target="#ECfRetr_11-2a.lnote.la.11"/> <hi rend="bold">statutum</hi><ptr type="liebermannNote" n="12" target="#ECfRetr_11-2a.lnote.la.12"/> <hi rend="bold">tamen neque firmatum, sed</hi><ptr type="liebermannNote" n="13" target="#ECfRetr_11-2a.lnote.la.13"/> <hi rend="bold">hac</hi><ptr type="liebermannNote" n="14" target="#ECfRetr_11-2a.lnote.la.14"/> <hi rend="bold">necessitatis causa), ex</hi> unaquaque hida <hi rend="bold">sibi</hi><ptr type="liebermannNote" n="15" target="#ECfRetr_11-2a.lnote.la.15"/> <hi rend="bold">dari</hi> quatuor solidos, ecclesia non excepta.</ab>
        <note type="comparison" source="#liebermann" n="636"><label>printed alongside</label> <ref target="clause:ECf_11-2a">ECf 11.2a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 636 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_11-2a.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de">longe <hi rend="italic">Va;</hi> tamen l. st. <hi rend="italic">Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">longe Va; tamen l. st. Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_11-2a.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de">sancitum <hi rend="italic">ohne</hi> tamen <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">sancitum without tamen Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_11-2a.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de">tantum <hi rend="italic">fügt zu Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">Db adds tantum</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_11-2a.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de">habuit <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">habuit Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_11-2a.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de">s. d. <hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. d. lacking in Ld</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">it was granted to him (not, however, established or confirmed by law, but for this cause of necessity) that four shillings be given him from each hide, the Church not excepted.</ab>
      </div>
    </body>
