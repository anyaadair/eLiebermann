      <div type="clause" n="54">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 54</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="54" corresp="#wit-g-a"><pb n="348" ed="#liebermann"/>Gif wiffæst wer hine forligce<ptr type="liebermannNote" n="11" target="#IICn_54.lnote.oe.11"/> be his agenre wylne, þolige þære ⁊ bete for hine sylfne wið God ⁊ wið men.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="54" corresp="#wit-b"><pb n="348" ed="#liebermann"/>Gyf wiffæst were<ptr type="liebermannNote" n="1" target="#IICn_54.lnote.oe.1-2"/> hine forlicge be his agenre wylne<ptr type="liebermannNote" n="2" target="#IICn_54.lnote.oe.2"/>, ðolie ðære ⁊ bete for hine sylfne [wiþ<ptr type="liebermannNote" n="3" target="#IICn_54.lnote.oe.3"/> Godd] wið men.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="54" corresp="#wit-a"><pb n="348" ed="#liebermann"/>Gif wiffæst wer hine forlicge be his agenre wylne, þolige þære ⁊ bete for hine sylfne wið Godd ⁊ wið men.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="54" corresp="#wit-q"><pb n="349" ed="#liebermann"/>Si quis alligatus uxori<ptr type="liebermannNote" n="10" target="#IICn_54.lnote.oe.10"/> (uxoratus) fornicetur cum ancilla sua, perdat eam et pro se ipso peniteat erga Deum et homines.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="54" corresp="#wit-inst-cn"><pb n="349" ed="#liebermann"/>Si uir legalem<ptr type="liebermannNote" n="4" target="#IICn_54.lnote.oe.4"/> coniugem habens fornicatus cum ancilla sua<ptr type="liebermannNote" n="5" target="#IICn_54.lnote.oe.5"/> fuerit, careat ancilla illa et pro semet ipso Deo et hominibus emendet.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="54" corresp="#wit-cons-cn"><pb n="349" ed="#liebermann"/>[54] Si coniugatus cum propria ancilla concumbit, amittat illam et satisfaciat pro se ipso tam erga Deum quam erga homines.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="54" corresp="#wit-b"><pb n="202" ed="#robertson"/>Gyf wiffæst wer<ptr type="editorNote" n="6" target="#IICn_54.robnote.fn.6"/> hine forlicge be his agenre wylne, ðolie ðære ⁊ bete for hine sylfne wiþ Godd<ptr type="editorNote" n="7" target="#IICn_54.robnote.fn.7"/> [⁊]<ptr type="editorNote" n="8" target="#IICn_54.robnote.fn.8"/> wið men.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="282" ed="#rabin-doml"/>Gif wiffæst wer hine forligce be his agenre wylne, þolige þære and bete for hine sylfne wið God and wið men.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="348" ed="#liebermann"/>Wenn ein verheiratheter Mann mit seiner eigenen Sklavin<ptr type="liebermannNote" n="1" target="#IICn_54.lnote.de.1"/> hurt, so verliere er diese und büsse für sich vor Gott und vor Menschen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a married man whores with his own slave-woman, let him lose her and atone for himself before God and before men.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_54.robnote.n.1"/><pb n="203" ed="#robertson"/>If a married man commits adultery with his own slave, he shall lose her and make amends for himself both to God and to men.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="470" ed="#whitelock"/>If a married man commits fornication with his own slave-woman, he is to forfeit her and make amends for himself with God and with men.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="283" ed="#rabin-doml"/>If a married man engages in intercourse with his own slave, she shall be confiscated and he must do penance for himself before God and the community.</ab>
        <note type="comparison" source="#liebermann" n="348">Poen. Ps. Theod. 19, 8; Conf. Egb. 14</note>
        <note type="comparisonPrinted" source="#liebermann">Poen. Ps. Theod. 19, 8; Conf. Egb. 14</note>
        <note type="editorial">BR: added from Gesetze I p. 349, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">God and: God B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_54.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">349</biblScope></bibl><seg type="original" xml:lang="de">-berit <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-berit Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_54.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">348</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb.</hi> wer</seg><seg type="translation" xml:lang="en" source="#claude">wer corrected</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_54.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">348</biblScope></bibl><seg type="original" xml:lang="de">ylne <hi rend="italic">spät auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">ylne late, on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_54.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">348</biblScope></bibl><seg type="original" xml:lang="de">w. G. <hi rend="italic">am Rande im</hi> 16. <hi rend="italic">Jh.</hi>; <hi rend="italic">ergänze</hi> ⁊</seg><seg type="translation" xml:lang="en" source="#claude">w. G. in the margin in the 16th cent.; supply ⁊</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_54.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">349</biblScope></bibl><seg type="original" xml:lang="de">a. u. <hi rend="italic">aus K;</hi> u. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. u. from K; u. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_54.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">348</biblScope></bibl><seg type="original" xml:lang="de">-icge <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-icge Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_54.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">349</biblScope></bibl><seg type="original" xml:lang="de">c. l. <hi rend="italic">Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. l. Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_54.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">349</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_54.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">210</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> unfrei 11b. 14c. Neben Pönitenz Strafgeld</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> unfrei 11b. 14c. A fine alongside penance</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_54.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">357</biblScope></bibl><seg type="original" xml:lang="en">Cf. <hi rend="italic">Poen. Theod.</hi> 19 § 8, ed. Thorpe, <hi rend="italic">Anc. Laws</hi>, <hi rend="smallcaps">ii</hi>. p. 17; <hi rend="italic">Conf. Egb.</hi> 14, <hi rend="italic">ibid.</hi> p. 142.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_54.robnote.fn.6" n="6" source="#robertson"><bibl><biblScope unit="page">202</biblScope></bibl><label>wer</label><seg type="original" xml:lang="en">G, A, Ld; <hi rend="italic">were</hi> B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_54.robnote.fn.7" n="7" source="#robertson"><bibl><biblScope unit="page">202</biblScope></bibl><label>Godd</label><seg type="original" xml:lang="en"><hi rend="italic">w. G.</hi> G, A, Ld; added in the margin in 16th cent. in B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_54.robnote.fn.8" n="8" source="#robertson"><bibl><biblScope unit="page">202</biblScope></bibl><label>⁊</label><seg type="original" xml:lang="en">G, A, Ld; om. B.</seg></note>
      </div>
