        <head><ref type="lawCode" target="law:ECf">ECf</ref> 23.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 23.2"><pb n="648" ed="#liebermann"/>Et<ptr type="liebermannNote" n="34" target="#ECf_23-2.lnote.la.34"/> si non poterit habere<ptr type="liebermannNote" n="35" target="#ECf_23-2.lnote.la.35"/> eum ad rectum, habebit terminum<ptr type="liebermannNote" n="36" target="#ECf_23-2.lnote.la.36"/> mensis et<ptr type="liebermannNote" n="37" target="#ECf_23-2.lnote.la.37"/> unius diei.</ab>
        <note type="comparison" source="#liebermann" n="648"><label>printed alongside</label> <ref target="clause:ECfRetr_23-2">ECf retr 23.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 648 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-2.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-2.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">e. h. <hi rend="italic">S Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. h. S Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-2.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">unius <hi rend="italic">fügt zu Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad Do add unius</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-2.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">u. et <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. et Hr</seg></note>
