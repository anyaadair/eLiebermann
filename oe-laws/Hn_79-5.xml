      <div type="clause" n="79.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 79.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 79.5" corresp="#wit-lat"><pb n="595" ed="#liebermann"/>Si<ptr type="liebermannNote" n="n" target="#Hn_79-5.lnote.oe.n"/> quis in ecclesia faciat homicidium, hoc emendare non possit; set persequatur eum omnis qui Deum diligit, nisi fors(it)an<ptr type="liebermannNote" n="37" target="#Hn_79-5.lnote.oe.37"/> eueniat, ut<ptr type="liebermannNote" n="38" target="#Hn_79-5.lnote.oe.38"/> per aliquod pacis confugium rex ei uitam indulgeat, dignis<ptr type="liebermannNote" n="39" target="#Hn_79-5.lnote.oe.39"/> satisfactionibus apud Deum<ptr type="liebermannNote" n="40" target="#Hn_79-5.lnote.oe.40"/> et homines, sua prius induccione, ut emendare<ptr type="liebermannNote" n="41" target="#Hn_79-5.lnote.oe.41"/> liceat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 595 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-5.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bereits</hi> 11, 1<hi rend="italic">a</hi>. 12, 1</seg><seg type="translation" xml:lang="en" source="#claude">already 11, 1a. 12, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-5.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">forsan <hi rend="italic">Sc Hg;</hi> forsitan <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">forsan Sc Hg; forsitan the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-5.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-5.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">ding. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">ding. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-5.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">dominum <hi rend="italic">empfiehlt Wh</hi> [<hi rend="italic">falsch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">dominum recommended by Wh [wrong]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-5.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">-ri <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ri Lond</seg></note>
