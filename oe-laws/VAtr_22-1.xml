    <body>
      <div type="clause" n="22.1">
        <head><ref type="lawCode" target="law:VAtr">V Atr</ref> 22.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.1" corresp="#wit-g"><pb n="242" ed="#liebermann"/>⁊ gearwige eac to huslgange oft ⁊ gelome gehwa hine sylfne<ptr type="liebermannNote" n="2" target="#VAtr_22-1.lnote.oe.2"/>,</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.1" corresp="#wit-g2"><pb n="242" ed="#liebermann"/>⁊ gearwige eac to huslgange oft ⁊ gelome gehwa hine sylfne,</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.1" corresp="#wit-d"><pb n="243" ed="#liebermann"/>⁊ gearwige eac to huselgange oft ⁊ gelome gehwa hine silfne,</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="22.1" corresp="#wit-d"><pb n="84" ed="#robertson"/>⁊ gearwige eac to huselgange oft ⁊ gelome gehwa hine silfne.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g"><pb n="154" ed="#rabin-doml"/>And gearwige eac to huslgange oft and gelome gehwa hine sylfne.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="243" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#VAtr_22-1.lnote.de.1"/> jeder bereite sich auch oft und häufig zum Abendmahl</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let everyone also prepare himself often and frequently to go to communion,</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d"><ptr type="editorNote" n="1" target="#VAtr_22-1.robnote.n.1"/><pb n="85" ed="#robertson"/>And everyone shall also prepare himself frequently and often for receiving the sacrament.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-g"><pb n="450" ed="#whitelock"/>And everyone is to prepare himself often and frequently for going to communion;<ptr type="editorNote" n="2" target="#VAtr_22-1.whinote.n.2"/></ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g"><pb n="155" ed="#rabin-doml"/>And everyone is also to prepare themselves often and frequently to receive the sacrament.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VIAtr_27-1">VI Atr 27.1</ref></note>
        <note type="comparison" source="#whitelock" n="450"><label>expanded in</label> <ref target="clause:VIAtr_27-1">VI Atr 27.1</ref> <quote>VI Ethelred 27.1 adds “at least thrice a year”</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="VAtr_22-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">242</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert aus</hi> syfne</seg><seg type="translation" xml:lang="en" source="#claude">corrected from syfne</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_22-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">173</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Bestimmter VI 27 = I Cn 19. <hi rend="italic">Vgl. Gl</hi> Abendmahl 1</seg><seg type="translation" xml:lang="en" source="#claude">More precisely VI 27 = I Cn 19. <hi rend="italic">Cf. Gl</hi> Abendmahl 1</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VAtr_22-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="en">Cf. VI, 27, 1; I Cn. 19 (three times in the year). The times for taking communion are given as Christmas, Easter and Whitsuntide in <hi rend="italic">Excerpt. Egb. Ebor.</hi> 38, ed. Thorpe, <hi rend="italic">Anc. Laws</hi>, <hi rend="smallcaps">ii</hi>. p. 103.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="VAtr_22-1.whinote.n.2" n="2" source="#whitelock"><bibl><biblScope unit="page">450</biblScope></bibl><label>communion</label><seg type="original" xml:lang="en">VI Ethelred 27.1 adds “at least thrice a year”</seg></note>
      </div>
