        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 82.2" corresp="#wit-lat"><pb n="598" ed="#liebermann"/>Si uagans<ptr type="liebermannNote" n="q" target="#Hn_82-2.lnote.oe.q"/> homo sit qui forisfecerit<ptr type="liebermannNote" n="25" target="#Hn_82-2.lnote.oe.25"/>, requiratur tamen<ptr type="liebermannNote" n="26" target="#Hn_82-2.lnote.oe.26"/> de recto ubi eum esse constabit; et consilio ac<ptr type="liebermannNote" n="27" target="#Hn_82-2.lnote.oe.27"/> licentia eius<ptr type="liebermannNote" n="7" target="#Hn_82-2.lnote.oe.7"/> in cuius terra ac<ptr type="liebermannNote" n="28" target="#Hn_82-2.lnote.oe.28"/> socna inuenietur<ptr type="liebermannNote" n="29" target="#Hn_82-2.lnote.oe.29"/>, fide uel sacramento<ptr type="liebermannNote" n="30" target="#Hn_82-2.lnote.oe.30"/> uel fideiussoribus adstrictus, iuste satisfaccioni<ptr type="liebermannNote" n="31" target="#Hn_82-2.lnote.oe.31"/> preparetur.</ab>
