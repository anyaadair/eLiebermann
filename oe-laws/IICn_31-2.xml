    <body>
      <div type="clause" n="31.2">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 31.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="31.2" corresp="#wit-g-a"><pb n="336" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="1" target="#IICn_31-2.lnote.oe.1"/> him seo lad<ptr type="liebermannNote" n="4" target="#IICn_31-2.lnote.oe.4-2"/> berste, gylde þam cingce his were; ⁊ si<ptr type="liebermannNote" n="5" target="#IICn_31-2.lnote.oe.5"/> se man utlah.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="31.2" corresp="#wit-b"><ptr type="liebermannNote" n="3" target="#IICn_31-2.lnote.oe.3"/><pb n="336" ed="#liebermann"/>⁊ beo se man utlah wið ðone cyng.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="31.2" corresp="#wit-a"><pb n="336" ed="#liebermann"/>Gif him seo lad berste, gilde þam cyninge his were; ⁊ sy se man utlage.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="31.2" corresp="#wit-q"><pb n="337" ed="#liebermann"/>Si purgatio<ptr type="liebermannNote" n="6" target="#IICn_31-2.lnote.oe.6"/> frangat ei, soluat<ptr type="liebermannNote" n="7" target="#IICn_31-2.lnote.oe.7"/> regi weram suam; et qui fugit, extra<ptr type="liebermannNote" n="8" target="#IICn_31-2.lnote.oe.8"/> legem habeatur.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="31.2" corresp="#wit-inst-cn"><pb n="337" ed="#liebermann"/>Si non poterit<ptr type="liebermannNote" n="2" target="#IICn_31-2.lnote.oe.2"/> purgare<ptr type="liebermannNote" n="3" target="#IICn_31-2.lnote.oe.3-2"/> se, persoluat regi ƿere suum; et homo sit exul ab omnibus.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="31.2" corresp="#wit-cons-cn"><pb n="337" ed="#liebermann"/>Cui si purgacio deficiat, soluat eius redempcionem regi; ille uero sit exlex.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="31a.2" corresp="#wit-b"><pb n="192" ed="#robertson"/>[Gyf him seo lad berste, gylde þam cingce his were]<ptr type="editorNote" n="3" target="#IICn_31-2.robnote.fn.3"/> ⁊ beo se man utlah wið ðone cyng<ptr type="editorNote" n="9" target="#IICn_31-2.robnote.fn.9"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="272" ed="#rabin-doml"/>Gyf him seo lad berste, gylde þam cingce his were; and si se man utlah.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="336" ed="#liebermann"/>Wenn ihm diese Reinigung misslingt, zahle er dem König sein<ptr type="liebermannNote" n="1" target="#IICn_31-2.lnote.de.1"/> Wergeld. Und jener Untergebene sei friedlos (gegenüber<ptr type="liebermannNote" n="2" target="#IICn_31-2.lnote.de.2"/> dem König <hi rend="italic">B</hi>).<ptr type="liebermannNote" n="3" target="#IICn_31-2.lnote.de.3"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If this clearing fails him, let him pay the king his wergild. And let that man be an outlaw (with respect to the king, B).</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="193" ed="#robertson"/>[And if he fails to clear himself, he shall pay his (own) wergeld to the king], and the man shall be an outlaw towards the king<ptr type="editorNote" n="1" target="#missing"/>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="467" ed="#whitelock"/>And if the exculpation fails, he is to pay his [own] wergild to the king and the man is to be an outlaw.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="273" ed="#rabin-doml"/>If the exoneration fails, he is to pay a fine equal to his wergild to the king, and the fugitive is to be declared an outlaw.</ab>
        <note type="comparison" source="#liebermann" n="336"><ref target="clause:IAtr_1-13">I Atr 1.13</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 1, 13</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_52-2">Leis Wl 52.2</ref></note>
        <note type="editorial">B skips a line here. Liebermann compares I Atr 1.13.; BR: added from Gesetze I p. 337, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">Gyf . . . and: omitted B</note>
        <note type="textual" source="#rabin-doml">si: beo B</note>
        <note type="textual" source="#rabin-doml">utlah: B adds wið ðone cyng</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">Cuius <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cuius Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Zeile übersprungen</hi></seg><seg type="translation" xml:lang="en" source="#claude">line skipped</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">f. ei p. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. ei p. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">reddat <hi rend="italic">Hk Hn</hi></seg><seg type="translation" xml:lang="en" source="#claude">reddat Hk Hn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">utlaga sit <hi rend="italic">Hn</hi></seg><seg type="translation" xml:lang="en" source="#claude">utlaga sit Hn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-2.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de">lade berst, gilde ð. cyning <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lade berst, gilde ð. cyning Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de">sy se m. utlage <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy se m. utlage Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb, wo nachträglich</hi> potest <hi rend="italic">hinter</hi> se</seg><seg type="translation" xml:lang="en" source="#claude">omitted Cb, where potest has been added later after se</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_31-2.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">se p. <hi rend="italic">Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">se p. Lb S</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_31-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">207</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S</hi>. I Atr 1, 13¹</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See</hi> I Atr 1, 13¹</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_31-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">207</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">B verdeutlicht synonym mit (vielleicht aus) 30, 9 <hi rend="italic">wið eal folc</hi>, im Ggs. zur Beschränkung der Friedlosigkeit (<hi rend="italic">s. d. Gl</hi> 6) bloss auf den Gerichtsbezirk der Ächtung</seg><seg type="translation" xml:lang="en" source="#claude">B makes this explicit, synonymously with (perhaps taken from) 30, 9 <hi rend="italic">wið eal folc</hi>, in contrast to the restriction of outlawry (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 6) merely to the court district in which it was pronounced</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_31-2.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">207</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Der in der Quelle folgende Satz I Atr 1, 14 lag vielleicht teilweise für <hi rend="italic">o</hi>. 13, 1 vor</seg><seg type="translation" xml:lang="en" source="#claude">The sentence that follows in the source, I Atr 1, 14, was perhaps partly the basis of <hi rend="italic">above</hi> 13, 1</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_31-2.robnote.fn.3" n="3" source="#robertson"><bibl><biblScope unit="page">192</biblScope></bibl><label>heo</label><seg type="original" xml:lang="en">G, A, Ld; om. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_31-2.robnote.fn.9" n="9" source="#robertson"><bibl><biblScope unit="page">192</biblScope></bibl><label>cyng</label><seg type="original" xml:lang="en"><hi rend="italic">w. ð. c.</hi> Not in G, A, Ld.</seg></note>
      </div>
