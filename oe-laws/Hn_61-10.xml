      <div type="clause" n="61.10">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 61.10</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 61.10" corresp="#wit-lat"><pb n="581" ed="#liebermann"/>Si quis dapifer uel prepositus uel minister placitum domini sui contramandet, ita sit<ptr type="liebermannNote" n="46" target="#Hn_61-10.lnote.oe.46"/>, quicquid dominus eius dicat, si<ptr type="liebermannNote" n="f" target="#Hn_61-10.lnote.oe.f"/> redierit<ptr type="liebermannNote" n="47" target="#Hn_61-10.lnote.oe.47"/> et placitum aduersarii<ptr type="liebermannNote" n="48" target="#Hn_61-10.lnote.oe.48"/> sui fractum<ptr type="liebermannNote" n="t" target="#Hn_61-10.lnote.oe.t"/> esse uelit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 581 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-10.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">581</biblScope></bibl><seg type="original" xml:lang="de">dominus</seg><seg type="translation" xml:lang="en" source="#claude">dominus</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-10.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">581</biblScope></bibl><seg type="original" xml:lang="de">gescheitert <hi rend="italic">durch Nichterscheinen des Gegners, der aber durch den Verwalter abbestellt gewesen</hi></seg><seg type="translation" xml:lang="en" source="#claude">failed through the non-appearance of the opponent, who had, however, been called off by the steward</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-10.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">581</biblScope></bibl><seg type="original" xml:lang="de">se <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">se K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-10.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">581</biblScope></bibl><seg type="original" xml:lang="de">reddiderit <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">reddiderit Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-10.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">581</biblScope></bibl><seg type="original" xml:lang="de">-rss. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rss. <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-10.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Truchsess 4a; Adelsbeamte 11—<hi rend="italic">se</hi>{46}—61, 11 <hi rend="italic">quorum</hi> bis <hi rend="italic">eius</hi> am Rande Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Truchsess 4a; Adelsbeamte 11—<hi rend="italic">se</hi>{46}—61, 11 <hi rend="italic">quorum</hi> to <hi rend="italic">eius</hi> in the margin Rs</seg></note>
