    <body>
      <div type="clause" n="80.12">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 80.12</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 80.12" corresp="#wit-lat"><pb n="597" ed="#liebermann"/>Infiht<ptr type="liebermannNote" n="34" target="#Hn_80-12.lnote.oe.34"/> uel insocna est quod ab ipsis qui<ptr type="liebermannNote" n="30" target="#Hn_80-12.lnote.oe.30"/> in domo sunt contubernales<ptr type="liebermannNote" n="m" target="#Hn_80-12.lnote.oe.m"/> agitur; hoc etiam, sicut<ptr type="liebermannNote" n="n" target="#Hn_80-12.lnote.oe.n"/> premisimus, wita emendabitur patrifamilias, si questionem<ptr type="liebermannNote" n="o" target="#Hn_80-12.lnote.oe.o"/> habeat querentem uel quesitam.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 597 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-12.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">contubernium <hi rend="italic">sagt Lex Ribuar.</hi> 41, 2 <hi rend="italic">statt</hi> heriraida; <hi rend="italic">vgl.</hi> 80, 11</seg><seg type="translation" xml:lang="en" source="#claude">contubernium <hi rend="italic">is the word in Lex Ribuar.</hi> 41, 2 <hi rend="italic">instead of</hi> heriraida; <hi rend="italic">cf.</hi> 80, 11</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-12.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">80, 9<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">80, 9<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-12.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">socn besitzt, <hi rend="italic">von Amtswegen</hi> zu untersuchen oder <hi rend="italic">nur auf Klage hin</hi> [<hi rend="italic">vgl.</hi> 44, 2] zu richten[?]. <hi rend="italic">Oder</hi> quærentis et quæsiti <hi rend="italic">zu emendiren:</hi> über Kläger und Beklagten</seg><seg type="translation" xml:lang="en" source="#claude">possesses socn, to investigate <hi rend="italic">by virtue of his office</hi> or to judge <hi rend="italic">only upon a complaint</hi> [<hi rend="italic">cf.</hi> 44, 2][?]. <hi rend="italic">Or emend to</hi> quærentis et quæsiti: over plaintiff and defendant</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-12.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-12.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">infitht <hi rend="italic">Sc Hg;</hi> infilc <hi rend="italic">Co Or;</hi> infylc <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">infitht Sc Hg; infilc Co Or; infylc K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-12.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Haushalt 4; Gerichtsbarkeit 28A—81 Rub. fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Haushalt 4; Gerichtsbarkeit 28A—81 rubric omitted Rs</seg></note>
      </div>
