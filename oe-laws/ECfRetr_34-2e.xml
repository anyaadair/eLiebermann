    <body>
      <div type="clause" n="34.2e">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 34.2e</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 34.2e"><pb n="663" ed="#liebermann"/>Post quem Hardecnutus<ptr type="liebermannNote" n="20" target="#ECfRetr_34-2e.lnote.la.20"/>, filius Chnuti <hi rend="bold">et</hi> Eluiue<ptr type="liebermannNote" n="21" target="#ECfRetr_34-2e.lnote.la.21"/>-<hi rend="spaced">Emme</hi>, sororis Rodberti<ptr type="liebermannNote" n="22" target="#ECfRetr_34-2e.lnote.la.22"/> Normannorum<ptr type="liebermannNote" n="23" target="#ECfRetr_34-2e.lnote.la.23"/> <hi rend="bold">ducis</hi><ptr type="liebermannNote" n="e" target="#ECfRetr_34-2e.lnote.la.fn.e"/> et <hi rend="spaced">matris</hi> regis<ptr type="liebermannNote" n="24" target="#ECfRetr_34-2e.lnote.la.24"/> <hi rend="bold">ultimi</hi><ptr type="liebermannNote" n="ee" target="#ECfRetr_34-2e.lnote.la.fn.ee"/> Eadwardi<ptr type="liebermannNote" n="25" target="#ECfRetr_34-2e.lnote.la.25"/>, regnauit† duobus annis, ebdomadibus<ptr type="liebermannNote" n="26" target="#ECfRetr_34-2e.lnote.la.26"/> duodecim minus. <hi rend="spaced">Sicque</hi> completi sunt LXVIII<ptr type="liebermannNote" n="27" target="#ECfRetr_34-2e.lnote.la.27"/> anni, <hi rend="bold">in quibus</hi> lege <hi rend="bold">predicte</hi><ptr type="liebermannNote" n="28" target="#ECfRetr_34-2e.lnote.la.28"/> <hi rend="bold">fuerant</hi><ptr type="liebermannNote" n="29" target="#ECfRetr_34-2e.lnote.la.29"/> <hi rend="bold">penitus</hi><ptr type="liebermannNote" n="30" target="#ECfRetr_34-2e.lnote.la.30"/> <hi rend="bold">pretermisse.</hi></ab>
        <note type="comparison" source="#liebermann" n="663"><label>printed alongside</label> <ref target="clause:ECf_34-2e">ECf 34.2e</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 663 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">Liebermann prints “regnauit†” and gives in the outer margin of the ECf retr column the dates †1039–42. Beside “pretermisse” he gives the dates 975–1042, for the 68 years.</note>
        <note type="editorial">Liebermann’s note 30 in this column reads “fehlt Hr”; Hr is a manuscript of ECf, not of the Retractator, so this may be a misprint for Hv.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2e.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht (mit Hk und einer Retr.-Classe)</hi> Ricardi [II.] <hi rend="italic">zu bessern, laut des Irrthums auch</hi> 35, 2. Ducem <hi rend="italic">setzt Retr., weil im</hi> 12. <hi rend="italic">Jh. der Grafentitel für die Normandie verschwand.</hi></seg><seg type="translation" xml:lang="en" source="#claude">not to be corrected (with Hk and one class of the Retr.) to Ricardi [II], given the same error also at 35, 2. The Retr. puts ducem because in the 12th century the title of count for Normandy disappeared.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2e.lnote.la.fn.ee" n="ee" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">erst Heinrich III. nannte</hi> 1239 <hi rend="italic">seinen Thronfolger wieder</hi> Eadward</seg><seg type="translation" xml:lang="en" source="#claude">not until 1239 did Henry III again name his heir Edward</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2e.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielmehr</hi> III</seg><seg type="translation" xml:lang="en" source="#claude">rather III</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2e.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">4 + 38 + 1 + 18 + 5 + 2 = 68</seg><seg type="translation" xml:lang="en" source="#claude">4 + 38 + 1 + 18 + 5 + 2 = 68</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2e.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">-chn. <hi rend="italic">Va Hv; die Buchstaben</hi> cnu <hi rend="italic">roth Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-chn. Va Hv; the letters cnu in red Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2e.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Lond;</hi> id est <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Lond; Hv adds id est</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2e.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">Ricardi</hi> <hi rend="italic">Lb Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ricardi Lb Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2e.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2e.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">Edw. r. ult. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">Edw. r. ult. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2e.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">id est sancti <hi rend="italic">fügt zu Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Co adds id est sancti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2e.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Cb;</hi> -adis <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Cb; -adis the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2e.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">quadraginta octo <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">quadraginta octo Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2e.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Cb Lb Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Cb Lb Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2e.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">-runt <hi rend="italic">Lb;</hi> pret. erant <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-runt Lb; pret. erant Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34-2e.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">After him Harthacnut, son of Cnut and of Ælfgifu-Emma, sister of Robert, duke of the Normans, and mother of the last King Edward, reigned† two years, less twelve weeks. And thus were completed the sixty-eight years in which the aforesaid laws had been entirely passed over.</ab>
      </div>
    </body>
  </text>
