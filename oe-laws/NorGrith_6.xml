    <body>
      <div type="clause" n="6">
        <head><ref type="lawCode" target="law:NorGrith">Nor Grið</ref> 6</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6" corresp="#wit-g-b"><pb n="473" ed="#liebermann"/>[mæ]r[þ]e<ptr type="liebermannNote" n="4" target="#NorGrith_6.lnote.oe.4"/> áá<ptr type="liebermannNote" n="5" target="#NorGrith_6.lnote.oe.5"/> be stowe mæþe. [3] [⁊]</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" n="2[b]" corresp="#wit-g-b"><pb n="32" ed="#rabin-doml"/>mærþe, aa be stowe mæþe.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="473" ed="#liebermann"/>[Schluss von 2.] Und einem Priester [?] sind Kirchgänge verboten [mit<ptr type="liebermannNote" n="1" target="#missing"/>] Weibern und Waffen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">[End of clause 2.] 3. And for a priest[?], church-goings with women and weapons are forbidden.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-b"><pb n="33" ed="#rabin-doml"/>always according to the status of the site.</ab>
        <note type="editorial">Clause 3 begins at the end of this line and runs over lines 7–8. The ‘e’ of ‘[mæ]r[þ]e’ cannot be made out; Warner reads letter 3 or 2 as rather ‘t’, and ‘áá’ as illegible. Liebermann supplies ‘mid’ before ‘wifum’.</note>
        <note type="textual" source="#rabin-doml">mærþe: reconstructed by Liebermann</note>
        <note type="liebermannNote" subtype="textual" xml:id="NorGrith_6.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">473</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> wyrceð <hi rend="italic">III Atr.</hi> 16</seg><seg type="translation" xml:lang="en" source="#claude">cf. wyrceð III Atr. 16</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="NorGrith_6.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">473</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. ebd.</hi> 156, 5 <hi rend="italic">A</hi>³</seg><seg type="translation" xml:lang="en" source="#claude">cf. ibid. 156, 5 A³</seg></note>
      </div>
    </body>
