        <dictScrap type="liebermann"><hi rend="bold">gedeman</hi> <hi rend="italic">richten</hi> <hi rend="bold">1</hi>) <hi rend="italic">Urteil sprechen, <ref type="abbreviation" target="gram:mit"><abbr>m.</abbr></ref> <ref type="abbreviation" target="gram:Dativ"><abbr>dt</abbr></ref> der Partei;</hi> 3: he ~mð us <ref type="lawCode" target="law:Episc">Episc</ref> 14 | <hi rend="italic"><ref type="abbreviation" target="gram:Optativ"><abbr>op</abbr></ref></hi> 3: oðrum ~me <ref type="lawCode" target="law:IIIEg">III Eg</ref> 3 <hi rend="bold">2</hi>) <hi rend="italic">zuerkennen, <ref type="abbreviation" target="gram:mitAccusativ"><abbr>m ac</abbr></ref> des Ausspruchs:</hi> undom ~me <ref type="lawCode" target="law:IICn">II Cn</ref> 15,1 | <hi rend="italic"><ref type="abbreviation" target="gram:Imperativ"><abbr>ipa</abbr></ref>:</hi> gidoem þætte soð is <ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 4, iudica quod iustum est <hi rend="italic"><ref type="abbreviation" target="gram:glossirend"><abbr>glossirend</abbr></ref></hi> | <hi rend="italic"><ref type="abbreviation" target="gram:Praeteritum"><abbr>ptt</abbr></ref></hi> 3: Crist mildheortnesse þam ~mde <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 49,7 <hi rend="bold">3</hi>) [?] <hi rend="italic"><ref type="abbreviation" target="gram:transitiv"><abbr>tr.</abbr></ref>, richten, beurteilen;</hi> 3: æghwelcne ~með 49,6 (<hi rend="italic"><ref type="abbreviation" target="gram:Optativ"><abbr>op</abbr></ref>:</hi> ~me <ref type="lawCode" target="law:H">H</ref>); unicuique <hi rend="italic">versteht</hi> <ref type="lawCode" target="law:Quadr">Q</ref> [<hi rend="italic">so <ref type="bibl" target="bib:CitToller">Toller</ref> und alle <ref type="abbreviation" target="gram:Ubersetzer"><abbr>Übss.</abbr></ref></hi>], <hi rend="italic"><ref type="abbreviation" target="gram:falsch"><abbr>falsch</abbr></ref> <ref type="abbreviation" target="gram:nach"><abbr>nach</abbr><