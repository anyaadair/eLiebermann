      <div type="clause" n="III 59">
        <head><ref type="lawCode" target="law:InCn">In Cn</ref> III 59</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="In Cn III 59" corresp="#wit-lat"><pb n="615" ed="#liebermann"/>sic<ptr type="liebermannNote" n="24" target="#InCn_III-59.lnote.oe.24"/> etiam monetarios<ptr type="liebermannNote" n="y" target="#InCn_III-59.lnote.oe.y"/> et púndæres<ptr type="liebermannNote" n="25" target="#InCn_III-59.lnote.oe.25"/> uel<ptr type="liebermannNote" n="26" target="#InCn_III-59.lnote.oe.26"/> ponderatores; et loca<ptr type="liebermannNote" n="z" target="#InCn_III-59.lnote.oe.z"/> iudiciorum ferri aut aquę; proprias mensuras et pondera<ptr type="liebermannNote" n="y" target="#InCn_III-59.lnote.oe.y"/>; et multas uarias consuetudines, quas statuerunt qúi Dei<ptr type="liebermannNote" n="27" target="#InCn_III-59.lnote.oe.27"/> honorem (et<ptr type="liebermannNote" n="2" target="#InCn_III-59.lnote.oe.2"/> iustitiam) amauerunt.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 615 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-59.lnote.oe.y" n="y" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de">Jurisdiction über öffentliche Münzer und Wäger. <hi rend="italic">Laut königlicher Gesetze falsch verallgemeinert aus den an einigen Orten verwirklichten Ansätzen zu hierarchischer Beschlagnahme der Münz-, Gewicht- und Maass-Verwaltung: Synode a.</hi> 786; II As. 14; Episc. 6. <hi rend="italic">Eigenes Münzgewicht besass Graf Eustach in Hertfordshire:</hi> terra . . ualet 22 libras de albis denariis ad pensum huius comitis; <hi rend="italic">Domesday</hi> I 137, 2</seg><seg type="translation" xml:lang="en" source="#claude">Jurisdiction over public moneyers and weighers. As royal laws show, wrongly generalized from the beginnings, realized in some places, of the hierarchy's appropriation of the administration of coinage, weights and measures: Synod a. 786; II As. 14; Episc. 6. Count Eustace possessed his own coin-weight in Hertfordshire: terra . . ualet 22 libras de albis denariis ad pensum huius comitis; <hi rend="italic">Domesday</hi> I 137, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-59.lnote.oe.z" n="z" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Feuerordal geschah in der Kirche; das Gewässer zum Kaltwasserordal war geweiht, unterstand also bischöflicher Mund</hi></seg><seg type="translation" xml:lang="en" source="#claude">The ordeal of fire took place in the church; the water for the cold-water ordeal was consecrated, and thus came under the bishop's protection</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-59.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Cb; fehlt HRl T</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Cb; absent in HRl T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-59.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de">sicut <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">sicut <hi rend="italic">Cb</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-59.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de">-deres <hi rend="italic">Cb T</hi></seg><seg type="translation" xml:lang="en" source="#claude">-deres <hi rend="italic">Cb T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-59.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de">et l. i. f. aut aq. (<hi rend="italic">fehlt T</hi>) uel po. aque pro. <hi rend="italic">Cb T</hi></seg><seg type="translation" xml:lang="en" source="#claude">et l. i. f. aut aq. (missing in <hi rend="italic">T</hi>) uel po. aque pro. <hi rend="italic">Cb T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-59.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de">h. Dei <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. Dei <hi rend="italic">Cb</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-59.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">333</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Münze 4b. 5; Mass 7.a; Gewicht 11a; Ordal 11a</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Münze 4b. 5; Mass 7.a; Gewicht 11a; Ordal 11a</seg></note>
      </div>
