    <body>
      <div type="clause" n="8.3">
        <head><ref type="lawCode" target="law:WlArt">Wl art</ref> 8.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-h"><pb n="488" ed="#liebermann"/>Quarta<ptr type="liebermannNote" n="37" target="#WlArt_8-3.lnote.oe.37"/> autem uice<ptr type="liebermannNote" n="38" target="#WlArt_8-3.lnote.oe.38"/> si non uenerint, reddatur de rebus<ptr type="liebermannNote" n="39" target="#WlArt_8-3.lnote.oe.39"/> hominis<ptr type="liebermannNote" n="40" target="#WlArt_8-3.lnote.oe.40"/> illius<ptr type="liebermannNote" n="41" target="#WlArt_8-3.lnote.oe.41"/> qui uenire<ptr type="liebermannNote" n="42" target="#WlArt_8-3.lnote.oe.42"/> noluerit quod calumniatum<ptr type="liebermannNote" n="43" target="#WlArt_8-3.lnote.oe.43"/> est, quod dicitur ceapgeld<ptr type="liebermannNote" n="44" target="#WlArt_8-3.lnote.oe.44"/>; et insuper<ptr type="liebermannNote" n="45" target="#WlArt_8-3.lnote.oe.45"/> forisfactura<ptr type="liebermannNote" n="46" target="#WlArt_8-3.lnote.oe.46"/> regis.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="8.3" corresp="#wit-h"><pb n="242" ed="#robertson"/>Quarta autem vice si non venerint, reddatur de rebus hominis illius qui venire noluerit quod calumniatum est, quod dicitur ceapgeld, et insuper forisfactura regis.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-h"><pb n="243" ed="#robertson"/>But if they do not come on the fourth summons, the amount claimed, called the "ceapgeld," shall be paid from the property of the man who has refused to appear, and in addition the fine for insubordination to the King.</ab>
        <note type="comparison" source="#liebermann" n="488">Inst Cn II 25.1</note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 25, 1</note>
        <note type="editorial">Added October 2026 from Robertson pp. 242–243 (text and translation); Liebermann’s text added from Gesetze I p. 488, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8-3.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">statt</hi> Qu. — uenerint <hi rend="italic">nur</hi> et si quarto <hi rend="italic">Cb Retr Ra Vi Va Ph Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">instead of Qu. — uenerint only et si quarto Cb Retr Ra Vi Va Ph Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8-3.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">am Rande H</hi></seg><seg type="translation" xml:lang="en" source="#claude">in the margin H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8-3.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">huius <hi rend="italic">fügt zu Cb Retr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cb Retr add huius</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8-3.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">i. h. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. h. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8-3.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">i. q. u. n. <hi rend="italic">fehlt Cb Retr Ra Vi Va Ph Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. q. u. n. omitted in Cb Retr Ra Vi Va Ph Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8-3.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">u. n. quod <hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. n. quod omitted in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8-3.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">-tus <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tus Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8-3.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">chepgeld <hi rend="italic">Cb;</hi> scapweld <hi rend="italic">Hv;</hi> chapgield <hi rend="italic">Franz.;</hi> chapgeldt <hi rend="italic">Va;</hi> chapgelt <hi rend="italic">Ph;</hi> cahþgelt <hi rend="italic">Pl;</hi> schapgelt <hi rend="italic">Ra</hi></seg><seg type="translation" xml:lang="en" source="#claude">chepgeld Cb; scapweld Hv; chapgield French; chapgeldt Va; chapgelt Ph; cahþgelt Pl; schapgelt Ra</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8-3.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">super <hi rend="italic">Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">super Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8-3.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">r. [regi <hi rend="italic">Hv</hi>] forisfacturam <hi rend="italic">Hv Retr Ra Vi Va Ph Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. [regi Hv] forisfacturam Hv Retr Ra Vi Va Ph Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8-3.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">281</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Urteil 5</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Urteil 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8-3.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">281</biblScope></bibl><seg type="original" xml:lang="de">Königs ‘Ungehorsam’ (<hi rend="italic">s. d. Gl</hi> 1c. 18), auch sonst für Gerichtsversäumnis (<hi rend="italic">s. d</hi>. 2. 5. a) und Rechtsweigerung 3a. 5. 6</seg><seg type="translation" xml:lang="en" source="#claude">The king’s ‘disobedience’ fine (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1c. 18), applied elsewhere too for default of court attendance (<hi rend="italic">see</hi> that word 2. 5. a) and refusal of justice 3a. 5. 6</seg></note>
      </div>
    </body>
  </text>
