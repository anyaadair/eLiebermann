      <div type="clause" n="37.2">
        <head><ref type="lawCode" target="law:Af">Af</ref> 37.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="37.2" corresp="#wit-e"><pb n="70" ed="#liebermann"/>Gif he hwæt yfla<ptr type="liebermannNote" n="26" target="#Af_37-2.lnote.oe.26"/> gedon<ptr type="liebermannNote" n="27" target="#Af_37-2.lnote.oe.27"/> hæbbe<ptr type="liebermannNote" n="28" target="#Af_37-2.lnote.oe.28"/> ðær<ptr type="liebermannNote" n="29" target="#Af_37-2.lnote.oe.29"/> he ær wæs, bete ðæt se ðe hine ðonne to men onfo<ptr type="liebermannNote" n="30" target="#Af_37-2.lnote.oe.30"/>, ⁊<ptr type="liebermannNote" n="**" target="#Af_37-2.lnote.oe.star2"/> cyninge<ptr type="liebermannNote" n="31" target="#Af_37-2.lnote.oe.31"/> CXX scill. to wite.<ptr type="liebermannNote" n="32" target="#Af_37-2.lnote.oe.32"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="37.2" corresp="#wit-h"><pb n="70" ed="#liebermann"/>Gif he hwæt (to<ptr type="liebermannNote" n="11" target="#Af_37-2.lnote.oe.11"/>) yfele<ptr type="liebermannNote" n="12" target="#Af_37-2.lnote.oe.12"/> gedon hæfð þær he ær wæs, bete ðæt þonne<ptr type="liebermannNote" n="11" target="#Af_37-2.lnote.oe.11"/> se ðe hine to men onfó<ptr type="liebermannNote" n="13" target="#Af_37-2.lnote.oe.13"/>, ond<ptr type="liebermannNote" n="1" target="#Af_37-2.lnote.oe.1"/> cyninge CXX scll' to wite.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="37.2" corresp="#wit-b-no-prol"><pb n="70" ed="#liebermann"/>Gyf he hwǽt to yfele gedon hæfð<ptr type="liebermannNote" n="11" target="#Af_37-2.lnote.oe.11-2"/> ðær he ær wæs, bete þ<hi rend="italic">æt</hi> se ðe hine ðonnon to m<hi rend="italic">en</hi> underfó, ⁊ cyninge hundtwelftig scill' to wite.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="37.2" corresp="#wit-q"><pb n="71" ed="#liebermann"/>Si quid (etiam<ptr type="liebermannNote" n="14" target="#Af_37-2.lnote.oe.14"/>) malefecit<ptr type="liebermannNote" n="15" target="#Af_37-2.lnote.oe.15"/> ubi prius fuit, hoc emendet qui eum ad<ptr type="liebermannNote" n="16" target="#Af_37-2.lnote.oe.16"/> hominem receperit et regi centum uiginti sol. wite.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="80" ed="#attenborough"/>Gif he hwæt yfla<ptr type="editorNote" n="15" target="#Af_37-2.attnote.fn.15"/> gedon hæbbe<ptr type="editorNote" n="16" target="#Af_37-2.attnote.fn.16"/> ðær he ær wæs, bete ðæt se ðe hine ðonne<ptr type="editorNote" n="17" target="#Af_37-2.attnote.fn.17"/> to men onfo<ptr type="editorNote" n="18" target="#Af_37-2.attnote.fn.18"/>, ⁊ [sylle þam]<ptr type="editorNote" n="19" target="#Af_37-2.attnote.fn.19"/> cyninge CXX scill. to wite.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="38.2" corresp="#wit-e"><pb n="336" ed="#jurasinski-and-oliver"/>Gif he hwæt yfla gedon hæbbe ðær he ær wæs, bete ðæt se ðe hine ðonne to men onfo, ⁊ cy___ninge CXX scill to wite.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="71" ed="#liebermann"/>Wenn er etwas übles<ptr type="liebermannNote" n="1" target="#Af_37-2.lnote.de.1"/> gethan hatte, da wo er früher war, so büsse<ptr type="liebermannNote" n="2" target="#Af_37-2.lnote.de.2"/> dies der [Herr], welcher ihn nunmehr zum Manne annimmt<ptr type="liebermannNote" n="3" target="#Af_37-2.lnote.de.3"/> [an den Geschädigten], und<ptr type="liebermannNote" n="4" target="#Af_37-2.lnote.de.4"/> dem Könige<ptr type="liebermannNote" n="5" target="#Af_37-2.lnote.de.5"/> 120 Schill. zur Strafe.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he had done anything evil where he was before, let the [lord] who now takes him on as his man make amends for it [to the injured party], and [pay] the king 120 shillings as a fine.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="81" ed="#attenborough"/>If he has committed any manner of offence in the place where he has been [residing], he who now takes him into his employment shall pay compensation for it, and a fine of 120 shillings to the king.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="415" ed="#whitelock"/>If he has committed any wrong where he was before, he who now receives him as his man is to pay compensation for it, and 120 shillings to the king as fine.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="337" ed="#jurasinski-and-oliver"/>If he has commited some offense where he was before, let him who took him on as his man compensate for that, and 120 shillings to the king as fine.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_37-2.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">to yfle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">to yfle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_37-2.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">gedón <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gedón So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_37-2.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">hæfþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hæfþ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_37-2.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">þære <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">þære So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_37-2.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">underfo <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">underfo Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_37-2.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">sylle þam <hi rend="italic">fügt zu So</hi></seg><seg type="translation" xml:lang="en" source="#claude">sylle þam added by So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_37-2.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">cyning mid <hi rend="spaced">hundtwelftigum</hi> <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyning mid <hi rend="italic">hundtwelftigum</hi> Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_37-2.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> Be gefeoht (<hi rend="italic">d. i. Rubrik für Af</hi> 38) <hi rend="italic">für das folgende Blatt vorgeschrieben, dann leere Seiten, dann II As, dann Ine</hi> 54 <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">there follows Be gefeoht (i.e. the rubric for Af 38), written in advance for the following leaf, then blank pages, then II As, then Ine 54 So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_37-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">am Rande</hi></seg><seg type="translation" xml:lang="en" source="#claude">in the margin</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_37-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">le <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">le on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_37-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">under</hi> <hi rend="italic">über</hi> on <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">under</hi> written above on</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_37-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_37-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">71</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_37-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">71</biblScope></bibl><seg type="original" xml:lang="de">-cerit <hi rend="italic">Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cerit Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_37-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">71</biblScope></bibl><seg type="original" xml:lang="de">receptat hom. <hi rend="italic">R;</hi> recepit ad h. <hi rend="italic">T Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">receptat hom. R; recepit ad h. T Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_37-2.lnote.oe.11-2" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">über der Seite</hi> Ælfredes lage</seg><seg type="translation" xml:lang="en" source="#claude">at the top of the page Ælfredes lage</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_37-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Gen. part. ‘an Missetaten’ E; ‘zu Bösem’ H cor. B</seg><seg type="translation" xml:lang="en" source="#claude">Partitive gen. ‘of misdeeds’ E; ‘to evil’ H cor. B</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_37-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Haftung 7d; Gefolge 19c</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Haftung 7d; Gefolge 19c</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_37-2.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">B modernisiert</seg><seg type="translation" xml:lang="en" source="#claude">B modernises</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_37-2.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘gebe dem’ fügt So zu</seg><seg type="translation" xml:lang="en" source="#claude">So adds ‘let him give to the’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_37-2.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Neben den in Af 37, 1, also doppelten Ungehorsam (<hi rend="italic">s. d.</hi> 4. 16). Die Fürsorge für Rechtspflege würde dem Staate unmöglich, wenn Gefolgsleute durch den Vassallitätsherrn vor gerichtlicher Verfolgung gesichert würden.</seg><seg type="translation" xml:lang="en" source="#claude">In addition to that in Af 37, 1, thus a double disobedience (<hi rend="italic">see</hi> that word 4. 16). Care for the administration of justice would become impossible for the state if followers were protected from judicial prosecution by their lord in vassalage.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_37-2.attnote.fn.15" n="15" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>yfla</label><seg type="original" xml:lang="en"><hi rend="italic">(to) yfele</hi>. H*, B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_37-2.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>hæbbe</label><seg type="original" xml:lang="en"><hi rend="italic">hæfð</hi>. H, B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_37-2.attnote.fn.17" n="17" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>ðonne</label><seg type="original" xml:lang="en"><hi rend="italic">ðonnon</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_37-2.attnote.fn.18" n="18" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>onfo</label><seg type="original" xml:lang="en"><hi rend="italic">underfo</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_37-2.attnote.fn.19" n="19" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>þam</label><seg type="original" xml:lang="en">So.</seg></note>
      </div>
