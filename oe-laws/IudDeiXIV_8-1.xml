      <div type="clause" n="8.1">
        <head><ref type="lawCode" target="law:IudDeiXIV">Iud Dei XIV</ref> 8.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIV 8.1" corresp="#wit-lat"><pb n="426" ed="#liebermann"/>ut, qui contra pręceptum tuum et aduersus instituta legalia, euangelica et<ptr type="liebermannNote" n="43" target="#IudDeiXIV_8-1.lnote.oe.43"/> apostolica furtum perpetrare non metuerunt<ptr type="liebermannNote" n="44" target="#IudDeiXIV_8-1.lnote.oe.44"/>, uirtutem tuam in hanc<ptr type="liebermannNote" n="45" target="#IudDeiXIV_8-1.lnote.oe.45"/> creaturam panis et casei sentiant aduenisse;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 426 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8-1.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8-1.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Vt Mg Ma;</hi> -uunt <hi rend="italic">Tr Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Vt Mg Ma; -uunt Tr Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8-1.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de">hac creatura <hi rend="italic">Bb</hi></seg><seg type="translation" xml:lang="en" source="#claude">hac creatura Bb</seg></note>
      </div>
