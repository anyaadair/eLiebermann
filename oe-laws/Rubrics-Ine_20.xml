    <body>
      <div type="clause" n="20">
        <head>Ine Rb 20</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="20" corresp="#wit-e"><pb n="20" ed="#liebermann"/>LXIIII. Be feorran cumenu<hi rend="italic">m</hi> men butan<ptr type="liebermannNote" n="18" target="#Rubrics-Ine_20.lnote.oe.18"/> wege gemetton.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="20" corresp="#wit-g-prol"><pb n="20" ed="#liebermann"/>LXIIII. Be feorran cumenu<hi rend="italic">m</hi> men butan wege gemettan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="20" corresp="#wit-h"><pb n="21" ed="#liebermann"/>LXIIII. Be feorran cumenan<ptr type="liebermannNote" n="15" target="#Rubrics-Ine_20.lnote.oe.15"/> men buton<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_20.lnote.oe.2"/> wege gemettu<hi rend="italic">m</hi>.<ptr type="liebermannNote" n="16" target="#Rubrics-Ine_20.lnote.oe.16"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="20" corresp="#wit-q"><pb n="21" ed="#liebermann"/>De peregrino<ptr type="liebermannNote" n="25" target="#Rubrics-Ine_20.lnote.oe.25"/> in deuiis occiso.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="204" ed="#jurasinski-and-oliver"/>LXIIII Be feorran cumenu<hi rend="italic">m</hi> men butan wege gemetton</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="204" ed="#jurasinski-and-oliver"/>Be feorran cumenan me<hi rend="italic">n</hi></ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="21" ed="#liebermann"/>Vom fernher gekommenen<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_20.lnote.de.1"/>, ausserhalb des Weges betroffenen Manne.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of a man come from afar, found off the road.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="205" ed="#jurasinski-and-oliver"/>Concerning meeting a man come from far away off the road</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="205" ed="#jurasinski-and-oliver"/>Concerning a man come from far away</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_20.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">20</biblScope></bibl><seg type="original" xml:lang="de">b. w. g. <hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">b. w. g. lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_20.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">ignoto in nemore doviante <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">ignoto in nemore doviante Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_20.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">u <hi rend="italic">und</hi> an <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">u and an on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_20.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_20.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. aus</hi> mettum, tū <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">altered from mettum, tū on an erasure</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_20.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Q ergänzt aus seinem Text die Rubrik</seg><seg type="translation" xml:lang="en" source="#claude">Q supplies the rubric from its own text</seg></note>
      </div>
