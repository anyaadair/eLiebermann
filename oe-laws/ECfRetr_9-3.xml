  <text>
    <body>
      <div type="clause" n="9.3">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 9.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 9.3"><pb n="633" ed="#liebermann"/>Si <hi rend="bold">qui</hi> barones iudicia<ptr type="liebermannNote" n="35" target="#ECfRetr_9-3.lnote.la.35"/> non habent, in hundredo ubi<ptr type="liebermannNote" n="36" target="#ECfRetr_9-3.lnote.la.36"/> placitum habitum<ptr type="liebermannNote" n="37" target="#ECfRetr_9-3.lnote.la.37"/> fuerit, ad propinquiorem ecclesiam, ubi iudicium regis<ptr type="liebermannNote" n="38" target="#ECfRetr_9-3.lnote.la.38"/> erit, determinandum est<ptr type="liebermannNote" n="4" target="#ECfRetr_9-3.lnote.la.4"/>, saluo <hi rend="bold">iure</hi> baronum<ptr type="liebermannNote" n="39" target="#ECfRetr_9-3.lnote.la.39"/> illorum.</ab>
        <note type="comparison" source="#liebermann" n="633"><label>printed alongside</label> <ref target="clause:ECf_9-3">ECf 9.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 633 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9-3.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">iusticiam <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">iusticiam K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9-3.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">nisi <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">nisi Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9-3.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">f. h. <hi rend="italic">Hv Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. h. Hv Dc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9-3.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">est uel <hi rend="italic">fügt zu Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">Dc adds est uel</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9-3.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_9-3.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">il. b. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">il. b. Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">If any barons do not have ordeals, in the hundred where the plea has been held, it is to be determined at the nearest church where the king's ordeal shall be, saving the right of those barons.</ab>
      </div>
    </body>
