    <body>
      <div type="clause" n="55.3a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 55.3a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 55.3a" corresp="#wit-lat"><pb n="575" ed="#liebermann"/>Furtum uero et prodici[o<ptr type="liebermannNote" n="14" target="#Hn_55-3a.lnote.oe.14"/>] et murdrum<ptr type="liebermannNote" n="15" target="#Hn_55-3a.lnote.oe.15"/> et que<ptr type="liebermannNote" n="16" target="#Hn_55-3a.lnote.oe.16"/> contra Deum<ptr type="liebermannNote" n="17" target="#Hn_55-3a.lnote.oe.17"/> sunt et fidem catholicam, nulli precipienda uel peragenda sunt.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 575 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-3a.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">-onem <hi rend="italic">Hss.;</hi> perdicionem <hi rend="italic">Lond; gebessert Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">-onem MSS; perdicionem Lond; emended by Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-3a.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">murdrorum <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">murdrorum Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-3a.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-3a.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">dominum <hi rend="italic">Sc Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">dominum Sc edd.</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">But theft and treachery and <hi rend="italic">murdrum</hi> and things which are against God and the catholic faith are to be commanded to no one, nor carried out for anyone.</ab>
      </div>
