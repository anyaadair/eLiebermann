  <text>
    <body>
      <div type="clause" n="18[b]">
        <head><ref type="lawCode" target="law:Wi">Wi</ref> 18[b]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="18[b]" corresp="#wit-h"><pb n="13" ed="#liebermann"/>Swylce diacon hine clænsie.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-h"><pb n="28" ed="#attenborough"/>Swylce diacon hine clænsie.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="14.1" corresp="#wit-h"><pb n="158" ed="#oliver"/>Swyle diacon hine clænsie.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="13" ed="#liebermann"/>Ebenso reinige sich ein Diakon.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Likewise is a deacon to clear himself.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="29" ed="#attenborough"/>A deacon shall clear himself in a similar way.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h"><pb n="159" ed="#oliver"/>Similarly should a deacon clear himself.</ab>
      </div>
    </body>
