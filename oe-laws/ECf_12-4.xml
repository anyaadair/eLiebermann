    <body>
      <div type="clause" n="12.4">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 12.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 12.4"><pb n="638" ed="#liebermann"/>Manbote in<ptr type="liebermannNote" n="25" target="#ECf_12-4.lnote.la.25"/> Denelaga<ptr type="liebermannNote" n="26" target="#ECf_12-4.lnote.la.26"/> de<ptr type="liebermannNote" n="27" target="#ECf_12-4.lnote.la.27"/> uillano et<ptr type="liebermannNote" n="28" target="#ECf_12-4.lnote.la.28"/> sokeman<ptr type="liebermannNote" n="29" target="#ECf_12-4.lnote.la.29"/> XII oras<ptr type="liebermannNote" n="i" target="#ECf_12-4.lnote.la.fn.i"/><ptr type="liebermannNote" n="30" target="#ECf_12-4.lnote.la.30"/>, de liberis<ptr type="liebermannNote" n="k" target="#ECf_12-4.lnote.la.fn.k"/> hominibus III<ptr type="liebermannNote" n="l" target="#ECf_12-4.lnote.la.fn.l"/> marcas.</ab>
        <note type="comparison" source="#liebermann" n="638"><label>printed alongside</label> <ref target="clause:ECfRetr_12-4">ECf retr 12.4</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 638 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “uillano” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-4.lnote.la.fn.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">i. e. uiginti solidos <hi rend="italic">zur Retr. am Rande Co, im Text Or; vgl.</hi> pur le serf XX sol. <hi rend="italic">Leis Wl</hi> 7; <hi rend="italic">Hn</hi> 70, 2; 4</seg><seg type="translation" xml:lang="en" source="#claude">i. e. uiginti solidos, to the Retr., in the margin Co, in the text Or; cf. pur le serf XX sol., Leis Wl 7; Hn 70, 2; 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-4.lnote.la.fn.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vollfrei</hi></seg><seg type="translation" xml:lang="en" source="#claude">fully free</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-4.lnote.la.fn.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">XL sol. [<hi rend="italic">gleichbedeutend; auch</hi> 12, 5; <hi rend="italic">vgl. S.</hi> 634<hi rend="italic">b</hi>] <hi rend="italic">Ad Do No</hi></seg><seg type="translation" xml:lang="en" source="#claude">XL sol. [meaning the same; also 12, 5; cf. p. 634, note b] Ad Do No</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-4.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">lege Anglorum regi et <hi rend="italic">fügt ein</hi> [<hi rend="italic">aus folg. Z.</hi>], <hi rend="italic">aber unterstreicht Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">Rl inserts lege Anglorum regi et [from the next line], but underlines it</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-4.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">-gha <hi rend="italic">Rl;</hi> Dan. <hi rend="italic">S Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gha Rl; Dan. S Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-4.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">dee <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">dee Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-4.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">e de <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">e de Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-4.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Ad;</hi> sochaman <hi rend="italic">Rl;</hi> socheman <hi rend="italic">Hk;</hi> sochesm. <hi rend="italic">S;</hi> sochm. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Ad; sochaman Rl; socheman Hk; sochesm. S; sochm. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-4.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">horas <hi rend="italic">Rl S;</hi> ornas <hi rend="italic">Ad;</hi> sol. <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">horas Rl S; ornas Ad; sol. Do</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Manbot in the Danelaw: for a villein and a sokeman twelve oras, for free men three marks.</ab>
      </div>
    </body>
