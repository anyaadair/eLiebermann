    <body>
      <div type="clause" n="19.1">
        <head><ref type="lawCode" target="law:ICn">I Cn</ref> 19.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19.1" corresp="#wit-g-a"><pb n="300" ed="#liebermann"/>⁊ word ⁊ weorc<ptr type="liebermannNote" n="14" target="#ICn_19-1.lnote.oe.14"/> freonda gehwylc fadige mid rihte, ⁊ að ⁊ wedd<ptr type="liebermannNote" n="15" target="#ICn_19-1.lnote.oe.15"/> wærlice healde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19.1" corresp="#wit-b"><pb n="300" ed="#liebermann"/>⁊<ptr type="liebermannNote" n="2" target="#ICn_19-1.lnote.oe.2"/> word a[<hi rend="italic">nd<ptr type="liebermannNote" n="3" target="#ICn_19-1.lnote.oe.3"/></hi>] weorc freonda gehwylc fadige<ptr type="liebermannNote" n="4" target="#ICn_19-1.lnote.oe.4"/> mid rihte, ⁊ að ⁊ wed wærlice healde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19.1" corresp="#wit-a"><pb n="300" ed="#liebermann"/>And word ⁊ weorc freonda gehwylc fadige mid rihte, ⁊ að ⁊ wead<ptr type="liebermannNote" n="2" target="#ICn_19-1.lnote.oe.2-2"/> wearlice healde.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="19.1" corresp="#wit-q"><pb n="301" ed="#liebermann"/>Et quisquis amicus Dei est, uerbis et<ptr type="liebermannNote" n="6" target="#ICn_19-1.lnote.oe.6"/> operibus rectitudinem flagitet, fidem et sacramenta caute<ptr type="liebermannNote" n="7" target="#ICn_19-1.lnote.oe.7"/> custodiat.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="19.1" corresp="#wit-cons-cn"><pb n="301" ed="#liebermann"/>Et uerba et opera omnis amicus moderetur recte, iusiurandum et manufirmacionem caute obseruet,</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="19.1" corresp="#wit-b"><pb n="170" ed="#robertson"/>⁊ word ⁊<ptr type="editorNote" n="1" target="#ICn_19-1.robnote.fn.1"/> weorc freonda gehwylc fadige mid rihte ⁊ að ⁊ wed wærlice healde.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="248" ed="#rabin-doml"/>And word and weorc freonda gehwylc fadige mid rihte, and að and wedd wærlice healde.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="301" ed="#liebermann"/>Und ordne der Freunde<ptr type="liebermannNote" n="1" target="#ICn_19-1.lnote.de.1"/> jeglicher Wort und Werk gerecht und halte sorgsam Eid und Versprechen.<ptr type="liebermannNote" n="2" target="#ICn_19-1.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let each of [our] friends order word and work rightly and carefully keep oath and pledge.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#ICn_19-1.robnote.n.1"/><pb n="171" ed="#robertson"/>And everyone of our friends<ptr type="editorNote" n="2" target="#ICn_19-1.robnote.n.2"/> shall order his words and deeds aright, and strictly abide by his oath and pledge.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="249" ed="#rabin-doml"/>And all of our friends must order their words and deeds properly, and carefully uphold their oath and pledge.</ab>
        <note type="comparison" source="#liebermann" n="301"><ref target="clause:VIAtr_28">VI Atr 28</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 28</note>
        <note type="comparison" source="#wormald-mel" n="357"><label>source (roman)</label> <ref target="clause:Af_1">Af 1</ref> <quote>Table 5.4, I Cn 19:1-2: Cn 1018 18-19  VI Atr 28-28:1  Af 1</quote></note>
        <note type="comparison" source="#wormald-mel" n="357"><label>quoted verbatim (bold in Wormald's table)</label> <ref target="clause:VIAtr_28">VI Atr 28–28.1</ref> <quote>Table 5.4, I Cn 19:1-2: Cn 1018 18-19  VI Atr 28-28:1  Af 1</quote></note>
        <note type="comparison" source="#wormald-mel" n="357"><label>quoted verbatim (bold in Wormald's table)</label> <ref target="clause:Cn-1018_part-053">Cn 1018 18–19</ref> <quote>Table 5.4, I Cn 19:1-2: Cn 1018 18-19  VI Atr 28-28:1  Af 1</quote></note>
        <note type="comparedBy" source="#kennedy" n="59"><label>used in I–II Cnut</label> <ref target="clause:Cn-1018_part-051">Cn 1018 17–18</ref> <quote>Kennedy’s table: VI Æthelred 27–28 | D 17–18 | I Cnut 19, I Cnut 19.1</quote></note>
        <note type="editorial">Liebermann compares VI Atr 28.; Robertson (p. 139) takes I Cn from B, which begins at ‘mæssedæg’ in 14.2, the earlier clauses being supplied from G; BR: added from Gesetze I p. 301, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_19-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">300</biblScope></bibl><seg type="original" xml:lang="de">worc <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">worc Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_19-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">300</biblScope></bibl><seg type="original" xml:lang="de">wed wearl. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wed wearl. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_19-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">301</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_19-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">301</biblScope></bibl><seg type="original" xml:lang="de">cu. ca. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">cu. ca. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_19-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">300</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">roth</hi></seg><seg type="translation" xml:lang="en" source="#claude">in red</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_19-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">300</biblScope></bibl><seg type="original" xml:lang="de">ac <hi rend="italic">spät geänd. in</hi> ⁊</seg><seg type="translation" xml:lang="en" source="#claude">ac late altered to ⁊</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_19-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">300</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert aus</hi> fandige</seg><seg type="translation" xml:lang="en" source="#claude">corrected from fandige</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_19-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">300</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_19-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">201</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Irrig ‘Gottesfreund’ Q vielleicht aus <hi rend="italic">o</hi>. 2, 3. <hi rend="italic">Vgl</hi>. vielmehr <hi rend="italic">Wb: freond</hi> 4. 5; <hi rend="italic">freondscipe</hi> 4</seg><seg type="translation" xml:lang="en" source="#claude">Q’s ‘friend of God’ is mistaken, perhaps taken from <hi rend="italic">above</hi> 2, 3. <hi rend="italic">Cf</hi>. rather <hi rend="italic">Wb: freond</hi> 4. 5; <hi rend="italic">freondscipe</hi> 4</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_19-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">201</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">manufirmatio</hi> Cons steht hier für ‘Versprechen (<hi rend="italic">s. d. Gl</hi> 2a. c) vielleicht durch Handschlag’, nicht, wie später Französisch, für Schenkungsurkunde, bes. von Zinsland; Ducange</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">manufirmatio</hi> in Cons stands here for ‘promise (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 2a. c), perhaps by handshake’, not, as later in French, for a deed of gift, esp. of rent-paying land; Ducange</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="ICn_19-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">350</biblScope></bibl><seg type="original" xml:lang="en">Cf. VI Atr. 28.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="ICn_19-1.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">350</biblScope></bibl><seg type="original" xml:lang="en">Cf. VI Atr. 6 etc.; VIII, 44, 1. Q reads <hi rend="italic">quisquis amicus Dei</hi>.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="ICn_19-1.robnote.fn.1" n="1" source="#robertson"><bibl><biblScope unit="page">170</biblScope></bibl><label>⁊</label><seg type="original" xml:lang="en"><hi rend="italic">ac</hi> later changed to ⁊ B.</seg></note>
      </div>
