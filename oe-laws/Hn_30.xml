      <div type="clause" n="30">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 30</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 30" corresp="#wit-lat"><ptr type="liebermannNote" n="41" target="#Hn_30.lnote.oe.41"/><pb n="563" ed="#liebermann"/>De libertate procerum<ptr type="liebermannNote" n="28" target="#Hn_30.lnote.oe.28"/> in<ptr type="liebermannNote" n="42" target="#Hn_30.lnote.oe.42"/> placitis<ptr type="liebermannNote" n="43" target="#Hn_30.lnote.oe.43"/> comitatus. Si<ptr type="liebermannNote" n="t" target="#Hn_30.lnote.oe.t"/> quis baro<ptr type="liebermannNote" n="44" target="#Hn_30.lnote.oe.44"/> comitatus<ptr type="liebermannNote" n="12" target="#Hn_30.lnote.oe.12"/> contra uicecomitem placitet, potest retinere suos homines a iudicio, tum<ptr type="liebermannNote" n="45" target="#Hn_30.lnote.oe.45"/> maxime si<ptr type="liebermannNote" n="46" target="#Hn_30.lnote.oe.46"/> tantum<ptr type="liebermannNote" n="47" target="#Hn_30.lnote.oe.47"/> de eo teneant: nisi de furto uel<ptr type="liebermannNote" n="48" target="#Hn_30.lnote.oe.48"/> de illis sit, que<ptr type="liebermannNote" n="49" target="#Hn_30.lnote.oe.49"/> simul abiurauimus<ptr type="liebermannNote" n="u" target="#Hn_30.lnote.oe.u"/><ptr type="liebermannNote" n="50" target="#Hn_30.lnote.oe.50"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 563 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_30.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">anders ausgedrückt</hi> 32, 2</seg><seg type="translation" xml:lang="en" source="#claude">expressed differently 32, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_30.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Spur des Unterthaneneides, der auch später zurückging auf II Cn.</hi> 21</seg><seg type="translation" xml:lang="en" source="#claude">Trace of the oath of allegiance, which later too went back to II Cn. 21</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_30.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">comm. <hi rend="italic">Co meist</hi></seg><seg type="translation" xml:lang="en" source="#claude">comm. Co mostly</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_30.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_30.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">C. XXXI <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">C. XXXI Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_30.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">comitum <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">comitum Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_30.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">-to comitatuum (comm. <hi rend="italic">roth</hi>) <hi rend="italic">schwarz und roth Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-to comitatuum (comm. in red) in black and red Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_30.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">-ronum <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ronum K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_30.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. vom Corr. aus</hi> tamen <hi rend="italic">Sc; fehlt Hg Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the corrector from tamen Sc; missing in Hg Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_30.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">tamen si de, <hi rend="italic">vom Corr. umgestellt</hi> si t. de <hi rend="italic">Sc;</hi> de eo t. <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">tamen si de, transposed by the corrector to si t. de Sc; de eo t. Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_30.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_30.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_30.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">qui <hi rend="italic">Sc;</hi> sit <hi rend="italic">fügt zu Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui Sc; sit added Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_30.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. vom Corr. aus</hi> adiu. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the corrector from adiu. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_30.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Vassallitat 16; Kapitalverbrechen 9; Urteilfinder 10. Der Satz ist nicht (wie Hatschek <hi rend="italic">Engl. Verfg</hi>. 70 will) auf das Grafschaftsgericht allein zu beziehen, sondern gilt allgemein laut 32, 2.—<hi rend="italic">baronum</hi>{44}—<hi rend="italic">tum</hi>{45} fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Vassallitat 16; Kapitalverbrechen 9; Urteilfinder 10. The sentence is not to be referred to the shire court alone (as Hatschek <hi rend="italic">Engl. Verfg</hi>. 70 would have it), but applies generally, according to 32, 2. — <hi rend="italic">baronum</hi>{44} — <hi rend="italic">tum</hi>{45} missing Rs</seg></note>
      </div>
    </body>
