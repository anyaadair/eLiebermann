      <div type="clause" n="47">
        <head>Ine Rb 47</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47" corresp="#wit-e"><pb n="24" ed="#liebermann"/>XCI. Be<ptr type="liebermannNote" n="**" target="#Rubrics-Ine_47.lnote.oe.star2"/> ðon þe mon forstolenne ceap befehð.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47" corresp="#wit-g-prol"><pb n="24" ed="#liebermann"/>XCI. Be ðon þe man forstolenne ceap befehþ.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47" corresp="#wit-h"><pb n="25" ed="#liebermann"/>XCI. Be þon<ptr type="liebermannNote" n="3" target="#Rubrics-Ine_47.lnote.oe.3"/> ðe mon<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_47.lnote.oe.2"/> forstolenne ceap<ptr type="liebermannNote" n="4" target="#Rubrics-Ine_47.lnote.oe.4"/> befehþ.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="47" corresp="#wit-q"><pb n="25" ed="#liebermann"/>De<ptr type="liebermannNote" n="12" target="#Rubrics-Ine_47.lnote.oe.12"/> intertiare.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="210" ed="#jurasinski-and-oliver"/>XCI Be ðon þe mon forstolenne ceap befehð</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="25" ed="#liebermann"/>Darüber, dass man gestohlene Fahrhabe [im Anefang] fasst.<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_47.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning someone seizing stolen goods [by attachment].</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="211" ed="#jurasinski-and-oliver"/>Concerning the finding of stolen livestock</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_47.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">24</biblScope></bibl><seg type="original" xml:lang="de">Be forstolene ceap befangene <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Be forstolene ceap befangene Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_47.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">Non debet advocari ad servum, si furtivum intercietur <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Non debet advocari ad servum, si furtivum intercietur Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_47.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> þam</seg><seg type="translation" xml:lang="en" source="#claude">altered þam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_47.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_47.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">b. c., <hi rend="italic">aber durch Zeichen richtig gestellt</hi></seg><seg type="translation" xml:lang="en" source="#claude">b. c., but set right by marks</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_47.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Q spät. Rez. vervollständigt die Rb aus seinem Text</seg><seg type="translation" xml:lang="en" source="#claude">The later recension of Q completes the Rb from its own text</seg><note type="remark" resp="#claude">On several rubrics: Ine Rb 40. 43f. 46—50. 54. 56f. 58. 61f. 67. 70f.</note></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_47.lnote.de.0" n="0" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘Von im Anefang ertappten gestohlenem Werte’ Ld</seg><seg type="translation" xml:lang="en" source="#claude">‘Of stolen property caught in Anefang’ Ld</seg></note>
      </div>
