        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">42</biblScope></bibl><seg type="original" xml:lang="de">-le <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-le Ld</seg></note>
