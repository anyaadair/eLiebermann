        <head><ref type="lawCode" target="law:Hn">Hn</ref> 82.2c</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 82.2c" corresp="#wit-lat"><pb n="598" ed="#liebermann"/>Et si etiam is<ptr type="liebermannNote" n="42" target="#Hn_82-2c.lnote.oe.42"/> in cuius terra fuerit inuentus rectum per omnia difforciabit, non tamen in eos inconsulte quid agatur, set in manu<ptr type="liebermannNote" n="u" target="#Hn_82-2c.lnote.oe.u"/> ipsius<ptr type="liebermannNote" n="43" target="#Hn_82-2c.lnote.oe.43"/> crauetur<ptr type="liebermannNote" n="44" target="#Hn_82-2c.lnote.oe.44"/> et principi<ptr type="liebermannNote" n="v" target="#Hn_82-2c.lnote.oe.v"/> uel<ptr type="liebermannNote" n="45" target="#Hn_82-2c.lnote.oe.45"/> ministro suo demonstretur<ptr type="liebermannNote" n="46" target="#Hn_82-2c.lnote.oe.46"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 598 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2c.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">gegen die eigene Person</seg><seg type="translation" xml:lang="en" source="#claude">against his own person</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2c.lnote.oe.v" n="v" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 83, 2; <hi rend="italic">vgl.</hi> 82, 1</seg><seg type="translation" xml:lang="en" source="#claude">as 83, 2; cf. 82, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2c.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">hiis <hi rend="italic">Hss.</hi>, hi <hi rend="italic">unterpunctirt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">hiis MSS, hi marked for deletion by dots beneath Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2c.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2c.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">curu. <hi rend="italic">Sc Hg</hi>; grau. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">curu. Sc Hg; grau. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2c.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Co Or</seg></note>
