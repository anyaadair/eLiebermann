      <div type="clause" n="12c">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 12c</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 12c"><pb n="638" ed="#liebermann"/>alia quam habent quatuor chimini<ptr type="liebermannNote" n="1" target="#ECfRetr_12c.lnote.la.1"/>, <hi rend="bold">scilicet</hi><ptr type="liebermannNote" n="2" target="#ECfRetr_12c.lnote.la.2"/> Ƿatlingestret<ptr type="liebermannNote" n="3" target="#ECfRetr_12c.lnote.la.3"/>, Fosse, Ikenildestret<ptr type="liebermannNote" n="4" target="#ECfRetr_12c.lnote.la.4"/>, Ermingestret<ptr type="liebermannNote" n="5" target="#ECfRetr_12c.lnote.la.5"/>, quorum<ptr type="liebermannNote" n="6" target="#ECfRetr_12c.lnote.la.6"/> duo<ptr type="liebermannNote" n="7" target="#ECfRetr_12c.lnote.la.7"/> in longitudine<ptr type="liebermannNote" n="8" target="#ECfRetr_12c.lnote.la.8"/> regni, alii uero<ptr type="liebermannNote" n="9" target="#ECfRetr_12c.lnote.la.9"/> in latitudine<ptr type="liebermannNote" n="10" target="#ECfRetr_12c.lnote.la.10"/> distenduntur;</ab>
        <note type="comparison" source="#liebermann" n="638"><label>printed alongside</label> <ref target="clause:ECf_12c">ECf 12c</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 638 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12c.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Cb Hv K</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Cb Hv K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12c.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Lb Va K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Lb Va K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12c.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">Wathl. <hi rend="italic">Hv;</hi> Wadeges. <hi rend="italic">K;</hi> Wal. <hi rend="italic">Va;</hi> -strete <hi rend="italic">stets alle ausser Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">Wathl. Hv; Wadeges. K; Wal. Va; -strete always, all except Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12c.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">Hunil. <hi rend="italic">Hv;</hi> hic hundes. <hi rend="italic">K;</hi> Hiche. <hi rend="italic">Lb Ph;</hi> Hi. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hunil. Hv; hic hundes. K; Hiche. Lb Ph; Hi. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12c.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">Ernyng. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ernyng. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12c.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">uero <hi rend="italic">fügt zu Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ph adds uero</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12c.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. aus</hi> uero <hi rend="italic">Cb;</hi> uero <hi rend="italic">Hv;</hi> uero duo <hi rend="italic">Lb Va K Sp Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected from uero Cb; uero Hv; uero duo Lb Va K Sp Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12c.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">-nem <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nem Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12c.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv; geändert in</hi> duo <hi rend="italic">Cb;</hi> duo <hi rend="italic">Lb Va Ph K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv; altered to duo Cb; duo Lb Va Ph K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12c.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">-nem protend. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nem protend. Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">another, which the four highways have, namely Watling Street (Ƿatlingestret), the Fosse, Icknield Street (Ikenildestret), Ermine Street (Ermingestret), of which two extend along the length of the kingdom, but the others across its breadth;</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12c.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">345</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">duo</hi><hi rend="superscript">9</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">duo</hi><hi rend="superscript">9</hi> Rs</seg></note>
      </div>
    </body>
  </text>
