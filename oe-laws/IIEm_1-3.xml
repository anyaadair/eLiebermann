      <div type="clause" n="1.3">
        <head><ref type="lawCode" target="law:IIEm">II Em</ref> 1.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.3" corresp="#wit-h"><pb n="188" ed="#liebermann"/>Gif þonne of ðære oðre mægðe hwa wrace dó on ænigum oðru<hi rend="italic">m</hi> men butan on ðam rihthanddædan, sy he gefah wið þone cyning ⁊ wið ealle his frind ⁊ ðolige ealles ðæs he age.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.3" corresp="#wit-b"><pb n="188" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="2" target="#IIEm_1-3.lnote.oe.2"/> ðonne<ptr type="liebermannNote" n="3" target="#IIEm_1-3.lnote.oe.3"/> of ðære mægðe hwa wrace do on ænigum oðru<hi rend="italic">m</hi> men butan on ðam<ptr type="liebermannNote" n="4" target="#IIEm_1-3.lnote.oe.4"/> rihthanddædan, sy he gefah wið ðone cyning ⁊ wið ealle his frynd<ptr type="liebermannNote" n="5" target="#IIEm_1-3.lnote.oe.5"/> ⁊ ðolie ealles<ptr type="liebermannNote" n="6" target="#IIEm_1-3.lnote.oe.6"/> ðæs<ptr type="liebermannNote" n="7" target="#IIEm_1-3.lnote.oe.7"/> he age.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.3" corresp="#wit-q"><pb n="189" ed="#liebermann"/>Si ex mortui<ptr type="liebermannNote" n="4" target="#IIEm_1-3.lnote.oe.4-2"/> cognatione quis uindictam perpetret<ptr type="liebermannNote" n="5" target="#IIEm_1-3.lnote.oe.5-2"/> in alium aliquem preter ipsum malefactorem, sit inimicus regis et<ptr type="liebermannNote" n="6" target="#IIEm_1-3.lnote.oe.6-2"/> omnium amicorum eius et perdat<ptr type="liebermannNote" n="7" target="#IIEm_1-3.lnote.oe.7-2"/> totum quicquid habet.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="1.3" corresp="#wit-b"><pb n="8" ed="#robertson"/>Gyf ðonne<ptr type="editorNote" n="7" target="#IIEm_1-3.robnote.fn.7"/> of ðære [oðre]<ptr type="editorNote" n="8" target="#IIEm_1-3.robnote.fn.8"/> mægðe hwa wrace do on ænigum oðrum men butan on ðam rihthanddædan, sy he gefah wið ðone cyning ⁊ wið ealle his frynd ⁊ ðolie ealles ðæs he age.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="189" ed="#liebermann"/>Wenn jedoch einer von der anderen Sippe [des Erschlagenen] Rache übt an irgend einem anderen Menschen als an dem richtigen Thäter, so sei er friedlos<ptr type="liebermannNote" n="1" target="#IIEm_1-3.lnote.de.1"/> gegenüber dem König und allen dessen Freunden und verliere [an diesen] alles, was er besitzt.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If, however, anyone of the other kindred [that of the slain man] takes vengeance on any other person than the actual perpetrator, let him be at feud with the king and all his friends and lose [to them] everything he owns.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="9" ed="#robertson"/>If, however, anyone from the other kindred take vengeance on any man other than the actual delinquent, he shall incur the hostility of the king and of all his friends<ptr type="editorNote" n="1" target="#IIEm_1-3.robnote.n.1"/>, and shall suffer the loss of all that he possesses.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="430" ed="#whitelock"/>If, however, anyone of the other kindred takes vengeance on any man other than the actual slayer, he is to incur the hostility of the king and all his friends, and to forfeit all that he owns.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IIEm_2">II Em 2</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-3.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">188</biblScope></bibl><seg type="original" xml:lang="de">Gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-3.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">188</biblScope></bibl><seg type="original" xml:lang="de">hwa ð. on ðær mægþ wræce dô <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hwa ð. on ðær mægþ wræce dô Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">188</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-3.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">188</biblScope></bibl><seg type="original" xml:lang="de">-de <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-de Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-3.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">188</biblScope></bibl><seg type="original" xml:lang="de">ealle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ealle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-3.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">188</biblScope></bibl><seg type="original" xml:lang="de">ðe <hi rend="italic">fügt zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðe added by Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-3.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">189</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">alia</hi> <hi rend="italic">Hn</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">alia</hi> Hn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-3.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">189</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">faciat</hi> <hi rend="italic">Hn</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">faciat</hi> Hn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-3.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">189</biblScope></bibl><seg type="original" xml:lang="de">et o. a. e. <hi rend="italic">fehlt MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">et o. a. e. lacking in MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-3.lnote.oe.7-2" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">189</biblScope></bibl><seg type="original" xml:lang="de">perda <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">perda Hk</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEm_1-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">127</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Blutrache 9</seg><seg type="translation" xml:lang="en" source="#claude">See <hi rend="italic">Gl</hi> Blutrache 9</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIEm_1-3.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">296</biblScope></bibl><seg type="original" xml:lang="en">Cf. II As. 20, 7; <hi rend="italic">fah wið god</hi>, Beo. l. 811; and see for further references Brunner, <hi rend="smallcaps">i</hi>.² p. 232.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIEm_1-3.robnote.fn.7" n="7" source="#robertson"><bibl><biblScope unit="page">8</biblScope></bibl><label>ðonne</label><seg type="original" xml:lang="en"><hi rend="italic">hwa ðonne on ðær mægþ wræce dô</hi> Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIEm_1-3.robnote.fn.8" n="8" source="#robertson"><bibl><biblScope unit="page">8</biblScope></bibl><label>oðre</label><seg type="original" xml:lang="en">H.</seg></note>
      </div>
