      <div type="clause" n="13.1 A">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 13.1 A</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 13.1 A"><pb n="640" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_13-1-A.lnote.oe.erkl-clause"/><ptr type="liebermannNote" n="1" target="#ECf_13-1-A.lnote.la.1"/><hi rend="spaced">De regibus Norwicorum et Danorum post mortem Aluredi regis.</hi> Iste uero Knutus<ptr type="liebermannNote" n="2" target="#ECf_13-1-A.lnote.la.2"/>, prefatus rex, et Swennus<ptr type="liebermannNote" n="f" target="#ECf_13-1-A.lnote.la.fn.f"/><ptr type="liebermannNote" n="3" target="#ECf_13-1-A.lnote.la.3"/> rex Danorum, pater suus<ptr type="liebermannNote" n="4" target="#ECf_13-1-A.lnote.la.4"/>, et Lachman<ptr type="liebermannNote" n="5" target="#ECf_13-1-A.lnote.la.5"/> rex Sueuorum et Olauus rex Norwegie<ptr type="liebermannNote" n="6" target="#ECf_13-1-A.lnote.la.6"/> et Haraldus<ptr type="liebermannNote" n="g" target="#ECf_13-1-A.lnote.la.fn.g"/> Harefote<ptr type="liebermannNote" n="7" target="#ECf_13-1-A.lnote.la.7"/> rex Danorum, filius Chnuti predicti et Elwyne<ptr type="liebermannNote" n="h" target="#ECf_13-1-A.lnote.la.fn.h"/>, et Hardechnutus rex Danorum, frater suus, filius Knuti<ptr type="liebermannNote" n="8" target="#ECf_13-1-A.lnote.la.8"/> predicti et Emme<ptr type="liebermannNote" n="g" target="#ECf_13-1-A.lnote.la.fn.g"/>, sororis Roberti Normannorum ducis et matris ultimi<ptr type="liebermannNote" n="i" target="#ECf_13-1-A.lnote.la.fn.i"/> Edwardi<ptr type="liebermannNote" n="g" target="#ECf_13-1-A.lnote.la.fn.g"/>, multa<ptr type="liebermannNote" n="k" target="#ECf_13-1-A.lnote.la.fn.k"/> iura et dignitates et terras et insulas a corona regni huius alienauerunt et dilapidauerunt<ptr type="liebermannNote" n="l" target="#ECf_13-1-A.lnote.la.fn.l"/> et Dacis suis et Norwigensibus<ptr type="liebermannNote" n="9" target="#ECf_13-1-A.lnote.la.9"/> suis<ptr type="liebermannNote" n="10" target="#ECf_13-1-A.lnote.la.10"/> illas dederunt, qui regnum illud<ptr type="liebermannNote" n="10" target="#ECf_13-1-A.lnote.la.10"/> infestantes destruxerunt.</ab>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 640 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">This passage is not part of ECf or ECf retr: it is one of the additions of the London collection (Leges Anglorum s. XIII in. Londoniis collectae), which Liebermann prints in smaller type across the page, under ECf retr. 13, 1, and numbers 13, 1 A ff. The dictionary cites it as “ECf 13, 1 A …”, so it is kept with ECf here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">Sw.—Olau. rex No. <hi rend="italic">aus</hi> Geneal. Norm. 4, <hi rend="italic">ed. Liebermann</hi> Über ECf. <hi rend="italic">p.</hi> 135</seg><seg type="translation" xml:lang="en" source="#claude">Sw.—Olau. rex No. from Geneal. Norm. 4, ed. Liebermann, Über ECf. p. 135</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus</hi> ECf. 34, 2<hi rend="italic">d; e</hi></seg><seg type="translation" xml:lang="en" source="#claude">from ECf. 34, 2, notes d; e</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">Elwine, <hi rend="italic">al.</hi> Elfgiue <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Elwine, al. Elfgiue Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.la.fn.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">den Bekenner nennen</hi> ultimus Edwardus <hi rend="italic">nochmals</hi> Leges Angl. <hi rend="italic">S.</hi> 69: <hi rend="italic">sicher bevor</hi> 1239 <hi rend="italic">wiederum ein Thronerbe so hiess</hi></seg><seg type="translation" xml:lang="en" source="#claude">Leges Angl. p. 69 again calls the Confessor ultimus Edwardus: certainly before 1239, when an heir to the throne was again so named</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.la.fn.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ähnlich</hi> 11, 1 A 2 <hi rend="italic">f.;</hi> 6</seg><seg type="translation" xml:lang="en" source="#claude">similarly 11, 1 A 2 f.; 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.la.fn.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ähnliches fabeln</hi> Leges Angl. <hi rend="italic">S.</hi> 24 <hi rend="italic">ff.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Leges Angl. p. 24 ff. tell similar fables</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hinter c.</hi> 16 [<hi rend="italic">richtiger, weil</hi> prefatus Cnut <hi rend="italic">auf</hi> 16 <hi rend="italic">Bezug nimmt</hi>], <hi rend="italic">ohne Überschrift Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">after c. 16 [more correctly, since prefatus Cnut refers to 16], without heading Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">Chn. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Chn. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">Sueinus <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Sueinus Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Ld;</hi> La.—et Ol. r. N. <hi rend="italic">fehlt Ce;</hi> Lachmam r. Swedno. <hi rend="italic">Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Ld; La.—et Ol. r. N. lacking in Ce; Lachmam r. Swedno. MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Ld;</hi> -wece <hi rend="italic">K;</hi> -wete <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Ld; -wece K; -wete Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">Herewot <hi rend="italic">K Co;</hi> Hereskot <hi rend="italic">Or;</hi> Harol. Harefote <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Herewot K Co; Hereskot Or; Harol. Harefote Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">Chn. <hi rend="italic">Co Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Chn. Co Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">-wegiens. <hi rend="italic">Ld;</hi> -wyg. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-wegiens. Ld; -wyg. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Of the kings of the Norwegians and of the Danes after the death of King Alfred. But this Cnut, the aforesaid king, and Swein king of the Danes, his father, and Lachman king of the Swedes [?] (<hi rend="italic">Sueuorum</hi>), and Olaf king of Norway, and Harold Harefoot king of the Danes, son of the aforesaid Cnut and of Ælfgifu (<hi rend="italic">Elwyne</hi>), and Harthacnut king of the Danes, his brother, son of the aforesaid Cnut and of Emma, sister of Robert duke of the Normans and mother of the last Edward, alienated and squandered many rights and dignities and lands and islands from the crown of this kingdom and gave them to their Danes and their Norwegians, who, harrying that kingdom, destroyed it.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1-A.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">345</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Cnut 10c; Dänen 2. 8. 17a — <hi rend="superscript">1</hi><hi rend="italic">De r. Noric. et D. p. m. Aldr.</hi> [besser: Æthelreds II.] <hi rend="italic">r. in Britannia. Iste v. Cn.</hi><hi rend="superscript">2</hi> <hi rend="italic">p. r. Danorum et S.</hi> — <hi rend="italic">Lachiman</hi><hi rend="superscript">5</hi> <hi rend="italic">r. Sweden. et O. r. Norweie et H. Herewcot</hi> — <hi rend="italic">Cn.</hi> — <hi rend="italic">Hardecn.</hi> — <hi rend="italic">Cn.</hi><hi rend="superscript">6</hi> — <hi rend="italic">matris regis u</hi><hi rend="superscript">i</hi>. [<hi rend="italic">ultimi</hi> ECf retr 34, 2e; nach der Geschichtsdarstellung des Londoners war Ine gefolgt auf den letzten Walliser Träger der Britischen Krone; Lond ECf 32 C 3] <hi rend="italic">Ead.</hi> — <hi rend="italic">r. istud</hi><hi rend="superscript">10</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">Cf. Gl Cnut 10c; Dänen 2. 8. 17a — <hi rend="superscript">1</hi><hi rend="italic">De r. Noric. et D. p. m. Aldr.</hi> [better: Æthelred II’s] <hi rend="italic">r. in Britannia. Iste v. Cn.</hi><hi rend="superscript">2</hi> <hi rend="italic">p. r. Danorum et S.</hi> — <hi rend="italic">Lachiman</hi><hi rend="superscript">5</hi> <hi rend="italic">r. Sweden. et O. r. Norweie et H. Herewcot</hi> — <hi rend="italic">Cn.</hi> — <hi rend="italic">Hardecn.</hi> — <hi rend="italic">Cn.</hi><hi rend="superscript">6</hi> — <hi rend="italic">matris regis u</hi><hi rend="superscript">i</hi>. [<hi rend="italic">ultimi</hi> ECf retr 34, 2e; according to the London compiler’s account of history Ine had followed the last Welsh bearer of the British crown; Lond ECf 32 C 3] <hi rend="italic">Ead.</hi> — <hi rend="italic">r. istud</hi><hi rend="superscript">10</hi> Rs</seg></note>
      </div>
