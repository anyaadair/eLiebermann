        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.13" corresp="#wit-lat"><pb n="549" ed="#liebermann"/>Pulsatus<ptr type="liebermannNote" n="y" target="#Hn_5-13.lnote.oe.y"/> ante suum iudicem, si uoluerit, causam (suam<ptr type="liebermannNote" n="30" target="#Hn_5-13.lnote.oe.30"/>) dicat; et non ante suum iudicem pulsatus, si uoluerit, taceat.</ab>
