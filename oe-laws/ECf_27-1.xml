    <body>
      <div type="clause" n="27.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 27.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 27.1"><pb n="651" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_27-1.lnote.oe.erkl-clause"/>— uerbi gratia in<ptr type="liebermannNote" n="c" target="#ECf_27-1.lnote.la.fn.c"/> Denelaga<ptr type="liebermannNote" n="10" target="#ECf_27-1.lnote.la.10"/> per X<ptr type="liebermannNote" n="11" target="#ECf_27-1.lnote.la.11"/> et octo ‘hundreda’, qui numerus<ptr type="liebermannNote" n="d" target="#ECf_27-1.lnote.la.fn.d"/> complet septies XX<ptr type="liebermannNote" n="e" target="#ECf_27-1.lnote.la.fn.e"/> libras et quattuor (forisfacturam<ptr type="liebermannNote" n="12" target="#ECf_27-1.lnote.la.12"/> enim ‘hundredi’ Dani et Norwenses<ptr type="liebermannNote" n="13" target="#ECf_27-1.lnote.la.13"/> uocabant VIII libras<ptr type="liebermannNote" n="f" target="#ECf_27-1.lnote.la.fn.f"/>;</ab>
        <note type="comparison" source="#liebermann" n="651"><label>printed alongside</label> <ref target="clause:ECfRetr_27-1">ECf retr 27.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 651 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-1.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">jedoch mit der Ausnahme c.</hi> 33</seg><seg type="translation" xml:lang="en" source="#claude">but with the exception of c. 33</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-1.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">18 × 8 £ = 144 £</seg><seg type="translation" xml:lang="en" source="#claude">18 × £8 = £144</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-1.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">über Rechnung nach</hi> Stiegen <hi rend="italic">vgl. Maurer in</hi> Engl. Stud. 1896, 77</seg><seg type="translation" xml:lang="en" source="#claude">on reckoning by scores (Stiegen) cf. Maurer in Engl. Stud. 1896, 77</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-1.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. mein</hi> Über Ed. Conf. <hi rend="italic">S.</hi> 46</seg><seg type="translation" xml:lang="en" source="#claude">cf. my Über Ed. Conf. p. 46</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-1.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">-lagha <hi rend="italic">Rl;</hi> -lah’ <hi rend="italic">Hk;</hi> -laga <hi rend="italic">Hr Ad;</hi> Danelaga <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lagha Rl; -lah’ Hk; -laga Hr Ad; Danelaga S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-1.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">XVIII <hi rend="italic">Hk S</hi></seg><seg type="translation" xml:lang="en" source="#claude">XVIII Hk S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-1.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-1.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">Norgue. <hi rend="italic">Rl;</hi> Norwice. <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">Norgue. Rl; Norwice. S</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">— for example, in the Danelaw by ten and eight 'hundreds', which number makes up seven times twenty pounds and four (for the Danes and Norwegians called the forfeiture of a 'hundred' eight pounds;</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-1.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> hundert 6; Dänen 2a. 8; Denalagu 11l; Strafgeldfixum 24ff.</seg><seg type="translation" xml:lang="en" source="#claude">Cf. <hi rend="italic">Gl</hi> hundert 6; Dänen 2a. 8; Denalagu 11l; Strafgeldfixum 24ff.</seg></note>
      </div>
    </body>
