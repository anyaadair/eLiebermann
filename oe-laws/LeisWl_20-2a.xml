    <body>
      <div type="clause" n="20.2a">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 20.2a</head>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-hk"><pb n="506–507" ed="#liebermann"/>E s’il fust desaparaillé, qu’il n’oust cheval ne armes, fuste<ptr type="liebermannNote" n="d" target="#LeisWl_20-2a.lnote.oe.d"/> quite par C sol.</ab>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-i"><pb n="506–507" ed="#liebermann"/>E<ptr type="liebermannNote" n="24" target="#LeisWl_20-2a.lnote.oe.24"/> s’il fust desapereilé<ptr type="liebermannNote" n="25" target="#LeisWl_20-2a.lnote.oe.25"/>, qu’il<ptr type="liebermannNote" n="26" target="#LeisWl_20-2a.lnote.oe.26"/> ne out ne chival ne les armes, . . . .<ptr type="liebermannNote" n="d" target="#LeisWl_20-2a.lnote.oe.d-2"/> per C solz.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="506–507" ed="#liebermann"/>Quodsi forte h[e]c<ptr type="liebermannNote" n="3" target="#LeisWl_20-2a.lnote.oe.3"/> non haberet, poterit se solutione centum solidorum adquietare.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="20.2a" corresp="#wit-hk"><pb n="262" ed="#robertson"/>E s'il fust desaparaillé qu'il n'oust cheval ne armes, fust quite par C sol.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="506–507" ed="#liebermann"/>20, 2<hi rend="italic">a</hi>. Wenn jener jedoch ungerüstet war, so dass er weder Ross noch Waffen besass, sei dieser [Vasall] quitt durch 100 Schill.<ptr type="liebermannNote" n="1" target="#LeisWl_20-2a.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">20, 2<hi rend="italic">a</hi>. If, however, that man was unarmed, so that he possessed neither steed nor weapons, this [vassal] shall be quit by 100 shill.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-hk"><pb n="263" ed="#robertson"/>And if he was without equipment, having neither horse nor arms, it shall be discharged by the payment of 100 shillings.</ab>
        <note type="comparison" source="#liebermann" n="507"><ref target="clause:IICn_71-2">II Cn 71.2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 71, 2</note>
        <note type="editorial">Added October 2026 from Robertson pp. 262–263 (text and translation); Liebermann’s text and German translation added from Gesetze I p. 506–507, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_20-2a.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">506</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> fust</seg><seg type="translation" xml:lang="en" source="#claude">read fust</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_20-2a.lnote.oe.d-2" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">506</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze aus HkL</hi></seg><seg type="translation" xml:lang="en" source="#claude">supply from HkL</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_20-2a.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">506</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_20-2a.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">506</biblScope></bibl><seg type="original" xml:lang="de">des apeile <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">des apeile <hi rend="italic">Io</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_20-2a.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">506</biblScope></bibl><seg type="original" xml:lang="de">que il <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">que il <hi rend="italic">Im</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_20-2a.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">507</biblScope></bibl><seg type="original" xml:lang="de">hoc <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">hoc <hi rend="italic">S</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_20-2a.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">289</biblScope></bibl><seg type="original" xml:lang="de">Das ‘Wahrscheinlichere’ (5 £) in <hi rend="italic">Gl</hi> Heergewäte 12b, scheint mir jetzt sicher</seg><seg type="translation" xml:lang="en" source="#claude">The ‘more probable’ (5 £) in <hi rend="italic">Gl</hi> Heergewäte 12b now seems certain to me</seg></note>
      </div>
