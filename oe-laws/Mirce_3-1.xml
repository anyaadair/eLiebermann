    <body>
      <div type="clause" n="3.1">
        <head><ref type="lawCode" target="law:Mirce">Mirce</ref> 3.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.1" corresp="#wit-d"><pb n="462" ed="#liebermann"/>⁊ for ðam cynedóme gebireð oðer swilc to bote on cynegilde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.1" corresp="#wit-o"><pb n="462" ed="#liebermann"/>⁊ for þa<hi rend="italic">m</hi> cynedome gebyreð oðer swilc<ptr type="liebermannNote" n="2" target="#Mirce_3-1.lnote.oe.2"/> to bóte on cynegylde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.1" corresp="#wit-h"><pb n="462" ed="#liebermann"/>And for þa<hi rend="italic">m</hi> cynedome gebyrað oþer swilc to bote on cynegylde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.1" corresp="#wit-ld"><pb n="463" ed="#liebermann"/>Ac<ptr type="liebermannNote" n="d" target="#Mirce_3-1.lnote.oe.d"/> for ðæs rices cynebot<ptr type="liebermannNote" n="e" target="#Mirce_3-1.lnote.oe.e"/> biþ to ðissum genume<hi rend="italic">n<ptr type="liebermannNote" n="*" target="#Mirce_3-1.lnote.oe.star"/></hi> eft swa micle on cynegyld.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3.1" corresp="#wit-q"><pb n="463" ed="#liebermann"/>Set pro regni<ptr type="liebermannNote" n="13" target="#Mirce_3-1.lnote.oe.13"/> emendatione (dignitate) debet addi tantumdem in cynegildo<ptr type="liebermannNote" n="14" target="#Mirce_3-1.lnote.oe.14"/>.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3.1" corresp="#wit-in"><pb n="463" ed="#liebermann"/>[43, 3] Sed propter excellentiam regię dignitatis conuenit iterum tantundem<ptr type="liebermannNote" n="15" target="#Mirce_3-1.lnote.oe.15"/> dare.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-h"><pb n="14" ed="#rabin-doml"/>And for ðam cynedome gebyrað oðer swilc to bote on cynegylde.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="463" ed="#liebermann"/>Jedoch für die Königswürde<ptr type="liebermannNote" n="a" target="#Mirce_3-1.lnote.de1.a"/> gebührt als Busse bei Königs-Entgeltung eine zweite<ptr type="liebermannNote" n="1" target="#Mirce_3-1.lnote.de.1"/> solche [Summe].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">But for the kingship a second such [sum] is due as compensation in the king's payment [the public king-compensation is added to it, as much again, lq].</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-d"><pb n="478" ed="#whitelock"/>and on account of the kingship there belongs a second equal sum as compensation in payment for a king.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-h">And for the kingship there is a second compensation owed equal to that for the king.</ab>
        <note type="comparison" source="#liebermann" n="463"><ref target="clause:Northleoda_1">Norðleoda 1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd.</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Northleoda_1">Norðleoda 1</ref></note>
        <note type="editorial">K: ‘ðam’ corrected to H's ‘þam’. Liebermann compares Norðleod 1.; U: checked against Whitelock, EHD I (1979), and corrected (before: ‘and on account of the kingship there belongs a second sum as compensation in payment for a king.’).</note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_3-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">462</biblScope></bibl><seg type="original" xml:lang="de">i <hi rend="italic">später geänd. in</hi> y</seg><seg type="translation" xml:lang="en" source="#claude">i later altered to y</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_3-1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Norðleod</hi> 7, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. Norðleod 7, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_3-1.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ebd.</hi> 1; <hi rend="italic">ebenso Quadr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">ibid. 1; likewise Quadr.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_3-1.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Abweichung vom Original</hi></seg><seg type="translation" xml:lang="en" source="#claude">Departure from the original</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_3-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de">r. e. <hi rend="italic">ohne</hi> di. <hi rend="italic">Lond;</hi> r. di. <hi rend="italic">R;</hi> di. r. <hi rend="italic">ohne</hi> em. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. e. without di. Lond; r. di. R; di. r. without em. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_3-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so TMHk;</hi> kin. <hi rend="italic">R;</hi> cen. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">so TMHk; kin. R; cen. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_3-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de">tantum <hi rend="italic">Lb S Pl Jo Ct</hi></seg><seg type="translation" xml:lang="en" source="#claude">tantum Lb S Pl Jo Ct</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="Mirce_3-1.lnote.de1.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de">die staatliche Königsbusse wird diesem hinzugenommen noch einmal so viel bei K. <hi rend="italic">lq</hi></seg><seg type="translation" xml:lang="en" source="#claude">for the public king’s compensation, as much again is added to this in the case of K. <hi rend="italic">lq</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Mirce_3-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">262</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Zu <hi rend="italic">oðer swilc</hi> mit Gen. <hi rend="italic">vgl</hi>. Toller 956b V</seg><seg type="translation" xml:lang="en" source="#claude">On <hi rend="italic">oðer swilc</hi> with gen. <hi rend="italic">cf.</hi> Toller 956b V</seg></note>
      </div>
    </body>
  </text>
