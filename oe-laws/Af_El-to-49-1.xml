        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-1.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">42</biblScope></bibl><seg type="original" xml:lang="de">God gecyr. <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">God gecyr. So Ld</seg></note>
