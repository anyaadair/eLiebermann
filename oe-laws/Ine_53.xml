        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_53.lnote.de.9" n="9" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">77</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">H cor. B verdeutlichen durch Wortfülle</seg><seg type="translation" xml:lang="en" source="#claude">H cor. B make the meaning clearer by using more words</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_53.lnote.de.10" n="10" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">77</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl.</hi> Eideshufen 4. 9. In B ist <hi rend="italic">XL</hi> Schreibfehler für <hi rend="italic">LX; s. o.</hi> 4³</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf.</hi> Eideshufen 4. 9. In B <hi rend="italic">XL</hi> is a scribal error for <hi rend="italic">LX; see above</hi> 4³</seg></note>
