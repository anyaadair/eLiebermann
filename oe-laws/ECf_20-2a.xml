    <body>
      <div type="clause" n="20.2a">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 20.2a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 20.2a"><pb n="645" ed="#liebermann"/>Ipse<ptr type="liebermannNote" n="m" target="#ECf_20-2a.lnote.la.fn.m"/> quidem de suo restauret<ptr type="liebermannNote" n="32" target="#ECf_20-2a.lnote.la.32"/> dampnum quod fecerat; et de corpore<ptr type="liebermannNote" n="n" target="#ECf_20-2a.lnote.la.fn.n"/> suo fiat<ptr type="liebermannNote" n="33" target="#ECf_20-2a.lnote.la.33"/> iusticia, si ad<ptr type="liebermannNote" n="34" target="#ECf_20-2a.lnote.la.34"/> hoc forisfecit<ptr type="liebermannNote" n="35" target="#ECf_20-2a.lnote.la.35"/>.</ab>
        <note type="comparison" source="#liebermann" n="645"><label>printed alongside</label> <ref target="clause:ECfRetr_20-2a">ECf retr 20.2a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 645 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-2a.lnote.la.fn.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">Missethäter, <hi rend="italic">wie</hi> 20, 4</seg><seg type="translation" xml:lang="en" source="#claude">the wrongdoer, as at 20, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-2a.lnote.la.fn.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 23, 2a</seg><seg type="translation" xml:lang="en" source="#claude">as at 23, 2a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-2a.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">-raret <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-raret Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-2a.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">fieret <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">fieret Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-2a.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">tantum <hi rend="italic">Ad Do</hi> [<hi rend="italic">aber</hi> ad hoc <hi rend="italic">auch</hi> 23, 2a]</seg><seg type="translation" xml:lang="en" source="#claude">tantum Ad Do [but ad hoc also at 23, 2a]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-2a.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl Hr;</hi> -cerit <hi rend="italic">S Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl Hr; -cerit S Ad</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Let him indeed make good from his own the damage which he had done; and let justice be done on his body, if he has offended to that extent.</ab>
      </div>
