    <body>
      <div type="clause" n="76.1b">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 76.1b</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="76.1b" corresp="#wit-g-a"><pb n="364" ed="#liebermann"/>⁊ ne mæg nan wif hyre<ptr type="liebermannNote" n="4" target="#IICn_76-1b.lnote.oe.4-2"/> bondan forbeodan, þ<hi rend="italic">æt</hi> he ne mote into his coton<ptr type="liebermannNote" n="5" target="#IICn_76-1b.lnote.oe.5"/> gelogian þ<hi rend="italic">æt</hi> þ<hi rend="italic">æt</hi> he wylle.<ptr type="liebermannNote" n="6" target="#IICn_76-1b.lnote.oe.6"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="76.1b" corresp="#wit-b"><pb n="364" ed="#liebermann"/>And ne mæg nan wif hire bundan forbeodan, þ<hi rend="italic">æt</hi> he ne mote into his cotan gelegian<ptr type="liebermannNote" n="3" target="#IICn_76-1b.lnote.oe.3-2"/> þ<hi rend="italic">æt</hi> þ<hi rend="italic">æt</hi> he wile.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="76.1b" corresp="#wit-a"><pb n="364" ed="#liebermann"/>And ne<ptr type="liebermannNote" n="1" target="#IICn_76-1b.lnote.oe.1"/> mæg nan wif hyre bonda<hi rend="italic">n</hi> forbeodan, þ<hi rend="italic">æt</hi> he ne mote into his cotan gelaðyan<ptr type="liebermannNote" n="2" target="#IICn_76-1b.lnote.oe.2-2"/> þ<hi rend="italic">æt</hi> þ<hi rend="italic">æt</hi> he wille.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="76.1b" corresp="#wit-q"><pb n="365" ed="#liebermann"/>Non potest uxor aliqua sponsum suum prohibere, quin mittat in tugurio suo quod uelit<ptr type="liebermannNote" n="4" target="#IICn_76-1b.lnote.oe.4"/> (uult).</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="76.1b" corresp="#wit-cons-cn"><pb n="365" ed="#liebermann"/>[76, 1<hi rend="italic">b</hi>] Nulla enim marita maritum prohibere potest, quin in sua propria domo locet quod uelit.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="76.1b" corresp="#wit-b"><pb n="214" ed="#robertson"/>And ne mæg nan wif hire bundan forbeodan þæt he ne mote into his cotan gelegian<ptr type="editorNote" n="5" target="#IICn_76-1b.robnote.fn.5"/> þæt þæt he wille.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="294" ed="#rabin-doml"/>And ne mæg nan wif hyre bondan forbeodan, þæt he ne mote into his coton gelogian þæt þæt he wylle.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="364" ed="#liebermann"/>Jedoch darf keine Frau ihrem Mann<ptr type="liebermannNote" n="1" target="#IICn_76-1b.lnote.de.1"/> verbieten, dass er was er wolle in seine Hütte absetzen<ptr type="liebermannNote" n="2" target="#IICn_76-1b.lnote.de.2"/> (legen <hi rend="italic">B</hi>; einführen <hi rend="italic">oder</hi> abladen ? <hi rend="italic">A</hi>) dürfe.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">But no wife may forbid her husband to put down (lay, B; bring in or unload?, A) in his cottage whatever he wants.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_76-1b.robnote.n.1"/><pb n="215" ed="#robertson"/>But no wife can forbid her husband to deposit anything that he desires in his cottage.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="473" ed="#whitelock"/>And no wife can forbid her husband to place inside his cottage what he pleases.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="295" ed="#rabin-doml"/>Yet no wife can prevent her husband from storing anything he wishes in his home.</ab>
        <note type="comparison" source="#liebermann" n="364"><ref target="clause:Ine_57">Ine 57</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. Ine 57?</note>
        <note type="editorial">Liebermann suggests A's ‘gelaðyan’ stands for ‘gelædan’ or ‘gehladan’. He compares (with a query) Ine 57.; BR: added from Gesetze I p. 365, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">gelogian: gelaðyan A</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_76-1b.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">365</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_76-1b.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">365</biblScope></bibl><seg type="original" xml:lang="de">p. d. s. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. d. s. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_76-1b.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">365</biblScope></bibl><seg type="original" xml:lang="de">Merito habebitur immunis a crimine, nisi sub seris sit ibi locatum, quia aliorum locorum illa non habet potestatem <hi rend="italic">fügt wiederholend hinzu Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Merito habebitur immunis a crimine, nisi sub seris sit ibi locatum, quia aliorum locorum illa non habet potestatem added by Hr as a repetition</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_76-1b.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">364</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> gelog.</seg><seg type="translation" xml:lang="en" source="#claude">altered gelog.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_76-1b.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">365</biblScope></bibl><seg type="original" xml:lang="de">ue. <hi rend="italic">K</hi>; uult <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">ue. K; uult the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_76-1b.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">364</biblScope></bibl><seg type="original" xml:lang="de">hire <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hire Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_76-1b.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">364</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 76 <hi rend="italic">B</hi>; cotan gelaþian <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 76 B; cotan gelaþian Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_76-1b.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">364</biblScope></bibl><seg type="original" xml:lang="de">wille <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wille Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_76-1b.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">364</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_76-1b.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">364</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">statt</hi> gelædan <hi rend="italic">oder</hi> gehladan?</seg><seg type="translation" xml:lang="en" source="#claude">instead of gelædan or gehladan?</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_76-1b.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">213</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Ehefrau 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Ehefrau 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_76-1b.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">213</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. gelogod</hi> Cn 1020, 6. B meint Nebenform von <hi rend="italic">gelecgan</hi>, oder verschrieb -<hi rend="italic">c</hi>- statt <hi rend="italic">o</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. gelogod</hi> Cn 1020, 6. B means a by-form of <hi rend="italic">gelecgan</hi>, or miswrote -<hi rend="italic">c</hi>- for <hi rend="italic">o</hi></seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_76-1b.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">359</biblScope></bibl><seg type="original" xml:lang="en">Cf. In. 57.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_76-1b.robnote.fn.5" n="5" source="#robertson"><bibl><biblScope unit="page">214</biblScope></bibl><label>gelegian</label><seg type="original" xml:lang="en">Altered later to <hi rend="italic">gelogian</hi> which is also G’s reading; <hi rend="italic">gelaðyan</hi> A.</seg></note>
      </div>
    </body>
