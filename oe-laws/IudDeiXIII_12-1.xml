      <div type="clause" n="12.1">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 12.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 12.1" corresp="#wit-lat"><pb n="423" ed="#liebermann"/>Si<ptr type="liebermannNote" n="41" target="#IudDeiXIII_12-1.lnote.oe.41"/> in aliquo est culpabilis ille<ptr type="liebermannNote" n="42" target="#IudDeiXIII_12-1.lnote.oe.42"/>, pro quo iste ad probationem mittendus est, scilicet aut per opera aut per consensum uel per conscientiam aut per ullum ingenium, fac eum super te, ó aqua, natare; et nulla possit contra<ptr type="liebermannNote" n="43" target="#IudDeiXIII_12-1.lnote.oe.43"/> esse<ptr type="liebermannNote" n="44" target="#IudDeiXIII_12-1.lnote.oe.44"/> causa aliquo modo facta aut ullum pręstigium, quo<ptr type="liebermannNote" n="45" target="#IudDeiXIII_12-1.lnote.oe.45"/> illud possit non manifestari<ptr type="liebermannNote" n="46" target="#IudDeiXIII_12-1.lnote.oe.46"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 423 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_12-1.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">12, 1 = <hi rend="italic">Zeu. p.</hi> 653. 665&lt;sub&gt;3&lt;/sub&gt;</seg><seg type="translation" xml:lang="en" source="#claude">12, 1 = Zeu. p. 653. 665&lt;sub&gt;3&lt;/sub&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_12-1.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">homo iste qui <hi rend="italic">statt</hi> i. p. q. i. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">homo iste qui instead of i. p. q. i. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_12-1.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">te <hi rend="italic">fügt zu Tr;</hi> a te <hi rend="italic">Zeu.</hi> 665&lt;sub&gt;5&lt;/sub&gt;</seg><seg type="translation" xml:lang="en" source="#claude">te added by Tr; a te Zeu. 665&lt;sub&gt;5&lt;/sub&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_12-1.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">c. e. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. e. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_12-1.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">Vt2</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod Vt2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_12-1.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">-re <hi rend="italic">Vt2</hi></seg><seg type="translation" xml:lang="en" source="#claude">-re Vt2</seg></note>
