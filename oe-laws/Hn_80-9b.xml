      <div type="clause" n="80.9b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 80.9b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 80.9b" corresp="#wit-lat"><pb n="597" ed="#liebermann"/>De thainis<ptr type="liebermannNote" n="15" target="#Hn_80-9b.lnote.oe.15"/> et baronibus et<ptr type="liebermannNote" n="16" target="#Hn_80-9b.lnote.oe.16"/> qui sunt eiusmodi<ptr type="liebermannNote" n="17" target="#Hn_80-9b.lnote.oe.17"/> in ouerseunessa<ptr type="liebermannNote" n="f" target="#Hn_80-9b.lnote.oe.f"/> consistat<ptr type="liebermannNote" n="18" target="#Hn_80-9b.lnote.oe.18"/>, nisi amplius interueniat ut addatur<ptr type="liebermannNote" n="g" target="#Hn_80-9b.lnote.oe.g"/>: ‘per pacis fraccionem’, ‘per hamsocnam’ et similium<ptr type="liebermannNote" n="19" target="#Hn_80-9b.lnote.oe.19"/>; uel<ptr type="liebermannNote" n="gg" target="#Hn_80-9b.lnote.oe.gg"/> si sit homo eius cuius est<ptr type="liebermannNote" n="20" target="#Hn_80-9b.lnote.oe.20"/> domus qui fuerit interfectus uel percussus uel quoquo modo afflictus.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 597 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-9b.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 80, 12</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 80, 12</seg></note>
