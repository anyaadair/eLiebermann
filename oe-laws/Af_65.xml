    <body>
      <div type="clause" n="65">
        <head><ref type="lawCode" target="law:Af">Af</ref> 65</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="65" corresp="#wit-e"><pb n="84" ed="#liebermann"/>Gif mon sie<ptr type="liebermannNote" n="1" target="#Af_65.lnote.oe.1"/> on þa herðan<ptr type="liebermannNote" n="10" target="#Af_65.lnote.oe.10"/> to ðam swiðe wund<ptr type="liebermannNote" n="11" target="#Af_65.lnote.oe.11"/>, þæt he ne mæge bearn [gestrienan<ptr type="liebermannNote" n="*" target="#Af_65.lnote.oe.star"/>], gebete him ðæt mid LXXX scill.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="65" corresp="#wit-h"><pb n="84" ed="#liebermann"/>Gif mon<ptr type="liebermannNote" n="4" target="#Af_65.lnote.oe.4"/> sy<ptr type="liebermannNote" n="3" target="#Af_65.lnote.oe.3"/> on ða herðan to þon<ptr type="liebermannNote" n="4" target="#Af_65.lnote.oe.4"/> swiðe wund<ptr type="liebermannNote" n="8" target="#Af_65.lnote.oe.8"/>, þæt he ne mage<ptr type="liebermannNote" n="9" target="#Af_65.lnote.oe.9"/> bearn gestrienan, gebete him ðæt mid LXXX scillingum.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="65" corresp="#wit-b-no-prol"><pb n="84" ed="#liebermann"/>Gyf mon sy on ða hærðan to ðan swiþe g<hi rend="italic">e</hi>wundod, þ<hi rend="italic">æt</hi> he ne mæge bearn begytan, gebete him þ<hi rend="italic">æt</hi> mid hundeahtatig scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="65" corresp="#wit-q"><pb n="85" ed="#liebermann"/>Si quis in testiculis plagietur, ut generare non possit, emendetur<ptr type="liebermannNote" n="7" target="#Af_65.lnote.oe.7"/> ei LXXX sol.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="90" ed="#attenborough"/>Gif mon sie on þa herðan to ðam<ptr type="editorNote" n="7" target="#Af_65.attnote.fn.7"/> swiðe wund<ptr type="editorNote" n="8" target="#Af_65.attnote.fn.8"/>, þæt he ne mæge bearn [gestrienan]<ptr type="editorNote" n="9" target="#Af_65.attnote.fn.9"/>, gebete him ðæt mid LXXX scill.<ptr type="editorNote" n="10" target="#Af_65.attnote.fn.10"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="68" corresp="#wit-e"><pb n="358" ed="#jurasinski-and-oliver"/>Gif mon sie on þa herðan to ðam swiðe wund, þæt he ne mæge bearn [gestrienen], gebete him ðæt mid LXXX scill.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="85" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_65.lnote.de.1"/> jemand an den Hoden<ptr type="liebermannNote" n="2" target="#Af_65.lnote.de.2"/> so stark verwundet<ptr type="liebermannNote" n="3" target="#Af_65.lnote.de.3"/> ist, dass er kein Kind zeugen<ptr type="liebermannNote" n="4" target="#Af_65.lnote.de.4"/> kann, büsse [der Thäter] ihm das mit 80 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone is wounded in the testicles so severely that he cannot beget a child, let [the offender] compensate him for it with 80 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="91" ed="#attenborough"/>If a man is so badly wounded in the testicles that he cannot beget children, 80 shillings shall be paid to him as compensation for it.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="359" ed="#jurasinski-and-oliver"/>If someone is wounded in the testicles so severely, that he may not conceive children, let him compensate him for that with 80 shillings.</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="359"><label>contrast</label> <ref target="clause:Abt_64">Abt 64</ref> <quote>This is considerably less than the three wergilds required as compensation for a similar injury in Æthelberht.</quote></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="361"><label>echoes</label> <ref target="clause:Abt_64">Abt 64</ref> <quote>As did §68, these rulings echo Æthelberht §64</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_65.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_65.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">hærþan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hærþan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_65.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">gewundod <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gewundod Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_65.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt E; ergänzt aus H;</hi> gestrynan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in E; supplied from H; gestrynan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_65.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_65.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_65.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> gewunded</seg><seg type="translation" xml:lang="en" source="#claude">altered to gewunded</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_65.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">a <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">a on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_65.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">85</biblScope></bibl><seg type="original" xml:lang="de">LXXX s. em. <hi rend="italic">ohne</hi> ei <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">LXXX s. em. without ei Lond</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_65.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Zeugungsglied 1a</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Zeugungsglied 1a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_65.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Anders als Abt 64</seg><seg type="translation" xml:lang="en" source="#claude">Different from Abt 64</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_65.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">B modernisiert wie <hi rend="italic">o.</hi> 53</seg><seg type="translation" xml:lang="en" source="#claude">B modernizes as <hi rend="italic">above</hi> 53</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_65.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">B modernisiert wie <hi rend="italic">o.</hi> 53</seg><seg type="translation" xml:lang="en" source="#claude">B modernizes as <hi rend="italic">above</hi> 53</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_65.lnote.de.5" n="5" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">[über 80 setze ⁵] Zahl vielleicht aus 66 irrig vorweggenommen</seg><seg type="translation" xml:lang="en" source="#claude">[set ⁵ over 80] The number was perhaps wrongly anticipated from 66</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_65.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">90</biblScope></bibl><label>ðam</label><seg type="original" xml:lang="en"><hi rend="italic">to þon</hi>. H. <hi rend="italic">to ðan</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_65.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">90</biblScope></bibl><label>wund</label><seg type="original" xml:lang="en"><hi rend="italic">gewundod</hi>. B &amp; Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_65.attnote.fn.9" n="9" source="#attenborough"><bibl><biblScope unit="page">90</biblScope></bibl><label>gestrienan</label><seg type="original" xml:lang="en">H. <hi rend="italic">begytan</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_65.attnote.fn.10" n="10" source="#attenborough"><bibl><biblScope unit="page">90</biblScope></bibl><label>scill</label><seg type="original" xml:lang="en"><hi rend="italic">scillingum</hi>. H.</seg></note>
