      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 1.1" corresp="#wit-lat"><pb n="401" ed="#liebermann"/>Accipe illos homines<ptr type="liebermannNote" n="6" target="#IudDeiI_1-1.lnote.oe.6"/>, quos uis<ptr type="liebermannNote" n="7" target="#IudDeiI_1-1.lnote.oe.7"/> mittere in aquam, et duc eos in ecclesiam; et coram omnibus<ptr type="liebermannNote" n="8" target="#IudDeiI_1-1.lnote.oe.8"/> illis<ptr type="liebermannNote" n="9" target="#IudDeiI_1-1.lnote.oe.9"/> cantet presbiter missam et faciat<ptr type="liebermannNote" n="10" target="#IudDeiI_1-1.lnote.oe.10"/> eos ad ipsam missam offerre.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 401 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_1-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Rj;</hi> illum hominem qnem <hi rend="italic">und so weiter Sing. Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Rj; illum hominem qnem and so on, in the singular, Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_1-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">m. u. <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">m. u. Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_1-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">eo canta m.: ‘Iustus es D. et r. i. t.’ (<hi rend="italic">s. u.</hi> 4). Cum a. ad com. (= 2) <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo canta m.: ‘Iustus es D. et r. i. t.’ (see below 4). Cum a. ad com. (= 2) Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_1-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_1-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">faciet <hi rend="italic">Ch Ca H;</hi> et—offerre <hi rend="italic">fehlt Co;</hi> et—missam <hi rend="italic">überspringt Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">faciet Ch Ca H; et—offerre omitted in Co; et—missam skipped by Vt</seg></note>
      </div>
