      <div type="clause" n="35.1 A 1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 35.1 A 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 35.1 A 1"><pb n="664" ed="#liebermann"/>Erat enim de iure post decessum Eadgari<ptr type="liebermannNote" n="6" target="#ECf_35-1-A-1.lnote.la.6"/> æðeling, fratris sui, uerus heres ultimi† regis Edwardi de corona tocius regni predicti<ptr type="liebermannNote" n="7" target="#ECf_35-1-A-1.lnote.la.7"/>. Sed instinctu<ptr type="liebermannNote" n="8" target="#ECf_35-1-A-1.lnote.la.8"/>, petitione et uoluntate boni regis Edwardi, propinqui<ptr type="liebermannNote" n="f" target="#ECf_35-1-A-1.lnote.la.fn.f"/> [ue]stri<ptr type="liebermannNote" n="9" target="#ECf_35-1-A-1.lnote.la.9"/>, aliter mutatum est: qui uobis<ptr type="liebermannNote" n="10" target="#ECf_35-1-A-1.lnote.la.10"/> coronam tocius regni predicti dedit et regnum predictum uobis<ptr type="liebermannNote" n="11" target="#ECf_35-1-A-1.lnote.la.11"/> iurare fecit; qui peroptime equitatem et scientiam et<ptr type="liebermannNote" n="12" target="#ECf_35-1-A-1.lnote.la.12"/> iustitiam probitatemque uestram<ptr type="liebermannNote" n="13" target="#ECf_35-1-A-1.lnote.la.13"/> nouit.</ab>
        <note type="comparisonPrinted" source="#liebermann">ebd. 34, 2e</note>
        <note type="comparisonPrinted" source="#liebermann">34, 1a</note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 664 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">This passage is not part of ECf or ECf retr: it is one of the additions of the London collection (Leges Anglorum s. XIII in. Londoniis collectae), which Liebermann prints across the page after ECf 35, 1 as an insertion into ECf retr. 35, 1 (35, 1 A). The dictionary cites it as “ECf 35,1 A …”, so it is kept with ECf here.</note>
        <note type="editorial">Liebermann prints some words here in smaller type (“Eadgari æðeling”, “ultimi regis Edwardi”, “regis Edwardi”, “coronam”, “regni”); they are taken over from ECf retr 34, 2e and 34, 1a, which his margin names (ebd. 34, 2e; 34, 1a).</note>
        <note type="editorial">The dagger after “ultimi” refers to Liebermann’s marginal reference “ebd. 34, 2e” (ECf retr 34, 2e).</note>
        <note type="editorial">In “[ue]stri” the square brackets are Liebermann’s: the manuscripts read “nostri” (note 9).</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1-A-1.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie o.</hi> 32 A 8</seg><seg type="translation" xml:lang="en" source="#claude">as above, 32 A 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1-A-1.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">Ed. ad. <hi rend="italic">K;</hi> Ed. athelinge <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ed. ad. K; Ed. athelinge Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1-A-1.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">dedit <hi rend="italic">fügt zu Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">Co Or add dedit</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1-A-1.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu K</hi></seg><seg type="translation" xml:lang="en" source="#claude">K adds et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1-A-1.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">nostri <hi rend="italic">Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">nostri MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1-A-1.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">c. nobis <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. nobis Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1-A-1.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">nobis <hi rend="italic">Or Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">nobis Or Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1-A-1.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1-A-1.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">nostram <hi rend="italic">Co Or Ld;</hi> ueram <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">nostram Co Or Ld; ueram K</seg></note>
      </div>
