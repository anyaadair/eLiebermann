    <body>
      <div type="clause" n="18.3">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 18.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 18.3"><pb n="644" ed="#liebermann"/>Quodsi periuri<ptr type="liebermannNote" n="18" target="#ECf_18-3.lnote.la.18"/> remanserint in terra, quicumque<ptr type="liebermannNote" n="19" target="#ECf_18-3.lnote.la.19"/> eos inuenire<ptr type="liebermannNote" n="20" target="#ECf_18-3.lnote.la.20"/> poterit, faciat<ptr type="liebermannNote" n="21" target="#ECf_18-3.lnote.la.21"/> de eis iustitiam<ptr type="liebermannNote" n="g" target="#ECf_18-3.lnote.la.fn.g"/>.</ab>
        <note type="comparison" source="#liebermann" n="644"><label>printed alongside</label> <ref target="clause:ECfRetr_18-3">ECf retr 18.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 644 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-3.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">‘<hi rend="italic">vollstrecke die Hinrichtung</hi> (‘<hi rend="italic">ohne</hi> [<hi rend="italic">weiteren</hi>] <hi rend="italic">Process</hi>’; <hi rend="italic">Retr.</hi>)’; <hi rend="italic">Tödtung Geächteter war zwar erlaubt</hi> (<hi rend="italic">s. o.</hi> 6, 2), <hi rend="italic">aber im XII. Jahrh. kaum mehr, wie bei den alten Germanen, Pflicht</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘let him carry out the execution (‘without [further] process’; Retr.)’; the killing of outlaws was indeed permitted (see above, 6, 2), but in the 12th century hardly still a duty, as among the ancient Germans</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-3.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">perituri <hi rend="italic">S;</hi> plus <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">perituri S; plus Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-3.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">ubicunque <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">ubicunque Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-3.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">inu.—eos <hi rend="italic">überspringt Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">Rl skips inu.—eos</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-3.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">fiat (fiet <hi rend="italic">Do</hi>) de e. iusticia <hi rend="italic">S Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">fiat (fiet Do) de e. iusticia S Ad Do</seg></note>
      </div>
