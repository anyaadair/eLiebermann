        <note type="liebermannNote" subtype="textual" xml:id="Ine_75.lnote.oe.11-2" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">122</biblScope></bibl><seg type="original" xml:lang="de">tymeð <hi rend="italic">So;</hi> tymð <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">tymeð So; tymð Ld</seg></note>
