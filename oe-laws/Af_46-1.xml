    <body>
      <div type="clause" n="46.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 46.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="46.1" corresp="#wit-e"><pb n="80" ed="#liebermann"/>Gif se hlyst oðstande, þæt he ne mæge gehieran<ptr type="liebermannNote" n="1" target="#Af_46-1.lnote.oe.1"/>, geselle LX<ptr type="liebermannNote" n="2" target="#Af_46-1.lnote.oe.2"/> scill. to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="46.1" corresp="#wit-h"><pb n="80" ed="#liebermann"/>Gif se hlyst<ptr type="liebermannNote" n="1" target="#Af_46-1.lnote.oe.1-2"/> oþstonde<ptr type="liebermannNote" n="2" target="#Af_46-1.lnote.oe.2-2"/>, ðæt he ne mæge gehiran, LX scll' to bote gesylle.<ptr type="liebermannNote" n="3" target="#Af_46-1.lnote.oe.3"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="46.1" corresp="#wit-b-no-prol"><pb n="80" ed="#liebermann"/>Gyf se lyst ætstande, ðæt he ne mæg gehyran, gesylle syxti scill' him to bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="46.1" corresp="#wit-q"><pb n="81" ed="#liebermann"/>Si<ptr type="liebermannNote" n="1" target="#Af_46-1.lnote.oe.1-3"/> auditum inde perdat, LX solid. emendetur.<ptr type="liebermannNote" n="2" target="#Af_46-1.lnote.oe.2-3"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="86" ed="#attenborough"/>Gif se hlyst oðstande<ptr type="editorNote" n="4" target="#Af_46-1.attnote.fn.4"/>, þæt he ne mæge gehieran, geselle LX scill. to bote<ptr type="editorNote" n="5" target="#Af_46-1.attnote.fn.5"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="49.1" corresp="#wit-e"><pb n="350" ed="#jurasinski-and-oliver"/>Gif se hlyst oðstande, þæt he ne mæge gehieran, geselle LX scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="81" ed="#liebermann"/>Wenn das Gehör fortbleibt<ptr type="liebermannNote" n="1" target="#Af_46-1.lnote.de.1"/>, dass jener nicht hören kann, gebe er<ptr type="liebermannNote" n="2" target="#Af_46-1.lnote.de.2"/> 60 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the hearing stops, so that he cannot hear, let him give 60 shillings as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="87" ed="#attenborough"/>If the hearing is stopped, so that he cannot hear, 60 shillings shall be given as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="351" ed="#jurasinski-and-oliver"/>If his hearing ceases to function, so that he can no longer hear, let him pay 60 shillings as compensation.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_46-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">gehyran, gesylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gehyran, gesylle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_46-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">XXX, <hi rend="italic">aber am Rande:</hi> al. 60 <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">XXX, but in the margin: al. 60 Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_46-1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_46-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> -stande</seg><seg type="translation" xml:lang="en" source="#claude">altered to -stande</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_46-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_46-1.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">46, 1 <hi rend="italic">fehlt Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">46, 1 lacking in Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_46-1.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">-det <hi rend="italic">Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">-det Brti</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_46-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">nicht ‘leidet, be impaired’, sondern ‘aussteht’. — B modernisiert; <hi rend="italic">ætstandan</hi> kann <hi rend="italic">obturere</hi> heissen, wie Inst. übersetzen</seg><seg type="translation" xml:lang="en" source="#claude">not ‘suffers, be impaired’, but ‘is missing’. — B modernizes; <hi rend="italic">ætstandan</hi> can mean <hi rend="italic">obturere</hi>, as Inst. translate</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_46-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Aus Abt 39; <hi rend="italic">vgl. Gl</hi> Taubheit</seg><seg type="translation" xml:lang="en" source="#claude">From Abt 39; <hi rend="italic">cf. Gl</hi> Taubheit</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_46-1.attnote.fn.4" n="4" source="#attenborough"><bibl><biblScope unit="page">86</biblScope></bibl><label>oðstande</label><seg type="original" xml:lang="en"><hi rend="italic">lyst ætstande</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_46-1.attnote.fn.5" n="5" source="#attenborough"><bibl><biblScope unit="page">86</biblScope></bibl><label>bote</label><seg type="original" xml:lang="en"><hi rend="italic">him to bote</hi>. B.</seg></note>
      </div>
    </body>
