    <body>
      <div type="clause" n="22">
        <head><ref type="lawCode" target="law:VIAtr">VI Atr</ref> 22</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22" corresp="#wit-k"><pb n="252" ed="#liebermann"/>K. ⁊ freolsa ⁊ fæstena healde man rihtlice.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22" corresp="#wit-d-incomplete"><pb n="252" ed="#liebermann"/>⁊ freolsa ⁊ fæstena healde man rihtlice.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="22" corresp="#wit-k"><pb n="96" ed="#robertson"/>⁊ freolsa ⁊ fæstena healde man rihtlice.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-k"><pb n="168" ed="#rabin-doml"/>And freolsa and fæstena healde man rihtlice.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="253" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#VIAtr_22.lnote.de.1"/> Feiertage und Fasten halte man gesetzmässig.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let feasts and fasts be kept lawfully.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-k"><ptr type="editorNote" n="1" target="#VIAtr_22.robnote.n.1"/><pb n="97" ed="#robertson"/>And festivals and fasts shall be duly observed.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-k"><pb n="169" ed="#rabin-doml"/>And feasts and fasts are to be properly observed.</ab>
        <note type="comparison" source="#liebermann" n="253"><ref target="clause:VAtr_12-3">V Atr 12.3</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 12, 3</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VIAtr_43-1">VI Atr 43.1</ref>; <ref target="clause:VIIIAtr_16">VIII Atr 16</ref>; <ref target="clause:ICn_14-1">I Cn 14.1</ref></note>
        <note type="comparison" source="#wormald-mel" n="343"><label>cf.</label> <ref target="clause:Af_43">Af 43</ref> <quote>and Ember Days — though for these cf. Af 43</quote></note>
        <note type="comparison" source="#wormald-mel" n="343"><label>expanded version</label> <ref target="clause:VAtr_12-3">V Atr 12.3–20</ref> <quote>n. 370: V Atr 12:3 – 20, VI 22-25:2 (where additions include hunting among prohibited Sunday activities, weddings ...)</quote></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VIAtr_22.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">176</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Verbot der Sonntagsjagd scheint kd einzuführen; <hi rend="italic">s. o</hi>. Einl. 21; <hi rend="italic">Gl</hi> Sonntag 4c. 5; Jagd 4</seg><seg type="translation" xml:lang="en" source="#claude">The prohibition of hunting on Sundays seems to be introduced by kd; <hi rend="italic">see above</hi> Introduction 21; <hi rend="italic">Gl</hi> Sonntag 4c. 5; Jagd 4</seg><note type="remark" resp="#claude">On several rubrics: VI Atr 22. 22, 1</note></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VIAtr_22.lnote.de.0" n="0" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">176</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">benutzt durch I Cn 14, 1—15, 1, <hi rend="italic">Hom. n</hi>. Wulfstan 272.—</seg><seg type="translation" xml:lang="en" source="#claude">used by I Cn 14, 1—15, 1, <hi rend="italic">Hom. n</hi>. Wulfstan 272.—</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VIAtr_22.lnote.de.a" n="a" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">176</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Weltliche, namentlich wohl landwirtschaftliche, Arbeit gilt also dem Lateiner als unfrei; <hi rend="italic">vgl. Gl</hi> Fron 12</seg><seg type="translation" xml:lang="en" source="#claude">Secular, and probably in particular agricultural, work is thus regarded by the Latin translator as servile; <hi rend="italic">cf. Gl</hi> Fron 12</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VIAtr_22.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">333</biblScope></bibl><seg type="original" xml:lang="en">Cf. V, 12, 3; I Cn. 14, 1.</seg></note>
      </div>
    </body>
