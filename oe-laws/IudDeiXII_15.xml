        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XII 15" corresp="#wit-lat"><pb n="421" ed="#liebermann"/>Post celebrationem<ptr type="liebermannNote" n="11" target="#IudDeiXII_15.lnote.oe.11"/> misse pergat sacerdos cum plebe, euangelio et sancta cruce et<ptr type="liebermannNote" n="12" target="#IudDeiXII_15.lnote.oe.12"/> turribulo et<ptr type="liebermannNote" n="13" target="#IudDeiXII_15.lnote.oe.13"/> sanctorum<ptr type="liebermannNote" n="14" target="#IudDeiXII_15.lnote.oe.14"/> reliquiis precedentibus, cum letania et penitentiales<ptr type="liebermannNote" n="15" target="#IudDeiXII_15.lnote.oe.15"/> psalmos ad benedicendam aquam ita<ptr type="liebermannNote" n="16" target="#IudDeiXII_15.lnote.oe.16"/>:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 421 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_15.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">421</biblScope></bibl><seg type="original" xml:lang="de">Post missam p. <hi rend="italic">hinter Iud. Dei</hi> I 18 <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Post missam p. after Iud. Dei I 18 Tr</seg></note>
