    <body>
      <div type="clause" n="49.3">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 49.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="49.3" corresp="#wit-e"><pb n="110" ed="#liebermann"/>Gif mon nime æfesne<ptr type="liebermannNote" n="26" target="#Ine_49-3.lnote.oe.26"/> on swynum: æt þryfingru<hi rend="italic">m<ptr type="liebermannNote" n="*" target="#Ine_49-3.lnote.oe.star"/></hi> þ<hi rend="italic">æt</hi> ðridde, æt twyfingrum þ<hi rend="italic">æt</hi> feorðe<ptr type="liebermannNote" n="27" target="#Ine_49-3.lnote.oe.27"/>, æt þymelum þæt fifte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="49.3" corresp="#wit-h"><pb n="110" ed="#liebermann"/>Gif mon<ptr type="liebermannNote" n="4" target="#Ine_49-3.lnote.oe.4"/> nime æbesne on swinum: æt ðry<ptr type="liebermannNote" n="2" target="#Ine_49-3.lnote.oe.2"/> fingrum ðæt ðridde, æt twy<ptr type="liebermannNote" n="2" target="#Ine_49-3.lnote.oe.2"/> fingrum ðæt feorþe, æt ðymelu<hi rend="italic">m</hi> ðæt fifte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="49.3" corresp="#wit-b-no-prol"><pb n="110" ed="#liebermann"/>Gyf mon nime æbesne on swinum: æt ðryfingrum<ptr type="liebermannNote" n="5" target="#Ine_49-3.lnote.oe.5"/> þ<hi rend="italic">æt</hi> ðridde<ptr type="liebermannNote" n="6" target="#Ine_49-3.lnote.oe.6"/>, æt twyfingru<hi rend="italic">m</hi> þ<hi rend="italic">æt</hi> feorðe, æt ðumelu<hi rend="italic">m<ptr type="liebermannNote" n="7" target="#Ine_49-3.lnote.oe.7"/></hi> þ<hi rend="italic">æt</hi> fifte.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="49.3" corresp="#wit-q"><pb n="111" ed="#liebermann"/>Si pasnagium<ptr type="liebermannNote" n="30" target="#Ine_49-3.lnote.oe.30"/> capiatur de porcis: de<ptr type="liebermannNote" n="31" target="#Ine_49-3.lnote.oe.31"/> tridigitali tertius<ptr type="liebermannNote" n="32" target="#Ine_49-3.lnote.oe.32"/>, de duodigitali quartus, de þimelo quintus.<ptr type="liebermannNote" n="33" target="#Ine_49-3.lnote.oe.33"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="52" ed="#attenborough"/>Gif mon nime æfesne on swynum: æt þryfingrum [spic]<ptr type="editorNote" n="8" target="#Ine_49-3.attnote.fn.8"/> þæt ðridde, æt twyfingrum þæt feorðe, æt þymelum þæt fifte.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="52" corresp="#wit-e"><pb n="412" ed="#jurasinski-and-oliver"/>Gif mon nime æfesne on swynum: æt þryfingru<hi rend="italic">m</hi> þæt ðridde, æt twyfingrum þ<hi rend="italic">æt</hi> feorðe, æt þymelum þæt fifte.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="111" ed="#liebermann"/>Wenn man [als Grundherr vom Viehbesitzer Mast-]Abgabe<ptr type="liebermannNote" n="1" target="#Ine_49-3.lnote.de.1"/> an Schweinen nimmt, [so erhalte man als Zins] bei 3 Finger dickem<ptr type="liebermannNote" n="2" target="#Ine_49-3.lnote.de.2"/> (Speck<ptr type="liebermannNote" n="3" target="#Ine_49-3.lnote.de.3"/>) [der Schweine je] das dritte, bei 2 Finger dickem<ptr type="liebermannNote" n="2" target="#Ine_49-3.lnote.de.2"/> das vierte, bei daumendickem<ptr type="liebermannNote" n="2" target="#Ine_49-3.lnote.de.2"/> das fünfte.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If [as landlord] one takes [pannage-]dues in pigs [from the owner of the livestock], [let one receive as rent] for (bacon) three fingers thick [each] third [pig], for two fingers thick the fourth, for a thumb thick the fifth.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="53" ed="#attenborough"/>If pannage is paid in pigs<ptr type="editorNote" n="1" target="#Ine_49-3.attnote.n.1"/>, every third pig shall be taken when the bacon is three fingers thick, every fourth when the bacon is two fingers thick, and every fifth when it is a thumb thick.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="405" ed="#whitelock"/>If one takes pannage in pigs, [one is to take] the third with the bacon three fingers thick, the fourth with it two fingers thick, the fifth with it a thumb thick.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="413" ed="#jurasinski-and-oliver"/>If [rent] for pasturage is paid in pigs: [if the bacon is] three-fingers thick, [let it be] every third [pig], at two-fingers, every fourth, at [the width of] a thumb, every fifth.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49-3.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">spic</hi> <hi rend="italic">im</hi> 16. <hi rend="italic">Jh. zugefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">spic</hi> added in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49-3.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de">dr. <hi rend="italic">B</hi></seg><seg type="translation" xml:lang="en" source="#claude">dr. B</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49-3.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. geänd. in</hi> ðym.</seg><seg type="translation" xml:lang="en" source="#claude">altered to ðym. in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49-3.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">111</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">mastenne</hi> <hi rend="italic">am Rande Co</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">mastenne</hi> in the margin Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49-3.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">111</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt T</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49-3.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">111</biblScope></bibl><seg type="original" xml:lang="de">te. de du. <hi rend="italic">überspringt R</hi></seg><seg type="translation" xml:lang="en" source="#claude">te. de du. omitted by R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49-3.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">111</biblScope></bibl><seg type="original" xml:lang="de">capiatur <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">capiatur added by Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49-3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49-3.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49-3.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de">æbesne (<hi rend="italic">am Rande:</hi> al<hi rend="italic">ias</hi> æfesne) on swin. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">æbesne (in the margin: al<hi rend="italic">ias</hi> æfesne) on swin. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49-3.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de">spic <hi rend="italic">ergänzt Ld B im</hi> 16. <hi rend="italic">Jh.</hi></seg><seg type="translation" xml:lang="en" source="#claude">spic supplied by Ld B in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49-3.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de">feowrþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">feowrþ Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_49-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">77</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Mast 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Mast 4</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_49-3.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">77</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Es liegen Adjektiva vor, die auch Plurale sein könnten, vielleicht ‘Schweinen’ zu ergänzen</seg><seg type="translation" xml:lang="en" source="#claude">These are adjectives which could also be plurals; perhaps ‘pigs’ should be supplied</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_49-3.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">77</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Die Ergänzung ‘Speck’ ist sachlich richtig, aber die Form ohne Endung nicht Ælfred-Ines; Archetyp hatte Ellipse</seg><seg type="translation" xml:lang="en" source="#claude">The supplement ‘bacon’ is correct in substance, but the form without an ending is not that of Ælfred-Ine; the archetype had an ellipsis</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_49-3.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">52</biblScope></bibl><label>spic</label><seg type="original" xml:lang="en">Addition to B in 16th century.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_49-3.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">190</biblScope></bibl><seg type="original" xml:lang="en">That is to say, if payment for the pasturage of pigs is paid in kind.</seg></note>
      </div>
