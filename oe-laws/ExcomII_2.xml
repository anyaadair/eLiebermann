        <head><ref type="lawCode" target="law:ExcomII">Excom II</ref> 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom II 2" corresp="#wit-lat"><pb n="434" ed="#liebermann"/>una uobiscum predictum pessimum uirum N.<ptr type="liebermannNote" n="11" target="#ExcomII_2.lnote.oe.11"/> a<ptr type="liebermannNote" n="e" target="#ExcomII_2.lnote.oe.e"/> liminibus<ptr type="liebermannNote" n="12" target="#ExcomII_2.lnote.oe.12"/> sancte matris ecclesie excludimus et ab omni societate<ptr type="liebermannNote" n="f" target="#ExcomII_2.lnote.oe.f"/> et communione Christiana separamus, separatumque<ptr type="liebermannNote" n="13" target="#ExcomII_2.lnote.oe.13"/> esse in eternum<ptr type="liebermannNote" n="g" target="#ExcomII_2.lnote.oe.g"/> decernimus<ptr type="liebermannNote" n="14" target="#ExcomII_2.lnote.oe.14"/>, id<ptr type="liebermannNote" n="15" target="#ExcomII_2.lnote.oe.15"/> est et<ptr type="liebermannNote" n="16" target="#ExcomII_2.lnote.oe.16"/> in presenti seculo et in futuro.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 434 (two independent readings of the page images, differences settled against the page); Liebermann prints in larger type (the readings of MS Ti, his note b on p. 432): N.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomII_2.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">434</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> I 11, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> I 11, 2</seg></note>
