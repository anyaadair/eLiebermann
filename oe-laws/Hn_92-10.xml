        <head><ref type="lawCode" target="law:Hn">Hn</ref> 92.10</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 92.10" corresp="#wit-lat"><pb n="608" ed="#liebermann"/>Si<ptr type="liebermannNote" n="22" target="#Hn_92-10.lnote.oe.22"/> quis Francigenam fugientem uel more suo resistentem solus uel cum aliis pro furto perimat, statim palam<ptr type="liebermannNote" n="l" target="#Hn_92-10.lnote.oe.l"/> faciat; et<ptr type="liebermannNote" n="7" target="#Hn_92-10.lnote.oe.7"/> si certum<ptr type="liebermannNote" n="23" target="#Hn_92-10.lnote.oe.23"/> hoc innotuerit, pacem suam habeat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 608 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-10.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 83, 6<hi rend="italic">a</hi>; Ine 21; <hi rend="italic">Brunner</hi> DRG. II 484</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 83, 6<hi rend="italic">a</hi>; Ine 21; <hi rend="italic">Brunner</hi> DRG. II 484</seg></note>
