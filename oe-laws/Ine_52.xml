    <body>
      <div type="clause" n="52">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 52</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="52" corresp="#wit-e"><pb n="112" ed="#liebermann"/>XCVI. Se ðe diernu<hi rend="italic">m<ptr type="liebermannNote" n="9" target="#Ine_52.lnote.oe.9-2"/></hi> geðingu<hi rend="italic">m</hi> betygen sie, geswicne<ptr type="liebermannNote" n="10" target="#Ine_52.lnote.oe.10-3"/> hine be CXX hida<ptr type="liebermannNote" n="11" target="#Ine_52.lnote.oe.11-2"/> þara geðingea oððe CXX<ptr type="liebermannNote" n="12" target="#Ine_52.lnote.oe.12"/> scill. geselle.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="52" corresp="#wit-h"><pb n="112" ed="#liebermann"/>XCVI. Se ðe dyrnum<ptr type="liebermannNote" n="7" target="#Ine_52.lnote.oe.7-2"/> geðingum betogen sy<ptr type="liebermannNote" n="7" target="#Ine_52.lnote.oe.7-2"/>, geladie<ptr type="liebermannNote" n="10" target="#Ine_52.lnote.oe.10-2"/> hine be CXX hida ðara<ptr type="liebermannNote" n="11" target="#Ine_52.lnote.oe.11"/> geþinga oþþe CXX scll' gesylle.<ptr type="liebermannNote" n="7" target="#Ine_52.lnote.oe.7-2"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="52" corresp="#wit-b-no-prol"><pb n="112" ed="#liebermann"/>Be ðyrnum<ptr type="liebermannNote" n="2" target="#Ine_52.lnote.oe.2"/> geþincðe. Se ðe dyrnum geðingðum betogen sy, geclænsie he hine be hundtwelftigu<hi rend="italic">m</hi> hída ðara ðinga oððe hundtwelftig scill' gesylle.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="52" corresp="#wit-q"><pb n="113" ed="#liebermann"/>Qui de occultis actionibus<ptr type="liebermannNote" n="7" target="#Ine_52.lnote.oe.7"/> fuerit accusatus<ptr type="liebermannNote" n="8" target="#Ine_52.lnote.oe.8"/>, neget CXX<ptr type="liebermannNote" n="9" target="#Ine_52.lnote.oe.9"/> hidis ipsum<ptr type="liebermannNote" n="10" target="#Ine_52.lnote.oe.10"/> actum aut CXX sol. emendet.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="52" ed="#attenborough"/>[Be ðyrnum geþincðe.] Se ðe diernum geðingum<ptr type="editorNote" n="16" target="#Ine_52.attnote.fn.16"/> betygen sie, geswicne<ptr type="editorNote" n="17" target="#Ine_52.attnote.fn.17"/> hine be CXX hida þara geðingea<ptr type="editorNote" n="18" target="#Ine_52.attnote.fn.18"/> oððe CXX scill. geselle.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="55" corresp="#wit-e"><pb n="414" ed="#jurasinski-and-oliver"/>{XCVI} Se ðe diernu<hi rend="italic">m</hi> geðingu<hi rend="italic">m</hi> betygen sie, geswicne hine be CXX hida þara geðingea oððe CXX sciƚƚ geselle.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="113" ed="#liebermann"/>Wer heimlicher<ptr type="liebermannNote" n="1" target="#Ine_52.lnote.de.1"/> Abfindungen<ptr type="liebermannNote" n="2" target="#Ine_52.lnote.de.2"/> beschuldigt wird, schwöre<ptr type="liebermannNote" n="3" target="#Ine_52.lnote.de.3"/> sich von solchen Abfindungen rein durch [Eid von] 120 Hiden<ptr type="liebermannNote" n="4" target="#Ine_52.lnote.de.4"/>, oder zahle [dem Gerichtsherrn] 120 Schill.<ptr type="liebermannNote" n="5" target="#Ine_52.lnote.de.5"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Whoever is accused of secret settlements, let him swear himself clear of such settlements by [an oath of] 120 hides, or pay [the lord of the court] 120 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="53" ed="#attenborough"/>He who is accused of making an illicit compact shall clear himself from the charge with [an oath worth] 120 hides, or pay 120 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="405" ed="#whitelock"/>He who is accused of secret compacts, is to clear himself of [complicity] in the compacts with [an oath of] 120 hides, or pay 120 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="415" ed="#jurasinski-and-oliver"/>He who is accused of [making] secret compacts, let him clear himself of [the accusation of making] those compacts by [an oath of the value of] 120 hides, or let him pay 120 shillings.</ab>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="319"><ref target="clause:Af_22">Af 22</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_52.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">112</biblScope></bibl><seg type="original" xml:lang="de">dyrnunge þincðe</seg><seg type="translation" xml:lang="en" source="#claude">dyrnunge þincðe</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_52.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">113</biblScope></bibl><seg type="original" xml:lang="de">actibus <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">actibus Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_52.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">113</biblScope></bibl><seg type="original" xml:lang="de">adcaus. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">adcaus. R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_52.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">113</biblScope></bibl><seg type="original" xml:lang="de">CCXX <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">CCXX Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_52.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">113</biblScope></bibl><seg type="original" xml:lang="de">i. a. <hi rend="italic">nur Lond; fehlt übrigen</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. a. only Lond; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_52.lnote.oe.7-2" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">112</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_52.lnote.oe.10-2" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">112</biblScope></bibl><seg type="original" xml:lang="de">ladie <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">ladie on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_52.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">112</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> þæra</seg><seg type="translation" xml:lang="en" source="#claude">altered to þæra</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_52.lnote.oe.9-2" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">112</biblScope></bibl><seg type="original" xml:lang="de">dyr. geþingþum betogen sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">dyr. geþingþum betogen sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_52.lnote.oe.10-3" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">112</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">am Rande</hi> al<hi rend="italic">ias</hi> geclænsie <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">in the margin al<hi rend="italic">ias</hi> geclænsie Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_52.lnote.oe.11-2" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">112</biblScope></bibl><seg type="original" xml:lang="de">hyda ðæra ðinga <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hyda ðæra ðinga Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_52.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">112</biblScope></bibl><seg type="original" xml:lang="de">hundtwelftig s. gesylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hundtwelftig s. gesylle Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_52.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">77</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Abfindung; nicht allein ‘bestochene Beamte’ sind gemeint. — Im Ortsrecht einiger privilegierter Städte lebte private Erledigung der Prozesse im 12. Jh. weiter, ohne Strafgeld an einen Richter, sogar mit dem Verbote, den gegnerischen Mitbürger vór dreimaligem privaten Schiedsversuche vors Stadtgericht vorzuladen; Ballard <hi rend="italic">Engl. borough 12 cty.</hi> 10</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Abfindung; not only ‘bribed officials’ are meant. — In the local law of some privileged towns the private settlement of lawsuits lived on in the 12th cent., without a fine to a judge, and even with a prohibition on summoning an opposing fellow burgess before the borough court until three private attempts at arbitration had been made; Ballard <hi rend="italic">Engl. borough 12 cty.</hi> 10</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_52.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">77</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">B konfundiert das Wort mit einem anderer Wurzel, das wohl ‘Beratung, Verhandlung’ ausdrücken soll</seg><seg type="translation" xml:lang="en" source="#claude">B confuses the word with one from another root, which is probably meant to express ‘deliberation, negotiation’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_52.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">77</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">H cor. und B modernisieren unabhängig</seg><seg type="translation" xml:lang="en" source="#claude">H cor. and B modernize independently</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_52.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">77</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Eideshufen 3. 9</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Eideshufen 3. 9</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_52.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">77</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Zunächst dem König; <hi rend="italic">s. Gl</hi> ‘Ungehorsam’ 6. 17</seg><seg type="translation" xml:lang="en" source="#claude">In the first place to the king; <hi rend="italic">see Gl</hi> ‘Ungehorsam’ 6. 17</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_52.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">52</biblScope></bibl><label>geðingum</label><seg type="original" xml:lang="en"><hi rend="italic">geðingðum</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_52.attnote.fn.17" n="17" source="#attenborough"><bibl><biblScope unit="page">52</biblScope></bibl><label>geswicne</label><seg type="original" xml:lang="en"><hi rend="italic">geladie</hi>. H. <hi rend="italic">geclænsie he</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_52.attnote.fn.18" n="18" source="#attenborough"><bibl><biblScope unit="page">52</biblScope></bibl><label>geðingea</label><seg type="original" xml:lang="en"><hi rend="italic">ðinga</hi>. B.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_52.attnote.n.0" n="0" source="#attenborough" rend="wholeClause"><bibl><biblScope unit="page">190</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e.</hi> an illicit compact by which a case is settled out of court, the judge and king thus being deprived of their fines (see V As. note to cap. 3 § 1).</seg></note>
      </div>
