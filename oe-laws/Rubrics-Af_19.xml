    <body>
      <div type="clause" n="19">
        <head>Af Rb 19</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19" corresp="#wit-e"><pb n="18" ed="#liebermann"/>XVII. Be ðam<ptr type="liebermannNote" n="1" target="#Rubrics-Af_19.lnote.oe.1-3"/> monnu<hi rend="italic">m</hi> þe heora wæpen<ptr type="liebermannNote" n="2" target="#Rubrics-Af_19.lnote.oe.2"/> to monslyhte lænað.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19" corresp="#wit-ot-frag"><pb n="18" ed="#liebermann"/>… e þā monnū þe<ptr type="liebermannNote" n="1" target="#Rubrics-Af_19.lnote.oe.1"/> hiora wæpen to monslyhte…</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19" corresp="#wit-g-prol"><pb n="18" ed="#liebermann"/>XVII. Be þa<hi rend="italic">m</hi> mannu<hi rend="italic">m</hi> ðe hyra wæpn to manslihte lænað.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19" corresp="#wit-h"><pb n="19" ed="#liebermann"/>XVII. Be þon<ptr type="liebermannNote" n="1" target="#Rubrics-Af_19.lnote.oe.1-4"/> monnum<ptr type="liebermannNote" n="2" target="#Rubrics-Af_19.lnote.oe.2-2"/> þe heora<ptr type="liebermannNote" n="3" target="#Rubrics-Af_19.lnote.oe.3"/> wæpna<ptr type="liebermannNote" n="4" target="#Rubrics-Af_19.lnote.oe.4"/> to monslyhte<ptr type="liebermannNote" n="2" target="#Rubrics-Af_19.lnote.oe.2-2"/> lænaþ.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="19" corresp="#wit-q"><pb n="19" ed="#liebermann"/>De illis<ptr type="liebermannNote" n="1" target="#Rubrics-Af_19.lnote.oe.1-2"/> qui prestant arma sua ad homicidium.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="190" ed="#jurasinski-and-oliver"/>XVII Be ðam monnum þe heora wæpen to monslyhte lænað</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="190" ed="#jurasinski-and-oliver"/>Be þam þe heore wepna lænað to manslihte</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="19" ed="#liebermann"/>Von<ptr type="liebermannNote" n="1" target="#Rubrics-Af_19.lnote.de.1"/> denjenigen, die ihre Waffe<ptr type="liebermannNote" n="2" target="#Rubrics-Af_19.lnote.de.2"/> zu Todtschlag darleihen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of those who lend their weapon for manslaughter.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="191" ed="#jurasinski-and-oliver"/>Concerning men who lend their weapons for killing a man</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="191" ed="#jurasinski-and-oliver"/>Concerning those who lend their weapons for killing a man</ab>
        <note type="editorial">I: first page of the clause in Liebermann, checked against Liebermann, Gesetze I, October 2026 (e.g. was “16”, now “18”; 3 rows of Af Rb)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_19.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de">þe hiora <hi rend="italic">geändert aus</hi> þeora, <hi rend="italic">indem</hi> hi <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">þe hiora altered from þeora by writing hi above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_19.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">prestantibus a. ad occisionem <hi rend="italic">Br;</hi> De forbatore [armorum <hi rend="italic">Br</hi>] et fabro <hi rend="italic">fügt Hk Br zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">prestantibus a. ad occisionem Br; De forbatore [armorum Br] et fabro added by Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_19.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de">ðon <hi rend="italic">statt</hi> ð. m. <hi rend="italic">Ld;</hi> wæpna lænum <hi rend="italic">statt</hi> ðam — lænað <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðon instead of ð. m. Ld; wæpna lænum instead of ðam — lænað So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_19.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de">wæpne lænaþ to mansliht <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wæpne lænaþ to mansliht Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_19.lnote.oe.1-4" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> þam</seg><seg type="translation" xml:lang="en" source="#claude">altered þam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_19.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_19.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_19.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">a <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">a on an erasure</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_19.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">40</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘Über Entleihungen von Waffen’ So</seg><seg type="translation" xml:lang="en" source="#claude">‘On lendings of weapons’ So</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_19.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">40</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘Waffen’ H, was Frühere aufnehmen; aber Sing. Af 19</seg><seg type="translation" xml:lang="en" source="#claude">‘Weapons’ H, which earlier editors adopt; but sing. Af 19</seg></note>
      </div>
    </body>
  </text>
