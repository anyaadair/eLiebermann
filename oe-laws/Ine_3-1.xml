    <body>
      <div type="clause" n="3.1">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 3.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.1" corresp="#wit-e"><pb n="90" ed="#liebermann"/>Gif þon<hi rend="italic">ne</hi> se ðeowa butan his gewitnesse<ptr type="liebermannNote" n="8" target="#Ine_3-1.lnote.oe.8"/> wyrce, þolie<ptr type="liebermannNote" n="9" target="#Ine_3-1.lnote.oe.9"/> his hyde.<ptr type="liebermannNote" n="10" target="#Ine_3-1.lnote.oe.10"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.1" corresp="#wit-bu"><pb n="90" ed="#liebermann"/>. . . þon<hi rend="italic">ne</hi> se þeowa . . . gewitnysse wyrce, þolie his hyd . . .</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.1" corresp="#wit-h"><pb n="90" ed="#liebermann"/>Gif þonne se þeowa buton<ptr type="liebermannNote" n="2" target="#Ine_3-1.lnote.oe.2"/> his gewitnesse wyrce, ðolie his hyde (oððe<ptr type="liebermannNote" n="5" target="#Ine_3-1.lnote.oe.5-2"/> hydgyld[<hi rend="italic">es</hi>]).</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.1" corresp="#wit-b-no-prol"><pb n="91" ed="#liebermann"/>Gyf þonne se ðeowa butan his gewitnysse wyrce, þolie his hyde oððe hydgyldes.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3.1" corresp="#wit-q"><pb n="91" ed="#liebermann"/>Si seruus sine<ptr type="liebermannNote" n="5" target="#Ine_3-1.lnote.oe.5"/> testimonio domini sui operetur, corium perdat.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="36" ed="#attenborough"/>Gif þonne se ðeowa butan his gewitnesse wyrce, þolie his hyde [oððe hydgyldes<ptr type="editorNote" n="10" target="#Ine_3-1.attnote.fn.10"/>].</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="3.1" corresp="#wit-e"><pb n="372" ed="#jurasinski-and-oliver"/>Gif þonne se ðeowa butan his gewitnesse wyrce, þolie his hyde.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="91" ed="#liebermann"/>Wenn aber der Sklav ohne Mitwissen<ptr type="liebermannNote" n="1" target="#Ine_3-1.lnote.de.1"/> desselben arbeitet, verliere er seine Haut<ptr type="liebermannNote" n="2" target="#Ine_3-1.lnote.de.2"/> (oder<ptr type="liebermannNote" n="3" target="#Ine_3-1.lnote.de.3"/> Hautgeld).</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">But if the slave works without the knowledge of that [lord], let him lose his hide (or hide-money).</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="37" ed="#attenborough"/>If, however, the slave works without the cognisance of his master, he shall undergo the lash or pay the fine in lieu thereof.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="400" ed="#whitelock"/>If, however, the slave works without his knowledge, he is to be flogged.<ptr type="editorNote" n="1" target="#Ine_3-1.whinote.n.1"/></ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="373" ed="#jurasinski-and-oliver"/>If, however, the slave works without his [lord’s] knowledge, let [the slave] pay with his hide</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="373"><label>cf.</label> <ref target="clause:Wi_10">Wi 10</ref> <quote>Wihtred §8.1 [L10] allows a payment to the esne's master of 6 shillings to avoid being whipped.</quote></note>
        <note type="comparedBy" source="#whitelock" n="469"><ref target="clause:IICn_45-2">II Cn 45.2</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_3-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">91</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_3-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_3-1.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">o. h. <hi rend="italic">am Rande, im</hi> 12. <hi rend="italic">Jh.;</hi> es <hi rend="italic">verschnitten</hi></seg><seg type="translation" xml:lang="en" source="#claude">o. h. in the margin, in the 12th cent.; es cut off in trimming</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_3-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">-nysse <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nysse Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_3-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">þolige <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þolige Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_3-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">oþþe his hydgyldes <hi rend="italic">fügt Ld zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">oþþe his hydgyldes added by Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_3-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘Zeugnis’, mehr ‘Erlaubnis, Aufsicht’, also fast = ‘Geheiss’ 3, 2; <hi rend="italic">vgl.</hi> Af 34³</seg><seg type="translation" xml:lang="en" source="#claude">Not ‘testimony’, rather ‘permission, supervision’, thus almost = ‘command’ 3, 2; <hi rend="italic">cf.</hi> Af 34³</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_3-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Prügel 4. 11b</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Prügel 4. 11b</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_3-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Mildernder Zusatz in hb, also 10. 11. Jhs., auch in EGu 7, 1. II Cn 45, 1, wahrscheinlich in Ines Sinne, da Wi 10 6 Schill. fordert, allerdings höheren Geldwertes</seg><seg type="translation" xml:lang="en" source="#claude">Mitigating addition in hb, thus of the 10th–11th cent., also in EGu 7, 1. II Cn 45, 1; probably in accordance with Ine’s intention, since Wi 10 demands 6 shill., though of a higher money value</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_3-1.attnote.fn.10" n="10" source="#attenborough"><bibl><biblScope unit="page">36</biblScope></bibl><label>twyscildig</label><seg type="original" xml:lang="en">B, H*.</seg><note type="remark" resp="#claude">The number 10 is printed 2 times on the page (3.1, 3.2), with one footnote.</note></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Ine_3-1.whinote.n.1" n="1" source="#whitelock"><bibl><biblScope unit="page">400</biblScope></bibl><label>flogged</label><seg type="original" xml:lang="en">C.C.C.C., MS. 383, adds: “or (pay) the ‘hide-price’”, i.e. the sum to save him from being flogged.</seg></note>
      </div>
