        <note type="liebermannNote" subtype="textual" xml:id="Ine_3.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_3.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_3.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">freo <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">freo Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_3.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">sylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sylle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_3.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">scillinges <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">scillinges Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Wiederum (wie Ine 2) wohl aus einem Synodaldekret. <hi rend="italic">Vgl.</hi> Wi 9ff.; <hi rend="italic">Gl</hi> unfrei 14c. 15; Sonntag 3</seg><seg type="translation" xml:lang="en" source="#claude">Again (as Ine 2) probably from a synodal decree. <hi rend="italic">Cf.</hi> Wi 9ff.; <hi rend="italic">Gl</hi> unfrei 14c. 15; Sonntag 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_3.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Befreiung der vom Herrn durch Unzucht geschädigten Unfreien <hi rend="italic">s. d.</hi> 11</seg><seg type="translation" xml:lang="en" source="#claude">On the freeing of unfree persons wronged by their lord through unchastity <hi rend="italic">see</hi> that word 11</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_3.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Wie <hi rend="italic">o.</hi> 2⁵</seg><seg type="translation" xml:lang="en" source="#claude">As <hi rend="italic">above</hi> 2⁵</seg></note>
      </div>
