      <div type="clause" n="28">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 28</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 28"><pb n="651" ed="#liebermann"/><hi rend="bold"><hi rend="spaced">Quale</hi></hi><ptr type="liebermannNote" n="30" target="#ECfRetr_28.lnote.la.30"/> <hi rend="bold"><hi rend="spaced">consilium sapientes ceperunt de illis qui has leges seruare</hi></hi><ptr type="liebermannNote" n="11" target="#ECfRetr_28.lnote.la.11"/> <hi rend="bold"><hi rend="spaced">despexerint</hi></hi><ptr type="liebermannNote" n="31" target="#ECfRetr_28.lnote.la.31"/><hi rend="bold"><hi rend="spaced">.</hi></hi> Cum autem<ptr type="liebermannNote" n="11" target="#ECfRetr_28.lnote.la.11"/> <hi rend="bold">contingeret</hi><ptr type="liebermannNote" n="32" target="#ECfRetr_28.lnote.la.32"/>, quod aliqui<ptr type="liebermannNote" n="33" target="#ECfRetr_28.lnote.la.33"/> stulti <hi rend="bold">et improbi gratis et</hi><ptr type="liebermannNote" n="19" target="#ECfRetr_28.lnote.la.19"/> <hi rend="bold">nimis consuete</hi> erga uicinos suos forisfaciebant<ptr type="liebermannNote" n="34" target="#ECfRetr_28.lnote.la.34"/>, ceperunt<ptr type="liebermannNote" n="35" target="#ECfRetr_28.lnote.la.35"/> sapientes <hi rend="bold">ad</hi><ptr type="liebermannNote" n="36" target="#ECfRetr_28.lnote.la.36"/> <hi rend="bold">inuicem super</hi><ptr type="liebermannNote" n="37" target="#ECfRetr_28.lnote.la.37"/> <hi rend="bold">hoc habere</hi> consilium; et <hi rend="bold">statuerunt</hi><ptr type="liebermannNote" n="38" target="#ECfRetr_28.lnote.la.38"/> iusticiarios super quosque decem<ptr type="liebermannNote" n="39" target="#ECfRetr_28.lnote.la.39"/> friborgos<ptr type="liebermannNote" n="40" target="#ECfRetr_28.lnote.la.40"/>, quos decanos possumus <hi rend="bold">appellare;</hi> <ptr type="liebermannNote" n="41" target="#ECfRetr_28.lnote.la.41"/>Anglice <hi rend="bold">uero</hi><ptr type="liebermannNote" n="11" target="#ECfRetr_28.lnote.la.11"/> tenðe<ptr type="liebermannNote" n="42" target="#ECfRetr_28.lnote.la.42"/> heued<ptr type="liebermannNote" n="43" target="#ECfRetr_28.lnote.la.43"/> <hi rend="bold">dicti</hi> sunt, hoc<ptr type="liebermannNote" n="44" target="#ECfRetr_28.lnote.la.44"/> est caput<ptr type="liebermannNote" n="45" target="#ECfRetr_28.lnote.la.45"/> de decem.</ab>
        <note type="comparison" source="#liebermann" n="651"><label>printed alongside</label> <ref target="clause:ECf_28">ECf 28</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 651 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">De centurionibus et de capitalibus friborgiis, scilicet tiendeheued <hi rend="italic">Lond;</hi> De cent. et cap. frib. <hi rend="italic">Ld;</hi> Quid ad iustitiarios pertinebat <hi rend="italic">Cb;</hi> De pena non seruantium has leges <hi rend="italic">Db;</hi> Q. s. ce. co. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">De centurionibus et de capitalibus friborgiis, scilicet tiendeheued Lond; De cent. et cap. frib. Ld; Quid ad iustitiarios pertinebat Cb; De pena non seruantium has leges Db; Q. s. ce. co. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">-runt <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-runt Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">-tigerit <hi rend="italic">Hv;</hi> tig. <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tigerit Hv; tig. Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">quidam <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">quidam Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">-cerent <hi rend="italic">Ld;</hi> et <hi rend="italic">fügt zu Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cerent Ld; Va adds et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">sa. cep. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">sa. cep. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">ad i. <hi rend="italic">fehlt Hv K</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad i. lacking in Hv K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">cons. s. hoc ha. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">cons. s. hoc ha. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">constitu. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">constitu. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv;</hi> fr. X <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv; fr. X Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">fridb. <hi rend="italic">Va Ph;</hi> frithb. <hi rend="italic">Hv; so hier auch Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">fridb. Va Ph; frithb. Hv; so here also Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">isti <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds isti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">tende <hi rend="italic">Lb Va Hv;</hi> tiende <hi rend="italic">Lond;</hi> tien <hi rend="italic">Ld;</hi> tenthe <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">tende Lb Va Hv; tiende Lond; tien Ld; tenthe Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">heofod <hi rend="italic">Ld;</hi> eueth <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">heofod Ld; eueth Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">h. e. <hi rend="italic">fehlt Va;</hi> i. e. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. e. lacking in Va; i. e. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_28.lnote.la.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb</seg></note>
      </div>
