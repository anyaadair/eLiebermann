      <div type="clause" n="34.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 34.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 34.3" corresp="#wit-lat"><pb n="565" ed="#liebermann"/>Qui iustum iudicium ordinabiliter<ptr type="liebermannNote" n="37" target="#Hn_34-3.lnote.oe.37"/> habitum et legittime redditum inprobauerit, si regis accio sit, ouerseunesse iudicetur, id est L<ptr type="liebermannNote" n="r" target="#Hn_34-3.lnote.oe.r"/> sol. in<ptr type="liebermannNote" n="38" target="#Hn_34-3.lnote.oe.38"/> Westsexa<ptr type="liebermannNote" n="39" target="#Hn_34-3.lnote.oe.39"/> — si erga comitem [LX<ptr type="liebermannNote" n="s" target="#Hn_34-3.lnote.oe.s"/>] sol., erga hundretum XXX sol. ex<ptr type="liebermannNote" n="40" target="#Hn_34-3.lnote.oe.40"/> V den., qui faciunt<ptr type="liebermannNote" n="t" target="#Hn_34-3.lnote.oe.t"/> V mancas —, ut<ptr type="liebermannNote" n="u" target="#Hn_34-3.lnote.oe.u"/> solidus denariis<ptr type="liebermannNote" n="41" target="#Hn_34-3.lnote.oe.41"/> XII computetur; et deinceps in aliis<ptr type="liebermannNote" n="v" target="#Hn_34-3.lnote.oe.v"/> estimetur, sicut eorum ouerseunessa<ptr type="liebermannNote" n="42" target="#Hn_34-3.lnote.oe.42"/> erit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 565 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-3.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Normannisch, umgerechnet aus</hi> CXX <hi rend="italic">Cnuts; vgl.</hi> 29, 3. 35, 1. 37, 2&lt;sup&gt;e&lt;/sup&gt;. 76, 4<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Norman, converted from Cnut’s</hi> CXX<hi rend="italic">; cf.</hi> 29, 3. 35, 1. 37, 2&lt;sup&gt;e&lt;/sup&gt;. 76, 4<hi rend="italic">b</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-3.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">XL <hi rend="italic">Hss. Edd.; gebessert aus</hi> 35, 1<hi rend="italic">a</hi>. 87, 5; <hi rend="italic">Cnut</hi></seg><seg type="translation" xml:lang="en" source="#claude">XL <hi rend="italic">MSS Edd.; emended from</hi> 35, 1<hi rend="italic">a</hi>. 87, 5; <hi rend="italic">Cnut</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-3.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 35, 1. 69, 2. 76, 6<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 35, 1. 69, 2. 76, 6<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-3.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">vorausgesetzt dass. <hi rend="italic">Das Folgende gehört zu</hi> L sol.</seg><seg type="translation" xml:lang="en" source="#claude">provided that. <hi rend="italic">What follows belongs with</hi> L sol.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-3.lnote.oe.v" n="v" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">bei anderen Gerichtsherren werde die Geldbusse für Ungehorsam gegen ihr Gerichtsurtheil</seg><seg type="translation" xml:lang="en" source="#claude">in the case of other lords of courts, let the fine for disobedience to the judgment of their court be</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-3.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">ordinaliter <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">ordinaliter <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-3.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">in W. <hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">in W. <hi rend="italic">omitted in Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-3.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">-saxa <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">-saxa <hi rend="italic">Wh</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-3.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-3.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">XX duo den. <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">XX duo den. <hi rend="italic">K Co Or Gi</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-3.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">-senn. <hi rend="italic">Co;</hi> seun. <hi rend="italic">Or;</hi> -se <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">-senn. <hi rend="italic">Co;</hi> seun. <hi rend="italic">Or;</hi> -se <hi rend="italic">Wh</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-3.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Urteilschelte 3a; Ungehorsam 24.—<hi rend="italic">ordinaliter</hi>{37}—<hi rend="italic">XL</hi>{8}—<hi rend="italic">XXII den</hi>.{41}—<hi rend="italic">euer</hi>.{42} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Urteilschelte 3a; Ungehorsam 24.—<hi rend="italic">ordinaliter</hi>{37}—<hi rend="italic">XL</hi>{8}—<hi rend="italic">XXII den</hi>.{41}—<hi rend="italic">euer</hi>.{42} Rs</seg></note>
      </div>
