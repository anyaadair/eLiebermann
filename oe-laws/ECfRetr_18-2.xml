      <div type="clause" n="18.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 18.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 18.2"><pb n="644" ed="#liebermann"/>Murdritor<ptr type="liebermannNote" n="7" target="#ECfRetr_18-2.lnote.la.7"/> <hi rend="bold">uero</hi> uel<ptr type="liebermannNote" n="2" target="#ECfRetr_18-2.lnote.la.2"/> traditor <hi rend="bold">uel huiusmodi criminosus, quamuis</hi> rex eis<ptr type="liebermannNote" n="8" target="#ECfRetr_18-2.lnote.la.8"/> condonauerit uitam et<ptr type="liebermannNote" n="9" target="#ECfRetr_18-2.lnote.la.9"/> membra, <hi rend="bold">(tamen</hi><ptr type="liebermannNote" n="10" target="#ECfRetr_18-2.lnote.la.10"/><hi rend="bold">) secundum</hi><ptr type="liebermannNote" n="11" target="#ECfRetr_18-2.lnote.la.11"/> legem nulla<hi rend="bold">tenus</hi> in<ptr type="liebermannNote" n="12" target="#ECfRetr_18-2.lnote.la.12"/> patria remanebunt<ptr type="liebermannNote" n="13" target="#ECfRetr_18-2.lnote.la.13"/>, sed <hi rend="bold">statim</hi> iurabunt<ptr type="liebermannNote" n="14" target="#ECfRetr_18-2.lnote.la.14"/> se ituros ad mare <hi rend="bold">infra</hi> terminum <hi rend="bold">a</hi> iustitia eis<ptr type="liebermannNote" n="15" target="#ECfRetr_18-2.lnote.la.15"/> constitutum<ptr type="liebermannNote" n="16" target="#ECfRetr_18-2.lnote.la.16"/> <hi rend="bold">mox</hi> trans<hi rend="bold">freta</hi>turos<ptr type="liebermannNote" n="17" target="#ECfRetr_18-2.lnote.la.17"/>, quam cito <hi rend="bold">(et</hi><ptr type="liebermannNote" n="18" target="#ECfRetr_18-2.lnote.la.18"/><hi rend="bold">)</hi> nauem<ptr type="liebermannNote" n="19" target="#ECfRetr_18-2.lnote.la.19"/> habuerint<ptr type="liebermannNote" n="20" target="#ECfRetr_18-2.lnote.la.20"/> et uentum.</ab>
        <note type="comparison" source="#liebermann" n="644"><label>printed alongside</label> <ref target="clause:ECf_18-2">ECf 18.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 644 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-2.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">‘<hi rend="italic">nach strengem Recht</hi>’: <hi rend="italic">wenn ihnen nicht der König die Abschwörung erlässt. Anders meint Schreuer</hi> Verbrechenskonkurrenz 169 <hi rend="italic">aus Fränkischen Quellen:</hi> gegen Busszahlung</seg><seg type="translation" xml:lang="en" source="#claude">‘according to strict law’: unless the king remits the abjuration for them. Schreuer, Verbrechenskonkurrenz 169, takes it otherwise, from Frankish sources: against payment of compensation</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-2.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">-drator <hi rend="italic">Lb Va Hv K Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">-drator Lb Va Hv K Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-2.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-2.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">ei <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-2.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">et m. <hi rend="italic">übergeschr. Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">et m. written above Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-2.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Lb Va Lond Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Lb Va Lond Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-2.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">s. l. <hi rend="italic">am Rande Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. l. in the margin Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-2.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">remanebit in p. <hi rend="italic">Hv;</hi> prisonia <hi rend="italic">nur Hv’s Ed. Savile</hi></seg><seg type="translation" xml:lang="en" source="#claude">remanebit in p. Hv; prisonia only Hv’s ed. Savile</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-2.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">-bit <hi rend="italic">K Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-bit K Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-2.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">-bit se iturum <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-bit se iturum Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-2.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">ei dictum et mox <hi rend="italic">Hv;</hi> regis <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei dictum et mox Hv; regis Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-2.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Co adds et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-2.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">-rum <hi rend="italic">ohne</hi> quam—uentum <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rum without quam—uentum Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-2.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Lb Lond Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Lb Lond Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-2.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">h. n. <hi rend="italic">Cb K;</hi> se, <hi rend="italic">aber unterpunctirt fügt zu Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. n. Cb K; Lb adds se, but dotted for deletion</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-2.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">-runt <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">-runt Va</seg></note>
      </div>
