    <body>
      <div type="clause" n="76">
        <head><ref type="lawCode" target="law:Af">Af</ref> 76</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="76" corresp="#wit-e"><pb n="86" ed="#liebermann"/>Gif ða<ptr type="liebermannNote" n="17" target="#Af_76.lnote.oe.17"/> smalan sinwe<ptr type="liebermannNote" n="18" target="#Af_76.lnote.oe.18"/> mon forslea, geselle<ptr type="liebermannNote" n="2" target="#Af_76.lnote.oe.2"/> him mon VI<ptr type="liebermannNote" n="19" target="#Af_76.lnote.oe.19"/> scill. to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="76" corresp="#wit-h"><pb n="86" ed="#liebermann"/>Gif ða smalan sinwe mon<ptr type="liebermannNote" n="1" target="#Af_76.lnote.oe.1"/> forslea, gesylle<ptr type="liebermannNote" n="2" target="#Af_76.lnote.oe.2-2"/> him mon<ptr type="liebermannNote" n="1" target="#Af_76.lnote.oe.1"/> VI scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="76" corresp="#wit-b-no-prol"><pb n="86" ed="#liebermann"/>Gyf ða smalan<ptr type="liebermannNote" n="7" target="#Af_76.lnote.oe.7"/> synewan man forsléa, gesylle hi<hi rend="italic">m</hi> man syx scill' to bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="76" corresp="#wit-q"><pb n="87" ed="#liebermann"/>Si graciles nerui truncentur, VI<ptr type="liebermannNote" n="17" target="#Af_76.lnote.oe.17-2"/> sol. emendetur<ptr type="liebermannNote" n="18" target="#Af_76.lnote.oe.18-2"/> (culpa iudicetur).</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="92" ed="#attenborough"/>Gif ða smalan sinwe<ptr type="editorNote" n="8" target="#Af_76.attnote.fn.8"/> mon forslea, geselle him mon VI scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="79" corresp="#wit-e"><pb n="362" ed="#jurasinski-and-oliver"/>Gif ða smalan sinwe mon forslea, geselle him mon VI scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="87" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_76.lnote.de.1"/> jemand die ‘kleine’ Sehne<ptr type="liebermannNote" n="2" target="#Af_76.lnote.de.2"/> zerschlägt, gebe er ihm [dem Verletzten] 6 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone severs the ‘small’ sinew, let him give him [the injured man] 6 shillings as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="93" ed="#attenborough"/>If the small sinew [of a man] be damaged, 6 shillings shall be given to him as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="363" ed="#jurasinski-and-oliver"/>If someone injures the smaller sinew, let him be paid 6 shillings as compensation.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_76.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">ðæs <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæs Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_76.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">sinewan</hi> <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">sinewan</hi> Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_76.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">gesylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gesylle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_76.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">syx <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">syx Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_76.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geändert in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_76.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_76.lnote.oe.17-2" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">87</biblScope></bibl><seg type="original" xml:lang="de">XII <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">XII Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_76.lnote.oe.18-2" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">87</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> em. <hi rend="italic">Lond Hn</hi> 93, 33; <hi rend="italic">nur</hi> cu. iu. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">only em. Lond Hn 93, 33; only cu. iu. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_76.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. aus</hi> maran</seg><seg type="translation" xml:lang="en" source="#claude">altered from maran</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_76.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">63</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o.</hi> 75²</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 75²</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_76.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">63</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘Fusssohlensehne’ Price grundlos. B braucht schwache Dekl. von <hi rend="italic">sinu</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘Sinew of the sole of the foot’ Price, without grounds. B uses the weak declension of <hi rend="italic">sinu</hi></seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_76.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">92</biblScope></bibl><label>sinwe</label><seg type="original" xml:lang="en"><hi rend="italic">synewe</hi>. B.</seg></note>
      </div>
