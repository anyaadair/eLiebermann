      <div type="clause" n="69.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 69.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 69.1a" corresp="#wit-lat"><pb n="587" ed="#liebermann"/>Et wita<ptr type="liebermannNote" n="24" target="#Hn_69-1a.lnote.oe.24"/> et manbota dominis, sicut iustum est, ad<ptr type="liebermannNote" n="m" target="#Hn_69-1a.lnote.oe.m"/> modum ipsius were:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 587 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_69-1a.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht aus Ine</hi> 76 (<hi rend="italic">Hn</hi> 79, 1); <hi rend="italic">vgl.</hi> 87, 4; 7</seg><seg type="translation" xml:lang="en" source="#claude">perhaps from Ine 76 (Hn 79, 1); cf. 87, 4; 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_69-1a.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de">wyta eius m. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">wyta eius m. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_69-1a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de">Hier fällt <hi rend="italic">wite</hi> für blutig (<hi rend="italic">s. d. Gl</hi> 3) fechten an den Gerichtsherrn, Mannbusse (<hi rend="italic">s. d. Gl</hi> 6) an den Vassallitätsherrn, vielleicht neben Bussen für gebrochenen Schutz an den Herrn des Ortes—<hi rend="italic">Et w</hi>.{24} <hi rend="italic">est m</hi>.—69, 2 <hi rend="italic">thyh</hi>.{26}—<hi rend="italic">idem</hi>{26} <hi rend="italic">h. V mancas</hi>—<hi rend="italic">tpel</hi>.{27}—<hi rend="italic">mancas</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">Here the <hi rend="italic">wite</hi> for fighting to bloodshed (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 3) falls to the lord of the court, the manbot (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 6) to the vassal’s lord, perhaps alongside compensations for breach of protection to the lord of the place—<hi rend="italic">Et w</hi>.{24} <hi rend="italic">est m</hi>.—69, 2 <hi rend="italic">thyh</hi>.{26}—<hi rend="italic">idem</hi>{26} <hi rend="italic">h. V mancas</hi>—<hi rend="italic">tpel</hi>.{27}—<hi rend="italic">mancas</hi> Rs</seg></note>
      </div>
    </body>
