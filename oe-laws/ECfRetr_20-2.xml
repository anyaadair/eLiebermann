      <div type="clause" n="20.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 20.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 20.2"><pb n="645" ed="#liebermann"/><hi rend="bold">Quesitus</hi><ptr type="liebermannNote" n="37" target="#ECfRetr_20-2.lnote.la.37"/> <hi rend="bold">interim</hi><ptr type="liebermannNote" n="34" target="#ECfRetr_20-2.lnote.la.34"/> <hi rend="bold">et</hi> inuentus ad iusticiam <hi rend="bold">regis</hi> adduceretur<ptr type="liebermannNote" n="38" target="#ECfRetr_20-2.lnote.la.38"/>;</ab>
        <note type="comparison" source="#liebermann" n="645"><label>printed alongside</label> <ref target="clause:ECf_20-2">ECf 20.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 645 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-2.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">Questus <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">Questus Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-2.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi> [<hi rend="italic">ursprünglicher</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv [more original]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-2.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">ducetur <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">ducetur Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Sought meanwhile and found, he should be brought to the king's justice;</ab>
      </div>
    </body>
