    <body>
      <div type="clause" n="21.1">
        <head><ref type="lawCode" target="law:VIAtr">VI Atr</ref> 21.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="21.1" corresp="#wit-k"><pb n="252" ed="#liebermann"/>⁊ ealle Godes gerihta fyrþrige man georne, ealswa hit þearf is.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="21.1" corresp="#wit-d-incomplete"><pb n="252" ed="#liebermann"/>And ealle Godes gerihta friðige man georne, ealswa hit þearf is.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="21.1" corresp="#wit-k"><pb n="96" ed="#robertson"/>⁊ ealle Godes gerihta fyrþrige<ptr type="editorNote" n="6" target="#VIAtr_21-1.robnote.fn.6"/> man georne, ealswa hit þearf is.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-k"><pb n="168" ed="#rabin-doml"/>And ealle Godes gerihta fyrþrige man georne, ealswa hit þearf is.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="253" ed="#liebermann"/>Und alle Kirchengerechtsame fördere (schütze<ptr type="liebermannNote" n="1" target="#VIAtr_21-1.lnote.de.1"/> <hi rend="italic">D</hi>) man willig, wie es nöthig ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let all God's dues be eagerly promoted (protected, D), as is needful.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-k"><ptr type="editorNote" n="1" target="#VIAtr_21-1.robnote.n.1"/><pb n="97" ed="#robertson"/>And all God's dues shall be promptly rendered, as the occasion requires.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-k"><pb n="169" ed="#rabin-doml"/>And all God’s dues are to be given willingly, just as is required.</ab>
        <note type="comparison" source="#liebermann" n="253"><ref target="clause:VAtr_12-2">V Atr 12.2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 12, 2</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VIAtr_43">VI Atr 43</ref>; <ref target="clause:VIIIAtr_14">VIII Atr 14</ref>; <ref target="clause:ICn_14">I Cn 14</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="356"><ref target="clause:ICn_14">I Cn 14–14.1</ref></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VIAtr_21-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">176</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">friðige</hi> V 12, 2 D. I Cn 14 A, wo dies benutzt ist</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">friðige</hi> V 12, 2 D. I Cn 14 A, where this is used</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VIAtr_21-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">333</biblScope></bibl><seg type="original" xml:lang="en">Cf. V, 12, 2; Wulfstan, pp. 272, 311.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="VIAtr_21-1.robnote.fn.6" n="6" source="#robertson"><bibl><biblScope unit="page">96</biblScope></bibl><label>fyrþrige</label><seg type="original" xml:lang="en"><hi rend="italic">friðige</hi> D.</seg></note>
      </div>
