        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-7a.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">æhtamen <hi rend="italic">Quadr. R statt</hi> eahta [<hi rend="italic">d. i.</hi> 8] men, <hi rend="italic">verwechselt mit</hi> æhtemen <hi rend="italic">Rect.</hi> 9, 1</seg><seg type="translation" xml:lang="en" source="#claude">æhtamen Quadr. R instead of eahta [i.e. 8] men, confused with æhtemen Rect. 9, 1</seg></note>
