      <div type="clause" n="48.3">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 48.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="48.3" corresp="#wit-g-a"><pb n="346" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="4" target="#IICn_48-3.lnote.oe.4-2"/> he gewyrce, þ<hi rend="italic">æt</hi> man hine afylle, þurh þ<hi rend="italic">æt</hi> þe he ongean riht geondbyrde<ptr type="liebermannNote" n="5" target="#IICn_48-3.lnote.oe.5"/>, gif man þ<hi rend="italic">æt</hi> gesoðige, licge ægilde.<ptr type="liebermannNote" n="6" target="#IICn_48-3.lnote.oe.6"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="48.3" corresp="#wit-b"><pb n="346" ed="#liebermann"/>Gyf he gewyrce, þ<hi rend="italic">æt</hi> man hine afylle, ðurh þ<hi rend="italic">æt</hi> ðe he ongean riht geanbyrde, gif [mann<ptr type="liebermannNote" n="1" target="#IICn_48-3.lnote.oe.1"/>] þ<hi rend="italic">æt</hi> gesoðian mage, licge he ǽgylde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="48.3" corresp="#wit-a"><pb n="346" ed="#liebermann"/>Gif he gewyrce, þ<hi rend="italic">æt</hi> man hine afylle, þurh þ<hi rend="italic">æt</hi> þe he ongean riht geanbyrde, gif man þ<hi rend="italic">æt</hi> gesoðige, licge agilde.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="48.3" corresp="#wit-q"><pb n="347" ed="#liebermann"/>Si efficiat, ut occidatur, per hoc quod contra rectum resistat, si hoc inueritetur<ptr type="liebermannNote" n="3" target="#IICn_48-3.lnote.oe.3-2"/>, inultus (insolutus<ptr type="liebermannNote" n="4" target="#IICn_48-3.lnote.oe.4"/>) iaceat.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="48.3" corresp="#wit-inst-cn"><pb n="347" ed="#liebermann"/>Et si ipse occisus<ptr type="liebermannNote" n="3" target="#IICn_48-3.lnote.oe.3-3"/> fuerit, propterea<ptr type="liebermannNote" n="4" target="#IICn_48-3.lnote.oe.4-3"/> quia contra iusticiam pugnauerit, iaceat impersolutus, quod Angli dicunt<ptr type="liebermannNote" n="5" target="#IICn_48-3.lnote.oe.5-2"/> (uocant) ægylde.<ptr type="liebermannNote" n="6" target="#IICn_48-3.lnote.oe.6-2"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="48.3" corresp="#wit-cons-cn"><pb n="347" ed="#liebermann"/>[48, 3] Si uero efficit, ut quis eum ibi occidat, uiribus uolendo iusticie resistere, si hoc probari potest, iaceat insolubilis.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="48.3" corresp="#wit-b"><pb n="200" ed="#robertson"/>Gyf he gewyrce þæt man hine afylle ðurh þæt ðe he ongean riht geanbyrde, gif mann þæt gesoðian mage<ptr type="editorNote" n="7" target="#IICn_48-3.robnote.fn.7"/>, licge he<ptr type="editorNote" n="5" target="#IICn_48-3.robnote.fn.5"/> ǽgylde.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="280" ed="#rabin-doml"/>Gyf he gewyrce, þæt man hine afylle, þurh þæt þe he ongean riht geondbyrde, gif man þæt gesoðige, licge ægilde.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="346" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#IICn_48-3.lnote.de.1"/> er bewirkt, dass er erschlagen wird dadurch, dass er gegen Rechts[forderung] ankämpft(e?), wenn dies erwiesen wird (werden kann <hi rend="italic">B</hi>), liege er, ohne [seiner Sippe durch den Todtschläger] entgolten zu werden.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he brings it about that he is killed because he fights against right, if that is proved (can be proved, B), let him lie uncompensated [to his kin by the slayer].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_48-3.robnote.n.1"/><pb n="201" ed="#robertson"/>If he so acts as to bring about his own death by setting himself against the law, no compensation shall be paid for him, if this can be proved.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="469" ed="#whitelock"/>If he so acts that he is slain because he offered resistance against the law, and that is proved true, no wergild is to be paid for him.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="281" ed="#rabin-doml"/>If he acts in such a way as to cause his own death through opposition to the law, he shall die without compensation, if this can be proved.</ab>
        <note type="comparison" source="#liebermann" n="346"><ref target="clause:EGu_6-7">EGu 6.7</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 6, 7</note>
        <note type="editorial">Liebermann compares EGu 6.7.; BR: added from Gesetze I p. 347, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">gesoðige: gesoðian mæge</note>
        <note type="textual" source="#rabin-doml">licge: licge he B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_48-3.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">347</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> uolentem<hi rend="italic">?</hi></seg><seg type="translation" xml:lang="en" source="#claude">read uolentem?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_48-3.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">346</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_48-3.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">347</biblScope></bibl><seg type="original" xml:lang="de">-uenietur <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uenietur K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_48-3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">347</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above Dm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_48-3.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">346</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_48-3.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">346</biblScope></bibl><seg type="original" xml:lang="de">geanb. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">geanb. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_48-3.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">346</biblScope></bibl><seg type="original" xml:lang="de">ag. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ag. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_48-3.lnote.oe.3-3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">347</biblScope></bibl><seg type="original" xml:lang="de">f. o. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. o. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_48-3.lnote.oe.4-3" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">347</biblScope></bibl><seg type="original" xml:lang="de">propt. — pugn. <hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">propt. — pugn. lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_48-3.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">347</biblScope></bibl><seg type="original" xml:lang="de">di. <hi rend="italic">H Di;</hi> u. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">di. H Di; u. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_48-3.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">347</biblScope></bibl><seg type="original" xml:lang="de">ægilde <hi rend="italic">Di;</hi> igilde <hi rend="italic">S;</hi> eðgelde <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">ægilde Di; igilde S; eðgelde Cb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_48-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">209</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Benutzt durch Hn 11, 11</seg><seg type="translation" xml:lang="en" source="#claude">Used by Hn 11, 11</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_48-3.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">357</biblScope></bibl><seg type="original" xml:lang="en">Cf. E. and G. 6, 7.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_48-3.robnote.fn.5" n="5" source="#robertson"><bibl><biblScope unit="page">200</biblScope></bibl><label>⁊</label><seg type="original" xml:lang="en">Om. G, A, Ld.</seg></note>
