    <body>
      <div type="clause" n="7[b]">
        <head><ref type="lawCode" target="law:Ger">Ger</ref> 7[b]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7[b]" corresp="#wit-b"><pb n="454" ed="#liebermann"/>[7[b]] selre him his<ptr type="liebermannNote" n="1*" target="#Ger_7-b.lnote.oe.1_"/> æfre of folgoðe ðonne on, gyf hine magan wyldan ða ðe he scolde<ptr type="liebermannNote" n="1" target="#Ger_7-b.lnote.oe.1"/> wealdan;</ab>
        <ab type="editionText" xml:lang="ang" source="#gobbitt" n="22.11" corresp="#wit-b">Selre him his æfre of folgoðe ðonne on . gyf hine magan wyldan ða ðe he scolde wealdan .</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-b"><pb n="334" ed="#rabin-doml"/>selre him is æfre of folgoðe ðonne on, gyf hine magan wyldan ða ðe he scolde wealdan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="454" ed="#liebermann"/>besser für ihn ist, stets ausser Amte als darin [sein<ptr type="liebermannNote" n="f" target="#Ger_7-b.lnote.de1.f"/>], wenn ihn díe beherrschen können, die er regieren sollte;</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">it is better for him always [to be] out of office than in it, if those whom he should rule can rule him;</ab>
        <ab type="translation" xml:lang="en" source="#gobbitt" corresp="#wit-b">[It is] better [use of] him if he is always out labouring than in [his position], if those whom he should govern would rule him.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-b"><pb n="335" ed="#rabin-doml"/>it would always be better for him to be out of service than in if he would be governed by those whom he should govern.</ab>
        <note type="editorial">B's ‘his’ stands for ‘is’ (so also in B at II Cn 75 f.). B's ‘scolde’ stands so.</note>
        <note type="textual" source="#rabin-doml">is: his B</note>
        <note type="liebermannNote" subtype="textual" xml:id="Ger_7-b.lnote.oe.1_" n="1*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">454</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">für</hi> is; <hi rend="italic">in B ebenso II Cn.</hi> 75. 76; hreaferas <hi rend="italic">II</hi> ⁊</seg><seg type="translation" xml:lang="en" source="#claude">for is; likewise in B II Cn. 75. 76; hreaferas II ⁊</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ger_7-b.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">454</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="Ger_7-b.lnote.de1.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">454</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ellipse des Infinitivs</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">ellipsis of the infinitive</hi></seg></note>
      </div>
    </body>
  </text>
