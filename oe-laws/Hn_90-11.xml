        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 88, 6<hi rend="italic">b</hi>; <hi rend="italic">vgl.</hi> 70, 12<hi rend="italic">c</hi>. 90, 11<hi rend="italic">d</hi></seg><seg type="translation" xml:lang="en" source="#claude">as 88, 6<hi rend="italic">b</hi>; cf. 70, 12<hi rend="italic">c</hi>. 90, 11<hi rend="italic">d</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
