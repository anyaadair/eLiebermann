        <dictScrap type="liebermann"><hi rend="bold">folcgemot</hi> <hi rend="italic">Staatsbürger-Versammlung, ordentliches Gericht; <ref type="abbreviation" target="gram:Dativ"><abbr>dt</abbr></ref>:</hi> ~te <ref type="lawCode" target="law:Af">Af</ref> 34. <ref type="lawCode" target="law:IIAs">II As</ref> 2. 12 (folcmote <ref type="lawCode" target="law:Ld">Ld</ref> <ref type="lawCode" target="law:So">So</ref>; folcimoto <ref type="lawCode" target="law:Quadr">Q</ref>, <hi rend="italic"><ref type="abbreviation" target="gram:Variante"><abbr>Var.</abbr></ref></hi> folkesim-, folcm-). V 1,1 | <hi rend="italic"><ref type="abbreviation" target="gram:accusativus"><abbr>ac</abbr></ref>:</hi> ~ <ref type="lawCode" target="law:Af">Af</ref> 38,1 (folcmot <ref type="lawCode" target="law:Quadr">Q</ref> <hi rend="italic"><ref type="abbreviation" target="gram:Variante"><abbr>Var.</abbr></ref>;</hi> id est populi placitum <ref type="lawCode" target="law:Quadr">Q</ref>. <ref type="lawCode" target="law:InCn">In Cn</ref>); <hi rend="italic">synonym <ref type="abbreviation" target="gram:mit"><abbr>mit</abbr></ref></hi> gemot 38; <ref type="lawCode" target="law:ICn">I Cn</ref> 15. <ref type="lawCode" target="law:Northu">Northu</ref> 55 | <hi rend="italic"><ref type="abbreviation" target="gram:Plural"><abbr>pl</abbr></ref> <ref type="abbreviation" target="gram:Genitiv"><abbr>gn</abbr></ref>:</hi> ~ta <ref type="lawCode" target="law:VAtr">V Atr</ref> 13,1 = <ref type="lawCode" target="law:VIAtr">VI</ref> 22,1 [<hi rend="italic"><ref type="abbreviation" target="gram:dafur"><abbr>dafür</abbr></ref></hi> folciscra gemota 44]. — <hi rend="italic"><ref type="abbreviation" target="gram:ersetztDurch"><abbr>Ersetzt durch</abbr></ref></hi> folces (ge)mot [<hi rend="italic"><ref type="abbreviation" target="gram:siehe"><abbr>s.</abbr></ref></hi> folc]. <hi rend="italic">Nur ein Londoner, im</hi> 13. <hi rend="italic"><ref type="abbreviation" target="gram:Jahrhundert"><abbr>Jh</abbr></ref>., gibt fälschend</hi> folkesmoth <hi rend="italic">die <ref type="abbreviation" target="gram:Bedeutung"><abbr>Bed.</abbr></ref>: ‘Reichsversammlung’</hi> <ref type="lawCode" target="law:Lond">Lond</ref> <ref type="lawCode" target="law:ECf">ECf</ref> 32 <ref type="lawCode" target="law:MsA">A</ref> 3—6, <hi rend="italic">getrennt <ref type="abbreviation" target="gram:vom"><abbr>vom</abbr></ref></hi> [<hi rend="italic">historisch echten</hi>] aliud folkmot in quolibet comitatu <ref type="lawCode" target="law:B">B</ref> 8</dictScrap>
