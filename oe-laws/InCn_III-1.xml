      <div type="clause" n="III 1">
        <head><ref type="lawCode" target="law:InCn">In Cn</ref> III 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="In Cn III 1" corresp="#wit-lat"><pb n="613" ed="#liebermann"/><hi rend="small">Si quis aliquid</hi><ptr type="liebermannNote" n="1" target="#InCn_III-1.lnote.oe.1"/><hi rend="small">, <hi rend="spaced">pro aliqua forisfactura</hi>, accipiat</hi><ptr type="liebermannNote" n="a" target="#InCn_III-1.lnote.oe.a"/><hi rend="small">, antequam iuste</hi><ptr type="liebermannNote" n="2" target="#InCn_III-1.lnote.oe.2"/><hi rend="small"> rectitudinem petat, reddat quod accepit et</hi><ptr type="liebermannNote" n="3" target="#InCn_III-1.lnote.oe.3"/><hi rend="small"> secundo persoluat; et</hi> <seg type="recension">(regi<ptr type="liebermannNote" n="4" target="#InCn_III-1.lnote.oe.4"/>)</seg> <hi rend="small">quadraginta</hi><ptr type="liebermannNote" n="b" target="#InCn_III-1.lnote.oe.b"/><hi rend="small"> solidos reddat</hi><ptr type="liebermannNote" n="5" target="#InCn_III-1.lnote.oe.5"/> <seg type="recension">(aut<ptr type="liebermannNote" n="6" target="#InCn_III-1.lnote.oe.6"/> illi<ptr type="liebermannNote" n="c" target="#InCn_III-1.lnote.oe.c"/>)</seg> qui<ptr type="liebermannNote" n="7" target="#InCn_III-1.lnote.oe.7"/> habet sacam et socnam suam; et insuper prętium suum<ptr type="liebermannNote" n="5" target="#InCn_III-1.lnote.oe.5"/> domino<ptr type="liebermannNote" n="9" target="#InCn_III-1.lnote.oe.9"/> suo.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 613 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Zwangspfand</hi> (nam <hi rend="italic">Cb u. S.</hi> 617) <hi rend="italic">wie</hi> II 19</seg><seg type="translation" xml:lang="en" source="#claude">distraint (nam Cb below p. 617) as in II 19</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">XXX <hi rend="italic">Ine; Verf. rechnet spätere</hi> oferhyrnes <hi rend="italic">von</hi> 120 scil. <hi rend="italic">um, als meine</hi> scilling <hi rend="italic">Mercisch</hi> ⅓ solidus</seg><seg type="translation" xml:lang="en" source="#claude">XXX Ine; the author converts the later oferhyrnes of 120 scil., as if scilling meant the Mercian ⅓ solidus</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch</hi> II 15a. 28. 66. III 3 <hi rend="italic">berücksichtigt Verf. privaten Gerichtsertrag</hi></seg><seg type="translation" xml:lang="en" source="#claude">in II 15a. 28. 66. III 3 too the author takes account of private profits of jurisdiction</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">pro a. f. aliquid <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">pro a. f. aliquid Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">iure <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">iure T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">doppelt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">twice Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Lb S Ct; fehlt H Di Rl T Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Lb S Ct; missing in H Di Rl T Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lb S Ct</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Lb S Ct</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">a. i. <hi rend="italic">aus S; fehlt H Di Rl T Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. i. from S; missing in H Di Rl T Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">qui h. <hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui h. missing in Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">-ni sui <hi rend="italic">Lb S Ct</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ni sui Lb S Ct</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">332</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Selbsthilfe 4. a; Ungehorsam 20; das Wergeld (<hi rend="italic">s. d. Gl</hi> 30n) als Strafe an den Herrn neben dem Strafgeld an private Gerichtsbarkeit (<hi rend="italic">s. d. Gl</hi> 20 u. 22ff.) ist beispiellos und kaum glaublich</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Selbsthilfe 4. a; Ungehorsam 20; wergild (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 30n) as a penalty payable to the lord alongside the fine payable to a private jurisdiction (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 20 and 22ff.) is unparalleled and scarcely credible</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat"><hi rend="small">If anyone takes something <hi rend="spaced">for some forfeiture</hi> before he justly seeks right, he shall give back what he took and pay a second time; and</hi> <seg type="recension">(to the king)</seg> <hi rend="small">shall pay forty shillings</hi> <seg type="recension">(or to him)</seg> who has his sake and soke; and in addition his price to his lord.</ab>
      </div>
    </body>
