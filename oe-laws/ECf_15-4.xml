    <body>
      <div type="clause" n="15.4">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 15.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 15.4"><pb n="641" ed="#liebermann"/>Sed quia uilla<ptr type="liebermannNote" n="18" target="#ECf_15-4.lnote.la.18"/> omnino confundebatur<ptr type="liebermannNote" n="c" target="#ECf_15-4.lnote.la.fn.c"/>, prouiderunt<ptr type="liebermannNote" n="19" target="#ECf_15-4.lnote.la.19"/> barones, quod per hundredum colligerentur<ptr type="liebermannNote" n="20" target="#ECf_15-4.lnote.la.20"/> et sigillarentur<ptr type="liebermannNote" n="21" target="#ECf_15-4.lnote.la.21"/> sigillo alicuius baronum<ptr type="liebermannNote" n="22" target="#ECf_15-4.lnote.la.22"/> comitatus et deportarentur<ptr type="liebermannNote" n="23" target="#ECf_15-4.lnote.la.23"/> ad thesaurum<ptr type="liebermannNote" n="24" target="#ECf_15-4.lnote.la.24"/> regis; quas<ptr type="liebermannNote" n="25" target="#ECf_15-4.lnote.la.25"/> ille seruaret per annum<ptr type="liebermannNote" n="d" target="#ECf_15-4.lnote.la.fn.d"/> integrum.</ab>
        <note type="comparison" source="#liebermann" n="641"><label>printed alongside</label> <ref target="clause:ECfRetr_15-4">ECf retr 15.4</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 641 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-4.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Haftung der Hundertschaft siegte; aber sonst unbekannt ist die vom Verf. behauptete Gesetzesreform</hi></seg><seg type="translation" xml:lang="en" source="#claude">the liability of the hundred prevailed; but the legal reform the author asserts is otherwise unknown</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-4.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">Jahr und Tag, <hi rend="italic">wie Retr. zufügt, stimmt nicht zur Exchequertagung zweimal jährlich, und entstammt also vielleicht der Frist für Ablieferung eines Schuldigen ans Gericht, nach deren Ablauf der Bürge das Verpfändete verlor;</hi> Leis Wl 3, 4; In. Cn. II 31, 1</seg><seg type="translation" xml:lang="en" source="#claude">year and day, as the Retractator adds, does not fit the Exchequer sitting twice a year, and so perhaps derives from the term for delivering a guilty man to the court, after which the surety lost what he had pledged; Leis Wl 3, 4; In. Cn. II 31, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-4.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">o. u. <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">o. u. Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-4.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-debant <hi rend="italic">Rl;</hi> -dent <hi rend="italic">Do;</hi> uiderunt <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">-debant Rl; -dent Do; uiderunt S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-4.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-retur <hi rend="italic">Rl S Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">-retur Rl S Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-4.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-retur <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">-retur S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-4.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-nis <hi rend="italic">Hk S Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nis Hk S Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-4.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-retur <hi rend="italic">S;</hi> -tabantur <hi rend="italic">Ad;</hi> -abatur <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-retur S; -tabantur Ad; -abatur Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-4.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Rl Hk Hr Ad Do;</hi> thesaurarium <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Rl Hk Hr Ad Do; thesaurarium S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-4.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">quos <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">quos Hk</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But because the vill was utterly ruined, the barons provided that they should be collected through the hundred and sealed with the seal of one of the barons of the shire and carried to the king's treasury; and he should keep them for a whole year.</ab>
      </div>
    </body>
