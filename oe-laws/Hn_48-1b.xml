        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 48.1b" corresp="#wit-lat"><pb n="571" ed="#liebermann"/>Quando<ptr type="liebermannNote" n="19" target="#Hn_48-1b.lnote.oe.19"/> itaque aliquid<ptr type="liebermannNote" n="20" target="#Hn_48-1b.lnote.oe.20"/> habetur in inplacitacionibus pretendendum, in inculpacionibus ostendatur; et ad consilium de implacitacione non exeat qui placitare non deliberat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 571 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-1b.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">Quod <hi rend="italic">Or;</hi> Quum <hi rend="italic">Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Quod Or; Quum edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-1b.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">-quis habeatur <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-quis habeatur Lond</seg></note>
