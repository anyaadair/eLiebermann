      <div type="clause" n="64.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 64.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 64.1" corresp="#wit-lat"><pb n="583" ed="#liebermann"/>Omnis<ptr type="liebermannNote" n="m" target="#Hn_64-1.lnote.oe.m"/> tihla<ptr type="liebermannNote" n="32" target="#Hn_64-1.lnote.oe.32"/> tractetur anteiuramento<ptr type="liebermannNote" n="m" target="#Hn_64-1.lnote.oe.m"/><ptr type="liebermannNote" n="33" target="#Hn_64-1.lnote.oe.33"/> plano<ptr type="liebermannNote" n="34" target="#Hn_64-1.lnote.oe.34"/> uel<ptr type="liebermannNote" n="n" target="#Hn_64-1.lnote.oe.n"/> obseruato, sepius<ptr type="liebermannNote" n="o" target="#Hn_64-1.lnote.oe.o"/> aut semel, sicut loci consuetudo erit, (uel<ptr type="liebermannNote" n="35" target="#Hn_64-1.lnote.oe.35"/> compellans precesserit, iuxta rei meritum et cause modum).</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 583 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht aus II As.</hi> 23, 2</seg><seg type="translation" xml:lang="en" source="#claude">perhaps from II As. 23, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de">schlicht oder gestabt (64, 1<hi rend="italic">c</hi>; <hi rend="italic">e</hi>; <hi rend="italic">f</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">plain or formal (64, 1<hi rend="italic">c</hi>; <hi rend="italic">e</hi>; <hi rend="italic">f</hi>)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Schwörer im Eide, so ist Erholung gestattet, bis das Urtheil feststellt, er sei ge- oder misslungen</hi></seg><seg type="translation" xml:lang="en" source="#claude">if the swearer makes a slip in the oath, a fresh attempt is allowed until the judgment establishes that it has succeeded or failed</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de">tihtla <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">tihtla <hi rend="italic">Wi</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de">-tum <hi rend="italic">Lond;</hi> iuramentum <hi rend="italic">Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tum Lond; iuramentum Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de">quod obseruando <hi rend="italic">statt</hi> p. u. o. <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod obseruando instead of p. u. o. K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de">uel — modum <hi rend="italic">nicht in Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel — modum not in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Eideswiederholung 5; Stabeid 3.—Am Rande spät: <hi rend="italic">Quod placitandum est pro loci consuetudine</hi>—<hi rend="italic">-tum</hi>{32} <hi rend="italic">u. observando</hi> ohne <hi rend="italic">pl</hi>.—<hi rend="italic">uel</hi>{35} . . <hi rend="italic">modum</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Eideswiederholung 5; Stabeid 3.—In the margin, in a late hand: <hi rend="italic">Quod placitandum est pro loci consuetudine</hi>—<hi rend="italic">-tum</hi>{32} <hi rend="italic">u. observando</hi> without <hi rend="italic">pl</hi>.—<hi rend="italic">uel</hi>{35} . . <hi rend="italic">modum</hi> Rs</seg></note>
      </div>
    </body>
