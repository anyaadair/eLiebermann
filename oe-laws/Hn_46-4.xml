      <div type="clause" n="46.4">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 46.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 46.4" corresp="#wit-lat"><pb n="570" ed="#liebermann"/>In<ptr type="liebermannNote" n="w" target="#Hn_46-4.lnote.oe.w"/> aliis querat accusatus consilium et habeat<ptr type="liebermannNote" n="27" target="#Hn_46-4.lnote.oe.27"/> ab amicis et<ptr type="liebermannNote" n="27*" target="#Hn_46-4.lnote.oe.27_"/> parentibus<ptr type="liebermannNote" n="28" target="#Hn_46-4.lnote.oe.28"/> suis — quod nulli iure debet defendi —, maxime eorum quos secum adduxerit uel ad placitum suum rogauerit; et si[c<ptr type="liebermannNote" n="29" target="#Hn_46-4.lnote.oe.29"/>] in consilio suo fiducialiter rerum ueritatem fateatur, ut de placito uel de pace salubrius uideatur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 570 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-4.lnote.oe.w" n="w" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bei nicht capitalen Verbrechen; vgl. o. Anm. r; wiederholt</hi> 48, 1; <hi rend="italic">vgl.</hi> 47. <hi rend="italic">Die</hi> Summa leg. Norm. 84, 4 <hi rend="italic">giebt dem</hi> de simplici querela personali querelatus licenciam consulendi, si requirat</seg><seg type="translation" xml:lang="en" source="#claude">in the case of non-capital offences; cf. above note r; repeated 48, 1; cf. 47. The Summa leg. Norm. 84, 4 gives the de simplici querela personali querelatus licenciam consulendi, si requirat</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-4.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-4.lnote.oe.27_" n="27*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">a <hi rend="italic">fügen zu Edd. ohne Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">a added by edd. without MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-4.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">paribus <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">paribus Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-4.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">si <hi rend="italic">Sc Hg; fehlt übr.</hi> [<hi rend="italic">vielleicht besser</hi>]; <hi rend="italic">vgl. S.</hi> 569&lt;sup&gt;8&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude">si Sc Hg; lacking in the rest [perhaps better]; cf. p. 569&lt;sup&gt;8&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-4.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Rechtsgang 14aff.—<hi rend="italic">paribus</hi>{28}—ohne <hi rend="italic">sic</hi>{29} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Rechtsgang 14aff.—<hi rend="italic">paribus</hi>{28}—without <hi rend="italic">sic</hi>{29} Rs</seg></note>
      </div>
