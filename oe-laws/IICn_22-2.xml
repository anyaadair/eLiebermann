      <div type="clause" n="22.2">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 22.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.2" corresp="#wit-g-a"><pb n="324" ed="#liebermann"/>And gyf<ptr type="liebermannNote" n="14" target="#IICn_22-2.lnote.oe.14"/> þegen hæbbe getrywne man to foraðe<ptr type="liebermannNote" n="15" target="#IICn_22-2.lnote.oe.15"/> for hine, þ<hi rend="italic">æt</hi> swa sig<ptr type="liebermannNote" n="16" target="#IICn_22-2.lnote.oe.16-2"/>; gyf<ptr type="liebermannNote" n="14" target="#IICn_22-2.lnote.oe.14"/> he næbbe, ofga sylf his spæce.<ptr type="liebermannNote" n="17" target="#IICn_22-2.lnote.oe.17-2"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.2" corresp="#wit-b"><pb n="324" ed="#liebermann"/>⁊ gyf ðegen hæbbe getreowe<ptr type="liebermannNote" n="5" target="#IICn_22-2.lnote.oe.5"/> man to foraðe for híne, þ<hi rend="italic">æt</hi> swa sy; gyf he næbbe, ofga sylf his spæce.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.2" corresp="#wit-a"><pb n="324" ed="#liebermann"/>⁊ gif þegen hæbbe getrywne man to foraðe for hine, þ<hi rend="italic">æt</hi> swa sy; gif he næbbe, ofga sylf his spæce.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="22.2" corresp="#wit-q"><pb n="325" ed="#liebermann"/>Si tainus habeat<ptr type="liebermannNote" n="16" target="#IICn_22-2.lnote.oe.16"/> credibilem hominem ad<ptr type="liebermannNote" n="17" target="#IICn_22-2.lnote.oe.17"/> anteiuramentum pro eo, sit; si non habeat<ptr type="liebermannNote" n="16" target="#IICn_22-2.lnote.oe.16"/>, ipse tainus causam suam preiuret.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.2" corresp="#wit-inst-cn"><pb n="325" ed="#liebermann"/>Si liberalis homo, id<ptr type="liebermannNote" n="20" target="#IICn_22-2.lnote.oe.20"/> est þegen<ptr type="liebermannNote" n="21" target="#IICn_22-2.lnote.oe.21"/>, habet fidelem hominem, qui pro eo possit iurare praeiuramentum<ptr type="liebermannNote" n="22" target="#IICn_22-2.lnote.oe.22"/> (id<ptr type="liebermannNote" n="23" target="#IICn_22-2.lnote.oe.23"/> est foraþ), ita sit; si autem non habet, ipsemet iuret.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="22.2" corresp="#wit-cons-cn"><pb n="325" ed="#liebermann"/>Et si procer (uel uirro) fidelem hominem habeat, quem ad preiuramentum pro se ponat, hoc illi licet; sin autem, ipsemet attingat.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="22.2" corresp="#wit-b"><pb n="184" ed="#robertson"/>⁊ gyf ðegen hæbbe getreowe man to foraðe for híne þæt swa sy; gyf he næbbe, ofga sylf his spæce.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="264" ed="#rabin-doml"/>And gyf þegen hæbbe getrywne man to foraðe for hine, þæt swa sig; gyf he næbbe, ofga sylf his spæce.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="325" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#IICn_22-2.lnote.de.1"/> wenn ein Thegn einen glaubwürdigen<ptr type="liebermannNote" n="2" target="#IICn_22-2.lnote.de.2"/> Vasallen statt seiner zum Klageeid-Leisten hat, so geschehe das also; wenn<ptr type="liebermannNote" n="3" target="#IICn_22-2.lnote.de.3"/> er keinen hat, beginne er seine Processklage selbst.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if a thegn has a trustworthy man to swear the fore-oath for him, let it be so; if he has none, let him bring his suit himself.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="185" ed="#robertson"/>And if a thegn has a trustworthy man to give his oath of accusation for him, he may be allowed to make use of him; if he has not, he must begin his case in person.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="465" ed="#whitelock"/>And if a thegn has a trustworthy man to give the preliminary oath in his stead, that may be so done; if he has not, he is himself to set on foot his suit.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="265" ed="#rabin-doml"/>And if a thane has a trustworthy man to make a claim on his behalf, he may use him; if he does not, then he must make the claim himself.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Gethyn_3">Geþyncðo 3</ref>; <ref target="clause:Gethyn_4">Geþyncðo 4</ref></note>
        <note type="editorial">BR: added from Gesetze I p. 325, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de">u. u. <hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. u. lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de">iur. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">iur. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de">habet <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">habet Dm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de">-aþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-aþ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-2.lnote.oe.16-2" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-2.lnote.oe.17-2" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de">spræce <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">spræce Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de">i. þ. <hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. þ. lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de">thein <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">thein S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-2.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de">post iur. <hi rend="italic">Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">post iur. Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_22-2.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">gleichzeitig übergeschr. H; fehlt Cb Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above contemporaneously H; lacking in Cb Lb S</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_22-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">205</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Dies und 22, 3 übernimmt derselbe 12 aus Inst</seg><seg type="translation" xml:lang="en" source="#claude">This and 22, 3 are taken over from Inst by the same, 12</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_22-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">205</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. u</hi>. 30, 1; Klageeid 5c</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. below</hi> 30, 1; Klageeid 5c</seg></note>
