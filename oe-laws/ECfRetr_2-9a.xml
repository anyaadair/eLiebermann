      <div type="clause" n="2.9a">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 2.9a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 2.9a"><pb n="629" ed="#liebermann"/><hi rend="bold">Ueruntamen</hi> si <hi rend="bold">quis arrogans</hi> pro episcopi iustitia emendare noluerit<ptr type="liebermannNote" n="20" target="#ECfRetr_2-9a.lnote.la.20"/>, <hi rend="bold">episcopus</hi> regi<ptr type="liebermannNote" n="21" target="#ECfRetr_2-9a.lnote.la.21"/> <hi rend="bold">notum faciat;</hi> rex <hi rend="bold">autem</hi><ptr type="liebermannNote" n="22" target="#ECfRetr_2-9a.lnote.la.22"/> constringet<ptr type="liebermannNote" n="23" target="#ECfRetr_2-9a.lnote.la.23"/> <hi rend="bold">male</hi>factorem, ut emendet cui forisfecit<ptr type="liebermannNote" n="24" target="#ECfRetr_2-9a.lnote.la.24"/>, <hi rend="bold">scilicet primum</hi><ptr type="liebermannNote" n="c" target="#ECfRetr_2-9a.lnote.la.fn.c"/> episcopo, <hi rend="bold">deinde</hi> sibi<ptr type="liebermannNote" n="25" target="#ECfRetr_2-9a.lnote.la.25"/>.</ab>
        <note type="comparison" source="#liebermann" n="629"><label>printed alongside</label> <ref target="clause:ECf_2-9a">ECf 2.9a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 629 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-9a.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Retr. wahrt</hi> (<hi rend="italic">klerikaler, auch</hi> 3, 1) <hi rend="italic">dem Bischof Priorität, wie u.</hi> 3. 6a</seg><seg type="translation" xml:lang="en" source="#claude">the Retractator (more clerical, also at 3, 1) keeps the priority for the bishop, as below, 3. 6a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-9a.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">noluit <hi rend="italic">Cc</hi></seg><seg type="translation" xml:lang="en" source="#claude">noluit Cc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-9a.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">n. r. <hi rend="italic">Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">n. r. Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-9a.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-9a.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">-gat <hi rend="italic">Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gat Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-9a.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">-cerit <hi rend="italic">Sp Cc K Ce;</hi> forisfacturam fecit <hi rend="italic">Hv;</hi> suum malefactum <hi rend="italic">Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cerit Sp Cc K Ce; forisfacturam fecit Hv; suum malefactum Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-9a.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">regi <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">regi Hv</seg></note>
      </div>
