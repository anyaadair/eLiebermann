      <div type="clause" n="12">
        <head><ref type="lawCode" target="law:WlArtRetr">Wl art retr</ref> 12</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-lond"><pb n="491" ed="#liebermann"/>Decretum est etiam ibi<ptr type="liebermannNote" n="23" target="#WlArtRetr_12.lnote.oe.23"/>, ut, si Francigena appellauerit Anglum de periurio<ptr type="liebermannNote" n="24" target="#WlArtRetr_12.lnote.oe.24"/> aut murdro, furto<ptr type="liebermannNote" n="25" target="#WlArtRetr_12.lnote.oe.25"/>, homicidio<ptr type="liebermannNote" n="25" target="#WlArtRetr_12.lnote.oe.25"/>, ran, quod dicunt<ptr type="liebermannNote" n="26" target="#WlArtRetr_12.lnote.oe.26"/> apertam rapinam, que negari non potest<ptr type="liebermannNote" n="27" target="#WlArtRetr_12.lnote.oe.27"/>, Anglus se defendat per quod melius uoluerit<ptr type="liebermannNote" n="28" target="#WlArtRetr_12.lnote.oe.28"/>: aut iudicio<ptr type="liebermannNote" n="*" target="#WlArtRetr_12.lnote.oe.star"/> ferri aut duello.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 491 (two independent readings of the page images, differences settled against the page); Robertson does not print this clause separately</note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_12.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">Hoc datur inteligi quod ordalium fuit in tempore Willelmi Conquestoris <hi rend="italic">Schreiber am Rande Co</hi> [<hi rend="italic">vergleiche dieses Schreibers Interesse fürs</hi> Iudicium Dei <hi rend="italic">oben S.</hi> 401{b}]</seg><seg type="translation" xml:lang="en" source="#claude">Hoc datur inteligi quod ordalium fuit in tempore Willelmi Conquestoris scribe in the margin Co [compare this scribe’s interest in the Iudicium Dei above p. 401{b}]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_12.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hg K3 Se</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Hg K3 Se</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_12.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">pergurio <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">pergurio Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_12.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">aut <hi rend="italic">fügt zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ld adds aut</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_12.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">dicitur aperta rapina <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">dicitur aperta rapina Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_12.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">poterit <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">poterit Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_12.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">nouerit <hi rend="italic">Se</hi></seg><seg type="translation" xml:lang="en" source="#claude">nouerit Se</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_12.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">283</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">pergurio</hi>{24} .. <hi rend="italic">nol</hi>.{28} Rs.—Zum <hi rend="italic">iudicio</hi>{*} <hi rend="italic">vgl. Gl</hi> Ordal 34e</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">pergurio</hi>{24} .. <hi rend="italic">nol</hi>.{28} Rs.—On the <hi rend="italic">iudicio</hi>{*} <hi rend="italic">cf. Gl</hi> Ordal 34e</seg></note>
      </div>
    </body>
