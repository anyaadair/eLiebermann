      <div type="clause" n="61.18a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 61.18a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 61.18a" corresp="#wit-lat"><pb n="582" ed="#liebermann"/>Et si<ptr type="liebermannNote" n="26" target="#Hn_61-18a.lnote.oe.26"/> ibi confitebitur<ptr type="liebermannNote" n="o" target="#Hn_61-18a.lnote.oe.o"/> uel ordine iudiciario conuincitur, iam condempnatus est.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 582 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-18a.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">‘A man who confessed a felony in court was condemned upon his confession’; <hi rend="italic">Pollock and Maitland</hi> HEL. II 650</seg><seg type="translation" xml:lang="en" source="#claude">‘A man who confessed a felony in court was condemned upon his confession’; Pollock and Maitland HEL. II 650</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-18a.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">sibi <hi rend="italic">statt</hi> si i. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sibi instead of si i. Lond</seg></note>
