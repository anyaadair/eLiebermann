      <div type="clause" n="19">
        <head><ref type="lawCode" target="law:VIAtr">VI Atr</ref> 19</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19" corresp="#wit-k"><pb n="252" ed="#liebermann"/>K. ⁊ leohtgescot þriwa on geare.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19" corresp="#wit-d-incomplete"><pb n="252" ed="#liebermann"/>⁊ leohtgescot þriwa on geare.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="19" corresp="#wit-k"><pb n="96" ed="#robertson"/>⁊ leohtgescot þriwa on geare.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-k"><pb n="168" ed="#rabin-doml"/>and leohtgescot þriwa on geare.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="253" ed="#liebermann"/>und Lichtschoss dreimal im Jahre.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">and light-dues three times a year.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-k"><ptr type="editorNote" n="1" target="#VIAtr_19.robnote.n.1"/><pb n="97" ed="#robertson"/>And light dues three times in the year.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-k"><pb n="169" ed="#rabin-doml"/>and the dues for the lighting of the church three times a year.</ab>
        <note type="comparison" source="#liebermann" n="253"><ref target="clause:VAtr_11-1">V Atr 11.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">V Atr. 11, 1</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VIIIAtr_12-1">VIII Atr 12.1</ref>; <ref target="clause:ICn_12">I Cn 12</ref></note>
        <note type="comparedBy" source="#kennedy" n="59"><ref target="clause:Cn-1018_part-035">Cn 1018 13.5–14.1</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="356"><ref target="clause:ICn_12">I Cn 12</ref></note>
