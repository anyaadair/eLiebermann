      <div type="clause" n="10">
        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 10</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 10" corresp="#wit-lat"><ptr type="liebermannNote" n="31" target="#LibLond_10.lnote.oe.31"/><pb n="675" ed="#liebermann"/>Ciues uero<ptr type="liebermannNote" n="32" target="#LibLond_10.lnote.oe.32"/> Lundonie<ptr type="liebermannNote" n="33" target="#LibLond_10.lnote.oe.33"/> non faciunt<ptr type="liebermannNote" n="34" target="#LibLond_10.lnote.oe.34"/> bellum<ptr type="liebermannNote" n="s" target="#LibLond_10.lnote.oe.s"/><ptr type="liebermannNote" n="35" target="#LibLond_10.lnote.oe.35"/>;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 675 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Cons.</hi> 713: duellum facere non debent</seg><seg type="translation" xml:lang="en" source="#claude">cf. Cons. 713: duellum facere non debent</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">Item quod <hi rend="italic">fügt zu Alb;</hi> Homo ciuitatis qui ad libertatem (<hi rend="italic">Bürgerrecht</hi>) est, duellum non faciet <hi rend="italic">Cons</hi></seg><seg type="translation" xml:lang="en" source="#claude">Alb adds Item quod; Homo ciuitatis qui ad libertatem (freedom of the city) est, duellum non faciet Cons</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Alb</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">missing in Alb</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">London’ <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">London’ Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">-ient <hi rend="italic">Horn Alb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ient Horn Alb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">duellum; nec ibunt <hi rend="italic">Alb</hi></seg><seg type="translation" xml:lang="en" source="#claude">duellum; nec ibunt Alb</seg></note>
