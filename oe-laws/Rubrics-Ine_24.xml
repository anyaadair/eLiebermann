        <head>Ine Rb 24</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="24" corresp="#wit-e"><pb n="22" ed="#liebermann"/>LXVIII. Be witeðeowes monnes<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_24.lnote.oe.2"/> slege.<ptr type="liebermannNote" n="6" target="#Rubrics-Ine_24.lnote.oe.6"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="24" corresp="#wit-g-prol"><pb n="22" ed="#liebermann"/>LXVIII. Be witeþeowes mannes slege.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="24" corresp="#wit-h"><pb n="23" ed="#liebermann"/>LXVIII. Be witeðeowes<ptr type="liebermannNote" n="3" target="#Rubrics-Ine_24.lnote.oe.3"/> monnes slege.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="24" corresp="#wit-q"><pb n="23" ed="#liebermann"/>De interfectione<ptr type="liebermannNote" n="7" target="#Rubrics-Ine_24.lnote.oe.7"/> hominis qui propter forisfactum<ptr type="liebermannNote" n="8" target="#Rubrics-Ine_24.lnote.oe.8"/> sit seruus.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="204" ed="#jurasinski-and-oliver"/>LXVIII Be witeðeowes monnes slege</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="23" ed="#liebermann"/>Von Erschlagung eines strafhörigen Menschen.<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_24.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of the slaying of a person enslaved as a penalty.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="205" ed="#jurasinski-and-oliver"/>Concerning the slaying of a penal slave</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_24.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de">-<hi rend="spaced">wum</hi> <hi rend="italic">ohne</hi> m. s. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-<hi rend="italic">wum</hi> without m. s. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_24.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">De fure Anglico <hi rend="italic">Br</hi>; De eo qui pr. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">De fure Anglico Br; De eo qui pr. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_24.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">forisfacturam <hi rend="italic">THk</hi></seg><seg type="translation" xml:lang="en" source="#claude">forisfacturam THk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_24.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
