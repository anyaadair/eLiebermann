      <div type="clause" n="49">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 49</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="49" corresp="#wit-e"><pb n="110" ed="#liebermann"/>XCII[I].<ptr type="liebermannNote" n="16" target="#Ine_49.lnote.oe.16"/> Gif mon on his mæstenne<ptr type="liebermannNote" n="17" target="#Ine_49.lnote.oe.17-2"/> unaliefed swín gemete, genime þon<hi rend="italic">ne</hi> VI<ptr type="liebermannNote" n="18" target="#Ine_49.lnote.oe.18-2"/> scill. weorð<ptr type="liebermannNote" n="19" target="#Ine_49.lnote.oe.19-2"/> wed.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="49" corresp="#wit-h"><pb n="110" ed="#liebermann"/>XCIII. Gif mon<ptr type="liebermannNote" n="4" target="#Ine_49.lnote.oe.4"/> on his mæstene unalyfed swin gemete, genime ðonne VI scll' weorð wed.<ptr type="liebermannNote" n="15" target="#Ine_49.lnote.oe.15"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="49" corresp="#wit-b-no-prol"><pb n="110" ed="#liebermann"/>Be unalefedu<hi rend="italic">m</hi> mæstenu<hi rend="italic">m</hi> andfencge. Gyf mon on his mæstene unalufed swin gemete, genime ðonne syx scill' wurð wed.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="49" corresp="#wit-q"><pb n="111" ed="#liebermann"/>Si quis obuiet porco<ptr type="liebermannNote" n="17" target="#Ine_49.lnote.oe.17"/> sine licentia in pasnagio suo, capiat<ptr type="liebermannNote" n="18" target="#Ine_49.lnote.oe.18"/> uadium sex solid. ualens.<ptr type="liebermannNote" n="19" target="#Ine_49.lnote.oe.19"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="52" ed="#attenborough"/>[Be unalefedum mæstenum andfencge.] Gif mon on his mæstenne unaliefed swín gemete, genime þonne VI scill. weorð wed.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="51" corresp="#wit-e"><pb n="412" ed="#jurasinski-and-oliver"/>{XCII[I]} Gif mon on his mæstenne unaliefed swin gemete, genime þon<hi rend="italic">ne</hi> VI sciƚƚ weorð wed.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><ptr type="liebermannNote" n="1" target="#Ine_49.lnote.de.1"/><pb n="111" ed="#liebermann"/>Wenn jemand innerhalb seiner Mast Schweine<ptr type="liebermannNote" n="2" target="#Ine_49.lnote.de.2"/> ohne Erlaubniss antrifft, dann nehme er [an ihnen<ptr type="liebermannNote" n="3" target="#Ine_49.lnote.de.3"/>] ein 6 Schill. werthes Pfand.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone comes upon pigs within his pannage without permission, then let him take [from them] a pledge worth 6 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="53" ed="#attenborough"/>If anyone finds swine intruding in his mast pasture, he may take security to the value of 6 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="405" ed="#whitelock"/>If anyone finds swine on his mast-pasture without his permission he is to take then a pledge worth six shillings.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="413" ed="#jurasinski-and-oliver"/>If someone finds swine on his pasture without permission, let him then take a pledge-payment of 6 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">111</biblScope></bibl><seg type="original" xml:lang="de">porcis <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">porcis Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">111</biblScope></bibl><seg type="original" xml:lang="de">-iet iudicium <hi rend="italic">M Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iet iudicium M Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">111</biblScope></bibl><seg type="original" xml:lang="de">ual. — hab. I sol. <hi rend="italic">überspringt M Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">ual. — hab. I sol. omitted by M Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> wedd</seg><seg type="translation" xml:lang="en" source="#claude">altered to wedd</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de">XCII <hi rend="italic">E</hi></seg><seg type="translation" xml:lang="en" source="#claude">XCII E</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49.lnote.oe.17-2" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de">-tene unalyfed <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tene unalyfed Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49.lnote.oe.18-2" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de">syx <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">syx Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_49.lnote.oe.19-2" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">110</biblScope></bibl><seg type="original" xml:lang="de">wyrþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wyrþ Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_49.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">77</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘Von unerlaubten Mastungen [‘und’ zu ergänzen oder <hi rend="italic">and fenge</hi> getrennt?] Ertappung’ Rb B</seg><seg type="translation" xml:lang="en" source="#claude">‘Of unlawful pannage [‘and’ to be supplied, or <hi rend="italic">and fenge</hi> to be divided?] seizure’ Rb B</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_49.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">77</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Den Plural führt Q spät. Rez. richtig ein, laut 49, 1f.</seg><seg type="translation" xml:lang="en" source="#claude">Q, later recension, rightly introduces the plural, in accordance with 49, 1f.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_49.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">77</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Mast 2. 4; Pfändung 6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Mast 2. 4; Pfändung 6</seg></note>
      </div>
