        <head>Wl art Frz 6.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-cu"><pb n="489" ed="#liebermann"/>Li queus d'eus ke fust ve[n]keus<ptr type="liebermannNote" n="1" target="#Wl-art-Frz_6-2.lnote.oe.1"/>, donat<ptr type="liebermannNote" n="d" target="#Wl-art-Frz_6-2.lnote.oe.d"/> al reis quarante sols.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 489 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Wl-art-Frz_6-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">489</biblScope></bibl><seg type="original" xml:lang="de">vekeus <hi rend="italic">Cu</hi></seg><seg type="translation" xml:lang="en" source="#claude">vekeus Cu</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Wl-art-Frz_6-2.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">489</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> dorrat <hi rend="italic">SUCHIER</hi></seg><seg type="translation" xml:lang="en" source="#claude">read dorrat SUCHIER</seg></note>
