      <div type="clause" n="9.4">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 9.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 9.4" corresp="#wit-lat"><pb n="555" ed="#liebermann"/>Et omnis<ptr type="liebermannNote" n="d" target="#Hn_9-4.lnote.oe.d"/> causa terminetur uel hundreto uel comitatu uel halimoto<ptr type="liebermannNote" n="e" target="#Hn_9-4.lnote.oe.e"/><ptr type="liebermannNote" n="11" target="#Hn_9-4.lnote.oe.11"/> socam habentium<ptr type="liebermannNote" n="12" target="#Hn_9-4.lnote.oe.12"/> uel<ptr type="liebermannNote" n="f" target="#Hn_9-4.lnote.oe.f"/> dominorum curiis<ptr type="liebermannNote" n="13" target="#Hn_9-4.lnote.oe.13"/> uel diuisis<ptr type="liebermannNote" n="14" target="#Hn_9-4.lnote.oe.14"/> parium<ptr type="liebermannNote" n="g" target="#Hn_9-4.lnote.oe.g"/> uel certis agendorum<ptr type="liebermannNote" n="15" target="#Hn_9-4.lnote.oe.15"/> locis adiacen[tibu]s<ptr type="liebermannNote" n="16" target="#Hn_9-4.lnote.oe.16"/>, ne cuilibet irrogatam iniuriam fomenta<ptr type="liebermannNote" n="h" target="#Hn_9-4.lnote.oe.h"/><ptr type="liebermannNote" n="17" target="#Hn_9-4.lnote.oe.17"/> dilata uel amota<ptr type="liebermannNote" n="18" target="#Hn_9-4.lnote.oe.18"/> multiplicent, ne causarum<ptr type="liebermannNote" n="i" target="#Hn_9-4.lnote.oe.i"/> habitudine uel aliqua recti destitucione iura pertranseant<ptr type="liebermannNote" n="k" target="#Hn_9-4.lnote.oe.k"/><ptr type="liebermannNote" n="19" target="#Hn_9-4.lnote.oe.19"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 555 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Duns. 8</seg><seg type="translation" xml:lang="en" source="#claude">cf. Duns. 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 20, 2. 57, 8</seg><seg type="translation" xml:lang="en" source="#claude">cf. 20, 2. 57, 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">jedes</hi> uel <hi rend="italic">hier:</hi> ‘oder aber’</seg><seg type="translation" xml:lang="en" source="#claude">each uel here: ‘or else’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 34, 1<hi rend="italic">a.</hi> 57, 1. 57, 8: = merchmotis</seg><seg type="translation" xml:lang="en" source="#claude">cf. 34, 1a. 57, 1. 57, 8: = merchmotis</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">Aufschiebungen oder Vorenthaltungen der Rechts-Heilmittel</seg><seg type="translation" xml:lang="en" source="#claude">postponements or withholdings of legal remedies</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">das innere Wesen der Processe</seg><seg type="translation" xml:lang="en" source="#claude">the inner nature of the lawsuits</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">an höhere Gerichtsinstanz verloren gehen. Vgl.</hi> 7, 5 transferre</seg><seg type="translation" xml:lang="en" source="#claude">be lost to a higher court. Cf. 7, 5 transferre</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">-mot socc. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-mot socc. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">hnīum <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">hnīum Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">curiæ <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">curiæ Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">diuersis <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">diuersis Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">adiacens <hi rend="italic">Hss., gebessert Wilkins</hi></seg><seg type="translation" xml:lang="en" source="#claude">adiacens MSS, emended by Wilkins</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">form., <hi rend="italic">aber Punkt unter</hi> r <hi rend="italic">Sc;</hi> formata <hi rend="italic">Gi; am Rande Wh;</hi> fouīt <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">form., but a dot under r Sc; formata Gi; in the margin Wh; fouīt Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">amm. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">amm. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">-nsseat <hi rend="italic">Sc Hg;</hi> -nseat <hi rend="italic">Wh Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nsseat Sc Hg; -nseat Wh Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">317</biblScope></bibl><seg type="original" xml:lang="de">Lehnrechtliches Gericht des Seigneur über Vassallen, Normannisch, im Ggs. zum Agsächs. Hallengericht (<hi rend="italic">s. d. Gl</hi> 1 ff.) des Herrschaftguts über bäuerliche Hintersassen; <hi rend="italic">vgl. Gl</hi> Gericht 11; Dorfgericht; Schiedsgericht 7; Instanzenzug 8 ff.; Justizweigerung 4—<hi rend="italic">adiacens</hi>{16}—<hi rend="italic">ammota</hi>{13} Rs</seg><seg type="translation" xml:lang="en" source="#claude">The feudal court of the seigneur over his vassals, Norman, in contrast to the Anglo-Saxon hall-moot (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1 ff.) of the manor over its peasant tenants; <hi rend="italic">cf. Gl</hi> Gericht 11; Dorfgericht; Schiedsgericht 7; Instanzenzug 8 ff.; Justizweigerung 4—<hi rend="italic">adiacens</hi>{16}—<hi rend="italic">ammota</hi>{13} Rs</seg></note>
      </div>
