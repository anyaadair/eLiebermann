    <body>
      <div type="clause" n="20.1a">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 20.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 20.1a"><pb n="645" ed="#liebermann"/>Quodsi<ptr type="liebermannNote" n="32" target="#ECfRetr_20-1a.lnote.la.32"/> aufugeret<ptr type="liebermannNote" n="33" target="#ECfRetr_20-1a.lnote.la.33"/>, daretur <hi rend="bold">(lege</hi><ptr type="liebermannNote" n="34" target="#ECfRetr_20-1a.lnote.la.34"/><hi rend="bold">)</hi> eis<ptr type="liebermannNote" n="35" target="#ECfRetr_20-1a.lnote.la.35"/> terminus triginta<ptr type="liebermannNote" n="36" target="#ECfRetr_20-1a.lnote.la.36"/> unius diei.</ab>
        <note type="comparison" source="#liebermann" n="645"><label>printed alongside</label> <ref target="clause:ECf_20-1a">ECf 20.1a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 645 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-1a.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">Qui si <hi rend="italic">Cb Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Qui si Cb Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-1a.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">-rit <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rit Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-1a.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi> [<hi rend="italic">ursprünglicher</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv [more original]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-1a.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">t. eis <hi rend="italic">Cb Lb Va Ph;</hi> t. ei <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. eis Cb Lb Va Ph; t. ei Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-1a.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">XXXI’ <hi rend="italic">Cb;</hi> tricesimi primi <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">XXXI’ Cb; tricesimi primi Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But if he fled, a term of thirty-one days should be given them (by law).</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-1a.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">346</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">lege t. eis</hi><hi rend="superscript">35</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">lege t. eis</hi><hi rend="superscript">35</hi> Rs</seg></note>
      </div>
