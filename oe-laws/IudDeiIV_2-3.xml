      <div type="clause" n="2.3">
        <head><ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 2.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 2.3" corresp="#wit-du"><pb n="409" ed="#liebermann"/>ut omnis homo timeat et contremescat nomen sanctum gloriae Domini nostri, qui uiuit.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei IV 2.3" corresp="#wit-gl"><pb n="409" ed="#liebermann"/>þ<hi rend="italic">æt</hi>te ælc <hi rend="italic">monn<ptr type="liebermannNote" n="33" target="#IudDeiIV_2-3.lnote.oe.33"/></hi> ondrede ⁊ gifyrhtia<ptr type="liebermannNote" n="37" target="#IudDeiIV_2-3.lnote.oe.37"/> nome `halig wvld<hi rend="italic">res</hi> Driht<hi rend="italic">nes</hi> vs[<hi rend="italic">cs<ptr type="liebermannNote" n="38" target="#IudDeiIV_2-3.lnote.oe.38"/></hi>], se ðe liof<hi rend="italic">as</hi>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 409 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2-3.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rune</hi> ᛞ</seg><seg type="translation" xml:lang="en" source="#claude">rune ᛞ</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2-3.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">-tiga <hi rend="italic">Stev.; beides möglich: Lind. S.</hi> 80</seg><seg type="translation" xml:lang="en" source="#claude">-tiga Stev.; both possible: Lind. p. 80</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2-3.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">vs <hi rend="italic">Du</hi> [<hi rend="italic">Stev. las</hi> us']</seg><seg type="translation" xml:lang="en" source="#claude">vs Du [Stev. read us’]</seg></note>
