  <text>
    <body>
      <div type="clause" n="14">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 14</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="14" corresp="#wit-h"><pb n="4" ed="#liebermann"/>Gif wið eorles birele man geligeþ, XII scill' gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-h"><pb n="6" ed="#attenborough"/>Gif wið eorles birele man geligeþ, XII scill' gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="19" corresp="#wit-h"><pb n="66" ed="#oliver"/>Gif wið eorles birele man geligeþ, XII scilƚ gebete.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="4" ed="#liebermann"/>Wenn bei eines Adligen Schenkin<ptr type="liebermannNote" n="1" target="#Abt_14.lnote.de.1"/> jemand liegt, büsse er [jenem] 12 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone lies with a nobleman’s cup-bearer [woman], let him pay [the latter] 12 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="7" ed="#attenborough"/>If a man lies with a nobleman’s serving maid, he shall pay 12 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h"><pb n="391" ed="#whitelock"/>If anyone lies with a nobleman’s serving-woman,<ptr type="editorNote" n="2" target="#Abt_14.whinote.n.2"/> he is to pay 20 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h"><pb n="67" ed="#oliver"/>If a person lies with a nobleman’s cupbearer,<ptr type="editorNote" n="a" target="#Abt_14.olinote.n.a"/> let him pay 12 shillings.</ab>
        <note type="comparedBy" source="#wormald-mel" n="281"><ref target="clause:Af_10">Af 10–11.5</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="281"><ref target="clause:Af_18-1">Af 18.1–18.3</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="281"><ref target="clause:Af_25">Af 25–25.1</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="281"><ref target="clause:Af_26">Af 26</ref></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_14.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">7</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Mundschenk 1. 2; <hi rend="italic">o.</hi> 13³. — Nicht bloss die Unfreie, sondern die Frau eines gefolgsadligen Gutsbesitzers versieht das <hi rend="italic">ministerium,</hi> dem Gaste <hi rend="italic">offerre poculum</hi> und <hi rend="italic">propinare ad prandium</hi> bei Beda V 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Mundschenk 1. 2; <hi rend="italic">above</hi> 13³. — Not only the unfree woman but also the wife of a landowner of the retinue-nobility performs the <hi rend="italic">ministerium</hi> of <hi rend="italic">offerre poculum</hi> to the guest and <hi rend="italic">propinare ad prandium</hi>, in Bede V 4</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Abt_14.whinote.n.2" n="2" source="#whitelock"><bibl><biblScope unit="page">391</biblScope></bibl><label>serving-woman</label><seg type="original" xml:lang="en">literally, “a female cup-bearer”</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Abt_14.olinote.n.a" n="a" source="#oliver"><bibl><biblScope unit="page">67</biblScope></bibl><label>cupbearer,</label><seg type="original" xml:lang="en">This figure is a woman: the noun is feminine.</seg></note>
      </div>
    </body>
