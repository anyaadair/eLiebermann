    <body>
      <div type="clause" n="7.2">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 7.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.2" corresp="#wit-e"><pb n="92" ed="#liebermann"/>Xwintre<ptr type="liebermannNote" n="20" target="#Ine_7-2.lnote.oe.20"/> cniht mæg bion<ptr type="liebermannNote" n="21" target="#Ine_7-2.lnote.oe.21"/> ðiefðe gewita.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.2" corresp="#wit-bu"><pb n="92" ed="#liebermann"/>Xwintre . . . m:g beon þeofðe gewyte.<ptr type="liebermannNote" n="2" target="#Ine_7-2.lnote.oe.2"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.2" corresp="#wit-h"><pb n="92" ed="#liebermann"/>Xwintra<ptr type="liebermannNote" n="13" target="#Ine_7-2.lnote.oe.13"/> cniht<ptr type="liebermannNote" n="14" target="#Ine_7-2.lnote.oe.14"/> mæg beon<ptr type="liebermannNote" n="9" target="#Ine_7-2.lnote.oe.9"/> ðyfðe gewita.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.2" corresp="#wit-b-no-prol"><pb n="93" ed="#liebermann"/>Tynwintre cniht mæg beon þyfðe gewita.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7.2" corresp="#wit-q"><pb n="93" ed="#liebermann"/>Puer decem annorum debet scire, ne furtum faciat.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="38" ed="#attenborough"/>X wintre cniht mæg bion ðiefðe gewita.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="7.2" corresp="#wit-e"><pb n="376" ed="#jurasinski-and-oliver"/>X wintre cniht mæg bion ðiefðe gewita.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="93" ed="#liebermann"/>Ein 10<ptr type="liebermannNote" n="1" target="#Ine_7-2.lnote.de.1"/> Jahr<ptr type="liebermannNote" n="2" target="#Ine_7-2.lnote.de.2"/> alter Knabe kann Mitwisser eines Diebstahls sein.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">A boy 10 years old can be an accessory to a theft.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="39" ed="#attenborough"/>A ten year old child can be [regarded as] accessory to a theft.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="400" ed="#whitelock"/>A ten-year-old boy can be [considered] privy to a theft.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="377" ed="#jurasinski-and-oliver"/>A ten-year old child may be accessory to theft.</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="377"><label>compare</label> <ref target="clause:Hl_6">Hl 6</ref> <quote>In early Kent and Wessex the child reaches legal maturity at the age of 10. Compare Hloþhere and Eadric §4 [L6].</quote></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="405"><label>cf.</label> <ref target="clause:Ine_38">Ine 38</ref> <quote>§7.2 implies that the child comes of age at 10; cf. Æthelberht §76.2 [L78] and Hloþhere and Eadric §4 [L6]; also Wifmannes Beweddung.</quote></note>
        <note type="comparedBy" source="#wormald-ppmel" n="127"><label>changes age</label> <ref target="clause:IIAs_1">II As 1</ref> <quote>Highly suggestive is the re-appearance in this context of the age of twelve. Ine had made ten the age when one might be accessory to theft.</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht</hi> gewytte, <hi rend="italic">nicht Turks</hi> -itæ</seg><seg type="translation" xml:lang="en" source="#claude">perhaps gewytte, not Turk’s -itæ</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">a <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">a on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rasur hinter</hi> i</seg><seg type="translation" xml:lang="en" source="#claude">erasure after i</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">tynw. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">tynw. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">beon þeofþe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">beon þeofþe Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_7-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">70</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Kind 4. 7; mündig 3. 7—12</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Kind 4. 7; mündig 3. 7—12</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_7-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">70</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">H Q verstehen <hi rend="italic">wintra</hi> als Gen. numeralis von <hi rend="italic">X</hi> abhängig; allein Ine braucht ein Adj. wie <hi rend="italic">fifwintre</hi> : <hi rend="italic">quinquennis</hi></seg><seg type="translation" xml:lang="en" source="#claude">H Q take <hi rend="italic">wintra</hi> as a genitive dependent on the numeral <hi rend="italic">X</hi>; but Ine uses an adjective such as <hi rend="italic">fifwintre</hi> : <hi rend="italic">quinquennis</hi></seg></note>
      </div>
    </body>
  </text>
