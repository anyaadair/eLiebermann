        <note type="liebermannNote" subtype="textual" xml:id="IICn_29.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">331</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so K;</hi> uel <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus K; uel the others</seg></note>
