      <div type="clause" n="5.19">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.19</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.19" corresp="#wit-lat"><pb n="550" ed="#liebermann"/>De habitu et uestitu nichil<ptr type="liebermannNote" n="31" target="#Hn_5-19.lnote.oe.31"/> legimus imperatum diuinitus; que ad pompam<ptr type="liebermannNote" n="32" target="#Hn_5-19.lnote.oe.32"/> sunt<ptr type="liebermannNote" n="33" target="#Hn_5-19.lnote.oe.33"/> prohibentur; etsi cogeris<ptr type="liebermannNote" n="34" target="#Hn_5-19.lnote.oe.34"/>, potes in<ptr type="liebermannNote" n="35" target="#Hn_5-19.lnote.oe.35"/> superbo<ptr type="liebermannNote" n="l" target="#Hn_5-19.lnote.oe.l"/> cultu habere<ptr type="liebermannNote" n="36" target="#Hn_5-19.lnote.oe.36"/> cor humile ut Ester<ptr type="liebermannNote" n="37" target="#Hn_5-19.lnote.oe.37"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 550 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-19.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">Esther inter purpuram ... superbiam humilitate uic[it]; <hi rend="italic">Hieronymi</hi> Epist. 79, 2 <hi rend="italic">ed. Migne</hi> Patrol. 22, 726</seg><seg type="translation" xml:lang="en" source="#claude">Esther inter purpuram ... superbiam humilitate uic[it]; Hieronymi Epist. 79, 2 ed. Migne Patrol. 22, 726</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-19.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">nil <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">nil Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-19.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">-pa <hi rend="italic">Co;</hi> -para <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-pa Co; -para Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-19.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">pr. s. <hi rend="italic">durch Zeichen später umgestellt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">pr. s. later transposed by signs in Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-19.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so, ähnlich wie</hi> reḡis <hi rend="italic">Sc;</hi> regeris <hi rend="italic">Thorpe;</hi> congeris, poterit <hi rend="italic">K Co Or Gi;</hi> rogeris <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">so, similar to reḡis Sc; regeris Thorpe; congeris, poterit K Co Or Gi; rogeris Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-19.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co;</hi> in s. <hi rend="italic">doppelt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in K Co; in s. twice in Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-19.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-19.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">Hester <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hester Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-19.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">315</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Clericus non debet esse . . arrogans in vestibus</hi>; Hirtenbr. Ælfrics ed. Fehr S. 54. Der Vergleich mit Esther ist damals häufig: [<hi rend="italic">Margareta regina Scotorum</hi>] <hi rend="italic">ornamenta velut</hi> <hi rend="italic">altera Esther mente calcavit, habuit curam humilitatis</hi>; ed. Hinde hinter <hi rend="italic">Sym. Dunelm</hi>. p. 242.—<hi rend="italic">Vgl</hi>. Synode 1102 gegen ausschweifende Tracht; Quadr II 8, 1.—<hi rend="italic">regeris</hi>{34}, <hi rend="italic">poteris</hi>—5, 20 <hi rend="italic">aut</hi>{38} bis <hi rend="italic">puniantur</hi> fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Clericus non debet esse . . arrogans in vestibus</hi>; Ælfric's pastoral letter ed. Fehr p. 54. The comparison with Esther is frequent at that time: [<hi rend="italic">Margareta regina Scotorum</hi>] <hi rend="italic">ornamenta velut</hi> <hi rend="italic">altera Esther mente calcavit, habuit curam humilitatis</hi>; ed. Hinde after <hi rend="italic">Sym. Dunelm</hi>. p. 242.—<hi rend="italic">Cf</hi>. the synod of 1102 against extravagant dress; Quadr II 8, 1.—<hi rend="italic">regeris</hi>{34}, <hi rend="italic">poteris</hi>—5, 20 <hi rend="italic">aut</hi>{38} to <hi rend="italic">puniantur</hi> missing Rs</seg></note>
      </div>
