        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.26</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.26" corresp="#wit-lat"><pb n="580" ed="#liebermann"/>De fugitiuis uero — conducticiis uel<ptr type="liebermannNote" n="20" target="#Hn_59-26.lnote.oe.20"/> residentibus, seruis uel liberis — secundum legem<ptr type="liebermannNote" n="m" target="#Hn_59-26.lnote.oe.m"/> perquisitis institutum<ptr type="liebermannNote" n="21" target="#Hn_59-26.lnote.oe.21"/>, prima uice furatos reducendos et signandos<ptr type="liebermannNote" n="c" target="#Hn_59-26.lnote.oe.c"/> esse.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 580 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-26.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht aus II Cn.</hi> 32; <hi rend="italic">vgl.</hi> 59, 26</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">perhaps from II Cn.</hi> 32; <hi rend="italic">cf.</hi> 59, 26</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-26.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 23, 6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 23, 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-26.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-26.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> est</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">supply</hi> est</seg></note>
