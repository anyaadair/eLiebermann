      <div type="clause" n="38.3a">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 38.3a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 38.3a"><pb n="669" ed="#liebermann"/>Et si <hi rend="spaced">sciret</hi> uenditorem <hi rend="bold">suum,</hi> quis<ptr type="liebermannNote" n="14" target="#ECfRetr_38-3a.lnote.la.14"/> <hi rend="spaced">esset</hi> uel ubi <hi rend="spaced">fuisset</hi>, <hi rend="spaced">diceret</hi>; iusticia<ptr type="liebermannNote" n="15" target="#ECfRetr_38-3a.lnote.la.15"/> <hi rend="bold">uero</hi> <hi rend="spaced">quereret</hi><ptr type="liebermannNote" n="16" target="#ECfRetr_38-3a.lnote.la.16"/> eum ad faciendam<ptr type="liebermannNote" n="17" target="#ECfRetr_38-3a.lnote.la.17"/> <hi rend="bold">de eo</hi> iusticiam; <hi rend="bold">qui</hi> si inueniri non <hi rend="spaced">posset</hi><ptr type="liebermannNote" n="18" target="#ECfRetr_38-3a.lnote.la.18"/>, <hi rend="spaced">utlagaretur</hi>.</ab>
        <note type="comparison" source="#liebermann" n="669"><label>printed alongside</label> <ref target="clause:ECf_38-3a">ECf 38.3a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 669 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-3a.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">jener Verkäufer</hi></seg><seg type="translation" xml:lang="en" source="#claude">that seller</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-3a.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">qui <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-3a.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">-iarius <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iarius Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-3a.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">requireret <hi rend="italic">Cb;</hi> queret <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">requireret Cb; queret Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-3a.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Cb Hv;</hi> -dum <hi rend="italic">übr.;</hi> i. de eo <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Cb Hv; -dum the others; i. de eo Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-3a.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">-ent <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ent K</seg></note>
