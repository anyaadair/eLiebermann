    <body>
      <div type="clause" n="13">
        <head>Ine Rb 13</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="13" corresp="#wit-e"><pb n="20" ed="#liebermann"/>LVII. Be ðam ðe hiora<ptr type="liebermannNote" n="12a" target="#Rubrics-Ine_13.lnote.oe.12a"/> gewitnessa beforan bisc<hi rend="italic">epe</hi> áleogað.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="13" corresp="#wit-g-prol"><pb n="20" ed="#liebermann"/>LVII. Be þan ðe hyra gewitnesse beforan bisceope aleogað.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="13" corresp="#wit-h"><pb n="21" ed="#liebermann"/>LVII. Be þon<ptr type="liebermannNote" n="10" target="#Rubrics-Ine_13.lnote.oe.10"/> þe heora<ptr type="liebermannNote" n="8" target="#Rubrics-Ine_13.lnote.oe.8"/> gewitnesse<ptr type="liebermannNote" n="11" target="#Rubrics-Ine_13.lnote.oe.11"/> beforan biscope aleogaþ.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="13" corresp="#wit-q"><pb n="21" ed="#liebermann"/>De illis qui ante<ptr type="liebermannNote" n="16" target="#Rubrics-Ine_13.lnote.oe.16"/> episcopum testimonium suum<ptr type="liebermannNote" n="17" target="#Rubrics-Ine_13.lnote.oe.17"/> infringunt.<ptr type="liebermannNote" n="18" target="#Rubrics-Ine_13.lnote.oe.18"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="202" ed="#jurasinski-and-oliver"/>LVII Be ðam ðe hiora gewitnessa beforan bisc<hi rend="italic">epe</hi> áleogað</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="202" ed="#jurasinski-and-oliver"/>Be þa<hi rend="italic">m</hi> þe heore gewitnesse geleogað</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="21" ed="#liebermann"/>Von denen, die ihre<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_13.lnote.de.1"/> Zeugnisse<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_13.lnote.de.2"/> vor dem Bischof<ptr type="liebermannNote" n="3" target="#Rubrics-Ine_13.lnote.de.3"/> falsch abgeben.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of those who give their testimony falsely before the bishop.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="203" ed="#jurasinski-and-oliver"/>Concerning those who deny their testimony in the presence of the bishop</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="203" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_13.lnote.oe.12a" n="12a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">20</biblScope></bibl><seg type="original" xml:lang="de">heora gewitnysse geleogaþ <hi rend="italic">ohne</hi> b. b. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">heora gewitnysse geleogaþ without b. b. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_13.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">coram episcopo <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">coram episcopo Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_13.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">vel vadium <hi rend="italic">fügt zu Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">vel vadium added by Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_13.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">Differentia [De dif. <hi rend="italic">Br</hi>] inter fures, cohortem [et <hi rend="italic">Brti</hi>] exercitum <hi rend="italic">fügt zu Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Differentia [De dif. Br] inter fures, cohortem [et Brti] exercitum added by Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_13.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geändert in</hi> þam</seg><seg type="translation" xml:lang="en" source="#claude">altered to þam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_13.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_13.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">letztes</hi> e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">last e on an erasure</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_13.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘ihr Zeugnis’ (GH?)Q</seg><seg type="translation" xml:lang="en" source="#claude">‘their testimony’ (GH?)Q</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_13.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Q spät. Rez. ergänzt die Rb aus seinem Text, auch unten öfter, was ich fortan nicht weiter bemerke</seg><seg type="translation" xml:lang="en" source="#claude">The later recension of Q supplies the Rb from its own text, often below as well, which I shall not note any further from now on</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_13.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">biscope</hi> Turk; ich ergänze nach E’s Text</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">biscope</hi> Turk; I supply it according to E’s text</seg></note>
      </div>
    </body>
