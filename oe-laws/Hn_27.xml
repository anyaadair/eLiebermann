    <body>
      <div type="clause" n="27">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 27</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 27" corresp="#wit-lat"><ptr type="liebermannNote" n="28" target="#Hn_27.lnote.oe.28"/><pb n="562" ed="#liebermann"/>De libertate uauasorum<ptr type="liebermannNote" n="21" target="#Hn_27.lnote.oe.21"/>. Habeant autem uauasores<ptr type="liebermannNote" n="29" target="#Hn_27.lnote.oe.29"/> qui liberas<ptr type="liebermannNote" n="30" target="#Hn_27.lnote.oe.30"/> terras<ptr type="liebermannNote" n="k" target="#Hn_27.lnote.oe.k"/> tenent, placita que ad witam<ptr type="liebermannNote" n="31" target="#Hn_27.lnote.oe.31"/> uel weram<ptr type="liebermannNote" n="32" target="#Hn_27.lnote.oe.32"/> pertinent<ptr type="liebermannNote" n="l" target="#Hn_27.lnote.oe.l"/> super suos homines et in suo; et super aliorum homines, si in forisfaciendo retenti uel grauati fuerint<ptr type="liebermannNote" n="m" target="#Hn_27.lnote.oe.m"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 562 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_27.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">Lehen, mit Jurisdiction privilegirt; <hi rend="italic">vgl.</hi> 29, 1</seg><seg type="translation" xml:lang="en" source="#claude">fiefs privileged with jurisdiction; <hi rend="italic">cf.</hi> 29, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_27.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aber nicht friedlos machende, mit Hinrichtung bedrohte Strafprocesse</hi></seg><seg type="translation" xml:lang="en" source="#claude">but not criminal proceedings that entail outlawry or carry the threat of execution</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_27.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie oben</hi> 20, 2</seg><seg type="translation" xml:lang="en" source="#claude">as above 20, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_27.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">-ssor. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ssor. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_27.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">C. XXVIII <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">C. XXVIII Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_27.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">-asso. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-asso. Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_27.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">libera <hi rend="italic">ohne</hi> te. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">libera without te. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_27.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">wyt. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">wyt. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_27.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">uer. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">uer. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_27.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Gerichtsbarkeit 37a. 38. 39a.—<hi rend="italic">uauass</hi>.{21} <hi rend="italic">H. a. uauass. q. libera ten</hi>. ohne <hi rend="italic">ter</hi>.—<hi rend="italic">crau. fu</hi>. 28.—Am Rande spät: <hi rend="italic">Notabilis sermo</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Gerichtsbarkeit 37a. 38. 39a.—<hi rend="italic">uauass</hi>.{21} <hi rend="italic">H. a. uauass. q. libera ten</hi>. without <hi rend="italic">ter</hi>.—<hi rend="italic">crau. fu</hi>. 28.—In the margin, in a late hand: <hi rend="italic">Notabilis sermo</hi> Rs</seg></note>
      </div>
