    <body>
      <div type="clause" n="25.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 25.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 25.1"><pb n="650" ed="#liebermann"/>Quodsi quis<hi rend="bold">piam</hi><ptr type="liebermannNote" n="17" target="#ECfRetr_25-1.lnote.la.17"/> detinuerit eos<ptr type="liebermannNote" n="18" target="#ECfRetr_25-1.lnote.la.18"/> uel pecuniam<ptr type="liebermannNote" n="19" target="#ECfRetr_25-1.lnote.la.19"/> eorum, <hi rend="bold">per</hi>quirat rex, si<ptr type="liebermannNote" n="20" target="#ECfRetr_25-1.lnote.la.20"/> uult, tanquam suum proprium.</ab>
        <note type="comparison" source="#liebermann" n="650"><label>printed alongside</label> <ref target="clause:ECf_25-1">ECf 25.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 650 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_25-1.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">quis <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">quis Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_25-1.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">eis pec. <hi rend="italic">ohne</hi> uel <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">eis pec. without uel Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_25-1.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">eor. pec. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">eor. pec. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_25-1.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">si u. <hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">si u. lacking in Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But if anyone detains them or their money, let the king seek it out, if he will, as his own property.</ab>
      </div>
    </body>
