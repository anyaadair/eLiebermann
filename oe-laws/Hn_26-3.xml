      <div type="clause" n="26.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 26.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 26.3" corresp="#wit-lat"><pb n="562" ed="#liebermann"/>Planum est denique pro tali causa condictum<ptr type="liebermannNote" n="18" target="#Hn_26-3.lnote.oe.18"/> diem nec<ptr type="liebermannNote" n="19" target="#Hn_26-3.lnote.oe.19"/> semel quidem salua curia<ptr type="liebermannNote" n="20" target="#Hn_26-3.lnote.oe.20"/> uauasoris<ptr type="liebermannNote" n="21" target="#Hn_26-3.lnote.oe.21"/> licere<ptr type="liebermannNote" n="22" target="#Hn_26-3.lnote.oe.22"/> respectari, nec accionem huiusmodi<ptr type="liebermannNote" n="23" target="#Hn_26-3.lnote.oe.23"/> sine regie potestatis ministro<ptr type="liebermannNote" n="24" target="#Hn_26-3.lnote.oe.24"/> debere-finiri: que magis uitanda sunt, si quis de furto<ptr type="liebermannNote" n="h" target="#Hn_26-3.lnote.oe.h"/> seisiatus<ptr type="liebermannNote" n="25" target="#Hn_26-3.lnote.oe.25"/> sit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 562 (two independent readings of the page images, differences settled against the page); Liebermann’s Erklärung (Gesetze III p. 320) has ‘nel’ (a turned u; read ‘uel’); transcribed as printed</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_26-3.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">handhaft; <hi rend="italic">vgl.</hi> 61, 18<hi rend="italic">c; Maitland</hi> Seisin of chattels, Law quart. rev. I 325</seg><seg type="translation" xml:lang="en" source="#claude">caught in the act; <hi rend="italic">cf.</hi> 61, 18<hi rend="italic">c</hi>; Maitland Seisin of chattels, Law quart. rev. I 325</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_26-3.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">conduc. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">conduc. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_26-3.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">ohne</hi> s. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel without s. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_26-3.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">cuaria <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">cuaria Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_26-3.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">-ssor. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ssor. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_26-3.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">l’re <hi rend="italic">Co Or;</hi> litt’ <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">l’re Co Or; litt’ K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_26-3.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">huius <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">huius Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_26-3.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">-sterio <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sterio Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_26-3.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">sais. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sais. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_26-3.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vavassor</hi> hier ‘Lehnträger allgemein’; <hi rend="italic">s. Gl</hi> Vassallität 2.—<hi rend="italic">nel</hi>{19} <hi rend="italic">semel</hi>—<hi rend="italic">sais</hi>.{25}—26, 4 <hi rend="italic">sit, si lex an</hi>{26} [für <hi rend="italic">ante?</hi>] <hi rend="italic">r. m. c. fuerit</hi> Rs, als seien zwei fernere Hypothesen der ersten <hi rend="italic">si quis</hi> zu Ende 26, 3 koordiniert</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Vavassor</hi> here ‘holder of a fief in general’; <hi rend="italic">see Gl</hi> Vassallität 2.—<hi rend="italic">nel</hi>{19} <hi rend="italic">semel</hi>—<hi rend="italic">sais</hi>.{25}—26, 4 <hi rend="italic">sit, si lex an</hi>{26} [for <hi rend="italic">ante?</hi>] <hi rend="italic">r. m. c. fuerit</hi> Rs, as though two further hypotheses were coordinated with the first <hi rend="italic">si quis</hi> at the end of 26, 3</seg></note>
      </div>
