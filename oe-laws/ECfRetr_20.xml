    <body>
      <div type="clause" n="20">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 20</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 20"><pb n="645" ed="#liebermann"/><hi rend="bold"><hi rend="spaced">De</hi></hi><ptr type="liebermannNote" n="7" target="#ECfRetr_20.lnote.la.7"/> <hi rend="bold"><hi rend="spaced">friborgis</hi></hi><ptr type="liebermannNote" n="8" target="#ECfRetr_20.lnote.la.8"/> <hi rend="bold"><hi rend="spaced">(quod</hi></hi><ptr type="liebermannNote" n="9" target="#ECfRetr_20.lnote.la.9"/> <hi rend="bold"><hi rend="spaced">soli</hi></hi><ptr type="liebermannNote" n="10" target="#ECfRetr_20.lnote.la.10"/> <hi rend="bold"><hi rend="spaced">Eboracenses uocant</hi></hi><ptr type="liebermannNote" n="11" target="#ECfRetr_20.lnote.la.11"/> <hi rend="bold"><hi rend="spaced">ten</hi></hi><ptr type="liebermannNote" n="12" target="#ECfRetr_20.lnote.la.12"/> <hi rend="bold"><hi rend="spaced">menne</hi></hi><ptr type="liebermannNote" n="13" target="#ECfRetr_20.lnote.la.13"/> <hi rend="bold"><hi rend="spaced">tale, id est sermo</hi></hi><ptr type="liebermannNote" n="g" target="#ECfRetr_20.lnote.la.fn.g"/> <hi rend="bold"><hi rend="spaced">decem hominum).</hi></hi> <hi rend="bold">Preterea</hi> est <hi rend="bold">quedam</hi><ptr type="liebermannNote" n="14" target="#ECfRetr_20.lnote.la.14"/> <hi rend="bold">summa et</hi> maxima pax<ptr type="liebermannNote" n="15" target="#ECfRetr_20.lnote.la.15"/>, per quam omnes statu<ptr type="liebermannNote" n="16" target="#ECfRetr_20.lnote.la.16"/> firmissimo sustinentur, <hi rend="bold">uidelicet ut unusquisque</hi><ptr type="liebermannNote" n="17" target="#ECfRetr_20.lnote.la.17"/> stabiliat se sub fideiussionis <hi rend="bold">securitate,</hi> quam Angli<ptr type="liebermannNote" n="18" target="#ECfRetr_20.lnote.la.18"/> uocant friborgas<ptr type="liebermannNote" n="19" target="#ECfRetr_20.lnote.la.19"/>; <hi rend="bold">soli tamen</hi> Eboracenses <hi rend="bold">dicunt</hi> eandem<ptr type="liebermannNote" n="20" target="#ECfRetr_20.lnote.la.20"/> tien<ptr type="liebermannNote" n="21" target="#ECfRetr_20.lnote.la.21"/> manna<ptr type="liebermannNote" n="22" target="#ECfRetr_20.lnote.la.22"/> tale<ptr type="liebermannNote" n="23" target="#ECfRetr_20.lnote.la.23"/>, <hi rend="bold">quod sonat Latine</hi> decem hominum numerum.</ab>
        <note type="comparison" source="#liebermann" n="645"><label>printed alongside</label> <ref target="clause:ECf_20">ECf 20</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 645 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">computationem <hi rend="italic">übersetzt</hi> Registr. Richmond. <hi rend="italic">ed. Gale</hi> 22; sermo <hi rend="italic">ist Irrthum des zweiten Rubricators zur Retr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Registr. Richmond., ed. Gale 22, translates computationem; sermo is an error of the second Rubricator to the Retr.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">friborg <hi rend="italic">entspricht</hi> francum plegium; <hi rend="italic">seit Mitte</hi> 12. <hi rend="italic">Jhs. begegnet daneben</hi> friðborh, <hi rend="italic">erklärbar durch das Verstummen auslautender Dentale im Französischen;</hi> pacem <hi rend="italic">bezweckt die Einrichtung auch nach Wil. Malm.</hi> Reg. II 122; <hi rend="italic">vgl. mein</hi> Über Ed. Conf. <hi rend="italic">S.</hi> 28—31; 79—82</seg><seg type="translation" xml:lang="en" source="#claude">friborg corresponds to francum plegium; from the middle of the 12th century friðborh also occurs, explicable by the silencing of final dentals in French; the institution aims at pacem according to Wil. Malm., Reg. II 122, too; cf. my Über Ed. Conf. pp. 28–31; 79–82</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> De f. <hi rend="italic">Cb Lond;</hi> Quid sit frithborg <hi rend="italic">Hv Db;</hi> Quid sit frideborch <hi rend="italic">Lb Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">only De f. Cb Lond; Quid sit frithborg Hv Db; Quid sit frideborch Lb Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">-giis <hi rend="italic">K;</hi> fridb. et <hi rend="italic">S;</hi> frithb. <hi rend="italic">Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-giis K; fridb. et S; frithb. Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">q.—hom. <hi rend="italic">fehlt Cb Db Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">q.—hom. lacking in Cb Db Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">fridborch <hi rend="italic">fügt zu S;</hi> frithbirgh <hi rend="italic">Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">S adds fridborch; frithbirgh Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">tene <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">tene Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lb S;</hi> men <hi rend="italic">Hv Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Lb S; men Hv Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Rich</hi>(<hi rend="italic">mond Reg. hon.</hi> 239)</seg><seg type="translation" xml:lang="en" source="#claude">lacking in Rich(mond Reg. hon. 239)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Va Hv Lond;</hi> securitas <hi rend="italic">Lb Ra Ph Ld</hi> (<hi rend="italic">cursiv, also nicht in der älteren Hs. Ld 1</hi>) <hi rend="italic">und</hi> (<hi rend="italic">vielleicht aus Ld</hi>) <hi rend="italic">Rich</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Va Hv Lond; securitas Lb Ra Ph Ld (in italics, so not in the older MS Ld 1) and (perhaps from Ld) Rich</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">f. s. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. s. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">quisque <hi rend="italic">Rich</hi></seg><seg type="translation" xml:lang="en" source="#claude">quisque Rich</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">Anglici <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Anglici Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> freoborhges <hi rend="italic">Ld;</hi> frithb. <hi rend="italic">Hv;</hi> fritheb. <hi rend="italic">Lb Va Db Ra;</hi> frithesb. <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Lond; freoborhges Ld; frithb. Hv; fritheb. Lb Va Db Ra; frithesb. Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">am Rande Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">in the margin Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Ld;</hi> ten <hi rend="italic">Lb Va Db Ph;</hi> tynne <hi rend="italic">Lond;</hi> tene <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Ld; ten Lb Va Db Ph; tynne Lond; tene Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Ld;</hi> manne <hi rend="italic">Lond;</hi> mañ <hi rend="italic">Cb;</hi> menne <hi rend="italic">Lb Va Ph;</hi> men <hi rend="italic">Hv Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Ld; manne Lond; mañ Cb; menne Lb Va Ph; men Hv Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">tela <hi rend="italic">Cb;</hi> tala <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">tela Cb; tala Ld</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Of frankpledges (which the men of York alone call <hi rend="italic">ten menne tale</hi>, that is, the speech of ten men). Moreover there is a certain highest and greatest peace, by which all are upheld in the firmest state, namely that each man should establish himself under the security of suretyship, which the English call <hi rend="italic">friborgas</hi>; the men of York alone, however, call the same <hi rend="italic">tien manna tale</hi>, which means in Latin the number of ten men.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">346</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Nur <hi rend="italic">De friborgiis</hi><hi rend="superscript">8</hi> überschr. ohne <hi rend="italic">q.</hi><hi rend="superscript">9</hi> bis <hi rend="italic">hom.</hi> — <hi rend="italic">pax</hi><hi rend="superscript">15</hi> fehlt — <hi rend="italic">tynne</hi><hi rend="superscript">21</hi> <hi rend="italic">manne tala</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">Rs heads it only <hi rend="italic">De friborgiis</hi><hi rend="superscript">8</hi>, without <hi rend="italic">q.</hi><hi rend="superscript">9</hi> to <hi rend="italic">hom.</hi> — <hi rend="italic">pax</hi><hi rend="superscript">15</hi> lacking — <hi rend="italic">tynne</hi><hi rend="superscript">21</hi> <hi rend="italic">manne tala</hi> Rs</seg></note>
      </div>
    </body>
  </text>
