      <div type="clause" n="22">
        <head><ref type="lawCode" target="law:QuadrDed">Quadr Ded</ref> 22</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Ded 22" corresp="#wit-lat"><pb n="531" ed="#liebermann"/>Si respiciant alios aurea<ptr type="liebermannNote" n="d" target="#QuadrDed_22.lnote.oe.d"/> deliciarum med[i]ocritate<ptr type="liebermannNote" n="2" target="#QuadrDed_22.lnote.oe.2"/> prouectos, qui lautiorem uitam sequi uel aliquos dignitatis gradus et idonea promotionis augmenta non [a]bhorreant<ptr type="liebermannNote" n="3" target="#QuadrDed_22.lnote.oe.3"/> et magis prodesse<ptr type="liebermannNote" n="dd" target="#QuadrDed_22.lnote.oe.dd"/> gaudeant et aliquid audeant inter homines inueniri, hos infamiæ denotatione polluunt et æternis cruciatibus deputare preiudicant, tanquam diues Deus famulos diuites habere non possit, si<ptr type="liebermannNote" n="e" target="#QuadrDed_22.lnote.oe.e"/> tantum eos appetat qui luctu<ptr type="liebermannNote" n="4" target="#QuadrDed_22.lnote.oe.4"/> et miseriis perditam uitam turpi mendicitate sustentent et qui cotidiane necessitatis alimenta laboriosis fatigationibus se[m]per<ptr type="liebermannNote" n="5" target="#QuadrDed_22.lnote.oe.5"/> exquirant.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 531 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_22.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Horaz</hi> Carm. 2, 10, 5</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Horace</hi> Carm. 2, 10, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_22.lnote.oe.dd" n="dd" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> II Praef. 7</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> II Praef. 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_22.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> acsi <hi rend="italic">oder</hi> sed</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">read</hi> acsi <hi rend="italic">or</hi> sed</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_22.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de">medroc. <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">medroc. <hi rend="italic">Dm</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_22.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de">obh. <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">obh. <hi rend="italic">Dm</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_22.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de">lucatu <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">lucatu <hi rend="italic">Dm</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_22.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de">seper <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">seper <hi rend="italic">Dm</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_22.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de">Dieses Eintreten zugunsten der Geistlichen in Amtsmacht und Reichtum erklärt sich nur, wenn Verf. ihnen zugehörte oder sozial nahe stand</seg><seg type="translation" xml:lang="en" source="#claude">This advocacy on behalf of the clergy in official power and wealth can only be explained if the author belonged to them or stood socially close to them</seg></note>
      </div>
