    <body>
      <div type="clause" n="84.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 84.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="84.1" corresp="#wit-g-a"><pb n="368" ed="#liebermann"/>Eallum us is mycel<ptr type="liebermannNote" n="6" target="#IICn_84-1.lnote.oe.6-2"/> þearf, þ<hi rend="italic">æt</hi> we God lufian ⁊ Godes lage<ptr type="liebermannNote" n="7" target="#IICn_84-1.lnote.oe.7"/> fylgean ⁊ godcundan lareowan<ptr type="liebermannNote" n="8" target="#IICn_84-1.lnote.oe.8"/> geornlice hyran.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="84.1" corresp="#wit-b"><pb n="368" ed="#liebermann"/>Eallum us is mycel ðearf, þ<hi rend="italic">æt</hi> we God lufian ⁊ Godes lage fylian<ptr type="liebermannNote" n="1" target="#IICn_84-1.lnote.oe.1"/> ⁊ godcundan lareowan ⁊<ptr type="liebermannNote" n="*" target="#IICn_84-1.lnote.oe.star"/> geor[n]lice<ptr type="liebermannNote" n="2" target="#IICn_84-1.lnote.oe.2"/> hyran.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="84.1" corresp="#wit-a"><pb n="368" ed="#liebermann"/>Eallum us his<ptr type="liebermannNote" n="3" target="#IICn_84-1.lnote.oe.3"/> michel<ptr type="liebermannNote" n="4" target="#IICn_84-1.lnote.oe.4-2"/> þearf, þ<hi rend="italic">æt</hi> we Godd lufian ⁊ Godes laga fylgean ⁊ godcundan larewan geornlice hyram<ptr type="liebermannNote" n="3" target="#IICn_84-1.lnote.oe.3"/> ⁊<ptr type="liebermannNote" n="5" target="#IICn_84-1.lnote.oe.5-2"/> Godes lage fylgean.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="84.1" corresp="#wit-q"><pb n="369" ed="#liebermann"/>Omnibus nobis magnum opus est, ut Deum uere<ptr type="liebermannNote" n="4" target="#IICn_84-1.lnote.oe.4"/> diligamus et Dei legi<ptr type="liebermannNote" n="5" target="#IICn_84-1.lnote.oe.5"/> seruiamus, sanctis doctoribus deuote<ptr type="liebermannNote" n="6" target="#IICn_84-1.lnote.oe.6"/> pareamus;</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="84.1" corresp="#wit-cons-cn"><pb n="369" ed="#liebermann"/>Omnibus nobis uehementer expedit, ut Deum diligamus et Dei legem sequamur diuinisque doctoribus obediamus diligenter.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="84.1" corresp="#wit-b"><pb n="216" ed="#robertson"/>Eallum us is mycel ðearf þæt we God lufian ⁊ Godes lage fylian<ptr type="editorNote" n="8" target="#IICn_84-1.robnote.fn.8"/> ⁊ godcundan lareowan<ptr type="editorNote" n="9" target="#IICn_84-1.robnote.fn.9"/> geor[n]lice<ptr type="editorNote" n="10" target="#IICn_84-1.robnote.fn.10"/> hyran<ptr type="editorNote" n="11" target="#IICn_84-1.robnote.fn.11"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="296" ed="#rabin-doml"/>Eallum us is mycel þearf þæt we God lufian and Godes lage fylgean and godcundan lareowan geornlice hyran.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="369" ed="#liebermann"/>Uns allen ist starke Noth, dass wir Gott<ptr type="liebermannNote" n="1" target="#IICn_84-1.lnote.de.1"/> lieben und Gottes Gesetz(e?) befolgen und geistlichen Lehrern eifrig gehorchen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">There is great need for all of us that we love God and follow God's law(s?) and eagerly obey spiritual teachers.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="217" ed="#robertson"/>There is great need for us all to love God and to follow God's law, and zealously to obey our spiritual teachers.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="297" ed="#rabin-doml"/>There is a great need for all of us to praise God and follow God’s law and zealously heed our spiritual teachers.</ab>
        <note type="editorial">Liebermann would strike A's final ‘⁊ Godes lage fylgean’ as a repetition.; BR: added from Gesetze I p. 369, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">geornlice: and georlice B</note>
        <note type="textual" source="#rabin-doml">hyran: A adds and Godes lage fylgean</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-1.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zu streichen</hi></seg><seg type="translation" xml:lang="en" source="#claude">to be deleted</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de">georl.</seg><seg type="translation" xml:lang="en" source="#claude">georl.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">369</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">369</biblScope></bibl><seg type="original" xml:lang="de">leges <hi rend="italic">K; verbessert aus</hi> lege <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">leges K; corrected from lege Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">369</biblScope></bibl><seg type="original" xml:lang="de">p. d. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. d. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-1.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de">michel <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">michel Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de">laga <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">laga Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de">larewan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">larewan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-1.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Mittelenglisch</hi></seg><seg type="translation" xml:lang="en" source="#claude">Middle English</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-1.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">streiche</hi> ⁊ G. l. f. <hi rend="italic">als Wiederholung</hi></seg><seg type="translation" xml:lang="en" source="#claude">delete ⁊ G. l. f. as a repetition</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_84-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">214</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Ebenso I 1. 21</seg><seg type="translation" xml:lang="en" source="#claude">Likewise I 1. 21</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_84-1.robnote.fn.8" n="8" source="#robertson"><bibl><biblScope unit="page">216</biblScope></bibl><label>fylian</label><seg type="original" xml:lang="en"><hi rend="italic">fylgean</hi> G, A, Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_84-1.robnote.fn.9" n="9" source="#robertson"><bibl><biblScope unit="page">216</biblScope></bibl><label>lareowan</label><seg type="original" xml:lang="en"><hi rend="italic">lar.</hi> ⁊ <hi rend="italic">g.</hi> B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_84-1.robnote.fn.10" n="10" source="#robertson"><bibl><biblScope unit="page">216</biblScope></bibl><label>geor[n]lice</label><seg type="original" xml:lang="en"><hi rend="italic">georl.</hi> B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_84-1.robnote.fn.11" n="11" source="#robertson"><bibl><biblScope unit="page">216</biblScope></bibl><label>hyran</label><seg type="original" xml:lang="en">A repeats: ⁊ <hi rend="italic">Godes lage fylgean.</hi></seg></note>
      </div>
