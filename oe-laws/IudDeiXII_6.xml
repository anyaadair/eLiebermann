      <div type="clause" n="6">
        <head><ref type="lawCode" target="law:IudDeiXII">Iud Dei XII</ref> 6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XII 6" corresp="#wit-lat"><ptr type="liebermannNote" n="32" target="#IudDeiXII_6.lnote.oe.32"/><pb n="420" ed="#liebermann"/>Iustus<ptr type="liebermannNote" n="33" target="#IudDeiXII_6.lnote.oe.33"/> es<ptr type="liebermannNote" n="34" target="#IudDeiXII_6.lnote.oe.34"/>, Domine, et rectum iudicium.<ptr type="liebermannNote" n="35" target="#IudDeiXII_6.lnote.oe.35"/></ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Ps. 118, 137</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 420 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_6.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de">Incipit missa ad iudicium <hi rend="italic">fügt roth zu Vt2</hi></seg><seg type="translation" xml:lang="en" source="#claude">Vt2 adds in red Incipit missa ad iudicium</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_6.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">c.</hi> 6—14 Missa iudicii, <hi rend="italic">Zeu.</hi> 707, <hi rend="italic">grossentheils verschieden von der in Iud. Dei</hi> I 4, <hi rend="italic">oben S.</hi> 402 <hi rend="italic">ff.</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. 6—14 Missa iudicii, Zeu. 707, largely different from that in Iud. Dei I 4, above p. 402 ff.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_6.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de">est <hi rend="italic">Ll Tb</hi></seg><seg type="translation" xml:lang="en" source="#claude">est Ll Tb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_6.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de">tuum <hi rend="italic">fügt zu Vt2 Tr. Von hier bis</hi> 14 <hi rend="italic">abweichend, entnimmt Tr die Messe aus Iud. Dei</hi> I 4—18, <hi rend="italic">o. S.</hi> 402 <hi rend="italic">ff.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Vt2 Tr add tuum. From here to 14 Tr diverges, taking the mass from Iud. Dei I 4—18, above p. 402 ff.</seg></note>
      </div>
    </body>
