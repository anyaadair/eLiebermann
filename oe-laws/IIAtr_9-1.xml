    <body>
      <div type="clause" n="9.1">
        <head><ref type="lawCode" target="law:IIAtr">II Atr</ref> 9.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="9.1" corresp="#wit-b"><pb n="226" ed="#liebermann"/>Warige<ptr type="liebermannNote" n="11" target="#IIAtr_9-1.lnote.oe.11"/> eac hine se ðe his hagen<ptr type="liebermannNote" n="12" target="#IIAtr_9-1.lnote.oe.12"/> befoð: <ptr type="liebermannNote" n="13" target="#IIAtr_9-1.lnote.oe.13"/>he to ælcan<ptr type="liebermannNote" n="14" target="#IIAtr_9-1.lnote.oe.14"/> teame hæbbe getrywne borh ⁊ beorge, þ<hi rend="italic">æt</hi> he awoh ne befo, ðy les<ptr type="liebermannNote" n="15" target="#IIAtr_9-1.lnote.oe.15"/> ðe hine mon swence, swa he oðerne man ðohte.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="9.1" corresp="#wit-q"><pb n="226" ed="#liebermann"/>Admoneat<ptr type="liebermannNote" n="6" target="#IIAtr_9-1.lnote.oe.6"/> etiam<ptr type="liebermannNote" n="7" target="#IIAtr_9-1.lnote.oe.7"/> eum ille qui suum<ptr type="liebermannNote" n="8" target="#IIAtr_9-1.lnote.oe.8"/> prosequitur, ut ad singulas appellationes habeat credibile testimonium, et caueat, ne iniuste interciet, ne per hoc disturbetur, sicut alium disturbare cogitaverat.<ptr type="liebermannNote" n="9" target="#IIAtr_9-1.lnote.oe.9"/></ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="9.1" corresp="#wit-b"><pb n="62" ed="#robertson"/>Warige eac hine se ðe his agen<ptr type="editorNote" n="2" target="#IIAtr_9-1.robnote.fn.2"/> befoð: he to ælcan teame hæbbe getrywne borh ⁊ beorge þæt he awoh ne befo, ðy les ðe hine mon swence, swa he oðerne man ðohte.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="227" ed="#liebermann"/>Sehe<ptr type="liebermannNote" n="1" target="#IIAtr_9-1.lnote.de.1"/> sich auch vor, wer sein Eigen im Anefang fasst, [dass] er [vom Ziehenden] vertrauenswerthe Bürgschaft<ptr type="liebermannNote" n="2" target="#IIAtr_9-1.lnote.de.2"/> zu jedem Gewährszuge erhalte, und hüte sich, dass er nicht fälschlich<ptr type="liebermannNote" n="3" target="#IIAtr_9-1.lnote.de.3"/> Anefang übe, damit er [selbst] nicht so belästigt werde, wie er den anderen [Besitzer zu belästigen] geplant hatte.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Let whoever attaches his own property also take care [that] he obtain trustworthy surety [from the vouching party] for every vouching to warranty, and beware of attaching wrongfully, lest he [himself] be put to trouble as he had intended [to trouble] the other [possessor].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="63" ed="#robertson"/>Likewise, he who attaches his goods shall see to it that he has trustworthy security<ptr type="editorNote" n="1" target="#IIAtr_9-1.robnote.n.1"/> in every case of vouching to warranty, and shall beware of attaching wrongly, lest the burden which he had thought should be borne by the other man should be laid upon him.</ab>
        <note type="comparedBy" source="#wormald-mel" n="370"><ref target="clause:Forf_2">Forf 2</ref></note>
        <note type="editorial">‘þæt’ is supplied by editors.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_9-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">226</biblScope></bibl><seg type="original" xml:lang="de">-oueat <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">-oueat R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_9-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">226</biblScope></bibl><seg type="original" xml:lang="de">eum et <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">eum et T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_9-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">226</biblScope></bibl><seg type="original" xml:lang="de">iuste <hi rend="italic">fügt zu MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">iuste added by MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_9-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">226</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert aus</hi> -rit <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected from -rit R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_9-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">226</biblScope></bibl><seg type="original" xml:lang="de">Parige, <hi rend="italic">am Rande: ‘al.</hi> parige <hi rend="italic">et rectius quidem’ Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Parige, in the margin: ‘al. parige et rectius quidem’ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_9-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">226</biblScope></bibl><seg type="original" xml:lang="de">agen <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">agen Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_9-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">226</biblScope></bibl><seg type="original" xml:lang="de">þæt <hi rend="italic">ergänzen Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">þæt supplied by edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_9-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">226</biblScope></bibl><seg type="original" xml:lang="de">ælcon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ælcon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_9-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">226</biblScope></bibl><seg type="original" xml:lang="de">læs <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">læs Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAtr_9-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">155</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Unter den Bedd. wählt die hier unpassende ‘ermahnen, warnen’ Q</seg><seg type="translation" xml:lang="en" source="#claude">Among the meanings Q chooses ‘admonish, warn’, which does not fit here</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAtr_9-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">155</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. 8⁴; ‘Zeugnis’ fordert Q, ebenso wie I Ew 1, 2; <hi rend="italic">s. u</hi>. 9, 2³. <hi rend="italic">Vgl. Gl</hi> Anefang 5c. 10a. 27a</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 8⁴; Q requires ‘testimony’, just as I Ew 1, 2; <hi rend="italic">see below</hi> 9, 2³. <hi rend="italic">Cf. Gl</hi> Anefang 5c. 10a. 27a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAtr_9-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">155</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Verleumdung 3—4. Diebstahlbusse versteht als Strafe Rauch <hi rend="italic">Spurfolge</hi> 40</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Verleumdung 3—4. Rauch <hi rend="italic">Spurfolge</hi> 40 takes the compensation for theft as a punishment</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIAtr_9-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">317</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e.</hi> that he obtains trustworthy security from the person against whom he is making the claim, cf. I Edw. 1, 2. The second clause <hi rend="italic">and beorge þæt he awoh ne befo</hi> seems to introduce another consideration—not connected with the preceding—which the plaintiff has to bear in mind.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAtr_9-1.robnote.fn.2" n="2" source="#robertson"><bibl><biblScope unit="page">62</biblScope></bibl><label>agen</label><seg type="original" xml:lang="en">Ld; <hi rend="italic">hagen</hi> B.</seg></note>
      </div>
