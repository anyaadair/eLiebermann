      <div type="clause" n="13.7">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 13.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 13.7" corresp="#wit-lat"><pb n="424" ed="#liebermann"/>Si de hoc furto ille<ptr type="liebermannNote" n="41" target="#IudDeiXIII_13-7.lnote.oe.41"/>, pro quo<ptr type="liebermannNote" n="41" target="#IudDeiXIII_13-7.lnote.oe.41"/> tu<ptr type="liebermannNote" n="41" target="#IudDeiXIII_13-7.lnote.oe.41"/> in aquam mittendus<ptr type="liebermannNote" n="41" target="#IudDeiXIII_13-7.lnote.oe.41"/> es<ptr type="liebermannNote" n="41" target="#IudDeiXIII_13-7.lnote.oe.41"/>, sciebat aut consensit aut conscius inde fuit, nullo modo tu suscipiaris ab<ptr type="liebermannNote" n="42" target="#IudDeiXIII_13-7.lnote.oe.42"/> aqua.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 424 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-7.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Plural überall roth darüber Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">plural written above in red throughout Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-7.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">hac <hi rend="italic">fügt zu Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">hac added by Tr</seg></note>
      </div>
