      <div type="clause" n="31.2">
        <head><ref type="lawCode" target="law:PsCnFor">Ps Cn for</ref> 31.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Ps Cn for 31.2" corresp="#wit-ho-st-cii"><pb n="625" ed="#liebermann"/>Si uero infra septa foreste<ptr type="liebermannNote" n="s" target="#PsCnFor_31-2.lnote.la.fn.s"/> reperiatur, dominus canis forisfaciet<ptr type="liebermannNote" n="27" target="#PsCnFor_31-2.lnote.la.27"/> et<ptr type="liebermannNote" n="28" target="#PsCnFor_31-2.lnote.la.28"/> canem<ptr type="liebermannNote" n="29" target="#PsCnFor_31-2.lnote.la.29"/> et decem<ptr type="liebermannNote" n="t" target="#PsCnFor_31-2.lnote.la.fn.t"/> solidos regi.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 625 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-ho-st-cii">But if [the dog] is found within the enclosures of the forest, the owner of the dog shall forfeit both the dog and ten shillings to the king.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_31-2.lnote.la.fn.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">625</biblScope></bibl><seg type="original" xml:lang="de">Nullus habeat canes nec leporarios in foresta; <hi rend="italic">Heinrichs II. Assisa</hi> 2</seg><seg type="translation" xml:lang="en" source="#claude">Nullus habeat canes nec leporarios in foresta; Henry II's Assize 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_31-2.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">625</biblScope></bibl><seg type="original" xml:lang="de">-cit <hi rend="italic">St Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cit St Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_31-2.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">625</biblScope></bibl><seg type="original" xml:lang="de">et c. <hi rend="italic">fehlt Ho</hi></seg><seg type="translation" xml:lang="en" source="#claude">et c. lacking in Ho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_31-2.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">625</biblScope></bibl><seg type="original" xml:lang="de">comem <hi rend="italic">Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">comem Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_31-2.lnote.la.fn.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">625</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 22<hi rend="superscript"><hi rend="italic">c</hi></hi></seg><seg type="translation" xml:lang="en" source="#claude">see above, 22 note c</seg></note>
      </div>
    </body>
