      <div type="clause" n="5.2a">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 5.2a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 5.2a"><pb n="630" ed="#liebermann"/>Et si illud extirpauerit et de suo proprio quod<ptr type="liebermannNote" n="31" target="#ECf_5-2a.lnote.la.31"/> reddat habuerit, in<ptr type="liebermannNote" n="32" target="#ECf_5-2a.lnote.la.32"/> integrum ei a quo furatum<ptr type="liebermannNote" n="33" target="#ECf_5-2a.lnote.la.33"/> est restituat<ptr type="liebermannNote" n="34" target="#ECf_5-2a.lnote.la.34"/>.</ab>
        <note type="comparison" source="#liebermann" n="630"><label>printed alongside</label> <ref target="clause:ECfRetr_5-2a">ECf retr 5.2a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 630 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5-2a.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">habeat quod r., int. <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">habeat quod r., int. Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5-2a.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt S</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5-2a.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">-tus <hi rend="italic">Hr;</hi> fraudatum <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tus Hr; fraudatum Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5-2a.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">reddat <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">reddat Hk</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And if he has done away with it and has of his own wherewith to repay, let him restore it in full to him from whom it was stolen.</ab>
      </div>
