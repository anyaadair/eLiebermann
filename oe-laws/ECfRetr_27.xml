      <div type="clause" n="27">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 27</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 27"><pb n="651" ed="#liebermann"/><hi rend="spaced">Item de pace regis</hi><ptr type="liebermannNote" n="1" target="#ECfRetr_27.lnote.la.1"/><hi rend="spaced">.</hi> <hi rend="bold"><hi rend="spaced">(Quomodo uel quid emendare solebant, quid regi, quid decano dabant qui pacem regis infringebant.)</hi></hi> Pax data manu regis et octo dierum quibus primum coronatus est et pax <hi rend="bold">pre</hi>dictorum festorum et pax per breue regis unum<ptr type="liebermannNote" n="2" target="#ECfRetr_27.lnote.la.2"/> habent<ptr type="liebermannNote" n="3" target="#ECfRetr_27.lnote.la.3"/> <hi rend="bold">modum</hi><ptr type="liebermannNote" n="4" target="#ECfRetr_27.lnote.la.4"/> emendationis, et<ptr type="liebermannNote" n="5" target="#ECfRetr_27.lnote.la.5"/> hoc iudicio quod maius<ptr type="liebermannNote" n="6" target="#ECfRetr_27.lnote.la.6"/> habetur in<ptr type="liebermannNote" n="7" target="#ECfRetr_27.lnote.la.7"/> scira<ptr type="liebermannNote" n="8" target="#ECfRetr_27.lnote.la.8"/>, ubi pax fracta fuerit</ab>
        <note type="comparison" source="#liebermann" n="651"><label>printed alongside</label> <ref target="clause:ECf_27">ECf 27</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 651 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 12—12, 3. 27, 2; <hi rend="italic">mein</hi> Über Ed. Conf. <hi rend="italic">S.</hi> 113</seg><seg type="translation" xml:lang="en" source="#claude">cf. 12–12, 3. 27, 2; my Über Ed. Conf. p. 113</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so nur Lond;</hi> Quom.—infr. <hi rend="italic">Pl S Lb Va Hv; davor</hi> Item <hi rend="italic">Pl S;</hi> Que forisfactura sit de pace regis fracta <hi rend="italic">Cb;</hi> De emenda eorum qui p. r. i. <hi rend="italic">Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">so only Lond; Quom.—infr. Pl S Lb Va Hv; Item before it Pl S; Que forisfactura sit de pace regis fracta Cb; De emenda eorum qui p. r. i. Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">unde <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">unde K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">habet <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">habet Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">e. m. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. m. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">etiam <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">etiam Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">magis <hi rend="italic">Va Ph Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">magis Va Ph Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">et K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">sira <hi rend="italic">Lb Va;</hi> schira <hi rend="italic">Hv K</hi></seg><seg type="translation" xml:lang="en" source="#claude">sira Lb Va; schira Hv K</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Again concerning the king's peace. (How or what they used to pay in compensation, what they gave to the king, what to the dean, who broke the king's peace.) The peace given by the king's hand, and that of the eight days on which he was first crowned, and the peace of the aforesaid feasts, and the peace by the king's writ have one manner of compensation, and that by the judgment which is held the greater in the shire where the peace has been broken</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">unde</hi><hi rend="superscript">2</hi> — <hi rend="italic">schira</hi><hi rend="superscript">8</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">unde</hi><hi rend="superscript">2</hi> — <hi rend="italic">schira</hi><hi rend="superscript">8</hi> Rs</seg></note>
      </div>
    </body>
  </text>
