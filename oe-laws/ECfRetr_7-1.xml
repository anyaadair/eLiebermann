  <text>
    <body>
      <div type="clause" n="7.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 7.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 7.1"><pb n="632" ed="#liebermann"/>Si<ptr type="liebermannNote" n="1" target="#ECfRetr_7-1.lnote.la.1"/> quis gregem equarum habuerit<ptr type="liebermannNote" n="2" target="#ECfRetr_7-1.lnote.la.2"/>, pullum reddat decimum; qui unam <hi rend="bold">tantum</hi> uel<ptr type="liebermannNote" n="3" target="#ECfRetr_7-1.lnote.la.3"/> duas <hi rend="bold">habuerit,</hi> de singulis pullis singulos denarios<ptr type="liebermannNote" n="4" target="#ECfRetr_7-1.lnote.la.4"/>.</ab>
        <note type="comparison" source="#liebermann" n="632"><label>printed alongside</label> <ref target="clause:ECf_7-1">ECf 7.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 632 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-1.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">Et si <hi rend="italic">Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et si Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-1.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">-uit <hi rend="italic">Va K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uit Va K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-1.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">h. u. d. <hi rend="italic">Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. u. d. Dc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-1.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">prebeat <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds prebeat</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">If anyone has a herd of mares, let him render the tenth foal; he who has only one or two, for each foal a penny.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-1.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">344</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">habuit</hi><hi rend="superscript">2</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">habuit</hi><hi rend="superscript">2</hi> Rs</seg></note>
      </div>
    </body>
  </text>
