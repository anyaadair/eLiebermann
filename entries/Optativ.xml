          <sense n="4">[<hi rend="italic"><ref type="abbreviation" target="gram:fruher"><abbr>früher</abbr></ref>?</hi>] <hi rend="italic"><ref type="abbreviation" target="gram:fur"><abbr>für</abbr></ref></hi> sculan <hi rend="italic"><ref type="abbreviation" target="gram:mit"><abbr>m.</abbr></ref> <ref type="abbreviation" target="gram:Infinitiv"><abbr>inf</abbr></ref>;</hi> swelte 14 <ref type="lawCode" target="law:H">H</ref>; sceal sweltan <ref type="lawCode" target="law:E">E</ref> <ref type="lawCode" target="law:G">G</ref></sense>
