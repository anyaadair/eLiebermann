    <body>
      <div type="clause" n="22.3">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 22.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 22.3"><pb n="647" ed="#liebermann"/><ptr type="liebermannNote" n="47" target="#ECfRetr_22-3.lnote.la.47"/><hi rend="bold"><hi rend="spaced">Quid sit</hi></hi><ptr type="liebermannNote" n="32" target="#ECfRetr_22-3.lnote.la.32"/> <hi rend="bold"><hi rend="spaced">theam</hi></hi><ptr type="liebermannNote" n="48" target="#ECfRetr_22-3.lnote.la.48"/><hi rend="bold"><hi rend="spaced">.</hi></hi> Theam<ptr type="liebermannNote" n="49" target="#ECfRetr_22-3.lnote.la.49"/>: quod, si quis<hi rend="bold">piam</hi> aliquid<ptr type="liebermannNote" n="50" target="#ECfRetr_22-3.lnote.la.50"/> intercietur<ptr type="liebermannNote" n="51" target="#ECfRetr_22-3.lnote.la.51"/> super aliquem et <hi rend="bold">interciatus</hi> non<ptr type="liebermannNote" n="52" target="#ECfRetr_22-3.lnote.la.52"/> poterit suum<ptr type="liebermannNote" n="53" target="#ECfRetr_22-3.lnote.la.53"/> warantum habere, erit forisfactura <hi rend="bold">sua</hi> et iusticia; similiter de calumniatore<ptr type="liebermannNote" n="54" target="#ECfRetr_22-3.lnote.la.54"/>, si defecerit.</ab>
        <note type="comparison" source="#liebermann" n="647"><label>printed alongside</label> <ref target="clause:ECf_22-3">ECf 22.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 647 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-3.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">sua <hi rend="italic">ergänzt Retr., richtig laut</hi> 22, 1</seg><seg type="translation" xml:lang="en" source="#claude">the Retr. supplies sua, rightly according to 22, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-3.lnote.la.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">De t. <hi rend="italic">Sp; fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">De t. Sp; lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-3.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">est <hi rend="italic">Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">est Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-3.lnote.la.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">thém <hi rend="italic">Lb Va Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">thém Lb Va Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-3.lnote.la.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">them <hi rend="italic">Lb Va Ph;</hi> est <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">them Lb Va Ph; Hv adds est</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-3.lnote.la.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">i. a. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. a. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-3.lnote.la.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">-ciet <hi rend="italic">Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ciet Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-3.lnote.la.52" n="52" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">s. w. h. n. p. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. w. h. n. p. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-3.lnote.la.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">w. s. <hi rend="italic">Sp Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">w. s. Sp Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-3.lnote.la.54" n="54" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">calupn. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">calupn. Cb</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">What team is. Team: that, if anyone attaches something in the hands of another, and the man attached cannot have his warrantor, the forfeiture and the justice shall be his; likewise concerning the accuser, if he fails.</ab>
      </div>
