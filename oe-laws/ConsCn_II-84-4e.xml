      <div type="clause" n="II 84.4e">
        <head><ref type="lawCode" target="law:ConsCn">Cons Cn</ref> II 84.4e</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Cons Cn II 84.4e" corresp="#wit-lat"><pb n="619" ed="#liebermann"/>Illi<ptr type="liebermannNote" n="d" target="#ConsCn_II-84-4e.lnote.oe.d"/> autem ordinati faciant, ut sibi necessarium<ptr type="liebermannNote" n="e" target="#ConsCn_II-84-4e.lnote.oe.e"/> est: die noctuque inuocent Christum sepe et frequenter et pro cuncto Christiano populo intercedant diligenter.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 619 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ConsCn_II-84-4e.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">619</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. o. S.</hi> 289*; <hi rend="italic">es scheint hier Consil.</hi> I 6, <hi rend="italic">nicht nochmals Cnuts Original benutzt</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. above p. 289*; Consil. I 6 seems to have been used here, not Cnut's original a second time</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ConsCn_II-84-4e.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">619</biblScope></bibl><seg type="original" xml:lang="de">swa him þearf is <hi rend="italic">las Quelle wie V Atr.</hi> 5</seg><seg type="translation" xml:lang="en" source="#claude">swa him þearf is the source read, as V Atr. 5</seg></note>
      </div>
    </body>
