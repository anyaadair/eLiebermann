    <body>
      <div type="clause" n="10.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 10.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 10.1"><pb n="634" ed="#liebermann"/>Iste uero denarius<ptr type="liebermannNote" n="8" target="#ECf_10-1.lnote.la.8"/> submoniri<ptr type="liebermannNote" n="9" target="#ECf_10-1.lnote.la.9"/> debet in festiuitate<ptr type="liebermannNote" n="10" target="#ECf_10-1.lnote.la.10"/> sanctorum apostolorum Petri et Pauli<ptr type="liebermannNote" n="c" target="#ECf_10-1.lnote.la.fn.c"/> et ultra festiuitatem<ptr type="liebermannNote" n="11" target="#ECf_10-1.lnote.la.11"/> sancti Petri<ptr type="liebermannNote" n="a" target="#ECf_10-1.lnote.oe.erkl-a"/> ad uincula<ptr type="liebermannNote" n="d" target="#ECf_10-1.lnote.la.fn.d"/> non detineatur.</ab>
        <note type="comparison" source="#liebermann" n="634"><label>printed alongside</label> <ref target="clause:ECfRetr_10-1">ECf retr 10.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 634 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-1.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">29. <hi rend="italic">Juni; Zahlung nach</hi> VI Atr. Lat. 18</seg><seg type="translation" xml:lang="en" source="#claude">29 June; payment according to VI Atr. Lat. 18</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-1.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">1. <hi rend="italic">August</hi></seg><seg type="translation" xml:lang="en" source="#claude">1 August</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-1.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-1.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Rl;</hi> summ. <hi rend="italic">übr.;</hi> -neri <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Rl; summ. the others; -neri Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-1.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">festis <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">festis Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-1.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">festum <hi rend="italic">S Hr; fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">festum S Hr; lacking in Ad Do</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">This penny ought to be called for at the feast of the holy apostles Peter and Paul, and let it not be withheld beyond the feast of St Peter ad Vincula.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-1.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">345</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Gl ebd.</hi> 15; 1. Aug. als Zahltag auch <hi rend="italic">Custum. Battle</hi> p. 43; Mat. Paris in <hi rend="italic">Mon. Germ.</hi> 28, 434</seg><seg type="translation" xml:lang="en" source="#claude">Gl ibid. 15; 1 August as day of payment also in <hi rend="italic">Custum. Battle</hi> p. 43; Mat. Paris in <hi rend="italic">Mon. Germ.</hi> 28, 434</seg></note>
      </div>
