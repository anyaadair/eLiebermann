      <div type="clause" n="66.7">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 66.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 66.7" corresp="#wit-lat"><pb n="586" ed="#liebermann"/>Si manupastum<ptr type="liebermannNote" n="2" target="#Hn_66-7.lnote.oe.2"/><ptr type="liebermannNote" n="c" target="#Hn_66-7.lnote.oe.c"/> alicuius accusetur de furto, solus paterfamilias em[u]ndare<ptr type="liebermannNote" n="3" target="#Hn_66-7.lnote.oe.3"/> potest,' si uelit, fracta<ptr type="liebermannNote" n="d" target="#Hn_66-7.lnote.oe.d"/> lege, sine preiurante<ptr type="liebermannNote" n="4" target="#Hn_66-7.lnote.oe.4"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 586 (two independent readings of the page images, differences settled against the page); Liebermann’s print has a stray raised mark after ‘potest,’; transcribed as printed</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-7.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">Gesinde, Hausfamilie (<hi rend="italic">App. A Gu.</hi> 5)?; <hi rend="italic">über die Haftung für sie vgl. Brunner</hi> DRG. II 276; <hi rend="italic">Poll.-Maitl.</hi> HEL. II 529</seg><seg type="translation" xml:lang="en" source="#claude">Household servants, the domestic household (App. A Gu. 5)?; on liability for them cf. Brunner DRG. II 276; Poll.-Maitl. HEL. II 529</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-7.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">durch Stabeid allein, falls nicht Klägers Voreid [66, 8] zur Reinigung mit Helfern zwingt. <hi rend="italic">Anders</hi> 41, 6 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">by the formal oath alone, unless the plaintiff’s fore-oath [66, 8] compels purgation with helpers. Otherwise 41, 6 <hi rend="italic">f.</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-7.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">-tus <hi rend="italic">ändert Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">Wi Tho alter to -tus</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-7.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">emend. <hi rend="italic">Hss. Edd.</hi> [<hi rend="italic">verderbt auch</hi> 52, 1<hi rend="italic">b</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">emend. MSS edd. [also corrupt at 52, 1<hi rend="italic">b</hi>]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-7.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">peri. <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">peri. Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-7.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Gefolge 16e; Haushalt 1; Stabeid 7—<hi rend="italic">emend</hi>.{5} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Gefolge 16e; Haushalt 1; Stabeid 7—<hi rend="italic">emend</hi>.{5} Rs</seg></note>
      </div>
