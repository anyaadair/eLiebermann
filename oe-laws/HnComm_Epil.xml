    <body>
      <div type="clause" n="Epil.">
        <head><ref type="lawCode" target="law:HnComm">Hn com</ref> Epil.</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-sc"><ptr type="liebermannNote" n="37" target="#HnComm_Epil.lnote.oe.37"/><pb n="524" ed="#liebermann"/>Teste R[icardo] episcopo Lundonie et Rogero episcopo et Ranulfo cancellario et R[odberto] comite de Mellent apud Rading’.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="Epil." corresp="#wit-sc"><pb n="286" ed="#robertson"/>Teste—R[icardo] episcopo Lundoniae et Rogero episcopo et Ranulfo cancellario et R[odberto] comite de Mellent, apud Rading'.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-sc"><pb n="287" ed="#robertson"/>Witnesses: Richard, Bishop of London, and Bishop Roger and Chancellor Ranulf and Earl Robert de Meulan, at Reading.</ab>
        <note type="editorial">Added October 2026 from Robertson pp. 286–287 (text and translation); Liebermann’s text added from Gesetze I p. 524, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="HnComm_Epil.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">524</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Zeugen fehlen Quadr Co.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Witnesses missing in Quadr Co.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="HnComm_Epil.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">301</biblScope></bibl><seg type="original" xml:lang="de">Von Salisbury. <hi rend="italic">S. o</hi>. Einl. 2</seg><seg type="translation" xml:lang="en" source="#claude">Of Salisbury. <hi rend="italic">See above</hi> Introduction 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="HnComm_Epil.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">301</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. Hn mon Test{b}</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> Hn mon Test{b}</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="HnComm_Epil.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">301</biblScope></bibl><seg type="original" xml:lang="de">Heinrich gründete später zu Reading eine Abtei, wo er dann auch begraben wurde</seg><seg type="translation" xml:lang="en" source="#claude">Henry later founded an abbey at Reading, where he was afterwards also buried</seg></note>
      </div>
