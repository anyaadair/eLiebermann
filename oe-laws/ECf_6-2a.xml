      <div type="clause" n="6.2a">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 6.2a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 6.2a"><pb n="631" ed="#liebermann"/>Lupinum enim gerit<ptr type="liebermannNote" n="34" target="#ECf_6-2a.lnote.la.34"/> caput a die utlagationis<ptr type="liebermannNote" n="35" target="#ECf_6-2a.lnote.la.35"/> sue, quod<ptr type="liebermannNote" n="36" target="#ECf_6-2a.lnote.la.36"/> ab Anglis<ptr type="liebermannNote" n="37" target="#ECf_6-2a.lnote.la.37"/> uulfesheued<ptr type="liebermannNote" n="38" target="#ECf_6-2a.lnote.la.38"/> nominatur<ptr type="liebermannNote" n="39" target="#ECf_6-2a.lnote.la.39"/>.</ab>
        <note type="comparison" source="#liebermann" n="631"><label>printed alongside</label> <ref target="clause:ECfRetr_6-2a">ECf retr 6.2a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 631 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “Lupinum” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6-2a.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">c. g. <hi rend="italic">Hr S Do;</hi> c. gerat <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. g. Hr S Do; c. gerat Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6-2a.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">uthl. <hi rend="italic">Rl;</hi> hucl. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">uthl. Rl; hucl. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6-2a.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">que <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">que Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6-2a.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">Anglicis <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Anglicis Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6-2a.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Do;</hi> wluisheuet uocatur <hi rend="italic">Hr;</hi> wlue. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Do; wluisheuet uocatur Hr; wlue. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6-2a.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">appellatur <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">appellatur Do</seg></note>
