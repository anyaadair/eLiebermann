      <div type="clause" n="8a">
        <head><ref type="lawCode" target="law:QuadrII">Quadr II</ref> 8a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr II 8a" corresp="#wit-lat"><pb n="544–545" ed="#liebermann"/>Estimari uero non potest, quantis gaudiis et quanta celebritate predicti nuntii<ptr type="liebermannNote" n="1" target="#QuadrII_8a.lnote.oe.1"/>, cum regis dignitate [t]um<ptr type="liebermannNote" n="2" target="#QuadrII_8a.lnote.oe.2"/> sua ipsorum probitate, recepti<ptr type="liebermannNote" n="a" target="#QuadrII_8a.lnote.oe.a"/> pariter et remissi sunt.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 544–545 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8a.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">sie brachten Rom</hi> munera; <hi rend="italic">Will. Malm.</hi> Pont. I 56</seg><seg type="translation" xml:lang="en" source="#claude">they brought Rome munera; Will. Malm. Pont. I 56</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8a.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de">nuncii <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">nuncii Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8a.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de">cum <hi rend="italic">Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">cum MSS</seg></note>
