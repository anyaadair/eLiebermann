    <body>
      <div type="clause" n="6">
        <head><ref type="lawCode" target="law:QuadrII">Quadr II</ref> 6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr II 6" corresp="#wit-lat"><ptr type="liebermannNote" n="19" target="#QuadrII_6.lnote.oe.19"/><pb n="544" ed="#liebermann"/>Eodem termino et per eosdem<ptr type="liebermannNote" n="e" target="#QuadrII_6.lnote.oe.e"/> legatos, per Rodbertum<ptr type="liebermannNote" n="20" target="#QuadrII_6.lnote.oe.20"/> scilicet Licetfeldensem<ptr type="liebermannNote" n="21" target="#QuadrII_6.lnote.oe.21"/> episcopum et per Herbertum Norwicensem episcopum, de intronizatione<ptr type="liebermannNote" n="f" target="#QuadrII_6.lnote.oe.f"/> Girardi uenerabilis Eboracensium archiepiscopi electi scribit hoc modo:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 544 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_6.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">544</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">den vorigen Brief hatte vielmehr Wilhelm Warelwast, später Bischof von Exeter, bestellt</hi></seg><seg type="translation" xml:lang="en" source="#claude">the previous letter had in fact been delivered by William Warelwast, later bishop of Exeter</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_6.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">544</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielmehr über die Verleihung des Pallium</hi></seg><seg type="translation" xml:lang="en" source="#claude">rather about the grant of the pallium</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_6.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">544</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">am Rande roth</hi> XVI <hi rend="italic">Hk; Br kürzt</hi></seg><seg type="translation" xml:lang="en" source="#claude">in the margin in red XVI Hk; Br abridges</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_6.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">544</biblScope></bibl><seg type="original" xml:lang="de">Rob. <hi rend="italic">TM</hi></seg><seg type="translation" xml:lang="en" source="#claude">Rob. TM</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_6.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">544</biblScope></bibl><seg type="original" xml:lang="de">Licef. <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Licef. MHk</seg></note>
