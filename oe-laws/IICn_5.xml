  <text>
    <body>
      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 5</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5" corresp="#wit-g-a"><pb n="312" ed="#liebermann"/>And<ptr type="liebermannNote" n="3" target="#IICn_5.lnote.oe.3"/> [we<ptr type="liebermannNote" n="4" target="#IICn_5.lnote.oe.4"/>] forbeodað eornostlice ælcne hæðenscipe.<ptr type="liebermannNote" n="5" target="#IICn_5.lnote.oe.5"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5" corresp="#wit-b"><pb n="312" ed="#liebermann"/>Be<ptr type="liebermannNote" n="1" target="#IICn_5.lnote.oe.1-2"/> hæðenscipe. We forbeodað eornostlice ælcne hæðenscipe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5" corresp="#wit-a"><pb n="312" ed="#liebermann"/>⁊ we forbeodað eornnostlice<ptr type="liebermannNote" n="2" target="#IICn_5.lnote.oe.2"/> ælcne haðenscype.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5" corresp="#wit-q"><pb n="313" ed="#liebermann"/>Omnem quoque gentilitatem modis omnibus interdicimus.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5" corresp="#wit-inst-cn"><pb n="313" ed="#liebermann"/>Interdicimus etiam omnem supersticionem paganorum,</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5" corresp="#wit-cons-cn"><pb n="313" ed="#liebermann"/>Interdicimus quoque omnem paganissimum.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="5" corresp="#wit-b"><ptr type="editorNote" n="10" target="#IICn_5.robnote.fn.10"/><pb n="176" ed="#robertson"/>Be hæðenscipe. We forbeodað eornostlice ælcne hæðenscipe.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="256" ed="#rabin-doml"/>And we forbeodað eornostlice ælcne hæðenscipe.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="313" ed="#liebermann"/>(Von Heidenthum. <hi rend="italic">B</hi>) Und wir verbieten ernstlich jedes Heidenthum.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">(Of heathenism. B) And we strictly forbid all heathenism.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="177" ed="#robertson"/>Concerning heathen practices. We earnestly forbid all heathen practices.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="462" ed="#whitelock"/>And we earnestly forbid every heathen practice.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="257" ed="#rabin-doml"/>And we earnestly forbid all heathen practices.</ab>
        <note type="comparison" source="#liebermann" n="313"><ref target="clause:EGu_Prol-to-1">EGu Pr.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. E Gu. Pr., 1</note>
        <note type="editorial">‘we’ was inserted in G in the 16th century. 5 and 5.1 are missing from D. Liebermann compares EGu Prol. 1.; BR: added from Gesetze I p. 313, October 2026 (MS Cons); AY: corrected against Rabin p. 256 / 257, October 2026 (was “∅”, now “|”)</note>
        <note type="textual" source="#rabin-doml">B adds rubric Be hæðenscipe</note>
        <note type="textual" source="#rabin-doml">And: omitted B</note>
        <note type="textual" source="#rabin-doml">we: omitted G</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_5.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">313</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_5.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">312</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">am Rande roth</hi></seg><seg type="translation" xml:lang="en" source="#claude">in red in the margin</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_5.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">312</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_5.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">312</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. eingefügt G</hi></seg><seg type="translation" xml:lang="en" source="#claude">inserted in the 16th cent. G</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_5.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">312</biblScope></bibl><seg type="original" xml:lang="de">hædenscype <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hædenscype Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_5.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">312</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_5.robnote.fn.10" n="10" source="#robertson"><bibl><biblScope unit="page">176</biblScope></bibl><label>Be</label><seg type="original" xml:lang="en">Om. D.</seg></note>
      </div>
    </body>
