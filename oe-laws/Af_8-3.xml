    <body>
      <div type="clause" n="8.3">
        <head><ref type="lawCode" target="law:Af">Af</ref> 8.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8.3" corresp="#wit-e"><pb n="54" ed="#liebermann"/>Gif hire<ptr type="liebermannNote" n="27" target="#Af_8-3.lnote.oe.27"/> bearn mon ofslea, gielde<ptr type="liebermannNote" n="28" target="#Af_8-3.lnote.oe.28"/> cyninge<ptr type="liebermannNote" n="29" target="#Af_8-3.lnote.oe.29"/> þara<ptr type="liebermannNote" n="30" target="#Af_8-3.lnote.oe.30"/> medrenmæga<ptr type="liebermannNote" n="31" target="#Af_8-3.lnote.oe.31"/> dǽl; fædrenmægum<ptr type="liebermannNote" n="32" target="#Af_8-3.lnote.oe.32"/> hiora dǽl mon agife.<ptr type="liebermannNote" n="33" target="#Af_8-3.lnote.oe.33"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8.3" corresp="#wit-h"><pb n="54" ed="#liebermann"/>Gif hire bearn mon<ptr type="liebermannNote" n="1" target="#Af_8-3.lnote.oe.1"/> ofslea, gylde (þam<ptr type="liebermannNote" n="2" target="#Af_8-3.lnote.oe.2"/>) cyninge ðara medrenmæga<ptr type="liebermannNote" n="12" target="#Af_8-3.lnote.oe.12"/> dæl; fædrenmægum hiora<ptr type="liebermannNote" n="13" target="#Af_8-3.lnote.oe.13"/> dæl mon<ptr type="liebermannNote" n="1" target="#Af_8-3.lnote.oe.1"/> agife.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8.3" corresp="#wit-b-no-prol"><pb n="55" ed="#liebermann"/>Gyf man hire bearn ofsléa, gylde cyninge þæra medramaga dæl; fædrenmagum héora dæl man agyfe.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="8.3" corresp="#wit-q"><pb n="55" ed="#liebermann"/>Si puer<ptr type="liebermannNote" n="11" target="#Af_8-3.lnote.oe.11"/> eorum occidatur, habeat rex<ptr type="liebermannNote" n="12" target="#Af_8-3.lnote.oe.12-2"/> partem materne cognationis<ptr type="liebermannNote" n="13" target="#Af_8-3.lnote.oe.13-2"/>; parentes patris partem suam habeant.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="68" ed="#attenborough"/>Gif hire bearn mon ofslea, gielde cyninge<ptr type="editorNote" n="16" target="#Af_8-3.attnote.fn.16"/> þara medrenmæga<ptr type="editorNote" n="17" target="#Af_8-3.attnote.fn.17"/> dǽl; fædrenmægum hiora dǽl mon agife.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="9.3" corresp="#wit-e"><pb n="304" ed="#jurasinski-and-oliver"/>Gif hire bearn mon ofslea, gi\e/ḷde cyninge þara medrenmæge dǽl; fædrenmægum hiora dǽl mon agife.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="55" ed="#liebermann"/>Wenn jemand ihr Kind erschlägt, zahle er der Muttermagen<ptr type="liebermannNote" n="1" target="#Af_8-3.lnote.de.1"/> Theil dem König; den Vatermagen<ptr type="liebermannNote" n="2" target="#Af_8-3.lnote.de.2"/> gebe man deren Theil.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone slays her child, let him pay the maternal kin’s share to the king; let the paternal kin be given their share.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="69" ed="#attenborough"/>If her child is slain, the share of the wergeld due to the mother’s kindred shall be paid to the king, but the father’s kindred shall be paid the share due to them.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="411" ed="#whitelock"/>If her child is killed, the share of the maternal kindred is to be paid to the king; the paternal kindred are to be given their share.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="305" ed="#jurasinski-and-oliver"/>If her child is killed, let the mother’s portion [of the wergild] be given to the king; let the father’s kin be given their portion.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-3.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">mon h. b. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mon h. b. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-3.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">erstes</hi> e <hi rend="italic">übergeschr. E;</hi> gyld <hi rend="italic">So;</hi> gylde <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">first e written above E; gyld So; gylde Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-3.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">-ng <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ng So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-3.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">þæra <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þæra So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-3.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">medramaga <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">medramaga Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-3.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">-mag. <hi rend="italic">So;</hi> fædranmag. heora <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-mag. So; fædranmag. heora Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-3.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">agyfe <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">agyfe So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-3.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-3.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-3.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> meddr.</seg><seg type="translation" xml:lang="en" source="#claude">altered to meddr.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-3.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert aus</hi> hira</seg><seg type="translation" xml:lang="en" source="#claude">corrected from hira</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-3.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">55</biblScope></bibl><seg type="original" xml:lang="de">infans <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">infans Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-3.lnote.oe.12-2" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">55</biblScope></bibl><seg type="original" xml:lang="de">p. rex <hi rend="italic">T Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. rex T Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-3.lnote.oe.13-2" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">55</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt T zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by T</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_8-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">1/3 des Wergelds; <hi rend="italic">s. Gl</hi> Muttersippe 6</seg><seg type="translation" xml:lang="en" source="#claude">1/3 of the wergild; <hi rend="italic">see Gl</hi> Muttersippe 6</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_8-3.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Der vom Vater anerkannte Bastard (<hi rend="italic">s. d. Gl</hi> 2) hat also Vatersippe</seg><seg type="translation" xml:lang="en" source="#claude">The bastard acknowledged by his father (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 2) thus has a paternal kindred</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_8-3.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">68</biblScope></bibl><label>cyninge</label><seg type="original" xml:lang="en">(<hi rend="italic">þam</hi>) <hi rend="italic">cyninge</hi>. H*.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_8-3.attnote.fn.17" n="17" source="#attenborough"><bibl><biblScope unit="page">68</biblScope></bibl><label>medrenmæga</label><seg type="original" xml:lang="en"><hi rend="italic">medramaga</hi>. B.</seg></note>
      </div>
