      <div type="clause" n="6.7">
        <head><ref type="lawCode" target="law:IVAs">IV As</ref> 6.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6.7" corresp="#wit-q"><pb n="172" ed="#liebermann"/>Si serua ancilla sit et ipsa<ptr type="liebermannNote" n="47" target="#IVAs_6-7.lnote.oe.47"/> furetur alicubi preterquam<ptr type="liebermannNote" n="48" target="#IVAs_6-7.lnote.oe.48"/> domino suo<ptr type="liebermannNote" n="49" target="#IVAs_6-7.lnote.oe.49"/> et<ptr type="liebermannNote" n="1" target="#IVAs_6-7.lnote.oe.1"/> (uel) domine suę, adeant sexaginta et uiginti<ptr type="liebermannNote" n="a" target="#IVAs_6-7.lnote.oe.a"/> ancille et afferant<ptr type="liebermannNote" n="a" target="#IVAs_6-7.lnote.oe.a"/> singule tria ligna et comburant<ptr type="liebermannNote" n="b" target="#IVAs_6-7.lnote.oe.b"/> eam<ptr type="liebermannNote" n="50" target="#IVAs_6-7.lnote.oe.50"/> unam ancillam et conferant totidem denarios<ptr type="liebermannNote" n="c" target="#IVAs_6-7.lnote.oe.c"/>, quot serui deberent, aut uerberentur, sicut<ptr type="liebermannNote" n="c" target="#IVAs_6-7.lnote.oe.c"/> de seruis dictum est.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="6.7" corresp="#wit-q"><pb n="150" ed="#attenborough"/>Si serva ancilla sit et ipsa furetur alicubi præterquam domino suo et<ptr type="editorNote" n="6" target="#IVAs_6-7.attnote.fn.6"/> dominæ suæ, adeant sexaginta et viginti ancillæ et afferant singulæ tria ligna et comburant eam unam ancillam, et conferant totidem denarios, quot servi deberent, aut verberentur, sicut de servis dictum est.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="151" ed="#attenborough"/>In the case of a female slave who commits an act of theft anywhere except against her master or mistress, sixty and twenty female slaves shall go and bring three logs each and burn that one slave; and they shall pay as many pennies as male slaves would have to pay<ptr type="editorNote" n="1" target="#IVAs_6-7.attnote.n.1"/>, or suffer scourging as has been stated above<ptr type="editorNote" n="2" target="#IVAs_6-7.attnote.n.2"/> with reference to male slaves.</ab>
        <note type="editorial">Latin only; no German translation in Liebermann.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-7.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">illa <hi rend="italic">TMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">illa TMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-7.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">preter <hi rend="italic">RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">preter RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-7.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt RMBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in RMBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-7.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond; (eingeklammertes) übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket Lond; (bracketed words) the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-7.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">ipsam <hi rend="italic">TMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">ipsam TMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-7.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">114</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o.</hi> 6, 5{b}</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 6, 5{b}</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-7.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">114</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. Gl</hi> Verbrennen</seg><seg type="translation" xml:lang="en" source="#claude">see <hi rend="italic">Gl</hi> Verbrennen</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-7.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">114</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o.</hi> 6, 6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 6, 6</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAs_6-7.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">211</biblScope></bibl><seg type="original" xml:lang="en">See note on § 6.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAs_6-7.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">211</biblScope></bibl><seg type="original" xml:lang="en">See Wiht. cap. 10, 13; Ine, cap. 3 § 1, etc.</seg></note>
