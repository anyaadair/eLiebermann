      <div type="clause" n="17">
        <head><ref type="lawCode" target="law:WlArtRetr">Wl art retr</ref> 17</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-lond"><pb n="491" ed="#liebermann"/>Interdicimus<ptr type="liebermannNote" n="59" target="#WlArtRetr_17.lnote.oe.59"/> etiam, ne quis occidatur uel suspendatur pro aliqua culpa, sed eruantur<ptr type="liebermannNote" n="60" target="#WlArtRetr_17.lnote.oe.60"/> oculi et abscidantur<ptr type="liebermannNote" n="61" target="#WlArtRetr_17.lnote.oe.61"/> pedes uel testiculi uel manus, ita quod truncus remaneat<ptr type="liebermannNote" n="62" target="#WlArtRetr_17.lnote.oe.62"/> uiuus in signum prodicionis et nequicie sue; secundum enim quantitatem delicti debet pena maleficis<ptr type="liebermannNote" n="63" target="#WlArtRetr_17.lnote.oe.63"/> infligi. Et<ptr type="liebermannNote" n="35" target="#WlArtRetr_17.lnote.oe.35"/> ista precepta [et<ptr type="liebermannNote" n="64" target="#WlArtRetr_17.lnote.oe.64"/> statuta] non sint uiolata super forisfacturam nostram plenam [: weram<ptr type="liebermannNote" n="65" target="#WlArtRetr_17.lnote.oe.65"/><ptr type="liebermannNote" n="f" target="#WlArtRetr_17.lnote.oe.f"/>]. [Testibus<ptr type="liebermannNote" n="66" target="#WlArtRetr_17.lnote.oe.66"/> etc.]<ptr type="liebermannNote" n="67" target="#WlArtRetr_17.lnote.oe.67"/></ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="17" corresp="#wit-rs"><pb n="250" ed="#robertson"/>Interdicimus eciam ne quis occidatur vel suspendatur pro aliqua culpa, sed eruantur occuli et abscidantur pedes vel testiculi vel manus, ita quod truncus vivus remaneat in signum prodicionis et nequiciae suae, secundum enim quantitatem delicti debet pena maleficis infligi. Et ista praecepta et statuta non sint violata super forisfacturam nostram plenam.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-rs"><pb n="251" ed="#robertson"/>We likewise forbid that anyone be slain or hanged for any offence, but his eyes shall be put out and his feet or his hands cut off, or he shall suffer castration, so that the trunk remains alive as a sign of his treachery and wickedness; for the penalty inflicted on malefactors should be in proportion to the crime committed. And these ordinances and statutes shall not be violated, under pain of incurring the full fine for insubordination to us.</ab>
        <note type="comparison" source="#liebermann" n="491"><ref target="clause:WlArt_10">Wl art 10</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Wl art. 10</note>
        <note type="editorial">Added October 2026 from Robertson pp. 250–251 (text and translation); Liebermann’s text added from Gesetze I p. 491, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_17.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus</hi> Hu Lond 7? <hi rend="italic">vgl. o.</hi> 6{g}</seg><seg type="translation" xml:lang="en" source="#claude">from Hu Lond 7? cf. above 6{g}</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_17.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_17.lnote.oe.59" n="59" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">-dico <hi rend="italic">Ld aus Trip.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dico Ld from Trip.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_17.lnote.oe.60" n="60" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">en'uantur <hi rend="italic">Sc;</hi> euernantur <hi rend="italic">Se</hi></seg><seg type="translation" xml:lang="en" source="#claude">en'uantur Sc; euernantur Se</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_17.lnote.oe.61" n="61" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">-scind. t. uel p. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-scind. t. uel p. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_17.lnote.oe.62" n="62" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">u. r. <hi rend="italic">K2 Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. r. K2 Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_17.lnote.oe.63" n="63" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">-ciis <hi rend="italic">Se;</hi> malif. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ciis Se; malif. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_17.lnote.oe.64" n="64" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">et st. <hi rend="italic">fehlt Sc Hg besser; vgl. o.</hi> Inscr.{e}</seg><seg type="translation" xml:lang="en" source="#claude">et st. missing in Sc Hg, better; cf. above Inscr.{e}</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_17.lnote.oe.65" n="65" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Co Or;</hi> war. <hi rend="italic">K2; fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Co Or; war. K2; missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_17.lnote.oe.66" n="66" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Sc Hg; fehlt K2 Co Or, nicht original; vgl. o.</hi> Inscr.{f}</seg><seg type="translation" xml:lang="en" source="#claude">thus Sc Hg; missing in K2 Co Or, not original; cf. above Inscr.{f}</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_17.lnote.oe.67" n="67" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> Edw. Conf. retr., Londoniis interpolatus <hi rend="italic">K2 Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">followed by Edw. Conf. retr., Londoniis interpolatus K2 Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_17.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">283</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Todesstrafe 7; Fuss 6—b</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Todesstrafe 7; Fuss 6—b</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_17.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">283</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Strafe 10g. 13; CHn cor 8.—<hi rend="italic">tr. ui. re</hi>.{62} <hi rend="italic">in</hi> Rs—<hi rend="italic">mal</hi>.{63} <hi rend="italic">infligli</hi> Rs—<hi rend="italic">et</hi>{64} <hi rend="italic">sta</hi>. Rs—<hi rend="italic">weram</hi>{65}. <hi rend="italic">T. etc</hi>.{67} fehlt besser Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Strafe 10g. 13; CHn cor 8.—<hi rend="italic">tr. ui. re</hi>.{62} <hi rend="italic">in</hi> Rs—<hi rend="italic">mal</hi>.{63} <hi rend="italic">infligli</hi> Rs—<hi rend="italic">et</hi>{64} <hi rend="italic">sta</hi>. Rs—<hi rend="italic">weram</hi>{65}. <hi rend="italic">T. etc</hi>.{67} missing in Rs, better</seg></note>
