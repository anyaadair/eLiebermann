    <body>
      <div type="clause" n="68.1c">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 68.1c</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="68.1c" corresp="#wit-g-a"><pb n="354" ed="#liebermann"/>And ægþer man sceal ge on godcundan scriftan ge on woruldcundan<ptr type="liebermannNote" n="15" target="#IICn_68-1c.lnote.oe.15"/> doman þas þinge tosceadan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="68.1c" corresp="#wit-b"><pb n="354" ed="#liebermann"/>And æðer<ptr type="liebermannNote" n="2" target="#IICn_68-1c.lnote.oe.2"/> man sceal ge on godcundan scrift<hi rend="italic">um</hi> ge on woruldcundan dome ðas ðincg tosceadan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="68.1c" corresp="#wit-a"><pb n="354" ed="#liebermann"/>And ægðer man sceall ge on godcundan scr[i]ftan<ptr type="liebermannNote" n="4" target="#IICn_68-1c.lnote.oe.4"/> ge on woruldcundan doman þæs þincg toseaden.<ptr type="liebermannNote" n="5" target="#IICn_68-1c.lnote.oe.5"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="68.1c" corresp="#wit-q"><pb n="355" ed="#liebermann"/>Et<ptr type="liebermannNote" n="9" target="#IICn_68-1c.lnote.oe.9"/> utrobique debet hoc diligenter aduerti tam in diuinis legibus (penitentiis<ptr type="liebermannNote" n="10" target="#IICn_68-1c.lnote.oe.10"/> diuinis) quam in secularibus iudiciis.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="68.1c" corresp="#wit-cons-cn"><pb n="355" ed="#liebermann"/>Non solum in diuinis decretis sed etiam in secularibus iudiciis hec sunt distinguenda.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="68.1c" corresp="#wit-b"><pb n="208" ed="#robertson"/>And æðer man sceal, ge on godcundan scriftum ge on woruldcundan dome, ðas ðincg tosceadan.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="288" ed="#rabin-doml"/>And ægþer man sceal ge on godcundan scriftan ge on woruldcundan doman þas þingc tosceadan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="355" ed="#liebermann"/>Und diese Umstände muss man unterscheiden sowohl bei geistlichen Bussen wie bei weltlichen [-em <hi rend="italic">B</hi>] Urtheilen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And one must distinguish these circumstances both in spiritual penances and in secular judgments (judgment, B).</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="209" ed="#robertson"/>And discrimination with regard to these circumstances must be shown both in [imposing] ecclesiastical amends and in [passing] secular judgment.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="472" ed="#whitelock"/>And these things are to be distinguished both in religious penances and in secular judgments.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="289" ed="#rabin-doml"/>And these considerations must be weighed when assigning spiritual penance and secular judgment.</ab>
        <note type="comparison" source="#liebermann" n="355"><ref target="clause:VIAtr_52">VI Atr 52</ref></note>
        <note type="comparisonPrinted" source="#liebermann">VI Atr. 52</note>
        <note type="editorial">Liebermann compares VI Atr 52.; BR: added from Gesetze I p. 355, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_68-1c.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">354</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_68-1c.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">355</biblScope></bibl><seg type="original" xml:lang="de">Et — aduerti <hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et — aduerti lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_68-1c.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">355</biblScope></bibl><seg type="original" xml:lang="de">p. d. <hi rend="italic">über</hi> d. l. <hi rend="italic">Dm; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. d. above d. l. Dm; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_68-1c.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">354</biblScope></bibl><seg type="original" xml:lang="de">worulc. d. ðæs dinge <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">worulc. d. ðæs dinge Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_68-1c.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">354</biblScope></bibl><seg type="original" xml:lang="de">scrftan</seg><seg type="translation" xml:lang="en" source="#claude">scrftan</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_68-1c.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">354</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
      </div>
