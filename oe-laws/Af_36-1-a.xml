    <body>
      <div type="clause" n="36.1[a]">
        <head><ref type="lawCode" target="law:Af">Af</ref> 36.1[a]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.1[a]" corresp="#wit-e"><pb n="68" ed="#liebermann"/>Gif beforan<ptr type="liebermannNote" n="44" target="#Af_36-1-a.lnote.oe.44"/> eagum asnase, gielde<ptr type="liebermannNote" n="41" target="#Af_36-1-a.lnote.oe.41"/> þone wer<ptr type="liebermannNote" n="45" target="#Af_36-1-a.lnote.oe.45"/>;</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.1[a]" corresp="#wit-h"><pb n="68" ed="#liebermann"/>Gif beforan eagum asnæse<ptr type="liebermannNote" n="18" target="#Af_36-1-a.lnote.oe.18"/>, gilde þone wer.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.1[a]" corresp="#wit-b-no-prol"><pb n="69" ed="#liebermann"/>[Gif<ptr type="liebermannNote" n="6" target="#Af_36-1-a.lnote.oe.6"/> beforan eagum, gylde þone wer; ⁊] gyf hine man téo gewealdes on þære dæde, g<hi rend="italic">e</hi>treowie<ptr type="liebermannNote" n="1" target="#Af_36-1-a.lnote.oe.1"/> hine be ðam wite ⁊ mid ða<hi rend="italic">m</hi> þ<hi rend="italic">æt</hi> wite afylle<ptr type="liebermannNote" n="2" target="#Af_36-1-a.lnote.oe.2"/>,</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="36.1[a]" corresp="#wit-q"><pb n="69" ed="#liebermann"/>Si ante<ptr type="liebermannNote" n="27" target="#Af_36-1-a.lnote.oe.27"/> oculos asnaset<ptr type="liebermannNote" n="28" target="#Af_36-1-a.lnote.oe.28"/>, reddat weram eius.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="78–80" ed="#attenborough"/>Gif beforan eagum asnase<ptr type="editorNote" n="21" target="#Af_36-1-a.attnote.fn.21"/>, gielde þone wer;</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="37.1" corresp="#wit-e"><pb n="332" ed="#jurasinski-and-oliver"/>Gif beforan eagum asnase, gielde þone wer.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="69" ed="#liebermann"/>Wenn er vor den Augen<ptr type="liebermannNote" n="1" target="#Af_36-1-a.lnote.de.1"/> spiesst<ptr type="liebermannNote" n="2" target="#Af_36-1-a.lnote.de.2"/>, zahle er das Wergeld.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he spits [him] before the eyes, let him pay the wergeld.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="79" ed="#attenborough"/>If [the man] is transfixed before his<ptr type="editorNote" n="1" target="#Af_36-1-a.attnote.n.1"/> eyes, he shall pay the wergeld;</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="415" ed="#whitelock"/>If he is transfixed before his eyes, he is to pay the wergild; if anyone accuses him of intention in this act, he is to clear himself in proportion to the fine, and by that [oath] do away with the fine,</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="333" ed="#jurasinski-and-oliver"/>If he should impale himself before the eyes [of the spear-carrier], let him pay the <hi rend="italic">wer</hi>.</ab>
        <note type="translator" source="#whitelock">Whitelock translates Af 36.1 as one clause, which the sheet divides into rows 36.1[a], 36.1[b]; her translation of the whole is given here, in the first row.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-a.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">he foran e. asnæse <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">he foran e. asnæse So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-a.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">gylde <hi rend="italic">Ld;</hi> gyld <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">gylde Ld; gyld So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-a.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">were <hi rend="italic">So;</hi> wite ⁊ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">were So; wite ⁊ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-a.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">æ <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">æ on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-a.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de">autem <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">autem Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-a.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de">-tur <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tur Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-a.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Zeile übersprungen, am Rande im</hi> 16. <hi rend="italic">Jh. geschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">line omitted, written in the margin in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-a.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. geänd. in</hi> getreowsie</seg><seg type="translation" xml:lang="en" source="#claude">altered in the 16th cent. to getreowsie</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-a.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">⁊ þis beo <hi rend="italic">im</hi> 16. <hi rend="italic">Jh. zugefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">⁊ þis beo added in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_36-1-a.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘des Trägers’ ergänzt richtig Hn 88, 3. Er trägt den Speer in der Hand, Spitze vorn</seg><seg type="translation" xml:lang="en" source="#claude">Hn 88, 3 correctly supplies ‘of the bearer’. He carries the spear in his hand, point foremost</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_36-1-a.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘sich spiesst’ Frühere; <hi rend="italic">hine</hi> ‘sich’ ergänzt unnötig Pogatscher in <hi rend="italic">Anglia</hi> 23, 262. Toller s. v. <hi rend="italic">snæsan</hi> zeigt, dass reflexive Bed. unbelegt ist</seg><seg type="translation" xml:lang="en" source="#claude">‘impales himself’ earlier editors; Pogatscher in <hi rend="italic">Anglia</hi> 23, 262 unnecessarily supplies <hi rend="italic">hine</hi> ‘himself’. Toller s. v. <hi rend="italic">snæsan</hi> shows that a reflexive meaning is unattested</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_36-1-a.attnote.fn.21" n="21" source="#attenborough"><bibl><biblScope unit="page">78</biblScope></bibl><label>asnase</label><seg type="original" xml:lang="en">om. B. <hi rend="italic">asnæse</hi>. H.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_36-1-a.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">197</biblScope></bibl><seg type="original" xml:lang="en">‘his’ refers to the man carrying the spear.</seg></note>
      </div>
    </body>
