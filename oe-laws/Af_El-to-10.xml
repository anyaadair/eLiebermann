    <body>
      <div type="clause" n="El. 10">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 10</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 10" corresp="#wit-e"><pb n="28" ed="#liebermann"/>Ne wyrc<ptr type="liebermannNote" n="14" target="#Af_El-to-10.lnote.oe.14"/> ðe gyldne<ptr type="liebermannNote" n="15" target="#Af_El-to-10.lnote.oe.15"/> godas oððe sylfrene.<ptr type="liebermannNote" n="16" target="#Af_El-to-10.lnote.oe.16"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 10" corresp="#wit-g-prol-only"><pb n="28" ed="#liebermann"/>Ne wyrce ðe gyldene godas oððe sylfrene.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 10" corresp="#wit-h"><pb n="29" ed="#liebermann"/>Ne wyrc ðu þe gyldene godas oððe sylfrene.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 10" corresp="#wit-q"><pb n="29" ed="#liebermann"/>Non<ptr type="liebermannNote" n="4" target="#Af_El-to-10.lnote.oe.4"/> facies tibi deos aureos uel argenteos.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 10" corresp="#wit-e"><pb n="230" ed="#jurasinski-and-oliver"/>Ne wyrc ðe gyldne godas oððe sylfrene.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="29" ed="#liebermann"/>Mache<ptr type="liebermannNote" n="1" target="#Af_El-to-10.lnote.de.1"/> dir<ptr type="liebermannNote" n="2" target="#Af_El-to-10.lnote.de.2"/> nicht goldene Götter oder silberne.<ptr type="liebermannNote" n="3" target="#Af_El-to-10.lnote.de.3"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Do not make yourself golden gods or silver ones.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="231" ed="#jurasinski-and-oliver"/>Do not make for yourself gods of gold or silver.</ab>
        <note type="passageSource">Exodus 20,23</note>
        <note type="comparison" source="#liebermann" n="29">Exodus 20.23</note>
        <note type="comparisonPrinted" source="#liebermann">[20, 23]</note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-10.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">28</biblScope></bibl><seg type="original" xml:lang="de">wyrce <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">wyrce So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-10.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">28</biblScope></bibl><seg type="original" xml:lang="de">gyldene <hi rend="italic">So Ld;</hi> goddas <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">gyldene So Ld; goddas So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-10.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">28</biblScope></bibl><seg type="original" xml:lang="de">seol. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">seol. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-10.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">29</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dieser Satz nur aus Hk; fehlt Dm T R;</hi> facietis <hi rend="italic">Vulgata</hi></seg><seg type="translation" xml:lang="en" source="#claude">this sentence only from Hk; lacking in Dm T R; facietis Vulgate</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-10.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">43</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o.</hi> El 1². Ursprünglich liess Quadr, dem katholischen Dekalog getreu, den Satz fort</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> El 1². Quadr, faithful to the Catholic Decalogue, originally omitted the sentence</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-10.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">43</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Dativus ethicus, vom Quadr spät. Rez. mitübersetzt</seg><seg type="translation" xml:lang="en" source="#claude">Ethic dative, translated along with the rest by the later rec. of Quadr</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-10.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">43</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Die in Vulgata folgenden Verse über Altarbau lässt Ælfred fort, wie <hi rend="italic">o.</hi> El 9²</seg><seg type="translation" xml:lang="en" source="#claude">Ælfred omits the verses on building altars that follow in the Vulgate, as <hi rend="italic">above</hi> El 9²</seg></note>
      </div>
    </body>
