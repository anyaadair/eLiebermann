    <body>
      <div type="clause" n="15.4">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 15.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 15.4"><pb n="641" ed="#liebermann"/><hi rend="bold">Ueruntamen quoniam</hi><ptr type="liebermannNote" n="16" target="#ECfRetr_15-4.lnote.la.16"/> omnino uilla confundebatur, prouiderunt barones, quod per hundredum colligerentur et sigillo alicuius baronum<ptr type="liebermannNote" n="17" target="#ECfRetr_15-4.lnote.la.17"/> comitatus sigillarentur et ad thesaurum<ptr type="liebermannNote" n="18" target="#ECfRetr_15-4.lnote.la.18"/> regis deportarentur; quas <hi rend="bold">sigillatas ipse</hi> seruaret per annum <hi rend="bold">et</hi><ptr type="liebermannNote" n="d" target="#ECfRetr_15-4.lnote.la.fn.d"/> <hi rend="bold">unum</hi><ptr type="liebermannNote" n="19" target="#ECfRetr_15-4.lnote.la.19"/> <hi rend="bold">diem.</hi></ab>
        <note type="comparison" source="#liebermann" n="641"><label>printed alongside</label> <ref target="clause:ECf_15-4">ECf 15.4</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 641 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-4.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">Jahr und Tag, <hi rend="italic">wie Retr. zufügt, stimmt nicht zur Exchequertagung zweimal jährlich, und entstammt also vielleicht der Frist für Ablieferung eines Schuldigen ans Gericht, nach deren Ablauf der Bürge das Verpfändete verlor;</hi> Leis Wl 3, 4; In. Cn. II 31, 1</seg><seg type="translation" xml:lang="en" source="#claude">year and day, as the Retractator adds, does not fit the Exchequer sitting twice a year, and so perhaps derives from the term for delivering a guilty man to the court, after which the surety lost what he had pledged; Leis Wl 3, 4; In. Cn. II 31, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-4.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">q., si ui. o. destrueretur, preu. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">q., si ui. o. destrueretur, preu. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-4.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-nis <hi rend="italic">Hv Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nis Hv Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-4.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Cb Va Hv;</hi> -rarium <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Cb Va Hv; -rarium the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-4.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">d. u. <hi rend="italic">Cb Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. u. Cb Lond</seg></note>
      </div>
