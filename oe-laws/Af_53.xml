    <body>
      <div type="clause" n="53">
        <head><ref type="lawCode" target="law:Af">Af</ref> 53</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="53" corresp="#wit-e"><pb n="80" ed="#liebermann"/>Gif mon bið<ptr type="liebermannNote" n="33" target="#Af_53.lnote.oe.33"/> on eaxle wund, þ<hi rend="italic">æt</hi> þæt liðseaw<ptr type="liebermannNote" n="34" target="#Af_53.lnote.oe.34"/> útflowe, gebete mid XXX scill.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="53" corresp="#wit-h"><pb n="80" ed="#liebermann"/>Gif mon<ptr type="liebermannNote" n="4" target="#Af_53.lnote.oe.4"/> bið on ða eaxle wund<ptr type="liebermannNote" n="13" target="#Af_53.lnote.oe.13"/>, ðæt ðæt liþseaw utflowe, gebete mid XXX scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="53" corresp="#wit-b-no-prol"><pb n="80" ed="#liebermann"/>Gyf mon on eaxle bið gewunded, þ<hi rend="italic">æt</hi> þ<hi rend="italic">æt</hi> liðseaw utflowe, gebete mid ðrittig scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="53" corresp="#wit-q"><pb n="81" ed="#liebermann"/>Si quis sit in humero uulneratus, ut compaginis glutinum effluat, XXX solid. emendetur.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="88" ed="#attenborough"/>Gif mon bið on eaxle<ptr type="editorNote" n="1" target="#Af_53.attnote.fn.1"/> wund<ptr type="editorNote" n="2" target="#Af_53.attnote.fn.2"/>, þæt þæt liðseaw útflowe, gebete mid XXX scill.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="57" corresp="#wit-e"><pb n="354" ed="#jurasinski-and-oliver"/>Gif mon bið on eaxle wund, þ<hi rend="italic">æt</hi> þæt liðseaw útflowe, gebete mid XXX scill.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="81" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_53.lnote.de.1"/> jemand an der<ptr type="liebermannNote" n="2" target="#Af_53.lnote.de.2"/> Achsel<ptr type="liebermannNote" n="3" target="#Af_53.lnote.de.3"/> verwundet<ptr type="liebermannNote" n="4" target="#Af_53.lnote.de.4"/> ist, so dass das Gliedwasser<ptr type="liebermannNote" n="5" target="#Af_53.lnote.de.5"/> herausfliesst, büsse [der Verletzer] mit 30 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone is wounded in the shoulder so that the joint-fluid flows out, let [the one who did it] pay 30 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="89" ed="#attenborough"/>If a man is wounded in the shoulder, so that the synovia flows out, 30 shillings shall be paid as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="355" ed="#jurasinski-and-oliver"/>If a man is wounded on the shoulder, so that synovia flows out, let him compensate with 30 shillings.</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="355"><label>compare</label> <ref target="clause:Af_68">Af 68</ref> <quote>Compare §72 and §77.</quote></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="355"><label>compare</label> <ref target="clause:Af_73">Af 73</ref> <quote>Compare §72 and §77.</quote></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="361"><ref target="clause:Af_68">Af 68</ref></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="363"><ref target="clause:Af_74">Af 74</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_53.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">on e. biþ <hi rend="spaced">gewundod</hi> <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">on e. biþ <hi rend="italic">gewundod</hi> Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_53.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">liþseawe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">liþseawe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_53.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_53.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> gewunded</seg><seg type="translation" xml:lang="en" source="#claude">altered to gewunded</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_53.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Achsel</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Achsel</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_53.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Wohl ohne Lähmung; <hi rend="italic">u.</hi> 68³</seg><seg type="translation" xml:lang="en" source="#claude">Probably without paralysis; <hi rend="italic">below</hi> 68³</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_53.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl.</hi> Abt 38</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf.</hi> Abt 38</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_53.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">B modernisiert wie <hi rend="italic">u.</hi> 65</seg><seg type="translation" xml:lang="en" source="#claude">B modernizes as <hi rend="italic">below</hi> 65</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_53.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Gelenkschmiere; <hi rend="italic">vgl. Gl</hi> Gliedwasser; so Thöne 79. Auch im Friesenrecht qualifiziert Ausfliessen des <hi rend="italic">liduwagi</hi> die Wunde</seg><seg type="translation" xml:lang="en" source="#claude">Synovial fluid; <hi rend="italic">cf. Gl</hi> Gliedwasser; so Thöne 79. In Frisian law too, the flowing out of the <hi rend="italic">liduwagi</hi> qualifies the wound</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_53.attnote.fn.1" n="1" source="#attenborough"><bibl><biblScope unit="page">88</biblScope></bibl><label>eaxle</label><seg type="original" xml:lang="en"><hi rend="italic">ða eaxle</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_53.attnote.fn.2" n="2" source="#attenborough"><bibl><biblScope unit="page">88</biblScope></bibl><label>wund</label><seg type="original" xml:lang="en"><hi rend="italic">gewunded</hi>. B.</seg></note>
      </div>
    </body>
