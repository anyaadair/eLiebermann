    <body>
      <div type="clause" n="23[b]">
        <head><ref type="lawCode" target="law:Wi">Wi</ref> 23[b]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="23[b]" corresp="#wit-h"><pb n="14" ed="#liebermann"/>gif he huslgenga nis, hæbbe him in aþe oðirne æwdan godne<ptr type="liebermannNote" n="2" target="#Wi_23-b.lnote.oe.2"/> oþþe gelde oþþe selle to swinganne.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-h"><pb n="28" ed="#attenborough"/>gif he huslgenga nis, hæbbe him in aþe oðirne æwdan godne oþþe gelde oþþe selle to swinganne.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="18.1" corresp="#wit-h"><pb n="160" ed="#oliver"/>Gif he huslgenga nis, hæbbe him in aþe oðirne æwdan godne,<ptr type="editorNote" n="c" target="#Wi_23-b.olinote.fn.c"/> oþþe gelde, oþþe selle to swinganne.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="14" ed="#liebermann"/>wenn derselbe nicht Abendmahlsgänger<ptr type="liebermannNote" n="5" target="#Wi_23-b.lnote.de.5"/> ist, so nehme er sich<ptr type="liebermannNote" n="6" target="#Wi_23-b.lnote.de.6"/> zum Eide einen zweiten guten Eideshelfer oder zahle [das Eingeklagte und Busse] oder liefere [ihn dem Kläger] aus zum Geisseln.<ptr type="liebermannNote" n="7" target="#Wi_23-b.lnote.de.7"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">if he is not a communicant, let him take a second good oath-helper for the oath, or pay [the amount claimed and compensation], or hand [him over to the plaintiff] to be flogged.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="29" ed="#attenborough"/>If he is not a communicant he shall get a second<ptr type="editorNote" n="4" target="#Wi_23-b.attnote.n.4"/> good witness [to support him] in the oath, or pay [the fine] or deliver him up to be scourged.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h"><pb n="161" ed="#oliver"/>If he is not a communicant, he should have for himself in the oath another good oath-helper, or he should pay recompense, or he should give [his servant] to be flogged.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Wi_23-b.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">14</biblScope></bibl><seg type="original" xml:lang="de">n <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">n written above</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Wi_23-b.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">29</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Der Kirchenherr (<hi rend="italic">s. Gl</hi> 1—3) entbehrte des Abendmahls gewiss nur, wenn er Laienabt war</seg><seg type="translation" xml:lang="en" source="#claude">The lord of the church (see <hi rend="italic">Gl</hi> 1—3) was surely without communion only if he was a lay abbot</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Wi_23-b.lnote.de.6" n="6" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">29</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Dativus ethicus wie <hi rend="italic">o.</hi> 7²</seg><seg type="translation" xml:lang="en" source="#claude">Ethic dative, as <hi rend="italic">above</hi> 7²</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Wi_23-b.lnote.de.7" n="7" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">29</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o.</hi> 22 Schluss</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 22, end</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Wi_23-b.attnote.n.4" n="4" source="#attenborough"><bibl><biblScope unit="page">182</biblScope></bibl><seg type="original" xml:lang="en">The oath of the communicant was worth double that of a non-communicant in Wessex (cf. Ine, cap. 15 § 1).</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Wi_23-b.olinote.fn.c" n="c" source="#oliver"><bibl><biblScope unit="page">160</biblScope></bibl><label>godne,</label><seg type="original" xml:lang="en"><hi rend="bold">n</hi> added above insertion mark.</seg></note>
      </div>
    </body>
