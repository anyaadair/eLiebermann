        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 87.5" corresp="#wit-lat"><pb n="601" ed="#liebermann"/>Ouerseunessa regis est<ptr type="liebermannNote" n="28" target="#Hn_87-5.lnote.oe.28"/>, ut<ptr type="liebermannNote" n="r" target="#Hn_87-5.lnote.oe.r"/> diximus, XX mance<ptr type="liebermannNote" n="51" target="#Hn_87-5.lnote.oe.51"/>, episcopi et<ptr type="liebermannNote" n="52" target="#Hn_87-5.lnote.oe.52"/> comitis X mance<ptr type="liebermannNote" n="51" target="#Hn_87-5.lnote.oe.51"/>, baronis uel thaini V (mance<ptr type="liebermannNote" n="32" target="#Hn_87-5.lnote.oe.32"/>) in Westsexa, que<ptr type="liebermannNote" n="s" target="#Hn_87-5.lnote.oe.s"/> capud regni est et legum, ad quam recurrendum est in omni dissidencia contingencium.</ab>
