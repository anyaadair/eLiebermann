    <body>
      <div type="clause" n="24.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 24.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 24.1"><pb n="649" ed="#liebermann"/>Praefectus<ptr type="liebermannNote" n="19" target="#ECfRetr_24-1.lnote.la.19"/> uille <hi rend="bold">mox</hi><ptr type="liebermannNote" n="4" target="#ECfRetr_24-1.lnote.la.4"/> mittat<ptr type="liebermannNote" n="20" target="#ECfRetr_24-1.lnote.la.20"/> ad quatuor uillas propinquiores pro sacerdotibus et pre<hi rend="bold">positis</hi> uillarum, <hi rend="bold">qui</hi> adducant secum de<ptr type="liebermannNote" n="21" target="#ECfRetr_24-1.lnote.la.21"/> <hi rend="bold">unaquaque</hi> uilla III uel IIII de melioribus <hi rend="bold">hominibus; eisque</hi><ptr type="liebermannNote" n="22" target="#ECfRetr_24-1.lnote.la.22"/> congregatis<ptr type="liebermannNote" n="*" target="#ECfRetr_24-1.lnote.la.star"/> ostendatur totum inuentum<ptr type="liebermannNote" n="23" target="#ECfRetr_24-1.lnote.la.23"/>.</ab>
        <note type="comparison" source="#liebermann" n="649"><label>printed alongside</label> <ref target="clause:ECf_24-1">ECf 24.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 649 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-1.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">Prepositus <hi rend="italic">Va Db Ph;</hi> uero <hi rend="italic">fügt zu Cb Lb Va Db Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">Prepositus Va Db Ph; Cb Lb Va Db Ph add uero</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-1.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-1.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">ad tres uel <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds ad tres uel</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-1.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">quatuor de mel. de un. uilla; eis co. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">quatuor de mel. de un. uilla; eis co. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-1.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">usque <hi rend="italic">Lb Va Ph;</hi> quibus <hi rend="italic">L</hi></seg><seg type="translation" xml:lang="en" source="#claude">usque Lb Va Ph; quibus L</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-1.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">quicquid sit <hi rend="italic">fügt zu L</hi></seg><seg type="translation" xml:lang="en" source="#claude">L adds quicquid sit</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-1.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus</hi> 24</seg><seg type="translation" xml:lang="en" source="#claude">from 24</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Let the reeve of the vill at once send to the four nearest vills for the priests and reeves of the vills, who are to bring with them from each vill three or four of the better men; and when they are assembled, let the whole find be shown.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24-1.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Pref.</hi><hi rend="superscript">19</hi> <hi rend="italic">uero ui.</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Pref.</hi><hi rend="superscript">19</hi> <hi rend="italic">uero ui.</hi> Rs</seg></note>
      </div>
    </body>
