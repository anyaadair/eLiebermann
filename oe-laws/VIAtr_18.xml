    <body>
      <div type="clause" n="18">
        <head><ref type="lawCode" target="law:VIAtr">VI Atr</ref> 18</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="18" corresp="#wit-k"><pb n="252" ed="#liebermann"/>K. ⁊ Romfeoh be Petres mæssan</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="18" corresp="#wit-d-incomplete"><pb n="252" ed="#liebermann"/>⁊ Romfeoh be Petres mæssan</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="18" corresp="#wit-k"><pb n="96" ed="#robertson"/>⁊ Romfeoh be Petres mæssan.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-k"><pb n="166" ed="#rabin-doml"/>and Romfeoh be Petres mæssan,</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="253" ed="#liebermann"/>und Romgeld zum Petersfest [1. August]</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">and Rome-money at St Peter's day [1 August]</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-k"><pb n="97" ed="#robertson"/>And Peter's Pence by St Peter's Day.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-k"><pb n="167" ed="#rabin-doml"/>the dues to Rome by the Feast of Saint Peter,</ab>
        <note type="comparison" source="#liebermann" n="253"><ref target="clause:VAtr_11-1">V Atr 11.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd.</note>
        <note type="comparedBy" source="#wormald-mel" n="356"><ref target="clause:ICn_9">I Cn 9</ref></note>
        <note type="translator" source="#rabin-doml">Feast of Saint Peter: June 29.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VIAtr_18.lnote.de.a__b" n="a. b" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">176</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Anderer Termin als sonst für Peterspfennig; <hi rend="italic">s. d. Gl</hi> 11ff. 15a</seg><seg type="translation" xml:lang="en" source="#claude">A different date from the usual one for Peter’s Pence; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 11ff. 15a</seg></note>
      </div>
    </body>
  </text>
