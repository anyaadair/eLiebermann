  <text>
    <body>
      <div type="clause" n="9">
        <head><ref type="lawCode" target="law:Hu">Hu</ref> 9</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="9" corresp="#wit-b"><pb n="194" ed="#liebermann"/>Ðæt isen, ðe bið to ðrimfealdum ordale, þ<hi rend="italic">æt</hi> wege III pund.<ptr type="liebermannNote" n="*" target="#Hu_9.lnote.oe.star"/><ptr type="liebermannNote" n="4" target="#Hu_9.lnote.oe.4"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="9" corresp="#wit-q"><pb n="194" ed="#liebermann"/>Ferrum, quod<ptr type="liebermannNote" n="15" target="#Hu_9.lnote.oe.15-2"/> facit ad triplex ordalium, debet ponderare LX solidos.<ptr type="liebermannNote" n="16" target="#Hu_9.lnote.oe.16"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="9" corresp="#wit-cons-cn"><pb n="195" ed="#liebermann"/>Ferrum<ptr type="liebermannNote" n="14" target="#Hu_9.lnote.oe.14"/> triplicis Dei iudicii ponderet III<ptr type="liebermannNote" n="15" target="#Hu_9.lnote.oe.15"/> libras.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="9" corresp="#wit-b"><pb n="18" ed="#robertson"/>Ðæt isen ðe bið to ðrimfealdum ordale, þæt wege III pund<ptr type="editorNote" n="3" target="#Hu_9.robnote.fn.3"/>.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="195" ed="#liebermann"/>Das<ptr type="liebermannNote" n="1" target="#Hu_9.lnote.de.1"/> Eisen, welches zum dreifachen Ordale gehört, das wiege 3<ptr type="liebermannNote" n="2" target="#Hu_9.lnote.de.2"/> Pfund.<ptr type="liebermannNote" n="3" target="#Hu_9.lnote.de.3"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">The iron which belongs to the threefold ordeal is to weigh 3 pounds.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#Hu_9.robnote.n.1"/><pb n="19" ed="#robertson"/>The iron for the triple ordeal shall weigh three pounds.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-b"><pb n="433" ed="#whitelock"/>The iron which belongs to the three-fold ordeal is to weigh three pounds.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Blas_1">Blas 1</ref></note>
        <note type="editorial">‘and to anfaldum an pund’ was added in the margin of B in the 16th century (not in the archetype, as Quadr. and Cons. Cn. show). The Latin's ‘LX solidos’ = 3 pounds. In B, I Atr follows in the same hand; in Quadr., IV As.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_9.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">194</biblScope></bibl><seg type="original" xml:lang="de">and to anfaldu<hi rend="italic">m</hi> an pund <hi rend="italic">im</hi> 16. <hi rend="italic">Jh. am Rande zugefügt</hi> [<hi rend="italic">nicht archetyp, laut Quadr., Consil. Cn.</hi>].</seg><seg type="translation" xml:lang="en" source="#claude">and to anfaldu<hi rend="italic">m</hi> an pund added in the margin in the 16th cent. [not in the archetype, according to Quadr., Consil. Cn.].</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_9.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">194</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt in derselben Hand:</hi> Æðelredes lage, <hi rend="italic">d. i.</hi> I Atr.</seg><seg type="translation" xml:lang="en" source="#claude">followed in the same hand by: Æðelredes lage, i.e. I Atr.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_9.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">195</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Cap.</hi> 9 <hi rend="italic">aus Cb Hr; fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cap. 9 from Cb Hr; lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_9.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">195</biblScope></bibl><seg type="original" xml:lang="de">li. III <hi rend="italic">Cb.</hi></seg><seg type="translation" xml:lang="en" source="#claude">li. III Cb.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_9.lnote.oe.15-2" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">194</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_9.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">194</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> IV As.; <hi rend="italic">o. S.</hi> 171.</seg><seg type="translation" xml:lang="en" source="#claude">IV As. follows; above p. 171.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Hu_9.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">133</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Der Satz = Blas 1, <hi rend="italic">o</hi>. I S. 388, welches Stück im Archetyp fast unmittelbar vorhergeht; <hi rend="italic">s</hi>. Einl. 8</seg><seg type="translation" xml:lang="en" source="#claude">The sentence = Blas 1, <hi rend="italic">above</hi> I p. 388, a piece which in the archetype comes almost immediately before; <hi rend="italic">see</hi> Introduction 8</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Hu_9.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">133</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Eisenordal 8</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Eisenordal 8</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Hu_9.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">133</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Q spricht wie <hi rend="italic">o</hi>. 3, 1 von Normannischen Schillingen zu ¹/₂₀ £, von denen 60 = 720 Silberpfennige damals noch nahezu drei kleine Römerpfund wogen. <hi rend="italic">Vgl. Gl</hi> Gewicht 1</seg><seg type="translation" xml:lang="en" source="#claude">Q, as <hi rend="italic">above</hi> 3, 1, speaks of Norman shillings of ¹/₂₀ £, 60 of which = 720 silver pennies then still weighed almost three small Roman pounds. <hi rend="italic">Cf. Gl</hi> Gewicht 1</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Hu_9.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">302</biblScope></bibl><seg type="original" xml:lang="en">Cf. <hi rend="italic">Be Blas.</hi>: <hi rend="italic">þæt man…myclade þæt ordal ysen</hi>, <hi rend="italic">þæt hit gewege þry pund</hi>. Schmid, following B, reads ⁊ <hi rend="italic">to anfealdum an pund</hi>.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Hu_9.robnote.fn.3" n="3" source="#robertson"><bibl><biblScope unit="page">18</biblScope></bibl><label>pund</label><seg type="original" xml:lang="en">⁊ <hi rend="italic">to anfaldum an pund</hi>, added in the margin in later handwriting.</seg></note>
      </div>
    </body>
  </text>
