        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-3.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-3.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">-mum <hi rend="italic">Hk;</hi> et friþborgam suam XII<sup>a</sup> persona exp., si <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-mum Hk; et friþborgam suam XIIa persona exp., si Ad Do</seg></note>
