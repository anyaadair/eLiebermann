    <body>
      <div type="clause" n="72">
        <head><ref type="lawCode" target="law:Af">Af</ref> 72</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="72" corresp="#wit-e"><pb n="86" ed="#liebermann"/>Gif monnes sconca bið ófaslegen<ptr type="liebermannNote" n="11" target="#Af_72.lnote.oe.11"/> wið ðæt cneou<ptr type="liebermannNote" n="12" target="#Af_72.lnote.oe.12"/>, ðær sceal LXXX scill. to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="72" corresp="#wit-h"><pb n="86" ed="#liebermann"/>Gif monnes<ptr type="liebermannNote" n="1" target="#Af_72.lnote.oe.1"/> sconca<ptr type="liebermannNote" n="1" target="#Af_72.lnote.oe.1"/> bið ofaslægen wið ðæt cneow, ðær scel<ptr type="liebermannNote" n="7" target="#Af_72.lnote.oe.7"/> LXXX scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="72" corresp="#wit-b-no-prol"><pb n="86" ed="#liebermann"/>Gyf mannes sceanca bið ofaslagen wið þ<hi rend="italic">æt</hi> cneow, ðær sceall hundeahtati scill' to bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="72" corresp="#wit-q"><pb n="87" ed="#liebermann"/>Si crus alicui perexcussum sit sub genu: LXXX solidorum culpa iudicetur.<ptr type="liebermannNote" n="6" target="#Af_72.lnote.oe.6"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="92" ed="#attenborough"/>Gif monnes sconca<ptr type="editorNote" n="1" target="#Af_72.attnote.fn.1"/> bið ófaslegen wið ðæt cneou<ptr type="editorNote" n="2" target="#Af_72.attnote.fn.2"/>, ðær sceal LXXX scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="76" corresp="#wit-e"><pb n="362" ed="#jurasinski-and-oliver"/>Gif monnes sconca bið ófaslegen wið ðæt cneou, ðær sceal LXXX scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="87" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_72.lnote.de.1"/> jemandes Unterschenkel an<ptr type="liebermannNote" n="2" target="#Af_72.lnote.de.2"/> dem Knie abgehauen ist, da gehört 80 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a person’s lower leg is cut off at the knee, 80 shillings are due as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="93" ed="#attenborough"/>If a man's shin is struck off at the knee, 80 shillings must be paid as compensation for it.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="363" ed="#jurasinski-and-oliver"/>If a person’s lower leg is struck off up to the knee, 80 shillings shall be the compensation.</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="363"><label>compare</label> <ref target="clause:Af_66">Af 66</ref> <quote>Compare §69 discussing cutting off the lower arm up to the elbow; wið here has the same meaning.</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_72.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">ofaslagen <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ofaslagen Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_72.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">cneowe, ðære <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cneowe, ðære Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_72.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geändert in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_72.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> sceal</seg><seg type="translation" xml:lang="en" source="#claude">altered to sceal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_72.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">87</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">emendetur</hi> <hi rend="italic">Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">emendetur</hi> Brti</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_72.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Unterschenkel 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Unterschenkel 1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_72.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘samt’ (obwohl <hi rend="italic">wið</hi> diese Bed. schon Agsä. haben kann) laut Parallele zum gleich teuren Unterarm bis zum Ellbogen; <hi rend="italic">o.</hi> 66</seg><seg type="translation" xml:lang="en" source="#claude">Not ‘together with’ (although <hi rend="italic">wið</hi> can already have this meaning in Anglo-Saxon), according to the parallel with the equally costly forearm up to the elbow; <hi rend="italic">above</hi> 66</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_72.attnote.fn.1" n="1" source="#attenborough"><bibl><biblScope unit="page">92</biblScope></bibl><label>sconca</label><seg type="original" xml:lang="en"><hi rend="italic">sceanca</hi>. B. <hi rend="italic">scanca</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_72.attnote.fn.2" n="2" source="#attenborough"><bibl><biblScope unit="page">92</biblScope></bibl><label>cneou</label><seg type="original" xml:lang="en"><hi rend="italic">cneow</hi>. B. <hi rend="italic">cneowe</hi>. Ld.</seg></note>
      </div>
    </body>
