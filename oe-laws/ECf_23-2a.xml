        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 23.2a"><pb n="649" ed="#liebermann"/>Et si poterit eum inuenire, ipse malefactor restauret dampnum quod fecerat et<ptr type="liebermannNote" n="1" target="#ECf_23-2a.lnote.la.1"/> emendationem<ptr type="liebermannNote" n="2" target="#ECf_23-2a.lnote.la.2"/>, si<ptr type="liebermannNote" n="3" target="#ECf_23-2a.lnote.la.3"/> poterit, etiam<ptr type="liebermannNote" n="4" target="#ECf_23-2a.lnote.la.4"/> de corpore, si ad<ptr type="liebermannNote" n="a" target="#ECf_23-2a.lnote.la.fn.a"/> hoc fuerit<ptr type="liebermannNote" n="5" target="#ECf_23-2a.lnote.la.5"/> forisfactum<ptr type="liebermannNote" n="6" target="#ECf_23-2a.lnote.la.6"/>.</ab>
