    <body>
      <div type="clause" n="5.3">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 5.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 5.3"><pb n="630" ed="#liebermann"/><hi rend="bold">Quodsi</hi><ptr type="liebermannNote" n="24" target="#ECfRetr_5-3.lnote.la.24"/> <hi rend="bold">more solito latro taliter</hi> egerit et<ptr type="liebermannNote" n="25" target="#ECfRetr_5-3.lnote.la.25"/> forte fortuitu ad ecclesias<ptr type="liebermannNote" n="26" target="#ECfRetr_5-3.lnote.la.26"/> <hi rend="bold">uel</hi><ptr type="liebermannNote" n="27" target="#ECfRetr_5-3.lnote.la.27"/> <hi rend="bold">ad</hi><ptr type="liebermannNote" n="28" target="#ECfRetr_5-3.lnote.la.28"/> <hi rend="bold">sacerdotum</hi><ptr type="liebermannNote" n="29" target="#ECfRetr_5-3.lnote.la.29"/> <hi rend="bold">domos frequenter euaserit,</hi> ablatione <hi rend="bold">restituta,</hi> prouinciam forisiuret nec<ptr type="liebermannNote" n="30" target="#ECfRetr_5-3.lnote.la.30"/> redeat.</ab>
        <note type="comparison" source="#liebermann" n="630"><label>printed alongside</label> <ref target="clause:ECf_5-3">ECf 5.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 630 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_5-3.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">Et si <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et si Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_5-3.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">si <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds si</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_5-3.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">-iam <hi rend="italic">Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iam Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_5-3.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_5-3.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lb Ra Ph Kn Sp Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lb Ra Ph Kn Sp Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_5-3.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">-tis domus <hi rend="italic">Hv;</hi> domum sac. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tis domus Hv; domum sac. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_5-3.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">n. r. <hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">n. r. lacking in Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But if the thief has done this in his usual way and by chance has frequently escaped to churches or to priests' houses, having restored what was taken, let him abjure the province and not return.</ab>
      </div>
    </body>
