    <body>
      <div type="clause" n="7.2">
        <head><ref type="lawCode" target="law:ICn">I Cn</ref> 7.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.2" corresp="#wit-g-a"><pb n="290" ed="#liebermann"/>ne ænige<ptr type="liebermannNote" n="18" target="#ICn_7-2.lnote.oe.18"/> forligru ahwar ne begange;</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.2" corresp="#wit-a"><pb n="290" ed="#liebermann"/>ne ænig forligru ahwær ne begange;</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7.2" corresp="#wit-q"><pb n="290" ed="#liebermann"/>nec cum meretricibus circumeundo fornicetur;</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.2" corresp="#wit-d-frags"><pb n="291" ed="#liebermann"/>ne ænig forligeru ahwar ne begange;</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7.2" corresp="#wit-cons-cn"><pb n="291" ed="#liebermann"/>[neque] illicitum coitum ambeat,</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="7.2" corresp="#wit-g-a"><pb n="162" ed="#robertson"/>ne ænige forligru ahwar ne begange;</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="242" ed="#rabin-doml"/>Ne ænige forligru ahwar ne begange.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="291" ed="#liebermann"/>noch<ptr type="liebermannNote" n="1" target="#ICn_7-2.lnote.de.1"/> begehe<ptr type="liebermannNote" n="2" target="#ICn_7-2.lnote.de.2"/> er irgendwo Hurereien;</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">nor let him commit fornication anywhere;</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-g-a"><ptr type="editorNote" n="1" target="#ICn_7-2.robnote.n.1"/><pb n="163" ed="#robertson"/>And he shall never commit adultery anywhere.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="243" ed="#rabin-doml"/>Nor may he ever commit adultery anywhere.</ab>
        <note type="comparison" source="#liebermann" n="291"><ref target="clause:VIAtr_28-2">VI Atr 28.2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">(* ebd. 28, 2)</note>
        <note type="comparedBy" source="#kennedy" n="59"><label>used in I–II Cnut</label> <ref target="clause:Cn-1018_part-028">Cn 1018 12.3</ref> <quote>Kennedy’s table:  (VI Æthelred 28.2) | D 12.3 | I Cnut 7.2</quote></note>
        <note type="editorial">Liebermann compares VI Atr 28.2.; BR: added from Gesetze I p. 291, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_7-2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de">-ig f. aghwær <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ig f. aghwær Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_7-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">291</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">in Hr</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_7-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">199</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Der Satz unterbricht den Zusammenhang, fehlt wie der Quelle Atr, so jener Vorlage der 2 Homileten <hi rend="italic">o</hi>. 7¹, und wiederholt das 6, 3 Gesagte; <hi rend="italic">vgl. Gl</hi> Unzucht 4a</seg><seg type="translation" xml:lang="en" source="#claude">The sentence interrupts the context; it is lacking both in the source, Atr, and in the exemplar of the 2 homilists <hi rend="italic">above</hi> 7¹, and it repeats what was said in 6, 3; <hi rend="italic">cf. Gl</hi> Unzucht 4a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_7-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">199</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Q, silbenweise übersetzend, entnimmt aus <hi rend="italic">gangan</hi> ‘ire’</seg><seg type="translation" xml:lang="en" source="#claude">Q, translating syllable by syllable, derives ‘ire’ from <hi rend="italic">gangan</hi></seg></note>
        <note type="editorNote" subtype="endnote" xml:id="ICn_7-2.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">349</biblScope></bibl><seg type="original" xml:lang="en">This clause is not found in Æthelred.</seg></note>
      </div>
    </body>
