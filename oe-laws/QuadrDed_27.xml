      <div type="clause" n="27">
        <head><ref type="lawCode" target="law:QuadrDed">Quadr Ded</ref> 27</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Ded 27" corresp="#wit-lat"><pb n="531" ed="#liebermann"/>Inde sum, fateor, de rustico causidicus, et pene iam satyricus formidolosa tarditate<ptr type="liebermannNote" n="9" target="#QuadrDed_27.lnote.oe.9"/> præcurro: ‘Occupet<ptr type="liebermannNote" n="m" target="#QuadrDed_27.lnote.oe.m"/> extremum scabies! Nuperne<ptr type="liebermannNote" n="n" target="#QuadrDed_27.lnote.oe.n"/> reponam? Insanire<ptr type="liebermannNote" n="o" target="#QuadrDed_27.lnote.oe.o"/> iu[ua]t; facit<ptr type="liebermannNote" n="oo" target="#QuadrDed_27.lnote.oe.oo"/> indignatio uersum’.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 531 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_27.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de">O. e. s. <hi rend="italic">Horaz,</hi> Pis. 417</seg><seg type="translation" xml:lang="en" source="#claude">O. e. s. <hi rend="italic">Horace,</hi> Pis. 417</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_27.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Juvenal</hi> 1, 1: Semper ego auditor tantum? Numquamne reponam? nuꝑne <hi rend="italic">wohl aus</hi> nūꝗne</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Juvenal</hi> 1, 1: Semper ego auditor tantum? Numquamne reponam? nuꝑne <hi rend="italic">probably from</hi> nūꝗne</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_27.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Horaz</hi> Carm. 3, 19, 18; iubet <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Horace</hi> Carm. 3, 19, 18; iubet <hi rend="italic">Dm</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_27.lnote.oe.oo" n="oo" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de">f. in. u. <hi rend="italic">Juv.</hi> I 79</seg><seg type="translation" xml:lang="en" source="#claude">f. in. u. <hi rend="italic">Juv.</hi> I 79</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_27.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de">-idate <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">-idate <hi rend="italic">Dm</hi></seg></note>
