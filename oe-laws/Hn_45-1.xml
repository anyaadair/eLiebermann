        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 45.1" corresp="#wit-lat"><pb n="570" ed="#liebermann"/>Multe<ptr type="liebermannNote" n="c" target="#Hn_45-1.lnote.oe.c"/> sunt et multorum inculpaciones, in quibus non neccesse est, secundum legem, responderi: ut quauis<ptr type="liebermannNote" n="4" target="#Hn_45-1.lnote.oe.4"/> compellacione<ptr type="liebermannNote" n="5" target="#Hn_45-1.lnote.oe.5"/> simplici promtum est inueniri.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 570 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt</hi> 63, 2</seg><seg type="translation" xml:lang="en" source="#claude">repeated 63, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">quamuis <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">quamuis Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">copulacione <hi rend="italic">Sc Hg;</hi> s. c. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">copulacione Sc Hg; s. c. Lond</seg></note>
