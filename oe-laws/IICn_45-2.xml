    <body>
      <div type="clause" n="45.2">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 45.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="45.2" corresp="#wit-g-a"><pb n="342" ed="#liebermann"/>Þeowman gif wyrce<ptr type="liebermannNote" n="23" target="#IICn_45-2.lnote.oe.23"/>, þolige his hyde oððon<ptr type="liebermannNote" n="24" target="#IICn_45-2.lnote.oe.24"/> hydgyldes, be þam seo dæd sy.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="45.2" corresp="#wit-b"><pb n="342" ed="#liebermann"/>Ðeowman gyf he wyrce, ðolie his hyde oððon hydgyldes, be ðam ðe seo dæd sy.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="45.2" corresp="#wit-a"><pb n="342" ed="#liebermann"/>Þeowman gif he weorce, þolige his hyde oððe hydgyldes, be<ptr type="liebermannNote" n="4" target="#IICn_45-2.lnote.oe.4"/> þam seo dæd sy.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="45.2" corresp="#wit-q"><pb n="343" ed="#liebermann"/>Si seruus operetur, corium amittat<ptr type="liebermannNote" n="7" target="#IICn_45-2.lnote.oe.7"/> (suum perdat) — aut<ptr type="liebermannNote" n="11" target="#IICn_45-2.lnote.oe.11"/> solutionem corii sui pro modo facti — uel XXX denariis redimat<ptr type="liebermannNote" n="12" target="#IICn_45-2.lnote.oe.12"/>, secundum<ptr type="liebermannNote" n="13" target="#IICn_45-2.lnote.oe.13"/> quod factum erit.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="45.2" corresp="#wit-inst-cn"><pb n="343" ed="#liebermann"/>Si seruus hoc faciat, careat corio suo aut emendet secundum modum operis.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="45.2" corresp="#wit-cons-cn"><pb n="343" ed="#liebermann"/>[45, 2] Si uero seruus, amittat cutem aut cutis redempcionem iuxta operis qualitatem.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="45.2" corresp="#wit-b"><pb n="198" ed="#robertson"/>Ðeowman, gyf he<ptr type="editorNote" n="9" target="#IICn_45-2.robnote.fn.9"/> wyrce, ðolie his hyde oððon hydgyldes, be ðam ðe seo dæd sy.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="278" ed="#rabin-doml"/>Þeowman gif wyrce, þolige his hyde oððon hydgyldes, be þam seo dæd sy.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="343" ed="#liebermann"/>Ein<ptr type="liebermannNote" n="1" target="#IICn_45-2.lnote.de.1"/> Unfreier<ptr type="liebermannNote" n="2" target="#IICn_45-2.lnote.de.2"/>, wenn er arbeitet, verliere seine Haut [erhalte Prügel] oder Hautgold<ptr type="liebermannNote" n="3" target="#IICn_45-2.lnote.de.3"/>, je<ptr type="liebermannNote" n="4" target="#IICn_45-2.lnote.de.4"/> nachdem die That ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">A slave, if he works, let him lose his hide [be flogged] or pay hide-money, according to what the deed is.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_45-2.robnote.n.1"/><pb n="199" ed="#robertson"/>If a slave works, he shall undergo the lash or pay the fine in lieu thereof, according to the nature of the offence.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><ptr type="editorNote" n="11" target="#IICn_45-2.whinote.n.11"/><pb n="469" ed="#whitelock"/>A slave, if he work, is to suffer a flogging or redeem himself from one, in proportion to the deed.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="279" ed="#rabin-doml"/>If a slave works, he shall suffer the lash or pay a fine in its stead, according to the nature of the deed.</ab>
        <note type="comparison" source="#liebermann" n="343"><ref target="clause:EGu_7-1">EGu 7.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd.</note>
        <note type="comparison" source="#whitelock" n="469"><label>from</label> <ref target="clause:Ine_3-1">Ine 3.1</ref> <quote>from “Edward and Guthrum”, 7.1, in agreement with Ine 3.1</quote></note>
        <note type="comparison" source="#whitelock" n="469"><label>from</label> <ref target="clause:EGu_7-1">EGu 7.1</ref> <quote>from “Edward and Guthrum”, 7.1, in agreement with Ine 3.1</quote></note>
        <note type="editorial">Liebermann compares EGu 7.1.; BR: added from Gesetze I p. 343, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">gif wyrce: gyf he wyrce B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_45-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">343</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> operetur</seg><seg type="translation" xml:lang="en" source="#claude">supply operetur</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_45-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">343</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer K; eingeklammertes übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">the words before the bracket K; the bracketed words the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_45-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">343</biblScope></bibl><seg type="original" xml:lang="de">id est <hi rend="italic">T;</hi> aut — facti <hi rend="italic">am Rande Dm; im Text T; fehlt K R Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">id est T; aut — facti in the margin Dm; in the text T; lacking in K R Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_45-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">343</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_45-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">343</biblScope></bibl><seg type="original" xml:lang="de">sicut <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">sicut K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_45-2.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">342</biblScope></bibl><seg type="original" xml:lang="de">he weorce <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">he weorce Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_45-2.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">342</biblScope></bibl><seg type="original" xml:lang="de">oþþe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">oþþe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_45-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">342</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">doppelt</hi></seg><seg type="translation" xml:lang="en" source="#claude">written twice</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_45-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">208</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Teilweise benutzt in Ps Cn for 22 aus Inst</seg><seg type="translation" xml:lang="en" source="#claude">Partly used in Ps Cn for 22, from Inst</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_45-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">208</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Feiertag 5d</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Feiertag 5d</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_45-2.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">208</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Die 6 Schilling (<hi rend="italic">s. Gl</hi> Prügel 2. 4b) rechnet Q richtig zu je 5 Pf. um</seg><seg type="translation" xml:lang="en" source="#claude">Q correctly converts the 6 shillings (<hi rend="italic">see Gl</hi> Prügel 2. 4b) at 5 pence each</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_45-2.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">208</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. o</hi>. 43¹</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. above</hi> 43¹</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_45-2.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">356</biblScope></bibl><seg type="original" xml:lang="en">Cf. In. 3, 1; E. and G. 7, 1; 8.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_45-2.robnote.fn.9" n="9" source="#robertson"><bibl><biblScope unit="page">198</biblScope></bibl><label>he</label><seg type="original" xml:lang="en">Om. G.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IICn_45-2.whinote.n.11" n="11" source="#whitelock"><bibl><biblScope unit="page">469</biblScope></bibl><label>45.2</label><seg type="original" xml:lang="en">from “Edward and Guthrum”, 7.1, in agreement with Ine 3.1</seg></note>
      </div>
