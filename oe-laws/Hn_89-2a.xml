      <div type="clause" n="89.2a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 89.2a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 89.2a" corresp="#wit-lat"><pb n="605" ed="#liebermann"/>Si uero aliquis eum iniuste cogat inseruire, et ille per cartam ingenuitatis sue<ptr type="liebermannNote" n="5" target="#Hn_89-2a.lnote.oe.5"/> ostendat et conuincat aduersarium, ipse qui hoc attemptauit<ptr type="liebermannNote" n="6" target="#Hn_89-2a.lnote.oe.6"/>, multam<ptr type="liebermannNote" n="7" target="#Hn_89-2a.lnote.oe.7"/> que in carta scripta est soluere cogatur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 605 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_89-2a.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">suo <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">suo Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_89-2a.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">ate. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">ate. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_89-2a.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">in lecta <hi rend="italic">K Co Or;</hi> in secta <hi rend="italic">Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">in lecta K Co Or; in secta Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_89-2a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Verknechtung 6—<hi rend="italic">mulct</hi>.{7}—89, 2b <hi rend="italic">-dum</hi>{9}—<hi rend="italic">quem</hi>{10}—<hi rend="italic">tres</hi>{11}—<hi rend="italic">ipsam</hi>{12} fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Verknechtung 6—<hi rend="italic">mulct</hi>.{7}—89, 2b <hi rend="italic">-dum</hi>{9}—<hi rend="italic">quem</hi>{10}—<hi rend="italic">tres</hi>{11}—<hi rend="italic">ipsam</hi>{12} lacking Rs</seg></note>
