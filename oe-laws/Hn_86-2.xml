        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 86.2" corresp="#wit-lat"><pb n="601" ed="#liebermann"/>Nec debet requiri<ptr type="liebermannNote" n="d" target="#Hn_86-2.lnote.oe.d"/> a domino, si homo<ptr type="liebermannNote" n="e" target="#Hn_86-2.lnote.oe.e"/> suus misfaciat<ptr type="liebermannNote" n="11" target="#Hn_86-2.lnote.oe.11"/> sine posse<ptr type="liebermannNote" n="f" target="#Hn_86-2.lnote.oe.f"/> uel uelle suo<ptr type="liebermannNote" n="g" target="#Hn_86-2.lnote.oe.g"/>, maxime si numquam deinceps ad eum<ptr type="liebermannNote" n="g" target="#Hn_86-2.lnote.oe.g"/> redeat, et hoc in uerum<ptr type="liebermannNote" n="h" target="#Hn_86-2.lnote.oe.h"/> mittere possit<ptr type="liebermannNote" n="g" target="#Hn_86-2.lnote.oe.g"/>.</ab>
