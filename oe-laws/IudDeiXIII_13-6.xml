      <div type="clause" n="13.6">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 13.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 13.6" corresp="#wit-lat"><ptr type="liebermannNote" n="39" target="#IudDeiXIII_13-6.lnote.oe.39"/><pb n="424" ed="#liebermann"/>Isto autem modo dicas<ptr type="liebermannNote" n="40" target="#IudDeiXIII_13-6.lnote.oe.40"/> ad eos qui pro<ptr type="liebermannNote" n="c" target="#IudDeiXIII_13-6.lnote.oe.c"/> aliis immittuntur:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 424 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-6.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. o.</hi> 12<hi rend="superscript"><hi rend="italic">d</hi></hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. above 12<hi rend="superscript">d</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-6.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">13, 6 <hi rend="italic">f. fehlt Co Zeu.</hi> 696<hi rend="subscript">8</hi>; = <hi rend="italic">Zeu.</hi> 654<hi rend="subscript">8</hi></seg><seg type="translation" xml:lang="en" source="#claude">13, 6 f. omitted in Co Zeu. 696<hi rend="subscript">8</hi>; = Zeu. 654<hi rend="subscript">8</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-6.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">dices ad illos qui <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">dices ad illos qui Tr</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">But in this manner you are to speak to those who are put in for others:</ab>
      </div>
