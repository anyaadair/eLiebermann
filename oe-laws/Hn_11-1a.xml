      <div type="clause" n="11.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 11.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 11.1a" corresp="#wit-lat"><pb n="556" ed="#liebermann"/>Si rex<ptr type="liebermannNote" n="y" target="#Hn_11-1a.lnote.oe.y"/> paciatur<ptr type="liebermannNote" n="45" target="#Hn_11-1a.lnote.oe.45"/>, ut qui in ecclesia fecerit<ptr type="liebermannNote" n="46" target="#Hn_11-1a.lnote.oe.46"/> homicidium, ad emendacionem ueniat, primo Christo (episcopo<ptr type="liebermannNote" n="47" target="#Hn_11-1a.lnote.oe.47"/>) et regi precium natiuitatis<ptr type="liebermannNote" n="48" target="#Hn_11-1a.lnote.oe.48"/> sue reddat<ptr type="liebermannNote" n="49" target="#Hn_11-1a.lnote.oe.49"/> et ita<ptr type="liebermannNote" n="50" target="#Hn_11-1a.lnote.oe.50"/> se inlegiet<ptr type="liebermannNote" n="51" target="#Hn_11-1a.lnote.oe.51"/>; deinde componat de pace ecclesie V libras et reconciliationem<ptr type="liebermannNote" n="52" target="#Hn_11-1a.lnote.oe.52"/> ecclesie querat, sicut ad eam pertinebit; et congnationis et dominationis<ptr type="liebermannNote" n="53" target="#Hn_11-1a.lnote.oe.53"/> emendacionem<ptr type="liebermannNote" n="z" target="#Hn_11-1a.lnote.oe.z"/> plene restituat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 556 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-1a.lnote.oe.y" n="y" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nochmals</hi> 79, 5 <hi rend="italic">f. Vgl.</hi> 12, 1; 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">again</hi> 79, 5 <hi rend="italic">f. Cf.</hi> 12, 1; 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-1a.lnote.oe.z" n="z" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">anderer Ausdruck für</hi> manbote 79, 5</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">another expression for</hi> manbote 79, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-1a.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de">petiatur <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">petiatur <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-1a.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de">h. f. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. f. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-1a.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de">Ch. <hi rend="italic">Lond;</hi> ep. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ch. <hi rend="italic">Lond;</hi> ep. <hi rend="italic">Sc Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-1a.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vom Corr. gebessert aus</hi> -tati <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">corrected by the corrector from</hi> -tati <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-1a.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de">-dit <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dit Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-1a.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de">i&lt;sup&gt;a&lt;/sup&gt; <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">i&lt;sup&gt;a&lt;/sup&gt; <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-1a.lnote.oe.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de">-iat <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iat <hi rend="italic">Sc Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-1a.lnote.oe.52" n="52" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert vom Schreiber aus</hi> recōsilcil. <hi rend="italic">Sc;</hi> <hi rend="spaced">ipsius</hi> <hi rend="italic">fügt hinzu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">corrected by the scribe from</hi> recōsilcil. <hi rend="italic">Sc;</hi> <hi rend="italic">ipsius</hi> <hi rend="italic">added by Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-1a.lnote.oe.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de">donat. <hi rend="italic">Lond Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">donat. <hi rend="italic">Lond edd.</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-1a.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de">Trotz Agsächs. Ausdrücke halten dies unter Heinrich I. noch für gültig Bigelow <hi rend="italic">Engl. proced</hi>. 53 und Böhmer <hi rend="italic">Kirche u. Staat</hi> 288. <hi rend="italic">Vgl. Gl</hi> Kirchenfrieden 2a ff.; Gerichtsbarkeit 18a.—Am Rande später: <hi rend="italic">De homicidio facto in ecclesia</hi>—<hi rend="italic">ho. fe</hi>.{46}—ohne <hi rend="italic">episcopo</hi>{47} Rs</seg><seg type="translation" xml:lang="en" source="#claude">Despite the Anglo-Saxon expressions, Bigelow <hi rend="italic">Engl. proced</hi>. 53 and Böhmer <hi rend="italic">Kirche u. Staat</hi> 288 consider this still valid under Henry I. <hi rend="italic">Cf. Gl</hi> Kirchenfrieden 2a ff.; Gerichtsbarkeit 18a.—In the margin, later: <hi rend="italic">De homicidio facto in ecclesia</hi>—<hi rend="italic">ho. fe</hi>.{46}—without <hi rend="italic">episcopo</hi>{47} Rs</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-1a.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de">In der Normandie <hi rend="italic">de occisoribus in pace ecclesie: duellum in curia mea</hi> (Heinrichs I. 1135); <hi rend="italic">episcopus IX libras de pecunia convicti</hi> (dessen Fahrhabe dem König verfällt); Très anc. cout. II 71; <hi rend="italic">vgl</hi>. Pol Mai II 461—<hi rend="italic">re</hi>.{52} <hi rend="italic">ipsius ec. q., s. ad c. p. et cogn</hi>.—Zu 11, 2 am Rande später <hi rend="italic">Nota, correctionem super decimis detentis pertinere ad regem sicut prius</hi>—11, 2a <hi rend="italic">di. eius</hi>{3}, <hi rend="italic">sit</hi>—11, 3 <hi rend="italic">Romfeach</hi>{6}—11, 4{8} fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude">In Normandy <hi rend="italic">de occisoribus in pace ecclesie: duellum in curia mea</hi> (Henry I, 1135); <hi rend="italic">episcopus IX libras de pecunia convicti</hi> (whose chattels are forfeit to the king); Très anc. cout. II 71; <hi rend="italic">cf.</hi> Pol Mai II 461—<hi rend="italic">re</hi>.{52} <hi rend="italic">ipsius ec. q., s. ad c. p. et cogn</hi>.—On 11, 2 in the margin, later, <hi rend="italic">Nota, correctionem super decimis detentis pertinere ad regem sicut prius</hi>—11, 2a <hi rend="italic">di. eius</hi>{3}, <hi rend="italic">sit</hi>—11, 3 <hi rend="italic">Romfeach</hi>{6}—11, 4{8} missing Rs</seg></note>
      </div>
