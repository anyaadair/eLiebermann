    <body>
      <div type="clause" n="6.2">
        <head><ref type="lawCode" target="law:EGu">EGu</ref> 6.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.2" corresp="#wit-h"><pb n="132" ed="#liebermann"/>Gif hwa leohtgesceot<ptr type="liebermannNote" n="1" target="#EGu_6-2.lnote.oe.1-2"/> ne gelæste, gylde lahslit<ptr type="liebermannNote" n="2" target="#EGu_6-2.lnote.oe.2-2"/> mid Denu<hi rend="italic">m</hi>, wíte mid Englu<hi rend="italic">m</hi>.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.2" corresp="#wit-b"><pb n="132" ed="#liebermann"/>Gyf hwá hleohtgesceot<ptr type="liebermannNote" n="1" target="#EGu_6-2.lnote.oe.1-3"/> ne g<hi rend="italic">e</hi>læste, gylde lahslitt mid Denu<hi rend="italic">m</hi>, wite mid Englu<hi rend="italic">m</hi>.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6.2" corresp="#wit-q"><pb n="133" ed="#liebermann"/>Si<ptr type="liebermannNote" n="1" target="#EGu_6-2.lnote.oe.1"/> quis non reddit<ptr type="liebermannNote" n="2" target="#EGu_6-2.lnote.oe.2"/> lucis<ptr type="liebermannNote" n="3" target="#EGu_6-2.lnote.oe.3"/> simbolum (luminis), reddat lahslit cum Dacis, witam cum Anglis.<ptr type="liebermannNote" n="4" target="#EGu_6-2.lnote.oe.4"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="6.2" corresp="#wit-h"><pb n="104" ed="#attenborough"/>Gif hwa leohtgesceot<ptr type="editorNote" n="18" target="#EGu_6-2.attnote.fn.18"/> ne gelæste, gylde lahslit mid Denum, wíte mid Englum.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-h"><pb n="6" ed="#rabin-doml"/>Gif hwa leohtgesceot ne gelæste, gylde lahslit mid Denum, wite mid Englum.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="133" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#EGu_6-2.lnote.de.1"/> jemand den Lichtschoss<ptr type="liebermannNote" n="2" target="#EGu_6-2.lnote.de.2"/> nicht leistet, zahle er Rechtsbruchbusse bei den Dänen, Strafgeld bei den Engländern.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If anyone does not pay light-dues, let him pay the penalty for breach of law among the Danes, a fine among the English.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="105" ed="#attenborough"/>If anyone neglects to pay 'light-dues<ptr type="editorNote" n="1" target="#EGu_6-2.attnote.n.1"/>' [to the church], he shall pay <hi rend="italic">lahslit</hi> in a Danish district, and a fine in an English district.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-h"><pb n="7" ed="#rabin-doml"/>If anyone does not pay the dues for the lighting of the church, he shall pay lahslit among the Danes or a penalty among the English.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VAtr_31">V Atr 31</ref></note>
        <note type="translator" source="#rabin-doml">dues for the lighting of a church: A tax paid between one and three times a year to fund the lighting of the local church or minster.</note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_6-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">133</biblScope></bibl><seg type="original" xml:lang="de">6, 2 <hi rend="italic">stellt hinter</hi> 6, 4 <hi rend="italic">KOr</hi></seg><seg type="translation" xml:lang="en" source="#claude">KOr place 6, 2 after 6, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_6-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">133</biblScope></bibl><seg type="original" xml:lang="de">-dat <hi rend="italic">TMHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dat TMHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_6-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">133</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> lucis s. <hi rend="italic">Lond; nur</hi> s. lum. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">only lucis s. Lond; only s. lum. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_6-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">133</biblScope></bibl><seg type="original" xml:lang="de">6, 3 <hi rend="italic">fehlt Quadr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">6, 3 omitted in Quadr.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_6-2.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">leohteg. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">leohteg. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_6-2.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">-ite <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ite Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_6-2.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_6-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Lichtschoss</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Lichtschoss</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_6-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Unorganisch <hi rend="italic">h</hi>- zu Anfang <hi rend="italic">s. Wb</hi> 107. — Aus dem antik Latein. <hi rend="italic">symbola</hi> ‘Zusammenschiessung’ (II Cn 13. 13, 1 Cons) macht Q <hi rend="italic">symbolum</hi> (<hi rend="italic">s. d. Wb</hi>), das Ducange nur aus Q zitiert; sein zweites Zitat entstammt nur Spelman's Übs. von VI Atr 19 in <hi rend="italic">Conc. Brit.</hi> 517</seg><seg type="translation" xml:lang="en" source="#claude">On inorganic initial <hi rend="italic">h</hi>- <hi rend="italic">see Wb</hi> 107. — From the classical Latin <hi rend="italic">symbola</hi> ‘contribution’ (II Cn 13. 13, 1 Cons) Q makes <hi rend="italic">symbolum</hi> (<hi rend="italic">see</hi> that word in <hi rend="italic">Wb</hi>), which Ducange cites only from Q; his second citation derives merely from Spelman’s translation of VI Atr 19 in <hi rend="italic">Conc. Brit.</hi> 517</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="EGu_6-2.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">202</biblScope></bibl><seg type="original" xml:lang="en">According to Schmid and Toller ‘light-dues’ were paid to provide the church with lights (cf. VIII Athlr. cap. 12 § 1; V Athlr. cap. 11 § 1; I Can. cap. 12).</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="EGu_6-2.attnote.fn.18" n="18" source="#attenborough"><bibl><biblScope unit="page">104</biblScope></bibl><label>leohtgesceot</label><seg type="original" xml:lang="en"><hi rend="italic">hleohtgesceot</hi>. B.</seg></note>
      </div>
    </body>
  </text>
