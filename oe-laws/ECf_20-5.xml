    <body>
      <div type="clause" n="20.5">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 20.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 20.5"><pb n="646" ed="#liebermann"/>Et tamen<ptr type="liebermannNote" n="28" target="#ECf_20-5.lnote.la.28"/> sacramentum, quod non potuerunt<ptr type="liebermannNote" n="29" target="#ECf_20-5.lnote.la.29"/> complere per uicinos<ptr type="liebermannNote" n="g" target="#ECf_20-5.lnote.la.fn.g"/>, per se ipsos nouem<ptr type="liebermannNote" n="30" target="#ECf_20-5.lnote.la.30"/> iurent: se<ptr type="liebermannNote" n="31" target="#ECf_20-5.lnote.la.31"/> immunes.</ab>
        <note type="comparison" source="#liebermann" n="646"><label>printed alongside</label> <ref target="clause:ECfRetr_20-5">ECf retr 20.5</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 646 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-5.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 20, 3, <hi rend="italic">woraus Retr. schöpft; Eidesformel theilweise in</hi> Wl art. 8</seg><seg type="translation" xml:lang="en" source="#claude">cf. 20, 3, from which the Retr. draws; the oath formula partly in Wl art. 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-5.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">tantum <hi rend="italic">Rl S;</hi> cum <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">tantum Rl S; cum Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-5.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">poterunt <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">poterunt Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-5.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">XX <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">XX Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-5.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">esse <hi rend="italic">fügt zu S</hi></seg><seg type="translation" xml:lang="en" source="#claude">S adds esse</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And yet the oath which they could not complete through the neighbours, let the nine swear by themselves: that they are guiltless.</ab>
      </div>
    </body>
  </text>
