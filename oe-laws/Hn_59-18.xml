      <div type="clause" n="59.18">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.18</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.18" corresp="#wit-lat"><pb n="579" ed="#liebermann"/>Et si quis furem<ptr type="liebermannNote" n="n" target="#Hn_59-18.lnote.oe.n"/> in eis<ptr type="liebermannNote" n="o" target="#Hn_59-18.lnote.oe.o"/> qu[e<ptr type="liebermannNote" n="33" target="#Hn_59-18.lnote.oe.33"/>] mortis<ptr type="liebermannNote" n="34" target="#Hn_59-18.lnote.oe.34"/> sunt probatum<ptr type="liebermannNote" n="35" target="#Hn_59-18.lnote.oe.35"/> sine iusticia<ptr type="liebermannNote" n="p" target="#Hn_59-18.lnote.oe.p"/> dimittat<ptr type="liebermannNote" n="36" target="#Hn_59-18.lnote.oe.36"/>, sit placitum eius cuius<ptr type="liebermannNote" n="q" target="#Hn_59-18.lnote.oe.q"/> socna<ptr type="liebermannNote" n="r" target="#Hn_59-18.lnote.oe.r"/> erit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 579 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-18.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">unten</hi> 65, 1 <hi rend="italic">dagegen aus II Cn.</hi> 29 (<hi rend="italic">dem</hi> Leis Wl 49 <hi rend="italic">folgt</hi>) <hi rend="italic">anders</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">below</hi> 65, 1, <hi rend="italic">by contrast, taken from II Cn.</hi> 29 (<hi rend="italic">which</hi> Leis Wl 49 <hi rend="italic">follows</hi>), <hi rend="italic">is different</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-18.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 59, 20; 21</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 59, 20; 21</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-18.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Strafgericht; vgl.</hi> 12, 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">criminal jurisdiction; cf.</hi> 12, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-18.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Gerichtsbarkeit über den Entlasser</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">jurisdiction over the one who releases [the thief]</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-18.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch</hi> In. Cn. II 29 <hi rend="italic">giebt einem Privaten das Strafgeld für Diebes-Entlassung</hi></seg><seg type="translation" xml:lang="en" source="#claude">In. Cn. II 29 <hi rend="italic">too gives a private person the fine for releasing a thief</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-18.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de">qui <hi rend="italic">Hss.; gebessert Thorpe;</hi> quia <hi rend="italic">Schmid</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui <hi rend="italic">MSS; emended by Thorpe;</hi> quia <hi rend="italic">Schmid</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-18.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de">digna <hi rend="italic">fügt zu ohne Hss. Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">digna <hi rend="italic">added, without MS authority, Wi</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-18.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de">-bant <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-bant <hi rend="italic">Sc Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-18.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">579</biblScope></bibl><seg type="original" xml:lang="de">-ant <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ant <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-18.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Kapitalverbrechen 1; Freilassen 5—<hi rend="italic">qui</hi>{33} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Kapitalverbrechen 1; Freilassen 5—<hi rend="italic">qui</hi>{33} Rs</seg></note>
      </div>
