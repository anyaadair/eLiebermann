      <div type="clause" n="70.16b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 70.16b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 70.16b" corresp="#wit-lat"><pb n="589" ed="#liebermann"/>Mulier<ptr type="liebermannNote" n="m" target="#Hn_70-16b.lnote.oe.m"/>, si partum suum<ptr type="liebermannNote" n="16" target="#Hn_70-16b.lnote.oe.16"/> ante XL dies sponte perdiderit<ptr type="liebermannNote" n="n" target="#Hn_70-16b.lnote.oe.n"/>, III<ptr type="liebermannNote" n="17" target="#Hn_70-16b.lnote.oe.17"/> annis peniteat; si postquam animatus est, quasi homicida<ptr type="liebermannNote" n="18" target="#Hn_70-16b.lnote.oe.18"/> VII<ptr type="liebermannNote" n="o" target="#Hn_70-16b.lnote.oe.o"/> annis peniteat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 589 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-16b.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Theodor</hi> Poen. 1, 14, 27, <hi rend="italic">Beda, Ps.-Beda stehen ferner</hi></seg><seg type="translation" xml:lang="en" source="#claude">Theodor Poen. 1, 14, 27, Beda and Ps.-Beda are more remote</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-16b.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verf. oder Archetyp überspringt</hi> (<hi rend="italic">wie Confess. Ps.-Egberti</hi> 30) annum peniteat; si uero post XL dies: <hi rend="italic">des Beda</hi> 4, 12; <hi rend="italic">Ps.-Beda</hi> 14, 1; <hi rend="italic">Ps.-Theodor</hi></seg><seg type="translation" xml:lang="en" source="#claude">The author or the archetype passes over (as does Confess. Ps.-Egberti 30) the words annum peniteat; si uero post XL dies found in Beda 4, 12; Ps.-Beda 14, 1; Ps.-Theodor</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-16b.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">X <hi rend="italic">Ps.-Theodor u. a. Poenitentialien</hi></seg><seg type="translation" xml:lang="en" source="#claude">X Ps.-Theodor and other penitentials</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-16b.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in K Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-16b.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">IIII <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">IIII Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-16b.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">-dia <hi rend="italic">Sc Hg Or;</hi> q. h. <hi rend="italic">fehlt Wh Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dia Sc Hg Or; q. h. missing Wh Wi</seg></note>
      </div>
