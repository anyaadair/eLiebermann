    <body>
      <div type="clause" n="65">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 65</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="65" corresp="#wit-e"><pb n="118" ed="#liebermann"/>CVIIII. Se ðe hæfð X<ptr type="liebermannNote" n="11" target="#Ine_65.lnote.oe.11"/> hida, se sceal tæcnan<ptr type="liebermannNote" n="12" target="#Ine_65.lnote.oe.12"/> VI hida<ptr type="liebermannNote" n="9" target="#Ine_65.lnote.oe.9"/> gesettes landes.<ptr type="liebermannNote" n="10" target="#Ine_65.lnote.oe.10"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="65" corresp="#wit-h"><pb n="118" ed="#liebermann"/>CIX. Se þe hæfð X hida londes<ptr type="liebermannNote" n="1" target="#Ine_65.lnote.oe.1"/>, se sceal tæcan<ptr type="liebermannNote" n="2" target="#Ine_65.lnote.oe.2"/> VI hida gesettes londes.<ptr type="liebermannNote" n="1" target="#Ine_65.lnote.oe.1"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="65" corresp="#wit-b-no-prol"><pb n="119" ed="#liebermann"/>Be tyn hidu<hi rend="italic">m</hi>. Se ðe hæfð tyn hida, se sceal tæcan syx hida gesettes landes.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="65" corresp="#wit-q"><ptr type="liebermannNote" n="4" target="#Ine_65.lnote.oe.4"/><pb n="119" ed="#liebermann"/>Qui habet decem hidas (terre<ptr type="liebermannNote" n="5" target="#Ine_65.lnote.oe.5"/>), debet reddere sex hidas uestitas.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="58" ed="#attenborough"/>[Be tyn hidum.] Se ðe hæfð X hida<ptr type="editorNote" n="1" target="#Ine_65.attnote.fn.1"/>, se sceal tæcnan<ptr type="editorNote" n="2" target="#Ine_65.attnote.fn.2"/> VI hida gesettes landes.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="67.2" corresp="#wit-e"><pb n="426" ed="#jurasinski-and-oliver"/>{CVIIII} Se ðe hæfð X hida, se sceal tæcnan VI hida gesettes landes.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="119" ed="#liebermann"/>Wer 10 Hiden (Landes<ptr type="liebermannNote" n="1" target="#Ine_65.lnote.de.1"/>) hat, der soll 6 Hiden besäten Landes vorweisen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Whoever has 10 hides (of land) is to show 6 hides of sown land.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="59" ed="#attenborough"/>He who has [a holding of] 10 hides shall show 6 hides under cultivation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="407" ed="#whitelock"/>He who has 10 hides, must show six hides of sown land.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="427" ed="#jurasinski-and-oliver"/>He who has ten hides must show six cultivated hides.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_65.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">119</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">cap.</hi> 65 <hi rend="italic">fehlt M Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">cap. 65 lacking in M Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_65.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">119</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_65.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">118</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_65.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">118</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> tæcnan</seg><seg type="translation" xml:lang="en" source="#claude">altered to tæcnan</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_65.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">118</biblScope></bibl><seg type="original" xml:lang="de">tyn hyda <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">tyn hyda Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_65.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">118</biblScope></bibl><seg type="original" xml:lang="de">tæcan syx <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">tæcan syx Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_65.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">118</biblScope></bibl><seg type="original" xml:lang="de">hyda <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hyda So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_65.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">118</biblScope></bibl><seg type="original" xml:lang="de">lon. <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">lon. So</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_65.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">80</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">H Q füllen die archaische Ellipse aus. Über 10 Hufen <hi rend="italic">s. d. Gl</hi> 12</seg><seg type="translation" xml:lang="en" source="#claude">H Q fill out the archaic ellipsis. On 10 hides <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 12</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_65.attnote.fn.1" n="1" source="#attenborough"><bibl><biblScope unit="page">58</biblScope></bibl><label>hida</label><seg type="original" xml:lang="en"><hi rend="italic">hida londes</hi>. H.</seg><note type="remark" resp="#claude">The number 1 is printed 2 times on the page (65, 66), with one footnote.</note></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_65.attnote.fn.2" n="2" source="#attenborough"><bibl><biblScope unit="page">58</biblScope></bibl><label>tæcnan</label><seg type="original" xml:lang="en"><hi rend="italic">tæcan</hi>. H, B &amp; Ld.</seg></note>
      </div>
    </body>
