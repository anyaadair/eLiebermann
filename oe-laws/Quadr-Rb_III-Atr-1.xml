        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">(I. Of breach of the peace.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_III-Atr-1.lnote.la.dagger" n="†" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">541</biblScope></bibl><seg type="original" xml:lang="de">(<hi rend="italic">Eingeklammertes</hi>) <hi rend="italic">entstammt jüngster Recension</hi></seg><seg type="translation" xml:lang="en" source="#claude">(Bracketed matter) derives from the latest recension</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_III-Atr-1.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">541</biblScope></bibl><seg type="original" xml:lang="de">III Atr. <hi rend="italic">folgt auf</hi> Wer <hi rend="italic">R;</hi> Adhuc de legibus Ethelredi regis <hi rend="italic">überschr. Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">III Atr. follows Wer in R; headed Adhuc de legibus Ethelredi regis in Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_III-Atr-1.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">541</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rubriken aus MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Rubrics from MHkBr</seg></note>
