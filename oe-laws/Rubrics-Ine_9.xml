    <body>
      <div type="clause" n="9">
        <head>Ine Rb 9</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="9" corresp="#wit-e"><pb n="20" ed="#liebermann"/>LIII. Be ðam wrecendan<ptr type="liebermannNote" n="9" target="#Rubrics-Ine_9.lnote.oe.9"/>, ær<ptr type="liebermannNote" n="10" target="#Rubrics-Ine_9.lnote.oe.10"/> him ryhtes bidde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="9" corresp="#wit-ot-frag"><pb n="20" ed="#liebermann"/>… an … htes bid …<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_9.lnote.oe.1"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="9" corresp="#wit-g-prol"><pb n="20" ed="#liebermann"/>LIII. Be þa<hi rend="italic">m</hi> wrecendan, ær man rihtes bidde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="9" corresp="#wit-h"><pb n="21" ed="#liebermann"/>LIII. Be ðam<ptr type="liebermannNote" n="6" target="#Rubrics-Ine_9.lnote.oe.6"/> wrecendan, ær hine<ptr type="liebermannNote" n="7" target="#Rubrics-Ine_9.lnote.oe.7"/> man ryhtes bidde.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="9" corresp="#wit-q"><pb n="21" ed="#liebermann"/>De uindicantibus, antequam rectum postulent.<ptr type="liebermannNote" n="14" target="#Rubrics-Ine_9.lnote.oe.14"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="200" ed="#jurasinski-and-oliver"/>LIII Be ðam wrecendan, ær \he/ him ryhtes bidde</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="200" ed="#jurasinski-and-oliver"/>Be þam wrecendan</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="21" ed="#liebermann"/>Von den Genugthuung sich Nehmenden, bevor man<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_9.lnote.de.1"/> sich Rechtserfüllung gefordert hat.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of those who take satisfaction for themselves before one has demanded justice.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="201" ed="#jurasinski-and-oliver"/>Concerning he who exacts redress before he petitions him for justice</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="201" ed="#jurasinski-and-oliver"/>Concerning he who exacts redress</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_9.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">20</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Endet I. Fragment. Das II. beginnt in Af</hi> 40.</seg><seg type="translation" xml:lang="en" source="#claude">End of fragment I. Fragment II begins at Af 40.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_9.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">20</biblScope></bibl><seg type="original" xml:lang="de">wræc. <hi rend="italic">ohne</hi> ær — bidde <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wræc. without ær — bidde Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_9.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">20</biblScope></bibl><seg type="original" xml:lang="de">he <hi rend="italic">modern übergeschr. E</hi></seg><seg type="translation" xml:lang="en" source="#claude">he written above in a modern hand E</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_9.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">-letur <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">-letur Dm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_9.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">am <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">am on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_9.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">on an erasure</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_9.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Die Ellipse des Pronomens ist archaisch (<hi rend="italic">s. u.</hi> Rb 36; Pogatscher in <hi rend="italic">Anglia</hi> 23, 300), und ‘er’ oder ‘man’ nur zugunsten späterer Sprache ergänzt. Hcor verderbt (durch Missverständnis des dat. eth.): ‘ihn [den Schuldigen] um Recht bittet’</seg><seg type="translation" xml:lang="en" source="#claude">The ellipsis of the pronoun is archaic (<hi rend="italic">see below</hi> Rb 36; Pogatscher in <hi rend="italic">Anglia</hi> 23, 300), and ‘he’ or ‘one’ has been supplied only to suit later usage. Hcor is corrupt (through misunderstanding of the ethic dative): ‘asks him [the guilty party] for justice’</seg></note>
      </div>
