      <div type="clause" n="3.5">
        <head><ref type="lawCode" target="law:IudDeiIX">Iud Dei IX</ref> 3.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IX 3.5" corresp="#wit-lat"><pb n="416" ed="#liebermann"/>Hac ítaque fiducia, exaudítor piissime, hoc ferrum (uel<ptr type="liebermannNote" n="2" target="#IudDeiIX_3-5.lnote.oe.2"/> hęc ferramenta), quaesumus<ptr type="liebermannNote" n="32" target="#IudDeiIX_3-5.lnote.oe.32"/>, ut per nostram benedictionem sanctifices,</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 416 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_3-5.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">rund Eingeklammertes übergeschrieben Ch; fehlt Rj Vt Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">words in round brackets written above in Ch; missing in Rj Vt Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_3-5.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de">q. ut <hi rend="italic">fehlt Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">q. ut missing in Rj</seg></note>
      </div>
