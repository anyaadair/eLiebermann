      <div type="clause" n="41.2a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 41.2a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 41.2a" corresp="#wit-lat"><pb n="567–568" ed="#liebermann"/>Si in eodem comitatu<ptr type="liebermannNote" n="54" target="#Hn_41-2a.lnote.oe.54"/> sit, inde ad VII<ptr type="liebermannNote" n="s" target="#Hn_41-2a.lnote.oe.s"/> dies terminum habeat; si in alia scira<ptr type="liebermannNote" n="55" target="#Hn_41-2a.lnote.oe.55"/> sit, XV dierum terminus ponatur<ptr type="liebermannNote" n="1" target="#Hn_41-2a.lnote.oe.1"/> (-num habeat<ptr type="liebermannNote" n="2" target="#Hn_41-2a.lnote.oe.2"/>); si in tercio comitatu sit, (terminus<ptr type="liebermannNote" n="3" target="#Hn_41-2a.lnote.oe.3"/>) III ebdomade, si<ptr type="liebermannNote" n="4" target="#Hn_41-2a.lnote.oe.4"/> in quarto, IIII ebdomade; et ultra non procedit, ubicunque fuerit in Anglia, nisi competens eum detineat soinus<ptr type="liebermannNote" n="5" target="#Hn_41-2a.lnote.oe.5"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 567–568 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2a.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 46, 1 (7, 4 = 51, 2)</seg><seg type="translation" xml:lang="en" source="#claude">cf. 46, 1 (7, 4 = 51, 2)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2a.lnote.oe.54" n="54" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">comm. <hi rend="italic">Co oft</hi></seg><seg type="translation" xml:lang="en" source="#claude">comm. Co often</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2a.lnote.oe.55" n="55" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">schira <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">schira Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2a.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Sc Hg;</hi> -num h. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Sc Hg; -num h. the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2a.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">habet <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">habet Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2a.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus K Co Or Sl Tw als Subject zu vorigem</hi> sit</seg><seg type="translation" xml:lang="en" source="#claude">from K Co Or Sl Tw, as subject of the preceding sit</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2a.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">sin <hi rend="italic">statt</hi> si in <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">sin instead of si in Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2a.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Tho;</hi> soñ <hi rend="italic">Sc Hg;</hi> sonius <hi rend="italic">K Co Sl Tw;</hi> soinius <hi rend="italic">Wh Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Tho; soñ Sc Hg; sonius K Co Sl Tw; soinius Wh Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-2a.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de">Die Fristen (<hi rend="italic">s. d. Gl</hi> 6e) sind Fränkisch und Nordfranzösisch; <hi rend="italic">vgl. Capit</hi>. a. 803 <hi rend="italic">L. Ribuar. add</hi>. ed. Boretius <hi rend="italic">Mon. Germ., Capit</hi>. I 118; Brunner II 335. Einfluss der Lex Salica hält für möglich Laughlin (<hi rend="italic">Essays on Ags. law</hi> 192), für sicher Opet <hi rend="italic">Processeinl</hi>. 51. <hi rend="italic">S. Gl</hi> Grafschaft 4b—<hi rend="italic">in alia</hi> doppelt <hi rend="italic">scyra</hi>{55}—ohne <hi rend="italic">-num habeat</hi>{2}—ohne <hi rend="italic">terminus</hi>{3} Rs</seg><seg type="translation" xml:lang="en" source="#claude">The time-limits (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 6e) are Frankish and northern French; <hi rend="italic">cf. Capit</hi>. a. 803 <hi rend="italic">L. Ribuar. add</hi>. ed. Boretius <hi rend="italic">Mon. Germ., Capit</hi>. I 118; Brunner II 335. Influence of the Lex Salica is considered possible by Laughlin (<hi rend="italic">Essays on Ags. law</hi> 192), and certain by Opet <hi rend="italic">Processeinl</hi>. 51. <hi rend="italic">See Gl</hi> Grafschaft 4b—<hi rend="italic">in alia</hi> twice <hi rend="italic">scyra</hi>{55}—without <hi rend="italic">-num habeat</hi>{2}—without <hi rend="italic">terminus</hi>{3} Rs</seg></note>
      </div>
