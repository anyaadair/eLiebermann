        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_42-1.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">76</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Das Rind hatte, mehr als heute, über das Auszuschlachtende hinaus den Wert als Arbeit-, Zucht- und Milchvieh; <hi rend="italic">vgl.</hi> Arnold <hi rend="italic">Deutsche Urzeit</hi> 241</seg><seg type="translation" xml:lang="en" source="#claude">Cattle, more than today, had a value beyond what could be got by slaughtering them, as draught, breeding and milk stock; <hi rend="italic">cf.</hi> Arnold <hi rend="italic">Deutsche Urzeit</hi> 241</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_42-1.attnote.fn.4" n="4" source="#attenborough"><bibl><biblScope unit="page">50</biblScope></bibl><label>hwelc</label><seg type="original" xml:lang="en"><hi rend="italic">gehwilc</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_42-1.attnote.fn.5" n="5" source="#attenborough"><bibl><biblScope unit="page">50</biblScope></bibl><label>þe</label><seg type="original" xml:lang="en"><hi rend="italic">ðæt</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_42-1.attnote.fn.6" n="6" source="#attenborough"><bibl><biblScope unit="page">50</biblScope></bibl><label>mete</label><seg type="original" xml:lang="en"><hi rend="italic">gemete</hi>. H &amp; B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_42-1.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">50</biblScope></bibl><label>⁊</label><seg type="original" xml:lang="en"><hi rend="italic">fel ⁊</hi>. om. H, B &amp; Ld.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_42-1.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">189</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e.</hi> perhaps the difference between its value alive and dead.</seg></note>
