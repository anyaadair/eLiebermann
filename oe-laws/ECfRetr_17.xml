      <div type="clause" n="17">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 17</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 17"><pb n="642" ed="#liebermann"/><ptr type="liebermannNote" n="27" target="#ECfRetr_17.lnote.la.27"/><hi rend="bold"><hi rend="spaced">Quid sit regis</hi></hi><ptr type="liebermannNote" n="28" target="#ECfRetr_17.lnote.la.28"/> <hi rend="bold"><hi rend="spaced">officium. (Et de Karolo et Pipino, fratre</hi></hi><ptr type="liebermannNote" n="h" target="#ECfRetr_17.lnote.la.fn.h"/> <hi rend="bold"><hi rend="spaced">eius, exemplum.</hi></hi><ptr type="liebermannNote" n="29" target="#ECfRetr_17.lnote.la.29"/><hi rend="bold">)</hi> Rex autem qui<ptr type="liebermannNote" n="30" target="#ECfRetr_17.lnote.la.30"/> uicarius summi<ptr type="liebermannNote" n="31" target="#ECfRetr_17.lnote.la.31"/> Regis est, ad hoc est<ptr type="liebermannNote" n="32" target="#ECfRetr_17.lnote.la.32"/> constitutus, ut regnum <hi rend="bold">terrenum</hi> et populum Domini<ptr type="liebermannNote" n="33" target="#ECfRetr_17.lnote.la.33"/> et super omnia sanctam <hi rend="bold">ueneretur</hi><ptr type="liebermannNote" n="34" target="#ECfRetr_17.lnote.la.34"/> <hi rend="bold">eius</hi><ptr type="liebermannNote" n="35" target="#ECfRetr_17.lnote.la.35"/> ecclesiam et<ptr type="liebermannNote" n="36" target="#ECfRetr_17.lnote.la.36"/> regat et ab iniuriosis<ptr type="liebermannNote" n="37" target="#ECfRetr_17.lnote.la.37"/> defendat <hi rend="bold">et</hi> maleficos <hi rend="bold">(ab</hi><ptr type="liebermannNote" n="38" target="#ECfRetr_17.lnote.la.38"/> <hi rend="bold">ea)</hi> euellat <hi rend="bold">et</hi> destruat <hi rend="bold">et penitus disperdat.</hi></ab>
        <note type="comparison" source="#liebermann" n="642"><label>printed alongside</label> <ref target="clause:ECf_17">ECf 17</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 642 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">Fehler des Rubricators</seg><seg type="translation" xml:lang="en" source="#claude">the rubricator’s error</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">Quod sit of. r. <hi rend="italic">Lond</hi> (<hi rend="italic">schon</hi> 11, 1 A); De multiplici potestate regia <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">Quod sit of. r. Lond (already at 11, 1 A); De multiplici potestate regia S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">o. r. <hi rend="italic">Cb;</hi> Et — exempl. <hi rend="italic">fehlt Cb Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">o. r. Cb; Et — exempl. lacking in Cb Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">exempliter <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">exempliter Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">quia <hi rend="italic">Cb K Co L;</hi> atque <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">quia Cb K Co L; atque Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">s. R. e. <hi rend="italic">fehlt Hv, wo</hi> eius</seg><seg type="translation" xml:lang="en" source="#claude">s. R. e. lacking in Hv, where eius</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">c. est <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. est Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">Dei <hi rend="italic">Cb Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Dei Cb Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">e. u. <hi rend="italic">K Co;</hi> eccl. uen. et ab <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. u. K Co; eccl. uen. et ab Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Hv;</hi> ec. eius <hi rend="italic">Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Hv; ec. eius Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ph;</hi> et r. <hi rend="italic">lässt Hv fort</hi> [<hi rend="italic">verkirchlichend</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ph; Hv leaves out et r. [making it churchly]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">iniuriatoribus <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">iniuriatoribus Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">ab ea <hi rend="italic">übergeschr. Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">ab ea written above Cb</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">What the king's office is. (And an example of Charles and Pippin, his brother.) But the king, who is the vicar of the highest King, is appointed for this, that he should venerate the earthly kingdom and the people of the Lord and, above all, his holy Church, and rule them and defend them from wrongdoers, and root out evildoers (from it) and destroy and utterly ruin them.</ab>
      </div>
    </body>
  </text>
