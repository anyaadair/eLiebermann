    <body>
      <div type="clause" n="52">
        <head><ref type="lawCode" target="law:Af">Af</ref> 52</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="52" corresp="#wit-e"><pb n="80" ed="#liebermann"/>Gif monnes tunge bið of heafde<ptr type="liebermannNote" n="30" target="#Af_52.lnote.oe.30"/> oþres monnes dædum dón<ptr type="liebermannNote" n="31" target="#Af_52.lnote.oe.31"/>, þæt biþ gelic ⁊ eagan<ptr type="liebermannNote" n="32" target="#Af_52.lnote.oe.32"/> bot.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="52" corresp="#wit-h"><pb n="80" ed="#liebermann"/>Gif monnes<ptr type="liebermannNote" n="4" target="#Af_52.lnote.oe.4"/> tunge biþ of heafde oðres monnes<ptr type="liebermannNote" n="4" target="#Af_52.lnote.oe.4"/> dedum (ge)dón<ptr type="liebermannNote" n="8" target="#Af_52.lnote.oe.8"/>, ðæt bið gelic eagan bot.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="52" corresp="#wit-b-no-prol"><pb n="80" ed="#liebermann"/>Gyf mannes tunge bið of heafde oðres monnes dædum g<hi rend="italic">e</hi>don, þ<hi rend="italic">æt</hi> bið gelic<ptr type="liebermannNote" n="6" target="#Af_52.lnote.oe.6"/> ⁊ eagon bot.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="52" corresp="#wit-q"><pb n="81" ed="#liebermann"/>Si linguam extrahat, sicut de oculo componat.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="86" ed="#attenborough"/>Gif monnes tunge bið of heafde oþres monnes dædum dón<ptr type="editorNote" n="20" target="#Af_52.attnote.fn.20"/>, þæt biþ gelic ⁊ eagan bot.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="56" corresp="#wit-e"><pb n="354" ed="#jurasinski-and-oliver"/>Gif monnes tunge bið of heafde oþres monnes dædum dón, þæt biþ gelic ⁊ eagan bot.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="81" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_52.lnote.de.1"/> jemandes Zunge durch eines anderen Missethat<ptr type="liebermannNote" n="2" target="#Af_52.lnote.de.2"/> aus dem Kopfe gerissen<ptr type="liebermannNote" n="3" target="#Af_52.lnote.de.3"/> ist: das und<ptr type="liebermannNote" n="4" target="#Af_52.lnote.de.4"/> Augenbusse<ptr type="liebermannNote" n="5" target="#Af_52.lnote.de.5"/> steht gleich.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a person’s tongue is torn from the head through another’s misdeed: that is equal to the compensation for an eye.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="87" ed="#attenborough"/>If, as the result of another's actions, a man's tongue is torn from his mouth<ptr type="editorNote" n="1" target="#Af_52.attnote.n.1"/>, the compensation [to be paid] shall be the same as that for an eye<ptr type="editorNote" n="2" target="#Af_52.attnote.n.2"/>.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="355" ed="#jurasinski-and-oliver"/>If someone’s tongue is struck from the head by another man’s deed, the compensation is equal to that for an eye.</ab>
        <note type="comparedBy" source="#wormald-mel" n="272"><label>cross-reference</label> <ref target="clause:Af_32">Af 32</ref> <quote>32 (ref. 52)</quote></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="325"><label>cf.</label> <ref target="clause:Af_32">Af 32</ref> <quote>The tongue would be redeemed at 1/3 of the value of the wergild; c.f. §56.</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_52.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">mid</hi> <hi rend="italic">fügt zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">mid</hi> added by Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_52.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">gedon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gedon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_52.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">eagum bót <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">eagum bót Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_52.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_52.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">ge <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">ge written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_52.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt Rasur von etwa</hi> 10 <hi rend="italic">Buchst.</hi></seg><seg type="translation" xml:lang="en" source="#claude">followed by an erasure of about 10 letters</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_52.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Zunge</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Zunge</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_52.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘Taten’, Plural, Or.</seg><seg type="translation" xml:lang="en" source="#claude">‘deeds’, plural, Or.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_52.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">H B modernisieren</seg><seg type="translation" xml:lang="en" source="#claude">H B modernize</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_52.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Über die Konstruktion Wülfing <hi rend="italic">Syntax</hi> I 63</seg><seg type="translation" xml:lang="en" source="#claude">On the construction, Wülfing <hi rend="italic">Syntax</hi> I 63</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_52.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Gliederbusse 5</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Gliederbusse 5</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_52.attnote.fn.20" n="20" source="#attenborough"><bibl><biblScope unit="page">86</biblScope></bibl><label>dón</label><seg type="original" xml:lang="en"><hi rend="italic">(ge)don</hi>. B &amp; H*.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_52.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">199</biblScope></bibl><seg type="original" xml:lang="en">Lit. ‘head.’</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_52.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">199</biblScope></bibl><seg type="original" xml:lang="en">Cf. cap. 47.</seg></note>
