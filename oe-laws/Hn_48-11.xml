      <div type="clause" n="48.11">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 48.11</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 48.11" corresp="#wit-lat"><pb n="572" ed="#liebermann"/>De primo feudo<ptr type="liebermannNote" n="1" target="#Hn_48-11.lnote.oe.1"/> habeantur quicunque liberi<ptr type="liebermannNote" n="2" target="#Hn_48-11.lnote.oe.2"/>, si non possint<ptr type="liebermannNote" n="3" target="#Hn_48-11.lnote.oe.3"/>, alii.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 572 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-11.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">feodo <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">feodo Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-11.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">quinque libre <hi rend="italic">K Co Or Wh Wi, obwohl Gi richtig</hi></seg><seg type="translation" xml:lang="en" source="#claude">quinque libre K Co Or Wh Wi, although Gi has it right</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-11.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">-sunt <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sunt K Co</seg></note>
      </div>
