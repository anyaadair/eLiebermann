      <div type="clause" n="5.29b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.29b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.29b" corresp="#wit-lat"><pb n="551" ed="#liebermann"/>Sed sine dubitatione malum minus est per deum<ptr type="liebermannNote" n="r" target="#Hn_5-29b.lnote.oe.r"/> falsum iurare ueraciter quam per Deum uerum iurare fallaciter; quanto enim<ptr type="liebermannNote" n="35" target="#Hn_5-29b.lnote.oe.35"/> id per quod iuratur magis est<ptr type="liebermannNote" n="36" target="#Hn_5-29b.lnote.oe.36"/> sanctum, tanto magis est penale periurium<ptr type="liebermannNote" n="37" target="#Hn_5-29b.lnote.oe.37"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 551 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-29b.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch Ivo</hi> Decr. XII 35; <hi rend="italic">Gr.</hi> C. 22 q. 1 c. 16</seg><seg type="translation" xml:lang="en" source="#claude">also Ivo Decr. XII 35; Gr. C. 22 q. 1 c. 16</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-29b.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Sigle</hi> ·H· <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">siglum ·H· Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-29b.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">s. est <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. est Lond</seg></note>
