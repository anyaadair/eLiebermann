          <sense n="3"><hi rend="italic">abdingen, Ermässigung erhandeln:</hi> on ceapgilde <hi rend="italic">am</hi> (<hi rend="italic"><ref type="abbreviation" target="gram:vom"><abbr>vom</abbr></ref></hi>) <hi rend="italic"><ref type="abbreviation" target="gram:Ersatz"><abbr>Ersatz</abbr></ref></hi> <ref type="lawCode" target="law:IIAs">II As</ref> 21</sense>
