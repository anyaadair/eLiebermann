    <body>
      <div type="clause" n="13">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 13</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 13"><pb n="640" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_13.lnote.oe.erkl-clause"/>Diuisiones<ptr type="liebermannNote" n="b" target="#ECf_13.lnote.la.fn.b"/><ptr type="liebermannNote" n="5" target="#ECf_13.lnote.la.5"/> scirarum<ptr type="liebermannNote" n="6" target="#ECf_13.lnote.la.6"/> regis<ptr type="liebermannNote" n="7" target="#ECf_13.lnote.la.7"/> proprie<ptr type="liebermannNote" n="8" target="#ECf_13.lnote.la.8"/> cum<ptr type="liebermannNote" n="c" target="#ECf_13.lnote.la.fn.c"/> iudicio IIII chiminorum regalium<ptr type="liebermannNote" n="9" target="#ECf_13.lnote.la.9"/> sunt.</ab>
        <note type="comparison" source="#liebermann" n="640"><label>printed alongside</label> <ref target="clause:ECfRetr_13">ECf retr 13</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 640 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">Gerichte; <hi rend="italic">vgl.</hi> Leis Wl 4; Hn 9, 4. 57, 1; 8</seg><seg type="translation" xml:lang="en" source="#claude">courts; cf. Leis Wl 4; Hn 9, 4. 57, 1; 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">gleicher Weise mit Reichsstrassen-Busse</hi> umfriedet</seg><seg type="translation" xml:lang="en" source="#claude">protected in the same way, with the fine for the highways of the realm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">autem <hi rend="italic">fügt zu Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad Do add autem</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">syr. <hi rend="italic">Rl Hk;</hi> shir. <hi rend="italic">Ad Wo</hi></seg><seg type="translation" xml:lang="en" source="#claude">syr. Rl Hk; shir. Ad Wo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">regni <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">regni Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">s. reg. <hi rend="italic">Hk; fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. reg. Hk; lacking in Ad Do</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">The boundaries of the shires are the king's own, under the judgment of the four royal highways.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">345</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl.</hi> Grafschaftsgericht 9a; Handfrieden 5.</seg><seg type="translation" xml:lang="en" source="#claude">Cf. Grafschaftsgericht 9a; Handfrieden 5.</seg></note>
      </div>
