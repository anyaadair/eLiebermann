      <div type="clause" n="18.3a">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 18.3a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 18.3a"><pb n="644" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_18-3a.lnote.oe.erkl-clause"/>Et si aliquis<ptr type="liebermannNote" n="22" target="#ECf_18-3a.lnote.la.22"/> scienter<ptr type="liebermannNote" n="23" target="#ECf_18-3a.lnote.la.23"/> eos detinuerit pro<ptr type="liebermannNote" n="24" target="#ECf_18-3a.lnote.la.24"/> una nocte, maiori<ptr type="liebermannNote" n="h" target="#ECf_18-3a.lnote.la.fn.h"/> lege Anglorum uel<ptr type="liebermannNote" n="25" target="#ECf_18-3a.lnote.la.25"/> Danorum emendabit, pro secunda duplici<ptr type="liebermannNote" n="26" target="#ECf_18-3a.lnote.la.26"/>; pro tertia<ptr type="liebermannNote" n="i" target="#ECf_18-3a.lnote.la.fn.i"/> nocte<ptr type="liebermannNote" n="27" target="#ECf_18-3a.lnote.la.27"/> socius est<ptr type="liebermannNote" n="28" target="#ECf_18-3a.lnote.la.28"/> et compar malefactorum.</ab>
        <note type="comparison" source="#liebermann" n="644"><label>printed alongside</label> <ref target="clause:ECfRetr_18-3a">ECf retr 18.3a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 644 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-3a.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">grosses Strafgeld; <hi rend="italic">vgl.</hi> 12, 1<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">the great fine; cf. 12, 1, note b</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-3a.lnote.la.fn.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 23, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. 23, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-3a.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">quis <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">quis Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-3a.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">e. s. <hi rend="italic">Hk Hr Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. s. Hk Hr Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-3a.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">per unam noctem <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">per unam noctem Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-3a.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">et don. <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">et don. Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-3a.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">dupplicius <hi rend="italic">Rl Ad Do;</hi> lege <hi rend="italic">fügt zu Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">dupplicius Rl Ad Do; Hr adds lege</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-3a.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-3a.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">Hk Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius Hk Do</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And if anyone knowingly keeps them for one night, he shall pay compensation by the greater law of the English or of the Danes, for a second, double; for the third night he is an associate and peer of the evildoers.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-3a.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">346</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> drei Tage 6; Begünstigung 13. 14c; Strafgeldfixum 31; Fremde 12—h. — <hi rend="italic">duppl.</hi><hi rend="superscript">30</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">Cf. Gl drei Tage 6; Begünstigung 13. 14c; Strafgeldfixum 31; Fremde 12—h. — <hi rend="italic">duppl.</hi><hi rend="superscript">30</hi> Rs</seg></note>
      </div>
    </body>
