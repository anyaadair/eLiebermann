      <div type="clause" n="83.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 83.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 83.1a" corresp="#wit-lat"><pb n="599" ed="#liebermann"/>Si quis<ptr type="liebermannNote" n="n" target="#Hn_83-1a.lnote.oe.n"/>, iuxta quod<ptr type="liebermannNote" n="o" target="#Hn_83-1a.lnote.oe.o"/> prediximus, in hostem suum incidat, uel uagipalantem<ptr type="liebermannNote" n="p" target="#Hn_83-1a.lnote.oe.p"/><ptr type="liebermannNote" n="39" target="#Hn_83-1a.lnote.oe.39"/> uel alium qui iuste requisitus<ptr type="liebermannNote" n="q" target="#Hn_83-1a.lnote.oe.q"/> rectum per omnia denegauerit, . . .<ptr type="liebermannNote" n="r" target="#Hn_83-1a.lnote.oe.r"/></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 599 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-1a.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Kläger, dem nach vergeblichen Vorladungen Selbsthilfe</hi> (<hi rend="italic">vgl.</hi> 83, 6) <hi rend="italic">zusteht</hi></seg><seg type="translation" xml:lang="en" source="#claude">the plaintiff, who after fruitless summonses is entitled to self-help (cf. 83, 6)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-1a.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 82, 2<hi rend="italic">a</hi>; <hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 82, 2<hi rend="italic">a</hi>; <hi rend="italic">b</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-1a.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">falsche Neubildung aus</hi> uagi, palantes <hi rend="italic">des Sallust</hi> Jug. 21</seg><seg type="translation" xml:lang="en" source="#claude">false new formation from uagi, palantes in Sallust Jug. 21</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-1a.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 82, 1</seg><seg type="translation" xml:lang="en" source="#claude">as 82, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-1a.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> licet eum impugnare (<hi rend="italic">aus Quadr.</hi>) <hi rend="italic">oder ähnliches</hi></seg><seg type="translation" xml:lang="en" source="#claude">supply licet eum impugnare (from Quadr.) or something similar</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-1a.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">-te <hi rend="italic">Sc Hg</hi>; uagi palentem <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">-te Sc Hg; uagi palentem K Co Or Gi</seg></note>
      </div>
