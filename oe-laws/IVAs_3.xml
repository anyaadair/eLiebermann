      <div type="clause" n="3">
        <head><ref type="lawCode" target="law:IVAs">IV As</ref> 3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3" corresp="#wit-q"><pb n="171" ed="#liebermann"/>Et<ptr type="liebermannNote" n="a" target="#IVAs_3.lnote.oe.a"/> si quis adeo diues<ptr type="liebermannNote" n="10" target="#IVAs_3.lnote.oe.10"/> sit uel tante cognationis<ptr type="liebermannNote" n="11" target="#IVAs_3.lnote.oe.11"/>, ut á furto uel defensione<ptr type="liebermannNote" n="12" target="#IVAs_3.lnote.oe.12"/> latronum uel firmatione reuocari non possit, educatur de patria ista<ptr type="liebermannNote" n="13" target="#IVAs_3.lnote.oe.13"/><ptr type="liebermannNote" n="b" target="#IVAs_3.lnote.oe.b"/> cum uxore et pueris et omnibus rebus suis ad<ptr type="liebermannNote" n="14" target="#IVAs_3.lnote.oe.14"/> eam partem regni<ptr type="liebermannNote" n="15" target="#IVAs_3.lnote.oe.15"/> huius, quam rex uelit<ptr type="liebermannNote" n="16" target="#IVAs_3.lnote.oe.16"/> (uoluerit), sit quicumque sit sic<ptr type="liebermannNote" n="17" target="#IVAs_3.lnote.oe.17"/> comitum sic<ptr type="liebermannNote" n="18" target="#IVAs_3.lnote.oe.18"/> uillanorum, eo tenore quo numquam in patriam redeat<ptr type="liebermannNote" n="16" target="#IVAs_3.lnote.oe.16"/> (reuertatur). Et (deinceps<ptr type="liebermannNote" n="19" target="#IVAs_3.lnote.oe.19"/><ptr type="liebermannNote" n="c" target="#IVAs_3.lnote.oe.c"/>) si<ptr type="liebermannNote" n="20" target="#IVAs_3.lnote.oe.20"/> unquam<ptr type="liebermannNote" n="21" target="#IVAs_3.lnote.oe.21"/> in<ptr type="liebermannNote" n="22" target="#IVAs_3.lnote.oe.22"/> patria<ptr type="liebermannNote" n="b" target="#IVAs_3.lnote.oe.b"/> ista obuiet<ptr type="liebermannNote" n="d" target="#IVAs_3.lnote.oe.d"/> alicui<ptr type="liebermannNote" n="23" target="#IVAs_3.lnote.oe.23"/>, sit tamquam inter<ptr type="liebermannNote" n="24" target="#IVAs_3.lnote.oe.24"/> manus habens fur inuentus.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="3" corresp="#wit-q"><pb n="146" ed="#attenborough"/>[De divitibus vel generosis a furto vel latronum firmatione non desistentibus.] Et si quis adeo dives sit vel tantæ cognationis, ut a furto vel defensione latronum vel firmatione revocari non possit, educatur de patria ista<ptr type="editorNote" n="9" target="#IVAs_3.attnote.fn.9"/> cum uxore et pueris et omnibus rebus suis ad eam partem regni huius, quam rex velit<ptr type="editorNote" n="10" target="#IVAs_3.attnote.fn.10"/>, sit quicumque sit, sic<ptr type="editorNote" n="11" target="#IVAs_3.attnote.fn.11"/> comitum, sic<ptr type="editorNote" n="11" target="#IVAs_3.attnote.fn.11"/> villanorum, eo tenore quo numquam in patriam redeat<ptr type="editorNote" n="12" target="#IVAs_3.attnote.fn.12"/>. Et si umquam<ptr type="editorNote" n="13" target="#IVAs_3.attnote.fn.13"/> in patria ista obviet alicui<ptr type="editorNote" n="14" target="#IVAs_3.attnote.fn.14"/>, sit tamquam in manus habens<ptr type="editorNote" n="15" target="#IVAs_3.attnote.fn.15"/> fur inventus.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="147" ed="#attenborough"/>And if anyone is so rich or belongs to so powerful a kindred<ptr type="editorNote" n="1" target="#IVAs_3.attnote.n.1"/>, that he cannot be restrained from crime or from protecting and harbouring criminals, he shall be led out of his native district with his wife and children, and all his goods<ptr type="editorNote" n="2" target="#IVAs_3.attnote.n.2"/>, to any part of the kingdom which the king chooses, be he noble or commoner, whoever he may be—with the provision that he shall never return to his native district. And henceforth, let him never be encountered<ptr type="editorNote" n="3" target="#IVAs_3.attnote.n.3"/> by anyone in that district; otherwise he shall be treated as a thief caught in the act<ptr type="editorNote" n="4" target="#IVAs_3.attnote.n.4"/>.</ab>
        <note type="comparison" source="#liebermann" n="171"><ref target="clause:IIIAs_6">III As 6</ref>; <ref target="clause:VAs_Prol-to-1">V As Pr. 1</ref>; <ref target="clause:VAs_Prol-to-2">V As Pr. 2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. III As. 6; V As. Pr. 1 | Vgl. V As. Pr. 2</note>
        <note type="comparison" source="#wormald-mel" n="296"><label>wording close to</label> <ref target="clause:IIIAs_6">III As 6</ref> <quote>But its wording was more like that used at Faversham. ... (III 6, 'adeo dives vel tante parentele'/IV 3 'adeo dives sit vel tante cognationis')</quote></note>
        <note type="comparison" source="#wormald-mel" n="296"><label>digest of</label> <ref target="clause:VAs_Prol-to-3">V As Prol.3</ref> <quote>'IV' gave a digest of what Exeter proposed for those who defied the Grately decrees</quote></note>
        <note type="editorial">Latin only; no German translation in Liebermann. Liebermann compares III As 6; V As Prol. 1–2.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">sit d. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit d. T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">sit <hi rend="italic">fügt zu Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit added by Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">l. fi. u. de. <hi rend="italic">RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">l. fi. u. de. RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">et K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">h. r. <hi rend="italic">RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. r. RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond; (eingeklammertes) übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket Lond; (bracketed words) the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Or;</hi> sit <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Or; sit T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">sit <hi rend="italic">Or T</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit Or T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt RMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in RMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">numq. <hi rend="italic">LondMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">numq. LondMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">ob. al. in p. ista <hi rend="italic">RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">ob. al. in p. ista RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">obuiet <hi rend="italic">fügt zu, aber unterpunctirt R;</hi> sed <hi rend="italic">fügt zu MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">obuiet added by R, but marked for deletion with dots beneath; sed added by MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">Lond;</hi> fur inter m. h. <hi rend="italic">RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">in Lond; fur inter m. h. RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">113</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Erste Zeile steht näher zu III, folgende zu V As. — <hi rend="italic">Vgl. Gl</hi> Begünstigung 12</seg><seg type="translation" xml:lang="en" source="#claude">The first line stands closer to III, the following ones to V As. — <hi rend="italic">Cf. Gl</hi> Begünstigung 12</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">113</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘England’, sondern aus <hi rend="italic">eard</hi>, laut V Pro 1: ‘Heimatsbezirk’</seg><seg type="translation" xml:lang="en" source="#claude">Not ‘England’, but from <hi rend="italic">eard</hi>, according to V Pro 1: ‘home district’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">113</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">aus <hi rend="italic">æfre eft;</hi> V Pro 2</seg><seg type="translation" xml:lang="en" source="#claude">from <hi rend="italic">æfre eft;</hi> V Pro 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_3.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">113</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">man</hi> lässt Q aus, so dass falsch der Verbrecher Subjekt wird</seg><seg type="translation" xml:lang="en" source="#claude">Q omits <hi rend="italic">man</hi>, so that the criminal wrongly becomes the subject</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAs_3.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">210</biblScope></bibl><seg type="original" xml:lang="en">Cf. III As. cap. 6.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAs_3.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">210</biblScope></bibl><seg type="original" xml:lang="en">Cf. V As. Pr. § 1.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAs_3.attnote.n.3" n="3" source="#attenborough"><bibl><biblScope unit="page">210</biblScope></bibl><seg type="original" xml:lang="en">According to Liebermann the Latin is not quite a correct translation; the original Anglo-Saxon was presumably a sentence beginning with <hi rend="italic">man</hi>.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAs_3.attnote.n.4" n="4" source="#attenborough"><bibl><biblScope unit="page">210</biblScope></bibl><seg type="original" xml:lang="en">Cf. V As. Pr. § 2; Wiht. cap. 25, 26; Ine, cap. 12, 16, etc.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_3.attnote.fn.9" n="9" source="#attenborough"><bibl><biblScope unit="page">146</biblScope></bibl><label>ista</label><seg type="original" xml:lang="en">om. <hi rend="italic">de patria ista</hi>. M, Hk, Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_3.attnote.fn.10" n="10" source="#attenborough"><bibl><biblScope unit="page">146</biblScope></bibl><label>velit</label><seg type="original" xml:lang="en"><hi rend="italic">voluerit</hi>.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_3.attnote.fn.11" n="11" source="#attenborough"><bibl><biblScope unit="page">146</biblScope></bibl><label>sic</label><seg type="original" xml:lang="en"><hi rend="italic">sit</hi>.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_3.attnote.fn.12" n="12" source="#attenborough"><bibl><biblScope unit="page">146</biblScope></bibl><label>redeat</label><seg type="original" xml:lang="en"><hi rend="italic">revertatur</hi>.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_3.attnote.fn.13" n="13" source="#attenborough"><bibl><biblScope unit="page">146</biblScope></bibl><label>umquam</label><seg type="original" xml:lang="en"><hi rend="italic">numquam</hi>. Lond.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_3.attnote.fn.14" n="14" source="#attenborough"><bibl><biblScope unit="page">146</biblScope></bibl><label>alicui</label><seg type="original" xml:lang="en"><hi rend="italic">Et deinceps numquam obviet alicui in patria ista</hi>.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_3.attnote.fn.15" n="15" source="#attenborough"><bibl><biblScope unit="page">146</biblScope></bibl><label>habens</label><seg type="original" xml:lang="en"><hi rend="italic">fur inter manus habens</hi>. R, T, M, Hk.</seg></note>
      </div>
