      <div type="clause" n="54.2">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 54.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="54.2" corresp="#wit-e"><pb n="114" ed="#liebermann"/>Witeðeowne monnan Wyliscne mon<ptr type="liebermannNote" n="11" target="#Ine_54-2.lnote.oe.11"/> sceal<ptr type="liebermannNote" n="12" target="#Ine_54-2.lnote.oe.12"/> bedrifan be XII<ptr type="liebermannNote" n="13" target="#Ine_54-2.lnote.oe.13"/> hidu<hi rend="italic">m<ptr type="liebermannNote" n="14" target="#Ine_54-2.lnote.oe.14"/></hi> swa ðeowne to swingum, Engliscne be feower ⁊ XXX<ptr type="liebermannNote" n="15" target="#Ine_54-2.lnote.oe.15"/><ptr type="liebermannNote" n="*" target="#Ine_54-2.lnote.oe.star"/> hida.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="54.2" corresp="#wit-h"><pb n="114" ed="#liebermann"/>Witeðeowne mon<ptr type="liebermannNote" n="8" target="#Ine_54-2.lnote.oe.8-2"/> Wiliscne mon<ptr type="liebermannNote" n="9" target="#Ine_54-2.lnote.oe.9-2"/> sceal bedrifan be XII hidum swa ðeowne to swingum<ptr type="liebermannNote" n="10" target="#Ine_54-2.lnote.oe.10"/>, Engliscne be XXXIIII hida.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="54.2" corresp="#wit-b-no-prol"><pb n="114" ed="#liebermann"/>Witeðeowne monnan Wyliscne man sceal bedrifan be twelf hyndum swa ðeowne to swincu<hi rend="italic">m<ptr type="liebermannNote" n="1" target="#Ine_54-2.lnote.oe.1"/></hi>, Engliscne be feowær<ptr type="liebermannNote" n="2" target="#Ine_54-2.lnote.oe.2"/> ⁊ ðrittig hida.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="54.2" corresp="#wit-q"><pb n="115" ed="#liebermann"/>Wita-(id<ptr type="liebermannNote" n="5" target="#Ine_54-2.lnote.oe.5"/> est forisfactura)-seruus<ptr type="liebermannNote" n="6" target="#Ine_54-2.lnote.oe.6"/> homo Waliscus debet superiurari<ptr type="liebermannNote" n="7" target="#Ine_54-2.lnote.oe.7"/> per duodecim hidas sic[ut<ptr type="liebermannNote" n="8" target="#Ine_54-2.lnote.oe.8"/>] seruus ad uerbera, Anglicus homo per triginta<ptr type="liebermannNote" n="9" target="#Ine_54-2.lnote.oe.9"/> quatuor hidas.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="54" ed="#attenborough"/>Witeðeowne monnan<ptr type="editorNote" n="14" target="#Ine_54-2.attnote.fn.14"/> Wyliscne mon sceal bedrifan be XII hidum<ptr type="editorNote" n="15" target="#Ine_54-2.attnote.fn.15"/> swa ðeowne to swingum<ptr type="editorNote" n="16" target="#Ine_54-2.attnote.fn.16"/>, Engliscne be feower ⁊ XXX hida.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="58" corresp="#wit-e"><pb n="418" ed="#jurasinski-and-oliver"/>Witeðeowne monnan wyliscne mon sceal bedrifan be XII hidu<hi rend="italic">m</hi> swa ðeowne to swingum, Engliscne be feower ⁊ XXX hida.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="115" ed="#liebermann"/>Einen strafhörigen Wälschen<ptr type="liebermannNote" n="1" target="#Ine_54-2.lnote.de.1"/> Mann soll [kann] man wie einen Sklaven<ptr type="liebermannNote" n="2" target="#Ine_54-2.lnote.de.2"/> durch [Eid von] 12 Hiden<ptr type="liebermannNote" n="3" target="#Ine_54-2.lnote.de.3"/> zur [Erleidung der] Prügelstrafe treiben<ptr type="liebermannNote" n="4" target="#Ine_54-2.lnote.de.4"/>, einen Englischen durch 34<ptr type="liebermannNote" n="5" target="#Ine_54-2.lnote.de.5"/> Hiden.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">A Welshman who is a penalty-slave may be driven to [suffer] the flogging like a slave by [an oath of] 12 hides; an Englishman by 34 hides.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="55" ed="#attenborough"/>A Welshman, who has been reduced to penal slavery, shall be compelled to submit to a scourging, as a slave, by [an oath of] 12 hides; an Englishman, by [an oath of] 34<ptr type="editorNote" n="1" target="#Ine_54-2.attnote.n.1"/> hides.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="406" ed="#whitelock"/>A penally enslaved Welshman shall be compelled to [suffer] a flogging as a slave by [an oath of] 12 hides, an Englishman by [an oath of] 34 hides.<ptr type="editorNote" n="4" target="#Ine_54-2.whinote.n.4"/></ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="419" ed="#jurasinski-and-oliver"/>A Welshman in the position of penal slave shall be forced to be lashed like a slave [by an oath of] twelve hides; an Englishman by [an oath of] thirty-four hides.1</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_54-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. verbessert</hi> swingum</seg><seg type="translation" xml:lang="en" source="#claude">corrected to swingum in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_54-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. geändert aus</hi> seo wær</seg><seg type="translation" xml:lang="en" source="#claude">altered from seo wær in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_54-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">115</biblScope></bibl><seg type="original" xml:lang="de">i. e. f. <hi rend="italic">aus Lond; fehlt übrigen</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. e. f. from Lond; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_54-2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">115</biblScope></bibl><seg type="original" xml:lang="de">seruum Waliscum hominem oportet [<hi rend="italic">fehlt Infinitiv</hi>] sic seruum ad uerbera, Anglicum <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">seruum Waliscum hominem oportet [infinitive missing] sic seruum ad uerbera, Anglicum Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_54-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">115</biblScope></bibl><seg type="original" xml:lang="de">-re <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-re MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_54-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">115</biblScope></bibl><seg type="original" xml:lang="de">sic <hi rend="italic">Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_54-2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">115</biblScope></bibl><seg type="original" xml:lang="de">XX [<hi rend="italic">richtig</hi>] <hi rend="italic">Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">XX [correct] Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_54-2.lnote.oe.8-2" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> man; <hi rend="italic">dahinter Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">altered to man; erasure after it</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_54-2.lnote.oe.9-2" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_54-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rasur hinter</hi> n</seg><seg type="translation" xml:lang="en" source="#claude">erasure after n</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_54-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">man <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">man Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_54-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">sceall <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">sceall So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_54-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">twelf <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">twelf Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_54-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">hyd. <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hyd. So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_54-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">þrittig hyda <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þrittig hyda Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_54-2.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">114</biblScope></bibl><seg type="original" xml:lang="de">XXIIII <hi rend="italic">vielleicht zu bessern.</hi></seg><seg type="translation" xml:lang="en" source="#claude">perhaps emend to XXIIII.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_54-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">78</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">H modernisiert. — <hi rend="italic">Vgl. Gl</hi> Walliser 6. a</seg><seg type="translation" xml:lang="en" source="#claude">H modernises. — <hi rend="italic">Cf. Gl</hi> Walliser 6. a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_54-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">78</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Geborenen Unfreien; <hi rend="italic">s. d. Gl</hi> 2 c. 19</seg><seg type="translation" xml:lang="en" source="#claude">Those born unfree; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 2 c. 19</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_54-2.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">78</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Also mehr als der Eid nur Eines, obwohl abendmahlfähigen, Gemeinfreien; <hi rend="italic">s.</hi> Eideshufen 9. — B, verschlechternd zu <hi rend="italic">hyndum,</hi> meint vielleicht den Eid eines 1200-Schilling-Mannes = 6 Gemeinfreier; B versteht jedenfalls die Eideshufen nicht mehr</seg><seg type="translation" xml:lang="en" source="#claude">Thus more than the oath of a single common freeman, even one admitted to communion; <hi rend="italic">see</hi> Eideshufen 9. — B, corrupting the text to <hi rend="italic">hyndum,</hi> perhaps means the oath of a 1200-shilling man = 6 common freemen; at any rate B no longer understands the oath-hides</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_54-2.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">78</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">superiurare s. Wb:</hi> ‘durch Schwur aufbürden, unterwerfen’</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">superiurare see Wb:</hi> ‘to impose by oath, to subject’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_54-2.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">78</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘24’ bessert schon eine Hs. Q in spät. Rez. und so Neuere nach Analogie; <hi rend="italic">s. Gl</hi> Prügel 4 c. 6</seg><seg type="translation" xml:lang="en" source="#claude">‘24’ is already the emendation of one MS of Q in the later recension, and so of modern editors, by analogy; <hi rend="italic">see Gl</hi> Prügel 4 c. 6</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_54-2.attnote.fn.14" n="14" source="#attenborough"><bibl><biblScope unit="page">54</biblScope></bibl><label>monnan</label><seg type="original" xml:lang="en"><hi rend="italic">man</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_54-2.attnote.fn.15" n="15" source="#attenborough"><bibl><biblScope unit="page">54</biblScope></bibl><label>hidum</label><seg type="original" xml:lang="en"><hi rend="italic">hyndum</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_54-2.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">54</biblScope></bibl><label>swingum</label><seg type="original" xml:lang="en"><hi rend="italic">swincum</hi>. B.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_54-2.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">191</biblScope></bibl><seg type="original" xml:lang="en">The figure is curious. One MS of Quadr. has <hi rend="italic">xx quatuor.</hi> The meaning is ‘shall not be compelled...by less than.’</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Ine_54-2.whinote.n.4" n="4" source="#whitelock"><bibl><biblScope unit="page">406</biblScope></bibl><label>hides</label><seg type="original" xml:lang="en">The original reading may have been 24, double the oath for a Welshman.</seg></note>
      </div>
