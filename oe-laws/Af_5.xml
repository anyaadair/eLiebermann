        <note type="liebermannNote" subtype="textual" xml:id="Af_5.lnote.oe.29-2" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">51</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">nisi extra</hi> pr. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">nisi extra</hi> pr. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5.lnote.oe.30-2" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">51</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">51</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. von späterer Hand</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above by a later hand</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5.lnote.oe.7-2" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">51</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">über</hi> on <hi rend="italic">später</hi> ne</seg><seg type="translation" xml:lang="en" source="#claude">above on, later, ne</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. o.</hi> Af 2¹, <hi rend="italic">Gl</hi> Kirchenfrieden 2a</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. above</hi> Af 2¹, <hi rend="italic">Gl</hi> Kirchenfrieden 2a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘der Rache verfallen’ Schmid 571</seg><seg type="translation" xml:lang="en" source="#claude">‘subject to vengeance’ Schmid 571</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Q <hi rend="smallcaps">i</hi> und Ld verstanden den Unterschied von <hi rend="italic">ierne</hi> und <hi rend="italic">ærne</hi> nicht; einige Erklärer halten das 2. Wort für synonyme Glosse; in Ine 5 ist es wirklich Bu’s Variante zu <hi rend="italic">geierne.</hi> Allein <hi rend="italic">ærning</hi> übersetzt <hi rend="italic">equitando, equi cursus</hi> [Toller <hi rend="italic">Suppl.</hi>]: nach Sweet (<hi rend="italic">Anglos. reader</hi> 211) Causativ aus <hi rend="italic">irnan,</hi> und bed. ‘das Pferd galoppieren lassen’</seg><seg type="translation" xml:lang="en" source="#claude">Q <hi rend="smallcaps">i</hi> and Ld did not understand the difference between <hi rend="italic">ierne</hi> and <hi rend="italic">ærne</hi>; some commentators regard the 2nd word as a synonymous gloss; in Ine 5 it really is Bu’s variant for <hi rend="italic">geierne.</hi> But <hi rend="italic">ærning</hi> translates <hi rend="italic">equitando, equi cursus</hi> [Toller <hi rend="italic">Suppl.</hi>]: according to Sweet (<hi rend="italic">Anglos. reader</hi> 211) it is a causative from <hi rend="italic">irnan,</hi> and means ‘to make the horse gallop’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘oder anrühre’ Q, den Asylschutz verstärkend</seg><seg type="translation" xml:lang="en" source="#claude">‘or touch’ Q, strengthening the protection of sanctuary</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘von da’ statt ‘dennoch’ B. — ‘Königsschutz’ (<hi rend="italic">s. d. Gl</hi>) kostet 5 £</seg><seg type="translation" xml:lang="en" source="#claude">‘from there’ instead of ‘nevertheless’ B. — ‘King’s protection’ (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi>) costs 5 £</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5.lnote.de.6" n="6" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> II 145 Sp. 3 <hi rend="italic">micel; þæne man</hi> emendiert ohne Not oder Zweck Thorpe</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">see above</hi> II 145 col. 3 <hi rend="italic">micel; þæne man</hi> is Thorpe’s emendation, made without need or purpose</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5.lnote.de.7" n="7" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘mehr verbricht’ ungenau Q, Price; ‘verwundet oder tötet’ Rieger <hi rend="italic">Altsächs. Leseb.</hi> 160</seg><seg type="translation" xml:lang="en" source="#claude">‘commits more [crime]’ Q, Price, inaccurately; ‘wounds or kills’ Rieger <hi rend="italic">Altsächs. Leseb.</hi> 160</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5.lnote.de.8" n="8" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Asyl 9. Nährung würde Begünstigung (<hi rend="italic">s. d. Gl</hi> 1) des Verbrechers bedeuten; <hi rend="italic">u.</hi> 5, 2²</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Asyl 9. Feeding would mean abetting (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1) the criminal; <hi rend="italic">below</hi> 5, 2²</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5.lnote.de.9" n="9" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘fight his way out’ (Price) oder ‘ficht ausserhalb der Asylgrenze’ (Thorpe). Sondern beim Verteidigen der Tür mit blutigem Fechten begeht Flüchtling Asylbruch; <hi rend="italic">s. d. Gl</hi> 1. Er muss die Waffen dem Verfolger ab- und sich ergeben; 5, 3</seg><seg type="translation" xml:lang="en" source="#claude">Not ‘fight his way out’ (Price) or ‘fights outside the bounds of sanctuary’ (Thorpe). Rather, by fighting with bloodshed in defending the door the fugitive commits breach of sanctuary; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1. He must hand over his weapons to the pursuer and surrender himself; 5, 3</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_5.attnote.fn.4" n="4" source="#attenborough"><bibl><biblScope unit="page">66</biblScope></bibl><label>cirican</label><seg type="original" xml:lang="en"><hi rend="italic">æghwylcere ciricean</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_5.attnote.fn.5" n="5" source="#attenborough"><bibl><biblScope unit="page">66</biblScope></bibl><label>fáhmon</label><seg type="original" xml:lang="en"><hi rend="italic">Gif gefahmon</hi> (<hi rend="italic">ciricean</hi>) <hi rend="italic">geyrne</hi>. B*. <hi rend="italic">gif fagman hy geyrne</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_5.attnote.fn.6" n="6" source="#attenborough"><bibl><biblScope unit="page">66</biblScope></bibl><label>þonne</label><seg type="original" xml:lang="en"><hi rend="italic">ðonon</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_5.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">66</biblScope></bibl><label>mundbyrde</label><seg type="original" xml:lang="en"><hi rend="italic">mundbryces</hi>. So.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_5.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">194</biblScope></bibl><seg type="original" xml:lang="en">Liebermann and earlier editors take <hi rend="italic">ut</hi> and <hi rend="italic">feohte</hi> together as a compound verb, but as no such verb is recognised by Bosworth-Toller it would be safer perhaps to take <hi rend="italic">ut</hi> as an adverb—equivalent to <hi rend="italic">ute</hi>, in which sense it occurs, though rarely, elsewhere.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_5.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">194</biblScope></bibl><seg type="original" xml:lang="en">The words from <hi rend="italic">gif hit...ofgefo</hi> form a parenthesis which can hardly be rendered in modern English, without transposition of the sentences.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Af_5.whinote.n.3" n="3" source="#whitelock"><bibl><biblScope unit="page">411</biblScope></bibl><label>out</label><seg type="original" xml:lang="en">According to Liebermann, commits himself a breach of sanctuary by fighting in the doorway to defend himself.</seg></note>
      </div>
