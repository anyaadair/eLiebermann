      <div type="clause" n="37.2">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 37.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-i"><pb n="515" ed="#liebermann"/>E les choses qui<ptr type="liebermannNote" n="3" target="#LeisWl_37-2.lnote.oe.3"/> sunt remises<ptr type="liebermannNote" n="4" target="#LeisWl_37-2.lnote.oe.4"/> en la<ptr type="liebermannNote" n="5" target="#LeisWl_37-2.lnote.oe.5"/> nef, seient departis<ptr type="liebermannNote" n="6" target="#LeisWl_37-2.lnote.oe.6"/> en comune sulun les chatels.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="515" ed="#liebermann"/>Res autem que remanent ex equo inter omnes diuidentur secundum catalla singulorem.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="37.2" corresp="#wit-i"><pb n="270" ed="#robertson"/>E les choses qui sunt remises en la nef seient departis en comune sulun les chatels.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="515" ed="#liebermann"/>37, 2. Und die Sachen, die in dem Schiffe geblieben sind, seien gemeinsam vertheilt je nach (der einzelnen <hi rend="italic">L</hi>) [Antheil<ptr type="liebermannNote" n="1" target="#LeisWl_37-2.lnote.de.1"/> an den einstigen] Werthstücken.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">37, 2. And the goods which have remained in the ship shall be divided in common according to (the individuals' <hi rend="italic">L</hi>) [share in the former] articles of value.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-i"><pb n="271" ed="#robertson"/>And the things which remained in the ship shall be divided in common according to [the value of] the goods [originally belonging to each person].</ab>
        <note type="comparison" source="#liebermann" n="515">Dig. 14, 2</note>
        <note type="comparisonPrinted" source="#liebermann">Dig. 14, 2</note>
        <note type="editorial">Added October 2026 from Robertson pp. 270–271 (text and translation); Liebermann’s text and German translation added from Gesetze I p. 515, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_37-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">515</biblScope></bibl><seg type="original" xml:lang="de">que <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">que Im</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_37-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">515</biblScope></bibl><seg type="original" xml:lang="de">-se <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">-se Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_37-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">515</biblScope></bibl><seg type="original" xml:lang="de">le <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">le Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_37-2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">515</biblScope></bibl><seg type="original" xml:lang="de">depertiz <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">depertiz Im</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_37-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">291</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Detrimentum pro portione communicetur</hi> (Paulus) steht F (<hi rend="italic">comune</hi>) näher als L.—Nicht ‘according to the quality’ (Kelham)</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Detrimentum pro portione communicetur</hi> (Paulus) is closer to F (<hi rend="italic">comune</hi>) than to L.—Not ‘according to the quality’ (Kelham)</seg></note>
      </div>
