    <body>
      <div type="clause" n="38.2">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 38.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 38.2"><pb n="669" ed="#liebermann"/>Quodsi aliquis<ptr type="liebermannNote" n="1" target="#ECf_38-2.lnote.la.1"/> aliter emerit, quod stulte emit<ptr type="liebermannNote" n="2" target="#ECf_38-2.lnote.la.2"/> perdat<ptr type="liebermannNote" n="a" target="#ECf_38-2.lnote.la.fn.a"/><ptr type="liebermannNote" n="3" target="#ECf_38-2.lnote.la.3"/>; et forisfacturam<ptr type="liebermannNote" n="4" target="#ECf_38-2.lnote.la.4"/>! Et postea inquiret<ptr type="liebermannNote" n="5" target="#ECf_38-2.lnote.la.5"/> iusticia per<ptr type="liebermannNote" n="b" target="#ECf_38-2.lnote.la.fn.b"/> lagemannos<ptr type="liebermannNote" n="6" target="#ECf_38-2.lnote.la.6"/> et per<ptr type="liebermannNote" n="7" target="#ECf_38-2.lnote.la.7"/> meliores homines de burgo uel de<ptr type="liebermannNote" n="8" target="#ECf_38-2.lnote.la.8"/> hundredo uel uilla, ubi emptor<ptr type="liebermannNote" n="9" target="#ECf_38-2.lnote.la.9"/> ipse manserit, de quali uita ipse est<ptr type="liebermannNote" n="10" target="#ECf_38-2.lnote.la.10"/>, et si antea<ptr type="liebermannNote" n="7" target="#ECf_38-2.lnote.la.7"/> audierunt<ptr type="liebermannNote" n="11" target="#ECf_38-2.lnote.la.11"/> eum<ptr type="liebermannNote" n="7" target="#ECf_38-2.lnote.la.7"/> calumpniari<ptr type="liebermannNote" n="12" target="#ECf_38-2.lnote.la.12"/> de exlegalitate<ptr type="liebermannNote" n="c" target="#ECf_38-2.lnote.la.fn.c"/>.</ab>
        <note type="comparison" source="#liebermann" n="669"><label>printed alongside</label> <ref target="clause:ECfRetr_38-2">ECf retr 38.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 669 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “lagemannos” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-2.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">an den Kläger im Anefang; denn solcher Process, mit Voraussetzung, dass der Gegenstand nicht bloss in falscher Handelsform erworben, sondern von jemandem gestohlen war, konnte allein zum Reinigungseide und zur Friedloslegung des ausbleibenden Gewähren führen</hi></seg><seg type="translation" xml:lang="en" source="#claude">to the claimant in the vouching process (Anefang); for such a suit, presupposing that the object had not merely been acquired in an improper form of trade but had been stolen from someone, could only lead to an oath of purgation and to the outlawing of the warrantor who failed to appear</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-2.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier nur Leumundszeugen</hi></seg><seg type="translation" xml:lang="en" source="#claude">here only character witnesses</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-2.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">Gesetzwidrigkeit, <hi rend="italic">aus nordöstlichem Frankreich bezeugt von Ducange</hi></seg><seg type="translation" xml:lang="en" source="#claude">unlawfulness; attested from north-eastern France by Ducange</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-2.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">aliter aliquis <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">aliter aliquis S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-2.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">emat <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">emat Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-2.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">-det <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-det Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-2.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">forsf. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">forsf. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-2.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">-rat <hi rend="italic">S Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rat S Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-2.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">laghe. <hi rend="italic">Rl;</hi> lagahem. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">laghe. Rl; lagahem. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-2.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-2.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk S</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-2.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">i. e. <hi rend="italic">Hk Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. e. Hk Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-2.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">sit <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-2.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">-rint <hi rend="italic">Hk S Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rint Hk S Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-2.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">eum <hi rend="italic">fügt nochmals zu Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">Rl adds eum again</seg></note>
      </div>
    </body>
