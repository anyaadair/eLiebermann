      <div type="clause" n="22.5">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 22.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 22.5"><pb n="648" ed="#liebermann"/>Illi <hi rend="bold">uero</hi> qui non habent <hi rend="bold">has</hi><ptr type="liebermannNote" n="13" target="#ECfRetr_22-5.lnote.la.13"/> consuetudines, <hi rend="bold">coram</hi> iusticia<ptr type="liebermannNote" n="14" target="#ECfRetr_22-5.lnote.la.14"/> regis<ptr type="liebermannNote" n="15" target="#ECfRetr_22-5.lnote.la.15"/> rectum faciant in hundredis uel<ptr type="liebermannNote" n="16" target="#ECfRetr_22-5.lnote.la.16"/> in <ptr type="liebermannNote" n="*" target="#ECfRetr_22-5.lnote.la.star"/>wapentagiis<ptr type="liebermannNote" n="17" target="#ECfRetr_22-5.lnote.la.17"/> uel in sciris<ptr type="liebermannNote" n="18" target="#ECfRetr_22-5.lnote.la.18"/>.</ab>
        <note type="comparison" source="#liebermann" n="648"><label>printed alongside</label> <ref target="clause:ECf_22-5">ECf 22.5</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 648 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-5.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">id est lestis <hi rend="italic">überschr. Hd.</hi> 13. <hi rend="italic">Jhs. Cb zur Retr., irrig Kentisch</hi> lathe <hi rend="italic">mit Angloskandinav.</hi> wapentake <hi rend="italic">gleichsetzend</hi></seg><seg type="translation" xml:lang="en" source="#claude">id est lestis written above in a 13th-century hand Cb, to the Retr., wrongly equating Kentish lathe with Anglo-Scandinavian wapentake</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-5.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-5.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">domini <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds domini</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-5.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">regia <hi rend="italic">Cb Va Sp Db Ph K</hi></seg><seg type="translation" xml:lang="en" source="#claude">regia Cb Va Sp Db Ph K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-5.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-5.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">-tachiis <hi rend="italic">Sp K;</hi> -tacco <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tachiis Sp K; -tacco Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-5.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">scyris <hi rend="italic">Sp;</hi> schiris <hi rend="italic">Hv;</hi> siris <hi rend="italic">Lb Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">scyris Sp; schiris Hv; siris Lb Va</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But those who do not have these customs, let them do right before the king's justice in the hundreds or in the wapentakes or in the shires.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22-5.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">regia</hi><hi rend="superscript">15</hi> — <hi rend="italic">syris</hi><hi rend="superscript">18</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">regia</hi><hi rend="superscript">15</hi> — <hi rend="italic">syris</hi><hi rend="superscript">18</hi> Rs</seg></note>
      </div>
    </body>
