    <body>
      <div type="clause" n="31.2">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 31.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 31.2"><pb n="654" ed="#liebermann"/>Et<ptr type="liebermannNote" n="1" target="#ECf_31-2.lnote.la.1"/> quod in<ptr type="liebermannNote" n="2" target="#ECf_31-2.lnote.la.2"/> [þ]rehingis<ptr type="liebermannNote" n="3" target="#ECf_31-2.lnote.la.3"/> non<ptr type="liebermannNote" n="4" target="#ECf_31-2.lnote.la.4"/> poterat diffiniri, in scyra<ptr type="liebermannNote" n="5" target="#ECf_31-2.lnote.la.5"/> seruabatur.</ab>
        <note type="comparison" source="#liebermann" n="654"><label>printed alongside</label> <ref target="clause:ECfRetr_31-2">ECf retr 31.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 654 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-2.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-2.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt S</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-2.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">-ngge <hi rend="italic">S;</hi> threhiggis <hi rend="italic">Hr;</hi> tþrihinga <hi rend="italic">Ad;</hi> tr. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ngge S; threhiggis Hr; tþrihinga Ad; tr. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-2.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">d. n. p. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. n. p. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-2.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">syra <hi rend="italic">Hk;</hi> scira <hi rend="italic">S;</hi> shira <hi rend="italic">Ad;</hi> sciriā <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">syra Hk; scira S; shira Ad; sciriā Hr</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And what could not be determined in the <hi rend="italic">[þ]rehingis</hi> was reserved for the shire.</ab>
      </div>
    </body>
  </text>
