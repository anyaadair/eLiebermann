        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-6b.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">581</biblScope></bibl><seg type="original" xml:lang="de">a's <hi rend="italic">Sc; fehlt übr.; auch Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">a's <hi rend="italic">Sc; missing in the rest, Hg included</hi></seg></note>
