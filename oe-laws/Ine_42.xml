      <div type="clause" n="42">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 42</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42" corresp="#wit-e"><pb n="106" ed="#liebermann"/>LXXXVI. Gif ceorlas gærstun<ptr type="liebermannNote" n="18" target="#Ine_42.lnote.oe.18-3"/> hæbben gemænne oððe oþer gedálland<ptr type="liebermannNote" n="19" target="#Ine_42.lnote.oe.19-3"/> to tynanne, ⁊ hæbben sume getyned hiora<ptr type="liebermannNote" n="20" target="#Ine_42.lnote.oe.20-3"/> dæl, sume næbben, ⁊ etten<ptr type="liebermannNote" n="21" target="#Ine_42.lnote.oe.21-3"/> hiora gemænan æceras<ptr type="liebermannNote" n="22" target="#Ine_42.lnote.oe.22"/> oððe gærs, gán þa þon<hi rend="italic">ne</hi>, þe ðæt geat agan<ptr type="liebermannNote" n="23" target="#Ine_42.lnote.oe.23"/>, ⁊ gebete<ptr type="liebermannNote" n="*" target="#Ine_42.lnote.oe.star"/> þam<ptr type="liebermannNote" n="24" target="#Ine_42.lnote.oe.24"/> oðrum, þe hiora<ptr type="liebermannNote" n="20" target="#Ine_42.lnote.oe.20-3"/> dǽl getynedne<ptr type="liebermannNote" n="25" target="#Ine_42.lnote.oe.25"/> hæbben, þone æwerdlan<ptr type="liebermannNote" n="26" target="#Ine_42.lnote.oe.26"/> þe ðær<ptr type="liebermannNote" n="27" target="#Ine_42.lnote.oe.27"/> gedon sie<ptr type="liebermannNote" n="28" target="#Ine_42.lnote.oe.28"/>; abidden him æt þam<ptr type="liebermannNote" n="24" target="#Ine_42.lnote.oe.24"/> ceape swylc ryht<ptr type="liebermannNote" n="17" target="#Ine_42.lnote.oe.17-3"/> swylce<ptr type="liebermannNote" n="29" target="#Ine_42.lnote.oe.29"/> hit kyn sie.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42" corresp="#wit-h"><pb n="106" ed="#liebermann"/>LXXXVI. Gif ciorlas gærstún habban<ptr type="liebermannNote" n="12" target="#Ine_42.lnote.oe.12-2"/> gemæne<ptr type="liebermannNote" n="13" target="#Ine_42.lnote.oe.13-2"/> oððe oðer gedalland<ptr type="liebermannNote" n="14" target="#Ine_42.lnote.oe.14-2"/> to tynanne<ptr type="liebermannNote" n="15" target="#Ine_42.lnote.oe.15-2"/>, ⁊ hæbben sume getyned heora dæl, sume nabben<ptr type="liebermannNote" n="16" target="#Ine_42.lnote.oe.16-2"/>, ⁊ etten heora gemænan<ptr type="liebermannNote" n="17" target="#Ine_42.lnote.oe.17-2"/> æceras oþþe gærs, gán ða ðonne þe ðæt geat agon ⁊<ptr type="liebermannNote" n="4" target="#Ine_42.lnote.oe.4"/> gebeten ðam oþrum, þe heora<ptr type="liebermannNote" n="18" target="#Ine_42.lnote.oe.18-2"/> dæl betyned<ptr type="liebermannNote" n="19" target="#Ine_42.lnote.oe.19-2"/> habben<ptr type="liebermannNote" n="16" target="#Ine_42.lnote.oe.16-2"/>, ðone<ptr type="liebermannNote" n="20" target="#Ine_42.lnote.oe.20-2"/> æfwyrdlan ðe þær gedón sy<ptr type="liebermannNote" n="3" target="#Ine_42.lnote.oe.3-2"/>; abidden<ptr type="liebermannNote" n="21" target="#Ine_42.lnote.oe.21-2"/> heom<ptr type="liebermannNote" n="18" target="#Ine_42.lnote.oe.18-2"/> æt<ptr type="liebermannNote" n="11" target="#Ine_42.lnote.oe.11"/> ðam ceape swylc riht swylc hit cynn<ptr type="liebermannNote" n="3" target="#Ine_42.lnote.oe.3-2"/> sy.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42" corresp="#wit-b-no-prol"><pb n="106" ed="#liebermann"/>Be ða<hi rend="italic">m</hi> þ<hi rend="italic">æt</hi> ceorlas habbað land gemæne ⁊ gærstunas. Gyf ceorlas habban gærstun gemæne oþþe oðer gedalland to tynanne, ⁊ hæbben sume getyned heora dæl, sume næbben, ⁊ etten heora gemænan<ptr type="liebermannNote" n="2" target="#Ine_42.lnote.oe.2"/> æceras oððe gærs, gan ða ðonne þe þ<hi rend="italic">æt</hi> geat agon ⁊ gebeten ðæm oðrum, ðe héora dæl getynedne hæbben, ðone æfwyrdlan, ðe ðær gedon sy<ptr type="liebermannNote" n="3" target="#Ine_42.lnote.oe.3"/>; abiddon heom æt ðam ceape swylc riht swylce hit cyn sy.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="42" corresp="#wit-q"><pb n="107" ed="#liebermann"/>Si ceorli habeant herbagium in communi uel aliam compascualem<ptr type="liebermannNote" n="12" target="#Ine_42.lnote.oe.12"/> (uel<ptr type="liebermannNote" n="13" target="#Ine_42.lnote.oe.13"/> diuisionis) terram claudendam, et quidam eorum partem<ptr type="liebermannNote" n="14" target="#Ine_42.lnote.oe.14"/> suam clauserint, quidam uero non, et comedant<ptr type="liebermannNote" n="15" target="#Ine_42.lnote.oe.15"/> eorundem<ptr type="liebermannNote" n="16" target="#Ine_42.lnote.oe.16"/> compascuales acras<ptr type="liebermannNote" n="17" target="#Ine_42.lnote.oe.17"/> uel herbagium, eant tunc illi quorum porta fuerit et emendent<ptr type="liebermannNote" n="18" target="#Ine_42.lnote.oe.18"/> aliis<ptr type="liebermannNote" n="19" target="#Ine_42.lnote.oe.19"/> (illis), qui partem suam clausam<ptr type="liebermannNote" n="20" target="#Ine_42.lnote.oe.20"/> habent, dampnum quod factum sit; (et<ptr type="liebermannNote" n="21" target="#Ine_42.lnote.oe.21"/>) adquirant sibi de captali sic rectum sicut congruum sit.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="48–50" ed="#attenborough"/>[Be ðam þæt ceorlas habbað land gemæne ⁊ gærstunas.] Gif ceorlas gærstun hæbben gemænne oððe oþer gedálland<ptr type="editorNote" n="19" target="#Ine_42.attnote.fn.19"/> to tynanne, ⁊ hæbben sume getyned hiora dæl, sume næbben, ⁊ etten hiora gemænan æceras oððe gærs, gán þa þonne þe ðæt geat agan, ⁊ gebeten<ptr type="editorNote" n="20" target="#Ine_42.attnote.fn.20"/> þam oðrum, þe hiora dǽl getynedne<ptr type="editorNote" n="21" target="#Ine_42.attnote.fn.21"/> hæbben, þone æwerdlan<ptr type="editorNote" n="1" target="#Ine_42.attnote.fn.1"/> þe ðær gedon sie; abidden<ptr type="editorNote" n="2" target="#Ine_42.attnote.fn.2"/> him<ptr type="editorNote" n="3" target="#Ine_42.attnote.fn.3"/> æt þam ceape swylc ryht swylce hit kyn sie.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="43" corresp="#wit-e"><pb n="406" ed="#jurasinski-and-oliver"/>{LXXXVI} Gif ceorlas gærstun hæbben gemænne oððe oþer gedálland to tynanne, ⁊ hæbben sume getyned hiora dæl sume næbben, ⁊ etten hiora gemænan æceras oððe gærs, gán þa þon<hi rend="italic">ne</hi> þe ðæt geat agan ⁊ gebet þam oðrum þe hiora dǽl getynedne hæbben þone æwerdlan þe ðær gedon sie. Abidden him æt þam ceape swelc ryht swelc hit kyn sie.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="107" ed="#liebermann"/>Wenn Bauern ein gemeinschaftliches<ptr type="liebermannNote" n="1" target="#Ine_42.lnote.de.1"/> Wiesengehege<ptr type="liebermannNote" n="2" target="#Ine_42.lnote.de.2"/> oder anderes [nämlich<ptr type="liebermannNote" n="3" target="#Ine_42.lnote.de.3"/> Acker-]Land<ptr type="liebermannNote" n="4" target="#Ine_42.lnote.de.4"/> in [Besitzer-]Antheilen<ptr type="liebermannNote" n="5" target="#Ine_42.lnote.de.5"/> zu umzäunen haben<ptr type="liebermannNote" n="6" target="#Ine_42.lnote.de.6"/>, und einige haben ihren [Zaun]theil gezäunt, andere haben [es] nicht<ptr type="liebermannNote" n="7" target="#Ine_42.lnote.de.7"/>, und [wenn<ptr type="liebermannNote" n="8" target="#Ine_42.lnote.de.8"/> nun Thiere] ihre [der Bauern] gemeinschaftliche Äcker oder Gras abfressen, so sollen dann die [Nachlässigen], welche die Öffnung [zu verantworten] haben<ptr type="liebermannNote" n="9" target="#Ine_42.lnote.de.9"/>, hingehen und den Anderen, welche ihren [Zaun]theil gezäunt haben<ptr type="liebermannNote" n="10" target="#Ine_42.lnote.de.10"/>, den Schaden, der da angerichtet sein mag, büssen; sie<ptr type="liebermannNote" n="11" target="#Ine_42.lnote.de.11"/> mögen sich<ptr type="liebermannNote" n="12" target="#Ine_42.lnote.de.12"/> von jenem [schädigenden] Vieh so weit Recht erholen, wie es<ptr type="liebermannNote" n="13" target="#Ine_42.lnote.de.13"/> gehörig ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If peasants have a common meadow or other [arable] land in [individual] shares to fence, and some have fenced their share [of the fence] and others have not, and [animals then] eat up their [the peasants’] common fields or grass, then let the [negligent ones] who are [responsible for] the gap go and compensate the others, who have fenced their share, for the damage that may have been done there; they may recover from that [damaging] livestock such justice as is fitting.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="49" ed="#attenborough"/>If commoners have a common meadow or other—partible—land<ptr type="editorNote" n="1" target="#Ine_42.attnote.n.1"/> to fence, and some have fenced their portion and some have not, [and cattle<ptr type="editorNote" n="2" target="#Ine_42.attnote.n.2"/> get in] and eat up their common crops<ptr type="editorNote" n="3" target="#Ine_42.attnote.n.3"/> or their grass, then those who are responsible for the opening shall go and pay compensation for the damage which has been done to the others, who have enclosed their portion. They [the latter] shall demand from [the owners of] the cattle such amends as are fitting.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="404" ed="#whitelock"/>If <hi rend="italic">ceorls</hi> have a common meadow or other land divided in shares to fence, and some have fenced their portion and some have not, and [if cattle] eat up their common crops or grass, those who are responsible for the gap are to go and pay to the others, who have fenced their part, compensation for the damage that has been done there. They are to demand with regard to<ptr type="editorNote" n="6" target="#Ine_42.whinote.n.6"/> those cattle such reparation as is proper.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="407" ed="#jurasinski-and-oliver"/>If <hi rend="italic">ceorls</hi> have to fence a common meadow or otherwise shared land and some have fenced their part and some have not, [and livestock get in and] eat their shared crops or grass, let those who are responsible for the gap go then and pay the others who have fenced their part for the damages that were done there. Let [those who fenced their land] demand from them for [damage done by] the cattle such lawful recompense as is proper.</ab>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="405"><ref target="clause:Ine_37">Ine 37</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_42.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">106</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. aus</hi> gemanan</seg><seg type="translation" xml:lang="en" source="#claude">altered from gemanan</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_42.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">106</biblScope></bibl><seg type="original" xml:lang="de">⁊ <hi rend="italic">neu zugefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">⁊ newly added</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_42.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">107</biblScope></bibl><seg type="original" xml:lang="de">-culam <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-culam K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_42.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">107</biblScope></bibl><seg type="original" xml:lang="de">uel d. <hi rend="italic">nur Lond;</hi> diuisam <hi rend="italic">Or;</hi> com. ter. uel diuisam <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel d. only Lond; diuisam Or; com. ter. uel diuisam the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_42.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">107</biblScope></bibl><seg type="original" xml:lang="de">cl. p. su. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">cl. p. su. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_42.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">107</biblScope></bibl><seg type="original" xml:lang="de">-antur <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-antur Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_42.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">107</biblScope></bibl><seg type="original" xml:lang="de">eorum <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">eorum Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_42.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">107</biblScope></bibl><seg type="original" xml:lang="de">-cre <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cre Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_42.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">107</biblScope></bibl><seg type="original" xml:lang="de">-det <hi rend="italic">T;</hi> -detur <hi rend="italic">M</hi></seg><seg type="translation" xml:lang="en" source="#claude">-det T; -detur M</seg></note>
