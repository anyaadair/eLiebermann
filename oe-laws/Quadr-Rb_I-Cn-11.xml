      <div type="clause" n="I Cn 11">
        <head>Quadr Rb I Cn 11</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Rb I Cn 11" corresp="#wit-lat"><pb n="536" ed="#liebermann"/>De thainis<ptr type="liebermannNote" n="23" target="#Quadr-Rb_I-Cn-11.lnote.la.23"/> qui ecclesias<ptr type="liebermannNote" n="a" target="#Quadr-Rb_I-Cn-11.lnote.la.fn.a"/><ptr type="liebermannNote" n="24" target="#Quadr-Rb_I-Cn-11.lnote.la.24"/> habent, ubi atrium sit<ptr type="liebermannNote" n="25" target="#Quadr-Rb_I-Cn-11.lnote.la.25"/> uel non sit<ptr type="liebermannNote" n="26" target="#Quadr-Rb_I-Cn-11.lnote.la.26"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 536 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">Of thegns who have churches, whether there is a churchyard or not.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-11.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">tainis <hi rend="italic">DmR stets</hi></seg><seg type="translation" xml:lang="en" source="#claude">tainis DmR always</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-11.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus dem Angelsächsischen Texte Cnuts</hi></seg><seg type="translation" xml:lang="en" source="#claude">from the Old English text of Cnut</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-11.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">ęccl. <hi rend="italic">Dm stets</hi></seg><seg type="translation" xml:lang="en" source="#claude">ęccl. Dm always</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-11.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">est <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">est R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-11.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt TRBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in TRBr</seg></note>
