      <div type="clause" n="70.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 70.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 70.1" corresp="#wit-lat"><pb n="587" ed="#liebermann"/>In Westsexa<ptr type="liebermannNote" n="31" target="#Hn_70-1.lnote.oe.31"/>, que<ptr type="liebermannNote" n="q" target="#Hn_70-1.lnote.oe.q"/> capud regni est et legum, tƿyhindi<ptr type="liebermannNote" n="r" target="#Hn_70-1.lnote.oe.r"/><ptr type="liebermannNote" n="32" target="#Hn_70-1.lnote.oe.32"/>, id est uillani, wera est IIII libr.<ptr type="liebermannNote" n="s" target="#Hn_70-1.lnote.oe.s"/>; tƿelfhindi<ptr type="liebermannNote" n="33" target="#Hn_70-1.lnote.oe.33"/>, id est<ptr type="liebermannNote" n="34" target="#Hn_70-1.lnote.oe.34"/> thaini<ptr type="liebermannNote" n="t" target="#Hn_70-1.lnote.oe.t"/>, XXV libr.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 587 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-1.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 87, 5. Cil de Lundres sunt chief del regne <hi rend="italic">beansprucht dagegen London c.</hi> 1200; <hi rend="italic">ed. Bateson</hi> 720; <hi rend="italic">vgl. meine</hi> Leges Angl. Lond. <hi rend="italic">S.</hi> 63</seg><seg type="translation" xml:lang="en" source="#claude">as 87, 5. London, by contrast, claims c. 1200: Cil de Lundres sunt chief del regne; ed. Bateson 720; cf. my Leges Angl. Lond. p. 63</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-1.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt</hi> 76, 4</seg><seg type="translation" xml:lang="en" source="#claude">repeated 76, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-1.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de">et 40 den. <hi rend="italic">Wer</hi> 1, 1; <hi rend="italic">wie hier</hi> 76, 4; 6<hi rend="italic">a</hi>: <hi rend="italic">wahrscheinlich rundete der Anglonorm. Jurist die Summe nach unten ab; vgl. Seebohm</hi> Tribal system under the Anglo-Saxons 325</seg><seg type="translation" xml:lang="en" source="#claude">et 40 den. Wer 1, 1; as here 76, 4; 6a: the Anglo-Norman jurist probably rounded the sum down; cf. Seebohm Tribal system under the Anglo-Saxons 325</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-1.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 69, 2. 76, 4; <hi rend="italic">aus Af Rb.</hi> 31</seg><seg type="translation" xml:lang="en" source="#claude">as 69, 2. 76, 4; from Af Rb. 31</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-1.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de">Wess. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Wess. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-1.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de">tih. <hi rend="italic">Co Or</hi>; teh. <hi rend="italic">Gi</hi>; thih. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">tih. Co Or; teh. Gi; thih. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-1.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de">thelh. <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">thelh. K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-1.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de">uillani wera est IIII li., thelhindi, id est <hi rend="italic">wiederholt Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">uillani wera est IIII li., thelhindi, id est repeated by Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de">Über des Verfs. Teilnahme für Wessex (<hi rend="italic">s. d. Gl</hi> 3) <hi rend="italic">o</hi>. Einl. 6—<hi rend="italic">libri thelh</hi>.{38} Rs</seg><seg type="translation" xml:lang="en" source="#claude">On the author’s sympathy for Wessex (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 3) see <hi rend="italic">above</hi> Introduction 6—<hi rend="italic">libri thelh</hi>.{38} Rs</seg></note>
      </div>
