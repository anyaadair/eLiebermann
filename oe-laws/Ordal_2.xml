      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:Ordal">Ordal</ref> 2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2" corresp="#wit-h"><pb n="386" ed="#liebermann"/>⁊ gif hit anfeald tyhle<ptr type="liebermannNote" n="6" target="#Ordal_2.lnote.oe.6"/> sy, dúfe seo hand ǽfter þam stane oð þa wríste, ⁊ gif hit þryfeald sy, oð þæne élbogan.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2" corresp="#wit-q"><pb n="386" ed="#liebermann"/>Et si<ptr type="liebermannNote" n="17" target="#Ordal_2.lnote.oe.17"/> anfeald<ptr type="liebermannNote" n="18" target="#Ordal_2.lnote.oe.18"/> tihla<ptr type="liebermannNote" n="19" target="#Ordal_2.lnote.oe.19"/> sit, inmergatur manus post lapidem (ut<ptr type="liebermannNote" n="20" target="#Ordal_2.lnote.oe.20"/> examen) usque ad þriste<ptr type="liebermannNote" n="21" target="#Ordal_2.lnote.oe.21"/>, et si triplex accusatio sit, usque ad cubitum.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="1.2" corresp="#wit-h">And gif hit anfeald tyhle<ptr type="editorNote" n="6" target="#Ordal_2.attnote.fn.6"/> sy, dúfe seo hand ǽfter þam stane oð þa wríste, and gif hit þryfeald sy, oð þæne élbogan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="386" ed="#liebermann"/>Und wenn es einfache<ptr type="liebermannNote" n="1" target="#Ordal_2.lnote.de.1"/> Klage ist, tauche die Hand nach dem Steine<ptr type="liebermannNote" n="2" target="#Ordal_2.lnote.de.2"/> [im siedenden Kessel] bis zur Handwurzel, und wenn es dreifache ist, bis zum Ellbogen.<ptr type="liebermannNote" n="3" target="#Ordal_2.lnote.de.3"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if it is a single accusation, let the hand dive after the stone [in the boiling cauldron] up to the wrist, and if it is threefold, up to the elbow.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">And if the accusation is ‘single,’ the hand shall be plunged in up to the wrist in order to reach the stone; if it is ‘threefold,’ up to the elbow.</ab>
        <note type="editorial">Thorpe alters ‘tyhle’ to ‘tyhtle’; but compare the Quadripartitus and I Cn 5–5.2 MS A.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">386</biblScope></bibl><seg type="original" xml:lang="de">tyhtle <hi rend="italic">ändert Thorpe; aber vgl. Quadr. und I Cn.</hi> 5—5, 2 <hi rend="italic">Hs. A</hi></seg><seg type="translation" xml:lang="en" source="#claude">Thorpe alters to tyhtle; but cf. Quadr. and I Cn. 5—5, 2 MS A</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">386</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">386</biblScope></bibl><seg type="original" xml:lang="de">-lt <hi rend="italic">T;</hi> -eld <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lt T; -eld MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">386</biblScope></bibl><seg type="original" xml:lang="de">tyhla <hi rend="italic">T;</hi> tyhde <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">tyhla T; tyhde MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">386</biblScope></bibl><seg type="original" xml:lang="de">ut e. <hi rend="italic">fehlt K;</hi> uel <hi rend="italic">MHk</hi> [<hi rend="italic">vielleicht Glosse zu</hi> iudicium <hi rend="italic">in</hi> 1b <hi rend="italic">oder</hi> 3, <hi rend="italic">wie in</hi> 6, <hi rend="italic">nur verschoben</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">ut e. lacking in K; uel MHk [perhaps a gloss on iudicium in 1b or 3, as in 6, only displaced]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">386</biblScope></bibl><seg type="original" xml:lang="de">þyrste <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">þyrste R</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ordal_2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">227</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Kesselfang 9b; Klage 10; Ordal 7 A</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Kesselfang 9b; Klage 10; Ordal 7 A</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ordal_2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">227</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Anderswo wird auch nach einem Ring gegriffen; Zeumer <hi rend="italic">Form</hi>. 6. 14</seg><seg type="translation" xml:lang="en" source="#claude">Elsewhere a ring is also reached for; Zeumer <hi rend="italic">Form</hi>. 6. 14</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ordal_2.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">227</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Kesselfang 9b; Klage 10; Ordal 7 A</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Kesselfang 9b; Klage 10; Ordal 7 A</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ordal_2.attnote.fn.6" n="6" source="#attenborough"><bibl><biblScope unit="page">170</biblScope></bibl><label>tyhle</label><seg type="original" xml:lang="en">Thorpe emends to <hi rend="italic">tyhtle.</hi></seg></note>
      </div>
    </body>
  </text>
