    <body>
      <div type="clause" n="8.3">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 8.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 8.3"><pb n="632" ed="#liebermann"/>Hec<ptr type="liebermannNote" n="36" target="#ECfRetr_8-3.lnote.la.36"/> <hi rend="bold">enim</hi><ptr type="liebermannNote" n="37" target="#ECfRetr_8-3.lnote.la.37"/> predicauit<ptr type="liebermannNote" n="38" target="#ECfRetr_8-3.lnote.la.38"/> <hi rend="bold">beatus</hi> Augustinus<ptr type="liebermannNote" n="*" target="#ECfRetr_8-3.lnote.la.star"/> <hi rend="bold">(et</hi><ptr type="liebermannNote" n="39" target="#ECfRetr_8-3.lnote.la.39"/> <hi rend="bold">docuit),</hi> et hec<ptr type="liebermannNote" n="40" target="#ECfRetr_8-3.lnote.la.40"/> concessa sunt a rege<ptr type="liebermannNote" n="41" target="#ECfRetr_8-3.lnote.la.41"/> et<ptr type="liebermannNote" n="42" target="#ECfRetr_8-3.lnote.la.42"/> baronibus et populo.</ab>
        <note type="comparison" source="#liebermann" n="632"><label>printed alongside</label> <ref target="clause:ECf_8-3">ECf 8.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 632 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">The note number after “Hec” is printed as 56 in the copy used; it is note 36 (“Hoc Dc”).</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-3.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">Hoc <hi rend="italic">Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hoc Dc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-3.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">etiam <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">etiam Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-3.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">b. A. p. <hi rend="italic">Lb Va Ph;</hi> sanctus A. p. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">b. A. p. Lb Va Ph; sanctus A. p. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-3.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">et d. <hi rend="italic">aus Lb Va Ph Hv; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">et d. from Lb Va Ph Hv; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-3.lnote.la.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-3.lnote.la.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">lege <hi rend="italic">Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">lege Dc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-3.lnote.la.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">a <hi rend="italic">fügt zu K;</hi> a <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">K adds a; a Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-3.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">Anglorum apostolus, qui Cantuarie iacet <hi rend="italic">fügt zu Cc</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cc adds Anglorum apostolus, qui Cantuarie iacet</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">For these things blessed Augustine preached (and taught), and these were granted by the king and the barons and the people.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-3.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">344</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">ohne <hi rend="italic">et</hi><hi rend="superscript">39</hi> <hi rend="italic">d.</hi> — <hi rend="italic">conc. s. a r.</hi><hi rend="superscript">41</hi> <hi rend="italic">hec</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">without <hi rend="italic">et</hi><hi rend="superscript">39</hi> <hi rend="italic">d.</hi> — <hi rend="italic">conc. s. a r.</hi><hi rend="superscript">41</hi> <hi rend="italic">hec</hi> Rs</seg></note>
      </div>
    </body>
