        <note type="liebermannNote" subtype="textual" xml:id="IIAs_19.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">160</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_19.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">160</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_19.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">160</biblScope></bibl><seg type="original" xml:lang="de">um <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">um on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_19.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">161</biblScope></bibl><seg type="original" xml:lang="de">est <hi rend="italic">TMHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">est TMHkBr</seg></note>
