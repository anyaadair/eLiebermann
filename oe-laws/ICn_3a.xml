      <div type="clause" n="3a">
        <head><ref type="lawCode" target="law:ICn">I Cn</ref> 3a</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3a" corresp="#wit-g-a"><pb n="282" ed="#liebermann"/>Bete man<ptr type="liebermannNote" n="13" target="#ICn_3a.lnote.oe.13"/> ærest þone<ptr type="liebermannNote" n="14" target="#ICn_3a.lnote.oe.14"/> griðbryce into þære<ptr type="liebermannNote" n="15" target="#ICn_3a.lnote.oe.15"/> cyrican, be þam þe seo dæd<ptr type="liebermannNote" n="16" target="#ICn_3a.lnote.oe.16"/> sy ⁊ be þam þe ðære cyricean<ptr type="liebermannNote" n="17" target="#ICn_3a.lnote.oe.17"/> mæð sy.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3a" corresp="#wit-a"><pb n="282" ed="#liebermann"/>Bete man arost þonne<ptr type="liebermannNote" n="2" target="#ICn_3a.lnote.oe.2-2"/> gryðbryce into þare cyrican, be þam þe syo dæde sy ⁊ be þam þe þare cyricean mæð sy.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3a" corresp="#wit-q"><pb n="282" ed="#liebermann"/>Emendetur prius<ptr type="liebermannNote" n="2" target="#ICn_3a.lnote.oe.2"/> (primitus) infractio pacis in<ptr type="liebermannNote" n="1" target="#ICn_3a.lnote.oe.1"/> ipsam ęcclesiam, iuxta quod culpa fuerit et ipsius ęcclesię dignitas;</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3a" corresp="#wit-inst-cn"><pb n="283" ed="#liebermann"/>imprimis semper<ptr type="liebermannNote" n="23" target="#ICn_3a.lnote.oe.23"/> fiat emendatio ęcclesię secundum qualitatem (et<ptr type="liebermannNote" n="24" target="#ICn_3a.lnote.oe.24"/> dignitatem) eius.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3a" corresp="#wit-cons-cn"><pb n="283" ed="#liebermann"/>primum autem ecclesie pacis infracturam iuxta modum ipsius malefacti et iuxta modum dignitatis ipsius ecclesie.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="3a" corresp="#wit-g-a"><pb n="156" ed="#robertson"/>Bete man ærest þone<ptr type="editorNote" n="6" target="#ICn_3a.robnote.fn.6"/> griðbryce into þære cyrican be þam þe seo dæd sy ⁊ be þam þe ðære cyricean mæð sy.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="234" ed="#rabin-doml"/>Bete man ærest þone griðbryce into þære cyrican, be þam þe seo dæd sy and be þam þe ðære cyricean mæð sy.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="283" ed="#liebermann"/>büsse er zuerst an die [verletzte] Kirche den Bruch des Sonderfriedens, je nachdem die Missethat ist, und je nachdem der Rang dieser Kirche ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">let compensation first be paid to the [violated] church for the breach of protection, according to what the deed is and according to the rank of the church.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-g-a"><pb n="157" ed="#robertson"/>In the first instance, amends for breach of its protection shall be made to the church, in accordance with the nature of the offence and also in proportion to the status of the church.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="235" ed="#rabin-doml"/>Penance for the violation of sanctuary is to be made first to the church according to the nature of the deed and likewise according to the status of the church.</ab>
        <note type="comparison" source="#liebermann" n="283"><ref target="clause:VIIIAtr_4">VIII Atr 4</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 4,</note>
        <note type="editorial">Liebermann compares VIII Atr 4.1.; BR: added from Gesetze I p. 283, October 2026 (MS Cons); AX: pages in Rabin (text / translation), checked against Rabin (translation on the facing page), October 2026 (e.g. was “234”, now “234 / 235”; 16 rows of I Cn)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_3a.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">282</biblScope></bibl><seg type="original" xml:lang="de">mon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_3a.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">282</biblScope></bibl><seg type="original" xml:lang="de">þonne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þonne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_3a.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">282</biblScope></bibl><seg type="original" xml:lang="de">þær <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þær Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_3a.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">282</biblScope></bibl><seg type="original" xml:lang="de">dæde <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">dæde Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_3a.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">282</biblScope></bibl><seg type="original" xml:lang="de">-can <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-can Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_3a.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">282</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond; eingeklammertes übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">what precedes the bracket Lond; what is bracketed the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_3a.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">282</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">et K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_3a.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">283</biblScope></bibl><seg type="original" xml:lang="de">fiet s. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">fiet s. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_3a.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">283</biblScope></bibl><seg type="original" xml:lang="de">et di. <hi rend="italic">nur Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">et di. only Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_3a.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">282</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 9, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. 9, 1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_3a.lnote.de.0" n="0" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">198</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Am Rande lies ‘4, 1’</seg><seg type="translation" xml:lang="en" source="#claude">In the margin read ‘4, 1’</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="ICn_3a.robnote.fn.6" n="6" source="#robertson"><bibl><biblScope unit="page">156</biblScope></bibl><label>þone</label><seg type="original" xml:lang="en"><hi rend="italic">þonne</hi> A, Ld.</seg></note>
      </div>
