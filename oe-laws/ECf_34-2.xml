    <body>
      <div type="clause" n="34.2">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 34.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 34.2"><pb n="662" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_34-2.lnote.oe.erkl-clause"/><ptr type="liebermannNote" n="9" target="#ECf_34-2.lnote.la.9"/>Eadwardus<ptr type="liebermannNote" n="10" target="#ECf_34-2.lnote.la.10"/>, filius eius natus de uxore<ptr type="liebermannNote" n="11" target="#ECf_34-2.lnote.la.11"/>, regnauit IIII<ptr type="liebermannNote" n="d" target="#ECf_34-2.lnote.la.fn.d"/> annis*, XVI ebdomadibus<ptr type="liebermannNote" n="12" target="#ECf_34-2.lnote.la.12"/> minus<ptr type="liebermannNote" n="13" target="#ECf_34-2.lnote.la.13"/>. Quo occiso<ptr type="liebermannNote" n="14" target="#ECf_34-2.lnote.la.14"/> innocenter<ptr type="liebermannNote" n="15" target="#ECf_34-2.lnote.la.15"/> dolo<ptr type="liebermannNote" n="e" target="#ECf_34-2.lnote.la.fn.e"/> nouerce sue, propter innocentem uitam suam, castam et elemosinis plenam, interfectionem eius pro martyrio reputauerunt<ptr type="liebermannNote" n="f" target="#ECf_34-2.lnote.la.fn.f"/> ei et uocauerunt sanctum.</ab>
        <note type="comparison" source="#liebermann" n="662"><label>printed alongside</label> <ref target="clause:ECfRetr_34-2">ECf retr 34.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 662 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann prints a small raised asterisk after “annis” (not one of his starred notes) and gives in the outer margin of the ECf retr column the dates 975–78.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielmehr</hi> III</seg><seg type="translation" xml:lang="en" source="#claude">rather III</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">d. n. s. <hi rend="italic">vielleicht aus Will. Malm.</hi> Reg. II 162</seg><seg type="translation" xml:lang="en" source="#claude">d. n. s. perhaps from Will. Malm., Reg. II 162</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">die gläubigen Engländer trennt der also wohl fremde Verf. von sich</hi></seg><seg type="translation" xml:lang="en" source="#claude">the author, who is thus probably a foreigner, separates the believing English from himself</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">Regnum Aedwardi [Ed. <hi rend="italic">S</hi>], filii Aedgari [Edwardi <hi rend="italic">S</hi>] regis <hi rend="italic">Überschrift Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">heading in Pl S: Regnum Aedwardi [Ed. S], filii Aedgari [Edwardi S] regis</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">Edw. <hi rend="italic">Hk;</hi> Aed. <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">Edw. Hk; Aed. S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">sua <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hk adds sua</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">-dis <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dis S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">innocente occ. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">innocente occ. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">-te <hi rend="italic">S Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-te S Hr</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Edward, his son born of his wife, reigned four years*, less sixteen weeks. When he had been killed, innocent, through the guile of his stepmother, because of his innocent life, chaste and full of almsgiving, they reckoned his killing to him as martyrdom and called him a saint.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">349</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd.</hi> Eadward II.; Einl. 9</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid.</hi> Eadward II.; Einl. 9</seg></note>
      </div>
    </body>
  </text>
