    <body>
      <div type="clause" n="61.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 61.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="61.1" corresp="#wit-e"><pb n="82" ed="#liebermann"/>Gif he ðurhwund bið, æt gehweðerum<ptr type="liebermannNote" n="22" target="#Af_61-1.lnote.oe.22"/> muðe XX<ptr type="liebermannNote" n="23" target="#Af_61-1.lnote.oe.23"/> scill.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="61.1" corresp="#wit-h"><pb n="82" ed="#liebermann"/>Gif he þurhwund bið, æt ægðrum muðe XX scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="61.1" corresp="#wit-b-no-prol"><pb n="82" ed="#liebermann"/>Gyf he ðurhwund bið, æt ægðran muðe twentig scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="61.1" corresp="#wit-q"><pb n="83" ed="#liebermann"/>Si transforatus<ptr type="liebermannNote" n="22" target="#Af_61-1.lnote.oe.22-2"/> sit, ad<ptr type="liebermannNote" n="23" target="#Af_61-1.lnote.oe.23-2"/> utrumque os emendetur uiginti<ptr type="liebermannNote" n="24" target="#Af_61-1.lnote.oe.24"/> sol.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="88" ed="#attenborough"/>Gif he ðurhwund bið, æt gehweðerum<ptr type="editorNote" n="16" target="#Af_61-1.attnote.fn.16"/> muðe XX scill.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="64.1" corresp="#wit-e"><pb n="356" ed="#jurasinski-and-oliver"/>Gif he ðurhwund bið, æt gehweðerum muðe XX scill.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="83" ed="#liebermann"/>Wenn er<ptr type="liebermannNote" n="1" target="#Af_61-1.lnote.de.1"/> durchbohrt<ptr type="liebermannNote" n="2" target="#Af_61-1.lnote.de.2"/> ist, [dass die Waffe herausfährt], für jede der beiden<ptr type="liebermannNote" n="3" target="#Af_61-1.lnote.de.3"/> Öffnungen<ptr type="liebermannNote" n="4" target="#Af_61-1.lnote.de.4"/> 20 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he is pierced through [so that the weapon comes out], for each of the two openings 20 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="89" ed="#attenborough"/>If he is pierced right through, 20 shillings [shall be paid as compensation] for each orifice.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="357" ed="#jurasinski-and-oliver"/>If the wound goes through it, at each opening 20 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_61-1.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">ægþrum <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ægþrum Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_61-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">tweontig <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">tweontig Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_61-1.lnote.oe.22-2" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">-tum <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tum T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_61-1.lnote.oe.23-2" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt HkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in HkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_61-1.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">XXX <hi rend="italic">LondTHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">XXX LondTHkBr</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_61-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘der Bauch’, weil im Agsä. Neutrum</seg><seg type="translation" xml:lang="en" source="#claude">Not ‘the belly’, because it is neuter in Anglo-Saxon</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_61-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Beeinflusst durch Abt 61a. Zum Wort <hi rend="italic">vgl. þurhhat</hi> ‘durch und durch heiss’</seg><seg type="translation" xml:lang="en" source="#claude">Influenced by Abt 61a. On the word <hi rend="italic">cf. þurhhat</hi> ‘hot through and through’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_61-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">hb modernisiert</seg><seg type="translation" xml:lang="en" source="#claude">hb modernizes</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_61-1.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl.</hi> Gliederbussen 10; <hi rend="italic">u.</hi> 67, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf.</hi> Gliederbussen 10; <hi rend="italic">below</hi> 67, 2</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_61-1.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">88</biblScope></bibl><label>gehweðerum</label><seg type="original" xml:lang="en"><hi rend="italic">ægðran</hi>. B. <hi rend="italic">ægðrum</hi>. H.</seg></note>
      </div>
    </body>
