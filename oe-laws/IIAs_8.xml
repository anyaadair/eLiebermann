        <note type="liebermannNote" subtype="textual" xml:id="IIAs_8.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">154</biblScope></bibl><seg type="original" xml:lang="de">-de <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">-de So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_8.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">154</biblScope></bibl><seg type="original" xml:lang="de">folcryht <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">folcryht So</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_8.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">103</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Die letzten 5 Wörter der Rubrik gehören sq, nicht dem Archetyp. — Den Satz benutzt, z. T. aus Q, aber dem Agsä. in <hi rend="italic">ducat</hi> aus <hi rend="italic">læde</hi> näher, Hn 8, 4</seg><seg type="translation" xml:lang="en" source="#claude">The last 5 words of the rubric belong to sq, not to the archetype. — The sentence is used by Hn 8, 4, partly from Q, but closer to the Anglo-Saxon in <hi rend="italic">ducat</hi> from <hi rend="italic">læde</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_8.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">103</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Gefolge 7 ff.; Fremde 12 a ff.; Grafschaft 11 ff.; Haftung 7 c</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Gefolge 7 ff.; Fremde 12 a ff.; Grafschaft 11 ff.; Haftung 7 c</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_8.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">103</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Kemble <hi rend="italic">Saxons</hi> II 514 denkt (aus Q ?) an nur vorübergehenden Besuch. Doch kann auch dauernde Heimkehr gemeint sein bei fortbestehender Herrschaft eines Auswärtigen</seg><seg type="translation" xml:lang="en" source="#claude">Kemble <hi rend="italic">Saxons</hi> II 514 thinks (from Q?) of only a temporary visit. But a permanent return home may also be meant, with the lordship of a man from elsewhere continuing</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_8.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">103</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">gerad</hi> scheint Q mit <hi rend="italic">rad</hi> (<hi rend="italic">u.</hi> 20, 4 <hi rend="italic">iter</hi>) zu verwechseln</seg><seg type="translation" xml:lang="en" source="#claude">Q seems to confuse <hi rend="italic">gerad</hi> with <hi rend="italic">rad</hi> (<hi rend="italic">below</hi> 20, 4 <hi rend="italic">iter</hi>)</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_8.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">103</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Das Gericht ist das der Heimat</seg><seg type="translation" xml:lang="en" source="#claude">The court is that of his home district</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIAs_8.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">207</biblScope></bibl><seg type="original" xml:lang="en">For ‘shire’ see note to Ine, cap. 36 § 1.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_8.attnote.fn.5" n="5" source="#attenborough"><bibl><biblScope unit="page">132</biblScope></bibl><label>oþre</label><seg type="original" xml:lang="en"><hi rend="italic">oþer</hi>. Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_8.attnote.fn.6" n="6" source="#attenborough"><bibl><biblScope unit="page">132</biblScope></bibl><label>gesece</label><seg type="original" xml:lang="en"><hi rend="italic">sece</hi>. Ld, Ot.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_8.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">132</biblScope></bibl><label>hine</label><seg type="original" xml:lang="en"><hi rend="italic">he ðe hine</hi>. Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_8.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">132</biblScope></bibl><label>gerad</label><seg type="original" xml:lang="en"><hi rend="italic">gerade</hi>. Ld, So.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_8.attnote.fn.9" n="9" source="#attenborough"><bibl><biblScope unit="page">132</biblScope></bibl><label>læde</label><seg type="original" xml:lang="en">Altered to <hi rend="italic">gelæde</hi>. H.</seg></note>
      </div>
