      <div type="clause" n="4.3">
        <head><ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 4.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 4.3" corresp="#wit-du"><pb n="410" ed="#liebermann"/>ita et qui innocens de hoc fyrto<ptr type="liebermannNote" n="35" target="#IudDeiIV_4-3.lnote.oe.35"/> in hanc aquam manum miserit, saluam et inlesam eam<ptr type="liebermannNote" n="8" target="#IudDeiIV_4-3.lnote.oe.8"/> educat:</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei IV 4.3" corresp="#wit-gl"><pb n="410" ed="#liebermann"/>svæ ⁊ æc se ðe vnscyldig of ðissu<hi rend="italic">m</hi> ðiofte in ðas<ptr type="liebermannNote" n="36" target="#IudDeiIV_4-3.lnote.oe.36"/> vætre hond gisendes<ptr type="liebermannNote" n="37" target="#IudDeiIV_4-3.lnote.oe.37"/>, hal ⁊ vnscended<hi rend="italic">e</hi> hia gilæde:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 410 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-3.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-3.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">für</hi> u <hi rend="italic">auch Note</hi> 1</seg><seg type="translation" xml:lang="en" source="#claude">y for u, also note 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-3.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Note</hi> 7; <hi rend="italic">Lind. S.</hi> 117; vætre: <hi rend="italic">o. S.</hi> 409{31}</seg><seg type="translation" xml:lang="en" source="#claude">cf. note 7; Lind. p. 117; vætre: above p. 409³¹</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-3.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">d. i.</hi> mittit</seg><seg type="translation" xml:lang="en" source="#claude">i.e. mittit</seg></note>
      </div>
