      <div type="clause" n="92.14">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 92.14</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 92.14" corresp="#wit-lat"><pb n="608" ed="#liebermann"/>Homicidium werelada<ptr type="liebermannNote" n="32" target="#Hn_92-14.lnote.oe.32"/> pernegetur; <ptr type="liebermannNote" n="q" target="#Hn_92-14.lnote.oe.q"/>ad purgandum uero uel respondendum<ptr type="liebermannNote" n="33" target="#Hn_92-14.lnote.oe.33"/> super hiis sufficit compellacio parentum bello uel anteiuramento<ptr type="liebermannNote" n="34" target="#Hn_92-14.lnote.oe.34"/>, uel per legalem personam uel per publicam fuerit, uel [si<ptr type="liebermannNote" n="35" target="#Hn_92-14.lnote.oe.35"/>] iter<ptr type="liebermannNote" n="36" target="#Hn_92-14.lnote.oe.36"/> unum simul habuerint<ptr type="liebermannNote" n="r" target="#Hn_92-14.lnote.oe.r"/> uel aliquid huiusmodi — et<ptr type="liebermannNote" n="s" target="#Hn_92-14.lnote.oe.s"/> quando et ubi simul fuerint<ptr type="liebermannNote" n="37" target="#Hn_92-14.lnote.oe.37"/> uel etiam recesserint<ptr type="liebermannNote" n="37" target="#Hn_92-14.lnote.oe.37"/> —, et si ire uel odium uel mine intercesserint<ptr type="liebermannNote" n="38" target="#Hn_92-14.lnote.oe.38"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 608 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-14.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">denke hinzu:</hi> um den Verdächtigen zu zwingen</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">understand:</hi> in order to compel the suspect</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-14.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Erschlagener und der Verdächtige</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">the slain man and the suspect</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-14.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de">inquiratur <hi rend="italic">hinzuzudenken</hi></seg><seg type="translation" xml:lang="en" source="#claude">inquiratur to be understood</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-14.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de">weral. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">weral. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-14.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de">pernegendum (<hi rend="italic">so</hi>) <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">pernegendum (<hi rend="italic">sic</hi>) <hi rend="italic">K Co Or Gi</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-14.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de">-tum <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tum Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-14.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg K;</hi> per <hi rend="italic">Co Or Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing Sc Hg K; per Co Or Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-14.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Sc;</hi> terminum <hi rend="italic">statt</hi> i. u. <hi rend="italic">übrige Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Sc; terminum instead of i. u. the others, Wi Tho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-14.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de">-runt <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-runt <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-14.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de">-rant <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rant <hi rend="italic">Sc</hi></seg></note>
