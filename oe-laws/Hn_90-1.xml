    <body>
      <div type="clause" n="90.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 90.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 90.1" corresp="#wit-lat"><pb n="605" ed="#liebermann"/>Si<ptr type="liebermannNote" n="d" target="#Hn_90-1.lnote.oe.d"/> quis dum<ptr type="liebermannNote" n="28" target="#Hn_90-1.lnote.oe.28"/> inter se dimicantes diuidere satagit, ex industria uel incuria decertancium<ptr type="liebermannNote" n="29" target="#Hn_90-1.lnote.oe.29"/> occidatur innocens, reddat eum qui occidit, quamuis rixam non incepit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 605 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur den Fall, nicht die Entscheidung giebt inhaltlich, nicht im Ausdruck, verwandt Lex Visigot.</hi> VI 5, 5: Si exorta cede, ad faciendam pacem quicumque … aduenerit et … mori contigerit, adque … uolumtatis eius (<hi rend="italic">des Tödters</hi>) non fuit</seg><seg type="translation" xml:lang="en" source="#claude">Lex Visigot. VI 5, 5, related in content though not in wording, gives only the case, not the decision: Si exorta cede, ad faciendam pacem quicumque … aduenerit et … mori contigerit, adque … uolumtatis eius (of the slayer) non fuit</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-1.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">d. i. se <hi rend="italic">doppelt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">i.e. se twice Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-1.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">decret. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">decret. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Absicht 7d—90, 2 <hi rend="italic">ad</hi>{31} <hi rend="italic">al. p</hi>. ohne <hi rend="italic">cap</hi>. Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Absicht 7d—90, 2 <hi rend="italic">ad</hi>{31} <hi rend="italic">al. p</hi>. without <hi rend="italic">cap</hi>. Rs</seg></note>
