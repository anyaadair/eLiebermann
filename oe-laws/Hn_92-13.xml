      <div type="clause" n="92.13">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 92.13</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 92.13" corresp="#wit-lat"><pb n="608" ed="#liebermann"/>Si alicui iure<ptr type="liebermannNote" n="n" target="#Hn_92-13.lnote.oe.n"/> non creditur, quod ei<ptr type="liebermannNote" n="o" target="#Hn_92-13.lnote.oe.o"/> pertineat<ptr type="liebermannNote" n="31" target="#Hn_92-13.lnote.oe.31"/>, iudicio<ptr type="liebermannNote" n="p" target="#Hn_92-13.lnote.oe.p"/> probet.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 608 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-13.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> iuramento</seg><seg type="translation" xml:lang="en" source="#claude">read iuramento</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-13.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de">dass <hi rend="italic">Ermordeter</hi> ihm, <hi rend="italic">dem Kläger,</hi> verwandt ist</seg><seg type="translation" xml:lang="en" source="#claude">that <hi rend="italic">the murdered man</hi> is related to him, <hi rend="italic">the plaintiff</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-13.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de">Gottesurtheil</seg><seg type="translation" xml:lang="en" source="#claude">ordeal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-13.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de">iure creditur <hi rend="italic">nochmals Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">iure creditur repeated Sc Hg</seg></note>
      </div>
