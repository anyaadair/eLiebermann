      <div type="clause" n="57.6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 57.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 57.6" corresp="#wit-lat"><pb n="576" ed="#liebermann"/>Inter homines aliorum comitatuum obseruetur, ut de<ptr type="liebermannNote" n="m" target="#Hn_57-6.lnote.oe.m"/> tihla<ptr type="liebermannNote" n="19" target="#Hn_57-6.lnote.oe.19"/> pariter ueniant<ptr type="liebermannNote" n="20" target="#Hn_57-6.lnote.oe.20"/> in curias<ptr type="liebermannNote" n="n" target="#Hn_57-6.lnote.oe.n"/> uel<ptr type="liebermannNote" n="21" target="#Hn_57-6.lnote.oe.21"/> hundreta<ptr type="liebermannNote" n="22" target="#Hn_57-6.lnote.oe.22"/> uel congrua causarum loca, tantum<ptr type="liebermannNote" n="23" target="#Hn_57-6.lnote.oe.23"/>, si opus est, datis plegiis rectum faciendi, si crauentur<ptr type="liebermannNote" n="24" target="#Hn_57-6.lnote.oe.24"/> ibi<ptr type="liebermannNote" n="nn" target="#Hn_57-6.lnote.oe.nn"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 576 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-6.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im Gegensatz zu Handhaftem</hi> (57, 7) <hi rend="italic">wie</hi> 9, 6</seg><seg type="translation" xml:lang="en" source="#claude">in contrast to a man taken in the act (57, 7), as 9, 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-6.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">am Wohnort des Beklagten</hi></seg><seg type="translation" xml:lang="en" source="#claude">at the defendant’s place of residence</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-6.lnote.oe.nn" n="nn" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">am Verhaftungsort</hi></seg><seg type="translation" xml:lang="en" source="#claude">at the place of arrest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-6.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">thih. <hi rend="italic">Sc;</hi> thila <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">thih. Sc; thila Lond</seg></note>
