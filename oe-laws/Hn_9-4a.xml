      <div type="clause" n="9.4a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 9.4a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 9.4a" corresp="#wit-lat"><pb n="555" ed="#liebermann"/>Transeunt autem multis modis<ptr type="liebermannNote" n="15" target="#Hn_9-4a.lnote.oe.15"/>, alia intrinsecis<ptr type="liebermannNote" n="20" target="#Hn_9-4a.lnote.oe.20"/> alia extrinsecis accidenciis, secundum industriam<ptr type="liebermannNote" n="kk" target="#Hn_9-4a.lnote.oe.kk"/> uel insciciam<ptr type="liebermannNote" n="21" target="#Hn_9-4a.lnote.oe.21"/> concausancium<ptr type="liebermannNote" n="22" target="#Hn_9-4a.lnote.oe.22"/>, secundum socam<ptr type="liebermannNote" n="23" target="#Hn_9-4a.lnote.oe.23"/> prelatorum<ptr type="liebermannNote" n="24" target="#Hn_9-4a.lnote.oe.24"/>, quam quidam habent in suo<ptr type="liebermannNote" n="l" target="#Hn_9-4a.lnote.oe.l"/> de suis, quidam<ptr type="liebermannNote" n="25" target="#Hn_9-4a.lnote.oe.25"/> de suis et<ptr type="liebermannNote" n="26" target="#Hn_9-4a.lnote.oe.26"/> extraneis, siue in omnibus<ptr type="liebermannNote" n="m" target="#Hn_9-4a.lnote.oe.m"/> siue in quibusdam causis.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 555 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4a.lnote.oe.kk" n="kk" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">je nach Absicht oder Unkenntnis [= 22, 1] der Parteien, je nach Jurisdiction der Gerichtsherren</seg><seg type="translation" xml:lang="en" source="#claude">according to the design or ignorance [= 22, 1] of the parties, according to the jurisdiction of the lords of the courts</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4a.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">auf eigenem Boden über eigene Leute; <hi rend="italic">vgl.</hi> 59, 17</seg><seg type="translation" xml:lang="en" source="#claude">on his own land over his own men; cf. 59, 17</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4a.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">sachlich unbeschränkt</hi></seg><seg type="translation" xml:lang="en" source="#claude">unrestricted as to subject-matter</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4a.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4a.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. vom Corr. aus</hi> -cus a. extrinsecus <hi rend="italic">Sc;</hi> -ci a. extrinseci <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the corrector from -cus a. extrinsecus Sc; -ci a. extrinseci Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4a.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">-scisci. <hi rend="italic">Sc;</hi> iusticiam <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-scisci. Sc; iusticiam Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4a.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">caus. <hi rend="italic">K Co Or Gi;</hi> concertantium <hi rend="italic">Edd.; s. o.</hi> 3, 1</seg><seg type="translation" xml:lang="en" source="#claude">caus. K Co Or Gi; concertantium edd.; see above 3, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4a.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">socc. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">socc. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4a.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">placit. <hi rend="italic">Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">placit. edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4a.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. vom Corr. aus</hi> quidem <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the corrector from quidem Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4a.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. vom Corr. Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above by the corrector in Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-4a.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">317</biblScope></bibl><seg type="original" xml:lang="de">Übertragung des Prozesses an anderes Gericht vermutet Maitland <hi rend="italic">Domesday</hi> 292 schon in Mercischen Urkk. 9. Jhs. hinter dem Worte <hi rend="italic">vicissitudo</hi>, das ich aber = <hi rend="italic">vicis</hi> ‘Mal’ übersetze.—Vielleicht ist der ‘äussere Umstand’ hier die Zuständigkeit der privaten Gerichtsbarkeit (<hi rend="italic">s. d. Gl</hi> 37 ff.), der ‘innere’ das Benehmen der Parteien im Prozess.—<hi rend="italic">multis a. intrincecis</hi>{20} <hi rend="italic">a. extrincecis</hi> ohne <hi rend="italic">modis</hi>—<hi rend="italic">causancium</hi>{22} Rs</seg><seg type="translation" xml:lang="en" source="#claude">Maitland (<hi rend="italic">Domesday</hi> 292) suspects the transfer of a case to another court already in Mercian charters of the 9th cent., behind the word <hi rend="italic">vicissitudo</hi>, which, however, I translate = <hi rend="italic">vicis</hi> ‘time, occasion’.—Perhaps the ‘external circumstance’ here is the competence of private jurisdiction (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 37 ff.), the ‘internal’ one the conduct of the parties in the suit.—<hi rend="italic">multis a. intrincecis</hi>{20} <hi rend="italic">a. extrincecis</hi> without <hi rend="italic">modis</hi>—<hi rend="italic">causancium</hi>{22} Rs</seg></note>
      </div>
    </body>
