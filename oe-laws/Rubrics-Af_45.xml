        <head>Af Rb 45</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="45" corresp="#wit-e"><pb n="20" ed="#liebermann"/>XLI. Be feaxwunde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="45" corresp="#wit-ot-frag"><pb n="20" ed="#liebermann"/>… xwunde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="45" corresp="#wit-g-prol"><pb n="20" ed="#liebermann"/>XLI. Be feaxwunde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="45" corresp="#wit-h"><pb n="21" ed="#liebermann"/>XLI. Be feaxwunde.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="45" corresp="#wit-q"><pb n="21" ed="#liebermann"/>De<ptr type="liebermannNote" n="6" target="#Rubrics-Af_45.lnote.oe.6"/> plaga sub capillis.<ptr type="liebermannNote" n="5" target="#Rubrics-Af_45.lnote.oe.5"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="198" ed="#jurasinski-and-oliver"/>XLI Be feaxwunde</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="21" ed="#liebermann"/>Von Verwundung unter [Kopf]haar.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of a wound under the [head-]hair.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="199" ed="#jurasinski-and-oliver"/>Concerning a hair-wound</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_45.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Die 3 folg. Rubriken fehlen Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">The 3 following rubrics lacking in Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_45.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt T zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by T</seg></note>
