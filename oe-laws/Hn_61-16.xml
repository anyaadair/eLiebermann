    <body>
      <div type="clause" n="61.16">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 61.16</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 61.16" corresp="#wit-lat"><pb n="582" ed="#liebermann"/>Si sine domino aut<ptr type="liebermannNote" n="18" target="#Hn_61-16.lnote.oe.18"/> termino<ptr type="liebermannNote" n="19" target="#Hn_61-16.lnote.oe.19"/> placitare cogatur aliquis, iniustum est; et per iudicium poterunt<ptr type="liebermannNote" n="20" target="#Hn_61-16.lnote.oe.20"/> recapitulare<ptr type="liebermannNote" n="b" target="#Hn_61-16.lnote.oe.b"/> placitum eius et emendare.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 582 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-16.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> caput pl. 59, 7; <hi rend="italic">vgl.</hi> 61, 16</seg><seg type="translation" xml:lang="en" source="#claude">as caput pl. 59, 7; cf. 61, 16</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-16.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">sine <hi rend="italic">fügt zu K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">K Co add sine</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-16.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">testimonio <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">testimonio Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-16.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">potuer. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">potuer. Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-16.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de">Der Termin ist wohl der 61, 14 gemeinte <hi rend="italic">dominum habendi; vgl. Gl</hi> Vassallität 18a</seg><seg type="translation" xml:lang="en" source="#claude">The term is probably the one meant at 61, 14, <hi rend="italic">dominum habendi</hi>; <hi rend="italic">cf. Gl</hi> Vassallität 18a</seg></note>
      </div>
