      <div type="clause" n="57">
        <head><ref type="lawCode" target="law:Af">Af</ref> 57</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="57" corresp="#wit-e"><pb n="82" ed="#liebermann"/>Gif se scytefinger<ptr type="liebermannNote" n="10" target="#Af_57.lnote.oe.10"/> bið ófaslegen<ptr type="liebermannNote" n="7" target="#Af_57.lnote.oe.7"/>, sio<ptr type="liebermannNote" n="6" target="#Af_57.lnote.oe.6"/> bót bið XV<ptr type="liebermannNote" n="4" target="#Af_57.lnote.oe.4"/> scill.; his nægles<ptr type="liebermannNote" n="11" target="#Af_57.lnote.oe.11"/> bið III scill.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="57" corresp="#wit-h"><pb n="82" ed="#liebermann"/>Gif se scytefinger biþ ofaslægen, seo<ptr type="liebermannNote" n="4" target="#Af_57.lnote.oe.4-2"/> bot bið XV scll'; his nægles bið V<ptr type="liebermannNote" n="8" target="#Af_57.lnote.oe.8"/> scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="57" corresp="#wit-b-no-prol"><pb n="82" ed="#liebermann"/>Gyf se scytefinger bið ofaslagen, seo bot bið fiftyne scill'; ⁊ his nægles beoð IIII scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="57" corresp="#wit-q"><pb n="83" ed="#liebermann"/>Si secundus digitus (id est index uel salutatorius) amputetur<ptr type="liebermannNote" n="9" target="#Af_57.lnote.oe.9"/>, XV<ptr type="liebermannNote" n="10" target="#Af_57.lnote.oe.10-2"/> sol. culpa<ptr type="liebermannNote" n="11" target="#Af_57.lnote.oe.11-2"/> sit; unguis eius<ptr type="liebermannNote" n="12" target="#Af_57.lnote.oe.12"/> III<ptr type="liebermannNote" n="13" target="#Af_57.lnote.oe.13"/> solid.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="88" ed="#attenborough"/>Gif se scytefinger bið ófaslegen, sio bót bið XV scill.; his<ptr type="editorNote" n="7" target="#Af_57.attnote.fn.7"/> nægles bið III<ptr type="editorNote" n="8" target="#Af_57.attnote.fn.8"/> scill.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="60" corresp="#wit-e"><pb n="354" ed="#jurasinski-and-oliver"/>Gif se scytefinger bið ófaslegen, sio bót bið XV scill; his nægles bið III scill.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="83" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_57.lnote.de.1"/> der Zeigefinger<ptr type="liebermannNote" n="2" target="#Af_57.lnote.de.2"/> abgeschlagen ist, ist die Busse 15 Schill.; [die] seines Nagels ist 3<ptr type="liebermannNote" n="3" target="#Af_57.lnote.de.3"/> Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the forefinger is struck off, the compensation is 15 shillings; [that] for its nail is 3 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="89" ed="#attenborough"/>If the first finger<ptr type="editorNote" n="1" target="#Af_57.attnote.n.1"/> is struck off, the compensation [to be paid] shall be 15 shillings; for the nail of the same, 3<ptr type="editorNote" n="2" target="#Af_57.attnote.n.2"/> shillings [compensation shall be paid].</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="355" ed="#jurasinski-and-oliver"/>If the “shooting finger” is struck off, the compensation is 15 shillings; its nail is 3 shillings.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_11-1">Leis Wl 11.1</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_57.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">-fynger <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-fynger Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_57.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">ofaslagen <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ofaslagen Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_57.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">seo bote <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">seo bote Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_57.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">fyftyne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fyftyne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_57.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">nægl beoþ IIII s. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">nægl beoþ IIII s. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_57.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_57.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_57.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">alicui <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">alicui added by Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_57.lnote.oe.10-2" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Hn</hi> 93, 16; VX (<hi rend="italic">so</hi>) <hi rend="italic">R;</hi> XX <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Hn 93, 16; VX (sic) R; XX the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_57.lnote.oe.11-2" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">emendetur <hi rend="italic">statt</hi> c. sit <hi rend="italic">HkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">emendetur instead of c. sit HkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_57.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt R</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_57.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">quattuor <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">quattuor R</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_57.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Finger 3g</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Finger 3g</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_57.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Durch Abt 54b beeinflusst</seg><seg type="translation" xml:lang="en" source="#claude">Influenced by Abt 54b</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_57.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Lesart II Inst. (5) ist wahrscheinlich richtig; <hi rend="italic">s. ebd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">The reading II Inst. (5) is probably correct; <hi rend="italic">see ibid.</hi></seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_57.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">88</biblScope></bibl><label>his</label><seg type="original" xml:lang="en"><hi rend="italic">⁊ his</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_57.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">88</biblScope></bibl><label>iii</label><seg type="original" xml:lang="en"><hi rend="italic"><hi rend="smallcaps">iiii</hi></hi>. B. <hi rend="italic"><hi rend="smallcaps">v</hi></hi>. H.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_57.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">199</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">scyte-finger; digitus secundus quo sagittatur</hi> (B. and T.).</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_57.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">199</biblScope></bibl><seg type="original" xml:lang="en">According to Liebermann, the reading of H (v shillings) is probably correct.</seg></note>
      </div>
