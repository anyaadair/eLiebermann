    <body>
      <div type="clause" n="11.1 B">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 11.1 B</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 11.1 B"><pb n="636" ed="#liebermann"/><hi rend="spaced">Epistola<ptr type="liebermannNote" n="f" target="#ECf_11-1-B.lnote.la.fn.f"/> domini Eleutherii<ptr type="liebermannNote" n="11" target="#ECf_11-1-B.lnote.la.11"/> Lucio<ptr type="liebermannNote" n="g" target="#ECf_11-1-B.lnote.la.fn.g"/> regi Britannie.</hi> Anno centesimo sexagesimo<ptr type="liebermannNote" n="h" target="#ECf_11-1-B.lnote.la.fn.h"/> nono a passione Christi scripsit<ptr type="liebermannNote" n="12" target="#ECf_11-1-B.lnote.la.12"/> dominus Eleutherius<ptr type="liebermannNote" n="11" target="#ECf_11-1-B.lnote.la.11"/> papa Lucio regi Brytannie ad petitionem<ptr type="liebermannNote" n="13" target="#ECf_11-1-B.lnote.la.13"/> regis et procerum regni Britannie:</ab>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 636 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">This passage is not part of ECf or ECf retr: it is one of the additions of the London collection (Leges Anglorum s. XIII in. Londoniis collectae), which Liebermann prints in smaller type across the page, under ECf retr. 11, 1, and numbers 11, 1 A ff. The dictionary cites it as “ECf 11, 1 A …”, so it is kept with ECf here.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_11-1-B.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">erfunden durch</hi> Lond; <hi rend="italic">vgl. mein</hi> Leges Angl. <hi rend="italic">S.</hi> 40</seg><seg type="translation" xml:lang="en" source="#claude">invented by Lond; cf. my Leges Angl. p. 40</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_11-1-B.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">die Geschichte, dass Lucius zu Eleuther sandte, ward vor</hi> 700 <hi rend="italic">geschmiedet; Haverfield</hi> Engl. hist. rev. 1896 <hi rend="italic">p.</hi> 419</seg><seg type="translation" xml:lang="en" source="#claude">the story that Lucius sent to Eleutherius was forged before 700; Haverfield, Engl. hist. rev. 1896 p. 419</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_11-1-B.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de">alias 156 <hi rend="italic">Ld; vgl.</hi> 11, 1 A 5</seg><seg type="translation" xml:lang="en" source="#claude">alias 156 Ld; cf. 11, 1 A 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1-B.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de">Eulench. <hi rend="italic">Co Or;</hi> Euleth. <hi rend="italic">K;</hi> Elut. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Eulench. Co Or; Euleth. K; Elut. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1-B.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de">d. Elut. p. L. r. B. s. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. Elut. p. L. r. B. s. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1-B.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de">correctionem <hi rend="italic">K;</hi> corr. <hi rend="italic">auf Rasur Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">correctionem K; corr. over an erasure Or</seg></note>
      </div>
