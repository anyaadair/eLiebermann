      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:IudDeiXIV">Iud Dei XIV</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIV 1.1" corresp="#wit-lat"><pb n="425" ed="#liebermann"/>Panis ordeaceus<ptr type="liebermannNote" n="3" target="#IudDeiXIV_1-1.lnote.oe.3"/> esse<ptr type="liebermannNote" n="4" target="#IudDeiXIV_1-1.lnote.oe.4"/> debet siccus<ptr type="liebermannNote" n="5" target="#IudDeiXIV_1-1.lnote.oe.5"/> et caseus caprinus<ptr type="liebermannNote" n="5" target="#IudDeiXIV_1-1.lnote.oe.5"/> aridus<ptr type="liebermannNote" n="6" target="#IudDeiXIV_1-1.lnote.oe.6"/>.<ptr type="liebermannNote" n="b" target="#IudDeiXIV_1-1.lnote.oe.b"/></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 425 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_1-1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">Quę appensio sit unius uncię. Primitus faciat sacerdos letanias; et omnes qui aderunt sint ieiuni <hi rend="italic">fügt zu Tr</hi> [<hi rend="italic">aus</hi> III <hi rend="italic">Inscr.</hi>, 1, <hi rend="italic">oben S.</hi> 408].</seg><seg type="translation" xml:lang="en" source="#claude">Quę appensio sit unius uncię. Primitus faciat sacerdos letanias; et omnes qui aderunt sint ieiuni added by Tr [from III Inscr., 1, above p. 408].</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_1-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">ho. <hi rend="italic">Ei;</hi> -atius <hi rend="italic">Bb;</hi> d. esse o. et s. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">ho. Ei; -atius Bb; d. esse o. et s. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_1-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">e. d. s. <hi rend="italic">fehlt Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. d. s. omitted in Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_1-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">siccus et caprinus <hi rend="italic">auch Zeu.</hi> 650&lt;sub&gt;2&lt;/sub&gt;</seg><seg type="translation" xml:lang="en" source="#claude">siccus et caprinus also Zeu. 650&lt;sub&gt;2&lt;/sub&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_1-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr</seg></note>
      </div>
