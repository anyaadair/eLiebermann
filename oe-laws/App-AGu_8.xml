      <div type="clause" n="8">
        <head>App AGu 8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="App AGu 8" corresp="#wit-q"><ptr type="liebermannNote" n="15" target="#App-AGu_8.lnote.oe.15"/><pb n="395" ed="#liebermann"/>Cogitate etiam<ptr type="liebermannNote" n="16" target="#App-AGu_8.lnote.oe.16"/> qui<ptr type="liebermannNote" n="17" target="#App-AGu_8.lnote.oe.17"/> mei estis, quam<ptr type="liebermannNote" n="18" target="#App-AGu_8.lnote.oe.18"/> incongruum uideatur, si nomen<ptr type="liebermannNote" n="19" target="#App-AGu_8.lnote.oe.19"/> regis habeam, et non secundum<ptr type="liebermannNote" n="***" target="#App-AGu_8.lnote.oe.star3"/> potentiam; uel quid ambit<ptr type="liebermannNote" n="20" target="#App-AGu_8.lnote.oe.20"/><ptr type="liebermannNote" n="†" target="#App-AGu_8.lnote.oe.dagger"/> homo domino suo, si<ptr type="liebermannNote" n="††" target="#App-AGu_8.lnote.oe.dagger2"/> secus ei non ambiat et competentiam?<ptr type="liebermannNote" n="21" target="#App-AGu_8.lnote.oe.21"/><ptr type="liebermannNote" n="†††" target="#App-AGu_8.lnote.oe.___"/></ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="395" ed="#liebermann"/>8. Bedenkt auch, die ihr meine [Vasallen] seid, wie [sehr] unangemessen es scheint, wenn ich den Namen des Königs trage und nicht gemäss der Macht; oder was gönnt ein Vasall seinem Herrn, wenn anders er ihm nicht auch die geziemende Machtbefugniss gönnt?</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">8. Consider also, you who are my [vassals], how [very] unfitting it seems if I bear the name of king and not according to the power; or what does a vassal grant his lord, if he does not otherwise grant him also the fitting authority?</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text and German translation transcribed from Gesetze I p. 395 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="App-AGu_8.lnote.oe.star3" n="***" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">395</biblScope></bibl><seg type="original" xml:lang="de">æfter <hi rend="italic">Vorlage?</hi></seg><seg type="translation" xml:lang="en" source="#claude">æfter in the original?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="App-AGu_8.lnote.oe.dagger" n="†" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">395</biblScope></bibl><seg type="original" xml:lang="de">gean <hi rend="italic">Vorlage?</hi></seg><seg type="translation" xml:lang="en" source="#claude">gean in the original?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="App-AGu_8.lnote.oe.dagger2" n="††" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">395</biblScope></bibl><seg type="original" xml:lang="de">gif elles <hi rend="italic">Vorlage?</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif elles in the original?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="App-AGu_8.lnote.oe.___" n="†††" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">395</biblScope></bibl><seg type="original" xml:lang="de">þa gerysnu <hi rend="italic">Swer</hi> 1; <hi rend="italic">Wif</hi> 1</seg><seg type="translation" xml:lang="en" source="#claude">þa gerysnu <hi rend="italic">Swer</hi> 1; <hi rend="italic">Wif</hi> 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="App-AGu_8.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">395</biblScope></bibl><seg type="original" xml:lang="de">8 <hi rend="italic">fehlt Br;</hi> VIII <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">8 omitted in Br; VIII added by Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="App-AGu_8.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">395</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt TMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in TMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="App-AGu_8.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">395</biblScope></bibl><seg type="original" xml:lang="de">quia <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">quia Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="App-AGu_8.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">395</biblScope></bibl><seg type="original" xml:lang="de">quam <hi rend="italic">bis Ende fehlt K; am unteren Rande nachgetragen Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">quam to the end omitted in K; added in the lower margin in Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="App-AGu_8.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">395</biblScope></bibl><seg type="original" xml:lang="de">r. n. <hi rend="italic">TMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. n. TMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="App-AGu_8.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">395</biblScope></bibl><seg type="original" xml:lang="de">amabit honco <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">amabit honco MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="App-AGu_8.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">395</biblScope></bibl><seg type="original" xml:lang="de">compenciam <hi rend="italic">Co Or;</hi> compotenciam <hi rend="italic">Hk; folgt</hi> EGu.</seg><seg type="translation" xml:lang="en" source="#claude">compenciam Co Or; compotenciam Hk; EGu. follows</seg></note>
