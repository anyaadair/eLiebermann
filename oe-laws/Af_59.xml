    <body>
      <div type="clause" n="59">
        <head><ref type="lawCode" target="law:Af">Af</ref> 59</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="59" corresp="#wit-e"><pb n="82" ed="#liebermann"/>Gif se goldfinger sie<ptr type="liebermannNote" n="5" target="#Af_59.lnote.oe.5"/> ófaslegen<ptr type="liebermannNote" n="7" target="#Af_59.lnote.oe.7"/>, to þam<ptr type="liebermannNote" n="15" target="#Af_59.lnote.oe.15"/> sculon XVII<ptr type="liebermannNote" n="16" target="#Af_59.lnote.oe.16"/> scill. to bote; ⁊ his nægles IIII scill. to<ptr type="liebermannNote" n="17" target="#Af_59.lnote.oe.17"/> bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="59" corresp="#wit-h"><pb n="82" ed="#liebermann"/>Gif se goldfinger bið ofaslægen, to ðæm<ptr type="liebermannNote" n="6" target="#Af_59.lnote.oe.6"/> sculon XVII scll' to bote; ⁊ his nægles IIII scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="59" corresp="#wit-b-no-prol"><pb n="82" ed="#liebermann"/>Gyf se goldfinger sy ofaslægen, to ðæm sculon seofentyne scill' to bote; ⁊ his<ptr type="liebermannNote" n="2" target="#Af_59.lnote.oe.2"/> nægles IIII scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="59" corresp="#wit-q"><pb n="83" ed="#liebermann"/>Si quartus qui anularis dicitur amputetur, XVII sol. culpa<ptr type="liebermannNote" n="16" target="#Af_59.lnote.oe.16-2"/> iudicetur<ptr type="liebermannNote" n="17" target="#Af_59.lnote.oe.17-2"/>; unguis<ptr type="liebermannNote" n="15" target="#Af_59.lnote.oe.15-2"/> IIII sol.<ptr type="liebermannNote" n="18" target="#Af_59.lnote.oe.18"/> emendetur.<ptr type="liebermannNote" n="19" target="#Af_59.lnote.oe.19"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="88" ed="#attenborough"/>Gif se goldfinger sie<ptr type="editorNote" n="10" target="#Af_59.attnote.fn.10"/> ofaslegen, to þam sculon XVII scill. to bote; ⁊ his nægles IIII scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="62" corresp="#wit-e"><pb n="356" ed="#jurasinski-and-oliver"/>Gif se goldfinger sie ofaslegen, to þam sculon XVII scill to bote; ⁊ his nægles IIII scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="83" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_59.lnote.de.1"/> der Goldfinger<ptr type="liebermannNote" n="2" target="#Af_59.lnote.de.2"/> abgeschlagen ist, dafür gehören 17 Schill. zur Busse, und 4 Schill. zu seines Nagels Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the gold-finger [ring finger] is struck off, 17 shillings are due for it as compensation, and 4 shillings for its nail’s compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="89" ed="#attenborough"/>If the third finger<ptr type="editorNote" n="1" target="#Af_59.attnote.n.1"/> is struck off, 17 shillings must be paid as compensation for it; and for the nail of the same, 4 shillings [must be paid] as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="357" ed="#jurasinski-and-oliver"/>If the ring finger175 is struck off, for that 17 shillings shall be compensation; and for its nail 4 shillings as compensation.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_11-1">Leis Wl 11.1</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_59.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">biþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">biþ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_59.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">ofaslagen <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ofaslagen Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_59.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_59.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">seofontyne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">seofontyne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_59.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">to b. <hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">to b. lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_59.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">æ <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">æ on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_59.lnote.oe.16-2" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">c. i. <hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. i. lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_59.lnote.oe.17-2" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">sit <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_59.lnote.oe.15-2" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius added by Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_59.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_59.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_59.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">h. n. <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. n. on an erasure</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_59.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Finger 3h, auch bei anderen Germanen höher als Mittelfinger bewertet; Wilda 768</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Finger 3h; among other Germanic peoples too it is valued more highly than the middle finger; Wilda 768</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_59.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Durch Abt 54d beeinflusst</seg><seg type="translation" xml:lang="en" source="#claude">Influenced by Abt 54d</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_59.attnote.fn.10" n="10" source="#attenborough"><bibl><biblScope unit="page">88</biblScope></bibl><label>sie</label><seg type="original" xml:lang="en"><hi rend="italic">bið</hi>. H.</seg><note type="remark" resp="#claude">The number 10 is printed 2 times on the page (58, 59), with one footnote.</note></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_59.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">199</biblScope></bibl><seg type="original" xml:lang="en">Lit. ‘ring-finger’; <hi rend="italic">auricularis</hi>, Henr. cap. 93 § 19.</seg></note>
      </div>
