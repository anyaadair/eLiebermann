      <div type="clause" n="22.5">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 22.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 22.5" corresp="#wit-lat"><pb n="405" ed="#liebermann"/>Innocentes<ptr type="liebermannNote" n="45" target="#IudDeiI_22-5.lnote.oe.45"/> uero a praedicto crimine more aquae in te recipias et in profundum innocuos<ptr type="liebermannNote" n="46" target="#IudDeiI_22-5.lnote.oe.46"/> pertrahas. Per dominum<ptr type="liebermannNote" n="47" target="#IudDeiI_22-5.lnote.oe.47"/> nostrum<ptr type="liebermannNote" n="48" target="#IudDeiI_22-5.lnote.oe.48"/>.<ptr type="liebermannNote" n="b" target="#IudDeiI_22-5.lnote.oe.b"/></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 405 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-5.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. oben</hi> 2, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. above 2, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-5.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">-tem (<hi rend="italic">darüber</hi> -tes <hi rend="italic">H</hi>) <hi rend="italic">Ch Ca H;</hi> -tes, <hi rend="italic">darüber</hi> -tem <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tem (with -tes above it H) Ch Ca H; -tes, with -tem above it, Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-5.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">innocuę <hi rend="italic">Ch Ci Ca H Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">innocuę Ch Ci Ca H Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-5.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">d. n. <hi rend="italic">fehlt Ci;</hi> uirtutem domini nostri Iesu Christi (<hi rend="italic">Ch Co</hi>), qui uenturus est <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. n. omitted in Ci; uirtutem domini nostri Iesu Christi (Ch Co), qui uenturus est Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-5.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt H;</hi> Iesum Christum filium tuum, qui tecum. Amen <hi rend="italic">fügt zu Rj. Hier schiebt Ca ein:</hi> Iud. Dei VIII; <hi rend="italic">in Co folgt unten</hi> XV</seg><seg type="translation" xml:lang="en" source="#claude">omitted in H; Iesum Christum filium tuum, qui tecum. Amen added by Rj. Here Ca inserts: Iud. Dei VIII; in Co there follows XV below</seg></note>
      </div>
