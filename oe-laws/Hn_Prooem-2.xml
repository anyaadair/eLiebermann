      <div type="clause" n="Prooem 2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> Prooem 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn Prooem 2" corresp="#wit-lat"><pb n="547" ed="#liebermann"/>Quem Deus felicibus auspiciis et salutari, quesumus<ptr type="liebermannNote" n="4" target="#Hn_Prooem-2.lnote.oe.4"/>, corporis et anime prosperitate<ptr type="liebermannNote" n="5" target="#Hn_Prooem-2.lnote.oe.5"/>, cum coniuge sua inclita Matilde<ptr type="liebermannNote" n="6" target="#Hn_Prooem-2.lnote.oe.6"/> secunda et eorum<ptr type="liebermannNote" n="7" target="#Hn_Prooem-2.lnote.oe.7"/> liberis, longis seculorum seculis et eterna pace gentis nostre<ptr type="liebermannNote" n="8" target="#Hn_Prooem-2.lnote.oe.8"/> faciat imperare!<ptr type="liebermannNote" n="9" target="#Hn_Prooem-2.lnote.oe.9"/></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 547 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_Prooem-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">547</biblScope></bibl><seg type="original" xml:lang="de">quauis <hi rend="italic">Edd.</hi> [<hi rend="italic">falsch</hi>]; q̄s <hi rend="italic">Sc Hg;</hi> qm̄s <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">quauis Edd. [wrong]; q̄s Sc Hg; qm̄s Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_Prooem-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">547</biblScope></bibl><seg type="original" xml:lang="de">-tem <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tem Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_Prooem-2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">547</biblScope></bibl><seg type="original" xml:lang="de">-da <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-da Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_Prooem-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">547</biblScope></bibl><seg type="original" xml:lang="de">ear. <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">ear. Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_Prooem-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">547</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_Prooem-2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">547</biblScope></bibl><seg type="original" xml:lang="de">impetrare <hi rend="italic">K Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">impetrare K Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_Prooem-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">314</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">quesumus</hi>{4} ausgeschrieben—<hi rend="italic">Matilde</hi>{6}—{8}<hi rend="italic">nostre</hi> fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">quesumus</hi>{4} written out in full—<hi rend="italic">Matilde</hi>{6}—{8}<hi rend="italic">nostre</hi> missing in Rs</seg></note>
