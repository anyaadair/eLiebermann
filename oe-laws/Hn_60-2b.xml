      <div type="clause" n="60.2b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 60.2b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 60.2b" corresp="#wit-lat"><pb n="580" ed="#liebermann"/>Si uicinus et compar sit<ptr type="liebermannNote" n="37" target="#Hn_60-2b.lnote.oe.37"/> eius cum quo agitur et alterius dominii, contramandet placitum ad numerum<ptr type="liebermannNote" n="u" target="#Hn_60-2b.lnote.oe.u"/> comitatuum secundum legem et iterum et tercio, si opus<ptr type="liebermannNote" n="38" target="#Hn_60-2b.lnote.oe.38"/> sit<ptr type="liebermannNote" n="39" target="#Hn_60-2b.lnote.oe.39"/> tanto:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 580 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_60-2b.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Bezug auf</hi> 59, 2<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">refers to</hi> 59, 2<hi rend="italic">b</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_60-2b.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de">e. sit <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. sit <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_60-2b.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de">tm̄ <hi rend="italic">unterpunctirt fügt zu Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">tm̄ <hi rend="italic">underdotted, added by Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_60-2b.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de">t. sit <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. sit <hi rend="italic">Lond</hi></seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">If he is a neighbour and the equal of the man with whom the case is being pursued, and of another lordship, let him countermand the plea for the number of shire courts according to law, both a second and a third time, if there is need for so much:</ab>
      </div>
