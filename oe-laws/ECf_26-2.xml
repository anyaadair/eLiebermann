    <body>
      <div type="clause" n="26.2">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 26.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 26.2"><pb n="650" ed="#liebermann"/>Quodsi confidens in pace quam habet<ptr type="liebermannNote" n="24" target="#ECf_26-2.lnote.la.24"/>, per superbiam forisfecerit<ptr type="liebermannNote" n="25" target="#ECf_26-2.lnote.la.25"/> alicui, restauret dampnum et iterum<ptr type="liebermannNote" n="i" target="#ECf_26-2.lnote.la.fn.i"/> tantumdem<ptr type="liebermannNote" n="26" target="#ECf_26-2.lnote.la.26"/>, quod Angli uocant a[f]trigelt<ptr type="liebermannNote" n="27" target="#ECf_26-2.lnote.la.27"/> [b]et[e<ptr type="liebermannNote" n="k" target="#ECf_26-2.lnote.la.fn.k"/>]; forisfacturam<ptr type="liebermannNote" n="28" target="#ECf_26-2.lnote.la.28"/>!</ab>
        <note type="comparison" source="#liebermann" n="650"><label>printed alongside</label> <ref target="clause:ECfRetr_26-2">ECf retr 26.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 650 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “iterum” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_26-2.lnote.la.fn.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">iterum tantum <hi rend="italic">In. Cn.</hi> II 24, 1 <hi rend="italic">für</hi> æftergyld</seg><seg type="translation" xml:lang="en" source="#claude">iterum tantum In. Cn. II 24, 1 for æftergyld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_26-2.lnote.la.fn.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">oder hatte Orig.</hi> æftrigilt; et for.? <hi rend="italic">letztere Ellipse auch</hi> 12, 8. 38, 2</seg><seg type="translation" xml:lang="en" source="#claude">or did the original have æftrigilt; et for.? the latter ellipsis also at 12, 8. 38, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_26-2.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad Do add et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_26-2.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_26-2.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">tandem <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">tandem Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_26-2.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt im Text,</hi> ersthigelt hechta <hi rend="italic">am Rande Rl;</hi> atrihilthet <hi rend="italic">Hk;</hi> astrikibthet <hi rend="italic">S;</hi> alst’kibthet <hi rend="italic">Hr;</hi> bote per f. <hi rend="italic">Ad Do;</hi> astrikebbet <hi rend="italic">Cl;</hi> a twifeld bot <hi rend="italic">schlägt vor Somner bei Wilkins</hi> Leg. Anglosax. 398; a threefold bot <hi rend="italic">Stubbs</hi> Rog. Hoved. IV 193</seg><seg type="translation" xml:lang="en" source="#claude">lacking in the text, ersthigelt hechta in the margin Rl; atrihilthet Hk; astrikibthet S; alst’kibthet Hr; bote per f. Ad Do; astrikebbet Cl; Somner in Wilkins, Leg. Anglosax. 398, suggests a twifeld bot; a threefold bot Stubbs, Rog. Hoved. IV 193</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_26-2.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl;</hi> dñt <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl; Hk adds dñt</seg></note>
      </div>
    </body>
