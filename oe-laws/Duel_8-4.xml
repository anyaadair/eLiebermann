      <div type="clause" n="8.4">
        <head><ref type="lawCode" target="law:Duel">Duel</ref> 8.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Duel 8.4" corresp="#wit-lat"><ptr type="liebermannNote" n="60" target="#Duel_8-4.lnote.oe.60"/><ptr type="liebermannNote" n="61" target="#Duel_8-4.lnote.oe.61"/><pb n="431" ed="#liebermann"/>Sit tibi Trinitas sancta protectio uera, uictoria perfecta! Amen<ptr type="liebermannNote" n="62" target="#Duel_8-4.lnote.oe.62"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 431 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_8-4.lnote.oe.60" n="60" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">8, 4 <hi rend="italic">nur Tr Mg; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">8, 4 only in Tr Mg; missing in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_8-4.lnote.oe.61" n="61" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">Alia <hi rend="italic">fügt zu Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">Alia added in Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_8-4.lnote.oe.62" n="62" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> Cum iuuenis cupit (<hi rend="italic">darüber</hi> -es -iunt) accingi gladio. Benedictio ensis <hi rend="italic">Tr; Rest der Seite leer Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">followed by Cum iuuenis cupit (above it -es -iunt) accingi gladio. Benedictio ensis Tr; rest of the page blank Mg</seg></note>
      </div>
