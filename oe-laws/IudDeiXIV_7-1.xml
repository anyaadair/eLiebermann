      <div type="clause" n="7.1">
        <head><ref type="lawCode" target="law:IudDeiXIV">Iud Dei XIV</ref> 7.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIV 7.1" corresp="#wit-lat"><pb n="426" ed="#liebermann"/>Adiuro te per sanctos apostolos<ptr type="liebermannNote" n="19" target="#IudDeiXIV_7-1.lnote.oe.19"/> eius et omnem miliciam caelestem, ut, si quis<ptr type="liebermannNote" n="20" target="#IudDeiXIV_7-1.lnote.oe.20"/> ex his sumere uoluerit<ptr type="liebermannNote" n="21" target="#IudDeiXIV_7-1.lnote.oe.21"/>, qui de his quae in isto breuiculo continentur contaminatus non est, salubris et leuis ei<ptr type="liebermannNote" n="22" target="#IudDeiXIV_7-1.lnote.oe.22"/> efficiaris esca ad sumendum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 426 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_7-1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">angelos</hi> <hi rend="italic">Ma und Hss. bei Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">angelos</hi> Ma and MSS in Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_7-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de">qui <hi rend="italic">Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_7-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de">te <hi rend="italic">fügen zu Hss. bei Zeumer</hi></seg><seg type="translation" xml:lang="en" source="#claude">te added in MSS in Zeumer</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_7-1.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de">ef. ei <hi rend="italic">Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">ef. ei Vt</seg></note>
