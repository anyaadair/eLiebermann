      <div type="clause" n="21.3">
        <head><ref type="lawCode" target="law:IudDeiXII">Iud Dei XII</ref> 21.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XII 21.3" corresp="#wit-lat"><pb n="422" ed="#liebermann"/>Discedant omnes insidię latentis inimici, quatinus ueritas de his, quę á nobis diuini sensus et alterius cordis ignaris requiruntur, tuo iuditio expetita, per inuocationem sancti<ptr type="liebermannNote" n="6" target="#IudDeiXII_21-3.lnote.oe.6"/> tui nominis patefacta clarescant<ptr type="liebermannNote" n="7" target="#IudDeiXII_21-3.lnote.oe.7"/>;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 422 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_21-3.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">422</biblScope></bibl><seg type="original" xml:lang="de">t. s. <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. s. Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_21-3.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">422</biblScope></bibl><seg type="original" xml:lang="de">-scat <hi rend="italic">besser meiste Hss. Zeu.’s</hi></seg><seg type="translation" xml:lang="en" source="#claude">-scat better, most of Zeu.’s MSS</seg></note>
      </div>
