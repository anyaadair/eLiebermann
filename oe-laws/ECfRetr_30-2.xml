      <div type="clause" n="30.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 30.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 30.2"><pb n="652" ed="#liebermann"/>Et non sine causa: Cum enim<ptr type="liebermannNote" n="35" target="#ECfRetr_30-2.lnote.la.35"/> quis accipiebat prefecturam<ptr type="liebermannNote" n="36" target="#ECfRetr_30-2.lnote.la.36"/> wapentagii, die statuto in loco, ubi <hi rend="bold">consueuerant</hi><ptr type="liebermannNote" n="37" target="#ECfRetr_30-2.lnote.la.37"/> congregari, omnes maiores <hi rend="bold">natu</hi> contra eum conueniebant; et, descendente eo<ptr type="liebermannNote" n="38" target="#ECfRetr_30-2.lnote.la.38"/> de equo suo, omnes<ptr type="liebermannNote" n="39" target="#ECfRetr_30-2.lnote.la.39"/> assurgebant<ptr type="liebermannNote" n="40" target="#ECfRetr_30-2.lnote.la.40"/> <hi rend="bold">ei.</hi></ab>
        <note type="comparison" source="#liebermann" n="652"><label>printed alongside</label> <ref target="clause:ECf_30-2">ECf 30.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 652 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-2.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lb L Va Ph K;</hi> e. q. <hi rend="italic">fehlt Hv;</hi> q. e. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lb L Va Ph K; e. q. lacking in Hv; q. e. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-2.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">prepositurаm <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">prepositurаm Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-2.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">solent congregare <hi rend="italic">Hv originaler</hi></seg><seg type="translation" xml:lang="en" source="#claude">solent congregare Hv, more original</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-2.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">eodem <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">eodem Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-2.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">a. o. <hi rend="italic">Lb Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. o. Lb Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-2.lnote.la.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">surg. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">surg. Cb</seg></note>
