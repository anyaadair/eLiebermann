      <div type="clause" n="16">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 16</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 16"><pb n="642" ed="#liebermann"/><ptr type="liebermannNote" n="7" target="#ECfRetr_16.lnote.la.7"/><hi rend="bold"><hi rend="spaced">Unde murdra</hi></hi><ptr type="liebermannNote" n="8" target="#ECfRetr_16.lnote.la.8"/> <hi rend="bold"><hi rend="spaced">uenit</hi></hi><ptr type="liebermannNote" n="9" target="#ECfRetr_16.lnote.la.9"/> <hi rend="bold"><hi rend="spaced">in Angliam.</hi></hi> Murdra quidem<ptr type="liebermannNote" n="10" target="#ECfRetr_16.lnote.la.10"/> inuenta fuerunt<ptr type="liebermannNote" n="11" target="#ECfRetr_16.lnote.la.11"/> <hi rend="bold">in</hi> tempore<ptr type="liebermannNote" n="12" target="#ECfRetr_16.lnote.la.12"/> Cnuti<ptr type="liebermannNote" n="13" target="#ECfRetr_16.lnote.la.13"/> regis <hi rend="bold">Dani;</hi> qui post adquisitam <hi rend="bold">Angliam</hi> et pacificatam <hi rend="bold">rogatu</hi><ptr type="liebermannNote" n="14" target="#ECfRetr_16.lnote.la.14"/> baronum <hi rend="bold">Anglorum</hi> remisit<ptr type="liebermannNote" n="15" target="#ECfRetr_16.lnote.la.15"/> <hi rend="bold">in</hi><ptr type="liebermannNote" n="16" target="#ECfRetr_16.lnote.la.16"/> <hi rend="bold">Daniam</hi><ptr type="liebermannNote" n="17" target="#ECfRetr_16.lnote.la.17"/> exercitum suum.</ab>
        <note type="comparison" source="#liebermann" n="642"><label>printed alongside</label> <ref target="clause:ECf_16">ECf 16</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 642 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECfRetr_16.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Cnut sandte Dänische Schiffe heim und verjagte später Herzöge; verwirrt Verf. Beides? Eine Bitte der Witan um Heeres-Entlassung, an sich möglich, erfand er vielleicht wie Ähnliches für Eadward III. und für</hi> 1070: 34, 3. 34, 1a. <hi rend="italic">Denn dass Grosse, z. Th. Dänen oder ihnen verwandt, sich Cnut fürs Engländervolk verbürgten, wäre beispiellos</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cnut sent Danish ships home and later drove out earls; does the author confuse the two? A request by the witan for the army to be dismissed, possible in itself, he perhaps invented, like similar things for Edward III and for 1070: 34, 3. 34, 1a. For that magnates, partly Danes or related to them, stood surety to Cnut for the English people would be without precedent</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dies Capitel setzt vor</hi> 13, 1, <hi rend="italic">mit Rubrik</hi> De inuentione murdri <hi rend="italic">Lond. C.</hi> 16 <hi rend="italic">benutzen</hi> Bracton III 2, 15, 3 (<hi rend="italic">f.</hi> 134b, <hi rend="italic">ed. Twiss</hi> II 384) <hi rend="italic">und</hi>(?) Mirror of justices I 12</seg><seg type="translation" xml:lang="en" source="#claude">Lond puts this chapter before 13, 1, with the rubric De inuentione murdri. C. 16 is used by Bracton III 2, 15, 3 (f. 134b, ed. Twiss II 384) and (?) the Mirror of justices I 12</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">mudra <hi rend="italic">Va;</hi> murdrum <hi rend="italic">Db Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">mudra Va; murdrum Db Pl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">u. in A. <hi rend="italic">fehlt Cb; dafür</hi> cepit <hi rend="italic">Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. in A. lacking in Cb; instead cepit Pl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">quedam <hi rend="italic">Va;</hi> constituta et <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">quedam Va; Lond adds constituta et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">fuit <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">fuit Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">diebus <hi rend="italic">Cb Lb Va K Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">diebus Cb Lb Va K Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">Chn. <hi rend="italic">Hv Va K;</hi> D. r. <hi rend="italic">Cb Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Chn. Hv Va K; D. r. Cb Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">consensu <hi rend="italic">Hv Va K Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">consensu Hv Va K Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">misit <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">misit Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">ad <hi rend="italic">Lb Va Kn Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad Lb Va Kn Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">Daciam <hi rend="italic">Cb L Kn Ph</hi> [<hi rend="italic">Retr. verliest vielleicht nur ECf.’s</hi> domum]</seg><seg type="translation" xml:lang="en" source="#claude">Daciam Cb L Kn Ph [the Retractator perhaps only misreads ECf.’s domum]</seg></note>
      </div>
    </body>
