      <div type="clause" n="19">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 19</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 19" corresp="#wit-lat"><ptr type="liebermannNote" n="17" target="#IudDeiI_19.lnote.oe.17"/><pb n="404" ed="#liebermann"/>Expleta missa, faciat ipse<ptr type="liebermannNote" n="18" target="#IudDeiI_19.lnote.oe.18"/> sacerdos aquam benedictam, et<ptr type="liebermannNote" n="19" target="#IudDeiI_19.lnote.oe.19"/> pergat ad locum, ubi homines<ptr type="liebermannNote" n="20" target="#IudDeiI_19.lnote.oe.20"/> probentur<ptr type="liebermannNote" n="21" target="#IudDeiI_19.lnote.oe.21"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 404 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_19.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">c.</hi> 19 <hi rend="italic">stimmt wieder zu Fränkisch: Zeu.</hi> 619—22. <hi rend="italic">Von hier an weichen ab Al Ma Bc Vt2 Tr; s. u.</hi> X 17. XII 15</seg><seg type="translation" xml:lang="en" source="#claude">c. 19 agrees again with the Frankish: Zeu. 619—22. From here on Al Ma Bc Vt2 Tr diverge; see below X 17. XII 15</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_19.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Vt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Vt Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_19.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">aspergat l., u. ille probatur <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">aspergat l., u. ille probatur Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_19.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi> homo -betur <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">homo -betur written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_19.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">-bantur <hi rend="italic">Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">-bantur Rj</seg></note>
