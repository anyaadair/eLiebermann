  <text>
    <body>
      <div type="clause" n="15.7">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 15.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 15.7"><pb n="641" ed="#liebermann"/>Si parentes <hi rend="bold">deessent,</hi> dominus eius <hi rend="bold">reciperet; si dominum non</hi><ptr type="liebermannNote" n="31" target="#ECfRetr_15-7.lnote.la.31"/> <hi rend="bold">haberet, (socius</hi><ptr type="liebermannNote" n="32" target="#ECfRetr_15-7.lnote.la.32"/><hi rend="bold">)</hi> aut felagus<ptr type="liebermannNote" n="33" target="#ECfRetr_15-7.lnote.la.33"/> <hi rend="bold">eius,</hi> scilicet<ptr type="liebermannNote" n="1" target="#ECfRetr_15-7.lnote.la.1"/> fide<ptr type="liebermannNote" n="2" target="#ECfRetr_15-7.lnote.la.2"/> cum eo ligatus, si haberet. Si <hi rend="bold">uero nichil</hi> istorum haberet, <hi rend="bold">tunc</hi> rex regni, sub cuius <hi rend="bold">protectione</hi> et pace<ptr type="liebermannNote" n="3" target="#ECfRetr_15-7.lnote.la.3"/> degunt omnes<ptr type="liebermannNote" n="4" target="#ECfRetr_15-7.lnote.la.4"/>, <hi rend="bold">resumeret</hi><ptr type="liebermannNote" n="5" target="#ECfRetr_15-7.lnote.la.5"/> sex marcas cum suis quadraginta<ptr type="liebermannNote" n="6" target="#ECfRetr_15-7.lnote.la.6"/>.</ab>
        <note type="comparison" source="#liebermann" n="641"><label>printed alongside</label> <ref target="clause:ECf_15-7">ECf 15.7</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 641–642 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">Liebermann’s footnote a (felagus) is printed under the ECf column; it is given here as well.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-7.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-7.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Db Ph Lond Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Db Ph Lond Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-7.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-gius <hi rend="italic">Va K;</hi> a. f. <hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gius Va K; a. f. lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-7.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">Genoss <hi rend="italic">versteht ein Interpolator der Retr. richtig. Etymologisch liegt Nord.</hi> félagi (Vermögensgenoss, Kamerad) <hi rend="italic">vor; die Erklärung des Verfassers aus</hi> fei <hi rend="italic">verräth den Franzosen</hi></seg><seg type="translation" xml:lang="en" source="#claude">an interpolator of the Retr. rightly understands companion. Etymologically Norse félagi (partner in property, comrade) underlies it; the author’s explanation from fei betrays the Frenchman</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-7.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">solo <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">solo K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-7.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">c. eo f. l. reciperet, si aliquem habuerit. Si u. nullum i. h., rex t. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. eo f. l. reciperet, si aliquem habuerit. Si u. nullum i. h., rex t. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-7.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">sunt et <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds sunt et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-7.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Hv;</hi> uniuersi <hi rend="italic">Cb Lb Va Lond Ph;</hi> uniuersum <hi rend="italic">Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Hv; uniuersi Cb Lb Va Lond Ph; uniuersum Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-7.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">reciperet <hi rend="italic">Hv;</hi> illas <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">reciperet Hv; Lond adds illas</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-7.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">marcis <hi rend="italic">fügt zu Hv; folgt C.</hi> 18 <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds marcis; c. 18 follows in Lond</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">If kinsmen were lacking, his lord should receive them; if he had no lord, his (associate) or <hi rend="italic">felagus</hi>, namely one bound with him by faith, if he had one. But if he had none of these, then the king of the kingdom, under whose protection and peace all live, should take back the six marks with his forty.</ab>
      </div>
    </body>
  </text>
