    <body>
      <div type="clause" n="26.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 26.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 26.1"><pb n="650" ed="#liebermann"/>Nec<ptr type="liebermannNote" n="21" target="#ECf_26-1.lnote.la.21"/> propter<ptr type="liebermannNote" n="h" target="#ECf_26-1.lnote.la.fn.h"/> eam pacem retineant seruicium<ptr type="liebermannNote" n="22" target="#ECf_26-1.lnote.la.22"/> dominorum suorum, nec rectitudines si<ptr type="liebermannNote" n="7" target="#ECf_26-1.lnote.la.7"/> quas debent uicinis suis; quia non est dignus habere<ptr type="liebermannNote" n="23" target="#ECf_26-1.lnote.la.23"/> pacem qui non diligit obseruare pacem.</ab>
        <note type="comparison" source="#liebermann" n="650"><label>printed alongside</label> <ref target="clause:ECfRetr_26-1">ECf retr 26.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 650 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_26-1.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Sonderschutz durch Krone soll nicht von Bürger- oder Lehnspflicht befreien; vgl.</hi> Hn com. 4</seg><seg type="translation" xml:lang="en" source="#claude">special protection by the Crown is not to release from the duties of a citizen or vassal; cf. Hn com. 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_26-1.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">Non <hi rend="italic">Hk S</hi></seg><seg type="translation" xml:lang="en" source="#claude">Non Hk S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_26-1.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">seruitia <hi rend="italic">Hk Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">seruitia Hk Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_26-1.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_26-1.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">p. h. <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. h. Do</seg></note>
      </div>
