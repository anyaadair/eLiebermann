      <div type="clause" n="57">
        <head>Ine Rb 57</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="57" corresp="#wit-e"><pb n="24" ed="#liebermann"/>CI. Be cierlisces<ptr type="liebermannNote" n="15" target="#Rubrics-Ine_57.lnote.oe.15"/> monnes stale.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="57" corresp="#wit-g-prol"><pb n="24" ed="#liebermann"/>CI. Be cyrlisces mannes tale.<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_57.lnote.oe.2"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="57" corresp="#wit-h"><pb n="25" ed="#liebermann"/>CI. Be cirlisces monnes<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_57.lnote.oe.2-2"/> stale.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="57" corresp="#wit-q"><pb n="25" ed="#liebermann"/>De<ptr type="liebermannNote" n="26" target="#Rubrics-Ine_57.lnote.oe.26"/> cyrlisco furato.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="212" ed="#jurasinski-and-oliver"/>CI Be cierlisces monnes stale</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="212" ed="#jurasinski-and-oliver"/>Be cyrlisces mannes stale</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="25" ed="#liebermann"/>Vom<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_57.lnote.de.1"/> Diebstahl eines gemeinfreien<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_57.lnote.de.2"/> Mannes.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of theft by a common freeman.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="213" ed="#jurasinski-and-oliver"/>Concerning theft by a man of <hi rend="italic">ceorl</hi>-rank</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="213" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_57.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">24</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_57.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">24</biblScope></bibl><seg type="original" xml:lang="de">ceorl. <hi rend="italic">So</hi>; cyrl. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ceorl. So; cyrl. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_57.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">Et de <hi rend="italic">T</hi>; Si ceorlus intercipiatur furatum quid in domum suam attulisse <hi rend="italic">Hk</hi>; De nativo, in cuius domo animal furatum inveniatur <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et de T; Si ceorlus intercipiatur furatum quid in domum suam attulisse Hk; De nativo, in cuius domo animal furatum inveniatur Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_57.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_57.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Q spät. Rez. vervollständigt die Rb aus seinem Text</seg><seg type="translation" xml:lang="en" source="#claude">The later recension of Q completes the Rb from its own text</seg><note type="remark" resp="#claude">On several rubrics: Ine Rb 40. 43f. 46—50. 54. 56f. 58. 61f. 67. 70f.</note></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_57.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Der Text meint nur ‘Ehemann, Hausvater’ mit <hi rend="italic">ceorl.</hi> Gemäss dem sozialen Herabsinken des Bauern versteht Br ‘Leibeigener’</seg><seg type="translation" xml:lang="en" source="#claude">The text means only ‘husband, head of household’ by <hi rend="italic">ceorl.</hi> In keeping with the social decline of the peasant, Br understands ‘serf’</seg></note>
      </div>
    </body>
