        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de">qua causam <hi rend="italic">fügt zu Vb</hi></seg><seg type="translation" xml:lang="en" source="#claude">qua causam added by Vb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de">ipsorum <hi rend="italic">darüber Ti</hi></seg><seg type="translation" xml:lang="en" source="#claude">ipsorum above it Ti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de">exęq., <hi rend="italic">geänd. aus</hi> ęq. <hi rend="italic">Ti;</hi> exquirimus <hi rend="italic">Vb</hi></seg><seg type="translation" xml:lang="en" source="#claude">exęq., altered from ęq. Ti; exquirimus Vb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">darüber</hi> nostri—ani sunt <hi rend="italic">Ti</hi></seg><seg type="translation" xml:lang="en" source="#claude">above it nostri—ani sunt Ti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de">non <hi rend="italic">fügt zu Vb</hi></seg><seg type="translation" xml:lang="en" source="#claude">non added by Vb</seg></note>
