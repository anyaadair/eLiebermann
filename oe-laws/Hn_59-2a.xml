      <div type="clause" n="59.2a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.2a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.2a" corresp="#wit-lat"><pb n="577" ed="#liebermann"/>Pridie ante solis occasum ad domum suam, si residens est cum quo agitur — et per bonum testimonium uicinorum et aliorum<ptr type="liebermannNote" n="34" target="#Hn_59-2a.lnote.oe.34"/>, quos secum habeat qui placitum contramandat<ptr type="liebermannNote" n="35" target="#Hn_59-2a.lnote.oe.35"/> —, ipsi respectetur, si domi est; uxori, dapifero uel<ptr type="liebermannNote" n="36" target="#Hn_59-2a.lnote.oe.36"/> preposito et familie<ptr type="liebermannNote" n="k" target="#Hn_59-2a.lnote.oe.k"/> eius dicatur intelligibiliter, si idem abfuerit. Et hoc utrimque<ptr type="liebermannNote" n="37" target="#Hn_59-2a.lnote.oe.37"/> tercio licet, continue siue interrupte.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 577 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-2a.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. die Ladung</hi> 41, 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. the summons 41, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-2a.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">aliquorum <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">aliquorum Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-2a.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">-det <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">-det Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-2a.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-2a.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">utrumque <hi rend="italic">Wh;</hi> iterum et <hi rend="italic">ändern Wi Tho aus</hi> 60, 2<hi rend="italic">b</hi> [<hi rend="italic">falsch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">utrumque Wh; Wi Tho alter to iterum et from 60, 2<hi rend="italic">b</hi> [wrongly]</seg></note>
