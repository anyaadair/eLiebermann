        <head>Ine Rb 72</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="72" corresp="#wit-e"><pb n="26" ed="#liebermann"/>CXVI. Be wergeldðeofes<ptr type="liebermannNote" n="8" target="#Rubrics-Ine_72.lnote.oe.8"/> forefonge.<ptr type="liebermannNote" n="9" target="#Rubrics-Ine_72.lnote.oe.9"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="72" corresp="#wit-g-prol"><pb n="26" ed="#liebermann"/>CXVI. Be wergildþeofes forefenge.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="72" corresp="#wit-h"><pb n="27" ed="#liebermann"/>CXVI. Be wergildðeofes forefenge.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="72" corresp="#wit-q"><pb n="27" ed="#liebermann"/>De weregyldi<ptr type="liebermannNote" n="14" target="#Rubrics-Ine_72.lnote.oe.14"/>-furis forfangio.<ptr type="liebermannNote" n="15" target="#Rubrics-Ine_72.lnote.oe.15"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="216" ed="#jurasinski-and-oliver"/>CXVI Be wergeldðeofes forefonge</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="216" ed="#jurasinski-and-oliver"/>Be wergildðeofes forfenge</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="27" ed="#liebermann"/>Vom Einfangen<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_72.lnote.de.1"/> eines Wergeld [schuldigen] Diebes.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of the catching of a thief [liable for his] wergeld.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="217" ed="#jurasinski-and-oliver"/>Concerning capture of a thief who owes wergild for his offense</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="217" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_72.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">26</biblScope></bibl><seg type="original" xml:lang="de">-gyld. <hi rend="italic">Ld</hi>; wergyldþeof, <hi rend="italic">ohne</hi> for. <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gyld. Ld; wergyldþeof, without for. So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_72.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">26</biblScope></bibl><seg type="original" xml:lang="de">forefeng <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">forefeng Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_72.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">27</biblScope></bibl><seg type="original" xml:lang="de">-gildi <hi rend="italic">T Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gildi T Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_72.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">27</biblScope></bibl><seg type="original" xml:lang="de">forisf. <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">forisf. Hk Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_72.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Hier nicht Anefang; <hi rend="italic">s. Wb forefang</hi></seg><seg type="translation" xml:lang="en" source="#claude">Here not Anefang; <hi rend="italic">see Wb forefang</hi></seg></note>
