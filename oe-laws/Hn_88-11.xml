      <div type="clause" n="88.11">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 88.11</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 88.11" corresp="#wit-lat"><pb n="603" ed="#liebermann"/>Si quis, cum inimico suo restitit contra<ptr type="liebermannNote" n="q" target="#Hn_88-11.lnote.oe.q"/> legem, si<ptr type="liebermannNote" n="32*" target="#Hn_88-11.lnote.oe.32_"/> alicui mortem uel uulnus inflixit uel aliquid excitauit<ptr type="liebermannNote" n="33" target="#Hn_88-11.lnote.oe.33"/>, ut exigentibus meritis mors secuta uideatur, non<ptr type="liebermannNote" n="qq" target="#Hn_88-11.lnote.oe.qq"/> est etiam<ptr type="liebermannNote" n="34" target="#Hn_88-11.lnote.oe.34"/> in quibuscunque parentibus uel paternis uel maternis, occidentibus uel occisis, indiscrete [uin]dicandum<ptr type="liebermannNote" n="35" target="#Hn_88-11.lnote.oe.35"/>:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 603 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-11.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 86&lt;sup&gt;c&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude">cf. 86&lt;sup&gt;c&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-11.lnote.oe.qq" n="qq" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">in der Fehde darf des Erschlagenen Sippe sich nur zu</hi> ²/₃ <hi rend="italic">seines Werthes an der Vatersippe des Todtschlägers, zu</hi> ¹/₃ <hi rend="italic">an dessen Muttersippe rächen; für zu viel Getödtete verfällt sie der Wergeldschuld oder Rache der über Gebühr Verletzten</hi></seg><seg type="translation" xml:lang="en" source="#claude">in a feud the slain man’s kindred may take vengeance for only ²/₃ of his value on the slayer’s paternal kindred and for ¹/₃ on his maternal kindred; for too many slain, it becomes liable to a wergild-debt or to the vengeance of those injured beyond what is due</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-11.lnote.oe.32_" n="32*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">streiche</hi></seg><seg type="translation" xml:lang="en" source="#claude">delete</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-11.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">exit. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">exit. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-11.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond, wohl besser</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond, probably better</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-11.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">iudicandum <hi rend="italic">Hss. Edd.; vgl.</hi> 88, 9<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">iudicandum MSS Edd.; cf. 88, 9<hi rend="italic">b</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-11.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de">‘Wohl von Juristenphantasie ausgeheckt’; Phillpotts <hi rend="italic">Kindred</hi> 231—<hi rend="italic">uind</hi>.{35}, wie ich emendierte—88, 12 Am Rande: <hi rend="italic">Dictum sancti Edmundi regis</hi> [der Heilige war Ende 13. Jhs. der einzige bekannte König Eadmund!]—<hi rend="italic">nos fuerit</hi> ohne <hi rend="italic">ipsos</hi>{3}—88, 12a <hi rend="italic">post hec</hi>{5}—<hi rend="italic">portat</hi>{6}—88, 12b <hi rend="italic">hundfah</hi>{12}—88, 12d <hi rend="italic">aliq. alium</hi>{17} <hi rend="italic">p. ip</hi>. ohne <hi rend="italic">in</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">‘Probably hatched by a jurist’s fancy’; Phillpotts <hi rend="italic">Kindred</hi> 231—<hi rend="italic">uind</hi>.{35}, as I emended—88, 12 In the margin: <hi rend="italic">Dictum sancti Edmundi regis</hi> [at the end of the 13th cent. the saint was the only known King Eadmund!]—<hi rend="italic">nos fuerit</hi> without <hi rend="italic">ipsos</hi>{3}—88, 12a <hi rend="italic">post hec</hi>{5}—<hi rend="italic">portat</hi>{6}—88, 12b <hi rend="italic">hundfah</hi>{12}—88, 12d <hi rend="italic">aliq. alium</hi>{17} <hi rend="italic">p. ip</hi>. without <hi rend="italic">in</hi> Rs</seg></note>
      </div>
