      <div type="clause" n="11a">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 11a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 11a"><pb n="634" ed="#liebermann"/>Patriam enim infestantes uastationi eius pro posse suo<ptr type="liebermannNote" n="38" target="#ECfRetr_11a.lnote.la.38"/> insistebant; ad<ptr type="liebermannNote" n="39" target="#ECfRetr_11a.lnote.la.39"/> eorum <hi rend="bold">quidem</hi> insolentiam reprimendam statutum est<ptr type="liebermannNote" n="40" target="#ECfRetr_11a.lnote.la.40"/> Denegeldum<ptr type="liebermannNote" n="41" target="#ECfRetr_11a.lnote.la.41"/> annuatim reddi, <hi rend="bold">scilicet</hi> duodecim denarios de<ptr type="liebermannNote" n="42" target="#ECfRetr_11a.lnote.la.42"/> unaquaque hida totius patrie, ad conducendos eos qui piratarum irruptioni resistendo obuiarent.</ab>
        <note type="comparison" source="#liebermann" n="634"><label>printed alongside</label> <ref target="clause:ECf_11a">ECf 11a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 634 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_11a.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_11a.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">adeo quod in. <hi rend="italic">Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">adeo quod in. Dc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_11a.lnote.la.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ph</seg></note>
