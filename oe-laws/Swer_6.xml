  <text>
    <body>
      <div type="clause" n="6">
        <head><ref type="lawCode" target="law:Swer">Swer</ref> 6</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6" corresp="#wit-h"><ptr type="liebermannNote" n="1" target="#Swer_6.lnote.oe.1-2"/><pb n="398" ed="#liebermann"/>On ðone Drihten, se að is clæne ⁊ unmæne, ðe N. swor.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6" corresp="#wit-b"><ptr type="liebermannNote" n="1" target="#Swer_6.lnote.oe.1-3"/><pb n="398" ed="#liebermann"/>His geferan að, þe hi<hi rend="italic">m</hi> mid standað. On ðone Drihten, se að is clæne ⁊ unmæne, ðe N. swor.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6" corresp="#wit-q"><pb n="399" ed="#liebermann"/>In ipso Deo, iusiurandum est clene<ptr type="liebermannNote" n="1" target="#Swer_6.lnote.oe.1"/> et unmene<ptr type="liebermannNote" n="2" target="#Swer_6.lnote.oe.2"/>, quod<ptr type="liebermannNote" n="3" target="#Swer_6.lnote.oe.3"/> N. iurauit.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="399" ed="#liebermann"/>(Eid seines Genossen<ptr type="liebermannNote" n="1" target="#Swer_6.lnote.de.1"/>, der bei ihm [als Eideshelfer] steht. <hi rend="italic">B</hi>) Bei dem Herrn . . ., der Eid<ptr type="liebermannNote" n="2" target="#Swer_6.lnote.de.2"/> ist rein und<ptr type="liebermannNote" n="††" target="#Swer_6.lnote.de1.dagger2"/> ohne Falsch, den N. [der Hauptschwörer] geschworen hat.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">(The oath of his companion who stands with him [as oath-helper]. B) By the Lord …, the oath is clean and without falsehood which N. [the principal swearer] has sworn.</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-h">[I swear] by the Lord [that] the oath sworn by N. is honest and without perjury.</ab>
        <note type="editorial">U: translator unrecorded: check; ‘clæne ⁊ unmæne’ is a rhyming pair.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Swer_6.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">399</biblScope></bibl><seg type="original" xml:lang="de">dene <hi rend="italic">T;</hi> de me <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">dene T; de me MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Swer_6.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">399</biblScope></bibl><seg type="original" xml:lang="de">imminet <hi rend="italic">T;</hi> in memet <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">imminet T; in memet MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Swer_6.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">399</biblScope></bibl><seg type="original" xml:lang="de">ipse <hi rend="italic">fügt zu T</hi></seg><seg type="translation" xml:lang="en" source="#claude">ipse added by T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Swer_6.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">398</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Platz für Überschrift frei</hi></seg><seg type="translation" xml:lang="en" source="#claude">Space left free for a heading</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Swer_6.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">398</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Überschrift roth</hi></seg><seg type="translation" xml:lang="en" source="#claude">Heading in red</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Swer_6.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">235</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Eideshelfer 3. 4D</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Eideshelfer 3. 4D</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Swer_6.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">235</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘rein und unmein’ gemein Germanisch; Brunner II 434. <hi rend="italic">Secundum scientiam</hi> fügt erst 13. Jh. beschränkend hinzu; Pol Mai II 598</seg><seg type="translation" xml:lang="en" source="#claude">‘rein und unmein’ is common Germanic; Brunner II 434. <hi rend="italic">Secundum scientiam</hi> is added, as a restriction, only in the 13th cent.; Pol Mai II 598</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="Swer_6.lnote.de1.dagger2" n="††" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">399</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Endreimpaar</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Rhyming pair</hi></seg></note>
      </div>
    </body>
