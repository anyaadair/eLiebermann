    <body>
      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:ExcomI">Excom I</ref> 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom I 2" corresp="#wit-ti"><ptr type="liebermannNote" n="4" target="#ExcomI_2.lnote.oe.4"/><pb n="432" ed="#liebermann"/>Nouerit karitas uestra, fratres karissimi<ptr type="liebermannNote" n="5" target="#ExcomI_2.lnote.oe.5"/>, quod quidam uir nomine N.<ptr type="liebermannNote" n="6" target="#ExcomI_2.lnote.oe.6"/>, diabolo suadente, postponens Christianam promissionem, quam in baptismo professus est, per apostasiam<ptr type="liebermannNote" n="e" target="#ExcomI_2.lnote.oe.e"/> conuersus post Satan[am<ptr type="liebermannNote" n="7" target="#ExcomI_2.lnote.oe.7"/>], cui abrenuntiauit et omnibus operibus eius, uineam Christi, id est ęcclesiam Eius, deuastare<ptr type="liebermannNote" n="f" target="#ExcomI_2.lnote.oe.f"/> et depredari<ptr type="liebermannNote" n="8" target="#ExcomI_2.lnote.oe.8"/> non pertimescit, pauperes Christi, quos pretioso sanguine Suo redemit, uiolenter<ptr type="liebermannNote" n="9" target="#ExcomI_2.lnote.oe.9"/> opprimens et interficiens et bona eorum diripiens.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 432 (two independent readings of the page images, differences settled against the page); Liebermann prints in larger type (the readings of MS Ti, his note b on p. 432): karissimi</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_2.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Reg.</hi> 414.</seg><seg type="translation" xml:lang="en" source="#claude">cf. Reg. 414.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_2.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Schädigung des Kirchenguts nennt als Anlass des Banns</hi> IV 1. XII 2. XIII 2.</seg><seg type="translation" xml:lang="en" source="#claude">IV 1. XII 2. XIII 2 name damage to church property as the occasion of the excommunication.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de">Allocutio <hi rend="italic">fügt zu Reg</hi></seg><seg type="translation" xml:lang="en" source="#claude">Allocutio added by Reg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de">mei <hi rend="italic">Reg Vb</hi></seg><seg type="translation" xml:lang="en" source="#claude">mei Reg Vb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de">ille <hi rend="italic">Mart Bal</hi></seg><seg type="translation" xml:lang="en" source="#claude">ille Mart Bal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de">Satan <hi rend="italic">Ti Bal</hi></seg><seg type="translation" xml:lang="en" source="#claude">Satan Ti Bal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de">-re <hi rend="italic">Reg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-re Reg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Mart</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Mart</seg></note>
