      <div type="clause" n="11.4">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 11.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 11.4" corresp="#wit-lat"><pb n="403" ed="#liebermann"/>Iesus autem, intuitus eum, dilexit eum<ptr type="liebermannNote" n="20" target="#IudDeiI_11-4.lnote.oe.20"/> et dixit ei: ‘Unum tibi deest: Uade, <ptr type="liebermannNote" n="21" target="#IudDeiI_11-4.lnote.oe.21"/>quaecumque habes uende<ptr type="liebermannNote" n="22" target="#IudDeiI_11-4.lnote.oe.22"/> et da pauperibus, et habebis thesaurum<ptr type="liebermannNote" n="23" target="#IudDeiI_11-4.lnote.oe.23"/> in coelo; et ueni, sequere me!’</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">10, 21</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 403 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_11-4.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">illum <hi rend="italic">Ci Al Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">illum Ci Al Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_11-4.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">omnia <hi rend="italic">fügt zu Al;</hi> uende omnia quę (quecumque <hi rend="italic">Ma Tr Co</hi>) habes <hi rend="italic">Ci Ma Tr Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">omnia added by Al; uende omnia quę (quecumque Ma Tr Co) habes Ci Ma Tr Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_11-4.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">u. et da p. <hi rend="italic">fehlt Ca, ebenso fernerhin manches aus Bibel oder Formeln, was ich nicht bemerke</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. et da p. lacking in Ca, as is much from the Bible or the formulae hereafter, which I do not record</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_11-4.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">indeficientem <hi rend="italic">fügt zu Al Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">indeficientem added by Al Ma</seg></note>
      </div>
