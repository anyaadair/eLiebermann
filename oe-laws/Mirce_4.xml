  <text>
    <body>
      <div type="clause" n="4">
        <head><ref type="lawCode" target="law:Mirce">Mirce</ref> 4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4" corresp="#wit-d"><pb n="462" ed="#liebermann"/>Se wer gebirað magu<hi rend="italic">m</hi> ⁊ seo cynebot þam leodum<ptr type="liebermannNote" n="3" target="#Mirce_4.lnote.oe.3-2"/>.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4" corresp="#wit-o"><pb n="462" ed="#liebermann"/>Se were gebyrað mágum ⁊ seo cynebót þa<hi rend="italic">m</hi> leodum<ptr type="liebermannNote" n="3" target="#Mirce_4.lnote.oe.3"/>.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4" corresp="#wit-h"><pb n="462" ed="#liebermann"/>Se wer gebyreð magum ⁊ seo cynebot þam leodum<ptr type="liebermannNote" n="1" target="#Mirce_4.lnote.oe.1"/>.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4" corresp="#wit-ld"><pb n="463" ed="#liebermann"/>Þam<ptr type="liebermannNote" n="b" target="#Mirce_4.lnote.oe.b"/> were habbaþ<ptr type="liebermannNote" n="*" target="#Mirce_4.lnote.oe.star"/> ða mægas ⁊ ðam<ptr type="liebermannNote" n="b" target="#Mirce_4.lnote.oe.b"/> cynebot se<ptr type="liebermannNote" n="b" target="#Mirce_4.lnote.oe.b"/> landleod<ptr type="liebermannNote" n="e" target="#Mirce_4.lnote.oe.e"/><ptr type="liebermannNote" n="1" target="#Mirce_4.lnote.oe.1-2"/>.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="4" corresp="#wit-q"><pb n="463" ed="#liebermann"/>Ipsam weram debent habere parentes eius et regalem<ptr type="liebermannNote" n="15" target="#Mirce_4.lnote.oe.15"/> emendationem ipsius terrę<ptr type="liebermannNote" n="16" target="#Mirce_4.lnote.oe.16"/> populus.<ptr type="liebermannNote" n="17" target="#Mirce_4.lnote.oe.17"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="4" corresp="#wit-in"><pb n="463" ed="#liebermann"/>[43, 4] Parentes (uero<ptr type="liebermannNote" n="16" target="#Mirce_4.lnote.oe.16-2"/>) regis iuste debent habere simplum prętium eius (regis<ptr type="liebermannNote" n="17" target="#Mirce_4.lnote.oe.17-2"/>) et populus aliud<ptr type="liebermannNote" n="18" target="#Mirce_4.lnote.oe.18"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-h"><pb n="14" ed="#rabin-doml"/>Se wer gebyreð magum and seo cynebot þam leodum.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="463" ed="#liebermann"/>Das Wergeld gebührt den Verwandten (erhalten die Verw. <hi rend="italic">lq</hi>) und die Königsbusse dem Volke (des Landes <hi rend="italic">lq</hi>).</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">The wergild belongs to the kinsmen (the kinsmen receive, lq) and the king-compensation to the people (of the land, lq).</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-d"><pb n="478" ed="#whitelock"/>The wergild belongs to the kinsmen and the royal-compensation to the people.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-h">The wergild belongs to his kinsmen and the royal compensation to the people.</ab>
        <note type="comparison" source="#liebermann" n="463"><ref target="clause:Northleoda_1">Norðleoda 1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd.</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Northleoda_1">Norðleoda 1</ref></note>
        <note type="editorial">In H, EGu follows after a paragraph break; in D and O, Að. Liebermann compares Norðleod 1.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_4.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">462</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> Að</seg><seg type="translation" xml:lang="en" source="#claude">Að follows</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_4.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">462</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nach Absatz folgt</hi> EGu, <hi rend="italic">oben S.</hi> 128</seg><seg type="translation" xml:lang="en" source="#claude">after a paragraph break EGu follows, above p. 128</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_4.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">462</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> Að</seg><seg type="translation" xml:lang="en" source="#claude">Að follows</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_4.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_4.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Abweichung vom Original</hi></seg><seg type="translation" xml:lang="en" source="#claude">Departure from the original</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_4.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ebd.</hi> 1; <hi rend="italic">ebenso Quadr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">ibid. 1; likewise Quadr.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_4.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt ohne Absatz</hi> Að</seg><seg type="translation" xml:lang="en" source="#claude">Að follows without a paragraph break</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_4.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> eius <hi rend="italic">R;</hi> regni <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Lond; eius R; regni the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_4.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">as in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_4.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> Að</seg><seg type="translation" xml:lang="en" source="#claude">Að follows</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_4.lnote.oe.16-2" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur in Cb T</hi></seg><seg type="translation" xml:lang="en" source="#claude">only in Cb T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_4.lnote.oe.17-2" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">statt</hi> eius <hi rend="italic">nur in Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">instead of eius only in Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_4.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> Að</seg><seg type="translation" xml:lang="en" source="#claude">Að follows</seg></note>
      </div>
