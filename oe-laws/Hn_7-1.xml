      <div type="clause" n="7.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 7.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 7.1" corresp="#wit-lat"><pb n="553" ed="#liebermann"/>Sicut antiqua<ptr type="liebermannNote" n="c" target="#Hn_7-1.lnote.oe.c"/> fuerat institucione<ptr type="liebermannNote" n="d" target="#Hn_7-1.lnote.oe.d"/> formatum<ptr type="liebermannNote" n="8" target="#Hn_7-1.lnote.oe.8"/>, salutari regis imperio uera nuper est recordacione firmatum<ptr type="liebermannNote" n="9" target="#Hn_7-1.lnote.oe.9"/>, generalia<ptr type="liebermannNote" n="10" target="#Hn_7-1.lnote.oe.10"/> comitatuum placita certis locis et uicibus<ptr type="liebermannNote" n="11" target="#Hn_7-1.lnote.oe.11"/> et diffinito<ptr type="liebermannNote" n="12" target="#Hn_7-1.lnote.oe.12"/> tempore per singulas prouincias<ptr type="liebermannNote" n="13" target="#Hn_7-1.lnote.oe.13"/> Anglie conuenire debere, nec ullis ultra fatigacionibus<ptr type="liebermannNote" n="e" target="#Hn_7-1.lnote.oe.e"/> agitari<ptr type="liebermannNote" n="14" target="#Hn_7-1.lnote.oe.14"/>, nisi propria regis necessitas uel commune regni comodum sepius adiciat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 553 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">d. h.</hi> ‘vor 1066’ <hi rend="italic">auch bei anderen Anglonormannen</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">i.e.</hi> ‘before 1066’, <hi rend="italic">as also in other Anglo-Normans</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wo ich am Rande ein Angelsächs. Gesetz als Quelle citire, ist stets dessen Übersetzung im Quadripartitus gemeint; seltene Ausnahmen, wo Hn dem Angelsächsischen näher steht, werd ich ausdrücklich notiren</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">where I cite an Anglo-Saxon law in the margin as a source, its translation in the Quadripartitus is always meant; the rare exceptions where Hn stands closer to the Anglo-Saxon I shall note expressly</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-1.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">die zum Grafschaftsgericht Pflichtigen <hi rend="italic">zu ergänzen</hi></seg><seg type="translation" xml:lang="en" source="#claude">those owing attendance at the shire court <hi rend="italic">to be supplied</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">forᵃtum <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">forᵃtum <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. aus</hi> furn. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">corrected from</hi> furn. <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">c. g. <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. g. <hi rend="italic">Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">iudicibus <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">iudicibus <hi rend="italic">K Co Or Gi</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">defi. <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">defi. <hi rend="italic">Wi</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Sc;</hi> A. pr. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">so Sc;</hi> A. pr. <hi rend="italic">the rest</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. vom Corr. aus</hi> fagitari nec <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">corrected by the corrector from</hi> fagitari nec <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">316</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Grafschaft 13; Grafschaftsgericht 6. 7. 10. Wendungen zweiter Z. wie Quadr Arg 12{n}.—<hi rend="italic">si. Anglie prou</hi>.{13} <hi rend="italic">co</hi>.—<hi rend="italic">commodum</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Grafschaft 13; Grafschaftsgericht 6. 7. 10. Phrases of the second l. as in Quadr Arg 12{n}.—<hi rend="italic">si. Anglie prou</hi>.{13} <hi rend="italic">co</hi>.—<hi rend="italic">commodum</hi> Rs</seg></note>
      </div>
