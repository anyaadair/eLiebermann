    <body>
      <div type="clause" n="II Cn 64">
        <head>Quadr Rb II Cn 64</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Rb II Cn 64" corresp="#wit-lat"><pb n="538" ed="#liebermann"/><ptr type="liebermannNote" n="19" target="#Quadr-Rb_II-Cn-64.lnote.la.19"/>De husbrece<ptr type="liebermannNote" n="20" target="#Quadr-Rb_II-Cn-64.lnote.la.20"/> et bernet, que<ptr type="liebermannNote" n="21" target="#Quadr-Rb_II-Cn-64.lnote.la.21"/> secundum legem emendari non possunt <ptr type="liebermannNote" n="a" target="#Quadr-Rb_II-Cn-64.lnote.la.fn.a"/>(et openthiefþe<ptr type="liebermannNote" n="22" target="#Quadr-Rb_II-Cn-64.lnote.la.22"/> et eberemorde et lafordsþike).</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 538 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">Of <hi rend="italic">husbryce</hi> (housebreaking) and <hi rend="italic">bærnet</hi> (arson), which cannot be compensated for according to law (and <hi rend="italic">open þiefþ</hi> (open theft) and <hi rend="italic">æbere morð</hi> (manifest murder) and <hi rend="italic">hlafordswice</hi> (treachery to one's lord)).</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-64.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de">et hu. <hi rend="italic">ohne Absatz DmT;</hi> De infractione domus et de incendio et de aperto furto et de probato murđro et infidelitate domini <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">et hu. without paragraph break DmT; De infractione domus et de incendio et de aperto furto et de probato murđro et infidelitate domini R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-64.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de">burghbreche <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">burghbreche Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-64.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">statt</hi> que — pos. <hi rend="italic">haben</hi> et op. — laf. <hi rend="italic">HkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">instead of que — pos., HkBr have et op. — laf.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-64.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. S</hi> 537<hi rend="superscript">c</hi></seg><seg type="translation" xml:lang="en" source="#claude">see p. 537, note c</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-64.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de">openþethief <hi rend="italic">Hk;</hi> opethef <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">openþethief Hk; opethef Br</seg></note>
      </div>
