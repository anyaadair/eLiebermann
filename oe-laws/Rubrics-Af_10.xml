    <body>
      <div type="clause" n="10">
        <head>Af Rb 10</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="10" corresp="#wit-e"><pb n="16" ed="#liebermann"/>XI. Be twelfhyndes<ptr type="liebermannNote" n="13" target="#Rubrics-Af_10.lnote.oe.13"/> monnes wife forlegenum.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="10" corresp="#wit-ot-frag"><pb n="16" ed="#liebermann"/>… welfhyndes monnes wife forlegenū.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="10" corresp="#wit-g-prol"><pb n="16" ed="#liebermann"/>XI. Be XII hyndes mannes wife forlegenu<hi rend="italic">m</hi>.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="10" corresp="#wit-h"><pb n="17" ed="#liebermann"/>XI. Be XIIhyndes monnes<ptr type="liebermannNote" n="3" target="#Rubrics-Af_10.lnote.oe.3"/> wife forlegenu<hi rend="italic">m</hi>.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="10" corresp="#wit-q"><pb n="17" ed="#liebermann"/>De muliere<ptr type="liebermannNote" n="9" target="#Rubrics-Af_10.lnote.oe.9"/> XIIhyndi<ptr type="liebermannNote" n="10" target="#Rubrics-Af_10.lnote.oe.10"/> hominis<ptr type="liebermannNote" n="11" target="#Rubrics-Af_10.lnote.oe.11"/> fornicata.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="188" ed="#jurasinski-and-oliver"/>XI Be twelfhyndes monnes wife forlegenum</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="188" ed="#jurasinski-and-oliver"/>Be hæmedðingu<hi rend="italic">m</hi></ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="17" ed="#liebermann"/>Vom<ptr type="liebermannNote" n="1" target="#Rubrics-Af_10.lnote.de.1"/> beschlafenen Weibe eines Mannes von 1200 [Schilling Wergeld].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of the wife of a man of 1200 [shillings’ wergeld] being lain with.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="189" ed="#jurasinski-and-oliver"/>Concerning lying with the wife of a 1,200 man</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="189" ed="#jurasinski-and-oliver"/>Concerning carnal intercourse</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_10.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">17</biblScope></bibl><seg type="original" xml:lang="de">sponsa <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">sponsa Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_10.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">17</biblScope></bibl><seg type="original" xml:lang="de">tlefh. <hi rend="italic">Dm;</hi> tlefhinde <hi rend="italic">T;</hi> XIIhindi <hi rend="italic">Hk;</hi> XIIh. h. <hi rend="italic">fehlt Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">tlefh. Dm; tlefhinde T; XIIhindi Hk; XIIh. h. lacking in Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_10.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">17</biblScope></bibl><seg type="original" xml:lang="de">vel VIhindi <hi rend="italic">fügt Hk zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">vel VIhindi added by Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_10.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de">t. m. w. <hi rend="italic">fehlt So Ld;</hi> forligerum <hi rend="italic">So;</hi> forleg. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. m. w. lacking in So Ld; forligerum So; forleg. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_10.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">17</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_10.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">40</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘Von Hurereien’ So</seg><seg type="translation" xml:lang="en" source="#claude">‘Of fornications’ So</seg></note>
      </div>
