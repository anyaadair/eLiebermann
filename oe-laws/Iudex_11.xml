    <body>
      <div type="clause" n="11">
        <head><ref type="lawCode" target="law:Iudex">Iudex</ref> 11</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11" corresp="#wit-g-a"><pb n="475" ed="#liebermann"/>Oft eac ða ðwyran deman for heora gitsungae<ptr type="liebermannNote" n="4" target="#Iudex_11.lnote.oe.4"/> þone dom geuferiað oððe hyne awendað ⁊ ne geendiað ná þa spæce, ær heora seod<ptr type="liebermannNote" n="b" target="#Iudex_11.lnote.oe.b"/> bið afylled; ⁊ þa<hi rend="italic">n</hi> þonne hy demað, ne scewiað<ptr type="liebermannNote" n="5" target="#Iudex_11.lnote.oe.5"/> hy ná þa spæce, ac þa medsceatas.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="11" corresp="#wit-q"><pb n="475" ed="#liebermann"/>Sepe etiam<ptr type="liebermannNote" n="14" target="#Iudex_11.lnote.oe.14"/> praui<ptr type="liebermannNote" n="d" target="#Iudex_11.lnote.oe.d"/> iudices iudicium peruertunt uel respectant<ptr type="liebermannNote" n="18" target="#Iudex_11.lnote.oe.18"/> et non finiunt<ptr type="liebermannNote" n="19" target="#Iudex_11.lnote.oe.19"/> causam, donec uultus<ptr type="liebermannNote" n="20" target="#Iudex_11.lnote.oe.20"/><ptr type="liebermannNote" n="†" target="#Iudex_11.lnote.oe.dagger"/> eorum impleatur<ptr type="liebermannNote" n="21" target="#Iudex_11.lnote.oe.21"/>; et quando<ptr type="liebermannNote" n="d" target="#Iudex_11.lnote.oe.d"/> iudicant, non<ptr type="liebermannNote" n="22" target="#Iudex_11.lnote.oe.22"/> opera, sed munera considerant.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="475" ed="#liebermann"/>Ferner schieben<ptr type="liebermannNote" n="1" target="#Iudex_11.lnote.de.1"/> die verderbten Richter wegen ihrer Habgier oft den Urtheilsspruch auf oder verdrehen<ptr type="liebermannNote" n="2" target="#Iudex_11.lnote.de.2"/> ihn und bringen<ptr type="liebermannNote" n="3" target="#Iudex_11.lnote.de.3"/> nimmer die Klagesache zu Ende, bevor ihr Geldbeutel gefüllt wird; und dann, wenn sie Urtheil sprechen, ziehen sie nie die Klagesache, sondern die Lohngelder in Betracht.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Further, corrupt judges, because of their greed, often postpone or pervert the judgment and never bring the suit to an end before their purse is filled; and then, when they give judgment, they consider not the suit but the bribes.</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-g-a">Often also, through greed, wicked judges defer or pervert cases, and don’t complete [them] before their purses are filled; and then they make determinations, not considering the cases, but [considering] the bribes.</ab>
        <note type="comparison" source="#liebermann" n="475">Isidor, Sent. III 52.11</note>
        <note type="comparisonPrinted" source="#liebermann">Isidor, Sent. III 52, 11</note>
        <note type="editorial">U: translator unrecorded: check; Isidore, Sent. III 52.11. The Quadripartitus's ‘uultus’ (face) reflects a confusion of OE ‘seod’ (purse) with ‘seo’ (pupil) or ‘gesihð’ (sight), Liebermann suggests.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_11.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de">enim <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">enim <hi rend="italic">T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_11.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">direct aus Isidor?</hi></seg><seg type="translation" xml:lang="en" source="#claude">directly from Isidor?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_11.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de">differunt <hi rend="italic">Isidor</hi></seg><seg type="translation" xml:lang="en" source="#claude">differunt <hi rend="italic">Isidor</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_11.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de">finium <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">finium <hi rend="italic">T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_11.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de">uoluntas <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">uoluntas <hi rend="italic">Br</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_11.lnote.oe.dagger" n="†" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Quadr. denkt an</hi> seo (<hi rend="italic">Pupille</hi>) <hi rend="italic">oder</hi> (ge)sihð (<hi rend="italic">Gesicht</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">Quadr. is thinking of seo (pupil of the eye) or (ge)sihð (sight)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_11.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de">-antur <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">-antur <hi rend="italic">T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_11.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de">per <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">per added by Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_11.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Sievers Gramm.</hi> 252 <hi rend="italic">A</hi>¹</seg><seg type="translation" xml:lang="en" source="#claude">cf. Sievers Gramm. 252 A¹</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_11.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de">marsupia [<hi rend="italic">der Processirenden</hi>] exhauriant <hi rend="italic">Isidor</hi></seg><seg type="translation" xml:lang="en" source="#claude">marsupia [of the litigants] exhauriant Isidor</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_11.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. ebd.</hi> 156, 5 <hi rend="italic">A</hi>³</seg><seg type="translation" xml:lang="en" source="#claude">cf. ibid. 156, 5 A³</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Iudex_11.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">269</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Justizweigerung 1. 2; Bestechung 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Justizweigerung 1. 2; Bestechung 1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Iudex_11.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">269</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Se yfela dema . . onwendeð þone rihtan dóm for þæs feos lufon</hi>; Blickling Hom. 61</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Se yfela dema . . onwendeð þone rihtan dóm for þæs feos lufon</hi>; Blickling Hom. 61</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Iudex_11.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">269</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl</hi>. II Ew 8; <hi rend="italic">Gl</hi> Terminaufschub 10</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf</hi>. II Ew 8; <hi rend="italic">Gl</hi> Terminaufschub 10</seg></note>
      </div>
