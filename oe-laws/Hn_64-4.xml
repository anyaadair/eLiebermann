      <div type="clause" n="64.4">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 64.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 64.4" corresp="#wit-lat"><pb n="584" ed="#liebermann"/>Si quis de homicidio accusetur et idem se purgare uelit, secundum natale suum<ptr type="liebermannNote" n="s" target="#Hn_64-4.lnote.oe.s"/> perneget, quod<ptr type="liebermannNote" n="24" target="#Hn_64-4.lnote.oe.24"/> est werelada<ptr type="liebermannNote" n="t" target="#Hn_64-4.lnote.oe.t"/>: ut qui ex parte patris erunt fracto<ptr type="liebermannNote" n="u" target="#Hn_64-4.lnote.oe.u"/> iuramento, qui ex materna cognacione erunt plano<ptr type="liebermannNote" n="n" target="#Hn_64-4.lnote.oe.n"/><ptr type="liebermannNote" n="25" target="#Hn_64-4.lnote.oe.25"/> se sacramento iuraturos aduertat<ptr type="liebermannNote" n="26" target="#Hn_64-4.lnote.oe.26"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 584 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-4.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">schlicht</seg><seg type="translation" xml:lang="en" source="#claude">plainly</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-4.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dagegen laut Angelsächs. Recht und</hi> 74, 1<hi rend="italic">a nach des Erschlagenen Wergeld</hi></seg><seg type="translation" xml:lang="en" source="#claude">whereas according to Anglo-Saxon law and 74, 1<hi rend="italic">a</hi> it follows the slain man’s wergild</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-4.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 12, 3</seg><seg type="translation" xml:lang="en" source="#claude">cf. 12, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-4.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Mischung gestabt und schlicht Schwörender</hi> (<hi rend="italic">vgl.</hi> 64, 6) <hi rend="italic">ist Eigenheit Anglonormannischen Rechts; Brunner</hi> Forsch. G. Dt. R. 328. <hi rend="italic">Die Vatersippe trägt schwereren Theil der Eideslast, sonst in der Helferzahl</hi> (II As. 11; VIII Atr. 23; E Cf. 36, 1), <hi rend="italic">hier in der Eidesform, gilt aber nicht etwa weniger glaubwürdig</hi></seg><seg type="translation" xml:lang="en" source="#claude">A mixture of men swearing the formal oath and men swearing the plain oath (cf. 64, 6) is a peculiarity of Anglo-Norman law; Brunner Forsch. G. Dt. R. 328. The paternal kindred bears the heavier part of the burden of the oath — elsewhere in the number of helpers (II As. 11; VIII Atr. 23; E Cf. 36, 1), here in the form of the oath — but is not, say, considered less credible</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-4.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">que <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">que Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-4.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">-ne <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ne Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-4.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">-ant <hi rend="italic">Sc Hg Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ant Sc Hg Wi Tho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-4.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Totschlag 15f. g; Sippe 8. 20—<hi rend="italic">-ant</hi>{26} besser Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Totschlag 15f. g; Sippe 8. 20—<hi rend="italic">-ant</hi>{26} better Rs</seg></note>
      </div>
