      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 1.1" corresp="#wit-lat"><pb n="673" ed="#liebermann"/>Sed cum in ciuitatem<ptr type="liebermannNote" n="7" target="#LibLond_1-1.lnote.oe.7"/> peruenerit, tunc sit<ptr type="liebermannNote" n="8" target="#LibLond_1-1.lnote.oe.8"/> ei mercatum commune tam<ptr type="liebermannNote" n="f" target="#LibLond_1-1.lnote.oe.f"/> pauperi<ptr type="liebermannNote" n="9" target="#LibLond_1-1.lnote.oe.9"/> quam diuiti.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 673 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_1-1.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">673</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht aus Angelsächs. Formel</hi> ge earm ge eadig <hi rend="italic">z. B.</hi> III Eg. 1, 1</seg><seg type="translation" xml:lang="en" source="#claude">perhaps from the Anglo-Saxon formula ge earm ge eadig, e.g. III Eg. 1, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_1-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">673</biblScope></bibl><seg type="original" xml:lang="de">-te <hi rend="italic">Ai;</hi> -tem <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-te Ai; -tem the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_1-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">673</biblScope></bibl><seg type="original" xml:lang="de">ei sit <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei sit Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_1-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">673</biblScope></bibl><seg type="original" xml:lang="de">di. q. pau. <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">di. q. pau. Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_1-1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Gl</hi> Markt 3; Ballard p. 197 über Zugangsfreiheit zum Markt</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Gl</hi> Markt 3; Ballard p. 197 on freedom of access to the market</seg></note>
