      <div type="clause" n="7.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 7.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 7.2"><pb n="632" ed="#liebermann"/><hi rend="bold">Similiter</hi> qui uaccas<ptr type="liebermannNote" n="5" target="#ECfRetr_7-2.lnote.la.5"/> plures habuerit<ptr type="liebermannNote" n="6" target="#ECfRetr_7-2.lnote.la.6"/>, decimum uitulum; qui unam uel duas<ptr type="liebermannNote" n="7" target="#ECfRetr_7-2.lnote.la.7"/>, de uitulis<ptr type="liebermannNote" n="8" target="#ECfRetr_7-2.lnote.la.8"/> singulis obolos<ptr type="liebermannNote" n="9" target="#ECfRetr_7-2.lnote.la.9"/> singulos.</ab>
        <note type="comparison" source="#liebermann" n="632"><label>printed alongside</label> <ref target="clause:ECf_7-2">ECf 7.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 632 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-2.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">p. u. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. u. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-2.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Dc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-2.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">habuerit <hi rend="italic">fügt zu Cc</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cc adds habuerit</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-2.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">s. u. <hi rend="italic">Hv Dc Cc</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. u. Hv Dc Cc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-2.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">s. o. <hi rend="italic">Dc Cc;</hi> s. denarios <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. o. Dc Cc; s. denarios Hv</seg></note>
      </div>
