    <body>
      <div type="clause" n="52.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 52.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="52.1" corresp="#wit-g-a"><pb n="346" ed="#liebermann"/>Gif hwa mæden<ptr type="liebermannNote" n="20" target="#IICn_52-1.lnote.oe.20"/> nydnæme, gebete þ<hi rend="italic">æt</hi> be were.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="52.1" corresp="#wit-b"><pb n="346" ed="#liebermann"/>Mæden. Gyf hwa mæden nydnæme, gebete þ<hi rend="italic">æt</hi> be his were.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="52.1" corresp="#wit-a"><pb n="346" ed="#liebermann"/>Gif hwa meden nydnæme, gebete þ<hi rend="italic">æt</hi> be wære.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="52.1" corresp="#wit-q"><pb n="347" ed="#liebermann"/>Si<ptr type="liebermannNote" n="16" target="#IICn_52-1.lnote.oe.16"/> quis uiolenter uirginem opprimat, wéra<ptr type="liebermannNote" n="17" target="#IICn_52-1.lnote.oe.17"/> componat.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="52.1" corresp="#wit-inst-cn"><pb n="347" ed="#liebermann"/>[52, 1] Si quis uirginem ui rapuerit et cum ea coierit, reddat eam<ptr type="liebermannNote" n="19" target="#IICn_52-1.lnote.oe.19"/> pretio suo, quod Angli dicunt be hyre<ptr type="liebermannNote" n="20" target="#IICn_52-1.lnote.oe.20-2"/> þere.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="52.1" corresp="#wit-b"><pb n="202" ed="#robertson"/>Mæden. Gyf hwa mæden nydnæme, gebete þæt be his<ptr type="editorNote" n="3" target="#IICn_52-1.robnote.fn.3"/> were.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="282" ed="#rabin-doml"/>Gif hwa mæden nydnæme, gebete þæt be were.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="347" ed="#liebermann"/>(Jungfrau. <hi rend="italic">B</hi>). Wenn einer eine Jungfrau gewaltsam<ptr type="liebermannNote" n="1" target="#IICn_52-1.lnote.de.1"/> sich zur Frau nimmt, büsse er das mit (seinem<ptr type="liebermannNote" n="2" target="#IICn_52-1.lnote.de.2"/> <hi rend="italic">B</hi>) Wergeld.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">(Maiden. B) If anyone takes a maiden by force, let him make amends for it with (his, B) wergild.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="203" ed="#robertson"/>Maidens. If anyone does violence to a maiden he shall make amends by the payment of his wergeld.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="470" ed="#whitelock"/>If anyone takes by force a maiden, he is to compensate for it with the wergild.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="283" ed="#rabin-doml"/>If anyone rapes a maiden, compensation shall be made through the payment of the offender’s wergild.</ab>
        <note type="textual" source="#rabin-doml">B adds rubric Mæden</note>
        <note type="textual" source="#rabin-doml">be were: be his were B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_52-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">347</biblScope></bibl><seg type="original" xml:lang="de">54; 54,1 <hi rend="italic">setzt vor</hi> 52 <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">K places 54; 54,1 before 52</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_52-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">347</biblScope></bibl><seg type="original" xml:lang="de">weram <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">weram T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_52-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">346</biblScope></bibl><seg type="original" xml:lang="de">med. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">med. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_52-1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">347</biblScope></bibl><seg type="original" xml:lang="de">pretium suum <hi rend="italic">Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">pretium suum Lb S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_52-1.lnote.oe.20-2" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">347</biblScope></bibl><seg type="original" xml:lang="de">híre <hi rend="italic">Cb Lb</hi> [<hi rend="italic">vgl. Anm.</hi> 13]</seg><seg type="translation" xml:lang="en" source="#claude">híre Cb Lb [cf. note 13]</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_52-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">209</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Dass Täter die Frau restituiere, nimmt an Brunner <hi rend="italic">Savigny Zs. RG., Germ</hi>. 23, 253</seg><seg type="translation" xml:lang="en" source="#claude">Brunner <hi rend="italic">Savigny Zs. RG., Germ</hi>. 23, 253 assumes that the offender restored the woman</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_52-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">209</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. o</hi>. 52²</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. above</hi> 52²</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_52-1.robnote.fn.3" n="3" source="#robertson"><bibl><biblScope unit="page">202</biblScope></bibl><label>his</label><seg type="original" xml:lang="en">Om. G, A, Ld.</seg></note>
      </div>
