        <note type="liebermannNote" subtype="textual" xml:id="Hn_20.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">C. XXI <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">C. XXI Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Überschrift fehlt Sc, wo aber Initiale;</hi> De causis participantibus <hi rend="italic">roth Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">heading lacking in Sc, where there is, however, an initial; De causis participantibus in red Hg</seg></note>
