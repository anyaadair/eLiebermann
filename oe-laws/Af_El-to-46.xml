      <div type="clause" n="El. 46">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 46</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 46" corresp="#wit-e"><pb n="40" ed="#liebermann"/>Ne onfoh<ptr type="liebermannNote" n="39" target="#Af_El-to-46.lnote.oe.39"/> ðu næfre médsceattum<ptr type="liebermannNote" n="40" target="#Af_El-to-46.lnote.oe.40"/>, forðon hie ablendað ful óft wisra<ptr type="liebermannNote" n="41" target="#Af_El-to-46.lnote.oe.41"/> monna geðoht<ptr type="liebermannNote" n="42" target="#Af_El-to-46.lnote.oe.42"/> ⁊ hiora word onwendað.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 46" corresp="#wit-g-prol-only"><pb n="40" ed="#liebermann"/>Ne onfoh ðu næfre medsceattu<hi rend="italic">m</hi>, forðon hí áblendað ful oft wisra manna geðoht ⁊ hyra word onwendað.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 46" corresp="#wit-h"><pb n="41" ed="#liebermann"/>Ne onfoh þu<ptr type="liebermannNote" n="16" target="#Af_El-to-46.lnote.oe.16"/> næfre metsceattum, forðon þe hy<ptr type="liebermannNote" n="12" target="#Af_El-to-46.lnote.oe.12"/> ablændaþ ful oft wisra monna<ptr type="liebermannNote" n="2" target="#Af_El-to-46.lnote.oe.2"/> geþoht ⁊<ptr type="liebermannNote" n="17" target="#Af_El-to-46.lnote.oe.17"/> heora word awendaþ.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 46" corresp="#wit-q"><pb n="41" ed="#liebermann"/>Nec accipies munera quę etiam<ptr type="liebermannNote" n="13" target="#Af_El-to-46.lnote.oe.13"/> excecant prudentes et subuertunt<ptr type="liebermannNote" n="14" target="#Af_El-to-46.lnote.oe.14"/> uerba iustorum.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 46" corresp="#wit-e"><pb n="260" ed="#jurasinski-and-oliver"/>Ne onfoh ðu næfre médsceattum, forðon hie ablendað ful óft wisra monna geðoht ⁊ hiora word onwendað.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="41" ed="#liebermann"/>Niemals nimm du Lohngelder<ptr type="liebermannNote" n="1" target="#Af_El-to-46.lnote.de.1"/> an; denn die verblenden gar oft weiser Männer Denken und verdrehen deren Worte.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Never accept bribes; for they very often blind the thinking of wise men and pervert their words.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="261" ed="#jurasinski-and-oliver"/>Never receive bribes, for they often blind the thoughts of wise men and misdirect their words.</ab>
        <note type="passageSource">Exodus 23,8</note>
        <note type="comparison" source="#liebermann" n="41">Exodus 23.8</note>
        <note type="comparisonPrinted" source="#liebermann">[23, 8]</note>
        <note type="comparedBy" source="#wormald-mel" n="290"><ref target="clause:IIEw_2">II Ew 2</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-46.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">-foþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-foþ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-46.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">-atas f. hi <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-atas f. hi Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-46.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">-re <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-re Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-46.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">geþeahte <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">geþeahte Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-46.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-46.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-46.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geändert in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-46.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de">⁊ h. — æl. ⁊ <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">⁊ h. — æl. ⁊ on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-46.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de">exc. etiam <hi rend="italic">Dm T;</hi> exc. et <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">exc. etiam Dm T; exc. et R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-46.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de">-tit <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tit Dm</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-46.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">47</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Restechung 1 [korrigiere dort: 46]</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Restechung 1 [correct there: 46]</seg></note>
      </div>
