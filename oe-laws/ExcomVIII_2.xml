      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:ExcomVIII">Excom VIII</ref> 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom VIII 2" corresp="#wit-h"><pb n="439" ed="#liebermann"/>excommunicamus et anathematizamus hunc (uel<ptr type="liebermannNote" n="i" target="#ExcomVIII_2.lnote.oe.i"/> -os<ptr type="liebermannNote" n="3" target="#ExcomVIII_2.lnote.oe.3"/>) furem<ptr type="liebermannNote" n="k" target="#ExcomVIII_2.lnote.oe.k"/> (-s<ptr type="liebermannNote" n="3" target="#ExcomVIII_2.lnote.oe.3"/>) — uel hunc (uel -os) malefactorem (-s) — N. et a liminibus<ptr type="liebermannNote" n="l" target="#ExcomVIII_2.lnote.oe.l"/> sanctę Dei ęcclesię sequestramus,</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 439 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVIII_2.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">439</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier Alternative für den Fall, dass mehrere betroffen werden, wie</hi> Iud. Dei I <hi rend="italic">o. S.</hi> 401⁶· ¹⁹ <hi rend="italic">für den Einzelfall</hi></seg><seg type="translation" xml:lang="en" source="#claude">here an alternative for the case where several persons are concerned, like Iud. Dei I above p. 401⁶· ¹⁹ for the individual case</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVIII_2.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">439</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> V 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> V 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVIII_2.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">439</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> I 11, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> I 11, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVIII_2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">439</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr., ebenso fernerhin (Eingeklammertes)</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above, as also hereafter (the bracketed words)</seg></note>
      </div>
