        <head><ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 4.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 4.6" corresp="#wit-du" ana="#glossed"><pb n="411" ed="#liebermann"/><seg type="glossed"><seg type="base">Per</seg><gloss xml:lang="ang">ðerh</gloss></seg> <seg type="glossed"><seg type="base">unigenitum</seg><gloss xml:lang="ang">ancend<hi rend="italic">e<ptr type="liebermannNote" n="7" target="#IudDeiIV_4-6.lnote.oe.7"/></hi></gloss></seg> <seg type="glossed"><seg type="base">filium</seg><gloss xml:lang="ang">bearne</gloss></seg> <seg type="glossed"><seg type="base">tuum</seg><gloss xml:lang="ang">ðin<hi rend="italic">um</hi></gloss></seg> <seg type="glossed"><seg type="base">dominum</seg><gloss xml:lang="ang">driht<hi rend="italic">ne</hi></gloss></seg> <seg type="glossed"><seg type="base">nostrum</seg><gloss xml:lang="ang">vsv<hi rend="italic">m</hi></gloss></seg> <seg type="glossed"><seg type="base">Iesum</seg><gloss xml:lang="ang">hæl<hi rend="italic">ende<ptr type="liebermannNote" n="8" target="#IudDeiIV_4-6.lnote.oe.8"/></hi></gloss></seg> <seg type="glossed"><seg type="base">Christum,</seg><gloss xml:lang="ang">Crist<hi rend="italic">e</hi>,</gloss></seg> <seg type="glossed"><seg type="base">qui</seg><gloss xml:lang="ang">se ðe</gloss></seg> <seg type="glossed"><seg type="base">tecum</seg><gloss xml:lang="ang">ðec mið</gloss></seg> <seg type="glossed"><seg type="base">in</seg><gloss xml:lang="ang">in</gloss></seg> <seg type="glossed"><seg type="base">unitate</seg><gloss xml:lang="ang">anniso</gloss></seg> <seg type="glossed"><seg type="base">Spiritus</seg><gloss xml:lang="ang">Gast<hi rend="italic">es</hi></gloss></seg> <seg type="glossed"><seg type="base">sancti</seg><gloss xml:lang="ang">hal<hi rend="italic">ges</hi></gloss></seg> <seg type="glossed"><seg type="base">uiuit</seg><gloss xml:lang="ang">liof<hi rend="italic">as</hi></gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">regnat</seg><gloss xml:lang="ang">ric<hi rend="italic">sas</hi></gloss></seg> <seg type="glossed"><seg type="base">Deus</seg><gloss xml:lang="ang">God</gloss></seg> <seg type="glossed"><seg type="base">per</seg><gloss xml:lang="ang">ð[<hi rend="italic">erh</hi>]<ptr type="liebermannNote" n="9" target="#IudDeiIV_4-6.lnote.oe.9"/></gloss></seg> <seg type="glossed"><seg type="base">omnia</seg><gloss xml:lang="ang">al<hi rend="italic">lra</hi></gloss></seg> <seg type="glossed"><seg type="base">secula</seg><gloss xml:lang="ang">wor<hi rend="italic">ulda<ptr type="liebermannNote" n="10" target="#IudDeiIV_4-6.lnote.oe.10"/></hi></gloss></seg> <seg type="glossed"><seg type="base">seculorum.</seg><gloss xml:lang="ang">wor<hi rend="italic">uld</hi>,</gloss></seg> <seg type="glossed"><seg type="base">Amen.</seg><gloss xml:lang="ang">soðlice.</gloss></seg></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 411 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-6.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de">ðerh <hi rend="italic">mit Dativ</hi> (<hi rend="italic">Toller</hi> Anglo-Saxon dict. 1078 II 2) <hi rend="italic">Note</hi> 37; <hi rend="italic">vgl. Dativ</hi> ondetende 5</seg><seg type="translation" xml:lang="en" source="#claude">ðerh with the dative (Toller Anglo-Saxon dict. 1078 II 2) note 37; cf. the dative ondetende 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-6.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. o.</hi> 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. above 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-6.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de">ð al' <hi rend="italic">Du</hi></seg><seg type="translation" xml:lang="en" source="#claude">ð al’ Du</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-6.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">gegen das Latein stelle ich Genetiv voran, gemäss Rituale Dun. p.</hi> 22. 60. 110. 145</seg><seg type="translation" xml:lang="en" source="#claude">contrary to the Latin I put the genitive first, in accordance with Rituale Dun. p. 22. 60. 110. 145</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-du">Through your only-begotten Son our Lord Jesus Christ, who with you in the unity of the Holy Spirit lives and reigns, God, for ever and ever. Amen.</ab>
      </div>
