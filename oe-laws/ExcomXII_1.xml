      <div type="clause" n="1">
        <head><ref type="lawCode" target="law:ExcomXII">Excom XII</ref> 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom XII 1" corresp="#wit-q"><pb n="441" ed="#liebermann"/>Auctoritate Dei omnipotentis, patris et filii et Spiritus sancti, et sanctę Dei genitricis Marię<ptr type="liebermannNote" n="b" target="#ExcomXII_1.lnote.oe.b"/> sancteque matris<ptr type="liebermannNote" n="c" target="#ExcomXII_1.lnote.oe.c"/> ecclesie et sanctorum canonum<ptr type="liebermannNote" n="d" target="#ExcomXII_1.lnote.oe.d"/>,</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 441 (two independent readings of the page images, differences settled against the page); Liebermann’s heading: [XII. aus Q]; F: corrected against Liebermann, Gesetze I (date at the head of the text); Wormald, Making of English Law I; Whitelock, English Historical Documents I, October 2026 (was “c. 900–c. 1100 (Liebermann)”, now “c. 900–c. 1100 (Liebermann, I p. 441)”)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXII_1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Hs. Cotton Vespasian</hi> D XV <hi rend="italic">f.</hi> 3<hi rend="italic">b, um</hi> 1130, <hi rend="italic">Schmutzblatt vor einem Benedictionale.</hi> XII <hi rend="italic">steht</hi> IX. XIII <hi rend="italic">zunächst</hi></seg><seg type="translation" xml:lang="en" source="#claude">MS Cotton Vespasian D XV f. 3b, c. 1130, flyleaf before a benedictional. XII is closest to IX and XIII</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXII_1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> V 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> V 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXII_1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> XIII 2, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. XIII 2, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXII_1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> III 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> III 1</seg></note>
