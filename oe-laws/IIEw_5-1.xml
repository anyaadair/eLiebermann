      <div type="clause" n="5.1">
        <head><ref type="lawCode" target="law:IIEw">II Ew</ref> 5.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.1" corresp="#wit-h"><pb n="144" ed="#liebermann"/>Gif he ðonne nelle, ðolige ure ealra freonscipes<ptr type="liebermannNote" n="*" target="#IIEw_5-1.lnote.oe.star"/> ⁊ ealles ðæs ðe he age.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.1" corresp="#wit-b"><pb n="144" ed="#liebermann"/>Gif he ðon<hi rend="italic">ne</hi> nelle<ptr type="liebermannNote" n="1" target="#IIEw_5-1.lnote.oe.1"/>, ðolige ure ealra freodscipes<ptr type="liebermannNote" n="2" target="#IIEw_5-1.lnote.oe.2"/> ⁊ ealles ðæs ðe he age.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.1" corresp="#wit-q"><pb n="145" ed="#liebermann"/>Si autem nolit, perdat omnium nostrum amiciciam et omne quod habebit.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="5.1" corresp="#wit-h"><pb n="120" ed="#attenborough"/>Gif he ðonne nelle, ðolige ure ealra freonscipes<ptr type="editorNote" n="7" target="#IIEw_5-1.attnote.fn.7"/> ⁊ ealles ðæs ðe he age.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="145" ed="#liebermann"/>Wenn er aber [dessen<ptr type="liebermannNote" n="1" target="#IIEw_5-1.lnote.de.1"/>] sich weigert, verliere er unser aller Freundschaft<ptr type="liebermannNote" n="2" target="#IIEw_5-1.lnote.de.2"/> und alles, was er besitzt.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">But if he refuses [this], let him lose the friendship of all of us and everything that he owns.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="121" ed="#attenborough"/>If, however, he is not willing to do so, he shall forfeit the friendship of all of us, and all that he possesses.</ab>
        <note type="comparedBy" source="#wormald-mel" n="315"><ref target="clause:IIIEg_3">III Eg 3</ref></note>
        <note type="editorial">H reads ‘freonscipes’; Liebermann emends to ‘freodscipes’ from Ld.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_5-1.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">144</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> freonds. <hi rend="italic">aus Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">read freonds. from Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_5-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">144</biblScope></bibl><seg type="original" xml:lang="de">nylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">nylle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_5-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">144</biblScope></bibl><seg type="original" xml:lang="de">freonds. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">freonds. Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEw_5-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">95</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Der Busse für Eidbruch; <hi rend="italic">ebd.</hi> 8e. 9</seg><seg type="translation" xml:lang="en" source="#claude">The compensation for breach of oath; <hi rend="italic">ibid.</hi> 8e. 9</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEw_5-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">95</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Huldentziehung; <hi rend="italic">s. Gl</hi> Gnade 6; Vermögenseinziehung 10o. Zwar ist das Leben nicht ausdrücklich bedroht, der Weigerer gilt aber dem Friedlosen (<hi rend="italic">s. d. Gl</hi> 1n. p) gleich; denn seine Begünstigung (<hi rend="italic">s. d. Gl</hi> 2. 17f.) wird wie die des Friedlosen geahndet in 5, 2</seg><seg type="translation" xml:lang="en" source="#claude">Withdrawal of favour; see <hi rend="italic">Gl</hi> Gnade 6; Vermögenseinziehung 10o. His life is not, it is true, expressly threatened, but the man who refuses is treated as equivalent to the outlaw (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1n. p); for harbouring him (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 2. 17f.) is punished in 5, 2 like harbouring the outlaw</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIEw_5-1.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">120</biblScope></bibl><label>freonscipes</label><seg type="original" xml:lang="en"><hi rend="italic">freondscipes</hi>. Ld. <hi rend="italic">freodscipes</hi>. B.</seg></note>
      </div>
    </body>
