    <body>
      <div type="clause" n="38.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 38.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="38.1" corresp="#wit-e"><pb n="72" ed="#liebermann"/>Gif he<ptr type="liebermannNote" n="1" target="#Af_38-1.lnote.oe.1"/> folcgemot mid wæpnes bryde árære, ðam<ptr type="liebermannNote" n="2" target="#Af_38-1.lnote.oe.2"/> ealdormen hundtwelftig<ptr type="liebermannNote" n="3" target="#Af_38-1.lnote.oe.3"/> scill. to wite.<ptr type="liebermannNote" n="4" target="#Af_38-1.lnote.oe.4"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="38.1" corresp="#wit-h"><pb n="72" ed="#liebermann"/>Gif he folces gemot mid wæpnes bryde arære, þam ealdermen CXX scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="38.1" corresp="#wit-b-no-prol"><pb n="72" ed="#liebermann"/>… . ⁊<ptr type="liebermannNote" n="1" target="#Af_38-1.lnote.oe.1-3"/> hundtwelftig scill. to wite.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="38.1" corresp="#wit-q"><pb n="73" ed="#liebermann"/>Si quis folcgemot<ptr type="liebermannNote" n="1" target="#Af_38-1.lnote.oe.1-2"/> (id est populi<ptr type="liebermannNote" n="2" target="#Af_38-1.lnote.oe.2-2"/> placitum) armorum exercione<ptr type="liebermannNote" n="3" target="#Af_38-1.lnote.oe.3-2"/> turbabit<ptr type="liebermannNote" n="4" target="#Af_38-1.lnote.oe.4-2"/>, emendet aldermanno CXX<ptr type="liebermannNote" n="5" target="#Af_38-1.lnote.oe.5"/> sol. wite (id est forisfacture).</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="80" ed="#attenborough"/>Gif he folcgemot<ptr type="editorNote" n="21" target="#Af_38-1.attnote.fn.21"/> mid wæpnes bryde árære, ðam ealdormen hundtwelftig scill. to wite<ptr type="editorNote" n="22" target="#Af_38-1.attnote.fn.22"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="39.1" corresp="#wit-e"><pb n="336" ed="#jurasinski-and-oliver"/>Gif he folcgemot mid wæpnes bryde árære, ðam ealdormen hundtwelftig scill to wite.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="73" ed="#liebermann"/>Wenn er<ptr type="liebermannNote" n="1" target="#Af_38-1.lnote.de.1"/> [solche] Volksversammlung durch Waffenzücken [ohne<ptr type="liebermannNote" n="2" target="#Af_38-1.lnote.de.2"/> Gefecht] aufregt: jenem Ealdorman 120 Schill.<ptr type="liebermannNote" n="3" target="#Af_38-1.lnote.de.3"/> als Strafgeld.<ptr type="liebermannNote" n="4" target="#Af_38-1.lnote.de.4"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he stirs up [such] a public assembly by drawing a weapon [without fighting]: 120 shillings to that ealdorman as a fine.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="81" ed="#attenborough"/>If he disturbs the meeting by drawing his weapon, he shall pay a fine of 120 shillings to the <hi rend="italic">ealdorman</hi>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="415" ed="#whitelock"/>If he disturbs a public meeting by drawing a weapon, [he is to pay] 120 shillings to the ealdorman as a fine.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="337" ed="#jurasinski-and-oliver"/>If he disrupts the folk meeting by drawing his weapon, 120 shillings to the <hi rend="italic">ealdorman</hi> as fine.</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="337"><label>cf.</label> <ref target="clause:Af_39-1">Af 39.1</ref> <quote>Alfred §40.1 states that drawing a weapon in a ceorl's house but not using it to fight draws half the fine of a fight.</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_38-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">hwa</hi> folces gemote <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">hwa</hi> folces gemote Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_38-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_38-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de">CXX <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">CXX Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_38-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">gesylle</hi> <hi rend="italic">fügt zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">gesylle</hi> added by Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_38-1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">73</biblScope></bibl><seg type="original" xml:lang="de">folegre. <hi rend="italic">R;</hi> folcmot <hi rend="italic">Hk Br;</hi> folchesmot <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">folegre. R; folcmot Hk Br; folchesmot Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_38-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">73</biblScope></bibl><seg type="original" xml:lang="de">pl. po. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">pl. po. R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_38-1.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">73</biblScope></bibl><seg type="original" xml:lang="de">-cicione <hi rend="italic">Br Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cicione Br Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_38-1.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">73</biblScope></bibl><seg type="original" xml:lang="de">-auit <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">-auit T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_38-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">73</biblScope></bibl><seg type="original" xml:lang="de">CXX <hi rend="italic">bis</hi> aldremanno <hi rend="italic">überspringt R</hi></seg><seg type="translation" xml:lang="en" source="#claude">CXX to aldremanno omitted by R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_38-1.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">später</hi></seg><seg type="translation" xml:lang="en" source="#claude">later</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_38-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘Einer’ Ld</seg><seg type="translation" xml:lang="en" source="#claude">‘One’ Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_38-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Waffenzücken 4. Die Ergänzung folgt aus 39, 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Waffenzücken 4. The supplement follows from 39, 1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_38-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Dies trifft also Störung des Gerichtsfriedens</seg><seg type="translation" xml:lang="en" source="#claude">This therefore concerns disturbance of the peace of the court</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_38-1.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘gebe er’ fügt Ld zu. Über die Zahl in Inst. <hi rend="italic">s. o.</hi> 38⁷</seg><seg type="translation" xml:lang="en" source="#claude">Ld adds ‘let him give’. On the number in Inst. <hi rend="italic">see above</hi> 38⁷</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_38-1.attnote.fn.21" n="21" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>folcgemot</label><seg type="original" xml:lang="en"><hi rend="italic">folces gemot</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_38-1.attnote.fn.22" n="22" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>wite</label><seg type="original" xml:lang="en">om. <hi rend="italic">to wite</hi>. H.</seg></note>
      </div>
