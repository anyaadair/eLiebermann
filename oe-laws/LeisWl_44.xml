  <text>
    <body>
      <div type="clause" n="44">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 44</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-i"><ptr type="liebermannNote" n="11" target="#LeisWl_44.lnote.oe.11"/><pb n="517" ed="#liebermann"/>Ne prenge hum<ptr type="liebermannNote" n="12" target="#LeisWl_44.lnote.oe.12"/> nam [nu]l<ptr type="liebermannNote" n="13" target="#LeisWl_44.lnote.oe.13"/> en conté ne defors, d’ici qu’il eit tres foiz<ptr type="liebermannNote" n="14" target="#LeisWl_44.lnote.oe.14"/> demandé dreit el hundred u el conté.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="517" ed="#liebermann"/>Ne quis temere namium<ptr type="liebermannNote" n="1" target="#LeisWl_44.lnote.oe.1"/> capiat. Nullus namium<ptr type="liebermannNote" n="1" target="#LeisWl_44.lnote.oe.1"/> capiat in comitatu uel extra, nisi rectum in hundredo uel comitatu tercio postulauerit.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="44" corresp="#wit-i"><pb n="272" ed="#robertson"/>Ne prenge hum nam [nu]l en conté ne defors, d'ici qu'il eit tres foiz demandé dreit el hundred u el conté.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="517" ed="#liebermann"/>44. Niemand nehme ein Pfand<ptr type="liebermannNote" n="d" target="#LeisWl_44.lnote.de1.d"/> [für Urtheilserfüllung dem Processgegner] fort, im Grafschaftsgericht, noch ausser[gerichtlich], bis er dreimal [vergeblich] Recht im Hundert- oder im<ptr type="liebermannNote" n="e" target="#LeisWl_44.lnote.de1.e"/> Grafschaftsgericht gefordert hat.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">44. Let no one take away a pledge [from the opposing party for fulfilment of the judgement], in the shire court nor out[side the court], until he has three times demanded justice [in vain] in the hundred or in the shire court.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-i"><pb n="273" ed="#robertson"/>No-one shall make distraint of property either in the county court or outside it, until he has demanded justice three times in the hundred or in the county courts.</ab>
        <note type="comparison" source="#liebermann" n="517"><ref target="clause:IICn_19">II Cn 19</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 19</note>
        <note type="editorial">Added October 2026 from Robertson pp. 272–273 (text and translation); Liebermann’s text and German translation added from Gesetze I p. 517, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_44.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">517</biblScope></bibl><seg type="original" xml:lang="de">XLII. <hi rend="italic">I</hi></seg><seg type="translation" xml:lang="en" source="#claude">XLII. I</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_44.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">517</biblScope></bibl><seg type="original" xml:lang="de">hun <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">hun Im</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_44.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">517</biblScope></bibl><seg type="original" xml:lang="de">mil <hi rend="italic">I</hi></seg><seg type="translation" xml:lang="en" source="#claude">mil I</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_44.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">517</biblScope></bibl><seg type="original" xml:lang="de">fois demand <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">fois demand Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_44.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">517</biblScope></bibl><seg type="original" xml:lang="de">nāmum <hi rend="italic">oder</hi> nānium <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">nāmum or nānium S</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="LeisWl_44.lnote.de1.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">517</biblScope></bibl><seg type="original" xml:lang="de">nam <hi rend="italic">entnahm England nicht der Normandie, auf deren</hi> Coutumier <hi rend="italic">Frühere hinweisen, sondern lange vor</hi> 1066 <hi rend="italic">dem Norden</hi></seg><seg type="translation" xml:lang="en" source="#claude">England took nam not from Normandy, to whose Coutumier earlier editors refer, but from the North, long before 1066</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="LeisWl_44.lnote.de1.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">517</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">falscher Zusatz laut</hi> 44, 1</seg><seg type="translation" xml:lang="en" source="#claude">a false addition, according to 44, 1</seg></note>
      </div>
    </body>
