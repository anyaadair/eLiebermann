      <div type="clause" n="87.8">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 87.8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 87.8" corresp="#wit-lat"><pb n="602" ed="#liebermann"/>Qui in collegio uel societate fuerit, ubi aliquis occidatur, acquietet se, quod eum non percussit, et<ptr type="liebermannNote" n="14" target="#Hn_87-8.lnote.oe.14"/> ita quartam<ptr type="liebermannNote" n="g" target="#Hn_87-8.lnote.oe.g"/> partem compositionis eius soluat, siue plures siue pauciores plagas uel quotcunque<ptr type="liebermannNote" n="15" target="#Hn_87-8.lnote.oe.15"/> uel qualescunque habeat uite retractione<ptr type="liebermannNote" n="h" target="#Hn_87-8.lnote.oe.h"/> uel mortis simplicitate discretas.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 602 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-8.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 88, 18<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 88, 18<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-8.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">retractacione <hi rend="italic">Sc, vielleicht laut</hi> 90, 11<hi rend="italic">b</hi> remotione uel m. propinquitate <hi rend="italic">gemeint</hi></seg><seg type="translation" xml:lang="en" source="#claude">retractacione <hi rend="italic">Sc; perhaps, in the light of</hi> 90, 11<hi rend="italic">b</hi>, remotione uel m. propinquitate <hi rend="italic">is meant</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-8.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-8.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">quodc. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">quodc. Lond</seg></note>
