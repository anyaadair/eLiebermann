    <body>
      <div type="clause" n="El. 14">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 14</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 14" corresp="#wit-e"><pb n="30" ed="#liebermann"/>Se ðe slea his fæder oððe his modor, se sceal deaðe<ptr type="liebermannNote" n="24" target="#Af_El-to-14.lnote.oe.24"/> sweltan.<ptr type="liebermannNote" n="38" target="#Af_El-to-14.lnote.oe.38"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 14" corresp="#wit-g-prol-only"><pb n="30" ed="#liebermann"/>Se ðe slea his fæder oððe his modor, se sceal deaðe swyltan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 14" corresp="#wit-h"><pb n="31" ed="#liebermann"/>Se þe slea his fæder oððe his moder, swelte se deaþe.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 14" corresp="#wit-q"><pb n="31" ed="#liebermann"/>Qui percusserit patrem aut matrem, morte moriatur.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 14" corresp="#wit-e"><pb n="238" ed="#jurasinski-and-oliver"/>Se ðe slea his fæder oððe his modor, se sceal deaðe sweltan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="31" ed="#liebermann"/>Wer seinen Vater oder seine Mutter schlägt<ptr type="liebermannNote" n="1" target="#Af_El-to-14.lnote.de.1"/>, der soll Todes<ptr type="liebermannNote" n="2" target="#Af_El-to-14.lnote.de.2"/> sterben.<ptr type="liebermannNote" n="3" target="#Af_El-to-14.lnote.de.3"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Whoever strikes his father or his mother shall die the death.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="239" ed="#jurasinski-and-oliver"/>He who strikes his father or his mother, he shall die [the] death.</ab>
        <note type="passageSource">Exodus 21,15</note>
        <note type="comparison" source="#liebermann" n="31">Exodus 21.15</note>
        <note type="comparisonPrinted" source="#liebermann">[21, 15]</note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-14.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">30</biblScope></bibl><seg type="original" xml:lang="de">deaþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">deaþ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-14.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">30</biblScope></bibl><seg type="original" xml:lang="de">-te <hi rend="italic">So, wo der zweitnächste Satz schon hier folgt</hi></seg><seg type="translation" xml:lang="en" source="#claude">-te So, where the next sentence but one already follows here</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-14.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">44</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘tötet’ Schmid, aber Af bewahrt den Doppelsinn der Vulg., ebenso ‘smiteth’ Price</seg><seg type="translation" xml:lang="en" source="#claude">‘kills’ Schmid, but Af preserves the double meaning of the Vulg., likewise ‘smiteth’ Price</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-14.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">44</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Selbst Verwandten<hi rend="spaced">mord</hi> (<hi rend="italic">s. d. Gl</hi>) fand nicht regelmässig staatliche Strafe. Ælfred wünscht Eltern (<hi rend="italic">s. d. Gl</hi> 2) geschützt; <hi rend="italic">s. u.</hi> El 15⁸</seg><seg type="translation" xml:lang="en" source="#claude">Even the <hi rend="italic">murder</hi> of kinsmen (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi>) did not regularly incur public punishment. Ælfred wishes parents (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 2) to be protected; see below El 15⁸</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-14.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">44</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Logischer Ordnung zuliebe lässt So den übernächsten Satz Ex 21, 17 schon hier folgen</seg><seg type="translation" xml:lang="en" source="#claude">For the sake of logical order So has the sentence after next, Ex 21, 17, follow already here</seg></note>
      </div>
    </body>
  </text>
