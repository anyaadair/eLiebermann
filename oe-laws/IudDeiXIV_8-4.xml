      <div type="clause" n="8.4">
        <head><ref type="lawCode" target="law:IudDeiXIV">Iud Dei XIV</ref> 8.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIV 8.4" corresp="#wit-lat"><pb n="426" ed="#liebermann"/>Scrutans<ptr type="liebermannNote" n="53" target="#IudDeiXIV_8-4.lnote.oe.53"/> ergo<ptr type="liebermannNote" n="54" target="#IudDeiXIV_8-4.lnote.oe.54"/> tu corda<ptr type="liebermannNote" n="55" target="#IudDeiXIV_8-4.lnote.oe.55"/> et renes et solus sciens cogitationes hominis<ptr type="liebermannNote" n="56" target="#IudDeiXIV_8-4.lnote.oe.56"/>, ne perdas iustum cum impio, sed aequitatem misericordiae tuae in illis ostende, ut, quomodo in aqua benedictionis pudicitiam et stuprum discreuisti<ptr type="liebermannNote" n="57" target="#IudDeiXIV_8-4.lnote.oe.57"/> quondam, ita quoque nostris temporibus in hac tua creatura operare miracula, ut discant omnes fines terrae iudicia tua, qui es benedictus in secula seculorum. Amen.</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Num. 5, 17</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 426 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8-4.lnote.oe.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de">-aris <hi rend="italic">Vt Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">-aris Vt Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8-4.lnote.oe.54" n="54" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de">tu e. <hi rend="italic">Bb</hi></seg><seg type="translation" xml:lang="en" source="#claude">tu e. Bb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8-4.lnote.oe.55" n="55" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de">r. et c. <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. et c. Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_8-4.lnote.oe.56" n="56" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">426</biblScope></bibl><seg type="original" xml:lang="de">-num <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-num Zeu.</seg></note>
