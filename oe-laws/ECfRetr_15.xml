    <body>
      <div type="clause" n="15">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 15</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 15"><pb n="641" ed="#liebermann"/><hi rend="spaced">Lex<ptr type="liebermannNote" n="1" target="#ECfRetr_15.lnote.la.1"/> murdrorum.</hi> <hi rend="bold">Si</hi> quis<hi rend="bold">piam</hi><ptr type="liebermannNote" n="2" target="#ECfRetr_15.lnote.la.2"/> murdratus alicubi<ptr type="liebermannNote" n="3" target="#ECfRetr_15.lnote.la.3"/> reperiebatur, querebatur apud uillam, ubi inueniebatur, interfector illius; <hi rend="bold">qui</hi> si inueniri poterat<ptr type="liebermannNote" n="4" target="#ECfRetr_15.lnote.la.4"/>, tradebatur iusticie<ptr type="liebermannNote" n="5" target="#ECfRetr_15.lnote.la.5"/> regis infra <hi rend="bold">ipsos</hi> octo dies interfectionis<ptr type="liebermannNote" n="6" target="#ECfRetr_15.lnote.la.6"/>.</ab>
        <note type="comparison" source="#liebermann" n="641"><label>printed alongside</label> <ref target="clause:ECf_15">ECf 15</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 641 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Cb K</hi> (<hi rend="italic">wo dies Capitel erst hinter c.</hi> 36 <hi rend="italic">folgt</hi>); De legibus murdratorum <hi rend="italic">Lb Va Hv Db;</hi> De murdro <hi rend="italic">Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Cb K (where this chapter only follows after c. 36); De legibus murdratorum Lb Va Hv Db; De murdro Pl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">quis m. fuerit et aliquis reprobatur, queratur a. u. et ubi inueniatur <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">quis m. fuerit et aliquis reprobatur, queratur a. u. et ubi inueniatur Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">alicui <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">alicui K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-rit, tradetur <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rit, tradetur Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-cia <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cia K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">fügt zu Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cb adds eius</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">The law of murders. If anyone was found murdered anywhere, his slayer was sought at the vill where he was found; who, if he could be found, was handed over to the king's justice within those eight days of the killing.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">346</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">L.</hi><hi rend="superscript">1</hi> <hi rend="italic">murdrorum</hi> — <hi rend="italic">alicui</hi><hi rend="superscript">8</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">L.</hi><hi rend="superscript">1</hi> <hi rend="italic">murdrorum</hi> — <hi rend="italic">alicui</hi><hi rend="superscript">8</hi> Rs</seg></note>
      </div>
    </body>
