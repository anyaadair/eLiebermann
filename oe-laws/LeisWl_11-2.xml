      <div type="clause" n="11.2">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 11.2</head>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-hk"><pb n="500–501" ed="#liebermann"/>De l’ungle, s’il le couped de la charn, V sol. de souz Engleis. A l’ungle del petit dei IIII den.</ab>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-i"><pb n="500–501" ed="#liebermann"/>De l’ungle, s’i[l]<ptr type="liebermannNote" n="25" target="#LeisWl_11-2.lnote.oe.25"/> l[e] colpe<ptr type="liebermannNote" n="d" target="#LeisWl_11-2.lnote.oe.d"/>, de cascun<ptr type="liebermannNote" n="b" target="#LeisWl_11-2.lnote.oe.b"/> V solz. de solt<ptr type="liebermannNote" n="22" target="#LeisWl_11-2.lnote.oe.22"/> Engleis. A l’ungle de petit dei IIII den.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="500–501" ed="#liebermann"/>si unguem pollicis uel alicuius<ptr type="liebermannNote" n="3" target="#LeisWl_11-2.lnote.oe.3"/> digiti maioris V sol., si unguem auricularis IIII den.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="11.2" corresp="#wit-hk"><pb n="258" ed="#robertson"/>De l'ungle, s'il le couped de la charn, V sol. de souz Engleis. A l'ungle del petit dei, IIII den.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="500–501" ed="#liebermann"/>11, 2. Für den Nagel<ptr type="liebermannNote" n="1" target="#LeisWl_11-2.lnote.de.1"/>, wenn er ihn vom Fleische haut, (für jeden <hi rend="italic">IL</hi>) 5 Schill. an Englischem Schilling(en <hi rend="italic">Hk</hi>); beim Nagel des kleinen Fingers 4<ptr type="liebermannNote" n="f" target="#LeisWl_11-2.lnote.de1.f"/> Pfennig.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">11, 2. For the nail, if he cuts it from the flesh, (for each <hi rend="italic">IL</hi>) 5 shill. in English shilling(s <hi rend="italic">Hk</hi>); for the nail of the little finger 4 pennies.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-hk"><pb n="259" ed="#robertson"/>For the nail if it is cut away from the flesh, 5 English shillings [shall be paid], and for the nail of the little finger 4 pence.</ab>
        <note type="comparison" source="#liebermann" n="501"><ref target="clause:Af_56-1">Af 56.1</ref>; <ref target="clause:Af_60">Af 60</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 56, 1 | ebd. 60</note>
        <note type="editorial">Added October 2026 from Robertson pp. 258–259 (text and translation); Liebermann’s text and German translation added from Gesetze I p. 500–501, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_11-2.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">500</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so auch L</hi></seg><seg type="translation" xml:lang="en" source="#claude">so also L</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_11-2.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">500</biblScope></bibl><seg type="original" xml:lang="de">colped <hi rend="italic">bessert BA.</hi></seg><seg type="translation" xml:lang="en" source="#claude">colped emended by BA.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_11-2.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">500</biblScope></bibl><seg type="original" xml:lang="de">solz <hi rend="italic">ändern BA. MAT.</hi></seg><seg type="translation" xml:lang="en" source="#claude">solz altered by BA. MAT.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_11-2.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">500</biblScope></bibl><seg type="original" xml:lang="de">si il c. <hi rend="italic">I;</hi> si le <hi rend="italic">TOY.</hi></seg><seg type="translation" xml:lang="en" source="#claude">si il c. I; si le TOY.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_11-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">501</biblScope></bibl><seg type="original" xml:lang="de">alic' <hi rend="italic">S;</hi> ancus <hi rend="italic">Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">alic' S; ancus edd.</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="LeisWl_11-2.lnote.de1.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">501</biblScope></bibl><seg type="original" xml:lang="de">1 Schilling <hi rend="italic">Mercisch</hi></seg><seg type="translation" xml:lang="en" source="#claude">1 shilling Mercian</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_11-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">288</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Fingernagel; Gliederbusse 1e</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Fingernagel; Gliederbusse 1e</seg></note>
      </div>
