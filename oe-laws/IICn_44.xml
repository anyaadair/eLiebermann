      <div type="clause" n="44">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 44</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-g-a"><pb n="342" ed="#liebermann"/>Gif deaðscyldig man scriftspæce<ptr type="liebermannNote" n="11" target="#IICn_44.lnote.oe.11"/> gyrne, ne wyrne him<ptr type="liebermannNote" n="12" target="#IICn_44.lnote.oe.12"/> man æfre.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-b"><pb n="342" ed="#liebermann"/>Gyf deaðscyldig man scriftspréce<ptr type="liebermannNote" n="3" target="#IICn_44.lnote.oe.3"/> gyrne, ne wyrne him nan man næfre.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-a"><pb n="342" ed="#liebermann"/>Gif deoðscyldig<ptr type="liebermannNote" n="1" target="#IICn_44.lnote.oe.1"/> man sriftsprace<ptr type="liebermannNote" n="1" target="#IICn_44.lnote.oe.1"/> georne, ne wirne man him æfre.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="44" corresp="#wit-q"><pb n="343" ed="#liebermann"/>Si quis morti dampnatus confessionem facere<ptr type="liebermannNote" n="3" target="#IICn_44.lnote.oe.3-2"/> (habere) desideret<ptr type="liebermannNote" n="4" target="#IICn_44.lnote.oe.4"/>, numquam negetur<ptr type="liebermannNote" n="5" target="#IICn_44.lnote.oe.5"/> (defendatur) ei.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="44" corresp="#wit-inst-cn"><pb n="343" ed="#liebermann"/>Si quis latro aut alius<ptr type="liebermannNote" n="5" target="#IICn_44.lnote.oe.5-2"/> condemnatus ad mortem quęrit confessionem, nullo modo ei denegetur.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="44" corresp="#wit-cons-cn"><pb n="343" ed="#liebermann"/>[44] Si morte dampnatus confessionis colloquium petat, nemo prohibeat.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="44" corresp="#wit-b"><pb n="198" ed="#robertson"/>Gyf deaðscyldig man scriftspréce gyrne, ne wyrne him nan<ptr type="editorNote" n="1" target="#IICn_44.robnote.fn.1"/> man næfre<ptr type="editorNote" n="2" target="#IICn_44.robnote.fn.2"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="278" ed="#rabin-doml"/>Gif deaðscyldig man scriftspæce gyrne, ne wyrne him man æfre.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="342" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#IICn_44.lnote.de.1"/> ein Todes<ptr type="liebermannNote" n="2" target="#IICn_44.lnote.de.2"/> schuldiger Mensch Beichte<ptr type="liebermannNote" n="3" target="#IICn_44.lnote.de.3"/> verlangt, werde sie ihm niemals verweigert.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a man condemned to death asks for confession, let it never be refused him.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_44.robnote.n.1"/><pb n="199" ed="#robertson"/>If a condemned man desires confession, it shall never be refused him.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><ptr type="editorNote" n="7" target="#IICn_44.whinote.n.7"/><pb n="468" ed="#whitelock"/>If a condemned man desire confession, it is never to be refused him.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="279" ed="#rabin-doml"/>If someone sentenced to death desires confession, it shall never be denied to him.</ab>
        <note type="comparison" source="#liebermann" n="342"><ref target="clause:EGu_5">EGu 5</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 5</note>
        <note type="editorial">Liebermann compares EGu 5.; BR: added from Gesetze I p. 343, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">him man æfre: him nan man næfre B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_44.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">343</biblScope></bibl><seg type="original" xml:lang="de">colliq. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">colliq. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_44.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">342</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> -spræce</seg><seg type="translation" xml:lang="en" source="#claude">altered to -spræce</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_44.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">343</biblScope></bibl><seg type="original" xml:lang="de">f. <hi rend="italic">K;</hi> h. <hi rend="italic">Dm T; fehlt Hk Hn.</hi> 11, 9; confiteri <hi rend="italic">Hn.</hi> 66, 4</seg><seg type="translation" xml:lang="en" source="#claude">f. K; h. Dm T; lacking in Hk Hn. 11, 9; confiteri Hn. 66, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_44.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">343</biblScope></bibl><seg type="original" xml:lang="de">-rat <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rat K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_44.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">343</biblScope></bibl><seg type="original" xml:lang="de">n. <hi rend="italic">K Hn.;</hi> d. <hi rend="italic">Dm T R</hi></seg><seg type="translation" xml:lang="en" source="#claude">n. K Hn.; d. Dm T R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_44.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">342</biblScope></bibl><seg type="original" xml:lang="de">-sprace georne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sprace georne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_44.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">342</biblScope></bibl><seg type="original" xml:lang="de">m. h. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">m. h. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_44.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">342</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_44.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">343</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_44.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">208</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Benutzt durch Hn 11, 9. 66, 4</seg><seg type="translation" xml:lang="en" source="#claude">Used by Hn 11, 9. 66, 4</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_44.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">208</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Zu A's Lesart <hi rend="italic">vgl</hi>. Wroblewski <hi rend="italic">Altengl. Ges. Knuts</hi>, Berl. Diss. 1901, S. 33 und Toller <hi rend="italic">deaðdæg</hi>; er gibt die Form <hi rend="italic">deoð</hi></seg><seg type="translation" xml:lang="en" source="#claude">On A’s reading <hi rend="italic">cf.</hi> Wroblewski <hi rend="italic">Altengl. Ges. Knuts</hi>, Berl. Diss. 1901, p. 33, and Toller <hi rend="italic">deaðdæg</hi>; he gives the form <hi rend="italic">deoð</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_44.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">208</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">srift</hi> in A statt <hi rend="italic">scrift</hi> ist mittelenglisch; <hi rend="italic">s. Wb</hi> 187 Sp. 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">srift</hi> in A for <hi rend="italic">scrift</hi> is Middle English; <hi rend="italic">see Wb</hi> 187 col. 3</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_44.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">356</biblScope></bibl><seg type="original" xml:lang="en">Cf. E. and G. 5.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_44.robnote.fn.1" n="1" source="#robertson"><bibl><biblScope unit="page">198</biblScope></bibl><label>ðæs</label><seg type="original" xml:lang="en">Om. G, A, Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_44.robnote.fn.2" n="2" source="#robertson"><bibl><biblScope unit="page">198</biblScope></bibl><label>næfre</label><seg type="original" xml:lang="en"><hi rend="italic">æfre</hi> G, A, Ld.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IICn_44.whinote.n.7" n="7" source="#whitelock"><bibl><biblScope unit="page">468</biblScope></bibl><label>44</label><seg type="original" xml:lang="en">ibid., 5</seg></note>
      </div>
