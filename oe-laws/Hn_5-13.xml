        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-13.lnote.oe.y" n="y" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">5, 13. 13<hi rend="italic">a auch</hi> Pan. IV 123; <hi rend="italic">Ivo</hi> Decr. VI 323; <hi rend="italic">Ps.-Is.</hi> 563; <hi rend="italic">Gr.</hi> C. III q. 6 c. 3</seg><seg type="translation" xml:lang="en" source="#claude">5, 13. 13a also Pan. IV 123; Ivo Decr. VI 323; Ps.-Is. 563; Gr. C. III q. 6 c. 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-13.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co Or Gi</hi> [<hi rend="italic">besser</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">missing in K Co Or Gi [better]</seg></note>
