      <div type="clause" n="1">
        <head><ref type="lawCode" target="law:IudDeiX">Iud Dei X</ref> 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei X 1" corresp="#wit-lat"><pb n="417" ed="#liebermann"/>Si<ptr type="liebermannNote" n="3" target="#IudDeiX_1.lnote.oe.3"/> aliquis de furto reprehensus fuerit ipseque hoc fecisse se negauerit<ptr type="liebermannNote" n="4" target="#IudDeiX_1.lnote.oe.4"/>, die Martis<ptr type="liebermannNote" n="b" target="#IudDeiX_1.lnote.oe.b"/> ad uesperas<ptr type="liebermannNote" n="5" target="#IudDeiX_1.lnote.oe.5"/> causa purgandi sese perducatur ad<ptr type="liebermannNote" n="c" target="#IudDeiX_1.lnote.oe.c"/> ecclesiam, laneis<ptr type="liebermannNote" n="b" target="#IudDeiX_1.lnote.oe.b"/> indutus<ptr type="liebermannNote" n="6" target="#IudDeiX_1.lnote.oe.6"/> uestibus et nudis<ptr type="liebermannNote" n="d" target="#IudDeiX_1.lnote.oe.d"/> incedens pedibus,</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 417 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">417</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Eigenthümlich.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Peculiar to this text.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">417</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl.</hi> II As. 23 <hi rend="italic">und o. S.</hi> 401{e}.</seg><seg type="translation" xml:lang="en" source="#claude">Cf. II As. 23 and above p. 401{e}.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">417</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Barfuss trägt der Prüfling das Glüheisen bei Zeumer Tab.</hi> 3.</seg><seg type="translation" xml:lang="en" source="#claude">In Zeumer Tab. 3 the person undergoing the ordeal carries the red-hot iron barefoot.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">417</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Anfang bis</hi> 18, 1 <hi rend="italic">fehlt Bc</hi></seg><seg type="translation" xml:lang="en" source="#claude">beginning as far as 18, 1 missing in Bc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">417</biblScope></bibl><seg type="original" xml:lang="de">den. <hi rend="italic">Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">den. Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">417</biblScope></bibl><seg type="original" xml:lang="de">-ros <hi rend="italic">Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ros Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">417</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Ma</seg></note>
