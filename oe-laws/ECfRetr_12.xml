      <div type="clause" n="12">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 12</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 12"><pb n="637" ed="#liebermann"/><hi rend="spaced">De<ptr type="liebermannNote" n="4" target="#ECfRetr_12.lnote.la.4"/> pace regis, <hi rend="bold">quod</hi> multiplex est. <hi rend="bold">(De multi</hi>moda<ptr type="liebermannNote" n="5" target="#ECfRetr_12.lnote.la.5"/> pace regis<ptr type="liebermannNote" n="6" target="#ECfRetr_12.lnote.la.6"/> <hi rend="bold">et quatuor cheminorum</hi><ptr type="liebermannNote" n="7" target="#ECfRetr_12.lnote.la.7"/> <hi rend="bold">siue</hi><ptr type="liebermannNote" n="8" target="#ECfRetr_12.lnote.la.8"/> <hi rend="bold">uiarum regalium et fluuiorum nominatorum</hi><ptr type="liebermannNote" n="9" target="#ECfRetr_12.lnote.la.9"/><hi rend="bold">, quorum nauigio de diuersis locis uictualia ciuitatibus</hi><ptr type="liebermannNote" n="10" target="#ECfRetr_12.lnote.la.10"/> <hi rend="bold">siue burgis deferuntur.)</hi></hi> Pax regis multiplex est: Alia<ptr type="liebermannNote" n="11" target="#ECfRetr_12.lnote.la.11"/> <hi rend="bold">enim</hi> data manu sua, quam Angli<ptr type="liebermannNote" n="12" target="#ECfRetr_12.lnote.la.12"/> uocant kinges<ptr type="liebermannNote" n="13" target="#ECfRetr_12.lnote.la.13"/> hand<ptr type="liebermannNote" n="14" target="#ECfRetr_12.lnote.la.14"/> sealde<ptr type="liebermannNote" n="15" target="#ECfRetr_12.lnote.la.15"/> grið<ptr type="liebermannNote" n="16" target="#ECfRetr_12.lnote.la.16"/>;</ab>
        <note type="comparison" source="#liebermann" n="637"><label>printed alongside</label> <ref target="clause:ECf_12">ECf 12</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 637 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> De p. r. <hi rend="italic">Lond;</hi> De—est <hi rend="italic">Cb;</hi> De multimoda—defer. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">only De p. r. Lond; De—est Cb; De multimoda—defer. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">-iplici <hi rend="italic">S</hi> [<hi rend="italic">ursprünglicher</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">-iplici S [more original]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">regia <hi rend="italic">Pl S;</hi> r. et <hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">regia Pl S; r. et lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">chim. <hi rend="italic">S Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">chim. S Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv;</hi> s. u. r. <hi rend="italic">fehlt S</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv; s. u. r. lacking in S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">notatorum <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">notatorum Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">c. s. b. <hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. s. b. lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">Illa <hi rend="italic">Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">Illa Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">Anglici <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Anglici Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">cyninges <hi rend="italic">Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyninges Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Cb Hv K;</hi> honde <hi rend="italic">Sp;</hi> hond <hi rend="italic">Dc;</hi> hande <hi rend="italic">übr.;</hi> bande <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Cb Hv K; honde Sp; hond Dc; hande the others; bande Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">sealder <hi rend="italic">Hv;</hi> sealdre <hi rend="italic">Ra;</hi> -ld <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">sealder Hv; sealdre Ra; -ld Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Cb;</hi> grith <hi rend="italic">Hv;</hi> griþ<sub>a</sub> <hi rend="italic">Sp;</hi> grid <hi rend="italic">Lb Ra Va Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Cb; grith Hv; griþ with a below Sp; grid Lb Ra Va Ph</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Of the king's peace, that it is manifold. (Of the manifold peace of the king and of the four highways or royal roads and of the named rivers, by whose navigation provisions are carried from various places to cities or boroughs.) The king's peace is manifold: for one, given by his own hand, which the English call <hi rend="italic">kinges hand sealde grið</hi> (peace given by the king's hand);</ab>
      </div>
    </body>
  </text>
