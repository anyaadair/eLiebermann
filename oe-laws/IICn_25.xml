        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_25.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">206</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Übersetzt in Leis Wl 47</seg><seg type="translation" xml:lang="en" source="#claude">Translated in Leis Wl 47</seg><note type="remark" resp="#claude">On several rubrics: II Cn 25. 25, 1; 2</note></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_25.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">206</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Aus anderer Quelle <hi rend="italic">u</hi>. 30ff. über Bescholtene, wo 30, 4 nicht recht mit 25a harmoniert</seg><seg type="translation" xml:lang="en" source="#claude">On men of ill repute, from another source, <hi rend="italic">below</hi> 30ff., where 30, 4 does not quite agree with 25a</seg><note type="remark" resp="#claude">On several rubrics: II Cn 25. 25, 1; 2</note></note>
