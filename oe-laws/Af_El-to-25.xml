        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-25.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">34</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">nan man</hi> his sleges <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">nan man</hi> his sleges So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-25.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">34</biblScope></bibl><seg type="original" xml:lang="de">-læges <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-læges Ld</seg></note>
