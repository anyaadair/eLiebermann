        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 9</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 9" corresp="#wit-lat"><ptr type="liebermannNote" n="18" target="#LibLond_9.lnote.oe.18"/><pb n="675" ed="#liebermann"/>Nequit<ptr type="liebermannNote" n="13" target="#LibLond_9.lnote.oe.13"/> iterum<ptr type="liebermannNote" n="19" target="#LibLond_9.lnote.oe.19"/> mercator foranus<ptr type="liebermannNote" n="12" target="#LibLond_9.lnote.oe.12"/> cum socio<ptr type="liebermannNote" n="20" target="#LibLond_9.lnote.oe.20"/> suo<ptr type="liebermannNote" n="21" target="#LibLond_9.lnote.oe.21"/> infra ciuitatem mercatum<ptr type="liebermannNote" n="22" target="#LibLond_9.lnote.oe.22"/> aliquod<ptr type="liebermannNote" n="23" target="#LibLond_9.lnote.oe.23"/> facere<ptr type="liebermannNote" n="o" target="#LibLond_9.lnote.oe.o"/> ad<ptr type="liebermannNote" n="24" target="#LibLond_9.lnote.oe.24"/> reuendendum illud in ciuitate;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 675 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">mercatores foranei neque debent foraneis uendere nec a foraneis emere; <hi rend="italic">Londoner Recht vor</hi> 1215 <hi rend="italic">ebd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">mercatores foranei neque debent foraneis uendere nec a foraneis emere; London law before 1215 ibid.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">-neus <hi rend="italic">Horn Cons Douai;</hi> extraneus <hi rend="italic">Alb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-neus Horn Cons Douai; extraneus Alb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">-id <hi rend="italic">Ai</hi></seg><seg type="translation" xml:lang="en" source="#claude">-id Ai</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">Item <hi rend="italic">überschr. PlS</hi></seg><seg type="translation" xml:lang="en" source="#claude">Item as heading PlS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">etiam <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">etiam Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">suo <hi rend="spaced">extraneo</hi> socio <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">suo <hi rend="italic">extraneo</hi> socio Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">a socio suo uel alio in urbe emere <hi rend="italic">Cons Douai</hi></seg><seg type="translation" xml:lang="en" source="#claude">a socio suo uel alio in urbe emere Cons Douai</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">a. m. <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. m. Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">-uid <hi rend="italic">Pl;</hi> q; <hi rend="italic">S, was</hi> quem [<hi rend="italic">falsch</hi>] <hi rend="italic">auflöste Thorpe</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uid Pl; q; S, which Thorpe expanded [wrongly] as quem</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">doppelt Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">written twice Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_9.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. 37b. c; Handel 16a; <hi rend="italic">s. o</hi>. 1; Frist 14c; Sunne 2. <hi rend="italic">Vgl</hi>. Bateson II 166: <hi rend="italic">foranus non faciat forchep civi</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. 37b. c; Handel 16a; <hi rend="italic">see above</hi> 1; Frist 14c; Sunne 2. <hi rend="italic">Cf</hi>. Bateson II 166: <hi rend="italic">foranus non faciat forchep civi</hi></seg></note>
