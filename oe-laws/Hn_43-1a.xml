      <div type="clause" n="43.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 43.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 43.1a" corresp="#wit-lat"><pb n="569" ed="#liebermann"/>Si<ptr type="liebermannNote" n="bb" target="#Hn_43-1a.lnote.oe.bb"/> prepositus aut debitor domini sui est<ptr type="liebermannNote" n="10" target="#Hn_43-1a.lnote.oe.10"/>, quod<ptr type="liebermannNote" n="11" target="#Hn_43-1a.lnote.oe.11"/> debet reddat<ptr type="liebermannNote" n="12" target="#Hn_43-1a.lnote.oe.12"/> aut inde componat; neque enim iustum est, ut hominis sui forisfactum dominus luat, nec expectari conuenit, ut quis<ptr type="liebermannNote" n="a" target="#Hn_43-1a.lnote.oe.a"/> eum in suis preueniat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 569 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-1a.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">rex: <hi rend="italic">zu</hi> warantus <hi rend="italic">vgl.</hi> 82, 6. 85, 2</seg><seg type="translation" xml:lang="en" source="#claude">rex: on warantus cf. 82, 6. 85, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-1a.lnote.oe.bb" n="bb" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">Wenn [<hi rend="italic">Verklagter jedoch</hi>] Gutsverwalter oder Schuldner seines [<hi rend="italic">klagenden</hi>] Herrn</seg><seg type="translation" xml:lang="en" source="#claude">If [the defendant, however, is] the estate steward or debtor of his [suing] lord</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-1a.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vom Corr. übergeschr. Sc; fehlt K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above by the corrector Sc; omitted in K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-1a.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">r. q. d. <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. q. d. K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-1a.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Or</seg></note>
      </div>
    </body>
