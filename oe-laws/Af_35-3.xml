    <body>
      <div type="clause" n="35.3">
        <head><ref type="lawCode" target="law:Af">Af</ref> 35.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35.3" corresp="#wit-e"><pb n="68" ed="#liebermann"/>Gif he hine on bismor<ptr type="liebermannNote" n="31" target="#Af_35-3.lnote.oe.31"/> to homolan<ptr type="liebermannNote" n="32" target="#Af_35-3.lnote.oe.32"/> bescire<ptr type="liebermannNote" n="33" target="#Af_35-3.lnote.oe.33"/>, mid X scill. gebete.<ptr type="liebermannNote" n="34" target="#Af_35-3.lnote.oe.34"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35.3" corresp="#wit-h"><pb n="68" ed="#liebermann"/>Gif he hine on<ptr type="liebermannNote" n="13" target="#Af_35-3.lnote.oe.13"/> bysmer to homelan bescire, mid X scll' gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35.3" corresp="#wit-b-no-prol"><pb n="69" ed="#liebermann"/>Gyf he hine on bismor to homelan bescyre, mid X scill' gebete.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="35.3" corresp="#wit-q"><pb n="69" ed="#liebermann"/>Si<ptr type="liebermannNote" n="13" target="#Af_35-3.lnote.oe.13-2"/> eum radat in contumeliam ad collificum<ptr type="liebermannNote" n="14" target="#Af_35-3.lnote.oe.14"/>, decem sol. emendet.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="78" ed="#attenborough"/>Gif he hine on bismor to homolan bescire, mid X scill. gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="36.3" corresp="#wit-e"><pb n="328" ed="#jurasinski-and-oliver"/>Gif he hine on bismor to homolan bescire, mid X scill gebete.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="69" ed="#liebermann"/>Wenn er ihn zum Schimpf<ptr type="liebermannNote" n="1" target="#Af_35-3.lnote.de.1"/> zum Verstümmelten<ptr type="liebermannNote" n="2" target="#Af_35-3.lnote.de.2"/> schert, büsse er mit 10 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he shaves him in disgrace like a mutilated man, let him pay 10 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="79" ed="#attenborough"/>If he cuts his hair to insult him, in such a way as to spoil his appearance, he shall pay 10 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="414" ed="#whitelock"/>If in insult he disfigures him by cutting his hair, he is to pay him 10 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="329" ed="#jurasinski-and-oliver"/>If he shears his hair to the point of mutilation to shame him, let him pay with 10 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-3.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">-re <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-re So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-3.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">homelan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">homelan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-3.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">bescyre <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">bescyre So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-3.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt So</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-3.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">on b. <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">on b. written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-3.lnote.oe.13-2" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de">35, 3 <hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">35, 3 lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-3.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so R;</hi> -cium <hi rend="italic">übrige; bessere</hi> colobicum</seg><seg type="translation" xml:lang="en" source="#claude">thus R; -cium the others; read colobicum</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_35-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> scheren 3; skalpieren 3b</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> scheren 3; skalpieren 3b</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_35-3.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘zum Narren’ Lambarde, Price, Thorpe, Schmid; <hi rend="italic">ignominiosus</hi> rät Wilkins; mit <hi rend="italic">hamelian</hi> verbindet das Wort richtig Toller; <hi rend="italic">vgl. Wb: hamola</hi> und Kluge <hi rend="italic">Etym. Wb.</hi> s. v. <hi rend="italic">Hammel;</hi> im Engl. (<hi rend="italic">hamble</hi>) wird aber nicht an Entmannung gedacht. — Q meint das Richtige; <hi rend="italic">s. Wb collificum,</hi> das nur Neuere [verwechselnd mit <hi rend="italic">collistrigium;</hi> Bateson <hi rend="italic">Borough customs</hi> I 55?] ‘Pranger, Halseisen’ missverstanden</seg><seg type="translation" xml:lang="en" source="#claude">‘as a fool’ Lambarde, Price, Thorpe, Schmid; Wilkins conjectures <hi rend="italic">ignominiosus</hi>; Toller rightly connects the word with <hi rend="italic">hamelian</hi>; <hi rend="italic">cf. Wb: hamola</hi> and Kluge <hi rend="italic">Etym. Wb.</hi> s. v. <hi rend="italic">Hammel;</hi> in English (<hi rend="italic">hamble</hi>), however, castration is not thought of. — Q means the right thing; <hi rend="italic">see Wb collificum,</hi> which only modern scholars [confusing it with <hi rend="italic">collistrigium;</hi> Bateson <hi rend="italic">Borough customs</hi> I 55?] have misunderstood as ‘pillory, iron collar’</seg></note>
      </div>
    </body>
  </text>
