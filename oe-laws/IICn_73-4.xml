      <div type="clause" n="73.4">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 73.4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="73.4" corresp="#wit-g-a"><pb n="360" ed="#liebermann"/>And gelæste<ptr type="liebermannNote" n="21" target="#IICn_73-4.lnote.oe.21"/> ælc wuduwe<ptr type="liebermannNote" n="22" target="#IICn_73-4.lnote.oe.22"/> þa heregeatu binnan XII<ptr type="liebermannNote" n="2" target="#IICn_73-4.lnote.oe.2"/> monðum, butan<ptr type="liebermannNote" n="16" target="#IICn_73-4.lnote.oe.16"/> hyre<ptr type="liebermannNote" n="23" target="#IICn_73-4.lnote.oe.23"/> ær to onhagige<ptr type="liebermannNote" n="24" target="#IICn_73-4.lnote.oe.24"/>, wíteleas.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="73.4" corresp="#wit-b"><pb n="360" ed="#liebermann"/>⁊ gelæste ælc wuduwe ða heregeata binnon twelf monðum, buton hyre ær to onhagie, witeleas.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="73.4" corresp="#wit-a"><pb n="360" ed="#liebermann"/>And gelæsta ælc wuduwa þa heregeata binnan twelf monðum, buton hire ær to anhagye, witeleas.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="73.4" corresp="#wit-q"><pb n="361" ed="#liebermann"/>Et persoluat omnis uidua releuationem<ptr type="liebermannNote" n="11" target="#IICn_73-4.lnote.oe.11"/> suam intra XII menses sine forisfactura, si non possit antea.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="73.4" corresp="#wit-inst-cn"><pb n="361" ed="#liebermann"/>Sed persoluat redditum<ptr type="liebermannNote" n="13" target="#IICn_73-4.lnote.oe.13"/> domino suo, quod supra heregeat<ptr type="liebermannNote" n="14" target="#IICn_73-4.lnote.oe.14"/> nominauimus, infra duodecim menses, nisi ei<ptr type="liebermannNote" n="15" target="#IICn_73-4.lnote.oe.15"/> ante oportunum<ptr type="liebermannNote" n="16" target="#IICn_73-4.lnote.oe.16-2"/> fuerit.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="73.4" corresp="#wit-cons-cn"><pb n="361" ed="#liebermann"/>Omnis autem uidua exercitualia debita infra anni spacium sine forisfacto persoluat, nisi ei cicius facultas persoluendi sit.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="73a.4" corresp="#wit-b"><pb n="212" ed="#robertson"/>⁊ gelæste ælc wuduwe ða heregeata binnon twelf monðum, buton hyre ær to onhagie, witeleas.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="292" ed="#rabin-doml"/>And gelæste ælc wuduwe þa heregeatu binnan XII monðum, butan hyre ær to onhagige, witeleas.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="361" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#IICn_73-4.lnote.de.1"/> jede Wittwe entrichte die Heergewæte binnen zwölf Monaten [nach des Gatten Tod] ohne [Verzugs]strafe, wenn es ihr nicht früher passt.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let every widow pay the heriot within twelve months [after her husband's death] without penalty [for delay], unless it suits her earlier.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="213" ed="#robertson"/>And every widow shall pay the heriots within twelve months without incurring a fine, if it has not been convenient for her to pay earlier.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="473" ed="#whitelock"/>And each widow is to pay the heriot within 12 months, without fine, unless it is convenient to her to do so sooner.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="293" ed="#rabin-doml"/>And each widow is to pay the tributes owed by her deceased husband within twelve months without incurring a penalty, if it has not been possible for her to pay earlier.</ab>
        <note type="editorial">BR: added from Gesetze I p. 361, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-4.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">exertu. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">exertu. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-4.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">reuela. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">reuela. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-4.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de">-sta <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sta Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-4.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de">-wa ða heregeata <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-wa ða heregeata Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-4.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de">twelf <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">twelf Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-4.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de">buton <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">buton Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-4.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de">hire <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hire Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-4.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de">-gye <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gye Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-4.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">redi. <hi rend="italic">Di</hi></seg><seg type="translation" xml:lang="en" source="#claude">redi. Di</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-4.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">herg. <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">herg. H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-4.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">a. ei <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. ei Cb</seg></note>
