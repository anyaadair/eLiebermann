    <body>
      <div type="clause" n="5.1">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 5.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.1" corresp="#wit-e"><pb n="90" ed="#liebermann"/>Gif hwa his hyde forwyrce ⁊ cirican<ptr type="liebermannNote" n="16" target="#Ine_5-1.lnote.oe.16"/> geierne, sie<ptr type="liebermannNote" n="2" target="#Ine_5-1.lnote.oe.2"/> him sio<ptr type="liebermannNote" n="18" target="#Ine_5-1.lnote.oe.18"/> swingelle forgifen.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.1" corresp="#wit-bu"><pb n="90" ed="#liebermann"/>Gif hwa his hyde forwerce ⁊ cirican geirne, sie hi<hi rend="italic">m</hi> sio swingelle forgifen.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.1" corresp="#wit-h"><pb n="90" ed="#liebermann"/>Gif hwa his hyde forwyrce ⁊ ciricean<ptr type="liebermannNote" n="12" target="#Ine_5-1.lnote.oe.12"/> geirne, sy<ptr type="liebermannNote" n="1" target="#Ine_5-1.lnote.oe.1"/> him seo<ptr type="liebermannNote" n="13" target="#Ine_5-1.lnote.oe.13-2"/> swingle<ptr type="liebermannNote" n="14" target="#Ine_5-1.lnote.oe.14"/> forgifen.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.1" corresp="#wit-b-no-prol"><pb n="91" ed="#liebermann"/>Gyf hwá his hyde forwyrce ⁊ cyricean geyrne, sy him seo swingle forgyfen.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.1" corresp="#wit-q"><pb n="91" ed="#liebermann"/>Si quis corium suum forisfaciat et ad<ptr type="liebermannNote" n="13" target="#Ine_5-1.lnote.oe.13"/> ecclesiam incurrat, sit ei uerberatio condonata.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="38" ed="#attenborough"/>Gif hwa his hyde forwyrce ⁊ cirican geierne, sie him sio swingelle forgifen.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="5.1" corresp="#wit-e"><pb n="374" ed="#jurasinski-and-oliver"/>Gif hwa his hyde forwyrce, ⁊ cyrican geierne, sy him sio swingelle forgifen.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="91" ed="#liebermann"/>Wenn jemand<ptr type="liebermannNote" n="1" target="#Ine_5-1.lnote.de.1"/> seine Haut verwirkt und eine Kirche erreicht, sei ihm die Prügelstrafe erlassen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone forfeits his hide and reaches a church, let the flogging be remitted to him.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="39" ed="#attenborough"/>If anyone renders himself liable to the lash and flees to the church, he shall be immune from scourging.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="400" ed="#whitelock"/>If anyone is liable to be flogged, and reaches a church, the flogging is to be remitted.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="375" ed="#jurasinski-and-oliver"/>If someone has committed an offense for which the penalty is whipping and he flees into a church, let him be spared the whipping</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_5-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">91</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt R</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_5-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zweites</hi> i <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">second i written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_5-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_5-1.lnote.oe.13-2" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_5-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor</hi> le <hi rend="italic">Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">erasure before le</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_5-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">cyricean geyrne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyricean geyrne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_5-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_5-1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">seo swingle gorgyfen (<hi rend="italic">so</hi>) <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">seo swingle gorgyfen (sic) Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_5-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Asyl 4; Prügel 3. Dieser Satz handelt von Halb- oder Unfreien, der vorige von Freien</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Asyl 4; Prügel 3. This sentence deals with the half-free or unfree, the previous one with the free</seg></note>
      </div>
    </body>
