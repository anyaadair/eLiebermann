    <body>
      <div type="clause" n="19.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 19.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 19.2"><pb n="645" ed="#liebermann"/><hi rend="bold">Pueri uero</hi> qui ante malefactum fuerant<ptr type="liebermannNote" n="1" target="#ECfRetr_19-2.lnote.la.1"/> <hi rend="bold">nati seu</hi><ptr type="liebermannNote" n="2" target="#ECfRetr_19-2.lnote.la.2"/> generati, non <hi rend="bold">erunt</hi><ptr type="liebermannNote" n="3" target="#ECfRetr_19-2.lnote.la.3"/> exleges, pro malefacto post generationem eorum <hi rend="bold">peracto,</hi> nec perdant<ptr type="liebermannNote" n="6" target="#ECfRetr_19-2.lnote.la.6"/> hereditatem.</ab>
        <note type="comparison" source="#liebermann" n="645"><label>printed alongside</label> <ref target="clause:ECf_19-2">ECf 19.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 645 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">There are no notes 4 and 5 in the ECf retr column of this page: Liebermann’s numbering goes from 3 to 6.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_19-2.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">nati erant uel gen. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">nati erant uel gen. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_19-2.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_19-2.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">exl. sint super mal. p. g. illorum p., ne <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">exl. sint super mal. p. g. illorum p., ne Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_19-2.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">-dent <hi rend="italic">Lb Va Ph;</hi> -dunt <hi rend="italic">Cb K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dent Lb Va Ph; -dunt Cb K</seg></note>
      </div>
