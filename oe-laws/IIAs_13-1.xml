    <body>
      <div type="clause" n="13.1">
        <head><ref type="lawCode" target="law:IIAs">II As</ref> 13.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="13.1" corresp="#wit-h"><pb n="158" ed="#liebermann"/>Oþer: þæt ælc<ptr type="liebermannNote" n="1" target="#IIAs_13-1.lnote.oe.1-2"/> ceaping sy<ptr type="liebermannNote" n="2" target="#IIAs_13-1.lnote.oe.2"/> binnon<ptr type="liebermannNote" n="3" target="#IIAs_13-1.lnote.oe.3"/> port.<ptr type="liebermannNote" n="4" target="#IIAs_13-1.lnote.oe.4"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="13.1" corresp="#wit-ld"><pb n="158" ed="#liebermann"/>Oþær: ylc ceapunge<ptr type="liebermannNote" n="1" target="#IIAs_13-1.lnote.oe.1"/> sy binnan porte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="13.1" corresp="#wit-ot"><pb n="158" ed="#liebermann"/>Oþær: [æ]lc cieping<ptr type="liebermannNote" n="1" target="#IIAs_13-1.lnote.oe.1-4"/> sie binnan porte.<ptr type="liebermannNote" n="2" target="#IIAs_13-1.lnote.oe.2-2"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="13.1" corresp="#wit-q"><pb n="159" ed="#liebermann"/>Et omne mercatum sit intra ciuitatem<ptr type="liebermannNote" n="1" target="#IIAs_13-1.lnote.oe.1-3"/> (portum).</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="13.1" corresp="#wit-h"><pb n="134" ed="#attenborough"/>Oþer: þæt ælc ceaping<ptr type="editorNote" n="15" target="#IIAs_13-1.attnote.fn.15"/> sy binnon port.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="159" ed="#liebermann"/>Zweitens: dass jedes Kaufen innerhalb der Stadt<ptr type="liebermannNote" n="1" target="#IIAs_13-1.lnote.de.1"/> geschehe.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Secondly: that all buying take place within a town.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="135" ed="#attenborough"/>Secondly: that all trading shall be carried on in a town.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="421" ed="#whitelock"/>Secondly, that all buying is to be within a town.<ptr type="editorNote" n="6" target="#IIAs_13-1.whinote.n.6"/></ab>
        <note type="comparison" source="#liebermann" n="159"><ref target="clause:IIAs_12">II As 12</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. II As. 12</note>
        <note type="comparedBy" source="#wormald-mel" n="286"><ref target="clause:AGu_4">AGu 4–5</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="291"><ref target="clause:IIAs_12">II As 12</ref></note>
        <note type="editorial">Liebermann compares II As 12.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_13-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">158</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_13-1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">158</biblScope></bibl><seg type="original" xml:lang="de">æ <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">æ on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_13-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">158</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_13-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">158</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_13-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">158</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> porte</seg><seg type="translation" xml:lang="en" source="#claude">altered to porte</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_13-1.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">159</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> ci. <hi rend="italic">Lond; nur</hi> p. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">only ci. Lond; only p. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_13-1.lnote.oe.1-4" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">158</biblScope></bibl><seg type="original" xml:lang="de">ceap. <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">ceap. So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_13-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">158</biblScope></bibl><seg type="original" xml:lang="de">port <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">port So</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_13-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">104</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Also weit allgemeineres Verbot als <hi rend="italic">o.</hi> 12, folglich aus ursprünglich anderem Zusammenhang</seg><seg type="translation" xml:lang="en" source="#claude">Thus a far more general prohibition than <hi rend="italic">above</hi> 12, and consequently from an originally different context</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_13-1.attnote.fn.15" n="15" source="#attenborough"><bibl><biblScope unit="page">134</biblScope></bibl><label>ceaping</label><seg type="original" xml:lang="en"><hi rend="italic">ylc ceapunge</hi>. Ld.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IIAs_13-1.whinote.n.6" n="6" source="#whitelock"><bibl><biblScope unit="page">421</biblScope></bibl><label>town</label><seg type="original" xml:lang="en">This repetition, and the new numbering of the clauses, suggests that a separate set of statutes is here being incorporated. It may end with 18; it is mainly concerned with trading regulations.</seg></note>
      </div>
    </body>
  </text>
