      <div type="clause" n="11.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 11.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 11.1"><pb n="634" ed="#liebermann"/>De hoc quoque Denegeldo quieta erat<ptr type="liebermannNote" n="34" target="#ECf_11-1.lnote.la.34"/> et libera omnis terra que de ecclesiis propria<ptr type="liebermannNote" n="35" target="#ECf_11-1.lnote.la.35"/> et <pb n="635" ed="#liebermann"/>dominica erat<ptr type="liebermannNote" n="1" target="#ECf_11-1.lnote.la.1"/>, etiam de ecclesiis<ptr type="liebermannNote" n="a" target="#ECf_11-1.lnote.la.fn.a"/> parochiarum<ptr type="liebermannNote" n="2" target="#ECf_11-1.lnote.la.2"/>, et nichil<ptr type="liebermannNote" n="3" target="#ECf_11-1.lnote.la.3"/> in eius<ptr type="liebermannNote" n="4" target="#ECf_11-1.lnote.la.4"/> redditione<ptr type="liebermannNote" n="5" target="#ECf_11-1.lnote.la.5"/> persoluebat<ptr type="liebermannNote" n="6" target="#ECf_11-1.lnote.la.6"/>, quia maiorem fiduciam habebant<ptr type="liebermannNote" n="7" target="#ECf_11-1.lnote.la.7"/> in orationibus<ptr type="liebermannNote" n="8" target="#ECf_11-1.lnote.la.8"/> sancte ecclesie quam in defensionibus<ptr type="liebermannNote" n="9" target="#ECf_11-1.lnote.la.9"/> armorum.<ptr type="liebermannNote" n="*" target="#ECf_11-1.lnote.la.star"/></ab>
        <note type="comparison" source="#liebermann" n="634"><label>printed alongside</label> <ref target="clause:ECfRetr_11-1">ECf retr 11.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 634–635 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “omnis” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="editorial">Liebermann’s note to the asterisk after “armorum” is printed under ECf retr; it is given here as well.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">er’ <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">er’ Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">-riis <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-riis Ad Do</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_11-1.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 8, 3a <hi rend="italic">f</hi></seg><seg type="translation" xml:lang="en" source="#claude">see above, 8, 3a, note f</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Hr;</hi> erit et de p. e. <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hr adds et; erit et de p. e. Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">parrochya. <hi rend="italic">Rl;</hi> hiisdem (ad idem <hi rend="italic">S</hi>) pertinentibus <hi rend="italic">fügt zu S Ad;</hi> parrochianis ecclesiis eis pertinentibus <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">parrochya. Rl; S Ad add hiisdem (ad idem S) pertinentibus; parrochianis ecclesiis eis pertinentibus Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">ut <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">ut Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">r. e. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. e. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">redit. <hi rend="italic">Rl;</hi> redemptione <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">redit. Rl; redemptione S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">-bant <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-bant Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">in o. s. e. habebat <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">in o. s. e. habebat S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">-one <hi rend="italic">Hk Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-one Hk Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">arm. defensione <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">arm. defensione Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">11, 2; 3 <hi rend="italic">lässt hier Lond aus Retr. fort und stellt sie hinter</hi> Geneal. Norm. 15 (<hi rend="italic">ed. Liebermann</hi> Über Edw. Conf. <hi rend="italic">p.</hi> 139**). [<hi rend="italic">Zwar stehen</hi> 11, 2—3 <hi rend="italic">hier am Rande von Co und im Texte von Or, aber meist aus</hi> ECf., <hi rend="italic">nicht aus Retr.-Form, also auch nicht aus Lond.</hi>] <hi rend="italic">Hier schaltet Lond in die Retr. ein</hi> (<hi rend="italic">was Ld willkürlich in</hi> 17 <hi rend="italic">versetzt</hi>):</seg><seg type="translation" xml:lang="en" source="#claude">Lond here leaves out 11, 2; 3 of the Retr. and puts them after Geneal. Norm. 15 (ed. Liebermann, Über Edw. Conf. p. 139**). [11, 2–3 do stand here in the margin of Co and in the text of Or, but mostly from ECf., not in the Retr. form, so not from Lond either.] Here Lond inserts into the Retr. (which Ld arbitrarily moves to 17):</seg></note>
      </div>
    </body>
  </text>
