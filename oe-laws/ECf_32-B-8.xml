    <body>
      <div type="clause" n="32 B 8">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 32 B 8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 32 B 8"><pb n="657" ed="#liebermann"/>Item aliud<ptr type="liebermannNote" n="c" target="#ECf_32-B-8.lnote.la.fn.c"/> folkmot<ptr type="liebermannNote" n="13" target="#ECf_32-B-8.lnote.la.13"/> esse debet in quolibet comitatu, et<ptr type="liebermannNote" n="14" target="#ECf_32-B-8.lnote.la.14"/> per prouincias<ptr type="liebermannNote" n="d" target="#ECf_32-B-8.lnote.la.fn.d"/> et patrias totius regni predicti uniuersas, scilicet in capite kalendarum Octob., ad prouidendum ibi, quis erit eorum<ptr type="liebermannNote" n="6" target="#ECf_32-B-8.lnote.la.6"/> uicecomes<ptr type="liebermannNote" n="e" target="#ECf_32-B-8.lnote.la.fn.e"/>, et qui erunt<ptr type="liebermannNote" n="15" target="#ECf_32-B-8.lnote.la.15"/> eorum heretochii<ptr type="liebermannNote" n="16" target="#ECf_32-B-8.lnote.la.16"/>, et ad audiendum ibi iusta eorum precepta, consilio et assensu procerum et iudicio folkesmoti<ptr type="liebermannNote" n="17" target="#ECf_32-B-8.lnote.la.17"/>.</ab>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 657 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">This passage is not part of ECf or ECf retr: it is one of the additions of the London collection (Leges Anglorum s. XIII in. Londoniis collectae), which Liebermann prints across the page as an insertion into ECf retr. 32 (32 A–E, pp. 655–660). The dictionary cites it as “ECf 32 B …”, so it is kept with ECf here.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_32-B-8.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">neben dem angeblichen Reichs-Folkmot zu London am</hi> 1. <hi rend="italic">Mai, o.</hi> 32 A 5</seg><seg type="translation" xml:lang="en" source="#claude">besides the alleged folkmoot of the realm in London on 1 May, above 32 A 5</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_32-B-8.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier weiter als</hi> Grafschaften; <hi rend="italic">dass</hi> comitatus <hi rend="italic">halbjährlich tagen, wohl aus</hi> 32 B 11</seg><seg type="translation" xml:lang="en" source="#claude">here wider than shires; that the comitatus meet twice a year, probably from 32 B 11</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_32-B-8.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 32 B 1<hi rend="italic">o</hi></seg><seg type="translation" xml:lang="en" source="#claude">see above, 32 B 1, note o</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-B-8.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de">folkemoth <hi rend="italic">K;</hi> -te <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">folkemoth K; -te Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-B-8.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-B-8.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co Or Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Co Or Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-B-8.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de">erint <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">erint K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-B-8.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de">-tho. <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tho. K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-B-8.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de">-te <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-te Ld</seg></note>
      </div>
    </body>
