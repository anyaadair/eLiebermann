      <div type="clause" n="34">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 34</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 34"><pb n="661" ed="#liebermann"/>Quam cum ipse<ptr type="liebermannNote" n="8" target="#ECfRetr_34.lnote.la.8"/> rex Willelmus audisset <hi rend="bold">cum</hi> aliis <hi rend="bold">sui</hi><ptr type="liebermannNote" n="9" target="#ECfRetr_34.lnote.la.9"/> regni legibus, maxime appretiatus est eam; et <hi rend="bold">precepit,</hi> ut obseruaretur<ptr type="liebermannNote" n="10" target="#ECfRetr_34.lnote.la.10"/> per <hi rend="bold">uniuersum</hi><ptr type="liebermannNote" n="11" target="#ECfRetr_34.lnote.la.11"/> regnum; <hi rend="bold">proferebat enim,</hi> quod antecessores <hi rend="bold">eius</hi> et fere<ptr type="liebermannNote" n="12" target="#ECfRetr_34.lnote.la.12"/> omnium baronum Normannie<ptr type="liebermannNote" n="13" target="#ECfRetr_34.lnote.la.13"/> <hi rend="bold">Norwenses</hi><ptr type="liebermannNote" n="14" target="#ECfRetr_34.lnote.la.14"/> <hi rend="bold">exstitissent et quod</hi> de Noruegia<ptr type="liebermannNote" n="15" target="#ECfRetr_34.lnote.la.15"/> <hi rend="bold">olim</hi> uenissent<ptr type="liebermannNote" n="16" target="#ECfRetr_34.lnote.la.16"/>; et <hi rend="bold">hac auctoritate</hi> leges eorum, cum<ptr type="liebermannNote" n="17" target="#ECfRetr_34.lnote.la.17"/> honeste erant, cum profundiores et honestiores omnibus aliis essent, <hi rend="bold">pre</hi><ptr type="liebermannNote" n="18" target="#ECfRetr_34.lnote.la.18"/> <hi rend="bold">ceteris regni sui</hi><ptr type="liebermannNote" n="19" target="#ECfRetr_34.lnote.la.19"/> <hi rend="bold">legibus asserebat</hi><ptr type="liebermannNote" n="20" target="#ECfRetr_34.lnote.la.20"/> debere sequi <hi rend="bold">et obseruari</hi><ptr type="liebermannNote" n="21" target="#ECfRetr_34.lnote.la.21"/><hi rend="bold">, quippe cum aliarum legibus nationum,</hi> Brittonum<ptr type="liebermannNote" n="22" target="#ECfRetr_34.lnote.la.22"/> scilicet, Anglorum<ptr type="liebermannNote" n="23" target="#ECfRetr_34.lnote.la.23"/> <hi rend="bold">et</hi> Pictorum<ptr type="liebermannNote" n="*" target="#ECfRetr_34.lnote.la.star"/> <hi rend="bold">ubique</hi><ptr type="liebermannNote" n="25" target="#ECfRetr_34.lnote.la.25"/> <hi rend="bold">preponderassent.</hi></ab>
        <note type="comparison" source="#liebermann" n="661"><label>printed alongside</label> <ref target="clause:ECf_34">ECf 34</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 661 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">There is no note 24 in the ECf retr column of this page: Liebermann’s numbering goes from 23 to 25.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECfRetr_34.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Wilhelms Gefühl der Verwandtschaft mit Dänemark, das auch</hi> Henr. Huntingd. <hi rend="italic">zu</hi> 1066 <hi rend="italic">meldet, passt kaum dazu, dass</hi> 1066 <hi rend="italic">gegen ihn</hi> auxilia miserat [Anglis] cognata terra Danorum, <hi rend="italic">und dass diese ihm später England entreissen wollte. Doch drangen unter Wilhelm I.</hi> (<hi rend="italic">Will. Pictav. p.</hi> 132) <hi rend="italic">Formalien der Dena lagu ins Englische Recht; Steenstrup</hi> Danelag 388. <hi rend="italic">Diese Stelle scheint benutzt von Wace</hi> Roman de Rou 9023—36</seg><seg type="translation" xml:lang="en" source="#claude">William’s feeling of kinship with Denmark, which Henry of Huntingdon also reports under 1066, hardly fits with the fact that in 1066 cognata terra Danorum auxilia miserat [Anglis] against him, and that the Danes later wanted to wrest England from him. But under William I (Will. Pictav. p. 132) formalities of the Danelaw did enter English law; Steenstrup, Danelag 388. This passage seems to be used by Wace, Roman de Rou 9023–36</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECfRetr_34.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">diese plumpe Erfindung macht den ganzen Satz verdächtig. Verf. ist beeinflusst von</hi> linguis Anglorum, Brittonum, Pictorum (<hi rend="italic">Bæda</hi> I 1), <hi rend="italic">deren letzte</hi> Henr. Huntingd. <hi rend="italic">erstorben nennt</hi></seg><seg type="translation" xml:lang="en" source="#claude">this clumsy invention makes the whole sentence suspect. The author is influenced by linguis Anglorum, Brittonum, Pictorum (Bede I 1), the last of which Henry of Huntingdon calls extinct</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">Scotorum <hi rend="italic">Rl;</hi> A. et P. et Scotorum <hi rend="italic">Lond; vielleicht beide aus</hi> Bæda I 1</seg><seg type="translation" xml:lang="en" source="#claude">Scotorum Rl; A. et P. et Scotorum Lond; perhaps both from Bede I 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Va Hv Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Va Hv Dc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">seruaretur <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">seruaretur Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">totum <hi rend="italic">Co Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">totum Co Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">o. f. <hi rend="italic">Cb Lb Va Ph Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">o. f. Cb Lb Va Ph Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">-mannorum <hi rend="italic">Cb Lb Va Ph Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-mannorum Cb Lb Va Ph Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">Noruegen. <hi rend="italic">Cb Va;</hi> Noruegienses <hi rend="italic">Lb;</hi> Nordwagien. <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">Noruegen. Cb Va; Noruegienses Lb; Nordwagien. Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">-weia <hi rend="italic">Hv Lond;</hi> -uagia <hi rend="italic">Lb Va;</hi> Nordwagia <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">-weia Hv Lond; -uagia Lb Va; Nordwagia Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">fuissent <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">fuissent Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">cum—essent <hi rend="italic">fehlt Cb Lb Va Hv Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">cum—essent lacking in Cb Lb Va Hv Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">cum predictis r. l. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">cum predictis r. l. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Lb Hv Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Lb Hv Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">se <hi rend="italic">fügt zu K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">K Co add se</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">-re <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-re Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">Brito. <hi rend="italic">Cb Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Brito. Cb Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">Britonum et <hi rend="italic">fügt nochmals zu K</hi></seg><seg type="translation" xml:lang="en" source="#claude">K adds Britonum et again</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_34.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">ubicunque <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">ubicunque K</seg></note>
      </div>
