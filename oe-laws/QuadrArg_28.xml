      <div type="clause" n="28">
        <head><ref type="lawCode" target="law:QuadrArg">Quadr Arg</ref> 28</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Arg 28" corresp="#wit-lat"><pb n="535" ed="#liebermann"/>Et quæ per<ptr type="liebermannNote" n="3" target="#QuadrArg_28.lnote.oe.3"/> parentis<ptr type="liebermannNote" n="e" target="#QuadrArg_28.lnote.oe.e"/> riuulos probitatis fluuia passim diducta sunt, hic in unum bonitatis<ptr type="liebermannNote" n="4" target="#QuadrArg_28.lnote.oe.4"/> alueum redundare uideamus, ubi prolis inclitæ generosæ propagines<ptr type="liebermannNote" n="f" target="#QuadrArg_28.lnote.oe.f"/> umbram fessis potumque sitientibus grata perpetuitate conciliant<ptr type="liebermannNote" n="5" target="#QuadrArg_28.lnote.oe.5"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 535 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_28.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">535</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Lob Wilhelms I., wie oben</hi> 16</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Praise of William I, as above</hi> 16</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_28.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">535</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nach Geburt mindestens zweier ehelicher Kinder Heinrichs, also nach</hi> 1103, <hi rend="italic">geschrieben und bevor</hi> 1120 <hi rend="italic">der Thronerbe Wilhelm ertrank. Vgl. u. S.</hi> 543&lt;sup&gt;i&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">written after the birth of at least two legitimate children of Henry, i.e. after</hi> 1103, <hi rend="italic">and before the heir to the throne, William, was drowned in</hi> 1120. <hi rend="italic">Cf. below p.</hi> 543&lt;sup&gt;i&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_28.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">535</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Hk</hi> [<hi rend="italic">ob Emendation</hi> 16. <hi rend="italic">Jhs.?</hi>]; per arentis, <hi rend="italic">geänd.</hi> per arentes <hi rend="italic">Dm;</hi> per arentes <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">thus Hk</hi> [<hi rend="italic">an emendation of the</hi> 16<hi rend="italic">th cent.?</hi>]; per arentis, <hi rend="italic">altered to</hi> per arentes <hi rend="italic">Dm;</hi> per arentes <hi rend="italic">T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_28.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">535</biblScope></bibl><seg type="original" xml:lang="de">bonitatem alucam <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">bonitatem alucam <hi rend="italic">Hk</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_28.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">535</biblScope></bibl><seg type="original" xml:lang="de">conciliauit <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">conciliauit <hi rend="italic">T</hi></seg></note>
      </div>
