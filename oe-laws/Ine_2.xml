    <body>
      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2" corresp="#wit-e"><pb n="90" ed="#liebermann"/>XLVI. Cild binnan ðritegum<ptr type="liebermannNote" n="1" target="#Ine_2.lnote.oe.1-3"/> nihta sie<ptr type="liebermannNote" n="2" target="#Ine_2.lnote.oe.2"/> gefulwad; gif hit swa ne sie<ptr type="liebermannNote" n="2" target="#Ine_2.lnote.oe.2"/>, XXX scill.<ptr type="liebermannNote" n="3" target="#Ine_2.lnote.oe.3"/> gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2" corresp="#wit-bu"><pb n="90" ed="#liebermann"/>XLVI. Cild binnan XXX nyhtu<hi rend="italic">m</hi> sie gefullod; gif hit swa ne sie, XXX scill' gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2" corresp="#wit-h"><pb n="90" ed="#liebermann"/>XLVI. Cyld<ptr type="liebermannNote" n="1" target="#Ine_2.lnote.oe.1-2"/> binnan XXX nihtum sy<ptr type="liebermannNote" n="1" target="#Ine_2.lnote.oe.1-2"/> gefullod; gif hit swa ne sy<ptr type="liebermannNote" n="1" target="#Ine_2.lnote.oe.1-2"/>, XXX scll' gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2" corresp="#wit-b-no-prol"><pb n="91" ed="#liebermann"/>Cild binnan XXX nihta sy gefullad; gyf hit swa ne sy, XXX scill' gebéte.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2" corresp="#wit-q"><pb n="91" ed="#liebermann"/>Puer infra<ptr type="liebermannNote" n="1" target="#Ine_2.lnote.oe.1"/> triginta noctes baptizetur; si non sit, XXX sol. emendetur.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="36" ed="#attenborough"/>Cild binnan ðritegum nihta<ptr type="editorNote" n="7" target="#Ine_2.attnote.fn.7"/> sie gefulwad<ptr type="editorNote" n="8" target="#Ine_2.attnote.fn.8"/>; gif hit swa ne sie, XXX scill. gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="2" corresp="#wit-e"><pb n="372" ed="#jurasinski-and-oliver"/>{XVI} Cild binnan ðritegum nihta sie gefulwad; gif hit swa ne sie, xxx sciƚƚ gebete.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="91" ed="#liebermann"/>Ein Kind werde binnen 30<ptr type="liebermannNote" n="1" target="#Ine_2.lnote.de.1"/> Nächten<ptr type="liebermannNote" n="2" target="#Ine_2.lnote.de.2"/> getauft. Wenn es nicht so [getauft<ptr type="liebermannNote" n="3" target="#Ine_2.lnote.de.3"/>] wird, büsse [sein Vormund<ptr type="liebermannNote" n="4" target="#Ine_2.lnote.de.4"/> dem König] 30 Schill.<ptr type="liebermannNote" n="5" target="#Ine_2.lnote.de.5"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Let a child be baptised within 30 nights. If it is not so [baptised], let [its guardian] pay [the king] 30 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="37" ed="#attenborough"/>A child shall be baptised within 30 days. If this is not done, [the guardian] shall pay 30 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="399" ed="#whitelock"/>A child is to be baptised within 30 days; if it is not, 30 shillings compensation is to be paid.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="373" ed="#jurasinski-and-oliver"/>A child must be baptized within thirty nights; if it is not, let him pay 30 shillings.</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="373"><label>similarly</label> <ref target="clause:Wi_6">Wi 6</ref> <quote>Wihtred §5 [L6] similarly punishes a priest for neglecting baptism.</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="397"><ref target="clause:Northu_10">Northu 10–10.1</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">91</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">doppelt Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">written twice in Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_2.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_2.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">þryttigum <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þryttigum Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">scillinges <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">scillinges Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">68</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Taufe 3. Es liegt wohl ein Synodaldekret zugrunde wie für Wi 6; <hi rend="italic">s. o.</hi> Einl. 12</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Taufe 3. This is probably based on a synodal decree, as with Wi 6; see above Introduction 12</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Den vom Numerale abhängigen Genetiv ändert spätere Sprache in Bu H</seg><seg type="translation" xml:lang="en" source="#claude">Later usage alters the genitive dependent on the numeral in Bu H</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_2.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">nicht ‘geschieht’. Über dieses <hi rend="italic">swa s. Wb</hi> II A3, Toller 940 III</seg><seg type="translation" xml:lang="en" source="#claude">not ‘happens’. On this <hi rend="italic">swa</hi> see <hi rend="italic">Wb</hi> II A3, Toller 940 III</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_2.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘parens’ ergänzt Wilkins richtig; ‘man’ ergänzt grammatisch richtig Schmid, Pogatscher in <hi rend="italic">Anglia</hi> 23, 299. Nicht aber ‘der Priester’ ist gemeint: der Satz steht ja unter Geboten für Laien. <hi rend="italic">Vgl. Gl</hi> Vormund 3</seg><seg type="translation" xml:lang="en" source="#claude">Wilkins rightly supplies ‘parens’; Schmid and Pogatscher in <hi rend="italic">Anglia</hi> 23, 299 supply ‘man’, which is grammatically correct. But ‘the priest’ is not meant: the sentence after all stands among commands for the laity. <hi rend="italic">Cf. Gl</hi> Vormund 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_2.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">So <hi rend="italic">u.</hi> 3³; <hi rend="italic">vgl. Gl</hi> Strafgeldfixum 4—5</seg><seg type="translation" xml:lang="en" source="#claude">So too <hi rend="italic">below</hi> 3³; <hi rend="italic">cf. Gl</hi> Strafgeldfixum 4—5</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_2.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">36</biblScope></bibl><label>nihta</label><seg type="original" xml:lang="en"><hi rend="italic">nyhtum</hi>. Bu &amp; H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_2.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">36</biblScope></bibl><label>gefulwad</label><seg type="original" xml:lang="en"><hi rend="italic">gefullad</hi>. B. <hi rend="italic">gefullod</hi>. H, Bu.</seg></note>
      </div>
