    <body>
      <div type="clause" n="32">
        <head>Ine Rb 32</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="32" corresp="#wit-e"><pb n="22" ed="#liebermann"/>LXXVI. Be Wilisces<ptr type="liebermannNote" n="10" target="#Rubrics-Ine_32.lnote.oe.10"/> monnes londhæfene.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="32" corresp="#wit-g-prol"><pb n="22" ed="#liebermann"/>LXXVI. Be Wylysces mannes landhæfene.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="32" corresp="#wit-h"><pb n="23" ed="#liebermann"/>LXXVI. Be Wilisces monnes<ptr type="liebermannNote" n="19" target="#Rubrics-Ine_32.lnote.oe.19"/> londhæwene.<ptr type="liebermannNote" n="20" target="#Rubrics-Ine_32.lnote.oe.20-2"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="32" corresp="#wit-q"><pb n="23" ed="#liebermann"/>De Cordubiensi<ptr type="liebermannNote" n="20" target="#Rubrics-Ine_32.lnote.oe.20"/> terram<ptr type="liebermannNote" n="21" target="#Rubrics-Ine_32.lnote.oe.21"/> habente.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="206" ed="#jurasinski-and-oliver"/>LXXVI Be Wilisces monnes londhæfene</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="206" ed="#jurasinski-and-oliver"/>Be Wylisces mannes landhæfene</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="23" ed="#liebermann"/>Vom Landbesitz eines Wälschen<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_32.lnote.de.1"/> Mannes.<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_32.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of the landholding of a Welshman.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="207" ed="#jurasinski-and-oliver"/>Concerning a Welsh landholder</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="207" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_32.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de">cirlisces m. landh. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cirlisces m. landh. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_32.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">wera Cordubiensis [Walisci <hi rend="italic">Br</hi>] hominis t. habentis <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">wera Cordubiensis [Walisci Br] hominis t. habentis Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_32.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">t. h. <hi rend="italic">fehlt Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. h. lacking in Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_32.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a; nes <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">o altered to a; nes written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_32.lnote.oe.20-2" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a; wen <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">o altered to a; wen on an erasure</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_32.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘Cornischen’ meint wohl Q, für Ines Nachbarn vermutlich passend</seg><seg type="translation" xml:lang="en" source="#claude">Q probably means ‘Cornish’, which would presumably suit Ine’s neighbours</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_32.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nicht den Besitz, sondern das Wergeld betrifft Ine 32</seg><seg type="translation" xml:lang="en" source="#claude">Ine 32 concerns not property but the wergild</seg></note>
      </div>
    </body>
