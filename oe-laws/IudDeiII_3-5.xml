        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-5.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-i <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-i written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-5.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">de — malef. <hi rend="italic">am Rande;</hi> hoc cuius inquisitio agitur <hi rend="italic">im Texte H</hi></seg><seg type="translation" xml:lang="en" source="#claude">de — malef. in the margin; hoc cuius inquisitio agitur in the text H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-5.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">pręsentis causae <hi rend="italic">fügt zu Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">pręsentis causae added by Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-5.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-nt <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nt written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-5.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">feruens <hi rend="italic">ohne</hi> u. a. f. <hi rend="italic">Tr;</hi> si aqua extit[er]it, dicat: <hi rend="italic">übergeschr. Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">feruens without u. a. f. Tr; si aqua extit[er]it, dicat: written above Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-5.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">in hanc <hi rend="italic">fügt zu Ch Ci;</hi> u. a. f. <hi rend="italic">fehlt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">in hanc added by Ch Ci; u. a. f. omitted in Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-5.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">tua <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">tua Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-5.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">ac <hi rend="italic">Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">ac Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-5.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-ę -orum <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ę -orum written above H</seg></note>
