    <body>
      <div type="clause" n="15.7">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 15.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 15.7"><pb n="641" ed="#liebermann"/>Si<ptr type="liebermannNote" n="33" target="#ECf_15-7.lnote.la.33"/> parentes<ptr type="liebermannNote" n="34" target="#ECf_15-7.lnote.la.34"/> non haberet, dominus eius eas<ptr type="liebermannNote" n="35" target="#ECf_15-7.lnote.la.35"/> haberet, aut<ptr type="liebermannNote" n="36" target="#ECf_15-7.lnote.la.36"/> felagus<ptr type="liebermannNote" n="a" target="#ECf_15-7.lnote.la.fn.a"/>, si<ptr type="liebermannNote" n="37" target="#ECf_15-7.lnote.la.37"/> haberet<ptr type="liebermannNote" n="38" target="#ECf_15-7.lnote.la.38"/>, scilicet<ptr type="liebermannNote" n="39" target="#ECf_15-7.lnote.la.39"/> fide <pb n="642" ed="#liebermann"/>ligatus cum eo. Si autem neutrum istorum<ptr type="liebermannNote" n="1" target="#ECf_15-7.lnote.la.1"/> haberet, rex regni, sub cuius dominio et pace degunt<ptr type="liebermannNote" n="2" target="#ECf_15-7.lnote.la.2"/> omnes <ptr type="liebermannNote" n="b" target="#ECf_15-7.lnote.la.fn.b"/>albani<ptr type="liebermannNote" n="3" target="#ECf_15-7.lnote.la.3"/>, haberet VI marcas cum suis XL.</ab>
        <note type="comparison" source="#liebermann" n="641"><label>printed alongside</label> <ref target="clause:ECfRetr_15-7">ECf retr 15.7</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 641–642 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “felagus”, “uicarius” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="editorial">Liebermann’s upright a after “felagus” refers to his Erklärungen; his footnote a explains the word.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-7.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">autem <hi rend="italic">fügt zu Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad Do add autem</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-7.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">patrem neque matrem neque parentes haberent <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">patrem neque matrem neque parentes haberent Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-7.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">si <hi rend="italic">Hr Ad Do;</hi> e. h. <hi rend="italic">fehlt Hk S</hi></seg><seg type="translation" xml:lang="en" source="#claude">si Hr Ad Do; e. h. lacking in Hk S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-7.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-7.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-7.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">hab. fideligationem <hi rend="italic">Rl, ohne</hi> sc.</seg><seg type="translation" xml:lang="en" source="#claude">hab. fideligationem Rl, without sc.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-7.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Rl;</hi> f. s. <hi rend="italic">Hr;</hi> fide cum eo lig. <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Rl; f. s. Hr; fide cum eo lig. Ad Do</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_15-7.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">Genoss <hi rend="italic">versteht ein Interpolator der Retr. richtig. Etymologisch liegt Nord.</hi> félagi (Vermögensgenoss, Kamerad) <hi rend="italic">vor; die Erklärung des Verfassers aus</hi> fei <hi rend="italic">verräth den Franzosen</hi></seg><seg type="translation" xml:lang="en" source="#claude">an interpolator of the Retr. rightly understands companion. Etymologically Norse félagi (partner in property, comrade) underlies it; the author’s explanation from fei betrays the Frenchman</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_15-7.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">Fremde, <hi rend="italic">Franz.</hi> aubain, <hi rend="italic">vom Retr. ausgelassen, vermuthlich weil unverstanden;</hi> 1138 <hi rend="italic">nennen sich die Schotten</hi> Albani (<hi rend="italic">Henr. Hunt.</hi>); <hi rend="italic">und</hi> Aubanie <hi rend="italic">heisst Anglofranz. im</hi> 12. <hi rend="italic">Jahrh.</hi> Schottland (<hi rend="italic">Fantosme</hi>). — <hi rend="italic">Der König ist Schutzherr</hi> (<hi rend="italic">der Juden</hi> ECf. 25) <hi rend="italic">schon bei den Angelsachsen der Fremden, empfängt deren Nachlass</hi> (<hi rend="italic">Birch</hi> Chart. Sax. 413) <hi rend="italic">und theilweise das Wergeld Sippenloser;</hi> Ine 23; Af 28</seg><seg type="translation" xml:lang="en" source="#claude">foreigners, French aubain, left out by the Retractator, presumably because not understood; in 1138 the Scots call themselves Albani (Henry of Huntingdon); and in the 12th century Aubanie is Anglo-French for Scotland (Fantosme). — Already among the Anglo-Saxons the king is protector of foreigners (of the Jews, ECf. 25), receives their estate (Birch, Chart. Sax. 413) and in part the wergeld of those without kin; Ine 23; Af 28</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-7.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">horum <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">horum Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-7.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-uit <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uit Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-7.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad Do</seg></note>
      </div>
    </body>
  </text>
