    <body>
      <div type="clause" n="3.1">
        <head><ref type="lawCode" target="law:IIEw">II Ew</ref> 3.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.1" corresp="#wit-h"><pb n="142" ed="#liebermann"/>Gif he nyte, hwa hine on borh nime, þon<hi rend="italic">ne</hi> niman þa ðe hit togebyreð on his æhtan inborh.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.1" corresp="#wit-b"><pb n="142" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="11" target="#IIEw_3-1.lnote.oe.11"/> he nyte, hwa hine<ptr type="liebermannNote" n="18" target="#IIEw_3-1.lnote.oe.18"/> on borh nime, ðon<hi rend="italic">ne</hi> niman ða ðe hit togebyreð on his æhtan inborh.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3.1" corresp="#wit-q"><pb n="143" ed="#liebermann"/>Si nesciat, quis eum capiat in plegium, accipiant illi, quibus hoc pertinet, de pecunia sua inborhgum.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="3.1" corresp="#wit-h"><pb n="118" ed="#attenborough"/>Gif he nyte, hwa hine on borh nime, þonne niman þa ðe hit togebyreð on his æhtan inborh.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="143" ed="#liebermann"/>Wenn er niemanden weiss, der ihn in Bürgschaft nehme, dann sollen diejenigen, denen es zukommt, pfandliche<ptr type="liebermannNote" n="1" target="#IIEw_3-1.lnote.de.1"/> Sicherheit an seinem Vermögen nehmen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he knows of no one who will take him into surety, then those to whom it belongs are to take a pledge-security from his property.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="119" ed="#attenborough"/>If he knows no one who will stand surety for him, those concerned may take security from his property<ptr type="editorNote" n="1" target="#IIEw_3-1.attnote.n.1"/>.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IIAs_20-5">II As 20.5</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_3-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">142</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEw_3-1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">142</biblScope></bibl><seg type="original" xml:lang="de">him <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">him Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEw_3-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">95</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Prozessualpfand 6. 7; Bürgschaft 13a</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Prozessualpfand 6. 7; Bürgschaft 13a</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIEw_3-1.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">205</biblScope></bibl><seg type="original" xml:lang="en">II As. cap. 20 § 5.</seg></note>
      </div>
