    <body>
      <div type="clause" n="23a">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 23a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 23a"><pb n="648" ed="#liebermann"/>Sed si ipse, cui<ptr type="liebermannNote" n="16" target="#ECf_23a.lnote.la.16"/> forisfecerat<ptr type="liebermannNote" n="17" target="#ECf_23a.lnote.la.17"/>, fecerit<ptr type="liebermannNote" n="18" target="#ECf_23a.lnote.la.18"/> clamorem ad iusticiam de eo, quod consilio eius factum sit forisfactum<ptr type="liebermannNote" n="14" target="#ECf_23a.lnote.la.14"/>, expurgabit se sacramento cum duobus legalibus<ptr type="liebermannNote" n="20" target="#ECf_23a.lnote.la.20"/> uicinis suis, si poterit<ptr type="liebermannNote" n="21" target="#ECf_23a.lnote.la.21"/>, de consilio<ptr type="liebermannNote" n="d" target="#ECf_23a.lnote.la.fn.d"/> et facto.</ab>
        <note type="comparison" source="#liebermann" n="648"><label>printed alongside</label> <ref target="clause:ECfRetr_23a">ECf retr 23a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 648 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">There is no note 19 in the ECf column of this page: Liebermann’s numbering goes from 18 to 20.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_23a.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">ræde ⁊ dæde; <hi rend="italic">vgl.</hi> 19</seg><seg type="translation" xml:lang="en" source="#claude">ræde ⁊ dæde; cf. 19</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23a.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">ipse <hi rend="italic">fügt zu S</hi></seg><seg type="translation" xml:lang="en" source="#claude">S adds ipse</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23a.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl;</hi> -rit <hi rend="italic">S Ad Do;</hi> -cit <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl; -rit S Ad Do; -cit Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23a.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">cl. faciat <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">cl. faciat Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23a.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23a.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">hominibus <hi rend="italic">fügt zu Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hr adds hominibus</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23a.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">p. de <hi rend="italic">fehlt Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. de lacking in Do</seg></note>
      </div>
