      <div type="clause" n="22">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 22</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 22"><pb n="647" ed="#liebermann"/><hi rend="bold"><hi rend="spaced">Quid</hi></hi><ptr type="liebermannNote" n="36" target="#ECfRetr_22.lnote.la.36"/> <hi rend="bold"><hi rend="spaced">sit</hi></hi><ptr type="liebermannNote" n="32" target="#ECfRetr_22.lnote.la.32"/> <hi rend="bold"><hi rend="spaced">soca</hi></hi><ptr type="liebermannNote" n="37" target="#ECfRetr_22.lnote.la.37"/><hi rend="bold"><hi rend="spaced">.</hi></hi> Socha<ptr type="liebermannNote" n="38" target="#ECfRetr_22.lnote.la.38"/>: quod, si aliquis<ptr type="liebermannNote" n="39" target="#ECfRetr_22.lnote.la.39"/> querit aliquid<ptr type="liebermannNote" n="10" target="#ECfRetr_22.lnote.la.10"/> in terra sua, etiam<ptr type="liebermannNote" n="40" target="#ECfRetr_22.lnote.la.40"/> furtum<ptr type="liebermannNote" n="10" target="#ECfRetr_22.lnote.la.10"/>, sua est iustitia, si inuentum fuerit an non.</ab>
        <note type="comparison" source="#liebermann" n="647"><label>printed alongside</label> <ref target="clause:ECf_22">ECf 22</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 647 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECfRetr_22.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dann also nicht handhaftes Verbrechen, im Gegensatz zu</hi> infangene-þeof 22, 4</seg><seg type="translation" xml:lang="en" source="#claude">so then not a crime caught in the act, in contrast to infangene-þeof, 22, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">De soca <hi rend="italic">Sp;</hi> De socha <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">De soca Sp; De socha Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">est <hi rend="italic">Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">est Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">socha <hi rend="italic">Cb Db Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">socha Cb Db Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">Socca <hi rend="italic">Hv;</hi> est <hi rend="italic">fügt zu Hv Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">Socca Hv; Hv Sp add est</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">quis querat <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">quis querat Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_22.lnote.la.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Wi</seg></note>
      </div>
