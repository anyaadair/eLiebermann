      <div type="clause" n="21.4">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 21.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 21.4" corresp="#wit-lat"><pb n="404–405" ed="#liebermann"/>ut<ptr type="liebermannNote" n="73" target="#IudDeiI_21-4.lnote.oe.73"/> nullo modo suscipias hos<ptr type="liebermannNote" n="74" target="#IudDeiI_21-4.lnote.oe.74"/> homines illos<ptr type="liebermannNote" n="75" target="#IudDeiI_21-4.lnote.oe.75"/>, si in aliquo sunt<ptr type="liebermannNote" n="76" target="#IudDeiI_21-4.lnote.oe.76"/> culpabiles de hoc quod illis<ptr type="liebermannNote" n="77" target="#IudDeiI_21-4.lnote.oe.77"/> obicitur, scilicet<ptr type="liebermannNote" n="78" target="#IudDeiI_21-4.lnote.oe.78"/> aut per opera aut per consensum uel per conscientiam seu per ullum ingenium;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 404–405 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-4.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">57, 2. 71, 1. 93, 1. 102, 22. 123, 8. 112, 2.</seg><seg type="translation" xml:lang="en" source="#claude">57, 2. 71, 1. 93, 1. 102, 22. 123, 8. 112, 2.</seg><note type="remark" resp="#claude">marker not found in the text</note></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-4.lnote.oe.73" n="73" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">aut <hi rend="italic">Co;</hi> tu <hi rend="italic">fügt zu Tr Vt2</hi></seg><seg type="translation" xml:lang="en" source="#claude">aut Co; tu added by Tr Vt2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-4.lnote.oe.74" n="74" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">hunc -em <hi rend="italic">übergeschr. Ci H;</hi> hunc hominem <hi rend="italic">Co;</hi> uel hanc feminam <hi rend="italic">übergeschr. Vt;</hi> hominem hunc XIII</seg><seg type="translation" xml:lang="en" source="#claude">hunc -em written above Ci H; hunc hominem Co; uel hanc feminam written above Vt; hominem hunc XIII</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-4.lnote.oe.75" n="75" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">N <hi rend="italic">Rj Ca H Co</hi> XIII; <hi rend="italic">fehlt Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">N Rj Ca H Co XIII; lacking in Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-4.lnote.oe.76" n="76" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">sit -is <hi rend="italic">übergeschr. Ci H Vt;</hi> est, <hi rend="italic">übergeschr.</hi> uel sunt <hi rend="italic">Ch;</hi> c-is est de eo quod ei ob. <hi rend="italic">Tr Vt2</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit -is written above Ci H Vt; est, with uel sunt written above, Ch; c-is est de eo quod ei ob. Tr Vt2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-4.lnote.oe.77" n="77" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">-i <hi rend="italic">übergeschr. Ci H;</hi> ei <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-i written above Ci H; ei Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-4.lnote.oe.78" n="78" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">von hier weicht</hi> XIII <hi rend="italic">Zeu.</hi> 665 <hi rend="italic">ab</hi></seg><seg type="translation" xml:lang="en" source="#claude">from here XIII Zeu. 665 diverges</seg></note>
      </div>
