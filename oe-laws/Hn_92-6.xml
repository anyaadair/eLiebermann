        <head><ref type="lawCode" target="law:Hn">Hn</ref> 92.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 92.6" corresp="#wit-lat"><pb n="608" ed="#liebermann"/>Non procedit nec soluatur<ptr type="liebermannNote" n="4" target="#Hn_92-6.lnote.oe.4"/> murdro Anglicus, set Francigena<ptr type="liebermannNote" n="b" target="#Hn_92-6.lnote.oe.b"/>; ex quo uero deest qui interfectum hominem comprobet<ptr type="liebermannNote" n="c" target="#Hn_92-6.lnote.oe.c"/> Anglicum esse<ptr type="liebermannNote" n="5" target="#Hn_92-6.lnote.oe.5"/>, Francigena reputatur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 608 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-6.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 91, 1. 92, 9<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">as</hi> 91, 1. 92, 9<hi rend="italic">b</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-6.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 75, 6<hi rend="italic">b</hi>. 92, 9<hi rend="italic">a</hi>; 11</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">as</hi> 75, 6<hi rend="italic">b</hi>. 92, 9<hi rend="italic">a</hi>; 11</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-6.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de">pro <hi rend="italic">ergänzt Wi unnöthig</hi></seg><seg type="translation" xml:lang="en" source="#claude">pro supplied, unnecessarily, by Wi</seg></note>
