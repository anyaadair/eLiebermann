      <div type="clause" n="17.2">
        <head><ref type="lawCode" target="law:IudDeiXII">Iud Dei XII</ref> 17.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XII 17.2" corresp="#wit-lat"><pb n="421" ed="#liebermann"/>Et si per aliqua maleficia aut per herbas diabolica arte infectas peccata sua contueri<ptr type="liebermannNote" n="25" target="#IudDeiXII_17-2.lnote.oe.25"/> uoluerit, tua dextera<ptr type="liebermannNote" n="26" target="#IudDeiXII_17-2.lnote.oe.26"/> euacuare dignetur. Per unigenitum<ptr type="liebermannNote" n="27" target="#IudDeiXII_17-2.lnote.oe.27"/> (tuum<ptr type="liebermannNote" n="28" target="#IudDeiXII_17-2.lnote.oe.28"/>), dominum nostrum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 421 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_17-2.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">421</biblScope></bibl><seg type="original" xml:lang="de">= tegere 19, 1; <hi rend="italic">vgl.</hi> II 4, 2 <hi rend="italic">o. S.</hi> 407&lt;sup&gt;51&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude">= tegere 19, 1; cf. II 4, 2 above p. 407&lt;sup&gt;51&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_17-2.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">421</biblScope></bibl><seg type="original" xml:lang="de">hoc <hi rend="italic">fügt zu Tr Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Tr Zeu. add hoc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_17-2.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">421</biblScope></bibl><seg type="original" xml:lang="de">filium <hi rend="italic">zu ergänzen aus Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">filium to be supplied from Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_17-2.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">421</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur Tr Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">only Tr Zeu.</seg></note>
      </div>
