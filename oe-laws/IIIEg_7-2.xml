    <body>
      <div type="clause" n="7.2">
        <head><ref type="lawCode" target="law:IIIEg">III Eg</ref> 7.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.2" corresp="#wit-g-a"><pb n="204" ed="#liebermann"/>⁊ gyf<ptr type="liebermannNote" n="11" target="#IIIEg_7-2.lnote.oe.11"/> aðor oððe mǽg<ptr type="liebermannNote" n="19" target="#IIIEg_7-2.lnote.oe.19"/> oþþe fremde þa rade<ptr type="liebermannNote" n="20" target="#IIIEg_7-2.lnote.oe.20"/> forsace, gylde þa<hi rend="italic">m<ptr type="liebermannNote" n="21" target="#IIIEg_7-2.lnote.oe.21"/></hi> cynge hundtwelftig scill'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.2" corresp="#wit-a"><pb n="204" ed="#liebermann"/>⁊ gyf aðer oððe mæg oððe fremde þa ráde forsace, gylde þa<hi rend="italic">m</hi> cynge hundtwelftig scyll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.2" corresp="#wit-d"><pb n="204" ed="#liebermann"/>⁊ gif aðer oððe mæg oððe fre<hi rend="italic">m</hi>de ða rade forsace, gilde þa<hi rend="italic">m</hi> cyninge hundtwelftig scill'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.2" corresp="#wit-g2"><pb n="205" ed="#liebermann"/>Gif aðer oððe mæg oððe fremde þa rade forsace, gylde þam cynge hundtwelftig scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7.2" corresp="#wit-q"><pb n="205" ed="#liebermann"/>Et si aliquis uel cognatus uel extraneus illuc ire negauerit, emendet regi CXX sol.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="7.2" corresp="#wit-d"><pb n="26" ed="#robertson"/>⁊ gif aðer oððe mæg oððe fremde ða rade forsace, gilde þam cyninge hundtwelftig scill'.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="358" ed="#rabin-doml"/>And gyf aðor oððe mæg oþþe fremde þa rade forsace, gylde þam cynge hundtwelftig scillinga.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="205" ed="#liebermann"/>Und wenn entweder ein Verwandter [des Verbrechers] oder ein Fremder diesen Zug verweigert, zahle er dem König 120 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if either a kinsman [of the criminal] or a stranger refuses this riding, let him pay the king 120 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d"><pb n="27" ed="#robertson"/>And if anyone, either kinsman or stranger<ptr type="editorNote" n="1" target="#IIIEg_7-2.robnote.n.1"/>, refuses to ride [against him], he shall pay the king 120 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="436" ed="#whitelock"/>If either kinsman or stranger refuses to go on that ride, he is to pay 120 shillings to the king.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="359" ed="#rabin-doml"/>And if anyone, either his relative or a stranger, refuses to participate in the ride, he is to pay the king one hundred twenty shillings.</ab>
        <note type="comparison" source="#liebermann" n="205"><ref target="clause:IIAs_20-2">II As 20.2</ref>; <ref target="clause:IIIEm_2">III Em 2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. II As. 20, 2; III Em. 2</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_25-2">II Cn 25.2</ref></note>
        <note type="editorial">Here So breaks off. Liebermann compares II As 20.2; III Em 2.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEg_7-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">204</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEg_7-2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">204</biblScope></bibl><seg type="original" xml:lang="de">mæge <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mæge Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEg_7-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">204</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bricht So ab, es folgt</hi> [<hi rend="italic">Af. El.</hi> 49, 5] on eow settan</seg><seg type="translation" xml:lang="en" source="#claude">So breaks off here; there follows [Af. El. 49, 5] on eow settan</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEg_7-2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">204</biblScope></bibl><seg type="original" xml:lang="de">ðæm cyng 120 <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm cyng 120 Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIIEg_7-2.lnote.de.1" n="1" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">137</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Sippe 6a; Strafvollzug 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Sippe 6a; Strafvollzug 4</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIEg_7-2.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">305</biblScope></bibl><seg type="original" xml:lang="en">Cf. the Scots phrase ‘better friend than fremd.’</seg></note>
      </div>
