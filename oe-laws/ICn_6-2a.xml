      <div type="clause" n="6.2a">
        <head><ref type="lawCode" target="law:ICn">I Cn</ref> 6.2a</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.2a" corresp="#wit-g-a"><pb n="290" ed="#liebermann"/>⁊ se ðe þæs geswican wille ⁊ clænnesse<ptr type="liebermannNote" n="1" target="#ICn_6-2a.lnote.oe.1"/> healdan, hæbbe he Godes miltse ⁊ to woruldwurðscipe<ptr type="liebermannNote" n="2" target="#ICn_6-2a.lnote.oe.2"/> si he þegenlage wyrðe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.2a" corresp="#wit-a"><pb n="290" ed="#liebermann"/>⁊ se þe þæs geswican wille ⁊ clænnesse healden, habbe he Godes miltse ⁊ to wuruldwurðscipe sy he þegenlage wyrðe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.2a" corresp="#wit-d-frags"><pb n="290" ed="#liebermann"/>⁊ se ðe þæs geswican wille ⁊ clænnesse healdan, hæbbe he Godes miltse ⁊ to worldwurðscipe sy he þegenlaga wyrðe.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6.2a" corresp="#wit-q"><pb n="290" ed="#liebermann"/>Et qui<ptr type="liebermannNote" n="1" target="#ICn_6-2a.lnote.oe.1-2"/> super his abstinebit et castitatem seruabit, ad profectum<ptr type="liebermannNote" n="2" target="#ICn_6-2a.lnote.oe.2-2"/> sempiternum<ptr type="liebermannNote" n="3" target="#ICn_6-2a.lnote.oe.3"/> Dei misericordiam habeat<ptr type="liebermannNote" n="4" target="#ICn_6-2a.lnote.oe.4"/> et ad honorem seculi taini<ptr type="liebermannNote" n="5" target="#ICn_6-2a.lnote.oe.5"/> lege dignus sit.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.2a" corresp="#wit-inst-cn"><pb n="291" ed="#liebermann"/>Qui autem abhinc a tali opere cessare et castitatem custodire uoluerit<ptr type="liebermannNote" n="1" target="#ICn_6-2a.lnote.oe.1-4"/> (studuerit), misericordiam Dei habeat et secundum dignitatem<ptr type="liebermannNote" n="2" target="#ICn_6-2a.lnote.oe.2-3"/> seculi liberalitatem<ptr type="liebermannNote" n="3" target="#ICn_6-2a.lnote.oe.3-2"/>, quam Angli uocant<ptr type="liebermannNote" n="4" target="#ICn_6-2a.lnote.oe.4-2"/> þegenscipe.<ptr type="liebermannNote" n="5" target="#ICn_6-2a.lnote.oe.5-2"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6.2a" corresp="#wit-cons-cn"><pb n="291" ed="#liebermann"/>Quicumque ergo hinc occupatus, cessare et castitatem diligere uoluerit, Dei misericordiam consequatur et honorem seculi, sitque uirronis priuilegio dignus.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="6a.2a" corresp="#wit-g-a"><pb n="162" ed="#robertson"/>⁊ se ðe þæs geswican wille ⁊ clænnesse healdan, hæbbe he Godes miltse ⁊ to woruldwurðscipe si he þegenlage wyrðe.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="240" ed="#rabin-doml"/>And se ðe þæs geswican wille and clænnesse healdan hæbbe he Godes miltse, and to woruldwurðscipe si he þegenlage wyrðe.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="291" ed="#liebermann"/>Und wer hiervon abstehen und Keuschheit bewahren will, erhalte er Gottes Gnade und zum weltlichen Ehrenrang sei er Thegn-Vorrechts<ptr type="liebermannNote" n="1" target="#ICn_6-2a.lnote.de.1"/> würdig.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And whoever will desist from this and keep chastity, let him have God's mercy, and as a worldly honour let him be entitled to a thegn's rights.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-g-a"><pb n="163" ed="#robertson"/>And he who will turn from marriage and observe celibacy shall obtain the favour of God, and as worldly honour he shall enjoy the privileges of a thegn<ptr type="editorNote" n="1" target="#ICn_6-2a.robnote.n.1"/>.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="241" ed="#rabin-doml"/>But he who will renounce marriage and practice celibacy will have God’s favor, and also, as a privilege in this world, he shall be deemed worthy of a thane’s rights.</ab>
        <note type="comparison" source="#liebermann" n="291"><ref target="clause:VAtr_9-1">V Atr 9.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. V Atr. 9, 1</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Gethyn_7">Geþyncðo 7</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="393"><label>same principle</label> <ref target="clause:Northleoda_5">Norðleoda 5</ref> <quote>Clauses were intruded into Norðleoda Laga equating the wergeld of priest and thegn, and into Að making the same point ... the archbishop stressed this principle from Enham onwards</quote></note>
        <note type="editorial">Liebermann compares V Atr 9.1.; BR: added from Gesetze I p. 291, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-2a.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de">-sa h., habbe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sa h., habbe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-2a.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de">wur. sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wur. sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-2a.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-2a.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de">proue. <hi rend="italic">Hk</hi>; perfe. <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">proue. Hk; perfe. Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-2a.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de">semper iterum <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">semper iterum K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-2a.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de">habet <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">habet Dm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-2a.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de">thani <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">thani K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-2a.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">291</biblScope></bibl><seg type="original" xml:lang="de">sicque <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">sicque Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-2a.lnote.oe.1-4" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">291</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Cb; eingeklammertes übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">the text before the bracket Cb; the bracketed text the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-2a.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">291</biblScope></bibl><seg type="original" xml:lang="de">s. d. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. d. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-2a.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">291</biblScope></bibl><seg type="original" xml:lang="de">libertatem <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">libertatem Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-2a.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">291</biblScope></bibl><seg type="original" xml:lang="de">theg. uoc. <hi rend="italic">Di</hi></seg><seg type="translation" xml:lang="en" source="#claude">theg. uoc. Di</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-2a.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">291</biblScope></bibl><seg type="original" xml:lang="de">theg. <hi rend="italic">HDi</hi>; thengesshipe habeat <hi rend="italic">Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">theg. HDi; thengesshipe habeat Lb S</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_6-2a.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">199</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Statt <hi rend="italic">riht</hi> der Quelle steht das modernere Nord. <hi rend="italic">lagu</hi>.—Cons. braucht <hi rend="italic">virro</hi> oft, <hi rend="italic">s. Wb</hi>; einmal glossiert Hs. Hr: <hi rend="italic">procer</hi>; <hi rend="italic">vgl</hi>. Ducange <hi rend="italic">s. v.: viro</hi>. Auch <hi rend="italic">Hist. Eli</hi>. II 32, ed. Stewart 148, bietet das Wort</seg><seg type="translation" xml:lang="en" source="#claude">Instead of the source’s <hi rend="italic">riht</hi> there stands the more modern Norse <hi rend="italic">lagu</hi>. — Cons. often uses <hi rend="italic">virro</hi>, <hi rend="italic">see Wb</hi>; once MS Hr glosses it: <hi rend="italic">procer</hi>; <hi rend="italic">cf</hi>. Ducange <hi rend="italic">s. v.: viro</hi>. The <hi rend="italic">Hist. Eli</hi>. II 32, ed. Stewart 148, also has the word</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="ICn_6-2a.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">349</biblScope></bibl><seg type="original" xml:lang="en">The Scandinavian <hi rend="italic">lagu</hi> here replaces the <hi rend="italic">riht</hi> of Canute’s source.</seg></note>
      </div>
