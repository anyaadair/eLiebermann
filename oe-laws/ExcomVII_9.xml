      <div type="clause" n="9">
        <head><ref type="lawCode" target="law:ExcomVII">Excom VII</ref> 9</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Excom VII 9" corresp="#wit-cx"><pb n="438" ed="#liebermann"/>Beon hi awergode waciende ⁊ slæpende!</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="438" ed="#liebermann"/>Seien sie verflucht wachend und schlafend<ptr type="liebermannNote" n="v" target="#ExcomVII_9.lnote.de1.v"/>!</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">May they be cursed waking and sleeping!</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text and German translation transcribed from Gesetze I p. 438 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="ExcomVII_9.lnote.de1.v" n="v" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">438</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> IV 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> IV 4</seg></note>
      </div>
