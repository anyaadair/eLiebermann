    <body>
      <div type="clause" n="22.2">
        <head><ref type="lawCode" target="law:VAtr">V Atr</ref> 22.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.2" corresp="#wit-g"><pb n="242" ed="#liebermann"/>⁊ word ⁊ weorc fadige mid rihte ⁊ að ⁊ wedd wærlice healde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.2" corresp="#wit-g2"><pb n="242" ed="#liebermann"/>⁊ word ⁊ weorc fadige mid rihte ⁊ að ⁊ wedd wærlice healde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.2" corresp="#wit-d"><pb n="243" ed="#liebermann"/>⁊ word ⁊ weorc fadige mid rihte ⁊ að ⁊ wed wærlice healde.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="22.2" corresp="#wit-d"><pb n="84" ed="#robertson"/>⁊ word ⁊ weorc fadige mid rihte ⁊ að ⁊ wed wærlice healde.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g"><pb n="154" ed="#rabin-doml"/>And word and weorc fadige mid rihte and að and wedd wærlice healde.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="243" ed="#liebermann"/>und<ptr type="liebermannNote" n="1" target="#VAtr_22-2.lnote.de.1"/> ordne [sein] Wort und Werk gerecht und halte sorgsam Eid<ptr type="liebermannNote" n="2" target="#VAtr_22-2.lnote.de.2"/> und Versprechen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">and order [his] words and deeds rightly, and keep oath and pledge carefully.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d"><ptr type="editorNote" n="1" target="#VAtr_22-2.robnote.n.1"/><pb n="85" ed="#robertson"/>And he shall order his words and deeds aright and carefully abide by his oath and his pledge.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-g"><pb n="450" ed="#whitelock"/>and to order words and deeds rightly, and keep carefully oath and pledge.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g"><pb n="155" ed="#rabin-doml"/>And words and deeds are to be ordered properly, and oath and pledge carefully upheld.</ab>
        <note type="comparison" source="#liebermann" n="243"><ref target="clause:Af_1">Af 1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. Af. 1</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VIAtr_28">VI Atr 28</ref></note>
        <note type="editorial">Liebermann compares Af 1.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_22-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">173</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">= VI 28 = I Cn 19, 1. Den ganzen Satz wiederholt Wulfstan 1014, ed. Napier 167</seg><seg type="translation" xml:lang="en" source="#claude">= VI 28 = I Cn 19, 1. The whole sentence is repeated by Wulfstan in 1014, ed. Napier 167</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_22-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">173</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Eid 4; Meineid 7; Versprechen 4. 6b</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Eid 4; Meineid 7; Versprechen 4. 6b</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VAtr_22-2.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="en">Cf. Af. 1; VI Atr. 28; I Cn. 19, 1.</seg></note>
      </div>
