      <div type="clause" n="1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 1"><pb n="628" ed="#liebermann"/>A <hi rend="bold">legibus</hi> itaque<ptr type="liebermannNote" n="1" target="#ECfRetr_1.lnote.la.1"/> sancte <hi rend="bold">matris</hi><ptr type="liebermannNote" n="2" target="#ECfRetr_1.lnote.la.2"/> ecclesie sumentes exordium, <hi rend="bold">quoniam</hi> per eam rex et regnum solidum subsistendi habent <hi rend="bold">fundamentum, leges</hi><ptr type="liebermannNote" n="3" target="#ECfRetr_1.lnote.la.3"/> libertatis<ptr type="liebermannNote" n="4" target="#ECfRetr_1.lnote.la.4"/> et pacis<ptr type="liebermannNote" n="5" target="#ECfRetr_1.lnote.la.5"/> ipsius concionati sunt dicentes:</ab>
        <note type="comparison" source="#liebermann" n="628"><label>printed alongside</label> <ref target="clause:ECf_1">ECf 1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 628 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_1.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">igitur <hi rend="italic">Sp Ld;</hi> namque <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">igitur Sp Ld; namque Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_1.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">e. m. <hi rend="italic">Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. m. Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_1.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">legis <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">legis Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_1.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">-tates ip. pa. <hi rend="italic">Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tates ip. pa. Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_1.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">pacem <hi rend="italic">Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">pacem Sp</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Taking their beginning, therefore, from the laws of holy mother Church, since through her king and kingdom have a solid foundation for standing firm, they declared the laws of her liberty and peace, saying:</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_1.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">343</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">namque</hi><hi rend="superscript">1</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">namque</hi><hi rend="superscript">1</hi> Rs</seg></note>
      </div>
    </body>
