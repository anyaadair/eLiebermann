    <body>
      <div type="clause" n="84.4a">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 84.4a</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="84.4a" corresp="#wit-g-a"><pb n="368" ed="#liebermann"/>⁊ ælc<ptr type="liebermannNote" n="24" target="#IICn_84-4a.lnote.oe.24"/> þe gescead wite, hlyste<ptr type="liebermannNote" n="25" target="#IICn_84-4a.lnote.oe.25"/> him georne, ⁊ godcunde lare<ptr type="liebermannNote" n="26" target="#IICn_84-4a.lnote.oe.26"/> gehwa on geþance healde<ptr type="liebermannNote" n="27" target="#IICn_84-4a.lnote.oe.27"/> swyðe fæste, him sylfum<ptr type="liebermannNote" n="28" target="#IICn_84-4a.lnote.oe.28"/> to þearfe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="84.4a" corresp="#wit-b"><pb n="368" ed="#liebermann"/>And ælc ðe gescead wite, hlyste him georne, ⁊ godcunde lare gewha<ptr type="liebermannNote" n="1" target="#IICn_84-4a.lnote.oe.1"/> on geðance healde swyðe fæste, him sylfum to ðearfe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="84.4a" corresp="#wit-a"><pb n="368" ed="#liebermann"/>⁊ alc<ptr type="liebermannNote" n="7" target="#IICn_84-4a.lnote.oe.7"/> þe gescad wite, hliste him georne, and godcunde lara gehwa on geþance healde swyðe<ptr type="liebermannNote" n="8" target="#IICn_84-4a.lnote.oe.8-2"/> fæste, hi<hi rend="italic">m</hi> sylfu<hi rend="italic">m</hi> to ðearfe.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="84.4a" corresp="#wit-q"><pb n="369" ed="#liebermann"/>Et omnis qui discretionis particeps<ptr type="liebermannNote" n="12" target="#IICn_84-4a.lnote.oe.12"/> (sciens) est et zelum Dei habet, audiat<ptr type="liebermannNote" n="13" target="#IICn_84-4a.lnote.oe.13"/> illos gratissime et Dei doctrinam in mente habeat firmiter, sibimet ad utilitatem.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="84.4a" corresp="#wit-cons-cn"><pb n="369" ed="#liebermann"/>Et omnis qui discrecionem habeat, attente illum audiat, diuinamque doctrinam quisque mente firmiter teneat, sibimet ad utilitatem.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="84.4a" corresp="#wit-b"><pb n="216" ed="#robertson"/>And ælc ðe gescead wite, hlyste him georne ⁊ godcunde lare gewha on geðance healde swyðe fæste him sylfum to ðearfe.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="298" ed="#rabin-doml"/>And ælc þe gescead wite hlyste him georne and godcunde lare gehwa on geþance healde swyðe fæste, him sylfum to þearfe.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="369" ed="#liebermann"/>Und jeder, der Vernunft besitzt, lausche ihnen willig, und jeder halte geistliche Lehre recht fest im Gedächtnisse, sich selbst zum Nutzen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let everyone who has understanding listen to them willingly, and let everyone hold spiritual teaching very firmly in memory, for his own benefit.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="217" ed="#robertson"/>And everyone who has discernment shall earnestly give heed to them, and everyone for his own well-being shall keep fast in his mind their spiritual instruction.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="299" ed="#rabin-doml"/>And everyone capable of reason shall sincerely listen to them and hold their spiritual teachings firmly in mind for their own good.</ab>
        <note type="editorial">BR: added from Gesetze I p. 369, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-4a.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">369</biblScope></bibl><seg type="original" xml:lang="de">illos <hi rend="italic">zu bessern?</hi></seg><seg type="translation" xml:lang="en" source="#claude">illos to be emended?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-4a.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-4a.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">369</biblScope></bibl><seg type="original" xml:lang="de">p. <hi rend="italic">K;</hi> s. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. K; s. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-4a.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">369</biblScope></bibl><seg type="original" xml:lang="de">-ant <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ant T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-4a.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de">eal ðe gescad <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">eal ðe gescad Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-4a.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de">hlist <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hlist Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-4a.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de">lara <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lara Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-4a.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de">heald swiþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">heald swiþ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-4a.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de">silfu <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">silfu Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-4a.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vorn</hi> [e?] <hi rend="italic">und</hi> c <hi rend="italic">verschabt; vgl. Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">[e?] in front and c scraped away; cf. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-4a.lnote.oe.8-2" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">368</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> swiðe</seg><seg type="translation" xml:lang="en" source="#claude">altered swiðe</seg></note>
      </div>
