      <div type="clause" n="I Cn 18">
        <head>Quadr Rb I Cn 18</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Rb I Cn 18" corresp="#wit-lat"><pb n="536" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#Quadr-Rb_I-Cn-18.lnote.oe.erkl-clause"/>De<ptr type="liebermannNote" n="41" target="#Quadr-Rb_I-Cn-18.lnote.la.41"/> confessione et penitentia uigiliis<ptr type="liebermannNote" n="†" target="#Quadr-Rb_I-Cn-18.lnote.la.dagger"/>, ieiuniis, orationibus<ptr type="liebermannNote" n="42" target="#Quadr-Rb_I-Cn-18.lnote.la.42"/>, elemosinis<ptr type="liebermannNote" n="43" target="#Quadr-Rb_I-Cn-18.lnote.la.43"/> pro<ptr type="liebermannNote" n="44" target="#Quadr-Rb_I-Cn-18.lnote.la.44"/> suggestione<ptr type="liebermannNote" n="b" target="#Quadr-Rb_I-Cn-18.lnote.la.fn.b"/>, delectatione<ptr type="liebermannNote" n="45" target="#Quadr-Rb_I-Cn-18.lnote.la.45"/>, consensu.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 536 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">Of confession and penance, by vigils, fasts, prayers, alms, for suggestion, delight, consent.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-18.lnote.la.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">De c. et p. <hi rend="italic">zu</hi> 18, 1 <hi rend="italic">R, ohne</hi> uig. — spe</seg><seg type="translation" xml:lang="en" source="#claude">De c. et p. at 18, 1 R, without uig. — spe</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-18.lnote.la.dagger" n="†" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Fettgedrucktes erfand Quadr. frei hinzu</hi></seg><seg type="translation" xml:lang="en" source="#claude">What is in bold type Quadr. freely invented and added</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-18.lnote.la.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Br adds et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-18.lnote.la.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu T</hi></seg><seg type="translation" xml:lang="en" source="#claude">T adds et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-18.lnote.la.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">pro s. <hi rend="italic">fehlt Hk;</hi> et aliis <hi rend="italic">statt</hi> pro s., d., c. <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">pro s. lacking in Hk; et aliis instead of pro s., d., c. Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-18.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Ded.</hi> 13, <hi rend="italic">o. S.</hi> 530<hi rend="superscript"><hi rend="italic">c</hi></hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. Ded. 13, above p. 530 note c</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-18.lnote.la.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">de dileccione <hi rend="italic">ohne</hi> cons. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">de dileccione without cons. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-18.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">312</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">S. 536 Sp. 1, drittletzte Z.† Dieselben hier eingefügten Wörter bringt Verf. auch Hn 72, 2b</seg><seg type="translation" xml:lang="en" source="#claude">P. 536 col. 1, third line from the bottom.† The same words inserted here the author also gives in Hn 72, 2b</seg></note>
      </div>
    </body>
