      <div type="clause" n="3">
        <head><ref type="lawCode" target="law:ExcomVI">Excom VI</ref> 3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom VI 3" corresp="#wit-ca"><pb n="436" ed="#liebermann"/>De Patre et Filio et Spiritu sancto sit maledictus ille — et tua<ptr type="liebermannNote" n="3" target="#ExcomVI_3.lnote.oe.3"/> (illius) progenies<ptr type="liebermannNote" n="i" target="#ExcomVI_3.lnote.oe.i"/> — et anathematizatus et alligatus laqueis<ptr type="liebermannNote" n="4" target="#ExcomVI_3.lnote.oe.4"/> diabolicis seu catenis in<ptr type="liebermannNote" n="k" target="#ExcomVI_3.lnote.oe.k"/> infernum cum<ptr type="liebermannNote" n="k" target="#ExcomVI_3.lnote.oe.k"/> diabolo et angelis eius conductus.</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">ebd. 41</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 436 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVI_3.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">436</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. u.</hi> 10. 16, 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf. below</hi> 10. 16, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVI_3.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">436</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. u.</hi> 13. 19 <hi rend="italic">ff.</hi> I 11, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf. below</hi> 13. 19 <hi rend="italic">ff.</hi> I 11, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVI_3.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">436</biblScope></bibl><seg type="original" xml:lang="de">illius <hi rend="italic">über</hi> tua, <hi rend="italic">das unterpunctirt und durchstrichen Ca</hi></seg><seg type="translation" xml:lang="en" source="#claude">illius above tua, which is underdotted and struck through <hi rend="italic">Ca</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVI_3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">436</biblScope></bibl><seg type="original" xml:lang="de">l. d. <hi rend="italic">spätere Hand auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">l. d. in a later hand on an erasure</seg></note>
