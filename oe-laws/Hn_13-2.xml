      <div type="clause" n="13.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 13.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 13.2" corresp="#wit-lat"><pb n="558" ed="#liebermann"/>Murdrum XLVI<ptr type="liebermannNote" n="za" target="#Hn_13-2.lnote.oe.za"/> marcis reddatur<ptr type="liebermannNote" n="42" target="#Hn_13-2.lnote.oe.42"/>, nisi malefactor infra VII dies habeatur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 558 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_13-2.lnote.oe.za" n="za" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">XLVI — habeatur <hi rend="italic">vielleicht nachgetragen</hi> (<hi rend="italic">aus</hi> 91, 1) <hi rend="italic">zu ursprünglich blossem</hi> Murdrum; <hi rend="italic">vgl. genauer</hi> 75, 6 <hi rend="italic">f.</hi> 91, 1 <hi rend="italic">bis</hi> 92, 19; ECf. 15, 2</seg><seg type="translation" xml:lang="en" source="#claude">XLVI — habeatur perhaps added later (from 91, 1) to an originally bare Murdrum; cf., in more detail, 75, 6 f. 91, 1 to 92, 19; ECf. 15, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_13-2.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">-antur <hi rend="italic">Sc Hg Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-antur Sc Hg Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_13-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Murdrum 9. 14.—Am Rande spät: <hi rend="italic">Nota, quantum solvi consuevit pro murdro</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Murdrum 9. 14.—In the margin, in a late hand: <hi rend="italic">Nota, quantum solvi consuevit pro murdro</hi> Rs</seg></note>
      </div>
