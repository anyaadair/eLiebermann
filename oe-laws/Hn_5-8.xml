      <div type="clause" n="5.8">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.8" corresp="#wit-lat"><pb n="549" ed="#liebermann"/>Sicut<ptr type="liebermannNote" n="k" target="#Hn_5-8.lnote.oe.k"/> autem nec clerici laicos<ptr type="liebermannNote" n="19" target="#Hn_5-8.lnote.oe.19"/>, ita nec laici<ptr type="liebermannNote" n="19" target="#Hn_5-8.lnote.oe.19"/> clericos in suis accusationibus (uel<ptr type="liebermannNote" n="l" target="#Hn_5-8.lnote.oe.l"/> infamationibus) debent recipere<ptr type="liebermannNote" n="m" target="#Hn_5-8.lnote.oe.m"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 549 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-8.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch Ivo</hi> Decr. VI 313; <hi rend="italic">Gr.</hi> C. 2 q. 7 c. 6; c. 2 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">also Ivo Decr. VI 313; Gr. C. 2 q. 7 c. 6; c. 2 f.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-8.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">uel inf. <hi rend="italic">fehlt Lond</hi> [<hi rend="italic">vielleicht Nachtrag des Verf.</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">uel inf. missing in Lond [perhaps an addition by the author]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-8.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 5, 22. 73, 1; <hi rend="italic">anders</hi> 66, 2; <hi rend="italic">allgemeiner als</hi> ECf. 2, 9. 6</seg><seg type="translation" xml:lang="en" source="#claude">cf. 5, 22. 73, 1; otherwise 66, 2; more general than ECf. 2, 9. 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-8.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">layc. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">layc. Co Or</seg></note>
