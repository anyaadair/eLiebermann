      <div type="clause" n="82.8">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 82.8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 82.8" corresp="#wit-lat"><pb n="599" ed="#liebermann"/>Similiter pugnare<ptr type="liebermannNote" n="14" target="#Hn_82-8.lnote.oe.14"/> potest homo contra eum quem cum desponsata<ptr type="liebermannNote" n="15" target="#Hn_82-8.lnote.oe.15"/> sibi<ptr type="liebermannNote" n="16" target="#Hn_82-8.lnote.oe.16"/> uxore post<ptr type="liebermannNote" n="e" target="#Hn_82-8.lnote.oe.e"/> secundam et terciam prohibicionem clausis hostiis<ptr type="liebermannNote" n="17" target="#Hn_82-8.lnote.oe.17"/> et<ptr type="liebermannNote" n="18" target="#Hn_82-8.lnote.oe.18"/> sub una coopertura<ptr type="liebermannNote" n="f" target="#Hn_82-8.lnote.oe.f"/> inueniet<ptr type="liebermannNote" n="19" target="#Hn_82-8.lnote.oe.19"/>, siue cum filia sua, quam de sponsa(ta<ptr type="liebermannNote" n="20" target="#Hn_82-8.lnote.oe.20"/>) genuerit, siue<ptr type="liebermannNote" n="21" target="#Hn_82-8.lnote.oe.21"/> cum sorore sua, que de sponsa(ta)<ptr type="liebermannNote" n="23" target="#Hn_82-8.lnote.oe.23"/> sit, siue cum matre sua<ptr type="liebermannNote" n="13" target="#Hn_82-8.lnote.oe.13"/>, que patri<ptr type="liebermannNote" n="24" target="#Hn_82-8.lnote.oe.24"/> suo fuerit desponsata<ptr type="liebermannNote" n="25" target="#Hn_82-8.lnote.oe.25"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 599 (two independent readings of the page images, differences settled against the page); Liebermann’s Erklärung (Gesetze III p. 328) has a stray full stop after the dash in ‘c.—. d.’; transcribed as printed</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-8.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Römischem Recht</hi> (<hi rend="italic">nicht direct; Conrat-Cohn</hi> Gesch. Röm. Rechts I 60) <hi rend="italic">durch Canones:</hi> quem postquam ter prohibuerit, . . inuenerit <hi rend="italic">Ivo</hi> Decr. VIII 111</seg><seg type="translation" xml:lang="en" source="#claude">from Roman law (not directly; Conrat-Cohn Gesch. Röm. Rechts I 60) through the canons: quem postquam ter prohibuerit, . . inuenerit Ivo Decr. VIII 111</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-8.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht aus Angelsächs. Ælfred</hi></seg><seg type="translation" xml:lang="en" source="#claude">perhaps from the Anglo-Saxon Ælfred</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-8.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-8.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">po. h. pu. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">po. h. pu. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-8.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">-nssa. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nssa. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-8.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co Or</hi>; u. sua <hi rend="italic">K Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Co Or; u. sua K Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-8.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">‘<hi rend="italic">leg.</hi> ostiis’ <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘leg. ostiis’ Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-8.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Co Or Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel Co Or Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-8.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">-iat <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iat <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-8.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">sponsa <hi rend="italic">Lond</hi>; -ata <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">sponsa Lond; -ata Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-8.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">d <hi rend="italic">fügt ein, unterpunctirt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">Sc inserts d, marked for deletion by a dot beneath</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-8.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">sponsa <hi rend="italic">Sc Hg</hi>; sponsata <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sponsa Sc Hg; sponsata Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-8.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">primo <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">primo Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-8.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">despossa. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">despossa. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-8.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Ehebruch 8a. 9b. 12.b—<hi rend="italic">S. po. h. pu</hi>.{14} <hi rend="italic">c</hi>.—. <hi rend="italic">d</hi>.{15} <hi rend="italic">uxore sua p</hi>. ohne <hi rend="italic">sibi</hi>—<hi rend="italic">sponsa</hi>{23}—<hi rend="italic">sua</hi>{18} fehlt—82, 9 <hi rend="italic">scy</hi>.{27} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Ehebruch 8a. 9b. 12.b—<hi rend="italic">S. po. h. pu</hi>.{14} <hi rend="italic">c</hi>.—. <hi rend="italic">d</hi>.{15} <hi rend="italic">uxore sua p</hi>. without <hi rend="italic">sibi</hi>—<hi rend="italic">sponsa</hi>{23}—<hi rend="italic">sua</hi>{18} missing—82, 9 <hi rend="italic">scy</hi>.{27} Rs</seg></note>
