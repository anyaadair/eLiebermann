        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de">man <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">man Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-3.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-3.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de">-tnes <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tnes Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-3.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de">-den <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-den Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-3.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de">l. D. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">l. D. R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-3.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zweimal</hi></seg><seg type="translation" xml:lang="en" source="#claude">twice</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_6-3.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">290</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_6-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">199</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">= <hi rend="italic">for Godes cge</hi> 4, 3</seg><seg type="translation" xml:lang="en" source="#claude">= <hi rend="italic">for Godes cge</hi> 4, 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_6-3.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">199</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl</hi>. gegen Unzucht 7, 2f. 24. II 50—54; Cn 1020, 15f.</seg><seg type="translation" xml:lang="en" source="#claude">Against unchastity <hi rend="italic">cf</hi>. 7, 2f. 24. II 50—54; Cn 1020, 15f.</seg></note>
