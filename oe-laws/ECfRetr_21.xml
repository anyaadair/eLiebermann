      <div type="clause" n="21">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 21</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 21"><pb n="646" ed="#liebermann"/><ptr type="liebermannNote" n="30" target="#ECfRetr_21.lnote.la.30"/><hi rend="bold"><hi rend="spaced">Quod (archiepiscopi</hi></hi><ptr type="liebermannNote" n="31" target="#ECfRetr_21.lnote.la.31"/><hi rend="bold"><hi rend="spaced">, episcopi, comites et</hi></hi><ptr type="liebermannNote" n="32" target="#ECfRetr_21.lnote.la.32"/> <hi rend="bold"><hi rend="spaced">barones et) omnes qui habent saca</hi></hi><ptr type="liebermannNote" n="33" target="#ECfRetr_21.lnote.la.33"/> <hi rend="bold"><hi rend="spaced">et soca et</hi></hi><ptr type="liebermannNote" n="34" target="#ECfRetr_21.lnote.la.34"/> <hi rend="bold"><hi rend="spaced">tol et theam</hi></hi><ptr type="liebermannNote" n="35" target="#ECfRetr_21.lnote.la.35"/> <hi rend="bold"><hi rend="spaced">et infangenetheof</hi></hi><ptr type="liebermannNote" n="36" target="#ECfRetr_21.lnote.la.36"/> <hi rend="bold"><hi rend="spaced">(pro</hi></hi><ptr type="liebermannNote" n="37" target="#ECfRetr_21.lnote.la.37"/> <hi rend="bold"><hi rend="spaced">militibus</hi></hi><ptr type="liebermannNote" n="38" target="#ECfRetr_21.lnote.la.38"/><hi rend="bold"><hi rend="spaced">, ministris et clientibus suis</hi></hi><ptr type="liebermannNote" n="39" target="#ECfRetr_21.lnote.la.39"/> <hi rend="bold"><hi rend="spaced">et) pro omnibus sibi</hi></hi><ptr type="liebermannNote" n="40" target="#ECfRetr_21.lnote.la.40"/> <hi rend="bold"><hi rend="spaced">seruientibus</hi></hi><ptr type="liebermannNote" n="41" target="#ECfRetr_21.lnote.la.41"/> <hi rend="bold"><hi rend="spaced">frithborgas</hi></hi><ptr type="liebermannNote" n="42" target="#ECfRetr_21.lnote.la.42"/> <hi rend="bold"><hi rend="spaced">dare debent.</hi></hi> <pb n="647" ed="#liebermann"/><hi rend="bold">(Archiepiscopi</hi><ptr type="liebermannNote" n="1" target="#ECfRetr_21.lnote.la.1"/><hi rend="bold">, episcopi, comites</hi><ptr type="liebermannNote" n="2" target="#ECfRetr_21.lnote.la.2"/><hi rend="bold">),</hi> barones <hi rend="bold">(et</hi><ptr type="liebermannNote" n="3" target="#ECfRetr_21.lnote.la.3"/> <hi rend="bold">omnes qui habent sacham</hi><ptr type="liebermannNote" n="4" target="#ECfRetr_21.lnote.la.4"/> <hi rend="bold">et socha</hi><ptr type="liebermannNote" n="5" target="#ECfRetr_21.lnote.la.5"/><hi rend="bold">, tol et them</hi><ptr type="liebermannNote" n="8" target="#ECfRetr_21.lnote.la.8"/> <hi rend="bold">et infangenþef</hi><ptr type="liebermannNote" n="9" target="#ECfRetr_21.lnote.la.9"/><hi rend="bold">)</hi> etiam<ptr type="liebermannNote" n="10" target="#ECfRetr_21.lnote.la.10"/> milites<ptr type="liebermannNote" n="11" target="#ECfRetr_21.lnote.la.11"/> suos et proprios<ptr type="liebermannNote" n="12" target="#ECfRetr_21.lnote.la.12"/> seruientes, scilicet<ptr type="liebermannNote" n="10" target="#ECfRetr_21.lnote.la.10"/> dapiferos, pincernas, camerarios, cocos, pistores<ptr type="liebermannNote" n="13" target="#ECfRetr_21.lnote.la.13"/>, sub suo friborgo<ptr type="liebermannNote" n="14" target="#ECfRetr_21.lnote.la.14"/> habeant<ptr type="liebermannNote" n="15" target="#ECfRetr_21.lnote.la.15"/>; et<ptr type="liebermannNote" n="16" target="#ECfRetr_21.lnote.la.16"/> <hi rend="bold">item</hi><ptr type="liebermannNote" n="17" target="#ECfRetr_21.lnote.la.17"/> <hi rend="bold">isti</hi> suos armigeros uel alios <hi rend="bold">sibi</hi> seruientes sub suo<ptr type="liebermannNote" n="18" target="#ECfRetr_21.lnote.la.18"/> friborgo<ptr type="liebermannNote" n="19" target="#ECfRetr_21.lnote.la.19"/>.</ab>
        <note type="comparison" source="#liebermann" n="646"><label>printed alongside</label> <ref target="clause:ECf_21">ECf 21</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 646–647 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">The bold heading of ECf retr 21, with its notes 30–42, stands at the foot of the ECf retr column on p. 646; the text follows on p. 647.</note>
        <note type="editorial">There are no notes 6 and 7 in the ECf retr column of p. 647: Liebermann’s numbering goes from 5 to 8.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_21.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">Descriptio libertatum diuersarum <hi rend="italic">setzt voran S; nur</hi> Barones habeant suos in plegio <hi rend="italic">Cb;</hi> De baronibus qui suam habent curiam et consuetudines <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">S puts Descriptio libertatum diuersarum before it; only Barones habeant suos in plegio Cb; De baronibus qui suam habent curiam et consuetudines Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_21.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">a.—bar. et <hi rend="italic">aus Hv Lb; fehlt Db Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">a.—bar. et from Hv Lb; lacking in Db Pl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_21.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_21.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lb;</hi> socha et sacha <hi rend="italic">Db;</hi> saccam et socam <hi rend="italic">Hv;</hi> sacham et sokam (socham <hi rend="italic">S</hi>) <hi rend="italic">Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Lb; socha et sacha Db; saccam et socam Hv; sacham et sokam (socham S) Pl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_21.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">statt</hi> et—serui. <hi rend="italic">nur</hi> etc. <hi rend="italic">Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">instead of et—serui. only etc. Db</seg></note>
