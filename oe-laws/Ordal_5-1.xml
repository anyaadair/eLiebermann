    <body>
      <div type="clause" n="5.1">
        <head><ref type="lawCode" target="law:Ordal">Ordal</ref> 5.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.1"><pb n="387" ed="#liebermann"/>….</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.1" corresp="#wit-q"><pb n="387" ed="#liebermann"/>Novem pedes mensurati distinguantur in<ptr type="liebermannNote" n="10" target="#Ordal_5-1.lnote.oe.10"/> ter ternos<ptr type="liebermannNote" n="11" target="#Ordal_5-1.lnote.oe.11"/>: in primo signo iuxta<ptr type="liebermannNote" n="7" target="#Ordal_5-1.lnote.oe.7"/>(secus) stacam<ptr type="liebermannNote" n="*" target="#Ordal_5-1.lnote.oe.star"/><ptr type="liebermannNote" n="12" target="#Ordal_5-1.lnote.oe.12"/> teneat pedem (suum<ptr type="liebermannNote" n="2" target="#Ordal_5-1.lnote.oe.2"/>) dextrum, in secundo<ptr type="liebermannNote" n="13" target="#Ordal_5-1.lnote.oe.13"/> sinistrum<ptr type="liebermannNote" n="14" target="#Ordal_5-1.lnote.oe.14"/>; inde<ptr type="liebermannNote" n="15" target="#Ordal_5-1.lnote.oe.15"/> transferat<ptr type="liebermannNote" n="16" target="#Ordal_5-1.lnote.oe.16"/> dextrum pedem in tertium signum, cum<ptr type="liebermannNote" n="7" target="#Ordal_5-1.lnote.oe.7"/> ferrum proicitur (quando f. proiciet), et ad sanctum altare festinet<ptr type="liebermannNote" n="17" target="#Ordal_5-1.lnote.oe.17"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-h">[….]</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="387" ed="#liebermann"/>(Die 9 gemessenen Fuss sollen in dreimal drei<ptr type="liebermannNote" n="1" target="#Ordal_5-1.lnote.de.1"/> geschieden werden: auf dem ersten Zeichen neben dem(?) Pfahl<ptr type="liebermannNote" n="2" target="#Ordal_5-1.lnote.de.2"/> halte [der Ordalleister] seinen rechten Fuss, auf dem zweiten den linken; dann setze er den rechten Fuss aufs dritte Zeichen hinüber, indem er das Eisen fortwirft<ptr type="liebermannNote" n="3" target="#Ordal_5-1.lnote.de.3"/>, und eile zum heiligen Altar <hi rend="italic">fehlt H</hi>).</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">(Let the 9 measured feet be divided into three times three: on the first mark beside the(?) stake let [the one undergoing the ordeal] keep his right foot, on the second his left; then let him move his right foot across onto the third mark, as he throws the iron away, and hasten to the holy altar — lacking in H).</ab>
        <note type="editorial">This clause is entirely lacking in H; Liebermann supplies it from the Quadripartitus (printed in bold). Column K is therefore only a gap marker.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_5-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de">inter <hi rend="italic">Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">inter MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_5-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de">terminos <hi rend="italic">KMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">terminos KMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_5-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond; eingeklammertes übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">what precedes the bracket Lond; what is bracketed the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_5-1.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de">þam stacan <hi rend="italic">las wohl Or. wie</hi> 1a; <hi rend="italic">vgl.</hi> 4, 2*</seg><seg type="translation" xml:lang="en" source="#claude">Or. probably read þam stacan, as in 1a; cf. 4, 2*</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_5-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de">stakam <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">stakam T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_5-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_5-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de">-dum <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dum Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_5-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt RT</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in RT</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_5-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt RMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in RMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_5-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de">t. d. <hi rend="italic">fehlt MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. d. lacking in MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_5-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de">sustinet <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">sustinet Or</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ordal_5-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">227</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">In tres terminos</hi> ‘in 3 Grenzlinien’ verstanden vielleicht die Abschreiber Q's</seg><seg type="translation" xml:lang="en" source="#claude">Q's copyists perhaps understood <hi rend="italic">In tres terminos</hi> as ‘in 3 boundary lines’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ordal_5-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">227</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. 1a³. 4, 2³</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 1a³. 4, 2³</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ordal_5-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">227</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Eisenordal 9e.—Am Altar wird der Priester die Hand versiegeln</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Eisenordal 9e.—The priest will seal the hand at the altar</seg></note>
      </div>
    </body>
