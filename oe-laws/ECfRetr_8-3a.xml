        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-3a.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">aut <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">aut Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-3a.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">non erat nisi una [<hi rend="italic">aus</hi> ECf] <hi rend="italic">Cc</hi></seg><seg type="translation" xml:lang="en" source="#claude">non erat nisi una [from ECf] Cc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-3a.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">endet Cc Mem</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cc Mem end here</seg></note>
