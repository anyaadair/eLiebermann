    <body>
      <div type="clause" n="29">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 29</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 29" corresp="#wit-lat"><ptr type="liebermannNote" n="1" target="#Hn_29.lnote.oe.1"/><pb n="563" ed="#liebermann"/>Qui debeant<ptr type="liebermannNote" n="2" target="#Hn_29.lnote.oe.2"/> esse iudices<ptr type="liebermannNote" n="a" target="#Hn_29.lnote.oe.a"/> regis.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 563 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">Urtheilsfinder für den Iustitiam regis (29, 1<hi rend="italic">b</hi>) sind die vollfreien Grundeigner (<hi rend="italic">vgl.</hi> 9, 9) je in der Grafschaft, wo das Gericht sitzt</seg><seg type="translation" xml:lang="en" source="#claude">The doomsmen for the Iustitiam regis (29, 1<hi rend="italic">b</hi>) are the fully free landowners (cf. 9, 9) in each case in the shire where the court sits</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">C. XXX <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">C. XXX Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">r. i. e. d. <hi rend="italic">Lond;</hi> debent, <hi rend="italic">gegen Hss., Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. i. e. d. Lond; debent, against MSS, edd.</seg></note>
      </div>
