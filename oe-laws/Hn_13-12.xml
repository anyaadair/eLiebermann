        <note type="liebermannNote" subtype="textual" xml:id="Hn_13-12.lnote.oe.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">o. q. <hi rend="italic">doppelt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">o. q. twice Sc</seg></note>
