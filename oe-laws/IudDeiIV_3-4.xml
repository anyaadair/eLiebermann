      <div type="clause" n="3.4">
        <head><ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 3.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 3.4" corresp="#wit-du"><pb n="410" ed="#liebermann"/>ne respicias peccata nostra in hac oratione, sed tu<ptr type="liebermannNote" n="16" target="#IudDeiIV_3-4.lnote.oe.16"/> uerum et sanctum iudicium coram omnibus in hoc manifestare digneris,</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei IV 3.4" corresp="#wit-gl"><pb n="410" ed="#liebermann"/>ðy læs eft ðu bisii synno us<hi rend="italic">ra</hi> on ðas<hi rend="italic">sum</hi> gibede, ah ðu soð ⁊ halig' dom bif<hi rend="italic">or</hi>a allvm on ðas<hi rend="italic">sum</hi> <hi rend="italic">uel<ptr type="liebermannNote" n="17" target="#IudDeiIV_3-4.lnote.oe.17"/></hi> in ðis<hi rend="italic">sum</hi> ædeava ðu g[i]meodv<hi rend="italic">m<ptr type="liebermannNote" n="18" target="#IudDeiIV_3-4.lnote.oe.18"/></hi>,</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 410 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-4.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">tuum <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">tuum Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-4.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Gloss. bessert hier nicht den Sinn, sondern Grammatik</hi></seg><seg type="translation" xml:lang="en" source="#claude">the glossator here corrects not the sense but the grammar</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-4.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">gmeodũ <hi rend="italic">Du;</hi> gimeodum <hi rend="italic">bessert Skeat</hi> *69</seg><seg type="translation" xml:lang="en" source="#claude">gmeodũ Du; Skeat emends to gimeodum *69</seg></note>
      </div>
