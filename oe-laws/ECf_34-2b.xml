      <div type="clause" n="34.2b">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 34.2b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 34.2b"><pb n="662" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_34-2b.lnote.oe.erkl-clause"/><ptr type="liebermannNote" n="20" target="#ECf_34-2b.lnote.la.20"/>Post <ptr type="liebermannNote" n="21" target="#ECf_34-2b.lnote.la.21"/>Ædelredum<ptr type="liebermannNote" n="22" target="#ECf_34-2b.lnote.la.22"/> filius eius Eadmundus<ptr type="liebermannNote" n="***" target="#ECf_34-2b.lnote.la.ststst"/> IX<ptr type="liebermannNote" n="23" target="#ECf_34-2b.lnote.la.23"/> fere<ptr type="liebermannNote" n="g" target="#ECf_34-2b.lnote.la.fn.g"/> mensibus* regnauit, in quibus uiriliter quinquies<ptr type="liebermannNote" n="h" target="#ECf_34-2b.lnote.la.fn.h"/> contra Danorum regem Chnutum<ptr type="liebermannNote" n="24" target="#ECf_34-2b.lnote.la.24"/> dimicauit. Peracto uero<ptr type="liebermannNote" n="25" target="#ECf_34-2b.lnote.la.25"/> ultimo bello, concordiam inter se fecerunt regnumque<ptr type="liebermannNote" n="26" target="#ECf_34-2b.lnote.la.26"/> Anglie diuise<pb n="663" ed="#liebermann"/>runt<ptr type="liebermannNote" n="1" target="#ECf_34-2b.lnote.la.1"/>: dimidium Chnuto<ptr type="liebermannNote" n="2" target="#ECf_34-2b.lnote.la.2"/> et dimidium Eadmundo<ptr type="liebermannNote" n="3" target="#ECf_34-2b.lnote.la.3"/>, ea conditione<ptr type="liebermannNote" n="4" target="#ECf_34-2b.lnote.la.4"/>, ut<ptr type="liebermannNote" n="5" target="#ECf_34-2b.lnote.la.5"/>, si<ptr type="liebermannNote" n="a" target="#ECf_34-2b.lnote.la.fn.a"/> quis eorum superuiueret, alius<ptr type="liebermannNote" n="6" target="#ECf_34-2b.lnote.la.6"/> totum possideret, nec<ptr type="liebermannNote" n="b" target="#ECf_34-2b.lnote.la.fn.b"/> interim aliquis eorum coronaretur. Sed hac<ptr type="liebermannNote" n="7" target="#ECf_34-2b.lnote.la.7"/> conuentione, cunctis primatibus<ptr type="liebermannNote" n="8" target="#ECf_34-2b.lnote.la.8"/> Anglie consentientibus, firmata<ptr type="liebermannNote" n="9" target="#ECf_34-2b.lnote.la.9"/>, post<ptr type="liebermannNote" n="10" target="#ECf_34-2b.lnote.la.10"/> primum<ptr type="liebermannNote" n="a" target="#ECf_34-2b.lnote.la.fn.a"/> mensem Eadmundus ex hac luce, pro<ptr type="liebermannNote" n="11" target="#ECf_34-2b.lnote.la.11"/> dolor, subtrahitur.</ab>
        <note type="comparison" source="#liebermann" n="662"><label>printed alongside</label> <ref target="clause:ECfRetr_34-2b">ECf retr 34.2b</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 662–663 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann prints a small raised asterisk after “mensibus” (not one of his starred notes) and gives in the outer margin of the ECf retr column the date 1016.</note>
        <note type="editorial">Liebermann’s numbering of the notes in the ECf column starts again at 1 on p. 663: the notes 1–11 are on p. 663, the notes 20–26 on p. 662.</note>
        <note type="editorial">Liebermann puts his note a both after “si” and after “primum”.</note>
        <note type="editorial">The notes (***) are printed across the whole page; given with both columns.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2b.lnote.la.ststst" n="***" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">cui cognomen erat Hirenside, id est Latus ferreum <hi rend="italic">fügt zu Pl S;</hi> Irenes. hoc est L. f. <hi rend="italic">fügt zu Lond; beide vielleicht aus Will. Malm.</hi> II 179</seg><seg type="translation" xml:lang="en" source="#claude">Pl S add cui cognomen erat Hirenside, id est Latus ferreum; Lond adds Irenes. hoc est L. f.; both perhaps from Will. Malm. II 179</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2b.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">9 <hi rend="italic">Monat</hi>, 1 <hi rend="italic">Woche</hi></seg><seg type="translation" xml:lang="en" source="#claude">9 months, 1 week</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2b.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fünf Kämpfe zählt auch</hi> Annal. Anglosax.</seg><seg type="translation" xml:lang="en" source="#claude">the Annal. Anglosax. also count five battles</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2b.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ob richtig?</hi></seg><seg type="translation" xml:lang="en" source="#claude">correct?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2b.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">anders</hi> Flor. Wigorn.</seg><seg type="translation" xml:lang="en" source="#claude">differently Flor. Wigorn.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2b.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">Regnum Eadmundi [Ed. <hi rend="italic">S</hi>] Hireneside [Hyrn. <hi rend="italic">Pl</hi>], filii [<hi rend="italic">fehlt Pl</hi>] Ældredi regis [<hi rend="italic">fehlt S</hi>] <hi rend="italic">überschr. Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">heading in Pl S: Regnum Eadmundi [Ed. S] Hireneside [Hyrn. Pl], filii [lacking in Pl] Ældredi regis [lacking in S]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2b.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">hunc <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hk adds hunc</seg></note>
