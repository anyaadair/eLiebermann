    <body>
      <div type="clause" n="7.7">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 7.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 7.7" corresp="#wit-lat"><pb n="553" ed="#liebermann"/>Si quis baronum regis uel aliorum comitatui<ptr type="liebermannNote" n="x" target="#Hn_7-7.lnote.oe.x"/> secundum legem interfuerit, totam terram, quam illic in dominio<ptr type="liebermannNote" n="y" target="#Hn_7-7.lnote.oe.y"/><ptr type="liebermannNote" n="43" target="#Hn_7-7.lnote.oe.43"/> suo habet, acquietare poterit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 553 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-7.lnote.oe.x" n="x" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch</hi> hundreto 7, 8</seg><seg type="translation" xml:lang="en" source="#claude">also hundreto 7, 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-7.lnote.oe.y" n="y" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier nicht bloss</hi> unausgeliehenes Land, <hi rend="italic">sondern</hi> Herrschaft überhaupt mitsammt Bauerndorf, <hi rend="italic">laut</hi> 7, 7<hi rend="italic">b. Vgl. Maitland</hi> Select pleas man. I <hi rend="italic">p.</hi> xxxiij</seg><seg type="translation" xml:lang="en" source="#claude">here not merely land not granted out, but the lordship as a whole together with the peasant village, according to 7, 7b. Cf. Maitland Select pleas man. I p. xxxiij</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-7.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">-nico <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nico Lond</seg></note>
      </div>
    </body>
