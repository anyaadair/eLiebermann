      <div type="clause" n="8.6">
        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 8.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 8.6" corresp="#wit-lat"><ptr type="liebermannNote" n="10" target="#LibLond_8-6.lnote.oe.10"/><pb n="675" ed="#liebermann"/>Mercator itaque<ptr type="liebermannNote" n="11" target="#LibLond_8-6.lnote.oe.11"/> foranus<ptr type="liebermannNote" n="12" target="#LibLond_8-6.lnote.oe.12"/> nequit<ptr type="liebermannNote" n="13" target="#LibLond_8-6.lnote.oe.13"/> madidum<ptr type="liebermannNote" n="l" target="#LibLond_8-6.lnote.oe.l"/><ptr type="liebermannNote" n="14" target="#LibLond_8-6.lnote.oe.14"/> pannum emere uel tincturam<ptr type="liebermannNote" n="m" target="#LibLond_8-6.lnote.oe.m"/> in<ptr type="liebermannNote" n="n" target="#LibLond_8-6.lnote.oe.n"/> urbe facere uel<ptr type="liebermannNote" n="15" target="#LibLond_8-6.lnote.oe.15"/> operam aliquam quod<ptr type="liebermannNote" n="16" target="#LibLond_8-6.lnote.oe.16"/> ad ciues pertinet<ptr type="liebermannNote" n="17" target="#LibLond_8-6.lnote.oe.17"/> operari.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 675 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-6.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">nul telier ne fuloun ne puet drap secchir ne teindre; Munim. Gildh. <hi rend="italic">ed. Riley</hi> II 130. <hi rend="italic">Das Gewerbe auch des Trockenpressens</hi> (<hi rend="italic">vgl. To. Smith</hi> Engl. gilds 180. 351 <hi rend="italic">f.</hi>; <hi rend="italic">Bateson</hi> Leicester I 89 <hi rend="italic">f.</hi>) <hi rend="italic">soll der Fremde dem Londoner nicht fortnehmen</hi></seg><seg type="translation" xml:lang="en" source="#claude">nul telier ne fuloun ne puet drap secchir ne teindre; Munim. Gildh. ed. Riley II 130. The foreigner is not to take from the Londoner the trade of dry-pressing either (cf. To. Smith Engl. gilds 180. 351 f.; Bateson Leicester I 89 f.)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-6.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">neque possunt de pannis quos ferunt uel emerint tincturam facere; <hi rend="italic">Londoner Recht vor</hi> 1215 <hi rend="italic">ed. Bateson</hi> 725</seg><seg type="translation" xml:lang="en" source="#claude">neque possunt de pannis quos ferunt uel emerint tincturam facere; London law before 1215 ed. Bateson 725</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-6.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">in u. <hi rend="italic">fehlt Douai</hi></seg><seg type="translation" xml:lang="en" source="#claude">in u. omitted in Douai</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-6.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">Item <hi rend="italic">überschr. Pl Douai</hi></seg><seg type="translation" xml:lang="en" source="#claude">Item as heading Pl Douai</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-6.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">ita <hi rend="italic">Horn; fehlt Cons Douai Ord</hi></seg><seg type="translation" xml:lang="en" source="#claude">ita Horn; omitted in Cons Douai Ord</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-6.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">-neus <hi rend="italic">Horn Cons Douai;</hi> extraneus <hi rend="italic">Alb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-neus Horn Cons Douai; extraneus Alb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-6.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">-id <hi rend="italic">Ai</hi></seg><seg type="translation" xml:lang="en" source="#claude">-id Ai</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-6.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">p. m. <hi rend="italic">PlS;</hi> moiste drap <hi rend="italic">Ord</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. m. PlS; moiste drap Ord</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-6.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">nec opus aliquod <hi rend="italic">Horn Alb;</hi> opera aliqua <hi rend="italic">Cons Douai</hi></seg><seg type="translation" xml:lang="en" source="#claude">nec opus aliquod Horn Alb; opera aliqua Cons Douai</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-6.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">que <hi rend="italic">PlS Cons Douai</hi></seg><seg type="translation" xml:lang="en" source="#claude">que PlS Cons Douai</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-6.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">-neat <hi rend="italic">PlS Cons;</hi> o. p. <hi rend="italic">S;</hi> -nent <hi rend="italic">Douai</hi></seg><seg type="translation" xml:lang="en" source="#claude">-neat PlS Cons; o. p. S; -nent Douai</seg></note>
      </div>
