      <div type="clause" n="3.2">
        <head><ref type="lawCode" target="law:IIIAtr">III Atr</ref> 3.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.2" corresp="#wit-h"><pb n="228" ed="#liebermann"/>⁊ niman þonne þa tihtbysian men, þe mid þam gerefan<ptr type="liebermannNote" n="7" target="#IIIAtr_3-2.lnote.oe.7"/> habbað, ⁊ heora ælc sylle VI healfmarc wedd, healf landrícan ⁊ healf wǽpentake.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3.2" corresp="#wit-q"><pb n="228" ed="#liebermann"/>Et capiantur<ptr type="liebermannNote" n="21" target="#IIIAtr_3-2.lnote.oe.21"/> accusati, qui cum preposito<ptr type="liebermannNote" n="22" target="#IIIAtr_3-2.lnote.oe.22"/> causam habent, et omnis eorum det VI dimidias marcas uadii, dimidium domino ipsius terre, dimidium wapentako.<ptr type="liebermannNote" n="23" target="#IIIAtr_3-2.lnote.oe.23"/></ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="3.2" corresp="#wit-h"><pb n="66" ed="#robertson"/>⁊ niman þonne þa tihtbysian men þe mid þam gerefan [sace]<ptr type="editorNote" n="1" target="#IIIAtr_3-2.robnote.fn.1"/> habbað, ⁊ heora ælc sylle VI healfmarc wedd, healf landrícan ⁊ healf wǽpentake.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="229" ed="#liebermann"/>und sie sollen ferner die bescholtenen Leute, die bei<ptr type="liebermannNote" n="1" target="#IIIAtr_3-2.lnote.de.1"/> dem [gerichtsherrlichen] Vogte [eine Strafsache<ptr type="liebermannNote" n="2" target="#IIIAtr_3-2.lnote.de.2"/> hängen] haben, greifen<ptr type="liebermannNote" n="3" target="#IIIAtr_3-2.lnote.de.3"/>, und deren jeder zahle<ptr type="liebermannNote" n="4" target="#IIIAtr_3-2.lnote.de.4"/> 6 Halbmark<ptr type="liebermannNote" n="5" target="#IIIAtr_3-2.lnote.de.5"/> Pfand, halb<ptr type="liebermannNote" n="6" target="#IIIAtr_3-2.lnote.de.6"/> dem Immunitätsherrn und halb dem Wapentake.<ptr type="liebermannNote" n="7" target="#IIIAtr_3-2.lnote.de.7"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">and they are further to seize the men of bad repute who have [a case pending] with the [lord's] reeve, and let each of them give 6 half-marks as pledge, half to the lord of the immunity and half to the wapentake.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-h"><pb n="67" ed="#robertson"/>And then they shall arrest those men of bad repute against whom the reeve is taking proceedings<ptr type="editorNote" n="1" target="#IIIAtr_3-2.robnote.n.1"/>, and each of them shall pay six half marks<ptr type="editorNote" n="2" target="#IIIAtr_3-2.robnote.n.2"/> as security, half to the lord of the manor and half to the wapentake<ptr type="editorNote" n="3" target="#IIIAtr_3-2.robnote.n.3"/>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h"><pb n="445" ed="#whitelock"/>And they are then to seize the men who have frequently been accused, against whom the reeve is taking proceedings,<ptr type="editorNote" n="8" target="#IIIAtr_3-2.whinote.n.8"/> and each of them is to pay six half marks as pledge, half to the lord of the estate and half to the wapentake.</ab>
        <note type="editorial">Editors supply ‘sace’ after ‘gerefan’ in H from Quadr.'s ‘causam’.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAtr_3-2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">228</biblScope></bibl><seg type="original" xml:lang="de">capiatur <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">capiatur <hi rend="italic">R</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAtr_3-2.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">228</biblScope></bibl><seg type="original" xml:lang="de">posito <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">posito <hi rend="italic">MHk</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAtr_3-2.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">228</biblScope></bibl><seg type="original" xml:lang="de">-aco <hi rend="italic">M</hi></seg><seg type="translation" xml:lang="en" source="#claude">-aco <hi rend="italic">M</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAtr_3-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">228</biblScope></bibl><seg type="original" xml:lang="de">sace <hi rend="italic">ergänzen Edd., aus</hi> causam <hi rend="italic">des Quadr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">sace supplied by edd., from causam of the Quadr.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIIAtr_3-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">159</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Wb: mid</hi> 8 = <hi rend="italic">wið</hi> 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Wb: mid</hi> 8 = <hi rend="italic">wið</hi> 4</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIIAtr_3-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">159</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">sace hym betweonan heoldan</hi> ‘Streitsache untereinander hätten’; Urk. c. 1050, Thorpe <hi rend="italic">Dipl</hi>. 377</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">sace hym betweonan heoldan</hi> ‘had a dispute between them’; charter c. 1050, Thorpe <hi rend="italic">Dipl</hi>. 377</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIIAtr_3-2.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">159</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘verhaften, fangen’; <hi rend="italic">s. Wb: niman</hi> 4; Toller</seg><seg type="translation" xml:lang="en" source="#claude">‘arrest, seize’; <hi rend="italic">see Wb: niman</hi> 4; Toller</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIIAtr_3-2.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">159</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Pfändung 3. Rein Agsä. Gesetze fordern dafür Bürgschaft; <hi rend="italic">s. d. Gl</hi> 6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Pfändung 3. Purely Anglo-Saxon laws require surety for this; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 6</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIIAtr_3-2.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">159</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. 1, 2²</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 1, 2²</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIIAtr_3-2.lnote.de.6" n="6" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">159</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Dieselbe Halbteilung <hi rend="italic">s</hi>. Gerichtsbarkeit 20a-h. Aus den Parallelen geht hervor, dass Maitland <hi rend="italic">Domesday</hi> 287 den Herrn für den Gerichtsherrn dieses Wapentake mit Unrecht hält: es ist vielmehr der Grundherr des Bescholtenen</seg><seg type="translation" xml:lang="en" source="#claude">For the same division into halves <hi rend="italic">see</hi> Gerichtsbarkeit 20a-h. It follows from the parallels that Maitland <hi rend="italic">Domesday</hi> 287 wrongly takes the lord to be the holder of jurisdiction of this wapentake: he is rather the landlord of the man of ill repute</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIIAtr_3-2.lnote.de.7" n="7" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">159</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Das Wapentake (<hi rend="italic">s. d. Gl</hi> 7) hat also eigene Einnahmen, wie das Hundred; <hi rend="italic">s. d. Gl</hi> 18—19; doch ist darunter nach 7 nur der Gerichtsherr desselben, d. i. nominell der König, tatsächlich dessen Vogt, zu verstehen. Der Sprengel steht für dessen Verwalter wie in Af 37, 1². VI As 8, 4</seg><seg type="translation" xml:lang="en" source="#claude">The wapentake (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 7) thus has revenues of its own, like the hundred; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 18—19; yet according to 7 this is to be understood only as its holder of jurisdiction, i.e. nominally the king, in practice his reeve. The district stands for its administrator, as in Af 37, 1². VI As 8, 4</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIAtr_3-2.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">qui cum preposito causam habent</hi>, Q.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIAtr_3-2.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="en">Cf. 1, 2; 12; 13, 2; 13, 4.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIAtr_3-2.robnote.n.3" n="3" source="#robertson"><bibl><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="en">Cf. III Edg. 7, 1.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAtr_3-2.robnote.fn.1" n="1" source="#robertson"><bibl><biblScope unit="page">66</biblScope></bibl><label>sace</label><seg type="original" xml:lang="en">Not in MS.; cf. <hi rend="italic">causam</hi> Q.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IIIAtr_3-2.whinote.n.8" n="8" source="#whitelock"><bibl><biblScope unit="page">445</biblScope></bibl><label>proceedings</label><seg type="original" xml:lang="en">The Old English text is corrupt here; this rendering (which is Miss Robert son’s) is based on <hi rend="italic">Quadripartitus</hi>.</seg></note>
      </div>
    </body>
