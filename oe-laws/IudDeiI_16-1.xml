        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 16.1" corresp="#wit-lat"><pb n="403" ed="#liebermann"/>Corpus hoc<ptr type="liebermannNote" n="80" target="#IudDeiI_16-1.lnote.oe.80"/> et sanguis<ptr type="liebermannNote" n="81" target="#IudDeiI_16-1.lnote.oe.81"/> domini nostri Iesu Christi sit uobis<ptr type="liebermannNote" n="82" target="#IudDeiI_16-1.lnote.oe.82"/> ad probationem hodie.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 403 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_16-1.lnote.oe.80" n="80" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_16-1.lnote.oe.81" n="81" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">-uinis <hi rend="italic">Ps</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uinis Ps</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_16-1.lnote.oe.82" n="82" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">tibi <hi rend="italic">übergeschr. Rj;</hi> uel tibi <hi rend="italic">übergeschr. H;</hi> tibi <hi rend="italic">Tr Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">tibi written above Rj; uel tibi written above H; tibi Tr Co</seg></note>
