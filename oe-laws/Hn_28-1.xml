      <div type="clause" n="28.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 28.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 28.1" corresp="#wit-lat"><pb n="562" ed="#liebermann"/>In omnibus agendis: inoffensus<ptr type="liebermannNote" n="34" target="#Hn_28-1.lnote.oe.34"/> esse<ptr type="liebermannNote" n="35" target="#Hn_28-1.lnote.oe.35"/> debet iudicum<ptr type="liebermannNote" n="n" target="#Hn_28-1.lnote.oe.n"/><ptr type="liebermannNote" n="36" target="#Hn_28-1.lnote.oe.36"/> affectus<ptr type="liebermannNote" n="37" target="#Hn_28-1.lnote.oe.37"/>, non suspectus:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 562 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_28-1.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">accusatorum et testium <hi rend="italic">Ps.-Isidor, auch Ivo; Gratian</hi> C. 3 q. 5 c. 2. <hi rend="italic">Auch</hi> 33, 5 <hi rend="italic">benutzt Verf. für die Auswahl der</hi> iudices <hi rend="italic">Kanonistik; vgl.</hi> 34. <hi rend="italic">Er deutet kanonistische Regeln auf andere Processpersonen um auch</hi> 32, 1<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">accusatorum et testium Ps.-Isidore, also Ivo; Gratian C. 3 q. 5 c. 2. In 33, 5 too the author uses canon law for the selection of the iudices; cf. 34. He also reinterprets canonical rules as applying to other persons in the proceedings in 32, 1<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_28-1.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert vom Corr. aus</hi> -sis <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the corrector from -sis Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_28-1.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">d. e. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. e. Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_28-1.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">-cium <hi rend="italic">Hss.; verbessert vom Corr. Sc; fehlt Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cium MSS; corrected by the corrector Sc; omitted Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_28-1.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de">a. n. s. <hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. n. s. omitted K Co Or Gi</seg></note>
      </div>
