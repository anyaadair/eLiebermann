        <note type="editorNote" subtype="footnote" xml:id="Af_34.attnote.fn.6" n="6" source="#attenborough"><bibl><biblScope unit="page">78</biblScope></bibl><label>gebrengen</label><seg type="original" xml:lang="en"><hi rend="italic">gebringe</hi>. H. <hi rend="italic">-an</hi>. B.</seg></note>
