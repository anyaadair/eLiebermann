        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-5.lnote.oe.1-4" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">334</biblScope></bibl><seg type="original" xml:lang="de">nase ⁊ earan ⁊ u. lippe oþþe h. hett. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">nase ⁊ earan ⁊ u. lippe oþþe h. hett. Ld</seg></note>
