        <head><ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 3.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 3.4" corresp="#wit-du" ana="#glossed"><pb n="410" ed="#liebermann"/><seg type="glossed"><seg type="base">ne</seg><gloss xml:lang="ang">ðy læs</gloss></seg> <seg type="glossed"><seg type="base">respicias</seg><gloss xml:lang="ang">eft ðu bisii</gloss></seg> <seg type="glossed"><seg type="base">peccata</seg><gloss xml:lang="ang">synno</gloss></seg> <seg type="glossed"><seg type="base">nostra</seg><gloss xml:lang="ang">us<hi rend="italic">ra</hi></gloss></seg> <seg type="glossed"><seg type="base">in</seg><gloss xml:lang="ang">on</gloss></seg> <seg type="glossed"><seg type="base">hac</seg><gloss xml:lang="ang">ðas<hi rend="italic">sum</hi></gloss></seg> <seg type="glossed"><seg type="base">oratione,</seg><gloss xml:lang="ang">gibede,</gloss></seg> <seg type="glossed"><seg type="base">sed</seg><gloss xml:lang="ang">ah</gloss></seg> <seg type="glossed"><seg type="base">tu<ptr type="liebermannNote" n="16" target="#IudDeiIV_3-4.lnote.oe.16"/></seg><gloss xml:lang="ang">ðu</gloss></seg> <seg type="glossed"><seg type="base">uerum</seg><gloss xml:lang="ang">soð</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">sanctum</seg><gloss xml:lang="ang">halig'</gloss></seg> <seg type="glossed"><seg type="base">iudicium</seg><gloss xml:lang="ang">dom</gloss></seg> <seg type="glossed"><seg type="base">coram</seg><gloss xml:lang="ang">bif<hi rend="italic">or</hi>a</gloss></seg> <seg type="glossed"><seg type="base">omnibus</seg><gloss xml:lang="ang">allvm</gloss></seg> <seg type="glossed"><seg type="base">in</seg><gloss xml:lang="ang">on</gloss></seg> <seg type="glossed"><seg type="base">hoc</seg><gloss xml:lang="ang">ðas<hi rend="italic">sum</hi> <hi rend="italic">uel<ptr type="liebermannNote" n="17" target="#IudDeiIV_3-4.lnote.oe.17"/></hi> in ðis<hi rend="italic">sum</hi></gloss></seg> <seg type="glossed"><seg type="base">manifestare</seg><gloss xml:lang="ang">ædeava</gloss></seg> <seg type="glossed"><seg type="base">digneris,</seg><gloss xml:lang="ang">ðu g[i]meodv<hi rend="italic">m<ptr type="liebermannNote" n="18" target="#IudDeiIV_3-4.lnote.oe.18"/></hi>,</gloss></seg></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 410 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-4.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">tuum <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">tuum Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-4.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Gloss. bessert hier nicht den Sinn, sondern Grammatik</hi></seg><seg type="translation" xml:lang="en" source="#claude">the glossator here corrects not the sense but the grammar</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-4.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">gmeodũ <hi rend="italic">Du;</hi> gimeodum <hi rend="italic">bessert Skeat</hi> *69</seg><seg type="translation" xml:lang="en" source="#claude">gmeodũ Du; Skeat emends to gimeodum *69</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-du">do not look upon our sins in this prayer, but deign to make manifest in this a true and holy judgment before all,</ab>
