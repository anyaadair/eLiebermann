    <body>
      <div type="clause" n="16.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 16.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 16.1" corresp="#wit-lat"><pb n="559" ed="#liebermann"/>Tam<ptr type="liebermannNote" n="33" target="#Hn_16-1.lnote.oe.33"/> longe debet esse pax regis a porta sua, ubi residens erit<ptr type="liebermannNote" n="34" target="#Hn_16-1.lnote.oe.34"/>, a quatuor partibus loci illius, hoc est: tria<ptr type="liebermannNote" n="35" target="#Hn_16-1.lnote.oe.35"/> miliaria et III quarentene et IX<ptr type="liebermannNote" n="g" target="#Hn_16-1.lnote.oe.g"/> acre latitudine et IX pedes et IX palme<ptr type="liebermannNote" n="e" target="#Hn_16-1.lnote.oe.e"/> et IX grana ordei.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 559 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_16-1.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Angelsächs. Text</hi></seg><seg type="translation" xml:lang="en" source="#claude">from the Anglo-Saxon text</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_16-1.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> III <hi rend="italic">aus Pax</hi></seg><seg type="translation" xml:lang="en" source="#claude">read III, from Pax</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_16-1.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">am, <hi rend="italic">davor roth</hi> N, <hi rend="italic">obwohl Texthand</hi> T <hi rend="italic">vorgeschrieben hatte, Sc;</hi> Nam <hi rend="italic">übr.;</hi> Tam <hi rend="italic">bessert Somner</hi></seg><seg type="translation" xml:lang="en" source="#claude">am, preceded by N in red, although the text hand had written T as a guide letter, Sc; Nam the others; Somner emends to Tam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_16-1.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">fuerit <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">fuerit Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_16-1.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">darüber Corr.</hi> IIII <hi rend="italic">Sc;</hi> IIII <hi rend="italic">Hg;</hi> quatuor <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">IIII written above by the corrector Sc; IIII Hg; quatuor the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_16-1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">319</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. S. 230{15}.—<hi rend="italic">Nam</hi>{33}—<hi rend="italic">fuerit</hi>{34}—<hi rend="italic">quatuor</hi>{35} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> p. 230{15}.—<hi rend="italic">Nam</hi>{33}—<hi rend="italic">fuerit</hi>{34}—<hi rend="italic">quatuor</hi>{35} Rs</seg></note>
      </div>
