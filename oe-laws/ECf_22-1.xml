    <body>
      <div type="clause" n="22.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 22.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 22.1"><pb n="647" ed="#liebermann"/>Sacha<ptr type="liebermannNote" n="24" target="#ECf_22-1.lnote.la.24"/>: quod, si aliquis aliquem nominatim de aliquo calumpniatus<ptr type="liebermannNote" n="25" target="#ECf_22-1.lnote.la.25"/> fuerit<ptr type="liebermannNote" n="26" target="#ECf_22-1.lnote.la.26"/>, et ipse negauerit, forisfactura<ptr type="liebermannNote" n="27" target="#ECf_22-1.lnote.la.27"/> probationis<ptr type="liebermannNote" n="d" target="#ECf_22-1.lnote.la.fn.d"/> uel negationis, si euenerit, sua erit<ptr type="liebermannNote" n="28" target="#ECf_22-1.lnote.la.28"/>.</ab>
        <note type="comparison" source="#liebermann" n="647"><label>printed alongside</label> <ref target="clause:ECfRetr_22-1">ECf retr 22.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 647 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “Sacha”, “si” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_22-1.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dann also nicht handhaftes Verbrechen, im Gegensatz zu</hi> infangene-þeof 22, 4</seg><seg type="translation" xml:lang="en" source="#claude">so then not a crime caught in the act, in contrast to infangene-þeof, 22, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-1.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">est <hi rend="italic">fügt zu Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad adds est</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-1.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">calumpniauerit <hi rend="italic">Ad Do Wo</hi></seg><seg type="translation" xml:lang="en" source="#claude">calumpniauerit Ad Do Wo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-1.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr adow</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr adow</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-1.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl;</hi> -ram <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl; -ram S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-1.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">erunt <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">erunt Hk</seg></note>
      </div>
    </body>
