  <text>
    <body>
      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:Iudex">Iudex</ref> 5</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5" corresp="#wit-g-a"><pb n="474" ed="#liebermann"/>Drihten cwæð: ‘Be ðam ylcan dome, ðe ge nú mannu<hi rend="italic">m</hi> demað, eow byð eft gedemed'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5" corresp="#wit-q"><pb n="474" ed="#liebermann"/>Dominus Iesus Christus<ptr type="liebermannNote" n="10" target="#Iudex_5.lnote.oe.10"/> dixit: ‘In<ptr type="liebermannNote" n="*" target="#Iudex_5.lnote.oe.star"/> quo iudicio iudicaueritis, iudicabimini’.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="474" ed="#liebermann"/>Der Herr sprach: ‘Nach<ptr type="liebermannNote" n="1" target="#Iudex_5.lnote.de.1"/> demselben Urtheilsspruche, den ihr jetzt Menschen ertheilet, wird später<ptr type="liebermannNote" n="†" target="#Iudex_5.lnote.de1.dagger"/> euch zuerkannt werden’.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">The Lord said: ‘By the same judgment that you now pass on men, judgment will later be passed on you’.</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-g-a">The Lord said: “By the same judgement that you now judge a man, so you will hereafter be judged.”</ab>
        <note type="passageSource">Matthew 7:2</note>
        <note type="comparison" source="#liebermann" n="474">Matth. 7, 2</note>
        <note type="comparisonPrinted" source="#liebermann">Matth. 7, 2</note>
        <note type="editorial">U: translator unrecorded: check</note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_5.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">474</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt THkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in THkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_5.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">474</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">klein Gedrucktes aus Vulgata</hi></seg><seg type="translation" xml:lang="en" source="#claude">the small print is from the Vulgate</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Iudex_5.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">269</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">þam ylcan dome þe ge demað, eow byð gedémed</hi> Agsä. Evangelienübs.—Auch Episc. 14 und die Synode, <hi rend="italic">o</hi>. Einl. 4, benutzt diesen Spruch des Matthäus; <hi rend="italic">s. d. Gl</hi> 1; Moral 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">þam ylcan dome þe ge demað, eow byð gedémed</hi> Anglo-Saxon translation of the Gospels.—Episc. 14 and the Synod, <hi rend="italic">above</hi> Introduction 4, also use this saying of Matthew; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1; Moral 4</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="Iudex_5.lnote.de1.dagger" n="†" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">474</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 6 <hi rend="italic">f.</hi> 10. 12</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 6 f. 10. 12</seg></note>
      </div>
