    <body>
      <div type="clause" n="76.7c">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 76.7c</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 76.7c" corresp="#wit-lat"><pb n="594" ed="#liebermann"/>Inde ad XXI. diem<ptr type="liebermannNote" n="1" target="#Hn_76-7c.lnote.oe.1"/> reddatur (ipsius<ptr type="liebermannNote" n="2" target="#Hn_76-7c.lnote.oe.2"/>) manbota; tunc ad XXI. diem fyhtƿita<ptr type="liebermannNote" n="3" target="#Hn_76-7c.lnote.oe.3"/>; inde ad XXI. diem reddatur ipsius<ptr type="liebermannNote" n="4" target="#Hn_76-7c.lnote.oe.4"/> were frumgildum<ptr type="liebermannNote" n="5" target="#Hn_76-7c.lnote.oe.5"/>, id est VII sol. et<ptr type="liebermannNote" n="6" target="#Hn_76-7c.lnote.oe.6"/> VI den. ad expletionem XX<ptr type="liebermannNote" n="a" target="#Hn_76-7c.lnote.oe.a"/> sol.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 594 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-7c.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Halsfang</hi> (12½)+7½ = 20 <hi rend="italic">Schilling = erstes Pfund</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Halsfang</hi> (12½)+7½ = 20 <hi rend="italic">shillings = first pound</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-7c.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-7c.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-7c.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de">fuytyhita <hi rend="italic">Sc Hg;</hi> sutƿita <hi rend="italic">K Co;</hi> sutwita <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">fuytyhita <hi rend="italic">Sc Hg;</hi> sutƿita <hi rend="italic">K Co;</hi> sutwita <hi rend="italic">Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-7c.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de">ipsi <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">ipsi <hi rend="italic">Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-7c.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de">fruug. <hi rend="italic">Sc;</hi> frimg. <hi rend="italic">Hg;</hi> freuimg. <hi rend="italic">K;</hi> freming. <hi rend="italic">Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">fruug. <hi rend="italic">Sc;</hi> frimg. <hi rend="italic">Hg;</hi> freuimg. <hi rend="italic">K;</hi> freming. <hi rend="italic">Co Or Gi</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-7c.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">Thence on the XXIst day let (his) manbot be paid; then on the XXIst day the <hi rend="italic">fyhtwita</hi>; thence on the XXIst day let the <hi rend="italic">frumgild</hi> (first payment) of the wergild itself be paid, that is, VII shillings and VI pence, to make up XX shillings.</ab>
      </div>
    </body>
