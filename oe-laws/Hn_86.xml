        <note type="liebermannNote" subtype="textual" xml:id="Hn_86.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hg;</hi> uindicetur <hi rend="italic">Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Hg; uindicetur edd.</seg></note>
