        <note type="comparisonPrinted" source="#liebermann">I Cor. 5, 1</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 432 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_8.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de">a <hi rend="italic">mehrere Reg-Hss. Vb;</hi> ex <hi rend="italic">Vulg.</hi></seg><seg type="translation" xml:lang="en" source="#claude">a several Reg MSS, Vb; ex Vulg.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_8.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de">uobis <hi rend="italic">statt</hi> m. u. <hi rend="italic">Vulg. Reg Vb;</hi> ex uobis <hi rend="italic">auch Reg</hi> 414</seg><seg type="translation" xml:lang="en" source="#claude">uobis instead of m. u. Vulg. Reg Vb; ex uobis also Reg 414</seg></note>
