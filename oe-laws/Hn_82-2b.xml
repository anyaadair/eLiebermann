        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 82.2b" corresp="#wit-lat"><pb n="598" ed="#liebermann"/>Et hiis omnibus habundantiori formidine<ptr type="liebermannNote" n="7" target="#Hn_82-2b.lnote.oe.7"/> refectum est, an<ptr type="liebermannNote" n="ss" target="#Hn_82-2b.lnote.oe.ss"/> de parentum uel amicorum<ptr type="liebermannNote" n="t" target="#Hn_82-2b.lnote.oe.t"/> interfeccione uel dampnis<ptr type="liebermannNote" n="40" target="#Hn_82-2b.lnote.oe.40"/> corporalibus uel peccunialibus actitetur<ptr type="liebermannNote" n="41" target="#Hn_82-2b.lnote.oe.41"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 598 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2b.lnote.oe.ss" n="ss" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">falls</seg><seg type="translation" xml:lang="en" source="#claude">in case</seg></note>
