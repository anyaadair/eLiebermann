      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:IudDeiXIV">Iud Dei XIV</ref> 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIV 2" corresp="#wit-lat"><pb n="425" ed="#liebermann"/>(Benedictio<ptr type="liebermannNote" n="22" target="#IudDeiXIV_2.lnote.oe.22"/> panis et casei.) Domine<ptr type="liebermannNote" n="23" target="#IudDeiXIV_2.lnote.oe.23"/> sancte, Pater omnipotens, aeterne Deus, qui es inuisibilis omnium rerum creator spiritaliumque<ptr type="liebermannNote" n="24" target="#IudDeiXIV_2.lnote.oe.24"/> remunerator, qui et archana prospicis et cuncta cognoscis, qui<ptr type="liebermannNote" n="25" target="#IudDeiXIV_2.lnote.oe.25"/> scrutaris corda et renes, deprecor<ptr type="liebermannNote" n="26" target="#IudDeiXIV_2.lnote.oe.26"/> te, ut exaudias uerba deprecationis meae, ut qui hoc furtum commisit<ptr type="liebermannNote" n="27" target="#IudDeiXIV_2.lnote.oe.27"/>, panem uel<ptr type="liebermannNote" n="28" target="#IudDeiXIV_2.lnote.oe.28"/> caseum hunc fauces eius gluttire<ptr type="liebermannNote" n="29" target="#IudDeiXIV_2.lnote.oe.29"/> non permittas. Qui uenturus<ptr type="liebermannNote" n="30" target="#IudDeiXIV_2.lnote.oe.30"/> est.</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Ps. 7, 10; 2 Tim. 4, 1</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 425 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_2.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">B. p. et c. <hi rend="italic">nur Mg Bb;</hi> Oremus. Oratio <hi rend="italic">Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">B. p. et c. only Mg Bb; Oremus. Oratio Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_2.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ähnlich Zeumer</hi> 629 <hi rend="italic">f.</hi> 632. 646. 665. 669 <hi rend="italic">f.</hi> 687 <hi rend="italic">f.</hi> 690. 692</seg><seg type="translation" xml:lang="en" source="#claude">similarly Zeumer 629 f. 632. 646. 665. 669 f. 687 f. 690. 692</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_2.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">rerum <hi rend="italic">fügt zu Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">rerum added in Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_2.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">cuncta <hi rend="italic">fügt zu Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">cuncta added in Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_2.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">te d. <hi rend="italic">Bb</hi></seg><seg type="translation" xml:lang="en" source="#claude">te d. Bb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_2.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">-erunt <hi rend="italic">und so Plural oft übergeschr. Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-erunt, and the plural likewise often written above, Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_2.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Vt</hi> (<hi rend="italic">2 lass ich fort</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">et Vt (I omit 2)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_2.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">glutire <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">glutire Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_2.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">statt</hi> u. e. <hi rend="italic">nur</hi> Per <hi rend="italic">Bb;</hi> uiuis et regnas <hi rend="italic">Vt; fehlt Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">instead of u. e. only Per Bb; uiuis et regnas Vt; omitted in Mg</seg></note>
      </div>
