      <div type="clause" n="36.2[a]">
        <head><ref type="lawCode" target="law:Af">Af</ref> 36.2[a]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.2[a]" corresp="#wit-e"><pb n="70" ed="#liebermann"/>gif se ord sie<ptr type="liebermannNote" n="5" target="#Af_36-2-a.lnote.oe.5"/> ufor<ptr type="liebermannNote" n="*" target="#Af_36-2-a.lnote.oe.star"/> þonne hindeweard<ptr type="liebermannNote" n="6" target="#Af_36-2-a.lnote.oe.6"/> sceaft.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.2[a]" corresp="#wit-h"><pb n="70" ed="#liebermann"/>gif se ord sy<ptr type="liebermannNote" n="2" target="#Af_36-2-a.lnote.oe.2"/> þreo<ptr type="liebermannNote" n="3" target="#Af_36-2-a.lnote.oe.3"/> fingre ufor<ptr type="liebermannNote" n="4" target="#Af_36-2-a.lnote.oe.4"/> þonne hindeweard sceaft.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.2[a]" corresp="#wit-b-no-prol"><pb n="70" ed="#liebermann"/>gyf se ord [si<ptr type="liebermannNote" n="3" target="#Af_36-2-a.lnote.oe.3-2"/>] ufor ðonne hindeweard sceaft. [Ac<ptr type="liebermannNote" n="4" target="#Af_36-2-a.lnote.oe.4-3"/>] gyf hi syn buta gelice, ord ⁊ hindeweard sceaft, þ<hi rend="italic">æt</hi> sy butan pleo.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="36.2[a]" corresp="#wit-q"><pb n="71" ed="#liebermann"/>si acutum<ptr type="liebermannNote" n="4" target="#Af_36-2-a.lnote.oe.4-2"/> lancee sit<ptr type="liebermannNote" n="5" target="#Af_36-2-a.lnote.oe.5-2"/> altius tribus digitis quam cuspis.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="80" ed="#attenborough"/>gif<ptr type="editorNote" n="4" target="#Af_36-2-a.attnote.fn.4"/> se ord sie ufor<ptr type="editorNote" n="5" target="#Af_36-2-a.attnote.fn.5"/> [þreo fingre]<ptr type="editorNote" n="6" target="#Af_36-2-a.attnote.fn.6"/> þonne hindeweard sceaft.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="37.2[b]" corresp="#wit-e"><pb n="334" ed="#jurasinski-and-oliver"/>gif se ord sie ufor þonne hindeweard sceaft.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><ptr type="liebermannNote" n="1" target="#Af_36-2-a.lnote.de.1"/><pb n="71" ed="#liebermann"/>vorausgesetzt, die Spitze sei (3<ptr type="liebermannNote" n="2" target="#Af_36-2-a.lnote.de.2"/> Finger) höher als hinterer<ptr type="liebermannNote" n="3" target="#Af_36-2-a.lnote.de.3"/> Schaft.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">provided that the point is (3 fingers) higher than the rear shaft.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="81" ed="#attenborough"/>supposing the point to be higher than the [other] end of the shaft, by the width of three fingers<ptr type="editorNote" n="1" target="#Af_36-2-a.attnote.n.1"/>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="415" ed="#whitelock"/>if the point is higher<ptr type="editorNote" n="2" target="#Af_36-2-a.whinote.n.2"/> than the butt end of the shaft. If they are both level, the point and the butt end, that is to be [considered] without risk.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="335" ed="#jurasinski-and-oliver"/>if the point is higher than the shaft in the back.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">þry fingra <hi rend="italic">fügt zu So;</hi> ðry fingere <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þry fingra added by So; ðry fingere Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">hindw. <hi rend="italic">So;</hi> hindwearde sceafte <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hindw. So; hindwearde sceafte Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> ufon</seg><seg type="translation" xml:lang="en" source="#claude">altered to ufon</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">71</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">acies</hi> l. sit <hi rend="spaced">altior</hi> <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">acies</hi> l. sit <hi rend="italic">altior</hi> Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">71</biblScope></bibl><seg type="original" xml:lang="de">alt. <hi rend="spaced">feratur</hi> <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">alt. <hi rend="italic">feratur</hi> Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. zugefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">added in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-2-a.lnote.oe.4-3" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">später eingefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">inserted later</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_36-2-a.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Die ersten 8 Wörter ständen logischer <hi rend="spaced">vor</hi> <hi rend="italic">getriowe.</hi> Schon B cor. empfindet das, indem er hier ‘und dies sei’ und ‘dagegen’ vor ‘wenn’ einführt</seg><seg type="translation" xml:lang="en" source="#claude">The first 8 words would stand more logically <hi rend="italic">before</hi> <hi rend="italic">getriowe.</hi> B cor. already senses this, introducing here ‘and let this be’ and ‘on the other hand’ before ‘if’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_36-2-a.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Diese Einschaltung stand zwar vielleicht schon am Rande des Archetyps, stammt aber wahrscheinlich nicht von Ælfred. Zwar die Form bietet keinen Gegengrund, wiewohl Wülfing, nur auf H cor. gestützt, sie bedenklich findet. Er möchte <hi rend="italic">þreofingre</hi> adverbial lesen; <hi rend="italic">Syntax</hi> 267. Dagegen kann in So <hi rend="italic">fingra</hi> Gen. von 3 abhängig sein; H cor. und Ld neigen zum Mittelenglischen. Aber bei diesem Zusatz müsste Af unter wagerecht auch die Lage umfassen, wenn Spitze 1 bis 2 Finger höher getragen ward</seg><seg type="translation" xml:lang="en" source="#claude">This insertion perhaps already stood in the margin of the archetype, but it probably does not derive from Ælfred. The form, it is true, offers no argument against it, although Wülfing, relying only on H cor., finds it questionable. He would read <hi rend="italic">þreofingre</hi> as an adverb; <hi rend="italic">Syntax</hi> 267. On the other hand, in So <hi rend="italic">fingra</hi> may be a gen. dependent on 3; H cor. and Ld tend towards Middle English. But with this addition Af would have to include under ‘horizontal’ the position in which the point was carried 1 to 2 fingers higher as well</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_36-2-a.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘Schaftende’. In seiner Gregor-Übers. sagt Ælfred (ed. Sweet 296): er erstach ihn nicht mit <hi rend="italic">þæs speres orde, ac mid hindeweardum þæm sceafte</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘Shaft-end’. In his translation of Gregory, Ælfred says (ed. Sweet 296): he did not stab him with <hi rend="italic">þæs speres orde, ac mid hindeweardum þæm sceafte</hi></seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_36-2-a.attnote.fn.4" n="4" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>gif</label><seg type="original" xml:lang="en"><hi rend="italic">⁊ þis beo, gif</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_36-2-a.attnote.fn.5" n="5" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>ufor</label><seg type="original" xml:lang="en"><hi rend="italic">ufon</hi>. H*.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_36-2-a.attnote.fn.6" n="6" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>fingre</label><seg type="original" xml:lang="en">H (cf. So, Ld).</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_36-2-a.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">197</biblScope></bibl><seg type="original" xml:lang="en">The words ‘supposing the point...fingers’ obviously belong to the preceding section; the spear point would thus be on a level with the face (see Pollock and Maitland, <hi rend="italic">Hist. of Eng. Law</hi>, <hi rend="smallcaps">i</hi>. p. 31).</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Af_36-2-a.whinote.n.2" n="2" source="#whitelock"><bibl><biblScope unit="page">415</biblScope></bibl><label>higher</label><seg type="original" xml:lang="en"><hi rend="italic">Textus RoJJetisis</hi> and <hi rend="italic">Quadripartitus</hi> add here: “three fingers”</seg></note>
      </div>
