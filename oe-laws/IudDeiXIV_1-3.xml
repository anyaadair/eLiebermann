      <div type="clause" n="1.3">
        <head><ref type="lawCode" target="law:IudDeiXIV">Iud Dei XIV</ref> 1.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIV 1.3" corresp="#wit-lat"><pb n="425" ed="#liebermann"/>Primum<ptr type="liebermannNote" n="12" target="#IudDeiXIV_1-3.lnote.oe.12"/> illae<ptr type="liebermannNote" n="13" target="#IudDeiXIV_1-3.lnote.oe.13"/> res quae furatae sunt ibidem<ptr type="liebermannNote" n="14" target="#IudDeiXIV_1-3.lnote.oe.14"/>, in<ptr type="liebermannNote" n="15" target="#IudDeiXIV_1-3.lnote.oe.15"/> uno breuiculo<ptr type="liebermannNote" n="c" target="#IudDeiXIV_1-3.lnote.oe.c"/> scriptae esse debent, et illorum<ptr type="liebermannNote" n="16" target="#IudDeiXIV_1-3.lnote.oe.16"/> nomina similiter qui de furto insimulantur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 425 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_1-3.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. unten</hi> 7, 1. 8, 2.</seg><seg type="translation" xml:lang="en" source="#claude">Cf. below 7, 1. 8, 2.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_1-3.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">Sed <hi rend="italic">Tr;</hi> 1, 3 <hi rend="italic">f. auch in Zeu.</hi> 668. 688</seg><seg type="translation" xml:lang="en" source="#claude">Sed Tr; 1, 3 f. also in Zeu. 668. 688</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_1-3.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">r. i. <hi rend="italic">Tr; für</hi> ae <hi rend="italic">meist</hi> ę, <hi rend="italic">oft</hi> e <hi rend="italic">Vt2 Tr Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. i. Tr; for ae mostly ę, often e Vt2 Tr Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_1-3.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Vt2 Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Vt2 Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_1-3.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">deb. e. s. in u. b. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">deb. e. s. in u. b. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_1-3.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">n. eorum <hi rend="italic">ohne</hi> sim. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">n. eorum without sim. Tr</seg></note>
