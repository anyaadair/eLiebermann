      <div type="clause" n="3.1">
        <head><ref type="lawCode" target="law:IudDeiIII">Iud Dei III</ref> 3.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei III 3.1" corresp="#wit-lat"><pb n="409" ed="#liebermann"/>respice<ptr type="liebermannNote" n="3" target="#IudDeiIII_3-1.lnote.oe.3"/> ad preces nostrae humilitatis, quibus famulatum sacri indidisti ordinis, et praesta<ptr type="liebermannNote" n="4" target="#IudDeiIII_3-1.lnote.oe.4"/>, non nostris<ptr type="liebermannNote" n="5" target="#IudDeiIII_3-1.lnote.oe.5"/> exigentibus meritis, sed tuorum omnium suffragantibus sanctorum precibus, ut<ptr type="liebermannNote" n="6" target="#IudDeiIII_3-1.lnote.oe.6"/> quod in hac culpa humanos latet oculos et sermonum humanae procacitatis obtegitur defensionibus, tua coelesti et superna moderatione sine ullo reueletur obstricamine<ptr type="liebermannNote" n="7" target="#IudDeiIII_3-1.lnote.oe.7"/>, et<ptr type="liebermannNote" n="8" target="#IudDeiIII_3-1.lnote.oe.8"/>, sicut solus uerus es, ueritatis in hoc sententiam elucidare digneris;</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">*) ‘Verschluss, Hülle’ ?</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 409 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_3-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">quesumus <hi rend="italic">fügt zu Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">quesumus added in Vt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_3-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">ut <hi rend="italic">fügt zu Ch Ca</hi></seg><seg type="translation" xml:lang="en" source="#claude">ut added in Ch Ca</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_3-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">nostri <hi rend="italic">Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">nostri Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_3-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">sed <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">sed H</seg></note>
