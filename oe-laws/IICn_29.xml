        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_29.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">206</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Begünstigung 3. 14; Freilassen 3a</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Begünstigung 3. 14; Freilassen 3a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_29.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">206</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Gerüfte 3; <hi rend="italic">u</hi>. 48, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Gerüfte 3; <hi rend="italic">below</hi> 48, 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_29.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">206</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Als Strafgeldempfänger denkt Cnut wie 29, 1 regelmässig den König, dagegen neben diesem den Inhaber privater Gerichtsbarkeit oder ihres Ertrages Inst und Hn 59, 18</seg><seg type="translation" xml:lang="en" source="#claude">As the recipient of the fine Cnut, as in 29, 1, regularly has the king in mind, whereas Inst and Hn 59, 18 have in mind, alongside him, the holder of private jurisdiction or of its profits</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_29.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">206</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">lade</hi> las wie Ld auch Q, wohl vom Archetyp; <hi rend="italic">s</hi>. Einl. 8. <hi rend="italic">Vgl. Gl</hi> Eideshelfer 27d. 29</seg><seg type="translation" xml:lang="en" source="#claude">Q, like Ld, read <hi rend="italic">lade</hi>, probably from the archetype; <hi rend="italic">see</hi> Introduction 8. <hi rend="italic">Cf. Gl</hi> Eideshelfer 27d. 29</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_29.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">355</biblScope></bibl><seg type="original" xml:lang="en">Cf. In. 36; IV As. 6, 3.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_29.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">355</biblScope></bibl><seg type="original" xml:lang="en">Probably exculpation by means of the oath of 12 compurgators is meant.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_29.robnote.fn.8" n="8" source="#robertson"><bibl><biblScope unit="page">188</biblScope></bibl><label>aðe</label><seg type="original" xml:lang="en">Beside this in the margin Ld has <hi rend="italic">al. lade.</hi></seg></note>
      </div>
