        <head><ref type="lawCode" target="law:ECf">ECf</ref> 6a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 6a"><pb n="631" ed="#liebermann"/>Et si<ptr type="liebermannNote" n="9" target="#ECf_6a.lnote.la.9"/> eorum<ptr type="liebermannNote" n="10" target="#ECf_6a.lnote.la.10"/> sententiam<ptr type="liebermannNote" n="d" target="#ECf_6a.lnote.la.fn.d"/><ptr type="liebermannNote" n="11" target="#ECf_6a.lnote.la.11"/> defugiendo<ptr type="liebermannNote" n="12" target="#ECf_6a.lnote.la.12"/> uel superbe<ptr type="liebermannNote" n="e" target="#ECf_6a.lnote.la.fn.e"/><ptr type="liebermannNote" n="13" target="#ECf_6a.lnote.la.13"/> contempnendo paruipenderit, ad regem<ptr type="liebermannNote" n="f" target="#ECf_6a.lnote.la.fn.f"/> de eo clamor<ptr type="liebermannNote" n="14" target="#ECf_6a.lnote.la.14"/> deferetur post dies XL; et iusticia<ptr type="liebermannNote" n="e" target="#ECf_6a.lnote.la.fn.e"/> regis mittet<ptr type="liebermannNote" n="15" target="#ECf_6a.lnote.la.15"/> eum per uadimonium<ptr type="liebermannNote" n="g" target="#ECf_6a.lnote.la.fn.g"/><ptr type="liebermannNote" n="16" target="#ECf_6a.lnote.la.16"/> et per<ptr type="liebermannNote" n="17" target="#ECf_6a.lnote.la.17"/> plegios<ptr type="liebermannNote" n="18" target="#ECf_6a.lnote.la.18"/>, si habere poterit<ptr type="liebermannNote" n="19" target="#ECf_6a.lnote.la.19"/>, usque dum Deo primitus<ptr type="liebermannNote" n="h" target="#ECf_6a.lnote.la.fn.h"/> et regi<ptr type="liebermannNote" n="20" target="#ECf_6a.lnote.la.20"/> postea<ptr type="liebermannNote" n="21" target="#ECf_6a.lnote.la.21"/> satisfaciat<ptr type="liebermannNote" n="a" target="#ECf_6a.lnote.oe.erkl-a"/>.</ab>
        <note type="comparison" source="#liebermann" n="631"><label>printed alongside</label> <ref target="clause:ECfRetr_6a">ECf retr 6a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 631 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Excommunication; vgl.</hi> Const. Clarendon. 10</seg><seg type="translation" xml:lang="en" source="#claude">excommunication; cf. Const. Clarendon. 10</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">diese Wörter vielleicht aus</hi> Wl episc.; <hi rend="italic">vgl. o. S.</hi> 629<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">these words perhaps from Wl episc.; cf. above, p. 629, note b</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 2, 9. 10, 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. 2, 9. 10, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 36</seg><seg type="translation" xml:lang="en" source="#claude">cf. 36</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 2, 9a <hi rend="italic">Retr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 2, 9a Retr.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">quis <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hk adds quis</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">-nci., <hi rend="italic">meist</hi> c <hi rend="italic">statt</hi> t <hi rend="italic">vor</hi> i + <hi rend="italic">Vocal Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nci., mostly c for t before i + vowel Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">diffug. <hi rend="italic">Hr;</hi> cont. uel def. <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">diffug. Hr; cont. uel def. Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad Do No</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad Do No</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">adm. <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">adm. Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">uadium <hi rend="italic">Hk Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">uadium Hk Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">plegium <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">plegium Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">potuerit <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">potuerit Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">p. r. <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. r. Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And if he sets little store by their sentence, by fleeing it or proudly despising it, complaint shall be brought to the king about him after forty days; and the king's justice shall put him under gage and under pledges, if he can find them, until he makes satisfaction first to God and afterwards to the king.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6a.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">344</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Kirchenstaatsrecht 20—22; Frist 14a; Prozessualpfand 3C. Verf. denkt also an die der Kirche zukommenden Geldbussen, nicht an Leibesstrafen</seg><seg type="translation" xml:lang="en" source="#claude">Cf. Gl Kirchenstaatsrecht 20—22; Frist 14a; Prozessualpfand 3C. The author is thus thinking of the money penalties due to the Church, not of corporal punishments</seg></note>
      </div>
