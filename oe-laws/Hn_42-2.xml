      <div type="clause" n="42.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 42.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 42.2" corresp="#wit-lat"><pb n="568–569" ed="#liebermann"/>Si quis<ptr type="liebermannNote" n="q" target="#Hn_42-2.lnote.oe.q"/> uero dapiferum<ptr type="liebermannNote" n="r" target="#Hn_42-2.lnote.oe.r"/> uel quemlibet ministrum<ptr type="liebermannNote" n="s" target="#Hn_42-2.lnote.oe.s"/> ita rebus suis<ptr type="liebermannNote" n="46" target="#Hn_42-2.lnote.oe.46"/> prefecerit — et hoc, ubi et sicut iustum est, notificauerit<ptr type="liebermannNote" n="q" target="#Hn_42-2.lnote.oe.q"/> — et [h]omin[i<ptr type="liebermannNote" n="47" target="#Hn_42-2.lnote.oe.47"/>] suo committet<ptr type="liebermannNote" n="q" target="#Hn_42-2.lnote.oe.q"/>, ut quodammodo locum eius habeat<ptr type="liebermannNote" n="r" target="#Hn_42-2.lnote.oe.r"/>, et quod fecerit<ptr type="liebermannNote" n="s" target="#Hn_42-2.lnote.oe.s"/> factum<ptr type="liebermannNote" n="48" target="#Hn_42-2.lnote.oe.48"/> sit, et a rege uel<ptr type="liebermannNote" n="49" target="#Hn_42-2.lnote.oe.49"/> iustitia eius uel a communi<ptr type="liebermannNote" n="o" target="#Hn_42-2.lnote.oe.o"/> utrorumque<ptr type="liebermannNote" n="50" target="#Hn_42-2.lnote.oe.50"/> domino de proprio<ptr type="liebermannNote" n="t" target="#Hn_42-2.lnote.oe.t"/> ipsorum placito per eum<ptr type="liebermannNote" n="s" target="#Hn_42-2.lnote.oe.s"/> submoneatur<ptr type="liebermannNote" n="51" target="#Hn_42-2.lnote.oe.51"/>, et idem<ptr type="liebermannNote" n="s" target="#Hn_42-2.lnote.oe.s"/> coram testibus suscepit, ut negari non possit, submonitus iudicetur<ptr type="liebermannNote" n="q" target="#Hn_42-2.lnote.oe.q"/>, siue<ptr type="liebermannNote" n="52" target="#Hn_42-2.lnote.oe.52"/> dictum sit ab homine suo siue non; et si non uenerit ad placitum, rectum inde iudicetur: unde si dampnum ei euenerit, loquatur inde cum homine suo.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 568–569 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-2.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">privaten Herrn sowohl des <hi rend="italic">mit Ladung Beauftragten</hi> wie des <hi rend="italic">Vorzuladenden</hi></seg><seg type="translation" xml:lang="en" source="#claude">private lord both of the person charged with the summons and of the person to be summoned</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-2.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">Vorzuladender</seg><seg type="translation" xml:lang="en" source="#claude">person to be summoned</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-2.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 41, 2. 92, 18</seg><seg type="translation" xml:lang="en" source="#claude">cf. 41, 2. 92, 18</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-2.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">Vertreter</seg><seg type="translation" xml:lang="en" source="#claude">representative</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-2.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. S.</hi> 570&lt;sup&gt;m&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude">cf. p. 570&lt;sup&gt;m&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-2.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">umgestellt aus</hi> p. s. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">transposed from p. s. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-2.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">domino <hi rend="italic">Hss.; geb. aus S.</hi> 569, <hi rend="italic">Z.</hi> 1 <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">domino MSS; emended from p. 569, l. 1 Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-2.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">ratum <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">ratum Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-2.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">nochmals, unterpunctirt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel repeated, dotted for deletion Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-2.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">utroque <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">utroque Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-2.lnote.oe.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">-moue. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-moue. Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-2.lnote.oe.52" n="52" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">siue — iudicetur <hi rend="italic">überspringen K Co Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">siue — iudicetur omitted by K Co Gi</seg></note>
