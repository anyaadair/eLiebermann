      <div type="clause" n="21.2">
        <head><ref type="lawCode" target="law:IudDeiXII">Iud Dei XII</ref> 21.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XII 21.2" corresp="#wit-lat"><pb n="422" ed="#liebermann"/>ut creatura mysteriis<ptr type="liebermannNote" n="2" target="#IudDeiXII_21-2.lnote.oe.2"/> tuis seruiens<ptr type="liebermannNote" n="3" target="#IudDeiXII_21-2.lnote.oe.3"/> ad diabolicas et humanas fallacias detegendas<ptr type="liebermannNote" n="4" target="#IudDeiXII_21-2.lnote.oe.4"/> et ad earum multiplicia figmenta et argumenta dissoluenda atque ad multiformes earum<ptr type="liebermannNote" n="5" target="#IudDeiXII_21-2.lnote.oe.5"/> artes destruendas diuinę gratię sumat effectum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 422 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_21-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">422</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Tr;</hi> mis. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Tr; mis. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_21-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">422</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Tr adds et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_21-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">422</biblScope></bibl><seg type="original" xml:lang="de">det̃g. <hi rend="italic">Ll Tb</hi></seg><seg type="translation" xml:lang="en" source="#claude">det̃g. Ll Tb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_21-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">422</biblScope></bibl><seg type="original" xml:lang="de">a. e. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. e. Tr</seg></note>
