      <div type="clause" n="83.6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 83.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 83.6" corresp="#wit-lat"><pb n="600" ed="#liebermann"/>Si quis in uindictam<ptr type="liebermannNote" n="d" target="#Hn_83-6.lnote.oe.d"/> uel in se defendendo occidat aliquem, nichil<ptr type="liebermannNote" n="9" target="#Hn_83-6.lnote.oe.9"/> sibi de mortui rebus aliquid<ptr type="liebermannNote" n="10" target="#Hn_83-6.lnote.oe.10"/> usurpet, non equum, non galeam<ptr type="liebermannNote" n="e" target="#Hn_83-6.lnote.oe.e"/><ptr type="liebermannNote" n="11" target="#Hn_83-6.lnote.oe.11"/> uel gladium uel peccuniam prorsus aliquam; set ipsum corpus<ptr type="liebermannNote" n="f" target="#Hn_83-6.lnote.oe.f"/> solito defunctorum more componat, caput ad occidens<ptr type="liebermannNote" n="12" target="#Hn_83-6.lnote.oe.12"/>, pedes ad oriens<ptr type="liebermannNote" n="13" target="#Hn_83-6.lnote.oe.13"/> uersum, super clipeum, si habeat; et lanceam suam figat et arma circummittat et equum adregniet<ptr type="liebermannNote" n="g" target="#Hn_83-6.lnote.oe.g"/><ptr type="liebermannNote" n="14" target="#Hn_83-6.lnote.oe.14"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 600 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. S.</hi> 599&lt;sup&gt;n&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude">cf. p. 599&lt;sup&gt;n&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 88, 1<hi rend="italic">a</hi>. <hi rend="italic">Wer die Waffe des Getödteten an sich nimmt, billigt den Todtschlag, begeht aber keine Rechtswidrigkeit in</hi> Beowulf 1151</seg><seg type="translation" xml:lang="en" source="#claude">cf. 88, 1<hi rend="italic">a</hi>. In Beowulf 1151 the man who takes the slain man's weapon for himself approves the killing, but commits no unlawful act</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">diesen Einzelheiten misstrauen Pollock-Maitland</hi> HEL. I 30. <hi rend="italic">Jedenfalls liegt hierin kein Bahrrecht vor; Lehmann</hi> Germanist. für K. Maurer 44</seg><seg type="translation" xml:lang="en" source="#claude">Pollock-Maitland HEL. I 30 distrust these details. At any rate this does not involve the ordeal of the bier; Lehmann Germanist. für K. Maurer 44</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vom altfrz.</hi> aresner (<hi rend="italic">nfrz.</hi> rêne <hi rend="italic">Zügel</hi>): anhalftern [‘<hi rend="italic">an die in den Boden gerammte Lanze?</hi>’ <hi rend="italic">SUCHIER</hi>], <hi rend="italic">wohl nicht</hi> equum freno tenere et adducere <hi rend="italic">mit Ducange, zu welchem Favre ein</hi> adrener <hi rend="italic">citirt</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Old French aresner (Modern French rêne ‘rein’): to tether by the halter [‘to the lance rammed into the ground?’ SUCHIER], probably not equum freno tenere et adducere, with Ducange, for which Favre cites an adrener</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">nil <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">nil Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">-uis <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uis Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">gl. non ga. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">gl. non ga. Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">oriens <hi rend="italic">K Co Or Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">oriens K Co Or Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">occidens <hi rend="italic">spät darüber Or; so Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">occidens written above in a late hand Or; so Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">arr. <hi rend="italic">Co</hi>; arreniet <hi rend="italic">Or</hi>; areniet <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">arr. Co; arreniet Or; areniet K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nil</hi>{9}—<hi rend="italic">-reniet</hi>{14} Rs. Im Wirtschaftslatein heisst a. 1402 <hi rend="italic">reynes</hi> ‘Halfter’; Cunningham <hi rend="italic">Growth Engl. indu</hi>. 522</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">nil</hi>{9}—<hi rend="italic">-reniet</hi>{14} Rs. In economic Latin of 1402 <hi rend="italic">reynes</hi> means ‘halter’; Cunningham <hi rend="italic">Growth Engl. indu</hi>. 522</seg></note>
      </div>
