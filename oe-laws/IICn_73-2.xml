      <div type="clause" n="73.2">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 73.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="73.2" corresp="#wit-g-a"><pb n="360" ed="#liebermann"/>⁊ þeah<ptr type="liebermannNote" n="14" target="#IICn_73-2.lnote.oe.14"/> heo nydnumen weorðe<ptr type="liebermannNote" n="15" target="#IICn_73-2.lnote.oe.15"/>, þolige þæra<ptr type="liebermannNote" n="7" target="#IICn_73-2.lnote.oe.7"/> æhta, butan<ptr type="liebermannNote" n="16" target="#IICn_73-2.lnote.oe.16"/> heo fram þam ceorle wylle<ptr type="liebermannNote" n="4" target="#IICn_73-2.lnote.oe.4"/> eft ham ongean ⁊ næfre heo<ptr type="liebermannNote" n="17" target="#IICn_73-2.lnote.oe.17"/> eft his ne weorðe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="73.2" corresp="#wit-b"><pb n="360" ed="#liebermann"/>⁊ ðeah heo neadnumen wyrðe, ðolie ðæra æhta, buton heo fram ðam ceorle wille eft ham ongean ⁊ næfre eft his [no<ptr type="liebermannNote" n="3" target="#IICn_73-2.lnote.oe.3"/>] wyrðe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="73.2" corresp="#wit-a"><pb n="360" ed="#liebermann"/>⁊ þeah heo nydnumen weorðe, þolige þara ehta, buton heo fra<hi rend="italic">m</hi> ceorle wille eft ham ongean ⁊ næfre eft heo his ne wurðe.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="73.2" corresp="#wit-q"><pb n="361" ed="#liebermann"/>Et licet etiam<ptr type="liebermannNote" n="8" target="#IICn_73-2.lnote.oe.8"/> per uim capiatur, perdat tamen totam<ptr type="liebermannNote" n="9" target="#IICn_73-2.lnote.oe.9"/> pecuniam, nisi nunc<ptr type="liebermannNote" n="10" target="#IICn_73-2.lnote.oe.10"/> ab eo recedere uelit in domum suam et nunquam deinceps fiat uxor eius.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="73.2" corresp="#wit-inst-cn"><pb n="361" ed="#liebermann"/>Et quamuis coacta fuisset<ptr type="liebermannNote" n="9" target="#IICn_73-2.lnote.oe.9-2"/> illum accipere, nisi ab<ptr type="liebermannNote" n="10" target="#IICn_73-2.lnote.oe.10-2"/> illo omnino recedat, ita ut eius nunquam amplius<ptr type="liebermannNote" n="11" target="#IICn_73-2.lnote.oe.11"/> fiat, careat omnium supra<ptr type="liebermannNote" n="12" target="#IICn_73-2.lnote.oe.12"/> dictorum bonorum.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="73.2" corresp="#wit-cons-cn"><pb n="361" ed="#liebermann"/>Que etiam si ui rapta sit, careat per alium possessis, nisi illum relinqueret, numquam illius futura.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="73a.2" corresp="#wit-b"><pb n="212" ed="#robertson"/>⁊ ðeah heo neadnumen wyrðe, ðolie ðæra æhta, buton heo fram ðam ceorle wille eft ham ongean ⁊ næfre eft his [no]<ptr type="editorNote" n="1" target="#IICn_73-2.robnote.fn.1"/> wyrðe.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="292" ed="#rabin-doml"/>And þeah heo nydnumen weorðe, þolige þæra æhta butan heo from þam ceorle wylle eft ham ongean and næfre heo eft his ne weorðe.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="361" ed="#liebermann"/>Und selbst wenn sie mit Zwang<ptr type="liebermannNote" n="1" target="#IICn_73-2.lnote.de.1"/> zur Frau genommen wird, verliere sie die Güter [erster Ehe], wenn sie nicht von dem [zweiten] Manne wieder zurück heim will und niemals späterhin die Seine wird.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And even if she is taken as wife by force, let her lose the goods [of the first marriage], unless she wishes to go back home again from the [second] man and never afterwards becomes his.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_73-2.robnote.n.1"/><pb n="213" ed="#robertson"/>And although she has been married by force, she shall lose her possessions, unless she is willing to leave the man and return home and never afterwards be his.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="473" ed="#whitelock"/>And even if she was married by force, she is to forfeit those possessions, unless she wishes to leave the husband and return home and never afterwards become his.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="293" ed="#rabin-doml"/>And even if she has been married against her will, she must forfeit her possessions unless she is willing to leave the man and return home and never again be his.</ab>
        <note type="editorial">BR: added from Gesetze I p. 361, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">per u. e. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">per u. e. T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">p. t. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. t. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">non <hi rend="italic">R; fehlt K;</hi> si non <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">non R; lacking in K; si non Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de">ðeaþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðeaþ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de">-rþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rþ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de">ðara ehta <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðara ehta Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de">buton <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">buton Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de">wille <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wille Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">360</biblScope></bibl><seg type="original" xml:lang="de">eft heo his ne wurþe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">eft heo his ne wurþe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-2.lnote.oe.9-2" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">esset <hi rend="italic">Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">esset Lb S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-2.lnote.oe.10-2" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">om. ab i. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">om. ab i. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">f. a. <hi rend="italic">Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. a. Lb S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_73-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">361</biblScope></bibl><seg type="original" xml:lang="de">predi. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">predi. Cb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_73-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">213</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Unrichtig versteht Notzucht C, und Zwang durch Vormund Inst. Gemeint ist Raubehe; <hi rend="italic">s. o</hi>. 52¹; <hi rend="italic">Gl</hi> Eheschliessung 2h. l</seg><seg type="translation" xml:lang="en" source="#claude">C wrongly understands rape, and Inst compulsion by a guardian. What is meant is marriage by abduction; <hi rend="italic">see above</hi> 52¹; <hi rend="italic">Gl</hi> Eheschliessung 2h. l</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_73-2.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">358</biblScope></bibl><seg type="original" xml:lang="en">Cf. cap. 52; and see P. and M. <hi rend="smallcaps">ii</hi>. p. 427.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_73-2.robnote.fn.1" n="1" source="#robertson"><bibl><biblScope unit="page">212</biblScope></bibl><label>no</label><seg type="original" xml:lang="en">Written above in 16th cent. in B; <hi rend="italic">ne</hi> G, A, Ld.</seg></note>
