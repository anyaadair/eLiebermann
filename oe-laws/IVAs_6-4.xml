    <body>
      <div type="clause" n="6.4">
        <head><ref type="lawCode" target="law:IVAs">IV As</ref> 6.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6.4" corresp="#wit-q"><pb n="172" ed="#liebermann"/>Si libera mulier<ptr type="liebermannNote" n="a" target="#IVAs_6-4.lnote.oe.a"/> sit, precipitetur<ptr type="liebermannNote" n="b" target="#IVAs_6-4.lnote.oe.b"/> de cliuo uel submergatur.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="6.4" corresp="#wit-q"><pb n="150" ed="#attenborough"/>Si libera mulier sit, præcipitetur de clivo vel submergatur.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="151" ed="#attenborough"/>In the case of a free woman, she shall be thrown from a cliff or drowned.</ab>
        <note type="editorial">Latin only; no German translation in Liebermann.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-4.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">114</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Todesstrafe 6; Ertränken; Frau 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Todesstrafe 6; Ertränken; Frau 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-4.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">114</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Todesstrafe 6; Ertränken; Frau 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Todesstrafe 6; Ertränken; Frau 3</seg></note>
      </div>
