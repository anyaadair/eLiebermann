      <div type="clause" n="44.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 44.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 44.1" corresp="#wit-lat"><pb n="569" ed="#liebermann"/>Si quis a domino suo missus sit in plegium<ptr type="liebermannNote" n="40" target="#Hn_44-1.lnote.oe.40"/> et<ptr type="liebermannNote" n="41" target="#Hn_44-1.lnote.oe.41"/> ostendere possit, quod ei<ptr type="liebermannNote" n="34" target="#Hn_44-1.lnote.oe.34"/> ex<ptr type="liebermannNote" n="42" target="#Hn_44-1.lnote.oe.42"/> sponsione uel fideiussione illa dampnum uenit, non cogitur ex lege de quauis peccuniali inplacitacione respondere ei, donec totum restituat<ptr type="liebermannNote" n="t" target="#Hn_44-1.lnote.oe.t"/> quod<ptr type="liebermannNote" n="43" target="#Hn_44-1.lnote.oe.43"/> amiserit<ptr type="liebermannNote" n="u" target="#Hn_44-1.lnote.oe.u"/> pro eo.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 569 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_44-1.lnote.oe.kk" n="kk" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Ed. Conf.</hi> 25; <hi rend="italic">Pollock and Maitland</hi> HEL. I 279</seg><seg type="translation" xml:lang="en" source="#claude">cf. Ed. Conf. 25; Pollock and Maitland HEL. I 279</seg><note type="remark" resp="#claude">marker not found in the text</note></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_44-1.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">der Herr</seg><seg type="translation" xml:lang="en" source="#claude">the lord</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_44-1.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">der Vasall</seg><seg type="translation" xml:lang="en" source="#claude">the vassal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_44-1.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_44-1.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">plīg. <hi rend="italic">Co;</hi> placitagium <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">plīg. Co; placitagium Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_44-1.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">ut <hi rend="italic">Sc Hg Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">ut Sc Hg Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_44-1.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geändert in</hi> expons. <hi rend="italic">Sc, und so übrige,</hi> ex pōne <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">altered to expons. Sc, and so the rest; ex pōne Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_44-1.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_44-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Bürgschaft 11. <hi rend="italic">Homo tenetur dominum plegiare in quacumque curia</hi> (Summa de leg. Norm. 27, 6) . . <hi rend="italic">de debitis, in prisonia, de stando iuri, de emendis; . . tamen ipse eos indemnes redde[t]; ebd</hi>. 59, 10. Nur wenn <hi rend="italic">homo debiti (domini) plegius exstiterit, res hominum pro dominorum debitis licet namtire</hi>; Gesetz fürs Festland 1177; Bened. abbas I 194.—<hi rend="italic">ut</hi>{41} ‘sodass’, vielleicht original—<hi rend="italic">peculiali inpl</hi>. (wohl nur für <hi rend="italic">pecunialis</hi> verschrieben; Ducange kennt zwar Gallolatein <hi rend="italic">peculialis</hi> ‘vom Kleinvieh’, hier aber ist ‘geldlich’ gemeint) Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Bürgschaft 11. <hi rend="italic">Homo tenetur dominum plegiare in quacumque curia</hi> (Summa de leg. Norm. 27, 6) . . <hi rend="italic">de debitis, in prisonia, de stando iuri, de emendis; . . tamen ipse eos indemnes redde[t]; ibid</hi>. 59, 10. Only if <hi rend="italic">homo debiti (domini) plegius exstiterit, res hominum pro dominorum debitis licet namtire</hi>; law for the Continent, 1177; Bened. abbas I 194.—<hi rend="italic">ut</hi>{41} ‘so that’, perhaps original—<hi rend="italic">peculiali inpl</hi>. (probably merely a miswriting of <hi rend="italic">pecunialis</hi>; Ducange does indeed know a Gallo-Latin <hi rend="italic">peculialis</hi> ‘relating to small livestock’, but here ‘pecuniary’ is meant) Rs</seg></note>
      </div>
