      <div type="clause" n="9">
        <head><ref type="lawCode" target="law:ExcomVI">Excom VI</ref> 9</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom VI 9" corresp="#wit-ca"><pb n="437" ed="#liebermann"/>Maledictus sit in capite<ptr type="liebermannNote" n="c" target="#ExcomVI_9.lnote.oe.c"/> et in collo. Maledictus sit in oculis<ptr type="liebermannNote" n="d" target="#ExcomVI_9.lnote.oe.d"/> et in naso<ptr type="liebermannNote" n="e" target="#ExcomVI_9.lnote.oe.e"/> et in auribus<ptr type="liebermannNote" n="f" target="#ExcomVI_9.lnote.oe.f"/>. Maledictus sit in labiis<ptr type="liebermannNote" n="c" target="#ExcomVI_9.lnote.oe.c"/> et in dentibus. Maledictus sit in collo et in gutture<ptr type="liebermannNote" n="c" target="#ExcomVI_9.lnote.oe.c"/>. Maledictus sit in scapulis<ptr type="liebermannNote" n="c" target="#ExcomVI_9.lnote.oe.c"/> et in pectoribus. Maledictus sit in brachiis<ptr type="liebermannNote" n="e" target="#ExcomVI_9.lnote.oe.e"/> et in manibus. Maledictus sit in corde<ptr type="liebermannNote" n="e" target="#ExcomVI_9.lnote.oe.e"/> et in umbilico.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 437 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVI_9.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">437</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> VII 14—18. 21 VIII 23 <hi rend="italic">ff.</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> VII 14—18. 21 VIII 23 <hi rend="italic">ff.</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVI_9.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">437</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> VII 15. VIII 25. <hi rend="italic">Rot</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> VII 15. VIII 25. <hi rend="italic">Rot</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVI_9.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">437</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> VIII 25</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> VIII 25</seg></note>
