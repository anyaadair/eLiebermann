      <div type="clause" n="2.2">
        <head><ref type="lawCode" target="law:Duel">Duel</ref> 2.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Duel 2.2" corresp="#wit-lat"><pb n="430" ed="#liebermann"/>quatinus quicumque his armis pugnauerit, tua protectione munitus tam corporis quam animę salutem<ptr type="liebermannNote" n="56" target="#Duel_2-2.lnote.oe.56"/> percipiat atque uictoriosum<ptr type="liebermannNote" n="57" target="#Duel_2-2.lnote.oe.57"/> de hoste reportans tropheum<ptr type="liebermannNote" n="58" target="#Duel_2-2.lnote.oe.58"/>, bello peracto, tibi<ptr type="liebermannNote" n="59" target="#Duel_2-2.lnote.oe.59"/>, Creatori omnium, gracias<ptr type="liebermannNote" n="e" target="#Duel_2-2.lnote.oe.e"/> referat cum<ptr type="liebermannNote" n="60" target="#Duel_2-2.lnote.oe.60"/> filio tuo domino nostro Iesu Christo, qui tecum<ptr type="liebermannNote" n="61" target="#Duel_2-2.lnote.oe.61"/> et cum<ptr type="liebermannNote" n="62" target="#Duel_2-2.lnote.oe.62"/> Spiritu sancto uiuit<ptr type="liebermannNote" n="63" target="#Duel_2-2.lnote.oe.63"/> et regnat Deus per omnia secula<ptr type="liebermannNote" n="64" target="#Duel_2-2.lnote.oe.64"/> seculorum<ptr type="liebermannNote" n="65" target="#Duel_2-2.lnote.oe.65"/>. Amen<ptr type="liebermannNote" n="66" target="#Duel_2-2.lnote.oe.66"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 430 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_2-2.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Dem Dome York bestätigt Stephan angeblich gemäss Heinrich’s I. Privileg:</hi> ‘Ubicumque fit duellum Eboraci, iuramenta fieri debent super textum uel super reliquias ecclesiæ sancti Petri; et facto duello, uictor arma uicti ad ecclesiam sancti Petri offerat, gratias agens Deo et sancto Petro pro uictoria’ (<hi rend="italic">Ed. Raine</hi> Historians of York III 36).</seg><seg type="translation" xml:lang="en" source="#claude">Stephen allegedly confirms to the minster of York, in accordance with Henry I’s privilege: ‘Ubicumque fit duellum Eboraci, iuramenta fieri debent super textum uel super reliquias ecclesiæ sancti Petri; et facto duello, uictor arma uicti ad ecclesiam sancti Petri offerat, gratias agens Deo et sancto Petro pro uictoria’ (ed. Raine Historians of York III 36).</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_2-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de">Symbolum <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Symbolum Tr</seg><note type="remark" resp="#claude">marker not found in the text</note></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_2-2.lnote.oe.56" n="56" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de">sanitatem <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">sanitatem Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_2-2.lnote.oe.57" n="57" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de">uict. — peracto <hi rend="italic">fehlt Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">uict. — peracto missing in Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_2-2.lnote.oe.58" n="58" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de">bello p. triumphum <hi rend="italic">Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">bello p. triumphum Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_2-2.lnote.oe.59" n="59" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ym Ta</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Ym Ta</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_2-2.lnote.oe.60" n="60" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de">cum — Christo <hi rend="italic">fehlt Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">cum — Christo missing in Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_2-2.lnote.oe.61" n="61" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de">tec. — sancto <hi rend="italic">fehlt Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">tec. — sancto missing in Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_2-2.lnote.oe.62" n="62" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de">eodem <hi rend="italic">fügt zu Hm</hi></seg><seg type="translation" xml:lang="en" source="#claude">eodem added in Hm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_2-2.lnote.oe.63" n="63" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de">-is et regnas <hi rend="italic">Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">-is et regnas Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_2-2.lnote.oe.64" n="64" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de">s. s. A. <hi rend="italic">fehlt Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. s. A. missing in Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_2-2.lnote.oe.65" n="65" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de">R[espon.] <hi rend="italic">fügt roth zu Hm</hi></seg><seg type="translation" xml:lang="en" source="#claude">R[espon.] added in red in Hm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_2-2.lnote.oe.66" n="66" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Tr Ym</seg></note>
