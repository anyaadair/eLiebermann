        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 90.4a" corresp="#wit-lat"><pb n="605" ed="#liebermann"/>Si autem uirga deforis sepem<ptr type="liebermannNote" n="44" target="#Hn_90-4a.lnote.oe.44"/> incaute missa sit et aliquid<ptr type="liebermannNote" n="45" target="#Hn_90-4a.lnote.oe.45"/> interfecerit, secundum legem Ribuariorum<ptr type="liebermannNote" n="46" target="#Hn_90-4a.lnote.oe.46"/> soluatur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 605 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-4a.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">sepe i. m. fuerit <hi rend="italic">Rib.</hi></seg><seg type="translation" xml:lang="en" source="#claude">sepe i. m. fuerit Rib.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-4a.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">-uis <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uis Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-4a.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">-arro. <hi rend="italic">oder</hi> -airo. <hi rend="italic">Sc;</hi> Ribuaito. <hi rend="italic">Hg;</hi> Rub. <hi rend="italic">Co Or Sl Tw</hi></seg><seg type="translation" xml:lang="en" source="#claude">-arro. or -airo. Sc; Ribuaito. Hg; Rub. Co Or Sl Tw</seg></note>
