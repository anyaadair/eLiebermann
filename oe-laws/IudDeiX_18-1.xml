      <div type="clause" n="18.1">
        <head><ref type="lawCode" target="law:IudDeiX">Iud Dei X</ref> 18.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei X 18.1" corresp="#wit-lat"><pb n="417" ed="#liebermann"/>In tertia<ptr type="liebermannNote" n="b" target="#IudDeiX_18-1.lnote.oe.b"/> uero parte foueae fustes<ptr type="liebermannNote" n="b" target="#IudDeiX_18-1.lnote.oe.b"/> fortissimi cum cleta<ptr type="liebermannNote" n="f" target="#IudDeiX_18-1.lnote.oe.f"/> fortissima ponantur desuper, ad sustinendum uidelicet sacerdotem aquam benedicentem et iudices<ptr type="liebermannNote" n="g" target="#IudDeiX_18-1.lnote.oe.g"/> desuper assistentes et hominem intraturum in aquam<ptr type="liebermannNote" n="34" target="#IudDeiX_18-1.lnote.oe.34"/>, cum duobus uel tribus hominibus eum ibidem demittentibus.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 417 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_18-1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">417</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Eigenthümlich.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Peculiar to this text.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_18-1.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">417</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Franz.</hi> claie <hi rend="italic">Hürde.</hi></seg><seg type="translation" xml:lang="en" source="#claude">French claie, hurdle.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_18-1.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">417</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vielleicht ‘Urtheilfinder’ neben dem Einen Gerichtsvorsitzenden? oder</hi> Iusticiarii regis.</seg><seg type="translation" xml:lang="en" source="#claude">Perhaps ‘judgment-finders’ alongside the one presiding judge? or Iusticiarii regis.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_18-1.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">417</biblScope></bibl><seg type="original" xml:lang="de">aqua <hi rend="italic">Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">aqua Ma</seg></note>
