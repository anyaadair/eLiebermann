      <div type="clause" n="19.6">
        <head><ref type="lawCode" target="law:IudDeiX">Iud Dei X</ref> 19.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei X 19.6" corresp="#wit-lat"><pb n="418" ed="#liebermann"/>Et si ille nocens uel reus per aliquod maleficium uel per herbas seu per<ptr type="liebermannNote" n="12" target="#IudDeiX_19-6.lnote.oe.12"/> causas diabolicas cor suum indurauerit et peccatum quod fecit confiteri noluerit, tua dextera, quaesumus Domine, declarare dignetur. Per<ptr type="liebermannNote" n="13" target="#IudDeiX_19-6.lnote.oe.13"/></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 418 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_19-6.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Bc</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Bc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_19-6.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de">eundem <hi rend="italic">fügt zu Bc</hi></seg><seg type="translation" xml:lang="en" source="#claude">Bc adds eundem</seg></note>
      </div>
