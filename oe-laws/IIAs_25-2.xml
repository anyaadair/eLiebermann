      <div type="clause" n="25.2">
        <head><ref type="lawCode" target="law:IIAs">II As</ref> 25.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="25.2" corresp="#wit-h"><pb n="164" ed="#liebermann"/>Se ðe of ðissa<ptr type="liebermannNote" n="15" target="#IIAs_25-2.lnote.oe.15"/> gerædnesse<ptr type="liebermannNote" n="16" target="#IIAs_25-2.lnote.oe.16"/> gá, gilde æt frumcirre V pund, æt oþrum cirre his wer<ptr type="liebermannNote" n="17" target="#IIAs_25-2.lnote.oe.17"/>, æt þriddan cirre ðolige ealles þæs (þe<ptr type="liebermannNote" n="2" target="#IIAs_25-2.lnote.oe.2"/>) he age ⁊ ure ealra freondscipes.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="25.2" corresp="#wit-ld"><pb n="164" ed="#liebermann"/>Se ðe of ðis<ptr type="liebermannNote" n="1" target="#IIAs_25-2.lnote.oe.1"/> gerednysse gá, gylde æt frumcyrre V punde<ptr type="liebermannNote" n="1" target="#IIAs_25-2.lnote.oe.1"/>, æt oþrum cyrre his wer, æt ðriddan ðolige ealle<ptr type="liebermannNote" n="1" target="#IIAs_25-2.lnote.oe.1"/> ðæs ðe he age ⁊ ura ealra freondscipes.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="25.2" corresp="#wit-q"><pb n="165" ed="#liebermann"/>Qui ex<ptr type="liebermannNote" n="22" target="#IIAs_25-2.lnote.oe.22"/> hac institutione recesserit<ptr type="liebermannNote" n="23" target="#IIAs_25-2.lnote.oe.23"/>, emendet prima uice<ptr type="liebermannNote" n="24" target="#IIAs_25-2.lnote.oe.24"/> quinque libras, alia uice weram suam, ad<ptr type="liebermannNote" n="25" target="#IIAs_25-2.lnote.oe.25"/> terciam uicem<ptr type="liebermannNote" n="26" target="#IIAs_25-2.lnote.oe.26"/> perdat quicquid habebit<ptr type="liebermannNote" n="27" target="#IIAs_25-2.lnote.oe.27"/> et omnium nostrum amicitiam.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="25.2" corresp="#wit-h"><pb n="140" ed="#attenborough"/>Se ðe of ðissa gerædnesse gá, gilde æt frumcirre V pund, æt oþrum cirre his wer, æt þriddan cirre ðolige ealles<ptr type="editorNote" n="19" target="#IIAs_25-2.attnote.fn.19"/> þæs he age ⁊ ure ealra freondscipes.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="165" ed="#liebermann"/>Wer<ptr type="liebermannNote" n="1" target="#IIAs_25-2.lnote.de.1"/> von dieser Verordnung<ptr type="liebermannNote" n="2" target="#IIAs_25-2.lnote.de.2"/> abweicht, zahle beim ersten Male 5 Pfund<ptr type="liebermannNote" n="3" target="#IIAs_25-2.lnote.de.3"/>, beim zweiten Male sein Wergeld, beim dritten Male verliere er alles, was er besitzt und unser aller Freundschaft.<ptr type="liebermannNote" n="4" target="#IIAs_25-2.lnote.de.4"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Whoever departs from this ordinance, let him pay 5 pounds the first time, his wergild the second time; the third time let him lose everything that he owns and the friendship of all of us.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="141" ed="#attenborough"/>He who violates these ordinances shall, on the first occasion, pay 5 pounds<ptr type="editorNote" n="1" target="#IIAs_25-2.attnote.n.1"/>; on the second occasion, his wergeld; and on the third he shall lose all that he has, and the friendship of us all.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="422" ed="#whitelock"/>He who deviates from this ordinance is to pay on the first occasion five pounds, on the second occasion his wergild, on the third occasion he is to forfeit all that he owns and the friendship of us all.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IIIAs_5">III As 5</ref>; <ref target="clause:IIIAs_7-3">III As 7.3</ref>; <ref target="clause:IICn_83">II Cn 83</ref>; <ref target="clause:IICn_83-2">II Cn 83.2</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="315"><ref target="clause:IIEg_4-1">II Eg 4.1–3</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="315"><ref target="clause:IIIEg_7-1">III Eg 7.1</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="354"><ref target="clause:IICn_83">II Cn 83–83.2</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">164</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">164</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">164</biblScope></bibl><seg type="original" xml:lang="de">ræd <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">ræd on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">164</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> were</seg><seg type="translation" xml:lang="en" source="#claude">altered to were</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">164</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-2.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">165</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> de <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Lond; de the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-2.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">165</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> recedet <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Lond; recedet the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-2.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">165</biblScope></bibl><seg type="original" xml:lang="de">u. q. l. a. u. <hi rend="italic">überspringt Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">Or skips u. q. l. a. u.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-2.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">165</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk;</hi> tercia <hi rend="italic">TMBr;</hi> alia <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk; tercia TMBr; alia K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-2.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">165</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so RHk;</hi> uice <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus RHk; uice the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_25-2.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">165</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so RT;</hi> -bat <hi rend="italic">K;</hi> habet <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus RT; -bat K; habet MHkBr</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_25-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">107</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Dieser Satz richtet sich nicht ans ganze Volk, sondern an den Adel allein, denn nur bei ihm betrug, wie hier vorausgesetzt wird, das Wergeld mehr als 5 £ (beim Ceorl nur 4 £). Gemeint sind also Thegnas, die als Richter und Bezirksregenten die Staatsverwaltung besorgen</seg><seg type="translation" xml:lang="en" source="#claude">This clause is addressed not to the whole people but to the nobility alone, for only among them was the wergild, as is presupposed here, more than 5 £ (for the ceorl only 4 £). What is meant, therefore, is thegns who carry on the administration of the state as judges and governors of districts</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_25-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">107</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Im Ggs. zum Nichtausführen in 25 steht hier mit stark geschärfter Strafe Widerstand gegen das Gesetz; <hi rend="italic">s. d. Gl</hi> 21—d; Rückfall 6. Auch bei Cnut tritt diese Drohung dicht vor dem Epilog auf; dort steht statt <hi rend="italic">gan of</hi> (das Cn 1020, 9 beibehält) klarer II Cn 83 <hi rend="italic">wierdan,</hi> worunter Hn richtig ‘verkehren, verdrehen, stürzen, absichtlich widerstehn’ versteht</seg><seg type="translation" xml:lang="en" source="#claude">In contrast to the failure to carry out in 25, what is in question here, with a sharply increased penalty, is resistance to the law; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 21—d; Rückfall 6. In Cnut too this threat occurs just before the epilogue; there, instead of <hi rend="italic">gan of</hi> (which Cn 1020, 9 retains), II Cn 83 has the clearer <hi rend="italic">wierdan,</hi> which Hn rightly understands as ‘pervert, distort, overthrow, deliberately resist’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_25-2.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">107</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Das ‘Königsschutz’ (<hi rend="italic">s. d. Gl</hi> 8) heissende Strafgeldfixum</seg><seg type="translation" xml:lang="en" source="#claude">The fixed fine called ‘king’s protection’ (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 8)</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_25-2.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">107</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Die Friedlosigkeit (<hi rend="italic">s. d. Gl</hi> 10 b) drückte ebenso als Huldentziehung aus, mit Vermögenseinziehung (<hi rend="italic">s. d. Gl</hi> 10 o), II Ew 5, 1; <hi rend="italic">s. o.</hi> 20, 7²</seg><seg type="translation" xml:lang="en" source="#claude">Outlawry (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 10 b) was likewise expressed as withdrawal of favour, with confiscation of property (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 10 o), II Ew 5, 1; see above 20, 7²</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIAs_25-2.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">209</biblScope></bibl><seg type="original" xml:lang="en">Five pounds is a sum greater than the wergeld of a commoner (200 shillings), so the law can refer only to people of a higher social rank.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_25-2.attnote.fn.19" n="19" source="#attenborough"><bibl><biblScope unit="page">140</biblScope></bibl><label>ealles</label><seg type="original" xml:lang="en"><hi rend="italic">ealle</hi>. Ld.</seg></note>
      </div>
