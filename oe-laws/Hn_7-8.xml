    <body>
      <div type="clause" n="7.8">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 7.8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 7.8" corresp="#wit-lat"><pb n="554" ed="#liebermann"/>Idem in hundreto<ptr type="liebermannNote" n="1" target="#Hn_7-8.lnote.oe.1"/> decreuimus<ptr type="liebermannNote" n="a" target="#Hn_7-8.lnote.oe.a"/> obseruandum de locis et uicibus et<ptr type="liebermannNote" n="2" target="#Hn_7-8.lnote.oe.2"/> iudicum<ptr type="liebermannNote" n="3" target="#Hn_7-8.lnote.oe.3"/> obseruantiis, de causis singulorum iustis examinacionibus audiendis, de domini et dapiferi, uel sacerdotis et<ptr type="liebermannNote" n="4" target="#Hn_7-8.lnote.oe.4"/> prepositi et meliorum<ptr type="liebermannNote" n="5" target="#Hn_7-8.lnote.oe.5"/> hominum presencia.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 554 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-8.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus der autoritativen Form folgt nicht, dass ein Königsgesetz vorlag; Verf. braucht solchen Stil auch sonst, wo er nur sich selbst meint oder was als Gewohnheitsrecht unter seinen Collegen galt</hi></seg><seg type="translation" xml:lang="en" source="#claude">it does not follow from the authoritative form that a royal law lay before him; the author uses this style elsewhere too, where he means only himself or what was accepted as customary law among his colleagues</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-8.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> -edo <hi rend="italic">Sc,</hi> -edo <hi rend="italic">meist Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">altered -edo Sc, -edo mostly Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-8.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-8.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de">-cium <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cium Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-8.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-8.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. vom Schreiber aus</hi> -ribus <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the scribe from -ribus Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-8.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">316</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl Gl</hi> Hundred 31b. c</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Hundred 31b. c</seg></note>
      </div>
