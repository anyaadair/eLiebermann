      <div type="clause" n="28">
        <head><ref type="lawCode" target="law:Af">Af</ref> 28</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="28" corresp="#wit-e"><pb n="66" ed="#liebermann"/>XXVIII. Gif mon swa geradne mon<ptr type="liebermannNote" n="6" target="#Af_28.lnote.oe.6"/> ofslea, gif he mægas<ptr type="liebermannNote" n="18" target="#Af_28.lnote.oe.18"/> nage, gielde<ptr type="liebermannNote" n="19" target="#Af_28.lnote.oe.19"/> mon<ptr type="liebermannNote" n="6" target="#Af_28.lnote.oe.6"/> healfne<ptr type="liebermannNote" n="20" target="#Af_28.lnote.oe.20"/> cyninge, healfne þa<hi rend="italic">m<ptr type="liebermannNote" n="21" target="#Af_28.lnote.oe.21"/></hi> gegildan.<ptr type="liebermannNote" n="17" target="#Af_28.lnote.oe.17"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="28" corresp="#wit-h"><pb n="66" ed="#liebermann"/>XXVIII. Gif mon<ptr type="liebermannNote" n="2" target="#Af_28.lnote.oe.2"/> swa geradne mon<ptr type="liebermannNote" n="2" target="#Af_28.lnote.oe.2"/> ofslea, gif he magas nage, gilde man<ptr type="liebermannNote" n="6" target="#Af_28.lnote.oe.6-2"/> healfne (were<ptr type="liebermannNote" n="9" target="#Af_28.lnote.oe.9"/> þam) cyninge, healfne ðam gegildan.<ptr type="liebermannNote" n="10" target="#Af_28.lnote.oe.10"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="28" corresp="#wit-b-no-prol"><pb n="67" ed="#liebermann"/>Gyf mon swa geradne man ofsléa, gyf he magas nage, gylde man healfe kyninge, healfne þam gegyldan.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="28" corresp="#wit-q"><pb n="67" ed="#liebermann"/>Si quis occidatur huiusmodi, si<ptr type="liebermannNote" n="12" target="#Af_28.lnote.oe.12"/> parentes non habeat, soluatur<ptr type="liebermannNote" n="13" target="#Af_28.lnote.oe.13"/> medietas<ptr type="liebermannNote" n="14" target="#Af_28.lnote.oe.14"/> compositionis regi<ptr type="liebermannNote" n="15" target="#Af_28.lnote.oe.15"/>, medietas congildonibus.<ptr type="liebermannNote" n="16" target="#Af_28.lnote.oe.16"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="76" ed="#attenborough"/>Gif mon swa geradne mon ofslea, gif he mægas nage, gielde mon healfne<ptr type="editorNote" n="25" target="#Af_28.attnote.fn.25"/> [were þam]<ptr type="editorNote" n="26" target="#Af_28.attnote.fn.26"/> cyninge, healfne þam gegildan.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="32.2" corresp="#wit-e"><pb n="324" ed="#jurasinski-and-oliver"/>{XXVIII} Gif mon swa geradne mon ofslea, gif he mægas nage, gielde mon healfne cyninge, healfne þa<hi rend="italic">m</hi> gegildan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="67" ed="#liebermann"/>Wenn man einen so beschaffenen Menschen erschlägt, [nämlich] wenn er keine Sippe hat, zahle man den halben<ptr type="liebermannNote" n="1" target="#Af_28.lnote.de.1"/> dem Könige<ptr type="liebermannNote" n="2" target="#Af_28.lnote.de.2"/>, den [anderen] halben den Gildegenossen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a person of that kind is slain, [namely] if he has no kin, let half be paid to the king, the [other] half to the guild-brothers.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="77" ed="#attenborough"/>If a man in this position is slain–if he has no relatives– half the wergeld shall be paid to the king, and half to his associates.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="414" ed="#whitelock"/>If anyone kills a man so placed, if he has no kinsmen, he is to pay half to the king, half to the associates.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="325" ed="#jurasinski-and-oliver"/>If someone kills a man in this condition – that is, he has no kin – let him pay half to the king and half to the associates.</ab>
        <note type="translator" source="#whitelock">Whitelock numbers this chapter 28 and gives Liebermann’s number, 28, in brackets.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_28.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">man <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">man Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_28.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">magas <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">magas So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_28.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">gyld <hi rend="italic">So;</hi> gylde <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gyld So; gylde Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_28.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">healf cyning <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">healf cyning Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_28.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">þa <hi rend="italic">So;</hi> ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þa So; ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_28.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">gegyl. <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gegyl. So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_28.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_28.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_28.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">w. þ. <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">w. þ. written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_28.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">an <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">an on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_28.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">67</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> <hi rend="spaced">qui</hi> <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Lond; <hi rend="italic">qui</hi> the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_28.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">67</biblScope></bibl><seg type="original" xml:lang="de">comp. med. so. <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">comp. med. so. Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_28.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">67</biblScope></bibl><seg type="original" xml:lang="de">c. m. <hi rend="italic">T Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. m. T Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_28.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">67</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_28.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">67</biblScope></bibl><seg type="original" xml:lang="de">et gil. <hi rend="italic">Hk;</hi> gil. <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">et gil. Hk; gil. Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_28.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Ergänze mit H cor. ‘Mann’ oder ‘Wergeld’</seg><seg type="translation" xml:lang="en" source="#claude">Supply, with H cor., ‘man’ or ‘wergild’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_28.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Sippe 26b. 29d; Genossenschaft 3—4; Fremde 5; König 14</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Sippe 26b. 29d; Genossenschaft 3—4; Fremde 5; König 14</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_28.attnote.fn.25" n="25" source="#attenborough"><bibl><biblScope unit="page">76</biblScope></bibl><label>healfne</label><seg type="original" xml:lang="en"><hi rend="italic">healfe</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_28.attnote.fn.26" n="26" source="#attenborough"><bibl><biblScope unit="page">76</biblScope></bibl><label>þam</label><seg type="original" xml:lang="en">H*.</seg></note>
