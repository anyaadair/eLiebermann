    <body>
      <div type="clause" n="46.2">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 46.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="46.2" corresp="#wit-g-a"><pb n="344" ed="#liebermann"/>Gif hit þeowman gedó, þolige his hyde oððe<ptr type="liebermannNote" n="11" target="#IICn_46-2.lnote.oe.11"/> hydgyldes, be þam þe seo dæd<ptr type="liebermannNote" n="3" target="#IICn_46-2.lnote.oe.3"/> sy.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="46.2" corresp="#wit-b"><pb n="344" ed="#liebermann"/>Gyf hit ðeowman gedó, ðolie his hyde oððe hydgyldes, be ða<hi rend="italic">m</hi> ðe seo dæd sy.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="46.2" corresp="#wit-a"><pb n="344" ed="#liebermann"/>Gif hit þeowman gedo, þolige his hyde, be þa<hi rend="italic">m</hi> þe seo dæde sy.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="46.2" corresp="#wit-q"><ptr type="liebermannNote" n="4" target="#IICn_46-2.lnote.oe.4"/><pb n="345" ed="#liebermann"/>Si seruus hoc efficiat<ptr type="liebermannNote" n="5" target="#IICn_46-2.lnote.oe.5"/>, corium suum amittat, sicut factum est.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="46.2" corresp="#wit-cons-cn"><pb n="345" ed="#liebermann"/>[46, 2] Quod si seruus faciat, amittat cutem aut cutis redempcionem iuxta facti qualitatem.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="46.2" corresp="#wit-b"><pb n="198" ed="#robertson"/>Gyf hit ðeowman gedó, ðolie his hyde oððe hydgyldes<ptr type="editorNote" n="12" target="#IICn_46-2.robnote.fn.12"/>, be ðam ðe seo dæd sy.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="280" ed="#rabin-doml"/>Gif hit þeowman gedo, þolige his hyde oððe hydgyldes, be þam þe seo dæd sy.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="344" ed="#liebermann"/>Wenn das ein Unfreier thut, verliere er seine Haut<ptr type="liebermannNote" n="1" target="#IICn_46-2.lnote.de.1"/> [erhalte Prügel] oder Hautgeld, je nachdem die That ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a slave does it, let him lose his hide [be flogged] or [pay] hide-money, according to what the deed is.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_46-2.robnote.n.1"/><pb n="199" ed="#robertson"/>If a slave does so, he shall undergo the lash or pay the fine in lieu thereof, in accordance with the nature of the deed.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><ptr type="editorNote" n="3" target="#IICn_46-2.whinote.n.3"/><pb n="469" ed="#whitelock"/>If a slave do it, he is to suffer a flogging or redeem himself from one, in proportion to the deed.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="281" ed="#rabin-doml"/>If a slave does so, he shall suffer the lash or pay a fine in its stead, according to the nature of the deed.</ab>
        <note type="comparison" source="#liebermann" n="344"><ref target="clause:EGu_8">EGu 8</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd.</note>
        <note type="comparison" source="#wormald-mel" n="359"><label>quoted verbatim (bold in Wormald's table)</label> <ref target="clause:EGu_8">EGu 8</ref> <quote>Table 5.4, II Cn 46:2: EGu 8</quote></note>
        <note type="editorial">A and Ld lack ‘oððe hydgyldes’. Liebermann compares EGu 8.; BR: added from Gesetze I p. 345, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">oððe hydgyldes: omitted A</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_46-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">345</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Dm unterstreicht diese Form von</hi> 46, 2 <hi rend="italic">roth</hi> [<hi rend="italic">weil schon vor</hi> 46, 1]; <hi rend="italic">sie fehlt T Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Dm underlines this form of 46, 2 in red [because it already stands before 46, 1]; it is lacking in T Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_46-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">345</biblScope></bibl><seg type="original" xml:lang="de">faciat <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">faciat K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_46-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">344</biblScope></bibl><seg type="original" xml:lang="de">o. h. <hi rend="italic">fehlt Ld</hi> [<hi rend="italic">wie A</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">o. h. lacking in Ld [as in A]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_46-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">344</biblScope></bibl><seg type="original" xml:lang="de">dæde sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">dæde sy Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_46-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">208</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Ebenso VII Atr 2, 4.—Zum Zusatze <hi rend="italic">s. o</hi>. 43¹</seg><seg type="translation" xml:lang="en" source="#claude">Likewise VII Atr 2, 4. — On the addition <hi rend="italic">see above</hi> 43¹</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_46-2.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">357</biblScope></bibl><seg type="original" xml:lang="en">Cf. <hi rend="italic">ibid.</hi>; VII Atr. 2, 4.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_46-2.robnote.fn.12" n="12" source="#robertson"><bibl><biblScope unit="page">198</biblScope></bibl><label>hydgyldes</label><seg type="original" xml:lang="en"><hi rend="italic">o. h.</hi> om. A, Ld.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IICn_46-2.whinote.n.3" n="3" source="#whitelock"><bibl><biblScope unit="page">469</biblScope></bibl><label>46.2</label><seg type="original" xml:lang="en">from ibid.</seg></note>
      </div>
    </body>
