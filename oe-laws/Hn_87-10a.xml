      <div type="clause" n="87.10a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 87.10a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 87.10a" corresp="#wit-lat"><pb n="602" ed="#liebermann"/>Que lex usque<ptr type="liebermannNote" n="21" target="#Hn_87-10a.lnote.oe.21"/> ad VII, qu[i<ptr type="liebermannNote" n="22" target="#Hn_87-10a.lnote.oe.22"/>] fuerint in conuiuio illo, conuenit<ptr type="liebermannNote" n="23" target="#Hn_87-10a.lnote.oe.23"/> obseruari.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 602 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-10a.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">doppelt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">written twice Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-10a.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">que <hi rend="italic">Sc Hg;</hi> si <hi rend="italic">übr.;</hi> qui <hi rend="italic">Sp. s. v.</hi> lex Salica, <hi rend="italic">geb. aus Sal.</hi></seg><seg type="translation" xml:lang="en" source="#claude">que Sc Hg; si the rest; qui Sp. s. v. lex Salica, emended from Sal.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-10a.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">conu. — illo <hi rend="italic">überspringt K Co Or Gi; steht in Sp.</hi></seg><seg type="translation" xml:lang="en" source="#claude">conu. — illo omitted by K Co Or Gi; present in Sp.</seg></note>
      </div>
