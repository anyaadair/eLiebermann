    <body>
      <div type="clause" n="9">
        <head><ref type="lawCode" target="law:QuadrArg">Quadr Arg</ref> 9</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Arg 9" corresp="#wit-lat"><pb n="533" ed="#liebermann"/>Tandem<ptr type="liebermannNote" n="d" target="#QuadrArg_9.lnote.oe.d"/> reuocato Eadwardo, Aðelredi<ptr type="liebermannNote" n="10" target="#QuadrArg_9.lnote.oe.10"/> regis filio, mediante Alwino<ptr type="liebermannNote" n="e" target="#QuadrArg_9.lnote.oe.e"/> Wintoniensi episcopo et Godwino comite, conuocatis apud Hursteshevet<ptr type="liebermannNote" n="f" target="#QuadrArg_9.lnote.oe.f"/><ptr type="liebermannNote" n="11" target="#QuadrArg_9.lnote.oe.11"/> totius Angliæ baronibus, ita demum in regem suscipiendus auditur, si<ptr type="liebermannNote" n="g" target="#QuadrArg_9.lnote.oe.g"/> eis Cnudi leges et filiorum eius inconuulsa stabilitate suo tempore mansuras iuramenti satisfactione sanciret.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 533 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_9.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">533</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verf. setzt irrig Eadwards III. Rückkehr nach Harthacnuts Tod</hi></seg><seg type="translation" xml:lang="en" source="#claude">The author wrongly places Eadward III’s return after Harthacnut’s death</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_9.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">533</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ælfwine</hi> 1032—47: <hi rend="italic">glaublich</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ælfwine 1032—47: credible</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_9.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">533</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">‘East Horstead, on the road to Lewes’; Y. Powell</hi> Engl. hist. rev. 1893, 333. Little Horsted <hi rend="italic">und</hi> Horsted Keynes <hi rend="italic">bei Uckfield heissen im</hi> Domesday I 22 <hi rend="italic">beide</hi> Horstede</seg><seg type="translation" xml:lang="en" source="#claude">‘East Horstead, on the road to Lewes’; Y. Powell Engl. hist. rev. 1893, 333. Little Horsted and Horsted Keynes near Uckfield are both called Horstede in Domesday I 22</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_9.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">533</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">der Eid auf Cnuts Recht ist glaublich; vgl. o.</hi> 1&lt;sup&gt;f&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude">the oath to Cnut’s law is credible; cf. above 1&lt;sup&gt;f&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_9.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">533</biblScope></bibl><seg type="original" xml:lang="de">Athel. <hi rend="italic">T;</hi> Ethel. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Athel. T; Ethel. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_9.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">533</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so T;</hi> Hurt. <hi rend="italic">Dm;</hi> Hiert. <hi rend="italic">Co;</hi> Hurtesheved <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus T; Hurt. Dm; Hiert. Co; Hurtesheved Hk</seg></note>
      </div>
