    <body>
      <div type="clause" n="64.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 64.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="64.1" corresp="#wit-e"><pb n="84" ed="#liebermann"/>Gif hit sie<ptr type="liebermannNote" n="4" target="#Af_64-1.lnote.oe.4"/> sio æfterre ta, XV scill. to bote geselle<ptr type="liebermannNote" n="5" target="#Af_64-1.lnote.oe.5"/> him mon.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="64.1" corresp="#wit-h"><pb n="84" ed="#liebermann"/>Gif seo<ptr type="liebermannNote" n="5" target="#Af_64-1.lnote.oe.5-2"/> æftere tá sy<ptr type="liebermannNote" n="3" target="#Af_64-1.lnote.oe.3"/> ofaslægen, gesylle<ptr type="liebermannNote" n="3" target="#Af_64-1.lnote.oe.3"/> him mon<ptr type="liebermannNote" n="4" target="#Af_64-1.lnote.oe.4-2"/> XV scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="64.1" corresp="#wit-b-no-prol"><pb n="84" ed="#liebermann"/>Gyf hit séo æftere tá sy, fiftene scill' to bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="64.1" corresp="#wit-q"><pb n="85" ed="#liebermann"/>Si secundus articulus sit, XV solid. emendetur;</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="90" ed="#attenborough"/>Gif hit sie sio æfterre ta<ptr type="editorNote" n="2" target="#Af_64-1.attnote.fn.2"/>, XV scill. to bote geselle him mon.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="67.1" corresp="#wit-e"><pb n="358" ed="#jurasinski-and-oliver"/>Gif hit sie sio æfterre ta, XV scill to bote geselle him mon.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="85" ed="#liebermann"/>Wenn es die zweite Zehe<ptr type="liebermannNote" n="1" target="#Af_64-1.lnote.de.1"/> ist, gebe man ihm 15 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If it is the second toe, let him be given 15 shillings as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="91" ed="#attenborough"/>If it is the second toe [which is struck off], 15 shillings shall be given to him as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="359" ed="#jurasinski-and-oliver"/>If it is the next toe, let him be given 15 shillings as compensation.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_64-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">sy seo æftere tá, fiftyne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy seo æftere tá, fiftyne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_64-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">g. h. m. <hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">g. h. m. lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_64-1.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_64-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_64-1.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_64-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘abgehauen’ fügt H hinzu</seg><seg type="translation" xml:lang="en" source="#claude">H adds ‘cut off’</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_64-1.attnote.fn.2" n="2" source="#attenborough"><bibl><biblScope unit="page">90</biblScope></bibl><label>ta</label><seg type="original" xml:lang="en"><hi rend="italic">Gif seo æftere ta sy ofaslægen</hi>. H.</seg></note>
      </div>
