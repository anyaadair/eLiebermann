      <div type="clause" n="88.9">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 88.9</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 88.9" corresp="#wit-lat"><pb n="603" ed="#liebermann"/>Qui<ptr type="liebermannNote" n="h" target="#Hn_88-9.lnote.oe.h"/> aliquem<ptr type="liebermannNote" n="i" target="#Hn_88-9.lnote.oe.i"/> rogauerit<ptr type="liebermannNote" n="k" target="#Hn_88-9.lnote.oe.k"/>, ut secum in opus suum eat, et interim occidatur<ptr type="liebermannNote" n="i" target="#Hn_88-9.lnote.oe.i"/> a suis<ptr type="liebermannNote" n="l" target="#Hn_88-9.lnote.oe.l"/><ptr type="liebermannNote" n="17" target="#Hn_88-9.lnote.oe.17"/> uel<ptr type="liebermannNote" n="18" target="#Hn_88-9.lnote.oe.18"/> eius inimicis, reddat<ptr type="liebermannNote" n="m" target="#Hn_88-9.lnote.oe.m"/> eum, (in<ptr type="liebermannNote" n="19" target="#Hn_88-9.lnote.oe.19"/>) cuius<ptr type="liebermannNote" n="20" target="#Hn_88-9.lnote.oe.20"/> hortatu et gratia in locum mortis uenerit<ptr type="liebermannNote" n="i" target="#Hn_88-9.lnote.oe.i"/>; et conscientie uel consensus in aliquo se acquietet<ptr type="liebermannNote" n="h" target="#Hn_88-9.lnote.oe.h"/>, si fuerit accusatus: et hoc werelada.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 603 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verklagter gemeint</hi></seg><seg type="translation" xml:lang="en" source="#claude">the accused is meant</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Erschlagener gemeint</hi></seg><seg type="translation" xml:lang="en" source="#claude">the slain man is meant</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 90, 6<hi rend="italic">b</hi>. <hi rend="italic">Bitten und Miethen macht laut</hi> 88, 9<hi rend="italic">a den Arbeitgeber haftbar; Frank</hi> Casuelle Tödtung 55. <hi rend="italic">Als Tödter haftet noch der, ohne dessen Handlung Getödteter vielleicht noch lebte, und zwar mit Wergeld des Erschlagenen; Pollock and Maitland</hi> HEL. II 469</seg><seg type="translation" xml:lang="en" source="#claude">cf. 90, 6<hi rend="italic">b</hi>. According to 88, 9<hi rend="italic">a</hi>, asking and hiring make the employer liable; Frank Casuelle Tödtung 55. The man without whose act the slain man might perhaps still be alive is still liable as the slayer, and indeed with the wergild of the slain man; Pollock and Maitland HEL. II 469</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hiernach gälte gleich, ob die Fehde gegen den Arbeiter oder den Auftraggeber ging; im ersteren Falle kann dagegen dieser frei ausgehen nach</hi> 88, 9<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">on this view it would make no difference whether the feud was directed against the workman or against the employer; in the former case, however, the latter may go free according to 88, 9<hi rend="italic">b</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 70, 12<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 70, 12<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert aus</hi> seruis <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected from seruis Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">u. e. <hi rend="italic">fehlt K Co Or Gi; dafür</hi> a suis <hi rend="italic">nochmals K</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. e. lacking in K Co Or Gi; instead K has a suis again</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht in Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">not in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">cum or. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">cum or. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-9.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Blutrache 5f; Absicht 7d—<hi rend="italic">in</hi>{13}—<hi rend="italic">wercrada</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Blutrache 5f; Absicht 7d—<hi rend="italic">in</hi>{13}—<hi rend="italic">wercrada</hi> Rs</seg></note>
      </div>
