      <div type="clause" n="83.7">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 83.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 83.7" corresp="#wit-lat"><pb n="600" ed="#liebermann"/>Si inter aliquos de rebus repentinis uerborum<ptr type="liebermannNote" n="19" target="#Hn_83-7.lnote.oe.19"/> dicacitate<ptr type="liebermannNote" n="20" target="#Hn_83-7.lnote.oe.20"/> uel euentus aliqua procacitate dissensio consurgat, ex quo aliquis eorum gladium scogilatum<ptr type="liebermannNote" n="i" target="#Hn_83-7.lnote.oe.i"/><ptr type="liebermannNote" n="21" target="#Hn_83-7.lnote.oe.21"/> euaginat, non est<ptr type="liebermannNote" n="22" target="#Hn_83-7.lnote.oe.22"/> expectandum etiam, ut percuciat<ptr type="liebermannNote" n="k" target="#Hn_83-7.lnote.oe.k"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 600 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-7.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">von der Scheide bedeckt; <hi rend="italic">vgl. Lex Ribuar.</hi> 36, 11</seg><seg type="translation" xml:lang="en" source="#claude">covered by the scabbard; cf. Lex Ribuar. 36, 11</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-7.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">früher musste Beklagter Empfang eines Hiebes nachweisen zur Präsumtion der Nothwehr, welche Bedingung auch in Deutschland später fortfiel; Levita</hi> 76; <hi rend="italic">Bar</hi> Beweisurtheil 87</seg><seg type="translation" xml:lang="en" source="#claude">formerly the defendant had to prove that he had received a blow in order for self-defence to be presumed, a condition which in Germany too later lapsed; Levita 76; Bar Beweisurtheil 87</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-7.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">d. u. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. u. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-7.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">uerborum <hi rend="italic">nochmals Co Or</hi>; dec. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">uerborum again Co Or; dec. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-7.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">sconiga. <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">sconiga. K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-7.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">etiam ex. etiam <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">etiam ex. etiam Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-7.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Waffenzücken 5—<hi rend="italic">sconigatum</hi>{21}—84 <hi rend="italic">De</hi>{24} <hi rend="italic">u</hi>. fehlt. Am Rande spät: <hi rend="italic">De pugnantibus, et qualiter rei censendi sunt</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Waffenzücken 5—<hi rend="italic">sconigatum</hi>{21}—84 <hi rend="italic">De</hi>{24} <hi rend="italic">u</hi>. missing. In the margin, in a late hand: <hi rend="italic">De pugnantibus, et qualiter rei censendi sunt</hi> Rs</seg></note>
      </div>
