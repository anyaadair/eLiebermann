        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-1a.lnote.la.fn.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">Monat und Tag <hi rend="italic">o.</hi> 15, 1; <hi rend="italic">u.</hi> 23, 2; Leis Wl 3</seg><seg type="translation" xml:lang="en" source="#claude">a month and a day, above 15, 1; below 23, 2; Leis Wl 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-1a.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">aff. <hi rend="italic">Hr;</hi> fugerent <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">aff. Hr; fugerent S</seg></note>
