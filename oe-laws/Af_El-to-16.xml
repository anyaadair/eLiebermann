      <div type="clause" n="El. 16">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 16</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 16" corresp="#wit-e"><pb n="32" ed="#liebermann"/>Gif hwa slea his ðone nehstan mid stane oððe mid fyste, ⁊ he þeah utgongan mæge bi<ptr type="liebermannNote" n="1" target="#Af_El-to-16.lnote.oe.1"/> stafe, begite<ptr type="liebermannNote" n="2" target="#Af_El-to-16.lnote.oe.2"/> him læce ⁊ wyrce his weorc<ptr type="liebermannNote" n="3" target="#Af_El-to-16.lnote.oe.3"/> ða hwile þe he self<ptr type="liebermannNote" n="4" target="#Af_El-to-16.lnote.oe.4"/> ne mæge.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 16" corresp="#wit-g-prol-only"><pb n="32" ed="#liebermann"/>Gif hwa slea his ðone nehstan mid stane oððe mid fyste, ⁊ he ðeah útgangan<ptr type="liebermannNote" n="1" target="#Af_El-to-16.lnote.oe.1-3"/> mage be stæfe, begyte hi<hi rend="italic">m</hi> læce ⁊ wyrce his weorc ða hwile þe he sylf ne mæge.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 16" corresp="#wit-h"><pb n="33" ed="#liebermann"/>Gif hwa slea hys þone nyhstan mid stane oððe mid fyste, ⁊ he þeah uttgangan mæge be stæfe, begyte him læce ⁊ wyrce his weorc þa hwyle þe he sylf ne mæge.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 16" corresp="#wit-q"><pb n="33" ed="#liebermann"/>Si rixati fuerint viri et percusserit alter proximum suum lapide uel pugno, et ille mortuus non fuerit, sed iacuerit in lectulo, si surrexerit et ambulauerit foris super baculum suum, innocens erit qui percusserit, ita tamen ut opera<ptr type="liebermannNote" n="1" target="#Af_El-to-16.lnote.oe.1-2"/> eius et impensas in medicos restituat.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 16" corresp="#wit-e"><pb n="238" ed="#jurasinski-and-oliver"/>Gif hwa slea his ðone nehstan mid stane oððe mid fyste, ⁊ he þeah utgongan mæge bi stafe, begite him læce ⁊ wyrce his weorc ða hwile þe he self ne mæge.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="33" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_El-to-16.lnote.de.1"/> jemand seinen Nächsten mit Stein oder Faust schlägt, und dieser dennoch am Stabe auszugehen vermag, so verschaffe er ihm einen Arzt<ptr type="liebermannNote" n="2" target="#Af_El-to-16.lnote.de.2"/> und thue jenes [Verletzten] Arbeit, die Zeit über, da dieser selbst nicht kann.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone strikes his neighbour with a stone or a fist, and the latter can nevertheless go out with a staff, let him get him a physician and do that [injured man’s] work for the time during which he himself cannot.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="239" ed="#jurasinski-and-oliver"/>If someone should strike his neighbor with a stone or a fist, and he may nonetheless go out with a staff, let him obtain for him a physician and perform his work in the time that he himself may not.</ab>
        <note type="passageSource">Exodus 21,18–19</note>
        <note type="comparison" source="#liebermann" n="33">Exodus 21.18; Exodus 21.19</note>
        <note type="comparisonPrinted" source="#liebermann">[Exodus 21, 18] | [21, 19]</note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="237"><ref target="clause:Af_El-to-13">Af El 13</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-16.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">32</biblScope></bibl><seg type="original" xml:lang="de">by <hi rend="italic">So;</hi> be <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">by So; be Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-16.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">32</biblScope></bibl><seg type="original" xml:lang="de">begyte <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">begyte Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-16.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">32</biblScope></bibl><seg type="original" xml:lang="de">-ce <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ce So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-16.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">32</biblScope></bibl><seg type="original" xml:lang="de">sylf <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sylf So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-16.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">33</biblScope></bibl><seg type="original" xml:lang="de">operas <hi rend="italic">Vulg.</hi></seg><seg type="translation" xml:lang="en" source="#claude">operas Vulg.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-16.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">32</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert aus</hi> -gen</seg><seg type="translation" xml:lang="en" source="#claude">corrected from -gen</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-16.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">45</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Glieder- oder Wundenbusse des Agsä. Rechts fehlt hier</seg><seg type="translation" xml:lang="en" source="#claude">The compensation of A.-S. law for limbs or wounds is lacking here</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-16.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">45</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Arzt, Arbeit</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Arzt, Arbeit</seg></note>
      </div>
