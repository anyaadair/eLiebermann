    <body>
      <div type="clause" n="31">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 31</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 31"><pb n="653" ed="#liebermann"/><hi rend="bold"><hi rend="spaced">De</hi></hi><ptr type="liebermannNote" n="20" target="#ECfRetr_31.lnote.la.20"/> <hi rend="bold"><hi rend="spaced">trehingis</hi></hi><ptr type="liebermannNote" n="21" target="#ECfRetr_31.lnote.la.21"/> <hi rend="bold"><hi rend="spaced">et wapentagiis</hi></hi><ptr type="liebermannNote" n="22" target="#ECfRetr_31.lnote.la.22"/> <hi rend="bold"><hi rend="spaced">et hundredis. (Quid sit</hi></hi><ptr type="liebermannNote" n="23" target="#ECfRetr_31.lnote.la.23"/> <hi rend="bold"><hi rend="spaced">wapentagium et</hi></hi><ptr type="liebermannNote" n="24" target="#ECfRetr_31.lnote.la.24"/> <hi rend="bold"><hi rend="spaced">trihingum</hi></hi><ptr type="liebermannNote" n="25" target="#ECfRetr_31.lnote.la.25"/> <hi rend="bold"><hi rend="spaced">et hundredum.)</hi></hi> Erant etiam<ptr type="liebermannNote" n="26" target="#ECfRetr_31.lnote.la.26"/> alie potestates super wapentagia<ptr type="liebermannNote" n="27" target="#ECfRetr_31.lnote.la.27"/>, quas trehingas<ptr type="liebermannNote" n="28" target="#ECfRetr_31.lnote.la.28"/> <hi rend="bold">dicebant, quod erat</hi> tertia<ptr type="liebermannNote" n="29" target="#ECfRetr_31.lnote.la.29"/> pars<ptr type="liebermannNote" n="15" target="#ECfRetr_31.lnote.la.15"/> prouincie.</ab>
        <note type="comparison" source="#liebermann" n="653"><label>printed alongside</label> <ref target="clause:ECf_31">ECf 31</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 653 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Aspiration der Initiale, aus Nord.</hi> þriðjungr, <hi rend="italic">in einigen Hss. an mehreren Stellen, stand im Orig. vielleicht stets</hi></seg><seg type="translation" xml:lang="en" source="#claude">the aspiration of the initial, from Norse þriðjungr, in some MSS in several places, perhaps stood always in the original</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Grafschaft; vgl.</hi> 5, 3. 9</seg><seg type="translation" xml:lang="en" source="#claude">shire; cf. 5, 3. 9</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Pl S;</hi> De t. et ledis <hi rend="italic">Lond;</hi> De aliis potestatibus <hi rend="italic">Cb;</hi> Quid—hundr. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Pl S; De t. et ledis Lond; De aliis potestatibus Cb; Quid—hundr. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">-ges <hi rend="italic">Lond;</hi> -gges <hi rend="italic">Pl;</hi> treinges <hi rend="italic">S;</hi> trihingis <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ges Lond; -gges Pl; treinges S; trihingis Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">-achiis <hi rend="italic">Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-achiis Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">inter <hi rend="italic">fügt zu Lb Va Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Lb Va Hv add inter</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">quid thenges, quid hu. <hi rend="italic">Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">quid thenges, quid hu. Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">-gam <hi rend="italic">Hv;</hi> trihengum <hi rend="italic">Lb Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gam Hv; trihengum Lb Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">enim, <hi rend="italic">am Rande Corrector:</hi> etiam <hi rend="italic">Cb;</hi> et <hi rend="italic">fügt zu Cb Lb Va Lond Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">enim, in the margin a corrector: etiam Cb; Cb Lb Va Lond Ld add et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">-ium <hi rend="italic">Hv;</hi> -chia <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ium Hv; -chia Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">trihinges <hi rend="italic">Va;</hi> uocabant ðrihinges <hi rend="italic">Ld;</hi> trihenges <hi rend="italic">Lb Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">trihinges Va; uocabant ðrihinges Ld; trihenges Lb Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">quarta <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">quarta Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Concerning ridings and wapentakes and hundreds. (What a wapentake is, and a riding and a hundred.) There were also other authorities over the wapentakes, which they called <hi rend="italic">trehingas</hi> (ridings), which was the third part of the province.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">348</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Item de</hi><hi rend="superscript">26</hi> <hi rend="italic">tr. et ledis</hi> (ohne <hi rend="italic">wap.</hi><hi rend="superscript">22</hi> bis <hi rend="italic">hundredum</hi>). <hi rend="italic">Er. et.</hi><hi rend="superscript">20</hi> <hi rend="italic">et a.</hi> Rs.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Item de</hi><hi rend="superscript">26</hi> <hi rend="italic">tr. et ledis</hi> (without <hi rend="italic">wap.</hi><hi rend="superscript">22</hi> to <hi rend="italic">hundredum</hi>). <hi rend="italic">Er. et.</hi><hi rend="superscript">20</hi> <hi rend="italic">et a.</hi> Rs.</seg></note>
      </div>
    </body>
