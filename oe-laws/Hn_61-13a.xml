        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 61.13a" corresp="#wit-lat"><pb n="582" ed="#liebermann"/>Quodsi<ptr type="liebermannNote" n="10" target="#Hn_61-13a.lnote.oe.10"/> domino eius uideatur, ut iniuste quid actum sit<ptr type="liebermannNote" n="11" target="#Hn_61-13a.lnote.oe.11"/>, potest ad placiti principium<ptr type="liebermannNote" n="b" target="#Hn_61-13a.lnote.oe.b"/> reformare, siue suus<ptr type="liebermannNote" n="12" target="#Hn_61-13a.lnote.oe.12"/> homo susceperit uel non susceperit inde iudicium.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 582 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-13a.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> caput pl. 59, 7; <hi rend="italic">vgl.</hi> 61, 16</seg><seg type="translation" xml:lang="en" source="#claude">as caput pl. 59, 7; cf. 61, 16</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-13a.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">si <hi rend="italic">doppelt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">si twice Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-13a.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">est <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">est K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-13a.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">seruus [<hi rend="italic">aus Tw?</hi>] <hi rend="italic">Wh am Rande</hi></seg><seg type="translation" xml:lang="en" source="#claude">seruus [from Tw?] Wh in the margin</seg></note>
