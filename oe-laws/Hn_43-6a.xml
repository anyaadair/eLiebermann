      <div type="clause" n="43.6a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 43.6a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 43.6a" corresp="#wit-lat"><pb n="569" ed="#liebermann"/>Si multis homagium fecerit, et ab aliquo eorum captus et implacitatus sit, ille cuius residens et legius<ptr type="liebermannNote" n="l" target="#Hn_43-6a.lnote.oe.l"/><ptr type="liebermannNote" n="24" target="#Hn_43-6a.lnote.oe.24"/> est erga quoslibet alios iure<ptr type="liebermannNote" n="25" target="#Hn_43-6a.lnote.oe.25"/> potest eum plegiare, nec debet ei denegari qui manbotam<ptr type="liebermannNote" n="m" target="#Hn_43-6a.lnote.oe.m"/> inde haberet et cui ipse magis acquieuerit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 569 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-6a.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 61, 6<hi rend="italic">b</hi>. 55, 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. 61, 6b. 55, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-6a.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 82, 5</seg><seg type="translation" xml:lang="en" source="#claude">as 82, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-6a.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">lig. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lig. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-6a.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">i. p. <hi rend="italic">zweimal, doch unterpunctirt Sc; ebenso Hs. Harley</hi> 785 <hi rend="italic">f.</hi> 26<hi rend="italic">v</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. p. twice, but dotted for deletion Sc; likewise MS Harley 785 f. 26v</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-6a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Mannbusse 7—<hi rend="italic">ligius</hi>{24} ohne <hi rend="italic">est</hi>—<hi rend="italic">acquieret</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Mannbusse 7—<hi rend="italic">ligius</hi>{24} without <hi rend="italic">est</hi>—<hi rend="italic">acquieret</hi> Rs</seg></note>
