      <div type="clause" n="11.3">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 11.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 11.3"><pb n="637" ed="#liebermann"/>Quorum dum fieret collectio, clamabat<ptr type="liebermannNote" n="1" target="#ECf_11-3.lnote.la.1"/> ecclesia, libertatem<ptr type="liebermannNote" n="a" target="#ECf_11-3.lnote.la.fn.a"/> suam reposcens; sed nichil sibi<ptr type="liebermannNote" n="2" target="#ECf_11-3.lnote.la.2"/> profuit.</ab>
        <note type="comparison" source="#liebermann" n="637"><label>printed alongside</label> <ref target="clause:ECfRetr_11-3">ECf retr 11.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 637 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-3.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Berufung auf alte Freiheit erfindet wohl Verf. aus damaliger Gewohnheit, jede Belastung der Kirche von Wilhelm II. herzuleiten</hi></seg><seg type="translation" xml:lang="en" source="#claude">the appeal to ancient freedom is probably the author’s invention, from the habit of the time of tracing every burden on the Church back to William II</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-3.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">sancta <hi rend="italic">fügt zu Hk Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hk Ad Do add sancta</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-3.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">ei <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei Ad Do</seg></note>
      </div>
    </body>
