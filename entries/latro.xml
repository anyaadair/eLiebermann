        <dictScrap type="liebermann"><lbl type="language">L</lbl> <hi rend="bold">latro</hi> <hi rend="bold">1</hi>) ~ infra (extra) terminos proclamatus <ref type="lawCode" target="law:InCn">In Cn</ref> III 58,1 <hi rend="italic"><ref type="abbreviation" target="gram:aus"><abbr>aus</abbr></ref></hi> infangene þeof (utfangene þeof), <hi rend="italic"><ref type="abbreviation" target="gram:sieheDort"><abbr>s. d.</abbr></ref></hi> <hi rend="bold">2</hi>) ~ homicida <ref type="lawCode" target="law:IICn">II Cn</ref> 4a Cons, morðwyrhta <hi rend="italic"><ref type="abbreviation" target="gram:ubersetzend"><abbr>übsnd</abbr></ref></hi> [<hi rend="italic">um in</hi> morð <hi rend="italic">die Verstecktheit, <ref type="abbreviation" target="gram:imGegensatzZu"><abbr>im Ggs. zu</abbr></ref> offenem Totschlag, zu <ref type="abbreviation" target="gram:bezeichnen"><abbr>bezeichnen</abbr></ref></hi>] <hi rend="bold">3</hi>) in latronum loco sepelire <hi rend="italic">im Verbrecher-Schindanger begraben</hi> 33,1 <ref type="lawCode" target="law:InCn">In</ref>, on fulan lecgan <hi rend="italic"><ref type="abbreviation" target="gram:ubersetzend"><abbr>übsnd</abbr></ref></hi> [in loco ‘le Thiefdounes’ <hi rend="italic">begräbt die Stadt Sandwich im</hi> 15. <hi rend="italic"><ref type="abbreviation" target="gram:Jahrhundert"><abbr>Jh</abbr></ref>. Mörder lebendig; </hi><ref type="bibl" target="bib:CitBatesonBC"><hi rend="italic">Bateson,</hi> Borough customs I 74</ref>]</dictScrap>
        <dictScrap type="senses">
