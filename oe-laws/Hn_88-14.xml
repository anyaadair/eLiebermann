      <div type="clause" n="88.14">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 88.14</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 88.14" corresp="#wit-lat"><pb n="604" ed="#liebermann"/>Et nemo forisfaciat feodum<ptr type="liebermannNote" n="24" target="#Hn_88-14.lnote.oe.24"/> suum<ptr type="liebermannNote" n="d" target="#Hn_88-14.lnote.oe.d"/> legittimis<ptr type="liebermannNote" n="25" target="#Hn_88-14.lnote.oe.25"/> heredibus suis nisi propter feloniam<ptr type="liebermannNote" n="26" target="#Hn_88-14.lnote.oe.26"/> uel reddicionem<ptr type="liebermannNote" n="27" target="#Hn_88-14.lnote.oe.27"/> spontaneam.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 604 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-14.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">denke hinzu:</hi> (zum Nachtheil auch für)</seg><seg type="translation" xml:lang="en" source="#claude">understand in addition: (to the detriment also of)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-14.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> feud. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Lond; feud. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-14.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">l. h. s. <hi rend="italic">fehlt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">l. h. s. lacking in Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-14.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">felen. <hi rend="italic">Sc Hg öfter</hi></seg><seg type="translation" xml:lang="en" source="#claude">felen. Sc Hg, frequently</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-14.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">redi. <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">redi. K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-14.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Felonie 2; Lehnwesen 15; Erbgang 20—Am Rande spät: <hi rend="italic">Species exhered</hi>[<hi rend="italic">ationis?</hi>] <hi rend="italic">que prius hic nominatur</hi>—<hi rend="italic">feud</hi>.{24} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Felonie 2; Lehnwesen 15; Erbgang 20—In the margin, in a late hand: <hi rend="italic">Species exhered</hi>[<hi rend="italic">ationis?</hi>] <hi rend="italic">que prius hic nominatur</hi>—<hi rend="italic">feud</hi>.{24} Rs</seg></note>
