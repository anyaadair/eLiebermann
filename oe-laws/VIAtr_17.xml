  <text>
    <body>
      <div type="clause" n="17">
        <head><ref type="lawCode" target="law:VIAtr">VI Atr</ref> 17</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="17" corresp="#wit-k"><pb n="252" ed="#liebermann"/>K. ⁊ geogoðe teoþunge be pentecosten ⁊ eorðwæstma be ealra halgena mæssan</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="17" corresp="#wit-d-incomplete"><pb n="252" ed="#liebermann"/>⁊ geoguðe teoðunge be pentecosten ⁊ eorðwæstma be ealra halgene<ptr type="liebermannNote" n="1" target="#VIAtr_17.lnote.oe.1"/> mæssan</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="17" corresp="#wit-k"><pb n="96" ed="#robertson"/>⁊ geogoðe teoþunge be pentecosten ⁊ eorðwæstma be ealra halgena mæssan.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-k"><pb n="166" ed="#rabin-doml"/>and geogoðe teoþunge be Pentecosten and eorðwæstma be Ealra Halgena mæssan,</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="253" ed="#liebermann"/>und Jungviehzehnt zu Pfingsten und Feldfrüchte[-Zehnt] zum Aller Heiligen-Fest [1. November]</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">and the tithe of young stock at Pentecost, and [the tithe of] the fruits of the earth at All Saints [1 November]</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-k"><pb n="97" ed="#robertson"/>And the tithe of young livestock at Pentecost, and that of the fruits of the earth at All Hallows.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-k"><pb n="167" ed="#rabin-doml"/>and the tithe of the young animals by Pentecost, and the tithe on the fruits of the earth by the Feast of All Saints,</ab>
        <note type="comparison" source="#liebermann" n="253"><ref target="clause:VAtr_11-1">V Atr 11.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd.</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VIIIAtr_9-1">VIII Atr 9.1</ref>; <ref target="clause:ICn_8-1">I Cn 8.1</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="VIAtr_17.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">252</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
      </div>
    </body>
