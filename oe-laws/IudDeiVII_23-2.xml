        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-2.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier Sing. über Plur.</hi></seg><seg type="translation" xml:lang="en" source="#claude">here sing. above pl.</seg></note>
      </div>
