        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-1a.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">þifþhe <hi rend="italic">auf Rasur Sc;</hi> þifihe <hi rend="italic">Hg;</hi> thef <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">þifþhe on an erasure Sc; þifihe Hg; thef Lond</seg></note>
