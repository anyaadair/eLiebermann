    <body>
      <div type="clause" n="29.4">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 29.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 29.4" corresp="#wit-lat"><pb n="563" ed="#liebermann"/>Si<ptr type="liebermannNote" n="38" target="#Hn_29-4.lnote.oe.38"/> opus est, licet in placitis iudicibus<ptr type="liebermannNote" n="p" target="#Hn_29-4.lnote.oe.p"/> qui aderunt respectare placitum ex<ptr type="liebermannNote" n="pp" target="#Hn_29-4.lnote.oe.pp"/> competenti<ptr type="liebermannNote" n="39" target="#Hn_29-4.lnote.oe.39"/>, donec senatores<ptr type="liebermannNote" n="q" target="#Hn_29-4.lnote.oe.q"/> absentes interesse possint uel<ptr type="liebermannNote" n="r" target="#Hn_29-4.lnote.oe.r"/> ipsi iudicium inquisierint; nec iure cogendi sunt<ptr type="liebermannNote" n="s" target="#Hn_29-4.lnote.oe.s"/> ad iurandum<ptr type="liebermannNote" n="40" target="#Hn_29-4.lnote.oe.40"/>, quod nesciant iudicium inde.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 563 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-4.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">den anwesenden [nicht selbst hochstehenden] Urtheilfindern</seg><seg type="translation" xml:lang="en" source="#claude">the doomsmen present [not themselves of high rank]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-4.lnote.oe.pp" n="pp" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">gebührend, <hi rend="italic">in Sc corrigirt:</hi> reichlich</seg><seg type="translation" xml:lang="en" source="#claude">duly; corrected in Sc: abundantly</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-4.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 20, 3</seg><seg type="translation" xml:lang="en" source="#claude">see above 20, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-4.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">= et</seg><seg type="translation" xml:lang="en" source="#claude">= et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-4.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">iudices, <hi rend="italic">vom königlichen Gerichtshalter</hi></seg><seg type="translation" xml:lang="en" source="#claude">iudices, by the king’s presiding judge</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-4.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">Set <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">Set Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-4.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">darüber Corr.</hi> abbundanti <hi rend="italic">Sc; so Edd.;</hi> hab. <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">above it the corrector abbundanti Sc; so edd.; hab. Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-4.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">iuren. <hi rend="italic">K;</hi> iudicandum <hi rend="italic">gegen Hss. Wi; als Emendation</hi> [<hi rend="italic">falsch</hi>] <hi rend="italic">Tho.</hi></seg><seg type="translation" xml:lang="en" source="#claude">iuren. K; iudicandum against MSS Wi; as an emendation [wrong] Tho.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-4.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Urteilfinder 11</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Urteilfinder 11</seg></note>
      </div>
