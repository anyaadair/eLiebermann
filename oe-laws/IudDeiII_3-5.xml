      <div type="clause" n="3.5">
        <head><ref type="lawCode" target="law:IudDeiII">Iud Dei II</ref> 3.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei II 3.5" corresp="#wit-lat"><pb n="406–407" ed="#liebermann"/>et si quis<ptr type="liebermannNote" n="73" target="#IudDeiII_3-5.lnote.oe.73"/> culpabilis<ptr type="liebermannNote" n="74" target="#IudDeiII_3-5.lnote.oe.74"/> uel<ptr type="liebermannNote" n="75" target="#IudDeiII_3-5.lnote.oe.75"/> noxius<ptr type="liebermannNote" n="76" target="#IudDeiII_3-5.lnote.oe.76"/> et<ptr type="liebermannNote" n="77" target="#IudDeiII_3-5.lnote.oe.77"/> tumido<ptr type="liebermannNote" n="78" target="#IudDeiII_3-5.lnote.oe.78"/> corde induratoque<ptr type="liebermannNote" n="79" target="#IudDeiII_3-5.lnote.oe.79"/> pectore<ptr type="liebermannNote" n="80" target="#IudDeiII_3-5.lnote.oe.80"/> uel superba mente reus<ptr type="liebermannNote" n="1" target="#IudDeiII_3-5.lnote.oe.1"/> de<ptr type="liebermannNote" n="2" target="#IudDeiII_3-5.lnote.oe.2"/> hoc furto — uel homicidio aut adulterio seu<ptr type="liebermannNote" n="3" target="#IudDeiII_3-5.lnote.oe.3"/> maleficio — manum miserit<ptr type="liebermannNote" n="4" target="#IudDeiII_3-5.lnote.oe.4"/> in hoc ferrum<ptr type="liebermannNote" n="5" target="#IudDeiII_3-5.lnote.oe.5"/> (uel<ptr type="liebermannNote" n="6" target="#IudDeiII_3-5.lnote.oe.6"/> aquam feruentem), tu, Deus omnipotens, iustissima<ptr type="liebermannNote" n="7" target="#IudDeiII_3-5.lnote.oe.7"/> pietate et<ptr type="liebermannNote" n="8" target="#IudDeiII_3-5.lnote.oe.8"/> rectissimo iudicio illud declarare et manifestare digneris, ut anima<ptr type="liebermannNote" n="9" target="#IudDeiII_3-5.lnote.oe.9"/> eius per poenitentiam saluetur<ptr type="liebermannNote" n="10" target="#IudDeiII_3-5.lnote.oe.10"/>;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 406–407 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-5.lnote.oe.73" n="73" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">qui -es <hi rend="italic">übergeschr. H;</hi> -a <hi rend="italic">übergeschr. Tr und so öfter</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui -es written above H; -a written above Tr, and so frequently</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-5.lnote.oe.74" n="74" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 4, 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. 4, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-5.lnote.oe.75" n="75" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">uel—maleficio <hi rend="italic">fehlt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel—maleficio omitted in Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-5.lnote.oe.76" n="76" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">-ii <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ii written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-5.lnote.oe.77" n="77" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-5.lnote.oe.78" n="78" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">-i <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-i written above H</seg></note>
