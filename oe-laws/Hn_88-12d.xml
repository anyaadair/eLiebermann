        <head><ref type="lawCode" target="law:Hn">Hn</ref> 88.12d</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 88.12d" corresp="#wit-lat"><pb n="604" ed="#liebermann"/>Si ex alia cognatione quis uindictam<ptr type="liebermannNote" n="15" target="#Hn_88-12d.lnote.oe.15"/> faciat<ptr type="liebermannNote" n="16" target="#Hn_88-12d.lnote.oe.16"/> in alium<ptr type="liebermannNote" n="17" target="#Hn_88-12d.lnote.oe.17"/> aliquem preter in<ptr type="liebermannNote" n="a" target="#Hn_88-12d.lnote.oe.a"/><ptr type="liebermannNote" n="18" target="#Hn_88-12d.lnote.oe.18"/> ipsum malefactorem, sit inimicus regis et omnium amicorum eius’.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 604 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-12d.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Angelsächs. Em.</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Anglo-Saxon Em.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-12d.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">-cta <hi rend="italic">Sc, nicht Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cta Sc, not Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-12d.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">capiat <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">capiat K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-12d.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">aliq. alium <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">aliq. alium Lond</seg></note>
