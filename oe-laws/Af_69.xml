    <body>
      <div type="clause" n="69">
        <head><ref type="lawCode" target="law:Af">Af</ref> 69</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="69" corresp="#wit-e"><pb n="86" ed="#liebermann"/>Gif mon oðrum ða hond<ptr type="liebermannNote" n="1" target="#Af_69.lnote.oe.1"/> utan forslea, geselle<ptr type="liebermannNote" n="2" target="#Af_69.lnote.oe.2"/> him XX scill. to bote, gif hine mon gelacnian mæge.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="69" corresp="#wit-h"><pb n="86" ed="#liebermann"/>Gif mon<ptr type="liebermannNote" n="1" target="#Af_69.lnote.oe.1-2"/> oþrum ða hond<ptr type="liebermannNote" n="1" target="#Af_69.lnote.oe.1-2"/> uton<ptr type="liebermannNote" n="1" target="#Af_69.lnote.oe.1-2"/> forslea, gesylle<ptr type="liebermannNote" n="2" target="#Af_69.lnote.oe.2-2"/> him XX scll' to bote, gif hine mon<ptr type="liebermannNote" n="1" target="#Af_69.lnote.oe.1-2"/> gelacnian mæge.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="69" corresp="#wit-b-no-prol"><pb n="86" ed="#liebermann"/>Gyf man on oðru<hi rend="italic">m</hi> ða hand uton forslea, gesylle him XX scill' to bote, gyf hine man gelacnian mæge.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="69" corresp="#wit-q"><pb n="87" ed="#liebermann"/>Si quis alteri<ptr type="liebermannNote" n="1" target="#Af_69.lnote.oe.1-3"/> (homini) manum extra<ptr type="liebermannNote" n="2" target="#Af_69.lnote.oe.2-3"/> plagiauerit, XX sol. emendet<ptr type="liebermannNote" n="1" target="#Af_69.lnote.oe.1-3"/> (culpa sit).</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="90" ed="#attenborough"/>Gif mon oðrum<ptr type="editorNote" n="18" target="#Af_69.attnote.fn.18"/> ða hond utan forslea, geselle him XX scill. to bote, gif hine mon gelacnian mæge.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="73" corresp="#wit-e"><pb n="360" ed="#jurasinski-and-oliver"/>Gif mon oðrum ða hond utan forslea, geselle him XX scill to bote, gif hine mon gelacnian mæge.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="87" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_69.lnote.de.1"/> jemand einem andern die Hand aussen<ptr type="liebermannNote" n="2" target="#Af_69.lnote.de.2"/> zerschlägt, gebe er ihm 20 Schill. zur Busse, vorausgesetzt, jener könne geheilt<ptr type="liebermannNote" n="3" target="#Af_69.lnote.de.3"/> werden.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone smashes another’s hand on the outside, let him give him 20 shillings as compensation, provided that the latter can be healed.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="91" ed="#attenborough"/>If a man maims another's hand outwardly<ptr type="editorNote" n="1" target="#Af_69.attnote.n.1"/>, 20 shillings shall be given to him as compensation, if he can be cured.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="361" ed="#jurasinski-and-oliver"/>If a man strikes the outside of another’s hand, let him pay him 20 shillings as compensation, if he can be healed.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_69.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">hand uton <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hand uton Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_69.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">gesylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gesylle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_69.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geändert in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_69.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_69.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">87</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lesart Lond Hn</hi> 93, 29; (<hi rend="italic">eingeklammertes</hi>) <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket the reading of Lond Hn 93, 29; (what is bracketed) the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_69.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">87</biblScope></bibl><seg type="original" xml:lang="de">plegg. extra <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">plegg. extra Or</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_69.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Hand 9</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Hand 9</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_69.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Äusserlich, ohne Schaden an Sehnen und Knochen</seg><seg type="translation" xml:lang="en" source="#claude">Externally, without damage to sinews and bones</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_69.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">d. h. ‘er behalte nicht bloss das Leben’, sondern auch die Funktion des Gliedes. Ggs. zu ‘geheilt werden’ ist Lähmung <hi rend="italic">u.</hi> 75, 1</seg><seg type="translation" xml:lang="en" source="#claude">i.e. ‘let him not merely keep his life’, but also the function of the limb. The contrast to ‘being healed’ is lameness <hi rend="italic">below</hi> 75, 1</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_69.attnote.fn.18" n="18" source="#attenborough"><bibl><biblScope unit="page">90</biblScope></bibl><label>oðrum</label><seg type="original" xml:lang="en"><hi rend="italic">on oðrum</hi>. B.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_69.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">200</biblScope></bibl><seg type="original" xml:lang="en">This translation is taken from Thorpe, with whom Schmid (‘an der Aussenseite zerschlägt’) and Liebermann (‘die Hand aussen zerschlägt’) practically agree. I do not understand what kind of an injury is meant.</seg></note>
      </div>
    </body>
