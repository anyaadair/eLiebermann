      <div type="clause" n="81.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 81.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 81.1" corresp="#wit-lat"><pb n="597–598" ed="#liebermann"/>In<ptr type="liebermannNote" n="37" target="#Hn_81-1.lnote.oe.37"/> omni potacione, dacioni<ptr type="liebermannNote" n="r" target="#Hn_81-1.lnote.oe.r"/> uel empcioni<ptr type="liebermannNote" n="s" target="#Hn_81-1.lnote.oe.s"/> uel gilde uel ad quidlibet<ptr type="liebermannNote" n="38" target="#Hn_81-1.lnote.oe.38"/> in hunc modum preparata<ptr type="liebermannNote" n="39" target="#Hn_81-1.lnote.oe.39"/>, primo pax<ptr type="liebermannNote" n="t" target="#Hn_81-1.lnote.oe.t"/> Dei et domini inter<ptr type="liebermannNote" n="1" target="#Hn_81-1.lnote.oe.1"/> eos qui conuenerint publica prenunciacione ponenda est et rogandum, ut si quis alium ibi<ptr type="liebermannNote" n="a" target="#Hn_81-1.lnote.oe.a"/> quacunque deu[oc]et<ptr type="liebermannNote" n="b" target="#Hn_81-1.lnote.oe.b"/><ptr type="liebermannNote" n="2" target="#Hn_81-1.lnote.oe.2"/> occasione, si placet<ptr type="liebermannNote" n="3" target="#Hn_81-1.lnote.oe.3"/>,' palam faciat<ptr type="liebermannNote" n="4" target="#Hn_81-1.lnote.oe.4"/>, et rectum ei uadietur competenti termino peragendum, sicut et ubi<ptr type="liebermannNote" n="5" target="#Hn_81-1.lnote.oe.5"/> iustum erit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 597–598 (two independent readings of the page images, differences settled against the page); Liebermann’s print has a stray raised mark after ‘placet,’; transcribed as printed</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_81-1.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">behufs einer Schenkung, <hi rend="italic">die Zeugen bedarf</hi></seg><seg type="translation" xml:lang="en" source="#claude">for the purpose of a gift <hi rend="italic">that requires witnesses</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_81-1.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wohl nicht</hi> Markt (<hi rend="italic">Brunner</hi> DRG. II 584), <hi rend="italic">da innerhalb eines Gelages, eher</hi> Weinkauf</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">probably not</hi> market (<hi rend="italic">Brunner</hi> DRG. II 584), <hi rend="italic">since within a drinking-bout; rather</hi> bargain-drink</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_81-1.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">öffentlicher Friede aller Welt (<hi rend="italic">vgl.</hi> 87, 2<hi rend="italic">a</hi>) und [Sonderschutz] des Haus<hi rend="spaced">herrn</hi> (<hi rend="italic">vgl.</hi> 81, 1; <hi rend="italic">dagegen</hi> VI Atr 32 <hi rend="italic">meint den</hi> Haus<hi rend="spaced">vater</hi>, <hi rend="italic">nicht den</hi> Immunitätsherrn); <hi rend="italic">auch</hi> E Cf <hi rend="italic">braucht</hi> pax Dei <hi rend="italic">in diesem Sinne;</hi> treuga Dei (<hi rend="italic">Kluckhohn</hi> Gottesfriede 135) <hi rend="italic">meint Hn nicht. Ursprünglich war auch der Marktfriede der Germanen religiös; Brunner</hi> DRG. II 581</seg><seg type="translation" xml:lang="en" source="#claude">public peace of all the world (<hi rend="italic">cf.</hi> 87, 2<hi rend="italic">a</hi>) and [special protection] of the <hi rend="italic">lord</hi> of the house (<hi rend="italic">cf.</hi> 81, 1; <hi rend="italic">by contrast</hi> VI Atr 32 <hi rend="italic">means the</hi> <hi rend="italic">father</hi> of the house, <hi rend="italic">not the</hi> lord of the immunity); E Cf <hi rend="italic">too uses</hi> pax Dei <hi rend="italic">in this sense;</hi> <hi rend="italic">Hn does not mean</hi> treuga Dei (<hi rend="italic">Kluckhohn</hi> Gottesfriede 135). <hi rend="italic">Originally the market peace of the Germanic peoples too was religious; Brunner</hi> DRG. II 581</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_81-1.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">Non in <hi rend="italic">statt</hi> In o. <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">Non in instead of In o. K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_81-1.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">queml. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">queml. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_81-1.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">rep. <hi rend="italic">K Co Or Gi;</hi> -ti <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">rep. K Co Or Gi; -ti Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_81-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Somner citirt hierzu aus West- und Nord-England</hi> 17. <hi rend="italic">Jhs.:</hi> ‘Ales’, ubi iurgia, lites et controversiæ inter vicinos ortæ audiantur et componantur</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">On this Somner cites, from the west and north of England in the</hi> 17<hi rend="italic">th cent.:</hi> ‘Ales’, ubi iurgia, lites et controversiæ inter vicinos ortæ audiantur et componantur</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_81-1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">klagend anspricht (<hi rend="italic">zur Verhandlung lädt</hi>); <hi rend="italic">vgl.</hi> Hl 8</seg><seg type="translation" xml:lang="en" source="#claude">makes a claim against (<hi rend="italic">summons to a hearing</hi>); <hi rend="italic">cf.</hi> Hl 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_81-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">qui eos inter <hi rend="italic">Sc Hg</hi>; qui i. eos <hi rend="italic">ohne Hss. Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui eos inter Sc Hg; qui i. eos without MSS Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_81-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">deuitet <hi rend="italic">Hss. Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">deuitet MSS edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_81-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">-eat <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-eat K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_81-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">-iet <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iet <hi rend="italic">Sc Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_81-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">ibi pistum <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">ibi pistum Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_81-1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Gottesfriede; Prozessualpfand 9; Biergelage 5. 7f. g; Genossenschaft 8 [trage nach: <hi rend="italic">Chnictehall ubi chenictes potabant gildam suam</hi> in Winchester; Gross <hi rend="italic">Gild. merch</hi>. I 188].—<hi rend="italic">deuitet</hi>{2}—81, 2 <hi rend="italic">pax</hi>{7} fehlt—<hi rend="italic">p. sit ita</hi>{8}—<hi rend="italic">uel</hi>{10} fehlt—<hi rend="italic">curu</hi>.{11} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Gottesfriede; Prozessualpfand 9; Biergelage 5. 7f. g; Genossenschaft 8 [add: <hi rend="italic">Chnictehall ubi chenictes potabant gildam suam</hi> in Winchester; Gross <hi rend="italic">Gild. merch</hi>. I 188].—<hi rend="italic">deuitet</hi>{2}—81, 2 <hi rend="italic">pax</hi>{7} omitted—<hi rend="italic">p. sit ita</hi>{8}—<hi rend="italic">uel</hi>{10} omitted—<hi rend="italic">curu</hi>.{11} Rs</seg></note>
      </div>
