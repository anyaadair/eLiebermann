      <div type="clause" n="7.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 7.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 7.5" corresp="#wit-lat"><pb n="553" ed="#liebermann"/>Et<ptr type="liebermannNote" n="33" target="#Hn_7-5.lnote.oe.33"/> si aliquid in hundretis<ptr type="liebermannNote" n="34" target="#Hn_7-5.lnote.oe.34"/> agendorum penuria iudicum<ptr type="liebermannNote" n="u" target="#Hn_7-5.lnote.oe.u"/><ptr type="liebermannNote" n="35" target="#Hn_7-5.lnote.oe.35"/> uel casu<ptr type="liebermannNote" n="36" target="#Hn_7-5.lnote.oe.36"/> aliquo transferendum<ptr type="liebermannNote" n="v" target="#Hn_7-5.lnote.oe.v"/> sit in<ptr type="liebermannNote" n="w" target="#Hn_7-5.lnote.oe.w"/> duos<ptr type="liebermannNote" n="37" target="#Hn_7-5.lnote.oe.37"/> uel III uel amplius hundredos<ptr type="liebermannNote" n="38" target="#Hn_7-5.lnote.oe.38"/>, respectetur iusto fine claudendum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 553 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-5.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Urtheilsfinder im Einzelhundred</hi></seg><seg type="translation" xml:lang="en" source="#claude">judgment-finders in the individual hundred</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-5.lnote.oe.v" n="v" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">transferre: <hi rend="italic">einen Process übertragen an anderes Gericht weiterer Zuständigkeit; vgl.</hi> 9, 4 <hi rend="italic">f.</hi> (per)transire</seg><seg type="translation" xml:lang="en" source="#claude">transferre: to transfer a case to another court of wider jurisdiction; cf. 9, 4 f. (per)transire</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-5.lnote.oe.w" n="w" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 31, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. 31, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-5.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">Ut si aliquis <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ut si aliquis Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-5.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">-edis <hi rend="italic">Lond meist</hi></seg><seg type="translation" xml:lang="en" source="#claude">-edis mostly Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-5.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">-cium <hi rend="italic">Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cium MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-5.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">caū <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">caū Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-5.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">duas <hi rend="italic">Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">duas Wi Tho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-5.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">-das <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-das Sc</seg></note>
