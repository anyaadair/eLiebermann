  <text>
    <body>
      <div type="clause" n="6">
        <head><ref type="lawCode" target="law:VIIaAtr">VIIa Atr</ref> 6</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6" corresp="#wit-d"><pb n="262" ed="#liebermann"/>⁊ on æghwilcan mynstre singe eal geferræden ætgædere heora saltere þa ðry dagas.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="6" corresp="#wit-d"><pb n="116" ed="#robertson"/>⁊ on æghwilcan mynstre singe eal geferræden ætgædere heora saltere þa ðry dagas.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-d"><pb n="188" ed="#rabin-doml"/>And on æghwilcan mynstre, singe eal geferræden ætgædere heora saltere þa ðry dagas.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="262" ed="#liebermann"/>Und in jeder Kirche singe der ganze Convent zusammen<ptr type="liebermannNote" n="1" target="#VIIaAtr_6.lnote.de.1"/> ihren Psalter die drei Tage.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And in every minster let the whole community sing their psalter together on the three days.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d"><ptr type="editorNote" n="1" target="#VIIaAtr_6.robnote.n.1"/><pb n="117" ed="#robertson"/>And in every religious foundation, on these three days, all the brotherhood in common shall chant [the psalms from] their psalters<ptr type="editorNote" n="2" target="#VIIaAtr_6.robnote.n.2"/>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-d"><pb n="453" ed="#whitelock"/>And in every minster all the community are to sing their psalter together during those three days.<ptr type="editorNote" n="2" target="#VIIaAtr_6.whinote.n.2"/></ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-d"><pb n="189" ed="#rabin-doml"/>And in every monastery, the whole community is to chant from their psalters on these three days.</ab>
        <note type="editorial">Liebermann compares VII Atr 3.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VIIaAtr_6.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">181</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Nur allgemein fordern Psalmen von den Mönchen jene Homilien</seg><seg type="translation" xml:lang="en" source="#claude">Those homilies require psalms of the monks only in general terms</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VIIaAtr_6.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">338</biblScope></bibl><seg type="original" xml:lang="en">Cf. VII, 3.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VIIaAtr_6.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">338</biblScope></bibl><seg type="original" xml:lang="en">Cf. VII, 3, 2.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="VIIaAtr_6.whinote.n.2" n="2" source="#whitelock"><bibl><biblScope unit="page">453</biblScope></bibl><label>days</label><seg type="original" xml:lang="en">id. (3.2) says that each priest is separately to celebrate 30 masses for this purpose, and each monk to say 30 psalters</seg></note>
      </div>
    </body>
  </text>
