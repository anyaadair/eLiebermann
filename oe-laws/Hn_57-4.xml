      <div type="clause" n="57.4">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 57.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 57.4" corresp="#wit-lat"><pb n="576" ed="#liebermann"/>Si cum aliquo<ptr type="liebermannNote" n="10" target="#Hn_57-4.lnote.oe.10"/> inuentum sit<ptr type="liebermannNote" n="i" target="#Hn_57-4.lnote.oe.i"/> unde culpatus<ptr type="liebermannNote" n="11" target="#Hn_57-4.lnote.oe.11"/> sit, ibi necesse est causam<ptr type="liebermannNote" n="12" target="#Hn_57-4.lnote.oe.12"/> tractari, et ibi purgetur uel<ptr type="liebermannNote" n="13" target="#Hn_57-4.lnote.oe.13"/> ibi sordidetur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 576 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-4.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie bei dem</hi> inter manus habens 62, 3; 57, 7. <hi rend="italic">Die</hi> Leis Wl 27 <hi rend="italic">geben dem Gerichtsherrn des Hauses, wo sich Diebstahl findet, die Diebeshabe. Allen versteht also hier ungenau das Gericht des Verhaftungsortes</hi></seg><seg type="translation" xml:lang="en" source="#claude">as with the inter manus habens 62, 3; 57, 7. Leis Wl 27 give the thief’s goods to the lord of the court of the house where the stolen property is found. Here, therefore, Allen imprecisely takes this to mean the court of the place of arrest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-4.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">alio <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">alio K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-4.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">inculp. <hi rend="italic">Gi;</hi> culpatur <hi rend="italic">ohne</hi> sit <hi rend="italic">Or;</hi> inculpatur <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">inculp. Gi; culpatur without sit Or; inculpatur K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-4.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">t. c. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. c. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-4.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-4.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. handhaft 3b—<hi rend="italic">inculpatur</hi>{11} ohne <hi rend="italic">sit</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. handhaft 3b—<hi rend="italic">inculpatur</hi>{11} without <hi rend="italic">sit</hi> Rs</seg></note>
      </div>
