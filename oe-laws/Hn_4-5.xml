      <div type="clause" n="4.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 4.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 4.5" corresp="#wit-lat"><pb n="548" ed="#liebermann"/>Set siue lex agenda precipiat<ptr type="liebermannNote" n="5" target="#Hn_4-5.lnote.oe.5"/>, leuia permittat, hortetur<ptr type="liebermannNote" n="5*" target="#Hn_4-5.lnote.oe.5_"/> maxima, uitanda prohibeat, debet esse manifesta, iusta, honesta, possibilis, in omni conditione, professione et ordine, in omni genere et statu causarum, in omni controuersia<ptr type="liebermannNote" n="6" target="#Hn_4-5.lnote.oe.6"/> simplici uel composita, in omni iure naturali uel consuetudinis, in omni contingenti<ptr type="liebermannNote" n="7" target="#Hn_4-5.lnote.oe.7"/> uel remoto loco, tempori, persone<ptr type="liebermannNote" n="8" target="#Hn_4-5.lnote.oe.8"/> conueniens, nullo priuato commodo precipue deseruiens, ueritatis et iustitie, non miserum peccunie querens<ptr type="liebermannNote" n="9" target="#Hn_4-5.lnote.oe.9"/> argumentum<ptr type="liebermannNote" n="10" target="#Hn_4-5.lnote.oe.10"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 548 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_4-5.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. vom Corr. aus</hi> -pitat <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the corrector from -pitat Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_4-5.lnote.oe.5_" n="5*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">-tatur <hi rend="italic">Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tatur MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_4-5.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">-rssia, <hi rend="italic">scharfes</hi> s <hi rend="italic">oft doppelt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rssia, sharp s often doubled Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_4-5.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">-gent <hi rend="italic">K Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gent K Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_4-5.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">ꝑᵒ conuenens <hi rend="italic">Sc;</hi> proprio <hi rend="italic">Edd.</hi> [<hi rend="italic">falsch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">ꝑᵒ conuenens Sc; proprio Edd. [wrong]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_4-5.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">querentis <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">querentis Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_4-5.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">augmentum <hi rend="italic">Lond Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">augmentum Lond Edd.</seg></note>
      </div>
