      <div type="clause" n="2.2">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 2.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 2.2"><pb n="628" ed="#liebermann"/>Item ab Ascensione<ptr type="liebermannNote" n="l" target="#ECf_2-2.lnote.la.fn.l"/> Domini usque ad octauas<ptr type="liebermannNote" n="m" target="#ECf_2-2.lnote.la.fn.m"/> pentecostes.</ab>
        <note type="comparison" source="#liebermann" n="628"><label>printed alongside</label> <ref target="clause:ECfRetr_2-2">ECf retr 2.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 628 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “ab” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-2.lnote.la.fn.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">30. <hi rend="italic">April</hi> — 3. <hi rend="italic">Juni</hi></seg><seg type="translation" xml:lang="en" source="#claude">30 April – 3 June</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-2.lnote.la.fn.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">17. <hi rend="italic">Mai</hi> — 20. <hi rend="italic">Juni</hi></seg><seg type="translation" xml:lang="en" source="#claude">17 May – 20 June</seg></note>
