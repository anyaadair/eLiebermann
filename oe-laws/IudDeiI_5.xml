      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 5" corresp="#wit-lat"><pb n="402" ed="#liebermann"/>Oratio.<ptr type="liebermannNote" n="28" target="#IudDeiI_5.lnote.oe.28"/> Absolue, quaesumus<ptr type="liebermannNote" n="29" target="#IudDeiI_5.lnote.oe.29"/>, Domine, tuorum<ptr type="liebermannNote" n="30" target="#IudDeiI_5.lnote.oe.30"/><ptr type="liebermannNote" n="e" target="#IudDeiI_5.lnote.oe.e"/> delicta famulorum<ptr type="liebermannNote" n="31" target="#IudDeiI_5.lnote.oe.31"/>, ut a<ptr type="liebermannNote" n="32" target="#IudDeiI_5.lnote.oe.32"/> peccatorum suorum nexibus, quae pro sua fragilitate contraxerunt<ptr type="liebermannNote" n="33" target="#IudDeiI_5.lnote.oe.33"/>, tua benignitate liberentur<ptr type="liebermannNote" n="34" target="#IudDeiI_5.lnote.oe.34"/> et in hoc iudicio, prout meruerunt<ptr type="liebermannNote" n="35" target="#IudDeiI_5.lnote.oe.35"/>, tua<ptr type="liebermannNote" n="36" target="#IudDeiI_5.lnote.oe.36"/> iustitia praeueniente, ad<ptr type="liebermannNote" n="37" target="#IudDeiI_5.lnote.oe.37"/> ueritatis censuram peruenire<ptr type="liebermannNote" n="38" target="#IudDeiI_5.lnote.oe.38"/> mereantur<ptr type="liebermannNote" n="39" target="#IudDeiI_5.lnote.oe.39"/>. Per dominum<ptr type="liebermannNote" n="40" target="#IudDeiI_5.lnote.oe.40"/> nostrum<ptr type="liebermannNote" n="41" target="#IudDeiI_5.lnote.oe.41"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 402 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_5.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">tuę <hi rend="italic">übergeschr. Vt, wo das Ordal mehrfach auf Weiber bezogen wird, vgl. u.</hi> 15, <hi rend="italic">Note</hi> 60; III 2³⁷. <hi rend="italic">Ci setzt weibliche Endungen über die Zeile u.</hi> 14, <hi rend="italic">Note</hi> 46 <hi rend="italic">f. und Tr unten</hi> II 3, 5, <hi rend="italic">Note</hi> 73.</seg><seg type="translation" xml:lang="en" source="#claude">tuę written above Vt, where the ordeal is several times applied to women, cf. below 15, note 60; III 2³⁷. Ci puts feminine endings above the line below 14, note 46 f., and so does Tr below II 3, 5, note 73.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_5.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">Collec̄ <hi rend="italic">Vt Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">Collec̄ Vt Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_5.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">D. q. <hi rend="italic">Ca</hi></seg><seg type="translation" xml:lang="en" source="#claude">D. q. Ca</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_5.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">d. famuli tui <hi rend="italic">Al Ma;</hi> tui <hi rend="italic">übergeschr. Rj Ci;</hi> uel tui <hi rend="italic">übergeschr. H; stets Sing. Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. famuli tui Al Ma; tui written above Rj Ci; uel tui written above H; always singular Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_5.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">-li <hi rend="italic">übergeschr. Rj Ci H;</hi> -lę <hi rend="italic">übergeschr. Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">-li written above Rj Ci H; -lę written above Vt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_5.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_5.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">-xit <hi rend="italic">Al Ma;</hi> -it <hi rend="italic">übers. Rj Vt Ci H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-xit Al Ma; -it written above Rj Vt Ci H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_5.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">-etur <hi rend="italic">Al; übers. Rj Vt Ci H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-etur Al; written above Rj Vt Ci H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_5.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">-uit <hi rend="italic">Al Ma;</hi> uel -it <hi rend="italic">übers. H;</hi> -ruit <hi rend="italic">übers. Rj Vt Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uit Al Ma; uel -it written above H; -ruit written above Rj Vt Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_5.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">i. t. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. t. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_5.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">aduersitatis c. <hi rend="italic">Ci Al Ma Bc</hi></seg><seg type="translation" xml:lang="en" source="#claude">aduersitatis c. Ci Al Ma Bc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_5.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">inuenire <hi rend="italic">Al Ma Bc</hi></seg><seg type="translation" xml:lang="en" source="#claude">inuenire Al Ma Bc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_5.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">-atur <hi rend="italic">Al Ma;</hi> uel -atur <hi rend="italic">übers. H;</hi> -reatur <hi rend="italic">übers. Rj Vt Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">-atur Al Ma; uel -atur written above H; -reatur written above Rj Vt Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_5.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">d. n. <hi rend="italic">fehlt Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. n. omitted in Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_5.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ch Ca H Tr;</hi> Iesum Christum filium tuum <hi rend="italic">fügt zu Pt</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Ch Ca H Tr; Iesum Christum filium tuum added by Pt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_5.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">239</biblScope></bibl><seg type="original" xml:lang="de">Zum weiblichen Geschlechte der Prüflinge <hi rend="italic">vgl. Gl</hi> Ordal 20</seg><seg type="translation" xml:lang="en" source="#claude">On persons of the female sex undergoing the ordeal cf. <hi rend="italic">Gl</hi> Ordal 20</seg></note>
      </div>
