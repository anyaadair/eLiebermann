      <div type="clause" n="29">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 29</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 29"><pb n="652" ed="#liebermann"/><ptr type="liebermannNote" n="9" target="#ECf_29.lnote.la.9"/>Cum autem maiores cause<ptr type="liebermannNote" n="10" target="#ECf_29.lnote.la.10"/> insurgebant, referebant eos ad alios<ptr type="liebermannNote" n="11" target="#ECf_29.lnote.la.11"/> maiores iusticiarios<ptr type="liebermannNote" n="12" target="#ECf_29.lnote.la.12"/>, quos sapientes supradicti<ptr type="liebermannNote" n="a" target="#ECf_29.lnote.la.fn.a"/> super eos constituerant<ptr type="liebermannNote" n="13" target="#ECf_29.lnote.la.13"/> — scilicet<ptr type="liebermannNote" n="a" target="#ECf_29.lnote.oe.erkl-a"/> super<ptr type="liebermannNote" n="14" target="#ECf_29.lnote.la.14"/> X<ptr type="liebermannNote" n="b" target="#ECf_29.lnote.la.fn.b"/> decanos —, quos possumus uocare centenarios, quia super C<ptr type="liebermannNote" n="b" target="#ECf_29.lnote.la.fn.b"/> friborgas<ptr type="liebermannNote" n="15" target="#ECf_29.lnote.la.15"/> iudicabant<ptr type="liebermannNote" n="16" target="#ECf_29.lnote.la.16"/>.</ab>
        <note type="comparison" source="#liebermann" n="652"><label>printed alongside</label> <ref target="clause:ECfRetr_29">ECf retr 29</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 652 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_29.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 28</seg><seg type="translation" xml:lang="en" source="#claude">cf. 28</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_29.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">Irrthum</seg><seg type="translation" xml:lang="en" source="#claude">an error</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_29.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">Item <hi rend="italic">überschr. Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">headed Item Pl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_29.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">cāe <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">cāe Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_29.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_29.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">interciarios <hi rend="italic">Rl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">interciarios Rl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_29.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">-runt <hi rend="italic">Hk Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-runt Hk Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_29.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">per <hi rend="italic">S;</hi> s. X <hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">per S; s. X lacking in Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_29.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">-ghas <hi rend="italic">Rl;</hi> -rg’ <hi rend="italic">Hk;</hi> friþ(-db. <hi rend="italic">S</hi>)borgos <hi rend="italic">Ad S</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ghas Rl; -rg’ Hk; friþ(-db. S)borgos Ad S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_29.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">-bunt <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">-bunt Ad</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But when greater cases arose, they referred them to other, greater justiciars, whom the above-mentioned wise men had set over them — that is, over ten deans —, whom we can call hundredmen (<hi rend="italic">centenarii</hi>), because they judged over a hundred frankpledges.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_29.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Hundred 10b. 25a; Kritik hiergegen Zehnerschaft 22</seg><seg type="translation" xml:lang="en" source="#claude">See <hi rend="italic">Gl</hi> Hundred 10b. 25a; criticism of this, Zehnerschaft 22</seg></note>
      </div>
    </body>
