      <div type="clause" n="18">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 18</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 18" corresp="#wit-lat"><ptr type="liebermannNote" n="51" target="#Hn_18.lnote.oe.51"/><pb n="559" ed="#liebermann"/>De lada<ptr type="liebermannNote" n="k" target="#Hn_18.lnote.oe.k"/>. Francigena<ptr type="liebermannNote" n="52" target="#Hn_18.lnote.oe.52"/> si compellatur, iuret se sexto<ptr type="liebermannNote" n="l" target="#Hn_18.lnote.oe.l"/>; Anglicus<ptr type="liebermannNote" n="m" target="#Hn_18.lnote.oe.m"/> liber<ptr type="liebermannNote" n="53" target="#Hn_18.lnote.oe.53"/> triplici lada plane<ptr type="liebermannNote" n="n" target="#Hn_18.lnote.oe.n"/> uel simplici frangenti<ptr type="liebermannNote" n="54" target="#Hn_18.lnote.oe.54"/>, uel iudicio<ptr type="liebermannNote" n="o" target="#Hn_18.lnote.oe.o"/> neget.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 559 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_18.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dieser Satz stört den Zusammenhang; denn</hi> 19 <hi rend="italic">setzt</hi> 17 <hi rend="italic">fort</hi></seg><seg type="translation" xml:lang="en" source="#claude">this sentence interrupts the context; for 19 continues 17</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_18.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ungestabt;</hi> Wl lad 3, 2. 1, 1</seg><seg type="translation" xml:lang="en" source="#claude">unformulated; Wl lad 3, 2. 1, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_18.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">Wl lad 2 <hi rend="italic">erlaubt daneben Zweikampf</hi></seg><seg type="translation" xml:lang="en" source="#claude">Wl lad 2 also allows judicial combat as an alternative</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_18.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s.</hi> 9, 6. 64, 3<hi rend="italic">a</hi>. <hi rend="italic">Schlichter dreifacher Eid gilt hier</hi> (<hi rend="italic">nicht</hi> Wl lad) <hi rend="italic">gleich gestabtem einfachen</hi></seg><seg type="translation" xml:lang="en" source="#claude">see 9, 6. 64, 3<hi rend="italic">a</hi>. A plain triple oath counts here (not in Wl lad) as equal to a formulated single one</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_18.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">Ordal</seg><seg type="translation" xml:lang="en" source="#claude">ordeal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_18.lnote.oe.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">C. XIX <hi rend="italic">Lond;</hi> De l. <hi rend="italic">fehlt Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">C. XIX Lond; De l. lacking in Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_18.lnote.oe.52" n="52" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">Tra. <hi rend="italic">K;</hi> -gencia <hi rend="italic">Co Or;</hi> compellatus <hi rend="italic">ohne</hi> si <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">Tra. K; -gencia Co Or; compellatus without si Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_18.lnote.oe.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_18.lnote.oe.54" n="54" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">-get <hi rend="italic">K Co Or Gi;</hi> exigenti <hi rend="italic">Wh</hi>, ‘unde nescio’ <hi rend="italic">Price</hi></seg><seg type="translation" xml:lang="en" source="#claude">-get K Co Or Gi; exigenti Wh, ‘unde nescio’ Price</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_18.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">319</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Franko-Engländer 3; Stabeid 4.—<hi rend="italic">Fr</hi>.{52} <hi rend="italic">compellatus</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Franko-Engländer 3; Stabeid 4.—<hi rend="italic">Fr</hi>.{52} <hi rend="italic">compellatus</hi> Rs</seg></note>
      </div>
