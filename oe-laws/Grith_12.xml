      <div type="clause" n="12">
        <head><ref type="lawCode" target="law:Grith">Grið</ref> 12</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="12" corresp="#wit-g-b"><pb n="471" ed="#liebermann"/>⁊ gyf<ptr type="liebermannNote" n="1" target="#Grith_12.lnote.oe.1"/> man beforan æðelinge <hi rend="italic">oððe<ptr type="liebermannNote" n="4" target="#Grith_12.lnote.oe.4"/></hi> arcebiscpe<ptr type="liebermannNote" n="5" target="#Grith_12.lnote.oe.5"/> gefeoht agynneð<ptr type="liebermannNote" n="1" target="#Grith_12.lnote.oe.1"/>, mid CL scillinga gebete; gyf<ptr type="liebermannNote" n="1" target="#Grith_12.lnote.oe.1"/> beforan oðran biscpe<ptr type="liebermannNote" n="5" target="#Grith_12.lnote.oe.5"/> oððe ealdormen þis geli<hi rend="italic">m</hi>pe, mid C scill'<ptr type="liebermannNote" n="6" target="#Grith_12.lnote.oe.6"/> gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" n="12" corresp="#wit-g-b"><pb n="24" ed="#rabin-doml"/>And gyf man beforan æðelinge oððe arcebiscpe gefeoht agynneð, mid CL scillinga gebete; gyf beforan oðran biscpe oððe ealdormen þis gelimpe, mid C scillingum gebete.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="471" ed="#liebermann"/>Und wenn jemand vor einem Prinzen<ptr type="liebermannNote" n="*" target="#Grith_12.lnote.de1.star"/> oder Erzbischof Fechten unternimmt<ptr type="liebermannNote" n="2" target="#Grith_12.lnote.de.2"/>, büsse er mit 150 Schilling; wenn dies vor einem anderen Bischof oder einem Ealdorman geschieht, büsse er mit 100 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if anyone starts a fight in the presence of a prince or an archbishop, let him atone with 150 shillings; if this happens in the presence of another bishop or an ealdorman, let him atone with 100 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-b"><pb n="25" ed="#rabin-doml"/>And if anyone starts a fight in the presence of a nobleman or archbishop, he is to compensate with one hundred and fifty shillings; if this occurs in the presence of another bishop or ealdorman, he is to compensate with one hundred shillings.</ab>
        <note type="comparison" source="#liebermann" n="471"><ref target="clause:Af_15">Af 15</ref>; <ref target="clause:Grith_4">Grið 4</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Af 15 | *s. o. 4</note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="269"><label>cf. (Golden Rule)</label> <ref target="clause:Af_El-to-49-5">Af El 49.5</ref> <quote>Inexact renderings of this saying occur as well in Ælfric's explication ... and in the work of Wulfstan ...; cf. also Grið §12.</quote></note>
        <note type="editorial">Liebermann compares Af 15.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Grith_12.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">471</biblScope></bibl><seg type="original" xml:lang="de">i <hi rend="italic">statt</hi> y <hi rend="italic">Tho.</hi></seg><seg type="translation" xml:lang="en" source="#claude">i instead of y Tho.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Grith_12.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">471</biblScope></bibl><seg type="original" xml:lang="de">l'</seg><seg type="translation" xml:lang="en" source="#claude">l'</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Grith_12.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">471</biblScope></bibl><seg type="original" xml:lang="de">-scop. <hi rend="italic">Wi. Tho., aber vgl.</hi> 11</seg><seg type="translation" xml:lang="en" source="#claude">-scop. Wi. Tho., but cf. 11</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Grith_12.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">471</biblScope></bibl><seg type="original" xml:lang="de">scillinga <hi rend="italic">Wi. Tho.</hi></seg><seg type="translation" xml:lang="en" source="#claude">scillinga Wi. Tho.</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="Grith_12.lnote.de1.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">471</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch</hi> 14—18 <hi rend="italic">sind particular Nordenglisch</hi></seg><seg type="translation" xml:lang="en" source="#claude">14—18 too are specifically Northern English</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Grith_12.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">266</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> blutig fechten 8a—c</seg><seg type="translation" xml:lang="en" source="#claude">See <hi rend="italic">Gl</hi> blutig fechten 8a—c</seg></note>
      </div>
