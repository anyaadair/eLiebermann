      <div type="clause" n="36.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 36.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 36.1" corresp="#wit-lat"><pb n="566" ed="#liebermann"/>De illis qui<ptr type="liebermannNote" n="30" target="#Hn_36-1.lnote.oe.30"/> nominatam ouerseunessam<ptr type="liebermannNote" n="13" target="#Hn_36-1.lnote.oe.13"/> non habent<ptr type="liebermannNote" n="p" target="#Hn_36-1.lnote.oe.p"/> — uel<ptr type="liebermannNote" n="31" target="#Hn_36-1.lnote.oe.31"/> habent, set in quibusdam<ptr type="liebermannNote" n="32" target="#Hn_36-1.lnote.oe.32"/> causis eam perdunt<ptr type="liebermannNote" n="33" target="#Hn_36-1.lnote.oe.33"/> —, honorabilius est, ut, si quid in eos uel in suos peccabitur, armis hoc et honoribus<ptr type="liebermannNote" n="q" target="#Hn_36-1.lnote.oe.q"/> pro modo singulorum emendetur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 566 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-1.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">denen unter Thegnrang</hi></seg><seg type="translation" xml:lang="en" source="#claude">those below thegnly rank</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-1.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 90, 11<hi rend="italic">d</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 90, 11<hi rend="italic">d</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">-senn. <hi rend="italic">stets Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-senn. <hi rend="italic">always Co</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-1.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. vom Corr. Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above by the corrector in Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-1.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">u. h. <hi rend="italic">fehlt Sc Hg Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. h. missing Sc Hg Edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-1.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">quibus <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">quibus Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-1.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">-dant <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dant Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Ehrenbezeigung 2; Schutz 22—<hi rend="italic">quibus</hi>{32}— 36, 1a <hi rend="italic">enim</hi>{34} fehlt—36, 1c <hi rend="italic">proc. in</hi>{38}, besser ohne <hi rend="italic">ut</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Ehrenbezeigung 2; Schutz 22—<hi rend="italic">quibus</hi>{32}— 36, 1a <hi rend="italic">enim</hi>{34} missing—36, 1c <hi rend="italic">proc. in</hi>{38}, better without <hi rend="italic">ut</hi> Rs</seg></note>
