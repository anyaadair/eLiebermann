    <body>
      <div type="clause" n="4.1">
        <head><ref type="lawCode" target="law:Hu">Hu</ref> 4.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4.1" corresp="#wit-b"><pb n="192" ed="#liebermann"/>⁊ buton<ptr type="liebermannNote" n="14" target="#Hu_4-1.lnote.oe.14"/> þara oðer hæbbe, nele him mon nænne team geþafian.<ptr type="liebermannNote" n="15" target="#Hu_4-1.lnote.oe.15"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="4.1" corresp="#wit-q"><pb n="192" ed="#liebermann"/>Et nisi alterutrum habeat, nolumus ei<ptr type="liebermannNote" n="24" target="#Hu_4-1.lnote.oe.24"/> permittere cenningam<ptr type="liebermannNote" n="25" target="#Hu_4-1.lnote.oe.25"/> aliquam.<ptr type="liebermannNote" n="26" target="#Hu_4-1.lnote.oe.26"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="4.1" corresp="#wit-cons-cn"><pb n="193" ed="#liebermann"/>Absque<ptr type="liebermannNote" n="11" target="#Hu_4-1.lnote.oe.11"/> uero utro (id<ptr type="liebermannNote" n="12" target="#Hu_4-1.lnote.oe.12"/> est alterius eorum testimonio) nulla ei attestacio indulgeatur (id<ptr type="liebermannNote" n="12" target="#Hu_4-1.lnote.oe.12"/> est: liceat ei trahere aliquem ad tutelam, quod ab eo habuit).</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="4.1" corresp="#wit-b"><pb n="16" ed="#robertson"/>⁊ buton þara oðer hæbbe, nele him mon nænne team geþafian.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="193" ed="#liebermann"/>Und ausser wenn er deren eine hat, weigere man, ihm einen Gewährzug zu gestatten.<ptr type="liebermannNote" n="1" target="#Hu_4-1.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And unless he has one of these, let him be refused permission to vouch to warranty.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="17" ed="#robertson"/>And unless he has the cognisance of one or other of these, he shall not be permitted to vouch to warranty.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-b"><pb n="433" ed="#whitelock"/>And unless he has one of them, he is not to be allowed to vouch to warranty.</ab>
        <note type="editorial">‘he’ was inserted in B in the 16th century.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_4-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">192</biblScope></bibl><seg type="original" xml:lang="de">he <hi rend="italic">eingeschoben im</hi> 16. <hi rend="italic">Jh.</hi></seg><seg type="translation" xml:lang="en" source="#claude">he inserted in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_4-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">192</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rasur hinter</hi> ge</seg><seg type="translation" xml:lang="en" source="#claude">erasure after ge</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_4-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">193</biblScope></bibl><seg type="original" xml:lang="de">Si a. ue. sit <hi rend="italic">statt</hi> A. u. ut. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Si a. ue. sit instead of A. u. ut. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_4-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">193</biblScope></bibl><seg type="original" xml:lang="de">(<hi rend="italic">Glosse</hi>) <hi rend="italic">aus Hr; fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">(gloss) from Hr; lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_4-1.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">192</biblScope></bibl><seg type="original" xml:lang="de">p. ei <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. ei T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_4-1.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">192</biblScope></bibl><seg type="original" xml:lang="de">ke. <hi rend="italic">Or;</hi> keni. <hi rend="italic">T;</hi> cemi. <hi rend="italic">MHk</hi> [<hi rend="italic">vgl. II Atr.</hi> 9, 2; 4 <hi rend="italic">oder verlesen aus</hi> temingam]</seg><seg type="translation" xml:lang="en" source="#claude">ke. Or; keni. T; cemi. MHk [cf. II Atr. 9, 2; 4, or misread from temingam]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_4-1.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">192</biblScope></bibl><seg type="original" xml:lang="de">amplius <hi rend="italic">zieht aus c.</hi> 5 <hi rend="italic">hierher RT; vgl. o. S.</hi> 189¹⁰</seg><seg type="translation" xml:lang="en" source="#claude">RT move amplius here from c. 5; cf. above p. 189¹⁰</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Hu_4-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">132</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">cenning</hi> braucht Verf. von Q auch in seinem Werke Hn für Gewährzug; <hi rend="italic">cennan</hi> heisst ‘zur Gewähr ziehen’ auch anderwärts; <hi rend="italic">s. Wb</hi>. Diese Bed. fehlt den Agsä. Wbb.—Cons., also auch Archetyp, las jedoch <hi rend="italic">team; vgl. Wb: tutatio; Gl</hi> Anefang 1d. 12</seg><seg type="translation" xml:lang="en" source="#claude">The author of Q also uses <hi rend="italic">cenning</hi> in his work Hn for vouching to warranty; <hi rend="italic">cennan</hi> means ‘vouch to warranty’ elsewhere too; <hi rend="italic">see Wb</hi>. This meaning is lacking in the Anglo-Saxon dictionaries.—Cons., and hence the archetype too, read, however, <hi rend="italic">team</hi>; <hi rend="italic">cf. Wb: tutatio; Gl</hi> Anefang 1d. 12</seg></note>
      </div>
    </body>
