      <div type="clause" n="4.5">
        <head><ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 4.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 4.5" corresp="#wit-du" ana="#glossed"><pb n="410–411" ed="#liebermann"/><seg type="glossed"><seg type="base">aut<ptr type="liebermannNote" n="44" target="#IudDeiIV_4-5.lnote.oe.44"/></seg><gloss xml:lang="ang"><hi rend="italic">oððe<ptr type="liebermannNote" n="3" target="#IudDeiIV_4-5.lnote.oe.3"/></hi></gloss></seg> <seg type="glossed"><seg type="base">si</seg><gloss xml:lang="ang">gif</gloss></seg> <seg type="glossed"><seg type="base">quis</seg><gloss xml:lang="ang">hvoelc</gloss></seg> <seg type="glossed"><seg type="base">culpabilis</seg><gloss xml:lang="ang">synnig</gloss></seg> <seg type="glossed"><seg type="base">per</seg><gloss xml:lang="ang">ðerh</gloss></seg> <seg type="glossed"><seg type="base">aliquid<ptr type="liebermannNote" n="45" target="#IudDeiIV_4-5.lnote.oe.45"/></seg><gloss xml:lang="ang">hvoelc</gloss></seg> <seg type="glossed"><seg type="base">maleficium</seg><gloss xml:lang="ang">yfelvoerc</gloss></seg> <seg type="glossed"><seg type="base">aut</seg><gloss xml:lang="ang"><hi rend="italic">oððe</hi></gloss></seg> <seg type="glossed"><seg type="base">per</seg><gloss xml:lang="ang">ðerh</gloss></seg> <seg type="glossed"><seg type="base">herbas</seg><gloss xml:lang="ang">wyrto</gloss></seg> <seg type="glossed"><seg type="base">maleficas<ptr type="liebermannNote" n="1" target="#IudDeiIV_4-5.lnote.oe.1"/></seg><gloss xml:lang="ang">yfelwyrcendo</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">diabolicas</seg><gloss xml:lang="ang">diovblica</gloss></seg> <seg type="glossed"><seg type="base">peccatum</seg><gloss xml:lang="ang">synn</gloss></seg> <seg type="glossed"><seg type="base">suum</seg><gloss xml:lang="ang">his</gloss></seg> uel <seg type="glossed"><seg type="base">furtum</seg><gloss xml:lang="ang">ðiof:nto<ptr type="liebermannNote" n="2" target="#IudDeiIV_4-5.lnote.oe.2"/></gloss></seg> <seg type="glossed"><seg type="base">detegere<ptr type="liebermannNote" n="3" target="#IudDeiIV_4-5.lnote.oe.3-2"/></seg><gloss xml:lang="ang">giwoeria</gloss></seg> <seg type="glossed"><seg type="base">uoluerit,</seg><gloss xml:lang="ang">vælle,</gloss></seg> <seg type="glossed"><seg type="base">tua</seg><gloss xml:lang="ang">ðinv<hi rend="italic">m<ptr type="liebermannNote" n="4" target="#IudDeiIV_4-5.lnote.oe.4"/></hi></gloss></seg> <seg type="glossed"><seg type="base">iustissima<ptr type="liebermannNote" n="5" target="#IudDeiIV_4-5.lnote.oe.5"/></seg><gloss xml:lang="ang">soðfæst<hi rend="italic">isto</hi></gloss></seg> <seg type="glossed"><seg type="base">ueritas</seg><gloss xml:lang="ang">soð<hi rend="italic">e<ptr type="liebermannNote" n="6" target="#IudDeiIV_4-5.lnote.oe.6"/></hi></gloss></seg> <seg type="glossed"><seg type="base">hoc</seg><gloss xml:lang="ang">ðis</gloss></seg> <seg type="glossed"><seg type="base">euacuare</seg><gloss xml:lang="ang">giidlago</gloss></seg> <seg type="glossed"><seg type="base">dignetur.</seg><gloss xml:lang="ang">sie gimeodv<hi rend="italic">mad</hi>;</gloss></seg></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 410–411 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-5.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wollte Glossator</hi> wœron <hi rend="italic">hinzufügen? In rein Engl. Text heisst</hi> ł : oððe (<hi rend="italic">so</hi> 4, 5); <hi rend="italic">ein Wortverbesserer aber denkt halb Lateinisch</hi></seg><seg type="translation" xml:lang="en" source="#claude">did the glossator mean to add wœron? In a purely English text ł means oððe (thus 4, 5); but a corrector of words thinks half in Latin</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-5.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-5.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">-qua maleficia <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-qua maleficia Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-5.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de">m. et <hi rend="italic">fehlt Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">m. et omitted in Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-5.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur ein Buchstabe verschwunden</hi> (<hi rend="italic">Skeat</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">only one letter vanished (Skeat)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-5.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">als</hi> tegere <hi rend="italic">glossirt;</hi> conteg. <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">glossed as tegere; conteg. Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-5.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. o. S.</hi> 410{41}</seg><seg type="translation" xml:lang="en" source="#claude">cf. above p. 410⁴¹</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-5.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de">dextera <hi rend="italic">statt</hi> i. u. <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">dextera instead of i. u. Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-5.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht</hi> soð<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">perhaps soð<hi rend="italic">a</hi></seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-du">or if any guilty man wishes to hide [?] (lit. 'uncover') his sin or theft through any sorcery or through magical and devilish herbs, may your most just truth deign to make this void.</ab>
      </div>
