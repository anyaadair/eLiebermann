      <div type="clause" n="5.23">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.23</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.23" corresp="#wit-lat"><pb n="550" ed="#liebermann"/>Si<ptr type="liebermannNote" n="q" target="#Hn_5-23.lnote.oe.q"/> episcopus a fide deuiauerit et a<ptr type="liebermannNote" n="21" target="#Hn_5-23.lnote.oe.21"/> subditis secrete commonitus incorrigibilis apparuerit, tunc ad summos<ptr type="liebermannNote" n="r" target="#Hn_5-23.lnote.oe.r"/> pontifices uel ad<ptr type="liebermannNote" n="12" target="#Hn_5-23.lnote.oe.12"/> sedem apostolicam accusetur; pro aliis actibus suis magis tollerandus<ptr type="liebermannNote" n="42" target="#Hn_5-23.lnote.oe.42"/> est quam corrigendus.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 550 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-23.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ähnlich Ivo</hi> Pan. IV 41</seg><seg type="translation" xml:lang="en" source="#claude">similarly Ivo Pan. IV 41</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-23.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">primates suos <hi rend="italic">Ps.-Is. Hieraus folgerten Frühere mit Unrecht Abfassung <hi rend="spaced">nach</hi> der Erlaubniss, an Rom zu appelliren</hi> 1172; <hi rend="italic">aber Appellation kam früher</hi> (<hi rend="italic">z. B.</hi> 1088) <hi rend="italic">vor</hi></seg><seg type="translation" xml:lang="en" source="#claude">primates suos Ps.-Is. From this earlier scholars wrongly inferred composition <hi rend="italic">after</hi> the permission to appeal to Rome, 1172; but appeals occurred earlier (e.g. 1088)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-23.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-23.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-23.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">est toll. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">est toll. Lond</seg></note>
      </div>
    </body>
