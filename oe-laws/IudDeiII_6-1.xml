      <div type="clause" n="6.1">
        <head><ref type="lawCode" target="law:IudDeiII">Iud Dei II</ref> 6.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei II 6.1" corresp="#wit-lat"><pb n="407" ed="#liebermann"/>Manus uero<ptr type="liebermannNote" n="78" target="#IudDeiII_6-1.lnote.oe.78"/> sigilletur et aperiatur, ut supra diximus in<ptr type="liebermannNote" n="79" target="#IudDeiII_6-1.lnote.oe.79"/> consecratione ferri<ptr type="liebermannNote" n="80" target="#IudDeiII_6-1.lnote.oe.80"/>.</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">*) 5, 2</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 407 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_6-1.lnote.oe.78" n="78" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_6-1.lnote.oe.79" n="79" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">de ferro <hi rend="italic">statt</hi> in c. ferri <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">de ferro instead of in c. ferri Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_6-1.lnote.oe.80" n="80" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> Iud. Dei XI <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Iud. Dei XI follows in Tr</seg></note>
      </div>
