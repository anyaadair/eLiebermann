    <body>
      <div type="clause" n="10">
        <head>Cn 1018 10</head>
        <ab type="editionText" xml:lang="ang" source="#kennedy" n="10" corresp="#wit-d"><pb n="74" ed="#kennedy"/>Liceteras 7 leogeras. riperas 7 reaferas. godes graman habban buton híg geswican.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-d"><pb n="214" ed="#rabin-doml"/>Liceteras and leogeras, riperas and reaferas, Godes graman habban, buton hig geswican.</ab>
        <ab type="translation" xml:lang="en" source="#kennedy" corresp="#wit-d"><pb n="74" ed="#kennedy"/>Hypocrites and liars, robbers and plunderers shall incur the wrath of God, unless they cease.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-d"><pb n="215" ed="#rabin-doml"/>Hypocrites and liars, thieves and looters will suffer God’s wrath unless they cease.</ab>
        <note type="comparedBy" source="#wormald-ppmel" n="93"><ref target="clause:IICn_7">II Cn 7</ref></note>
      </div>
