        <note type="liebermannNote" subtype="textual" xml:id="Ine_75.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">123</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K;</hi> ei hoc <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K; ei hoc MHk</seg></note>
