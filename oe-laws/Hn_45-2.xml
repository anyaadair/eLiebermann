      <div type="clause" n="45.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 45.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 45.2" corresp="#wit-lat"><pb n="570" ed="#liebermann"/>Et si quis monacho<ptr type="liebermannNote" n="f" target="#Hn_45-2.lnote.oe.f"/> uel monache, seruo uel ancille sine prelatorum suorum licencia<ptr type="liebermannNote" n="f" target="#Hn_45-2.lnote.oe.f"/> aliquid committat: ut<ptr type="liebermannNote" n="11" target="#Hn_45-2.lnote.oe.11"/> negauerit<ptr type="liebermannNote" n="g" target="#Hn_45-2.lnote.oe.g"/>, nil recipiat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 570 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-2.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie oben</hi> 23, 3</seg><seg type="translation" xml:lang="en" source="#claude">as above 23, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-2.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">Empfänger</seg><seg type="translation" xml:lang="en" source="#claude">recipient</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">empfiehlt Somner</hi></seg><seg type="translation" xml:lang="en" source="#claude">et proposed by Somner</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Anvertrautes 4; unfrei 21d—<hi rend="italic">sine placitorum su</hi>. Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Anvertrautes 4; unfrei 21d—<hi rend="italic">sine placitorum su</hi>. Rs</seg></note>
