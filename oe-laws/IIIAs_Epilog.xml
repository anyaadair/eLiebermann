      <div type="clause" n="Epilog">
        <head><ref type="lawCode" target="law:IIIAs">III As</ref> Epilog</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Epilog" corresp="#wit-q"><pb n="170" ed="#liebermann"/>Precamur, domine, misericordiam tuam, si<ptr type="liebermannNote" n="56" target="#IIIAs_Epilog.lnote.oe.56"/> in hoc scripto<ptr type="liebermannNote" n="57" target="#IIIAs_Epilog.lnote.oe.57"/> alterutrum<ptr type="liebermannNote" n="58" target="#IIIAs_Epilog.lnote.oe.58"/> sit uel<ptr type="liebermannNote" n="59" target="#IIIAs_Epilog.lnote.oe.59"/> nimis uel<ptr type="liebermannNote" n="60" target="#IIIAs_Epilog.lnote.oe.60"/> minus<ptr type="liebermannNote" n="61" target="#IIIAs_Epilog.lnote.oe.61"/>, ut hoc emendari<ptr type="liebermannNote" n="62" target="#IIIAs_Epilog.lnote.oe.62"/> iubeas<ptr type="liebermannNote" n="a" target="#IIIAs_Epilog.lnote.oe.a"/> secundum<ptr type="liebermannNote" n="5" target="#IIIAs_Epilog.lnote.oe.5"/> (iuxta) uelle tuum. Et nos deuote parati sumus ad omnia que nobis precipere uelis, que unquam<ptr type="liebermannNote" n="63" target="#IIIAs_Epilog.lnote.oe.63"/> aliquatenus implere<ptr type="liebermannNote" n="64" target="#IIIAs_Epilog.lnote.oe.64"/> ualeamus.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-q"><pb n="146" ed="#attenborough"/>Precamur, Domine, misericordiam tuam, si in hoc scripto alterutrum sit<ptr type="editorNote" n="1" target="#IIIAs_Epilog.attnote.fn.1"/>, vel nimis vel minus, ut hoc emendari<ptr type="editorNote" n="2" target="#IIIAs_Epilog.attnote.fn.2"/> iubeas secundum<ptr type="editorNote" n="3" target="#IIIAs_Epilog.attnote.fn.3"/> velle tuum. Et nos devote parati sumus ad omnia quæ nobis præcipere velis, quæ unquam aliquatenus implere valeamus.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="147" ed="#attenborough"/>And we beseech your clemency, lord! if this document contains either too much, or too little, to command alterations to be made according to your wishes. And we are zealously prepared to carry out everything you are willing to order us, in so far as it lies within our power to do so.</ab>
        <note type="editorial">Latin only; no German translation in Liebermann.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_Epilog.lnote.oe.56" n="56" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">sit <hi rend="italic">TMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit TMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_Epilog.lnote.oe.57" n="57" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt TMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in TMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_Epilog.lnote.oe.58" n="58" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">sit alt. <hi rend="italic">TMHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit alt. TMHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_Epilog.lnote.oe.59" n="59" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">u. n. <hi rend="italic">fehlt Or Jl</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. n. lacking in Or Jl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_Epilog.lnote.oe.60" n="60" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">u. m. sit <hi rend="italic">am Rande Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. m. sit in the margin Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_Epilog.lnote.oe.61" n="61" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">sit <hi rend="italic">fügt zu Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit added by Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_Epilog.lnote.oe.62" n="62" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">-re <hi rend="italic">TMBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-re TMBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_Epilog.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond; (eingeklammertes) übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket Lond; (the bracketed words) the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_Epilog.lnote.oe.63" n="63" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">nunq. <hi rend="italic">JlMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">nunq. JlMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_Epilog.lnote.oe.64" n="64" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">impellere <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">impellere Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_Epilog.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">112</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hwæðer ma swa læs</hi> lautete Or.: eine häufige Antithese; <hi rend="italic">s.</hi> Toller 612. — Zum Inhalt <hi rend="italic">vgl. o.</hi> Einl. 3</seg><seg type="translation" xml:lang="en" source="#claude">The orig. read <hi rend="italic">hwæðer ma swa læs</hi>: a frequent antithesis; <hi rend="italic">see</hi> Toller 612. — On the content <hi rend="italic">cf. above</hi> Introduction 3</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_Epilog.attnote.fn.1" n="1" source="#attenborough"><bibl><biblScope unit="page">146</biblScope></bibl><label>sit</label><seg type="original" xml:lang="en"><hi rend="italic">sit in hoc, sit alterutrum</hi>. Br, M, Hk, T.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_Epilog.attnote.fn.2" n="2" source="#attenborough"><bibl><biblScope unit="page">146</biblScope></bibl><label>emendari</label><seg type="original" xml:lang="en"><hi rend="italic">emendare</hi>. Br, M.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_Epilog.attnote.fn.3" n="3" source="#attenborough"><bibl><biblScope unit="page">146</biblScope></bibl><label>secundum</label><seg type="original" xml:lang="en"><hi rend="italic">iuxta</hi>. Br, M.</seg></note>
      </div>
    </body>
