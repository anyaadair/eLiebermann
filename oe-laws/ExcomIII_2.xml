        <head><ref type="lawCode" target="law:ExcomIII">Excom III</ref> 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom III 2" corresp="#wit-o"><pb n="434" ed="#liebermann"/>Sintque participes eorum in<ptr type="liebermannNote" n="e" target="#ExcomIII_2.lnote.oe.e"/> inferno Dathan<ptr type="liebermannNote" n="f" target="#ExcomIII_2.lnote.oe.f"/> et Abyron, Herodes, Pilatus<ptr type="liebermannNote" n="g" target="#ExcomIII_2.lnote.oe.g"/>, Iudas<ptr type="liebermannNote" n="h" target="#ExcomIII_2.lnote.oe.h"/>, Cayphas, Barrabas, Nero<ptr type="liebermannNote" n="i" target="#ExcomIII_2.lnote.oe.i"/> et Symon<ptr type="liebermannNote" n="k" target="#ExcomIII_2.lnote.oe.k"/> magus,</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Num. 16, 33; Matth. 27, 2; A. apost. 8,</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 434 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomIII_2.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">434</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. u.</hi> 4. I 11, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf. below</hi> 4. I 11, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomIII_2.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">434</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> V 6. VI 4. VIII 3. X 7. XI 8. <hi rend="italic">Alet Gem</hi> 1 <hi rend="italic">Rot; häufig auch in Flüchen gegen Verletzer von Urkunden;</hi> Marculf II <hi rend="italic">p.</hi> 73. 77</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> V 6. VI 4. VIII 3. X 7. XI 8. <hi rend="italic">Alet Gem</hi> 1 <hi rend="italic">Rot; frequent also in curses against those who infringe charters;</hi> Marculf II <hi rend="italic">p.</hi> 73. 77</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomIII_2.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">434</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> V 6. VI 4. <hi rend="italic">Alet</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> V 6. VI 4. <hi rend="italic">Alet</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomIII_2.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">434</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> V 6. VI 4. X 7. XI 8. <hi rend="italic">Alet Leo Rot;</hi> æterno anathematis vinculo .. Iudæ traditori (<hi rend="italic">vgl.</hi> VII 5) sociatus <hi rend="italic">Engl. Synode a.</hi> 786 <hi rend="italic">c.</hi> 12; Iudas proditor <hi rend="italic">in diesem Zusammenhang auch</hi> Formulæ Flaviniac. II 482</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> V 6. VI 4. X 7. XI 8. <hi rend="italic">Alet Leo Rot;</hi> æterno anathematis vinculo .. Iudæ traditori (<hi rend="italic">cf.</hi> VII 5) sociatus <hi rend="italic">English synod a.</hi> 786 <hi rend="italic">c.</hi> 12; Iudas proditor <hi rend="italic">in this context also</hi> Formulæ Flaviniac. II 482</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomIII_2.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">434</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> V 6. XI 8 <hi rend="italic">Rot</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> V 6. XI 8 <hi rend="italic">Rot</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomIII_2.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">434</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> V 6. XI 8</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> V 6. XI 8</seg></note>
