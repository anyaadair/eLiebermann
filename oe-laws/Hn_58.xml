    <body>
      <div type="clause" n="58">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 58</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 58" corresp="#wit-lat"><pb n="577" ed="#liebermann"/>(C. LVIII<ptr type="liebermannNote" n="15" target="#Hn_58.lnote.oe.15"/>) De homine uaganti<ptr type="liebermannNote" n="16" target="#Hn_58.lnote.oe.16"/>. Aliter de uaganti<ptr type="liebermannNote" n="17" target="#Hn_58.lnote.oe.17"/> si dominum habeat, aliter si non habeat: quod<ptr type="liebermannNote" n="h" target="#Hn_58.lnote.oe.h"/> si fuerit et alicubi forisfaciat, ostendatur iusticie qu[i<ptr type="liebermannNote" n="18" target="#Hn_58.lnote.oe.18"/>] preerit, et consilio eius agatur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 577 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_58.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wenn der Vagant herrenlos, wird er dem Gerichtsherrn des Thatorts vorgeführt; vgl.</hi> 82, 2</seg><seg type="translation" xml:lang="en" source="#claude">if the vagrant has no lord, he is brought before the lord holding jurisdiction over the place of the deed; cf. 82, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_58.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_58.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">uago <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">uago Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_58.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">-ndi <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ndi Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_58.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">que <hi rend="italic">Hss. Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">que MSS edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_58.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Gefolge 9k—<hi rend="italic">uago</hi>{16}—<hi rend="italic">que</hi>{18} original (da <hi rend="italic">iusticia</hi>, auch trotz Bed. ‘Richter’, als Fem. oft im Normann. Latein vorkommt; z. B. Urk. [1120—28] Cunnigham <hi rend="italic">Growth Engl. industry</hi> 541) Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Gefolge 9k—<hi rend="italic">uago</hi>{16}—<hi rend="italic">que</hi>{18} original (since <hi rend="italic">iusticia</hi>, even with the meaning ‘judge’, often occurs as a feminine in Norman Latin; e.g. charter [1120—28] Cunnigham <hi rend="italic">Growth Engl. industry</hi> 541) Rs</seg></note>
      </div>
