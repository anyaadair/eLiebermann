      <div type="clause" n="33.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 33.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 33.2" corresp="#wit-lat"><pb n="564–565" ed="#liebermann"/>Iniusto quoque iudicio contradici<ptr type="liebermannNote" n="y" target="#Hn_33-2.lnote.oe.y"/> poterit wemminge<ptr type="liebermannNote" n="45" target="#Hn_33-2.lnote.oe.45"/> maiori et sapienciori, presertim si<ptr type="liebermannNote" n="46" target="#Hn_33-2.lnote.oe.46"/> in reddicione<ptr type="liebermannNote" n="47" target="#Hn_33-2.lnote.oe.47"/> fuerit<ptr type="liebermannNote" n="48" target="#Hn_33-2.lnote.oe.48"/> aduocatum<ptr type="liebermannNote" n="z" target="#Hn_33-2.lnote.oe.z"/>. illam reformare<ptr type="liebermannNote" n="1" target="#Hn_33-2.lnote.oe.1"/> quis cupiat, non procedet<ptr type="liebermannNote" n="2" target="#Hn_33-2.lnote.oe.2"/> in cele[bration]ibus[?]<ptr type="liebermannNote" n="a" target="#Hn_33-2.lnote.oe.a"/>, ut opus sit iudicibus narraciones repetere iudicii<ptr type="liebermannNote" n="3" target="#Hn_33-2.lnote.oe.3"/>, maxime si dominus querimonie interfuerit uel dapifer uel minister eius, uel congruum inde terminum<ptr type="liebermannNote" n="4" target="#Hn_33-2.lnote.oe.4"/> habuerit<ptr type="liebermannNote" n="5" target="#Hn_33-2.lnote.oe.5"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 564–565 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-2.lnote.oe.y" n="y" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">Urtheilsschelte; <hi rend="italic">vgl.</hi> 67, 2</seg><seg type="translation" xml:lang="en" source="#claude">challenge to the judgment; <hi rend="italic">cf.</hi> 67, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-2.lnote.oe.z" n="z" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">Berufung eingelegt sofort bei der Urtheilsabgabe (34, 4)</seg><seg type="translation" xml:lang="en" source="#claude">appeal lodged immediately upon the delivery of the judgment (34, 4)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-2.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">-ga <hi rend="italic">Lond;</hi> wenunga <hi rend="italic">Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ga <hi rend="italic">Lond;</hi> wenunga <hi rend="italic">Sp</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-2.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. vom Corr. aus</hi> non <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">corrected by the corrector from</hi> non <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-2.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">redi. <hi rend="italic">Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">redi. <hi rend="italic">MSS</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-2.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. vom Corr. aus</hi> fiunt <hi rend="italic">Sc;</hi> fiunt, <hi rend="italic">verb.</hi> fuerit <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">corrected by the corrector from</hi> fiunt <hi rend="italic">Sc;</hi> fiunt, <hi rend="italic">corrected to</hi> fuerit <hi rend="italic">Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">cel'ibus <hi rend="italic">Sc Hg;</hi> sceleribus <hi rend="italic">übr., Edd.; vgl.</hi> non procedit <hi rend="italic">S.</hi> 568 <hi rend="italic">Z.</hi> 2 <hi rend="italic">und</hi> iudicium celebrare 5, 2. 32, 1</seg><seg type="translation" xml:lang="en" source="#claude">cel'ibus <hi rend="italic">Sc Hg;</hi> sceleribus <hi rend="italic">the others, Edd.; cf.</hi> non procedit <hi rend="italic">p.</hi> 568 <hi rend="italic">l.</hi> 2 <hi rend="italic">and</hi> iudicium celebrare 5, 2. 32, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">info. q. <hi rend="italic">Or;</hi> informare <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">info. q. <hi rend="italic">Or;</hi> informare <hi rend="italic">Sc Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">-dit <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dit <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Punct unter letztem</hi> i <hi rend="italic">Sc;</hi> -ci <hi rend="italic">Hg Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Dot under the last</hi> i <hi rend="italic">Sc;</hi> -ci <hi rend="italic">Hg Wh</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert vom Corr. aus</hi> tamen <hi rend="italic">Sc;</hi> tunc <hi rend="italic">fügt zu K Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">corrected by the corrector from</hi> tamen <hi rend="italic">Sc;</hi> tunc <hi rend="italic">added by K Edd.</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">habuit <hi rend="italic">Sc Hg K</hi></seg><seg type="translation" xml:lang="en" source="#claude">habuit <hi rend="italic">Sc Hg K</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-2.lnote.oe.a-2" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Urteilschelte 4—6. In Agsächs. Zeit ist dieser Sinn noch nicht belegt. Es heisst <hi rend="italic">(ge)wemman</hi> ‘beflecken, tadeln’, <hi rend="italic">(ge)wemming</hi> ‘Schändung, Profanation’, <hi rend="italic">gewemmednys</hi> dass., <hi rend="italic">gewemmodlice</hi>: ‘corrupte’, <hi rend="italic">unwemme(d), -mlic</hi> ‘fleckenlos, untadelig, rein, unverletzt’, <hi rend="italic">unwemnes</hi> ‘Reinheit’.—<hi rend="italic">Contradicere, chalonger</hi> hat diesen Sinn in Frankreich; Brunner II 357.—<hi rend="italic">wemunga</hi>—<hi rend="italic">redic</hi>.{47}—33, 2a <hi rend="italic">procedit</hi>{2} <hi rend="italic">in sceleribus, ut</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Urteilschelte 4—6. This meaning is not yet attested in the Anglo-Saxon period. <hi rend="italic">(ge)wemman</hi> means ‘to stain, to blame’, <hi rend="italic">(ge)wemming</hi> ‘defilement, profanation’, <hi rend="italic">gewemmednys</hi> the same, <hi rend="italic">gewemmodlice</hi>: ‘corrupte’, <hi rend="italic">unwemme(d), -mlic</hi> ‘spotless, blameless, pure, unharmed’, <hi rend="italic">unwemnes</hi> ‘purity’.—<hi rend="italic">Contradicere, chalonger</hi> has this meaning in France; Brunner II 357.—<hi rend="italic">wemunga</hi>—<hi rend="italic">redic</hi>.{47}—33, 2a <hi rend="italic">procedit</hi>{2} <hi rend="italic">in sceleribus, ut</hi> Rs</seg></note>
      </div>
