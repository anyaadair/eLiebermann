      <div type="clause" n="10.3">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 10.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 10.3"><pb n="634" ed="#liebermann"/>Et si quis plures domos habuerit<ptr type="liebermannNote" n="18" target="#ECf_10-3.lnote.la.18"/>, de illa ubi<ptr type="liebermannNote" n="f" target="#ECf_10-3.lnote.la.fn.f"/> residens fuerit<ptr type="liebermannNote" n="19" target="#ECf_10-3.lnote.la.19"/> festo apostolorum<ptr type="liebermannNote" n="20" target="#ECf_10-3.lnote.la.20"/> Petri et Pauli<ptr type="liebermannNote" n="c" target="#ECf_10-3.lnote.la.fn.c"/>, reddet<ptr type="liebermannNote" n="21" target="#ECf_10-3.lnote.la.21"/> denarium.</ab>
        <note type="comparison" source="#liebermann" n="634"><label>printed alongside</label> <ref target="clause:ECfRetr_10-3">ECf retr 10.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 634 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_10-3.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">29. <hi rend="italic">Juni; Zahlung nach</hi> VI Atr. Lat. 18</seg><seg type="translation" xml:lang="en" source="#claude">29 June; payment according to VI Atr. Lat. 18</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_10-3.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so entscheidet über Kirchenschoss der Wintersitz nach</hi> Ine 61</seg><seg type="translation" xml:lang="en" source="#claude">so, according to Ine 61, the winter residence decides church-scot</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-3.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">habuit <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">habuit Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-3.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">fügt zu Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad Do add in</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-3.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">beati <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">beati Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_10-3.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">-dat <hi rend="italic">Hk Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dat Hk Ad Do</seg></note>
      </div>
