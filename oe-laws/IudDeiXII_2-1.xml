      <div type="clause" n="2.1">
        <head><ref type="lawCode" target="law:IudDeiXII">Iud Dei XII</ref> 2.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XII 2.1" corresp="#wit-lat"><pb n="420" ed="#liebermann"/>Pergens ad<ptr type="liebermannNote" n="12" target="#IudDeiXII_2-1.lnote.oe.12"/> ęcclesiam sacerdos, induat se uestimentis sacris excepta casula, ferens (in<ptr type="liebermannNote" n="13" target="#IudDeiXII_2-1.lnote.oe.13"/> laeua) sanctum euangelium cum crismario et patrociniis sanctorum calicemque et<ptr type="liebermannNote" n="14" target="#IudDeiXII_2-1.lnote.oe.14"/> patena, expectante eum plebe cum fure — uel quocunque<ptr type="liebermannNote" n="15" target="#IudDeiXII_2-1.lnote.oe.15"/> crimine implicato — in atrio ecclesię, et dicat coram astanti plebe in hostio<ptr type="liebermannNote" n="16" target="#IudDeiXII_2-1.lnote.oe.16"/> ecclesię<ptr type="liebermannNote" n="17" target="#IudDeiXII_2-1.lnote.oe.17"/>:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 420 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_2-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de">s. ad e. <hi rend="italic">Vt2 Tr Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. ad e. Vt2 Tr Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_2-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de">in l. <hi rend="italic">nur Tr und meiste Hss. Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">in l. only Tr and most of Zeu.’s MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_2-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de">cum <hi rend="italic">Zeu. besser</hi></seg><seg type="translation" xml:lang="en" source="#claude">cum Zeu., better</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_2-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de">qualic. <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">qualic. Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_2-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de">ostio <hi rend="italic">Vt2 Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">ostio Vt2 Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_2-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de">Omnes tamen qui affuerint, ut supra, sint ieiuni <hi rend="italic">fügt zu Tr; vgl. o. S.</hi> 419<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">Tr adds Omnes tamen qui affuerint, ut supra, sint ieiuni; cf. above p. 419b</seg></note>
      </div>
