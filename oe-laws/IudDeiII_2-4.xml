      <div type="clause" n="2.4">
        <head><ref type="lawCode" target="law:IudDeiII">Iud Dei II</ref> 2.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei II 2.4" corresp="#wit-lat"><pb n="406" ed="#liebermann"/>Deus, qui in<ptr type="liebermannNote" n="24" target="#IudDeiII_2-4.lnote.oe.24"/> aduentu sancti<ptr type="liebermannNote" n="25" target="#IudDeiII_2-4.lnote.oe.25"/> Spiritus tui<ptr type="liebermannNote" n="26" target="#IudDeiII_2-4.lnote.oe.26"/> inlustratione<ptr type="liebermannNote" n="21" target="#IudDeiII_2-4.lnote.oe.21"/> ignis fideles tuos ab infidelibus decreuisti<ptr type="liebermannNote" n="27" target="#IudDeiII_2-4.lnote.oe.27"/>,</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Act. apost. 2, 3</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 406 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-4.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">ill. <hi rend="italic">H Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">ill. H Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-4.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">ad <hi rend="italic">Ca;</hi> ante aduentum V <hi rend="italic">Rj1</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad Ca; ante aduentum V Rj1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-4.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">Sp. sa. <hi rend="italic">Rj; fehlt Pt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Sp. sa. Rj; omitted in Pt Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-4.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">tuum V</seg><seg type="translation" xml:lang="en" source="#claude">tuum V</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-4.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">discr. <hi rend="italic">Rj Rj1 Ch Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">discr. Rj Rj1 Ch Vt</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">O God, who at the coming of your Holy Spirit distinguished your faithful from the unbelievers by the illumination of fire,</ab>
      </div>
    </body>
