    <body>
      <div type="clause" n="5.4">
        <head><ref type="lawCode" target="law:IVAtr">IV Atr</ref> 5.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.4" corresp="#wit-q"><pb n="234" ed="#liebermann"/>Et monetarii<ptr type="liebermannNote" n="53" target="#IVAtr_5-4.lnote.oe.53"/>, qui in nemoribus operantur<ptr type="liebermannNote" n="53" target="#IVAtr_5-4.lnote.oe.53"/> uel alicubi<ptr type="liebermannNote" n="54" target="#IVAtr_5-4.lnote.oe.54"/> similibus fabricant, uitę suę culpabiles sint, nisi rex<ptr type="liebermannNote" n="55" target="#IVAtr_5-4.lnote.oe.55"/> uelit eorum misereri.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="5.4" corresp="#wit-q"><pb n="74" ed="#robertson"/>Et monetarii<ptr type="editorNote" n="16" target="#IVAtr_5-4.robnote.fn.16"/>, qui in nemoribus operantur<ptr type="editorNote" n="16" target="#IVAtr_5-4.robnote.fn.16"/> vel alicubi<ptr type="editorNote" n="17" target="#IVAtr_5-4.robnote.fn.17"/> similibus fabricant, vitae suae culpabiles sint, nisi rex velit eorum misereri.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><ptr type="liebermannNote" n="1" target="#IVAtr_5-4.lnote.de.1"/><pb n="235" ed="#liebermann"/>Und Münzer, welche in Wäldern arbeiten oder sonstwo in ähnlichen [heimlichen Orten] schmieden, seien [des Verlustes] ihres Lebens schuldig, ausser wenn der König sich ihrer erbarmen will.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And moneyers who work in woods or forge anywhere in similar [secret places], let them be liable [to lose] their lives, unless the king is willing to have mercy on them.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q"><ptr type="editorNote" n="1" target="#IVAtr_5-4.robnote.n.1"/><pb n="75" ed="#robertson"/>And moneyers who carry on their business in woods or work in other such places shall forfeit their lives, unless the king is willing to pardon them.</ab>
        <note type="comparison" source="#liebermann" n="235"><ref target="clause:IIIAtr_16">III Atr 16</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. III Atr. 16</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IIIAtr_16">III Atr 16</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="323"><ref target="clause:IIIAtr_16">III Atr 16</ref></note>
        <note type="editorial">Liebermann compares III Atr 16.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_5-4.lnote.oe.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">234</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_5-4.lnote.oe.54" n="54" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">234</biblScope></bibl><seg type="original" xml:lang="de">alibi <hi rend="italic">TMHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">alibi TMHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_5-4.lnote.oe.55" n="55" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">234</biblScope></bibl><seg type="original" xml:lang="de">u. r. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. r. Hk</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_5-4.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">166</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Der Agsä. Wortlaut des Satzes steht III 16, aber mit einer Lücke, und vielleicht dort nicht zugehörig; <hi rend="italic">s. o</hi>. zu III Atr 16¹</seg><seg type="translation" xml:lang="en" source="#claude">The Anglo-Saxon wording of the clause appears at III 16, but with a lacuna, and perhaps it does not belong there; <hi rend="italic">see above</hi> on III Atr 16¹</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_5-4.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">326</biblScope></bibl><seg type="original" xml:lang="en">Cf. III Atr. 16.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_5-4.robnote.fn.16" n="16" source="#robertson"><bibl><biblScope unit="page">74</biblScope></bibl><label>monetarii</label><seg type="original" xml:lang="en">Om. Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_5-4.robnote.fn.17" n="17" source="#robertson"><bibl><biblScope unit="page">74</biblScope></bibl><label>alicubi</label><seg type="original" xml:lang="en"><hi rend="italic">alibi</hi> T, M, Hk, Br.</seg></note>
      </div>
    </body>
