        <head><ref type="lawCode" target="law:Hn">Hn</ref> 76.3a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 76.3a" corresp="#wit-lat"><pb n="593" ed="#liebermann"/>Liberi alii tƿyhindi<ptr type="liebermannNote" n="21" target="#Hn_76-3a.lnote.oe.21"/>, alii<ptr type="liebermannNote" n="h" target="#Hn_76-3a.lnote.oe.h"/> syxhindi<ptr type="liebermannNote" n="22" target="#Hn_76-3a.lnote.oe.22"/>, alii tƿelfhindi<ptr type="liebermannNote" n="23" target="#Hn_76-3a.lnote.oe.23"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 593 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3a.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wohl nur aus</hi> Af 18, 2. 30, <hi rend="italic">die Hn</hi> 82, 9. 87, 4 <hi rend="italic">benutzt, vielleicht (nach Maitland</hi> Domesday 44) <hi rend="italic">ohne die</hi> 600 <hi rend="italic">Schilling-Classe noch zu kennen</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">probably only from</hi> Af 18, 2. 30, <hi rend="italic">which are used in Hn</hi> 82, 9. 87, 4, <hi rend="italic">perhaps (according to Maitland</hi> Domesday 44) <hi rend="italic">without his yet knowing the</hi> 600 <hi rend="italic">shilling class</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3a.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de">thyyh. <hi rend="italic">Sc Hg;</hi> ƿifh. <hi rend="italic">K;</hi> wifh. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">thyyh. <hi rend="italic">Sc Hg;</hi> ƿifh. <hi rend="italic">K;</hi> wifh. <hi rend="italic">Co Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3a.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de">sex. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sex. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3a.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de">thyelf. <hi rend="italic">Sc Hg;</hi> twelh. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">thyelf. <hi rend="italic">Sc Hg;</hi> twelh. <hi rend="italic">Co</hi></seg></note>
