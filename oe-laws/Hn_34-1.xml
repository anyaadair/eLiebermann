      <div type="clause" n="34.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 34.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 34.1" corresp="#wit-lat"><pb n="565" ed="#liebermann"/>Si quis ira uel odio<ptr type="liebermannNote" n="i" target="#Hn_34-1.lnote.oe.i"/> uel timore<ptr type="liebermannNote" n="19" target="#Hn_34-1.lnote.oe.19"/> uel amore uel cupiditate uel quoquo<ptr type="liebermannNote" n="20" target="#Hn_34-1.lnote.oe.20"/> respectu<ptr type="liebermannNote" n="k" target="#Hn_34-1.lnote.oe.k"/> iniustum<ptr type="liebermannNote" n="l" target="#Hn_34-1.lnote.oe.l"/> iudicet uel unlagam<ptr type="liebermannNote" n="21" target="#Hn_34-1.lnote.oe.21"/> constituat, CXX sol. culpa sit et ðegenscypes<ptr type="liebermannNote" n="m" target="#Hn_34-1.lnote.oe.m"/><ptr type="liebermannNote" n="22" target="#Hn_34-1.lnote.oe.22"/> (honore) et<ptr type="liebermannNote" n="23" target="#Hn_34-1.lnote.oe.23"/> omni<ptr type="liebermannNote" n="n" target="#Hn_34-1.lnote.oe.n"/> iudiciaria<ptr type="liebermannNote" n="24" target="#Hn_34-1.lnote.oe.24"/> dignitate priuetur<ptr type="liebermannNote" n="25" target="#Hn_34-1.lnote.oe.25"/>, nisi se erga regem redimat, sicut in eius misericordia erit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 565 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">peruertitur iudicium timore, cupiditate, odio et amore <hi rend="italic">Isidori</hi> Sent. 3, 54, 7</seg><seg type="translation" xml:lang="en" source="#claude">peruertitur iudicium timore, cupiditate, odio et amore <hi rend="italic">Isidori</hi> Sent. 3, 54, 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ausgeschrieben vom Corrector über Sc’s</hi> r&lt;sup&gt;u&lt;/sup&gt; [<hi rend="italic">was dafür richtige Sigle, aber als</hi> r <hi rend="italic">von Wheloc missverstanden ist;</hi> forte ‘regis’ <hi rend="italic">Twysden;</hi> iudicium <hi rend="italic">ändert Somner</hi>]</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">written out in full by the corrector over Sc’s</hi> r&lt;sup&gt;u&lt;/sup&gt; [<hi rend="italic">which is the correct abbreviation for it, but was misread by Wheloc as</hi> r<hi rend="italic">;</hi> forte ‘regis’ <hi rend="italic">Twysden;</hi> iudicium <hi rend="italic">Somner emends</hi>]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Leis Wl 39, 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> Leis Wl 39, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Angelsächs. Cnut. Anders</hi> 34, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">from the Anglo-Saxon Cnut. Differently</hi> 34, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi> 13, 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">so</hi> 13, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">a. uel t. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. uel t. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">quocumque <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">quocumque <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">utl. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">utl. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">ð. <hi rend="italic">Sc; statt dessen</hi> h. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">ð. <hi rend="italic">Sc; instead of which</hi> h. <hi rend="italic">the others</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K;</hi> id est <hi rend="italic">empfiehlt Somner</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">omitted in K;</hi> id est <hi rend="italic">proposed by Somner</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">d. i. <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. i. <hi rend="italic">K Co Or Gi</hi></seg></note>
