  <text>
    <body>
      <div type="clause" n="3.2">
        <head><ref type="lawCode" target="law:Forf">Forf</ref> 3.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.2" corresp="#wit-b"><pb n="390" ed="#liebermann"/>Gyf hit ðonne elles on hydelse funden sy, ðonne mæg þ<hi rend="italic">æt</hi> forfangfeoh leohtre beon, forðam<ptr type="liebermannNote" n="3" target="#Forf_3-2.lnote.oe.3"/> bið on læsse plihte begytan<ptr type="liebermannNote" n="4" target="#Forf_3-2.lnote.oe.4"/>.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3.2" corresp="#wit-q"><pb n="391" ed="#liebermann"/>Si uero aliter inueniatur occultum<ptr type="liebermannNote" n="16" target="#Forf_3-2.lnote.oe.16"/>, tunc potest forfang<ptr type="liebermannNote" n="17" target="#Forf_3-2.lnote.oe.17"/> esse minoris precii, quia minori fuit<ptr type="liebermannNote" n="18" target="#Forf_3-2.lnote.oe.18"/> periculo<ptr type="liebermannNote" n="19" target="#Forf_3-2.lnote.oe.19"/> conquisitum<ptr type="liebermannNote" n="20" target="#Forf_3-2.lnote.oe.20"/>.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3.2" corresp="#wit-cons"><pb n="391" ed="#liebermann"/>sin autem in repostaculo reperta, tunc poterit census anticipacionis moderacior esse, eo quod minori periculo nacta sit.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="391" ed="#liebermann"/>Wenn es dagegen anderswo, im Versteck<ptr type="liebermannNote" n="1" target="#Forf_3-2.lnote.de.1"/>, gefunden ist, dann kann die Rettungsgebühr leichter sein, weil es in weniger Gefahr erlangt worden ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If, on the other hand, it is found elsewhere, in hiding, then the rescue-fee may be lighter, because it was obtained at less risk.</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-b">If [stolen] property is found in a hidden [but nearer?] place, then the reward may be less, because it was recovered with less trouble.</ab>
        <note type="editorial">U: translator unrecorded: check; Thorpe supplies ‘hit’ after ‘forðam’. Compare ‘bebodan’ II Eg 5. In B (as in the Quadripartitus and the Consiliatio) Hundred follows.; BR: added from Gesetze I p. 391, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Forf_3-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">391</biblScope></bibl><seg type="original" xml:lang="de">antip. <hi rend="italic">Hr;</hi> m. a. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">antip. Hr; m. a. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Forf_3-2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">391</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> Hundred</seg><seg type="translation" xml:lang="en" source="#claude">followed by Hundred</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Forf_3-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">391</biblScope></bibl><seg type="original" xml:lang="de">-ltatum <hi rend="italic">RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ltatum RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Forf_3-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">391</biblScope></bibl><seg type="original" xml:lang="de">-feng <hi rend="italic">K;</hi> forefeng <hi rend="italic">Or;</hi> forfangium <hi rend="italic">TMHk;</hi> forisfangium <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">-feng K; forefeng Or; forfangium TMHk; forisfangium R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Forf_3-2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">391</biblScope></bibl><seg type="original" xml:lang="de">fuerit <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">fuerit T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Forf_3-2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">391</biblScope></bibl><seg type="original" xml:lang="de">pretio <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">pretio MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Forf_3-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">391</biblScope></bibl><seg type="original" xml:lang="de">quam quis. <hi rend="italic">R; folgt</hi> Hundred</seg><seg type="translation" xml:lang="en" source="#claude">quam quis. R; followed by Hundred</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Forf_3-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">390</biblScope></bibl><seg type="original" xml:lang="de">hit <hi rend="italic">ergänzt Thorpe</hi></seg><seg type="translation" xml:lang="en" source="#claude">hit supplied by Thorpe</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Forf_3-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">390</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> bebodan <hi rend="italic">II Eg.</hi> 5. <hi rend="italic">In B folgt</hi> [<hi rend="italic">wie in Qu. Cons.</hi>] Hundred, <hi rend="italic">o. S.</hi> 192.</seg><seg type="translation" xml:lang="en" source="#claude">cf. bebodan II Eg. 5. In B there follows [as in Qu. Cons.] Hundred, above p. 192.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Forf_3-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">229</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Cons bildet ein Wort aus <hi rend="italic">repostorium</hi> ‘Gewahrsam, Geheimbehälter’.—Vermutlich näherte sich dann der ‘Einfang’ dem im ältesten Rechte noch fehlenden Finderlohne (<hi rend="italic">s</hi>. J. Hübner 52) oder dem Lohne für ‘Anzeige’; <hi rend="italic">s. d. Gl</hi> 8—9 über den Unterschied</seg><seg type="translation" xml:lang="en" source="#claude">Cons forms a word from <hi rend="italic">repostorium</hi> ‘custody, secret receptacle’.—Presumably the ‘capture’ then came close to the finder's reward, which is still absent from the oldest law (<hi rend="italic">see</hi> J. Hübner 52), or to the reward for ‘information’; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 8—9 on the difference</seg></note>
      </div>
    </body>
