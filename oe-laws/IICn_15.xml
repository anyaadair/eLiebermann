        <note type="liebermannNote" subtype="textual" xml:id="IICn_15.lnote.oe.9-2" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de">wille <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wille Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_15.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">319</biblScope></bibl><seg type="original" xml:lang="de">Secundum legem D. — cons. <hi rend="italic">roth Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">Secundum legem D. — cons. in red Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_15.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">319</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt CbLb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in CbLb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_15.lnote.oe.6-3" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">319</biblScope></bibl><seg type="original" xml:lang="de">r. hab. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. hab. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_15.lnote.oe.7-3" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">319</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur Cb; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">only Cb; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_15.lnote.oe.8-3" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">319</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_15.lnote.oe.9-3" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">319</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">spät geänd.</hi> -che <hi rend="italic">Cb;</hi> gritbreche <hi rend="italic">Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">altered late to -che Cb; gritbreche Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_15.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">319</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">fügt zu Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel added by Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_15.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">319</biblScope></bibl><seg type="original" xml:lang="de">d. u. <hi rend="italic">HLb</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. u. HLb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_15.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">204</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nicht blosses Waffenzücken oder bloss ‘private war’ oder bloss Totschlag; <hi rend="italic">vgl. Gl</hi> blutig 1—i</seg><seg type="translation" xml:lang="en" source="#claude">Not merely drawing a weapon, or merely ‘private war’, or merely homicide; <hi rend="italic">cf. Gl</hi> blutig 1—i</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_15.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">204</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘Münzfälschung’ (<hi rend="italic">s. d. Gl</hi> 5. a) ist bloss Lesefehler in Inst oder Schreibfehler seiner Vorlage, obwohl bevorzugt von Pol Mai II 451. Allerdings gehört sie zum Kronprozess</seg><seg type="translation" xml:lang="en" source="#claude">‘Counterfeiting’ (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 5. a) is merely a misreading in Inst or a scribal error in its exemplar, although preferred by Pol Mai II 451. It does, admittedly, belong to the pleas of the Crown</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_15.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">204</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘Verlassen’ zu eng; auch Nichterscheinen war strafbar; <hi rend="italic">s. Gl</hi> Heer 8a</seg><seg type="translation" xml:lang="en" source="#claude">‘Desertion’ is too narrow; failure to appear was also punishable; <hi rend="italic">see Gl</hi> Heer 8a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_15.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">204</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘Friedensbruch’ allgemein; <hi rend="italic">vgl. Gl</hi> Königsfrieden 1c. 6b</seg><seg type="translation" xml:lang="en" source="#claude">Not ‘breach of the peace’ in general; <hi rend="italic">cf. Gl</hi> Königsfrieden 1c. 6b</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_15.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">204</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘Hausfrieden’</seg><seg type="translation" xml:lang="en" source="#claude">Not ‘peace of the house’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_15.lnote.de.6" n="6" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">204</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. 12¹³.—In Stamford entzieht das Domesday I 336b 2 zugunsten des Königs dem Grundherrn unter dem Strafgeldempfange die <hi rend="italic">forisfactura corporum de 40 oris argenti</hi> und den <hi rend="italic">lagemanni</hi> den <hi rend="italic">latro</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 12¹³.—In Stamford, Domesday I 336b 2 withdraws from the landlord's receipt of fines, in favour of the king, the <hi rend="italic">forisfactura corporum de 40 oris argenti</hi>, and from the <hi rend="italic">lagemanni</hi> the <hi rend="italic">latro</hi></seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_15.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">353</biblScope></bibl><seg type="original" xml:lang="en">Cf. cap. 12.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_15.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">353</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e.</hi> a fine for fighting which has resulted in the shedding of blood, cf. II Edm. 3; <hi rend="italic">Be Wergilde</hi>, 6. It covers, therefore, cases both of wounding and of slaying.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_15.robnote.fn.7" n="7" source="#robertson"><bibl><biblScope unit="page">180</biblScope></bibl><label>hwǽne</label><seg type="original" xml:lang="en"><hi rend="italic">he hw. ðe</hi> G.</seg></note>
      </div>
