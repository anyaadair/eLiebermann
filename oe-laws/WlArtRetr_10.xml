    <body>
      <div type="clause" n="10">
        <head><ref type="lawCode" target="law:WlArtRetr">Wl art retr</ref> 10</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-lond"><pb n="491" ed="#liebermann"/>Interdicimus etiam, ut nulla uiua<ptr type="liebermannNote" n="5" target="#WlArtRetr_10.lnote.oe.5"/> peccunia uendatur<ptr type="liebermannNote" n="6" target="#WlArtRetr_10.lnote.oe.6"/> aut<ptr type="liebermannNote" n="7" target="#WlArtRetr_10.lnote.oe.7"/> ematur nisi intra ciuitates, et hoc ante tres fideles testes, nec aliquam rem uetitam<ptr type="liebermannNote" n="8" target="#WlArtRetr_10.lnote.oe.8"/> sine fideiussore et waranto. Quodsi <ptr type="liebermannNote" n="9" target="#WlArtRetr_10.lnote.oe.9"/>aliter fecerit, soluat et persoluat, et postea forisfacturam.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:WlArtRetr_11">Wl art retr 11</ref></note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 491 (two independent readings of the page images, differences settled against the page); Robertson does not print this clause separately</note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_10.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt; Lücke K3 Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing; gap K3 Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_10.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">-dantur aut emantur <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dantur aut emantur Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_10.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_10.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">uenditam</hi> <hi rend="italic">Co Or;</hi> aliqua res uendita <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">uenditam</hi> Co Or; aliqua res uendita Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_10.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">491</biblScope></bibl><seg type="original" xml:lang="de">quis <hi rend="italic">fügt zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ld adds quis</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_10.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">283</biblScope></bibl><seg type="original" xml:lang="de">Über <hi rend="italic">uetitam</hi> (<hi rend="italic">ueitam</hi> liest Rs) <hi rend="italic">s</hi>. Wl art 5{c}; <hi rend="italic">venditam</hi> wohl nur tautologisch aus <hi rend="italic">uendatur</hi> voriger Z.</seg><seg type="translation" xml:lang="en" source="#claude">On <hi rend="italic">uetitam</hi> (Rs reads <hi rend="italic">ueitam</hi>) <hi rend="italic">see</hi> Wl art 5{c}; <hi rend="italic">venditam</hi> is probably merely tautological, taken from <hi rend="italic">uendatur</hi> in the preceding l.</seg></note>
      </div>
