        <note type="liebermannNote" subtype="textual" xml:id="Af_4-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">50</biblScope></bibl><seg type="original" xml:lang="de">syrwe <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">syrwe So Ld</seg></note>
