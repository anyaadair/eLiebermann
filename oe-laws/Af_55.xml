      <div type="clause" n="55">
        <head><ref type="lawCode" target="law:Af">Af</ref> 55</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="55" corresp="#wit-e"><pb n="82" ed="#liebermann"/>Gif ða earmscancan beoð<ptr type="liebermannNote" n="5" target="#Af_55.lnote.oe.5"/> begen forade, sio<ptr type="liebermannNote" n="6" target="#Af_55.lnote.oe.6"/> bot bið XXX scill.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="55" corresp="#wit-h"><pb n="82" ed="#liebermann"/>Gif ða earmsconcan<ptr type="liebermannNote" n="1" target="#Af_55.lnote.oe.1"/> beoð<ptr type="liebermannNote" n="4" target="#Af_55.lnote.oe.4"/> begen forode<ptr type="liebermannNote" n="5" target="#Af_55.lnote.oe.5-2"/>, seo<ptr type="liebermannNote" n="4" target="#Af_55.lnote.oe.4"/> bot bið XXX scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="55" corresp="#wit-b-no-prol"><pb n="82" ed="#liebermann"/>Gyf ða earmscancan beoð begen forade, seo bot bið ðrittig scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="55" corresp="#wit-q"><pb n="83" ed="#liebermann"/>Si utrumque<ptr type="liebermannNote" n="4" target="#Af_55.lnote.oe.4-2"/> os brachii fractum sit, emendatio est XXX solidi.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="88" ed="#attenborough"/>Gif ða earmscancan beoð begen forade, sio bot bið XXX scill.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="58.1" corresp="#wit-e"><pb n="354" ed="#jurasinski-and-oliver"/>Gif þa earmscancan beoð begen forade, sio bot bið XXX scill.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="83" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_55.lnote.de.1"/> die Armknochen beide<ptr type="liebermannNote" n="2" target="#Af_55.lnote.de.2"/> [der des Ober- und der<ptr type="liebermannNote" n="3" target="#Af_55.lnote.de.3"/> des Unterarms] gebrochen sind, ist die Busse 30 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If both arm-bones [that of the upper and that of the lower arm] are broken, the compensation is 30 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="89" ed="#attenborough"/>If both<ptr type="editorNote" n="1" target="#Af_55.attnote.n.1"/> bones in the arm are broken, the compensation [to be paid] shall be 30 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="355" ed="#jurasinski-and-oliver"/>If the armbones both are broken, the compensation is 30 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_55.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">biþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">biþ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_55.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">seo bote <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">seo bote Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_55.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_55.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_55.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> forade</seg><seg type="translation" xml:lang="en" source="#claude">altered to forade</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_55.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">utrum <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">utrum Or</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_55.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Inst. missverstehen ‘beide Arme’</seg><seg type="translation" xml:lang="en" source="#claude">Inst. misunderstand ‘both arms’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_55.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Wortstellung <hi rend="italic">s.</hi> Wülfing <hi rend="italic">Syntax</hi> 304</seg><seg type="translation" xml:lang="en" source="#claude">On word order <hi rend="italic">see</hi> Wülfing <hi rend="italic">Syntax</hi> 304</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_55.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Wohl nicht ‘des Unterarms: Radius und Ulna’. Ob Af soviel Anatomie verstand? Und warum sollte Unterarm doppelt soviel wie Oberarm gelten und allein <hi rend="italic">sceanca</hi> heissen, das doch auch vom Bein gebraucht wird? Auch sondert Af beim Bein Ober- und Unterschenkel; 62f.</seg><seg type="translation" xml:lang="en" source="#claude">Probably not ‘of the forearm: radius and ulna’. Would Af have understood that much anatomy? And why should the forearm be valued at twice the upper arm and alone be called <hi rend="italic">sceanca</hi>, which is after all also used of the leg? Moreover, in the case of the leg Af distinguishes thigh and shank; 62f.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_55.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">199</biblScope></bibl><seg type="original" xml:lang="en">According to Liebermann, ‘both bones’ refers, not to the radius and the ulna, but to the bones both above and below the elbow.</seg></note>
      </div>
    </body>
  </text>
