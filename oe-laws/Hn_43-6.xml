      <div type="clause" n="43.6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 43.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 43.6" corresp="#wit-lat"><pb n="569" ed="#liebermann"/>Qu[ot]cunque<ptr type="liebermannNote" n="22" target="#Hn_43-6.lnote.oe.22"/> dominos<ptr type="liebermannNote" n="k" target="#Hn_43-6.lnote.oe.k"/> aliquis habeat uel quantumcunque de aliis teneat, ei magis obnoxius est et eius residens esse debet<ptr type="liebermannNote" n="23" target="#Hn_43-6.lnote.oe.23"/> cuius legius<ptr type="liebermannNote" n="24" target="#Hn_43-6.lnote.oe.24"/> est.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 569 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-6.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt</hi> 55, 2. 82, 5</seg><seg type="translation" xml:lang="en" source="#claude">repeated 55, 2. 82, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-6.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">Quantumcumque <hi rend="italic">Hss., geb. aus</hi> 82, 5 <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">Quantumcumque MSS, emended from 82, 5 Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-6.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">de <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">de Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-6.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">lig. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lig. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-6.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de">Am Rande spät: <hi rend="italic">Cui de diversis dominis maior reverencia seu fidelitas debetur</hi> Rs.—<hi rend="italic">Vgl. Gl</hi> ligius. Wilhelm II. datiert 1093 von <hi rend="italic">die crastina qua Anselmus meus ligeus homo factus est</hi>; Davis <hi rend="italic">Reg. Agnorm</hi>. n. 337.—Zu <hi rend="italic">residens</hi> vgl. den Ausgang des Begriffes <hi rend="italic">ligius</hi> aus ‘Muntmann im Hause des Herrn wohnhaft’; E. Mayer <hi rend="italic">Dt. Fz. Vfg</hi>. II 116.—<hi rend="italic">Quantumcum-</hi> <hi rend="italic">que</hi>{22}—<hi rend="italic">lig</hi>.{24} Rs.—Statt <hi rend="italic">cuius</hi>{a} bessere <hi rend="italic">cuius</hi>{kk}</seg><seg type="translation" xml:lang="en" source="#claude">In the margin, in a late hand: <hi rend="italic">Cui de diversis dominis maior reverencia seu fidelitas debetur</hi> Rs.—<hi rend="italic">Cf. Gl</hi> ligius. William II dates a writ in 1093 <hi rend="italic">die crastina qua Anselmus meus ligeus homo factus est</hi>; Davis <hi rend="italic">Reg. Agnorm</hi>. n. 337.—On <hi rend="italic">residens</hi> cf. the origin of the concept <hi rend="italic">ligius</hi> in ‘a man under mund living in the lord’s house’; E. Mayer <hi rend="italic">Dt. Fz. Vfg</hi>. II 116.—<hi rend="italic">Quantumcum-</hi> <hi rend="italic">que</hi>{22}—<hi rend="italic">lig</hi>.{24} Rs.—Instead of <hi rend="italic">cuius</hi>{a} read <hi rend="italic">cuius</hi>{kk}</seg></note>
      </div>
