      <div type="clause" n="24">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 24</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 24"><pb n="649" ed="#liebermann"/><hi rend="bold"><hi rend="spaced">De</hi></hi><ptr type="liebermannNote" n="8" target="#ECfRetr_24.lnote.la.8"/> <hi rend="bold"><hi rend="spaced">(animalibus</hi></hi><ptr type="liebermannNote" n="9" target="#ECfRetr_24.lnote.la.9"/><hi rend="bold"><hi rend="spaced">, de</hi></hi><ptr type="liebermannNote" n="10" target="#ECfRetr_24.lnote.la.10"/> <hi rend="bold"><hi rend="spaced">equis uel aliis) rebus inuentis (quid faciendum sit).</hi></hi> Si quis adduxerit animal<ptr type="liebermannNote" n="11" target="#ECfRetr_24.lnote.la.11"/> in<ptr type="liebermannNote" n="12" target="#ECfRetr_24.lnote.la.12"/> uillam<ptr type="liebermannNote" n="13" target="#ECfRetr_24.lnote.la.13"/> uel apportauerit pecuniam et dixerit<ptr type="liebermannNote" n="14" target="#ECfRetr_24.lnote.la.14"/> se inuenisse, <hi rend="bold">prius</hi>quam introducat<ptr type="liebermannNote" n="15" target="#ECfRetr_24.lnote.la.15"/> in domum suam uel <hi rend="bold">etiam</hi> alterius, ante<ptr type="liebermannNote" n="16" target="#ECfRetr_24.lnote.la.16"/> ecclesiam ducat et <hi rend="bold">coram</hi> sacerdote ecclesie et pre<hi rend="bold">posito</hi> uille et melioribus hominibus<ptr type="liebermannNote" n="17" target="#ECfRetr_24.lnote.la.17"/> totum ostendat inuentum<ptr type="liebermannNote" n="18" target="#ECfRetr_24.lnote.la.18"/>, quicquid sit.</ab>
        <note type="comparison" source="#liebermann" n="649"><label>printed alongside</label> <ref target="clause:ECf_24">ECf 24</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 649 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> De r. i. <hi rend="italic">Db; nur</hi> De inuencionibus <hi rend="italic">Pl S;</hi> De an. uel (de <hi rend="italic">fügt zu Lond</hi>) alia re inuenta <hi rend="italic">Cb Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">only De r. i. Db; only De inuencionibus Pl S; De an. uel (Lond adds de) alia re inuenta Cb Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">-li <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-li Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">de e.—sit <hi rend="italic">aus Lb Va Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">de e.—sit from Lb Va Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">aliquid <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">aliquid Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">ad <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">uilla <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">uilla Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">dixit <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">dixit Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">intus ducat <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">intus ducat Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">eat ad ec. et cor. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">eat ad ec. et cor. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">uille <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">uille Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_24.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">in uerum <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">in uerum K</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Of (animals, of horses or other) things found (what is to be done). If anyone has led an animal into the vill or carried in goods and says that he found it, before he brings it into his own house or even another's, let him lead it before the church and, in the presence of the priest of the church and the reeve of the vill and the better men, show the whole find, whatever it may be.</ab>
      </div>
    </body>
  </text>
