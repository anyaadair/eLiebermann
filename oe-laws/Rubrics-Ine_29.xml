      <div type="clause" n="29">
        <head>Ine Rb 29</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="29" corresp="#wit-e"><pb n="22" ed="#liebermann"/>LXXIII. Be<ptr type="liebermannNote" n="*" target="#Rubrics-Ine_29.lnote.oe.star"/> ðon þe mon sweordes onlæne oðres ðeowe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="29" corresp="#wit-g-prol"><pb n="22" ed="#liebermann"/>LXXIII. Be þan ðe man sweordes onlæne oðres ðeowe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="29" corresp="#wit-h"><pb n="23" ed="#liebermann"/>LXXIII. Be þon<ptr type="liebermannNote" n="3" target="#Rubrics-Ine_29.lnote.oe.3"/> ðe mon<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_29.lnote.oe.2"/> (his<ptr type="liebermannNote" n="13" target="#Rubrics-Ine_29.lnote.oe.13-2"/>) sweord alæne<ptr type="liebermannNote" n="14" target="#Rubrics-Ine_29.lnote.oe.14-2"/> oðres ðeowan.<ptr type="liebermannNote" n="15" target="#Rubrics-Ine_29.lnote.oe.15-2"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="29" corresp="#wit-q"><pb n="23" ed="#liebermann"/>Si<ptr type="liebermannNote" n="13" target="#Rubrics-Ine_29.lnote.oe.13"/> quis gladium commodet<ptr type="liebermannNote" n="14" target="#Rubrics-Ine_29.lnote.oe.14"/> alterius<ptr type="liebermannNote" n="15" target="#Rubrics-Ine_29.lnote.oe.15"/> seruo.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="206" ed="#jurasinski-and-oliver"/>LXXIII Be ðon þe mon sweordes onlæne oðres ðeowe</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="206" ed="#jurasinski-and-oliver"/>Be ða<hi rend="italic">m</hi> þe his sweord alæne oðres ðeowan</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="23" ed="#liebermann"/>Darüber, dass einer dem Sklaven von jemand anders ein Schwert<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_29.lnote.de.1"/> darleiht.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning someone lending a sword to another person’s slave.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="207" ed="#jurasinski-and-oliver"/>Concerning the loan of a sword to another’s slave</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="207" ed="#jurasinski-and-oliver"/>Concerning he who loans his sword to another’s slave</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_29.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de">Be ðam ðe his wæpnu onl. <hi rend="italic">ohne</hi> oð. ð. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Be ðam ðe his wæpnu onl. without oð. ð. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_29.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">De praestantibus gl. <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">De praestantibus gl. Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_29.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Br</hi>; commendet <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Br; commendet Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_29.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">statt</hi> alt. se. <hi rend="italic">hat</hi> ad homicidium vel lanceam vel equum <hi rend="italic">Hk</hi>; la. v. e. ad h. domini <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">instead of alt. se., Hk has ad homicidium vel lanceam vel equum; la. v. e. ad h. domini Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_29.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> þam</seg><seg type="translation" xml:lang="en" source="#claude">altered þam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_29.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_29.lnote.oe.13-2" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_29.lnote.oe.14-2" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">a <hi rend="italic">auf Rasur</hi>.</seg><seg type="translation" xml:lang="en" source="#claude">a on an erasure.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_29.lnote.oe.15-2" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">n <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">n written above</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_29.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘sein Schwert’ Hcor (Ld), der auch <hi rend="italic">on</hi>- zu <hi rend="italic">a</hi>- modernisiert und gen. zum acc.</seg><seg type="translation" xml:lang="en" source="#claude">‘his sword’ Hcor (Ld), who also modernises <hi rend="italic">on</hi>- to <hi rend="italic">a</hi>- and the gen. to the acc.</seg></note>
      </div>
    </body>
