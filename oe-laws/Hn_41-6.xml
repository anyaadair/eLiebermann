      <div type="clause" n="41.6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 41.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 41.6" corresp="#wit-lat"><pb n="568" ed="#liebermann"/>Si de familia<ptr type="liebermannNote" n="b" target="#Hn_41-6.lnote.oe.b"/> sit qui<ptr type="liebermannNote" n="16" target="#Hn_41-6.lnote.oe.16"/> inplacitatur, ad rectum eum habeat in cuius familia est, quando et ubi iustum erit, si a domino uel rege uel prelato<ptr type="liebermannNote" n="c" target="#Hn_41-6.lnote.oe.c"/> secundum legem sit monitus, siue per breue siue per nuntium.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 568 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-6.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">anders</hi> 66, 7</seg><seg type="translation" xml:lang="en" source="#claude">differently 66, 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-6.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">vorgesetzten Beamten, <hi rend="italic">zunächst</hi> Sheriff</seg><seg type="translation" xml:lang="en" source="#claude">superior official, in the first instance the sheriff</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-6.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">que <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">que Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-6.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Gefolge 19; Haftung 7d; Vorladung 11b; Anklagezustand 1—41, 7 <hi rend="italic">s</hi>.{17} <hi rend="italic">h. t</hi>.—<hi rend="italic">sit lex</hi>{20}—41, 11 <hi rend="italic">di</hi>.{23} <hi rend="italic">do. cum donec</hi>—41, 12 <hi rend="italic">nil</hi>{24}—{26}<hi rend="italic">p. fuerat</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Gefolge 19; Haftung 7d; Vorladung 11b; Anklagezustand 1—41, 7 <hi rend="italic">s</hi>.{17} <hi rend="italic">h. t</hi>.—<hi rend="italic">sit lex</hi>{20}—41, 11 <hi rend="italic">di</hi>.{23} <hi rend="italic">do. cum donec</hi>—41, 12 <hi rend="italic">nil</hi>{24}—{26}<hi rend="italic">p. fuerat</hi> Rs</seg></note>
