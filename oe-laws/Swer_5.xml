    <body>
      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:Swer">Swer</ref> 5</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5" corresp="#wit-h"><ptr type="liebermannNote" n="1" target="#Swer_5.lnote.oe.1"/><pb n="398" ed="#liebermann"/>On ðone Drihten, ic eom unscyldig ægðer ge dæde ge dihtes æt þære tihtlan, ðe N. me tihð.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5" corresp="#wit-b"><ptr type="liebermannNote" n="1" target="#Swer_5.lnote.oe.1-2"/><pb n="398" ed="#liebermann"/>Ðæs oðres að, þ<hi rend="italic">æt</hi> he is unscyldi. On ðone Drihten, ic eom unscyldig ægðer ge dæde ge dihtes æt ðere tihtlan, ðe Ñ me tyhð.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5" corresp="#wit-q"><pb n="399" ed="#liebermann"/>In omnipotenti Deo, innocens sum actionis et dictionis ab ea compellatione, qua N. me compellat.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="399" ed="#liebermann"/>(Eid des Gegners<ptr type="liebermannNote" n="1" target="#Swer_5.lnote.de.1"/> [Beklagten]: dass er unschuldig ist. <hi rend="italic">B</hi>) Bei dem Herrn . . ., ich bin unschuldig, sowohl in That<ptr type="liebermannNote" n="2" target="#Swer_5.lnote.de.2"/> wie<ptr type="liebermannNote" n="†" target="#Swer_5.lnote.de1.dagger"/> im Planen<ptr type="liebermannNote" n="3" target="#Swer_5.lnote.de.3"/>, der Anschuldigung deren N. mich zeiht.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">(The oath of the opponent [the defendant]: that he is innocent. B) By the Lord …, I am innocent, both in deed and in planning, of the accusation of which N. accuses me.</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-h">[I swear] by the Lord [that] I am not guilty of the accusation that N. laid against me, either in deed or purpose.</ab>
        <note type="editorial">U: translator unrecorded: check; B's heading is in red. ‘That … Planen’ (dæde … dihtes) is an alliterating pair.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Swer_5.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">398</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Platz für Überschrift frei</hi></seg><seg type="translation" xml:lang="en" source="#claude">Space left free for a heading</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Swer_5.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">398</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Überschrift roth</hi></seg><seg type="translation" xml:lang="en" source="#claude">Heading in red</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Swer_5.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">235</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Diese Reinigung bezieht sich nicht auf Anefang allein</seg><seg type="translation" xml:lang="en" source="#claude">This exculpation does not relate to Anefang alone</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Swer_5.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">235</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl</hi>. Hoffmann <hi rend="italic">Reimformeln im Westgerm</hi>. 25</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf.</hi> Hoffmann <hi rend="italic">Reimformeln im Westgerm</hi>. 25</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="Swer_5.lnote.de1.dagger" n="†" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">399</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Alliterationspaar</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Alliterative pair</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Swer_5.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">235</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Gleichklangs wegen übersetzt Q auch sonst durch <hi rend="italic">dictio</hi>; <hi rend="italic">s. Wb</hi></seg><seg type="translation" xml:lang="en" source="#claude">For the sake of the similar sound Q translates by <hi rend="italic">dictio</hi> elsewhere too; <hi rend="italic">see Wb</hi></seg></note>
      </div>
    </body>
