        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 83.4a" corresp="#wit-lat"><pb n="600" ed="#liebermann"/>Weilref<ptr type="liebermannNote" n="1" target="#Hn_83-4a.lnote.oe.1"/> dicimus<ptr type="liebermannNote" n="2" target="#Hn_83-4a.lnote.oe.2"/>, si quis mortuum refabit<ptr type="liebermannNote" n="3" target="#Hn_83-4a.lnote.oe.3"/> armis aut<ptr type="liebermannNote" n="4" target="#Hn_83-4a.lnote.oe.4"/> uestibus aut prorsus aliquibus<ptr type="liebermannNote" n="a" target="#Hn_83-4a.lnote.oe.a"/>, aut<ptr type="liebermannNote" n="5" target="#Hn_83-4a.lnote.oe.5"/> tumulatum aut tumulandum<ptr type="liebermannNote" n="b" target="#Hn_83-4a.lnote.oe.b"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 600 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-4a.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">pecunia; 83, 6</seg><seg type="translation" xml:lang="en" source="#claude">pecunia; 83, 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-4a.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ob die Leiche bestattet oder nicht, unterscheiden andere Germanen; Brunner</hi> DRG. II 683</seg><seg type="translation" xml:lang="en" source="#claude">other Germanic peoples distinguish whether the corpse was buried or not; Brunner DRG. II 683</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-4a.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">-reif <hi rend="italic">Co Or</hi>; weylref <hi rend="italic">Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">-reif Co Or; weylref Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-4a.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">dn̄is <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">dn̄is Sc Hg</seg></note>
