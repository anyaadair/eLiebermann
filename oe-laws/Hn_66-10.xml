    <body>
      <div type="clause" n="66.10">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 66.10</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 66.10" corresp="#wit-lat"><pb n="586" ed="#liebermann"/>In Myrcenis<ptr type="liebermannNote" n="15" target="#Hn_66-10.lnote.oe.15"/> habendi sunt<ptr type="liebermannNote" n="16" target="#Hn_66-10.lnote.oe.16"/> in triplici lada XXXV<ptr type="liebermannNote" n="k" target="#Hn_66-10.lnote.oe.k"/> consacramentales<ptr type="liebermannNote" n="17" target="#Hn_66-10.lnote.oe.17"/>, in Denelaga XLVIII electi, et sorte pocius quam eleccione<ptr type="liebermannNote" n="l" target="#Hn_66-10.lnote.oe.l"/> iuraturi.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 586 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-10.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">36 <hi rend="italic">auch</hi> Wal; III Atr. 13; Magna lex <hi rend="italic">Londons</hi> (<hi rend="italic">Riley</hi> Mun. gildh. I 91 <hi rend="italic">f.</hi> 110; <hi rend="italic">Form von</hi> 1130—50 <hi rend="italic">bei Bateson</hi> Engl. hist. rev. 1902, 707); <hi rend="italic">in Lincoln</hi> 1200 (<hi rend="italic">Maitland</hi> Sel. pleas. of the crown I <hi rend="italic">p.</hi> 39)</seg><seg type="translation" xml:lang="en" source="#claude">36 also Wal; III Atr. 13; the Magna lex of London (Riley Mun. gildh. I 91 <hi rend="italic">f.</hi> 110; form of 1130–50 in Bateson Engl. hist. rev. 1902, 707); in Lincoln in 1200 (Maitland Sel. pleas. of the crown I p. 39)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-10.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">Loos, nicht des Verklagten Wahl (<hi rend="italic">bestimmt aus dem grösseren Helferkreis</hi>) die wirklichen Mitschwörer (‘<hi rend="italic">auch in Cnuts Witherlagsrecht; also wohl Nordisch</hi>’, <hi rend="italic">Steenstrup</hi> Danelag 235)</seg><seg type="translation" xml:lang="en" source="#claude">The lot, not the choice of the accused, determines (from the larger circle of helpers) the actual co-swearers (‘also in Cnut’s Witherlag law; hence probably Norse’, Steenstrup Danelag 235)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-10.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">Mir. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Mir. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-10.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">etiam <hi rend="italic">fügt zu Wh Wi; nicht aus Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">Wh Wi add etiam; not from Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-10.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">sacr. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">sacr. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-10.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de">In Anm. <hi rend="italic">l</hi> lies vielleicht <hi rend="italic">Gegners oder Richters</hi> statt <hi rend="italic">Verklagten; s. Gl</hi> Eideshelfer 21. 47</seg><seg type="translation" xml:lang="en" source="#claude">In note <hi rend="italic">l</hi> perhaps read <hi rend="italic">opponent or judge</hi> instead of <hi rend="italic">accused</hi>; <hi rend="italic">see Gl</hi> Eideshelfer 21. 47</seg></note>
      </div>
