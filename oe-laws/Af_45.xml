      <div type="clause" n="45">
        <head><ref type="lawCode" target="law:Af">Af</ref> 45</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="45" corresp="#wit-e"><pb n="78" ed="#liebermann"/>XLI. Gif in feaxe bið wund inces<ptr type="liebermannNote" n="27" target="#Af_45.lnote.oe.27"/> lang, geselle<ptr type="liebermannNote" n="23" target="#Af_45.lnote.oe.23"/> anne<ptr type="liebermannNote" n="28" target="#Af_45.lnote.oe.28"/> scill.<ptr type="liebermannNote" n="29" target="#Af_45.lnote.oe.29"/> to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="45" corresp="#wit-h"><pb n="78" ed="#liebermann"/>XLI. Gif in feaxe wund bið ynces<ptr type="liebermannNote" n="2" target="#Af_45.lnote.oe.2"/> long<ptr type="liebermannNote" n="4" target="#Af_45.lnote.oe.4"/>, gesylle<ptr type="liebermannNote" n="14" target="#Af_45.lnote.oe.14"/> anne scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="45" corresp="#wit-b-no-prol"><pb n="78" ed="#liebermann"/>Gyf in feaxe bið wund ynces lang, gesylle anne<ptr type="liebermannNote" n="3" target="#Af_45.lnote.oe.3"/> scill' to bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="45" corresp="#wit-q"><pb n="79" ed="#liebermann"/>Si in fexh<ptr type="liebermannNote" n="18" target="#Af_45.lnote.oe.18"/> (capillis) sit uulnus longitudinis<ptr type="liebermannNote" n="19" target="#Af_45.lnote.oe.19"/> unius uncie, componatur<ptr type="liebermannNote" n="20" target="#Af_45.lnote.oe.20"/> solido uno.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="86" ed="#attenborough"/>Gif in feaxe bið wund inces lang, geselle anne scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="48" corresp="#wit-e"><pb n="350" ed="#jurasinski-and-oliver"/>{XLI} Gif in feaxe bið wund inces lang, geselle anne scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="79" ed="#liebermann"/>Wenn unterm Haupthaar<ptr type="liebermannNote" n="1" target="#Af_45.lnote.de.1"/> eine Zoll<ptr type="liebermannNote" n="2" target="#Af_45.lnote.de.2"/> lange Wunde ist, gebe man einen Schilling<ptr type="liebermannNote" n="3" target="#Af_45.lnote.de.3"/> zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If under the head-hair there is a wound an inch long, let one shilling be given as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="87" ed="#attenborough"/>If a wound an inch long is inflicted under the hair, one shilling shall be given as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="351" ed="#jurasinski-and-oliver"/>If a wound is an inch long above the hairline, let him pay one shilling as compensation.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_10-1">Leis Wl 10.1</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_45.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">78</biblScope></bibl><seg type="original" xml:lang="de">ynces <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ynces Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_45.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">78</biblScope></bibl><seg type="original" xml:lang="de">gesylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gesylle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_45.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">78</biblScope></bibl><seg type="original" xml:lang="de">ænne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ænne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_45.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">78</biblScope></bibl><seg type="original" xml:lang="de">scyll. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">scyll. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_45.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">78</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_45.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">78</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_45.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">78</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_45.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">79</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur Co übergeschr.; fehlt übrigen</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above only in Co; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_45.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">79</biblScope></bibl><seg type="original" xml:lang="de">-dine <hi rend="italic">Lond Hn</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dine Lond Hn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_45.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">79</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">XII den.</hi> in I sol. comp. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">XII den.</hi> in I sol. comp. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_45.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">78</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. geänd. in</hi> ænne</seg><seg type="translation" xml:lang="en" source="#claude">altered in the 16th cent. to ænne</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_45.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘Haarwuchs’ Schmid. Das Wort steht bisweilen in Ggs. zu Bart; Mätzner <hi rend="italic">Wb</hi> s. v. <hi rend="italic">fax.</hi> <hi rend="italic">Vgl. Gl</hi> Haar; Gliederbussen 8B. 9. 11</seg><seg type="translation" xml:lang="en" source="#claude">‘Growth of hair’ Schmid. The word is sometimes contrasted with beard; Mätzner <hi rend="italic">Wb</hi> s. v. <hi rend="italic">fax.</hi> <hi rend="italic">Cf. Gl</hi> Haar; Gliederbussen 8B. 9. 11</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_45.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Zollmass; Rein <hi rend="italic">Massbezeichnung d. Engl.</hi> 93</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Zollmass; Rein <hi rend="italic">Massbezeichnung d. Engl.</hi> 93</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_45.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Richtig <hi rend="italic">V den.</hi> Hn 93, 3; dagegen falsch ‘12’ Q Lond. Inst Var.</seg><seg type="translation" xml:lang="en" source="#claude">Correctly <hi rend="italic">V den.</hi> Hn 93, 3; on the other hand wrongly ‘12’ Q Lond. Inst Var.</seg></note>
      </div>
