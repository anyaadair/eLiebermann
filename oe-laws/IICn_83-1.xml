      <div type="clause" n="83.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 83.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="83.1" corresp="#wit-g-a"><pb n="366" ed="#liebermann"/>⁊ gif he hit<ptr type="liebermannNote" n="21" target="#IICn_83-1.lnote.oe.21"/> eft wyrde, gylde tuwa<ptr type="liebermannNote" n="22" target="#IICn_83-1.lnote.oe.22"/> his were.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="83.1" corresp="#wit-b"><pb n="366" ed="#liebermann"/>And gyf he hit eft wyrde, gylde twywa<ptr type="liebermannNote" n="8" target="#IICn_83-1.lnote.oe.8"/> his were.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="83.1" corresp="#wit-a"><pb n="366" ed="#liebermann"/>⁊ gif he hit eft wyrde, gylde twuga his were.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="83.1" corresp="#wit-q"><pb n="367" ed="#liebermann"/>Et si secundo id<ptr type="liebermannNote" n="13" target="#IICn_83-1.lnote.oe.13"/> faciat, reddat bis wéram suam.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="83.1" corresp="#wit-inst-cn"><pb n="367" ed="#liebermann"/>Si secundo hoc idem fecerit, dupliciter<ptr type="liebermannNote" n="12" target="#IICn_83-1.lnote.oe.12"/> secundum superiorem rationem emendet.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="83.1" corresp="#wit-cons-cn"><pb n="367" ed="#liebermann"/>[83, 1] Quodsi secundo, bis persoluat censum sue redempcionis.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="83.1" corresp="#wit-b"><pb n="216" ed="#robertson"/>And gyf he hit eft wyrde, gylde twywa his were.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="296" ed="#rabin-doml"/>And gif he hit eft wyrde, gylde tuwa his were.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="366" ed="#liebermann"/>Und wenn er das [Gesetz] wiederum verletzt, zahle er sein Wergeld doppelt.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if he violates the [law] again, let him pay his wergild twice.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="217" ed="#robertson"/>And if he violates it again, he shall pay his wergeld twice over.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="474" ed="#whitelock"/>And if he violates it again, he is to pay his wergild twice.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="297" ed="#rabin-doml"/>And if he violates it again, he shall pay twice his wergild.</ab>
        <note type="editorial">BR: added from Gesetze I p. 367, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_83-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">366</biblScope></bibl><seg type="original" xml:lang="de">twa, <hi rend="italic">darüber</hi> yw</seg><seg type="translation" xml:lang="en" source="#claude">twa, above it yw</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_83-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">367</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus KL Angl.</hi>; <hi rend="italic">fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">from KL Angl.; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_83-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">366</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. G</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above G</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_83-1.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">366</biblScope></bibl><seg type="original" xml:lang="de">twa <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">twa Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_83-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">367</biblScope></bibl><seg type="original" xml:lang="de">dupp. <hi rend="italic">Di</hi></seg><seg type="translation" xml:lang="en" source="#claude">dupp. Di</seg></note>
      </div>
