      <div type="clause" n="11a">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 11a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 11a"><pb n="634" ed="#liebermann"/>Patriam<ptr type="liebermannNote" n="25" target="#ECf_11a.lnote.la.25"/> enim infestantes<ptr type="liebermannNote" n="26" target="#ECf_11a.lnote.la.26"/> uastationi eius pro posse suo<ptr type="liebermannNote" n="27" target="#ECf_11a.lnote.la.27"/> insistebant; sed ad eorum insolentiam reprimendam<ptr type="liebermannNote" n="12" target="#ECf_11a.lnote.la.12"/> statutum est Denegeldum annuatim<ptr type="liebermannNote" n="a" target="#ECf_11a.lnote.oe.erkl-a"/> reddi<ptr type="liebermannNote" n="28" target="#ECf_11a.lnote.la.28"/>, id<ptr type="liebermannNote" n="29" target="#ECf_11a.lnote.la.29"/> est duodecim<ptr type="liebermannNote" n="30" target="#ECf_11a.lnote.la.30"/> denarios de unaquaque<ptr type="liebermannNote" n="31" target="#ECf_11a.lnote.la.31"/> hida<ptr type="liebermannNote" n="32" target="#ECf_11a.lnote.la.32"/> totius patrie, ad conducendos eos qui piratarum irruptioni resistendo obuiarent<ptr type="liebermannNote" n="33" target="#ECf_11a.lnote.la.33"/>.</ab>
        <note type="comparison" source="#liebermann" n="634"><label>printed alongside</label> <ref target="clause:ECfRetr_11a">ECf retr 11a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 634 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11a.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">Patrie uero uast. pro <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Patrie uero uast. pro Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11a.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">uastatione inf. <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">uastatione inf. Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11a.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt S</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11a.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11a.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">reddendum <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">reddendum S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11a.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">scilicet <hi rend="italic">statt</hi> id e. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">scilicet instead of id e. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11a.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">de u. h. to. terre XII den. ad conducendum <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">de u. h. to. terre XII den. ad conducendum Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11a.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">unaque <hi rend="italic">Rl Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">unaque Rl Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11a.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">hyda <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">hyda Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11a.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Do</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">For, harrying the country, they pressed on with laying it waste as far as they could; but to repress their insolence it was established that Danegeld be paid annually, that is, twelve pence from each hide of the whole country, to hire those who would oppose the pirates' incursion by resisting it.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11a.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">345</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Gl ebd.</hi> 6 (Hufe 16c). — <hi rend="italic">ad</hi><hi rend="superscript">29</hi> <hi rend="italic">e. quod in.</hi> — <hi rend="italic">ex</hi><hi rend="superscript">42</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">Gl ibid. 6 (Hufe 16c). — <hi rend="italic">ad</hi><hi rend="superscript">29</hi> <hi rend="italic">e. quod in.</hi> — <hi rend="italic">ex</hi><hi rend="superscript">42</hi> Rs</seg></note>
      </div>
    </body>
  </text>
