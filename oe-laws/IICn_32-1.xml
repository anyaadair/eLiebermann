    <body>
      <div type="clause" n="32.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 32.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="32.1" corresp="#wit-g-a"><pb n="336" ed="#liebermann"/>⁊ æt þam oðran<ptr type="liebermannNote" n="8" target="#IICn_32-1.lnote.oe.8"/> cyrre ne si<ptr type="liebermannNote" n="9" target="#IICn_32-1.lnote.oe.9-2"/> þær nan oðer<ptr type="liebermannNote" n="6" target="#IICn_32-1.lnote.oe.6-3"/> bót butan<ptr type="liebermannNote" n="10" target="#IICn_32-1.lnote.oe.10-2"/> þ<hi rend="italic">æt</hi> heafod.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="32.1" corresp="#wit-b"><pb n="336" ed="#liebermann"/>⁊ æt ðam oðran cyrran<ptr type="liebermannNote" n="6" target="#IICn_32-1.lnote.oe.6-2"/> ne sy ðær nan bot buton þ<hi rend="italic">æt</hi> heafod.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="32.1" corresp="#wit-a"><pb n="336" ed="#liebermann"/>An[d<ptr type="liebermannNote" n="4" target="#IICn_32-1.lnote.oe.4"/>] æt þa<hi rend="italic">m</hi> oðru<hi rend="italic">m</hi> cerre ne sy þær nan bot buton þ<hi rend="italic">æt</hi> heafod.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="32.1" corresp="#wit-q"><pb n="337" ed="#liebermann"/>Secunda<ptr type="liebermannNote" n="9" target="#IICn_32-1.lnote.oe.9"/> uice nulla sit<ptr type="liebermannNote" n="10" target="#IICn_32-1.lnote.oe.10"/> emendatio nisi caput.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="32.1" corresp="#wit-inst-cn"><pb n="337" ed="#liebermann"/>Si secundo ceciderit, nichil<ptr type="liebermannNote" n="5" target="#IICn_32-1.lnote.oe.5"/> aliud emendationis accipiatur, nisi ut ei<ptr type="liebermannNote" n="6" target="#IICn_32-1.lnote.oe.6-4"/> caput abscidatur.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="32.1" corresp="#wit-cons-cn"><pb n="337" ed="#liebermann"/>Secunda autem uice nulla redempcio sit nisi caput.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="32.1" corresp="#wit-b"><pb n="192" ed="#robertson"/>⁊ æt ðam oðran cyrran ne sy ðær nan bot<ptr type="editorNote" n="11" target="#IICn_32-1.robnote.fn.11"/> buton þæt heafod.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="272" ed="#rabin-doml"/>And æt þam oðran cyrre ne si þær nan oðer bot butan þæt heafod.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="336" ed="#liebermann"/>Und beim zweiten Male<ptr type="liebermannNote" n="1" target="#IICn_32-1.lnote.de.1"/> gebe es da keine andere Busse als den Kopf.<ptr type="liebermannNote" n="2" target="#IICn_32-1.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And the second time let there be no other compensation there than the head.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="193" ed="#robertson"/>And on the second occasion he shall not be able to make any amends except by his head.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="467" ed="#whitelock"/>And on the second occasion, there is to be no compensation except his head.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="273" ed="#rabin-doml"/>And on the next occasion he shall not be able to make compensation except with his head.</ab>
        <note type="comparison" source="#liebermann" n="336"><ref target="clause:IAtr_2-1">I Atr 2.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 2, 1</note>
        <note type="editorial">Liebermann compares I Atr 2.1.; BR: added from Gesetze I p. 337, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">oðer: omitted B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_32-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_32-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_32-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">sit r. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit r. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_32-1.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_32-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">s. u. <hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. u. omitted Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_32-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">e. sit <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. sit K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_32-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de">-rum <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rum Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_32-1.lnote.oe.9-2" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_32-1.lnote.oe.6-3" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_32-1.lnote.oe.10-2" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de">buton <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">buton Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_32-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de">An <hi rend="italic">A</hi></seg><seg type="translation" xml:lang="en" source="#claude">An A</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_32-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">nil <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">nil Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_32-1.lnote.oe.6-4" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">c. ei <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. ei Cb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_32-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">207</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Zu <hi rend="italic">cyrran</hi> in B <hi rend="italic">vgl</hi>. I Atr 2²</seg><seg type="translation" xml:lang="en" source="#claude">On <hi rend="italic">cyrran</hi> in B <hi rend="italic">cf.</hi> I Atr 2²</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_32-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">207</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">I Atr 3 übergeht Cn, vermutlich weil er Kautel für den Handel (<hi rend="italic">s. d</hi>. 8) schon <hi rend="italic">o</hi>. 24 gefordert hat</seg><seg type="translation" xml:lang="en" source="#claude">Cn passes over I Atr 3, presumably because he has already required a safeguard for trade (<hi rend="italic">see</hi> that word 8) <hi rend="italic">above</hi> 24</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_32-1.robnote.fn.11" n="11" source="#robertson"><bibl><biblScope unit="page">192</biblScope></bibl><label>bot</label><seg type="original" xml:lang="en"><hi rend="italic">n. oðer b.</hi> G.</seg></note>
      </div>
