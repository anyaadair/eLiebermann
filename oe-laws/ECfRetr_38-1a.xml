      <div type="clause" n="38.1a">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 38.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 38.1a"><pb n="668" ed="#liebermann"/>Si uenditor <hi rend="bold">careret</hi> plegiis<ptr type="liebermannNote" n="28" target="#ECfRetr_38-1a.lnote.la.28"/>, <hi rend="spaced">retineretur</hi> cum <hi rend="bold">censu</hi><ptr type="liebermannNote" n="h" target="#ECfRetr_38-1a.lnote.la.fn.h"/>, donec <hi rend="spaced">uenisset</hi> dominus eius <hi rend="bold">uel</hi> alius<ptr type="liebermannNote" n="29" target="#ECfRetr_38-1a.lnote.la.29"/> qui posset<ptr type="liebermannNote" n="30" target="#ECfRetr_38-1a.lnote.la.30"/> <hi rend="bold">bene</hi><ptr type="liebermannNote" n="31" target="#ECfRetr_38-1a.lnote.la.31"/> eum warantizare.</ab>
        <note type="comparison" source="#liebermann" n="668"><label>printed alongside</label> <ref target="clause:ECf_38-1a">ECf 38.1a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 668 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-1a.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">Fahrhabe, <hi rend="italic">zunächst</hi> Vieh, <hi rend="italic">was Retr. in</hi> censu (Geld) <hi rend="italic">zu eng fasst</hi></seg><seg type="translation" xml:lang="en" source="#claude">movable goods, in the first place cattle, which the Retr. takes too narrowly as censu (money)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-1a.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">-gio <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gio Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-1a.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">alter <hi rend="italic">Cb Lb Va Ph Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">alter Cb Lb Va Ph Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-1a.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">b. p. <hi rend="italic">Cb Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">b. p. Cb Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-1a.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">eum b. <hi rend="italic">Hv;</hi> e. w. b. <hi rend="italic">Lb Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">eum b. Hv; e. w. b. Lb Ph</seg></note>
      </div>
