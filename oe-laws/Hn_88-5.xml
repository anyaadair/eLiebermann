      <div type="clause" n="88.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 88.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 88.5" corresp="#wit-lat"><pb n="603" ed="#liebermann"/>Si quis<ptr type="liebermannNote" n="a" target="#Hn_88-5.lnote.oe.a"/> alium fugiens — ut ira decertantium uel causa persequentium sepius impetrauit — precipicio<ptr type="liebermannNote" n="1" target="#Hn_88-5.lnote.oe.1"/> uel casu<ptr type="liebermannNote" n="2" target="#Hn_88-5.lnote.oe.2"/> persequentium<ptr type="liebermannNote" n="3" target="#Hn_88-5.lnote.oe.3"/> aliquo moriatur, reddat eum qui iniuste perfugabat<ptr type="liebermannNote" n="4" target="#Hn_88-5.lnote.oe.4"/>; nec<ptr type="liebermannNote" n="a" target="#Hn_88-5.lnote.oe.a"/> sibi mortem intulisse nec egilde<ptr type="liebermannNote" n="b" target="#Hn_88-5.lnote.oe.b"/> meruisse<ptr type="liebermannNote" n="5" target="#Hn_88-5.lnote.oe.5"/> uideatur<ptr type="liebermannNote" n="6" target="#Hn_88-5.lnote.oe.6"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 603 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-5.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verfolgter</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">the pursued man</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-5.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">= inultus 11, 11; <hi rend="italic">vielleicht aus dessen Original: II Cn.</hi> 48, 3. <hi rend="italic">Vgl.</hi> 87, 6<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">= inultus 11, 11; <hi rend="italic">perhaps from its original: II Cn.</hi> 48, 3. <hi rend="italic">Cf.</hi> 87, 6<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-5.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">-pio <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-pio Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-5.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">c. per. <hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. per. lacking in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-5.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">pros. <hi rend="italic">ändert Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">pros. Wi alters</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-5.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">progabat <hi rend="italic">Sc;</hi> purg. <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">progabat Sc; purg. Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-5.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">iacuisse <hi rend="italic">ändert Wi Tho; vgl. jedoch</hi> 70, 12<hi rend="italic">c</hi></seg><seg type="translation" xml:lang="en" source="#claude">Wi Tho alter iacuisse; but cf. 70, 12<hi rend="italic">c</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-5.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">-ebatur <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ebatur Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-5.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Wergeld 17a—Am Rande spät: <hi rend="italic">De mort[em] passo propria temeritate</hi>—<hi rend="italic">uidebatur</hi>{6} <hi rend="italic">Rs</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Wergeld 17a—In the margin, in a late hand: <hi rend="italic">De mort[em] passo propria temeritate</hi>—<hi rend="italic">uidebatur</hi>{6} Rs</seg></note>
      </div>
