      <div type="clause" n="4.1">
        <head><ref type="lawCode" target="law:QuadrII">Quadr II</ref> 4.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr II 4.1" corresp="#wit-lat"><pb n="544" ed="#liebermann"/>Ubi dum sancte Sion<ptr type="liebermannNote" n="14" target="#QuadrII_4-1.lnote.oe.14"/> recordatur, in salicibus Babilonis nostræ suspendit ad tempus organa sua, donec preponatur Ierusalem in principio letitiæ<ptr type="liebermannNote" n="15" target="#QuadrII_4-1.lnote.oe.15"/> nostræ; et beatus sit qui se continebit et allidet prauitates suas ad petram Christum; aspiret autem dies et inclinentur<ptr type="liebermannNote" n="16" target="#QuadrII_4-1.lnote.oe.16"/> umbre, quæ sanctæ mentis desiderium tenebrosa noctis inuolutione<ptr type="liebermannNote" n="17" target="#QuadrII_4-1.lnote.oe.17"/> prepediunt!</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 544 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_4-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">544</biblScope></bibl><seg type="original" xml:lang="de">Syon <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">Syon <hi rend="italic">T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_4-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">544</biblScope></bibl><seg type="original" xml:lang="de">leticie <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">leticie <hi rend="italic">Hk</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_4-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">544</biblScope></bibl><seg type="original" xml:lang="de">clin. <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">clin. <hi rend="italic">MHk</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_4-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">544</biblScope></bibl><seg type="original" xml:lang="de">inuoluci. prepediuit <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">inuoluci. prepediuit <hi rend="italic">Hk</hi></seg></note>
