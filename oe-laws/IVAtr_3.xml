    <body>
      <div type="clause" n="3">
        <head><ref type="lawCode" target="law:IVAtr">IV Atr</ref> 3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3" corresp="#wit-q"><ptr type="liebermannNote" n="20" target="#IVAtr_3.lnote.oe.20"/><pb n="234" ed="#liebermann"/>Si portireua uel tungrauio compellet<ptr type="liebermannNote" n="21" target="#IVAtr_3.lnote.oe.21"/> aliquem uel alius prepositus, quod teloneum<ptr type="liebermannNote" n="22" target="#IVAtr_3.lnote.oe.22"/> supertenuerit<ptr type="liebermannNote" n="23" target="#IVAtr_3.lnote.oe.23"/>, et homo respondeat, quod nullum tolneum<ptr type="liebermannNote" n="24" target="#IVAtr_3.lnote.oe.24"/> concelauerit, quod iuste dare<ptr type="liebermannNote" n="25" target="#IVAtr_3.lnote.oe.25"/> debuisset<ptr type="liebermannNote" n="26" target="#IVAtr_3.lnote.oe.26"/>, iuret hoc se VIIᵒ<ptr type="liebermannNote" n="27" target="#IVAtr_3.lnote.oe.27"/> et sit quietus.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="3" corresp="#wit-q"><pb n="72" ed="#robertson"/>Si portireva vel tungravio compellet<ptr type="editorNote" n="17" target="#IVAtr_3.robnote.fn.17"/> aliquem vel alius praepositus quod teloneum supertenuerit, et homo respondeat quod nullum tolneum<ptr type="editorNote" n="18" target="#IVAtr_3.robnote.fn.18"/> concelaverit quod iuste dare<ptr type="editorNote" n="2" target="#IVAtr_3.robnote.fn.2"/> debuisset<ptr type="editorNote" n="19" target="#IVAtr_3.robnote.fn.19"/>, iuret hoc se VII°<ptr type="editorNote" n="20" target="#IVAtr_3.robnote.fn.20"/> et sit quietus.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="235" ed="#liebermann"/>Wenn der Stadtvogt<ptr type="liebermannNote" n="1" target="#IVAtr_3.lnote.de.1"/> oder der Ortsvogt oder ein anderer Vogt jemanden verklagt<ptr type="liebermannNote" n="2" target="#IVAtr_3.lnote.de.2"/>, dass er den Zoll vorenthalten<ptr type="liebermannNote" n="3" target="#IVAtr_3.lnote.de.3"/> habe, und dieser Mann antwortet, er habe keinen Zoll, den er von Rechtswegen zu zahlen schuldig gewesen, hinterzogen, so beschwöre dies letzterer selbsiebent<ptr type="liebermannNote" n="4" target="#IVAtr_3.lnote.de.4"/> und sei [dadurch] entlastet.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the town-reeve or the village-reeve or another reeve accuses anyone of having withheld toll, and the man answers that he has concealed no toll which he was rightly bound to pay, let the latter swear this as one of seven, and be [thereby] cleared.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q"><pb n="73" ed="#robertson"/>If the town-reeve or the village reeve<ptr type="editorNote" n="1" target="#IVAtr_3.robnote.n.1"/> or any other official<ptr type="editorNote" n="2" target="#IVAtr_3.robnote.n.2"/> accuses<ptr type="editorNote" n="3" target="#IVAtr_3.robnote.n.3"/> anyone of having withheld<ptr type="editorNote" n="4" target="#IVAtr_3.robnote.n.4"/> toll, and the man replies that he has kept back no toll which it was his legal duty to pay, he shall swear to this with 6 others and shall be quit of the charge.</ab>
        <note type="editorial">This chapter is also in Co (Cotton Domitian A VIII), after II Cn, in the margin.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_3.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">234</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dieses Capitel auch in Co, hinter II Cnut am Rande</hi></seg><seg type="translation" xml:lang="en" source="#claude">this chapter also in Co, after II Cnut, in the margin</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_3.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">234</biblScope></bibl><seg type="original" xml:lang="de">-lat <hi rend="italic">Co;</hi> u. alius p. compellat aliquem <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lat Co; u. alius p. compellat aliquem Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_3.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">234</biblScope></bibl><seg type="original" xml:lang="de">toloneum <hi rend="italic">M;</hi> theol. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">toloneum M; theol. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_3.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">234</biblScope></bibl><seg type="original" xml:lang="de">-rint <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rint T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_3.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">234</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so R;</hi> teloneum <hi rend="italic">TMHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">so R; teloneum TMHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_3.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">234</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_3.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">234</biblScope></bibl><seg type="original" xml:lang="de">debuit <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">debuit Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_3.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">234</biblScope></bibl><seg type="original" xml:lang="de">VIᵒ <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">VIᵒ MHkBr</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">165</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Die folgenden Sätze 3—4, 2 beziehen sich nicht mehr auf London allein (obwohl 4, 2 noch einmal ein lokalrechtlicher Satz folgt). Denn <hi rend="italic">tungravio</hi> (<hi rend="italic">s. d. Wb</hi>), welches Wort Q für <hi rend="italic">tun</hi>(<hi rend="italic">es</hi>)<hi rend="italic">gerefa</hi> setzt, oder sonstiger königlicher Vogt (<hi rend="italic">s. d. Gl</hi> 5. 12) kann nicht in London neben dem Stadtvogt vorkommen; es bedeutet ‘Dorfvogt’. (Dass letzterer als Unterbeamter jenen vertrete, rät Kemble <hi rend="italic">Saxons</hi> II 176 beweislos nur hieraus.) Das bisherige Tempus der Vergangenheit ist fallen gelassen; fortan oder wenigstens von 4 ab sind Staatsgesetze benutzt</seg><seg type="translation" xml:lang="en" source="#claude">The following clauses 3—4, 2 no longer relate to London alone (although in 4, 2 a clause of local law follows once more). For <hi rend="italic">tungravio</hi> (<hi rend="italic">see</hi> that word in <hi rend="italic">Wb</hi>), the word Q uses for <hi rend="italic">tun</hi>(<hi rend="italic">es</hi>)<hi rend="italic">gerefa</hi>, or any other royal reeve (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 5. 12) cannot occur in London alongside the town-reeve; it means ‘village reeve’. (That the latter, as a subordinate official, acted for the former is Kemble's conjecture, <hi rend="italic">Saxons</hi> II 176, made without proof and from this passage alone.) The past tense used hitherto has been dropped; from here on, or at least from 4 on, laws of the realm have been used</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_3.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">165</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Im Orig. stand <hi rend="italic">teon; vgl. Wb: compellare, -atio</hi></seg><seg type="translation" xml:lang="en" source="#claude">The orig. read <hi rend="italic">teon; cf. Wb: compellare, -atio</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_3.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">165</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Im Orig. stand vielleicht <hi rend="italic">oferhealdan; s. Wb: supertenere</hi></seg><seg type="translation" xml:lang="en" source="#claude">The orig. perhaps read <hi rend="italic">oferhealdan; see Wb: supertenere</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_3.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">165</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl</hi>. Lib Lond 2, 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf</hi>. Lib Lond 2, 1</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_3.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e. tun</hi>(<hi rend="italic">es</hi>) <hi rend="italic">gerefa</hi>, cf. VII Atr. 2, 5.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_3.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">praepositus</hi> is the usual word for ‘reeve’ in Latin documents of the period.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_3.robnote.n.3" n="3" source="#robertson"><bibl><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">Compellare</hi> translates A.S. <hi rend="italic">teon</hi>, cf. Af. 17; 33.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_3.robnote.n.4" n="4" source="#robertson"><bibl><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="en">Cf. <hi rend="italic">forhealdan</hi>, E. and G. 6, 1.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_3.robnote.fn.2" n="2" source="#robertson"><bibl><biblScope unit="page">72</biblScope></bibl><label>uno</label><seg type="original" xml:lang="en">Om. M, Hk, Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_3.robnote.fn.17" n="17" source="#robertson"><bibl><biblScope unit="page">72</biblScope></bibl><label>compellet</label><seg type="original" xml:lang="en"><hi rend="italic">v. alius p. compellat aliquem</hi> Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_3.robnote.fn.18" n="18" source="#robertson"><bibl><biblScope unit="page">72</biblScope></bibl><label>tolneum</label><seg type="original" xml:lang="en">R; <hi rend="italic">teloneum</hi> T, M, Hk, Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_3.robnote.fn.19" n="19" source="#robertson"><bibl><biblScope unit="page">72</biblScope></bibl><label>debuisset</label><seg type="original" xml:lang="en"><hi rend="italic">debuit</hi> Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_3.robnote.fn.20" n="20" source="#robertson"><bibl><biblScope unit="page">72</biblScope></bibl><label>vii°</label><seg type="original" xml:lang="en"><hi rend="smallcaps">vi</hi>° M, Hk, Br.</seg></note>
      </div>
