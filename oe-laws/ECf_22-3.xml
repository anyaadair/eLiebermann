      <div type="clause" n="22.3">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 22.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 22.3"><pb n="647" ed="#liebermann"/>Team<ptr type="liebermannNote" n="32" target="#ECf_22-3.lnote.la.32"/><ptr type="liebermannNote" n="a" target="#ECf_22-3.lnote.oe.erkl-a"/>: quod, si aliquis<ptr type="liebermannNote" n="33" target="#ECf_22-3.lnote.la.33"/> aliquid<ptr type="liebermannNote" n="34" target="#ECf_22-3.lnote.la.34"/> interciebatur<ptr type="liebermannNote" n="35" target="#ECf_22-3.lnote.la.35"/> super aliquem<ptr type="liebermannNote" n="36" target="#ECf_22-3.lnote.la.36"/>, et ipse non poterat<ptr type="liebermannNote" n="37" target="#ECf_22-3.lnote.la.37"/> warantum<ptr type="liebermannNote" n="38" target="#ECf_22-3.lnote.la.38"/> suum habere, <ptr type="liebermannNote" n="f" target="#ECf_22-3.lnote.la.fn.f"/>erat<ptr type="liebermannNote" n="39" target="#ECf_22-3.lnote.la.39"/> forisfactura<ptr type="liebermannNote" n="40" target="#ECf_22-3.lnote.la.40"/> et iusticia<ptr type="liebermannNote" n="41" target="#ECf_22-3.lnote.la.41"/>; similiter de calumpniatore, si deficiebat<ptr type="liebermannNote" n="42" target="#ECf_22-3.lnote.la.42"/>.</ab>
        <note type="comparison" source="#liebermann" n="647"><label>printed alongside</label> <ref target="clause:ECfRetr_22-3">ECf retr 22.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 647 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-3.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">sua <hi rend="italic">ergänzt Retr., richtig laut</hi> 22, 1</seg><seg type="translation" xml:lang="en" source="#claude">the Retr. supplies sua, rightly according to 22, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-3.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">theam <hi rend="italic">Rl S;</hi> them <hi rend="italic">Ad Do Wo</hi></seg><seg type="translation" xml:lang="en" source="#claude">theam Rl S; them Ad Do Wo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-3.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk Hr;</hi> quis <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk Hr; quis Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-3.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Rl Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Rl Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-3.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">-ciab. <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ciab. Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-3.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">-quod <hi rend="italic">Ad;</hi> -quid <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-quod Ad; -quid Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-3.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">-rit <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rit Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-3.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">warent. <hi rend="italic">Rl Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">warent. Rl Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-3.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">erit <hi rend="italic">Ad Do; fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">erit Ad Do; lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-3.lnote.la.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-3.lnote.la.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">s. i. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. i. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-3.lnote.la.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">defecerit <hi rend="italic">Ad Do;</hi> sua erat <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">defecerit Ad Do; Hk adds sua erat</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Team: that, if anyone attached something in the hands of another, and he could not have his warrantor, there was forfeiture and justice; likewise concerning the accuser, if he failed.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_22-3.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Anefang 27a bis 28b; Klage 7b</seg><seg type="translation" xml:lang="en" source="#claude">Cf. <hi rend="italic">Gl</hi> Anefang 27a to 28b; Klage 7b</seg></note>
      </div>
    </body>
