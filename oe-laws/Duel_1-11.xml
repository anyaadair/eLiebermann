        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Duel 1.11" corresp="#wit-lat"><pb n="430" ed="#liebermann"/>Domine<ptr type="liebermannNote" n="23" target="#Duel_1-11.lnote.oe.23"/>, ne memineris iniquitatum<ptr type="liebermannNote" n="24" target="#Duel_1-11.lnote.oe.24"/> nostrarum antiquarum; cito anticipent<ptr type="liebermannNote" n="25" target="#Duel_1-11.lnote.oe.25"/> nos<ptr type="liebermannNote" n="26" target="#Duel_1-11.lnote.oe.26"/> misericordiæ tuæ, quia pauperes facti sumus nimis.</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">78, 8</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 430 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_1-11.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de">Ne m. D. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ne m. D. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_1-11.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de">-tem <hi rend="italic">Ta;</hi> in. — nimis <hi rend="italic">Tr Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tem Ta; in. — nimis Tr Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_1-11.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de">autem <hi rend="italic">Ta</hi></seg><seg type="translation" xml:lang="en" source="#claude">autem Ta</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_1-11.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de">nos — nimis <hi rend="italic">nur Sr; dafür</hi> usque ‘nimis’ <hi rend="italic">Hm</hi></seg><seg type="translation" xml:lang="en" source="#claude">nos — nimis only in Sr; instead usque ‘nimis’ Hm</seg></note>
