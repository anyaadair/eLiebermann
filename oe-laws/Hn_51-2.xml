      <div type="clause" n="51.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 51.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 51.2" corresp="#wit-lat"><pb n="573" ed="#liebermann"/>Debent autem, ut<ptr type="liebermannNote" n="f" target="#Hn_51-2.lnote.oe.f"/> dictum est, ad singulos menses, id est per annum duodecies, congregari<ptr type="liebermannNote" n="20" target="#Hn_51-2.lnote.oe.20"/> hundreta, comitatus<ptr type="liebermannNote" n="g" target="#Hn_51-2.lnote.oe.g"/> bis, si non sit opus amplius (eis<ptr type="liebermannNote" n="21" target="#Hn_51-2.lnote.oe.21"/>); et omnis homo rectum faciat alii<ptr type="liebermannNote" n="22" target="#Hn_51-2.lnote.oe.22"/> ad rectum terminum, et omnis causa finem<ptr type="liebermannNote" n="h" target="#Hn_51-2.lnote.oe.h"/> habeat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 573 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_51-2.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 7, 4</seg><seg type="translation" xml:lang="en" source="#claude">cf. 7, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_51-2.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht aus II Cn.</hi> 18 (= <hi rend="italic">III Eg.</hi> 5, 1)</seg><seg type="translation" xml:lang="en" source="#claude">perhaps from II Cn. 18 (= III Eg. 5, 1)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_51-2.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus I Ew. Pr.</hi> = <hi rend="italic">II Ew.</hi> 8<hi rend="italic">?</hi></seg><seg type="translation" xml:lang="en" source="#claude">from I Ew. Pr. = II Ew. 8?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_51-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">-ati <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ati Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_51-2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht in Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">not in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_51-2.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">alteri <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">alteri Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_51-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. 30; Gericht 9d—<hi rend="italic">opus eos a</hi>. ohne <hi rend="italic">eis</hi>{21}—<hi rend="italic">rectum</hi> bis <hi rend="italic">omnis</hi> am Rande—51, 3 <hi rend="italic">l. in s. u. alt. alium</hi>{24} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. 30; Gericht 9d—<hi rend="italic">opus eos a</hi>. without <hi rend="italic">eis</hi>{21}—<hi rend="italic">rectum</hi> to <hi rend="italic">omnis</hi> in the margin—51, 3 <hi rend="italic">l. in s. u. alt. alium</hi>{24} Rs</seg></note>
