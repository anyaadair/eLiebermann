      <div type="clause" n="III 53">
        <head><ref type="lawCode" target="law:InCn">In Cn</ref> III 53</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="In Cn III 53" corresp="#wit-lat"><pb n="614" ed="#liebermann"/>Antiqua<ptr type="liebermannNote" n="g" target="#InCn_III-53.lnote.oe.g"/> consuetudo fuit, ut omnis ęcclesiastica et<ptr type="liebermannNote" n="q" target="#InCn_III-53.lnote.oe.q"/> secularis emendatio communis erat regi et episcopo.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 614 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-53.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">614</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">d. h. vor</hi> 1066; <hi rend="italic">vgl.</hi> III 53. 57. 60</seg><seg type="translation" xml:lang="en" source="#claude">i.e. before 1066; cf. III 53. 57. 60</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-53.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">614</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">meint Verf.:</hi> gemischt kirchlich-staatlich <hi rend="italic">wie</hi> III 51, <hi rend="italic">bei Heidenthum</hi> EGu. Pr. 2, <hi rend="italic">Incest</hi> EGu. 4, <hi rend="italic">bei Zehntweigerung</hi> II Eg. 3, 1 (<hi rend="italic">daraus</hi> VIII Atr. 8. 15. 36), adulterium Hn 11, 5? <hi rend="italic">Jedenfalls ist</hi> omnis <hi rend="italic">übertrieben wie</hi> omnia III 57</seg><seg type="translation" xml:lang="en" source="#claude">does the author mean mixed ecclesiastical and secular, as in III 51, in cases of heathenism EGu. Pr. 2, incest EGu. 4, refusal of tithe II Eg. 3, 1 (whence VIII Atr. 8. 15. 36), adulterium Hn 11, 5? In any case omnis is an exaggeration, like omnia III 57</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-53.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">333</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. 51; Einl. 14</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 51; Introduction 14</seg></note>
      </div>
