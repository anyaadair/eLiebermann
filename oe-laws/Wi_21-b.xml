    <body>
      <div type="clause" n="21[b]">
        <head><ref type="lawCode" target="law:Wi">Wi</ref> 21[b]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="21[b]" corresp="#wit-h"><pb n="14" ed="#liebermann"/>⁊ ðissa ealra að sie unlegnæ.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-h"><pb n="28" ed="#attenborough"/>⁊ ðissa ealra að sie unlegnæ.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="16.2" corresp="#wit-h"><pb n="158" ed="#oliver"/>⁊ ðissa ealra að sie unlegnæ.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="14" ed="#liebermann"/>und dieser<ptr type="liebermannNote" n="3" target="#Wi_21-b.lnote.de.3"/> aller Eid sei untadelig.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">and the oath of all these is to be unimpeachable.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="29" ed="#attenborough"/>and the oath of all these [collectively] shall be incontrovertible.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h"><pb n="159" ed="#oliver"/>and let the oath of all these be incontrovertible.</ab>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Wi_21-b.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">29</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Der in 17—21 erwähnten. Zu <hi rend="italic">unlegen</hi> <hi rend="italic">s. o.</hi> 16⁴</seg><seg type="translation" xml:lang="en" source="#claude">Of those mentioned in 17—21. On <hi rend="italic">unlegen</hi> <hi rend="italic">see above</hi> 16⁴</seg></note>
      </div>
    </body>
  </text>
