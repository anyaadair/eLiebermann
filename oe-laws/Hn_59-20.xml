        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.20" corresp="#wit-lat"><pb n="579" ed="#liebermann"/>Singulos<ptr type="liebermannNote" n="v" target="#Hn_59-20.lnote.oe.v"/> conuenit<ptr type="liebermannNote" n="39" target="#Hn_59-20.lnote.oe.39"/>, ut<ptr type="liebermannNote" n="40" target="#Hn_59-20.lnote.oe.40"/> ueram per omnia iusticiam teneant et sic in<ptr type="liebermannNote" n="41" target="#Hn_59-20.lnote.oe.41"/> malefacientibus misericordiam senciant<ptr type="liebermannNote" n="42" target="#Hn_59-20.lnote.oe.42"/>, ne forisbannitum<ptr type="liebermannNote" n="43" target="#Hn_59-20.lnote.oe.43"/> aut furem handhabbendam<ptr type="liebermannNote" n="w" target="#Hn_59-20.lnote.oe.w"/><ptr type="liebermannNote" n="44" target="#Hn_59-20.lnote.oe.44"/> Francigenam uel Anglicum ultra duodecimum etatis annum et VIII<ptr type="liebermannNote" n="x" target="#Hn_59-20.lnote.oe.x"/> denarios ualens impunitum transeant<ptr type="liebermannNote" n="45" target="#Hn_59-20.lnote.oe.45"/>.</ab>
