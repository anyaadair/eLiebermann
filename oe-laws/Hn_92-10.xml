        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-10.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">608</biblScope></bibl><seg type="original" xml:lang="de">Si — more <hi rend="italic">doppelt K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Si — more twice K Co</seg></note>
