        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-1.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Lind. S.</hi> 117</seg><seg type="translation" xml:lang="en" source="#claude">Lind. p. 117</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geändert in</hi> vt. <hi rend="italic">Du</hi></seg><seg type="translation" xml:lang="en" source="#claude">altered to vt. Du</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">letzter Buchstabe durch Abreibung unklar</hi></seg><seg type="translation" xml:lang="en" source="#claude">last letter unclear through rubbing</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wollte Glossator</hi> wœron <hi rend="italic">hinzufügen? In rein Engl. Text heisst</hi> ł : oððe (<hi rend="italic">so</hi> 4, 5); <hi rend="italic">ein Wortverbesserer aber denkt halb Lateinisch</hi></seg><seg type="translation" xml:lang="en" source="#claude">did the glossator mean to add wœron? In a purely English text ł means oððe (thus 4, 5); but a corrector of words thinks half in Latin</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-du">who for us men and for our salvation came down from the bosom of the Father and deigned to take flesh from the Virgin Mary, and through your passion redeemed the world on the cross, and descended to those below (hell), and bound the devil in the outer darkness, and all the just, who were held there by original sin, you set free from there with great power,</ab>
