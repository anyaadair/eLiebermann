      <div type="clause" n="9.6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 9.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 9.6" corresp="#wit-lat"><pb n="555" ed="#liebermann"/>Differt etiam, an aliquis cum suo uel alterius homine causam agat, et si quid in actu<ptr type="liebermannNote" n="p" target="#Hn_9-6.lnote.oe.p"/> uel in solà<ptr type="liebermannNote" n="q" target="#Hn_9-6.lnote.oe.q"/> tihla<ptr type="liebermannNote" n="29" target="#Hn_9-6.lnote.oe.29"/> consistat, et si quid bello uel lege sacramentali — plaua<ptr type="liebermannNote" n="r" target="#Hn_9-6.lnote.oe.r"/><ptr type="liebermannNote" n="30" target="#Hn_9-6.lnote.oe.30"/> uel frangenti — uel etiam iudiciali repetatur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 555 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-6.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 9, 1<hi rend="italic">a;</hi> 57, 6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 9, 1<hi rend="italic">a;</hi> 57, 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-6.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">sola inculpatio 62, 3<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">sola inculpatio 62, 3<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-6.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">schlichten oder gestabten Eidesbeweis [<hi rend="italic">s. u.</hi> 18] oder einseitigen Ordalbeweis</seg><seg type="translation" xml:lang="en" source="#claude">simple or formulaic oath-proof [<hi rend="italic">see below</hi> 18] or one-sided proof by ordeal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-6.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">tihtla <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">tihtla <hi rend="italic">Wi</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-6.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vom Corr. geänd.</hi> plena <hi rend="italic">Sc und so übr., auch Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">altered by the corrector to plena <hi rend="italic">Sc</hi>, and so the others, also edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-6.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">317</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> handhaft; Zweikampf; Stabeid; Ordal—<hi rend="italic">plena</hi>{30}—9, 7 <hi rend="italic">accusatione</hi>{35} <hi rend="italic">p</hi>. ohne <hi rend="italic">modis</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> handhaft; Zweikampf; Stabeid; Ordal—<hi rend="italic">plena</hi>{30}—9, 7 <hi rend="italic">accusatione</hi>{35} <hi rend="italic">p</hi>. without <hi rend="italic">modis</hi> Rs</seg></note>
      </div>
