        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-3a.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">modis <hi rend="italic">fügt zu Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">Va adds modis</seg></note>
