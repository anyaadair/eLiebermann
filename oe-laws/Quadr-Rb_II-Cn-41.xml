      <div type="clause" n="II Cn 41">
        <head>Quadr Rb II Cn 41</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Rb II Cn 41" corresp="#wit-lat"><pb n="537" ed="#liebermann"/>Si<ptr type="liebermannNote" n="46" target="#Quadr-Rb_II-Cn-41.lnote.la.46"/> quis ordinatus<ptr type="liebermannNote" n="47" target="#Quadr-Rb_II-Cn-41.lnote.la.47"/> hominem occidat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 537 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">If a man in orders kills a man.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-41.lnote.la.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">537</biblScope></bibl><seg type="original" xml:lang="de">De ordinato qui h. o. <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">De ordinato qui h. o. Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-41.lnote.la.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">537</biblScope></bibl><seg type="original" xml:lang="de">in ordine constitutus <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">in ordine constitutus Lond</seg></note>
      </div>
