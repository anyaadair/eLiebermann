        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_42-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">76</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Q hat <hi rend="italic">agenfrigea</hi> mehrfach als wär es Terminus verkannt; <hi rend="italic">s. Wb</hi></seg><seg type="translation" xml:lang="en" source="#claude">Q has several times misunderstood <hi rend="italic">agenfrigea</hi>, as if it were a technical term; <hi rend="italic">see Wb</hi></seg></note>
