      <div type="clause" n="III 54">
        <head><ref type="lawCode" target="law:InCn">In Cn</ref> III 54</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="In Cn III 54" corresp="#wit-lat"><pb n="614" ed="#liebermann"/>Hoc etiam debet quisque scire, quia<ptr type="liebermannNote" n="r" target="#InCn_III-54.lnote.oe.r"/>, si<ptr type="liebermannNote" n="10" target="#InCn_III-54.lnote.oe.10"/> pro aliqua forisfactura, quę ad Deum<ptr type="liebermannNote" n="11" target="#InCn_III-54.lnote.oe.11"/> pertineat<ptr type="liebermannNote" n="12" target="#InCn_III-54.lnote.oe.12"/>, accipitur<ptr type="liebermannNote" n="13" target="#InCn_III-54.lnote.oe.13"/> pecunia ab episcopo uel ab aliquo alio, episcopus debet eandem pecuniam distribuere ęcclesiis et pauperibus<ptr type="liebermannNote" n="s" target="#InCn_III-54.lnote.oe.s"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 614 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-54.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">614</biblScope></bibl><seg type="original" xml:lang="de">‘dass’</seg><seg type="translation" xml:lang="en" source="#claude">‘that’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-54.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">614</biblScope></bibl><seg type="original" xml:lang="de">gif for godbotan feohbot ariseð, .. to þearfena hyþþe ⁊ to cyricbote; VI Atr. 51; <hi rend="italic">vgl.</hi> Can. Edgari 55. <hi rend="italic">Auch</hi> III 45, 3 <hi rend="italic">setzt Verf.</hi> pauperum <hi rend="italic">zu</hi> Had 9, 1</seg><seg type="translation" xml:lang="en" source="#claude">gif for godbotan feohbot ariseð, .. to þearfena hyþþe ⁊ to cyricbote; VI Atr. 51; cf. Can. Edgari 55. In III 45, 3 too the author adds pauperum to Had 9, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-54.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">614</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt T</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-54.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">614</biblScope></bibl><seg type="original" xml:lang="de">dominum <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">dominum T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-54.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">614</biblScope></bibl><seg type="original" xml:lang="de">-net <hi rend="italic">CbT</hi></seg><seg type="translation" xml:lang="en" source="#claude">-net CbT</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-54.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">614</biblScope></bibl><seg type="original" xml:lang="de">p. a. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. a. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-54.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">333</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. 45, 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 45, 3</seg></note>
      </div>
