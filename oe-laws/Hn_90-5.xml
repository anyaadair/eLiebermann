      <div type="clause" n="90.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 90.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 90.5" corresp="#wit-lat"><pb n="605" ed="#liebermann"/>Si quis in sepem uel in quodlibet<ptr type="liebermannNote" n="50" target="#Hn_90-5.lnote.oe.50"/> periculum res alienas inuit[a]s<ptr type="liebermannNote" n="51" target="#Hn_90-5.lnote.oe.51"/> minauerit<ptr type="liebermannNote" n="52" target="#Hn_90-5.lnote.oe.52"/>, et ibidem interfecte uel debilitate fuerint, similes restituat; aut cum VI iuret, quod hoc non fecisset.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 605 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-5.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">quocumque l. periculo <hi rend="italic">Rib.</hi></seg><seg type="translation" xml:lang="en" source="#claude">quocumque l. periculo Rib.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-5.lnote.oe.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">-tus <hi rend="italic">Hss. Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tus MSS edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-5.lnote.oe.52" n="52" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">inuiau. <hi rend="italic">las Wh Wi, gemäss früheren</hi> Ribuaria-<hi rend="italic">Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">inuiau. read by Wh Wi, following earlier edd. of the Ribuaria</seg></note>
