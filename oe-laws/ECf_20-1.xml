    <body>
      <div type="clause" n="20.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 20.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 20.1"><pb n="645" ed="#liebermann"/>Et hoc est, quod de<ptr type="liebermannNote" n="17" target="#ECf_20-1.lnote.la.17"/> omnibus uillis<ptr type="liebermannNote" n="h" target="#ECf_20-1.lnote.la.fn.h"/><ptr type="liebermannNote" n="18" target="#ECf_20-1.lnote.la.18"/> totius regni sub decennali fideiussione debebant<ptr type="liebermannNote" n="19" target="#ECf_20-1.lnote.la.19"/> omnes esse, ita quod, si unus ex decem forisfaceret<ptr type="liebermannNote" n="20" target="#ECf_20-1.lnote.la.20"/>, nouem haberent<ptr type="liebermannNote" n="21" target="#ECf_20-1.lnote.la.21"/> eum<ptr type="liebermannNote" n="7" target="#ECf_20-1.lnote.la.7"/> ad<ptr type="liebermannNote" n="22" target="#ECf_20-1.lnote.la.22"/> rectum<ptr type="liebermannNote" n="i" target="#ECf_20-1.lnote.la.fn.i"/>.</ab>
        <note type="comparison" source="#liebermann" n="645"><label>printed alongside</label> <ref target="clause:ECfRetr_20-1">ECf retr 20.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 645 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “decennali” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-1.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht in ganz England, aber auch in Städten bestand Freibürgschaft, nicht bloss unter</hi> uillani <hi rend="italic">oder Freibauern</hi></seg><seg type="translation" xml:lang="en" source="#claude">frankpledge existed not in all of England, but also in towns, not merely among uillani or free peasants</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-1.lnote.la.fn.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">vor Gericht stellen <hi rend="italic">auch Quadr.</hi> III Eg. 6; I Atr. 1; II Cn. 20a</seg><seg type="translation" xml:lang="en" source="#claude">bring before the court, Quadr. too, III Eg. 6; I Atr. 1; II Cn. 20a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-1.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">Hr Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">in Hr Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-1.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">prouinciis <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">prouinciis Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-1.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">debeant <hi rend="italic">Hk S Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">debeant Hk S Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-1.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl;</hi> -fecerit <hi rend="italic">S Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl; -fecerit S Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-1.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">e. h. <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. h. S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-1.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-1.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">adiectum <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">adiectum Hr</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And this is, that from all the vills of the whole kingdom all ought to be under a tenfold suretyship, so that, if one of the ten committed an offence, the nine should have him to right.</ab>
      </div>
    </body>
