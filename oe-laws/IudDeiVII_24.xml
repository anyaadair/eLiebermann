      <div type="clause" n="24">
        <head><ref type="lawCode" target="law:IudDeiVII">Iud Dei VII</ref> 24</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei VII 24" corresp="#wit-lat"><pb n="414" ed="#liebermann"/>Deprecamur<ptr type="liebermannNote" n="8" target="#IudDeiVII_24.lnote.oe.8"/> te, domine Ihesu Christe, quod in hoc signum tuum sic ponas: si hic homo (hi<ptr type="liebermannNote" n="2" target="#IudDeiVII_24.lnote.oe.2"/> -mines) reus sit (rei<ptr type="liebermannNote" n="2" target="#IudDeiVII_24.lnote.oe.2-2"/> sint), in hanc aquam receptus (-ti<ptr type="liebermannNote" n="2" target="#IudDeiVII_24.lnote.oe.2-2"/>) non sit (sint<ptr type="liebermannNote" n="2" target="#IudDeiVII_24.lnote.oe.2-2"/>).</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 414 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_24.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_24.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fast identisch mit Zeumer</hi> 619, <hi rend="italic">vgl.</hi> 625. 627. 651. 654. 656. 663. 690. 696; <hi rend="italic">unten</hi> VIII 2, 3 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">almost identical with Zeumer 619, cf. 625. 627. 651. 654. 656. 663. 690. 696; below VIII 2, 3 f.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_24.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier Sing. über Plur.</hi></seg><seg type="translation" xml:lang="en" source="#claude">here sing. above pl.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_24.lnote.oe.8-2" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">für</hi> forhtiendan</seg><seg type="translation" xml:lang="en" source="#claude">for forhtiendan</seg></note>
      </div>
