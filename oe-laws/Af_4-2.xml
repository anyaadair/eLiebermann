        <note type="liebermannNote" subtype="textual" xml:id="Af_4-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">51</biblScope></bibl><seg type="original" xml:lang="de">enim <hi rend="italic">T;</hi> stabilimus <hi rend="italic">fügt zu Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">enim T; stabilimus added by Or</seg></note>
