    <body>
      <div type="clause" n="23.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 23.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 23.5" corresp="#wit-lat"><ptr type="liebermannNote" n="n" target="#Hn_23-5.lnote.oe.n"/><pb n="561" ed="#liebermann"/>Eorum<ptr type="liebermannNote" n="o" target="#Hn_23-5.lnote.oe.o"/> etiam est consecucio<ptr type="liebermannNote" n="40" target="#Hn_23-5.lnote.oe.40"/> et reduccio furum sine calumpnia<ptr type="liebermannNote" n="p" target="#Hn_23-5.lnote.oe.p"/>;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 561 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_23-5.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">561</biblScope></bibl><seg type="original" xml:lang="de">23, 5 <hi rend="italic">f. stehen falsch angeordnet und gehören vielleicht hinter</hi> 24, 1</seg><seg type="translation" xml:lang="en" source="#claude">23, 5 f. are wrongly placed and perhaps belong after 24, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_23-5.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">561</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht</hi> iudicum fiscalium; <hi rend="italic">s.</hi> 24, 1 [<hi rend="italic">jedenfalls nicht</hi> abbatum]</seg><seg type="translation" xml:lang="en" source="#claude">perhaps iudicum fiscalium; see 24, 1 [at any rate not abbatum]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_23-5.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">561</biblScope></bibl><seg type="original" xml:lang="de">wo Privatkläger fehlt, von Amtswegen</seg><seg type="translation" xml:lang="en" source="#claude">where there is no private accuser, ex officio</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_23-5.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">561</biblScope></bibl><seg type="original" xml:lang="de">consencio <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">consencio Lond</seg></note>
      </div>
