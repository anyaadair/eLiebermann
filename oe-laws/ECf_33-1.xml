    <body>
      <div type="clause" n="33.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 33.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 33.1"><pb n="661" ed="#liebermann"/>In omnibus aliis causis et forisfacturis eandem legem<ptr type="liebermannNote" n="1" target="#ECf_33-1.lnote.la.1"/> habebant cum supradictis Norwensibus<ptr type="liebermannNote" n="a" target="#ECf_33-1.lnote.la.fn.a"/><ptr type="liebermannNote" n="2" target="#ECf_33-1.lnote.la.2"/>.</ab>
        <note type="comparison" source="#liebermann" n="661"><label>printed alongside</label> <ref target="clause:ECfRetr_33-1">ECf retr 33.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 661 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_33-1.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verf. vermengt in C.</hi> 34 <hi rend="italic">Dänen und Norweger, kennt also nicht etwa die vorwiegend Norwegische Besiedelung Nordbritanniens; auch sassen in Lincolnshire, das er dort in C.</hi> 30 <hi rend="italic">nennt, mehr Dänen</hi></seg><seg type="translation" xml:lang="en" source="#claude">in c. 34 the author mixes up Danes and Norwegians, so does not know, say, of the predominantly Norwegian settlement of northern Britain; also, in Lincolnshire, which he names there in c. 30, Danes were the more numerous</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_33-1.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_33-1.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">661</biblScope></bibl><seg type="original" xml:lang="de">Norgue. <hi rend="italic">Rl;</hi> Norwage. <hi rend="italic">Hk;</hi> Norwice. <hi rend="italic">Ad;</hi> Norwyce. <hi rend="italic">Wo Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Norgue. Rl; Norwage. Hk; Norwice. Ad; Norwyce. Wo Do</seg></note>
      </div>
    </body>
