      <div type="clause" n="13">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 13</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 13" corresp="#wit-lat"><ptr type="liebermannNote" n="33" target="#IudDeiI_13.lnote.oe.33"/><pb n="403" ed="#liebermann"/>Secreta. Intercessio<ptr type="liebermannNote" n="34" target="#IudDeiI_13.lnote.oe.34"/> sanctorum tuorum misericordiae<ptr type="liebermannNote" n="35" target="#IudDeiI_13.lnote.oe.35"/> tuae, Domine<ptr type="liebermannNote" n="36" target="#IudDeiI_13.lnote.oe.36"/>, munera nostra conciliet<ptr type="liebermannNote" n="37" target="#IudDeiI_13.lnote.oe.37"/>, ut<ptr type="liebermannNote" n="38" target="#IudDeiI_13.lnote.oe.38"/>, quam<ptr type="liebermannNote" n="39" target="#IudDeiI_13.lnote.oe.39"/> merita nostra non ualent<ptr type="liebermannNote" n="40" target="#IudDeiI_13.lnote.oe.40"/>, eorum deprecatio<ptr type="liebermannNote" n="41" target="#IudDeiI_13.lnote.oe.41"/> indulgentiam ualeat<ptr type="liebermannNote" n="42" target="#IudDeiI_13.lnote.oe.42"/> optinere. Per dominum<ptr type="liebermannNote" n="43" target="#IudDeiI_13.lnote.oe.43"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 403 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_13.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">13 <hi rend="italic">f. auch in Vt2 Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">13 also lacking in Vt2 Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_13.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">quesumus <hi rend="italic">fügt zu Bc</hi></seg><seg type="translation" xml:lang="en" source="#claude">quesumus added by Bc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_13.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">D. m. t. <hi rend="italic">Al Ma;</hi> -dia tua <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">D. m. t. Al Ma; -dia tua Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_13.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Bc Tr;</hi> quaesumus D. misericordiae tuae <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Bc Tr; quaesumus D. misericordiae tuae Ch</seg></note>
