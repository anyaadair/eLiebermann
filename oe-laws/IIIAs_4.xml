    <body>
      <div type="clause" n="4">
        <head><ref type="lawCode" target="law:IIIAs">III As</ref> 4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="4" corresp="#wit-q"><pb n="170" ed="#liebermann"/>Quartum<ptr type="liebermannNote" n="33" target="#IIIAs_4.lnote.oe.33"/>: ne<ptr type="liebermannNote" n="a" target="#IIIAs_4.lnote.oe.a"/> aliquis recipiat alterius<ptr type="liebermannNote" n="34" target="#IIIAs_4.lnote.oe.34"/> hominem sine licencia eius<ptr type="liebermannNote" n="5" target="#IIIAs_4.lnote.oe.5"/> (ipsius) cui ante<ptr type="liebermannNote" n="5" target="#IIIAs_4.lnote.oe.5"/> (prius) folgauit nec intra<ptr type="liebermannNote" n="b" target="#IIIAs_4.lnote.oe.b"/> mercam nec extra;</ab>
        <ab type="editionText" xml:lang="la" source="#attenborough" n="4" corresp="#wit-q"><pb n="144" ed="#attenborough"/>Quartum, ne aliquis recipiat alterius hominem sine licentia eius<ptr type="editorNote" n="7" target="#IIIAs_4.attnote.fn.7"/> cui ante<ptr type="editorNote" n="8" target="#IIIAs_4.attnote.fn.8"/> folgavit nec intra mercam nec extra;</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="145" ed="#attenborough"/>Fourthly, no one shall receive a man who has been in the service of another, without the permission of him he has been serving<ptr type="editorNote" n="1" target="#IIIAs_4.attnote.n.1"/>, whether within our borders or beyond them.</ab>
        <note type="comparison" source="#liebermann" n="170"><ref target="clause:IIAs_22">II As 22</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. II As. 22</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IVAs_4">IV As 4</ref>; <ref target="clause:IVAs_5">IV As 5</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="296"><label>digest of; wording like</label> <ref target="clause:IVAs_4">IV As 4–5</ref> <quote>V 1:1, a new decision about those unjustly accused by their lords, echoed in IV 5, which uses the word 'hlafordsocnam' as in III 4:1</quote></note>
        <note type="editorial">Latin only; no German translation in Liebermann. Liebermann compares II As 22.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_4.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">Quartus <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">Quartus T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_4.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">h. a. <hi rend="italic">M</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. a. M</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_4.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond; (eingeklammertes) übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket Lond; (the bracketed words) the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_4.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">111</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Der Reichstag zu Faversham wiederholte also Beschlüsse von Greatley</seg><seg type="translation" xml:lang="en" source="#claude">The assembly of the realm at Faversham thus repeated decisions of Greatley</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_4.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">111</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">aus <hi rend="italic">ne binnan mearce ne butan</hi>, hier: ‘Provinzgrenze’, = <hi rend="italic">scir</hi> Af 37</seg><seg type="translation" xml:lang="en" source="#claude">from <hi rend="italic">ne binnan mearce ne butan</hi>, here: ‘boundary of the province’, = <hi rend="italic">scir</hi> Af 37</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIAs_4.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">209</biblScope></bibl><seg type="original" xml:lang="en">Cf. Ine, cap. 39; Alf. cap. 37; II As. cap. 22; IV As. cap. 5.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_4.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">144</biblScope></bibl><label>eius</label><seg type="original" xml:lang="en"><hi rend="italic">ipsius</hi>. Br, M.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_4.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">144</biblScope></bibl><label>ante</label><seg type="original" xml:lang="en"><hi rend="italic">prius</hi>. Br, M.</seg></note>
      </div>
    </body>
