        <head><ref type="lawCode" target="law:Hn">Hn</ref> 9.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 9.7" corresp="#wit-lat"><pb n="555" ed="#liebermann"/>Permutantur<ptr type="liebermannNote" n="32" target="#Hn_9-7.lnote.oe.32"/> etiam causarum acciones in<ptr type="liebermannNote" n="s" target="#Hn_9-7.lnote.oe.s"/> locorum contingentiis, in tempore<ptr type="liebermannNote" n="33" target="#Hn_9-7.lnote.oe.33"/>, ex personis<ptr type="liebermannNote" n="34" target="#Hn_9-7.lnote.oe.34"/>, in accusationum<ptr type="liebermannNote" n="35" target="#Hn_9-7.lnote.oe.35"/> modis.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 555 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-7.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 9, 3. 40, 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 9, 3. 40, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-7.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">Permitt. <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">Permitt. <hi rend="italic">Wh</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-7.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">-rum <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rum <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-7.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier interpungiren, gegen Hss., Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">punctuate here, against MSS and edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-7.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">acusacione personarum <hi rend="italic">ohne</hi> modis, <hi rend="italic">dann Punkt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">acusacione personarum without modis, then a full stop <hi rend="italic">Lond</hi></seg></note>
