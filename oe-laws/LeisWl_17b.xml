    <body>
      <div type="clause" n="17b">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 17b</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-hk"><ptr type="liebermannNote" n="a" target="#LeisWl_17b.lnote.oe.a"/><pb n="504–505" ed="#liebermann"/>. . . . . . . . . . . . . . . .</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-i"><pb n="504–505" ed="#liebermann"/>Li burgeis, qui<ptr type="liebermannNote" n="3" target="#LeisWl_17b.lnote.oe.3"/> ad en soun<ptr type="liebermannNote" n="6" target="#LeisWl_17b.lnote.oe.6"/> propre chatel demi marc vailant, deit doner<ptr type="liebermannNote" n="7" target="#LeisWl_17b.lnote.oe.7"/> le dener Seint Pere.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="504–505" ed="#liebermann"/>Burgensis si habet de proprio catallo ad ualenciam dimidie marce, dabit denar. Sancti Petri.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="17b" corresp="#wit-i"><pb n="260" ed="#robertson"/>Li burgeis qui ad en soun propre chatel demi marc vailant deit doner le dener Seint Pere.]</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="504–505" ed="#liebermann"/>17<hi rend="italic">b</hi>. Der Bürger, der in seinem Eigenthum eine Halbmark<ptr type="liebermannNote" n="c" target="#LeisWl_17b.lnote.de1.c"/> werthe Fahrhabe besitzt, soll den Peterspfennig zahlen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">17<hi rend="italic">b</hi>. The burgess who possesses in his own property movable goods worth half a mark shall pay Peter's Pence.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-i"><pb n="261" ed="#robertson"/>A burgess who possesses property of his own of the value of half a mark shall pay Peter's Pence.]</ab>
        <note type="editorial">Added October 2026 from Robertson pp. 260–261 (text and translation); 17a and 17b are from I (not in Hk) (Robertson).; Liebermann’s text and German translation added from Gesetze I p. 504–505, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_17b.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze aus IL</hi></seg><seg type="translation" xml:lang="en" source="#claude">supply from IL</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_17b.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">qi <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">qi <hi rend="italic">Im</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_17b.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">son <hi rend="italic">Isp;</hi> sonn <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">son <hi rend="italic">Isp;</hi> sonn <hi rend="italic">Io</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_17b.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">do. le <hi rend="italic">fehlt Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">do. le missing in Io</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="LeisWl_17b.lnote.de1.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">505</biblScope></bibl><seg type="original" xml:lang="de">80 Pfennig</seg><seg type="translation" xml:lang="en" source="#claude">80 pence</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_17b.lnote.de._" n="-" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">289</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> II 489 Z. 2f.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> II 489 l. 2f.</seg></note>
      </div>
