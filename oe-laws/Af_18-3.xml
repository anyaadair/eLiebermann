      <div type="clause" n="18.3">
        <head><ref type="lawCode" target="law:Af">Af</ref> 18.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="18.3" corresp="#wit-e"><pb n="60" ed="#liebermann"/>Gif hio sie twelfhyndu, CXX<ptr type="liebermannNote" n="4" target="#Af_18-3.lnote.oe.4"/> scill. gebete þam byrgean.<ptr type="liebermannNote" n="3" target="#Af_18-3.lnote.oe.3"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="18.3" corresp="#wit-h"><pb n="60" ed="#liebermann"/>Gif hio sy<ptr type="liebermannNote" n="1" target="#Af_18-3.lnote.oe.1"/> XII hynde, CXX scll' gebete ðam þe<ptr type="liebermannNote" n="4" target="#Af_18-3.lnote.oe.4-2"/> hit gebyrie.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="18.3" corresp="#wit-b-no-prol"><pb n="60" ed="#liebermann"/>Gyf heo sy twelfhynde, hundtwelftig scill' gebete ðam ðe<ptr type="liebermannNote" n="2" target="#Af_18-3.lnote.oe.2"/> to gebyrige.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="18.3" corresp="#wit-q"><pb n="61" ed="#liebermann"/>Si<ptr type="liebermannNote" n="5" target="#Af_18-3.lnote.oe.5"/> est twelf-<ptr type="liebermannNote" n="6" target="#Af_18-3.lnote.oe.6"/>(duodecim-)hinda, C uiginti solid. emendetur marito.<ptr type="liebermannNote" n="7" target="#Af_18-3.lnote.oe.7"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="72" ed="#attenborough"/>Gif hio sie twelfhyndu, CXX scill. gebete þam<ptr type="editorNote" n="18" target="#Af_18-3.attnote.fn.18"/> byrgean<ptr type="editorNote" n="17" target="#Af_18-3.attnote.fn.17"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="21.2" corresp="#wit-e"><pb n="312" ed="#jurasinski-and-oliver"/>Gif hio sie twelfhyndu, CXX scill gebete þam byrgean.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="61" ed="#liebermann"/>Wenn sie [vom] 1200 [Schilling-Wergeld] ist, büsse sie dem Bürgen 120 Schilling.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If she is [of] 1200 [shillings’ wergeld], let her pay the surety 120 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="73" ed="#attenborough"/>If her wergeld is 1200 shillings, she shall pay 120 shillings to the surety [of the marriage].</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="412" ed="#whitelock"/>If she is a woman of a twelve-hundred wergild, 120 shillings are to be paid to the surety.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="313" ed="#jurasinski-and-oliver"/>If she is [of] twelve-hundred rank, let her compensate the guarantor with 120 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_18-3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">hundtwelftig <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">hundtwelftig So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_18-3.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">bir. <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">bir. So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_18-3.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_18-3.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">þe h. g. <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">þe h. g. on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_18-3.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">61</biblScope></bibl><seg type="original" xml:lang="de">18,3 <hi rend="italic">fehlt T Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">18,3 lacking in T Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_18-3.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">61</biblScope></bibl><seg type="original" xml:lang="de">tƿelf. <hi rend="italic">Lond,</hi> duod. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">tƿelf. Lond, duod. R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_18-3.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">61</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt c.</hi> 12 <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. 12 follows in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_18-3.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">hit <hi rend="italic">im</hi> 16. <hi rend="italic">Jh. zugefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">hit added in the 16th cent.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_18-3.attnote.fn.17" n="17" source="#attenborough"><bibl><biblScope unit="page">72</biblScope></bibl><label>byrgean</label><seg type="original" xml:lang="en"><hi rend="italic">þe hit gebyrie</hi>. H. <hi rend="italic">to gebyrian</hi>. B.</seg><note type="remark" resp="#claude">The number 17 is printed 2 times on the page (18.2, 18.3), with one footnote.</note></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_18-3.attnote.fn.18" n="18" source="#attenborough"><bibl><biblScope unit="page">72</biblScope></bibl><label>þam</label><seg type="original" xml:lang="en"><hi rend="italic">ðam ðe</hi>. B.</seg></note>
      </div>
    </body>
