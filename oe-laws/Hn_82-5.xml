      <div type="clause" n="82.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 82.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 82.5" corresp="#wit-lat"><pb n="599" ed="#liebermann"/>Et quotcunque<ptr type="liebermannNote" n="3" target="#Hn_82-5.lnote.oe.3"/> dominos<ptr type="liebermannNote" n="b" target="#Hn_82-5.lnote.oe.b"/> quis<ptr type="liebermannNote" n="4" target="#Hn_82-5.lnote.oe.4"/> habeat uel quantumcunque<ptr type="liebermannNote" n="5" target="#Hn_82-5.lnote.oe.5"/> de aliis teneat, ei plus debet cuius<ptr type="liebermannNote" n="6" target="#Hn_82-5.lnote.oe.6"/> ligius est (in<ptr type="liebermannNote" n="7" target="#Hn_82-5.lnote.oe.7"/>) honesto<ptr type="liebermannNote" n="bb" target="#Hn_82-5.lnote.oe.bb"/>, utili et necessario ad facultatem, ad<ptr type="liebermannNote" n="8" target="#Hn_82-5.lnote.oe.8"/> sanitatem, ad animam<ptr type="liebermannNote" n="c" target="#Hn_82-5.lnote.oe.c"/><ptr type="liebermannNote" n="9" target="#Hn_82-5.lnote.oe.9"/>; et eius residens esse debet et in bello secum esse; et eius manbota est, si occidatur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 599 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-5.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 43, 6; 6<hi rend="italic">a</hi>. 55, 2; 3<hi rend="italic">b</hi>. 61, 6<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">as 43, 6; 6<hi rend="italic">a</hi>. 55, 2; 3<hi rend="italic">b</hi>. 61, 6<hi rend="italic">b</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-5.lnote.oe.bb" n="bb" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 55, 3</seg><seg type="translation" xml:lang="en" source="#claude">cf. 55, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-5.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">für die Seele <hi rend="italic">des gestorbenen Herrn, durch Beschenkung Geistlicher und Armer</hi></seg><seg type="translation" xml:lang="en" source="#claude">for the soul of the deceased lord, by gifts to clergy and the poor</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-5.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">quosc. <hi rend="italic">Lond</hi>; quotque <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">quosc. Lond; quotque Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-5.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-5.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">qu. — debet <hi rend="italic">überspringt Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">Gi omits qu. — debet</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-5.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">cui leg. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">cui leg. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-5.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht in Sc Hg</hi>; omni <hi rend="italic">ohne Hss. fügt zu Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">not in Sc Hg; Wi Tho add omni without MS authority</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-5.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-5.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">aīam <hi rend="italic">Sc Hg</hi>; a. et <hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">aīam Sc Hg; a. et missing in K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-5.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl</hi>. CHn cor 7, 1{a}; <hi rend="italic">Gl</hi> ligius 4; Mannbusse 7; Seelschatz 9—<hi rend="italic">quosc</hi>.{5}—<hi rend="italic">in</hi>{7}—<hi rend="italic">ad an</hi>.{9}—82, 6 fehlt—<hi rend="italic">contrista</hi>.{10}—82, 7 <hi rend="italic">cog. suo</hi>{12}—<hi rend="italic">nec</hi>.{13} fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf</hi>. CHn cor 7, 1{a}; <hi rend="italic">Gl</hi> ligius 4; Mannbusse 7; Seelschatz 9—<hi rend="italic">quosc</hi>.{5}—<hi rend="italic">in</hi>{7}—<hi rend="italic">ad an</hi>.{9}—82, 6 missing—<hi rend="italic">contrista</hi>.{10}—82, 7 <hi rend="italic">cog. suo</hi>{12}—<hi rend="italic">nec</hi>.{13} missing Rs</seg></note>
      </div>
