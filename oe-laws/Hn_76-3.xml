      <div type="clause" n="76.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 76.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 76.3" corresp="#wit-lat"><pb n="593" ed="#liebermann"/>Serui alii natura<ptr type="liebermannNote" n="d" target="#Hn_76-3.lnote.oe.d"/>, alii facti<ptr type="liebermannNote" n="14" target="#Hn_76-3.lnote.oe.14"/>, et<ptr type="liebermannNote" n="12" target="#Hn_76-3.lnote.oe.12"/> alii empcione et<ptr type="liebermannNote" n="12" target="#Hn_76-3.lnote.oe.12"/> alii redempcione<ptr type="liebermannNote" n="e" target="#Hn_76-3.lnote.oe.e"/>, alii sui<ptr type="liebermannNote" n="f" target="#Hn_76-3.lnote.oe.f"/><ptr type="liebermannNote" n="15" target="#Hn_76-3.lnote.oe.15"/> uel alterius<ptr type="liebermannNote" n="g" target="#Hn_76-3.lnote.oe.g"/> dacione<ptr type="liebermannNote" n="a" target="#Hn_76-3.lnote.oe.a"/> serui, — et si que sunt alie<ptr type="liebermannNote" n="16" target="#Hn_76-3.lnote.oe.16"/> species huiusmodi<ptr type="liebermannNote" n="17" target="#Hn_76-3.lnote.oe.17"/>, quas tamen omnes uolumus<ptr type="liebermannNote" n="18" target="#Hn_76-3.lnote.oe.18"/> sub uno seruitutis menbro constitui, quem ‘casum’<ptr type="liebermannNote" n="d" target="#Hn_76-3.lnote.oe.d"/> ponimus appellari<ptr type="liebermannNote" n="19" target="#Hn_76-3.lnote.oe.19"/>, ut ita<ptr type="liebermannNote" n="20" target="#Hn_76-3.lnote.oe.20"/> dictum sit: serui alii<ptr type="liebermannNote" n="d" target="#Hn_76-3.lnote.oe.d"/> casu, alii genitura.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 593 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 70, 8</seg><seg type="translation" xml:lang="en" source="#claude">as 70, 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Strafknechte</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">penal slaves</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Selbstergebung; vgl.</hi> 78, 2<hi rend="italic">c</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">self-surrender; cf.</hi> 78, 2<hi rend="italic">c</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">des Vaters</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">the father’s</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de">-to <hi rend="italic">Co Or Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-to <hi rend="italic">Co Or Edd.</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de">sua <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sua <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de">alii <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">alii <hi rend="italic">Co Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de">huius <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">huius Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de">-minis <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-minis <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de">ape. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">ape. <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de">d. s. ita <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. s. ita <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-3.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">327</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgt. Gl</hi> unfrei 4; Verknechtung 4 ff.—A. 1069 <hi rend="italic">per Northymbriam fames praevaluit, ut in servitutem perpetuam sese venderent</hi>; Sym. Dunelm. ed. Hinde 85—<hi rend="italic">et</hi>{13} fehlt—<hi rend="italic">sua</hi>{15}—76, 3a <hi rend="italic">pifh</hi>.{21} <hi rend="italic">a. sex</hi>.—76, 4a <hi rend="italic">h. est</hi>{28}—76, 4b <hi rend="italic">Eius</hi>{32}—76, 5 <hi rend="italic">d</hi>.{38} <hi rend="italic">halsfang</hi> ohne <hi rend="italic">hoc</hi>—<hi rend="italic">red</hi>.{39} bis <hi rend="italic">noctem</hi> überspr.—<hi rend="italic">primum</hi>{12} fehlt—76, 5a <hi rend="italic">intra</hi>—<hi rend="italic">instituent</hi>{43}—76, 6 <hi rend="italic">debet</hi>{48} fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> unfrei 4; Verknechtung 4 ff.—A. 1069 <hi rend="italic">per Northymbriam fames praevaluit, ut in servitutem perpetuam sese venderent</hi>; Sym. Dunelm. ed. Hinde 85—<hi rend="italic">et</hi>{13} missing—<hi rend="italic">sua</hi>{15}—76, 3a <hi rend="italic">pifh</hi>.{21} <hi rend="italic">a. sex</hi>.—76, 4a <hi rend="italic">h. est</hi>{28}—76, 4b <hi rend="italic">Eius</hi>{32}—76, 5 <hi rend="italic">d</hi>.{38} <hi rend="italic">halsfang</hi> without <hi rend="italic">hoc</hi>—<hi rend="italic">red</hi>.{39} to <hi rend="italic">noctem</hi> skipped—<hi rend="italic">primum</hi>{12} missing—76, 5a <hi rend="italic">intra</hi>—<hi rend="italic">instituent</hi>{43}—76, 6 <hi rend="italic">debet</hi>{48} missing Rs</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">Slaves are some by nature, others made so, and some by purchase and some by redemption, others slaves by their own or another's giving, and if there are any other kinds of this sort, all of which we nevertheless wish to be placed under one member of servitude, which we propose to call '<hi rend="italic">casus</hi>' (chance), so that it may be said thus: slaves are some by chance, others by birth.</ab>
      </div>
