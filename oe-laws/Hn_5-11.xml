      <div type="clause" n="5.11">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.11</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.11" corresp="#wit-lat"><pb n="549" ed="#liebermann"/>Et non<ptr type="liebermannNote" n="s" target="#Hn_5-11.lnote.oe.s"/> dampnetur presul nisi in<ptr type="liebermannNote" n="26" target="#Hn_5-11.lnote.oe.26"/> LXXII testibus.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 549 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-11.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">näher zu Ps.-Isidor als zu Angilram oder Ivo</hi> Pan. IV 91 (<hi rend="italic">ohne</hi> 5, 11. 11<hi rend="italic">a Ivo</hi> Decr. VI 334) <hi rend="italic">oder Gr.</hi> C. 2 q. 4 c. 2</seg><seg type="translation" xml:lang="en" source="#claude">closer to Ps.-Isidor than to Angilram or Ivo Pan. IV 91 (without 5, 11. 11a Ivo Decr. VI 334) or Gr. C. 2 q. 4 c. 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-11.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
      </div>
