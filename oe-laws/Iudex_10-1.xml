      <div type="clause" n="10.1">
        <head><ref type="lawCode" target="law:Iudex">Iudex</ref> 10.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="10.1" corresp="#wit-g-a"><pb n="475" ed="#liebermann"/>Forðan se æðela middangeardes lareow cwæð: ‘Na ða áne ðe yfel doþ, ac ælc þara þe hit ðam dondum geðafiað, beoð wyrþe ðas<ptr type="liebermannNote" n="1" target="#Iudex_10-1.lnote.oe.1"/> ecean deaðes’.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="10.1" corresp="#wit-q"><pb n="475" ed="#liebermann"/>quia dominus et magister<ptr type="liebermannNote" n="17" target="#Iudex_10-1.lnote.oe.17"/> seculorum ait: Non solum male agentes, sed omnes consentientes digni sunt ęterna morte.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="475" ed="#liebermann"/>Denn der edle Erdenlehrer [Paulus] sprach: ‘Nicht die allein, welche Übel thun, sondern jeder derer, die es den Thuenden<ptr type="liebermannNote" n="1" target="#Iudex_10-1.lnote.de.1"/> gestatten, ist des ewigen Todes würdig’.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">For the noble teacher of the world [Paul] said: ‘Not only those who do evil, but everyone who permits it to those who do it, is worthy of eternal death’.</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-g-a">For the noble [and] worldly teacher said: “Not only those who do evil, but also those who permit it are deserving of eternal death.”</ab>
        <note type="passageSource">Romans 1:32</note>
        <note type="comparison" source="#liebermann" n="475">Rom. 1, 32</note>
        <note type="comparisonPrinted" source="#liebermann">Rom. 1, 32</note>
        <note type="editorial">U: translator unrecorded: check</note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_10-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de">minister <hi rend="italic">MBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">minister <hi rend="italic">MBr</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_10-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
