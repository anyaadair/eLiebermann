      <div type="clause" n="21.1">
        <head><ref type="lawCode" target="law:IudDeiX">Iud Dei X</ref> 21.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei X 21.1" corresp="#wit-lat"><pb n="418" ed="#liebermann"/>et connectantur<ptr type="liebermannNote" n="31" target="#IudDeiX_21-1.lnote.oe.31"/> insimul manus reprehensi<ptr type="liebermannNote" n="32" target="#IudDeiX_21-1.lnote.oe.32"/> sub<ptr type="liebermannNote" n="e" target="#IudDeiX_21-1.lnote.oe.e"/> flexis poplitibus, ad modum hominis in campum<ptr type="liebermannNote" n="f" target="#IudDeiX_21-1.lnote.oe.f"/><ptr type="liebermannNote" n="33" target="#IudDeiX_21-1.lnote.oe.33"/> artum intrantis.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 418 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_21-1.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Hockend, die Hände <hi rend="spaced">über</hi> den zur Brust gezogenen Knieen gefesselt, sinkt der Prüfling an einer <hi rend="spaced">Kette</hi> auf Zeumer’s Tab.</hi> 3.</seg><seg type="translation" xml:lang="en" source="#claude">In Zeumer’s Tab. 3 the person undergoing the ordeal sinks on a <hi rend="italic">chain</hi>, crouching, with the hands bound <hi rend="italic">over</hi> the knees, which are drawn up to the chest.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_21-1.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de">champ estroit (clos); <hi rend="italic">Ducange</hi> Gloss. med. Lat. <hi rend="italic">ed. Favre</hi> II (1883) 69; <hi rend="italic">La Curne de St. Palaye</hi> Dict. anc. franç. III 202.</seg><seg type="translation" xml:lang="en" source="#claude">champ estroit (clos); Ducange Gloss. med. Lat. ed. Favre II (1883) 69; La Curne de St. Palaye Dict. anc. franç. III 202.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_21-1.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de">cone. <hi rend="italic">Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">cone. Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_21-1.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de">repressi <hi rend="italic">Al</hi></seg><seg type="translation" xml:lang="en" source="#claude">repressi Al</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_21-1.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de">a. c. <hi rend="italic">Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. c. Ma</seg></note>
