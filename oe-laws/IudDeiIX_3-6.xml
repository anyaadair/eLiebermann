      <div type="clause" n="3.6">
        <head><ref type="lawCode" target="law:IudDeiIX">Iud Dei IX</ref> 3.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IX 3.6" corresp="#wit-lat"><pb n="416" ed="#liebermann"/>ut, quicumque sacrilégii, fúrti, homicidii, adultérii quarúmque aliárum noxa<ptr type="liebermannNote" n="33" target="#IudDeiIX_3-6.lnote.oe.33"/> deprehensus (uel<ptr type="liebermannNote" n="2" target="#IudDeiIX_3-6.lnote.oe.2"/> -si) hoc ferrum<ptr type="liebermannNote" n="34" target="#IudDeiIX_3-6.lnote.oe.34"/> (uel<ptr type="liebermannNote" n="2" target="#IudDeiIX_3-6.lnote.oe.2"/> hęc ferramenta) igne calidatum<ptr type="liebermannNote" n="35" target="#IudDeiIX_3-6.lnote.oe.35"/> (uel<ptr type="liebermannNote" n="2" target="#IudDeiIX_3-6.lnote.oe.2"/> -dáta) tángere presúmpserit (uel<ptr type="liebermannNote" n="2" target="#IudDeiIX_3-6.lnote.oe.2"/> -rint), indignationis<ptr type="liebermannNote" n="36" target="#IudDeiIX_3-6.lnote.oe.36"/> tuę incendio in conspectu adstantium árdeat<ptr type="liebermannNote" n="37" target="#IudDeiIX_3-6.lnote.oe.37"/> (uel<ptr type="liebermannNote" n="2" target="#IudDeiIX_3-6.lnote.oe.2"/> -ant),</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 416 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_3-6.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">rund Eingeklammertes übergeschrieben Ch; fehlt Rj Vt Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">words in round brackets written above in Ch; missing in Rj Vt Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_3-6.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de">noxia <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">noxia Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_3-6.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_3-6.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de">call. <hi rend="italic">Ch;</hi> -to <hi rend="italic">Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">call. Ch; -to Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_3-6.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">statt</hi> ind.—credat <hi rend="italic">nur</hi> sciat <hi rend="italic">Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">instead of ind.—credat only sciat Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_3-6.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> arescant <hi rend="italic">V</hi> 1, 6</seg><seg type="translation" xml:lang="en" source="#claude">cf. arescant V 1, 6</seg></note>
      </div>
