    <body>
      <div type="clause" n="35.2">
        <head><ref type="lawCode" target="law:Af">Af</ref> 35.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35.2" corresp="#wit-e"><pb n="68" ed="#liebermann"/>Gif he hine on hengenne<ptr type="liebermannNote" n="29" target="#Af_35-2.lnote.oe.29"/> alecgge<ptr type="liebermannNote" n="30" target="#Af_35-2.lnote.oe.30"/>, mid XXX scill. gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35.2" corresp="#wit-h"><pb n="68" ed="#liebermann"/>Gif he hine on hengenne gebringe, mid XXX scillinga gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35.2" corresp="#wit-b-no-prol"><pb n="69" ed="#liebermann"/>Gyf he hine on hengene gebringe, mid ðrittig scill' gebete.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="35.2" corresp="#wit-q"><pb n="69" ed="#liebermann"/>Si eum in<ptr type="liebermannNote" n="11" target="#Af_35-2.lnote.oe.11"/> suspendio<ptr type="liebermannNote" n="12" target="#Af_35-2.lnote.oe.12"/> mittat, XXX sol. emendet.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="78" ed="#attenborough"/>Gif he hine on hengenne alecgge<ptr type="editorNote" n="16" target="#Af_35-2.attnote.fn.16"/>, mid XXX scill. gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="36.2" corresp="#wit-e"><pb n="328" ed="#jurasinski-and-oliver"/>Gif he hine on hengenne alecgge, mid XXX scill gebete.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="69" ed="#liebermann"/>Wenn er ihn ins Gefängniss<ptr type="liebermannNote" n="1" target="#Af_35-2.lnote.de.1"/> legt<ptr type="liebermannNote" n="2" target="#Af_35-2.lnote.de.2"/>, büsse er mit 30 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he puts him in prison, let him pay 30 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="79" ed="#attenborough"/>If he places him in the stocks<ptr type="editorNote" n="1" target="#Af_35-2.attnote.n.1"/>, he shall pay 30 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="414" ed="#whitelock"/>If he places him in the stocks,<ptr type="editorNote" n="1" target="#Af_35-2.whinote.n.1"/> he is to pay him 30 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="329" ed="#jurasinski-and-oliver"/>If he puts him in confinement, let him pay with 30 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-2.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">hengene <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hengene So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-2.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">alecge <hi rend="italic">So;</hi> <hi rend="spaced">gebringe</hi>, mid ðrittig <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">alecge So; <hi rend="italic">gebringe</hi>, mid ðrittig Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de">-nso <hi rend="italic">Brti;</hi> suspenderit <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nso Brti; suspenderit Or</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_35-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Gefängnis 1b—3. Q missversteht (aus Etymologie oder durch falsche Wahl der Bedeutung), wie auch II Cn 35 Cons., ‘Galgen’; <hi rend="italic">s. Wb: suspendium.</hi> Auch gutgläubige Freiheitsberaubung an Verdächtigem, der nachher nicht schuldig erwiesen wird, kostet Busse; Brunner II 675</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Gefängnis 1b—3. Q misunderstands it (from etymology or by a wrong choice of meaning) as ‘gallows’, as does II Cn 35 Cons.; <hi rend="italic">see Wb: suspendium.</hi> Even deprivation of liberty in good faith of a suspect who is afterwards not proved guilty costs compensation; Brunner II 675</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_35-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘bringt’ hb (Q?)</seg><seg type="translation" xml:lang="en" source="#claude">‘brings’ hb (Q?)</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_35-2.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">78</biblScope></bibl><label>alecgge</label><seg type="original" xml:lang="en"><hi rend="italic">gebringe</hi>. B, H.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_35-2.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">197</biblScope></bibl><seg type="original" xml:lang="en">For <hi rend="italic">hengenne</hi> see B. and T. <hi rend="italic">s.v.</hi>, and Liebermann, <hi rend="italic">Glossar</hi>, <hi rend="italic">s.v.</hi> gefongniss. The translation ‘stocks’ is due to Schmid.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Af_35-2.whinote.n.1" n="1" source="#whitelock"><bibl><biblScope unit="page">414</biblScope></bibl><label>stocks</label><seg type="original" xml:lang="en"><hi rend="italic">hengen;</hi> perhaps it should be rendered “prison”</seg></note>
      </div>
    </body>
