    <body>
      <div type="clause" n="12d">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 12d</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 12d"><pb n="638" ed="#liebermann"/>alia quam habent aque<ptr type="liebermannNote" n="4" target="#ECf_12d.lnote.la.4"/>, quarum nauigio<ptr type="liebermannNote" n="a" target="#ECf_12d.lnote.la.fn.a"/> de<ptr type="liebermannNote" n="5" target="#ECf_12d.lnote.la.5"/> diuersis partibus deferuntur<ptr type="liebermannNote" n="6" target="#ECf_12d.lnote.la.6"/> uictualia ciuitatibus uel<ptr type="liebermannNote" n="7" target="#ECf_12d.lnote.la.7"/> burgis.</ab>
        <note type="comparison" source="#liebermann" n="638"><label>printed alongside</label> <ref target="clause:ECfRetr_12d">ECf retr 12d</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 638 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12d.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur Hauptströme laut Retr. und u.</hi> 12, 1; 8</seg><seg type="translation" xml:lang="en" source="#claude">only the main rivers, according to the Retr. and below, 12, 1; 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12d.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">aquarum nauigia, que de <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">aquarum nauigia, que de Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12d.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12d.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">-runt <hi rend="italic">S Ad;</hi> afferunt <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-runt S Ad; afferunt Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12d.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Hr S Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Hr S Ad Do</seg></note>
