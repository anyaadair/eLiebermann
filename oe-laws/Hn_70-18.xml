      <div type="clause" n="70.18">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 70.18</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 70.18" corresp="#wit-lat"><pb n="589" ed="#liebermann"/>Si<ptr type="liebermannNote" n="q" target="#Hn_70-18.lnote.oe.q"/> quis pater mortuus fuerit et filium uel filiam hereditandam<ptr type="liebermannNote" n="20" target="#Hn_70-18.lnote.oe.20"/> reliquerit, usque ad XV etatis annos nec causam prosequantur nec iudicium subeant; set sub tutoribus et actoribus<ptr type="liebermannNote" n="21" target="#Hn_70-18.lnote.oe.21"/> sint in parentum legittima custodia<ptr type="liebermannNote" n="r" target="#Hn_70-18.lnote.oe.r"/> saisiti<ptr type="liebermannNote" n="22" target="#Hn_70-18.lnote.oe.22"/>, sicut<ptr type="liebermannNote" n="s" target="#Hn_70-18.lnote.oe.s"/> pater eorum fuit<ptr type="liebermannNote" n="23" target="#Hn_70-18.lnote.oe.23"/> in die<ptr type="liebermannNote" n="24" target="#Hn_70-18.lnote.oe.24"/> mortis et uite sue.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 589 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-18.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie o.</hi> 59, 9</seg><seg type="translation" xml:lang="en" source="#claude">as above 59, 9</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-18.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Glanvilla</hi> 13, 15, 3 <hi rend="italic">f.</hi>: seisina minori remanebit donec plenam habuerit etatem; de nullo placito tenetur respondere per quod possit exheredari.</seg><seg type="translation" xml:lang="en" source="#claude">cf. Glanvilla 13, 15, 3 f.: seisina minori remanebit donec plenam habuerit etatem; de nullo placito tenetur respondere per quod possit exheredari.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-18.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> III Atr. 14; II Cn. 72, <hi rend="italic">woraus</hi> Hn 14, 5. <hi rend="italic">Vgl.</hi> Lib. Lond. 7</seg><seg type="translation" xml:lang="en" source="#claude">cf. III Atr. 14; II Cn. 72, whence Hn 14, 5. Cf. Lib. Lond. 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-18.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">herit. <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">herit. Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-18.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">auct. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">auct. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-18.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">seis. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">seis. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-18.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">fuerit <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">fuerit K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-18.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">diebus <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">diebus Lond</seg></note>
