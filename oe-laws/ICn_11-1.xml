  <text>
    <body>
      <div type="clause" n="11.1">
        <head><ref type="lawCode" target="law:ICn">I Cn</ref> 11.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11.1" corresp="#wit-g-a"><pb n="294" ed="#liebermann"/>And<ptr type="liebermannNote" n="*" target="#ICn_11-1.lnote.oe.star"/> gyf<ptr type="liebermannNote" n="1" target="#ICn_11-1.lnote.oe.1"/> hwa cyricean hæbbe, þe legerstow on ne sig<ptr type="liebermannNote" n="6" target="#ICn_11-1.lnote.oe.6"/>, do he of ða<hi rend="italic">m</hi> nigon dælum his preoste þ<hi rend="italic">æt</hi> þ<hi rend="italic">æt</hi> he wylle.<ptr type="liebermannNote" n="7" target="#ICn_11-1.lnote.oe.7"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11.1" corresp="#wit-a"><pb n="294" ed="#liebermann"/>Gif hwa cyricean hæbbe, þe legerstow on ne sy, do he of þam nigon dalum his preoste þ<hi rend="italic">æt</hi> þ<hi rend="italic">æt</hi> he wille.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="11.1" corresp="#wit-q"><pb n="294" ed="#liebermann"/>Si quis ęcclesiam<ptr type="liebermannNote" n="3" target="#ICn_11-1.lnote.oe.3"/> habeat, ubi positionis<ptr type="liebermannNote" n="4" target="#ICn_11-1.lnote.oe.4"/> locus non sit, det ex suis nouem partibus presbitero suo quod uelit.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="11.1" corresp="#wit-inst-cn"><pb n="295" ed="#liebermann"/>Quodsi alius habet<ptr type="liebermannNote" n="8" target="#ICn_11-1.lnote.oe.8"/> ęcclesiam, quę cimiterium non habeat<ptr type="liebermannNote" n="9" target="#ICn_11-1.lnote.oe.9"/>, de nouem partibus bonorum suorum det ęcclesię suę . . . .<ptr type="liebermannNote" n="10" target="#ICn_11-1.lnote.oe.10"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="11.1" corresp="#wit-cons-cn"><pb n="295" ed="#liebermann"/>Si uero cimiterium desit, de nona parte det presbitero quantum sibi libuerit.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="11.1" corresp="#wit-g-a"><pb n="164" ed="#robertson"/>And<ptr type="editorNote" n="8" target="#ICn_11-1.robnote.fn.8"/> gyf hwa cyricean hæbbe þe legerstow on ne sig, do he of ðam nigon dælum his preoste þæt þæt he wylle.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="244" ed="#rabin-doml"/>And gyf hwa cyricean hæbbe, þe legerstow on ne sig, do he of ðam nigon dælum his preoste þæt þæt he wylle.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="295" ed="#liebermann"/>(Und <hi rend="italic">G</hi>) Wenn jemand eine [Landguts]kirche hat, an der kein Friedhof ist, entrichte er aus den neun [ihm übrigen] Zehnteln seinem Priester, was er will.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">(And, G) if anyone has an [estate-]church at which there is no graveyard, let him give his priest what he will from the nine [remaining] parts.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-g-a"><pb n="165" ed="#robertson"/>If anyone has a church to which no graveyard is attached, he shall give his priest whatever he desires from the nine [remaining] parts.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="245" ed="#rabin-doml"/>If anyone has a church without a graveyard, then let him give what he chooses to his priest out of the next one-tenth share after that paid as tithe.</ab>
        <note type="comparison" source="#liebermann" n="295"><ref target="clause:IIEg_2-1">II Eg 2.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 2, 1</note>
        <note type="editorial">G's ‘And’ is missing from the other MSS and Edgar. Liebermann compares II Eg 2.1.; BR: added from Gesetze I p. 295, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">And: omitted A</note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_11-1.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">294</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt übrigen Hss. und Eg.</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in the other MSS and Eg.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_11-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">294</biblScope></bibl><seg type="original" xml:lang="de">Gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_11-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">294</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_11-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">294</biblScope></bibl><seg type="original" xml:lang="de">wille <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wille Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_11-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">294</biblScope></bibl><seg type="original" xml:lang="de">h. e. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. e. R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_11-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">294</biblScope></bibl><seg type="original" xml:lang="de">potit. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">potit. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_11-1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">295</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> nouem partibus</seg><seg type="translation" xml:lang="en" source="#claude">read nouem partibus</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_11-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">295</biblScope></bibl><seg type="original" xml:lang="de">habeat <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">habeat T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_11-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">295</biblScope></bibl><seg type="original" xml:lang="de">habet <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">habet T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_11-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">295</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt II Eg.</hi> 1, 1 <hi rend="italic">oben S.</hi> 197</seg><seg type="translation" xml:lang="en" source="#claude">followed by II Eg. 1, 1 above p. 197</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="ICn_11-1.robnote.fn.8" n="8" source="#robertson"><bibl><biblScope unit="page">164</biblScope></bibl><label>And</label><seg type="original" xml:lang="en">Om. A, Ld.</seg></note>
      </div>
    </body>
