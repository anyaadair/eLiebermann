      <div type="clause" n="80.6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 80.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 80.6" corresp="#wit-lat"><pb n="596" ed="#liebermann"/>In cuiuscumque terra fiat homicidium, qui socnam<ptr type="liebermannNote" n="31" target="#Hn_80-6.lnote.oe.31"/> et sacam<ptr type="liebermannNote" n="32" target="#Hn_80-6.lnote.oe.32"/> suam habeat, si homicida diuadietur ibi uel crauetur<ptr type="liebermannNote" n="33" target="#Hn_80-6.lnote.oe.33"/>, fihtþitam<ptr type="liebermannNote" n="34" target="#Hn_80-6.lnote.oe.34"/> recipiat<ptr type="liebermannNote" n="l" target="#Hn_80-6.lnote.oe.l"/><ptr type="liebermannNote" n="35" target="#Hn_80-6.lnote.oe.35"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 596 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-6.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">der Gerichtsherr des Thatorts; vgl.</hi> 23, 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">the lord with jurisdiction over the scene of the crime; cf.</hi> 23, 1</seg></note>
