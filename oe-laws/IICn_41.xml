        <note type="liebermannNote" subtype="textual" xml:id="IICn_41.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">341</biblScope></bibl><seg type="original" xml:lang="de">ultra <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">ultra Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_41.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">341</biblScope></bibl><seg type="original" xml:lang="de">‘<hi rend="italic">sich verwirrt</hi>’</seg><seg type="translation" xml:lang="en" source="#claude">‘becomes entangled’</seg></note>
