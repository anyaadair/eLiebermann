    <body>
      <div type="clause" n="11">
        <head>Ine Rb 11</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11" corresp="#wit-e"><pb n="20" ed="#liebermann"/>LV. Be ðam<ptr type="liebermannNote" n="11" target="#Rubrics-Ine_11.lnote.oe.11"/> monnu<hi rend="italic">m</hi> þe hiora gelondan bebycggað.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11" corresp="#wit-g-prol"><pb n="20" ed="#liebermann"/>LV. Be þan mannu<hi rend="italic">m</hi> þe hira gelandan bebicgað.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11" corresp="#wit-h"><pb n="21" ed="#liebermann"/>LV. Be þam mannum þe heora<ptr type="liebermannNote" n="8" target="#Rubrics-Ine_11.lnote.oe.8"/> gelandan<ptr type="liebermannNote" n="9" target="#Rubrics-Ine_11.lnote.oe.9"/> bebicgað.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="11" corresp="#wit-q"><pb n="21" ed="#liebermann"/>De illis qui compatriotas suos emunt.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="202" ed="#jurasinski-and-oliver"/>LV Be ðam monnu<hi rend="italic">m</hi> þe hiora gelondan bebycggað</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="202" ed="#jurasinski-and-oliver"/>Be landbygene</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="21" ed="#liebermann"/>Von den Menschen, die ihre Landsleute<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_11.lnote.de.1"/> verkaufen.<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_11.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of people who sell their countrymen.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="203" ed="#jurasinski-and-oliver"/>Concerning those who sell their countrymen</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="203" ed="#jurasinski-and-oliver"/>Concerning selling land</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_11.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">20</biblScope></bibl><seg type="original" xml:lang="de">leodbygene <hi rend="italic">statt</hi> ðam — bebycggað <hi rend="italic">Ld</hi> [<hi rend="italic">aus B?</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">leodbygene instead of ðam — bebycggað Ld [from B?]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_11.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_11.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. aus</hi> land.</seg><seg type="translation" xml:lang="en" source="#claude">altered from land.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_11.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Oder ‘ihren Landsmann’. Ohne Grund denkt Price an eine von <hi rend="italic">geleod</hi> des Textes verschiedene Bedeutung. Das Wort wird glossiert <hi rend="italic">fratrueles, paternitates</hi>; ahd. heisst <hi rend="italic">galanto</hi> : <hi rend="italic">pagensis</hi>, <hi rend="italic">gilante</hi> : <hi rend="italic">patriota</hi>. ‘Vaterland’ heisst <hi rend="italic">land</hi> in den Compositis <hi rend="italic">landbegenga</hi>, <hi rend="italic">-buend</hi>, <hi rend="italic">-leode</hi>, <hi rend="italic">-man</hi>, <hi rend="italic">-sidu</hi></seg><seg type="translation" xml:lang="en" source="#claude">Or ‘their fellow-countryman’. Price has no grounds for thinking of a meaning different from that of <hi rend="italic">geleod</hi> in the text. The word is glossed <hi rend="italic">fratrueles, paternitates</hi>; in OHG <hi rend="italic">galanto</hi> : <hi rend="italic">pagensis</hi>, <hi rend="italic">gilante</hi> : <hi rend="italic">patriota</hi>. <hi rend="italic">land</hi> means ‘native country’ in the compounds <hi rend="italic">landbegenga</hi>, <hi rend="italic">-buend</hi>, <hi rend="italic">-leode</hi>, <hi rend="italic">-man</hi>, <hi rend="italic">-sidu</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_11.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">An <hi rend="italic">bycgean</hi> denkt Q</seg><seg type="translation" xml:lang="en" source="#claude">Q is thinking of <hi rend="italic">bycgean</hi></seg></note>
      </div>
    </body>
  </text>
