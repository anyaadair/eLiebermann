    <body>
      <div type="clause" n="2.2">
        <head><ref type="lawCode" target="law:IVAtr">IV Atr</ref> 2.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2.2" corresp="#wit-q"><pb n="232" ed="#liebermann"/>De naui plena lignorum unum lignum ad tol'.<ptr type="liebermannNote" n="14" target="#IVAtr_2-2.lnote.oe.14"/></ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="2.2" corresp="#wit-q"><pb n="70" ed="#robertson"/>De navi plena lignorum—unum lignum ad tol'<ptr type="editorNote" n="16" target="#IVAtr_2-2.robnote.fn.16"/>.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="233" ed="#liebermann"/>Von einem Schiff voll Hölzern ein Brett als Zoll.<ptr type="liebermannNote" n="1" target="#IVAtr_2-2.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">From a ship full of timber, one plank as toll.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q"><pb n="71" ed="#robertson"/>From a ship with a cargo of planks, one plank is given as toll.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_2-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">232</biblScope></bibl><seg type="original" xml:lang="de">telon. <hi rend="italic">T;</hi> tel' <hi rend="italic">MHk;</hi> detur <hi rend="italic">fügt zu Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">telon. T; tel' MHk; detur added by Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_2-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">163</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Wo Q eigenes Latein setzt, sagt er <hi rend="italic">teloneum</hi></seg><seg type="translation" xml:lang="en" source="#claude">Where Q uses his own Latin, he says <hi rend="italic">teloneum</hi></seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_2-2.robnote.fn.16" n="16" source="#robertson"><bibl><biblScope unit="page">70</biblScope></bibl><label>tol'</label><seg type="original" xml:lang="en"><hi rend="italic">a. t. detur</hi> Br.</seg></note>
      </div>
    </body>
