      <div type="clause" n="70.1">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 70.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="70.1" corresp="#wit-e"><pb n="118" ed="#liebermann"/>Æt X<ptr type="liebermannNote" n="38" target="#Ine_70-1.lnote.oe.38"/> hidu<hi rend="italic">m<ptr type="liebermannNote" n="39" target="#Ine_70-1.lnote.oe.39"/></hi> to fostre X<ptr type="liebermannNote" n="38" target="#Ine_70-1.lnote.oe.38"/> fata hunies<ptr type="liebermannNote" n="40" target="#Ine_70-1.lnote.oe.40"/>, CCC<ptr type="liebermannNote" n="41" target="#Ine_70-1.lnote.oe.41"/> hlafa, XII<ptr type="liebermannNote" n="42" target="#Ine_70-1.lnote.oe.42"/> ambra Wilisc<ptr type="liebermannNote" n="43" target="#Ine_70-1.lnote.oe.43"/> ealað, XXX<ptr type="liebermannNote" n="44" target="#Ine_70-1.lnote.oe.44"/> hluttres, tu<ptr type="liebermannNote" n="45" target="#Ine_70-1.lnote.oe.45"/> eald hriðeru oððe X<ptr type="liebermannNote" n="38" target="#Ine_70-1.lnote.oe.38"/> weðeras<ptr type="liebermannNote" n="46" target="#Ine_70-1.lnote.oe.46"/>, X gees, XX henna, X<ptr type="liebermannNote" n="38" target="#Ine_70-1.lnote.oe.38"/> cesas<ptr type="liebermannNote" n="1" target="#Ine_70-1.lnote.oe.1-3"/>, amber fulne buteran, V<ptr type="liebermannNote" n="2" target="#Ine_70-1.lnote.oe.2-2"/> leaxas, XX<ptr type="liebermannNote" n="3" target="#Ine_70-1.lnote.oe.3-2"/> pundwæga<ptr type="liebermannNote" n="4" target="#Ine_70-1.lnote.oe.4"/> foðres ⁊ hundteontig<ptr type="liebermannNote" n="5" target="#Ine_70-1.lnote.oe.5"/> æla.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="70.1" corresp="#wit-ot-frags"><pb n="118" ed="#liebermann"/>Æt ... fostre ..., XII amb... Wilisces e..., eald hriþeru oþþe X weð .... na, X cesas, amber fuln.., XX pundwæga fodres ⁊ hu ...</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="70.1" corresp="#wit-h"><pb n="118" ed="#liebermann"/>Æt X hidum to fostre X fata huniges, CCC hlafa<ptr type="liebermannNote" n="9" target="#Ine_70-1.lnote.oe.9"/>, XII ambres<ptr type="liebermannNote" n="10" target="#Ine_70-1.lnote.oe.10"/> Wilisc<ptr type="liebermannNote" n="11" target="#Ine_70-1.lnote.oe.11"/> ealoð, XXX hlutres<ptr type="liebermannNote" n="12" target="#Ine_70-1.lnote.oe.12"/>, II eald<ptr type="liebermannNote" n="13" target="#Ine_70-1.lnote.oe.13"/> hryþeru<ptr type="liebermannNote" n="14" target="#Ine_70-1.lnote.oe.14"/> oððe X weþeras, X gés (⁊<ptr type="liebermannNote" n="15" target="#Ine_70-1.lnote.oe.15"/>) XX henna, X cysas<ptr type="liebermannNote" n="7" target="#Ine_70-1.lnote.oe.7"/>, amber fulne butran<ptr type="liebermannNote" n="1" target="#Ine_70-1.lnote.oe.1-2"/>, V leaxas ⁊ XX (pund)wæga<ptr type="liebermannNote" n="2" target="#Ine_70-1.lnote.oe.2"/> fodres ⁊ C æla.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="70.1" corresp="#wit-b-no-prol"><pb n="119" ed="#liebermann"/>Æt tyn hidu<hi rend="italic">m</hi> to fostre tyn fata hunies, ðreo hund hláfa, twelf ambra Wylisces ealoð, ðrittig hlutres, twa ealda ryðeru oððe tyn weðeras, [⁊<ptr type="liebermannNote" n="3" target="#Ine_70-1.lnote.oe.3"/> tyn gees ⁊ twenti henna ⁊ tyn cysas], amber fulne buteran, fif leaxas, twentig pundwega fodres ⁊ hundteontig ǽla.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="70.1" corresp="#wit-q"><pb n="119" ed="#liebermann"/>De X hidis<ptr type="liebermannNote" n="26" target="#Ine_70-1.lnote.oe.26"/> ad<ptr type="liebermannNote" n="27" target="#Ine_70-1.lnote.oe.27"/> corredium debent reddi<ptr type="liebermannNote" n="28" target="#Ine_70-1.lnote.oe.28"/> decem dolia mellis, CCC panes, duodecim ambre<ptr type="liebermannNote" n="29" target="#Ine_70-1.lnote.oe.29"/> ceruisie Wylisce<ptr type="liebermannNote" n="30" target="#Ine_70-1.lnote.oe.30"/>, XXX hluttres<ptr type="liebermannNote" n="31" target="#Ine_70-1.lnote.oe.31"/>, duo ueteres<ptr type="liebermannNote" n="32" target="#Ine_70-1.lnote.oe.32"/> boues uel decem arietes, galline uiginti, casei decem<ptr type="liebermannNote" n="1" target="#Ine_70-1.lnote.oe.1"/>, plena ambra butiri, salmones quinque, uiginti pondia fodri et centum anguille.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="58" ed="#attenborough"/>Æt X hidum to fostre X fata hunies, CCC hlafa, XII ambra Wilisc ealað, XXX hluttres, tu eald hriðeru<ptr type="editorNote" n="10" target="#Ine_70-1.attnote.fn.10"/> oððe X weðeras, <ptr type="editorNote" n="11" target="#Ine_70-1.attnote.fn.11"/>X gees, <ptr type="editorNote" n="12" target="#Ine_70-1.attnote.fn.12"/>XX henna, <ptr type="editorNote" n="11" target="#Ine_70-1.attnote.fn.11-2"/>X cesas, amber fulne buteran, V leaxas, XX pundwæga foðres ⁊ hundteontig æla.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="72" corresp="#wit-e"><pb n="430" ed="#jurasinski-and-oliver"/>Æt X hidu<hi rend="italic">m</hi> to fostre X fata hunies, CCC hlafa, XII ambra wilesc ealað, XXX hluttres, tu eald hriðeru oððe X weðeras, X gees, XX henna, X cesas, amber fulne buteran, V leaxas, XX pundwæga foðres ⁊ hundteonig æla.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="119" ed="#liebermann"/>Von 10 Hiden [zahle<ptr type="liebermannNote" n="1" target="#Ine_70-1.lnote.de.1"/> der Beliehene dem Grundherrn] zum Unterhalt [als Jahreszins<ptr type="liebermannNote" n="2" target="#Ine_70-1.lnote.de.2"/>] 10 Fässer<ptr type="liebermannNote" n="3" target="#Ine_70-1.lnote.de.3"/> Honig, 300 Brote, 12 Eimer<ptr type="liebermannNote" n="4" target="#Ine_70-1.lnote.de.4"/> Wälschen Bieres, 30 hellen [Bieres], 2 ausgewachsene<ptr type="liebermannNote" n="5" target="#Ine_70-1.lnote.de.5"/> Rinder oder 10 Widder, 10 Gänse, 20 Hennen, 10 Käse, einen Eimer<ptr type="liebermannNote" n="6" target="#Ine_70-1.lnote.de.6"/> voll Butter, 5 Lachse, 20 Wispel<ptr type="liebermannNote" n="7" target="#Ine_70-1.lnote.de.7"/> Futter und 100 Aale.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">From 10 hides [let the tenant pay the landlord] for provision [as yearly rent] 10 vats of honey, 300 loaves, 12 ambers of Welsh ale, 30 of clear [ale], 2 full-grown cattle or 10 wethers, 10 geese, 20 hens, 10 cheeses, an amber full of butter, 5 salmon, 20 weys of fodder and 100 eels.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="59" ed="#attenborough"/>10 vats of honey, 300 loaves, 12 ambers<ptr type="editorNote" n="1" target="#Ine_70-1.attnote.n.1"/> of Welsh ale, 30 ambers of clear ale, 2 full-grown cows or 10 wethers, 10 geese, 20 hens, 10 cheeses, a full amber of butter, 5 salmon, 20 pounds of fodder, and 100 eels shall be paid as food rent<ptr type="editorNote" n="2" target="#Ine_70-1.attnote.n.2"/> from every 10 hides.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="407" ed="#whitelock"/>As a food-rent from 10 hides: 10 vats of honey, 300 loaves, 12 “ambers” of Welsh ale, 30 of clear ale, 2 full-grown cows, or 10 wethers, 10 geese, 20 hens, 10 cheeses, an “amber” full of butter, 5 salmon, 20 pounds<ptr type="editorNote" n="4" target="#Ine_70-1.whinote.n.4"/> of fodder and 100 eels.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="431" ed="#jurasinski-and-oliver"/>For 10 hides, food render [to the lord] should be 10 vats of honey, 300 loaves, 12 pails of Welsh ale, 30 of clear ale, two full-grown cows or 10 wethers, 10 geese, 20 hens, 10 cheeses, a full pail of butter, 5 salmon, 20 pound-weights of fodder and 100 eels.</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="431"><label>see</label> <ref target="clause:Abt_12">Abt 12</ref> <quote>See Æthelberht §17 [L12]</quote></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="291"><ref target="clause:Af_2">Af 2</ref></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="409"><ref target="clause:Ine_44-1">Ine 44.1</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_70-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">119</biblScope></bibl><seg type="original" xml:lang="de">⁊ — cysas <hi rend="italic">im</hi> 16. <hi rend="italic">Jh. am Rande</hi></seg><seg type="translation" xml:lang="en" source="#claude">⁊ — cysas in the margin in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_70-1.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">119</biblScope></bibl><seg type="original" xml:lang="de">hindi <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">hindi Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_70-1.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">119</biblScope></bibl><seg type="original" xml:lang="de">de. ad co. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">de. ad co. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_70-1.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">119</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_70-1.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">119</biblScope></bibl><seg type="original" xml:lang="de">manbre <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">manbre K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_70-1.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">119</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> Wal. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Lond; Wal. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_70-1.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">119</biblScope></bibl><seg type="original" xml:lang="de">blut. <hi rend="italic">Or;</hi> blint <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">blut. Or; blint K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_70-1.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">119</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Co Or; fehlt übrigen</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Co Or; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_70-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">121</biblScope></bibl><seg type="original" xml:lang="de">XV <hi rend="italic">T; fehlt MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">XV T; lacking in MHkBr</seg></note>
