        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 75.6" corresp="#wit-lat"><pb n="592" ed="#liebermann"/>Si Francigena<ptr type="liebermannNote" n="l" target="#Hn_75-6.lnote.oe.l"/> qui parentes non habeat in murdro perimatur, habeat precium<ptr type="liebermannNote" n="20" target="#Hn_75-6.lnote.oe.20"/> natalis<ptr type="liebermannNote" n="m" target="#Hn_75-6.lnote.oe.m"/> eius qui<ptr type="liebermannNote" n="4" target="#Hn_75-6.lnote.oe.4"/> murdrum<ptr type="liebermannNote" n="21" target="#Hn_75-6.lnote.oe.21"/> abarnauerit<ptr type="liebermannNote" n="22" target="#Hn_75-6.lnote.oe.22"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 592 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-6.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 91, 1<hi rend="italic">a.</hi> 92, 6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">as in</hi> 91, 1<hi rend="italic">a.</hi> 92, 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-6.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de">VI marce <hi rend="italic">laut</hi> 13, 2. 91, 1 [<hi rend="italic">d. i.</hi> 4 <hi rend="italic">Pfund, also wie Engl.</hi> ceorl (villanus) <hi rend="italic">laut</hi> 70, 1. 76, 4; 6<hi rend="italic">a</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">VI marce <hi rend="italic">according to</hi> 13, 2. 91, 1 [<hi rend="italic">i.e.</hi> 4 <hi rend="italic">pounds, thus as for the English</hi> ceorl (villanus) <hi rend="italic">according to</hi> 70, 1. 76, 4; 6<hi rend="italic">a</hi>]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-6.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
