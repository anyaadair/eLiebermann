    <body>
      <div type="clause" n="2.5">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 2.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 2.5"><pb n="628" ed="#liebermann"/>Item uigiliis sancte Marie, sancti<ptr type="liebermannNote" n="22" target="#ECfRetr_2-5.lnote.la.22"/> Michaelis, sancti<ptr type="liebermannNote" n="22" target="#ECfRetr_2-5.lnote.la.22"/> Iohannis baptiste, Omnium<ptr type="liebermannNote" n="23" target="#ECfRetr_2-5.lnote.la.23"/> apostolorum et sanctorum, quorum <hi rend="bold">solemnitates</hi> a sacerdotibus dominicis diebus<ptr type="liebermannNote" n="24" target="#ECfRetr_2-5.lnote.la.24"/> annunciantur, et Omnium sanctorum in kalendis Nouembris, semper<ptr type="liebermannNote" n="25" target="#ECfRetr_2-5.lnote.la.25"/> ab hora nona uigiliarum et<ptr type="liebermannNote" n="26" target="#ECfRetr_2-5.lnote.la.26"/> sequentem<ptr type="liebermannNote" n="27" target="#ECfRetr_2-5.lnote.la.27"/> <hi rend="bold">solennitatem</hi><ptr type="liebermannNote" n="28" target="#ECfRetr_2-5.lnote.la.28"/>.</ab>
        <note type="comparison" source="#liebermann" n="628"><label>printed alongside</label> <ref target="clause:ECf_2-5">ECf 2.5</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 628 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-5.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-5.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">a. o. <hi rend="italic">Sp;</hi> sanctorum <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. o. Sp; Hv adds sanctorum</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-5.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">a. d. <hi rend="italic">Cb Hv Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. d. Cb Hv Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-5.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">similiter <hi rend="italic">Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">similiter Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-5.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">ad <hi rend="italic">Va;</hi> in <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad Va; in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-5.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">-te <hi rend="italic">Cb;</hi> subseq. <hi rend="italic">Hv Lond Cc;</hi> subsequente <hi rend="italic">Sp;</hi> subsequentium <hi rend="italic">Lb Ph Co Kn L</hi></seg><seg type="translation" xml:lang="en" source="#claude">-te Cb; subseq. Hv Lond Cc; subsequente Sp; subsequentium Lb Ph Co Kn L</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-5.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">-te <hi rend="italic">Cb Sp;</hi> -tum <hi rend="italic">Lb Kn L</hi></seg><seg type="translation" xml:lang="en" source="#claude">-te Cb Sp; -tum Lb Kn L</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Likewise on the vigils of St Mary, St Michael, St John the Baptist, of all the apostles and of the saints whose solemnities are announced by the priests on Sundays, and of All Saints on the kalends of November, always from the ninth hour of the vigils and the following solemnity.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_2-5.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">343</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">subsequentium</hi><hi rend="superscript">27</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">subsequentium</hi><hi rend="superscript">27</hi> Rs</seg></note>
      </div>
    </body>
  </text>
