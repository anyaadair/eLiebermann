      <div type="clause" n="3.6">
        <head><ref type="lawCode" target="law:IudDeiII">Iud Dei II</ref> 3.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei II 3.6" corresp="#wit-lat"><pb n="407" ed="#liebermann"/>et si ille<ptr type="liebermannNote" n="11" target="#IudDeiII_3-6.lnote.oe.11"/> nocens uel culpabilis<ptr type="liebermannNote" n="12" target="#IudDeiII_3-6.lnote.oe.12"/> sit et per aliquod maleficium uel per herbas aut<ptr type="liebermannNote" n="13" target="#IudDeiII_3-6.lnote.oe.13"/> per causas diabolicas<ptr type="liebermannNote" n="14" target="#IudDeiII_3-6.lnote.oe.14"/> indurauerit<ptr type="liebermannNote" n="15" target="#IudDeiII_3-6.lnote.oe.15"/> et peccatum, quod fecit<ptr type="liebermannNote" n="16" target="#IudDeiII_3-6.lnote.oe.16"/>, confiteri noluerit, tua dextera<ptr type="liebermannNote" n="17" target="#IudDeiII_3-6.lnote.oe.17"/>, quesumus Domine, hoc declarare dignetur. Per dominum<ptr type="liebermannNote" n="18" target="#IudDeiII_3-6.lnote.oe.18"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 407 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-6.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-i -tes <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-i -tes written above in H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-6.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-es -nt <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-es -nt written above in H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-6.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-6.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> cor suum <hi rend="italic">aus unten</hi> X 19, 6</seg><seg type="translation" xml:lang="en" source="#claude">supply cor suum from below X 19, 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-6.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-nt <hi rend="italic">übergeschr. H;</hi> -ratus fuerit <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nt written above in H; -ratus fuerit Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-6.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-erunt <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-erunt written above in H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-6.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">Do. q., de. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Do. q., de. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-6.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Rj H Tr;</hi> eundem <hi rend="italic">Ci;</hi> nostrum <hi rend="italic">fügt zu Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Rj H Tr; eundem Ci; nostrum added in Co</seg></note>
      </div>
