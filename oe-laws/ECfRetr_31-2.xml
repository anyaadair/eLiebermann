    <body>
      <div type="clause" n="31.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 31.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 31.2"><pb n="654" ed="#liebermann"/>In quibusdam uero prouinciis Anglice<ptr type="liebermannNote" n="1" target="#ECfRetr_31-2.lnote.la.1"/> uocabatur <ptr type="liebermannNote" n="a" target="#ECfRetr_31-2.lnote.la.fn.a"/>leð<ptr type="liebermannNote" n="2" target="#ECfRetr_31-2.lnote.la.2"/>, quod isti<ptr type="liebermannNote" n="3" target="#ECfRetr_31-2.lnote.la.3"/> dicunt þrihinge<ptr type="liebermannNote" n="4" target="#ECfRetr_31-2.lnote.la.4"/>. Quodque<ptr type="liebermannNote" n="5" target="#ECfRetr_31-2.lnote.la.5"/> in þrehingis<ptr type="liebermannNote" n="6" target="#ECfRetr_31-2.lnote.la.6"/> diffiniri<ptr type="liebermannNote" n="7" target="#ECfRetr_31-2.lnote.la.7"/> non poterat, <hi rend="bold">ferebatur</hi> in sciram<ptr type="liebermannNote" n="8" target="#ECfRetr_31-2.lnote.la.8"/>.</ab>
        <note type="comparison" source="#liebermann" n="654"><label>printed alongside</label> <ref target="clause:ECf_31-2">ECf 31.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 654 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">Liebermann prints the first sentence, which ECf lacks, in the larger type of the ECf column.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-2.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Retr.</hi> 32 <hi rend="italic">stellt eher</hi> lathe — <hi rend="italic">im Domesday und jetzt nur in Kent bekannt — und</hi> wapentake <hi rend="italic">gleich. Ebenso Cb</hi> 22, 5. <hi rend="italic">Er vollzieht hier den Vergleich mit</hi> riding <hi rend="italic">nur der Symmetrie wegen. Heinrich I. befreite S. Trinity zu London</hi> de omnibus sectis de syris et hundredis et lethis et hustingis [<hi rend="italic">vgl.</hi> Hn Lond 9]; <hi rend="italic">ed. Sharpe</hi> Calendar of letterbooks of London C <hi rend="italic">p.</hi> 74</seg><seg type="translation" xml:lang="en" source="#claude">at 32 the Retr. rather equates lathe — in Domesday and now known only in Kent — with wapentake. So too Cb at 22, 5. He makes the comparison with riding here only for symmetry. Henry I freed Holy Trinity, London, de omnibus sectis de syris et hundredis et lethis et hustingis [cf. Hn Lond 9]; ed. Sharpe, Calendar of letterbooks of London C p. 74</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-2.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">Anglici uocant <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Anglici uocant Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-2.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so L;</hi> leþ <hi rend="italic">Ld;</hi> lede <hi rend="italic">Hv;</hi> led <hi rend="italic">Cb Lb Lond Ph;</hi> Sed <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">so L; leþ Ld; lede Hv; led Cb Lb Lond Ph; Sed Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-2.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-2.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">þinge di. <hi rend="italic">Hv;</hi> tr. <hi rend="italic">Lond Ld;</hi> treh. <hi rend="italic">Lb Va;</hi> triehing <hi rend="italic">Cb;</hi> tith. <hi rend="italic">L;</hi> þreinges <hi rend="italic">Franz. Übers.</hi></seg><seg type="translation" xml:lang="en" source="#claude">þinge di. Hv; tr. Lond Ld; treh. Lb Va; triehing Cb; tith. L; þreinges French transl.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-2.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">Quod quoque <hi rend="italic">Hv;</hi> Quod autem <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Quod quoque Hv; Quod autem Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-2.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">þinges <hi rend="italic">Hv;</hi> þrihinge <hi rend="italic">Ld;</hi> tr. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">þinges Hv; þrihinge Ld; tr. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-2.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">defin. <hi rend="italic">Va Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">defin. Va Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_31-2.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">schi. <hi rend="italic">Hv;</hi> siram <hi rend="italic">Lb Va;</hi> scyr. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">schi. Hv; siram Lb Va; scyr. Ld</seg></note>
      </div>
    </body>
