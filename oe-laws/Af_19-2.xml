    <body>
      <div type="clause" n="19.2">
        <head><ref type="lawCode" target="law:Af">Af</ref> 19.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19.2" corresp="#wit-e"><pb n="60" ed="#liebermann"/>Gif he hine triewan<ptr type="liebermannNote" n="18" target="#Af_19-2.lnote.oe.18"/> wille, þæt he to ðære læne facn<ptr type="liebermannNote" n="19" target="#Af_19-2.lnote.oe.19"/> ne<ptr type="liebermannNote" n="20" target="#Af_19-2.lnote.oe.20"/> wiste, þæt he mot.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19.2" corresp="#wit-h"><pb n="60" ed="#liebermann"/>Gif he hine trywan<ptr type="liebermannNote" n="1" target="#Af_19-2.lnote.oe.1"/> wille, ðæt he to ðære fore ⁊ to ðære læne facn nyste<ptr type="liebermannNote" n="8" target="#Af_19-2.lnote.oe.8"/>, ðæt he mot.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19.2" corresp="#wit-b-no-prol"><pb n="60" ed="#liebermann"/>Gyf he hine triwian<ptr type="liebermannNote" n="4" target="#Af_19-2.lnote.oe.4"/> wylle, þ<hi rend="italic">æt</hi> he to ðære læne facne nyste, þ<hi rend="italic">æt</hi> he mot.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="19.2" corresp="#wit-q"><pb n="61" ed="#liebermann"/>Si uelit se<ptr type="liebermannNote" n="17" target="#Af_19-2.lnote.oe.17"/> purgare, quod ad eam commendationem<ptr type="liebermannNote" n="18" target="#Af_19-2.lnote.oe.18-2"/> malum nesciuit, hoc ei liceat.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="72" ed="#attenborough"/>Gif he hine triewan<ptr type="editorNote" n="22" target="#Af_19-2.attnote.fn.22"/> wille, þæt he to ðære læne<ptr type="editorNote" n="23" target="#Af_19-2.attnote.fn.23"/> facn ne wiste<ptr type="editorNote" n="24" target="#Af_19-2.attnote.fn.24"/>, þæt he mot.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="22.2" corresp="#wit-e"><pb n="312" ed="#jurasinski-and-oliver"/>Gif he hine triewan wille, þæt he to ðære læne facn ne wiste, þæt he mot.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="61" ed="#liebermann"/>Wenn er sich reinschwören will, dass er bei<ptr type="liebermannNote" n="1" target="#Af_19-2.lnote.de.1"/> jener Darleihung kein Arg<ptr type="liebermannNote" n="2" target="#Af_19-2.lnote.de.2"/> wusste, das darf er.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he wishes to clear himself by oath that he knew of no wrong in that lending, he may do so.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="73" ed="#attenborough"/>If he<ptr type="editorNote" n="1" target="#Af_19-2.attnote.n.1"/> wishes to clear himself, [by swearing] he was cognisant of no criminal intention when he made the loan, he may do so.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="413" ed="#whitelock"/>If he wishes to clear himself, that in making the loan he was aware of no evil intent, he may do so.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="313" ed="#jurasinski-and-oliver"/>If he wishes to clear himself [by oath] that he knew of no malice when he made the loan, he may do so.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">triowan <hi rend="italic">So;</hi> trywian <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">triowan So; trywian Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">facne <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">facne So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">nyste <hi rend="italic">statt</hi> ne w. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">nyste instead of ne w. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de">ny <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">ny on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">61</biblScope></bibl><seg type="original" xml:lang="de">expurg. <hi rend="italic">statt</hi> se p. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">expurg. instead of se p. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-2.lnote.oe.18-2" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">61</biblScope></bibl><seg type="original" xml:lang="de">commod. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">commod. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_19-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">60</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">in</hi> trywsian <hi rend="italic">im</hi> 16. <hi rend="italic">Jh. geänd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">altered to trywsian in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_19-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">55</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘bei jener [Mord]fahrt und’ fügt H zu behufs Verdeutlichung</seg><seg type="translation" xml:lang="en" source="#claude">H adds ‘on that [murderous] expedition and’ for the sake of clarity</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_19-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">55</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Gefährdeeid 1a</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Gefährdeeid 1a</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_19-2.attnote.fn.22" n="22" source="#attenborough"><bibl><biblScope unit="page">72</biblScope></bibl><label>triewan</label><seg type="original" xml:lang="en"><hi rend="italic">triwian</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_19-2.attnote.fn.23" n="23" source="#attenborough"><bibl><biblScope unit="page">72</biblScope></bibl><label>læne</label><seg type="original" xml:lang="en"><hi rend="italic">to ðære fore ⁊ t. ð. l</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_19-2.attnote.fn.24" n="24" source="#attenborough"><bibl><biblScope unit="page">72</biblScope></bibl><label>wiste</label><seg type="original" xml:lang="en"><hi rend="italic">nyste</hi>. H, B &amp; Ld.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_19-2.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">195</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e.</hi> the lender.</seg></note>
      </div>
