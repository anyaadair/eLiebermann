    <body>
      <div type="clause" n="33.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 33.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="33.1" corresp="#wit-g-a"><pb n="336" ed="#liebermann"/>Gif he þone<ptr type="liebermannNote" n="**" target="#IICn_33-1.lnote.oe.star2"/><ptr type="liebermannNote" n="16" target="#IICn_33-1.lnote.oe.16"/> borh næbbe, slea hine man ⁊ on fulan lecge.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="33.1" corresp="#wit-b"><pb n="336" ed="#liebermann"/>Gyf he ðonne borh næbbe, slea hine man ⁊ on fulan lecge.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="33.1" corresp="#wit-a"><pb n="336" ed="#liebermann"/>Gif he þonne borh næbbe, slea hine man ⁊ on fulan lecge.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="33.1" corresp="#wit-q"><pb n="337" ed="#liebermann"/>Si plegium non habeat, interimatur<ptr type="liebermannNote" n="5" target="#IICn_33-1.lnote.oe.5"/> (occidatur) et cum dampnatis<ptr type="liebermannNote" n="14" target="#IICn_33-1.lnote.oe.14"/> mittatur.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="33.1" corresp="#wit-inst-cn"><pb n="337" ed="#liebermann"/>Et si non potest<ptr type="liebermannNote" n="8" target="#IICn_33-1.lnote.oe.8"/> habere plegios, occidatur et in loco latronum sepeliatur.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="33.1" corresp="#wit-cons-cn"><pb n="337" ed="#liebermann"/>Qui si fideiussorem habere nequeat, . . . et inmundo sepelliatur.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="33.1" corresp="#wit-b"><pb n="192" ed="#robertson"/>Gyf he ðonne borh næbbe, slea hine man ⁊ on fulan lecge.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="274" ed="#rabin-doml"/>Gif he þone borh næbbe, slea hine man and on fulan lecge.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="336" ed="#liebermann"/>Wenn er aber (solche <hi rend="italic">G</hi>?) Bürgschaft nicht erhält, so tödte man ihn und lege ihn in<ptr type="liebermannNote" n="1" target="#IICn_33-1.lnote.de.1"/> schimpfliches [Grab].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">But if he gets no (such, G?) surety, let him be killed and laid in a dishonoured [grave].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="193" ed="#robertson"/>If he has no surety, he shall be slain and buried in unconsecrated ground.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="467" ed="#whitelock"/>If, however, he has no surety, he is to be slain and to lie in unconsecrated ground.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="275" ed="#rabin-doml"/>If he has no surety, he is to be executed and buried in unconsecrated ground.</ab>
        <note type="comparison" source="#liebermann" n="336"><ref target="clause:IAtr_4-1">I Atr 4.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 4, 1</note>
        <note type="editorial">G's ‘þone’ perhaps for ‘þonne’ (compare 35). Liebermann compares I Atr 4.1.; BR: added from Gesetze I p. 337, October 2026 (MS Cons); AY: added from Rabin p. 274, October 2026 (Rabin’s note to the text)</note>
        <note type="textual" source="#rabin-doml">forene: omitted B; fora A</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_33-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> occidatur</seg><seg type="translation" xml:lang="en" source="#claude">supply occidatur</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_33-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> in</seg><seg type="translation" xml:lang="en" source="#claude">supply in</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_33-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer K; eingeklammertes übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">the words before the bracket K; the bracketed words the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_33-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">condemnatis <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">condemnatis Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_33-1.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">statt</hi> þonne? <hi rend="italic">vgl.</hi> 35</seg><seg type="translation" xml:lang="en" source="#claude">instead of þonne? cf. 35</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_33-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de">þonne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þonne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_33-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">poterit <hi rend="italic">Lb;</hi> potuerit <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">poterit Lb; potuerit S</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_33-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">207</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘als Schuldigen’; <hi rend="italic">s</hi>. I Atr 4, 1¹</seg><seg type="translation" xml:lang="en" source="#claude">Not ‘as guilty’; <hi rend="italic">see</hi> I Atr 4, 1¹</seg></note>
      </div>
    </body>
