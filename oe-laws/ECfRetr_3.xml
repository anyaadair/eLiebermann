      <div type="clause" n="3">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 3"><pb n="629" ed="#liebermann"/><hi rend="bold">De iustitia sancte</hi><ptr type="liebermannNote" n="28" target="#ECfRetr_3.lnote.la.28"/> <hi rend="bold">ecclesie.</hi> Ubicumque regis<ptr type="liebermannNote" n="29" target="#ECfRetr_3.lnote.la.29"/> iustitia, uel cuiuscumque sit, placita tenuerit, si <hi rend="bold">missus</hi><ptr type="liebermannNote" n="30" target="#ECfRetr_3.lnote.la.30"/> episcopi <hi rend="bold">ueniens illuc aperuerit</hi><ptr type="liebermannNote" n="31" target="#ECfRetr_3.lnote.la.31"/> causam<ptr type="liebermannNote" n="32" target="#ECfRetr_3.lnote.la.32"/> sancte<ptr type="liebermannNote" n="33" target="#ECfRetr_3.lnote.la.33"/> ecclesie, ipsa primitus<ptr type="liebermannNote" n="34" target="#ECfRetr_3.lnote.la.34"/> <hi rend="bold">terminetur.</hi></ab>
        <note type="comparison" source="#liebermann" n="629"><label>printed alongside</label> <ref target="clause:ECf_3">ECf 3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 629 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_3.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_3.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">i. r. uel c. iusticia sit, p. t. de iusticia, si minister ep. ibi fuerit et ostenderit ca. ec. sue, i. prius deducatur ad quam[!] finem rationabilius poterit ipsa die <hi rend="italic">Cc</hi> [<hi rend="italic">aus</hi> ECf]</seg><seg type="translation" xml:lang="en" source="#claude">i. r. uel c. iusticia sit, p. t. de iusticia, si minister ep. ibi fuerit et ostenderit ca. ec. sue, i. prius deducatur ad quam[!] finem rationabilius poterit ipsa die Cc [from ECf]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_3.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">ullus episcopus ueniat i. et a. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">ullus episcopus ueniat i. et a. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_3.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">appar. <hi rend="italic">Kn Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">appar. Kn Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_3.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">pro causa <hi rend="italic">Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">pro causa Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_3.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_3.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">prius <hi rend="italic">Hv Cc</hi></seg><seg type="translation" xml:lang="en" source="#claude">prius Hv Cc</seg></note>
