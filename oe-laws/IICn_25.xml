        <note type="liebermannNote" subtype="textual" xml:id="IICn_25.lnote.oe.4-3" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de">-do ter u. <hi rend="italic">Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">-do ter u. Lb S</seg></note>
