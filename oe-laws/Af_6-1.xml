    <body>
      <div type="clause" n="6.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 6.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.1" corresp="#wit-e"><pb n="52" ed="#liebermann"/>Gif he ða hand lesan<ptr type="liebermannNote" n="44" target="#Af_6-1.lnote.oe.44"/> wille, ⁊ him mon ðæt geðafian wille, gelde<ptr type="liebermannNote" n="45" target="#Af_6-1.lnote.oe.45"/> swa to his were belimpe.<ptr type="liebermannNote" n="41" target="#Af_6-1.lnote.oe.41"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.1" corresp="#wit-h"><pb n="52" ed="#liebermann"/>Gif he ða hond<ptr type="liebermannNote" n="3" target="#Af_6-1.lnote.oe.3"/> alysan<ptr type="liebermannNote" n="13" target="#Af_6-1.lnote.oe.13"/> wille, ond<ptr type="liebermannNote" n="3" target="#Af_6-1.lnote.oe.3"/> him mon þæt geðafyan<ptr type="liebermannNote" n="7" target="#Af_6-1.lnote.oe.7"/> wille, gylde<ptr type="liebermannNote" n="7" target="#Af_6-1.lnote.oe.7"/> swa to his were belimpe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.1" corresp="#wit-b-no-prol"><pb n="53" ed="#liebermann"/>Gyf he ða hand lysan wylle, ⁊ him mon þ<hi rend="italic">æt</hi> <hi rend="italic">ge</hi>þafian wylle, gylde swa to his were belimpe.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6.1" corresp="#wit-q"><pb n="53" ed="#liebermann"/>Si manum redimere uelit, et hoc ei permittatur, componat sicut<ptr type="liebermannNote" n="20" target="#Af_6-1.lnote.oe.20"/> ad weram eius pertinebit.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="68" ed="#attenborough"/>Gif he ða hand lesan<ptr type="editorNote" n="4" target="#Af_6-1.attnote.fn.4"/> wille, ⁊ him mon ðæt geðafian wille, gelde swa to his were belimpe.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="7.1" corresp="#wit-e"><pb n="300" ed="#jurasinski-and-oliver"/>Gif he ða hand lesan wille, ⁊ him mon ðæt geðafian wille, gelde swa to his were belimpe.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="53" ed="#liebermann"/>Wenn er die Hand lösen will, und man<ptr type="liebermannNote" n="6" target="#Af_6-1.lnote.de.6"/> ihm das gestatten will, zahle er [für sie so viel], wie sich nach seinem Wergeld gehört.<ptr type="liebermannNote" n="7" target="#Af_6-1.lnote.de.7"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he wishes to redeem the hand, and he is willing to be allowed that, let him pay [for it as much] as is fitting according to his wergeld.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="69" ed="#attenborough"/>If he wishes to redeem his hand, and if it is decided to give him permission to do so, he shall pay [such fine] as is appropriate to his wergeld.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="411" ed="#whitelock"/>And if he wishes to redeem the hand, and that is allowed to him, he is to pay in proportion to his wergild.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="301" ed="#jurasinski-and-oliver"/>If he wishes to redeem the hand, and it is permitted him, let him pay in accordance with his wergild.</ab>
        <note type="comparison" source="#wormald-mel" n="272"><label>cross-reference</label> <ref target="clause:Af_71">Af 71</ref> <quote>6:1 (ref. 71)</quote></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="301"><label>cf.</label> <ref target="clause:Af_71">Af 71</ref> <quote>§75 sets the fine for striking off a hand at 66 shillings 6 and 1/3 pennies</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_6-1.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">lysan wylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lysan wylle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_6-1.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">gylde <hi rend="italic">Ld;</hi> he <hi rend="italic">fügt zu So</hi></seg><seg type="translation" xml:lang="en" source="#claude">gylde Ld; he added by So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_6-1.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">-lym- <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lym- So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_6-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_6-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">erstes</hi> a <hi rend="italic">übergeschr.,</hi> y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">first a written above, y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_6-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_6-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">53</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Brti</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_6-1.lnote.de.6" n="6" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Das Gericht</seg><seg type="translation" xml:lang="en" source="#claude">The court</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_6-1.lnote.de.7" n="7" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Halbes Wergeld <hi rend="italic">s. Gl</hi> Hand 9. 10</seg><seg type="translation" xml:lang="en" source="#claude">Half the wergild, <hi rend="italic">see Gl</hi> Hand 9. 10</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_6-1.attnote.fn.4" n="4" source="#attenborough"><bibl><biblScope unit="page">68</biblScope></bibl><label>lesan</label><seg type="original" xml:lang="en"><hi rend="italic">alysan</hi>. H.</seg></note>
      </div>
