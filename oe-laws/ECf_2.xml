    <body>
      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 2"><pb n="628" ed="#liebermann"/><ptr type="liebermannNote" n="e" target="#ECf_2.lnote.la.fn.e"/><ptr type="liebermannNote" n="16" target="#ECf_2.lnote.la.16"/>Ab Aduentu Domini<ptr type="liebermannNote" n="f" target="#ECf_2.lnote.la.fn.f"/> usque ad<ptr type="liebermannNote" n="g" target="#ECf_2.lnote.la.fn.g"/> octauas Epiphanie pacem<ptr type="liebermannNote" n="17" target="#ECf_2.lnote.la.17"/> Dei<ptr type="liebermannNote" n="h" target="#ECf_2.lnote.la.fn.h"/> et sancte ecclesie per omne regnum<ptr type="liebermannNote" n="18" target="#ECf_2.lnote.la.18"/>.</ab>
        <note type="comparison" source="#liebermann" n="628"><label>printed alongside</label> <ref target="clause:ECfRetr_2">ECf retr 2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 628 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “Aduentu” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_2.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verf. benutzt wörtlich eine</hi> Treuga Dei: <hi rend="italic">entweder eine ungedruckte Form oder er verbindet Stücke mehrerer Gestalten. Dass sie als Ganzes</hi> (<hi rend="italic">was für die Normandie richtig</hi>) <hi rend="italic">in England galt, behauptet nur er: frommer Wunsch?</hi></seg><seg type="translation" xml:lang="en" source="#claude">the author uses a Treuga Dei word for word: either a form not yet printed, or he combines pieces of several versions. That it was in force as a whole in England (which is true of Normandy) is claimed by him alone: a pious wish?</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_2.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">27. <hi rend="italic">Nov.</hi> — 3. <hi rend="italic">Dec.</hi></seg><seg type="translation" xml:lang="en" source="#claude">27 Nov. – 3 Dec.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_2.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">13. <hi rend="italic">Jan.</hi></seg><seg type="translation" xml:lang="en" source="#claude">13 Jan.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_2.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">Dei treuiam <hi rend="italic">sagt Wilhelm I.</hi> Mon. Germ. Leg. IV 1, <hi rend="italic">p.</hi> 601</seg><seg type="translation" xml:lang="en" source="#claude">William I says Dei treuiam, Mon. Germ. Leg. IV 1, p. 601</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">Quibus temporibus pax seruanda est <hi rend="italic">überschr. S;</hi> De pace regis <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">headed Quibus temporibus pax seruanda est S; De pace regis Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">pax <hi rend="italic">Hk;</hi> sit pax <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">pax Hk; sit pax Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">statuimus <hi rend="italic">fügt zu Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cl adds statuimus</seg></note>
      </div>
    </body>
