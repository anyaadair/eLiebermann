    <body>
      <div type="clause" n="11">
        <head><ref type="lawCode" target="law:VAtr">V Atr</ref> 11</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11" corresp="#wit-g"><pb n="240" ed="#liebermann"/>⁊ gelæste man Godes gerihta georne æghwylce geare.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11" corresp="#wit-g2"><pb n="240" ed="#liebermann"/>⁊ gelæste man Godes gerihta æghwylce geare.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11" corresp="#wit-d"><pb n="241" ed="#liebermann"/>⁊ gelæste man Godes gerihta georne æghwilce geare.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="11" corresp="#wit-d"><pb n="82" ed="#robertson"/>⁊ gelæste man Godes gerihta georne<ptr type="editorNote" n="4" target="#VAtr_11.robnote.fn.4"/> æghwilce geare.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g"><pb n="150" ed="#rabin-doml"/>And gelæste man Godes gerihta georne æghwylce geare.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="241" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#VAtr_11.lnote.de.1"/> man leiste willig Kirchengerechtsame in jedem Jahre,</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let God's dues be paid willingly every year,</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d"><ptr type="editorNote" n="1" target="#VAtr_11.robnote.n.1"/><pb n="83" ed="#robertson"/>And ecclesiastical dues shall be promptly rendered every year.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-g"><pb n="449" ed="#whitelock"/>And God’s dues are to be readily paid every year.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g"><pb n="151" ed="#rabin-doml"/>And God’s dues are to be paid readily every year:</ab>
        <note type="comparison" source="#liebermann" n="241"><ref target="clause:EGu_5-1">EGu 5.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. E Gu. 5, 1</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VIAtr_16">VI Atr 16</ref></note>
        <note type="comparison" source="#wormald-mel" n="338"><label>compared (table)</label> <ref target="clause:EGu_5-1">EGu 5.1–6.4</ref> <quote>Table 5.3 Wulfstan's injunctions on Church Dues compared: Hom XIII lns 70–6 | Canons of Edgar (I) 54 | Edward/Guthrum 5:1–6:4 | V Æthelred 11–12:2</quote></note>
        <note type="comparison" source="#wormald-ppmel" n="37"><label>cf.</label> <ref target="clause:VI-Atr-Latin-Paraphrase_15-2">VI Atr Lat 15.2–17</ref> <quote>cf. VI (lat.) 15:2 – 17</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="331"><ref target="clause:VIIAtr_7-1">VII Atr 7.1</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="346"><ref target="clause:Cn-1018_part-030">Cn 1018 13–14</ref></note>
        <note type="comparedBy" source="#wormald-ppmel" n="39"><ref target="clause:Cn-1018_part-030">Cn 1018 13–13.3</ref></note>
        <note type="comparedBy" source="#wormald-ppmel" n="18"><ref target="clause:ICn_8">I Cn 8</ref></note>
        <note type="editorial">Liebermann compares EGu 5.1.</note>
        <note type="textual" source="#rabin-doml">georne: omitted G2</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_11.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">172</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">= VI 16, ähnlich 43</seg><seg type="translation" xml:lang="en" source="#claude">= VI 16, similarly 43</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VAtr_11.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="en">Cf. E. and G. 5, 1; II Edg. 2, 3; 3; VI, 16–19; 43; VIII, 9–12, 1; I Cn. 8–10; Wulfstan, pp. 116, 208, 310 f.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="VAtr_11.robnote.fn.4" n="4" source="#robertson"><bibl><biblScope unit="page">82</biblScope></bibl><label>georne</label><seg type="original" xml:lang="en">Om. G₂.</seg></note>
      </div>
