      <div type="clause" n="13.3">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 13.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 13.3" corresp="#wit-lat"><ptr type="liebermannNote" n="25" target="#IudDeiXIII_13-3.lnote.oe.25"/><pb n="424" ed="#liebermann"/>si de hoc furto aliquid fecisti<ptr type="liebermannNote" n="26" target="#IudDeiXIII_13-3.lnote.oe.26"/> aut<ptr type="liebermannNote" n="27" target="#IudDeiXIII_13-3.lnote.oe.27"/> uidisti<ptr type="liebermannNote" n="26" target="#IudDeiXIII_13-3.lnote.oe.26"/> aut baiulasti<ptr type="liebermannNote" n="26" target="#IudDeiXIII_13-3.lnote.oe.26"/> aut in<ptr type="liebermannNote" n="28" target="#IudDeiXIII_13-3.lnote.oe.28"/> domo tua<ptr type="liebermannNote" n="29" target="#IudDeiXIII_13-3.lnote.oe.29"/> recepisti<ptr type="liebermannNote" n="26" target="#IudDeiXIII_13-3.lnote.oe.26"/> aut consentiens aut conscius inde fuisti, ut<ptr type="liebermannNote" n="30" target="#IudDeiXIII_13-3.lnote.oe.30"/> confitearis.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 424 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-3.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">Adiuro te ut <hi rend="italic">fügt zu Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Adiuro te ut added by Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-3.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">-is, <hi rend="italic">darüber</hi> i <hi rend="italic">Tr und so ferner Singular über Plural</hi></seg><seg type="translation" xml:lang="en" source="#claude">-is, above it i Tr, and so further on singular above plural</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-3.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">a. u. <hi rend="italic">fehlt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. u. omitted in Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-3.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">statt</hi> in — inde <hi rend="italic">nur</hi> consentaneus exinde <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">instead of in — inde, only consentaneus exinde Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-3.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">domos uestras, <hi rend="italic">darüber</hi> -mum tuam (<hi rend="italic">wie Zeu.</hi> 696&lt;sub&gt;4&lt;/sub&gt;) <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">domos uestras, above it -mum tuam (as Zeu. 696&lt;sub&gt;4&lt;/sub&gt;) Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-3.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">ut conf. <hi rend="italic">fehlt Co Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">ut conf. omitted in Co Zeu.</seg></note>
      </div>
