      <div type="clause" n="66">
        <head><ref type="lawCode" target="law:Af">Af</ref> 66</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="66" corresp="#wit-e"><pb n="84" ed="#liebermann"/>Gif men sie<ptr type="liebermannNote" n="1" target="#Af_66.lnote.oe.1"/> se<ptr type="liebermannNote" n="12" target="#Af_66.lnote.oe.12"/> earm<ptr type="liebermannNote" n="13" target="#Af_66.lnote.oe.13"/> mid honda mid ealle ofácorfen<ptr type="liebermannNote" n="14" target="#Af_66.lnote.oe.14"/> beforan elmbogan, gebete ðæt mid LXXX scill.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="66" corresp="#wit-h"><pb n="84" ed="#liebermann"/>Gif men sy<ptr type="liebermannNote" n="3" target="#Af_66.lnote.oe.3"/> se earm mid honda<ptr type="liebermannNote" n="4" target="#Af_66.lnote.oe.4"/> mid ealle ofacorfen beforan elbogan<ptr type="liebermannNote" n="10" target="#Af_66.lnote.oe.10"/>, gebete ðæt<ptr type="liebermannNote" n="11" target="#Af_66.lnote.oe.11"/> mid LXXX scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="66" corresp="#wit-b-no-prol"><pb n="84" ed="#liebermann"/>Gyf men sy se earm ofacoruen beforan elmbogan, gebete þ<hi rend="italic">æt</hi> mid hundeahtatig scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="66" corresp="#wit-q"><pb n="85" ed="#liebermann"/>Si homini sit brachium cum<ptr type="liebermannNote" n="8" target="#Af_66.lnote.oe.8"/> manu penitus amputatum ante cubitum, emendetur hoc<ptr type="liebermannNote" n="9" target="#Af_66.lnote.oe.9"/> LXXX<ptr type="liebermannNote" n="10" target="#Af_66.lnote.oe.10-2"/> sol.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="90" ed="#attenborough"/>Gif men sie se earm mid honda mid ealle ofácorfen<ptr type="editorNote" n="11" target="#Af_66.attnote.fn.11"/> beforan elmbogan<ptr type="editorNote" n="12" target="#Af_66.attnote.fn.12"/>, gebete ðæt mid LXXX scill.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="69" corresp="#wit-e"><pb n="358" ed="#jurasinski-and-oliver"/>Gif men sie se earm mid honda mid ealle ofácorfen beforan elmbogan, gebete ðæt mid LXXX scill.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="85" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_66.lnote.de.1"/> jemandem der Arm sammt der Hand vor<ptr type="liebermannNote" n="2" target="#Af_66.lnote.de.2"/> dem Elbogen gänzlich abgehauen ist, büsse [der Thäter] das mit 80<ptr type="liebermannNote" n="3" target="#Af_66.lnote.de.3"/> Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone’s arm together with the hand is completely cut off in front of the elbow, let [the offender] compensate for it with 80 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="91" ed="#attenborough"/>If a man's arm, with the hand and all below the elbow, is cut off, 80 shillings shall be paid as compensation for it.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="359" ed="#jurasinski-and-oliver"/>If a man’s arm including his hand is cut off below the elbow, let him compensate that with 80 shillings.</ab>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="363"><ref target="clause:Af_72">Af 72</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">earme <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">earme Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">-fan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-fan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rasur hinter</hi> el</seg><seg type="translation" xml:lang="en" source="#claude">erasure after el</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">85</biblScope></bibl><seg type="original" xml:lang="de">p. c. m. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. c. m. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">85</biblScope></bibl><seg type="original" xml:lang="de">ei <hi rend="italic">fügt zu HkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei added by HkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66.lnote.oe.10-2" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">85</biblScope></bibl><seg type="original" xml:lang="de">viginti <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">viginti added by Lond</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_66.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Arm 2a; Gliederbussen 5</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Arm 2a; Gliederbussen 5</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_66.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Unterarm und Unterschenkel stehen gleich; ebenso Hand und Fuss; Af 71</seg><seg type="translation" xml:lang="en" source="#claude">Forearm and shank are treated alike; likewise hand and foot; Af 71</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_66.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Die Zufügung in Q <hi rend="smallcaps">i</hi> entstand aus Französ. Ausdruck für 80: 60 + 20</seg><seg type="translation" xml:lang="en" source="#claude">The addition in Q <hi rend="smallcaps">i</hi> arose from the French expression for 80: 60 + 20</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_66.lnote.de.4" n="4" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Eine Inst.-Variante nimmt Af’s Schilling irrig für den Normannischen, wie <hi rend="italic">o.</hi> 60</seg><seg type="translation" xml:lang="en" source="#claude">One Inst. variant wrongly takes Af’s shilling for the Norman one, as <hi rend="italic">above</hi> 60</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_66.attnote.fn.11" n="11" source="#attenborough"><bibl><biblScope unit="page">90</biblScope></bibl><label>ofácorfen</label><seg type="original" xml:lang="en"><hi rend="italic">ofacorven</hi>. B. <hi rend="italic">-fan</hi>. Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_66.attnote.fn.12" n="12" source="#attenborough"><bibl><biblScope unit="page">90</biblScope></bibl><label>elmbogan</label><seg type="original" xml:lang="en"><hi rend="italic">elbogan</hi>. H.</seg></note>
      </div>
