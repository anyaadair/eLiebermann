      <div type="clause" n="66.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 66.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 66.1" corresp="#wit-lat"><pb n="585" ed="#liebermann"/>Si quis minist[rum<ptr type="liebermannNote" n="35" target="#Hn_66-1.lnote.oe.35"/>] altaris<ptr type="liebermannNote" n="l" target="#Hn_66-1.lnote.oe.l"/> occidat, utlaga<ptr type="liebermannNote" n="36" target="#Hn_66-1.lnote.oe.36"/> sit erga Deum et homines, nisi digna satisfaccione peniteat et parentibus illius iuste componat — uel<ptr type="liebermannNote" n="37" target="#Hn_66-1.lnote.oe.37"/> werelada perneget —; et hoc infra XXX noctes incipiat apud Deum et homines super omne quod habet<ptr type="liebermannNote" n="38" target="#Hn_66-1.lnote.oe.38"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 585 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-1.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">anders</hi> 68, 5 <hi rend="italic">f.</hi> 73, 6</seg><seg type="translation" xml:lang="en" source="#claude">otherwise 68, 5 <hi rend="italic">f.</hi> 73, 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-1.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Tw;</hi> -ster <hi rend="italic">übr.</hi> [<hi rend="italic">also archetyp; dennoch nicht Hn’s Meinung laut</hi> 66, 2]</seg><seg type="translation" xml:lang="en" source="#claude">thus Tw; -ster the others [hence in the archetype; nevertheless not Hn’s meaning, according to 66, 2]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-1.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de">-gha <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gha Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-1.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de">u. w. p. <hi rend="italic">fehlt K Co Or Gi</hi> [<hi rend="italic">Wi bemerkt:</hi> ‘u. weril. p. (<hi rend="italic">was er aus Wh im Text hat</hi>) <hi rend="italic">Gi</hi>’, desunt <hi rend="italic">zuzufügen vergessend</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">u. w. p. missing K Co Or Gi [Wi remarks: ‘u. weril. p. (which he has in his text from Wh) Gi’, forgetting to add desunt]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-1.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de">-eat <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-eat Lond</seg></note>
      </div>
    </body>
