      <div type="clause" n="11.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 11.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11.1" corresp="#wit-e"><pb n="56" ed="#liebermann"/>Gif he hie<ptr type="liebermannNote" n="11" target="#Af_11-1.lnote.oe.11"/> oferweorpe ⁊ mid ne gehæme, mid X<ptr type="liebermannNote" n="12" target="#Af_11-1.lnote.oe.12"/> scill. gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11.1" corresp="#wit-h"><pb n="56" ed="#liebermann"/>Gif he oferweorpe hy<ptr type="liebermannNote" n="4" target="#Af_11-1.lnote.oe.4"/> ⁊ mid ne gehæme, mid X scll' gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11.1" corresp="#wit-b-no-prol"><pb n="57" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="4" target="#Af_11-1.lnote.oe.4-2"/> he hig oferweorpe ⁊ mid ne gehæme, tyn scill' gebete.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="11.1" corresp="#wit-q"><pb n="57" ed="#liebermann"/>Si supinet<ptr type="liebermannNote" n="12" target="#Af_11-1.lnote.oe.12-2"/> eam nec tamen concumbat<ptr type="liebermannNote" n="13" target="#Af_11-1.lnote.oe.13"/> cum ea, decem sol. emendetur.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="70" ed="#attenborough"/>Gif he hie oferweorpe ⁊ mid ne gehæme, mid X scill. gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="13.1" corresp="#wit-e"><pb n="306" ed="#jurasinski-and-oliver"/>Gif he oferweorpe ⁊ mid ne gehæme, mid X scill gebete.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="57" ed="#liebermann"/>Wenn er sie niederwirft<ptr type="liebermannNote" n="1" target="#Af_11-1.lnote.de.1"/>, jedoch nicht beschläft, büsse er mit 10 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he throws her down, but does not lie with her, let him pay 10 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="71" ed="#attenborough"/>If he throws her down but does not lie with her, he shall pay [her] 10 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="307" ed="#jurasinski-and-oliver"/>If he throws her down but does not have intercourse with her, let him recompense with 10 shillings.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_18-1">Leis Wl 18.1</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">hi <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hi Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">X — mid geh. mid <hi rend="italic">überspringt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">X — mid geh. mid skipped by Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-1.lnote.oe.12-2" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">57</biblScope></bibl><seg type="original" xml:lang="de">sup., suppremet eam et prosterneret id est ad terram <hi rend="italic">fügt zu Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">sup., suppremet eam et prosterneret id est ad terram added by Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">57</biblScope></bibl><seg type="original" xml:lang="de">concubat <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">concubat R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-1.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">57</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">über hier beginnender Seite</hi> 16: Ælfredes lage cunincges <hi rend="italic">im</hi> 12. <hi rend="italic">Jh. übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">above p. 16, which begins here: Ælfredes lage cunincges written above in the 12th cent.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_11-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Falls die Notzucht vollendet wird, geht in der Busse dafür die für den Versuch auf. — Das adverbiale <hi rend="italic">mid</hi> ‘simul’, hier und 11, 2, ist nachzutragen <hi rend="italic">Wb</hi> S. 146 II</seg><seg type="translation" xml:lang="en" source="#claude">If the rape is completed, the compensation for the attempt is absorbed into the compensation for the rape. — The adverbial <hi rend="italic">mid</hi> ‘simul’, here and in 11, 2, should be added to <hi rend="italic">Wb</hi> p. 146 II</seg></note>
      </div>
