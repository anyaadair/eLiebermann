      <div type="clause" n="4">
        <head><ref type="lawCode" target="law:WlArtRetr">Wl art retr</ref> 4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-lond"><pb n="490" ed="#liebermann"/>Et omnis Francigena qui tempore Eadwardi, propiuqui nostri, fuit in Anglia particeps consuetudinum<ptr type="liebermannNote" n="12" target="#WlArtRetr_4.lnote.oe.12"/> Anglorum, quod ipsi<ptr type="liebermannNote" n="13" target="#WlArtRetr_4.lnote.oe.13"/> dicunt an hlote ⁊ an scote, persoluat<ptr type="liebermannNote" n="14" target="#WlArtRetr_4.lnote.oe.14"/> secundum legem Anglorum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 490 (two independent readings of the page images, differences settled against the page); Liebermann’s print has ‘propiuqui’ (a turned n; read ‘propinqui’); transcribed as printed; Robertson does not print this clause separately</note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_4.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de">-din̄ <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-din̄ Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_4.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de">sibi <hi rend="italic">Co Or; fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sibi Co Or; missing in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_4.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de">-uatur <hi rend="italic">Ld aus Trip.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uatur Ld from Trip.</seg></note>
      </div>
