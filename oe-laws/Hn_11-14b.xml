        <head><ref type="lawCode" target="law:Hn">Hn</ref> 11.14b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 11.14b" corresp="#wit-lat"><pb n="557" ed="#liebermann"/>Et omnis emendatio communiter emendetur Christo et regi, ubicunque<ptr type="liebermannNote" n="47" target="#Hn_11-14b.lnote.oe.47"/> recusabitur<ptr type="liebermannNote" n="g" target="#Hn_11-14b.lnote.oe.g"/> lex Dei iuste seruari secundum diccionem<ptr type="liebermannNote" n="48" target="#Hn_11-14b.lnote.oe.48"/> episcopi,</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 557 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-14b.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ferner ab von</hi> 11, 15 <hi rend="italic">f. stehen</hi> VIII Atr. 36; Had 11</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">more remote from</hi> 11, 15 <hi rend="italic">f. are</hi> VIII Atr. 36; Had 11</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-14b.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de">Ubi cum <hi rend="italic">Lond; neuen Satz beginnen Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ubi cum <hi rend="italic">Lond; edd. begin a new sentence</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-14b.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de">distinccionem <hi rend="italic">Lond; fehlt Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">distinccionem <hi rend="italic">Lond; missing in Hg</hi></seg></note>
