      <div type="clause" n="60.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 60.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 60.1a" corresp="#wit-lat"><pb n="580" ed="#liebermann"/>Si accusato contramandet et iusticiam pretermittat, ouerseunesse<ptr type="liebermannNote" n="r" target="#Hn_60-1a.lnote.oe.r"/><ptr type="liebermannNote" n="34" target="#Hn_60-1a.lnote.oe.34"/> culpa sit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 580 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_60-1a.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 61, 1; 8<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 61, 1; 8<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_60-1a.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de">-ssam <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ssam <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_60-1a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Ungehorsam 18—<hi rend="italic">-ssa</hi>{34}—60, 2 <hi rend="italic">-icio</hi>{36}—60, 2b <hi rend="italic">eius sit</hi>{37}—<hi rend="italic">tanto sit</hi>{39}—60, 2c <hi rend="italic">si</hi>{1} <hi rend="italic">in co. eo</hi>.—<hi rend="italic">aliquos</hi>{2} <hi rend="italic">aliquo</hi>—<hi rend="italic">uel</hi>{3}—60, 3 <hi rend="italic">pla</hi>.{6} fehlt—statt <hi rend="italic">si</hi> in Z. 3 meinte Verf. wohl <hi rend="italic">nisi</hi>; streiche also {a} vor <hi rend="italic">pla . re</hi>. und verstehe ‘Kriminal- und Kronprozess’ im Ggs. zur Sheriffspachtzuständigkeit—61, 1 <hi rend="italic">subditis</hi>{11} <hi rend="italic">p. conducat</hi>—<hi rend="italic">-ssa</hi>{18} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Ungehorsam 18—<hi rend="italic">-ssa</hi>{34}—60, 2 <hi rend="italic">-icio</hi>{36}—60, 2b <hi rend="italic">eius sit</hi>{37}—<hi rend="italic">tanto sit</hi>{39}—60, 2c <hi rend="italic">si</hi>{1} <hi rend="italic">in co. eo</hi>.—<hi rend="italic">aliquos</hi>{2} <hi rend="italic">aliquo</hi>—<hi rend="italic">uel</hi>{3}—60, 3 <hi rend="italic">pla</hi>.{6} is missing—instead of <hi rend="italic">si</hi> in l. 3 the author probably meant <hi rend="italic">nisi</hi>; so delete {a} before <hi rend="italic">pla . re</hi>. and understand ‘criminal and Crown pleas’ as opposed to the jurisdiction included in the sheriff’s farm—61, 1 <hi rend="italic">subditis</hi>{11} <hi rend="italic">p. conducat</hi>—<hi rend="italic">-ssa</hi>{18} Rs</seg></note>
      </div>
