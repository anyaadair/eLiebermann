      <div type="clause" n="27.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 27.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 27.2"><pb n="651" ed="#liebermann"/><hi rend="bold">et</hi> hoc non sine causa; de istis enim<ptr type="liebermannNote" n="11" target="#ECfRetr_27-2.lnote.la.11"/> <hi rend="bold">octo libris</hi> rex habebat centum solidos et<ptr type="liebermannNote" n="22" target="#ECfRetr_27-2.lnote.la.22"/> <hi rend="bold">consul</hi> comitatus<ptr type="liebermannNote" n="23" target="#ECfRetr_27-2.lnote.la.23"/>, qui tertium habet denarium de<ptr type="liebermannNote" n="24" target="#ECfRetr_27-2.lnote.la.24"/> forisfacturis, L<ptr type="liebermannNote" n="25" target="#ECfRetr_27-2.lnote.la.25"/> <hi rend="bold">solidos,</hi> decanus autem <hi rend="bold">episcopi, in</hi><ptr type="liebermannNote" n="26" target="#ECfRetr_27-2.lnote.la.26"/> <hi rend="bold">cuius decanatu pax fracta fuerit,</hi> reliquos decem, <hi rend="bold">preter</hi> pacem regis, scilicet<ptr type="liebermannNote" n="27" target="#ECfRetr_27-2.lnote.la.27"/> de pace data<ptr type="liebermannNote" n="11" target="#ECfRetr_27-2.lnote.la.11"/> manu regis et<ptr type="liebermannNote" n="27" target="#ECfRetr_27-2.lnote.la.27"/> de primo coronatu et de supradictis festis, natalis<ptr type="liebermannNote" n="28" target="#ECfRetr_27-2.lnote.la.28"/>, pasche, pentecostes<ptr type="liebermannNote" n="29" target="#ECfRetr_27-2.lnote.la.29"/>.</ab>
        <note type="comparison" source="#liebermann" n="651"><label>printed alongside</label> <ref target="clause:ECf_27-2">ECf 27.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 651 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-2.lnote.la.fn.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">kirchlich</hi> (<hi rend="italic">zu trennen vom</hi> decanus <hi rend="italic">in</hi> 28); <hi rend="italic">vgl. Schröder</hi> Entwickl. des Archidiakonats <hi rend="italic">S.</hi> 36</seg><seg type="translation" xml:lang="en" source="#claude">ecclesiastical (to be distinguished from the decanus in 28); cf. Schröder, Entwickl. des Archidiakonats p. 36</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-2.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-2.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt L;</hi> et—50 sol. <hi rend="italic">fehlt Va Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in L; et—50 sol. lacking in Va Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-2.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">quinquaginta <hi rend="italic">nachtr. eingefügt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">quinquaginta inserted afterwards Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-2.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">forisfacture <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">forisfacture Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-2.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">unum (<hi rend="italic">weil</hi> l <hi rend="italic">verlesen als</hi> I) sol. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">unum (because l was misread as I) sol. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-2.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">si intus decanatum <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">si intus decanatum Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-2.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">si <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">si Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-2.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">nat. pa. pe. <hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">nat. pa. pe. lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-2.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">-sten <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sten K</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">and this not without reason; for of these eight pounds the king had a hundred shillings, and the earl (<hi rend="italic">consul</hi>) of the shire, who has the third penny of the forfeitures, 50 shillings, and the bishop's dean, in whose deanery the peace has been broken, the remaining ten, besides the king's peace, namely for the peace given by the king's hand and for the first coronation and for the above-mentioned feasts, of Christmas, of Easter, of Pentecost.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-2.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">unum</hi><hi rend="superscript">25</hi> <hi rend="italic">sot.</hi> — <hi rend="italic">-sten</hi><hi rend="superscript">29</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">unum</hi><hi rend="superscript">25</hi> <hi rend="italic">sot.</hi> — <hi rend="italic">-sten</hi><hi rend="superscript">29</hi> Rs</seg></note>
      </div>
    </body>
  </text>
