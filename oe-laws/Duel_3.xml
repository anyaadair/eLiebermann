      <div type="clause" n="3">
        <head><ref type="lawCode" target="law:Duel">Duel</ref> 3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Duel 3" corresp="#wit-lat"><ptr type="liebermannNote" n="1" target="#Duel_3.lnote.oe.1"/><pb n="431" ed="#liebermann"/>Hic<ptr type="liebermannNote" n="a" target="#Duel_3.lnote.oe.a"/> tradat ei scutum<ptr type="liebermannNote" n="2" target="#Duel_3.lnote.oe.2"/> dicens<ptr type="liebermannNote" n="3" target="#Duel_3.lnote.oe.3"/>:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 431 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_3.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">aspergat sacerdos scutum et baculum aqua benedicta; deinde, resurgente pugnaturo, (<hi rend="italic">vgl.</hi> 1<hi rend="italic">ᵇ</hi>) <hi rend="italic">fügt zu Sr.</hi> [<hi rend="italic">Auch Ordal-Instrumente erhalten Weihwasser:</hi> Iud. Dei XII 5. XVI 8.]</seg><seg type="translation" xml:lang="en" source="#claude">aspergat sacerdos scutum et baculum aqua benedicta; deinde, resurgente pugnaturo, (cf. 1ᵇ) added in Sr. [Ordeal instruments too receive holy water: Iud. Dei XII 5. XVI 8.]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_3.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">Sacerdos det sc. d. <hi rend="italic">Tr;</hi> Tradatur tunc ei sc. et dicat sacerdos <hi rend="italic">Ym;</hi> Quando dederis scutum <hi rend="italic">Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">Sacerdos det sc. d. Tr; Tradatur tunc ei sc. et dicat sacerdos Ym; Quando dederis scutum Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_3.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">baculum <hi rend="italic">Gl</hi></seg><seg type="translation" xml:lang="en" source="#claude">baculum Gl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_3.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">-ndo <hi rend="italic">Sr Ta Gl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ndo Sr Ta Gl</seg></note>
