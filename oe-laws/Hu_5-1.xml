  <text>
    <body>
      <div type="clause" n="5.1">
        <head><ref type="lawCode" target="law:Hu">Hu</ref> 5.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.1" corresp="#wit-b"><pb n="194" ed="#liebermann"/>Gyf he hit forsitte, gesylle ðam cynge ðrittig scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.1" corresp="#wit-q"><pb n="194" ed="#liebermann"/>Si hec<ptr type="liebermannNote" n="1" target="#Hu_5-1.lnote.oe.1"/> supersederint, emendent (hoc pretermittat, emendet) regi XXX sol.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.1" corresp="#wit-cons-cn"><pb n="195" ed="#liebermann"/>Quod si recuset, det regi XXX solidos.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="5.1" corresp="#wit-b"><pb n="18" ed="#robertson"/>Gyf he hit forsitte, gesylle ðam cynge ðrittig scill'.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="195" ed="#liebermann"/>Wenn er es versäumt, zahle er dem König 30 Schilling.<ptr type="liebermannNote" n="1" target="#Hu_5-1.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he neglects it, let him pay the king 30 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="19" ed="#robertson"/>If he neglects to do so, he shall pay 30 shillings<ptr type="editorNote" n="1" target="#Hu_5-1.robnote.n.1"/> to the king.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-b"><pb n="433" ed="#whitelock"/>If he neglects it, he is to pay 30 shillings to the king.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_5-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">194</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond;</hi> (<hi rend="italic">eingeklammertes</hi>) <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket Lond; (bracketed) the others</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Hu_5-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">132</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. u</hi>. 7, 1⁴; <hi rend="italic">Gl</hi> Amtsvergehen 1 Z. 10</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. below</hi> 7, 1⁴; <hi rend="italic">Gl</hi> Amtsvergehen 1 l. 10</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Hu_5-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">301</biblScope></bibl><seg type="original" xml:lang="en">The fine payable by the <hi rend="italic">gerefa</hi> was 120 shillings, see VI As. 8, 4. Is it possible that the reeve had jurisdiction over a larger district, <hi rend="italic">i.e.</hi> several hundreds?</seg></note>
      </div>
    </body>
