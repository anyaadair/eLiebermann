    <body>
      <div type="clause" n="11.8">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 11.8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 11.8" corresp="#wit-lat"><pb n="557" ed="#liebermann"/>Qui<ptr type="liebermannNote" n="b" target="#Hn_11-8.lnote.oe.b"/> ordinatum occiderit<ptr type="liebermannNote" n="c" target="#Hn_11-8.lnote.oe.c"/> uel malignauerit, emendet ei sicut rectum sit, et episcopo<ptr type="liebermannNote" n="17" target="#Hn_11-8.lnote.oe.17"/> emendacionem altaris secundum ordinis dignitatem, regi uel domino plenam infraccionem pacis; uel<ptr type="liebermannNote" n="18" target="#Hn_11-8.lnote.oe.18"/> plena<ptr type="liebermannNote" n="19" target="#Hn_11-8.lnote.oe.19"/> lada neget.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 557 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-8.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">näher zu Cnut unten</hi> 66, 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">closer to Cnut below</hi> 66, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-8.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">gemeint als (oder Flüchtigkeitsfehler für)</hi> ceciderit, <hi rend="italic">weil sonst die Strafe zu milde wäre</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">meant as (or a slip for)</hi> ceciderit, <hi rend="italic">since otherwise the penalty would be too mild</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-8.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de">ipī (<hi rend="italic">d. i.</hi> ipsi) <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">ipī (<hi rend="italic">i.e.</hi> ipsi) <hi rend="italic">Sc Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-8.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">vom Corr. geänd.</hi> uel <hi rend="italic">Sc; vielleicht hatte Orig. mit Cnut</hi> aut</seg><seg type="translation" xml:lang="en" source="#claude">et <hi rend="italic">altered by the corrector to</hi> uel <hi rend="italic">Sc; perhaps the original had, with Cnut,</hi> aut</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-8.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de">plene <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">plene <hi rend="italic">Sc Hg</hi></seg></note>
      </div>
    </body>
