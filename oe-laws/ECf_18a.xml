  <text>
    <body>
      <div type="clause" n="18a">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 18a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 18a"><pb n="643" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_18a.lnote.oe.erkl-clause"/>Et<ptr type="liebermannNote" n="25" target="#ECf_18a.lnote.la.25"/> ipse<ptr type="liebermannNote" n="h" target="#ECf_18a.lnote.la.fn.h"/> cui fecerit<ptr type="liebermannNote" n="26" target="#ECf_18a.lnote.la.26"/> misericordiam<ptr type="liebermannNote" n="27" target="#ECf_18a.lnote.la.27"/>, faciat rectum cui prius<ptr type="liebermannNote" n="28" target="#ECf_18a.lnote.la.28"/> forisfecerat<ptr type="liebermannNote" n="29" target="#ECf_18a.lnote.la.29"/>, in quantum poterit<ptr type="liebermannNote" n="30" target="#ECf_18a.lnote.la.30"/> complere, et inueniat fideiussores<ptr type="liebermannNote" n="i" target="#ECf_18a.lnote.la.fn.i"/> de pace et legalitate tenenda.</ab>
        <note type="comparison" source="#liebermann" n="643"><label>printed alongside</label> <ref target="clause:ECfRetr_18a">ECf retr 18a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 643 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18a.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 18, 1a: <hi rend="italic">der König kann von vermögensrechtlichen Verbindlichkeiten nicht lösen</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 18, 1a: the king cannot release from obligations in property law</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18a.lnote.la.fn.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> II As. 20, 1. 4; I Atr. 4</seg><seg type="translation" xml:lang="en" source="#claude">cf. II As. 20, 1. 4; I Atr. 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18a.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18a.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">fecit <hi rend="italic">Ad Do;</hi> m. f. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">fecit Ad Do; m. f. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18a.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">miām <hi rend="italic">Rl Hk;</hi> iniuriam <hi rend="italic">S Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">miām Rl Hk; iniuriam S Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18a.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">f. p. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. p. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18a.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18a.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">potuerit <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">potuerit S</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And let him to whom he has shown mercy do right to the one against whom he had before offended, as far as he can fulfil it, and let him find sureties for keeping the peace and lawfulness.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18a.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">346</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Bürgschaft 6b; Verbannung</seg><seg type="translation" xml:lang="en" source="#claude">Cf. Gl Bürgschaft 6b; Verbannung</seg></note>
      </div>
    </body>
