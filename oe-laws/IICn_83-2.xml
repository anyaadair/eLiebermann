    <body>
      <div type="clause" n="83.2">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 83.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="83.2" corresp="#wit-g-a"><pb n="366" ed="#liebermann"/>⁊ gyf<ptr type="liebermannNote" n="23" target="#IICn_83-2.lnote.oe.23"/> he þonn<hi rend="italic">e</hi> swa dyrstig sig<ptr type="liebermannNote" n="5" target="#IICn_83-2.lnote.oe.5"/>, þ<hi rend="italic">æt</hi> he hit<ptr type="liebermannNote" n="16" target="#IICn_83-2.lnote.oe.16"/> þriddan<ptr type="liebermannNote" n="24" target="#IICn_83-2.lnote.oe.24"/> syðe wyrde, þolige ealles þæs þe he áge.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="83.2" corresp="#wit-b"><pb n="366" ed="#liebermann"/>And gyf he ðonne swa dyrstig sy, þ<hi rend="italic">æt</hi> he hi ðridde siðe abrece, ðolige ealles ðæs ðe he age.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="83.2" corresp="#wit-a"><pb n="366" ed="#liebermann"/>⁊ gif he þonne swa dyrstig sy, þ<hi rend="italic">æt</hi> he þridde syðe wyrde, þolige ealles þæs þe he age.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="83.2" corresp="#wit-q"><pb n="367" ed="#liebermann"/>Et si quis addat<ptr type="liebermannNote" n="14" target="#IICn_83-2.lnote.oe.14"/> tertio, reus sit omnium quę habebit.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="83.2" corresp="#wit-inst-cn"><pb n="367" ed="#liebermann"/>Quod si audendo tertio<ptr type="liebermannNote" n="13" target="#IICn_83-2.lnote.oe.13"/> hoc presumpserit, perdat omnia sua. . . . . . .<ptr type="liebermannNote" n="14" target="#IICn_83-2.lnote.oe.14-2"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="83.2" corresp="#wit-cons-cn"><pb n="367" ed="#liebermann"/>[83, 2] Quodsi adeo audax si[t], ut illam tertio temeret, amittat quicquid possidet.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="83.2" corresp="#wit-b"><pb n="216" ed="#robertson"/>And gyf he ðonne swa dyrstig sy þæt he hi<ptr type="editorNote" n="4" target="#IICn_83-2.robnote.fn.4"/> ðridde siðe abrece<ptr type="editorNote" n="5" target="#IICn_83-2.robnote.fn.5"/>, ðolige ealles ðæs ðe he age.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="296" ed="#rabin-doml"/>And gyf he þonne swa dyrstig sig, þæt he hit þriddan syðe wyrde, þolige ealles þæs þe he age.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="366" ed="#liebermann"/>Und wenn er dann so frech<ptr type="liebermannNote" n="1" target="#IICn_83-2.lnote.de.1"/> ist, dass er es zum dritten Male verletzt, verliere er alles<ptr type="liebermannNote" n="2" target="#IICn_83-2.lnote.de.2"/>, was er besitzt.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if he is then so bold that he violates it a third time, let him lose everything that he possesses.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="217" ed="#robertson"/>And if he is so presumptuous as to break it a third time, he shall lose all that he possesses.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="474" ed="#whitelock"/>And if he then is so presumptuous that he violates it a third time, he is to forfeit all that he owns.<ptr type="editorNote" n="4" target="#IICn_83-2.whinote.n.4"/></ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="297" ed="#rabin-doml"/>And if he is brazen enough to violate it a third time, he shall forfeit all that he possesses.</ab>
        <note type="comparison" source="#liebermann" n="366"><ref target="clause:IIAs_25-2">II As 25.2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd.</note>
        <note type="editorial">BR: added from Gesetze I p. 367, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">hit: hi B; omitted A</note>
        <note type="textual" source="#rabin-doml">wyrde: abrece B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_83-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">367</biblScope></bibl><seg type="original" xml:lang="de">sic <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_83-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">367</biblScope></bibl><seg type="original" xml:lang="de">audeat <hi rend="italic">zu bessern?</hi> presumet <hi rend="italic">Hn</hi> 12, 4; presumpserit 34, 8</seg><seg type="translation" xml:lang="en" source="#claude">audeat to be emended? presumet Hn 12, 4; presumpserit 34, 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_83-2.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">366</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_83-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">366</biblScope></bibl><seg type="original" xml:lang="de">sẏ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sẏ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_83-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">366</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_83-2.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">366</biblScope></bibl><seg type="original" xml:lang="de">-de <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-de Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_83-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">367</biblScope></bibl><seg type="original" xml:lang="de">h. t. <hi rend="italic">S Pl Ct</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. t. S Pl Ct</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_83-2.lnote.oe.14-2" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">367</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">II Cnut</hi> 84—84, 6 <hi rend="italic">fehlt; folgt Theil III; s. o. S.</hi> 93**.</seg><seg type="translation" xml:lang="en" source="#claude">II Cnut 84—84, 6 lacking; Part III follows; see above p. 93**.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_83-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">214</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S</hi>. Cn 1020, 9³</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See</hi> Cn 1020, 9³</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_83-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">214</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Friedlosigkeit II As 25, 2; hier nur Vermögenseinziehung; <hi rend="italic">s. d. Gl</hi> 10o</seg><seg type="translation" xml:lang="en" source="#claude">Outlawry in II As 25, 2; here only confiscation of property; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 10o</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_83-2.robnote.fn.4" n="4" source="#robertson"><bibl><biblScope unit="page">216</biblScope></bibl><label>hi</label><seg type="original" xml:lang="en"><hi rend="italic">hit</hi> G; om. A, Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_83-2.robnote.fn.5" n="5" source="#robertson"><bibl><biblScope unit="page">216</biblScope></bibl><label>abrece</label><seg type="original" xml:lang="en"><hi rend="italic">wyrde</hi> G, A, Ld.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IICn_83-2.whinote.n.4" n="4" source="#whitelock"><bibl><biblScope unit="page">474</biblScope></bibl><label>owns</label><seg type="original" xml:lang="en">Some concluding chapters follow, which agree with a treatise “Concerning the priesthood”, printed by Jost, <hi rend="italic">Die “Institutes of Polity”,</hi> pp. 259–61. They are merely homiletic.</seg></note>
      </div>
