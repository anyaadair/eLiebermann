      <div type="clause" n="4">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 4"><pb n="630" ed="#liebermann"/><hi rend="spaced">De ecclesie<ptr type="liebermannNote" n="1" target="#ECf_4.lnote.la.1"/> tenentibus.</hi> Quicunque de ecclesia<ptr type="liebermannNote" n="2" target="#ECf_4.lnote.la.2"/> tenuerit uel in feudo<ptr type="liebermannNote" n="3" target="#ECf_4.lnote.la.3"/> ecclesie manserit, alicubi<ptr type="liebermannNote" n="4" target="#ECf_4.lnote.la.4"/> extra curiam<ptr type="liebermannNote" n="5" target="#ECf_4.lnote.la.5"/> ecclesiasticam<ptr type="liebermannNote" n="a" target="#ECf_4.lnote.la.fn.a"/> non placitabit, si in aliquo<ptr type="liebermannNote" n="b" target="#ECf_4.lnote.la.fn.b"/> forisfactum<ptr type="liebermannNote" n="6" target="#ECf_4.lnote.la.6"/> habuerit<ptr type="liebermannNote" n="c" target="#ECf_4.lnote.la.fn.c"/>, donec — quod absit! — in<ptr type="liebermannNote" n="7" target="#ECf_4.lnote.la.7"/> curia<ptr type="liebermannNote" n="a" target="#ECf_4.lnote.la.fn.a"/> ecclesiastica<ptr type="liebermannNote" n="8" target="#ECf_4.lnote.la.8"/> de<ptr type="liebermannNote" n="9" target="#ECf_4.lnote.la.9"/> recto defecerit.</ab>
        <note type="comparison" source="#liebermann" n="630"><label>printed alongside</label> <ref target="clause:ECfRetr_4">ECf retr 4</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 630 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_4.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Baronialgericht der Kirche, da laut letzter Zeile eine nicht-</hi>ecclesiastica curia <hi rend="italic">höhere Instanz</hi> (<hi rend="italic">s. u.</hi> 9, 1<hi rend="italic">e</hi>) <hi rend="italic">sein kann, was der klerikale Verf. für ein geistliches Gericht nicht zugegeben hätte; gegen Bigelow</hi> Hist. of proced. 49</seg><seg type="translation" xml:lang="en" source="#claude">the Church’s baronial court, since according to the last line a non-ecclesiastical curia can be a higher instance (see below, 9, 1e), which the clerical author would not have conceded for a spiritual court; against Bigelow, Hist. of proced. 49</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_4.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">falsch, falls die Klage Land ausserhalb dieses Lehens oder eine der Krone vorbehaltene Sache betraf, oder der Frevler auswärts</hi> (<hi rend="italic">am Thatort</hi>) <hi rend="italic">verhaftet oder nur Einwohner ohne Vasallität war, oder das Kirchenland nicht Jurisdictionsprivileg genoss: also klerikale Übertreibung</hi></seg><seg type="translation" xml:lang="en" source="#claude">wrong, if the suit concerned land outside this fief or a matter reserved to the Crown, or the offender was arrested elsewhere (at the scene of the deed) or was only a resident without vassalage, or the church land did not enjoy a privilege of jurisdiction: so a clerical exaggeration</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_4.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Retr. latinisirt das barbarisch durch Hilfszeitwort gebildete Perfect</hi></seg><seg type="translation" xml:lang="en" source="#claude">the Retractator latinizes the perfect, barbarously formed with an auxiliary verb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_4.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">-sia <hi rend="italic">Rl;</hi> De his qui de ecclesia tenent <hi rend="italic">Hr;</hi> De dignitate ecclesiarum <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sia Rl; De his qui de ecclesia tenent Hr; De dignitate ecclesiarum Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_4.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">ecclesiis <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">ecclesiis Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_4.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">feodo <hi rend="italic">Hk Cl Ad;</hi> fundo <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">feodo Hk Cl Ad; fundo Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_4.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">alibi <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">alibi Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_4.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">ecclesie cur. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">ecclesie cur. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_4.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl stets</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl always</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_4.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_4.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">ecclesie <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">ecclesie Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_4.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">a <hi rend="italic">Hk;</hi> in <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">a Hk; in Do</seg></note>
      </div>
