      <div type="clause" n="57.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 57.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 57.1a" corresp="#wit-lat"><pb n="576" ed="#liebermann"/>Et si alias ire oporteat, in curiam domini sui eant, si unum dominum habeant, et soca sit eius — et illic eos amicitia<ptr type="liebermannNote" n="e" target="#Hn_57-1a.lnote.oe.e"/> congreget<ptr type="liebermannNote" n="5" target="#Hn_57-1a.lnote.oe.5"/> aut sequestret iudicium —; si secus est, in hundretum suum, si opus est, eant.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 576 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-1a.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 7, 3<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">see above 7, 3<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-1a.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">confregit <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">confregit Lond</seg></note>
      </div>
