        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 29.1c" corresp="#wit-lat"><pb n="563" ed="#liebermann"/>Sed submonitis<ptr type="liebermannNote" n="15" target="#Hn_29-1c.lnote.oe.15"/> terrarum dominis, inforcietur<ptr type="liebermannNote" n="e" target="#Hn_29-1c.lnote.oe.e"/> placitum termino<ptr type="liebermannNote" n="16" target="#Hn_29-1c.lnote.oe.16"/> competenti; si fuerint<ptr type="liebermannNote" n="f" target="#Hn_29-1c.lnote.oe.f"/> uel non fuerint antea submoniti<ptr type="liebermannNote" n="17" target="#Hn_29-1c.lnote.oe.17"/>, tamen<ptr type="liebermannNote" n="18" target="#Hn_29-1c.lnote.oe.18"/> secuti<ptr type="liebermannNote" n="19" target="#Hn_29-1c.lnote.oe.19"/> ius estimati s[unt<ptr type="liebermannNote" n="20" target="#Hn_29-1c.lnote.oe.20"/>].</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 563 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-1c.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 33, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. 33, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-1c.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">sc.</hi> villani; <hi rend="italic">das Gericht gilt als vollzählig durch Ladung ihrer Herren</hi></seg><seg type="translation" xml:lang="en" source="#claude">sc. villani; the court counts as complete through the summoning of their lords</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-1c.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">cummon. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">cummon. Lond</seg></note>
