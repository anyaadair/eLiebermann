    <body>
      <div type="clause" n="9.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 9.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 9.5" corresp="#wit-lat"><pb n="555" ed="#liebermann"/>Multa siquidem causarum differencia<ptr type="liebermannNote" n="27" target="#Hn_9-5.lnote.oe.27"/> est: capite plectendarum<ptr type="liebermannNote" n="n" target="#Hn_9-5.lnote.oe.n"/> uel peccunia redimendarum, transeuncium<ptr type="liebermannNote" n="o" target="#Hn_9-5.lnote.oe.o"/>, manencium uel utrumque spectantium et que solum<ptr type="liebermannNote" n="n" target="#Hn_9-5.lnote.oe.n"/> pertinent<ptr type="liebermannNote" n="28" target="#Hn_9-5.lnote.oe.28"/> ad ius regium.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 555 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-5.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 9, 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">see above</hi> 9, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-5.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">in anderes Gericht übergehend [oder] bei der anfänglichen Instanz verbleibend oder zweierlei Gerichtsherrlichkeiten [<hi rend="italic">s. o.</hi> 9, 1<hi rend="italic">a</hi>] angehend</seg><seg type="translation" xml:lang="en" source="#claude">passing to another court [or] remaining with the court of first instance, or concerning two different jurisdictions [<hi rend="italic">see above</hi> 9, 1<hi rend="italic">a</hi>]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-5.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">draᵃ <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">draᵃ <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-5.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">555</biblScope></bibl><seg type="original" xml:lang="de">-net <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-net <hi rend="italic">Co Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-5.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">317</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">utr. sp</hi>. nicht (mit Stubbs <hi rend="italic">Lect</hi>. 153) ‘mutual, where one side is as much in fault as the other’</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">utr. sp</hi>. does not mean (as Stubbs <hi rend="italic">Lect</hi>. 153 takes it) ‘mutual, where one side is as much in fault as the other’</seg></note>
      </div>
