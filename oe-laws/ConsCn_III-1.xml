      <div type="clause" n="III 1">
        <head><ref type="lawCode" target="law:ConsCn">Cons Cn</ref> III 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Cons Cn III 1" corresp="#wit-lat"><pb n="619" ed="#liebermann"/>De<ptr type="liebermannNote" n="g" target="#ConsCn_III-1.lnote.oe.g"/> balatronibus<ptr type="liebermannNote" n="5" target="#ConsCn_III-1.lnote.oe.5"/>. Diximus de balatronibus<ptr type="liebermannNote" n="6" target="#ConsCn_III-1.lnote.oe.6"/> — — morte puniatur; <hi rend="italic">s. o. S</hi>. 389</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 619 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ConsCn_III-1.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">619</biblScope></bibl><seg type="original" xml:lang="de">III 1—3, 9 <hi rend="italic">sind übersetzt aus Einer Sammlung</hi></seg><seg type="translation" xml:lang="en" source="#claude">III 1—3, 9 are translated from a single collection</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ConsCn_III-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">619</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Überschrift fehlt Hk, wo aber rothe Initiale</hi></seg><seg type="translation" xml:lang="en" source="#claude">Heading missing in Hk, which however has a red initial</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ConsCn_III-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">619</biblScope></bibl><seg type="original" xml:lang="de">latronibus <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">latronibus Hk</seg></note>
