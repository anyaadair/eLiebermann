    <body>
      <div type="clause" n="5.3a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.3a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.3a" corresp="#wit-lat"><pb n="548" ed="#liebermann"/>Si<ptr type="liebermannNote" n="43" target="#Hn_5-3a.lnote.oe.43"/> in testibus et iudicibus<ptr type="liebermannNote" n="g" target="#Hn_5-3a.lnote.oe.g"/> et personis<ptr type="liebermannNote" n="m" target="#Hn_5-3a.lnote.oe.m"/><ptr type="liebermannNote" n="44" target="#Hn_5-3a.lnote.oe.44"/> satisfactum sit ei, si iudicibus consentiat<ptr type="liebermannNote" n="45" target="#Hn_5-3a.lnote.oe.45"/>, <ptr type="liebermannNote" n="n" target="#Hn_5-3a.lnote.oe.n"/>. . . aduocet<ptr type="liebermannNote" n="o" target="#Hn_5-3a.lnote.oe.o"/><ptr type="liebermannNote" n="46" target="#Hn_5-3a.lnote.oe.46"/> aut contradicat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 548 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-3a.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">anders als kanonisches Recht versteht Verf.</hi> 33, 5 <hi rend="italic">unter</hi> iudices electi ‘<hi rend="italic">Urtheilfinder</hi>’; <hi rend="italic">so vielleicht schon hier oder doch</hi> 5, 3<hi rend="italic">a</hi>; 5, 6 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">unlike canon law, the author in 33, 5 understands by iudices electi ‘judgment-finders’; so perhaps already here, or at any rate in 5, 3a; 5, 6 f.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-3a.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">accusantium <hi rend="italic">Pan.</hi></seg><seg type="translation" xml:lang="en" source="#claude">accusantium Pan.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-3a.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlen Wörter laut</hi> 31, 6: si iudices suspectos habeat, aduocet aut contradicat</seg><seg type="translation" xml:lang="en" source="#claude">words are missing, according to 31, 6: si iudices suspectos habeat, aduocet aut contradicat</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-3a.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">berufe oder schelte; <hi rend="italic">vgl.</hi> 33, 2. 34, 4</seg><seg type="translation" xml:lang="en" source="#claude">appeal or challenge; cf. 33, 2. 34, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-3a.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">siue <hi rend="italic">statt</hi> si in <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">siue instead of si in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-3a.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">prepositis <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">prepositis K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-3a.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">-nsiat <hi rend="italic">Sc;</hi> consentia <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nsiat Sc; consentia Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-3a.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">aut uocet <hi rend="italic">Sc Hg;</hi> aut nocet <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">aut uocet Sc Hg; aut nocet Wh</seg></note>
      </div>
