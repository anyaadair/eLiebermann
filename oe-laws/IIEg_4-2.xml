      <div type="clause" n="4.2">
        <head><ref type="lawCode" target="law:IIEg">II Eg</ref> 4.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4.2" corresp="#wit-g-a"><pb n="198" ed="#liebermann"/>⁊ gyf<ptr type="liebermannNote" n="21" target="#IIEg_4-2.lnote.oe.21"/> he hine eft syllan nylle, læde hine eft to Róme ⁊ oðre swylce<ptr type="liebermannNote" n="22" target="#IIEg_4-2.lnote.oe.22"/> bote<ptr type="liebermannNote" n="23" target="#IIEg_4-2.lnote.oe.23"/>; ⁊ þon<hi rend="italic">ne</hi> he ha<hi rend="italic">m</hi> cume, gylde<ptr type="liebermannNote" n="24" target="#IIEg_4-2.lnote.oe.24"/> þa<hi rend="italic">m</hi> cynge<ptr type="liebermannNote" n="25" target="#IIEg_4-2.lnote.oe.25"/> twahund scill.'</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4.2" corresp="#wit-a"><pb n="198" ed="#liebermann"/>⁊ gyf he hine eft syllan nelle, læde hine eft to Rome ⁊ oðere swilce bote; ⁊ þon<hi rend="italic">ne</hi> he ham cume, gylde þa<hi rend="italic">m</hi> cinge twahund scyllinga.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4.2" corresp="#wit-d"><pb n="198" ed="#liebermann"/>⁊ gif he hine eft sillan nelle, læde hine eft to Rome ⁊ oðre swilce bote; ⁊ þon<hi rend="italic">ne</hi> he ha<hi rend="italic">m</hi> cume, gilde þa<hi rend="italic">m</hi> cynge twahund scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="4.2" corresp="#wit-q"><pb n="199" ed="#liebermann"/>Et si<ptr type="liebermannNote" n="1" target="#IIEg_4-2.lnote.oe.1"/> iterum<ptr type="liebermannNote" n="2" target="#IIEg_4-2.lnote.oe.2"/> reddere nolit, deferat eum Romam<ptr type="liebermannNote" n="3" target="#IIEg_4-2.lnote.oe.3"/> iterum<ptr type="liebermannNote" n="4" target="#IIEg_4-2.lnote.oe.4"/> et eandem emendationem; et cum redierit, emendet CC<ptr type="liebermannNote" n="5" target="#IIEg_4-2.lnote.oe.5"/> sol. regi.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="4.2" corresp="#wit-d"><pb n="22" ed="#robertson"/>⁊ gif he hine eft sillan nelle, læde hine eft to Rome ⁊ oðre swilce bote; ⁊ þonne he ham cume, gilde þam cynge twahund scill'.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="352" ed="#rabin-doml"/>And gyf he hine eft syllan nylle, læde hine eft to Rome and oðre swylce bote; and þonne he ham cume, gylde þam cynge twahund scillinga.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="199" ed="#liebermann"/>Und wenn er zum zweiten Male<ptr type="liebermannNote" n="1" target="#IIEg_4-2.lnote.de.1"/> sich weigert, den [Peterspfennig] zu geben, trage er ihn wiederum nach Rom mit einer zweiten solchen Busssumme; und wenn er heimkommt, zahle er dem König 200 Schill.<ptr type="liebermannNote" n="2" target="#IIEg_4-2.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if he again refuses to give the [Peter's Penny], let him take it to Rome again with a second such penalty; and when he comes home, let him pay the king 200 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d"><pb n="23" ed="#robertson"/>And if he again refuses to give it, he shall take it again to Rome, and hand over the same sum as compensation, and when he comes home, he shall pay 200 shillings to the king.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="435" ed="#whitelock"/>And if again he will not pay it, he is again to take it to Rome, with another such compensation; and when he comes home, he is to pay 200 shillings to the king.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="353" ed="#rabin-doml"/>And if he refuses to pay a second time, he is to take the payment again to Rome along with the same amount as a penalty; and when he has returned, he is to pay two hundred shillings to the king.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_4-2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">198</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_4-2.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">198</biblScope></bibl><seg type="original" xml:lang="de">swilce <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">swilce So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_4-2.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">198</biblScope></bibl><seg type="original" xml:lang="de">bete <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">bete Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_4-2.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">198</biblScope></bibl><seg type="original" xml:lang="de">gyld þæm <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gyld þæm So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_4-2.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">198</biblScope></bibl><seg type="original" xml:lang="de">cyng <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyng Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_4-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">199</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt M</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in M</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_4-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">199</biblScope></bibl><seg type="original" xml:lang="de">item <hi rend="italic">T Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">item T Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_4-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">199</biblScope></bibl><seg type="original" xml:lang="de">i. R. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. R. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_4-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">199</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_4-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">199</biblScope></bibl><seg type="original" xml:lang="de">r. CC s. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. CC s. Co</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEg_4-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">135</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Zweite und dritte Weigerung wiederholen Benutzer nicht; <hi rend="italic">vgl. Gl</hi> Rückfall 7</seg><seg type="translation" xml:lang="en" source="#claude">The borrowers do not repeat the second and third refusals; <hi rend="italic">cf. Gl</hi> Rückfall 7</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEg_4-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">135</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Gemeinfreies Wergeld (<hi rend="italic">s. d. Gl</hi> 27. 30b), als Halslösung, sieht hierin Schreuer <hi rend="italic">Verbrechenskonk</hi>. 167.—In Cn weichen willkürlich, wohl bloss nachlässig, von Eg ab</seg><seg type="translation" xml:lang="en" source="#claude">Schreuer <hi rend="italic">Verbrechenskonk</hi>. 167 sees in this the common freeman's wergild (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 27. 30b), as a redemption of life. — In Cn departs from Eg arbitrarily, probably merely through carelessness</seg></note>
      </div>
