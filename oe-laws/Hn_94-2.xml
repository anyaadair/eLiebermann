    <body>
      <div type="clause" n="94.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 94.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 94.2" corresp="#wit-lat"><pb n="611" ed="#liebermann"/>Qui uulnus alicui faciet ac sanguinem, emendet hoc per uncias: ad singulas V den.<ptr type="liebermannNote" n="a" target="#Hn_94-2.lnote.oe.a"/> in cooperto; in nudo<ptr type="liebermannNote" n="b" target="#Hn_94-2.lnote.oe.b"/> pro singulis unciis X den.<ptr type="liebermannNote" n="a" target="#Hn_94-2.lnote.oe.a"/>; et remaneat<ptr type="liebermannNote" n="c" target="#Hn_94-2.lnote.oe.c"/> de<ptr type="liebermannNote" n="b" target="#Hn_94-2.lnote.oe.b"/> cecis<ptr type="liebermannNote" n="1" target="#Hn_94-2.lnote.oe.1"/> ictibus et belidentibus<ptr type="liebermannNote" n="d" target="#Hn_94-2.lnote.oe.d"/><ptr type="liebermannNote" n="2" target="#Hn_94-2.lnote.oe.2"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 611 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> Leis Wl 10, 1 <hi rend="italic">Denare statt</hi> 1 <hi rend="italic">bezw.</hi> 2 sol.</seg><seg type="translation" xml:lang="en" source="#claude">as in Leis Wl 10, 1, pence instead of 1 or 2 sol. respectively</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 93, 1; 3; 26</seg><seg type="translation" xml:lang="en" source="#claude">cf. 93, 1; 3; 26</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Blauwunde neben Blutwunde, dem schwereren Delict, häuft die Busse nicht: ‘vereinzelt’; Schreuer</hi> 126</seg><seg type="translation" xml:lang="en" source="#claude">a bruise alongside a bleeding wound, the graver offence, does not increase the compensation: ‘isolated’; Schreuer 126</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">von</hi> be-(h)lidan <hi rend="italic">decken,</hi> (<hi rend="italic">sich</hi>) <hi rend="italic">schliessen</hi></seg><seg type="translation" xml:lang="en" source="#claude">from be-(h)lidan to cover, to close (up)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">ceteris <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">ceteris Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so K Co Or Gi;</hi> belundintis <hi rend="italic">Sc;</hi> belidintis <hi rend="italic">Hg;</hi> blindintis, <hi rend="italic">ohne Hss., ändert Wi Tho, schief erklärend:</hi> ‘<hi rend="italic">ex</hi> blind <hi rend="italic">et</hi> dint’ [blindslite <hi rend="italic">heisst: nicht offene Wunde</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">so K Co Or Gi; belundintis Sc; belidintis Hg; blindintis, without MS authority, is Wi Tho's alteration, with the mistaken explanation ‘ex blind et dint’ [blindslite means: a wound that is not open]</seg></note>
      </div>
