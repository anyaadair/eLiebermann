    <body>
      <div type="clause" n="12">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 12</head>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-hk"><pb n="500–501" ed="#liebermann"/>Cil ki autrui femme purgist, si forfeit sun were vers sun seinur.</ab>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-i"><ptr type="liebermannNote" n="26" target="#LeisWl_12.lnote.oe.26"/><pb n="500–501" ed="#liebermann"/>Ki altrei<ptr type="liebermannNote" n="27" target="#LeisWl_12.lnote.oe.27"/> espouse<ptr type="liebermannNote" n="b" target="#LeisWl_12.lnote.oe.b"/> purgist, si forfait la were vers sun seignour<ptr type="liebermannNote" n="28" target="#LeisWl_12.lnote.oe.28"/>.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="500–501" ed="#liebermann"/>Si uiolat quis uxorem proximi. Si quis uxorem alterius legitimam uiolat, weram suam domino suo reddat.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="12" corresp="#wit-hk"><pb n="258" ed="#robertson"/>Cil ki autrui femme purgist, si forfeit sun were vers sun seinur.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="500–501" ed="#liebermann"/>12. Der welcher [Wenn jemand] beiliegt<ptr type="liebermannNote" n="1" target="#LeisWl_12.lnote.de.1"/> der (angetrauten<ptr type="liebermannNote" n="2" target="#LeisWl_12.lnote.de.2"/> <hi rend="italic">IL</hi>) Frau eines anderen, so verwirkt er sein<ptr type="liebermannNote" n="3" target="#LeisWl_12.lnote.de.3"/> Wergeld gegenüber seinem<ptr type="liebermannNote" n="g" target="#LeisWl_12.lnote.de1.g"/> Herrn.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">12. He who [If someone] lies with the (wedded <hi rend="italic">IL</hi>) wife of another, then he forfeits his wergild to his lord.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-hk"><pb n="259" ed="#robertson"/>He who assaults the wife of another man shall forfeit his wergeld to his lord.</ab>
        <note type="comparison" source="#liebermann" n="501"><ref target="clause:LeisWl_21-2">Leis Wl 21.2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">vgl. u. 21, 2</note>
        <note type="editorial">Added October 2026 from Robertson pp. 258–259 (text and translation); Liebermann’s text and German translation added from Gesetze I p. 500–501, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_12.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">500</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so auch L</hi></seg><seg type="translation" xml:lang="en" source="#claude">so also L</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_12.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">500</biblScope></bibl><seg type="original" xml:lang="de">XIIII. <hi rend="italic">I</hi></seg><seg type="translation" xml:lang="en" source="#claude">XIIII. I</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_12.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">500</biblScope></bibl><seg type="original" xml:lang="de">altri <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">altri Im</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_12.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">500</biblScope></bibl><seg type="original" xml:lang="de">seignor <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">seignor Im</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="LeisWl_12.lnote.de1.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">501</biblScope></bibl><seg type="original" xml:lang="de">ihrem Eheherrn <hi rend="italic">missversteht Chevallet. Gemeint ist <hi rend="spaced">Unzuchtstrafe</hi>. Vielleicht bestand die von</hi> Af. 10 <hi rend="italic">dem Ehemanne zugesprochene <hi rend="spaced">Busse</hi> noch daneben. Vgl. u.</hi> 35</seg><seg type="translation" xml:lang="en" source="#claude">Chevallet misunderstands this as ‘her husband’. What is meant is a <hi rend="italic">penalty</hi> for unchastity. Perhaps the <hi rend="italic">compensation</hi> awarded to the husband by Af. 10 still existed alongside it. Cf. below 35</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_12.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">288</biblScope></bibl><seg type="original" xml:lang="de">Über <hi rend="italic">purgesir s</hi>. W. Foerster in <hi rend="italic">Zschr. Rom. Philol</hi>. VI 415.—<hi rend="italic">Autrui</hi> falsch Dativ Schmid</seg><seg type="translation" xml:lang="en" source="#claude">On <hi rend="italic">purgesir see</hi> W. Foerster in <hi rend="italic">Zschr. Rom. Philol</hi>. VI 415.—<hi rend="italic">Autrui</hi> wrongly taken as a dative by Schmid</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_12.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">288</biblScope></bibl><seg type="original" xml:lang="de">Die Form Hk scheint älter</seg><seg type="translation" xml:lang="en" source="#claude">The form in Hk seems older</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_12.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">288</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘ihr Wergeld (<hi rend="italic">s. d. Gl</hi> 30s)’ laut <hi rend="italic">u</hi>. 13; gegen Moeller <hi rend="italic">Wergeld</hi> 32. <hi rend="italic">Vgl. Gl</hi> Ehebruch 11; Gerichtsbarkeit 38b.—Von Wilhelm I. <hi rend="italic">delicta impudicarum retabantur</hi>, rühmt Will. Pictav. ed. Giles 147</seg><seg type="translation" xml:lang="en" source="#claude">Not ‘her wergild (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 30s)’, according to <hi rend="italic">below</hi> 13; against Moeller <hi rend="italic">Wergeld</hi> 32. <hi rend="italic">Cf. Gl</hi> Ehebruch 11; Gerichtsbarkeit 38b.—Will. Pictav. ed. Giles 147 praises William I for the fact that <hi rend="italic">delicta impudicarum retabantur</hi></seg></note>
      </div>
    </body>
