        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_17.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">200</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Benutzt durch jene <hi rend="italic">Hom</hi>. 117 = 208</seg><seg type="translation" xml:lang="en" source="#claude">Used by those <hi rend="italic">Hom</hi>. 117 = 208</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_17.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">200</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">⁊ wifunga</hi> setzt eine Hs. <hi rend="italic">Hom</hi>. 117 hinzu, wie VI Atr 25; <hi rend="italic">s. Gl</hi> Eheschliessung 13a</seg><seg type="translation" xml:lang="en" source="#claude">One MS of <hi rend="italic">Hom</hi>. 117 adds <hi rend="italic">⁊ wifunga</hi>, as does VI Atr 25; see <hi rend="italic">Gl</hi> Eheschliessung 13a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_17.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">200</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">= <hi rend="italic">oð octabas Epiphanie Homil</hi>. wie V Atr 18 = VI 25</seg><seg type="translation" xml:lang="en" source="#claude">= <hi rend="italic">oð octabas Epiphanie Homil</hi>., as V Atr 18 = VI 25</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_17.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">200</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Wb: twelfta</hi>. Auch ein Kompositum <hi rend="italic">twelftamæsseæfen</hi> hat <hi rend="italic">Ann. Anglosax</hi>. 1066; <hi rend="italic">mæsse</hi> kann fortbleiben: <hi rend="italic">on twelftan dæg; ebd</hi>. 1065. <hi rend="italic">Vgl</hi>. Imelmann <hi rend="italic">Altengl. Menolog</hi> S. 23</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Wb: twelfta</hi>. A compound <hi rend="italic">twelftamæsseæfen</hi> also occurs in <hi rend="italic">Ann. Anglosax</hi>. 1066; <hi rend="italic">mæsse</hi> can be omitted: <hi rend="italic">on twelftan dæg; ibid</hi>. 1065. <hi rend="italic">Cf</hi>. Imelmann <hi rend="italic">Altengl. Menolog</hi> p. 23</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="ICn_17.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">350</biblScope></bibl><seg type="original" xml:lang="en">Cf. VI Atr. 25; Wulfstan, pp. 117, 208.</seg></note>
