      <div type="clause" n="50.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 50.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 50.1" corresp="#wit-lat"><pb n="573" ed="#liebermann"/>Si quis a domino uel prelato suo de nominatis<ptr type="liebermannNote" n="b" target="#Hn_50-1.lnote.oe.b"/> placitis secundum legem inplacitatus<ptr type="liebermannNote" n="4" target="#Hn_50-1.lnote.oe.4"/> ad diem condictum non uenerit, omnium placitorum de quibus nominatim inplacitabatur incurrit<ptr type="liebermannNote" n="c" target="#Hn_50-1.lnote.oe.c"/><ptr type="liebermannNote" n="5" target="#Hn_50-1.lnote.oe.5"/> emendaciones<ptr type="liebermannNote" n="6" target="#Hn_50-1.lnote.oe.6"/>, nisi competens aliquid<ptr type="liebermannNote" n="7" target="#Hn_50-1.lnote.oe.7"/> respectauerit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 573 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_50-1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 29, 3&lt;sup&gt;n&lt;/sup&gt;. 46, 1. 53, 1<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 29, 3&lt;sup&gt;n&lt;/sup&gt;. 46, 1. 53, 1a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_50-1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 29, 3<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 29, 3a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_50-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">plac. <hi rend="italic">K Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">plac. K Or</seg></note>
