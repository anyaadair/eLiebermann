      <div type="clause" n="1.2">
        <head><ref type="lawCode" target="law:IIIEg">III Eg</ref> 1.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.2" corresp="#wit-g-a"><pb n="200" ed="#liebermann"/>⁊ sý on þære bote swylc<ptr type="liebermannNote" n="6" target="#IIIEg_1-2.lnote.oe.6"/> forgifnes<ptr type="liebermannNote" n="7" target="#IIIEg_1-2.lnote.oe.7"/>, swylce hit for<ptr type="liebermannNote" n="8" target="#IIIEg_1-2.lnote.oe.8"/> Gode<ptr type="liebermannNote" n="9" target="#IIIEg_1-2.lnote.oe.9"/> gebeorglic sy ⁊ for worulde<ptr type="liebermannNote" n="10" target="#IIIEg_1-2.lnote.oe.10"/> aberendlic.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.2" corresp="#wit-a"><pb n="200" ed="#liebermann"/>⁊ sy on þære bote swilc forgyfnes, swilce swilce<ptr type="liebermannNote" n="1" target="#IIIEg_1-2.lnote.oe.1"/> hit for Gode gebeorhlic sy ⁊ for worulde aberendlic.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.2" corresp="#wit-d"><pb n="200" ed="#liebermann"/>⁊ sy on ðare bote swilc forgifnes, swilce hit for Gode gebeorhlic sy ⁊ for worlde aberendlic.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.2" corresp="#wit-q"><pb n="201" ed="#liebermann"/>Et sit in emendationibus remissio uenialis apud Deum et apud seculum tolerabilis.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="1.2" corresp="#wit-d"><pb n="24" ed="#robertson"/>⁊ sy on ðare bote swilc forgifnes, swilce<ptr type="editorNote" n="4" target="#IIIEg_1-2.robnote.fn.4"/> hit for Gode gebeorhlic sy ⁊ for worlde aberendlic.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="354" ed="#rabin-doml"/>And sy on þære bote swylc forgifnes, swylce hit for Gode gebeorglic sy and for worulde aberendlic.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="201" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#IIIEg_1-2.lnote.de.1"/> bei der [zuzuerkennenden] Bussenstrafe herrsche soweit Verzeihung, wie es sich vor Gott verantworten und im Staate ertragen lässt.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And in the [penalty of] compensation [to be awarded] let there be such leniency as can be justified before God and tolerated in the world.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d"><pb n="25" ed="#robertson"/>And that there be such remission in the case of compensations as shall be justifiable in the sight of God and acceptable in the eyes of men<ptr type="editorNote" n="1" target="#IIIEg_1-2.robnote.n.1"/>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="436" ed="#whitelock"/>And there is to be such remission in the compensation as is justifiable before God and supportable in the state.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="355" ed="#rabin-doml"/>And that penalties are to be assessed with such leniency as would be fitting before God and acceptable in the eyes of the world.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VIAtr_10-2">VI Atr 10.2</ref></note>
        <note type="comparedBy" source="#wormald-ppmel" n="93"><label>=</label> <ref target="clause:VIAtr_10-2">VI Atr 10.2</ref> <quote>III Eg 1:2 = VI Atr 10:2</quote></note>
        <note type="comparedBy" source="#whitelock" n="460"><label>same thing meant as</label> <ref target="clause:Cn1020_11">Cn 1020 11</ref> <quote>on the assumption that the same thing is meant as in III Edgar 1.2</quote></note>
        <note type="editorial">A writes ‘swilce’ twice.</note>
        <note type="textual" source="#rabin-doml">swylce: swilce swilce A</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEg_1-2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">200</biblScope></bibl><seg type="original" xml:lang="de">swylce <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">swylce Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEg_1-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">200</biblScope></bibl><seg type="original" xml:lang="de">-gyfenesse <hi rend="italic">So;</hi> -gyfenisse <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gyfenesse So; -gyfenisse Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEg_1-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">200</biblScope></bibl><seg type="original" xml:lang="de">fore <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fore Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEg_1-2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">200</biblScope></bibl><seg type="original" xml:lang="de">God <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">God So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEg_1-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">200</biblScope></bibl><seg type="original" xml:lang="de">-ld <hi rend="italic">So;</hi> weoruld <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ld So; weoruld Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEg_1-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">200</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so doppelt</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus doubled</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIIEg_1-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">136</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Dies wiederholt inhaltlich, und letzte Zeile wörtlich, VI Atr 10 = II Cn 2; <hi rend="italic">vgl</hi>. Cn 1020, 11; <hi rend="italic">Gl</hi> Barmherzigkeit 3; Gott 1, der hier für ‘moralische Ordnung’ steht, im Ggs. zur strengen des Staats wie IV As 3, 2</seg><seg type="translation" xml:lang="en" source="#claude">VI Atr 10 = II Cn 2 repeats this in substance, and the last line word for word; <hi rend="italic">cf.</hi> Cn 1020, 11; <hi rend="italic">Gl</hi> Barmherzigkeit 3; Gott 1, who here stands for ‘moral order’, in contrast to the strict order of the State, as in IV As 3, 2</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIEg_1-2.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">303</biblScope></bibl><seg type="original" xml:lang="en">Cf. VI Atr. 10, 1; II Cn. 2.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIEg_1-2.robnote.fn.4" n="4" source="#robertson"><bibl><biblScope unit="page">24</biblScope></bibl><label>swilce</label><seg type="original" xml:lang="en"><hi rend="italic">swilce swilce</hi> A.</seg></note>
      </div>
    </body>
  </text>
