      <div type="clause" n="5.17a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.17a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.17a" corresp="#wit-lat"><pb n="550" ed="#liebermann"/>Et<ptr type="liebermannNote" n="f" target="#Hn_5-17a.lnote.oe.f"/> si quando episcopus dicit<ptr type="liebermannNote" n="11" target="#Hn_5-17a.lnote.oe.11"/>, aliquem sibi soli<ptr type="liebermannNote" n="12" target="#Hn_5-17a.lnote.oe.12"/> fuisse confessum proprium crimen, et ille neget, non putet episcopus, ad iniuriam suam<ptr type="liebermannNote" n="13" target="#Hn_5-17a.lnote.oe.13"/> pertinere<ptr type="liebermannNote" n="14" target="#Hn_5-17a.lnote.oe.14"/>, quod sibi soli non creditur, etsi scrupulo conscientie sue dicat, se ei nolle communicare.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 550 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-17a.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch Ivo</hi> Decr. V 363; <hi rend="italic">Ps.-Is. p.</hi> 316; <hi rend="italic">Gr.</hi> C. VI q. 2 c. 3</seg><seg type="translation" xml:lang="en" source="#claude">also Ivo Decr. V 363; Ps.-Is. p. 316; Gr. C. VI q. 2 c. 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-17a.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">al. dicat <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">al. dicat K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-17a.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-17a.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">non <hi rend="italic">fügt zu Sc Hg K</hi></seg><seg type="translation" xml:lang="en" source="#claude">non added by Sc Hg K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-17a.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">550</biblScope></bibl><seg type="original" xml:lang="de">penitere <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">penitere Lond</seg></note>
