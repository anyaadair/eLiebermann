    <body>
      <div type="clause" n="2.3">
        <head><ref type="lawCode" target="law:IudDeiV">Iud Dei V</ref> 2.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei V 2.3" corresp="#wit-du"><pb n="412" ed="#liebermann"/>nec patiaris ab illa<ptr type="liebermannNote" n="4" target="#IudDeiV_2-3.lnote.oe.4"/> inpune baiulari, sed in nomine Domini et inperio uirtutis eius aefficiaris<ptr type="liebermannNote" n="5" target="#IudDeiV_2-3.lnote.oe.5"/> ei in conbustionem et contra pietatem adque<ptr type="liebermannNote" n="6" target="#IudDeiV_2-3.lnote.oe.6"/> ostensionem nequitie eius, necnon aduersaris ei, quia aduersatus est Creaturi<ptr type="liebermannNote" n="5" target="#IudDeiV_2-3.lnote.oe.5"/> tuo;</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei V 2.3" corresp="#wit-gl"><pb n="412" ed="#liebermann"/>ne æc giðole ðv fro<hi rend="italic">m</hi> ðær vnapinedlic þ<hi rend="italic">æt</hi>te sie aboren, ah on nome Driht<hi rend="italic">nes</hi> ⁊ mið hæs mægnes his ðu sie gifre<hi rend="italic">m</hi>med him on byrne ⁊ við arfæstnise ⁊ æc eavdnise woghfvlnisse his, no ðon læs sceððendum<ptr type="liebermannNote" n="7" target="#IudDeiV_2-3.lnote.oe.7"/> his, f<hi rend="italic">or</hi>ðon giwiðirworded, is giscefte<ptr type="liebermannNote" n="8" target="#IudDeiV_2-3.lnote.oe.8"/> ðinv<hi rend="italic">m</hi>;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 412 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_2-3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">412</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> illo</seg><seg type="translation" xml:lang="en" source="#claude">read illo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_2-3.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">412</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_2-3.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">412</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">‘und zu’, nicht</hi> atque</seg><seg type="translation" xml:lang="en" source="#claude">‘and to’, not atque</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_2-3.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">412</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">statt des</hi> aduerseris <hi rend="italic">zu bessernden Lateins missversteht Glossator</hi> aduersariis eius</seg><seg type="translation" xml:lang="en" source="#claude">where the Latin should be emended to aduerseris, the glossator misunderstands aduersariis eius</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_2-3.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">412</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">statt des</hi> Creatori <hi rend="italic">zu bessernden Lateins missversteht Glossator</hi> creature; <hi rend="italic">vgl. IV</hi> 2</seg><seg type="translation" xml:lang="en" source="#claude">where the Latin should be emended to Creatori, the glossator misunderstands creature; cf. IV 2</seg></note>
      </div>
