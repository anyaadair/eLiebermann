      <div type="clause" n="19">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 19</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 19"><pb n="644" ed="#liebermann"/><hi rend="bold"><hi rend="spaced">De uxoribus</hi></hi><ptr type="liebermannNote" n="32" target="#ECfRetr_19.lnote.la.32"/> <hi rend="bold"><hi rend="spaced">malefactorum</hi></hi><ptr type="liebermannNote" n="33" target="#ECfRetr_19.lnote.la.33"/> <hi rend="bold"><hi rend="spaced">et filiis eorum.</hi></hi> Si <hi rend="bold">quidem tales</hi> habuerint uxores<ptr type="liebermannNote" n="34" target="#ECfRetr_19.lnote.la.34"/> suas in <hi rend="bold">patria subsistentes</hi><ptr type="liebermannNote" n="35" target="#ECfRetr_19.lnote.la.35"/>, et dixerit aliquis parentum murdriti<ptr type="liebermannNote" n="36" target="#ECfRetr_19.lnote.la.36"/>, eas <hi rend="bold">nequitie</hi> fuisse <hi rend="bold">participes,</hi> expurgent se iudicio Dei.</ab>
        <note type="comparison" source="#liebermann" n="644"><label>printed alongside</label> <ref target="clause:ECf_19">ECf 19</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 644 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_19.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> De u. reorum <hi rend="italic">Pl S;</hi> De paruis qui nati sunt post malefactum <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">only De u. reorum Pl S; De paruis qui nati sunt post malefactum Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_19.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">et f. dampnatorum <hi rend="italic">Db;</hi> captiuorum et iniquorum et de pueris (-ribus <hi rend="italic">K</hi>) illorum <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">et f. dampnatorum Db; captiuorum et iniquorum et de pueris (-ribus K) illorum Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_19.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">s. u. <hi rend="italic">Cb Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. u. Cb Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_19.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">exist. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">exist. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_19.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">murdrati <hi rend="italic">Hv Va K;</hi> -redi <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">murdrati Hv Va K; -redi Ph</seg></note>
      </div>
