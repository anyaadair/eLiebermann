        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 4</seg><seg type="translation" xml:lang="en" source="#claude">see above 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de">Ex. <hi rend="italic">roth Ti;</hi> Ipsa anathematizatio <hi rend="italic">Vb;</hi> Ex conc. Rotomag. <hi rend="italic">überschr. Reginos Abschreiber Burchard; Ivo</hi> Decr. XIV 76; Coll. 12 part. X 233</seg><seg type="translation" xml:lang="en" source="#claude">Ex. in red Ti; Ipsa anathematizatio Vb; Regino’s copyist Burchard gives the heading Ex conc. Rotomag.; Ivo Decr. XIV 76; Coll. 12 part. X 233</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de">-nunt <hi rend="italic">darüber Ti</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nunt above it Ti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de">quę, <hi rend="italic">geänd.</hi> quod <hi rend="italic">Ti</hi></seg><seg type="translation" xml:lang="en" source="#claude">quę, altered to quod Ti</seg></note>
