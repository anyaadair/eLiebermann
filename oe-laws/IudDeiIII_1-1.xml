      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:IudDeiIII">Iud Dei III</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei III 1.1" corresp="#wit-lat"><pb n="408" ed="#liebermann"/>Conseruator<ptr type="liebermannNote" n="8" target="#IudDeiIII_1-1.lnote.oe.8"/> et creator humani generis<ptr type="liebermannNote" n="9" target="#IudDeiIII_1-1.lnote.oe.9"/>, dator gratiae spiritalis<ptr type="liebermannNote" n="10" target="#IudDeiIII_1-1.lnote.oe.10"/>, largitor aeternae salutis, tu emitte Spiritum tuum super hanc creaturam panis uel casei cum tremore<ptr type="liebermannNote" n="11" target="#IudDeiIII_1-1.lnote.oe.11"/> et timore magnitudinis brachii<ptr type="liebermannNote" n="12" target="#IudDeiIII_1-1.lnote.oe.12"/> tui aduersus eum<ptr type="liebermannNote" n="13" target="#IudDeiIII_1-1.lnote.oe.13"/>, qui cum superbia et contumacia ac zelo iniquo uenit<ptr type="liebermannNote" n="14" target="#IudDeiIII_1-1.lnote.oe.14"/> et uult<ptr type="liebermannNote" n="15" target="#IudDeiIII_1-1.lnote.oe.15"/> subuertere iustitiam<ptr type="liebermannNote" n="16" target="#IudDeiIII_1-1.lnote.oe.16"/> et conculcare iudicium<ptr type="liebermannNote" n="17" target="#IudDeiIII_1-1.lnote.oe.17"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 408 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ungefähr ähnlich Zeu.</hi> 692₃₂</seg><seg type="translation" xml:lang="en" source="#claude">roughly similar Zeu. 692₃₂</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">domine Deus <hi rend="italic">fügt zu Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">domine Deus added in Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> -tualis <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">altered to -tualis H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">ti. et tr. <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">ti. et tr. H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">brahii <hi rend="italic">Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">brahii Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">-os <hi rend="italic">übergeschr. H; stets Plural darüber auch Ci;</hi> uel eos <hi rend="italic">übergeschr. Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">-os written above in H; Ci too always has the plural written above; uel eos written above in Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">-unt <hi rend="italic">übergeschr. Rj H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-unt written above in Rj H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">uolunt <hi rend="italic">übergeschr. Rj Ci H</hi></seg><seg type="translation" xml:lang="en" source="#claude">uolunt written above in Rj Ci H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">Dei <hi rend="italic">fügt zu Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">Dei added in Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">ueritatis <hi rend="italic">fügt zu Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">ueritatis added in Ch</seg></note>
      </div>
