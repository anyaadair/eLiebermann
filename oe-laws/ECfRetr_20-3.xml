    <body>
      <div type="clause" n="20.3">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 20.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 20.3"><pb n="646" ed="#liebermann"/><hi rend="bold">Sed</hi> si infra predictum<ptr type="liebermannNote" n="1" target="#ECfRetr_20-3.lnote.la.1"/> terminum inueniri non posset, quia in omni friborgo<ptr type="liebermannNote" n="2" target="#ECfRetr_20-3.lnote.la.2"/> unus erat capitalis, quem uocabant friborges<ptr type="liebermannNote" n="3" target="#ECfRetr_20-3.lnote.la.3"/> heauod<ptr type="liebermannNote" n="4" target="#ECfRetr_20-3.lnote.la.4"/>, ipse capitalis <hi rend="bold">sumeret</hi> duos de melioribus sui<ptr type="liebermannNote" n="5" target="#ECfRetr_20-3.lnote.la.5"/> friborgi<ptr type="liebermannNote" n="6" target="#ECfRetr_20-3.lnote.la.6"/> et de tribus friborgis<ptr type="liebermannNote" n="7" target="#ECfRetr_20-3.lnote.la.7"/> <hi rend="bold">sibi</hi> propinquioribus acciperet de unoquoque capitalem et duos de melioribus <hi rend="bold">uniuscuiusque</hi><ptr type="liebermannNote" n="8" target="#ECfRetr_20-3.lnote.la.8"/> <hi rend="bold">friborgi</hi><ptr type="liebermannNote" n="9" target="#ECfRetr_20-3.lnote.la.9"/>, si posset habere<ptr type="liebermannNote" n="10" target="#ECfRetr_20-3.lnote.la.10"/>, et <hi rend="bold">ita</hi><ptr type="liebermannNote" n="11" target="#ECfRetr_20-3.lnote.la.11"/>, se duodecimo <hi rend="bold">existente</hi><ptr type="liebermannNote" n="12" target="#ECfRetr_20-3.lnote.la.12"/>, purgaret<ptr type="liebermannNote" n="13" target="#ECfRetr_20-3.lnote.la.13"/> se et<ptr type="liebermannNote" n="14" target="#ECfRetr_20-3.lnote.la.14"/> friborgum<ptr type="liebermannNote" n="15" target="#ECfRetr_20-3.lnote.la.15"/> suum, si facere posset, de forisfacto et fuga supradicti malefactoris.</ab>
        <note type="comparison" source="#liebermann" n="646"><label>printed alongside</label> <ref target="clause:ECf_20-3">ECf 20.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 646 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-3.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 24, 1. <hi rend="italic">Dem Verfasser ist die Freibürgschaft territorialisirt, nicht rein persönlich</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 24, 1. For the author the frankpledge is territorial, not purely personal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-3.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">t. p. <hi rend="italic">Va Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. p. Va Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-3.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">fritheb. <hi rend="italic">Lb Va;</hi> fritheburgo <hi rend="italic">Ph;</hi> frithb. <hi rend="italic">Hv Ld;</hi> friburgo <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">fritheb. Lb Va; fritheburgo Ph; frithb. Hv Ld; friburgo K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-3.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">frithb. <hi rend="italic">Hv;</hi> fritheb. <hi rend="italic">Lb Va;</hi> frithes borges <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">frithb. Hv; fritheb. Lb Va; frithes borges Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-3.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Va K;</hi> heued <hi rend="italic">Cb Hv;</hi> heofod <hi rend="italic">Ld;</hi> heauot <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Va K; heued Cb Hv; heofod Ld; heauot Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-3.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">suorum frithborgorum <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">suorum frithborgorum Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-3.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">fritheb. <hi rend="italic">Ph Va;</hi> frithb. <hi rend="italic">Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">fritheb. Ph Va; frithb. Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-3.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">fritheb. <hi rend="italic">Ph Va;</hi> frithb. <hi rend="italic">Hv K Ld;</hi> fridb. <hi rend="italic">Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">fritheb. Ph Va; frithb. Hv K Ld; fridb. Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-3.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">sui <hi rend="italic">Va Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">sui Va Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-3.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">frithb. <hi rend="italic">Hv;</hi> fritheb. <hi rend="italic">Ph Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">frithb. Hv; fritheb. Ph Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-3.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. aus</hi> -ret <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected from -ret Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-3.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">inde <hi rend="italic">Va Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">inde Va Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-3.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv besser</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking, which is better, in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-3.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">expurg. <hi rend="italic">ohne</hi> se <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">expurg. without se Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-3.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-3.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">fridb. <hi rend="italic">Va Ph;</hi> frithb. <hi rend="italic">Lb Hv;</hi> friðb. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fridb. Va Ph; frithb. Lb Hv; friðb. Ld</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But if he could not be found within the aforesaid term, since in every frankpledge there was one head, whom they called <hi rend="italic">friborges heauod</hi> (head of the frankpledge), that head should take two of the better men of his frankpledge, and from the three frankpledges nearest to him should take from each the head and two of the better men of each frankpledge, if he could have them, and so, being himself the twelfth, should clear himself and his frankpledge, if he could do so, of the offence and the flight of the abovementioned evildoer.</ab>
      </div>
