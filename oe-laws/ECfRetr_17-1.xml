    <body>
      <div type="clause" n="17.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 17.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 17.1"><pb n="643" ed="#liebermann"/><hi rend="bold">Quod nisi fecerit, nec</hi><ptr type="liebermannNote" n="1" target="#ECfRetr_17-1.lnote.la.1"/> <hi rend="bold">regis nomen</hi><ptr type="liebermannNote" n="2" target="#ECfRetr_17-1.lnote.la.2"/> <hi rend="bold">constabit</hi><ptr type="liebermannNote" n="3" target="#ECfRetr_17-1.lnote.la.3"/><hi rend="bold">, uerum,</hi> testante<ptr type="liebermannNote" n="4" target="#ECfRetr_17-1.lnote.la.4"/> papa Iohanne, nomen regis perdit<ptr type="liebermannNote" n="5" target="#ECfRetr_17-1.lnote.la.5"/>. Cui<ptr type="liebermannNote" n="6" target="#ECfRetr_17-1.lnote.la.6"/> Pipinus et Karolus, filius eius, necdum reges, sed principes sub rege Francorum<ptr type="liebermannNote" n="7" target="#ECfRetr_17-1.lnote.la.7"/> stulto<ptr type="liebermannNote" n="8" target="#ECfRetr_17-1.lnote.la.8"/>, scripserunt, querentes, si ita <hi rend="bold">per</hi>manere deberent Francorum<ptr type="liebermannNote" n="9" target="#ECfRetr_17-1.lnote.la.9"/> reges, solo regio<ptr type="liebermannNote" n="10" target="#ECfRetr_17-1.lnote.la.10"/> nomine contenti? A quo responsum est: ‘Illos decet uocari reges, qui uigilanter<ptr type="liebermannNote" n="11" target="#ECfRetr_17-1.lnote.la.11"/> defendunt et regunt ecclesiam Dei et populum eius’, imitati<ptr type="liebermannNote" n="12" target="#ECfRetr_17-1.lnote.la.12"/> regem psalmigraphum<ptr type="liebermannNote" n="13" target="#ECfRetr_17-1.lnote.la.13"/> dicentem: ‘Non habitabit in medio domus mee qui facit superbiam’ et cetera<ptr type="liebermannNote" n="14" target="#ECfRetr_17-1.lnote.la.14"/>.</ab>
        <note type="comparison" source="#liebermann" n="643"><label>printed alongside</label> <ref target="clause:ECf_17-1">ECf 17.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Ps. 100, 7</note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 643 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">Liebermann’s footnotes a and b are printed under the ECf column; they are given here as well.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17-1.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Thronverlust bestimmt dem pflichtvergessenen Herrscher Gregor VII.; vgl. Böhmer</hi> Staat und Kirche 416; <hi rend="italic">vielleicht dachte Verf. an Robert von der Normandie</hi> 1106 <hi rend="italic">und der Retractor an Stephan</hi> 1141 <hi rend="italic">oder</hi> 1154</seg><seg type="translation" xml:lang="en" source="#claude">Gregory VII decrees loss of the throne for a ruler forgetful of his duty; cf. Böhmer, Staat und Kirche 416; perhaps the author was thinking of Robert of Normandy in 1106, and the Retractator of Stephen in 1141 or 1154</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17-1.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">Zacharias (751—52), <hi rend="italic">wie im</hi> 16. <hi rend="italic">Jahrh. Va in Retr. bessert; vgl. S.</hi> 635<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">Zacharias (751–52), as Va corrects in the Retr. in the 16th century; cf. p. 635, note b</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17-1.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">nomen r. non in <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">nomen r. non in K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17-1.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">in eo <hi rend="italic">fügt zu Lb Lond Ph Sp L</hi></seg><seg type="translation" xml:lang="en" source="#claude">Lb Lond Ph Sp L add in eo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17-1.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">u. c. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. c. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17-1.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">p. Zacharia t. <hi rend="italic">Va;</hi> p. I. t. <hi rend="italic">Cb Lb Lond Ph;</hi> p. I. atestante <hi rend="italic">Ra;</hi> propheta I. t. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. Zacharia t. Va; p. I. t. Cb Lb Lond Ph; p. I. atestante Ra; propheta I. t. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17-1.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">et cetera <hi rend="italic">übergeschr. Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">et cetera written above Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17-1.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">[<hi rend="italic">statt</hi> Cui] qui quod regis est non faciat. Audientes autem P. <hi rend="italic">nur Eine spätere Hs. Hv’s;</hi> cum <hi rend="italic">fügt zu, aber unterpunctirt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">[instead of Cui] qui quod regis est non faciat. Audientes autem P. only one later MS of Hv’s; Cb adds cum, but dotted for deletion</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17-1.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">hanc diffinitiuam sententiam tam ueraciter quam prudenter de regis nomine a Willelmo notho rege Anglie prolatam ei <hi rend="italic">fügt zu nur Eine spätere Hs. Hv’s</hi> [<hi rend="italic">unsinnig</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">only one later MS of Hv’s adds hanc diffinitiuam sententiam tam ueraciter quam prudenter de regis nomine a Willelmo notho rege Anglie prolatam ei [senseless]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17-1.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">Childerico <hi rend="italic">fügt zu Va;</hi> stulte sc., ab eo q. <hi rend="italic">dieselbe Hs. Hv’s</hi></seg><seg type="translation" xml:lang="en" source="#claude">Va adds Childerico; stulte sc., ab eo q. the same MS of Hv’s</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17-1.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">r. F. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. F. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17-1.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">no. regis <hi rend="italic">Hv; fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">no. regis Hv; lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17-1.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">u. r. et d. <hi rend="italic">Cb;</hi> uigilant, d. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. r. et d. Cb; uigilant, d. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17-1.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">-tantes <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tantes Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17-1.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert</hi> -mogr. <hi rend="italic">Cb;</hi> -mogr. <hi rend="italic">Va Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected to -mogr. Cb; -mogr. Va Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_17-1.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">643</biblScope></bibl><seg type="original" xml:lang="de">Hec hactenus <hi rend="italic">fügt zu Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cb adds Hec hactenus</seg></note>
      </div>
    </body>
