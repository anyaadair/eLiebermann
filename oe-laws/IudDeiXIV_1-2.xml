        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIV 1.2" corresp="#wit-lat"><ptr type="liebermannNote" n="7" target="#IudDeiXIV_1-2.lnote.oe.7"/><pb n="425" ed="#liebermann"/>Et<ptr type="liebermannNote" n="8" target="#IudDeiXIV_1-2.lnote.oe.8"/> antequam diuidantur<ptr type="liebermannNote" n="9" target="#IudDeiXIV_1-2.lnote.oe.9"/>, scribe<ptr type="liebermannNote" n="10" target="#IudDeiXIV_1-2.lnote.oe.10"/> ‘Pater noster’ in utroque, et<ptr type="liebermannNote" n="11" target="#IudDeiXIV_1-2.lnote.oe.11"/> postea sic debes benedicere.</ab>
