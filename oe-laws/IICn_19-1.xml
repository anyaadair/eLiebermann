    <body>
      <div type="clause" n="19.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 19.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19.1" corresp="#wit-g-a"><pb n="322" ed="#liebermann"/>Gif he æt þam þriddan cyrre<ptr type="liebermannNote" n="3" target="#IICn_19-1.lnote.oe.3-2"/> nan riht næbbe<ptr type="liebermannNote" n="4" target="#IICn_19-1.lnote.oe.4"/>, þonne fare he<ptr type="liebermannNote" n="5" target="#IICn_19-1.lnote.oe.5"/> feorðan siðe<ptr type="liebermannNote" n="6" target="#IICn_19-1.lnote.oe.6"/> to scirgemote<ptr type="liebermannNote" n="7" target="#IICn_19-1.lnote.oe.7"/>, ⁊ seo scir<ptr type="liebermannNote" n="8" target="#IICn_19-1.lnote.oe.8"/> him sette þone<ptr type="liebermannNote" n="9" target="#IICn_19-1.lnote.oe.9"/> feorðan andagan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19.1" corresp="#wit-b"><pb n="322" ed="#liebermann"/>Gyf he æt ðam ðriddan cyrre nan riht næbbe, ðonne fare he feorðan siðe to scirgemote, ⁊ seo scir him sette ðone feorðan andagan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19.1" corresp="#wit-a"><pb n="322" ed="#liebermann"/>Gif he æt þam þriddam<ptr type="liebermannNote" n="1" target="#IICn_19-1.lnote.oe.1"/> cyre nan riht nabbe, þonne fare he æt þam feorðam syðe to scyrgemote, ⁊ seo scyr hi<hi rend="italic">m</hi> sette þanne feorðan<ptr type="liebermannNote" n="2" target="#IICn_19-1.lnote.oe.2-3"/> ðon andagan.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="19.1" corresp="#wit-q"><pb n="323" ed="#liebermann"/>Si tercia uice rectum non habeat, eat quarta uice ad conuentum totius comitatus, quod Anglice dicitur syremotus, et ipse comitatus ponat ei quartum<ptr type="liebermannNote" n="2" target="#IICn_19-1.lnote.oe.2-2"/> terminum.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="19.1" corresp="#wit-inst-cn"><pb n="323" ed="#liebermann"/>Quodsi uice tertia rectum habere non poterit, eat ad comitatum et ostendat, se iam tercio<ptr type="liebermannNote" n="1" target="#IICn_19-1.lnote.oe.1-2"/> hundredum adiisse, rectum<ptr type="liebermannNote" n="2" target="#IICn_19-1.lnote.oe.2-4"/> requisisse et habere non potuisse; tunc comitatus statuat illi<ptr type="liebermannNote" n="3" target="#IICn_19-1.lnote.oe.3-3"/> diem, in quo qui calumniatur<ptr type="liebermannNote" n="4" target="#IICn_19-1.lnote.oe.4-2"/> faciat<ptr type="liebermannNote" n="5" target="#IICn_19-1.lnote.oe.5-2"/> rectum.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="19.1" corresp="#wit-cons-cn"><pb n="323" ed="#liebermann"/>Ubi tercio si iusticia sibi defecerit, quarto petat comitatus conuentum, qui ei quartum terminum ponat.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="19.1" corresp="#wit-b"><pb n="182" ed="#robertson"/>Gyf he æt ðam ðriddan cyrre nan riht næbbe, ðonne fare he feorðan siðe<ptr type="editorNote" n="13" target="#IICn_19-1.robnote.fn.13"/> to scirgemote ⁊ seo scir him sette ðone feorðan andagan.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="262" ed="#rabin-doml"/>Gif he æt þam þriddan cyrre nan riht næbbe, þonne fare he feorðan siðe to scirgemote, and seo scir him sette þone feorðan andagan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="322" ed="#liebermann"/>Wenn er beim dritten Male kein Recht erlangt, dann [erst] ziehe<ptr type="liebermannNote" n="1" target="#IICn_19-1.lnote.de.1"/> er zum vierten Male zum Grafschaftsgerichte; und die Grafschaft setze ihm (dann <hi rend="italic">A</hi>) den vierten Termin.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he obtains no right the third time, then [only] let him go the fourth time to the shire-court; and let the shire set him (then, A) the fourth term.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="183" ed="#robertson"/>If on the third occasion he does not obtain justice, he shall go on the fourth occasion to the shire court, and the shire court shall appoint a day when he shall issue his summons for the fourth time.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="464" ed="#whitelock"/>If on the third occasion he cannot obtain right, he is then the fourth time to go to the shire-meeting, and the shire is to appoint for him the fourth term [for settlement].</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="263" ed="#rabin-doml"/>If he does not receive what is rightfully owed him after the third petition, then he shall appeal on a fourth occasion to the shire court, and the shire court shall set a day for the fourth hearing.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_44-1">Leis Wl 44.1</ref></note>
        <note type="editorial">BR: added from Gesetze I p. 323, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">he feorðan: he æt þam feorðam A</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de">si i. sibi t. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">si i. sibi t. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de">comm. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">comm. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de">t. q. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. q. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de">cyre <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyre Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de">nabbe, ðan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">nabbe, ðan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de">æt þam <hi rend="italic">fügt zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">æt þam added by Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de">syþe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">syþe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de">scyreg. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">scyreg. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de">scyre <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">scyre Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de">þonne feorðan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þonne feorðan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de">feordanðon <hi rend="italic">A; entweder</hi> ðon <hi rend="italic">zu streichen oder</hi> þ. [tunc; <hi rend="italic">vgl. Inst.</hi>] ð. f. a. <hi rend="italic">umzustellen</hi></seg><seg type="translation" xml:lang="en" source="#claude">feordanðon A; either ðon is to be deleted or þ. [tunc; cf. Inst.] ð. f. a. is to be transposed</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de">ter <hi rend="italic">Di</hi></seg><seg type="translation" xml:lang="en" source="#claude">ter Di</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.2-4" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de">req. rec. <hi rend="italic">Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">req. rec. Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.3-3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de">sibi <hi rend="italic">Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">sibi Lb S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de">-tus est <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tus est Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_19-1.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de">ei <hi rend="italic">fügt zu Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei added by Lb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_19-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">205</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Nicht etwa zur Berufung gegen früheres Urteil, sondern nur behufs Erzielung der Prozesseinlassung samt Urteilserfüllung; Adams <hi rend="italic">Essays in Agsa. law</hi> 24</seg><seg type="translation" xml:lang="en" source="#claude">Not, say, for an appeal against an earlier judgment, but only for the purpose of obtaining the defendant's appearance in the suit together with fulfilment of the judgment; Adams <hi rend="italic">Essays in Agsa. law</hi> 24</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_19-1.robnote.fn.13" n="13" source="#robertson"><bibl><biblScope unit="page">182</biblScope></bibl><label>siðe</label><seg type="original" xml:lang="en"><hi rend="italic">æt þam f. s.</hi> A, Ld.</seg></note>
