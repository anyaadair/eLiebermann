      <div type="clause" n="59.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.1a" corresp="#wit-lat"><pb n="577" ed="#liebermann"/>Si<ptr type="liebermannNote" n="27" target="#Hn_59-1a.lnote.oe.27"/> non sit contramandatus — nisi erga eos<ptr type="liebermannNote" n="o" target="#Hn_59-1a.lnote.oe.o"/> qui non<ptr type="liebermannNote" n="28" target="#Hn_59-1a.lnote.oe.28"/> frangunt causam suam —, reus<ptr type="liebermannNote" n="p" target="#Hn_59-1a.lnote.oe.p"/> erit qui remanserit, nisi repentine infirmitatis<ptr type="liebermannNote" n="q" target="#Hn_59-1a.lnote.oe.q"/> aut domini<ptr type="liebermannNote" n="r" target="#Hn_59-1a.lnote.oe.r"/> neccessitatis aut<ptr type="liebermannNote" n="29" target="#Hn_59-1a.lnote.oe.29"/> exercitus<ptr type="liebermannNote" n="30" target="#Hn_59-1a.lnote.oe.30"/> uel suorum causa hostium uel iusticie regis competens detencio liberauerit<ptr type="liebermannNote" n="31" target="#Hn_59-1a.lnote.oe.31"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 577 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1a.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Herrschaft (vgl.</hi> 61, 3) <hi rend="italic">und Krone, deren Klage durch ihre Terminversäumniss nicht erlischt</hi></seg><seg type="translation" xml:lang="en" source="#claude">lordship (cf. 61, 3) and Crown, whose suit does not lapse through their failure to appear on the appointed day</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1a.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 60, 1<hi rend="italic">b</hi>. 61, 1</seg><seg type="translation" xml:lang="en" source="#claude">as in 60, 1<hi rend="italic">b</hi>. 61, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1a.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 41, 2<hi rend="italic">b</hi>. 59, 4</seg><seg type="translation" xml:lang="en" source="#claude">as in 41, 2<hi rend="italic">b</hi>. 59, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1a.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 60, 2. 61, 6; 6<hi rend="italic">a</hi>; 7</seg><seg type="translation" xml:lang="en" source="#claude">as in 60, 2. 61, 6; 6<hi rend="italic">a</hi>; 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-1a.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">sit <hi rend="italic">fügt zu Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit added by Or</seg></note>
