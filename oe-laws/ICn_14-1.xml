    <body>
      <div type="clause" n="14.1">
        <head><ref type="lawCode" target="law:ICn">I Cn</ref> 14.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="14.1" corresp="#wit-g-a"><pb n="294" ed="#liebermann"/>And<ptr type="liebermannNote" n="21" target="#ICn_14-1.lnote.oe.21"/> freolsa ⁊ fæstena<ptr type="liebermannNote" n="22" target="#ICn_14-1.lnote.oe.22"/> healde mon<ptr type="liebermannNote" n="23" target="#ICn_14-1.lnote.oe.23"/> rihtlice.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="14.1" corresp="#wit-a"><pb n="294" ed="#liebermann"/>⁊ freolsa ⁊ festena healde man<ptr type="liebermannNote" n="2" target="#ICn_14-1.lnote.oe.2"/>:</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="14.1" corresp="#wit-b"><pb n="294" ed="#liebermann"/>. . . . . . . . . . . . .</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="14.1" corresp="#wit-q"><pb n="294" ed="#liebermann"/>in festiuitatibus, in<ptr type="liebermannNote" n="15" target="#ICn_14-1.lnote.oe.15"/> ieiuniis,</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="14.1" corresp="#wit-cons-cn"><pb n="295" ed="#liebermann"/>Et festa et ieiunia recte obseruentur.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="14.1" corresp="#wit-g-a"><pb n="166" ed="#robertson"/>And freolsa ⁊ fæstena healde mon rihtlice<ptr type="editorNote" n="2" target="#ICn_14-1.robnote.fn.2"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="244" ed="#rabin-doml"/>And freolsa and fæstena healde mon rihtlice.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="295" ed="#liebermann"/>Und Feiertage und Fasten halte man gesetzmässig.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let feasts and fasts be kept lawfully.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-g-a"><ptr type="editorNote" n="1" target="#ICn_14-1.robnote.n.1"/><pb n="167" ed="#robertson"/>And festivals and fasts shall be duly observed.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="245" ed="#rabin-doml"/>And feasts and fasts are to be properly observed.</ab>
        <note type="comparison" source="#liebermann" n="295"><ref target="clause:VIAtr_22">VI Atr 22</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 22</note>
        <note type="comparison" source="#wormald-ppmel" n="56"><label>anthologizes</label> <ref target="clause:VAtr_13">V Atr 13–13.1</ref> <quote>almost everything that Wulfstan had previously drafted on the subject was anthologized in Cnut's code (7)</quote></note>
        <note type="comparison" source="#wormald-ppmel" n="56"><label>anthologizes</label> <ref target="clause:VIAtr_22-1">VI Atr 22.1</ref> <quote>almost everything that Wulfstan had previously drafted on the subject was anthologized in Cnut's code (7)</quote></note>
        <note type="comparison" source="#wormald-ppmel" n="56"><label>anthologizes</label> <ref target="clause:Cn-1018_part-039">Cn 1018 14.1</ref> <quote>almost everything that Wulfstan had previously drafted on the subject was anthologized in Cnut's code (7)</quote></note>
        <note type="comparison" source="#wormald-ppmel" n="56"><label>anthologizes</label> <ref target="clause:Cn1020_18">Cn 1020 18</ref> <quote>almost everything that Wulfstan had previously drafted on the subject was anthologized in Cnut's code (7)</quote></note>
        <note type="editorial">A skips four words here. Liebermann compares VI Atr 22.; BR: added from Gesetze I p. 295, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">rihtlice: omitted A</note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_14-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">294</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_14-1.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">294</biblScope></bibl><seg type="original" xml:lang="de">fest. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fest. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_14-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">294</biblScope></bibl><seg type="original" xml:lang="de">m. r. ⁊ h. <hi rend="italic">fehlt Ld</hi> [= <hi rend="italic">A</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">m. r. ⁊ h. missing in Ld [= A]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_14-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">294</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt KR</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in KR</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_14-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">294</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vier Wörter übersprungen</hi></seg><seg type="translation" xml:lang="en" source="#claude">four words skipped</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_14-1.lnote.de.0" n="0" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">200</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Nochmals Feiertag zu halten schärft ein II 45, 1</seg><seg type="translation" xml:lang="en" source="#claude">II 45, 1 enjoins once more the keeping of holy days</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="ICn_14-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">350</biblScope></bibl><seg type="original" xml:lang="en">Cf. V Atr. 12, 3; VI, 22; VIII, 16.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="ICn_14-1.robnote.fn.2" n="2" source="#robertson"><bibl><biblScope unit="page">166</biblScope></bibl><label>rihtlice</label><seg type="original" xml:lang="en"><hi rend="italic">r.—man</hi> om. A, Ld.</seg></note>
      </div>
    </body>
