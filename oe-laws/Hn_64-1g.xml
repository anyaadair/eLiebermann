      <div type="clause" n="64.1g">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 64.1g</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 64.1g" corresp="#wit-lat"><pb n="584" ed="#liebermann"/>Et unde accusatus cum una<ptr type="liebermannNote" n="7" target="#Hn_64-1g.lnote.oe.7"/> decima se purgaret per eleccionem<ptr type="liebermannNote" n="h" target="#Hn_64-1g.lnote.oe.h"/> et sortem, si[c<ptr type="liebermannNote" n="8" target="#Hn_64-1g.lnote.oe.8"/>] ad iudicium ferri calidi uadat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 584 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1g.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 67, 9 <hi rend="italic">f.</hi> 31, 8</seg><seg type="translation" xml:lang="en" source="#claude">cf. 67, 9 <hi rend="italic">f.</hi> 31, 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1g.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> sua [<hi rend="italic">vgl.</hi> 66, 8] <hi rend="italic">oder</hi> manu undecima [<hi rend="italic">vgl.</hi> 66, 5 <hi rend="italic">f. trotz</hi> 67, 1<hi rend="italic">c</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">read sua [cf. 66, 8] or manu undecima [cf. 66, 5 f. despite 67, 1<hi rend="italic">c</hi>]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1g.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">si <hi rend="italic">Hss. Edd.; vielleicht zu streichen oder</hi> ad simplex [<hi rend="italic">vgl.</hi> 67, 1<hi rend="italic">b</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">si MSS edd.; perhaps to be deleted, or ad simplex [cf. 67, 1<hi rend="italic">b</hi>]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-1g.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de">Stubbs <hi rend="italic">eb.</hi>: ‘with ten compurgators’; allein diese Zahl kommt bei Eideshelfern (<hi rend="italic">s. d. Gl</hi> 21. 33) und <hi rend="italic">una decima</hi> für <hi rend="italic">decem</hi> beim Verf. nicht vor. <hi rend="italic">Vgl. Gl</hi> Zehnerschaft 27b; Auswahleid 17f.; Eisenordal 12.—In Anm. <hi rend="italic">h</hi> bessere 67, 9f. in 66, 9a—<hi rend="italic">si</hi>{8}—64, 1h <hi rend="italic">tripodum</hi>{10} Rs</seg><seg type="translation" xml:lang="en" source="#claude">Stubbs <hi rend="italic">ibid.</hi>: ‘with ten compurgators’; but this number does not occur with oath-helpers (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 21. 33), nor does <hi rend="italic">una decima</hi> for <hi rend="italic">decem</hi> occur in the author. <hi rend="italic">Cf. Gl</hi> Zehnerschaft 27b; Auswahleid 17f.; Eisenordal 12.—In note <hi rend="italic">h</hi> correct 67, 9f. to 66, 9a—<hi rend="italic">si</hi>{8}—64, 1h <hi rend="italic">tripodum</hi>{10} Rs</seg></note>
      </div>
