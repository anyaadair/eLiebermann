      <div type="clause" n="8">
        <head><ref type="lawCode" target="law:EGu">EGu</ref> 8</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8" corresp="#wit-h"><ptr type="liebermannNote" n="†††" target="#EGu_8.lnote.oe.___"/><pb n="132" ed="#liebermann"/>Gif frigman<ptr type="liebermannNote" n="11" target="#EGu_8.lnote.oe.11"/> rihtfæsten<ptr type="liebermannNote" n="17" target="#EGu_8.lnote.oe.17-2"/> abrece, gylde wíte oððe<ptr type="liebermannNote" n="18" target="#EGu_8.lnote.oe.18"/> lahslite. Gif hit þeowman<ptr type="liebermannNote" n="19" target="#EGu_8.lnote.oe.19"/> gedó, ðolie his hyde oððe hydgyldes.<ptr type="liebermannNote" n="14" target="#EGu_8.lnote.oe.14"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8" corresp="#wit-b"><pb n="132" ed="#liebermann"/>Gyf friman rihtfæsten abrece, gylde wite <hi rend="italic">uel<ptr type="liebermannNote" n="3" target="#EGu_8.lnote.oe.3"/></hi> lahslite. Gyf hit ðeowman gedó, ðolie his<ptr type="liebermannNote" n="*" target="#EGu_8.lnote.oe.star"/> … oððe hydgyldes.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="8" corresp="#wit-q"><pb n="133" ed="#liebermann"/>Si liber homo rectum ieiunium infringat<ptr type="liebermannNote" n="25" target="#EGu_8.lnote.oe.25"/>, reddat witam uel lahslit. Si seruus hoc efficiat<ptr type="liebermannNote" n="26" target="#EGu_8.lnote.oe.26"/>, perdat corium suum uel hidgildum.<ptr type="liebermannNote" n="17" target="#EGu_8.lnote.oe.17"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="8" corresp="#wit-h"><pb n="106" ed="#attenborough"/>[Be fæstenum.]<ptr type="editorNote" n="11" target="#EGu_8.attnote.fn.11"/> Gif frigman rihtfæsten abrece, gylde wíte oððe lahslite. Gif hit þeowman gedó, ðolie his hyde oððe hydgyldes.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-h"><pb n="280" ed="#rabin-doml"/>Gif frigman rihtfæsten abrece, gylde wite oððe lahslite. Gif hit þeowman gedo, ðolie his hyde oððe hydgyldes.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="133" ed="#liebermann"/>(Über Fasten. <hi rend="italic">Ld</hi>) Wenn ein Freier gesetzliches<ptr type="liebermannNote" n="1" target="#EGu_8.lnote.de.1"/> Fasten<ptr type="liebermannNote" n="2" target="#EGu_8.lnote.de.2"/> bricht, zahle er Strafgeld beziehungsweise Rechtsbruchbusse. Wenn es ein Unfreier thut, verliere er seine Haut<ptr type="liebermannNote" n="3" target="#EGu_8.lnote.de.3"/> oder Hautgeld.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">(Of fasting. Ld) If a free man breaks a lawful fast, let him pay a fine or the penalty for breach of law. If an unfree man does it, let him lose his hide or the hide-money.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="107" ed="#attenborough"/>If a freeman breaks a legally ordained fast, he shall pay a fine or <hi rend="italic">lahslit</hi>. If a slave does so, he shall undergo the lash or pay the fine in lieu thereof.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-h"><pb n="281" ed="#rabin-doml"/>If a freeman breaks a legally mandated fast, he must pay a penalty or lahslit. If a slave does so, he shall receive a whipping or pay to redeem himself.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_46">II Cn 46</ref>; <ref target="clause:IICn_46-2">II Cn 46.2</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="359"><ref target="clause:IICn_46-2">II Cn 46.2</ref></note>
        <note type="editorial">AX: pages in Rabin (text / translation), checked against Rabin (our double-read transcription), October 2026 (e.g. was “6 / 7”, now “280 / 281”; 1 rows of EGu)</note>
        <note type="textual" source="#rabin-doml">hyde: omitted B</note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_8.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">133</biblScope></bibl><seg type="original" xml:lang="de">frangat <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">frangat Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_8.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">133</biblScope></bibl><seg type="original" xml:lang="de">faciat <hi rend="italic">Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">faciat Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_8.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">133</biblScope></bibl><seg type="original" xml:lang="de">c. su. p. <hi rend="italic">T;</hi> c. p. <hi rend="italic">ohne</hi> su. <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. su. p. T; c. p. without su. MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_8.lnote.oe.___" n="†††" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">Be fæstenum <hi rend="italic">überschreibt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Be fæstenum as heading in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_8.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">freoman <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">freoman Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_8.lnote.oe.17-2" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">rihte fæstan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">rihte fæstan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_8.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">⁊ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">⁊ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_8.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">-mon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-mon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_8.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">hydeg. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hydeg. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_8.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">l', <hi rend="italic">viell.</hi> oððe <hi rend="italic">aufzulösen B</hi></seg><seg type="translation" xml:lang="en" source="#claude">l', perhaps to be expanded as oððe B</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_8.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> hyde <hi rend="italic">aus HLd Quadr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">supply hyde from HLd Quadr.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_8.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Benutzt von II Cn 46. Wohl im Ggs. zu freiwillig gelobtem</seg><seg type="translation" xml:lang="en" source="#claude">Used by II Cn 46. Probably in contrast to [fasting] voluntarily vowed</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_8.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Fasten 3b. 5a. 7</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Fasten 3b. 5a. 7</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_8.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl.</hi> Unfreie 15; Prügel 4. 11a. Sachlich ebenso Wi 15</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf.</hi> Unfreie 15; Prügel 4. 11a. Wi 15 is the same in substance</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="EGu_8.attnote.fn.11" n="11" source="#attenborough"><bibl><biblScope unit="page">106</biblScope></bibl><label>fæstenum</label><seg type="original" xml:lang="en">Ld.</seg></note>
      </div>
