    <body>
      <div type="clause" n="7.1">
        <head><ref type="lawCode" target="law:IVAtr">IV Atr</ref> 7.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7.1" corresp="#wit-q"><pb n="236" ed="#liebermann"/>Si<ptr type="liebermannNote" n="3" target="#IVAtr_7-1.lnote.oe.3"/> non possint, werę suę culpa<ptr type="liebermannNote" n="4" target="#IVAtr_7-1.lnote.oe.4"/> sit uel uitę suę, sicut rex uolet<ptr type="liebermannNote" n="5" target="#IVAtr_7-1.lnote.oe.5"/>, uel eadem lada se innoxient, quam prediximus, quod in ipsa pecunia nil inmundum sciebant, unde suam negotiationem exercuerunt.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="7.1" corresp="#wit-q"><pb n="76" ed="#robertson"/>Si non possint<ptr type="editorNote" n="3" target="#IVAtr_7-1.robnote.fn.3"/>, werae suae culpa sit<ptr type="editorNote" n="4" target="#IVAtr_7-1.robnote.fn.4"/> vel vitae suae, sicut rex volet<ptr type="editorNote" n="5" target="#IVAtr_7-1.robnote.fn.5"/>, vel eadem lada se innoxient quam praediximus, quod in ipsa pecunia nil immundum sciebant unde suam negotiationem exercuerunt.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="237" ed="#liebermann"/>Wenn sie dies nicht können, sei ihr Wergeld oder ihr Leben verwirkt, je<ptr type="liebermannNote" n="1" target="#IVAtr_7-1.lnote.de.1"/> wie der König verfügen will, oder sie mögen mit demselben Beweisrecht, das wir oben genannt haben, sich als unschuldig<ptr type="liebermannNote" n="2" target="#IVAtr_7-1.lnote.de.2"/> darthun: dass sie [nämlich] an diesem Gelde, ,womit sie ihren Handel getrieben haben, kein Falsch gewusst<ptr type="liebermannNote" n="3" target="#IVAtr_7-1.lnote.de.3"/> hätten.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If they cannot, let their wergild or their life be forfeit, as the king will decide, or let them prove themselves innocent by the same means of proof that we named above: [namely] that they knew of nothing false in the money with which they did their trading.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q"><pb n="77" ed="#robertson"/>If they cannot do so, they shall forfeit their wergeld or their life, as the king shall decide<ptr type="editorNote" n="1" target="#IVAtr_7-1.robnote.n.1"/>, or they shall clear themselves by the same method<ptr type="editorNote" n="2" target="#IVAtr_7-1.robnote.n.2"/> as we have specified above, [asserting] that they were unaware that there was anything counterfeit about the money with which they were carrying on their business.</ab>
        <note type="comparison" source="#liebermann" n="237"><ref target="clause:IVAtr_5-2">IV Atr 5.2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. 5, 2</note>
        <note type="editorial">Liebermann compares IV Atr 5.2.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_7-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">236</biblScope></bibl><seg type="original" xml:lang="de">Si n. p. <hi rend="italic">überspringt R</hi></seg><seg type="translation" xml:lang="en" source="#claude">Si n. p. omitted by R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_7-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">236</biblScope></bibl><seg type="original" xml:lang="de">culpabiles sint <hi rend="italic">MBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">culpabiles sint MBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_7-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">236</biblScope></bibl><seg type="original" xml:lang="de">uelit <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">uelit Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_7-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">166</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Königsgericht 6b; Begnadigung 1. 8; Todesstrafe 7</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Königsgericht 6b; Begnadigung 1. 8; Todesstrafe 7</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_7-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">166</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">clænsian</hi> las Original</seg><seg type="translation" xml:lang="en" source="#claude">The original read <hi rend="italic">clænsian</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_7-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">166</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Gefährdeeid 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Gefährdeeid 4</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_7-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">326</biblScope></bibl><seg type="original" xml:lang="en">Cf. Wi. 26; 27; In. 6.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_7-1.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">326</biblScope></bibl><seg type="original" xml:lang="en">Cf. 5, 2.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_7-1.robnote.fn.3" n="3" source="#robertson"><bibl><biblScope unit="page">76</biblScope></bibl><label>possint</label><seg type="original" xml:lang="en"><hi rend="italic">s. n. p.</hi> om. R.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_7-1.robnote.fn.4" n="4" source="#robertson"><bibl><biblScope unit="page">76</biblScope></bibl><label>sit</label><seg type="original" xml:lang="en"><hi rend="italic">culpabiles sint</hi> Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_7-1.robnote.fn.5" n="5" source="#robertson"><bibl><biblScope unit="page">76</biblScope></bibl><label>volet</label><seg type="original" xml:lang="en"><hi rend="italic">velit</hi> Br.</seg></note>
      </div>
