    <body>
      <div type="clause" n="55.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 55.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 55.3" corresp="#wit-lat"><ptr type="liebermannNote" n="11" target="#Hn_55-3.lnote.oe.11"/><pb n="575" ed="#liebermann"/>Omnis<ptr type="liebermannNote" n="d" target="#Hn_55-3.lnote.oe.d"/> homo fidem debet<ptr type="liebermannNote" n="12" target="#Hn_55-3.lnote.oe.12"/> domino suo de uita et membris suis et terreno honore et obseruacione consilii sui, per honestum et utile, fide<ptr type="liebermannNote" n="13" target="#Hn_55-3.lnote.oe.13"/> Dei et terre principis salua.<ptr type="liebermannNote" n="e" target="#Hn_55-3.lnote.oe.e"/></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 575 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-3.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">the highwatermark of English vassalism; <hi rend="italic">Pollock and Maitland</hi> HEL. I 280</seg><seg type="translation" xml:lang="en" source="#claude">the highwatermark of English vassalism; Pollock and Maitland HEL. I 280</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-3.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus diesem Vorbehalt folgt keineswegs Abfassung lange nach</hi> 1135</seg><seg type="translation" xml:lang="en" source="#claude">it by no means follows from this reservation that the text was composed long after 1135</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-3.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">De modo fidelitatis quanto (<hi rend="italic">so Hg; erloschen Sc</hi>) prestando domino <hi rend="italic">in Kreide im</hi> 13. <hi rend="italic">Jahrh. am Rande Sc; roth am Rande Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">De modo fidelitatis quanto (thus Hg; faded Sc) prestando domino in chalk in the 13th cent. in the margin Sc; in red in the margin Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-3.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">det <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">det Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-3.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">salua f. D. et t. p. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">salua f. D. et t. p. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_55-3.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Vassallität 8ff. 15. Am Rande später: <hi rend="italic">De forma et virtute homagii prestandi</hi>—<hi rend="italic">utile salua f</hi>.{18} <hi rend="italic">D. et t. p</hi>.—55, 3a <hi rend="italic">prodicionem</hi>{14}—55, 3b <hi rend="italic">precedendum</hi>—ohne <hi rend="italic">aliquem</hi>{19}—<hi rend="italic">facit</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Vassallität 8ff. 15. Later, in the margin: <hi rend="italic">De forma et virtute homagii prestandi</hi>—<hi rend="italic">utile salua f</hi>.{18} <hi rend="italic">D. et t. p</hi>.—55, 3a <hi rend="italic">prodicionem</hi>{14}—55, 3b <hi rend="italic">precedendum</hi>—without <hi rend="italic">aliquem</hi>{19}—<hi rend="italic">facit</hi> Rs</seg></note>
      </div>
