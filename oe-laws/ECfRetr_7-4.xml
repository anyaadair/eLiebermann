    <body>
      <div type="clause" n="7.4">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 7.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 7.4"><pb n="632" ed="#liebermann"/><ptr type="liebermannNote" n="14" target="#ECfRetr_7-4.lnote.la.14"/><hi rend="bold">Similiter</hi> agnum<ptr type="liebermannNote" n="15" target="#ECfRetr_7-4.lnote.la.15"/> decimum, uellus<ptr type="liebermannNote" n="16" target="#ECfRetr_7-4.lnote.la.16"/> decimum, caseum<ptr type="liebermannNote" n="17" target="#ECfRetr_7-4.lnote.la.17"/> decimum, butyrum<ptr type="liebermannNote" n="18" target="#ECfRetr_7-4.lnote.la.18"/> decimum<ptr type="liebermannNote" n="19" target="#ECfRetr_7-4.lnote.la.19"/>, porcellum<ptr type="liebermannNote" n="20" target="#ECfRetr_7-4.lnote.la.20"/> decimum.</ab>
        <note type="comparison" source="#liebermann" n="632"><label>printed alongside</label> <ref target="clause:ECf_7-4">ECf 7.4</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 632 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-4.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Überschrift in Lb Va vor</hi> 8; Item de decimis <hi rend="italic">überschreibt Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">heading in Lb Va before 8; Pl S head it Item de decimis</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-4.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">d. a. <hi rend="italic">Lb Va Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. a. Lb Va Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-4.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">d. u. <hi rend="italic">Lb Va Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. u. Lb Va Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-4.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">d. c. <hi rend="italic">Lb Va K;</hi> c. d. <hi rend="italic">fehlt Cb Hv Cc</hi> [<hi rend="italic">weil in</hi> 7, 3]</seg><seg type="translation" xml:lang="en" source="#claude">d. c. Lb Va K; c. d. lacking in Cb Hv Cc [because in 7, 3]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-4.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">d. b. <hi rend="italic">Lb Va;</hi> b. d. <hi rend="italic">fehlt Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. b. Lb Va; b. d. lacking in Dc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-4.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7-4.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">purc. <hi rend="italic">Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">purc. Lb</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Likewise the tenth lamb, the tenth fleece, the tenth cheese, the tenth butter, the tenth piglet.</ab>
      </div>
    </body>
