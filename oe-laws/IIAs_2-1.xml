    <body>
      <div type="clause" n="2.1">
        <head><ref type="lawCode" target="law:IIAs">II As</ref> 2.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2.1" corresp="#wit-h"><pb n="152" ed="#liebermann"/>⁊ gif hi hine ðonne begytan<ptr type="liebermannNote" n="1" target="#IIAs_2-1.lnote.oe.1-2"/> nyllen<ptr type="liebermannNote" n="1" target="#IIAs_2-1.lnote.oe.1-2"/> oððe ne mægen to<ptr type="liebermannNote" n="2" target="#IIAs_2-1.lnote.oe.2-2"/> þa<hi rend="italic">m</hi> andagan, ðonne beo he syþþan<ptr type="liebermannNote" n="1" target="#IIAs_2-1.lnote.oe.1-2"/> flyma<ptr type="liebermannNote" n="3" target="#IIAs_2-1.lnote.oe.3-2"/>, ⁊ hine lecge for ðeof se þe<ptr type="liebermannNote" n="4" target="#IIAs_2-1.lnote.oe.4-2"/> him tocume.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2.1" corresp="#wit-b"><pb n="152" ed="#liebermann"/>⁊ gyf<ptr type="liebermannNote" n="1" target="#IIAs_2-1.lnote.oe.1"/> hi hine ðænne<ptr type="liebermannNote" n="2" target="#IIAs_2-1.lnote.oe.2"/> begytan nellon oððe ne magon to ðam<ptr type="liebermannNote" n="3" target="#IIAs_2-1.lnote.oe.3"/> andagan, ðonne beo hé syððan flyma, ⁊ hine lecge for ðeof<ptr type="liebermannNote" n="4" target="#IIAs_2-1.lnote.oe.4"/> se ðe him tocume.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2.1" corresp="#wit-so"><pb n="152" ed="#liebermann"/>⁊ gif hi hine þon<hi rend="italic">ne</hi> begytan<ptr type="liebermannNote" n="1" target="#IIAs_2-1.lnote.oe.1-4"/> nellen oððe ne mægen to ðam andagum, þon<hi rend="italic">ne</hi> beo he syððan flyme, ⁊ hine lecge for þeof se ðe him tocume.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2.1" corresp="#wit-q"><pb n="153" ed="#liebermann"/>Et si hoc efficere nolint<ptr type="liebermannNote" n="1" target="#IIAs_2-1.lnote.oe.1-3"/> uel non possint ad terminum, sit ille forisbannitus<ptr type="liebermannNote" n="2" target="#IIAs_2-1.lnote.oe.2-3"/> deinceps, et capiat eum pro fure qui eum<ptr type="liebermannNote" n="3" target="#IIAs_2-1.lnote.oe.3-3"/> consequetur.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="2.1" corresp="#wit-h"><pb n="128" ed="#attenborough"/>⁊ gif hi hine ðonne begytan nyllen<ptr type="editorNote" n="10" target="#IIAs_2-1.attnote.fn.10"/> oððe ne mægen<ptr type="editorNote" n="11" target="#IIAs_2-1.attnote.fn.11"/> to þam andagan<ptr type="editorNote" n="12" target="#IIAs_2-1.attnote.fn.12"/>, ðonne beo he syþþan flyma, ⁊ hine lecge for ðeof<ptr type="editorNote" n="13" target="#IIAs_2-1.attnote.fn.13"/> se þe him tocume.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="153" ed="#liebermann"/>Und wenn sie nun ihn [den Herrenlosen<ptr type="liebermannNote" n="1" target="#IIAs_2-1.lnote.de.1"/>] zu dem Termin<ptr type="liebermannNote" n="2" target="#IIAs_2-1.lnote.de.2"/> nicht stellen wollen oder können, so sei derselbe fortan in Acht, und es erlege<ptr type="liebermannNote" n="3" target="#IIAs_2-1.lnote.de.3"/> ihn als einen Dieb, wer auf ihn trifft.<ptr type="liebermannNote" n="4" target="#IIAs_2-1.lnote.de.4"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if they then will not or cannot produce him [the lordless man] by the appointed day, let him be an outlaw thenceforth, and let whoever comes upon him strike him down as a thief.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="129" ed="#attenborough"/>If, however, on the appointed day they [the relatives of such a man] will not or cannot, he shall be henceforth an outlaw, and he who encounters him may assume him to be a thief and kill him.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="419" ed="#whitelock"/>And if they then will not, or cannot, produce him on that appointed day, he is then to be a fugitive afterwards, and he who encounters him is to strike him down as a thief.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_2-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">152</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_2-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">152</biblScope></bibl><seg type="original" xml:lang="de">ðonne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðonne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_2-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">152</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_2-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">152</biblScope></bibl><seg type="original" xml:lang="de">ðeofe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðeofe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_2-1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">152</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_2-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">152</biblScope></bibl><seg type="original" xml:lang="de">to þ. a. <hi rend="italic">auf dem Rande</hi></seg><seg type="translation" xml:lang="en" source="#claude">to þ. a. in the margin</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_2-1.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">152</biblScope></bibl><seg type="original" xml:lang="de">a <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">a on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_2-1.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">152</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_2-1.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">153</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so K;</hi> nolit uel n. possit <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">so K; nolit uel n. possit the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_2-1.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">153</biblScope></bibl><seg type="original" xml:lang="de">forb. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">forb. T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_2-1.lnote.oe.3-3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">153</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond; fehlt übrigen</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Lond; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_2-1.lnote.oe.1-4" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">152</biblScope></bibl><seg type="original" xml:lang="de">begytaten (<hi rend="italic">weil Vorlage</hi> te <hi rend="italic">über</hi> tan <hi rend="italic">hatte?</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">begytaten (because the exemplar had te above tan?)</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_2-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">102</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘dies bewirken’ Q, <hi rend="italic">hine</hi> falsch übersetzend. Wohl davon beeinflusst, ‘den [Herrn] nicht beschaffen’ Schmid unrichtig (gegen Price-Thorpe, Kemble <hi rend="italic">Saxons</hi> I 263). Hierzu passt nicht ‘zum Termin’ oder das ‘nicht wollen’ der Sippe. Wenn diese den Verbrecher nicht stellen will, bezweckt sie, dass er fliehe</seg><seg type="translation" xml:lang="en" source="#claude">‘bring this about’ Q, mistranslating <hi rend="italic">hine</hi>. Probably influenced by this, Schmid incorrectly has ‘do not procure the [lord]’ (against Price-Thorpe, Kemble <hi rend="italic">Saxons</hi> I 263). Neither ‘at the term’ nor the kindred's ‘being unwilling’ fits this. If the kindred is unwilling to produce the criminal, its aim is that he should flee</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_2-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">102</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘den Terminen’ So ? vielleicht nur moderner Kopisten-Fehler</seg><seg type="translation" xml:lang="en" source="#claude">‘the terms’ So ? perhaps only a modern copyist's error</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_2-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">102</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘fange’ falsch Q; er versteht VI 1, 4 richtig <hi rend="italic">occidere</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘let him catch’ Q, wrongly; at VI 1, 4 he correctly understands it as <hi rend="italic">occidere</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_2-1.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">102</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> friedlos 9. 11</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> friedlos 9. 11</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_2-1.attnote.fn.10" n="10" source="#attenborough"><bibl><biblScope unit="page">128</biblScope></bibl><label>nyllen</label><seg type="original" xml:lang="en"><hi rend="italic">nellon</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_2-1.attnote.fn.11" n="11" source="#attenborough"><bibl><biblScope unit="page">128</biblScope></bibl><label>mægen</label><seg type="original" xml:lang="en"><hi rend="italic">magon</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_2-1.attnote.fn.12" n="12" source="#attenborough"><bibl><biblScope unit="page">128</biblScope></bibl><label>andagan</label><seg type="original" xml:lang="en"><hi rend="italic">andagum</hi>. So.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_2-1.attnote.fn.13" n="13" source="#attenborough"><bibl><biblScope unit="page">128</biblScope></bibl><label>ðeof</label><seg type="original" xml:lang="en"><hi rend="italic">ðeofe</hi>. Ld.</seg></note>
      </div>
