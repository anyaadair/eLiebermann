    <body>
      <div type="clause" n="2.1">
        <head><ref type="lawCode" target="law:Duns">Duns</ref> 2.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2.1" corresp="#wit-b"><pb n="376" ed="#liebermann"/>Ne stent nan oðer lad æt tihtlan<ptr type="liebermannNote" n="1" target="#Duns_2-1.lnote.oe.1"/> bute ordal betweox Wealan ⁊ Ænglan, bute man<ptr type="liebermannNote" n="2" target="#Duns_2-1.lnote.oe.2"/> ðafian wille.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2.1" corresp="#wit-q"><pb n="377" ed="#liebermann"/>Non stat alia lada (id est purgatio) de tihla<ptr type="liebermannNote" n="1" target="#Duns_2-1.lnote.oe.1-2"/> (id est compellatione) nisi ordalium inter Walos et Anglos — nisi pati uoluerint<ptr type="liebermannNote" n="2" target="#Duns_2-1.lnote.oe.2-2"/>.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="377" ed="#liebermann"/>Kein anderer Reinigungsbeweis als das Ordal<ptr type="liebermannNote" n="1" target="#Duns_2-1.lnote.de.1"/> gilt<ptr type="liebermannNote" n="2" target="#Duns_2-1.lnote.de.2"/> bei einer Klage zwischen Wallisern und Engländern, es sei denn, man [Gegner] wolle [leichteren] zulassen<ptr type="liebermannNote" n="3" target="#Duns_2-1.lnote.de.3"/>.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">No other clearing proof than the ordeal holds in an accusation between Welsh and English, unless one [the opponent] is willing to allow [a lighter one].</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-b">Upon accusation, no other exculpation between the English and Welsh is valid except the ordeal, unless one [of the opponents] wants to admit it [the falsity of his claim].</ab>
        <note type="editorial">U: translator unrecorded: check</note>
        <note type="liebermannNote" subtype="textual" xml:id="Duns_2-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">376</biblScope></bibl><seg type="original" xml:lang="de">tyh. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">tyh. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duns_2-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">376</biblScope></bibl><seg type="original" xml:lang="de">mon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duns_2-1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">377</biblScope></bibl><seg type="original" xml:lang="de">tyh. <hi rend="italic">M Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">tyh. M Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duns_2-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">377</biblScope></bibl><seg type="original" xml:lang="de">uelint <hi rend="italic">T M Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">uelint T M Hk</seg></note>
