      <div type="clause" n="80.8">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 80.8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 80.8" corresp="#wit-lat"><pb n="597" ed="#liebermann"/>Item qui in domibus archiepiscoporum (uel<ptr type="liebermannNote" n="5" target="#Hn_80-8.lnote.oe.5"/>) episcoporum uel comitum fecerit homicidium uel hominicedium<ptr type="liebermannNote" n="b" target="#Hn_80-8.lnote.oe.b"/><ptr type="liebermannNote" n="6" target="#Hn_80-8.lnote.oe.6"/>, sicut causa fuerit, menbrorum<ptr type="liebermannNote" n="c" target="#Hn_80-8.lnote.oe.c"/> uel peccunialis<ptr type="liebermannNote" n="7" target="#Hn_80-8.lnote.oe.7"/> emendacionis reus sit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 597 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-8.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 80, 7 <hi rend="italic">und Isidor, Etymol.</hi> V 26: homicidium ex homine et cæde</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 80, 7 <hi rend="italic">and Isidore, Etymol.</hi> V 26: homicidium ex homine et cæde</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-8.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur Geldbusse fordert</hi> Ine 6, 2; Af 15 (<hi rend="italic">daraus</hi> Grið 12)</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">only a money compensation is required by</hi> Ine 6, 2; Af 15 (<hi rend="italic">whence</hi> Grið 12)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-8.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht in Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">not in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-8.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">homiced. <hi rend="italic">Wh;</hi> hōi ce. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">homiced. Wh; hōi ce. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-8.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">pecunia uel <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">pecunia uel K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-8.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Hausfrieden 5; Schutz 12; Asyl 14a; blutig fechten 8c—<hi rend="italic">uel</hi>{5}—<hi rend="italic">homiced</hi>.{8} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Hausfrieden 5; Schutz 12; Asyl 14a; blutig fechten 8c—<hi rend="italic">uel</hi>{5}—<hi rend="italic">homiced</hi>.{8} Rs</seg></note>
