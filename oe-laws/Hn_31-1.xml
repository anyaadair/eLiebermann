        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 31.1" corresp="#wit-lat"><pb n="563" ed="#liebermann"/>In summis et<ptr type="liebermannNote" n="33" target="#Hn_31-1.lnote.oe.33"/> capitalibus placitis unus hundretus uel comitatus iudicetur a duobus<ptr type="liebermannNote" n="v" target="#Hn_31-1.lnote.oe.v"/>, non unus duos iudicet.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 563 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_31-1.lnote.oe.v" n="v" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 7, 5</seg><seg type="translation" xml:lang="en" source="#claude">cf. 7, 5</seg></note>
