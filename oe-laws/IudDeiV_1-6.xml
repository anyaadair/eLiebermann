      <div type="clause" n="1.6">
        <head><ref type="lawCode" target="law:IudDeiV">Iud Dei V</ref> 1.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei V 1.6" corresp="#wit-du"><pb n="411" ed="#liebermann"/>ut tactus<ptr type="liebermannNote" n="26" target="#IudDeiV_1-6.lnote.oe.26"/> eius furti — criminis uel alterius —, cuius inquisitio agitur, conscii et<ptr type="liebermannNote" n="27" target="#IudDeiV_1-6.lnote.oe.27"/> arescant manus eorum (aut pedes<ptr type="liebermannNote" n="b" target="#IudDeiV_1-6.lnote.oe.b"/>) conburantur aliquatenus;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 411 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_1-6.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. o. S.</hi> 409{a}</seg><seg type="translation" xml:lang="en" source="#claude">cf. above p. 409ᵃ</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_1-6.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert aus</hi> actus, <hi rend="italic">bessere</hi> tactu <hi rend="italic">nach II</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected from actus; read tactu, following II</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_1-6.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de">exhorrescant et m. <hi rend="italic">II</hi></seg><seg type="translation" xml:lang="en" source="#claude">exhorrescant et m. II</seg></note>
      </div>
