    <body>
      <div type="clause" n="6.4">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 6.4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.4" corresp="#wit-e"><pb n="92" ed="#liebermann"/>⁊ þeah hit sie<ptr type="liebermannNote" n="7" target="#Ine_6-4.lnote.oe.7"/> on middum<ptr type="liebermannNote" n="8" target="#Ine_6-4.lnote.oe.8"/> felda gefohten, CXX<ptr type="liebermannNote" n="9" target="#Ine_6-4.lnote.oe.9"/><ptr type="liebermannNote" n="**" target="#Ine_6-4.lnote.oe.star2"/> scill. to wite sie<ptr type="liebermannNote" n="7" target="#Ine_6-4.lnote.oe.7"/> agifen.<ptr type="liebermannNote" n="10" target="#Ine_6-4.lnote.oe.10-2"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.4" corresp="#wit-bu"><pb n="92" ed="#liebermann"/>⁊ þeah . . . dan felda gefeohtan, CXX . . . ag . . .</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.4" corresp="#wit-h"><pb n="92" ed="#liebermann"/>⁊ þeah hit sy<ptr type="liebermannNote" n="3" target="#Ine_6-4.lnote.oe.3"/> gefohten<ptr type="liebermannNote" n="5" target="#Ine_6-4.lnote.oe.5"/> on middan felda, CXX scll' to wite sy<ptr type="liebermannNote" n="3" target="#Ine_6-4.lnote.oe.3"/> agifen.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.4" corresp="#wit-b-no-prol"><pb n="93" ed="#liebermann"/>⁊ ðeah hit sy on middan felda gefohtan, hundtwelftig scill' to wite sy agyfen.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6.4" corresp="#wit-q"><pb n="93" ed="#liebermann"/>Et licet sit<ptr type="liebermannNote" n="10" target="#Ine_6-4.lnote.oe.10"/> in mediis campis dimicatum, centum uiginti sol. wite reddantur.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="38" ed="#attenborough"/>⁊ þeah hit sie on middum<ptr type="editorNote" n="10" target="#Ine_6-4.attnote.fn.10"/> felda gefohten, CXX scill. to wite sie agifen.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="6.4" corresp="#wit-e"><pb n="376" ed="#jurasinski-and-oliver"/>⁊ þeah hit sie on middum felda gefohten cxx sciƚƚ to wite sie agifen.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="93" ed="#liebermann"/>Und wenn selbst [nur] mitten auf dem Felde<ptr type="liebermannNote" n="1" target="#Ine_6-4.lnote.de.1"/> gefochten worden ist, werde [dem König doch] 120[30<ptr type="liebermannNote" n="2" target="#Ine_6-4.lnote.de.2"/>] Schill. zur Strafe gegeben.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And even if the fighting has taken place [only] in the middle of the open field, let 120 [30] shillings [nevertheless] be given [to the king] as a fine.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="39" ed="#attenborough"/>And even if it [the fight] takes place in the open, a fine of 120 shillings shall be paid.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="400" ed="#whitelock"/>And even if the fighting is in the midst of the open country, 120 shillings is to be given as a fine.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="377" ed="#jurasinski-and-oliver"/>And even if the fight takes place in an open field, 120 shillings shall be paid as fine.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_6-4.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">93</biblScope></bibl><seg type="original" xml:lang="de">in m. c. sit <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">in m. c. sit MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_6-4.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_6-4.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> gefeohten</seg><seg type="translation" xml:lang="en" source="#claude">altered to gefeohten</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_6-4.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_6-4.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">middan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">middan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_6-4.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">hundtwelftig <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hundtwelftig Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_6-4.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> XXX</seg><seg type="translation" xml:lang="en" source="#claude">read XXX</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_6-4.lnote.oe.10-2" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">agyfen <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">agyfen Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_6-4.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Wo also kein Schutz privaten Hauses oder adliger Anwesenheit gebrochen war</seg><seg type="translation" xml:lang="en" source="#claude">Where, therefore, no protection of a private house or of a noble’s presence had been broken</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_6-4.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Archetyp und jede Hs. las 120. Dennoch scheint mir Schmids Besserung richtig; <hi rend="italic">s. o.</hi> 6, 3³</seg><seg type="translation" xml:lang="en" source="#claude">The archetype and every MS read 120. Nevertheless Schmid’s emendation seems to me correct; see above 6, 3³</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_6-4.attnote.fn.10" n="10" source="#attenborough"><bibl><biblScope unit="page">38</biblScope></bibl><label>middum</label><seg type="original" xml:lang="en"><hi rend="italic">middan</hi>. B &amp; H.</seg></note>
      </div>
    </body>
