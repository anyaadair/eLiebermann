    <body>
      <div type="clause" n="22">
        <head>Cn 1018 22</head>
        <ab type="editionText" xml:lang="ang" source="#kennedy" n="22" corresp="#wit-d"><pb n="79" ed="#kennedy"/>And burhbota 7 bricbota. aginne man georne.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-d"><pb n="220" ed="#rabin-doml"/>And burhbota and bricbota aginne man georne,</ab>
        <ab type="translation" xml:lang="en" source="#kennedy" corresp="#wit-d"><pb n="79" ed="#kennedy"/>And the repair of fortifications and bridges should be diligently undertaken.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-d"><pb n="221" ed="#rabin-doml"/>And improvements to fortifications and bridges are to be undertaken zealously,</ab>
        <note type="comparison" source="#kennedy" n="59"><label>source in V–VIII Æthelred</label> <ref target="clause:VIAtr_32-3">VI Atr 32.3</ref> <quote>Kennedy’s table: VI Æthelred 32.3 | D 22–23 | II Cnut 10</quote></note>
        <note type="comparison" source="#kennedy" n="59"><label>used in I–II Cnut</label> <ref target="clause:IICn_10">II Cn 10</ref> <quote>Kennedy’s table: VI Æthelred 32.3 | D 22–23 | II Cnut 10</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="358"><label>source (roman)</label> <ref target="clause:IICn_10">II Cn 10</ref> <quote>Table 5.4, II Cn 10: Cn 1018 22-23  VI Atr 32:3</quote></note>
      </div>
    </body>
