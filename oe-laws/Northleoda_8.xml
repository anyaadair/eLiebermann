  <text>
    <body>
      <div type="clause" n="8">
        <head><ref type="lawCode" target="law:Northleoda">Norðleoda</ref> 8</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8" corresp="#wit-d"><pb n="460" ed="#liebermann"/>And gif he ænig land næbbe ⁊ þeah freoh sy, forgilde hine man mid LXX<ptr type="liebermannNote" n="d" target="#Northleoda_8.lnote.oe.d"/> scill'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8" corresp="#wit-h"><pb n="460" ed="#liebermann"/>⁊ gif he ænig land næbbe ⁊ þeh freoh sy, forgylde man hine mid LXX scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8" corresp="#wit-ld"><pb n="460" ed="#liebermann"/>Gif he land næbbe, ac biþ freoh, gyld<ptr type="liebermannNote" n="a" target="#Northleoda_8.lnote.oe.a"/> mon LXX scill.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="8" corresp="#wit-q"><ptr type="liebermannNote" n="13" target="#Northleoda_8.lnote.oe.13"/><pb n="461" ed="#liebermann"/>Et si nichil terre habeat et liber<ptr type="liebermannNote" n="14" target="#Northleoda_8.lnote.oe.14"/> tamen sit, reddatur<ptr type="liebermannNote" n="15" target="#Northleoda_8.lnote.oe.15"/> LX<ptr type="liebermannNote" n="16" target="#Northleoda_8.lnote.oe.16"/> sol. et decem sol.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-h"><pb n="14" ed="#rabin-doml"/>And gif he ænig land næbbe and þeh freo sy, forgylde man hine mid LXX scillinga.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="461" ed="#liebermann"/>Und wenn er kein Land besitzt und (aber<ptr type="liebermannNote" n="1" target="#Northleoda_8.lnote.de.1"/> <hi rend="italic">Ld</hi>) doch frei<ptr type="liebermannNote" n="2" target="#Northleoda_8.lnote.de.2"/> ist, werde er [wenn erschlagen] entgolten mit 70<ptr type="liebermannNote" n="3" target="#Northleoda_8.lnote.de.3"/> Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if he has no land and (but, Ld) is nevertheless free, let him [if slain] be paid for with 70 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-d"><pb n="477" ed="#whitelock"/>And if he has no land and nevertheless is free, one is to pay for him with 70 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-h">And if he does not have any land but is still free, then compensation for him shall be seventy shillings.</ab>
        <note type="comparison" source="#liebermann" n="461"><ref target="clause:Ine_32">Ine 32</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd.</note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="399"><ref target="clause:Ine_32">Ine 32</ref></note>
        <note type="editorial">Ine 32 has LX. Liebermann compares Ine 32.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Northleoda_8.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">460</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Northleoda_8.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">460</biblScope></bibl><seg type="original" xml:lang="de">LX <hi rend="italic">Ine</hi> 32</seg><seg type="translation" xml:lang="en" source="#claude">LX Ine 32</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Northleoda_8.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">461</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">c.</hi> 8 <hi rend="italic">fehlt TMHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. 8 lacking in TMHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Northleoda_8.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">461</biblScope></bibl><seg type="original" xml:lang="de">t. l. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. l. R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Northleoda_8.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">461</biblScope></bibl><seg type="original" xml:lang="de">-antur <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-antur Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Northleoda_8.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">461</biblScope></bibl><seg type="original" xml:lang="de">LXX <hi rend="italic">ohne</hi> s. et d. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">LXX without s. et d. R</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Northleoda_8.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">261</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. o</hi>. Einl. 2; reicherer Partikelschatz beweist spätere Sprache des Bearbeiters l</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. above</hi> Introduction 2; the richer stock of particles proves the later language of the reviser l</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Northleoda_8.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">261</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Es folgt nicht, der Keltische Arme sei in der Regel unfrei</seg><seg type="translation" xml:lang="en" source="#claude">It does not follow that the poor Celt was as a rule unfree</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Northleoda_8.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">261</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Nach Ine möchte ‘60’ bessern Maurer <hi rend="italic">Kr. Üb</hi>. I 419.—Q drückt das Zahlwort auf Französische Art aus; <hi rend="italic">s. Wb: sexaginta</hi></seg><seg type="translation" xml:lang="en" source="#claude">Maurer <hi rend="italic">Kr. Üb</hi>. I 419 would emend to ‘60’ following Ine. — Q expresses the numeral in the French manner; <hi rend="italic">see Wb: sexaginta</hi></seg></note>
      </div>
    </body>
