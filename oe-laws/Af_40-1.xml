    <body>
      <div type="clause" n="40.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 40.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="40.1" corresp="#wit-e"><pb n="74" ed="#liebermann"/>Gif ðisses hwæt<ptr type="liebermannNote" n="1" target="#Af_40-1.lnote.oe.1"/> gelimpe, ðenden fyrd ute sie, oððe in lenctenfæsten<ptr type="liebermannNote" n="2" target="#Af_40-1.lnote.oe.2"/>, hit sie twybote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="40.1" corresp="#wit-ot-frags"><pb n="74" ed="#liebermann"/>Gif þisses hw.. gelimpe, þe... fyrd .., .. þe in lenctenfæst.., hit sie twybo..</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="40.1" corresp="#wit-h"><pb n="74" ed="#liebermann"/>Gif þysses hwæt gelimpe, þonne fyrd ute sy<ptr type="liebermannNote" n="1" target="#Af_40-1.lnote.oe.1-2"/>, oþþe in lencten<ptr type="liebermannNote" n="2" target="#Af_40-1.lnote.oe.2-2"/>fæsten, hit<ptr type="liebermannNote" n="3" target="#Af_40-1.lnote.oe.3"/> sy<ptr type="liebermannNote" n="1" target="#Af_40-1.lnote.oe.1-2"/> twybote.<ptr type="liebermannNote" n="4" target="#Af_40-1.lnote.oe.4"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="40.1" corresp="#wit-b-no-prol"><pb n="75" ed="#liebermann"/>Gyf ðisses hwæt gelimpe, ðonne fyrd ute sy, oððe in lenctene, [si<ptr type="liebermannNote" n="1" target="#Af_40-1.lnote.oe.1-4"/> hit twibote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="40.1" corresp="#wit-q"><pb n="75" ed="#liebermann"/>Si horum aliquid eueniat, quando exercitus foris est<ptr type="liebermannNote" n="1" target="#Af_40-1.lnote.oe.1-3"/>, uel in quadragesimali ieiunio, sit dupliciter emendandum.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="82" ed="#attenborough"/>Gif ðisses hwæt gelimpe, ðenden<ptr type="editorNote" n="5" target="#Af_40-1.attnote.fn.5"/> fyrd ute sie, oððe in lenctenfæsten, hit sie twybote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="41.1" corresp="#wit-e"><pb n="338" ed="#jurasinski-and-oliver"/>Gif ðisses hwæt gelimpe, ðenden fyrd ute sie, oððe in lenctenfæsten, hit sie twybote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><ptr type="liebermannNote" n="1" target="#Af_40-1.lnote.de.1"/><pb n="75" ed="#liebermann"/>Wenn etwas derart<ptr type="liebermannNote" n="2" target="#Af_40-1.lnote.de.2"/> geschieht, während<ptr type="liebermannNote" n="3" target="#Af_40-1.lnote.de.3"/> die Landwehr auswärts ist, oder in den Frühlingsfasten<ptr type="liebermannNote" n="4" target="#Af_40-1.lnote.de.4"/>, stehe es unter Doppelbusse.<ptr type="liebermannNote" n="5" target="#Af_40-1.lnote.de.5"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If anything of this kind happens while the army is out, or in the Lenten fast, let it be subject to double compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="83" ed="#attenborough"/>If any of these offences occur while the army is in the field, or during the fast of Lent, the compensation [to be paid] shall be double [the above].</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="415" ed="#whitelock"/>If any of this happens when the army has been called out, or in the Lenten fast, the compensations are to be doubled.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="339" ed="#jurasinski-and-oliver"/>If something of this nature occurs while the army is out [on duty], or in the Lenten fast, it is double compensation.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_47">II Cn 47</ref></note>
        <note type="comparedBy" source="#wormald-ppmel" n="58"><ref target="clause:IICn_45-1">II Cn 45.1–47.1</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="359"><ref target="clause:IICn_47">II Cn 47</ref></note>
        <note type="comparedBy" source="#whitelock" n="469"><ref target="clause:IICn_47">II Cn 47</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_40-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">74</biblScope></bibl><seg type="original" xml:lang="de">hwat gelimp <hi rend="spaced">ðonne</hi> f. ut sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hwat gelimp <hi rend="italic">ðonne</hi> f. ut sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_40-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">74</biblScope></bibl><seg type="original" xml:lang="de">lenctene, sy hit twybot <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lenctene, sy hit twybot Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_40-1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">74</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_40-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">74</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> lengten</seg><seg type="translation" xml:lang="en" source="#claude">altered to lengten</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_40-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">74</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">durch Zeichen umgestellt zu</hi> sy hit</seg><seg type="translation" xml:lang="en" source="#claude">transposed by marks to sy hit</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_40-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">74</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">scheint geänd. aus</hi> twibete</seg><seg type="translation" xml:lang="en" source="#claude">seems to be altered from twibete</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_40-1.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">75</biblScope></bibl><seg type="original" xml:lang="de">sit <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_40-1.lnote.oe.1-4" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">75</biblScope></bibl><seg type="original" xml:lang="de">si — lenctene <hi rend="italic">übersprungen, im</hi> 16. <hi rend="italic">Jh. am Rande</hi></seg><seg type="translation" xml:lang="en" source="#claude">si — lenctene omitted, in the margin in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_40-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Heer 6a; Schutz 9c II</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Heer 6a; Schutz 9c II</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_40-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Ob sich dies auch auf Hausfrieden Af 39 bezieht?</seg><seg type="translation" xml:lang="en" source="#claude">Does this also refer to the peace of the house in Af 39?</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_40-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘wann’ H B Ld Q?</seg><seg type="translation" xml:lang="en" source="#claude">‘when’ H B Ld Q?</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_40-1.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Busse 10b; Feiertag 9a—c</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Busse 10b; Feiertag 9a—c</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_40-1.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">An Schutzbruchbusse und Strafe</seg><seg type="translation" xml:lang="en" source="#claude">Of compensation for breach of protection and of fine</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_40-1.attnote.fn.5" n="5" source="#attenborough"><bibl><biblScope unit="page">82</biblScope></bibl><label>ðenden</label><seg type="original" xml:lang="en"><hi rend="italic">ðonne</hi>. H, B.</seg></note>
      </div>
