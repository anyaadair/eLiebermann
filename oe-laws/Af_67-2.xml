    <body>
      <div type="clause" n="67.2">
        <head><ref type="lawCode" target="law:Af">Af</ref> 67.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="67.2" corresp="#wit-e"><pb n="84" ed="#liebermann"/>Gif hio<ptr type="liebermannNote" n="21" target="#Af_67-2.lnote.oe.21"/> bið ðurhðyrel<ptr type="liebermannNote" n="24" target="#Af_67-2.lnote.oe.24"/>, ðon<hi rend="italic">ne</hi> sceal ðær XXX scill. to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="67.2" corresp="#wit-h"><pb n="84" ed="#liebermann"/>Gif heo<ptr type="liebermannNote" n="5" target="#Af_67-2.lnote.oe.5"/> bið þurhþyrel, þonne scel<ptr type="liebermannNote" n="14" target="#Af_67-2.lnote.oe.14"/> þær<ptr type="liebermannNote" n="11" target="#Af_67-2.lnote.oe.11"/> XXX scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="67.2" corresp="#wit-b-no-prol"><pb n="84" ed="#liebermann"/>Gyf héo bið ðurhðurl<ptr type="liebermannNote" n="3" target="#Af_67-2.lnote.oe.3"/>, ðonne sceal ðrittig scill' to bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="67.2" corresp="#wit-q"><pb n="85" ed="#liebermann"/>Si transpuncti sunt<ptr type="liebermannNote" n="14" target="#Af_67-2.lnote.oe.14-2"/>, id<ptr type="liebermannNote" n="15" target="#Af_67-2.lnote.oe.15"/> componant XXX sol.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="90" ed="#attenborough"/>Gif hio bið ðurhðyrel<ptr type="editorNote" n="15" target="#Af_67-2.attnote.fn.15"/>, ðonne sceal ðær XXX scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="71.2" corresp="#wit-e"><pb n="360" ed="#jurasinski-and-oliver"/>Gif hio bið ðurhðyrel, ðon<hi rend="italic">ne</hi> sceal ðær XXX scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="85" ed="#liebermann"/>Wenn sie durchbohrt<ptr type="liebermannNote" n="1" target="#Af_67-2.lnote.de.1"/> ist, dann gebührt da 30 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If it is pierced through, then 30 shillings are due as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="91" ed="#attenborough"/>If it is pierced right through, then 30 shillings must be paid as compensation for it.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="361" ed="#jurasinski-and-oliver"/>If it is pierced through, then 30 shillings shall be compensation for that.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_67-2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">heo <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">heo Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_67-2.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">-ðyrl <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ðyrl Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_67-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_67-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> sceal</seg><seg type="translation" xml:lang="en" source="#claude">altered to sceal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_67-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_67-2.lnote.oe.14-2" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">85</biblScope></bibl><seg type="original" xml:lang="de">sint <hi rend="italic">HkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">sint HkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_67-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">85</biblScope></bibl><seg type="original" xml:lang="de">illud <hi rend="italic">Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">illud Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_67-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. geänd.:</hi> -ðyrl</seg><seg type="translation" xml:lang="en" source="#claude">altered in the 16th cent.: -ðyrl</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_67-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Zweimündig; <hi rend="italic">s. o.</hi> 61, 1⁴; Gliederbussen 10</seg><seg type="translation" xml:lang="en" source="#claude">With two openings; <hi rend="italic">see above</hi> 61, 1⁴; Gliederbussen 10</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_67-2.attnote.fn.15" n="15" source="#attenborough"><bibl><biblScope unit="page">90</biblScope></bibl><label>ðurhðyrel</label><seg type="original" xml:lang="en"><hi rend="italic">ðurhðurl</hi>. B.</seg></note>
      </div>
