    <body>
      <div type="clause" n="12.8">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 12.8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 12.8"><pb n="639" ed="#liebermann"/>Et si molendina<ptr type="liebermannNote" n="d" target="#ECf_12-8.lnote.la.fn.d"/>, <ptr type="liebermannNote" n="15" target="#ECf_12-8.lnote.la.15"/>piscaria uel alia quelibet opera<ptr type="liebermannNote" n="c" target="#ECf_12-8.lnote.la.fn.c"/> ad disturbationem eorum preparantur<ptr type="liebermannNote" n="16" target="#ECf_12-8.lnote.la.16"/>, ipsa<ptr type="liebermannNote" n="17" target="#ECf_12-8.lnote.la.17"/> opera destruantur, chimini<ptr type="liebermannNote" n="18" target="#ECf_12-8.lnote.la.18"/> et aque<ptr type="liebermannNote" n="19" target="#ECf_12-8.lnote.la.19"/> reparentur; et<ptr type="liebermannNote" n="20" target="#ECf_12-8.lnote.la.20"/> forisfactura<ptr type="liebermannNote" n="21" target="#ECf_12-8.lnote.la.21"/> regis<ptr type="liebermannNote" n="e" target="#ECf_12-8.lnote.la.fn.e"/>.</ab>
        <note type="comparison" source="#liebermann" n="639"><label>printed alongside</label> <ref target="clause:ECfRetr_12-8">ECf retr 12.8</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 639 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “disturbationem” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-8.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 12, 1; 2</seg><seg type="translation" xml:lang="en" source="#claude">see above, 12, 1; 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-8.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">Wassermühlen</seg><seg type="translation" xml:lang="en" source="#claude">water-mills</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-8.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">cinges wite, <hi rend="italic">laut</hi> 12, 2 <hi rend="italic">halb so viel wie</hi> assaltus. <hi rend="italic">Den Retractator stört die Ellipse, die aber auch</hi> 38, 2</seg><seg type="translation" xml:lang="en" source="#claude">cinges wite, according to 12, 2 half as much as assaltus. The ellipsis troubles the Retractator; but it is also at 38, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-8.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">fügt zu Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad adds uel</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-8.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">-rentur <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rentur S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-8.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">illa <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">illa Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-8.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">cheminus <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">cheminus Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-8.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">cursus <hi rend="italic">fügt zu Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad Do add cursus</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-8.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">et sit transgressor in fo. domini regis <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">et sit transgressor in fo. domini regis Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-8.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And if mills, fisheries or any other works are set up to their obstruction, let the works themselves be destroyed, and the highways and waters be repaired; and the king's forfeiture.</ab>
      </div>
    </body>
