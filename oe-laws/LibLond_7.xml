      <div type="clause" n="7">
        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 7" corresp="#wit-lat"><ptr type="liebermannNote" n="28" target="#LibLond_7.lnote.oe.28"/><pb n="674" ed="#liebermann"/>Item<ptr type="liebermannNote" n="29" target="#LibLond_7.lnote.oe.29"/> si<ptr type="liebermannNote" n="30" target="#LibLond_7.lnote.oe.30"/> ciuis Lund.<ptr type="liebermannNote" n="31" target="#LibLond_7.lnote.oe.31"/> terram aliquam per annum<ptr type="liebermannNote" n="n" target="#LibLond_7.lnote.oe.n"/> et diem<ptr type="liebermannNote" n="32" target="#LibLond_7.lnote.oe.32"/> I<ptr type="liebermannNote" n="33" target="#LibLond_7.lnote.oe.33"/> sine<ptr type="liebermannNote" n="34" target="#LibLond_7.lnote.oe.34"/> calumpnia tenuerit, alicui in<ptr type="liebermannNote" n="35" target="#LibLond_7.lnote.oe.35"/> ciuitate<ptr type="liebermannNote" n="o" target="#LibLond_7.lnote.oe.o"/> manenti<ptr type="liebermannNote" n="36" target="#LibLond_7.lnote.oe.36"/> respondere non debet: nisi qui<ptr type="liebermannNote" n="37" target="#LibLond_7.lnote.oe.37"/> terram<ptr type="liebermannNote" n="38" target="#LibLond_7.lnote.oe.38"/> post calumpniauerit<ptr type="liebermannNote" n="39" target="#LibLond_7.lnote.oe.39"/> talis<ptr type="liebermannNote" n="40" target="#LibLond_7.lnote.oe.40"/> etatis<ptr type="liebermannNote" n="p" target="#LibLond_7.lnote.oe.p"/> tunc fuerit, quod calumpniare<ptr type="liebermannNote" n="41" target="#LibLond_7.lnote.oe.41"/> eam nesciret<ptr type="liebermannNote" n="42" target="#LibLond_7.lnote.oe.42"/>, uel nisi languor<ptr type="liebermannNote" n="43" target="#LibLond_7.lnote.oe.43"/> inpediat, aut in patria hac<ptr type="liebermannNote" n="44" target="#LibLond_7.lnote.oe.44"/> non<ptr type="liebermannNote" n="q" target="#LibLond_7.lnote.oe.q"/> fuerit aut<ptr type="liebermannNote" n="45" target="#LibLond_7.lnote.oe.45"/> in<ptr type="liebermannNote" n="46" target="#LibLond_7.lnote.oe.46"/> werra<ptr type="liebermannNote" n="r" target="#LibLond_7.lnote.oe.r"/><ptr type="liebermannNote" n="47" target="#LibLond_7.lnote.oe.47"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 674 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Hn 59, 9; <hi rend="italic">Stadtrechte</hi> (<hi rend="italic">wie</hi> Newcastle); <hi rend="italic">Maitland</hi> Year and day <hi rend="italic">in</hi> Law quart. rev. 1889, 260</seg><seg type="translation" xml:lang="en" source="#claude">cf. Hn 59, 9; town laws (such as Newcastle); Maitland Year and day in Law quart. rev. 1889, 260</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">gegen auswärts wohnende Kläger verjährt also die Klage auf Londoner Grundeigen nicht; die</hi> Cons. <hi rend="italic">streicht diese Beschränkung der Verjährung</hi></seg><seg type="translation" xml:lang="en" source="#claude">against plaintiffs living elsewhere, therefore, the action for London real property does not become time-barred; the Cons. deletes this restriction on limitation</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Hn 45, 3. 59, 9. 70, 18</seg><seg type="translation" xml:lang="en" source="#claude">cf. Hn 45, 3. 59, 9. 70, 18</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Hn 59, 2<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. Hn 59, 2b</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Hn 59, 9<hi rend="italic">a</hi>. 68, 2. 83, 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. Hn 59, 9a. 68, 2. 83, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">Unde supra <hi rend="italic">überschr. PlS</hi></seg><seg type="translation" xml:lang="en" source="#claude">Unde supra as heading PlS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cons</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Cons</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ai;</hi> c. L. si <hi rend="italic">Horn Cons</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Ai; c. L. si Horn Cons</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">Londonie <hi rend="italic">PlS;</hi> London’ <hi rend="italic">Horn;</hi> Lond’ <hi rend="italic">Cons</hi></seg><seg type="translation" xml:lang="en" source="#claude">Londonie PlS; London’ Horn; Lond’ Cons</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">dic̄ <hi rend="italic">Ai</hi></seg><seg type="translation" xml:lang="en" source="#claude">dic̄ Ai</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">unum <hi rend="italic">PlS Cons; fehlt Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">unum PlS Cons; omitted in Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">sint <hi rend="italic">Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">sint Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">in c. m. <hi rend="italic">fehlt Cons</hi></seg><seg type="translation" xml:lang="en" source="#claude">in c. m. omitted in Cons</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">-te <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">-te Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">calumpniator infra etatem uel in languore uel extra terram fuerit (uel incarceratus <hi rend="italic">nachträgl.</hi>) <hi rend="italic">Cons</hi></seg><seg type="translation" xml:lang="en" source="#claude">calumpniator infra etatem uel in languore uel extra terram fuerit (uel incarceratus added later) Cons</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">illam</hi> <hi rend="italic">fügt zu PlS</hi></seg><seg type="translation" xml:lang="en" source="#claude">PlS adds <hi rend="italic">illam</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">-iatus fuerit <hi rend="italic">PlS</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iatus fuerit PlS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">infra [e]tatem [ciuita. <hi rend="italic">Riley</hi>] <hi rend="italic">Alb</hi></seg><seg type="translation" xml:lang="en" source="#claude">infra [e]tatem [ciuita. Riley] Alb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">-ri <hi rend="italic">PlS</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ri PlS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">ness. <hi rend="italic">Ai;</hi> -ierit <hi rend="italic">PlS</hi></seg><seg type="translation" xml:lang="en" source="#claude">ness. Ai; -ierit PlS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">-gor <hi rend="italic">Horn S;</hi> aeger <hi rend="italic">Alb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gor Horn S; aeger Alb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">ista <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">ista Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">a. in w. <hi rend="italic">fehlt Ord PlS;</hi> uel <hi rend="italic">Horn Alb</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. in w. omitted in Ord PlS; uel Horn Alb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Alb; fehlt Ai Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Alb; omitted in Ai Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_7.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">gwe. <hi rend="italic">Horn;</hi> gue. <hi rend="italic">Alb</hi></seg><seg type="translation" xml:lang="en" source="#claude">gwe. Horn; gue. Alb</seg></note>
