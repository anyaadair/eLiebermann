    <body>
      <div type="clause" n="32.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 32.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 32.3" corresp="#wit-lat"><pb n="564" ed="#liebermann"/>Si dominus placitet contra<ptr type="liebermannNote" n="31" target="#Hn_32-3.lnote.oe.31"/> suum<ptr type="liebermannNote" n="32" target="#Hn_32-3.lnote.oe.32"/> hominem, potest in<ptr type="liebermannNote" n="s" target="#Hn_32-3.lnote.oe.s"/> consilio suo habitos<ptr type="liebermannNote" n="33" target="#Hn_32-3.lnote.oe.33"/> iudices informare<ptr type="liebermannNote" n="34" target="#Hn_32-3.lnote.oe.34"/>, si opus sit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 564 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_32-3.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">die in seinem Rath gehaltenen Leute zu Urtheilsfindern aufstellen</seg><seg type="translation" xml:lang="en" source="#claude">appoint the men held in his council as judgment-finders</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_32-3.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">dominum <hi rend="italic">fügt ein, aber vom Corr. unterpunctirt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">dominum <hi rend="italic">inserted, but expunged by the corrector, Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_32-3.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">h. s. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. s. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_32-3.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">i. h. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. h. <hi rend="italic">Sc Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_32-3.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">inforre, <hi rend="italic">über erstem</hi> r <hi rend="italic">übergeschr.</hi> a <hi rend="italic">Sc Hg;</hi> inforciare <hi rend="italic">Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">inforre, a <hi rend="italic">written above the first</hi> r <hi rend="italic">Sc Hg;</hi> inforciare <hi rend="italic">Edd.</hi></seg></note>
      </div>
