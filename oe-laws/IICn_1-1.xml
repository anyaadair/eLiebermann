        <note type="liebermannNote" subtype="textual" xml:id="IICn_1-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">308</biblScope></bibl><seg type="original" xml:lang="de">-me <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-me Ld</seg></note>
