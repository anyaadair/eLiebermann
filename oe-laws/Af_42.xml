      <div type="clause" n="42">
        <head><ref type="lawCode" target="law:Af">Af</ref> 42</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42" corresp="#wit-e"><pb n="74" ed="#liebermann"/>XXXVIII. Eac we beodað: se mon se<ptr type="liebermannNote" n="14" target="#Af_42.lnote.oe.14"/> ðe his gefan hamsittendne<ptr type="liebermannNote" n="15" target="#Af_42.lnote.oe.15"/> wite, þæt he ne feohte, ær ðam<ptr type="liebermannNote" n="16" target="#Af_42.lnote.oe.16"/> he him ryhtes<ptr type="liebermannNote" n="17" target="#Af_42.lnote.oe.17"/> bidde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42" corresp="#wit-ot-frags"><pb n="74" ed="#liebermann"/>XXXVI.. Eac we beo...: ..ttende wite, ...eohte, ær þam he...idde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42" corresp="#wit-h"><pb n="74" ed="#liebermann"/>XXXVIII. Eac we beodað: se mon<ptr type="liebermannNote" n="5" target="#Af_42.lnote.oe.5"/> se ðe his gefán hamsittende wite, ðæt he ne feohte, ær ðam ðe he him ryhtes bidde.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="42" corresp="#wit-q"><pb n="75" ed="#liebermann"/>Etiam instituimus: homo, qui inimicum suum residentem scit, non ante impugnet<ptr type="liebermannNote" n="12" target="#Af_42.lnote.oe.12"/> eum, quam sibi rectum postulet.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="82" ed="#attenborough"/>Eac we beodað; se mon se ðe his gefan hamsittendne<ptr type="editorNote" n="15" target="#Af_42.attnote.fn.15"/> wite, þæt he ne feohte, ær ðam he<ptr type="editorNote" n="16" target="#Af_42.attnote.fn.16"/> him ryhtes bidde.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="44" corresp="#wit-e"><pb n="342" ed="#jurasinski-and-oliver"/>{XXXVIII} Eac we beodæð: se mon se ðe his gefán hamsittendne wite, þæt he ne feohte, ærðam he him ryhtes bidde.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="75" ed="#liebermann"/>Auch gebieten wir: Jemand<ptr type="liebermannNote" n="1" target="#Af_42.lnote.de.1"/>, der seinen [mit Racherecht<ptr type="liebermannNote" n="2" target="#Af_42.lnote.de.2"/> zu verfolgenden] Feind als auf [eigenem] Hofe sitzend kennt, dass er nicht [in Rache] fechte, bevor er sich<ptr type="liebermannNote" n="3" target="#Af_42.lnote.de.3"/> Recht [im Sühnewege] fordere.<ptr type="liebermannNote" n="4" target="#Af_42.lnote.de.4"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">We also command: someone who knows his [feud-]enemy to be sitting at home [on his own estate] is not to fight [in vengeance] before he demands justice for himself [by way of settlement].</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="83" ed="#attenborough"/>Also we enjoin, that a man who knows his adversary to be residing at home, shall not have recourse to violence before demanding justice of him.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="415" ed="#whitelock"/>Moreover we command: that the man who knows his opponent<ptr type="editorNote" n="2" target="#Af_42.whinote.n.2"/> to be dwelling at home is not to fight before he asks justice for himself.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="343" ed="#jurasinski-and-oliver"/>Likewise we command: for the man who knows that his enemy is sitting at home, that he not fight him before he offers to settle according to law.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IVAtr_4-1">IV Atr 4.1</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">74</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">74</biblScope></bibl><seg type="original" xml:lang="de">-de <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-de Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">74</biblScope></bibl><seg type="original" xml:lang="de">þon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">74</biblScope></bibl><seg type="original" xml:lang="de">rih. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">rih. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">74</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">75</biblScope></bibl><seg type="original" xml:lang="de">e. i. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. i. Lond</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_42.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Benutzt in Hn 82, 1</seg><seg type="translation" xml:lang="en" source="#claude">Used in Hn 82, 1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_42.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Blutrache 8. 14—o; gerechte Heimsuchung 2—b; Selbsthilfe 2. 7; ausässig 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Blutrache 8. 14—o; gerechte Heimsuchung 2—b; Selbsthilfe 2. 7; ausässig 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_42.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">nicht <hi rend="italic">hine</hi> (‘ihn um’) zu ändern</seg><seg type="translation" xml:lang="en" source="#claude">not to be emended to <hi rend="italic">hine</hi> (‘him for’)</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_42.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Zuwiderhandeln kostet in späteren Stellen als ‘Heimsuchung’ 5 £</seg><seg type="translation" xml:lang="en" source="#claude">In later passages contravention costs 5 £, as ‘hamsocn’</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_42.attnote.fn.15" n="15" source="#attenborough"><bibl><biblScope unit="page">82</biblScope></bibl><label>hamsittendne</label><seg type="original" xml:lang="en"><hi rend="italic">hamsittende</hi>. H. &amp; Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_42.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">82</biblScope></bibl><label>he</label><seg type="original" xml:lang="en"><hi rend="italic">ðam ðe he</hi>. H. <hi rend="italic">ær þon he</hi>. Ld.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Af_42.whinote.n.2" n="2" source="#whitelock"><bibl><biblScope unit="page">415</biblScope></bibl><label>opponent</label><seg type="original" xml:lang="en">A man against whom he has a legitimate blood-feud.</seg></note>
      </div>
