      <div type="clause" n="56.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 56.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 56.1" corresp="#wit-lat"><pb n="575" ed="#liebermann"/>Si inter aliquem et firmarium suum, qui non etiam sit homo suus — (set<ptr type="liebermannNote" n="20" target="#Hn_56-1.lnote.oe.20"/>) de hiis (presertim<ptr type="liebermannNote" n="20" target="#Hn_56-1.lnote.oe.20"/>) que ad firmam pertinent —, controuersia<ptr type="liebermannNote" n="21" target="#Hn_56-1.lnote.oe.21"/> oriatur, siue<ptr type="liebermannNote" n="22" target="#Hn_56-1.lnote.oe.22"/> de<ptr type="liebermannNote" n="23" target="#Hn_56-1.lnote.oe.23"/> taleis<ptr type="liebermannNote" n="i" target="#Hn_56-1.lnote.oe.i"/> agatur siue<ptr type="liebermannNote" n="24" target="#Hn_56-1.lnote.oe.24"/> de supplecione<ptr type="liebermannNote" n="25" target="#Hn_56-1.lnote.oe.25"/> in<ptr type="liebermannNote" n="k" target="#Hn_56-1.lnote.oe.k"/> ipso manerio, sit<ptr type="liebermannNote" n="26" target="#Hn_56-1.lnote.oe.26"/> de cetero<ptr type="liebermannNote" n="l" target="#Hn_56-1.lnote.oe.l"/> sicut in ceteris.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 575 (two independent readings of the page images, differences settled against the page); Liebermann’s print numbers this clause [57, 1], in error for 56, 1 (the next label is [56, 2]); numbered here 56, 1</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-1.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Kerbhölzer</hi> (<hi rend="italic">als Quittungen für Leistungen durch den Pächter</hi>). <hi rend="italic">Ein</hi> tallator <hi rend="italic">im königlichen Haushalt vor</hi> 1135 <hi rend="italic">im</hi> Red book of the Exchequer <hi rend="italic">ed. Hall p.</hi> <hi rend="smallcaps">ccc</hi></seg><seg type="translation" xml:lang="en" source="#claude">Tallies (as receipts for renders made by the lessee). A tallator in the royal household before 1135 in the Red book of the Exchequer ed. Hall p. <hi rend="smallcaps">ccc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-1.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ersatz</hi> (<hi rend="italic">Ergänzungsnachwuchs</hi>) <hi rend="italic">an Hörigen und Vieh. Ducange falsch:</hi> exactio extraordinaria, <hi rend="italic">wie</hi> superpositio</seg><seg type="translation" xml:lang="en" source="#claude">Replacement (supplementary new stock) of serfs and cattle. Ducange wrongly: exactio extraordinaria, like superpositio</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-1.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">den nichtvasallatischen Pächter belange der Grundherr im öffentlichen Gericht, den mit Pacht Belehnten im herrschaftlichen</hi></seg><seg type="translation" xml:lang="en" source="#claude">the landlord is to sue the non-vassal lessee in the public court, and the one enfeoffed with the lease in the seignorial court</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Lond; nicht in Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Lond; not in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">-rss. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rss. <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-1.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">si <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">si K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">decaleis <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">decaleis Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-1.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">si <hi rend="italic">Sc K</hi></seg><seg type="translation" xml:lang="en" source="#claude">si Sc K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-1.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">-lic. <hi rend="italic">K Co Or Gi; vgl.</hi> 56, 3</seg><seg type="translation" xml:lang="en" source="#claude">-lic. K Co Or Gi; cf. 56, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-1.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier interpungirt Sc K</hi></seg><seg type="translation" xml:lang="en" source="#claude">punctuated here Sc K</seg></note>
      </div>
