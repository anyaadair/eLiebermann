    <body>
      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 1.1"><pb n="628" ed="#liebermann"/><ptr type="liebermannNote" n="10" target="#ECf_1-1.lnote.la.10"/><hi rend="spaced">De clericis et possessionibus eorum.</hi> Omnis<ptr type="liebermannNote" n="11" target="#ECf_1-1.lnote.la.11"/> clerus<ptr type="liebermannNote" n="bb" target="#ECf_1-1.lnote.la.fn.bb"/> et<ptr type="liebermannNote" n="12" target="#ECf_1-1.lnote.la.12"/> scolares<ptr type="liebermannNote" n="c" target="#ECf_1-1.lnote.la.fn.c"/> et omnes<ptr type="liebermannNote" n="13" target="#ECf_1-1.lnote.la.13"/> eorum possessiones, ubicumque<ptr type="liebermannNote" n="14" target="#ECf_1-1.lnote.la.14"/> fuerint, pacem<ptr type="liebermannNote" n="d" target="#ECf_1-1.lnote.la.fn.d"/> Dei et sancte<ptr type="liebermannNote" n="15" target="#ECf_1-1.lnote.la.15"/> ecclesie habeant.</ab>
        <note type="comparison" source="#liebermann" n="628"><label>printed alongside</label> <ref target="clause:ECfRetr_1-1">ECf retr 1.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 628 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “possessiones” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1-1.lnote.la.fn.bb" n="bb" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verf. erstrebt</hi> (<hi rend="italic">und Retr.</hi> [<hi rend="italic">vgl.</hi> res] <hi rend="italic">benutzt vielleicht</hi>) <hi rend="italic">Stephans Zugeständniss von</hi> 1136: omnium clericorum et rerum eorum iustitiam et potestatem … in manu episcoporum esse perhibeo</seg><seg type="translation" xml:lang="en" source="#claude">the author aims at (and the Retractator [cf. res] perhaps uses) Stephen’s concession of 1136: omnium clericorum et rerum eorum iustitiam et potestatem … in manu episcoporum esse perhibeo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1-1.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">Kirchen-Schüler, <hi rend="italic">nicht</hi> Studenten <hi rend="italic">der erst in Frankreich erblühenden</hi> Universität</seg><seg type="translation" xml:lang="en" source="#claude">church school pupils, not students of the university, which was only then coming into flower in France</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1-1.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">öffentlichen, allgemeinen Schutz <hi rend="italic">wie</hi> Hn 81, 1; <hi rend="italic">also anders als</hi> 2</seg><seg type="translation" xml:lang="en" source="#claude">public, general protection, as in Hn 81, 1; so different from 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1-1.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rubriken fehlen alle Hk adow; diese Rubrik fehlt Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">all the rubrics are lacking in Hk adow; this rubric is lacking in Pl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1-1.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">Omnes clerici <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Omnes clerici Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1-1.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">etiam <hi rend="italic">Ad Pl S Cl;</hi> etiam <hi rend="italic">fügt zu Hr;</hi> omnes <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">etiam Ad Pl S Cl; Hr adds etiam; Hk adds omnes</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1-1.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad Do Wo No Ck</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad Do Wo No Ck</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1-1.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">u. f. <hi rend="italic">fehlt Do No</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. f. lacking in Do No</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1-1.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">ec. s. <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">ec. s. Ad</seg></note>
      </div>
