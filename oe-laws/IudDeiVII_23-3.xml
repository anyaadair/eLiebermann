      <div type="clause" n="23.3">
        <head><ref type="lawCode" target="law:IudDeiVII">Iud Dei VII</ref> 23.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei VII 23.3" corresp="#wit-lat"><pb n="414" ed="#liebermann"/>Si tu reus (uos<ptr type="liebermannNote" n="2" target="#IudDeiVII_23-3.lnote.oe.2"/> rei) sis (-tis<ptr type="liebermannNote" n="2" target="#IudDeiVII_23-3.lnote.oe.2-2"/>), emollias (-tis<ptr type="liebermannNote" n="2" target="#IudDeiVII_23-3.lnote.oe.2-2"/>) cor tuum (-da<ptr type="liebermannNote" n="2" target="#IudDeiVII_23-3.lnote.oe.2-2"/> uestra) et confitearis (-mini<ptr type="liebermannNote" n="2" target="#IudDeiVII_23-3.lnote.oe.2-2"/>), quicquid in hoc scias (-tis<ptr type="liebermannNote" n="2" target="#IudDeiVII_23-3.lnote.oe.2-2"/>).<ptr type="liebermannNote" n="7" target="#IudDeiVII_23-3.lnote.oe.7"/></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 414 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-3.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-3.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">das Angelsächsische</hi> (23 <hi rend="italic">A</hi>) <hi rend="italic">steht <hi rend="spaced">hinter</hi> dem Latein</hi> (23)</seg><seg type="translation" xml:lang="en" source="#claude">the Anglo-Saxon (23 A) stands <hi rend="italic">after</hi> the Latin (23)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-3.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier Sing. über Plur.</hi></seg><seg type="translation" xml:lang="en" source="#claude">here sing. above pl.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-3.lnote.oe.7-2" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de">hæled., <hi rend="italic">übergeschr.</hi> n</seg><seg type="translation" xml:lang="en" source="#claude">hæled., n written above</seg></note>
