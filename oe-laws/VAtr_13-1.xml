    <body>
      <div type="clause" n="13.1">
        <head><ref type="lawCode" target="law:VAtr">V Atr</ref> 13.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="13.1" corresp="#wit-g"><pb n="240" ed="#liebermann"/>⁊ cypinga ⁊ folcgemota on ðam halgan dǽge geswice man georne.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="13.1" corresp="#wit-g2"><pb n="240" ed="#liebermann"/>⁊ cypinga ⁊ folcgemota on þam halgan dæge geswice man georne.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="13.1" corresp="#wit-d"><pb n="241" ed="#liebermann"/>⁊ cipinga ⁊ folcgemota on ða<hi rend="italic">m</hi> halgan dæge geswice man georne.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="13.1" corresp="#wit-d"><pb n="82" ed="#robertson"/>⁊ cipinga ⁊ folcgemota on ðam halgan dæge geswice man georne.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g"><pb n="152" ed="#rabin-doml"/>And cypinga and folcgemota on ðam halgan dæge geswice man georne.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="241" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#VAtr_13-1.lnote.de.1"/> Kaufgeschäfte<ptr type="liebermannNote" n="2" target="#VAtr_13-1.lnote.de.2"/> und [gerichtliche] Volksversammlungen<ptr type="liebermannNote" n="3" target="#VAtr_13-1.lnote.de.3"/> stelle man willig ein an diesem heiligen Tage.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let trading and [judicial] public assemblies be eagerly given up on that holy day.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d"><pb n="83" ed="#robertson"/>And marketings<ptr type="editorNote" n="1" target="#VAtr_13-1.robnote.n.1"/> and meetings shall be strictly abstained from on the holy day.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-g"><pb n="449" ed="#whitelock"/>And one is readily to abstain from markets and public meetings<ptr type="editorNote" n="5" target="#VAtr_13-1.whinote.n.5"/> on the holy day.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g"><pb n="153" ed="#rabin-doml"/>And one must assiduously avoid markets and meetings on that holy day.</ab>
        <note type="comparison" source="#liebermann" n="241"><ref target="clause:EGu_7">EGu 7</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. E Gu. 7</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VIAtr_22-1">VI Atr 22.1</ref></note>
        <note type="editorial">Liebermann compares EGu 7.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_13-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">172</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">= VI 22, 2 (= teilweise VIII 17) = I Cn 15</seg><seg type="translation" xml:lang="en" source="#claude">= VI 22, 2 (= partly VIII 17) = I Cn 15</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_13-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">172</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Sonntag 5ff., Gerichtsferien 1</seg><seg type="translation" xml:lang="en" source="#claude">See <hi rend="italic">Gl</hi> Sonntag 5ff., Gerichtsferien 1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_13-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">172</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Nochmals <hi rend="italic">u</hi>. 19</seg><seg type="translation" xml:lang="en" source="#claude">Again <hi rend="italic">below</hi> 19</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VAtr_13-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="en">Cf. IV Atr. 2, 3 and note; VI, 22, 1; VIII, 17; I Cn. 15; <hi rend="italic">N.P.L.</hi> 55.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="VAtr_13-1.whinote.n.5" n="5" source="#whitelock"><bibl><biblScope unit="page">449</biblScope></bibl><label>meetings</label><seg type="original" xml:lang="en">VI Ethelred adds “and hunting expeditions and secular work”</seg></note>
      </div>
    </body>
