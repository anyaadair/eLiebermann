        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.27</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.27" corresp="#wit-lat"><pb n="580" ed="#liebermann"/>Si quis ex<ptr type="liebermannNote" n="22" target="#Hn_59-27.lnote.oe.22"/> proclamacione<ptr type="liebermannNote" n="o" target="#Hn_59-27.lnote.oe.o"/>, quam<ptr type="liebermannNote" n="23" target="#Hn_59-27.lnote.oe.23"/> apud iusticiam fecerit, placitum suscipiat, quod de furto uel robaria<ptr type="liebermannNote" n="24" target="#Hn_59-27.lnote.oe.24"/> uel<ptr type="liebermannNote" n="25" target="#Hn_59-27.lnote.oe.25"/> huiusmodi sit, nullam inde sine licentia iustitie latentem uel patentem reconciliationem<ptr type="liebermannNote" n="26" target="#Hn_59-27.lnote.oe.26"/> faciat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 580 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-27.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht aus Af</hi> 22</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">perhaps from Af</hi> 22</seg></note>
