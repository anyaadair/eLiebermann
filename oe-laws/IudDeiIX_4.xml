    <body>
      <div type="clause" n="4">
        <head><ref type="lawCode" target="law:IudDeiIX">Iud Dei IX</ref> 4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IX 4" corresp="#wit-lat"><ptr type="liebermannNote" n="40" target="#IudDeiIX_4.lnote.oe.40"/><pb n="416" ed="#liebermann"/>Benedictio in<ptr type="liebermannNote" n="41" target="#IudDeiIX_4.lnote.oe.41"/> conclusione ferri. <ptr type="liebermannNote" n="42" target="#IudDeiIX_4.lnote.oe.42"/>Benedictio Dei Patris et Filii et Spiritus sancti descendat super hoc ferrum (uel<ptr type="liebermannNote" n="43" target="#IudDeiIX_4.lnote.oe.43"/> hęc ferramenta) ad discernendum iudicium Dei. Amen.<ptr type="liebermannNote" n="44" target="#IudDeiIX_4.lnote.oe.44"/></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 416 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_4.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">in Rj fehlt</hi> 4, <hi rend="italic">folgt II</hi> 2—2, 7 (= <hi rend="italic">V</hi> 1), <hi rend="italic">oben S.</hi> 406¹⁰ <hi rend="italic">als</hi> Rj 1 <hi rend="italic">verglichen</hi></seg><seg type="translation" xml:lang="en" source="#claude">in Rj 4 is missing; there follows II 2—2, 7 (= V 1), collated above p. 406¹⁰ as Rj 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_4.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de">ad ferrum <hi rend="italic">statt</hi> in c. f. <hi rend="italic">Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad ferrum instead of in c. f. Vt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_4.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de">4 <hi rend="italic">auch in Ci, hinter II</hi> 4, 3 <hi rend="italic">oben S.</hi> 407ᵇ; <hi rend="italic">unten XI</hi> 6. <hi rend="italic">XVI</hi> 38, 2; <hi rend="italic">Zeumer</hi> 616<hi rend="italic">h</hi></seg><seg type="translation" xml:lang="en" source="#claude">4 also in Ci, after II 4, 3 above p. 407ᵇ; below XI 6. XVI 38, 2; Zeumer 616h</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_4.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de">u. h. f. <hi rend="italic">fehlt Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. h. f. missing in Vt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_4.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt in Rj Ch Vt</hi> I—III, <hi rend="italic">oben S.</hi> 401 [<hi rend="italic">wohl nicht nach dem Willen des Verfassers, da in</hi> II 4 <hi rend="italic">fast ganz</hi> IX 2 <hi rend="italic">wiederkehrt</hi>].</seg><seg type="translation" xml:lang="en" source="#claude">followed in Rj Ch Vt by I—III, above p. 401 [probably not as the author intended, since IX 2 recurs almost in full in II 4].</seg></note>
      </div>
