          <sense n="4">~, þæt <hi rend="italic">befehlen, verfügen, verordnen, dass</hi> <ref type="lawCode" target="law:IEw">I Ew</ref> 1. <ref type="lawCode" target="law:IIEw">II</ref> 4. <ref type="lawCode" target="law:IAs">I As</ref> 1. 4. <ref type="lawCode" target="law:VAs">V</ref> 1,1 <ref type="lawCode" target="law:Ld">Ld</ref> (an, <hi rend="italic">concedo</hi> <ref type="lawCode" target="law:H">H</ref>). <ref type="lawCode" target="law:Hu">Hu</ref> 7. <ref type="lawCode" target="law:IIIEg">III Eg</ref> 1. 1,1. <ref type="lawCode" target="law:IVEg">IV</ref> 1,6. <ref type="lawCode" target="law:VIIaAtr">VIIa Atr</ref> 1. <ref type="lawCode" target="law:VIIIAtr">VIII</ref> 1. <ref type="lawCode" target="law:Northu">Northu</ref> 57,1. <ref type="lawCode" target="law:WiLond">Wl Lond</ref> 2 <ref type="abbreviation" target="gram:folgende"><abbr>f.</abbr></ref> <ref type="lawCode" target="law:IICn">II Cn</ref> 75 <ref type="lawCode" target="law:MsA">A</ref>; læte riht <ref type="lawCode" target="law:G">G</ref></sense>
          <sense n="4a"><hi rend="italic">eingeschoben, <ref type="abbreviation" target="gram:ohne"><abbr>ohne</abbr></ref> Construirung <ref type="abbreviation" target="gram:mit"><abbr>mit</abbr></ref> Übrigem;</hi> gehwelc, we willað, sie <ref type="lawCode" target="law:Af">Af</ref> 5,5</sense>
          <sense n="5"><hi rend="italic">belieben zu;</hi> gif him cyning arian (geþafian) wille <ref type="lawCode" target="law:Ine">Ine</ref> 36,1 (<ref type="lawCode" target="law:IIIEg">III Eg</ref> 3 = <ref type="lawCode" target="law:IICn">II Cn</ref> 15,1)</sense>
          <sense n="6"><hi rend="italic">entscheiden, wählen;</hi> swa cyning wille <ref type="lawCode" target="law:Wi">Wi</ref> 27; swa hwæðer man wille <ref type="lawCode" target="law:ICn">I Cn</ref> Insc <ref type="lawCode" target="law:MsA">A</ref>; swa he wylle swa ordal swa að <ref type="lawCode" target="law:IAtr">I Atr</ref> 1,3; do þæt þæt he wille <ref type="lawCode" target="law:IIEg">II Eg</ref> 2,1</sense>
          <sense n="7">[<hi rend="italic"><ref type="abbreviation" target="gram:neuenglisch"><abbr>neuengl.</abbr></ref></hi>] <hi rend="italic">gewohnt sein, pflegen zu;</hi> wolde sweogian <ref type="lawCode" target="law:VAtr">V Atr</ref> 32,3 <ref type="lawCode" target="law:D">D</ref></sense>
          <sense n="8">[<hi rend="italic">auxiliar, futurisch</hi>] <hi rend="italic">werden;</hi> <ref type="lawCode" target="law:IVEg">IV Eg</ref> 1,5. <ref type="lawCode" target="law:IIAtr">II Atr</ref> 9. <ref type="lawCode" target="law:VIIaAtr">VIIa</ref> 4,1, deberet <hi rend="italic"><ref type="abbreviation" target="gram:ubersetzend"><abbr>übsnd</abbr></ref></hi> | hwæt lician wolde <hi rend="italic">was künftig gefallen würde</hi> <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 49,9 | God lufian woldon <ref type="lawCode" target="law:EGu">EGu</ref> Pro 1 | gif we gelæstan ~að, .. þeofas ~að rixian <ref type="lawCode" target="law:VIAs">VI As</ref> 8,9 | ic wille earnian <ref type="lawCode" target="law:Swer">Swer</ref> 1 | <hi rend="italic">verbürgen,</hi> þæt he wille healdan <ref type="lawCode" target="law:Northu">Northu</ref> 2,3</sense>
          <sense n="9">[<hi rend="italic">auxiliar</hi>] <hi rend="italic">sollen, mögen, können;</hi> ne læte he hyne oferwealdan, <ref type="abbreviation" target="gram:accusativus"><abbr>ac</abbr></ref> wille he ælcne <hi rend="italic">möge</hi> (<hi rend="italic">soll</hi>) <hi rend="italic">jeden</hi> [<hi rend="italic">regiren</hi>] <ref type="lawCode" target="law:Ger">Ger</ref> 7 | gif he don wolde <hi rend="italic">täte, tun würde</hi> <ref type="lawCode" target="law:IVEg">IV Eg</ref> 1,5a | <hi rend="italic">Relativ</hi> <pb n="245"/><hi rend="italic">verallgemeinernd:</hi> þe eardian wille <hi rend="italic">wer immer wohnt</hi> <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 35, qui habitat <hi rend="italic"><ref type="abbreviation" target="gram:ubersetzend"><abbr>übsnd</abbr></ref></hi> | swa belimpan wille <ref type="lawCode" target="law:Af">Af</ref> 6 | sie þær he wille <hi rend="italic"><ref type="abbreviation" target="gram:wo"><abbr>wo</abbr></ref> <ref type="abbreviation" target="gram:immer"><abbr>immer</abbr></ref> er</hi> [<hi rend="italic">sein</hi>] <hi rend="italic">mag</hi> <ref type="lawCode" target="law:Wi">Wi</ref> 8. — <hi rend="italic"><ref type="abbreviation" target="gram:Derivativ"><abbr>Der.</abbr></ref>:</hi> <ref type="entry" target="entry:nellan">nellan</ref>, <hi rend="italic">womit</hi> ne ~ [<hi rend="italic"><ref type="abbreviation" target="gram:sieheNummer"><abbr>s. n.</abbr></ref></hi> 1d] <hi rend="italic">variirt</hi></sense>
