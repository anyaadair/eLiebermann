      <div type="clause" n="61.11">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 61.11</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 61.11" corresp="#wit-lat"><pb n="582" ed="#liebermann"/>Si quis inter<ptr type="liebermannNote" n="1" target="#Hn_61-11.lnote.oe.1"/> homines suos per eorum querimoniam placitum ipse posuit et idem promiserit interesse, nulli eorum quorum causa est<ptr type="liebermannNote" n="2" target="#Hn_61-11.lnote.oe.2"/> sine prelocucione uel eius<ptr type="liebermannNote" n="2" target="#Hn_61-11.lnote.oe.2"/> licentia respectare uel inde<ptr type="liebermannNote" n="3" target="#Hn_61-11.lnote.oe.3"/> finire possit<ptr type="liebermannNote" n="4" target="#Hn_61-11.lnote.oe.4"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 582 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-11.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">per <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">per Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-11.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-11.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">in fide <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">in fide Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-11.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">licet <hi rend="italic">hatte Verfasser schreiben wollen</hi></seg><seg type="translation" xml:lang="en" source="#claude">the author had meant to write licet</seg></note>
