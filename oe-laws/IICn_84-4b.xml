        <note type="editorNote" subtype="footnote" xml:id="IICn_84-4b.robnote.fn.2" n="2" source="#robertson"><bibl><biblScope unit="page">218</biblScope></bibl><label>þæt</label><seg type="original" xml:lang="en"><hi rend="italic">þæs þe</hi> A, Ld.</seg></note>
