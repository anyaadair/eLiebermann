      <div type="clause" n="59.25">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.25</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.25" corresp="#wit-lat"><pb n="580" ed="#liebermann"/>Si plures serui furentur, unus<ptr type="liebermannNote" n="i" target="#Hn_59-25.lnote.oe.i"/> pro omnibus paciatur; et is<ptr type="liebermannNote" n="13" target="#Hn_59-25.lnote.oe.13"/> sit<ptr type="liebermannNote" n="14" target="#Hn_59-25.lnote.oe.14"/> quem<ptr type="liebermannNote" n="k" target="#Hn_59-25.lnote.oe.k"/> obtuleri[n]t<ptr type="liebermannNote" n="15" target="#Hn_59-25.lnote.oe.15"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 580 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-25.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch</hi> IV As. 6, 5 <hi rend="italic">f. zahlen für Einen diebischen Sklaven die anderen (wohl als Mitwisser, die jenen als Hauptthäter bezeichnen)</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">in</hi> IV As. 6, 5 <hi rend="italic">f. too the others pay for one thieving slave (probably as accessories, who designate him as the principal offender)</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-25.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 87, 10</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 87, 10</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-25.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de">hiis <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">hiis <hi rend="italic">Co Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-25.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de">fit <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">fit <hi rend="italic">Sc Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-25.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de">-rit <hi rend="italic">Hss. Edd.;</hi> sors <hi rend="italic">ergänzt davor Wi Tho</hi> [<hi rend="italic">falsch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">-rit <hi rend="italic">MSS edd.;</hi> sors <hi rend="italic">supplied before it by Wi Tho</hi> [<hi rend="italic">wrongly</hi>]</seg></note>
      </div>
