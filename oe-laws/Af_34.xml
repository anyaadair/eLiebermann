        <note type="liebermannNote" subtype="textual" xml:id="Af_34.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">heom lædaþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">heom lædaþ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_34.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">gebrin. <hi rend="italic">So;</hi> gebringan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gebrin. So; gebringan Ld</seg></note>
