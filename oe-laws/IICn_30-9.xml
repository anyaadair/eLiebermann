      <div type="clause" n="30.9">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 30.9</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="30.9" corresp="#wit-g-a"><pb n="334" ed="#liebermann"/>⁊ gif heo<ptr type="liebermannNote" n="17" target="#IICn_30-9.lnote.oe.17"/> forð ne cume<ptr type="liebermannNote" n="18" target="#IICn_30-9.lnote.oe.18"/>, fo se cingc<ptr type="liebermannNote" n="19" target="#IICn_30-9.lnote.oe.19"/> to þam were. ⁊ beo se<ptr type="liebermannNote" n="20" target="#IICn_30-9.lnote.oe.20"/> þeof utlah wið eal folc.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="30.9" corresp="#wit-b"><pb n="334" ed="#liebermann"/>forð ne cume, fo se cyng to ðam wére. ⁊ beo seo<ptr type="liebermannNote" n="4" target="#IICn_30-9.lnote.oe.4"/> þeof utlah wið eal folc.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="30.9" corresp="#wit-a"><pb n="334" ed="#liebermann"/>And gif he<ptr type="liebermannNote" n="1" target="#IICn_30-9.lnote.oe.1"/> forð ne cume, fo se cynincg to þam were. ⁊ beo seo<ptr type="liebermannNote" n="1" target="#IICn_30-9.lnote.oe.1"/> þeof utlah wið ealle<ptr type="liebermannNote" n="1" target="#IICn_30-9.lnote.oe.1"/> folc.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="30.9" corresp="#wit-q"><pb n="335" ed="#liebermann"/>Si deficiat, habeat rex ipsam wéram; et fur apud omnem populum útlaga sit.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="30.9" corresp="#wit-inst-cn"><pb n="335" ed="#liebermann"/>Si purgare se<ptr type="liebermannNote" n="6" target="#IICn_30-9.lnote.oe.6"/> non poterit, rex habeat illud<ptr type="liebermannNote" n="7" target="#IICn_30-9.lnote.oe.7"/> prętium<ptr type="liebermannNote" n="8" target="#IICn_30-9.lnote.oe.8"/>; et latro habeatur exul et reus ab omni populo.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="30.9" corresp="#wit-cons-cn"><pb n="335" ed="#liebermann"/>Si autem defecerit (purgatio), redempcio (furis) contingat regi; fur autem sit exlex erga uniuersum populum.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="30.9" corresp="#wit-b"><pb n="192" ed="#robertson"/>⁊ gif heo]<ptr type="editorNote" n="3" target="#IICn_30-9.robnote.fn.3"/> forð ne cume, fo se cyng to þam wére ⁊ beo seo þeof utlah wið eal folc.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="272" ed="#rabin-doml"/>And gif heo forð ne cume, fo se cingc to þam were and beo se þeof utlah wið eal folc.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="335" ed="#liebermann"/>Und wenn sie nicht zu Stande kommt, erhalte der König dies Wergeld. Und jener Dieb sei friedlos beim ganzen Volke.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if it does not succeed, let the king take that wergild. And let the thief be an outlaw with respect to the whole people.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="193" ed="#robertson"/>And if he fails, the king shall take the wergeld, and the thief shall be treated as an outlaw by the whole nation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="466" ed="#whitelock"/>And if it does not succeed, the king is to succeed to the wergild, and the thief is to be an outlaw as regards the whole people.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="273" ed="#rabin-doml"/>And if it does not succeed, the king shall take his wergild and the thief shall be adjudged an outlaw by the entire realm.</ab>
        <note type="comparison" source="#liebermann" n="335"><ref target="clause:IAtr_1-9a">I Atr 1.9a</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 1, 9a</note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="129"><ref target="clause:Af_22">Af 22</ref></note>
        <note type="editorial">Liebermann compares I Atr 1.9a.; BR: added from Gesetze I p. 335, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">And gif heo: omitted B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-9.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">335</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-9.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">335</biblScope></bibl><seg type="original" xml:lang="de">erit e. e. omnem p. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">erit e. e. omnem p. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-9.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">334</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-9.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">334</biblScope></bibl><seg type="original" xml:lang="de">hit <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hit Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-9.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">334</biblScope></bibl><seg type="original" xml:lang="de">cyme <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyme Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-9.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">334</biblScope></bibl><seg type="original" xml:lang="de">cyning <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyning Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-9.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">334</biblScope></bibl><seg type="original" xml:lang="de">seo <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">seo Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-9.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">334</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-9.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">335</biblScope></bibl><seg type="original" xml:lang="de">se p. <hi rend="italic">Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">se p. Lb S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-9.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">335</biblScope></bibl><seg type="original" xml:lang="de">p. i. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. i. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_30-9.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">335</biblScope></bibl><seg type="original" xml:lang="de">latronis <hi rend="italic">fügt zu S</hi></seg><seg type="translation" xml:lang="en" source="#claude">S adds latronis</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_30-9.robnote.fn.3" n="3" source="#robertson"><bibl><biblScope unit="page">192</biblScope></bibl><label>heo</label><seg type="original" xml:lang="en">G, A, Ld; om. B.</seg></note>
      </div>
