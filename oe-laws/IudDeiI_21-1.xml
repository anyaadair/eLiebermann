      <div type="clause" n="21.1">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 21.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 21.1" corresp="#wit-lat"><pb n="404" ed="#liebermann"/>Adiuro etiam<ptr type="liebermannNote" n="54" target="#IudDeiI_21-1.lnote.oe.54"/> te per ineffabile nomen<ptr type="liebermannNote" n="55" target="#IudDeiI_21-1.lnote.oe.55"/> Iesu<ptr type="liebermannNote" n="49" target="#IudDeiI_21-1.lnote.oe.49"/> Christi, filii Dei uiui<ptr type="liebermannNote" n="56" target="#IudDeiI_21-1.lnote.oe.56"/>, sub cuius<ptr type="liebermannNote" n="57" target="#IudDeiI_21-1.lnote.oe.57"/> pedibus mare<ptr type="liebermannNote" n="58" target="#IudDeiI_21-1.lnote.oe.58"/> et<ptr type="liebermannNote" n="59" target="#IudDeiI_21-1.lnote.oe.59"/> elementum diuisum<ptr type="liebermannNote" n="60" target="#IudDeiI_21-1.lnote.oe.60"/> se calcabile<ptr type="liebermannNote" n="61" target="#IudDeiI_21-1.lnote.oe.61"/> prebuit, qui<ptr type="liebermannNote" n="62" target="#IudDeiI_21-1.lnote.oe.62"/> etiam baptizari se<ptr type="liebermannNote" n="63" target="#IudDeiI_21-1.lnote.oe.63"/> in aquarum elemento uoluit.</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Matth. 14, 2; 3, 16</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 404 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-1.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">+ <hi rend="italic">über der Zeile H</hi></seg><seg type="translation" xml:lang="en" source="#claude">+ above the line H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-1.lnote.oe.54" n="54" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. aus</hi> te e. <hi rend="italic">H Co;</hi> te e. <hi rend="italic">Tr Vt2 Zeu.</hi> 664</seg><seg type="translation" xml:lang="en" source="#claude">corrected from te e. H Co; te e. Tr Vt2 Zeu. 664</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-1.lnote.oe.55" n="55" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">domini <hi rend="italic">fügt zu Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">domini added by Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-1.lnote.oe.56" n="56" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">omnipotentis XIII <hi rend="italic">Zeu.</hi> 664. 694</seg><seg type="translation" xml:lang="en" source="#claude">omnipotentis XIII Zeu. 664. 694</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-1.lnote.oe.57" n="57" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">p. c. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. c. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-1.lnote.oe.58" n="58" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">el. maris se ca. XIII</seg><seg type="translation" xml:lang="en" source="#claude">el. maris se ca. XIII</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-1.lnote.oe.59" n="59" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">bei Zeu. nur Hs. S. Germain;</hi> mare el. aquarum, se <hi rend="italic">übrige Zeu.</hi> 694</seg><seg type="translation" xml:lang="en" source="#claude">et in Zeu. only MS S. Germain; mare el. aquarum, se the rest, Zeu. 694</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-1.lnote.oe.60" n="60" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier</hi> diuisum est <hi rend="italic">nur Hs. Lambach; verschoben aus</hi> 21, 3?</seg><seg type="translation" xml:lang="en" source="#claude">diuisum est here only MS Lambach; displaced from 21, 3?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-1.lnote.oe.61" n="61" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">-lem <hi rend="italic">Ch Ca H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lem Ch Ca H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-1.lnote.oe.62" n="62" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">in te <hi rend="italic">fügt zu</hi> XIII <hi rend="italic">Zeu.</hi> 664</seg><seg type="translation" xml:lang="en" source="#claude">in te added by XIII Zeu. 664</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-1.lnote.oe.63" n="63" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">se in a. e. <hi rend="italic">fehlt</hi> XIII <hi rend="italic">Zeu.</hi> 664</seg><seg type="translation" xml:lang="en" source="#claude">se in a. e. lacking in XIII Zeu. 664</seg></note>
