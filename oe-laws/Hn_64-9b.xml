        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 64.9b" corresp="#wit-lat"><pb n="585" ed="#liebermann"/>Et inducatur simplex lada<ptr type="liebermannNote" n="15" target="#Hn_64-9b.lnote.oe.15"/> simplici preiuramento<ptr type="liebermannNote" n="16" target="#Hn_64-9b.lnote.oe.16"/>, triplex lada triplici preiuracione<ptr type="liebermannNote" n="17" target="#Hn_64-9b.lnote.oe.17"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 585 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-9b.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de">lada — triplex <hi rend="italic">überspringt K Co Or Gi Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">K Co Or Gi Sp skip lada — triplex</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-9b.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu ohne Hss. Wi;</hi> periu. <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">Wi adds et without MSS; periu. Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-9b.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de">periu. <hi rend="italic">Co Or Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">periu. Co Or Wh</seg></note>
