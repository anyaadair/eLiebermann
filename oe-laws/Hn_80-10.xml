      <div type="clause" n="80.10">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 80.10</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 80.10" corresp="#wit-lat"><ptr type="liebermannNote" n="21" target="#Hn_80-10.lnote.oe.21"/><pb n="597" ed="#liebermann"/>Hamsocna — quod<ptr type="liebermannNote" n="h" target="#Hn_80-10.lnote.oe.h"/> domus inuasionem Latine sonat — fit pluribus modis, <ptr type="liebermannNote" n="hh" target="#Hn_80-10.lnote.oe.hh"/>extrinsec[i]s<ptr type="liebermannNote" n="22" target="#Hn_80-10.lnote.oe.22"/> uel et<ptr type="liebermannNote" n="23" target="#Hn_80-10.lnote.oe.23"/> intrinsec[i]s<ptr type="liebermannNote" n="22" target="#Hn_80-10.lnote.oe.22"/> accidenciis.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 597 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-10.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ebenso übersetzen</hi> In Cn <hi rend="italic">und</hi> Cons. Cn. II 62. <hi rend="italic">In den folg. Sätzen sehen</hi> ‘the constructive jurisprudence of hamsocn’ <hi rend="italic">Pollock-Maitland</hi> HEL. II 456. <hi rend="italic">Er entfloss nicht</hi> II Em. 6; IV Atr. 4; II Cn. 62; Leis Wl 2. 15</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">translated likewise by</hi> In Cn <hi rend="italic">and</hi> Cons. Cn. II 62. <hi rend="italic">In the following clauses</hi> <hi rend="italic">Pollock-Maitland</hi> HEL. II 456 <hi rend="italic">see</hi> ‘the constructive jurisprudence of hamsocn’. <hi rend="italic">It did not derive from</hi> II Em. 6; IV Atr. 4; II Cn. 62; Leis Wl 2. 15</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-10.lnote.oe.hh" n="hh" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 9, 4<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">as</hi> 9, 4<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-10.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">80, 10 <hi rend="italic">überspr. K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">80, 10 skipped by K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-10.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">-cus <hi rend="italic">Hss. Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cus MSS edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-10.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-10.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgt. Gl</hi> Heimsuchung 5; zum Steinigen des Hauses gibt Babut in <hi rend="italic">Mélanges Bémont</hi> 260 Belege von 1304 und c. 1320.—Am Rande spät: <hi rend="italic">Diffinicio hamsoke</hi> und zu 80, 11–c: <hi rend="italic">Totum de hamsoke</hi>—{21}<hi rend="italic">H. est quod L. d. i. s</hi>.—<hi rend="italic">-cus</hi>{22} <hi rend="italic">intrinsecus</hi> ohne <hi rend="italic">uel et</hi>{23}—80, 11 <hi rend="italic">alium</hi>{24} <hi rend="italic">fehlt</hi>—80, 11a <hi rend="italic">esse</hi>{30} fehlt—80, 11c <hi rend="italic">in</hi>{5} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Heimsuchung 5; on the stoning of the house Babut in <hi rend="italic">Mélanges Bémont</hi> 260 gives instances from 1304 and c. 1320.—In the margin, in a late hand: <hi rend="italic">Diffinicio hamsoke</hi> and on 80, 11–c: <hi rend="italic">Totum de hamsoke</hi>—{21}<hi rend="italic">H. est quod L. d. i. s</hi>.—<hi rend="italic">-cus</hi>{22} <hi rend="italic">intrinsecus</hi> without <hi rend="italic">uel et</hi>{23}—80, 11 <hi rend="italic">alium</hi>{24} <hi rend="italic">omitted</hi>—80, 11a <hi rend="italic">esse</hi>{30} omitted—80, 11c <hi rend="italic">in</hi>{5} Rs</seg></note>
      </div>
