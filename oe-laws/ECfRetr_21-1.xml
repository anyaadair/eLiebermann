      <div type="clause" n="21.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 21.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 21.1"><pb n="647" ed="#liebermann"/>Quodsi<ptr type="liebermannNote" n="20" target="#ECfRetr_21-1.lnote.la.20"/> <hi rend="bold">cui</hi> forisfacerent<ptr type="liebermannNote" n="21" target="#ECfRetr_21-1.lnote.la.21"/>, et clamor uicinorum de eis assurgeret, ipsi<ptr type="liebermannNote" n="22" target="#ECfRetr_21-1.lnote.la.22"/> <hi rend="bold">tenerent</hi> eos rectitudini in curia sua<ptr type="liebermannNote" n="23" target="#ECfRetr_21-1.lnote.la.23"/>, <hi rend="bold">illi</hi><ptr type="liebermannNote" n="24" target="#ECfRetr_21-1.lnote.la.24"/> <hi rend="bold">dico qui</hi> habebant<ptr type="liebermannNote" n="25" target="#ECfRetr_21-1.lnote.la.25"/> sacham<ptr type="liebermannNote" n="26" target="#ECfRetr_21-1.lnote.la.26"/> et socam<ptr type="liebermannNote" n="27" target="#ECfRetr_21-1.lnote.la.27"/>, tol<ptr type="liebermannNote" n="28" target="#ECfRetr_21-1.lnote.la.28"/> et theam<ptr type="liebermannNote" n="29" target="#ECfRetr_21-1.lnote.la.29"/> et infangenetheof<ptr type="liebermannNote" n="30" target="#ECfRetr_21-1.lnote.la.30"/>.</ab>
        <note type="comparison" source="#liebermann" n="647"><label>printed alongside</label> <ref target="clause:ECf_21-1">ECf 21.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 647 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_21-1.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">Qui si <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Qui si Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_21-1.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">-fecerint <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-fecerint Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_21-1.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">episcopi <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">episcopi Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_21-1.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Va Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">Va Ph add et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_21-1.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">illis <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">illis Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_21-1.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">haberent <hi rend="italic">Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">haberent Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_21-1.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">saccam <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">saccam Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_21-1.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">soccam et <hi rend="italic">Hv;</hi> socham <hi rend="italic">Cb Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">soccam et Hv; socham Cb Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_21-1.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">toll <hi rend="italic">Cb;</hi> thol <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">toll Cb; thol K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_21-1.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">them <hi rend="italic">Lb Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">them Lb Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_21-1.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">647</biblScope></bibl><seg type="original" xml:lang="de">-gendef <hi rend="italic">Va;</hi> -gethefe <hi rend="italic">Sp;</hi> -geneþief <hi rend="italic">Cb;</hi> -nþef <hi rend="italic">Lb;</hi> -thef <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gendef Va; -gethefe Sp; -geneþief Cb; -nþef Lb; -thef K</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And if they committed an offence against anyone, and the outcry of the neighbours rose against them, they should hold them to right in their court — those, I say, who had sake and soke, toll and team and infangentheof.</ab>
      </div>
