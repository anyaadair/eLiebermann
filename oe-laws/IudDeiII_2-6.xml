      <div type="clause" n="2.6">
        <head><ref type="lawCode" target="law:IudDeiII">Iud Dei II</ref> 2.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei II 2.6" corresp="#wit-lat"><pb n="406" ed="#liebermann"/>ut<ptr type="liebermannNote" n="32" target="#IudDeiII_2-6.lnote.oe.32"/> a<ptr type="liebermannNote" n="33" target="#IudDeiII_2-6.lnote.oe.33"/> tactu eius<ptr type="liebermannNote" n="34" target="#IudDeiII_2-6.lnote.oe.34"/> furti<ptr type="liebermannNote" n="35" target="#IudDeiII_2-6.lnote.oe.35"/> — uel homicidii uel<ptr type="liebermannNote" n="36" target="#IudDeiII_2-6.lnote.oe.36"/> adulterii<ptr type="liebermannNote" n="37" target="#IudDeiII_2-6.lnote.oe.37"/> —, cuius<ptr type="liebermannNote" n="38" target="#IudDeiII_2-6.lnote.oe.38"/> inquisitio agitur, conscii<ptr type="liebermannNote" n="39" target="#IudDeiII_2-6.lnote.oe.39"/> exhorrescant<ptr type="liebermannNote" n="40" target="#IudDeiII_2-6.lnote.oe.40"/>, et manus eorum<ptr type="liebermannNote" n="41" target="#IudDeiII_2-6.lnote.oe.41"/> (uel<ptr type="liebermannNote" n="e" target="#IudDeiII_2-6.lnote.oe.e"/> pedes) comburantur<ptr type="liebermannNote" n="42" target="#IudDeiII_2-6.lnote.oe.42"/> aliquatenus,</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 406 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-6.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">u. p. <hi rend="italic">lässt fort Co, gemäss Engl. Recht, s. o. Anm. c; u. S.</hi> 407ᵃ</seg><seg type="translation" xml:lang="en" source="#claude">u. p. left out by Co, in accordance with English law, see above n. c; below p. 407ᵃ</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-6.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">ut -cuius <hi rend="italic">am Rande H; vgl. Note</hi> 38</seg><seg type="translation" xml:lang="en" source="#claude">ut -cuius in the margin H; cf. note 38</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-6.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">ad tactum <hi rend="italic">Rj1;</hi> attactu <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad tactum Rj1; attactu H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-6.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">huius sacrilegii <hi rend="italic">Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">huius sacrilegii Vt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-6.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">huius <hi rend="italic">fügt zu Ch;</hi> fu.—adult. <hi rend="italic">fehlt Al Co;</hi> furtum criminis exh. <hi rend="italic">Rj1</hi></seg><seg type="translation" xml:lang="en" source="#claude">huius added by Ch; fu.—adult. omitted in Al Co; furtum criminis exh. Rj1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-6.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">aut <hi rend="italic">Ci Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">aut Ci Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-6.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">siue alicuius néui <hi rend="italic">fügt zu Ci Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">siue alicuius néui added by Ci Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-6.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">attactū eius rei cuius <hi rend="italic">im Text H</hi></seg><seg type="translation" xml:lang="en" source="#claude">attactū eius rei cuius in the text H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-6.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">uel -us <hi rend="italic">übergeschr. H;</hi> -us uel -scii <hi rend="italic">und so stets Sing. Ch Ci Co, daneben</hi> uel <hi rend="italic">mit Plural Ch; darüber Plural Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel -us written above H; -us uel -scii, and likewise the singular throughout, Ch Ci Co, alongside it uel with the plural Ch; the plural written above Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-6.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">-at <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-at written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-6.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">-ius <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ius written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-6.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">-atur <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-atur written above H</seg></note>
      </div>
