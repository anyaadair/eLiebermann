      <div type="clause" n="18.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 18.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="18.1" corresp="#wit-g-a"><pb n="320" ed="#liebermann"/>⁊ þær<ptr type="liebermannNote" n="22" target="#IICn_18-1.lnote.oe.22"/> beo on þære scire<ptr type="liebermannNote" n="23" target="#IICn_18-1.lnote.oe.23"/> bisceop ⁊ se ealdorman, ⁊ þær ægþer tæcan<ptr type="liebermannNote" n="24" target="#IICn_18-1.lnote.oe.24"/> ge Godes riht ge woruldriht.<ptr type="liebermannNote" n="25" target="#IICn_18-1.lnote.oe.25"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="18.1" corresp="#wit-b"><pb n="320" ed="#liebermann"/>⁊ þær beo on ðære scire bisceop ⁊ se ealdorman, ⁊ þær ægðer tæcan ge Godes riht ge woruldriht.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="18.1" corresp="#wit-a"><pb n="320" ed="#liebermann"/>⁊ þær beo on ðare scyre biscop ⁊ se ealdorman, ⁊ þær ægðer teacean ge Godes riht ge weoruldriht.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="18.1" corresp="#wit-q"><pb n="321" ed="#liebermann"/>Et intersit episcopus et aldremannus<ptr type="liebermannNote" n="17" target="#IICn_18-1.lnote.oe.17"/>, et doceant ibi Dei rectum et seculi.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="18.1" corresp="#wit-inst-cn"><pb n="321" ed="#liebermann"/>Et in illo comitatu sint episcopus<ptr type="liebermannNote" n="17" target="#IICn_18-1.lnote.oe.17-2"/> et comes, qui ostendant populo et iusticias Dei et rectitudines saeculi.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="18.1" corresp="#wit-cons-cn"><pb n="321" ed="#liebermann"/>In illo autem conuentu comitatus assint episcopus et preses, ibique doceant tam Dei quam seculi iusticiam.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="18.1" corresp="#wit-b"><pb n="182" ed="#robertson"/>⁊ þær beo on ðære scire bisceop ⁊ se ealdorman ⁊ þær ægðer tæcan ge Godes riht ge woruldriht.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="262" ed="#rabin-doml"/>And þær beo on þære scire bisceop and se ealdorman, and þær ægþer tæcan ge Godes riht ge woruldriht.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="321" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#IICn_18-1.lnote.de.1"/> hier sei anwesend der Diöcesanbischof<ptr type="liebermannNote" n="2" target="#IICn_18-1.lnote.de.2"/> und der Ealdorman, und sie sollen dort beides, sowohl Kirchenrecht wie weltliches Recht, anordnen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let the bishop of the shire and the ealdorman be present there, and let them both direct there both God's law and secular law.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_18-1.robnote.n.1"/><pb n="183" ed="#robertson"/>And the bishop of the diocese and the ealdorman shall attend, and they shall direct the administration of both ecclesiastical and secular law.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="263" ed="#rabin-doml"/>And the bishop of the diocese and the ealdorman shall both be in attendance, and there administer the ecclesiastical and secular laws.</ab>
        <note type="comparison" source="#liebermann" n="321"><ref target="clause:IIIEg_5-2">III Eg 5.2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 5, 2</note>
        <note type="comparison" source="#wormald-mel" n="358"><label>quoted verbatim (bold in Wormald's table)</label> <ref target="clause:IIIEg_5-2">III Eg 5.2</ref> <quote>Table 5.4, II Cn 18:1: III Eg 5:2</quote></note>
        <note type="editorial">Liebermann compares III Eg 5.2.; BR: added from Gesetze I p. 321, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de">com̄ut. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">com̄ut. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht</hi> princeps [<hi rend="italic">nach</hi> 58] <hi rend="italic">zu lesen</hi></seg><seg type="translation" xml:lang="en" source="#claude">perhaps read princeps [following 58]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de">-derm. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-derm. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18-1.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de">ðære <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðære Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de">scyre biscop <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">scyre biscop Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18-1.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de">teacan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">teacan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18-1.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de">weor. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">weor. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_18-1.lnote.oe.17-2" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de">-pi et comites <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-pi et comites Cb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_18-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">205</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Hieraus oder aus der Quelle Hn 7, 2. 31, 3</seg><seg type="translation" xml:lang="en" source="#claude">From this or from the source, Hn 7, 2. 31, 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_18-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">205</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘auf der Shire’; dann würde der Artikel, den <hi rend="italic">ealdorman</hi> hat, vor <hi rend="italic">bisceop</hi> stehen</seg><seg type="translation" xml:lang="en" source="#claude">Not ‘at the shire’; in that case the article that <hi rend="italic">ealdorman</hi> has would stand before <hi rend="italic">bisceop</hi></seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_18-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">354</biblScope></bibl><seg type="original" xml:lang="en">Cf. III Edg. 5, 2.</seg></note>
      </div>
