      <div type="clause" n="15.6">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 15.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 15.6"><pb n="641" ed="#liebermann"/>Si<ptr type="liebermannNote" n="28" target="#ECf_15-6.lnote.la.28"/> autem infra annum non posset<ptr type="liebermannNote" n="29" target="#ECf_15-6.lnote.la.29"/> inueniri, parentes<ptr type="liebermannNote" n="30" target="#ECf_15-6.lnote.la.30"/> murdrati<ptr type="liebermannNote" n="31" target="#ECf_15-6.lnote.la.31"/> haberent VI<ptr type="liebermannNote" n="32" target="#ECf_15-6.lnote.la.32"/> marcas.</ab>
        <note type="comparison" source="#liebermann" n="641"><label>printed alongside</label> <ref target="clause:ECfRetr_15-6">ECf retr 15.6</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 641 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “marcas” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-6.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">Sin <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Sin Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-6.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-sit <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sit Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-6.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">illius <hi rend="italic">fügt zu Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad adds illius</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-6.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-driti <hi rend="italic">Hk Hr;</hi> -dreti <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">-driti Hk Hr; -dreti S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-6.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Do</seg></note>
