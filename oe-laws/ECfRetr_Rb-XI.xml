    <body>
      <div type="clause" n="Rb XI">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> Rb XI</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr Rb XI"><pb n="670" ed="#liebermann"/>De denario<ptr type="liebermannNote" n="18" target="#ECfRetr_Rb-XI.lnote.la.18"/> Sancti Petri <hi rend="bold">quod Anglice</hi><ptr type="liebermannNote" n="19" target="#ECfRetr_Rb-XI.lnote.la.19"/> <hi rend="bold">dicitur</hi><ptr type="liebermannNote" n="b" target="#ECfRetr_Rb-XI.lnote.la.fn.b"/> <hi rend="bold">Romescot</hi><ptr type="liebermannNote" n="20" target="#ECfRetr_Rb-XI.lnote.la.20"/><hi rend="bold">.</hi></ab>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 670 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">This is one of the chapter headings (rubrics) that a later writer, whom Liebermann calls “Rubricator II” and dates 1163–1189, made for the Retractator’s text; so the date given for ECf retr (c. 1140–59) does not apply to it. Liebermann prints them on pp. 670–672 as an appendix (Anhang) to ECf retr; they are numbered here “Rb” with his Roman numerals. He prints in small type what is taken from the text of ECf retr, so the words in bold are the Rubricator’s own.</note>
        <note type="editorial">Liebermann gives in the margin, in square brackets, the chapter of ECf retr that this heading belongs to: 10.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Rb-XI.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">670</biblScope></bibl><seg type="original" xml:lang="de">de.—dicitur <hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">de.—dicitur lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Rb-XI.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">670</biblScope></bibl><seg type="original" xml:lang="de">Anglie <hi rend="italic">La;</hi> d. A. <hi rend="italic">Ph; fehlt Gr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Anglie La; d. A. Ph; lacking in Gr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Rb-XI.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">670</biblScope></bibl><seg type="original" xml:lang="de">Roms. <hi rend="italic">Gr La</hi></seg><seg type="translation" xml:lang="en" source="#claude">Roms. Gr La</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Rb-XI.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">670</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o. S.</hi> 634<hi rend="superscript">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">see above p. 634, note a</seg></note>
      </div>
