      <div type="clause" n="El. 20">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 20</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 20" corresp="#wit-e"><pb n="32" ed="#liebermann"/>Gif hwa<ptr type="liebermannNote" n="28" target="#Af_El-to-20.lnote.oe.28"/> áslea<ptr type="liebermannNote" n="29" target="#Af_El-to-20.lnote.oe.29"/> his ðeowe oððe his ðeowenne þæt eage út ⁊ he þon<hi rend="italic">ne</hi> hie<ptr type="liebermannNote" n="30" target="#Af_El-to-20.lnote.oe.30"/> gedo ánigge<ptr type="liebermannNote" n="31" target="#Af_El-to-20.lnote.oe.31"/>, gefreoge hie<ptr type="liebermannNote" n="32" target="#Af_El-to-20.lnote.oe.32"/> for þon.<ptr type="liebermannNote" n="33" target="#Af_El-to-20.lnote.oe.33"/> Gif he þon<hi rend="italic">ne<ptr type="liebermannNote" n="34" target="#Af_El-to-20.lnote.oe.34"/></hi> ðone toð ófaslea, do<ptr type="liebermannNote" n="35" target="#Af_El-to-20.lnote.oe.35"/> þæt ilce.<ptr type="liebermannNote" n="36" target="#Af_El-to-20.lnote.oe.36"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 20" corresp="#wit-g-prol-only"><pb n="32" ed="#liebermann"/>Gif hwa aslea his ðeowe oððe his ðeowenne þ<hi rend="italic">æt</hi> eage út ⁊ he ðonne hie gedo áneage, gefreoge hí for ðan. Gyf he ðonne ðone toð ofáslea, dó þ<hi rend="italic">æt</hi> sylfe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 20" corresp="#wit-h"><pb n="33" ed="#liebermann"/>Gif hwa ofslea his þeowan oððe his þeowene þ<hi rend="italic">æt</hi> eage utt ⁊ he þonne hy gedó ánegede, gefreoge<ptr type="liebermannNote" n="1" target="#Af_El-to-20.lnote.oe.1"/> heo for þon. Gif he þonne toð ofaslea, dó þ<hi rend="italic">æt</hi> ilce.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 20" corresp="#wit-q"><pb n="33" ed="#liebermann"/>Si percusserit quispiam oculum serui sui<ptr type="liebermannNote" n="8" target="#Af_El-to-20.lnote.oe.8"/> aut ancillæ et luscos eos fecerit, dimittet<ptr type="liebermannNote" n="9" target="#Af_El-to-20.lnote.oe.9"/> liberos pro oculo quem eruit. Dentem quoque si excusserit seruo uel ancillæ suæ, similiter dimittet<ptr type="liebermannNote" n="10" target="#Af_El-to-20.lnote.oe.10"/> eos liberos.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 20" corresp="#wit-e"><pb n="242" ed="#jurasinski-and-oliver"/>Gif hwa áslea his ðeowe oððe his ðeowenne þæt eage ut ⁊ he þonne hie gedo ánigge, gefreoge hie for þon. Gif he þonne ðone toð ófaslea, do þæt ilce.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="33" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_El-to-20.lnote.de.1"/> jemand seinem Sklaven oder seiner Sklavin das Auge ausschlägt<ptr type="liebermannNote" n="2" target="#Af_El-to-20.lnote.de.2"/> und er sie also einäugig macht, so lasse er sie frei dafür. Wenn er aber den Zahn ausschlägt, thu er das gleiche.<ptr type="liebermannNote" n="3" target="#Af_El-to-20.lnote.de.3"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone strikes out the eye of his slave or his slave woman and so makes them one-eyed, let him set them free for it. But if he knocks out the tooth, let him do the same.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="243" ed="#jurasinski-and-oliver"/>If someone should strike out the eye of his male or female slave and thereby make them one-eyed, let him free them for that. If, however, he should strike out a tooth, let him do the same.</ab>
        <note type="passageSource">Exodus 21,26–27</note>
        <note type="comparison" source="#liebermann" n="33">Exodus 21.26; Exodus 21.27</note>
        <note type="comparisonPrinted" source="#liebermann">[21, 26] | [21, 27]</note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-20.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">32</biblScope></bibl><seg type="original" xml:lang="de">swa <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">swa So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-20.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">32</biblScope></bibl><seg type="original" xml:lang="de">slea <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">slea So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-20.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">32</biblScope></bibl><seg type="original" xml:lang="de">hi <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hi Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-20.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">32</biblScope></bibl><seg type="original" xml:lang="de">anigge, al. anege <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">anigge, al. anege Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-20.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">32</biblScope></bibl><seg type="original" xml:lang="de">hi <hi rend="italic">Ld;</hi> he hine <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">hi Ld; he hine So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-20.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">32</biblScope></bibl><seg type="original" xml:lang="de">ðone <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðone So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-20.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">32</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-20.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">32</biblScope></bibl><seg type="original" xml:lang="de">he <hi rend="italic">fügt zu So</hi></seg><seg type="translation" xml:lang="en" source="#claude">he added by So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-20.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">32</biblScope></bibl><seg type="original" xml:lang="de">ylce <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ylce Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-20.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">33</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">erstes</hi> ge <hi rend="italic">übergeschrieben</hi></seg><seg type="translation" xml:lang="en" source="#claude">first ge written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-20.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">33</biblScope></bibl><seg type="original" xml:lang="de">quispiam <hi rend="italic">fügt T zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">quispiam added by T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-20.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">33</biblScope></bibl><seg type="original" xml:lang="de">eos <hi rend="italic">fügt Vulg. zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">eos added by Vulg.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-20.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">33</biblScope></bibl><seg type="original" xml:lang="de">e. d. <hi rend="italic">Dm T Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. d. Dm T Hk</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-20.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">45</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Freilassung 10d. f. Ælfred mochte solch Gesetz wünschen</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Freilassung 10d. f. Ælfred may well have desired such a law</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-20.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">45</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">H ändert in <hi rend="italic">ófslea</hi> I; <hi rend="italic">s. d. Wb</hi></seg><seg type="translation" xml:lang="en" source="#claude">H alters to <hi rend="italic">ófslea</hi> I; <hi rend="italic">see</hi> that word in <hi rend="italic">Wb</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-20.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">45</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Laut G Ld scheint <hi rend="italic">ilce</hi> (<hi rend="italic">s. d. Wb</hi>) dem 11. Jh. zu archaisch</seg><seg type="translation" xml:lang="en" source="#claude">To judge from G Ld, <hi rend="italic">ilce</hi> (<hi rend="italic">see</hi> that word in <hi rend="italic">Wb</hi>) seems to have been too archaic for the 11th cent.</seg></note>
      </div>
