    <body>
      <div type="clause" n="62.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 62.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="62.1" corresp="#wit-g-a"><pb n="350" ed="#liebermann"/>⁊ gif hine mon<ptr type="liebermannNote" n="19" target="#IICn_62-1.lnote.oe.19"/> þær afylle, licge ǽgilde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="62.1" corresp="#wit-b"><pb n="350" ed="#liebermann"/>⁊ gyf hine man ðær afylle, licge ægylde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="62.1" corresp="#wit-a"><pb n="350" ed="#liebermann"/>⁊ gif hine man þær alecge, licge agylde.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="62.1" corresp="#wit-q"><pb n="351" ed="#liebermann"/>Quodsi quis eum inter agendum perimat, ægylde<ptr type="liebermannNote" n="21" target="#IICn_62-1.lnote.oe.21"/> (<ptr type="liebermannNote" n="22" target="#IICn_62-1.lnote.oe.22"/>insolutus<ptr type="liebermannNote" n="23" target="#IICn_62-1.lnote.oe.23"/>) iaceat.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="62.1" corresp="#wit-inst-cn"><pb n="351" ed="#liebermann"/>Et si in illa inuasione occisus fuerit, iaceat impersolutus, quod Angli dicunt ægelde.<ptr type="liebermannNote" n="20" target="#IICn_62-1.lnote.oe.20"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="62.1" corresp="#wit-cons-cn"><pb n="351" ed="#liebermann"/>[62, 1] Si autem ibi peremptus fuerit, iaceat insolubilis.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="62.1" corresp="#wit-b"><pb n="204" ed="#robertson"/>⁊ gyf hine man ðær afylle<ptr type="editorNote" n="10" target="#IICn_62-1.robnote.fn.10"/>, licge ægylde.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="286" ed="#rabin-doml"/>And gif hine mon þær afylle, licge ægilde.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="351" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#IICn_62-1.lnote.de.1"/> wenn er dabei erschlagen wird, liege er todt, ohne [seiner Sippe] vergolten [zu werden].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if he is slain in doing so, let him lie dead without being paid for [to his kin].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_62-1.robnote.n.1"/><pb n="205" ed="#robertson"/>And if he is slain in such a case, no compensation shall be paid for his death.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="471" ed="#whitelock"/>And if he is slain there, no wergild is to be paid for him.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="287" ed="#rabin-doml"/>And if he is killed in the course of his crime, he shall die without compensation.</ab>
        <note type="comparison" source="#liebermann" n="351"><ref target="clause:IVAtr_4">IV Atr 4</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. IV Atr. 4</note>
        <note type="editorial">Liebermann compares IV Atr 4.; BR: added from Gesetze I p. 351, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">afylle: alecge A</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_62-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_62-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de">eg. <hi rend="italic">R;</hi> ang. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">eg. R; ang. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_62-1.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de">id est <hi rend="italic">fügt zu T</hi></seg><seg type="translation" xml:lang="en" source="#claude">id est added by T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_62-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. Dm; fehlt KRHk;</hi> id est <hi rend="spaced">sine emendatione</hi> <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above Dm; lacking in KRHk; id est <hi rend="italic">sine emendatione</hi> R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_62-1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">350</biblScope></bibl><seg type="original" xml:lang="de">man ð. alecge, l. agylde <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">man ð. alecge, l. agylde Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_62-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de">eg. <hi rend="italic">S;</hi> eðg. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">eg. S; eðg. Cb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_62-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">210</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Offenbar Kopie des uns verlorenen Originals von IV Atr 4</seg><seg type="translation" xml:lang="en" source="#claude">Evidently a copy of the original of IV Atr 4, which is lost to us</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_62-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">358</biblScope></bibl><seg type="original" xml:lang="en">Cf. IV Atr. 4.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_62-1.robnote.fn.10" n="10" source="#robertson"><bibl><biblScope unit="page">204</biblScope></bibl><label>afylle</label><seg type="original" xml:lang="en"><hi rend="italic">alecge</hi> A, Ld.</seg></note>
      </div>
