        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2b.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">quinto b. ul. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">quinto b. ul. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2b.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">regnum quoque <hi rend="italic">S</hi>, Diuisio regni inter Chnutum et Edmundum <hi rend="italic">überschr. S</hi></seg><seg type="translation" xml:lang="en" source="#claude">regnum quoque S, with the heading Diuisio regni inter Chnutum et Edmundum S</seg></note>
