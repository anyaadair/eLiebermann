      <div type="clause" n="17">
        <head><ref type="lawCode" target="law:QuadrArg">Quadr Arg</ref> 17</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Arg 17" corresp="#wit-lat"><pb n="534" ed="#liebermann"/>qui libertatem æcclesiæ<ptr type="liebermannNote" n="b" target="#QuadrArg_17.lnote.oe.b"/>, securitatem<ptr type="liebermannNote" n="c" target="#QuadrArg_17.lnote.oe.c"/> patrie, pretium uirtutibus, gratiam laboribus, gaudia merentibus, suffragia poscentibus pia miseratione respexit;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 534 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_17.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">534</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. CHn cor.</hi> 1: ecclesiam liberam facio</seg><seg type="translation" xml:lang="en" source="#claude">cf. CHn cor. 1: ecclesiam liberam facio</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_17.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">534</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Robert von der Normandie war erst</hi> 1106 <hi rend="italic">besiegt; s. u. Anm. s</hi></seg><seg type="translation" xml:lang="en" source="#claude">Robert of Normandy was not defeated until 1106; see below note s</seg></note>
      </div>
