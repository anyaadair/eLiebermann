      <div type="clause" n="5.3">
        <head><ref type="lawCode" target="law:IudDeiII">Iud Dei II</ref> 5.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei II 5.3" corresp="#wit-lat"><pb n="407" ed="#liebermann"/>Et si mundus<ptr type="liebermannNote" n="66" target="#IudDeiII_5-3.lnote.oe.66"/> est, Deo<ptr type="liebermannNote" n="73" target="#IudDeiII_5-3.lnote.oe.73"/> gratuletur; si autem insanies<ptr type="liebermannNote" n="74" target="#IudDeiII_5-3.lnote.oe.74"/> crudescens in uestigio ferri inueniatur, culpabilis et inmundus<ptr type="liebermannNote" n="66" target="#IudDeiII_5-3.lnote.oe.66"/> reputetur<ptr type="liebermannNote" n="75" target="#IudDeiII_5-3.lnote.oe.75"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 407 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_5-3.lnote.oe.66" n="66" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-a <hi rend="italic">vom Rubricator übergeschr. Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-a written above by the rubricator in Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_5-3.lnote.oe.73" n="73" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">Deus laudetur <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Deus laudetur Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_5-3.lnote.oe.74" n="74" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so alle Hss.;</hi> sanies <hi rend="italic">nur in</hi> XVI 39, 2 <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus all MSS; sanies only in XVI 39, 2 Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_5-3.lnote.oe.75" n="75" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">Romani, <hi rend="italic">d. i. unten</hi> Iud. Dei XII, <hi rend="italic">schaltet hier ganz ein Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Romani, i.e. below Iud. Dei XII, is inserted here in full by Tr</seg></note>
      </div>
