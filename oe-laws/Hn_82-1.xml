      <div type="clause" n="82.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 82.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 82.1" corresp="#wit-lat"><pb n="598" ed="#liebermann"/>In omni causa, si quis inimicum residentem habeat, non ante impugnet<ptr type="liebermannNote" n="o" target="#Hn_82-1.lnote.oe.o"/> eum, quam ipsum<ptr type="liebermannNote" n="23" target="#Hn_82-1.lnote.oe.23"/> ter et per bonos testes de<ptr type="liebermannNote" n="p" target="#Hn_82-1.lnote.oe.p"/> recto requirat<ptr type="liebermannNote" n="24" target="#Hn_82-1.lnote.oe.24"/>, et ei cuius homo est — et<ptr type="liebermannNote" n="10" target="#Hn_82-1.lnote.oe.10"/>, si opus est, iusticie que preerit — ostendat, siue de Anglico siue de Franco causa consistat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 598 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-1.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">unerlaubte Heimsuchung straft</hi> IV Atr. 4</seg><seg type="translation" xml:lang="en" source="#claude">unlawful attack on a house is punished by IV Atr. 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-1.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 83, 1<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 83, 1<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">ipse <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">ipse Sc Hg</seg></note>
