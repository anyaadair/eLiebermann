  <text>
    <body>
      <div type="clause" n="44">
        <head><ref type="lawCode" target="law:VIIIAtr">VIII Atr</ref> 44</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-d"><pb n="268" ed="#liebermann"/>And uton rihtne Cristendo<hi rend="italic">m</hi> geornlice wurðian ⁊ ælcne hæðendo<hi rend="italic">m</hi> mid ealle oferhogian.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="44" corresp="#wit-cons"><pb n="268" ed="#liebermann"/>[44] Rectam Christianitatem attente honorificemus et omnem paganissimum<ptr type="liebermannNote" n="1" target="#VIIIAtr_44.lnote.oe.1"/> omnino contempnamus</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="44" corresp="#wit-d"><pb n="128" ed="#robertson"/>And uton rihtne Cristendom geornlice wurðian ⁊ ælcne hæðendom mid ealle oferhogian.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-d"><pb n="204" ed="#rabin-doml"/>And uton rihtne Cristendom geornlice wurðian and ælcne hæðendom mid ealle oferhogian.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="268" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#VIIIAtr_44.lnote.de.1"/> lasst uns rechtes Christenthum eifrig ehren und jedes Heidenthum gänzlich verschmähen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let us eagerly honour true Christianity and utterly despise all heathenism.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d"><ptr type="editorNote" n="1" target="#VIIIAtr_44.robnote.n.1"/><pb n="129" ed="#robertson"/>And let us zealously honour the true Christian religion and utterly despise all heathen practices.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-d"><pb n="457" ed="#whitelock"/>And let us zealously honour the true Christian religion and utterly despise all heathen practices.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-d"><pb n="205" ed="#rabin-doml"/>And let us fervently exalt the true Christian faith, and wholly reject all heathen practices.</ab>
        <note type="comparison" source="#liebermann" n="268">VI Atr</note>
        <note type="comparisonPrinted" source="#liebermann">ebd.</note>
        <note type="liebermannNote" subtype="textual" xml:id="VIIIAtr_44.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">268</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so meist</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus mostly</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VIIIAtr_44.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">185</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Christentum 2a; Heidentum 8</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Christentum 2a; Heidentum 8</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VIIIAtr_44.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">342</biblScope></bibl><seg type="original" xml:lang="en">Cf. V, 1; 22; 34; VI, 1; 27; 42; I Cn. 19; 21; <hi rend="italic">N.P.L.</hi> 47.</seg></note>
      </div>
