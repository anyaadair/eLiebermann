      <div type="clause" n="38">
        <head><ref type="lawCode" target="law:QuadrDed">Quadr Ded</ref> 38</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Ded 38" corresp="#wit-lat"><pb n="532" ed="#liebermann"/>Cuius te dispensationis hortatorem secutus, iudicem quoque constituo, ueniam postulans, ne prius hæc patiaris grandia professorum<ptr type="liebermannNote" n="e" target="#QuadrDed_38.lnote.oe.e"/> debachationibus occupari qua[m<ptr type="liebermannNote" n="4" target="#QuadrDed_38.lnote.oe.4"/>] tuæ nobilitatis et nostræ dilectionis intuitu superflua rese[c]es<ptr type="liebermannNote" n="5" target="#QuadrDed_38.lnote.oe.5"/>, errata castiges, impleta confirmes, ut pax sit diligentibus legem tuam, et non sit offendiculum!</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 532 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_38.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">532</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. o.</hi> 24</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf. above</hi> 24</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_38.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">532</biblScope></bibl><seg type="original" xml:lang="de">qua <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">qua <hi rend="italic">Dm</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_38.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">532</biblScope></bibl><seg type="original" xml:lang="de">resenes <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">resenes <hi rend="italic">Dm</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_38.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. Einl. 8</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> Introduction 8</seg></note>
