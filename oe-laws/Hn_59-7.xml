      <div type="clause" n="59.7">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.7" corresp="#wit-lat"><pb n="578" ed="#liebermann"/>Qui<ptr type="liebermannNote" n="23" target="#Hn_59-7.lnote.oe.23"/> sine legali ratione contramandacionem renuit — licet ad locum placiti ueniat, licet illic adusque expectet, dum hora placitandi pretereat, et huius(modi)<ptr type="liebermannNote" n="24" target="#Hn_59-7.lnote.oe.24"/> expectationis testes circumquaque conuocet, et ita aduersarii sui placitum esse<ptr type="liebermannNote" n="25" target="#Hn_59-7.lnote.oe.25"/> fractum contendant<ptr type="liebermannNote" n="nn" target="#Hn_59-7.lnote.oe.nn"/> —: non<ptr type="liebermannNote" n="o" target="#Hn_59-7.lnote.oe.o"/> procedit, quin diem qui positus est<ptr type="liebermannNote" n="27" target="#Hn_59-7.lnote.oe.27"/> expectari oporteat<ptr type="liebermannNote" n="28" target="#Hn_59-7.lnote.oe.28"/>; et si eum<ptr type="liebermannNote" n="p" target="#Hn_59-7.lnote.oe.p"/> secundum<ptr type="liebermannNote" n="29" target="#Hn_59-7.lnote.oe.29"/> legem contramandatum esse constet, de capite<ptr type="liebermannNote" n="q" target="#Hn_59-7.lnote.oe.q"/><ptr type="liebermannNote" n="30" target="#Hn_59-7.lnote.oe.30"/> placiti disceptetur<ptr type="liebermannNote" n="31" target="#Hn_59-7.lnote.oe.31"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 578 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-7.lnote.oe.nn" n="nn" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Abbestellter und Zeugen</hi></seg><seg type="translation" xml:lang="en" source="#claude">the countermanded party and witnesses</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-7.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">das hilft nicht, dass nicht vielmehr der neue Termin</seg><seg type="translation" xml:lang="en" source="#claude">this is of no avail to prevent the new day, rather,</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-7.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">der Abbestellte</seg><seg type="translation" xml:lang="en" source="#claude">the countermanded party</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-7.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> ad principium pl. 61, 13<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. ad principium pl. 61, 13<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-7.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">Quod <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">Quod K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-7.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">huius <hi rend="italic">Sc Hg;</hi> hi' <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">huius Sc Hg; hi' Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-7.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">f. e. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. e. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-7.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-7.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">opp. <hi rend="italic">Hss. meist</hi></seg><seg type="translation" xml:lang="en" source="#claude">opp. MSS mostly</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-7.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">eum omnes contramandant, secundum legem constant, de ca. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">eum omnes contramandant, secundum legem constant, de ca. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-7.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">d <hi rend="italic">unterpunctirt fügt ein Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">d, underdotted, inserted by Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-7.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">-ptur <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ptur Lond</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">He who refuses a countermand without lawful reason — although he comes to the place of the plea, although he waits there until the hour of pleading passes, and calls together from all around witnesses of this waiting, and so they maintain that his adversary's plea is broken —: it does not avail, but the day which has been set must be awaited; and if it is established that he was countermanded according to law, let the dispute be on the head of the plea.</ab>
      </div>
