        <head><ref type="lawCode" target="law:Hn">Hn</ref> 76.6a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 76.6a" corresp="#wit-lat"><pb n="593" ed="#liebermann"/>Age enim de aliquo secundum legem, qui natus sit ad IIII libras<ptr type="liebermannNote" n="p" target="#Hn_76-6a.lnote.oe.p"/>, et quando uel quibus reddi debeat uel quomodo distribui: halsfang<ptr type="liebermannNote" n="47" target="#Hn_76-6a.lnote.oe.47"/> eius sunt V mance<ptr type="liebermannNote" n="48" target="#Hn_76-6a.lnote.oe.48"/>, que faciunt<ptr type="liebermannNote" n="q" target="#Hn_76-6a.lnote.oe.q"/> XII<ptr type="liebermannNote" n="49" target="#Hn_76-6a.lnote.oe.49"/> sol. et VI<ptr type="liebermannNote" n="50" target="#Hn_76-6a.lnote.oe.50"/> den.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 593 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-6a.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 76, 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 76, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-6a.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier</hi> 1 sol. = 12 den., <hi rend="italic">gegen</hi> 34, 3 <hi rend="italic">Zwischensatz und</hi> 69, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">here</hi> 1 sol. = 12 den., <hi rend="italic">as against the parenthesis in</hi> 34, 3 <hi rend="italic">and</hi> 69, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-6a.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de">-lffa. <hi rend="italic">K;</hi> -sha. <hi rend="italic">Co Or;</hi> -ge, <hi rend="italic">aber später</hi> e <hi rend="italic">unterpunctirt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lffa. <hi rend="italic">K;</hi> -sha. <hi rend="italic">Co Or;</hi> -ge, <hi rend="italic">but</hi> e <hi rend="italic">later dotted for deletion Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-6a.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de">marc. <hi rend="italic">Sc Hg K</hi></seg><seg type="translation" xml:lang="en" source="#claude">marc. <hi rend="italic">Sc Hg K</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-6a.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de">XXII <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">XXII <hi rend="italic">Sc Hg</hi></seg></note>
