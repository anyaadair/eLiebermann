    <body>
      <div type="clause" n="1">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1" corresp="#wit-e"><pb n="88" ed="#liebermann"/>XLV. Ærest we bebeodað<ptr type="liebermannNote" n="23" target="#Ine_1.lnote.oe.23"/>, þætte<ptr type="liebermannNote" n="18" target="#Ine_1.lnote.oe.18-2"/> Godes ðeowas hiora ryhtregol<ptr type="liebermannNote" n="24" target="#Ine_1.lnote.oe.24"/> on ryht healdan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1" corresp="#wit-bu"><pb n="88" ed="#liebermann"/>XLV. Ærest we . . . eodaþ, þ<hi rend="italic">æt</hi>te Godes ðeowas hiora ryhtregol on ryht healden.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1" corresp="#wit-h"><pb n="88" ed="#liebermann"/>XLV. Ærest we bebeodað, þæt Godes ðeowas heora<ptr type="liebermannNote" n="15" target="#Ine_1.lnote.oe.15"/> ryhtregol on riht healden.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1" corresp="#wit-b-no-prol"><pb n="89" ed="#liebermann"/>Ærest we bebeodað, þ<hi rend="italic">æt</hi> Godas<ptr type="liebermannNote" n="4" target="#Ine_1.lnote.oe.4"/> þeowas héora rihtregol gyman ⁊ on riht healdon.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1" corresp="#wit-q"><pb n="89" ed="#liebermann"/>Inprimis<ptr type="liebermannNote" n="18" target="#Ine_1.lnote.oe.18"/> precipimus<ptr type="liebermannNote" n="19" target="#Ine_1.lnote.oe.19"/>, ut ministri Domini rectam discipline<ptr type="liebermannNote" n="20" target="#Ine_1.lnote.oe.20"/> sancte regulam iuste custodiant.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="36" ed="#attenborough"/>Ærest we bebeodað, þætte Godes ðeowas hiora ryhtregol [gyman ⁊<ptr type="editorNote" n="6" target="#Ine_1.attnote.fn.6"/>] on ryht healdan.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="1" corresp="#wit-e"><pb n="370" ed="#jurasinski-and-oliver"/>{XLIV} Ærest we bebeodað þætte Godes ðeowas hiora ryhtregol on ryht healdan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="89" ed="#liebermann"/>Zuerst<ptr type="liebermannNote" n="1" target="#Ine_1.lnote.de.1"/> gebieten wir, dass Geistliche<ptr type="liebermannNote" n="2" target="#Ine_1.lnote.de.2"/> ihre Kanones<ptr type="liebermannNote" n="3" target="#Ine_1.lnote.de.3"/><ptr type="liebermannNote" n="4" target="#Ine_1.lnote.de.4"/> richtig halten.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">First we command that clergy keep their canons properly.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="37" ed="#attenborough"/>In the first place, we command that the servants of God heed, and duly observe, their proper 'rule.'</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="399" ed="#whitelock"/>First we enjoin that the servants of God rightly observe their proper rule,</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="371" ed="#jurasinski-and-oliver"/>First we command that God’s servants hold their proper rule according to law.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VAtr_4-1">V Atr 4.1</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">89</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">89</biblScope></bibl><seg type="original" xml:lang="de">uolumus et <hi rend="italic">fügt zu T</hi></seg><seg type="translation" xml:lang="en" source="#claude">uolumus et added by T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">89</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt hier Lond, wo</hi> ut mi. — regulam prec.</seg><seg type="translation" xml:lang="en" source="#claude">lacking here in Lond, where ut mi. — regulam prec.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">89</biblScope></bibl><seg type="original" xml:lang="de">-nam <hi rend="italic">R;</hi> s. d. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nam R; s. d. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">88</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">88</biblScope></bibl><seg type="original" xml:lang="de">-dæþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dæþ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_1.lnote.oe.18-2" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">88</biblScope></bibl><seg type="original" xml:lang="de">þ' <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þ' Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_1.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">88</biblScope></bibl><seg type="original" xml:lang="de">-le <hi rend="spaced">gyman</hi> ⁊ on <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-le <hi rend="italic">gyman</hi> ⁊ on Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">68</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Vorausstellung eines kirchlichen Satzes <hi rend="italic">s. Gl</hi> Kirchenstaatsrecht 22. b; Geistliche 27. Es fehlt hier Strafdrohung, weil Geistliches Gericht (<hi rend="italic">s. d. Gl</hi> 6ff.) eintritt. — ‘Wir’ = König und Witan; <hi rend="italic">s. o.</hi> Einl. 16</seg><seg type="translation" xml:lang="en" source="#claude">On the placing of an ecclesiastical provision first see <hi rend="italic">Gl</hi> Kirchenstaatsrecht 22. b; Geistliche 27. There is no threat of penalty here, because ecclesiastical jurisdiction (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 6ff.) applies. — ‘We’ = king and witan; see above Introduction 16</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">68</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Godas</hi> B, späte Form. <hi rend="italic">Vgl.</hi> Pro¹³</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Godas</hi> B, a late form. <hi rend="italic">Cf.</hi> Pro¹³</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">68</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘Mönchsregel’ zu eng; Glosse: <hi rend="italic">canones</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘Monastic rule’ is too narrow; gloss: <hi rend="italic">canones</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_1.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">68</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘beobachten und’ homiletischer Zusatz B</seg><seg type="translation" xml:lang="en" source="#claude">‘observe and’ is a homiletic addition in B</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_1.attnote.fn.6" n="6" source="#attenborough"><bibl><biblScope unit="page">36</biblScope></bibl><label>⁊</label><seg type="original" xml:lang="en">B.</seg></note>
      </div>
