    <body>
      <div type="clause" n="87.2c">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 87.2c</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 87.2c" corresp="#wit-lat"><pb n="601" ed="#liebermann"/>Obseruet autem ille<ptr type="liebermannNote" n="k" target="#Hn_87-2c.lnote.oe.k"/> cuius arma erant, ut ea non recipiat<ptr type="liebermannNote" n="35" target="#Hn_87-2c.lnote.oe.35"/> antequam in omni calumpnia munda sint.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 601 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-2c.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">der Benutzer des leblosen</hi> auctor interfectionis, <hi rend="italic">dessen Wiedergebrauch</hi> Lex Ribuar. 70, 1 <hi rend="italic">verbietet, würde haften für den durch die befleckte Waffe geschehenen Unfall; Brunner</hi> Absichtslose Missethat 26; DRG. II 558; <hi rend="italic">Pollock and Maitland</hi> HEL. II 471. <hi rend="italic">Vgl.</hi> 88, 1<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">the user of the lifeless</hi> auctor interfectionis, <hi rend="italic">whose re-use</hi> Lex Ribuar. 70, 1 <hi rend="italic">forbids, would be liable for the accident caused by the defiled weapon; Brunner</hi> Absichtslose Missethat 26; DRG. II 558; <hi rend="italic">Pollock and Maitland</hi> HEL. II 471. <hi rend="italic">Cf.</hi> 88, 1<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-2c.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">-ant <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ant Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-2c.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Haftung 4g</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Haftung 4g</seg></note>
