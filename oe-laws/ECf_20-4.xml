      <div type="clause" n="20.4">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 20.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 20.4"><pb n="646" ed="#liebermann"/>Quod si facere<ptr type="liebermannNote" n="17" target="#ECf_20-4.lnote.la.17"/> non poterit<ptr type="liebermannNote" n="22" target="#ECf_20-4.lnote.la.22"/>, restaurarent<ptr type="liebermannNote" n="c" target="#ECf_20-4.lnote.la.fn.c"/><ptr type="liebermannNote" n="23" target="#ECf_20-4.lnote.la.23"/> dampnum<ptr type="liebermannNote" n="a" target="#ECf_20-4.lnote.oe.erkl-a"/>, quod ipse<ptr type="liebermannNote" n="d" target="#ECf_20-4.lnote.la.fn.d"/> fecerat<ptr type="liebermannNote" n="24" target="#ECf_20-4.lnote.la.24"/>, de proprio forisfactoris<ptr type="liebermannNote" n="25" target="#ECf_20-4.lnote.la.25"/>, quantum durauerit, et de suo<ptr type="liebermannNote" n="e" target="#ECf_20-4.lnote.la.fn.e"/>; et erga iusticiam<ptr type="liebermannNote" n="f" target="#ECf_20-4.lnote.la.fn.f"/> emendent<ptr type="liebermannNote" n="26" target="#ECf_20-4.lnote.la.26"/>, secundum<ptr type="liebermannNote" n="27" target="#ECf_20-4.lnote.la.27"/> quod legaliter iudicatum fuerit eis.</ab>
        <note type="comparison" source="#liebermann" n="646"><label>printed alongside</label> <ref target="clause:ECfRetr_20-4">ECf retr 20.4</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 646 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-4.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">den Plural bestätigt</hi> Wl art. 8 <hi rend="italic">gegen den Retractator, dem Kemble</hi> Saxons 250 <hi rend="italic">folgt</hi></seg><seg type="translation" xml:lang="en" source="#claude">Wl art. 8 confirms the plural, against the Retractator, whom Kemble, Saxons 250, follows</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-4.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">Missethäter, <hi rend="italic">wie</hi> 20, 2</seg><seg type="translation" xml:lang="en" source="#claude">the wrongdoer, as at 20, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-4.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vermögen aller Freibürgen</hi></seg><seg type="translation" xml:lang="en" source="#claude">the property of all the members of the frankpledge</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-4.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">Richter</seg><seg type="translation" xml:lang="en" source="#claude">judge</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-4.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-4.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">-runt <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-runt Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-4.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">-urent <hi rend="italic">Hk Hr Ad Do;</hi> -aret <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">-urent Hk Hr Ad Do; -aret S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-4.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">-cit <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cit Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-4.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl;</hi> -facti <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl; -facti Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-4.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">-det <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-det Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-4.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">sec.—sacramentum <hi rend="italic">überspringt Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Do skips sec.—sacramentum</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But if he cannot do this, they should make good the damage which he had done from the offender's own property, as far as it lasts, and from their own; and let them pay compensation to the justice, according to what has been lawfully adjudged to them.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-4.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">346</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Zehnerschaft 26a-f; Ersatz 1; Begünstigung 16</seg><seg type="translation" xml:lang="en" source="#claude">Cf. <hi rend="italic">Gl</hi> Zehnerschaft 26a-f; Ersatz 1; Begünstigung 16</seg></note>
      </div>
    </body>
  </text>
