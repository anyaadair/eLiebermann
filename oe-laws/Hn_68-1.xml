      <div type="clause" n="68.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 68.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 68.1" corresp="#wit-lat"><pb n="586" ed="#liebermann"/>Si<ptr type="liebermannNote" n="t" target="#Hn_68-1.lnote.oe.t"/> quis liber aut seruus occidatur, natalis sui precio legittime componatur — nisi satisfaccionis<ptr type="liebermannNote" n="29" target="#Hn_68-1.lnote.oe.29"/> iudicium dampnis corporalibus amplietur: continget<ptr type="liebermannNote" n="30" target="#Hn_68-1.lnote.oe.30"/> enim, qui aliquem occiderit uel plagiauerit, sue uite periculum uel menbrorum detrimentum<ptr type="liebermannNote" n="31" target="#Hn_68-1.lnote.oe.31"/> sustinebit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 586 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_68-1.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt</hi> 69, 1. 76, 1</seg><seg type="translation" xml:lang="en" source="#claude">repeated 69, 1. 76, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_68-1.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">scīficat. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">scīficat. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_68-1.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">-git e. ut qui <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">-git e. ut qui Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_68-1.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">-ta <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ta <hi rend="italic">Lond</hi></seg></note>
