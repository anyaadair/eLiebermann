        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 2" corresp="#wit-du" ana="#glossed"><pb n="409" ed="#liebermann"/>Exorcismus<ptr type="liebermannNote" n="26" target="#IudDeiIV_2.lnote.oe.26"/> aquæ ad furtum requirendum. <seg type="glossed"><seg type="base">Exorcizo</seg><gloss xml:lang="ang">Ic halsigo</gloss></seg> <seg type="glossed"><seg type="base">te,</seg><gloss xml:lang="ang">ðec,</gloss></seg> <seg type="glossed"><seg type="base">creatura</seg><gloss xml:lang="ang">giscæft</gloss></seg> <seg type="glossed"><seg type="base">aque,</seg><gloss xml:lang="ang">⁊<ptr type="liebermannNote" n="27" target="#IudDeiIV_2.lnote.oe.27"/> æc,</gloss></seg> <seg type="glossed"><seg type="base">in</seg><gloss xml:lang="ang">in</gloss></seg> <seg type="glossed"><seg type="base">nomine</seg><gloss xml:lang="ang">nome</gloss></seg> <seg type="glossed"><seg type="base">Dei,</seg><gloss xml:lang="ang">God,</gloss></seg> <seg type="glossed"><seg type="base">patris</seg><gloss xml:lang="ang">fador<hi rend="italic">es</hi></gloss></seg> <seg type="glossed"><seg type="base">omnipotentis,</seg><gloss xml:lang="ang">allmæht<hi rend="italic">iges<ptr type="liebermannNote" n="28" target="#IudDeiIV_2.lnote.oe.28"/></hi>,</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> in <seg type="glossed"><seg type="base">nomine</seg><gloss xml:lang="ang">nome</gloss></seg> <seg type="glossed"><seg type="base">Ie<hi rend="italic">s</hi>u<ptr type="liebermannNote" n="30" target="#IudDeiIV_2.lnote.oe.30"/></seg><gloss xml:lang="ang">hæl<hi rend="italic">endes<ptr type="liebermannNote" n="29" target="#IudDeiIV_2.lnote.oe.29"/></hi></gloss></seg> <seg type="glossed"><seg type="base">Chr<hi rend="italic">is</hi>t[i],</seg><gloss xml:lang="ang">Crist<hi rend="italic">es</hi>,</gloss></seg> <seg type="glossed"><seg type="base">filii</seg><gloss xml:lang="ang">bearn<hi rend="italic">es</hi></gloss></seg> <seg type="glossed"><seg type="base">eius,</seg><gloss xml:lang="ang">his̄,</gloss></seg> <seg type="glossed"><seg type="base">domini</seg><gloss xml:lang="ang">drih<hi rend="italic">tnes</hi></gloss></seg> <seg type="glossed"><seg type="base">nostri,</seg><gloss xml:lang="ang">us<hi rend="italic">es</hi>,</gloss></seg> <seg type="glossed"><seg type="base">ut</seg><gloss xml:lang="ang">þ<hi rend="italic">æt</hi>te</gloss></seg> <seg type="glossed"><seg type="base">fias</seg><gloss xml:lang="ang">giworðe</gloss></seg> <seg type="glossed"><seg type="base">aqua</seg><gloss xml:lang="ang">vætre<ptr type="liebermannNote" n="31" target="#IudDeiIV_2.lnote.oe.31"/></gloss></seg> <seg type="glossed"><seg type="base">exorcizata</seg><gloss xml:lang="ang">gihalsad</gloss></seg> <seg type="glossed"><seg type="base">ad</seg><gloss xml:lang="ang">to</gloss></seg> <seg type="glossed"><seg type="base">effugandam</seg><gloss xml:lang="ang">fleanne</gloss></seg> <seg type="glossed"><seg type="base">omnem</seg><gloss xml:lang="ang">ælc</gloss></seg> <seg type="glossed"><seg type="base">potestatem</seg><gloss xml:lang="ang">maeht</gloss></seg> <seg type="glossed"><seg type="base">inimici</seg><gloss xml:lang="ang">fiondes</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">omne</seg><gloss xml:lang="ang">ælc</gloss></seg> <seg type="glossed"><seg type="base">fantasma</seg><gloss xml:lang="ang">scinelac</gloss></seg> <seg type="glossed"><seg type="base">diaboli,</seg><gloss xml:lang="ang">divoles,</gloss></seg></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 409 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">c.</hi> 2. 3 <hi rend="italic">gleich Zeu.</hi> 610<hi rend="italic">a. b</hi>, <hi rend="italic">wo</hi> aq. calidæ</seg><seg type="translation" xml:lang="en" source="#claude">c. 2. 3 equivalent to Zeu. 610a. b, where aq. calidæ</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">irrig wie</hi> atque V 2. 2, 3 <hi rend="italic">glossirt; richtig</hi> uætres 3, 2</seg><seg type="translation" xml:lang="en" source="#claude">wrongly glossed like atque V 2. 2, 3; correctly uætres 3, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch grosse Abkürzung zeigt Apostroph</hi></seg><seg type="translation" xml:lang="en" source="#claude">an apostrophe indicates even a large abbreviation</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">Iesus <hi rend="italic">glossirt durch ‘Heiland’</hi> 3. 4, 6. V 2, 1. VII 23 <hi rend="italic">A</hi></seg><seg type="translation" xml:lang="en" source="#claude">Iesus glossed by ‘Saviour’ 3. 4, 6. V 2, 1. VII 23 A</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">ihū xp̄e <hi rend="italic">Du</hi></seg><seg type="translation" xml:lang="en" source="#claude">ihū xp̄e Du</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-du">Exorcism of water for seeking out a theft. I exorcise you, creature of water, in the name of God, the Father almighty, and in the name of Jesus [Christ], his Son, our Lord, that you may become exorcised water for putting to flight every power of the enemy and every phantasm of the devil,</ab>
      </div>
