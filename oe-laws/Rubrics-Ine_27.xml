      <div type="clause" n="27">
        <head>Ine Rb 27</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="27" corresp="#wit-e"><pb n="22" ed="#liebermann"/>LXXI. Be<ptr type="liebermannNote" n="5" target="#Rubrics-Ine_27.lnote.oe.5"/> þon<ptr type="liebermannNote" n="6" target="#Rubrics-Ine_27.lnote.oe.6"/> þe mon dearnenga bearn gestriene.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="27" corresp="#wit-g-prol"><pb n="22" ed="#liebermann"/>LXXI. Be ðan ðe man dearnunga bearn gestryne.<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_27.lnote.oe.2"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="27" corresp="#wit-h"><pb n="23" ed="#liebermann"/>LXXI. Be þon<ptr type="liebermannNote" n="3" target="#Rubrics-Ine_27.lnote.oe.3"/> ðe mon<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_27.lnote.oe.2-2"/> dearnunga bearn<ptr type="liebermannNote" n="10" target="#Rubrics-Ine_27.lnote.oe.10"/> gestrine.<ptr type="liebermannNote" n="11" target="#Rubrics-Ine_27.lnote.oe.11-2"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="27" corresp="#wit-q"><pb n="23" ed="#liebermann"/>De eo<ptr type="liebermannNote" n="11" target="#Rubrics-Ine_27.lnote.oe.11"/> si quis puerum procreet<ptr type="liebermannNote" n="12" target="#Rubrics-Ine_27.lnote.oe.12"/> in occulto.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="204" ed="#jurasinski-and-oliver"/>LXXI Be þon þe mon dearnenga bearn gestriene</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="204" ed="#jurasinski-and-oliver"/>Be ðam þe dearnunge bearn stryneð</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="23" ed="#liebermann"/>Darüber, dass man unehelich Nachkommenschaft zeugt.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning someone begetting offspring out of wedlock.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="205" ed="#jurasinski-and-oliver"/>Concerning a child conceived secretly</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="205" ed="#jurasinski-and-oliver"/>Concerning he who conceives a child secretly</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_27.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im 16. Jh. geändert in</hi> gestriene</seg><seg type="translation" xml:lang="en" source="#claude">altered to gestriene in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_27.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de">28 <hi rend="italic">setzt vor</hi> 27 <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">28 placed before 27 Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_27.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de">ðam ðe dearnunga b. <hi rend="spaced">stryneþ</hi> <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðam ðe dearnunga b. <hi rend="italic">stryneþ</hi> Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_27.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">puero in o. procreato <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">puero in o. procreato Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_27.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">procrearet <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">procrearet T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_27.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> þam</seg><seg type="translation" xml:lang="en" source="#claude">altered þam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_27.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_27.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dahinter Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">erasure after it</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_27.lnote.oe.11-2" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hinter</hi> i <hi rend="italic">Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">erasure after i</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_27.lnote.de.0" n="0" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Wo sich <hi rend="italic">dierne</hi>, eig. ‘heimlich’, mit ‘Beischlaf’ verbindet, ist ‘unerlaubt, gesetzwidrig’ gemeint; <hi rend="italic">s.</hi> Af El 49, 5; Toller <hi rend="italic">Suppl.: dirne</hi> II 1. <hi rend="italic">dirne forlegen</hi>, <hi rend="italic">-gelegerscipe</hi>, <hi rend="italic">-geligere</hi>, <hi rend="italic">-leger(scipe)</hi>, <hi rend="italic">dirnlicgan</hi> : <hi rend="italic">fornicari</hi>, <hi rend="italic">dirnhæmende</hi>, <hi rend="italic">ligc dearnenga</hi> : <hi rend="italic">moechaberis</hi> Af El 6. So auch mittelengl. <hi rend="italic">derne</hi></seg><seg type="translation" xml:lang="en" source="#claude">Where <hi rend="italic">dierne</hi>, properly ‘secret’, is combined with ‘intercourse’, ‘illicit, unlawful’ is meant; <hi rend="italic">see</hi> Af El 49, 5; Toller <hi rend="italic">Suppl.: dirne</hi> II 1. <hi rend="italic">dirne forlegen</hi>, <hi rend="italic">-gelegerscipe</hi>, <hi rend="italic">-geligere</hi>, <hi rend="italic">-leger(scipe)</hi>, <hi rend="italic">dirnlicgan</hi> : <hi rend="italic">fornicari</hi>, <hi rend="italic">dirnhæmende</hi>, <hi rend="italic">ligc dearnenga</hi> : <hi rend="italic">moechaberis</hi> Af El 6. Likewise Middle English <hi rend="italic">derne</hi></seg></note>
      </div>
    </body>
