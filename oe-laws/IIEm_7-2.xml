    <body>
      <div type="clause" n="7.2">
        <head><ref type="lawCode" target="law:IIEm">II Em</ref> 7.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.2" corresp="#wit-h"><pb n="190" ed="#liebermann"/>Ðon<hi rend="italic">ne</hi> he ðæs beweddad hæbbe, ðon<hi rend="italic">ne</hi> finde he ðærto wærborh.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.2" corresp="#wit-b"><pb n="190" ed="#liebermann"/>Ðon<hi rend="italic">ne</hi> he ðæs beweddad<ptr type="liebermannNote" n="5" target="#IIEm_7-2.lnote.oe.5"/> hæbbe, ðone finde he ðærto wæreborh.<ptr type="liebermannNote" n="6" target="#IIEm_7-2.lnote.oe.6"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7.2" corresp="#wit-q"><pb n="191" ed="#liebermann"/>Et quando uadiauerit eam, inueniat wereplegios.<ptr type="liebermannNote" n="7" target="#IIEm_7-2.lnote.oe.7"/></ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="7.2" corresp="#wit-b"><pb n="10" ed="#robertson"/>Ðonne he ðæs beweddad hæbbe, ðone finde he ðærto wæreborh.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="191" ed="#liebermann"/>Nachdem<ptr type="liebermannNote" n="1" target="#IIEm_7-2.lnote.de.1"/> er sich darauf verpflichtet hat, dann finde er dazu [für Zahlung des] Wergelds<ptr type="liebermannNote" n="2" target="#IIEm_7-2.lnote.de.2"/> Bürgschaft.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">When he has pledged himself to that, then let him find surety for [payment of] the wergild for it.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="11" ed="#robertson"/>When he has pledged himself to this, he shall find a surety for the payment of the wergeld.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="430" ed="#whitelock"/>When he has pledged this, he is to find surety for the wergild.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Wer_3">Wer 3</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_7-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">190</biblScope></bibl><seg type="original" xml:lang="de">-ade h., ðonne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ade h., ðonne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_7-2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">190</biblScope></bibl><seg type="original" xml:lang="de">wærb. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wærb. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_7-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">191</biblScope></bibl><seg type="original" xml:lang="de">uere pl. <hi rend="italic">M</hi></seg><seg type="translation" xml:lang="en" source="#claude">uere pl. M</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEm_7-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">128</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Schiedsgericht 9d.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Schiedsgericht 9d.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEm_7-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">128</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Das mittlere <hi rend="italic">-e</hi> in B's <hi rend="italic">wæreborh</hi> ist Mittelenglisch. Da H Ld Q und Wer Ein Wort verstehen, darf man nicht etwa <hi rend="italic">þær to were borh</hi> (‘zum Wergeld Bürgschaft’) trennen.—<hi rend="italic">Vgl. Gl</hi> Bürgschaft 10</seg><seg type="translation" xml:lang="en" source="#claude">The medial <hi rend="italic">-e</hi> in B's <hi rend="italic">wæreborh</hi> is Middle English. Since H, Ld, Q and Wer take it as a single word, one must not divide it as, say, <hi rend="italic">þær to were borh</hi> (‘surety for the wergild’).—<hi rend="italic">Cf. Gl</hi> Bürgschaft 10</seg></note>
      </div>
    </body>
  </text>
