      <div type="clause" n="15.2">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 15.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 15.2"><pb n="641" ed="#liebermann"/>Et si non inueniebatur<ptr type="liebermannNote" n="a" target="#ECf_15-2.lnote.oe.erkl-a"/>, colligebantur<ptr type="liebermannNote" n="14" target="#ECf_15-2.lnote.la.14"/> in uilla<ptr type="liebermannNote" n="15" target="#ECf_15-2.lnote.la.15"/> XLVI marce<ptr type="liebermannNote" n="16" target="#ECf_15-2.lnote.la.16"/>.</ab>
        <note type="comparison" source="#liebermann" n="641"><label>printed alongside</label> <ref target="clause:ECfRetr_15-2">ECf retr 15.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 641 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-2.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-bant <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">-bant Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-2.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">uillis <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">uillis Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-2.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">XL marc̄ et VI <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">XL marc̄ et VI Ad</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And if he was not found, forty-six marks were collected in the vill.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-2.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">346</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd.</hi> Murdrum 10b. 11. 13. 14. — <hi rend="italic">Quodsi</hi><hi rend="superscript">10</hi> — <hi rend="italic">uilla</hi><hi rend="superscript">12</hi> <hi rend="italic">illa</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">Ibid. Murdrum 10b. 11. 13. 14. — <hi rend="italic">Quodsi</hi><hi rend="superscript">10</hi> — <hi rend="italic">uilla</hi><hi rend="superscript">12</hi> <hi rend="italic">illa</hi> Rs</seg></note>
      </div>
