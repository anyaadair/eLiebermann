      <div type="clause" n="42.2">
        <head><ref type="lawCode" target="law:Af">Af</ref> 42.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42.2" corresp="#wit-e"><pb n="76" ed="#liebermann"/>Gif he ðonne<ptr type="liebermannNote" n="1" target="#Af_42-2.lnote.oe.1"/> cirican geierne<ptr type="liebermannNote" n="2" target="#Af_42-2.lnote.oe.2"/>, sie<ptr type="liebermannNote" n="3" target="#Af_42-2.lnote.oe.3"/> ðon<hi rend="italic">ne</hi> be ðære cirican<ptr type="liebermannNote" n="4" target="#Af_42-2.lnote.oe.4"/> are, swa we ær bufan cwædon.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42.2" corresp="#wit-ot-frags"><pb n="76" ed="#liebermann"/>....ne<ptr type="liebermannNote" n="1" target="#Af_42-2.lnote.oe.1-2"/> geierne, sie<ptr type="liebermannNote" n="2" target="#Af_42-2.lnote.oe.2-2"/> þon..., .. bufan cwædon.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42.2" corresp="#wit-h"><pb n="76" ed="#liebermann"/>Gif he þonne ciricean<ptr type="liebermannNote" n="1" target="#Af_42-2.lnote.oe.1-3"/> gyrne, sy<ptr type="liebermannNote" n="2" target="#Af_42-2.lnote.oe.2-3"/> ðonne be þære ciricean<ptr type="liebermannNote" n="1" target="#Af_42-2.lnote.oe.1-3"/> áre, swa we ær bufon<ptr type="liebermannNote" n="3" target="#Af_42-2.lnote.oe.3-2"/> cwædon.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="42.2" corresp="#wit-q"><ptr type="liebermannNote" n="1" target="#Af_42-2.lnote.oe.1-4"/><pb n="77" ed="#liebermann"/>Si<ptr type="liebermannNote" n="2" target="#Af_42-2.lnote.oe.2-4"/> ecclesiam incurrat, sit secundum ueniam ipsius ecclesię, sicut supra diximus.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="82" ed="#attenborough"/>Gif he ðonne cirican geierne, sie ðonne be ðære cirican are, swa we ær bufan cwædon.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="44.2" corresp="#wit-e"><pb n="342" ed="#jurasinski-and-oliver"/>Gif he ðonne cirican geierne, sie ðon<hi rend="italic">ne</hi> be ðære cirican are, swa we ær bufan cwædon.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="77" ed="#liebermann"/>Wenn jener aber Kirchen[zuflucht] erreicht, geschehe dann gemäss dem Vorrecht<ptr type="liebermannNote" n="1" target="#Af_42-2.lnote.de.1"/> der Kirche so, wie wir zuvor oben<ptr type="liebermannNote" n="2" target="#Af_42-2.lnote.de.2"/> verkündet haben.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">But if that man reaches the [sanctuary of a] church, then let it be according to the privilege of the church, as we have declared above.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="83" ed="#attenborough"/>If, however, he flees to a church, the privileges of the church shall be respected, as we have declared above.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="416" ed="#whitelock"/>If he, however, reaches a church, it is then to be [dealt with] according to the privilege of the church, as we have said above.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="343" ed="#jurasinski-and-oliver"/>If he however makes it to a church [for sanctuary], let it be according to church privilege, as we spoke of before above.</ab>
        <note type="comparison" source="#wormald-mel" n="272"><label>cross-reference</label> <ref target="clause:Af_5">Af 5</ref> <quote>'If he then reaches a church, then let it be according to the church's privilege, as we said above'; the reference is to the law just quoted in full.</quote></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="343"><label>see</label> <ref target="clause:Af_2">Af 2</ref> <quote>as we spoke of before above. [n.] See Alfred §2.</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">cyricean ðonne <hi rend="italic">Ld; vgl. Ot</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyricean ðonne Ld; cf. Ot</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">geyrne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">geyrne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">cyricean <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyricean Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-2.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-2.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">i <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">i written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-2.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zweites</hi> i <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">second i written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-2.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-2.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-2.lnote.oe.1-4" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">77</biblScope></bibl><seg type="original" xml:lang="de">42, 2 <hi rend="italic">fehlt Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">42, 2 lacking in Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-2.lnote.oe.2-4" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">77</biblScope></bibl><seg type="original" xml:lang="de">in eccl. cur. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">in eccl. cur. Lond</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_42-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">60</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Kirchenrang; Asyl 14; Asylbruch 3. 5. 7; Kirchenfrieden 4c. — Mit <hi rend="italic">uenia</hi> meint Q ‘Privileg’; <hi rend="italic">s. o.</hi> 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Kirchenrang; Asyl 14; Asylbruch 3. 5. 7; Kirchenfrieden 4c. — By <hi rend="italic">uenia</hi> Q means ‘privilege’; <hi rend="italic">see above</hi> 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_42-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">60</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">O.</hi> 2. 5</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Above</hi> 2. 5</seg></note>
      </div>
