      <div type="clause" n="5.4">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.4" corresp="#wit-lat"><pb n="549" ed="#liebermann"/>Non<ptr type="liebermannNote" n="a" target="#Hn_5-4.lnote.oe.a"/> ita penitus est in ecclesiasticis negotiis sicut in secularibus: in secularibus, postquam aliquis uocatus uenerit et<ptr type="liebermannNote" n="1" target="#Hn_5-4.lnote.oe.1"/> in foro placitari ceperit, non licet ante peractam causam recedere<ptr type="liebermannNote" n="2" target="#Hn_5-4.lnote.oe.2"/> (etsi<ptr type="liebermannNote" n="b" target="#Hn_5-4.lnote.oe.b"/><ptr type="liebermannNote" n="3" target="#Hn_5-4.lnote.oe.3"/> inde iustitiam conuenerit<ptr type="liebermannNote" n="4" target="#Hn_5-4.lnote.oe.4"/>); in<ptr type="liebermannNote" n="5" target="#Hn_5-4.lnote.oe.5"/> ecclesiasticis uero, dicta causa, licet<ptr type="liebermannNote" n="6" target="#Hn_5-4.lnote.oe.6"/>, si<ptr type="liebermannNote" n="7" target="#Hn_5-4.lnote.oe.7"/> necesse fuerit<ptr type="liebermannNote" n="8" target="#Hn_5-4.lnote.oe.8"/>, si iudicem<ptr type="liebermannNote" n="c" target="#Hn_5-4.lnote.oe.c"/> suspectum habuit<ptr type="liebermannNote" n="9" target="#Hn_5-4.lnote.oe.9"/> uel se sentiat pregrauari<ptr type="liebermannNote" n="10" target="#Hn_5-4.lnote.oe.10"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 549 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-4.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch Ivo</hi> Decr. VI 336; <hi rend="italic">Gratian</hi> C. 2 q. 6 c. 18</seg><seg type="translation" xml:lang="en" source="#claude">also Ivo Decr. VI 336; Gratian C. 2 q. 6 c. 18</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-4.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">e. i. i. c. <hi rend="italic">vielleicht Nachtrag des Verfassers</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. i. i. c. perhaps an addition by the author</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-4.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">i. s. h. <hi rend="italic">aus anderer kanonistischen Quelle, z. B. Ivo,</hi> Decr. VI 318; Pan. IV 108. 120</seg><seg type="translation" xml:lang="en" source="#claude">i. s. h. from another canonistic source, e.g. Ivo, Decr. VI 318; Pan. IV 108. 120</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-4.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-4.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg;</hi> recedere <hi rend="italic">setzt hinter</hi> causa <hi rend="italic">Hg Wh Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg; Hg Wh Wi put recedere after causa</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-4.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">etsi iñ iu. co., in eccl. u. d. c. <hi rend="italic">am Rande vom Corr.</hi> 13. <hi rend="italic">Jhs. nachgetragen Sc; im Text Hg; fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">etsi iñ iu. co., in eccl. u. d. c. added in the margin by the 13th-cent. corrector in Sc; in the text in Hg; missing in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-4.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">-rint <hi rend="italic">ändert Wh</hi> [<hi rend="italic">falsch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">-rint altered by Wh [wrongly]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-4.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">in—licet <hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">in—licet missing in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-4.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">licet si n. f. <hi rend="italic">fehlt Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">licet si n. f. missing in Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-4.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">set <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">set K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-4.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">fuit <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">fuit K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-4.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">-uerit <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uerit Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-4.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">pergr. <hi rend="italic">Co Or Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">pergr. Co Or edd.</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">It is not quite the same in ecclesiastical business as in secular: in secular, after anyone summoned has come and has begun to plead in court, it is not lawful to withdraw before the case is concluded (even if he has come to terms with the justice about it [?]); in ecclesiastical, however, once the case has been stated, it is lawful, if it is necessary, if he held the judge suspect or feels himself overburdened.</ab>
      </div>
    </body>
