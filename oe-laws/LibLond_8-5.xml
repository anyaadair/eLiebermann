      <div type="clause" n="8.5">
        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 8.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 8.5" corresp="#wit-lat"><pb n="675" ed="#liebermann"/>Si uero ceram attulerit<ptr type="liebermannNote" n="8" target="#LibLond_8-5.lnote.oe.8"/>, non minus uendat simul<ptr type="liebermannNote" n="6" target="#LibLond_8-5.lnote.oe.6"/> quam I quarter’<ptr type="liebermannNote" n="g" target="#LibLond_8-5.lnote.oe.g"/><ptr type="liebermannNote" n="9" target="#LibLond_8-5.lnote.oe.9"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 675 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-5.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">¹/₄ <hi rend="italic">Hundert</hi> = quarter’ 8, 5. <hi rend="italic">Auch Deutschland kennt</hi> 25 <hi rend="italic">Pfund als Maximum des Kleinhandels; vgl. Keutgen</hi> Hans. Geschichtsbl. 1901 (1902) <hi rend="italic">S.</hi> 103</seg><seg type="translation" xml:lang="en" source="#claude">¹/₄ hundred = quarter’ 8, 5. Germany too knows 25 pounds as the maximum for retail trade; cf. Keutgen Hans. Geschichtsbl. 1901 (1902) p. 103</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-5.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt PlS Cons</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in PlS Cons</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-5.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">ferat <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">ferat Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-5.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">-tarium <hi rend="italic">PlS;</hi> -terium <hi rend="italic">Cons,</hi> quartrun <hi rend="italic">Alb;</hi> quarterun <hi rend="italic">Ord</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tarium PlS; -terium Cons, quartrun Alb; quarterun Ord</seg></note>
      </div>
