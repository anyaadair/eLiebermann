        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Duel 1.12" corresp="#wit-lat"><pb n="430" ed="#liebermann"/>Adiuua nos, Deus<ptr type="liebermannNote" n="27" target="#Duel_1-12.lnote.oe.27"/> salutaris<ptr type="liebermannNote" n="28" target="#Duel_1-12.lnote.oe.28"/> noster<ptr type="liebermannNote" n="29" target="#Duel_1-12.lnote.oe.29"/>, et propter gloriam<ptr type="liebermannNote" n="30" target="#Duel_1-12.lnote.oe.30"/> nominis tui, Domine, libera nos et propitius esto peccatis nostris propter nomen tuum.</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">78, 9</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 430 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_1-12.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de">domine <hi rend="italic">Sr Ta;</hi> Deus — tuum <hi rend="italic">fehlt Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">domine Sr Ta; Deus — tuum missing in Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_1-12.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de">sa. — tuum <hi rend="italic">fehlt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">sa. — tuum missing in Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_1-12.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">430</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ta</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Ta</seg></note>
