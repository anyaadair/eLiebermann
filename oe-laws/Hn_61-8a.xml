        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-8a.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">581</biblScope></bibl><seg type="original" xml:lang="de">sonitus <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sonitus <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-8a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">condixit et p. tamen</hi> [Sinn des Archetyp-Verderbers vielleicht: ‘Wenn (der Richter den Termin) nicht angeordnet hat, und (Gericht) dennoch vorbereitet ist’]—<hi rend="italic">-ssa</hi>{40} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">condixit et p. tamen</hi> [what the corrupter of the archetype meant was perhaps: ‘If (the judge) has not appointed (the day), and (the court) is nevertheless prepared’]—<hi rend="italic">-ssa</hi>{40} Rs</seg></note>
