    <body>
      <div type="clause" n="1.4">
        <head><ref type="lawCode" target="law:IIAs">II As</ref> 1.4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.4" corresp="#wit-h"><pb n="150" ed="#liebermann"/>⁊ gif he ofer ðæt stalige,<ptr type="liebermannNote" n="†" target="#IIAs_1-4.lnote.oe.dagger"/> forgildon<ptr type="liebermannNote" n="15" target="#IIAs_1-4.lnote.oe.15"/> hy<ptr type="liebermannNote" n="16" target="#IIAs_1-4.lnote.oe.16"/> hine be his were oþþe hine eft ðær inne gebringan.<ptr type="liebermannNote" n="17" target="#IIAs_1-4.lnote.oe.17"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.4" corresp="#wit-b"><pb n="150" ed="#liebermann"/>And gyf<ptr type="liebermannNote" n="8" target="#IIAs_1-4.lnote.oe.8"/> he ofer þ<hi rend="italic">æt</hi> stalie<ptr type="liebermannNote" n="19" target="#IIAs_1-4.lnote.oe.19"/>, ðonne forgyldan hi hine be his were oððe hine eft<ptr type="liebermannNote" n="20" target="#IIAs_1-4.lnote.oe.20"/> ingebringan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.4" corresp="#wit-so"><pb n="150" ed="#liebermann"/>⁊ gif he ofer þ<hi rend="italic">æt</hi> stalie, þonne forgylden hie hine be his were oððe hine eft þær inne gebringen.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.4" corresp="#wit-q"><pb n="151" ed="#liebermann"/>Et<ptr type="liebermannNote" n="17" target="#IIAs_1-4.lnote.oe.17-2"/> si iterum<ptr type="liebermannNote" n="18" target="#IIAs_1-4.lnote.oe.18"/> furetur (postmodum), wera<ptr type="liebermannNote" n="19" target="#IIAs_1-4.lnote.oe.19-2"/> sua gildet eum, uel reddat similiter incarceratum.<ptr type="liebermannNote" n="20" target="#IIAs_1-4.lnote.oe.20-2"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="1.4" corresp="#wit-h"><pb n="128" ed="#attenborough"/>⁊ gif he ofer ðæt stalige, forgildon<ptr type="editorNote" n="2" target="#IIAs_1-4.attnote.fn.2"/> hy hine be his were oþþe hine eft ðær inne gebringan<ptr type="editorNote" n="3" target="#IIAs_1-4.attnote.fn.3"/>.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="151" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#IIAs_1-4.lnote.de.1"/> wenn er fernerhin stiehlt, (dann <hi rend="italic">B So</hi>) sollen sie [die Verwandten] ihn durch sein Wergeld<ptr type="liebermannNote" n="2" target="#IIAs_1-4.lnote.de.2"/> bezahlen oder<ptr type="liebermannNote" n="3" target="#IIAs_1-4.lnote.de.3"/> ihn wieder dort [ins Gefängniss] hinein bringen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if he steals after that, (then, B So) they [the kinsmen] are to pay for him with his wergild or bring him back in there [into prison].</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="129" ed="#attenborough"/>If he steals after that, they [his kinsmen] shall pay for him to the amount of his wergeld or put him back there<ptr type="editorNote" n="1" target="#IIAs_1-4.attnote.n.1"/>.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VIAs_12-2">VI As 12.2</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-4.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-4.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de">stalige <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">stalige Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-4.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de">þær <hi rend="italic">fügt zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þær added by Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-4.lnote.oe.dagger" n="†" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> þonne <hi rend="italic">aus B So</hi></seg><seg type="translation" xml:lang="en" source="#claude">supply þonne from B So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-4.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> -dan</seg><seg type="translation" xml:lang="en" source="#claude">altered to -dan</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-4.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">am Rande</hi></seg><seg type="translation" xml:lang="en" source="#claude">in the margin</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-4.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">150</biblScope></bibl><seg type="original" xml:lang="de">i <hi rend="italic">und</hi> a <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">i and a on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-4.lnote.oe.17-2" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">151</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-4.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">151</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> i. f. <hi rend="italic">Lond; nur</hi> f. p. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">only i. f. Lond; only f. p. the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-4.lnote.oe.19-2" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">151</biblScope></bibl><seg type="original" xml:lang="de">reddat eum w. sua <hi rend="italic">KOr, wo</hi> uel — wera sua <hi rend="italic">übersprungen</hi></seg><seg type="translation" xml:lang="en" source="#claude">reddat eum w. sua KOr, where uel — wera sua is skipped</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_1-4.lnote.oe.20-2" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">151</biblScope></bibl><seg type="original" xml:lang="de">in carcerem <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">in carcerem T</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_1-4.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">102</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Zitiert in VI 1, 4. <hi rend="italic">Vgl. Gl</hi> Rückfall 3 a</seg><seg type="translation" xml:lang="en" source="#claude">Cited in VI 1, 4. <hi rend="italic">Cf. Gl</hi> Rückfall 3 a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_1-4.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">102</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Also mindestens 200 Schill.</seg><seg type="translation" xml:lang="en" source="#claude">So at least 200 shill.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_1-4.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">102</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nach 40 Tagen wird er Strafknecht der Krone bis zum Abverdienen des Wergelds; VI 12, 2</seg><seg type="translation" xml:lang="en" source="#claude">After 40 days he becomes a penal slave of the Crown until he has worked off the wergild; VI 12, 2</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIAs_1-4.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">207</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e</hi>. in prison.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_1-4.attnote.fn.2" n="2" source="#attenborough"><bibl><biblScope unit="page">128</biblScope></bibl><label>forgildon</label><seg type="original" xml:lang="en"><hi rend="italic">ðonn forgyldan</hi>. B. <hi rend="italic">þonne forgylden</hi>. So.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_1-4.attnote.fn.3" n="3" source="#attenborough"><bibl><biblScope unit="page">128</biblScope></bibl><label>gebringan</label><seg type="original" xml:lang="en"><hi rend="italic">eft ingebringen</hi>. B.</seg></note>
      </div>
    </body>
  </text>
