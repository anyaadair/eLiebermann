      <div type="clause" n="45.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 45.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 45.1a" corresp="#wit-lat"><pb n="570" ed="#liebermann"/>Simplex enim et uacua compellacio est, ubi ex neutra parte, compellantis<ptr type="liebermannNote" n="d" target="#Hn_45-1a.lnote.oe.d"/> scilicet aut compellati<ptr type="liebermannNote" n="6" target="#Hn_45-1a.lnote.oe.6"/>, testis est; nec causa huiusmodi<ptr type="liebermannNote" n="7" target="#Hn_45-1a.lnote.oe.7"/> que<ptr type="liebermannNote" n="8" target="#Hn_45-1a.lnote.oe.8"/> bello<ptr type="liebermannNote" n="e" target="#Hn_45-1a.lnote.oe.e"/> uel iudicio uel lege sacramentali uel<ptr type="liebermannNote" n="9" target="#Hn_45-1a.lnote.oe.9"/> timore uel amore mereatur promoueri<ptr type="liebermannNote" n="10" target="#Hn_45-1a.lnote.oe.10"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 570 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-1a.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">kein Zeuge für Kläger bezw. Eidhelfer des Beklagten</seg><seg type="translation" xml:lang="en" source="#claude">no witness for the plaintiff, or no oath-helper for the defendant, respectively</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-1a.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">Zweikampf oder einseitiges Ordal oder Eideshelferbeweis; <hi rend="italic">vgl.</hi> 49, 6</seg><seg type="translation" xml:lang="en" source="#claude">trial by combat, or unilateral ordeal, or proof by oath-helpers; cf. 49, 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-1a.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">-ari <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ari Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-1a.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">huius <hi rend="italic">Sc, nicht Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">huius Sc, not Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-1a.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">streiche?</hi></seg><seg type="translation" xml:lang="en" source="#claude">delete?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-1a.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> set?</seg><seg type="translation" xml:lang="en" source="#claude">read set?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-1a.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">promereri <hi rend="italic">Lond;</hi> promoueri, ut aperte promereri <hi rend="italic">Gi;</hi> 49, 6 <hi rend="italic">bestätigt</hi> promou.</seg><seg type="translation" xml:lang="en" source="#claude">promereri Lond; promoueri, ut aperte promereri Gi; 49, 6 confirms promou.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_45-1a.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Klage 14. <hi rend="italic">Nemo tenetur respondere nisi testimonio alicuius subsequente</hi>; Très anc. cout. Norm. I 40, 1—<hi rend="italic">-ari</hi>{6}—<hi rend="italic">-mereri</hi>{10} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Klage 14. <hi rend="italic">Nemo tenetur respondere nisi testimonio alicuius subsequente</hi>; Très anc. cout. Norm. I 40, 1—<hi rend="italic">-ari</hi>{6}—<hi rend="italic">-mereri</hi>{10} Rs</seg></note>
      </div>
