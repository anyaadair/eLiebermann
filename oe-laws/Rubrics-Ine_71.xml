      <div type="clause" n="71">
        <head>Ine Rb 71</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="71" corresp="#wit-e"><pb n="26" ed="#liebermann"/>CXV. Be wertyhtlan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="71" corresp="#wit-g-prol"><pb n="26" ed="#liebermann"/>CXV. Be wertihlan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="71" corresp="#wit-h"><pb n="27" ed="#liebermann"/>CXV. Be wertihtlan.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="71" corresp="#wit-q"><pb n="27" ed="#liebermann"/>De<ptr type="liebermannNote" n="3" target="#Rubrics-Ine_71.lnote.oe.3"/><ptr type="liebermannNote" n="13" target="#Rubrics-Ine_71.lnote.oe.13"/> weretihla.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="216" ed="#jurasinski-and-oliver"/>CXV Be wertyhtlan</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="216" ed="#jurasinski-and-oliver"/>Be wertyhlan</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="27" ed="#liebermann"/>Von<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_71.lnote.de.1"/> Klage auf Wergeld.<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_71.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of a claim for wergeld.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="217" ed="#jurasinski-and-oliver"/>Concerning accusation of an act for which wergild must be paid</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="217" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_71.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">27</biblScope></bibl><seg type="original" xml:lang="de">Et de <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et de T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_71.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">27</biblScope></bibl><seg type="original" xml:lang="de">De homicida accusato, primo negante et [<hi rend="italic">fehlt Br</hi>] postea [post <hi rend="italic">Br</hi>] confitente <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">De homicida accusato, primo negante et [lacking in Br] postea [post Br] confitente Hk Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_71.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Q spät. Rez. vervollständigt die Rb aus seinem Text</seg><seg type="translation" xml:lang="en" source="#claude">The later recension of Q completes the Rb from its own text</seg><note type="remark" resp="#claude">On several rubrics: Ine Rb 40. 43f. 46—50. 54. 56f. 58. 61f. 67. 70f.</note></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_71.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Nicht: ‘Über ein mit Wergeld[strafe] bedrohtes Verbrechen’ Schmid; <hi rend="italic">s.</hi> Ine 71</seg><seg type="translation" xml:lang="en" source="#claude">Not: ‘Of a crime punishable by wergild [penalty]’ Schmid; <hi rend="italic">see</hi> Ine 71</seg></note>
      </div>
