      <div type="clause" n="41.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 41.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 41.5" corresp="#wit-lat"><pb n="568" ed="#liebermann"/>Qui plures mansiones habet in comitatu, submoneri<ptr type="liebermannNote" n="10" target="#Hn_41-5.lnote.oe.10"/> debet a uicecomite, ad quam earum residens erit cum familia sua, si sit etiam<ptr type="liebermannNote" n="15" target="#Hn_41-5.lnote.oe.15"/> agendum de alia.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 568 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-5.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">summoniri <hi rend="italic">oder</hi> sumo. <hi rend="italic">Lond meist</hi></seg><seg type="translation" xml:lang="en" source="#claude">summoniri or sumo. Lond mostly</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-5.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_41-5.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Herrschaftsgut 6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Herrschaftsgut 6</seg></note>
