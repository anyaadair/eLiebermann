      <div type="clause" n="23.1A">
        <head><ref type="lawCode" target="law:IudDeiVII">Iud Dei VII</ref> 23.1A</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei VII 23.1A" corresp="#wit-ci"><pb n="414" ed="#liebermann"/>Ic halsige þe þurh Fæder ⁊ Sunu ⁊ þurh þæne halegan Gast ⁊ þa halegan þrynnysse, þa untodæledlican, ⁊ þurh urne drihten hælendne<ptr type="liebermannNote" n="7" target="#IudDeiVII_23-1A.lnote.oe.7"/> Crist ⁊ þurh ealle englas ⁊ heahenglas ⁊ þurh ealle martiras ⁊ þurh þæne forhttundan<ptr type="liebermannNote" n="8" target="#IudDeiVII_23-1A.lnote.oe.8"/> domes dæg, of þa<hi rend="italic">m</hi> ealle gesceafta cwaciað ⁊ bifiað, ⁊ þurh þa feower ⁊ twentig uðwitan<ptr type="liebermannNote" n="9" target="#IudDeiVII_23-1A.lnote.oe.9"/>, þe dæghwa<hi rend="italic">m</hi>lice Drihten heriað, ⁊ þurh þa feower godspelleras Matheus, Marcus, Lucas, Iohannes ⁊ þurh þa twelf wítigan ⁊ þurh ealle Godes halegan þroweras ⁊ halige fæmnan ⁊<ptr type="liebermannNote" n="10" target="#IudDeiVII_23-1A.lnote.oe.10"/> andetras, ⁊ ealdordomas ⁊ halige mihta ⁊ mægenu ⁊ anwealdu, ⁊ þurh þ<hi rend="italic">æt</hi> halige Godes hehsetl ⁊ þurh þ<hi rend="italic">æt</hi> halige engelcynn Cherubin et Seraphin ⁊<ptr type="liebermannNote" n="11" target="#IudDeiVII_23-1A.lnote.oe.11"/> ealle heofonlice anweald.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 414 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-1A.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">das Angelsächsische</hi> (23 <hi rend="italic">A</hi>) <hi rend="italic">steht <hi rend="spaced">hinter</hi> dem Latein</hi> (23)</seg><seg type="translation" xml:lang="en" source="#claude">the Anglo-Saxon (23 A) stands <hi rend="italic">after</hi> the Latin (23)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-1A.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fast identisch mit Zeumer</hi> 619, <hi rend="italic">vgl.</hi> 625. 627. 651. 654. 656. 663. 690. 696; <hi rend="italic">unten</hi> VIII 2, 3 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">almost identical with Zeumer 619, cf. 625. 627. 651. 654. 656. 663. 690. 696; below VIII 2, 3 f.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-1A.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">das Angelsächsische</hi> (24 <hi rend="italic">A</hi>) <hi rend="italic">steht <hi rend="spaced">hinter</hi> dem Latein</hi> (24).</seg><seg type="translation" xml:lang="en" source="#claude">the Anglo-Saxon (24 A) stands <hi rend="italic">after</hi> the Latin (24).</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-1A.lnote.oe.7-2" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de">hæled., <hi rend="italic">übergeschr.</hi> n</seg><seg type="translation" xml:lang="en" source="#claude">hæled., n written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-1A.lnote.oe.8-2" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">für</hi> forhtiendan</seg><seg type="translation" xml:lang="en" source="#claude">for forhtiendan</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-1A.lnote.oe.9-2" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">‘Weise, Gelehrte’ übersetzt auch</hi> V 2 <hi rend="italic">und in Psalmen</hi> seniores</seg><seg type="translation" xml:lang="en" source="#claude">‘wise men, learned men’; also translates seniores in V 2 and in the Psalms</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-1A.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de">⁊ a. <hi rend="italic">übergeschrieben</hi></seg><seg type="translation" xml:lang="en" source="#claude">⁊ a. written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-1A.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">‘und alle himmlischen Gewalten’</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘and all the heavenly powers’</seg></note>
      </div>
