        <head><ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 5" corresp="#wit-du" ana="#glossed"><pb n="411" ed="#liebermann"/><seg type="glossed"><seg type="base">Omnipotens,</seg><gloss xml:lang="ang"><ptr type="liebermannNote" n="11" target="#IudDeiIV_5.lnote.oe.11"/><pb n="411" ed="#liebermann"/>Allm<hi rend="italic">æhtig</hi></gloss></seg> <seg type="glossed"><seg type="base">sempiterne</seg><gloss xml:lang="ang">ece</gloss></seg> <seg type="glossed"><seg type="base">Deus,</seg><gloss xml:lang="ang">God,</gloss></seg> <seg type="glossed"><seg type="base">confitenti</seg><gloss xml:lang="ang">ondetende</gloss></seg> <seg type="glossed"><seg type="base">tibi<ptr type="liebermannNote" n="12" target="#IudDeiIV_5.lnote.oe.12"/></seg><gloss xml:lang="ang">ðe</gloss></seg> <seg type="glossed"><seg type="base">huic</seg><gloss xml:lang="ang">ðissvm</gloss></seg> <seg type="glossed"><seg type="base">famulo</seg><gloss xml:lang="ang">ðea</gloss></seg> <seg type="glossed"><seg type="base">tuo</seg><gloss xml:lang="ang">ðinv<hi rend="italic">m</hi></gloss></seg> illo<ptr type="liebermannNote" n="13" target="#IudDeiIV_5.lnote.oe.13"/> <seg type="glossed"><seg type="base">pro</seg><gloss xml:lang="ang">f<hi rend="italic">or</hi>e</gloss></seg> <seg type="glossed"><seg type="base">tua</seg><gloss xml:lang="ang">ðinv<hi rend="italic">m<ptr type="liebermannNote" n="14" target="#IudDeiIV_5.lnote.oe.14"/></hi></gloss></seg> <seg type="glossed"><seg type="base">pietate</seg><gloss xml:lang="ang">arfæst<hi rend="italic">nise</hi></gloss></seg> <seg type="glossed"><seg type="base">peccata</seg><gloss xml:lang="ang">synno</gloss></seg> <seg type="glossed"><seg type="base">relaxa,</seg><gloss xml:lang="ang">f<hi rend="italic">or</hi>let,</gloss></seg> <seg type="glossed"><seg type="base">ut</seg><gloss xml:lang="ang">þ<hi rend="italic">æt</hi>te</gloss></seg> <seg type="glossed"><seg type="base">non</seg><gloss xml:lang="ang">no</gloss></seg> <seg type="glossed"><seg type="base">plus</seg><gloss xml:lang="ang">f<hi rend="italic">or</hi>ðor</gloss></seg> <seg type="glossed"><seg type="base">ei</seg><gloss xml:lang="ang">him</gloss></seg> <seg type="glossed"><seg type="base">noceat<ptr type="liebermannNote" n="15" target="#IudDeiIV_5.lnote.oe.15"/></seg><gloss xml:lang="ang">gisceððe</gloss></seg> <seg type="glossed"><seg type="base">reatus</seg><gloss xml:lang="ang">scyldignis<hi rend="italic">e</hi></gloss></seg> <seg type="glossed"><seg type="base">ad</seg><gloss xml:lang="ang">to</gloss></seg> <seg type="glossed"><seg type="base">poena<hi rend="italic">m</hi></seg><gloss xml:lang="ang">pinvnge <hi rend="italic">uel<ptr type="liebermannNote" n="16" target="#IudDeiIV_5.lnote.oe.16"/></hi></gloss></seg> <seg type="glossed"><seg type="base">quam</seg><gloss xml:lang="ang">þ<hi rend="italic">æt</hi> <hi rend="italic">uel<ptr type="liebermannNote" n="17" target="#IudDeiIV_5.lnote.oe.17"/></hi> ðon<hi rend="italic">ne</hi></gloss></seg> <seg type="glossed"><seg type="base">indulgentia</seg><gloss xml:lang="ang">f<hi rend="italic">or</hi>gefnise</gloss></seg> <seg type="glossed"><seg type="base">tuæ<ptr type="liebermannNote" n="18" target="#IudDeiIV_5.lnote.oe.18"/></seg><gloss xml:lang="ang">ðinræ</gloss></seg> <seg type="glossed"><seg type="base">pietatis</seg><gloss xml:lang="ang">arfæstnisse</gloss></seg> <seg type="glossed"><seg type="base">ad</seg><gloss xml:lang="ang">to</gloss></seg> <seg type="glossed"><seg type="base">ueniam.</seg><gloss xml:lang="ang">f<hi rend="italic">or</hi>letnise.</gloss></seg> Per.<ptr type="liebermannNote" n="19" target="#IudDeiIV_5.lnote.oe.19"/></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 411 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_5.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">identisch mit</hi> Ordo poenitentiae, Ad missam <hi rend="italic">bei Rozière</hi> Recueil des formules <hi rend="italic">p.</hi> 766</seg><seg type="translation" xml:lang="en" source="#claude">identical with Ordo poenitentiae, Ad missam in Rozière Recueil des formules p. 766</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_5.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Roz.</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Roz.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_5.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> illi, <hi rend="italic">Namen des Beichtenden; fehlt Roz.</hi></seg><seg type="translation" xml:lang="en" source="#claude">read illi, the name of the penitent; omitted in Roz.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_5.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Lind. S.</hi> 117. 121</seg><seg type="translation" xml:lang="en" source="#claude">Lind. p. 117. 121</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_5.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de">conscientia <hi rend="italic">fügt zu Roz.</hi></seg><seg type="translation" xml:lang="en" source="#claude">conscientia added by Roz.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_5.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">besserndes Synonym fehlt</hi></seg><seg type="translation" xml:lang="en" source="#claude">correcting synonym missing</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_5.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> ðonne <hi rend="italic">ist richtig</hi></seg><seg type="translation" xml:lang="en" source="#claude">only ðonne is correct</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_5.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de">tua <hi rend="italic">Roz.</hi></seg><seg type="translation" xml:lang="en" source="#claude">tua Roz.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_5.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> Benedictio uestium uirginum <hi rend="italic">Du.</hi></seg><seg type="translation" xml:lang="en" source="#claude">followed by Benedictio uestium uirginum Du.</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-du">Almighty, everlasting God, in your mercy forgive the sins of this your servant N., who confesses to you, so that guilt may not harm him more towards punishment than the indulgence of your mercy [avails him] towards pardon. Through …</ab>
      </div>
