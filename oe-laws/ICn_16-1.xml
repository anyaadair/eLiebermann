        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_16-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">200</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Jene Homileten lassen 16, 1 fort</seg><seg type="translation" xml:lang="en" source="#claude">Those homilists omit 16, 1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_16-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">200</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Öffentlichen Busstag (<hi rend="italic">s</hi>. VII Atr) meint Inst</seg><seg type="translation" xml:lang="en" source="#claude">Inst means a public day of penance (<hi rend="italic">see</hi> VII Atr)</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="ICn_16-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">350</biblScope></bibl><seg type="original" xml:lang="en">Lit. ‘unless anyone has had it prescribed to him.’ Inst. reads: <hi rend="italic">preceptum pro publica penitentia</hi>.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="ICn_16-1.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">350</biblScope></bibl><seg type="original" xml:lang="en">Note G’s addition, which means literally ‘a week after the twelfth Mass day.’</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="ICn_16-1.robnote.fn.13" n="13" source="#robertson"><bibl><biblScope unit="page">166</biblScope></bibl><label>fæsten</label><seg type="original" xml:lang="en"><hi rend="italic">fæstan</hi> G.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="ICn_16-1.robnote.fn.14" n="14" source="#robertson"><bibl><biblScope unit="page">166</biblScope></bibl><label>⁊</label><seg type="original" xml:lang="en"><hi rend="italic">eallswa</hi> G.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="ICn_16-1.robnote.fn.15" n="15" source="#robertson"><bibl><biblScope unit="page">166</biblScope></bibl><label>Epiphanie</label><seg type="original" xml:lang="en"><hi rend="italic">Epiphanige, þæt is seofen niht ofer Twelftan mæssedæge</hi> G.</seg></note>
