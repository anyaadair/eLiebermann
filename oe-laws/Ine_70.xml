        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_70.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">80</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Mannbusse 15</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Mannbusse 15</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_70.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">80</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Q versteht richtig</seg><seg type="translation" xml:lang="en" source="#claude">Q understands correctly</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_70.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">80</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Ine kann auch ‘Mann’ mit <hi rend="italic">wer</hi> meinen, was den Sinn nicht ändert</seg><seg type="translation" xml:lang="en" source="#claude">Ine may also mean ‘man’ by <hi rend="italic">wer</hi>, which does not change the sense</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_70.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">192</biblScope></bibl><seg type="original" xml:lang="en">For <hi rend="italic">manbot</hi>, <hi rend="italic">i.e.</hi> compensation paid to a lord for the death of one of his men, cf. Abt. cap. 6; Ine, cap. 76; II Edm. cap. 7 § 3, 3; I Can. cap. 2 § 5; I Wm. cap. 7; and Maitland, <hi rend="italic">Domesday Book and Beyond</hi>, pp. 31, 54, 70.</seg></note>
