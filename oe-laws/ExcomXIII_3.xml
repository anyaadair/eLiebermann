      <div type="clause" n="3">
        <head><ref type="lawCode" target="law:ExcomXIII">Excom XIII</ref> 3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom XIII 3" corresp="#wit-ym"><pb n="441" ed="#liebermann"/>Et nisi restituerint<ptr type="liebermannNote" n="4" target="#ExcomXIII_3.lnote.oe.4"/> et ad satisfactionem<ptr type="liebermannNote" n="5" target="#ExcomXIII_3.lnote.oe.5"/> uenerint, sic extinguatur<ptr type="liebermannNote" n="i" target="#ExcomXIII_3.lnote.oe.i"/> lucerna eorum in secula seculorum!</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 441 (two independent readings of the page images, differences settled against the page); Liebermann prints in smaller type: Et nisi restituerint et ad satisfactionem uenerint, sic extinguatur lucerna eorum in secula seculorum!</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXIII_3.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> I 11, 2. 14</seg><seg type="translation" xml:lang="en" source="#claude">cf. I 11, 2. 14</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXIII_3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de">resipuerint <hi rend="italic">Gem und</hi> I 12 <hi rend="italic">Citirtes</hi></seg><seg type="translation" xml:lang="en" source="#claude">resipuerint Gem and the passage quoted in I 12</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXIII_3.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de">-nis et emendationis remedium confugerint <hi rend="italic">Gem.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nis et emendationis remedium confugerint Gem.</seg></note>
      </div>
