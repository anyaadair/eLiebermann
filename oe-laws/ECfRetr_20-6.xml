      <div type="clause" n="20.6">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 20.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 20.6"><pb n="646" ed="#liebermann"/>Et si quando possent<ptr type="liebermannNote" n="27" target="#ECfRetr_20-6.lnote.la.27"/> eum recuperare, adducerent <hi rend="bold">illum</hi><ptr type="liebermannNote" n="28" target="#ECfRetr_20-6.lnote.la.28"/> ad iustitiam<ptr type="liebermannNote" n="29" target="#ECfRetr_20-6.lnote.la.29"/> aut dicerent iusticie, ubi esset.</ab>
        <note type="comparison" source="#liebermann" n="646"><label>printed alongside</label> <ref target="clause:ECf_20-6">ECf 20.6</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 646 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-6.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">e. r. p. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. r. p. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-6.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Lb Va Ra Ph Co Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Lb Va Ra Ph Co Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-6.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">iustitiarium <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">iustitiarium Hv</seg></note>
      </div>
