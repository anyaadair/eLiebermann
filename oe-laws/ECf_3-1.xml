      <div type="clause" n="3.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 3.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 3.1"><pb n="629" ed="#liebermann"/>Iustum est<ptr type="liebermannNote" n="37" target="#ECf_3-1.lnote.la.37"/> enim<ptr type="liebermannNote" n="18" target="#ECf_3-1.lnote.la.18"/>, ut<ptr type="liebermannNote" n="38" target="#ECf_3-1.lnote.la.38"/> Dominus<ptr type="liebermannNote" n="39" target="#ECf_3-1.lnote.la.39"/> ubique<ptr type="liebermannNote" n="18" target="#ECf_3-1.lnote.la.18"/> per seruos suos<ptr type="liebermannNote" n="26" target="#ECf_3-1.lnote.la.26"/> honoretur.</ab>
        <note type="comparison" source="#liebermann" n="629"><label>printed alongside</label> <ref target="clause:ECfRetr_3-1">ECf retr 3.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 629 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_3-1.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">en. est <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">en. est Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_3-1.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_3-1.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_3-1.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">diues, <hi rend="italic">später darüber</hi> Deus <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">diues, later Deus above it Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_3-1.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">For it is just that the Lord be honoured everywhere through his servants.</ab>
      </div>
