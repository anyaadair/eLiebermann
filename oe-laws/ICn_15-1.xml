    <body>
      <div type="clause" n="15.1">
        <head><ref type="lawCode" target="law:ICn">I Cn</ref> 15.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15.1" corresp="#wit-g-a"><pb n="296" ed="#liebermann"/>⁊ huntaðfara ⁊ ealra woruldlicra weorca on þa<hi rend="italic">m</hi> halgan dæge geswícæ<ptr type="liebermannNote" n="4" target="#ICn_15-1.lnote.oe.4"/> man georne.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15.1" corresp="#wit-b"><pb n="296" ed="#liebermann"/>And huntaðfara ⁊ ealra woruldlica weorca on ðam halgan dæge geswican<ptr type="liebermannNote" n="1" target="#ICn_15-1.lnote.oe.1"/> man georne.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15.1" corresp="#wit-a"><pb n="296" ed="#liebermann"/>⁊ huntaðfara ⁊ ealra woruldlicra weorca on þa<hi rend="italic">m</hi> halgan dæge geswice man georne.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="15.1" corresp="#wit-inst-cn"><pb n="297" ed="#liebermann"/>Opera quoque uenatoria<ptr type="liebermannNote" n="3" target="#ICn_15-1.lnote.oe.3"/> et omnia secularia negotia prohibemus.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="15.1" corresp="#wit-cons-cn"><pb n="297" ed="#liebermann"/>[15, 1] et omnem uenacionem et omnem secularem operacionem.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="15.1" corresp="#wit-b"><pb n="166" ed="#robertson"/>And huntaðfara ⁊ ealra woruldlica weorca on ðam halgan dæge geswican<ptr type="editorNote" n="5" target="#ICn_15-1.robnote.fn.5"/> man georne.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="244" ed="#rabin-doml"/>And huntaðfara and ealra woruldlicra weorca on þam halgan dæge geswicæ man georne.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="296" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#ICn_15-1.lnote.de.1"/> der Jagdzüge und aller weltlichen Arbeiten enthalte man sich willig an dem heiligen Tage.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let hunting and all worldly work be eagerly given up on that holy day.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="167" ed="#robertson"/>And hunting and all secular occupations shall be strictly abstained from on the holy day.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="245" ed="#rabin-doml"/>And hunts and worldly business are to be assiduously avoided on that holy day.</ab>
        <note type="comparison" source="#liebermann" n="296"><ref target="clause:VIAtr_22-1">VI Atr 22.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd.</note>
        <note type="editorial">Quadr. includes this in 15 (‘uenationes et huiusmodi secularium actiones’). Liebermann compares VI Atr 22.1.; Robertson (p. 139) takes I Cn from B, which begins at ‘mæssedæg’ in 14.2, the earlier clauses being supplied from G; BR: added from Gesetze I p. 297, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_15-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">296</biblScope></bibl><seg type="original" xml:lang="de">-ce <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ce Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_15-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">296</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. II Cn.</hi> 3</seg><seg type="translation" xml:lang="en" source="#claude">cf. II Cn. 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_15-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">297</biblScope></bibl><seg type="original" xml:lang="de">-antia <hi rend="italic">HLb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">-antia HLb S</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_15-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">200</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Den Satz lassen fort <hi rend="italic">Hom</hi>. 117. 208</seg><seg type="translation" xml:lang="en" source="#claude">The sentence is omitted by <hi rend="italic">Hom</hi>. 117. 208</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="ICn_15-1.robnote.fn.5" n="5" source="#robertson"><bibl><biblScope unit="page">166</biblScope></bibl><label>geswican</label><seg type="original" xml:lang="en"><hi rend="italic">-swicæ</hi> G; <hi rend="italic">-swice</hi> A, Ld.</seg></note>
      </div>
    </body>
