    <body>
      <div type="clause" n="4.3">
        <head><ref type="lawCode" target="law:IAtr">I Atr</ref> 4.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4.3" corresp="#wit-h"><pb n="220" ed="#liebermann"/>⁊ se þe þys forsytte ⁊ hit geforðian nylle, swa ure ealra cwide is, sylle þa<hi rend="italic">m</hi> cynge CXX scll.'<ptr type="liebermannNote" n="1" target="#IAtr_4-3.lnote.oe.1"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4.3" corresp="#wit-b"><pb n="220" ed="#liebermann"/>⁊ se ðe þis forsitte<ptr type="liebermannNote" n="12" target="#IAtr_4-3.lnote.oe.12"/> ⁊ hit geforðian nylle, swa ure ealra cwide is, sylle ðam<ptr type="liebermannNote" n="1" target="#IAtr_4-3.lnote.oe.1-2"/> cynge hundtwelftig scill.'<ptr type="liebermannNote" n="13" target="#IAtr_4-3.lnote.oe.13"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="4.3" corresp="#wit-q"><pb n="221" ed="#liebermann"/>Et qui<ptr type="liebermannNote" n="3" target="#IAtr_4-3.lnote.oe.3"/> supersederit et<ptr type="liebermannNote" n="4" target="#IAtr_4-3.lnote.oe.4"/> paruipendet uel complere nolet<ptr type="liebermannNote" n="5" target="#IAtr_4-3.lnote.oe.5"/>, sicut omnium nostrum est institutum, emendet regi CXX<ptr type="liebermannNote" n="6" target="#IAtr_4-3.lnote.oe.6"/> sol.<ptr type="liebermannNote" n="7" target="#IAtr_4-3.lnote.oe.7"/></ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="4.3" corresp="#wit-b"><pb n="54" ed="#robertson"/>⁊ se ðe þis forsitte ⁊ hit geforðian nylle, swa ure ealra cwide is, sylle ðam cynge hundtwelftig scill'.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="221" ed="#liebermann"/>Und wer dies vernachlässigt und es, wie unser aller Beschluss ist, zu fördern weigert, zahle dem König 120 Schill. [Strafe].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And whoever neglects this and refuses to further it, as is the decision of us all, let him pay the king 120 shillings [as a fine].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IAtr_4-3.robnote.n.1"/><pb n="55" ed="#robertson"/>And he who ignores this, and will not further what we have all decreed, shall pay 120 shillings to the king.</ab>
        <note type="comparison" source="#liebermann" n="221"><ref target="clause:IVAs_7">IV As 7</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. IV As. 7</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_33-2">II Cn 33.2</ref></note>
        <note type="editorial">In H, ‘Willelmes cyninges asetnysse’ on modes of proof follows; in B, French verses written in the early 13th c.; in Quadr., III Atr. Liebermann compares IV As 7.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_4-3.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">220</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> Willelmes cyninges asetnysse <hi rend="italic">über Beweismittel</hi></seg><seg type="translation" xml:lang="en" source="#claude">followed by Willelmes cyninges asetnysse on means of proof</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_4-3.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">221</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_4-3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">221</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt MHk, so dass</hi> pa. <hi rend="italic">Glosse zu</hi> su. <hi rend="italic">scheint</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing MHk, so that pa. appears to be a gloss on su.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_4-3.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">221</biblScope></bibl><seg type="original" xml:lang="de">noluerit <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">noluerit Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_4-3.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">221</biblScope></bibl><seg type="original" xml:lang="de">XXX <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">XXX MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_4-3.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">221</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt III Atr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">followed by III Atr.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_4-3.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">220</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. aus</hi> forsette <hi rend="italic">B</hi></seg><seg type="translation" xml:lang="en" source="#claude">altered from forsette B</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_4-3.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">220</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_4-3.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">220</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgen Französ. Verse, Anfang</hi> 13. <hi rend="italic">Jhs. geschrieben B</hi></seg><seg type="translation" xml:lang="en" source="#claude">followed by French verses written in the early 13th cent. B</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IAtr_4-3.lnote.de.0" n="0" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">148</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Ungehorsam 6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Ungehorsam 6</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IAtr_4-3.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">313</biblScope></bibl><seg type="original" xml:lang="en">Cf. IV As. 7.</seg></note>
      </div>
    </body>
