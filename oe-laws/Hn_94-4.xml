      <div type="clause" n="94.4">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 94.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 94.4" corresp="#wit-lat"><pb n="611" ed="#liebermann"/>Si<ptr type="liebermannNote" n="28" target="#Hn_94-4.lnote.oe.28"/> quis aliquem per capillos arripiat, tantum emendet quantum<ptr type="liebermannNote" n="29" target="#Hn_94-4.lnote.oe.29"/> de uno<ptr type="liebermannNote" n="m" target="#Hn_94-4.lnote.oe.m"/> colpo faceret, id est V den.: de hergripa<ptr type="liebermannNote" n="n" target="#Hn_94-4.lnote.oe.n"/><ptr type="liebermannNote" n="30" target="#Hn_94-4.lnote.oe.30"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 611 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-4.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 94, 1</seg><seg type="translation" xml:lang="en" source="#claude">as in 94, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-4.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">nämlich wegen Haargriffes; <hi rend="italic">vgl. Abt.</hi> 33; <hi rend="italic">das Compositum ist im Dänischen Recht, nicht in England belegt</hi></seg><seg type="translation" xml:lang="en" source="#claude">namely for seizing by the hair; cf. Abt. 33; the compound is attested in Danish law, not in England</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-4.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">Si q. a. <hi rend="italic">doppelt Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">Si q. a. twice Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-4.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">quam <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">quam Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-4.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">hereg. <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">hereg. K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-4.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Haar 3—<hi rend="italic">heregripe</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Haar 3—<hi rend="italic">heregripe</hi> Rs</seg></note>
