      <div type="clause" n="87.6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 87.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 87.6" corresp="#wit-lat"><pb n="602" ed="#liebermann"/>Si quis autem iudicio ferri calidi uel bello uel testibus legittimis uel consacramentalibus<ptr type="liebermannNote" n="1" target="#Hn_87-6.lnote.oe.1"/> adhibitis<ptr type="liebermannNote" n="2" target="#Hn_87-6.lnote.oe.2"/> uel idoneo legis<ptr type="liebermannNote" n="a" target="#Hn_87-6.lnote.oe.a"/> examine monstrare possit, quod<ptr type="liebermannNote" n="b" target="#Hn_87-6.lnote.oe.b"/> assalliatus<ptr type="liebermannNote" n="3" target="#Hn_87-6.lnote.oe.3"/> fuerit, quod coactus<ptr type="liebermannNote" n="c" target="#Hn_87-6.lnote.oe.c"/> et se defendente fecerit homicidium, dignis satisfaccionibus<ptr type="liebermannNote" n="a" target="#Hn_87-6.lnote.oe.a"/> hoc monstrare liceat; et rectum inde sit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 602 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-6.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">Beweismittel</seg><seg type="translation" xml:lang="en" source="#claude">means of proof</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-6.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 80, 7<hi rend="italic">b</hi>. 83, 1. 88, 4; 19</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 80, 7<hi rend="italic">b</hi>. 83, 1. 88, 4; 19</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-6.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Nach</hi> 80, 7<hi rend="italic">b büsst aber der Todtschläger, obwohl in Nothwehr, dem Ortsgerichtsherrn den verletzten Frieden</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">According to</hi> 80, 7<hi rend="italic">b, however, the slayer, even though acting in self-defence, pays compensation to the lord of the local court for the breach of the peace</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-6.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">-sec. <hi rend="italic">Sc;</hi> sacr. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sec. Sc; sacr. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-6.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">adi. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">adi. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-6.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">-ailli. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ailli. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-6.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Beweismittel 1; Notwehr 8. a; Zweikampf 10</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Beweismittel 1; Notwehr 8. a; Zweikampf 10</seg></note>
