    <body>
      <div type="clause" n="22.1">
        <head><ref type="lawCode" target="law:IIAs">II As</ref> 22.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.1" corresp="#wit-h"><pb n="162" ed="#liebermann"/>Gif hit hwa dó, agife þone mon<ptr type="liebermannNote" n="4" target="#IIAs_22-1.lnote.oe.4"/> ⁊ bete cynges<ptr type="liebermannNote" n="8" target="#IIAs_22-1.lnote.oe.8"/> oferhyrnesse.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.1" corresp="#wit-ld"><pb n="162" ed="#liebermann"/>Gif hit hwa dó, agyfe he ðone man ⁊ bete ðæs cynges oferhyrnysse.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.1" corresp="#wit-ot"><pb n="162" ed="#liebermann"/>Gif hit hwa . . ., . . man ⁊ bete þæs cinges oferhernesse.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="22.1" corresp="#wit-q"><pb n="163" ed="#liebermann"/>Si quis hoc faciat, reddat ipsum hominem et regis overhyrnissam.<ptr type="liebermannNote" n="15" target="#IIAs_22-1.lnote.oe.15"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="22.1" corresp="#wit-h"><pb n="138" ed="#attenborough"/>Gif hit hwa dó, agife þone<ptr type="editorNote" n="14" target="#IIAs_22-1.attnote.fn.14"/> mon ⁊ bete [ðæs] cynges<ptr type="editorNote" n="15" target="#IIAs_22-1.attnote.fn.15"/> oferhyrnesse.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="163" ed="#liebermann"/>Wenn es einer thut, gebe er den Mann zurück<ptr type="liebermannNote" n="1" target="#IIAs_22-1.lnote.de.1"/> und büsse ‘Ungehorsam’ gegen den König.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If anyone does it, let him give the man back and pay [the fine for] ‘disobedience’ to the king.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="139" ed="#attenborough"/>If anyone does so, he shall give up the man and pay as compensation the sum due to the king for insubordination<ptr type="editorNote" n="1" target="#IIAs_22-1.attnote.n.1"/>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="422" ed="#whitelock"/>If anyone does so, he is to give back the man and pay the fine for disobedience to the king.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VAs_1">V As 1</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">162</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">162</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">163</biblScope></bibl><seg type="original" xml:lang="de">-her- <hi rend="italic">KM</hi></seg><seg type="translation" xml:lang="en" source="#claude">-her- KM</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_22-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">106</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Gefolge 8 d</seg><seg type="translation" xml:lang="en" source="#claude">See <hi rend="italic">Gl</hi> Gefolge 8 d</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIAs_22-1.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">208</biblScope></bibl><seg type="original" xml:lang="en">See note to cap. 20, above.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_22-1.attnote.fn.14" n="14" source="#attenborough"><bibl><biblScope unit="page">138</biblScope></bibl><label>þone</label><seg type="original" xml:lang="en"><hi rend="italic">he ðone</hi>. Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_22-1.attnote.fn.15" n="15" source="#attenborough"><bibl><biblScope unit="page">138</biblScope></bibl><label>cynges</label><seg type="original" xml:lang="en"><hi rend="italic">ðæs cynges</hi>. Ld, Ot.</seg></note>
      </div>
