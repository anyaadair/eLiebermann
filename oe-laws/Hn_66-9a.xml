      <div type="clause" n="66.9a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 66.9a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 66.9a" corresp="#wit-lat"><pb n="586" ed="#liebermann"/>Tunc oportet, ut die congruo XXX<ptr type="liebermannNote" n="h" target="#Hn_66-9a.lnote.oe.h"/> consacramentales<ptr type="liebermannNote" n="12" target="#Hn_66-9a.lnote.oe.12"/> habeat, quorum nullus in aliquo reculpandus sit; et cum XV ex eis, quos iusticia<ptr type="liebermannNote" n="i" target="#Hn_66-9a.lnote.oe.i"/> selegerit<ptr type="liebermannNote" n="13" target="#Hn_66-9a.lnote.oe.13"/>, sextus decimus iuret, sicut causa<ptr type="liebermannNote" n="14" target="#Hn_66-9a.lnote.oe.14"/> dictabit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 586 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-9a.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hohe Helferzahl scheint Nordisch Steenstrup</hi> Danelag 235; <hi rend="italic">allein</hi> Hn <hi rend="italic">meint laut</hi> 66, 8 <hi rend="italic">Wessex; und die Schwörer betragen nur dreifach die Zahl von</hi> 66, 8</seg><seg type="translation" xml:lang="en" source="#claude">the high number of helpers seems Norse, Steenstrup Danelag 235; but Hn, according to 66, 8, means Wessex; and the swearers amount to only three times the number in 66, 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-9a.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">cyreað<hi rend="italic">?</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyreað?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-9a.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">sacr. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">sacr. Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-9a.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">el. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">el. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-9a.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">eam <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">eam Sc Hg</seg></note>
      </div>
