      <div type="clause" n="3">
        <head><ref type="lawCode" target="law:QuadrArg">Quadr Arg</ref> 3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Arg 3" corresp="#wit-lat"><pb n="532" ed="#liebermann"/>Communi denique commodo prouidus et saluti, omnem regnorum<ptr type="liebermannNote" n="k" target="#QuadrArg_3.lnote.oe.k"/> eius sapientiam, meritorum potius quam personarum estimatione, quanta potuit sollicitudine congregare curauit, memorabilem cum eis synodum, in secula successiua<ptr type="liebermannNote" n="13" target="#QuadrArg_3.lnote.oe.13"/> profuturam, Deo grata consideratione diffiniens generaliter ac principaliter in uniuersis, que<ptr type="liebermannNote" n="14" target="#QuadrArg_3.lnote.oe.14"/> ad sanctam matrem nostram ecclesiam pertinere uidebantur, secundo loco de statu et<ptr type="liebermannNote" n="l" target="#QuadrArg_3.lnote.oe.l"/> agendis regni eius, in opprimendis uitiis et augendis uirtutibus, quicquid diligens sapientum indagatio ualuit perscrutari.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 532 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_3.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">532</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">d. h.</hi> [<hi rend="italic">falsch wie u.</hi> 4] <hi rend="italic">nicht bloss Englands</hi></seg><seg type="translation" xml:lang="en" source="#claude">i.e. [wrongly, as below 4] not only of England</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_3.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">532</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">unten</hi> 32 <hi rend="italic">meint Verf. damit</hi> ‘Gerichtsstand(?) und Klagen’</seg><seg type="translation" xml:lang="en" source="#claude">below 32 the author means by this ‘jurisdiction(?) and suits’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_3.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">532</biblScope></bibl><seg type="original" xml:lang="de">-ssura <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ssura Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_3.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">532</biblScope></bibl><seg type="original" xml:lang="de">qui <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_3.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de">Zu Zeile 2 <hi rend="italic">personarum</hi> [wo {a} ausgefallen] <hi rend="italic">vgl</hi>. Ded. 25</seg><seg type="translation" xml:lang="en" source="#claude">On line 2 <hi rend="italic">personarum</hi> [where {a} has dropped out] <hi rend="italic">cf</hi>. Ded. 25</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_3.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. Einl. 2</seg><seg type="translation" xml:lang="en" source="#claude">See above Introduction 2</seg></note>
