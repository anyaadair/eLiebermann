      <div type="clause" n="91.4">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 91.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 91.4" corresp="#wit-lat"><pb n="607" ed="#liebermann"/>Si murdrum in campis<ptr type="liebermannNote" n="h" target="#Hn_91-4.lnote.oe.h"/> patentibus et passim accessibilibus inueniatur, a toto hundreto communiter, non solum ab eo cuius terra est, suppleatur; si in diuisis<ptr type="liebermannNote" n="i" target="#Hn_91-4.lnote.oe.i"/> accidat, utrimque<ptr type="liebermannNote" n="24" target="#Hn_91-4.lnote.oe.24"/> pertranseat<ptr type="liebermannNote" n="k" target="#Hn_91-4.lnote.oe.k"/>; si in uia regia sit, inde componat cui<ptr type="liebermannNote" n="l" target="#Hn_91-4.lnote.oe.l"/> terra adiacebit<ptr type="liebermannNote" n="25" target="#Hn_91-4.lnote.oe.25"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 607 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_91-4.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 92, 8. 9</seg><seg type="translation" xml:lang="en" source="#claude">cf. 92, 8. 9</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_91-4.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de">an der Grenze zweier Territorien; <hi rend="italic">vgl. S.</hi> 608<hi rend="italic">f</hi> inter duas uillas</seg><seg type="translation" xml:lang="en" source="#claude">on the boundary of two territories; cf. p. 608<hi rend="italic">f</hi> inter duas uillas</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_91-4.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de">gehe [<hi rend="italic">die Pflicht</hi>] auf beide [<hi rend="italic">Territorien</hi>] über; <hi rend="italic">vgl.</hi> 92, 17</seg><seg type="translation" xml:lang="en" source="#claude">let [the duty] pass to both [territories]; cf. 92, 17</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_91-4.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verstehe</hi> cuius</seg><seg type="translation" xml:lang="en" source="#claude">understand cuius</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_91-4.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de">-rumque <hi rend="italic">Lond Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rumque Lond edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_91-4.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de">-bat <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-bat Co Or</seg></note>
      </div>
