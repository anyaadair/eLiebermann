        <note type="liebermannNote" subtype="textual" xml:id="ICn_16-1.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">297</biblScope></bibl><seg type="original" xml:lang="de">enim <hi rend="italic">fügt zu T Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">enim added by T Hk</seg></note>
