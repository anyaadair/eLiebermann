  <text>
    <body>
      <div type="clause" n="3.1">
        <head><ref type="lawCode" target="law:Duns">Duns</ref> 3.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.1" corresp="#wit-b"><pb n="376" ed="#liebermann"/>Sceal syððan nede riht<ptr type="liebermannNote" n="4" target="#Duns_3-1.lnote.oe.4"/> wyrcean se ðe ær nolde.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3.1" corresp="#wit-q"><pb n="377" ed="#liebermann"/>Postea<ptr type="liebermannNote" n="7" target="#Duns_3-1.lnote.oe.7"/> uel coactus rectum faciat qui gratis<ptr type="liebermannNote" n="8" target="#Duns_3-1.lnote.oe.8"/> ante noluit.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="377" ed="#liebermann"/>Alsdann soll gezwungen [durch Pfändung] Urtheil erfüllen, wer bisher [freiwillig] nicht gewollt hat.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Then he who previously would not [voluntarily] shall be compelled [by distraint] to do justice.</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-b">They must afterwards of legal necessity do what they earlier would not.</ab>
        <note type="editorial">U: translator unrecorded: check</note>
        <note type="liebermannNote" subtype="textual" xml:id="Duns_3-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">376</biblScope></bibl><seg type="original" xml:lang="de">-te <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-te Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duns_3-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">377</biblScope></bibl><seg type="original" xml:lang="de">Post <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Post Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duns_3-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">377</biblScope></bibl><seg type="original" xml:lang="de">a. g. <hi rend="italic">M Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. g. M Hk</seg></note>
      </div>
