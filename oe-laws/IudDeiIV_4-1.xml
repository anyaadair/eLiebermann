      <div type="clause" n="4.1">
        <head><ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 4.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 4.1" corresp="#wit-du"><pb n="410" ed="#liebermann"/>qui respicis super terram et facis ea[m<ptr type="liebermannNote" n="30" target="#IudDeiIV_4-1.lnote.oe.30"/>] tremere, tu Deus omnipotens, qui per aduentum filii tui, domini nostri Iesu Christi, mundum saluasti et per eius passionem genus humanum redemisti, tu hanc aquam per ignem feruentem sanctifica,</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei IV 4.1" corresp="#wit-gl"><pb n="410" ed="#liebermann"/>ðv ðone<ptr type="liebermannNote" n="28" target="#IudDeiIV_4-1.lnote.oe.28"/> ðv onsiist of<hi rend="italic">er</hi> earðe<ptr type="liebermannNote" n="29" target="#IudDeiIV_4-1.lnote.oe.29"/> ⁊ ðv doest ða fyrhta, ðv God allm<hi rend="italic">æhtig</hi>, ðv ðe ðerh tocyme bearn<hi rend="italic">es</hi> ðines, driht<hi rend="italic">nes</hi> us<hi rend="italic">es</hi> hæl<hi rend="italic">endes<ptr type="liebermannNote" n="31" target="#IudDeiIV_4-1.lnote.oe.31"/></hi> Crist<hi rend="italic">es</hi>, middan<hi rend="italic">geard</hi> gihældest ⁊ ðerh his ðrovnge cynn mennisc'<ptr type="liebermannNote" n="32" target="#IudDeiIV_4-1.lnote.oe.32"/> eft gilesdest, ðv ðis wæt<hi rend="italic">er</hi> ðerh fyr vallende gihalga,</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">103, 32</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 410 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-1.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> ðe</seg><seg type="translation" xml:lang="en" source="#claude">read ðe</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-1.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Lind.</hi> § 38</seg><seg type="translation" xml:lang="en" source="#claude">cf. Lind. § 38</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-1.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">ea <hi rend="italic">Du</hi></seg><seg type="translation" xml:lang="en" source="#claude">ea Du</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-1.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. o.</hi> 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. above 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-1.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">mennisc cynn <hi rend="italic">p.</hi> 93 <hi rend="italic">ed. Stev.</hi></seg><seg type="translation" xml:lang="en" source="#claude">mennisc cynn p. 93 ed. Stev.</seg></note>
      </div>
