        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-2.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch</hi> 35, 2. 79, 4; <hi rend="italic">vgl. I Cn.</hi> 3, 2</seg><seg type="translation" xml:lang="en" source="#claude">also 35, 2. 79, 4; cf. I Cn. 3, 2</seg></note>
