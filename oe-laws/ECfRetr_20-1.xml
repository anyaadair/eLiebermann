    <body>
      <div type="clause" n="20.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 20.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 20.1"><pb n="645" ed="#liebermann"/><hi rend="bold">Hec securitas hoc modo fiebat: scilicet</hi><ptr type="liebermannNote" n="24" target="#ECfRetr_20-1.lnote.la.24"/> quod<ptr type="liebermannNote" n="25" target="#ECfRetr_20-1.lnote.la.25"/> de omnibus uillis totius regni sub decennali fideiussione debebant<ptr type="liebermannNote" n="26" target="#ECfRetr_20-1.lnote.la.26"/> esse <hi rend="bold">uniuersi,</hi> ita quod, si unus ex<ptr type="liebermannNote" n="27" target="#ECfRetr_20-1.lnote.la.27"/> decem forisfaceret<ptr type="liebermannNote" n="28" target="#ECfRetr_20-1.lnote.la.28"/>, nouem<ptr type="liebermannNote" n="29" target="#ECfRetr_20-1.lnote.la.29"/> ad rectitudinem<ptr type="liebermannNote" n="30" target="#ECfRetr_20-1.lnote.la.30"/> eum<ptr type="liebermannNote" n="31" target="#ECfRetr_20-1.lnote.la.31"/> haberent.</ab>
        <note type="comparison" source="#liebermann" n="645"><label>printed alongside</label> <ref target="clause:ECf_20-1">ECf 20.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 645 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-1.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">secundum <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">secundum Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-1.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lb Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lb Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-1.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">debeant <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">debeant Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-1.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">de <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">de Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-1.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">-fecerit <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-fecerit Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-1.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">ad r. n. h. decimum <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad r. n. h. decimum Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-1.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">rectum <hi rend="italic">K</hi> [<hi rend="italic">besser</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">rectum K [better]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-1.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">h. e. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. e. Cb</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">This security was made in this way: namely, that from all the vills of the whole kingdom all ought to be under a tenfold suretyship, so that, if one of the ten committed an offence, the nine should have him to right.</ab>
      </div>
    </body>
