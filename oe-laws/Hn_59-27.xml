        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-27.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de">quaque <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">quaque <hi rend="italic">K Co</hi></seg></note>
