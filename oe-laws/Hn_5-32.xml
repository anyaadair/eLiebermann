      <div type="clause" n="5.32">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.32</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.32" corresp="#wit-lat"><pb n="551–552" ed="#liebermann"/>Si<ptr type="liebermannNote" n="w" target="#Hn_5-32.lnote.oe.w"/> quis iurat falsum, te sciente, si te non audierit — utrum sit prodendus<ptr type="liebermannNote" n="45" target="#Hn_5-32.lnote.oe.45"/>, si proditus et periculum mortis incurrat? Difficillima<ptr type="liebermannNote" n="1" target="#Hn_5-32.lnote.oe.1"/> questio est, cui plus noceat: illi cui iuratur an sacerdoti? Mihi uidetur, quod illi<ptr type="liebermannNote" n="2" target="#Hn_5-32.lnote.oe.2"/>, cui magis prodesse<ptr type="liebermannNote" n="3" target="#Hn_5-32.lnote.oe.3"/> potest<ptr type="liebermannNote" n="4" target="#Hn_5-32.lnote.oe.4"/> uel obesse.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 551–552 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-32.lnote.oe.w" n="w" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch Ivo</hi> Decr. XII 29; <hi rend="italic">Gr.</hi> C. 22 q. 5 c. 8. <hi rend="italic">Verf. ändert Interpunction und Sinn</hi></seg><seg type="translation" xml:lang="en" source="#claude">also Ivo Decr. XII 29; Gr. C. 22 q. 5 c. 8. The author alters the punctuation and the sense</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-32.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">procedendus <hi rend="italic">Sc Hg;</hi> prohibendus <hi rend="italic">Ivo</hi></seg><seg type="translation" xml:lang="en" source="#claude">procedendus Sc Hg; prohibendus Ivo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-32.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">-cilima <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cilima Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-32.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Co;</hi> ille <hi rend="italic">übr.;</hi> talibus qui <hi rend="italic">Aug.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Co; ille the rest; talibus qui Aug.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-32.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. vom Corr. aus</hi> prodest uel obest <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">altered by the corrector from prodest uel obest Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-32.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc</seg></note>
      </div>
