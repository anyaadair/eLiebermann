  <text>
    <body>
      <div type="clause" n="6">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 6"><pb n="631" ed="#liebermann"/><hi rend="spaced">De<ptr type="liebermannNote" n="5" target="#ECf_6.lnote.la.5"/> fractione pacis ecclesie.</hi> Si<ptr type="liebermannNote" n="6" target="#ECf_6.lnote.la.6"/> quis sancte<ptr type="liebermannNote" n="7" target="#ECf_6.lnote.la.7"/> ecclesie pacem<ptr type="liebermannNote" n="b" target="#ECf_6.lnote.la.fn.b"/><ptr type="liebermannNote" n="b" target="#ECf_6.lnote.oe.erkl-b"/> fregerit, episcoporum<ptr type="liebermannNote" n="8" target="#ECf_6.lnote.la.8"/> est iusticia<ptr type="liebermannNote" n="c" target="#ECf_6.lnote.la.fn.c"/>.</ab>
        <note type="comparison" source="#liebermann" n="631"><label>printed alongside</label> <ref target="clause:ECfRetr_6">ECf retr 6</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 631 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht allein Einbruch oder Gewaltthat in Kirchen</hi> (<hi rend="italic">so wohl Retr.</hi>), <hi rend="italic">sondern allgemein Verletzung des</hi> ciricgrið; <hi rend="italic">vgl. Kemble</hi> Saxons II 398</seg><seg type="translation" xml:lang="en" source="#claude">not only breaking into churches or violence in them (so probably the Retractator), but any breach of the ciricgrið; cf. Kemble, Saxons II 398</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 2, 9</seg><seg type="translation" xml:lang="en" source="#claude">cf. 2, 9</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rubr. fehlt Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">the rubric is lacking in Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">Et si <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et si Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">p. s. e. <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. s. e. Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">ipsi tamen <hi rend="italic">Do;</hi> episcopi tantum <hi rend="italic">S Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">ipsi tamen Do; episcopi tantum S Ad</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Of breach of the Church's peace. If anyone breaks the peace of holy Church, justice belongs to the bishops.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_6.lnote.oe.erkl-b" n="b" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">344</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Mitgemeint ist auch die Treuga Dei; <hi rend="italic">vgl. Gl</hi> Geistliches Gericht 27.</seg><seg type="translation" xml:lang="en" source="#claude">The Truce of God is also meant; cf. Gl Geistliches Gericht 27.</seg></note>
      </div>
    </body>
