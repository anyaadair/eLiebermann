    <body>
      <div type="clause" n="18.2">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 18.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 18.2"><pb n="644" ed="#liebermann"/>Murdritor<ptr type="liebermannNote" n="8" target="#ECf_18-2.lnote.la.8"/> autem uel traditor<ptr type="liebermannNote" n="b" target="#ECf_18-2.lnote.la.fn.b"/>, si rex condonauerit eis uitam et<ptr type="liebermannNote" n="9" target="#ECf_18-2.lnote.la.9"/> membra, seruata<ptr type="liebermannNote" n="c" target="#ECf_18-2.lnote.la.fn.c"/> lege<ptr type="liebermannNote" n="10" target="#ECf_18-2.lnote.la.10"/> nullo<ptr type="liebermannNote" n="d" target="#ECf_18-2.lnote.la.fn.d"/> modo remanebunt<ptr type="liebermannNote" n="11" target="#ECf_18-2.lnote.la.11"/> in patria, sed iurabunt se ituros<ptr type="liebermannNote" n="e" target="#ECf_18-2.lnote.la.fn.e"/> ad mare<ptr type="liebermannNote" n="12" target="#ECf_18-2.lnote.la.12"/>, ad terminum quem iusticia<ptr type="liebermannNote" n="f" target="#ECf_18-2.lnote.la.fn.f"/><ptr type="liebermannNote" n="13" target="#ECf_18-2.lnote.la.13"/> eis<ptr type="liebermannNote" n="14" target="#ECf_18-2.lnote.la.14"/> constituerit<ptr type="liebermannNote" n="15" target="#ECf_18-2.lnote.la.15"/>, et<ptr type="liebermannNote" n="16" target="#ECf_18-2.lnote.la.16"/> se transituros, quam<ptr type="liebermannNote" n="e" target="#ECf_18-2.lnote.la.fn.e"/> citius potuerint<ptr type="liebermannNote" n="17" target="#ECf_18-2.lnote.la.17"/> habere nauem et uentum.</ab>
        <note type="comparison" source="#liebermann" n="644"><label>printed alongside</label> <ref target="clause:ECfRetr_18-2">ECf retr 18.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 644 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “terminum” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-2.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">schwerste Verbrecher auch nach</hi> Hn 71, 1. 75, 1</seg><seg type="translation" xml:lang="en" source="#claude">the gravest criminals, also according to Hn 71, 1. 75, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-2.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">‘<hi rend="italic">nach strengem Recht</hi>’: <hi rend="italic">wenn ihnen nicht der König die Abschwörung erlässt. Anders meint Schreuer</hi> Verbrechenskonkurrenz 169 <hi rend="italic">aus Fränkischen Quellen:</hi> gegen Busszahlung</seg><seg type="translation" xml:lang="en" source="#claude">‘according to strict law’: unless the king remits the abjuration for them. Schreuer, Verbrechenskonkurrenz 169, takes it otherwise, from Frankish sources: against payment of compensation</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-2.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 5, 3. 18b</seg><seg type="translation" xml:lang="en" source="#claude">cf. 5, 3. 18b</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-2.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wörtlicher Anklang an die Formel der Abschwörung</hi></seg><seg type="translation" xml:lang="en" source="#claude">a verbal echo of the formula of abjuration</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-2.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">der königliche Richter, zunächst der Sheriff</hi></seg><seg type="translation" xml:lang="en" source="#claude">the royal judge, first of all the sheriff</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-2.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">Si autem rex murdratori uel traditori cond. ui. <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Si autem rex murdratori uel traditori cond. ui. Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-2.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-2.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">ipsi <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">ipsi Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-2.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">man. <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">man. Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-2.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad Do add et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-2.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">eis iu. <hi rend="italic">Hr;</hi> -cie <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">eis iu. Hr; -cie Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-2.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt S Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in S Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-2.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">statuerint <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">statuerint Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-2.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_18-2.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">-runt <hi rend="italic">Rl;</hi> poterunt <hi rend="italic">S Hr;</hi> h. poterunt <hi rend="italic">Ad Do;</hi> nau. et u. h. p. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-runt Rl; poterunt S Hr; h. poterunt Ad Do; nau. et u. h. p. Hk</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But a murderer or traitor, if the king has granted them life and limb, shall, the law being kept, by no means remain in the country, but shall swear that they will go to the sea, by the term which the justice sets them, and that they will cross over as soon as they can have a ship and wind.</ab>
      </div>
    </body>
  </text>
