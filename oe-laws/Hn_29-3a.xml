      <div type="clause" n="29.3a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 29.3a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 29.3a" corresp="#wit-lat"><pb n="563" ed="#liebermann"/>Si de nominatis (placitis<ptr type="liebermannNote" n="35" target="#Hn_29-3a.lnote.oe.35"/>) terminum<ptr type="liebermannNote" n="36" target="#Hn_29-3a.lnote.oe.36"/> susceperat — nisi competens soinus<ptr type="liebermannNote" n="37" target="#Hn_29-3a.lnote.oe.37"/> eum detineat —, si non uenerit, omnium<ptr type="liebermannNote" n="o" target="#Hn_29-3a.lnote.oe.o"/> reus sit de quibus placitum nominatum suscepit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 563 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-3a.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 50, 1. 53, 1<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 50, 1. 53, 1<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-3a.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vom Corr. übergeschr. Sc;</hi> t. p. <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above by the corrector Sc; t. p. Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-3a.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">ū <hi rend="italic">fügt übergeschrieben als Endung ein Corr. Sc, was Edd.</hi> [<hi rend="italic">falsch laut</hi> 53, 1<hi rend="italic">a</hi>] non <hi rend="italic">lesen</hi></seg><seg type="translation" xml:lang="en" source="#claude">ū inserted above the line as an ending by a corrector Sc, which edd. [wrongly, according to 53, 1<hi rend="italic">a</hi>] read as non</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_29-3a.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">563</biblScope></bibl><seg type="original" xml:lang="de">essonius <hi rend="italic">K Co Or,</hi> essoinus <hi rend="italic">Gi Sl Tw</hi></seg><seg type="translation" xml:lang="en" source="#claude">essonius K Co Or, essoinus Gi Sl Tw</seg></note>
      </div>
