        <note type="liebermannNote" subtype="textual" xml:id="Af_27.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Ld;</hi> þryddan <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Ld; þryddan So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27.lnote.oe.dagger" n="†" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">⁊ ð. d. ða g., f. ð. d. <hi rend="italic">überspringt E; ergänzt aus So</hi></seg><seg type="translation" xml:lang="en" source="#claude">⁊ ð. d. ða g., f. ð. d. omitted by E; supplied from So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">ðam <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðam Ld</seg></note>
