    <body>
      <div type="clause" n="14">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 14</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="14" corresp="#wit-g-a"><pb n="318" ed="#liebermann"/>And on<ptr type="liebermannNote" n="1" target="#IICn_14.lnote.oe.1-2"/> Myrcean he<ptr type="liebermannNote" n="2" target="#IICn_14.lnote.oe.2"/> ah, eallswa<ptr type="liebermannNote" n="3" target="#IICn_14.lnote.oe.3"/> her beforan awriten<ptr type="liebermannNote" n="4" target="#IICn_14.lnote.oe.4"/> is, ofer eall<ptr type="liebermannNote" n="5" target="#IICn_14.lnote.oe.5"/> men.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="14" corresp="#wit-b"><pb n="318" ed="#liebermann"/>⁊ on Myrcean he ah, ealswa her beforan gewriten is, ofer ealle men.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="14" corresp="#wit-a"><pb n="318" ed="#liebermann"/>An on Myrcean he ah, ealswa her beforan gewrytan is, ofer ealle men.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="14" corresp="#wit-inst-cn"><pb n="319" ed="#liebermann"/>In lege Mercia rex habet easdem consuetudines.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="14" corresp="#wit-cons-cn"><pb n="319" ed="#liebermann"/>Et in lege Merce habet super omnes homines, ut prescriptum est.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="14" corresp="#wit-b"><pb n="180" ed="#robertson"/>⁊ on Myrcean he ah, ealswa her beforan gewriten is, ofer ealle men.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="260" ed="#rabin-doml"/>And on Myrcean he ah eallswa her beforan awriten is ofer eall men.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="318" ed="#liebermann"/>Und in Mercien hat er [der König] über alle<ptr type="liebermannNote" n="1" target="#IICn_14.lnote.de.1"/> Leute [Rechte], wie hier zuvor (auf- <hi rend="italic">G</hi>)geschrieben steht.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And in Mercia he [the king] has [the rights] over all men, as is written above.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="181" ed="#robertson"/>And in Mercia he is entitled to all the dues described above, from all men.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="463" ed="#whitelock"/>And in Mercia he possesses just what is written here above, over all men.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="261" ed="#rabin-doml"/>And in Mercia the king is entitled to everything listed here from all the people.</ab>
        <note type="comparison" source="#liebermann" n="318"><ref target="clause:IICn_12">II Cn 12f.</ref></note>
        <note type="comparisonPrinted" source="#liebermann">*Vgl. 12 f.</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_2">Leis Wl 2</ref></note>
        <note type="editorial">14 is missing from Quadripartitus (drawn forward into 12). Liebermann compares II Cn 12 f.; BR: added from Gesetze I p. 319, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_14.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">319</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">C.</hi> 14—15, 1<hi rend="italic">a fehlen Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">C. 14—15, 1a lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_14.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_14.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de">he ah <hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">he ah lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_14.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de">eals. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">eals. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_14.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de">gewrytan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gewrytan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_14.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de">ealle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ealle Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_14.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">204</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Partikularrecht 8. a.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Partikularrecht 8. a.</seg></note>
      </div>
