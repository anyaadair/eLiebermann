      <div type="clause" n="12">
        <head><ref type="lawCode" target="law:PsCnFor">Ps Cn for</ref> 12</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Ps Cn for 12" corresp="#wit-ho-st-cii"><pb n="622" ed="#liebermann"/>Liberalis autem homo, id<ptr type="liebermannNote" n="18" target="#PsCnFor_12.lnote.la.18"/> est þegen<ptr type="liebermannNote" n="22" target="#PsCnFor_12.lnote.la.22"/>, modo crimen suum non sit inter maiora<ptr type="liebermannNote" n="23" target="#PsCnFor_12.lnote.la.23"/>, habeat fidelem hominem qui possit pro eo iurare iuramentum<ptr type="liebermannNote" n="r" target="#PsCnFor_12.lnote.la.fn.r"/>, id est forathe<ptr type="liebermannNote" n="n" target="#PsCnFor_12.lnote.la.fn.n"/>; si autem<ptr type="liebermannNote" n="18" target="#PsCnFor_12.lnote.la.18"/> non habet, ipsemet<ptr type="liebermannNote" n="24" target="#PsCnFor_12.lnote.la.24"/> iuret; nec perdonetur<ptr type="liebermannNote" n="25" target="#PsCnFor_12.lnote.la.25"/> ei aliquod iuramentum<ptr type="liebermannNote" n="r" target="#PsCnFor_12.lnote.la.fn.r"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 622 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-ho-st-cii">But a noble man, that is a <hi rend="italic">þegen</hi>, provided his crime is not among the greater ones, may have a faithful man who can swear the oath for him, that is the <hi rend="italic">forathe</hi> (fore-oath); but if he has none, let him swear himself; and no oath shall be remitted to him.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_12.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">622</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_12.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">622</biblScope></bibl><seg type="original" xml:lang="de">pegen <hi rend="italic">Cii Ho</hi></seg><seg type="translation" xml:lang="en" source="#claude">pegen Cii Ho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_12.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">622</biblScope></bibl><seg type="original" xml:lang="de">mariora <hi rend="italic">Ho;</hi> within the seas [<hi rend="italic">also aus</hi> maria] <hi rend="italic">Mw</hi></seg><seg type="translation" xml:lang="en" source="#claude">mariora Ho; within the seas [thus from maria] Mw</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_12.lnote.la.fn.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">622</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederum verkennt Verf. Cnuts klägerischen Voreid als Reinigung des Beklagten</hi></seg><seg type="translation" xml:lang="en" source="#claude">Again the author mistakes Cnut's plaintiff's fore-oath for the defendant's exculpation</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_12.lnote.la.fn.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">622</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur in Hs.</hi> H <hi rend="italic">der</hi> Inst. Cnuti</seg><seg type="translation" xml:lang="en" source="#claude">only in MS H of the Inst. Cnuti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_12.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">622</biblScope></bibl><seg type="original" xml:lang="de">ipsimet <hi rend="italic">Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">ipsimet Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_12.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">622</biblScope></bibl><seg type="original" xml:lang="de">pard. <hi rend="italic">Ho</hi></seg><seg type="translation" xml:lang="en" source="#claude">pard. Ho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_12.lnote.oe.erkl-n" n="n" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">338</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">for-</hi> missverstanden als <hi rend="italic">pro eo</hi>: ‘vertretend’</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">for-</hi> misunderstood as <hi rend="italic">pro eo</hi>: ‘representing (him)’</seg></note>
      </div>
    </body>
