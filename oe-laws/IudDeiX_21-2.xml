      <div type="clause" n="21.2">
        <head><ref type="lawCode" target="law:IudDeiX">Iud Dei X</ref> 21.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei X 21.2" corresp="#wit-lat"><pb n="418" ed="#liebermann"/>Deinde uero corda quadam<ptr type="liebermannNote" n="34" target="#IudDeiX_21-2.lnote.oe.34"/>, quae eum tenere queat<ptr type="liebermannNote" n="35" target="#IudDeiX_21-2.lnote.oe.35"/>, circa lumbos<ptr type="liebermannNote" n="g" target="#IudDeiX_21-2.lnote.oe.g"/> alligetur; atque in corda ad longitudinem<ptr type="liebermannNote" n="36" target="#IudDeiX_21-2.lnote.oe.36"/> longioris<ptr type="liebermannNote" n="g" target="#IudDeiX_21-2.lnote.oe.g"/> capilli fiat nodus<ptr type="liebermannNote" n="h" target="#IudDeiX_21-2.lnote.oe.h"/>; et sic in aquam suauiter, ne aqua<ptr type="liebermannNote" n="37" target="#IudDeiX_21-2.lnote.oe.37"/> commoueat<ptr type="liebermannNote" n="g" target="#IudDeiX_21-2.lnote.oe.g"/> se, demittatur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 418 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_21-2.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Eigenthümlich.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Peculiar to this text.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_21-2.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Statt des Knotens zeigt einen Querstab die Kette bei Zeu., etwa</hi> 1½ <hi rend="italic">Armlängen über dem Halse, vgl.</hi> II As. 23, 1.</seg><seg type="translation" xml:lang="en" source="#claude">Instead of the knot, the chain in Zeu. shows a crossbar, roughly 1½ arm’s lengths above the neck; cf. II As. 23, 1.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_21-2.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de">quedam <hi rend="italic">Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">quedam Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_21-2.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de">c. l. q. <hi rend="italic">Bc</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. l. q. Bc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_21-2.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de">larg. <hi rend="italic">Al</hi></seg><seg type="translation" xml:lang="en" source="#claude">larg. Al</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_21-2.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de">aquam c. <hi rend="italic">ohne</hi> se <hi rend="italic">Al</hi></seg><seg type="translation" xml:lang="en" source="#claude">aquam c. without se Al</seg></note>
      </div>
