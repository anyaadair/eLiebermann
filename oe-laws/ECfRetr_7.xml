    <body>
      <div type="clause" n="7">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 7"><pb n="631" ed="#liebermann"/><hi rend="spaced">De decimis ecclesie<ptr type="liebermannNote" n="32" target="#ECfRetr_7.lnote.la.32"/> reddendis<ptr type="liebermannNote" n="33" target="#ECfRetr_7.lnote.la.33"/>.</hi> De omni annona decima garba <hi rend="bold">Deo debita</hi><ptr type="liebermannNote" n="34" target="#ECfRetr_7.lnote.la.34"/> est <hi rend="bold">et</hi><ptr type="liebermannNote" n="35" target="#ECfRetr_7.lnote.la.35"/> <hi rend="bold">ideo</hi> reddenda<ptr type="liebermannNote" n="36" target="#ECfRetr_7.lnote.la.36"/>.</ab>
        <note type="comparison" source="#liebermann" n="631"><label>printed alongside</label> <ref target="clause:ECf_7">ECf 7</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 631 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Pl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv Lb Va Dc Pl S Sp K Ld;</hi> de ouibus et purcellis <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv Lb Va Dc Pl S Sp K Ld; Lond adds de ouibus et purcellis</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">reddenda <hi rend="italic">Dc;</hi> est reddita <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">reddenda Dc; est reddita Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">et i. r. <hi rend="italic">fehlt Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">et i. r. lacking in Dc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_7.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">631</biblScope></bibl><seg type="original" xml:lang="de">est <hi rend="italic">fügt zu Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ph adds est</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Of tithes to be rendered to the Church. Of all grain the tenth sheaf is owed to God and is therefore to be rendered.</ab>
      </div>
    </body>
  </text>
