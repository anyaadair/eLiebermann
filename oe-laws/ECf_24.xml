      <div type="clause" n="24">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 24</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 24"><pb n="649" ed="#liebermann"/><ptr type="liebermannNote" n="12" target="#ECf_24.lnote.la.12"/>Si aliquis<ptr type="liebermannNote" n="13" target="#ECf_24.lnote.la.13"/> adduxerit aliquid in uillam uel apportauerit<ptr type="liebermannNote" n="14" target="#ECf_24.lnote.la.14"/> animal<ptr type="liebermannNote" n="c" target="#ECf_24.lnote.la.fn.c"/><ptr type="liebermannNote" n="15" target="#ECf_24.lnote.la.15"/> uel pecuniam<ptr type="liebermannNote" n="d" target="#ECf_24.lnote.la.fn.d"/> aliquam et<ptr type="liebermannNote" n="16" target="#ECf_24.lnote.la.16"/> dixerit se inuenisse, antequam introducat illud in domum suam uel alterius, ante ecclesiam ducat et faciat uenire sacerdotem de ecclesia et prefectum de<ptr type="liebermannNote" n="e" target="#ECf_24.lnote.la.fn.e"/> uilla<ptr type="liebermannNote" n="f" target="#ECf_24.lnote.la.fn.f"/>, et<ptr type="liebermannNote" n="17" target="#ECf_24.lnote.la.17"/> de<ptr type="liebermannNote" n="g" target="#ECf_24.lnote.la.fn.g"/> melioribus hominibus de<ptr type="liebermannNote" n="e" target="#ECf_24.lnote.la.fn.e"/> <ptr type="liebermannNote" n="18" target="#ECf_24.lnote.la.18"/>uilla quotquot habere<ptr type="liebermannNote" n="19" target="#ECf_24.lnote.la.19"/> poterit per summonitionem<ptr type="liebermannNote" n="20" target="#ECf_24.lnote.la.20"/> prefecti; et<ptr type="liebermannNote" n="21" target="#ECf_24.lnote.la.21"/> ipsis<ptr type="liebermannNote" n="15" target="#ECf_24.lnote.la.15"/> congregatis, ostendat<ptr type="liebermannNote" n="22" target="#ECf_24.lnote.la.22"/> eis totum inuentum, quicquid sit.</ab>
        <note type="comparison" source="#liebermann" n="649"><label>printed alongside</label> <ref target="clause:ECfRetr_24">ECf retr 24</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 649 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “antequam” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_24.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Leis Wl 6</seg><seg type="translation" xml:lang="en" source="#claude">cf. Leis Wl 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_24.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Fahrhabe ausser</hi> thesaurus <hi rend="italic">o.</hi> 14</seg><seg type="translation" xml:lang="en" source="#claude">movable property other than thesaurus, above 14</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_24.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">diese Gallicismen ersetzen Abschreiber durch Genitive</hi></seg><seg type="translation" xml:lang="en" source="#claude">copyists replace these Gallicisms with genitives</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_24.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">Dorfreeve [<hi rend="italic">schon Domesday</hi> I 57b 1 <hi rend="italic">erwähnt</hi> reveland]; <hi rend="italic">Retr. braucht das im Anglolatein dafür Technische</hi></seg><seg type="translation" xml:lang="en" source="#claude">the village reeve [Domesday I 57b 1 already mentions reveland]; the Retr. uses the technical Anglo-Latin term for it</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_24.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Hn 7, 7b</seg><seg type="translation" xml:lang="en" source="#claude">cf. Hn 7, 7b</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_24.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">De rebus inuentis <hi rend="italic">Hr;</hi> De inuencionibus <hi rend="italic">Pl S;</hi> De inuencione <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">De rebus inuentis Hr; De inuencionibus Pl S; De inuencione Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_24.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">quis al. dux. in <hi rend="italic">Ad Do Wo</hi></seg><seg type="translation" xml:lang="en" source="#claude">quis al. dux. in Ad Do Wo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_24.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk;</hi> asp. <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk; asp. Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_24.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_24.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">antequam—alterius, et dixerit [dicat <hi rend="italic">Ad Do</hi>] se inu., ante ec. <hi rend="italic">Hk Hr S Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">antequam—alterius, et dixerit [dicat Ad Do] se inu., ante ec. Hk Hr S Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_24.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">et—uilla <hi rend="italic">überspringt Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Do skips et—uilla</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_24.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">uille <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">uille Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_24.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_24.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">subm. <hi rend="italic">Rl;</hi> ipsius <hi rend="italic">fügt zu Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">subm. Rl; Ad Do add ipsius</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_24.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk Hr S Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk Hr S Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_24.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">649</biblScope></bibl><seg type="original" xml:lang="de">-derat <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-derat Rl</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">If anyone has brought something into the vill, either led in an animal or carried in any goods, and says that he found it, before he brings it into his own house or another's, let him lead it before the church and have the priest of the church and the reeve of the vill come, and as many of the better men of the vill as he can have by the reeve's summons; and when they are assembled, let him show them the whole find, whatever it may be.</ab>
      </div>
