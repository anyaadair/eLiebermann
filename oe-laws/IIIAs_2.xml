    <body>
      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:IIIAs">III As</ref> 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2" corresp="#wit-q"><pb n="170" ed="#liebermann"/>Secundum est de pace nostra, quod<ptr type="liebermannNote" n="5" target="#IIIAs_2.lnote.oe.5"/> (quam) omnis populus teneri<ptr type="liebermannNote" n="18" target="#IIIAs_2.lnote.oe.18"/> desiderat, sicut apud Greateleyam<ptr type="liebermannNote" n="19" target="#IIIAs_2.lnote.oe.19"/><ptr type="liebermannNote" n="a" target="#IIIAs_2.lnote.oe.a"/> sapientes tui posuerunt, et sicut etiam nunc dictum est in concilio<ptr type="liebermannNote" n="20" target="#IIIAs_2.lnote.oe.20"/> apud Fefresham.<ptr type="liebermannNote" n="21" target="#IIIAs_2.lnote.oe.21"/></ab>
        <ab type="editionText" xml:lang="la" source="#attenborough" n="2" corresp="#wit-q"><pb n="142" ed="#attenborough"/>Secundum est de pace nostra, quam omnis populus teneri desiderat, sicut apud Greateleyam sapientes tui posuerunt, et sicut etiam nunc dictum est in concilio apud Favresham<ptr type="editorNote" n="19" target="#IIIAs_2.attnote.fn.19"/>.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="143" ed="#attenborough"/>The second relates to the measures enacted by your councillors at Grately<ptr type="editorNote" n="1" target="#IIIAs_2.attnote.n.1"/>, and now also proclaimed in the Council at Faversham<ptr type="editorNote" n="2" target="#IIIAs_2.attnote.n.2"/>, for the peace of our land, for the preservation of which the whole people is much concerned.</ab>
        <note type="comparison" source="#liebermann" n="170">II As</note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. II As.</note>
        <note type="editorial">Latin only; no German translation in Liebermann. Liebermann compares II As.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond; (eingeklammertes) übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket Lond; (the bracketed words) the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt T</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">Grat. <hi rend="italic">Lond;</hi> Greatteleiam <hi rend="italic">MT</hi></seg><seg type="translation" xml:lang="en" source="#claude">Grat. Lond; Greatteleiam MT</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de">consil. <hi rend="italic">M</hi></seg><seg type="translation" xml:lang="en" source="#claude">consil. M</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">170</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so TMHkBr;</hi> Faur. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus TMHkBr; Faur. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAs_2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">111</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o.</hi> Pro{g}. Nicht II As 20, 3 besonders ist hiermit zitiert, sondern das ganze Stück II As</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> Pro{g}. What is cited here is not II As 20, 3 in particular, but the whole piece II As</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIAs_2.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">209</biblScope></bibl><seg type="original" xml:lang="en">Grately, Hampshire, S.W. of Andover; cf. also VI As. Preamble, cap. 1 § 4, 12 § 1; III As. cap. 5, 7 § 3; IV As. cap. 2. The references to the Council of Grately (II As.), here and in cap. 5 and 6, appear to be of a general character rather than to specific chapters.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIAs_2.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">209</biblScope></bibl><seg type="original" xml:lang="en">Faversham in Kent; cf. also VI As. cap. 10; III. cap. 2; IV. cap. 1.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIAs_2.attnote.fn.19" n="19" source="#attenborough"><bibl><biblScope unit="page">142</biblScope></bibl><label>Favresham</label><seg type="original" xml:lang="en"><hi rend="italic">Fefresham</hi>. Br, M.</seg></note>
      </div>
    </body>
  </text>
