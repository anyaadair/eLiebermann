      <div type="clause" n="85.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 85.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 85.3" corresp="#wit-lat"><pb n="600" ed="#liebermann"/>Qui ad occidendum aliquem innoxium redbana<ptr type="liebermannNote" n="s" target="#Hn_85-3.lnote.oe.s"/><ptr type="liebermannNote" n="47" target="#Hn_85-3.lnote.oe.47"/> uel dedbana<ptr type="liebermannNote" n="47" target="#Hn_85-3.lnote.oe.47"/> fuerit, conuictus noxe componat inde solus uel<ptr type="liebermannNote" n="48" target="#Hn_85-3.lnote.oe.48"/> cum aliis<ptr type="liebermannNote" n="t" target="#Hn_85-3.lnote.oe.t"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 600 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_85-3.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht aus</hi> dædbana oððe rædbana <hi rend="italic">I Cn.</hi> 5, 2<hi rend="italic">b</hi>. <hi rend="italic">Über Verantwortlichkeit aus Beihilfe im Englischen Recht</hi> 13. <hi rend="italic">Jhs. vgl. Pollock-Maitland</hi> HEL. II 507. 527</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">perhaps from</hi> dædbana oððe rædbana <hi rend="italic">I Cn.</hi> 5, 2<hi rend="italic">b</hi>. <hi rend="italic">On liability for aiding and abetting in English law of the</hi> 13th <hi rend="italic">cent. cf. Pollock-Maitland</hi> HEL. II 507. 527</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_85-3.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 61, 18<hi rend="italic">c?</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 61, 18<hi rend="italic">c?</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_85-3.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">-nna <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nna Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_85-3.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Sc Hg</seg></note>
