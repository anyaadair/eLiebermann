    <body>
      <div type="clause" n="23">
        <head><ref type="lawCode" target="law:QuadrArg">Quadr Arg</ref> 23</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Arg 23" corresp="#wit-lat"><pb n="534" ed="#liebermann"/>Hic<ptr type="liebermannNote" n="12" target="#QuadrArg_23.lnote.oe.12"/> molestias et multiplices potentum<ptr type="liebermannNote" n="x" target="#QuadrArg_23.lnote.oe.x"/> iniurias, famosi quondam senatus<ptr type="liebermannNote" n="y" target="#QuadrArg_23.lnote.oe.y"/> exhibitione, terminamus.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 534 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_23.lnote.oe.x" n="x" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">534</biblScope></bibl><seg type="original" xml:lang="de">‘Kränkungen durch Dynasten sehen wir beendet’; <hi rend="italic">vgl. o. Anm. a. n</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘we see the injuries done by magnates brought to an end’; cf. above note a. n</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_23.lnote.oe.y" n="y" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">534</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">soll Heinrichs I. Reichstag sammt Höchstgericht erscheinen als Fortsetzung des</hi> Witena gemot?</seg><seg type="translation" xml:lang="en" source="#claude">is Henry I’s assembly of the realm, together with the supreme court, meant to appear as a continuation of the Witena gemot?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_23.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">534</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> Nunc? <hi rend="italic">s. jedoch</hi> 28. <hi rend="italic">Hier beginnt wieder Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">read Nunc? but see 28. Hk begins again here</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_23.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">312</biblScope></bibl><seg type="original" xml:lang="de">{y} <hi rend="italic">senatus</hi> für <hi rend="italic">witan s</hi>. zu Duns Pro; <hi rend="italic">vgl</hi>. mein <hi rend="italic">National assembly</hi> p. 9{4}</seg><seg type="translation" xml:lang="en" source="#claude">{y} <hi rend="italic">senatus</hi> for <hi rend="italic">witan</hi>: <hi rend="italic">see</hi> on Duns Pro; <hi rend="italic">cf</hi>. my <hi rend="italic">National assembly</hi> p. 9{4}</seg></note>
      </div>
