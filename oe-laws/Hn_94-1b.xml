      <div type="clause" n="94.1b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 94.1b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 94.1b" corresp="#wit-lat"><pb n="610" ed="#liebermann"/>Set non<ptr type="liebermannNote" n="m" target="#Hn_94-1b.lnote.oe.m"/> simul habenda est blodwita et<ptr type="liebermannNote" n="45" target="#Hn_94-1b.lnote.oe.45"/> fihtwita<ptr type="liebermannNote" n="46" target="#Hn_94-1b.lnote.oe.46"/>, due<ptr type="liebermannNote" n="n" target="#Hn_94-1b.lnote.oe.n"/> scilicet emende de<ptr type="liebermannNote" n="5" target="#Hn_94-1b.lnote.oe.5"/> una culpa.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 610 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-1b.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">610</biblScope></bibl><seg type="original" xml:lang="de">94, 1<hi rend="italic">b gilt nur, falls beide Vasallen Eines Herrn sind; sonst vgl.</hi> 94, 2<hi rend="italic">a; d</hi></seg><seg type="translation" xml:lang="en" source="#claude">94, 1b applies only if both are vassals of one lord; otherwise cf. 94, 2a; d</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-1b.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">610</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 49, 7</seg><seg type="translation" xml:lang="en" source="#claude">cf. 49, 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-1b.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">610</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-1b.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">610</biblScope></bibl><seg type="original" xml:lang="de">et f. <hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">et f. missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-1b.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">610</biblScope></bibl><seg type="original" xml:lang="de">fightwyta <hi rend="italic">K;</hi> fighw. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">fightwyta K; fighw. Co Or</seg></note>
