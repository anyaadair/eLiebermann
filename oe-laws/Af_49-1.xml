      <div type="clause" n="49.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 49.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="49.1" corresp="#wit-e"><pb n="80" ed="#liebermann"/>Gif hit sie<ptr type="liebermannNote" n="16" target="#Af_49-1.lnote.oe.16"/> se wongtoð, geselle<ptr type="liebermannNote" n="17" target="#Af_49-1.lnote.oe.17"/> IIII scill. to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="49.1" corresp="#wit-h"><pb n="80" ed="#liebermann"/>Gif hit sy<ptr type="liebermannNote" n="1" target="#Af_49-1.lnote.oe.1"/> þe<ptr type="liebermannNote" n="6" target="#Af_49-1.lnote.oe.6"/> wongtoþ<ptr type="liebermannNote" n="9" target="#Af_49-1.lnote.oe.9"/>, gebete mid IIII scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="49.1" corresp="#wit-b-no-prol"><pb n="80" ed="#liebermann"/>Gyf hit sy ðe wongtoð, g<hi rend="italic">e</hi>sylle feower scill' to bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="49.1" corresp="#wit-q"><pb n="81" ed="#liebermann"/>Si secundos quos wongtoþ<ptr type="liebermannNote" n="14" target="#Af_49-1.lnote.oe.14"/> (caninos) uocant, quatuor solid. emendabit.<ptr type="liebermannNote" n="15" target="#Af_49-1.lnote.oe.15"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="86" ed="#attenborough"/>Gif hit sie se<ptr type="editorNote" n="13" target="#Af_49-1.attnote.fn.13"/> wongtoð, geselle<ptr type="editorNote" n="14" target="#Af_49-1.attnote.fn.14"/> IIII scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="52.1" corresp="#wit-e"><pb n="352" ed="#jurasinski-and-oliver"/>Gif hit sie se wongtoð, geselle IIII scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="81" ed="#liebermann"/>Wenn es der Backenzahn<ptr type="liebermannNote" n="1" target="#Af_49-1.lnote.de.1"/> ist, gebe<ptr type="liebermannNote" n="2" target="#Af_49-1.lnote.de.2"/> er 4 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If it is the cheek-tooth, let him give 4 shillings as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="87" ed="#attenborough"/>If it is a back tooth<ptr type="editorNote" n="1" target="#Af_49-1.attnote.n.1"/> [that is knocked out], 4 shillings shall be given as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="353" ed="#jurasinski-and-oliver"/>If it is the molar, let him pay 4 shillings as compensation.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_49-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_49-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">gesylle feower <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gesylle feower Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_49-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_49-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_49-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> wang.</seg><seg type="translation" xml:lang="en" source="#claude">altered to wang.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_49-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. nur Co; fehlt übrigen; aber Hn</hi> 93, 7: caninos uel wongtoð</seg><seg type="translation" xml:lang="en" source="#claude">written above only in Co; lacking in the others; but Hn 93, 7: caninos uel wongtoð</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_49-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">-bitur <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-bitur Lond</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_49-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘Eck(Stoss-, Augen)zahn’, wie schon Q Inst. missverstehen (Ælfric glossiert richtig <hi rend="italic">molares: genuini</hi> und <hi rend="italic">tusc: caninus</hi>), vielleicht durch Af’s verkehrte Reihenfolge verführt; <hi rend="italic">s. u.</hi> 49, 2. Doch konnte schon die niedere Busse vor dem Irrtume bewahren: einer der 4 Eckzähne gilt, auch bei Abt, mehr als einer der 20 Backzähne. Über <hi rend="italic">fengtoð</hi> in In Cn¹⁶ <hi rend="italic">s.</hi> Thöne 108</seg><seg type="translation" xml:lang="en" source="#claude">Not ‘corner (thrusting, eye) tooth’, as Q Inst. already misunderstand (Ælfric correctly glosses <hi rend="italic">molares: genuini</hi> and <hi rend="italic">tusc: caninus</hi>), perhaps misled by Af’s wrong order; <hi rend="italic">see below</hi> 49, 2. Yet the lower compensation alone might have guarded against the error: one of the 4 canine teeth is valued, in Abt too, more highly than one of the 20 molars. On <hi rend="italic">fengtoð</hi> in In Cn¹⁶ <hi rend="italic">see</hi> Thöne 108</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_49-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘büsse er mit’ H</seg><seg type="translation" xml:lang="en" source="#claude">‘let him compensate with’ H</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_49-1.attnote.fn.13" n="13" source="#attenborough"><bibl><biblScope unit="page">86</biblScope></bibl><label>se</label><seg type="original" xml:lang="en"><hi rend="italic">þe</hi>. B &amp; H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_49-1.attnote.fn.14" n="14" source="#attenborough"><bibl><biblScope unit="page">86</biblScope></bibl><label>geselle</label><seg type="original" xml:lang="en"><hi rend="italic">gebete mid</hi>. om. <hi rend="italic">to bote</hi>. H.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_49-1.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">199</biblScope></bibl><seg type="original" xml:lang="en">Lit. ‘cheek-tooth.’</seg></note>
      </div>
