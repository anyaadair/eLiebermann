    <body>
      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 5"><pb n="630" ed="#liebermann"/><hi rend="spaced">De reis<ptr type="liebermannNote" n="10" target="#ECf_5.lnote.la.10"/> ad ecclesiam<ptr type="liebermannNote" n="11" target="#ECf_5.lnote.la.11"/> confugientibus<ptr type="liebermannNote" n="12" target="#ECf_5.lnote.la.12"/>.</hi> Quicunque reus uel noxius ad ecclesiam<ptr type="liebermannNote" n="13" target="#ECf_5.lnote.la.13"/> pro presidio confugerit<ptr type="liebermannNote" n="14" target="#ECf_5.lnote.la.14"/>, ex quo atrium<ptr type="liebermannNote" n="15" target="#ECf_5.lnote.la.15"/> ingressus<ptr type="liebermannNote" n="16" target="#ECf_5.lnote.la.16"/> fuerit, securus sit<ptr type="liebermannNote" n="17" target="#ECf_5.lnote.la.17"/> et a nemine insequente ullo<ptr type="liebermannNote" n="18" target="#ECf_5.lnote.la.18"/> modo apprehendatur nisi per pontificem loci illius uel per<ptr type="liebermannNote" n="19" target="#ECf_5.lnote.la.19"/> ministros eius.</ab>
        <note type="comparison" source="#liebermann" n="630"><label>printed alongside</label> <ref target="clause:ECfRetr_5">ECf retr 5</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 630 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “presidio” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">hiis qui ad <hi rend="italic">Cl Pl S;</hi> fugientibus ad e. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">hiis qui ad Cl Pl S; fugientibus ad e. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">pro presidio <hi rend="italic">fügt zu Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">Pl S add pro presidio</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">-gerint <hi rend="italic">Cl Pl;</hi> fugerint <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gerint Cl Pl; fugerint S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">ecclesiasticum <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">ecclesiasticum Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">fug. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">fug. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">illam <hi rend="italic">Ad No</hi></seg><seg type="translation" xml:lang="en" source="#claude">illam Ad No</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">introgr. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">introgr. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">nullo <hi rend="italic">Hk Cl Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">nullo Hk Cl Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr S</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr S</seg></note>
      </div>
