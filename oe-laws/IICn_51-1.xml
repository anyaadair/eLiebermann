  <text>
    <body>
      <div type="clause" n="51.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 51.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="51.1" corresp="#wit-g-a"><ptr type="liebermannNote" n="**" target="#IICn_51-1.lnote.oe.star2"/><pb n="346" ed="#liebermann"/>Ne byð<ptr type="liebermannNote" n="17" target="#IICn_51-1.lnote.oe.17"/> na gelic, þ<hi rend="italic">æt</hi> man wið<ptr type="liebermannNote" n="11" target="#IICn_51-1.lnote.oe.11"/> swustor gehæme ⁊ hit wære feorr<ptr type="liebermannNote" n="18" target="#IICn_51-1.lnote.oe.18"/> sibb.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="51.1" corresp="#wit-b"><pb n="346" ed="#liebermann"/>Ne byð na gelic, þ<hi rend="italic">æt</hi> man wið swustor gehæme ⁊ ðes þe hit bið feor sibbe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="51.1" corresp="#wit-a"><pb n="346" ed="#liebermann"/>Ne bið na gelic, þ<hi rend="italic">æt</hi> man <ptr type="liebermannNote" n="4" target="#IICn_51-1.lnote.oe.4"/>swustor gehame ⁊ hit wære feor sib.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="51.1" corresp="#wit-q"><pb n="347" ed="#liebermann"/>Non<ptr type="liebermannNote" n="13" target="#IICn_51-1.lnote.oe.13"/> est equale, si quis cum sorore<ptr type="liebermannNote" n="14" target="#IICn_51-1.lnote.oe.14"/> sua concumbat<ptr type="liebermannNote" n="15" target="#IICn_51-1.lnote.oe.15"/> et fuerit de longe pertinens.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="51.1" corresp="#wit-cons-cn"><pb n="347" ed="#liebermann"/>[51, 1] Non sunt equipollencia cum sorore concumbere et cum ea que remocior sit cognacione.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="51.1" corresp="#wit-b"><pb n="202" ed="#robertson"/>Ne byð na gelic þæt man wið swustor gehæme ⁊ þes þe<ptr type="editorNote" n="1" target="#IICn_51-1.robnote.fn.1"/> hit bið<ptr type="editorNote" n="2" target="#IICn_51-1.robnote.fn.2"/> feor sibbe.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="282" ed="#rabin-doml"/>Ne byð na gelic, þæt man wið swustor gehæme and hit wære feorr sibb.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="347" ed="#liebermann"/>Es ist nicht gleichgiltig, ob jemand der Schwester<ptr type="liebermannNote" n="1" target="#IICn_51-1.lnote.de.1"/> beiwohne<ptr type="liebermannNote" n="2" target="#IICn_51-1.lnote.de.2"/>, oder es<ptr type="liebermannNote" n="3" target="#IICn_51-1.lnote.de.3"/> eine entfernt<ptr type="liebermannNote" n="4" target="#IICn_51-1.lnote.de.4"/> Verwandte wäre.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">It is not the same whether one lies with a sister or whether it were a distant relative.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="203" ed="#robertson"/>The cases are not alike if incest is committed with a sister or with a distant relation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="470" ed="#whitelock"/>It is by no means on a level whether a man has intercourse with his sister, or with a distant relation.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="283" ed="#rabin-doml"/>Fornication with one’s sister shall not be considered comparable to fornication with a distant relation.</ab>
        <note type="editorial">G places 51.1 before 52.1, one line too low.; BR: added from Gesetze I p. 347, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">and hit: and þes þe hit B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_51-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">347</biblScope></bibl><seg type="original" xml:lang="de">eq. est eq. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">eq. est eq. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_51-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">347</biblScope></bibl><seg type="original" xml:lang="de">uxore <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">uxore K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_51-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">347</biblScope></bibl><seg type="original" xml:lang="de">occu. <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">occu. Dm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_51-1.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">346</biblScope></bibl><seg type="original" xml:lang="de">51, 1 <hi rend="italic">setzt vor</hi> 52, 1, <hi rend="italic">eine Zeile zu tief, G</hi></seg><seg type="translation" xml:lang="en" source="#claude">G places 51, 1 before 52, 1, one line too low</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_51-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">346</biblScope></bibl><seg type="original" xml:lang="de">biþ na gelice <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">biþ na gelice Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_51-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">346</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_51-1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">346</biblScope></bibl><seg type="original" xml:lang="de">feor sibbe <hi rend="italic">Ld; ‘or?</hi> feorsibb’ <hi rend="italic">Toller</hi> 869</seg><seg type="translation" xml:lang="en" source="#claude">feor sibbe Ld; ‘or? feorsibb’ Toller 869</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_51-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">346</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ohne Präposition</hi></seg><seg type="translation" xml:lang="en" source="#claude">without preposition</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_51-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">209</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Zu <hi rend="italic">gehæman</hi>, transitiv in A, <hi rend="italic">vgl. hæmde bioð : nubentur</hi> Matt. 22, 30</seg><seg type="translation" xml:lang="en" source="#claude">On <hi rend="italic">gehæman</hi>, transitive in A, <hi rend="italic">cf. hæmde bioð : nubentur</hi> Matt. 22, 30</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_51-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">209</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Zu <hi rend="italic">gehæman</hi>, transitiv in A, <hi rend="italic">vgl. hæmde bioð : nubentur</hi> Matt. 22, 30</seg><seg type="translation" xml:lang="en" source="#claude">On <hi rend="italic">gehæman</hi>, transitive in A, <hi rend="italic">cf. hæmde bioð : nubentur</hi> Matt. 22, 30</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_51-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">209</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">þes þe</hi> ‘dies, dass’ B, weil er <hi rend="italic">and</hi> ‘mit’ oder die Ellipse des <hi rend="italic">þæt</hi> nicht mehr verstand. Doch kopiert er <hi rend="italic">efen .. and</hi>, nur in <hi rend="italic">ealswa</hi> ändernd, <hi rend="italic">u</hi>. 76, 2⁶ ‘ebenso .. als wenn’</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">þes þe</hi> ‘this, that’ B, because he no longer understood <hi rend="italic">and</hi> ‘with’ or the ellipsis of <hi rend="italic">þæt</hi>. He does, however, copy <hi rend="italic">efen .. and</hi>, altering only to <hi rend="italic">ealswa</hi>, <hi rend="italic">below</hi> 76, 2⁶ ‘just as .. as if’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_51-1.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">209</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Kompositum <hi rend="italic">feorsib</hi> hält für möglich, analog <hi rend="italic">neáhsib</hi>, Toller <hi rend="italic">s. v. sib. Vgl. feorcund, feorbuend</hi></seg><seg type="translation" xml:lang="en" source="#claude">Toller <hi rend="italic">s. v. sib</hi> considers a compound <hi rend="italic">feorsib</hi> possible, on the analogy of <hi rend="italic">neáhsib</hi>. <hi rend="italic">Cf. feorcund, feorbuend</hi></seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_51-1.robnote.fn.1" n="1" source="#robertson"><bibl><biblScope unit="page">202</biblScope></bibl><label>þe</label><seg type="original" xml:lang="en"><hi rend="italic">þ. þ.</hi> om. G, A, Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_51-1.robnote.fn.2" n="2" source="#robertson"><bibl><biblScope unit="page">202</biblScope></bibl><label>bið</label><seg type="original" xml:lang="en"><hi rend="italic">wære</hi> G, A, Ld.</seg></note>
      </div>
