      <div type="clause" n="16.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 16.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 16.2"><pb n="642" ed="#liebermann"/><hi rend="bold">ueruntamen</hi> si quis Anglorum aliquem eorum<ptr type="liebermannNote" n="20" target="#ECfRetr_16-2.lnote.la.20"/> interficeret <hi rend="bold">et</hi> si se <hi rend="bold">super hoc</hi> defendere<ptr type="liebermannNote" n="21" target="#ECfRetr_16-2.lnote.la.21"/> non posset iudicio Dei, <hi rend="bold">scilicet</hi> aqua<ptr type="liebermannNote" n="22" target="#ECfRetr_16-2.lnote.la.22"/> uel ferro, fieret de<ptr type="liebermannNote" n="23" target="#ECfRetr_16-2.lnote.la.23"/> eo iusticia; si autem aufugeret<ptr type="liebermannNote" n="24" target="#ECfRetr_16-2.lnote.la.24"/>, solueretur<ptr type="liebermannNote" n="25" target="#ECfRetr_16-2.lnote.la.25"/>, ut supra dictum est<ptr type="liebermannNote" n="26" target="#ECfRetr_16-2.lnote.la.26"/>.</ab>
        <note type="comparison" source="#liebermann" n="642"><label>printed alongside</label> <ref target="clause:ECf_16-2">ECf 16.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 642 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECfRetr_16-2.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">das Ordal reinigt vom Verdacht des heimlichen Todtschlags</hi> (<hi rend="italic">nicht des offenen zur Abwehr oder Rache, dem Widerrechtlichkeit vorgeworfen</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">the ordeal clears of the suspicion of secret homicide (not of open homicide in self-defence or revenge, of which unlawfulness is alleged)</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECfRetr_16-2.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">murdrum <hi rend="italic">laut</hi> 15, 2</seg><seg type="translation" xml:lang="en" source="#claude">murdrum, according to 15, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16-2.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">illorum <hi rend="italic">Hv Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">illorum Hv Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16-2.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">non defendisset <hi rend="italic">statt</hi> d. n. p. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">non defendisset instead of d. n. p. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16-2.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">aque <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">aque K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16-2.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">ei <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16-2.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">fugeret <hi rend="italic">Hv Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">fugeret Hv Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16-2.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de">-uentur, sicut <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uentur, sicut Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_16-2.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">642</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier endet Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">Kn ends here</seg></note>
      </div>
