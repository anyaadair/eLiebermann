      <div type="clause" n="30.4">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 30.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 30.4"><pb n="653" ed="#liebermann"/><hi rend="bold">Anglice uero</hi><ptr type="liebermannNote" n="4" target="#ECfRetr_30-4.lnote.la.4"/> arma uocantur wepne<ptr type="liebermannNote" n="5" target="#ECfRetr_30-4.lnote.la.5"/> et taccare<ptr type="liebermannNote" n="6" target="#ECfRetr_30-4.lnote.la.6"/>: confirmare<ptr type="liebermannNote" n="7" target="#ECfRetr_30-4.lnote.la.7"/>, <hi rend="bold">quasi armorum confirmacio.</hi></ab>
        <note type="comparison" source="#liebermann" n="653"><label>printed alongside</label> <ref target="clause:ECf_30-4">ECf 30.4</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 653 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-4.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">autem <hi rend="italic">Hv;</hi> enim <hi rend="italic">Cb Lond Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">autem Hv; enim Cb Lond Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-4.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Cb;</hi> -pene <hi rend="italic">K;</hi> wapne <hi rend="italic">Hv;</hi> ƿæpnu <hi rend="italic">Ld</hi> [<hi rend="italic">archaisirend</hi>]; wapen <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Cb; -pene K; wapne Hv; ƿæpnu Ld [archaizing]; wapen the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-4.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">tactare <hi rend="italic">Lb;</hi> tractare <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">tactare Lb; tractare Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-4.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">-ri <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ri Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">For in English arms are called <hi rend="italic">wepne</hi>, and <hi rend="italic">taccare</hi>: to confirm, as it were a confirmation of arms.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_30-4.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">348</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wepene</hi><hi rend="superscript">5</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">wepene</hi><hi rend="superscript">5</hi> Rs</seg></note>
      </div>
    </body>
  </text>
