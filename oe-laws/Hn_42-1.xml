      <div type="clause" n="42.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 42.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 42.1" corresp="#wit-lat"><pb n="568" ed="#liebermann"/>Qui summonicionem regis uel communis<ptr type="liebermannNote" n="o" target="#Hn_42-1.lnote.oe.o"/> domini domino uel cuilibet perferendam susceperit, et dimiserit<ptr type="liebermannNote" n="39" target="#Hn_42-1.lnote.oe.39"/> uel ex industria uel ex inscicia<ptr type="liebermannNote" n="40" target="#Hn_42-1.lnote.oe.40"/>, emendet per iudicium, sicut erit<ptr type="liebermannNote" n="41" target="#Hn_42-1.lnote.oe.41"/>, dampnum uel ouerseunessam<ptr type="liebermannNote" n="p" target="#Hn_42-1.lnote.oe.p"/><ptr type="liebermannNote" n="42" target="#Hn_42-1.lnote.oe.42"/>, si ad id deducatur<ptr type="liebermannNote" n="43" target="#Hn_42-1.lnote.oe.43"/>; et quietus inde sit qui submonebatur<ptr type="liebermannNote" n="44" target="#Hn_42-1.lnote.oe.44"/>, et ite[ru]m<ptr type="liebermannNote" n="45" target="#Hn_42-1.lnote.oe.45"/> ad rectum submoneatur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 568 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-1.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">privaten Herrn sowohl des <hi rend="italic">mit Ladung Beauftragten</hi> wie des <hi rend="italic">Vorzuladenden</hi></seg><seg type="translation" xml:lang="en" source="#claude">private lord both of the person charged with the summons and of the person to be summoned</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-1.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">Ungehorsamsbusse <hi rend="italic">gegen den Gerichtsherrn — König oder Privaten —, dessen Ladung zu bestellen er verabsäumt</hi></seg><seg type="translation" xml:lang="en" source="#claude">fine for disobedience to the lord of the court — king or private lord — whose summons he has failed to deliver</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-1.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">-sit <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sit Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-1.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">inscia <hi rend="italic">K Co Or Sl Tw</hi></seg><seg type="translation" xml:lang="en" source="#claude">inscia K Co Or Sl Tw</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-1.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">erat <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">erat Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-1.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">-ssa <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ssa Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-1.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">redu. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">redu. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-1.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">si mouebatur <hi rend="italic">Co Or; corr. aus</hi> -neatur <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">si mouebatur Co Or; corrected from -neatur Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-1.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">568</biblScope></bibl><seg type="original" xml:lang="de">idem <hi rend="italic">Lond;</hi> item <hi rend="italic">Sc; geb. Thorpe</hi></seg><seg type="translation" xml:lang="en" source="#claude">idem Lond; item Sc; emended by Thorpe</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_42-1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Vorladung 11b. c; Ungehorsam 6; Vertreter 6a; Truchsess 4a—<hi rend="italic">-ssa</hi>{42}—<hi rend="italic">item</hi>{45}—<hi rend="italic">domino</hi>{47}—<hi rend="italic">siue</hi>{52} bis <hi rend="italic">iudicetur</hi> überspr.—42, 3 <hi rend="italic">nu. mi</hi>.{1} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Vorladung 11b. c; Ungehorsam 6; Vertreter 6a; Truchsess 4a—<hi rend="italic">-ssa</hi>{42}—<hi rend="italic">item</hi>{45}—<hi rend="italic">domino</hi>{47}—<hi rend="italic">siue</hi>{52} to <hi rend="italic">iudicetur</hi> omitted—42, 3 <hi rend="italic">nu. mi</hi>.{1} Rs</seg></note>
      </div>
