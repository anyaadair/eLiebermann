      <div type="clause" n="71.1c">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 71.1c</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 71.1c" corresp="#wit-lat"><pb n="590" ed="#liebermann"/>Et si beneficio<ptr type="liebermannNote" n="22" target="#Hn_71-1c.lnote.oe.22"/> legis ad misericordiam uel concordiam pertrahatur<ptr type="liebermannNote" n="23" target="#Hn_71-1c.lnote.oe.23"/>, de wera<ptr type="liebermannNote" n="i" target="#Hn_71-1c.lnote.oe.i"/> mortui plene satisfaciat, et witam<ptr type="liebermannNote" n="24" target="#Hn_71-1c.lnote.oe.24"/> et manbotam<ptr type="liebermannNote" n="24" target="#Hn_71-1c.lnote.oe.24"/>; et omnibus rite paccatis, plegios<ptr type="liebermannNote" n="f" target="#Hn_71-1c.lnote.oe.f"/> legalitatis<ptr type="liebermannNote" n="k" target="#Hn_71-1c.lnote.oe.k"/> deinceps inueniat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 590 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1c.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht theilweise aus II As.</hi> 6; 6, 1</seg><seg type="translation" xml:lang="en" source="#claude">perhaps partly from II As. 6; 6, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1c.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">weregildum <hi rend="italic">Ribuar.</hi> 83, 1</seg><seg type="translation" xml:lang="en" source="#claude">weregildum <hi rend="italic">Ribuar.</hi> 83, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1c.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Bürgen für Wohlverhalten Begnadigter fordert auch</hi> E Cf. 18</seg><seg type="translation" xml:lang="en" source="#claude">Sureties for the good conduct of pardoned persons are also required by E Cf. 18</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1c.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">benediccio <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">benediccio Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1c.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">protr. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">protr. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1c.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">-ta <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ta <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1c.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">326</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Schiedsgericht 9; Bürgschaft 6c—<hi rend="italic">benediccio</hi>{22}—<hi rend="italic">protr</hi>.{23}—<hi rend="italic">wita et manbota</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Schiedsgericht 9; Bürgschaft 6c—<hi rend="italic">benediccio</hi>{22}—<hi rend="italic">protr</hi>.{23}—<hi rend="italic">wita et manbota</hi> Rs</seg></note>
