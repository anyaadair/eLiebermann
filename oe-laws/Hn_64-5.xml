      <div type="clause" n="64.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 64.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 64.5" corresp="#wit-lat"><pb n="584" ed="#liebermann"/>Item si<ptr type="liebermannNote" n="v" target="#Hn_64-5.lnote.oe.v"/> quis sine iudicio occidatur, et parentes eius innoxiare<ptr type="liebermannNote" n="27" target="#Hn_64-5.lnote.oe.27"/> uelint, quod innocens et sine merito<ptr type="liebermannNote" n="28" target="#Hn_64-5.lnote.oe.28"/> sit occisus, predicto modo faciant.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 584 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-5.lnote.oe.v" n="v" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ausführlicher</hi> 74, 1; <hi rend="italic">vgl.</hi> 92, 3<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">in more detail 74, 1; cf. 92, 3<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-5.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">in noxietate <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">in noxietate Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-5.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">suo <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Lond adds suo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-5.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Hingerichtete 3—<hi rend="italic">innoxietate</hi>{27}—<hi rend="italic">m</hi>.{28} <hi rend="italic">suo sit</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Hingerichtete 3—<hi rend="italic">innoxietate</hi>{27}—<hi rend="italic">m</hi>.{28} <hi rend="italic">suo sit</hi> Rs</seg></note>
