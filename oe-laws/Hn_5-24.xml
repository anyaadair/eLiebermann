      <div type="clause" n="5.24">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.24</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.24" corresp="#wit-lat"><pb n="551" ed="#liebermann"/>Si<ptr type="liebermannNote" n="a" target="#Hn_5-24.lnote.oe.a"/> quis episcopus super certis criminibus accusetur, ab omnibus qui sunt in prouincia episcopis<ptr type="liebermannNote" n="1" target="#Hn_5-24.lnote.oe.1"/> audiatur; nec dampnetur uel iudicetur, priusquam legittimos accusatores presentes<ptr type="liebermannNote" n="aa" target="#Hn_5-24.lnote.oe.aa"/> habeat; et comprouinciales<ptr type="liebermannNote" n="2" target="#Hn_5-24.lnote.oe.2"/>, non alienigenas<ptr type="liebermannNote" n="b" target="#Hn_5-24.lnote.oe.b"/>, et a se electos iudices non<ptr type="liebermannNote" n="3" target="#Hn_5-24.lnote.oe.3"/> refutet, nisi sit appellatum<ptr type="liebermannNote" n="4" target="#Hn_5-24.lnote.oe.4"/>; quod etiam liceat destinatis in suplicium.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 551 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-24.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch Ps.-Isidor p.</hi> 563; <hi rend="italic">Bened. lev.</hi> VII 104; <hi rend="italic">hieraus folgere man trotz</hi> 57, 9<hi rend="italic">a nicht, Heinrich I. lasse Criminalklagen gegen Bischöfe nur durch kirchliches Gericht aburtheilen</hi></seg><seg type="translation" xml:lang="en" source="#claude">also Ps.-Isidor p. 563; Bened. lev. VII 104; from this one should not conclude, despite 57, 9a, that Henry I allowed criminal charges against bishops to be tried only by an ecclesiastical court</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-24.lnote.oe.aa" n="aa" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 5, 9<hi rend="italic">o</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 5, 9o</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-24.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Ps.-Is. p.</hi> 184</seg><seg type="translation" xml:lang="en" source="#claude">cf. Ps.-Is. p. 184</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-24.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">-pi <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-pi Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-24.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">prou. <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">prou. K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-24.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">n. r. <hi rend="italic">Corr. am Rande Sc;</hi> si refugiat <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">n. r. corr. in the margin Sc; si refugiat Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-24.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">apel. <hi rend="italic">Sc stets</hi></seg><seg type="translation" xml:lang="en" source="#claude">apel. Sc always</seg></note>
      </div>
