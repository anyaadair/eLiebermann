    <body>
      <div type="clause" n="86">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 86</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="86" corresp="#wit-h"><pb n="8" ed="#liebermann"/>Gif esne oþerne<ptr type="liebermannNote" n="4" target="#Abt_86.lnote.oe.4"/> ofslea unsynnigne, ealne weorðe forgelde.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-h"><pb n="16" ed="#attenborough"/>Gif esne oþerne<ptr type="editorNote" n="h" target="#Abt_86.olinote.fn.h"/> ofslea unsynnigne, ealne weorðe forgelde.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="79" corresp="#wit-h"><pb n="78" ed="#oliver"/>Gif esne oþerne ofslea unsynnigne, ealne weorðe forgelde.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="8" ed="#liebermann"/>Wenn ein Lohnknecht den andern<ptr type="liebermannNote" n="1" target="#Abt_86.lnote.de.1"/> erschlägt, [der] unschuldig [ist], so entgelte er<ptr type="liebermannNote" n="2" target="#Abt_86.lnote.de.2"/> ihn [an dessen Herrn<ptr type="liebermannNote" n="3" target="#Abt_86.lnote.de.3"/>] ganz mit [Knechts-]Werth.<ptr type="liebermannNote" n="4" target="#Abt_86.lnote.de.4"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a hired servant slays another [who is] innocent, let him pay for him [to his master] in full with [a servant’s] value.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="17" ed="#attenborough"/>If one servant slays another, who has committed no offence, he shall pay his full value.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h"><pb n="393" ed="#whitelock"/>If one servant kills another without cause, he is to pay the full value.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h"><pb n="79" ed="#oliver"/>If a servant should kill another [who is] guiltless, let him pay [the dead man’s master] the entire worth.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Abt_86.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">8</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vom Schreiber zwischen die Zeilen geschoben</hi></seg><seg type="translation" xml:lang="en" source="#claude">inserted between the lines by the scribe</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_86.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">16</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Ergänze ‘Esne’. — <hi rend="italic">Unsynnig</hi> synonym mit <hi rend="italic">buton scylde</hi> Hl 12; <hi rend="italic">nan yfel deð</hi> 13</seg><seg type="translation" xml:lang="en" source="#claude">Supply ‘esne’. — <hi rend="italic">Unsynnig</hi> is synonymous with <hi rend="italic">buton scylde</hi> Hl 12; <hi rend="italic">nan yfel deð</hi> 13</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_86.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">16</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Der Unfreie (<hi rend="italic">s. d. Gl</hi> 22e) ist auch sonst zu Buss- und Strafzahlungen pflichtig. Nur wo er dazu unfähig ist, haftet sein Herr; <hi rend="italic">ebd.</hi> 16</seg><seg type="translation" xml:lang="en" source="#claude">The unfree man (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 22e) is liable elsewhere too to pay compensation and fines. Only where he is unable to do so is his lord liable; <hi rend="italic">ibid.</hi> 16</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_86.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">16</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd.</hi> 20f.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid.</hi> 20f.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_86.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">16</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Der Unfreie hat kein Wergeld, sondern Sachpreis; <hi rend="italic">ebd.</hi> 6a. 7</seg><seg type="translation" xml:lang="en" source="#claude">The unfree man has no wergild, only a price as a chattel; <hi rend="italic">ibid.</hi> 6a. 7</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Abt_86.olinote.fn.h" n="h" source="#oliver"><bibl><biblScope unit="page">78</biblScope></bibl><label>oþerne</label><seg type="original" xml:lang="en">Written above following words.</seg></note>
      </div>
    </body>
