      <div type="clause" n="23">
        <head>Af Rb 23</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="23" corresp="#wit-e"><pb n="18" ed="#liebermann"/>XXI. Be hundes slite.<ptr type="liebermannNote" n="6" target="#Rubrics-Af_23.lnote.oe.6"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="23" corresp="#wit-ot-frag"><pb n="18" ed="#liebermann"/>… Be hundes slyte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="23" corresp="#wit-g-prol"><pb n="18" ed="#liebermann"/>XXI. Be hundes slite.<ptr type="liebermannNote" n="4" target="#Rubrics-Af_23.lnote.oe.4"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="23" corresp="#wit-h"><pb n="19" ed="#liebermann"/>XXI. Be hundes slite.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="23" corresp="#wit-q"><pb n="19" ed="#liebermann"/>De canum disubitatione (uel<ptr type="liebermannNote" n="5" target="#Rubrics-Af_23.lnote.oe.5"/> morsu).</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="192" ed="#jurasinski-and-oliver"/>XXI Be hundes slite</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="192" ed="#jurasinski-and-oliver"/>Be hundes slite</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="19" ed="#liebermann"/>Vom Hundsbiss.<ptr type="liebermannNote" n="1" target="#Rubrics-Af_23.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of a dog-bite.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="193" ed="#jurasinski-and-oliver"/>Concerning a dog’s bite</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="193" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_23.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">v. m. <hi rend="italic">nur Hk;</hi> De morsu canis emendando <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">v. m. only Hk; De morsu canis emendando Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_23.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de">slyte <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">slyte So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_23.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de">lit <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">lit on an erasure</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_23.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Zum Quadr vgl. Afz. <hi rend="italic">(de)soubiter</hi>, ‘das Ducange als bes. Picardisch wohl nur weil er in Amiens lebte erklärt’; H. <hi rend="spaced">Suchier</hi> [Ave pia anima!] frndl. Mitt. 7 VI 1896. Dachte Quadr an <hi rend="italic">slide</hi>: ‘lapsus, Fall’? Die letzte Rez. versteht richtig</seg><seg type="translation" xml:lang="en" source="#claude">On Quadr cf. OFr. <hi rend="italic">(de)soubiter</hi>, ‘which Ducange explains as specifically Picard probably only because he lived in Amiens’; H. <hi rend="italic">Suchier</hi> [Ave pia anima!], kind communication of 7 VI 1896. Was Quadr thinking of <hi rend="italic">slide</hi>: ‘lapsus, fall’? The last rec. understands it correctly</seg></note>
