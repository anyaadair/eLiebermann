    <body>
      <div type="clause" n="70.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 70.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="70.1" corresp="#wit-e"><pb n="86" ed="#liebermann"/>Gif sio<ptr type="liebermannNote" n="6" target="#Af_70-1.lnote.oe.6"/> hyd sie tobrocen, ⁊ mon ban ófádo, geselle<ptr type="liebermannNote" n="2" target="#Af_70-1.lnote.oe.2"/> XV<ptr type="liebermannNote" n="7" target="#Af_70-1.lnote.oe.7"/> scill. to<ptr type="liebermannNote" n="8" target="#Af_70-1.lnote.oe.8"/> bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="70.1" corresp="#wit-h"><pb n="86" ed="#liebermann"/>Gif seo<ptr type="liebermannNote" n="5" target="#Af_70-1.lnote.oe.5"/> hyd sy<ptr type="liebermannNote" n="2" target="#Af_70-1.lnote.oe.2-2"/> tobrocen ⁊ mon<ptr type="liebermannNote" n="1" target="#Af_70-1.lnote.oe.1"/> bán ofadó, gesylle<ptr type="liebermannNote" n="2" target="#Af_70-1.lnote.oe.2-2"/> XV scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="70.1" corresp="#wit-b-no-prol"><pb n="86" ed="#liebermann"/>Gyf seo hyd sy tobrocen, ⁊ man ban ofadó, gesylle fiftyne scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="70.1" corresp="#wit-q"><pb n="87" ed="#liebermann"/>Si<ptr type="liebermannNote" n="3" target="#Af_70-1.lnote.oe.3"/> cutis aperta sit, et os extrahatur, det XV sol. ad emendationem.<ptr type="liebermannNote" n="4" target="#Af_70-1.lnote.oe.4"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="90" ed="#attenborough"/>Gif sio hyd sie tobrocen, ⁊ mon ban ófádo, geselle XV scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="360" ed="#jurasinski-and-oliver"/>Gif sio hyd sie tobrocen ⁊ mon bán ófádo, geselle XV scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="87" ed="#liebermann"/>Wenn die Haut zerbrochen ist, und jemand einen Knochen herausreisst<ptr type="liebermannNote" n="1" target="#Af_70-1.lnote.de.1"/>, gebe er 15 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the skin is broken, and someone tears out a bone, let him give 15 shillings as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="91" ed="#attenborough"/>If the skin is broken and a bone is removed<ptr type="editorNote" n="1" target="#Af_70-1.attnote.n.1"/>, 15 shillings shall be given [to him] as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="361" ed="#jurasinski-and-oliver"/>If the skin is broken, and a bone [fragment] is removed, let him pay 15 shillings as compensation.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_70-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">seo hyde sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">seo hyde sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_70-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">gesylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gesylle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_70-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">fiftyne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fiftyne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_70-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">to b. <hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">to b. lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_70-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_70-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_70-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geändert in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_70-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">87</biblScope></bibl><seg type="original" xml:lang="de">70, 1 <hi rend="italic">überspringt Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Br omits 70, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_70-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">87</biblScope></bibl><seg type="original" xml:lang="de">emendam <hi rend="italic">T;</hi> emendandam <hi rend="italic">Lond;</hi> ad e. <hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">emendam T; emendandam Lond; ad e. lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_70-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Gliederbussen 8H. 9a; <hi rend="italic">u.</hi> 74</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Gliederbussen 8H. 9a; <hi rend="italic">below</hi> 74</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_70-1.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">200</biblScope></bibl><seg type="original" xml:lang="en">‘Taken out,’ Thorpe; ‘herausreisst,’ Liebermann; cf. cap. 74, below.</seg></note>
      </div>
