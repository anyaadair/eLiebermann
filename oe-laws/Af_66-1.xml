    <body>
      <div type="clause" n="66.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 66.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="66.1" corresp="#wit-e"><pb n="84" ed="#liebermann"/>Æghwelcere<ptr type="liebermannNote" n="15" target="#Af_66-1.lnote.oe.15"/> wunde beforan feaxe ⁊ beforan sliefan<ptr type="liebermannNote" n="16" target="#Af_66-1.lnote.oe.16"/> ⁊ beneoðan cneowe sio<ptr type="liebermannNote" n="17" target="#Af_66-1.lnote.oe.17"/> bot bið twysceatte<ptr type="liebermannNote" n="18" target="#Af_66-1.lnote.oe.18"/> mare.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="66.1" corresp="#wit-h"><pb n="84" ed="#liebermann"/>Æghwylcre wunde beforan feaxe ⁊ beforan slyfon<ptr type="liebermannNote" n="4" target="#Af_66-1.lnote.oe.4"/> ⁊ beneoþan<ptr type="liebermannNote" n="12" target="#Af_66-1.lnote.oe.12"/> cneowe seo<ptr type="liebermannNote" n="5" target="#Af_66-1.lnote.oe.5"/> bot bið twysceatte<ptr type="liebermannNote" n="3" target="#Af_66-1.lnote.oe.3"/> mare.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="66.1" corresp="#wit-b-no-prol"><pb n="84" ed="#liebermann"/>Æghwylcere wunde beforan feaxe ⁊ beforan slefan ⁊ beneoðan cneowe seo bot byð twyggylde mare.<ptr type="liebermannNote" n="1" target="#Af_66-1.lnote.oe.1"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="66.1" corresp="#wit-q"><pb n="85" ed="#liebermann"/>Omne uulnus ante capillos<ptr type="liebermannNote" n="11" target="#Af_66-1.lnote.oe.11"/> et ante manicam et sub genu duplo maioris emendationis sit.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="90" ed="#attenborough"/>Æghwelcere wunde beforan feaxe ⁊ beforan sliefan ⁊ beneoðan cneowe sio bot bið twysceatte<ptr type="editorNote" n="13" target="#Af_66-1.attnote.fn.13"/> mare.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="70" corresp="#wit-e"><pb n="358" ed="#jurasinski-and-oliver"/>Æghwelcere wunde beforan feaxe ⁊ beforan sliefan ⁊ beneoðan cneowe sio bot bið twysceatte mare.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="85" ed="#liebermann"/>Jeder<ptr type="liebermannNote" n="1" target="#Af_66-1.lnote.de.1"/> Wunde<ptr type="liebermannNote" n="2" target="#Af_66-1.lnote.de.2"/> vor<ptr type="liebermannNote" n="3" target="#Af_66-1.lnote.de.3"/> dem Haupthaar, und vor<ptr type="liebermannNote" n="4" target="#Af_66-1.lnote.de.4"/> dem Aermel<ptr type="liebermannNote" n="5" target="#Af_66-1.lnote.de.5"/> und unterhalb<ptr type="liebermannNote" n="6" target="#Af_66-1.lnote.de.6"/> des Knies ist die Busse doppelt<ptr type="liebermannNote" n="7" target="#Af_66-1.lnote.de.7"/> so viel.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">For every wound in front of the head-hair, and in front of the sleeve, and below the knee, the compensation is twice as much.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="91" ed="#attenborough"/>For every wound in front of the hair, and below the sleeve and beneath the knee, the compensation shall be doubled<ptr type="editorNote" n="1" target="#Af_66-1.attnote.n.1"/>.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="359" ed="#jurasinski-and-oliver"/>Any wound below the hairline, and below the sleeve, and beneath the knee is two-fold more.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_10-1">Leis Wl 10.1</ref></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="359"><label>similarly</label> <ref target="clause:Abt_57">Abt 57</ref> <quote>Æthelberht §61 [L57] similarly fines a bruise that is visible more highly than one which is covered by clothing.</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">-hwylc. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-hwylc. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">slyf. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">slyf. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">s. b. <hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. b. lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66-1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">twygylde</hi> <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">twygylde</hi> Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zweites</hi> e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">second e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">85</biblScope></bibl><seg type="original" xml:lang="de">scapulam <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">scapulam Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_66-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor</hi> mare <hi rend="italic">interpungirt B</hi></seg><seg type="translation" xml:lang="en" source="#claude">punctuated before mare B</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_66-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Gen. oder Dativ, wie <hi rend="italic">o.</hi> 44</seg><seg type="translation" xml:lang="en" source="#claude">Gen. or dative, as <hi rend="italic">above</hi> 44</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_66-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Gliederbussen 11</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Gliederbussen 11</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_66-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘vor dem Ellbogen’, setzt zu Inst., wohl nur aus Af 66 hierher verirrt</seg><seg type="translation" xml:lang="en" source="#claude">Inst. add ‘before the elbow’, probably merely strayed in here from Af 66</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_66-1.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘vor dem Ellbogen’, setzt zu Inst., wohl nur aus Af 66 hierher verirrt</seg><seg type="translation" xml:lang="en" source="#claude">Inst. add ‘before the elbow’, probably merely strayed in here from Af 66</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_66-1.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘vor dem Ellbogen’, setzt zu Inst., wohl nur aus Af 66 hierher verirrt</seg><seg type="translation" xml:lang="en" source="#claude">Inst. add ‘before the elbow’, probably merely strayed in here from Af 66</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_66-1.lnote.de.6" n="6" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ante</hi> in Inst. ‘unterhalb’, laut Af 66, wie <hi rend="italic">usque ad</hi> 72. So setzt in Af 66 Q <hi rend="italic">ante,</hi> Hn 93, 25: <hi rend="italic">sub</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">ante</hi> in Inst. ‘below’, according to Af 66, as <hi rend="italic">usque ad</hi> 72. Thus in Af 66 Q puts <hi rend="italic">ante,</hi> Hn 93, 25: <hi rend="italic">sub</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_66-1.lnote.de.7" n="7" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">nicht ‘two parts more’ oder ‘um 2 Geldstücke mehr’; <hi rend="italic">vgl.</hi> Fries. <hi rend="italic">twiskette,</hi> mndd. <hi rend="italic">twischette.</hi> B modernisiert</seg><seg type="translation" xml:lang="en" source="#claude">not ‘two parts more’ or ‘more by 2 coins’; <hi rend="italic">cf.</hi> Frisian <hi rend="italic">twiskette,</hi> Middle Low German <hi rend="italic">twischette.</hi> B modernizes</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_66-1.attnote.fn.13" n="13" source="#attenborough"><bibl><biblScope unit="page">90</biblScope></bibl><label>twysceatte</label><seg type="original" xml:lang="en"><hi rend="italic">twyggylde</hi>. B &amp; Ld.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_66-1.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">199</biblScope></bibl><seg type="original" xml:lang="en">Cf. Abt. cap. 59 and 60.</seg></note>
      </div>
