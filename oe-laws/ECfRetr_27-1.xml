      <div type="clause" n="27.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 27.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 27.1"><pb n="651" ed="#liebermann"/>— uerbi gratia in<ptr type="liebermannNote" n="9" target="#ECfRetr_27-1.lnote.la.9"/> Denelaga<ptr type="liebermannNote" n="10" target="#ECfRetr_27-1.lnote.la.10"/> per<ptr type="liebermannNote" n="11" target="#ECfRetr_27-1.lnote.la.11"/> XVIII<ptr type="liebermannNote" n="12" target="#ECfRetr_27-1.lnote.la.12"/> ‘hundreda’<ptr type="liebermannNote" n="13" target="#ECfRetr_27-1.lnote.la.13"/>, qui<ptr type="liebermannNote" n="14" target="#ECfRetr_27-1.lnote.la.14"/> numerus complet<ptr type="liebermannNote" n="15" target="#ECfRetr_27-1.lnote.la.15"/> septies<ptr type="liebermannNote" n="16" target="#ECfRetr_27-1.lnote.la.16"/> uiginti libras et<ptr type="liebermannNote" n="17" target="#ECfRetr_27-1.lnote.la.17"/> quatuor <hi rend="bold">libras, quoniam</hi> forisfacturam<ptr type="liebermannNote" n="18" target="#ECfRetr_27-1.lnote.la.18"/> ‘hundredi’ Dani et<ptr type="liebermannNote" n="19" target="#ECfRetr_27-1.lnote.la.19"/> Norwenses<ptr type="liebermannNote" n="20" target="#ECfRetr_27-1.lnote.la.20"/> octo libras <hi rend="bold">habebant</hi><ptr type="liebermannNote" n="21" target="#ECfRetr_27-1.lnote.la.21"/> <hi rend="bold">(multiplicatis</hi><ptr type="liebermannNote" n="d" target="#ECfRetr_27-1.lnote.la.fn.d"/> <hi rend="bold">igitur octo per octodecim faciunt centum et quadraginta quatuor):</hi></ab>
        <note type="comparison" source="#liebermann" n="651"><label>printed alongside</label> <ref target="clause:ECf_27-1">ECf 27.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 651 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-1.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">18 × 8 £ = 144 £</seg><seg type="translation" xml:lang="en" source="#claude">18 × £8 = £144</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-1.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">hidene l. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">hidene l. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-1.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">Denal. <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">Denal. Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-1.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-1.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">octo <hi rend="italic">Hv Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">octo Hv Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-1.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">-eta <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-eta Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-1.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">igitur <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">igitur Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-1.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">continet <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">continet Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-1.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">sexies <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sexies Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-1.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">et q. l. <hi rend="italic">fehlt Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">et q. l. lacking in Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-1.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">-factorum <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-factorum Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-1.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-1.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">-wagensis <hi rend="italic">Va;</hi> -wegienses <hi rend="italic">Cb Ld Lond;</hi> -wagienses <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">-wagensis Va; -wegienses Cb Ld Lond; -wagienses Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-1.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">habeant <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">habeant Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">— for example, in the Danelaw by eighteen 'hundreds', which number makes up seven times twenty pounds and four pounds, since the Danes and Norwegians held the forfeiture of a 'hundred' as eight pounds (so eight multiplied by eighteen make a hundred and forty-four):</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_27-1.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Norwegienses</hi><hi rend="superscript">20</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Norwegienses</hi><hi rend="superscript">20</hi> Rs</seg></note>
      </div>
    </body>
