      <div type="clause" n="48.10">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 48.10</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 48.10" corresp="#wit-lat"><pb n="571" ed="#liebermann"/>Et de cremento<ptr type="liebermannNote" n="p" target="#Hn_48-10.lnote.oe.p"/> feudi<ptr type="liebermannNote" n="45" target="#Hn_48-10.lnote.oe.45"/> debet haberi<ptr type="liebermannNote" n="46" target="#Hn_48-10.lnote.oe.46"/> testis eiusdem dominii<ptr type="liebermannNote" n="47" target="#Hn_48-10.lnote.oe.47"/>, uel ex sua uel ex parte domini etiam<ptr type="liebermannNote" n="48" target="#Hn_48-10.lnote.oe.48"/> inuocatus<ptr type="liebermannNote" n="49" target="#Hn_48-10.lnote.oe.49"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 571 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-10.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">das Wort steht Domesday</hi> I 64b 1. <hi rend="italic">Hier etwa</hi> Zuwachs <hi rend="italic">im Gegensatz zu</hi> primo feodo (<hi rend="italic">Hauptgut</hi>) 48, 11<hi rend="italic">? oder ist</hi> tenemento <hi rend="italic">zu emendiren; vgl.</hi> ses pers de la tenure meimes apelerad a testimonie (Leis Wl 23)</seg><seg type="translation" xml:lang="en" source="#claude">the word occurs in Domesday I 64b 1. Here perhaps increment, in contrast to primo feodo (principal holding) 48, 11? Or should tenemento be read by emendation? cf. ses pers de la tenure meimes apelerad a testimonie (Leis Wl 23)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-10.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">feodi <hi rend="italic">immer Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">feodi always Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-10.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">habere testes <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">habere testes Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-10.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">-ni <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ni Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-10.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-10.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">adu. <hi rend="italic">Lond;</hi> -tos <hi rend="italic">gegen Hss., Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">adu. Lond; -tos against MSS, edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-10.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de">Der Ggs. ist, dass hier nur Vassallen desselben Lehns, in 48, 11 auch andere Freie zeugen dürfen—<hi rend="italic">aduocatus</hi>{48}—48, 11 <hi rend="italic">feodo h. quinque l. si n. possunt</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">The contrast is that here only vassals of the same fief may act as witnesses, but in 48, 11 other free men too—<hi rend="italic">aduocatus</hi>{48}—48, 11 <hi rend="italic">feodo h. quinque l. si n. possunt</hi> Rs</seg></note>
      </div>
