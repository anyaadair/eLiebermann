      <div type="clause" n="48">
        <head>Ine Rb 48</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="48" corresp="#wit-e"><pb n="24" ed="#liebermann"/>XCII. Be witeþeowum men.<ptr type="liebermannNote" n="6" target="#Rubrics-Ine_48.lnote.oe.6"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="48" corresp="#wit-g-prol"><pb n="24" ed="#liebermann"/>XCII. Be witeþeowum men.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="48" corresp="#wit-h"><pb n="25" ed="#liebermann"/>XCII. Be witeþeowum mannū.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="48" corresp="#wit-q"><pb n="25" ed="#liebermann"/>De<ptr type="liebermannNote" n="13" target="#Rubrics-Ine_48.lnote.oe.13"/> witaseruo.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="210" ed="#jurasinski-and-oliver"/>XCII Be witeþeowum men</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="210" ed="#jurasinski-and-oliver"/>Be witeðeowu<hi rend="italic">m</hi> mannu<hi rend="italic">m</hi></ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="25" ed="#liebermann"/>Vom strafhörigen<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_48.lnote.de.1"/> Menschen.<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_48.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of a person enslaved as a penalty.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="211" ed="#jurasinski-and-oliver"/>Concerning a penal slave</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="211" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_48.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">24</biblScope></bibl><seg type="original" xml:lang="de">mannum <hi rend="italic">Ld</hi> [<hi rend="italic">aus B?</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">mannum Ld [from B?]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_48.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">Et de witaservi <hi rend="italic">T</hi>; Si quis [De illo qui <hi rend="italic">Br</hi>] propter forisfactum in servitutem redactus [transit <hi rend="italic">statt</hi> red. — servit. <hi rend="italic">Br</hi>] accusetur furtum fecisse ante servitutem <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et de witaservi T; Si quis [De illo qui Br] propter forisfactum in servitutem redactus [transit instead of red. — servit. Br] accusetur furtum fecisse ante servitutem Hk Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_48.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Q spät. Rez. vervollständigt die Rb aus seinem Text</seg><seg type="translation" xml:lang="en" source="#claude">The later recension of Q completes the Rb from its own text</seg><note type="remark" resp="#claude">On several rubrics: Ine Rb 40. 43f. 46—50. 54. 56f. 58. 61f. 67. 70f.</note></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_48.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Plural H B</seg><seg type="translation" xml:lang="en" source="#claude">Plural H B</seg></note>
      </div>
