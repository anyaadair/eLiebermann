    <body>
      <div type="clause" n="32 B 10">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 32 B 10</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 32 B 10"><pb n="657" ed="#liebermann"/>Ita uero bis folkesmot<ptr type="liebermannNote" n="19" target="#ECf_32-B-10.lnote.la.19"/> singulis annis semper celebrari debet per annum per uniuersos comitatus<ptr type="liebermannNote" n="h" target="#ECf_32-B-10.lnote.la.fn.h"/> et prouincias et patrias uniuersas totius<ptr type="liebermannNote" n="20" target="#ECf_32-B-10.lnote.la.20"/> regni predicti, pro pace et stabilitate<ptr type="liebermannNote" n="hh" target="#ECf_32-B-10.lnote.la.fn.hh"/> et confirmatione regni, ut predictum est, super plenam wytam<ptr type="liebermannNote" n="21" target="#ECf_32-B-10.lnote.la.21"/> et drincelen<ptr type="liebermannNote" n="i" target="#ECf_32-B-10.lnote.la.fn.i"/>.</ab>
        <note type="comparisonPrinted" source="#liebermann">32 A 5</note>
        <note type="comparisonPrinted" source="#liebermann">II Cn. 80, 1. 81</note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 657 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">This passage is not part of ECf or ECf retr: it is one of the additions of the London collection (Leges Anglorum s. XIII in. Londoniis collectae), which Liebermann prints across the page as an insertion into ECf retr. 32 (32 A–E, pp. 655–660). The dictionary cites it as “ECf 32 B …”, so it is kept with ECf here.</note>
        <note type="editorial">Liebermann prints the words borrowed from Quadr. II Cn. 80, 1. 81 (and 32 A 5) in smaller type; his margin names the source (II Cn. 80, 1. 81).</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_32-B-10.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nach</hi> 32 B 8 <hi rend="italic">ist nur Octobertag in jeder Grafschaft, nach</hi> 32 A 5 <hi rend="italic">Maitag Reichsversammlung</hi></seg><seg type="translation" xml:lang="en" source="#claude">according to 32 B 8 there is only an October day in each shire, according to 32 A 5 a May day of the assembly of the realm</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_32-B-10.lnote.la.fn.hh" n="hh" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus</hi> 32 C 6</seg><seg type="translation" xml:lang="en" source="#claude">from 32 C 6</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_32-B-10.lnote.la.fn.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">was bei Cnut, o.</hi> 32 B 5a, <hi rend="italic">Satzbeginn ist, missversteht der Londoner als ähnlich mit Strafe</hi></seg><seg type="translation" xml:lang="en" source="#claude">what in Cnut, above 32 B 5a, begins a sentence the Londoner misunderstands as something like a penalty</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-B-10.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de">-th <hi rend="italic">K;</hi> folkemote <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-th K; folkemote Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-B-10.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de">tocius <hi rend="italic">stets K</hi></seg><seg type="translation" xml:lang="en" source="#claude">tocius always K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-B-10.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de">wit. <hi rend="italic">ohne</hi> et d. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wit. without et d. Ld</seg></note>
      </div>
