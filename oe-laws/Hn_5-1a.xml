      <div type="clause" n="5.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.1a" corresp="#wit-lat"><ptr type="liebermannNote" n="f" target="#Hn_5-1a.lnote.oe.f"/><pb n="548" ed="#liebermann"/>Deinde<ptr type="liebermannNote" n="35" target="#Hn_5-1a.lnote.oe.35"/> causarum qualitas sincera perscrutatione pensanda et accusantium<ptr type="liebermannNote" n="36" target="#Hn_5-1a.lnote.oe.36"/> intentio, testium modus et iudicum<ptr type="liebermannNote" n="37" target="#Hn_5-1a.lnote.oe.37"/> electio<ptr type="liebermannNote" n="g" target="#Hn_5-1a.lnote.oe.g"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 548 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-1a.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">D. c. q. <hi rend="italic">aus Pan.</hi> IV 82 (<hi rend="italic">Gr.</hi> C. 2 q. 1 c. 7)</seg><seg type="translation" xml:lang="en" source="#claude">D. c. q. from Pan. IV 82 (Gr. C. 2 q. 1 c. 7)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-1a.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">anders als kanonisches Recht versteht Verf.</hi> 33, 5 <hi rend="italic">unter</hi> iudices electi ‘<hi rend="italic">Urtheilfinder</hi>’; <hi rend="italic">so vielleicht schon hier oder doch</hi> 5, 3<hi rend="italic">a</hi>; 5, 6 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">unlike canon law, the author in 33, 5 understands by iudices electi ‘judgment-finders’; so perhaps already here, or at any rate in 5, 3a; 5, 6 f.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-1a.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">deiñ <hi rend="italic">Sc;</hi> demum <hi rend="italic">Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">deiñ Sc; demum Edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-1a.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">accāncium <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">accāncium Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-1a.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">-cium <hi rend="italic">Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cium MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-1a.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">315</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Urteilfinder 7b ff. Sie heissen auch <hi rend="italic">iudicatores</hi> (Engl. Rolle um 1300), die <hi rend="italic">iudicia faciunt</hi> (1226; Maitland <hi rend="italic">Sel. pleas manor</hi>. p. <hi rend="smallcaps">lxv</hi>) und <hi rend="italic">iudiciarii</hi> in <hi rend="italic">Summa leg. Norm</hi>. (um 1250) 9, 2. 52, 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Urteilfinder 7b ff. They are also called <hi rend="italic">iudicatores</hi> (English roll c. 1300), who <hi rend="italic">iudicia faciunt</hi> (1226; Maitland <hi rend="italic">Sel. pleas manor</hi>. p. <hi rend="smallcaps">lxv</hi>), and <hi rend="italic">iudiciarii</hi> in <hi rend="italic">Summa leg. Norm</hi>. (c. 1250) 9, 2. 52, 4</seg></note>
      </div>
