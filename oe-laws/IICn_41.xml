        <note type="liebermannNote" subtype="textual" xml:id="IICn_41.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">340</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geändert</hi> wræc.</seg><seg type="translation" xml:lang="en" source="#claude">altered to wræc.</seg></note>
