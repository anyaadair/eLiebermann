        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="75" corresp="#wit-e"><pb n="26" ed="#liebermann"/>CXVIIII. Be forstolenes ceapes forefonge.<ptr type="liebermannNote" n="13" target="#Rubrics-Ine_75.lnote.oe.13"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="75" corresp="#wit-g-prol"><pb n="26" ed="#liebermann"/>CXVIIII. Be forstolenes ceapes forefenge</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="75" corresp="#wit-h"><pb n="27" ed="#liebermann"/>CXIX. Be forstolenes ceapes forfenge.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="75" corresp="#wit-q"><pb n="27" ed="#liebermann"/>De<ptr type="liebermannNote" n="3" target="#Rubrics-Ine_75.lnote.oe.3"/> furtiui captalis forfangio.<ptr type="liebermannNote" n="18" target="#Rubrics-Ine_75.lnote.oe.18"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="218" ed="#jurasinski-and-oliver"/>CXVIIII Be forstolenes ceapes forefonge</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="218" ed="#jurasinski-and-oliver"/>Be forstolene ceape</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="27" ed="#liebermann"/>Von Anefang gestohlener Fahrhabe.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of attachment of stolen goods.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="219" ed="#jurasinski-and-oliver"/>Concerning the seizure of stolen goods</ab>
