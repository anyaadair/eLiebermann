      <div type="clause" n="59">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 59</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-e"><seg type="part" corresp="#part-a"><pb n="116" ed="#liebermann"/>CIII. Cuuhorn<ptr type="liebermannNote" n="1" target="#Ine_59-a.lnote.oe.1-3"/> bið<ptr type="liebermannNote" n="2" target="#Ine_59-a.lnote.oe.2-2"/> twegea<ptr type="liebermannNote" n="3" target="#Ine_59-a.lnote.oe.3"/> pæninga<ptr type="liebermannNote" n="4" target="#Ine_59-a.lnote.oe.4"/>;</seg> <seg type="part" corresp="#part-b"><pb n="116" ed="#liebermann"/>oxan tægl bið<ptr type="liebermannNote" n="2" target="#Ine_59-b.lnote.oe.2-2"/> scill.<ptr type="liebermannNote" n="5" target="#Ine_59-b.lnote.oe.5"/> weorð, cus bið<ptr type="liebermannNote" n="2" target="#Ine_59-b.lnote.oe.2-2"/> fifa<ptr type="liebermannNote" n="*" target="#Ine_59-b.lnote.oe.star"/>;</seg> <seg type="part" corresp="#part-c"><pb n="116" ed="#liebermann"/>oxan eage bið<ptr type="liebermannNote" n="2" target="#Ine_59-c.lnote.oe.2"/> V<ptr type="liebermannNote" n="6" target="#Ine_59-c.lnote.oe.6"/> p.<ptr type="liebermannNote" n="7" target="#Ine_59-c.lnote.oe.7"/> weorð, cus<ptr type="liebermannNote" n="8" target="#Ine_59-c.lnote.oe.8"/> bið<ptr type="liebermannNote" n="2" target="#Ine_59-c.lnote.oe.2"/> scill. weorþ.<ptr type="liebermannNote" n="9" target="#Ine_59-c.lnote.oe.9"/></seg></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-h"><seg type="part" corresp="#part-a"><pb n="116" ed="#liebermann"/>CIII. Cúhorn bið V peninga weorð;</seg> <seg type="part" corresp="#part-b"><pb n="116" ed="#liebermann"/>oxan tægl bið scill'<ptr type="liebermannNote" n="1" target="#Ine_59-b.lnote.oe.1"/> weorð; cú bið V peninga;</seg> <seg type="part" corresp="#part-c"><pb n="116" ed="#liebermann"/>oxan eage bið V peninga weorð, cú bið scillinges.</seg></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-b-no-prol"><seg type="part" corresp="#part-a"><pb n="116" ed="#liebermann"/>Cuhorn twegea peniga wurð; oxan tægl bið IIII<ptr type="liebermannNote" n="1" target="#Ine_59-a.lnote.oe.1"/> peonega wurð; cutægl bið fif penega wurð; oxan eage bið fif peonega wurð; cu<ptr type="liebermannNote" n="2" target="#Ine_59-a.lnote.oe.2"/> bið scill' weorð.</seg></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-q"><seg type="part" corresp="#part-a"><pb n="117" ed="#liebermann"/>uacce II<ptr type="liebermannNote" n="1" target="#Ine_59-a.lnote.oe.1-2"/> den.;</seg> <seg type="part" corresp="#part-b"><pb n="117" ed="#liebermann"/>bouis cauda I<ptr type="liebermannNote" n="2" target="#Ine_59-b.lnote.oe.2"/> sol.<ptr type="liebermannNote" n="3" target="#Ine_59-b.lnote.oe.3"/>, uacce quinque den.;</seg> <seg type="part" corresp="#part-c"><pb n="117" ed="#liebermann"/>bouis oculus quinque den. componendus est, uacce<ptr type="liebermannNote" n="4" target="#Ine_59-c.lnote.oe.4"/> I<ptr type="liebermannNote" n="5" target="#Ine_59-c.lnote.oe.5"/> sol.</seg></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><seg type="part" corresp="#part-a"><pb n="56" ed="#attenborough"/>Cuuhorn bið twegea<ptr type="editorNote" n="4" target="#Ine_59-a.attnote.fn.4"/> pæninga<ptr type="editorNote" n="5" target="#Ine_59-a.attnote.fn.5"/>;</seg> <seg type="part" corresp="#part-b"><pb n="56" ed="#attenborough"/>oxan tægl bið scill.<ptr type="editorNote" n="6" target="#Ine_59-b.attnote.fn.6"/> weorð, cus bið fifa<ptr type="editorNote" n="7" target="#Ine_59-b.attnote.fn.7"/>;</seg> <seg type="part" corresp="#part-c"><pb n="56" ed="#attenborough"/>oxan eage bið V p[eninga]<ptr type="editorNote" n="8" target="#Ine_59-c.attnote.fn.8"/> weorð, cus bið scill. weorþ.</seg></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e" n="62.1–62.3"><seg type="part" n="62.1" corresp="#part-a"><pb n="422" ed="#jurasinski-and-oliver"/>{CIII} Cuuhorn \bið/ twegea pæninga;</seg> <seg type="part" n="62.2" corresp="#part-b"><pb n="422" ed="#jurasinski-and-oliver"/>oxan tægl bið sciƚƚ weorð, cus bið fifa;</seg> <seg type="part" n="62.3" corresp="#part-c"><pb n="422" ed="#jurasinski-and-oliver"/>oxan eage bið V pæ<hi rend="italic">ninga</hi> weorð, cus bið sciƚƚ weorð.</seg></ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><seg type="part" corresp="#part-a"><pb n="117" ed="#liebermann"/>Ein Kuhhorn gilt 2<ptr type="liebermannNote" n="1" target="#Ine_59-a.lnote.de.1"/> Pfennige<ptr type="liebermannNote" n="2" target="#Ine_59-a.lnote.de.2"/>;</seg> <seg type="part" corresp="#part-b"><pb n="117" ed="#liebermann"/>ein Ochsenschwanz ist 1<ptr type="liebermannNote" n="3" target="#Ine_59-b.lnote.de.3"/> Schill. werth, [der] einer Kuh<ptr type="liebermannNote" n="4" target="#Ine_59-b.lnote.de.4"/> 5 (Pfennige<ptr type="liebermannNote" n="2" target="#Ine_59-b.lnote.de.2"/>);</seg> <seg type="part" corresp="#part-c"><pb n="117" ed="#liebermann"/>eines Ochsen Auge ist 5 Pfennig werth, das einer Kuh ist 1<ptr type="liebermannNote" n="5" target="#Ine_59-c.lnote.de.5"/> Schill. werth.</seg></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman"><seg type="part" corresp="#part-a">A cow’s horn is worth 2 pence;</seg> <seg type="part" corresp="#part-b">an ox’s tail is worth 1 shilling, [that] of a cow 5 (pence);</seg> <seg type="part" corresp="#part-c">an ox’s eye is worth 5 pence, that of a cow is worth 1 shilling.</seg></ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><seg type="part" corresp="#part-a"><pb n="57" ed="#attenborough"/>A cow’s horn is worth 2 pence (5 pence, H):</seg> <seg type="part" corresp="#part-b"><pb n="57" ed="#attenborough"/>the tail of an ox is worth a shilling<ptr type="editorNote" n="1" target="#Ine_59-b.attnote.n.1"/>, a cow's tail 5 pence.</seg> <seg type="part" corresp="#part-c"><pb n="57" ed="#attenborough"/>The eye of an ox is worth 5 pence and a cow's is worth a shilling.</seg></ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><seg type="part" corresp="#part-a"><pb n="406" ed="#whitelock"/>The horn of a cow [is valued at] twopence; the tail of an ox is valued at a shilling; that of a cow at fivepence; the eye of an ox is valued at fivepence, that of a cow at a shilling.</seg></ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><seg type="part" corresp="#part-a"><pb n="423" ed="#jurasinski-and-oliver"/>A cow horn is worth 2 pennies.</seg> <seg type="part" corresp="#part-b"><pb n="423" ed="#jurasinski-and-oliver"/>An ox tail is worth a shilling, a cow’s is 5.</seg> <seg type="part" corresp="#part-c"><pb n="423" ed="#jurasinski-and-oliver"/>An ox eye is worth 5 shillings, a cow’s is worth a shilling.</seg></ab>
        <note type="concordance"><seg type="edition">Jurasinski and Oliver 62.1, 62.2, 62.3</seg></note>
        <note type="translator" source="#whitelock" target="#part-a">Whitelock translates Ine 59 as one clause, which the sheet divides into rows 59[a], 59[b], 59[c]; her translation of the whole is given here, in the first row.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-a.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">spät auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">late, on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-a.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de">eage <hi rend="italic">im</hi> 16. <hi rend="italic">Jh. eingefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">eage inserted in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-a.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">117</biblScope></bibl><seg type="original" xml:lang="de">II <hi rend="italic">Lond; geänd.</hi> V <hi rend="italic">Co Or;</hi> V <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">II Lond; altered: V Co Or; V the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-a.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de">Cúhorn twega <hi rend="italic">ohne</hi> bið <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cúhorn twega without bið Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-a.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de">beoð <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">beoð So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-a.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de">twegra, <hi rend="italic">darüber</hi> V <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">twegra, above it V So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-a.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de">pen. weorð <hi rend="italic">So;</hi> pen. wyrþe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">pen. weorð So; pen. wyrþe Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_59-a.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">78</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">H irrt, weil <hi rend="italic">II</hi> und <hi rend="italic">V</hi> (= 5) ähnelten</seg><seg type="translation" xml:lang="en" source="#claude">H errs because <hi rend="italic">II</hi> and <hi rend="italic">V</hi> (= 5) looked alike</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_59-a.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">78</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Die Zufügung und nachherige Auslassung von <hi rend="italic">weorð</hi> in hb bzw. H sind Schreiber-Willkür</seg><seg type="translation" xml:lang="en" source="#claude">The addition and subsequent omission of <hi rend="italic">weorð</hi> in hb and H respectively are arbitrary scribal changes</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_59-a.attnote.fn.4" n="4" source="#attenborough"><bibl><biblScope unit="page">56</biblScope></bibl><label>twegea</label><seg type="original" xml:lang="en"><hi rend="italic"><hi rend="smallcaps">v</hi></hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_59-a.attnote.fn.5" n="5" source="#attenborough"><bibl><biblScope unit="page">56</biblScope></bibl><label>pæninga</label><seg type="original" xml:lang="en"><hi rend="italic">p. weorð</hi>. H. <hi rend="italic">wurð</hi>. B.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-b.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">117</biblScope></bibl><seg type="original" xml:lang="de">V d. <hi rend="italic">T M Hk Br Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">V d. T M Hk Br Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-b.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">117</biblScope></bibl><seg type="original" xml:lang="de">id est XII den. appreciatur <hi rend="italic">Lond;</hi> V <hi rend="italic">über</hi> XII <hi rend="italic">Co;</hi> V <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">id est XII den. appreciatur Lond; V above XII Co; V Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-b.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-b.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de">beoð <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">beoð So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-b.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de">IIII peninga wyrþe; cús tægl biþ fif peninga wirþe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">IIII peninga wyrþe; cús tægl biþ fif peninga wirþe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-b.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> pæn. <hi rend="italic">aus Ld H B Quadr. Instit. Cn.</hi></seg><seg type="translation" xml:lang="en" source="#claude">supply pæn. from Ld H B Quadr. Instit. Cn.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_59-b.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">78</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Da B London entstammt, setzt er dortigen Mercischen Schilling von nur 4 Pf.; Ine meint 5. Ein Q-Schreiber missversteht den Normann. von 12 Pf.</seg><seg type="translation" xml:lang="en" source="#claude">Since B comes from London, he puts the Mercian shilling of only 4 pence current there; Ine means 5. A Q scribe misunderstands it as the Norman shilling of 12 pence</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_59-b.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">78</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘Schwanz’ Ausfüllung archaischer Ellipse B</seg><seg type="translation" xml:lang="en" source="#claude">‘tail’: B’s filling-out of an archaic ellipsis</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_59-b.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">78</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Die Zufügung und nachherige Auslassung von <hi rend="italic">weorð</hi> in hb bzw. H sind Schreiber-Willkür</seg><seg type="translation" xml:lang="en" source="#claude">The addition and subsequent omission of <hi rend="italic">weorð</hi> in hb and H respectively are arbitrary scribal changes</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_59-b.attnote.fn.6" n="6" source="#attenborough"><bibl><biblScope unit="page">56</biblScope></bibl><label>scill</label><seg type="original" xml:lang="en"><hi rend="italic"><hi rend="smallcaps">iiii</hi> peonega wurð</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_59-b.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">56</biblScope></bibl><label>fifa</label><seg type="original" xml:lang="en"><hi rend="italic"><hi rend="smallcaps">v</hi> peninga</hi>. H. <hi rend="italic">fif penega wurð</hi>. B.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_59-b.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">191</biblScope></bibl><seg type="original" xml:lang="en">Liebermann assumes that the shilling in Ine’s time contained five pence, as it did in Wessex in later times; but it is difficult to believe that the terms ‘shilling’ and ‘five pence’ used in this law signify identical amounts. That the West Saxon shilling contained four pence at this time (like the Mercian shilling) seems to be shown by the <hi rend="italic">Sax. Chron.</hi> ann. 694, where the sum paid for the slaying of Mul is identical with the wergeld of a king stated in the fragment <hi rend="italic">Be Myrcna Lage.</hi> It is probable also that the <hi rend="italic">wite</hi> of 60 shillings originally meant a pound of silver (see Chadwick, <hi rend="italic">Anglo-Saxon Institutions</hi>, p. 12 f.).</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-c.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">117</biblScope></bibl><seg type="original" xml:lang="de">V den.; bouis oculus V den. componendum est; uacce <hi rend="italic">wiederholt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">V den.; bouis oculus V den. componendum est; uacce repeated by Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-c.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">117</biblScope></bibl><seg type="original" xml:lang="de">unum <hi rend="italic">Or; auf Rasur Co;</hi> VIII <hi rend="italic">K;</hi> XII den. <hi rend="italic">M Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">unum Or; on an erasure Co; VIII K; XII den. M Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-c.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de">beoð <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">beoð So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-c.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de">fif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-c.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de">peninga <hi rend="italic">So;</hi> peninge wyrþe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">peninga So; peninge wyrþe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-c.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de">eage <hi rend="italic">fügt zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">eage added by Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-c.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt So;</hi> wyrþe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in So; wyrþe Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_59-c.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">78</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Weshalb wechselt Ine im Ausdruck Eines Wertes zwischen 1 Schill. und 5 Pf.? — Die Lex Ribuaria verlangt, wo Wergeld in Ochsen bezahlt wird, diese ungeblendet. Verstümmelten die barbarischen Viehhalter ihr Arbeitsvieh im Zorn, wie das Strafrecht kalten Blutes den Menschen?</seg><seg type="translation" xml:lang="en" source="#claude">Why does Ine, in expressing one and the same value, alternate between 1 shill. and 5 pence? — Where wergild is paid in oxen, the Lex Ribuaria requires them not to have been blinded. Did the barbarian stock-keepers mutilate their working animals in anger, as the criminal law mutilated human beings in cold blood?</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_59-c.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">56</biblScope></bibl><label>p[eninga</label><seg type="original" xml:lang="en">H &amp; B.</seg></note>
      </div>
