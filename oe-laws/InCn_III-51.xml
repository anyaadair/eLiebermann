      <div type="clause" n="III 51">
        <head><ref type="lawCode" target="law:InCn">In Cn</ref> III 51</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="In Cn III 51" corresp="#wit-lat"><pb n="614" ed="#liebermann"/>In terra omnium secundum antiquam<ptr type="liebermannNote" n="g" target="#InCn_III-51.lnote.oe.g"/><ptr type="liebermannNote" n="8" target="#InCn_III-51.lnote.oe.8"/> consuetudinem fractę pacis<ptr type="liebermannNote" n="h" target="#InCn_III-51.lnote.oe.h"/> ęcclesię emendatio erit communiter<ptr type="liebermannNote" n="i" target="#InCn_III-51.lnote.oe.i"/> regis et episcopi.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 614 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-51.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">614</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">d. h. vor</hi> 1066; <hi rend="italic">vgl.</hi> III 53. 57. 60</seg><seg type="translation" xml:lang="en" source="#claude">i.e. before 1066; cf. III 53. 57. 60</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-51.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">614</biblScope></bibl><seg type="original" xml:lang="de">ciricgrið <hi rend="italic">oder</hi> mynstres griðbryce <hi rend="italic">I Cn.</hi> 3, 2</seg><seg type="translation" xml:lang="en" source="#claude">ciricgrið or mynstres griðbryce I Cn. 3, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-51.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">614</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 53. <hi rend="italic">Todtschläger in der Kirche zahlt Wergeld</hi> episcopo et regi <hi rend="italic">Hn</hi> 11, 1<hi rend="italic">a; der König erhält Strafgeld-Antheil bei sonstiger Verletzung des Rechtes der Kirche</hi> EGu. 4; Hn 11, 5; VIII Atr. 8. 15. 36; <hi rend="italic">bei Widerstand gegen Bischofsgebot</hi> EGu. Pr. 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. 53. A slayer in a church pays wergild episcopo et regi Hn 11, 1a; the king receives a share of the fine for other infringements of the rights of the Church EGu. 4; Hn 11, 5; VIII Atr. 8. 15. 36; for resistance to a bishop’s command EGu. Pr. 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-51.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">614</biblScope></bibl><seg type="original" xml:lang="de">c. a. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. a. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-51.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">333</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Kirchenfrieden 6a. 9; Kirchenstaatsrecht 16; Halbteilung 1; Bischof 7b-f; <hi rend="italic">s. o</hi>. Einl. 3. 9</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Kirchenfrieden 6a. 9; Kirchenstaatsrecht 16; Halbteilung 1; Bischof 7b-f; <hi rend="italic">see above</hi> Introduction 3. 9</seg></note>
      </div>
