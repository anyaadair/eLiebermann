      <div type="clause" n="59.4">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.4" corresp="#wit-lat"><pb n="578" ed="#liebermann"/>De peccunia etiam<ptr type="liebermannNote" n="5" target="#Hn_59-4.lnote.oe.5"/>, que pro pace<ptr type="liebermannNote" n="e" target="#Hn_59-4.lnote.oe.e"/> uel inimicitia<ptr type="liebermannNote" n="6" target="#Hn_59-4.lnote.oe.6"/> uadiata est, terminus<ptr type="liebermannNote" n="7" target="#Hn_59-4.lnote.oe.7"/> protelari non debet<ptr type="liebermannNote" n="8" target="#Hn_59-4.lnote.oe.8"/> nec placitum de morte<ptr type="liebermannNote" n="f" target="#Hn_59-4.lnote.oe.f"/> inimicorum — nisi<ptr type="liebermannNote" n="9" target="#Hn_59-4.lnote.oe.9"/> exercitus<ptr type="liebermannNote" n="10" target="#Hn_59-4.lnote.oe.10"/> [uel<ptr type="liebermannNote" n="11" target="#Hn_59-4.lnote.oe.11"/>] regia<ptr type="liebermannNote" n="12" target="#Hn_59-4.lnote.oe.12"/> neccessitas inpediat uel infirmitatis uel ydonee ueritatis aliquid occurrat<ptr type="liebermannNote" n="g" target="#Hn_59-4.lnote.oe.g"/> —, et tunc inter eos<ptr type="liebermannNote" n="h" target="#Hn_59-4.lnote.oe.h"/> firma pax et diffinita plenaque consistat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 578 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-4.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">Sühne und (= der) Fehde</seg><seg type="translation" xml:lang="en" source="#claude">settlement and (= of the) feud</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-4.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">Blutrache</seg><seg type="translation" xml:lang="en" source="#claude">blood-vengeance</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-4.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 59, 1<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 59, 1<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-4.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Sippe des ersten Mörders und Sippe des Rächers</hi></seg><seg type="translation" xml:lang="en" source="#claude">kindred of the first slayer and kindred of the avenger</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-4.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">autem <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">autem K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-4.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">-micia <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-micia Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-4.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">testes prothe. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">testes prothe. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-4.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">-ent <hi rend="italic">gegen Hss., Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ent against the MSS, Wi Tho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-4.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">nec <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">nec Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-4.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">excer. <hi rend="italic">Hss. oft</hi></seg><seg type="translation" xml:lang="en" source="#claude">excer. MSS often</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-4.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hss., ergänzt Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in MSS, supplied by Tho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-4.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">regi <hi rend="italic">gegen Hss. Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">regi against the MSS, Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-4.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Schiedsgericht 9—<hi rend="italic">uel</hi>{11} fehlt; viell <hi rend="italic">exercitūs regii?</hi>—<hi rend="italic">idonee</hi>—59, 4a <hi rend="italic">etiam</hi>{13} fehlt—<hi rend="italic">o. et</hi>{14} <hi rend="italic">ca</hi>.—<hi rend="italic">o. em</hi>.{15} ohne <hi rend="italic">uel emu</hi>.—59, 5 <hi rend="italic">respectetur s</hi>.{19} <hi rend="italic">q. p. o</hi>.—<hi rend="italic">Anglum</hi>{21}—59, 7 <hi rend="italic">huius</hi>{24}—<hi rend="italic">f. esse</hi>{25} <hi rend="italic">contendat</hi> besser Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Schiedsgericht 9—<hi rend="italic">uel</hi>{11} missing; perhaps <hi rend="italic">exercitūs regii?</hi>—<hi rend="italic">idonee</hi>—59, 4a <hi rend="italic">etiam</hi>{13} missing—<hi rend="italic">o. et</hi>{14} <hi rend="italic">ca</hi>.—<hi rend="italic">o. em</hi>.{15} without <hi rend="italic">uel emu</hi>.—59, 5 <hi rend="italic">respectetur s</hi>.{19} <hi rend="italic">q. p. o</hi>.—<hi rend="italic">Anglum</hi>{21}—59, 7 <hi rend="italic">huius</hi>{24}—<hi rend="italic">f. esse</hi>{25} <hi rend="italic">contendat</hi> better Rs</seg></note>
      </div>
