      <div type="clause" n="1.6">
        <head><ref type="lawCode" target="law:Af">Af</ref> 1.6</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.6" corresp="#wit-e"><pb n="48" ed="#liebermann"/>Gif he út oðfleo ær þam<ptr type="liebermannNote" n="20" target="#Af_1-6.lnote.oe.20"/> fierste<ptr type="liebermannNote" n="21" target="#Af_1-6.lnote.oe.21"/>, ⁊ hine mon gefó, sie<ptr type="liebermannNote" n="3" target="#Af_1-6.lnote.oe.3"/> he feowertig nihta on carcerne<ptr type="liebermannNote" n="22" target="#Af_1-6.lnote.oe.22"/>, swa he ǽr sceolde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.6" corresp="#wit-h"><pb n="48" ed="#liebermann"/>Gif he ut oðfleo ær þan fyrste, ⁊ hine man gefó, sy he XL nihta on carcerne, swa he ær sceolde.<ptr type="liebermannNote" n="2" target="#Af_1-6.lnote.oe.2"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.6" corresp="#wit-q"><pb n="49" ed="#liebermann"/>Si aufugiat ante terminum et item<ptr type="liebermannNote" n="9" target="#Af_1-6.lnote.oe.9"/> capiatur, sit XL noctibus in<ptr type="liebermannNote" n="10" target="#Af_1-6.lnote.oe.10"/> carcere, sicut<ptr type="liebermannNote" n="11" target="#Af_1-6.lnote.oe.11"/> antea<ptr type="liebermannNote" n="12" target="#Af_1-6.lnote.oe.12"/> debuerat.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="64" ed="#attenborough"/>Gif he út oðfleo ær þam fierste<ptr type="editorNote" n="2" target="#Af_1-6.attnote.fn.2"/>, ⁊ hine mon gefó, sie hé feowertig nihta on carcerne, swa he ǽr sceolde.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="1.6" corresp="#wit-e"><pb n="288" ed="#jurasinski-and-oliver"/>Gif he út oðfleo ær þam fierste, ⁊ hine mon gefó, sie he feowertig nihta on carcene, swa he ær sceolde.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="49" ed="#liebermann"/>Wenn er hinausflieht vor [dem Ende] der Frist, und man ihn einfängt, sei er 40 Nächte im Kerker, so wie er vorher [schon] gesollt hätte.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he escapes before [the end of] the term, and he is caught, let him be 40 nights in prison, just as he should have been before.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="65" ed="#attenborough"/>If he runs away before the term [of imprisonment is completed] and is recaptured, he shall remain in prison 40 days, as he ought to have done at first.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="410" ed="#whitelock"/>If he escapes before the end of the period, and he is caught, he is to be 40 days in prison, as he should have been before.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="289" ed="#jurasinski-and-oliver"/>If he escapes before the due time, and he is caught, let him be forty nights in prison, as he should have been before.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_1-6.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">48</biblScope></bibl><seg type="original" xml:lang="de">þæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_1-6.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">48</biblScope></bibl><seg type="original" xml:lang="de">fyrst <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fyrst So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_1-6.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">48</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_1-6.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">48</biblScope></bibl><seg type="original" xml:lang="de">cærc. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cærc. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_1-6.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">48</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">erstes</hi> e <hi rend="italic">übergeschrieben</hi></seg><seg type="translation" xml:lang="en" source="#claude">first e written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_1-6.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">49</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so häufig für</hi> iterum</seg><seg type="translation" xml:lang="en" source="#claude">thus frequently for iterum</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_1-6.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">49</biblScope></bibl><seg type="original" xml:lang="de">in c. <hi rend="italic">fehlt Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">in c. lacking in Dm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_1-6.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">49</biblScope></bibl><seg type="original" xml:lang="de">ut <hi rend="italic">Hk Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">ut Hk Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_1-6.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">49</biblScope></bibl><seg type="original" xml:lang="de">ante <hi rend="italic">Dm Brti Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">ante Dm Brti Lond</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_1-6.lnote.de.0" n="0" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">50</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o.</hi> 1, 2⁵</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 1, 2⁵</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_1-6.attnote.fn.2" n="2" source="#attenborough"><bibl><biblScope unit="page">64</biblScope></bibl><label>fierste</label><seg type="original" xml:lang="en"><hi rend="italic">þan fyrste</hi>. H.</seg></note>
      </div>
