    <body>
      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:AsAlm">As Alm</ref> 2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2" corresp="#wit-ld"><pb n="148" ed="#liebermann"/>⁊ gif se gereafa<ptr type="liebermannNote" n="1" target="#AsAlm_2.lnote.oe.1"/> ðis oferheald<ptr type="liebermannNote" n="1" target="#AsAlm_2.lnote.oe.1"/>, gebete XXX scill., ⁊ sie þ<hi rend="italic">æt</hi> feoh gedæled ðæm ðearfum ðe on ða<ptr type="liebermannNote" n="1" target="#AsAlm_2.lnote.oe.1"/> tun<ptr type="liebermannNote" n="1" target="#AsAlm_2.lnote.oe.1"/> synd, ðe ðis ungefremed wunie, on ðæs bisceopes gewitnesse.<ptr type="liebermannNote" n="2" target="#AsAlm_2.lnote.oe.2"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2" corresp="#wit-q"><pb n="148" ed="#liebermann"/>Et si prepositus hoc superteneat<ptr type="liebermannNote" n="16" target="#AsAlm_2.lnote.oe.16"/>, emendet triginta sol., et diuidatur hęc pecunia per testimonium episcopi pauperibus<ptr type="liebermannNote" n="17" target="#AsAlm_2.lnote.oe.17"/> qui in ipsa<ptr type="liebermannNote" n="18" target="#AsAlm_2.lnote.oe.18"/> uilla sunt<ptr type="liebermannNote" n="19" target="#AsAlm_2.lnote.oe.19"/>, ubi hoc non fuerit<ptr type="liebermannNote" n="20" target="#AsAlm_2.lnote.oe.20"/> executum.<ptr type="liebermannNote" n="21" target="#AsAlm_2.lnote.oe.21"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="2" corresp="#wit-ld"><pb n="126" ed="#attenborough"/>⁊ gif se gereafa ðis oferheald, gebete XXX scill., ⁊ sie þæt feoh gedæled ðæm ðearfum ðe on ða tun synd, ðe ðis ungefremed wunie, on ðæs bisceopes gewitnesse.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="149" ed="#liebermann"/>Und wenn der [königliche] Vogt dies versäumt, büsse er 30 Schill.<ptr type="liebermannNote" n="1" target="#AsAlm_2.lnote.de.1"/>, und werde dies Geld unter Zeugniss<ptr type="liebermannNote" n="2" target="#AsAlm_2.lnote.de.2"/> des Bischofs den Armen vertheilt, die in jenem Herrschaftsbezirke<ptr type="liebermannNote" n="3" target="#AsAlm_2.lnote.de.3"/> sind, wo dies unausgeführt geblieben ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if the [royal] reeve neglects this, let him pay 30 shillings in compensation, and let this money be distributed, under the witness of the bishop, to the poor who are in that estate where this has remained undone.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-ld"><pb n="127" ed="#attenborough"/>And if the reeve neglects [to do] this, he shall pay 30 shillings compensation, and the money shall be divided, with the cognisance of the bishop, among the poor who are on the estate where [this] remains unfulfilled.</ab>
        <note type="editorial">II As follows in both Ld and Quadr.</note>
        <note type="liebermannNote" subtype="textual" xml:id="AsAlm_2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">148</biblScope></bibl><seg type="original" xml:lang="de">supersedeat <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">supersedeat <hi rend="italic">T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="AsAlm_2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">148</biblScope></bibl><seg type="original" xml:lang="de">pauperioribus <hi rend="italic">R T</hi></seg><seg type="translation" xml:lang="en" source="#claude">pauperioribus <hi rend="italic">R T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="AsAlm_2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">148</biblScope></bibl><seg type="original" xml:lang="de">illa <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">illa <hi rend="italic">Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="AsAlm_2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">148</biblScope></bibl><seg type="original" xml:lang="de">erunt <hi rend="italic">R T;</hi> erint <hi rend="italic">M Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">erunt <hi rend="italic">R T;</hi> erint <hi rend="italic">M Hk</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="AsAlm_2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">148</biblScope></bibl><seg type="original" xml:lang="de">fuit <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">fuit <hi rend="italic">R</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="AsAlm_2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">148</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> II As.</seg><seg type="translation" xml:lang="en" source="#claude">followed by II As.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="AsAlm_2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">148</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="AsAlm_2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">148</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> II As.</seg><seg type="translation" xml:lang="en" source="#claude">followed by II As.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="AsAlm_2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">99</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Das kleine Strafgeldfixum (<hi rend="italic">s. d. Gl</hi> 7) in Wessex</seg><seg type="translation" xml:lang="en" source="#claude">The small fixed fine (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 7) in Wessex</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="AsAlm_2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">99</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o.</hi> 1⁷. Strafgeld gibt Armen VII Atr 2, 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 1⁷. VII Atr 2, 4 gives a fine to the poor</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="AsAlm_2.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">99</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Ländliche Ortschaft, Dorf, Herrschaftsgut; <hi rend="italic">s. d. Gl</hi> 1c. 5</seg><seg type="translation" xml:lang="en" source="#claude">Rural settlement, village, lord’s estate; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1c. 5</seg></note>
      </div>
