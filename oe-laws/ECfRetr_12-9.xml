    <body>
      <div type="clause" n="12.9">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 12.9</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 12.9"><pb n="639" ed="#liebermann"/>Chimini<ptr type="liebermannNote" n="15" target="#ECfRetr_12-9.lnote.la.15"/> <hi rend="bold">uero minores</hi><ptr type="liebermannNote" n="18" target="#ECfRetr_12-9.lnote.la.18"/> de ciuitate ad<ptr type="liebermannNote" n="19" target="#ECfRetr_12-9.lnote.la.19"/> ciuitates<ptr type="liebermannNote" n="20" target="#ECfRetr_12-9.lnote.la.20"/> <hi rend="bold">quosque</hi><ptr type="liebermannNote" n="21" target="#ECfRetr_12-9.lnote.la.21"/> <hi rend="bold">ducentes,</hi> de burgis ad burgos, per quos mercata <hi rend="bold">uehuntur et cetera</hi><ptr type="liebermannNote" n="22" target="#ECfRetr_12-9.lnote.la.22"/> negotia <hi rend="bold">fiunt</hi><ptr type="liebermannNote" n="23" target="#ECfRetr_12-9.lnote.la.23"/>, sub lege comitatus sunt<ptr type="liebermannNote" n="10" target="#ECfRetr_12-9.lnote.la.10"/>.</ab>
        <note type="comparison" source="#liebermann" n="639"><label>printed alongside</label> <ref target="clause:ECf_12-9">ECf 12.9</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 639 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">Liebermann’s footnote f, on the minor roads, is printed to ECf 12, 9; it is given here as well.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-9.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">Hauptstrassen (minores <hi rend="italic">in Retr. und</hi> 12, 11), <hi rend="italic">ausgenommen die vier in</hi> 12c. 12, 7. <hi rend="italic">Auch Normannisches Recht scheidet Haupt- und Nebenstrassen; Pollock-Maitland</hi> HEL. II 453 (<hi rend="italic">letztere unterstehen dem Gutseigner bei den Angelsachsen: Kemble</hi> Saxons II 94). <hi rend="italic">Anders nennt</hi> Hn 80, 3 <hi rend="italic">jede zu Städten führende Strasse</hi> uia regia</seg><seg type="translation" xml:lang="en" source="#claude">main roads (minores in the Retr. and 12, 11), except the four in 12c. 12, 7. Norman law too distinguishes main and minor roads; Pollock–Maitland, HEL. II 453 (among the Anglo-Saxons the latter are subject to the owner of the estate: Kemble, Saxons II 94). Hn 80, 3, on the other hand, calls every road leading to towns uia regia</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-9.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">chem. <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">chem. Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-9.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">de c. min. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">de c. min. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-9.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">Cb Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">in Cb Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-9.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">-tem <hi rend="italic">Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tem Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-9.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so;</hi> quousque <hi rend="italic">Cb K</hi></seg><seg type="translation" xml:lang="en" source="#claude">so; quousque Cb K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-9.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">certa <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">certa Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-9.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">fuerunt <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">fuerunt K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-9.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But the lesser highways, leading from city to whatever cities, from boroughs to boroughs, by which market wares are carried and other business is done, are under the law of the shire.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-9.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">345</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fuerunt</hi><hi rend="superscript">28</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">fuerunt</hi><hi rend="superscript">28</hi> Rs</seg></note>
      </div>
    </body>
  </text>
