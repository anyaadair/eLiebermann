      <div type="clause" n="II Cn 65">
        <head>Quadr Rb II Cn 65</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Rb II Cn 65" corresp="#wit-lat"><pb n="538" ed="#liebermann"/><ptr type="liebermannNote" n="23" target="#Quadr-Rb_II-Cn-65.lnote.la.23"/>Si quis burhbotam<ptr type="liebermannNote" n="24" target="#Quadr-Rb_II-Cn-65.lnote.la.24"/> <ptr type="liebermannNote" n="a" target="#Quadr-Rb_II-Cn-65.lnote.la.fn.a"/>(uel<ptr type="liebermannNote" n="25" target="#Quadr-Rb_II-Cn-65.lnote.la.25"/> brigbotam uel ferdfare) supersedeat<ptr type="liebermannNote" n="26" target="#Quadr-Rb_II-Cn-65.lnote.la.26"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 538 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">If anyone neglects <hi rend="italic">burhbot</hi> (or <hi rend="italic">brigbot</hi> or <hi rend="italic">fyrdfaru</hi> (going on military service)).</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-65.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de">De burhbota et brucbota <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">De burhbota et brucbota R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-65.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de">burb. <hi rend="italic">T;</hi> burgb. <hi rend="italic">HkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">burb. T; burgb. HkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-65.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. S</hi> 537<hi rend="superscript">c</hi></seg><seg type="translation" xml:lang="en" source="#claude">see p. 537, note c</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-65.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de">u. b. u. f. <hi rend="italic">nur aus Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. b. u. f. only from Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-65.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de">-sederit <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sederit Br</seg></note>
      </div>
