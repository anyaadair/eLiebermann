    <body>
      <div type="clause" n="59[c]">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 59[c]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="59[c]" corresp="#wit-e"><pb n="116" ed="#liebermann"/>oxan eage bið<ptr type="liebermannNote" n="2" target="#Ine_59-c.lnote.oe.2"/> V<ptr type="liebermannNote" n="6" target="#Ine_59-c.lnote.oe.6"/> p.<ptr type="liebermannNote" n="7" target="#Ine_59-c.lnote.oe.7"/> weorð, cus<ptr type="liebermannNote" n="8" target="#Ine_59-c.lnote.oe.8"/> bið<ptr type="liebermannNote" n="2" target="#Ine_59-c.lnote.oe.2"/> scill. weorþ.<ptr type="liebermannNote" n="9" target="#Ine_59-c.lnote.oe.9"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="59[c]" corresp="#wit-h"><pb n="116" ed="#liebermann"/>oxan eage bið V peninga weorð, cú bið scillinges.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="59[c]" corresp="#wit-q"><pb n="117" ed="#liebermann"/>bouis oculus quinque den. componendus est, uacce<ptr type="liebermannNote" n="4" target="#Ine_59-c.lnote.oe.4"/> I<ptr type="liebermannNote" n="5" target="#Ine_59-c.lnote.oe.5"/> sol.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="56" ed="#attenborough"/>oxan eage bið V p[eninga]<ptr type="editorNote" n="8" target="#Ine_59-c.attnote.fn.8"/> weorð, cus bið scill. weorþ.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="62.3" corresp="#wit-e"><pb n="422" ed="#jurasinski-and-oliver"/>oxan eage bið V pæ<hi rend="italic">ninga</hi> weorð, cus bið sciƚƚ weorð.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="117" ed="#liebermann"/>eines Ochsen Auge ist 5 Pfennig werth, das einer Kuh ist 1<ptr type="liebermannNote" n="5" target="#Ine_59-c.lnote.de.5"/> Schill. werth.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">an ox’s eye is worth 5 pence, that of a cow is worth 1 shilling.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="57" ed="#attenborough"/>The eye of an ox is worth 5 pence and a cow's is worth a shilling.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="423" ed="#jurasinski-and-oliver"/>An ox eye is worth 5 shillings, a cow’s is worth a shilling.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-c.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">117</biblScope></bibl><seg type="original" xml:lang="de">V den.; bouis oculus V den. componendum est; uacce <hi rend="italic">wiederholt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">V den.; bouis oculus V den. componendum est; uacce repeated by Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-c.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">117</biblScope></bibl><seg type="original" xml:lang="de">unum <hi rend="italic">Or; auf Rasur Co;</hi> VIII <hi rend="italic">K;</hi> XII den. <hi rend="italic">M Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">unum Or; on an erasure Co; VIII K; XII den. M Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-c.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de">beoð <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">beoð So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-c.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de">fif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-c.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de">peninga <hi rend="italic">So;</hi> peninge wyrþe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">peninga So; peninge wyrþe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-c.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de">eage <hi rend="italic">fügt zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">eage added by Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_59-c.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">116</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt So;</hi> wyrþe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in So; wyrþe Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_59-c.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">78</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Weshalb wechselt Ine im Ausdruck Eines Wertes zwischen 1 Schill. und 5 Pf.? — Die Lex Ribuaria verlangt, wo Wergeld in Ochsen bezahlt wird, diese ungeblendet. Verstümmelten die barbarischen Viehhalter ihr Arbeitsvieh im Zorn, wie das Strafrecht kalten Blutes den Menschen?</seg><seg type="translation" xml:lang="en" source="#claude">Why does Ine, in expressing one and the same value, alternate between 1 shill. and 5 pence? — Where wergild is paid in oxen, the Lex Ribuaria requires them not to have been blinded. Did the barbarian stock-keepers mutilate their working animals in anger, as the criminal law mutilated human beings in cold blood?</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_59-c.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">56</biblScope></bibl><label>p[eninga</label><seg type="original" xml:lang="en">H &amp; B.</seg></note>
      </div>
    </body>
