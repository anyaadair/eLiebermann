      <div type="clause" n="3.3">
        <head><ref type="lawCode" target="law:IIAtr">II Atr</ref> 3.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.3" corresp="#wit-b"><pb n="222" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="8" target="#IIAtr_3-3.lnote.oe.8"/> he his æhta bere geman<ptr type="liebermannNote" n="16" target="#IIAtr_3-3.lnote.oe.16-2"/> ðara unfriðmanna æhta into huse<ptr type="liebermannNote" n="17" target="#IIAtr_3-3.lnote.oe.17"/>, ðolie his æhta ⁊ æbbe<ptr type="liebermannNote" n="2" target="#IIAtr_3-3.lnote.oe.2"/> sylf frið ⁊ feorh, gif he hine cyðe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.3" corresp="#wit-q"><pb n="222" ed="#liebermann"/>Si pecuniam suam inter<ptr type="liebermannNote" n="14" target="#IIAtr_3-3.lnote.oe.14"/> pecuniam unfriðmannorum<ptr type="liebermannNote" n="15" target="#IIAtr_3-3.lnote.oe.15"/> (id est pacem non habentium) mittat in domo, perdat pecuniam suam, et ipse tamen pacem et<ptr type="liebermannNote" n="16" target="#IIAtr_3-3.lnote.oe.16"/> uitam habeat, si se manifestet.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="3.3" corresp="#wit-b"><pb n="58" ed="#robertson"/>Gyf he his æhta bere geman ðara unfriðmanna æhta into huse, ðolie his æhta, ⁊ æbbe sylf frið ⁊ feorh, gif he hine cyðe.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="223" ed="#liebermann"/>Wenn er [dagegen] seine Güter mitten<ptr type="liebermannNote" n="1" target="#IIAtr_3-3.lnote.de.1"/> unter Gütern jener ausserhalb dieses Friedensvertrages [stehenden<ptr type="liebermannNote" n="2" target="#IIAtr_3-3.lnote.de.2"/>] Leute in ein Haus trägt, verliere er [zwar] seine Güter, habe aber selbst, wofern er sich zu erkennen giebt, Friedensschutz und Leben [vor diesem Heere sicher].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If [on the other hand] he carries his goods into a house among the goods of those people [standing] outside this peace-treaty, let him lose his goods, but himself have protection and [keep his] life [safe from this army], if he makes himself known.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="59" ed="#robertson"/>If he bears his goods into a house in common with those of the men not included in the truce<ptr type="editorNote" n="1" target="#IIAtr_3-3.robnote.n.0"/>, he shall forfeit his goods, but he himself shall have protection and his life [shall be spared], if he makes himself known.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-b"><pb n="442" ed="#whitelock"/>If he brings his goods into a house among the goods of men outside the truce, he is to forfeit his goods, but himself to have peace and his life, if he announces himself.</ab>
        <note type="editorial">B's ‘geman’ should be corrected to ‘gemang’ (Liebermann).</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_3-3.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">222</biblScope></bibl><seg type="original" xml:lang="de">cum pecunia <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">cum pecunia MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_3-3.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">222</biblScope></bibl><seg type="original" xml:lang="de">infriðmanni i. p. n. habentis <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">infriðmanni i. p. n. habentis MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_3-3.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">222</biblScope></bibl><seg type="original" xml:lang="de">h. et u. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. et u. T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_3-3.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">222</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_3-3.lnote.oe.16-2" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">222</biblScope></bibl><seg type="original" xml:lang="de">-ne <hi rend="italic">Ld; bessere</hi> gemang</seg><seg type="translation" xml:lang="en" source="#claude">-ne Ld; read gemang</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_3-3.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">222</biblScope></bibl><seg type="original" xml:lang="de">hûs <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hûs Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_3-3.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">222</biblScope></bibl><seg type="original" xml:lang="de">hæb. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hæb. Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAtr_3-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">152</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘gemeinschaftlich mit’; eine Präposition <hi rend="italic">gemân</hi>, wie Frühere lesen, gibt es nicht; <hi rend="italic">gemang</hi> mit acc. <hi rend="italic">s</hi>. Toller</seg><seg type="translation" xml:lang="en" source="#claude">‘together with’; there is no preposition <hi rend="italic">gemân</hi>, as earlier editors read; for <hi rend="italic">gemang</hi> with acc. <hi rend="italic">see</hi> Toller</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAtr_3-3.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">152</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Q übersetzt hier richtig, Schmid falsch ‘Friedloser’; <hi rend="italic">s. o</hi>. 2³</seg><seg type="translation" xml:lang="en" source="#claude">Q translates correctly here, Schmid wrongly ‘outlaw’; <hi rend="italic">see above</hi> 2³</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIAtr_3-3.robnote.n.0" n="0" source="#robertson"><bibl><biblScope unit="page">316</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">unfriðmanna</hi>, cf. cap. 2 and note.</seg></note>
      </div>
