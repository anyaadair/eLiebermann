      <div type="clause" n="43.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 43.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 43.1" corresp="#wit-lat"><pb n="569" ed="#liebermann"/>Nemo a<ptr type="liebermannNote" n="6" target="#Hn_43-1.lnote.oe.6"/> rege inplacitatus cogitur per legem alicui respondere, donec ei qui dominus<ptr type="liebermannNote" n="7" target="#Hn_43-1.lnote.oe.7"/> omnium est satisfecerit. Si[c<ptr type="liebermannNote" n="8" target="#Hn_43-1.lnote.oe.8"/>] potest<ptr type="liebermannNote" n="a" target="#Hn_43-1.lnote.oe.a"/> ei warantus<ptr type="liebermannNote" n="9" target="#Hn_43-1.lnote.oe.9"/> esse<ptr type="liebermannNote" n="b" target="#Hn_43-1.lnote.oe.b"/>, qui in seruicio suo est.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 569 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">rex: <hi rend="italic">zu</hi> warantus <hi rend="italic">vgl.</hi> 82, 6. 85, 2</seg><seg type="translation" xml:lang="en" source="#claude">rex: on warantus cf. 82, 6. 85, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">per seruitium regis se essoniat <hi rend="italic">Glanvilla</hi> I 27</seg><seg type="translation" xml:lang="en" source="#claude">per seruitium regis se essoniat Glanvilla I 27</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">agere, <hi rend="italic">vom Corr. verb.</hi> a rere <hi rend="italic">Sc;</hi> a rege <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">agere, corrected by the corrector from a rere Sc; a rege Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">o. d. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">o. d. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">Si <hi rend="italic">Hss.; gebessert Edd.; vgl. S.</hi> 570&lt;sup&gt;29&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude">Si MSS; emended Edd.; cf. p. 570&lt;sup&gt;29&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">warantatus <hi rend="italic">K Co Or Sl Tw</hi></seg><seg type="translation" xml:lang="en" source="#claude">warantatus K Co Or Sl Tw</seg></note>
