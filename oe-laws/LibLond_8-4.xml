      <div type="clause" n="8.4">
        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 8.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 8.4" corresp="#wit-lat"><pb n="675" ed="#liebermann"/>Et si pannos de seta<ptr type="liebermannNote" n="5" target="#LibLond_8-4.lnote.oe.5"/> uel de<ptr type="liebermannNote" n="6" target="#LibLond_8-4.lnote.oe.6"/> lana uel de<ptr type="liebermannNote" n="6" target="#LibLond_8-4.lnote.oe.6"/> lino attulerit, uideat ne incidat<ptr type="liebermannNote" n="7" target="#LibLond_8-4.lnote.oe.7"/>, sed integros<ptr type="liebermannNote" n="ii" target="#LibLond_8-4.lnote.oe.ii"/> uendat<ptr type="liebermannNote" n="k" target="#LibLond_8-4.lnote.oe.k"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 675 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-4.lnote.oe.ii" n="ii" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 8, 1{u}</seg><seg type="translation" xml:lang="en" source="#claude">see above 8, 1{u}</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-4.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">uel alia aueria (<hi rend="italic">Waaren</hi>), ponderibus suptilibus exceptis, non minus quam I quaternum uendat <hi rend="italic">fügt zu Douai</hi></seg><seg type="translation" xml:lang="en" source="#claude">Douai adds uel alia aueria (goods), ponderibus suptilibus exceptis, non minus quam I quaternum uendat</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-4.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">seia <hi rend="italic">PlS;</hi> serico <hi rend="italic">Co Horn Alb Cons</hi></seg><seg type="translation" xml:lang="en" source="#claude">seia PlS; serico Co Horn Alb Cons</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-4.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt PlS Cons</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in PlS Cons</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-4.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">eos <hi rend="italic">fügt zu Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">Horn adds eos</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_8-4.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Seide; Tuch 4; Wachs; London 37. d</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Seide; Tuch 4; Wachs; London 37. d</seg></note>
      </div>
