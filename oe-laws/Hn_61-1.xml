        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 61.1" corresp="#wit-lat"><pb n="581" ed="#liebermann"/>Si dominus inter<ptr type="liebermannNote" n="10" target="#Hn_61-1.lnote.oe.10"/> prepositum et sibi subditos<ptr type="liebermannNote" n="11" target="#Hn_61-1.lnote.oe.11"/> placitum condicat<ptr type="liebermannNote" n="12" target="#Hn_61-1.lnote.oe.12"/>: qui sine legittima racione remanserit nichilominus, causam suam perdat<ptr type="liebermannNote" n="cc" target="#Hn_61-1.lnote.oe.cc"/> et ouerseunessam<ptr type="liebermannNote" n="13" target="#Hn_61-1.lnote.oe.13"/> domini<ptr type="liebermannNote" n="d" target="#Hn_61-1.lnote.oe.d"/> emendet.</ab>
