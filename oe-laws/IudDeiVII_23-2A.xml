      <div type="clause" n="23.2A">
        <head><ref type="lawCode" target="law:IudDeiVII">Iud Dei VII</ref> 23.2A</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei VII 23.2A" corresp="#wit-ci"><pb n="414" ed="#liebermann"/>Ic halsige þe<ptr type="liebermannNote" n="12" target="#IudDeiVII_23-2A.lnote.oe.12"/> (eow<ptr type="liebermannNote" n="4" target="#IudDeiVII_23-2A.lnote.oe.4"/>) þurh þa þrý cnihtas, þe dæghwa<hi rend="italic">m</hi>lice beforan Gode standað, Sidrac, Misac et Abdenago, ⁊ þurh heondteontig<ptr type="liebermannNote" n="13" target="#IudDeiVII_23-2A.lnote.oe.13"/> ⁊ feower ⁊ feowertig þusendu martira, þe for Cristes naman þrowudon, ⁊ þurh s<hi rend="italic">anct</hi>a Marian ures drihnes<ptr type="liebermannNote" n="5" target="#IudDeiVII_23-2A.lnote.oe.5"/> modor hælendes<ptr type="liebermannNote" n="6" target="#IudDeiVII_23-2A.lnote.oe.6"/> Cristes:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 414 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-2A.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">‘dazu beistimmtest’ nicht in Vt, obwohl aus Latein</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘consented thereto’ not in Vt, although from the Latin</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-2A.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">in anderer Hand über</hi> hwa; <hi rend="italic">aber</hi> it <hi rend="italic">soll</hi> hyt <hi rend="italic">ersetzen</hi></seg><seg type="translation" xml:lang="en" source="#claude">in another hand above hwa; but it is meant to replace hyt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-2A.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ähnlich</hi> XIII 13, 1. VIII 2</seg><seg type="translation" xml:lang="en" source="#claude">similarly XIII 13, 1. VIII 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-2A.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-2A.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">für</hi> drihtnes <hi rend="italic">auch</hi> 23, 2 <hi rend="italic">A; Sievers</hi> § 196, 3</seg><seg type="translation" xml:lang="en" source="#claude">for drihtnes; also 23, 2 A; Sievers § 196, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-2A.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de">hælend <hi rend="italic">für</hi> Iesus <hi rend="italic">auch</hi> IV 2²⁹</seg><seg type="translation" xml:lang="en" source="#claude">hælend for Iesus also IV 2²⁹</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-2A.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de">þe þurh <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">þe þurh written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-2A.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
      </div>
    </body>
