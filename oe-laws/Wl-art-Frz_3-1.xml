    <body>
      <div type="clause" n="3.1">
        <head>Wl art Frz 3.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-cu"><pb n="488" ed="#liebermann"/>E si nuls de ceals fust ocis, li sires al<ptr type="liebermannNote" n="d" target="#Wl-art-Frz_3-1.lnote.oe.d"/> homicide eat<ptr type="liebermannNote" n="e" target="#Wl-art-Frz_3-1.lnote.oe.e"/> celui, si il put, dedenz les cinc jors. E si il ne pot, si come<hi rend="italic">n</hi>crat<ptr type="liebermannNote" n="3" target="#Wl-art-Frz_3-1.lnote.oe.3"/> a rendre al rey quarante e cinc<ptr type="liebermannNote" n="f" target="#Wl-art-Frz_3-1.lnote.oe.f"/> mars de argent, si tant pot atendre sun chatel.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 488 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Wl-art-Frz_3-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Wl-art-Frz_3-1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Fehler: des Ermordeten Herrn meint</hi> Wl art. 3</seg><seg type="translation" xml:lang="en" source="#claude">error: Wl art. 3 means the lord of the murdered man</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Wl-art-Frz_3-1.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> seat <hi rend="italic">für</hi> set (&gt; septem) <hi rend="italic">im Lambspringer</hi> Alex. <hi rend="italic">Str.</hi> 115b <hi rend="italic">SUCHIER</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. seat for set (&gt; septem) in the Lambspringer Alex. stanza 115b SUCHIER</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Wl-art-Frz_3-1.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">statt</hi> VI</seg><seg type="translation" xml:lang="en" source="#claude">instead of VI</seg></note>
      </div>
