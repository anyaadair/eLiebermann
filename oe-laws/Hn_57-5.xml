      <div type="clause" n="57.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 57.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 57.5" corresp="#wit-lat"><pb n="576" ed="#liebermann"/>Si quis in curia sua rectum de hominibus suis facturus sit, nominentur<ptr type="liebermannNote" n="14" target="#Hn_57-5.lnote.oe.14"/> ei qui inplacitantur<ptr type="liebermannNote" n="k" target="#Hn_57-5.lnote.oe.k"/>; et competenti<ptr type="liebermannNote" n="15" target="#Hn_57-5.lnote.oe.15"/> termino<ptr type="liebermannNote" n="16" target="#Hn_57-5.lnote.oe.16"/> satisfaccionem habeant<ptr type="liebermannNote" n="l" target="#Hn_57-5.lnote.oe.l"/><ptr type="liebermannNote" n="17" target="#Hn_57-5.lnote.oe.17"/>; nec perdat curiam nec<ptr type="liebermannNote" n="18" target="#Hn_57-5.lnote.oe.18"/> socnam suam, quamdiu non difforciauerit rectum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 576 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-5.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">die verklagten Leute des Gerichtsherrn</hi></seg><seg type="translation" xml:lang="en" source="#claude">the men of the lord of the court who are accused</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-5.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">die Kläger</hi> (<hi rend="italic">oder bessere:</hi> [<hi rend="italic">Verklagte</hi>] ad sat. habeantur <hi rend="italic">oder</hi> habeat)</seg><seg type="translation" xml:lang="en" source="#claude">the plaintiffs (or read: [the accused] ad sat. habeantur or habeat)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-5.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">-netur <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-netur Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-5.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">compenti <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">compenti K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-5.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">testimonio <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">testimonio Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-5.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">debeantur <hi rend="italic">Lond;</hi> debeant <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">debeantur Lond; debeant Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-5.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-5.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">satisfaccioni habeantur</hi> Rs, nämlich Beklagte durch deren Gerichtsherrn zur Genugtuung, wie ich vorschlug. <hi rend="italic">Vgl. Gl</hi> Justizweigerung 4—<hi rend="italic">uel</hi>{18}—57, 6 <hi rend="italic">crau</hi>.{24} gebessert aus <hi rend="italic">curu</hi>. Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">satisfaccioni habeantur</hi> Rs, that is, the accused [are to be held] to satisfaction by their lord of the court, as I proposed. <hi rend="italic">Cf. Gl</hi> Justizweigerung 4—<hi rend="italic">uel</hi>{18}—57, 6 <hi rend="italic">crau</hi>.{24} corrected from <hi rend="italic">curu</hi>. Rs</seg></note>
      </div>
