  <text>
    <body>
      <div type="clause" n="15">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 15</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 15"><pb n="641" ed="#liebermann"/><ptr type="liebermannNote" n="1" target="#ECf_15.lnote.la.1"/><hi rend="spaced">Lex murdrorum<ptr type="liebermannNote" n="2" target="#ECf_15.lnote.la.2"/>.</hi> Quando aliquis<ptr type="liebermannNote" n="a" target="#ECf_15.lnote.oe.erkl-a"/> alicubi murdratus<ptr type="liebermannNote" n="3" target="#ECf_15.lnote.la.3"/> reperiebatur, querebatur apud uillam, ubi<ptr type="liebermannNote" n="4" target="#ECf_15.lnote.la.4"/> inueniebatur<ptr type="liebermannNote" n="5" target="#ECf_15.lnote.la.5"/>, interfector illius; et si inueniri poterat<ptr type="liebermannNote" n="6" target="#ECf_15.lnote.la.6"/>, iusticie<ptr type="liebermannNote" n="7" target="#ECf_15.lnote.la.7"/> regis infra<ptr type="liebermannNote" n="8" target="#ECf_15.lnote.la.8"/> octo<ptr type="liebermannNote" n="a" target="#ECf_15.lnote.la.fn.a"/> dies interfectionis<ptr type="liebermannNote" n="9" target="#ECf_15.lnote.la.9"/> tradebatur.</ab>
        <note type="comparison" source="#liebermann" n="641"><label>printed alongside</label> <ref target="clause:ECfRetr_15">ECf retr 15</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 641 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">eine Woche (<hi rend="italic">gegen</hi> Wl art. 3, 1) <hi rend="italic">auch</hi> Leis Wl 22 <hi rend="italic">und</hi> Hn 13, 2. 75, 6a. 91, 1. 92, 3; 5</seg><seg type="translation" xml:lang="en" source="#claude">one week (against Wl art. 3, 1) also Leis Wl 22 and Hn 13, 2. 75, 6a. 91, 1. 92, 3; 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">De interfect.’ et lege murdrorum <hi rend="italic">Hr; Rb. fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">De interfect.’ et lege murdrorum Hr; the rubric is lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-drar. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-drar. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-dritus <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dritus S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">nisi <hi rend="italic">S;</hi> ut inueniretur <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">nisi S; ut inueniretur Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">int. il. reperiebatur <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">int. il. reperiebatur Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-rit <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rit Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">domini <hi rend="italic">fügt zu Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad Do add domini</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">post <hi rend="italic">Hk;</hi> ipsos <hi rend="italic">fügt zu Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">post Hk; Hr adds ipsos</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr Ad Do</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">The law of murders (<hi rend="italic">murdra</hi>: secret killings and the fines for them). When anyone was found murdered anywhere, his slayer was sought at the vill where he was found; and if he could be found, he was handed over to the king's justice within eight days of the killing.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">346</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Murdrum 11c; Dorf 2c—3b; [die Englishry (<hi rend="italic">s. d. Gl</hi>) fehlt zwar ECf; dass aber Ermordeter Fremder sein musste, folgt aus <hi rend="italic">albani</hi> 15, 7 und mittelbar aus Engl. Nationalität des Mörders 16, 2<hi rend="superscript">d</hi>]; Königsrichter 16</seg><seg type="translation" xml:lang="en" source="#claude">Cf. Gl Murdrum 11c; Dorf 2c—3b; [Englishry (s. Gl s.v.) is indeed absent from ECf; but that the murdered man had to be a foreigner follows from <hi rend="italic">albani</hi> 15, 7 and indirectly from the English nationality of the killer 16, 2<hi rend="superscript">d</hi>]; Königsrichter 16</seg></note>
      </div>
    </body>
