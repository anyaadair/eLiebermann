        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="63" corresp="#wit-h"><pb n="27" ed="#liebermann"/>CVII. Be gesiþcundes monnes<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_63.lnote.oe.1-3"/> fære.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="63" corresp="#wit-q"><pb n="27" ed="#liebermann"/>De<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_63.lnote.oe.1-2"/> discessu syðcundi hominis.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="214" ed="#jurasinski-and-oliver"/>CVII Be gesiðcundes monnes fære</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="214" ed="#jurasinski-and-oliver"/>Be gesiðcundes mannes fare</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="27" ed="#liebermann"/>Über Fortziehen eines Mannes von Gefolgsstande.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning the departure of a man of the retainer class.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="215" ed="#jurasinski-and-oliver"/>Concerning the departure of a nobly born man</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="215" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_63.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">26</biblScope></bibl><seg type="original" xml:lang="de">fare <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fare Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_63.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">27</biblScope></bibl><seg type="original" xml:lang="de">Si syðcundus homo mutet mansionem <hi rend="italic">Hk</hi>; De homine siðcundo mutante m. suam <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Si syðcundus homo mutet mansionem Hk; De homine siðcundo mutante m. suam Br</seg></note>
