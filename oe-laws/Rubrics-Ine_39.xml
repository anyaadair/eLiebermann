      <div type="clause" n="39">
        <head>Ine Rb 39</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="39" corresp="#wit-e"><pb n="22" ed="#liebermann"/>LXXXIII. Be unalefedu<hi rend="italic">m<ptr type="liebermannNote" n="18" target="#Rubrics-Ine_39.lnote.oe.18"/></hi> fære from his hlaforde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="39" corresp="#wit-g-prol"><pb n="22" ed="#liebermann"/>LXXXIII. Be únalyfedu<hi rend="italic">m</hi> fære fra<hi rend="italic">m</hi> his hlaforde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="39" corresp="#wit-h"><pb n="23" ed="#liebermann"/>LXXXIII. Be unagelyfedu<hi rend="italic">m<ptr type="liebermannNote" n="26" target="#Rubrics-Ine_39.lnote.oe.26"/></hi> fære from<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_39.lnote.oe.2"/> his hlaforde.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="39" corresp="#wit-q"><pb n="23" ed="#liebermann"/>De inconcessa<ptr type="liebermannNote" n="32" target="#Rubrics-Ine_39.lnote.oe.32"/> discessione a domino.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="208" ed="#jurasinski-and-oliver"/>LXXXIII Be unalefedum fære from his hlaforde</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="208" ed="#jurasinski-and-oliver"/>Be unalyfedum fare fram his laforde</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="23" ed="#liebermann"/>Über unerlaubten<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_39.lnote.de.1"/> Fortzug von jemandes Herrn.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning unpermitted departure from one’s lord.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="209" ed="#jurasinski-and-oliver"/>Concerning departure from his lord without permission</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="209" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_39.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de">unalyf. f. fram his hlaford <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">unalyf. f. fram his hlaford Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_39.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">discedente a do. suo sine licentia <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">discedente a do. suo sine licentia Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_39.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_39.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_39.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Das unmögliche <hi rend="italic">unagelyfed</hi> in H entstand wohl so, dass H <hi rend="italic">a</hi>- des Archetyps in <hi rend="italic">ge</hi>- ändern wollte, wie denn öfter, auch bei H, das Präfix <hi rend="italic">a</hi>- (<hi rend="italic">s. d. Wb</hi> II und <hi rend="italic">aliesan</hi>) später schwindet, aber jenes zu streichen vergass</seg><seg type="translation" xml:lang="en" source="#claude">The impossible <hi rend="italic">unagelyfed</hi> in H probably arose in this way: H meant to change the archetype’s <hi rend="italic">a</hi>- to <hi rend="italic">ge</hi>- (as indeed the prefix <hi rend="italic">a</hi>- [<hi rend="italic">see</hi> that word in <hi rend="italic">Wb</hi> II and <hi rend="italic">aliesan</hi>] often disappears later, in H too), but forgot to delete the former</seg></note>
      </div>
    </body>
