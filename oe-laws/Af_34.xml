      <div type="clause" n="34">
        <head><ref type="lawCode" target="law:Af">Af</ref> 34</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="34" corresp="#wit-e"><pb n="68" ed="#liebermann"/>XXXI. Éac is ciepemonnum<ptr type="liebermannNote" n="1" target="#Af_34.lnote.oe.1"/> gereht<ptr type="liebermannNote" n="2" target="#Af_34.lnote.oe.2"/>: ða men ðe<ptr type="liebermannNote" n="3" target="#Af_34.lnote.oe.3"/> hie<ptr type="liebermannNote" n="4" target="#Af_34.lnote.oe.4"/> up mid him<ptr type="liebermannNote" n="5" target="#Af_34.lnote.oe.5"/> læden, gebrengen<ptr type="liebermannNote" n="6" target="#Af_34.lnote.oe.6"/> beforan kyninges<ptr type="liebermannNote" n="7" target="#Af_34.lnote.oe.7"/> gerefan on folcgemote, ⁊ gerecce hu manige<ptr type="liebermannNote" n="8" target="#Af_34.lnote.oe.8"/> þara sien<ptr type="liebermannNote" n="9" target="#Af_34.lnote.oe.9"/>; ⁊ hie<ptr type="liebermannNote" n="4" target="#Af_34.lnote.oe.4"/> nimen<ptr type="liebermannNote" n="10" target="#Af_34.lnote.oe.10"/> þa men mid him<ptr type="liebermannNote" n="11" target="#Af_34.lnote.oe.11"/> þe hie mægen<ptr type="liebermannNote" n="12" target="#Af_34.lnote.oe.12"/> eft to folcgemote to ryhte<ptr type="liebermannNote" n="13" target="#Af_34.lnote.oe.13"/> brengan<ptr type="liebermannNote" n="14" target="#Af_34.lnote.oe.14"/>; ⁊ þon<hi rend="italic">ne</hi> him<ptr type="liebermannNote" n="15" target="#Af_34.lnote.oe.15"/> ðearf sie ma manna<ptr type="liebermannNote" n="16" target="#Af_34.lnote.oe.16"/> úp mid him<ptr type="liebermannNote" n="17" target="#Af_34.lnote.oe.17"/> to habbanne<ptr type="liebermannNote" n="18" target="#Af_34.lnote.oe.18"/> on hiora<ptr type="liebermannNote" n="19" target="#Af_34.lnote.oe.19"/> fore, gecyðe<ptr type="liebermannNote" n="20" target="#Af_34.lnote.oe.20"/> symle<ptr type="liebermannNote" n="21" target="#Af_34.lnote.oe.21"/>, swa óft swa him<ptr type="liebermannNote" n="22" target="#Af_34.lnote.oe.22"/> ðearf sie<ptr type="liebermannNote" n="23" target="#Af_34.lnote.oe.23"/>, in<ptr type="liebermannNote" n="24" target="#Af_34.lnote.oe.24"/> gemotes gewitnesse<ptr type="liebermannNote" n="25" target="#Af_34.lnote.oe.25"/> cyninges gerefan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="34" corresp="#wit-h"><pb n="68" ed="#liebermann"/>XXXI. Eac is cypemannum<ptr type="liebermannNote" n="1" target="#Af_34.lnote.oe.1-2"/> gereht: ða men þe hy<ptr type="liebermannNote" n="2" target="#Af_34.lnote.oe.2-2"/> up mid heo<hi rend="italic">m<ptr type="liebermannNote" n="3" target="#Af_34.lnote.oe.3-2"/></hi> lædan<ptr type="liebermannNote" n="4" target="#Af_34.lnote.oe.4-2"/>, gebringe<ptr type="liebermannNote" n="5" target="#Af_34.lnote.oe.5-2"/> beforan cyninges gerefan on folcgemote, ⁊ gerecce<ptr type="liebermannNote" n="5" target="#Af_34.lnote.oe.5-2"/> hu monige ðæra<ptr type="liebermannNote" n="6" target="#Af_34.lnote.oe.6-2"/> syn<ptr type="liebermannNote" n="2" target="#Af_34.lnote.oe.2-2"/>; ⁊ hy<ptr type="liebermannNote" n="2" target="#Af_34.lnote.oe.2-2"/> nimen ða men up mid him þe hy<ptr type="liebermannNote" n="2" target="#Af_34.lnote.oe.2-2"/> magon<ptr type="liebermannNote" n="7" target="#Af_34.lnote.oe.7-2"/> eft to folcgemote<ptr type="liebermannNote" n="8" target="#Af_34.lnote.oe.8-2"/> to ryhte brengan; ⁊ þonne him þearf sy ma manna<ptr type="liebermannNote" n="9" target="#Af_34.lnote.oe.9-2"/> up mid him to habbanne to heora<ptr type="liebermannNote" n="10" target="#Af_34.lnote.oe.10-2"/> fore, gecyðe simle, swa oft swa him ðearf sy<ptr type="liebermannNote" n="2" target="#Af_34.lnote.oe.2-2"/>, on gemotes gewitnesse cyninges gerefan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="34" corresp="#wit-b-no-prol"><pb n="69" ed="#liebermann"/>Be cypmannum. Eac is cypemonnu<hi rend="italic">m</hi> g<hi rend="italic">e</hi>reht<ptr type="liebermannNote" n="1" target="#Af_34.lnote.oe.1-4"/>: ða m<hi rend="italic">en</hi> þe hi up mid heo<hi rend="italic">m</hi> lædan<ptr type="liebermannNote" n="2" target="#Af_34.lnote.oe.2-4"/>, gebringan beforan cyninges gerefan on folcgemote, ⁊ gerecca hu monie ðæra syn; ⁊ hi nimen þa m<hi rend="italic">en</hi> mid heo<hi rend="italic">m</hi> ðe hig magon eft to folcgemote bringan; ⁊ þonon heo<hi rend="italic">m</hi> þearf sy<ptr type="liebermannNote" n="*" target="#Af_34.lnote.oe.star"/> up mid heo<hi rend="italic">m</hi> to habbanne on heora fóre, gecyðe symble, swa oft swa ðearf sy, in gemotes gewitnysse cyninges gerefan.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="34" corresp="#wit-q"><pb n="69" ed="#liebermann"/>Etiam<ptr type="liebermannNote" n="1" target="#Af_34.lnote.oe.1-3"/> de mercatoribus statutum est, ut homines quos secum ducunt in negotiationem suam, ostendant regis<ptr type="liebermannNote" n="2" target="#Af_34.lnote.oe.2-3"/> preposito in publicis actionibus et edicant quot sint; et eos<ptr type="liebermannNote" n="3" target="#Af_34.lnote.oe.3-3"/> denique secum assumant, quos ad rectum publicum possint adducere.<ptr type="liebermannNote" n="4" target="#Af_34.lnote.oe.4-3"/> Et cum opus eueniet, ut secum plures habeant, simul hoc notificent preposito regis<ptr type="liebermannNote" n="5" target="#Af_34.lnote.oe.5-3"/> in publici<ptr type="liebermannNote" n="6" target="#Af_34.lnote.oe.6-3"/> gemóti<ptr type="liebermannNote" n="7" target="#Af_34.lnote.oe.7-3"/> (conuentus) testimonio sic<ptr type="liebermannNote" n="8" target="#Af_34.lnote.oe.8-3"/> sepe sicut opus sit.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="78" ed="#attenborough"/>[Be cypmannum.] Éac is ciepemonnum gereht: ða<ptr type="editorNote" n="4" target="#Af_34.attnote.fn.4"/> men ðe hie up mid him læden<ptr type="editorNote" n="5" target="#Af_34.attnote.fn.5"/>, gebrengen<ptr type="editorNote" n="6" target="#Af_34.attnote.fn.6"/> beforan kyninges gerefan on folcgemote, ⁊ gerecce<ptr type="editorNote" n="7" target="#Af_34.attnote.fn.7"/> hu manige<ptr type="editorNote" n="8" target="#Af_34.attnote.fn.8"/> þara sien; ⁊ hie nimen þa men mid<ptr type="editorNote" n="9" target="#Af_34.attnote.fn.9"/> him þe hie mægen<ptr type="editorNote" n="10" target="#Af_34.attnote.fn.10"/> eft to folcgemote to ryhte<ptr type="editorNote" n="11" target="#Af_34.attnote.fn.11"/> brengan; ⁊ ðonne him ðearf sie ma manna<ptr type="editorNote" n="12" target="#Af_34.attnote.fn.12"/> úp mid him to habbanne on hiora fore, gecyðe symle<ptr type="editorNote" n="13" target="#Af_34.attnote.fn.13"/>, swa óft swa him ðearf sie, in<ptr type="editorNote" n="14" target="#Af_34.attnote.fn.14"/> gemotes gewitnesse cyninges gerefan.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="35" corresp="#wit-e"><pb n="326" ed="#jurasinski-and-oliver"/>{XXXI} Éac is ciepemonnum gereht: ða men ðe hie up mid him læden, gebrengen beforan kyninges gerefan on folcgemote, ⁊ gerecce hu manige þara sien: ⁊ he nimen þa men mid him þe hie mægen eft to folcgemote to ryhte bringan; ⁊ þon<hi rend="italic">ne</hi> him ðearf sie ma manna úp mid him to habbanne on hiora fore, gecyðe symle, swa óft swa him ðearf sie, in gemotes gewitnesse cyninges geferan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="69" ed="#liebermann"/>Ferner ist Kaufleuten bestimmt: die Leute, die sie mit sich [aufs<ptr type="liebermannNote" n="1" target="#Af_34.lnote.de.1"/> Land] hinaufführen, sollen sie vor den Königsvogt in die Volksversammlung<ptr type="liebermannNote" n="2" target="#Af_34.lnote.de.2"/> bringen, und [man<ptr type="liebermannNote" n="3" target="#Af_34.lnote.de.3"/>] stelle fest, wie viele deren seien; und [zwar] sollen sie solche Leute<ptr type="liebermannNote" n="4" target="#Af_34.lnote.de.4"/> mit sich nehmen, welche sie späterhin zur Volksversammlung vor<ptr type="liebermannNote" n="5" target="#Af_34.lnote.de.5"/> Gericht zu stellen vermögen; und falls für sie nöthig ist, mehr Leute<ptr type="liebermannNote" n="6" target="#Af_34.lnote.de.6"/> bei sich auf ihrer [Handels]fahrt zu haben, thue [man<ptr type="liebermannNote" n="7" target="#Af_34.lnote.de.7"/>] jedesmal<ptr type="liebermannNote" n="8" target="#Af_34.lnote.de.8"/>, so oft wie [es] für sie nöthig ist, [es] dem Königsvogt unter Mitwissen der Versammlung kund.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Further, it is laid down for merchants: the men whom they take up [country] with them, they are to bring before the king’s reeve in the public assembly, and [one is to] establish how many of them there are; and [indeed] they are to take with them such men as they can afterwards bring to justice at the public assembly; and if it is necessary for them to have more men with them on their [trading] journey, [one is to] make [it] known each time, as often as [it] is necessary for them, to the king’s reeve with the knowledge of the assembly.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="79" ed="#attenborough"/>Further, with regard to traders, it is decreed: they shall bring before the king's reeve, at a public meeting, the men they are taking with them up into the country, and declare how many of them there are; and they shall take with them [only] such men as they can bring to justice again, at a public meeting. And when they need to have more men with them on their journey, a similar declaration shall always be made to the king's reeve, before the assembled company, as often as need arises.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="414" ed="#whitelock"/>Moreover, it is prescribed for traders: they are to bring before the king’s reeve in a public meeting the men whom they take up into the country with them, and it is to be established how many of them there are to be; and they are to take with them men whom they can afterwards bring to justice at a public meeting; and whenever it may be necessary for them to have more men out with them on their journey, it is always to be announced, as often as it is necessary for them, to the king’s reeve in the witness of the meeting. 35. If anyone binds an innocent <hi rend="italic">ceorl</hi>, he is to pay him ten shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="327" ed="#jurasinski-and-oliver"/>Also this is the law for merchants: they shall bring before the king’s reeve in the folk assembly those men that they are taking up [country] with them, and count how many of them there are; and they shall take with them [only] the men that they might afterwards bring to justice at the folk assembly. And if there is again need for them to take more men up with them to have on their journey, let them declare [this] likewise, as often as there is need, to the king’s reeve with the witness of the assembly.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:App-AGu_5">App AGu 5</ref></note>
        <note type="comparison" source="#wormald-mel" n="280"><label>gloss to</label> <ref target="clause:Ine_25">Ine 25</ref> <quote>look like glosses to Ine (n. 78: Af. 34/Ine 25 (traders))</quote></note>
        <note type="comparison" source="#wormald-mel" n="290"><label>builds on</label> <ref target="clause:Ine_25">Ine 25</ref> <quote>Alfred, himself building on Ine, demanded that traders register their escorts before a king's reeve (n. 123: Af 34, Ine 25)</quote></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="299"><label>emends</label> <ref target="clause:Ine_25">Ine 25</ref> <quote>Ine §25 requires a merchant [...] to do so in the presence of witnesses. Alfred §35 stipulates that these witnesses must be pre-approved by the king's reeve</quote></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="327"><label>compare</label> <ref target="clause:Ine_25">Ine 25</ref> <quote>Compare to Ine §25, which requires a merchant doing trade out in the countryside [...] to do so in front of witnesses.</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="290"><label>builds on</label> <ref target="clause:IEw_1">I Ew 1</ref> <quote>Each built on themes covered by Alfred ... Alfred, himself building on Ine, demanded that traders register their escorts</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_34.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">ceapm. <hi rend="italic">So;</hi> ceapman. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ceapm. So; ceapman. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_34.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">-riht <hi rend="italic">Ld;</hi> þ<hi rend="italic">æt fügt zu So</hi></seg><seg type="translation" xml:lang="en" source="#claude">-riht Ld; þ<hi rend="italic">æt</hi> added by So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_34.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">þa <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">þa So</seg></note>
