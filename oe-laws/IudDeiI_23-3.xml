        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_23-3.lnote.oe.59" n="59" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">-us -it, -is -etur <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-us -it, -is -etur written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_23-3.lnote.oe.60" n="60" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">-it, -us <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-it, -us written above H</seg></note>
