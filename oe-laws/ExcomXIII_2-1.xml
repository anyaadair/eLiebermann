        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom XIII 2.1" corresp="#wit-ym"><pb n="441" ed="#liebermann"/>excommunizamus et anathematizamus atque a<ptr type="liebermannNote" n="f" target="#ExcomXIII_2-1.lnote.oe.f"/> liminibus sancte Dei matris<ptr type="liebermannNote" n="g" target="#ExcomXIII_2-1.lnote.oe.g"/> ecclesie sequestramus<ptr type="liebermannNote" n="d" target="#ExcomXIII_2-1.lnote.oe.d"/> illos qui hec mala fecerunt uel consenserunt<ptr type="liebermannNote" n="e" target="#ExcomXIII_2-1.lnote.oe.e"/> uel terras<ptr type="liebermannNote" n="h" target="#ExcomXIII_2-1.lnote.oe.h"/> Sancti Petri depopulati sunt,</ab>
