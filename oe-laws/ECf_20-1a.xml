        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-1a.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">e. h. <hi rend="italic">S Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. h. S Do</seg></note>
