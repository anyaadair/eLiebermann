      <div type="clause" n="7">
        <head>Af Rb 7</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7" corresp="#wit-e"><pb n="16" ed="#liebermann"/>VIII. Be ðon þe mon on cynges<ptr type="liebermannNote" n="8" target="#Rubrics-Af_7.lnote.oe.8"/> healle feohte.<ptr type="liebermannNote" n="9" target="#Rubrics-Af_7.lnote.oe.9"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7" corresp="#wit-ot-frag"><pb n="16" ed="#liebermann"/>… þe mon on cyninges healle feohte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7" corresp="#wit-g-prol"><pb n="16" ed="#liebermann"/>VIII. Be þon þ<hi rend="italic">æt</hi> man on cyninges healle feohte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7" corresp="#wit-h"><pb n="17" ed="#liebermann"/>VIII. Be þon<ptr type="liebermannNote" n="7" target="#Rubrics-Af_7.lnote.oe.7"/> ðe mon on kyninges healle feohte.<ptr type="liebermannNote" n="8" target="#Rubrics-Af_7.lnote.oe.8-2"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7" corresp="#wit-q"><pb n="17" ed="#liebermann"/>Si quis in domo regis pugnet.<ptr type="liebermannNote" n="6" target="#Rubrics-Af_7.lnote.oe.6"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="188" ed="#jurasinski-and-oliver"/>VIII Be ðon þe mon on cynges healle feohte.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="188" ed="#jurasinski-and-oliver"/>Be ða<hi rend="italic">m</hi> þæt man feohteð on kyninges healle</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="17" ed="#liebermann"/>Davon, dass jemand in der Königshalle ficht.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of someone fighting in the king’s hall.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="189" ed="#jurasinski-and-oliver"/>Concerning that someone fights in the king’s hall</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="189" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_7.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">17</biblScope></bibl><seg type="original" xml:lang="de">De pugnantibus in d. r. <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">De pugnantibus in d. r. Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_7.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de">cyninges <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyninges So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_7.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de">gefeohte <hi rend="italic">Ld;</hi> gefeoht <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">gefeohte Ld; gefeoht So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_7.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">17</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> þam</seg><seg type="translation" xml:lang="en" source="#claude">altered þam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_7.lnote.oe.8-2" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">17</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> gefeohte</seg><seg type="translation" xml:lang="en" source="#claude">altered gefeohte</seg></note>
