    <body>
      <div type="clause" n="1.7">
        <head><ref type="lawCode" target="law:IAtr">I Atr</ref> 1.7</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.7" corresp="#wit-h"><pb n="218" ed="#liebermann"/>Gif he þonne uthleape ⁊ þ<hi rend="italic">æt</hi> ordal forbuge, gylde se borh þam teonde his ceapgyld ⁊ þa<hi rend="italic">m</hi> hlaforde his were, þe his wites wyrðe sy.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.7" corresp="#wit-b"><pb n="218" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="1" target="#IAtr_1-7.lnote.oe.1"/> he ðonne uthleape ⁊ þ<hi rend="italic">æt</hi> ordal<ptr type="liebermannNote" n="8" target="#IAtr_1-7.lnote.oe.8"/> forbuge, gylde<ptr type="liebermannNote" n="9" target="#IAtr_1-7.lnote.oe.9"/> se borh ðam<ptr type="liebermannNote" n="4" target="#IAtr_1-7.lnote.oe.4"/> teonde his ceapgyld ⁊ ðam<ptr type="liebermannNote" n="4" target="#IAtr_1-7.lnote.oe.4"/> hlaforde his were, ðe his wites wyrðe<ptr type="liebermannNote" n="10" target="#IAtr_1-7.lnote.oe.10"/> sy.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.7" corresp="#wit-q"><pb n="219" ed="#liebermann"/>Si aufugiat et ordalium uitet, reddat plegius eius capitale suum repetenti et domino weram suam, qui<ptr type="liebermannNote" n="2" target="#IAtr_1-7.lnote.oe.2"/> ea dignus sit.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="1.7" corresp="#wit-b"><pb n="52" ed="#robertson"/>Gyf he ðonne uthleape ⁊ þæt ordal forbuge, gylde se borh ðam teonde his ceapgyld ⁊ ðam hlaforde his were ðe his wites wyrðe sy.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="219" ed="#liebermann"/>Wenn [Verklagt]er aber entflieht und das<ptr type="liebermannNote" n="1" target="#IAtr_1-7.lnote.de.1"/> Ordal vermeidet, so zahle der Bürge<ptr type="liebermannNote" n="2" target="#IAtr_1-7.lnote.de.2"/> dem Kläger dessen Schadenersatz<ptr type="liebermannNote" n="3" target="#IAtr_1-7.lnote.de.3"/> und jenem Herrn, [sofern<ptr type="liebermannNote" n="4" target="#IAtr_1-7.lnote.de.4"/>] der zu dem [durch Verklagten verwirkten] Strafgeld berechtigt ist, des letzteren<ptr type="liebermannNote" n="5" target="#IAtr_1-7.lnote.de.5"/> Wergeld.<ptr type="liebermannNote" n="6" target="#IAtr_1-7.lnote.de.6"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">But if [the accused] escapes and avoids the ordeal, let the surety pay the plaintiff his compensation for the goods, and the lord — [if] he is entitled to the fine [forfeited by the accused] — the latter's wergild.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IAtr_1-7.robnote.n.1"/><pb n="53" ed="#robertson"/>If he escapes and avoids the ordeal, his surety shall pay the value of his goods to the accuser and the wergeld of the accused to the lord who is entitled to the fines incurred by him.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IIIAtr_6-2">III Atr 6.2</ref>; <ref target="clause:IICn_30-3b">II Cn 30.3b</ref>; <ref target="clause:IICn_30-6">II Cn 30.6</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="321"><ref target="clause:IICn_30-6">II Cn 30.6</ref></note>
        <note type="comparedBy" source="#wormald-ppmel" n="206"><ref target="clause:IICn_30-6">II Cn 30.6</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-7.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">219</biblScope></bibl><seg type="original" xml:lang="de">quia ei <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">quia ei Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-7.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-7.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">-le <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-le Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-7.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">gyld <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gyld Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-7.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-7.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">wurþe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wurþe Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IAtr_1-7.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">147</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Den Satz wiederholt wörtlich III 6, 2</seg><seg type="translation" xml:lang="en" source="#claude">III 6, 2 repeats the sentence word for word</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IAtr_1-7.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">147</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Wie in 1 kann ein Bürgenverband gemeint sein.—Geschah die Flucht nach erstmaligem Verbrechen, so ist wie dort die Bürgschaft für den ganzen Charakter gemeint; geschah sie erst nach dem Rückfall, dagegen die für Verdächtige; <hi rend="italic">s. o</hi>. 1, 5</seg><seg type="translation" xml:lang="en" source="#claude">As in 1, an association of sureties may be meant.—If the flight occurred after a first offence, then, as there, suretyship for the whole character is meant; if it occurred only after the relapse, then on the other hand that for suspects; <hi rend="italic">see above</hi> 1, 5</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IAtr_1-7.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">147</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Friedlosigkeit (<hi rend="italic">s. u</hi>. 1, 9a) des Verbrechers absorbiert die Busse</seg><seg type="translation" xml:lang="en" source="#claude">The outlawry (<hi rend="italic">see below</hi> 1, 9a) of the criminal absorbs the compensation</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IAtr_1-7.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">147</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. o</hi>. 1, 5⁴</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. above</hi> 1, 5⁴</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IAtr_1-7.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">148</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. u</hi>. 1, 9; 11; Q ist zweideutig</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See below</hi> 1, 9; 11; Q is ambiguous</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IAtr_1-7.lnote.de.6" n="6" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">148</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Der Bürge haftet, dass der Strafgeldberechtigte so viel erhalte, als wäre der Verbrecher zum Ordal erschienen. Nicht also <hi rend="italic">borgbryce</hi> liegt vor</seg><seg type="translation" xml:lang="en" source="#claude">The surety is liable for ensuring that the party entitled to the fine receives as much as if the criminal had appeared for the ordeal. So it is not a case of <hi rend="italic">borgbryce</hi></seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IAtr_1-7.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">313</biblScope></bibl><seg type="original" xml:lang="en">Cf. III Atr. 6, 2.</seg></note>
      </div>
