      <div type="clause" n="2.5">
        <head><ref type="lawCode" target="law:IVAtr">IV Atr</ref> 2.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2.5" corresp="#wit-q"><pb n="232" ed="#liebermann"/>Homines de Rotomago<ptr type="liebermannNote" n="23" target="#IVAtr_2-5.lnote.oe.23"/>, qui ueniebant cum uino uel craspisce<ptr type="liebermannNote" n="24" target="#IVAtr_2-5.lnote.oe.24"/>, dabant<ptr type="liebermannNote" n="25" target="#IVAtr_2-5.lnote.oe.25"/> rectitudinem sex sol. de magna<ptr type="liebermannNote" n="26" target="#IVAtr_2-5.lnote.oe.26"/> naui et XX.<ptr type="liebermannNote" n="27" target="#IVAtr_2-5.lnote.oe.27"/> frustum de ipso craspisce.<ptr type="liebermannNote" n="24" target="#IVAtr_2-5.lnote.oe.24"/></ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="2.5" corresp="#wit-q"><pb n="72" ed="#robertson"/>Homines de Rotomago qui veniebant cum vino vel craspisce<ptr type="editorNote" n="6" target="#IVAtr_2-5.robnote.fn.6"/> dabant<ptr type="editorNote" n="7" target="#IVAtr_2-5.robnote.fn.7"/> rectitudinem sex sol. de magna navi et viginti frustum de ipso craspisce<ptr type="editorNote" n="6" target="#IVAtr_2-5.robnote.fn.6"/>.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="233" ed="#liebermann"/>Leute von Rouen<ptr type="liebermannNote" n="1" target="#IVAtr_2-5.lnote.de.1"/>, die mit Wein oder Wal<ptr type="liebermannNote" n="2" target="#IVAtr_2-5.lnote.de.2"/> [d. i. Fettfisch: Walfisch und Delphin] kamen, gaben als Gebühr<ptr type="liebermannNote" n="3" target="#IVAtr_2-5.lnote.de.3"/> 6 Schill. vom grossen Schiff und die zwanzigste Schnitte<ptr type="liebermannNote" n="4" target="#IVAtr_2-5.lnote.de.4"/> von jenem Wal.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Men from Rouen who came with wine or whale [i.e. ‘fat fish’: whale and porpoise] gave as due 6 shillings for a large ship and the twentieth slice of that whale.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q"><pb n="73" ed="#robertson"/>Men of Rouen<ptr type="editorNote" n="1" target="#IVAtr_2-5.robnote.n.1"/>, who came with wine or blubber-fish<ptr type="editorNote" n="2" target="#IVAtr_2-5.robnote.n.2"/>, paid a duty<ptr type="editorNote" n="3" target="#IVAtr_2-5.robnote.n.3"/> of 6 shillings for a large ship and 5 %<ptr type="editorNote" n="4" target="#IVAtr_2-5.robnote.n.4"/> of the fish.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_2-5.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">232</biblScope></bibl><seg type="original" xml:lang="de">Rothomaga <hi rend="italic">MBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Rothomaga MBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_2-5.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">232</biblScope></bibl><seg type="original" xml:lang="de">-pice <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">-pice R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_2-5.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">232</biblScope></bibl><seg type="original" xml:lang="de">dabant — craspisce <hi rend="italic">überspringt MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">dabant — craspisce omitted by MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_2-5.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">232</biblScope></bibl><seg type="original" xml:lang="de">n. m. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">n. m. T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_2-5.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">232</biblScope></bibl><seg type="original" xml:lang="de">uicesimum <hi rend="italic">T;</hi> uiginti <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">uicesimum T; uiginti R</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_2-5.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">163</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Rouen; Chéruel <hi rend="italic">Rouen pend. époque commun</hi>. I 241; Fréville <hi rend="italic">Comm. de Rouen</hi> I 90; Giry <hi rend="italic">Établ. de Rouen</hi> I 24. II 27; Gross <hi rend="italic">Gild merch</hi>. I 292; Round <hi rend="italic">Commune of London</hi> 246</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Rouen; Chéruel <hi rend="italic">Rouen pend. époque commun</hi>. I 241; Fréville <hi rend="italic">Comm. de Rouen</hi> I 90; Giry <hi rend="italic">Établ. de Rouen</hi> I 24. II 27; Gross <hi rend="italic">Gild merch</hi>. I 292; Round <hi rend="italic">Commune of London</hi> 246</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_2-5.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">164</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Wal; das Original hatte vielleicht <hi rend="italic">hran(fisc)</hi> oder <hi rend="italic">hwæl</hi>. Gegen die Deutung ‘Stör’ Round a. a. O; <hi rend="italic">styria, mereswyn</hi> und seltenen Seefisch behält die Herrschaft sich vor an Wye- und Severnmündung; hinter Urk. a. 956 [wohl 11. Jh.] Bi 928</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Wal; the original perhaps had <hi rend="italic">hran(fisc)</hi> or <hi rend="italic">hwæl</hi>. Against the interpretation ‘sturgeon’, Round loc. cit.; at the mouths of the Wye and Severn the lordship reserves to itself <hi rend="italic">styria, mereswyn</hi> and rare sea-fish; appended to charter a. 956 [probably 11th cent.] Bi 928</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_2-5.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">164</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Wohl <hi rend="italic">geriht(o)</hi> im Orig.; günstiger als übrige Normandie 2, 6</seg><seg type="translation" xml:lang="en" source="#claude">Probably <hi rend="italic">geriht(o)</hi> in the orig.; more favourable than for the rest of Normandy 2, 6</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_2-5.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">164</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl</hi>. Verleihung durch Urk.: <hi rend="italic">dexteram alam de crasso pisce et frustum unum de crasso eiusdem</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf</hi>. a grant by charter: <hi rend="italic">dexteram alam de crasso pisce et frustum unum de crasso eiusdem</hi></seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_2-5.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="en">Cf. <hi rend="italic">Homines Rotomagi qui de ghilda sunt mercatorum sint quieti de omni consuetudine apud Londonium, nisi de vino et de crasso pisce</hi>, Charter of Henry Plantagenet, Duke of Normandy, c. 1150 (see Chéruel, <hi rend="italic">Rouen pendant l’époque communale</hi>, <hi rend="smallcaps">i</hi>. p. 245). The clauses which follow grant to the merchants of Rouen the right of entry to all English markets and also assign to them a special harbour at London which they had held in the time of King Edward, cf. the similar clauses in the Charter of John Lackland, Chéruel, <hi rend="italic">op. cit.</hi> p. 252 f.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_2-5.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="en">Alias <hi rend="italic">piscis crassus, i.e.</hi> whales, porpoises etc. See Du Cange, <hi rend="italic">s.v. craspiscis</hi>; Round, <hi rend="italic">Commune of London</hi>, p. 246; Fréville, <hi rend="italic">Commerce de Rouen</hi>, <hi rend="smallcaps">i</hi>. p. 179. Liebermann suggests that the A.S. original may have read <hi rend="italic">hran</hi>(<hi rend="italic">fisc</hi>) or <hi rend="italic">hwæl</hi>; cf. Icel. <hi rend="italic">hvalr</hi> (Maurer, <hi rend="italic">Island</hi>, p. 414).</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_2-5.robnote.n.3" n="3" source="#robertson"><bibl><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="en">Liebermann suggests that the A.S. text may have read <hi rend="italic">geriht</hi>(<hi rend="italic">o</hi>).</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_2-5.robnote.n.4" n="4" source="#robertson"><bibl><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="en">Lit. ‘a twentieth part of the fish itself.’</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_2-5.robnote.fn.6" n="6" source="#robertson"><bibl><biblScope unit="page">72</biblScope></bibl><label>craspisce</label><seg type="original" xml:lang="en"><hi rend="italic">craspice</hi> R.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_2-5.robnote.fn.7" n="7" source="#robertson"><bibl><biblScope unit="page">72</biblScope></bibl><label>dabant</label><seg type="original" xml:lang="en"><hi rend="italic">dabant…craspisce</hi> om. M, Hk, Br.</seg></note>
      </div>
