      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:Mirce">Mirce</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-d"><pb n="462" ed="#liebermann"/>Ðegnes wergild is syx swa micel, þ<hi rend="italic">æt</hi> bið twelf hund scill'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-o"><pb n="462" ed="#liebermann"/>Ðegenes wergild<ptr type="liebermannNote" n="2" target="#Mirce_1-1.lnote.oe.2"/> is six swa micel, þ<hi rend="italic">æt</hi> bið twelf hund scill'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-h"><pb n="462" ed="#liebermann"/>Ðegenes wergyld is syx swa micel, þ<hi rend="italic">æt</hi> byð XII hundred scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-ld"><pb n="463" ed="#liebermann"/>Þegnes syxfeald ðam, þ<hi rend="italic">æt</hi> is MCC scill.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.1" corresp="#wit-q"><pb n="463" ed="#liebermann"/>Thaini<ptr type="liebermannNote" n="4" target="#Mirce_1-1.lnote.oe.4"/> weregildum est sexies tantum, id<ptr type="liebermannNote" n="5" target="#Mirce_1-1.lnote.oe.5"/> est XII hun[d<ptr type="liebermannNote" n="6" target="#Mirce_1-1.lnote.oe.6"/>] schillinges, (id<ptr type="liebermannNote" n="7" target="#Mirce_1-1.lnote.oe.7"/> est duodecies C sol.).</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-in"><pb n="463" ed="#liebermann"/>[43] Liberalis hominis, id<ptr type="liebermannNote" n="4" target="#Mirce_1-1.lnote.oe.4-2"/> est þegenes<ptr type="liebermannNote" n="5" target="#Mirce_1-1.lnote.oe.5-2"/>, pretium est<ptr type="liebermannNote" n="6" target="#Mirce_1-1.lnote.oe.6-2"/> sexies<ptr type="liebermannNote" n="7" target="#Mirce_1-1.lnote.oe.7-2"/> tantum, id est duodecies C sol.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-h"><pb n="14" ed="#rabin-doml"/>Ðegenes wergyld is syx swa micel, þæt byð XII hund scillinga.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="462" ed="#liebermann"/>Eines Thegn Wergeld ist sechsmal<ptr type="liebermannNote" n="1" target="#Mirce_1-1.lnote.de.1"/> so viel, das heisst 1200 Schill. [20 Pfund].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">A thegn's wergild is six times as much, that is 1,200 shillings [20 pounds].</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-d"><pb n="477" ed="#whitelock"/>A thegn’s wergild is six times as much, namely 1200 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-h">The wergild of a thane is six times as much, that is, twelve hundred shillings.</ab>
        <note type="comparison" source="#liebermann" n="462"><ref target="clause:Ath_1">Að 1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Að 1</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Ath_1">Að 1</ref>; <ref target="clause:LeisWl_8">Leis Wl 8</ref></note>
        <note type="editorial">Liebermann compares Að 1.; U: checked against Whitelock, EHD I (1979), and corrected (before: ‘A thegn's wergild is six times a much, namely 1200 shillings.’).</note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">462</biblScope></bibl><seg type="original" xml:lang="de">i <hi rend="italic">später geänd. in</hi> y</seg><seg type="translation" xml:lang="en" source="#claude">i later altered to y</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so K;</hi> ta. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so K; ta. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de">id — sc. <hi rend="italic">nur Lond, ohne</hi> id — sol., <hi rend="italic">was übr. bieten</hi></seg><seg type="translation" xml:lang="en" source="#claude">id — sc. only Lond, without id — sol., which the others have</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de">hun <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">hun K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1-1.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de">i. e. <hi rend="italic">fehlt Ct</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. e. missing in Ct</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1-1.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de">the. <hi rend="italic">H;</hi> þeignes <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">the. H; þeignes S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1-1.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">Cb Lb S Pl Jo Ct</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius Cb Lb S Pl Jo Ct</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1-1.lnote.oe.7-2" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de">sexcies <hi rend="italic">Cb Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">sexcies Cb Lb S</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Mirce_1-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">262</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Stand 15. 20</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Stand 15. 20</seg></note>
      </div>
    </body>
