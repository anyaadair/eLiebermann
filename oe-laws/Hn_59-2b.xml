        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.2b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.2b" corresp="#wit-lat"><pb n="577" ed="#liebermann"/>Si<ptr type="liebermannNote" n="t" target="#Hn_59-2b.lnote.oe.t"/> eiusdem comitatus sit qui placitum induciat, pridie ante solis occasum ad VII dies terminum ponat, sicut<ptr type="liebermannNote" n="u" target="#Hn_59-2b.lnote.oe.u"/> premisimus; si alterius comitatus sit, II diebus ante placitum respectetur ad XV<ptr type="liebermannNote" n="38" target="#Hn_59-2b.lnote.oe.38"/> dies; si de tercio comitatu sit, triduo respectetur ad III ebdomadas; si de<ptr type="liebermannNote" n="14" target="#Hn_59-2b.lnote.oe.14"/> quarto comitatu, IIII diebus ante prenunciet ad IIII ebdomadas; et ultra non procedit, si sit in Anglia.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 577 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-2b.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 60, 2<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 60, 2<hi rend="italic">b</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-2b.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 41, 2<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 41, 2<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-2b.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-2b.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">XV — respectetur <hi rend="italic">überspringt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">XV — respectetur skipped by K Co Or Gi</seg></note>
