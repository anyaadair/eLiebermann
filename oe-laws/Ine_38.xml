        <note type="liebermannNote" subtype="textual" xml:id="Ine_38.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">105</biblScope></bibl><seg type="original" xml:lang="de">ad nu. <hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad nu. lacking in K</seg></note>
