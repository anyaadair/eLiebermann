      <div type="clause" n="2.1">
        <head><ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 2.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 2.1" corresp="#wit-du"><pb n="409" ed="#liebermann"/>ut si hic homo, manum suam in te missurus, innocens est unde reputatur, pietas Dei omnipotentis liberet eum;</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei IV 2.1" corresp="#wit-gl"><pb n="409" ed="#liebermann"/>þ<hi rend="italic">æt</hi>te gif her<ptr type="liebermannNote" n="32" target="#IudDeiIV_2-1.lnote.oe.32"/> <hi rend="italic">monn<ptr type="liebermannNote" n="33" target="#IudDeiIV_2-1.lnote.oe.33"/></hi>, hond his on ðec bið sendend, vnscyldig<ptr type="liebermannNote" n="34" target="#IudDeiIV_2-1.lnote.oe.34"/> is bi ðon bið ateled, arfæst<hi rend="italic">nise</hi> God<hi rend="italic">es</hi> allm<hi rend="italic">æhtiges</hi> gifrie hine;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 409 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2-1.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Glossator missversteht</hi> hīc</seg><seg type="translation" xml:lang="en" source="#claude">the glossator misunderstands hīc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2-1.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rune</hi> ᛞ</seg><seg type="translation" xml:lang="en" source="#claude">rune ᛞ</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2-1.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">oft</hi> v <hi rend="italic">für</hi> u</seg><seg type="translation" xml:lang="en" source="#claude">often v for u</seg></note>
      </div>
