      <div type="clause" n="59.9a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.9a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.9a" corresp="#wit-lat"><pb n="578" ed="#liebermann"/>De<ptr type="liebermannNote" n="u" target="#Hn_59-9a.lnote.oe.u"/> rebus hereditatis<ptr type="liebermannNote" n="v" target="#Hn_59-9a.lnote.oe.v"/> sue interpellatus<ptr type="liebermannNote" n="39" target="#Hn_59-9a.lnote.oe.39"/> post XV annos defensorem<ptr type="liebermannNote" n="40" target="#Hn_59-9a.lnote.oe.40"/> habeat uel idem respondeat; et calumpniam<ptr type="liebermannNote" n="41" target="#Hn_59-9a.lnote.oe.41"/> mittat<ptr type="liebermannNote" n="w" target="#Hn_59-9a.lnote.oe.w"/> in rebus suis, ut nullus<ptr type="liebermannNote" n="42" target="#Hn_59-9a.lnote.oe.42"/> eas teneat uno anno et uno<ptr type="liebermannNote" n="43" target="#Hn_59-9a.lnote.oe.43"/> die sine contradiccione, dum sanus sit et in<ptr type="liebermannNote" n="44" target="#Hn_59-9a.lnote.oe.44"/> patria<ptr type="liebermannNote" n="x" target="#Hn_59-9a.lnote.oe.x"/> pax.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 578 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-9a.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ob Reminiscenz an</hi> Capitula a. 819 legi Sal. add., c. 5: De hereditate . . . si aliquis [<hi rend="italic">den Minorennen</hi>] interpellare voluerit?</seg><seg type="translation" xml:lang="en" source="#claude">a reminiscence of Capitula a. 819 legi Sal. add., c. 5: De hereditate . . . si aliquis [the minor] interpellare voluerit?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-9a.lnote.oe.v" n="v" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">also nur über die Erbschaft wird der Process bis zur Grossjährigkeit des Mündels verschoben; in sonstiger Civilklage vertritt ihn der Vormund; Rive</hi> Vormundschaft 201</seg><seg type="translation" xml:lang="en" source="#claude">thus it is only in the matter of the inheritance that the suit is postponed until the ward comes of age; in other civil suits the guardian represents him; Rive Vormundschaft 201</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-9a.lnote.oe.w" n="w" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">der grossjährig werdende Eigenthümer klage im ersten Jahre; sonst gewänne Verklagter den Processvortheil des Besitzes; Maitland</hi> Year and day <hi rend="italic">in</hi> Law quart. rev. 1889, 260</seg><seg type="translation" xml:lang="en" source="#claude">the owner coming of age is to bring his suit within the first year; otherwise the defendant would gain the procedural advantage of possession; Maitland Year and day in Law quart. rev. 1889, 260</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-9a.lnote.oe.x" n="x" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 83, 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. 83, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-9a.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">-tos <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tos Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-9a.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">-sionem <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sionem Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-9a.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">-upn. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-upn. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-9a.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">eos <hi rend="italic">statt</hi> nu. eas <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">eos instead of nu. eas Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-9a.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de">una <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">una Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-9a.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">578</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg Co;</hi> patrie <hi rend="italic">gegen Hss. Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing Sc Hg Co; patrie against the MSS, Wi Tho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-9a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Jahr und Tag 5. Der in Anm. <hi rend="italic">w</hi> zitierte Aufsatz steht jetzt auch in Maitland <hi rend="italic">Coll. papers</hi> II 73f.—<hi rend="italic">defensionem</hi>{40}—59, 9b <hi rend="italic">aliqui</hi>{46}—59, 10 <hi rend="italic">eisdem</hi>{1}—<hi rend="italic">accusanti</hi>{4} <hi rend="italic">s. et iudici</hi>{5}—59, 11 <hi rend="italic">placitet c. h. s</hi>.{8} <hi rend="italic">de pr. s. pl</hi>. Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Jahr und Tag 5. The article cited in note <hi rend="italic">w</hi> is now also printed in Maitland <hi rend="italic">Coll. papers</hi> II 73f.—<hi rend="italic">defensionem</hi>{40}—59, 9b <hi rend="italic">aliqui</hi>{46}—59, 10 <hi rend="italic">eisdem</hi>{1}—<hi rend="italic">accusanti</hi>{4} <hi rend="italic">s. et iudici</hi>{5}—59, 11 <hi rend="italic">placitet c. h. s</hi>.{8} <hi rend="italic">de pr. s. pl</hi>. Rs</seg></note>
      </div>
