    <body>
      <div type="clause" n="5.4">
        <head><ref type="lawCode" target="law:ICn">I Cn</ref> 5.4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.4" corresp="#wit-g-a"><pb n="288" ed="#liebermann"/>⁊ gyf<ptr type="liebermannNote" n="6" target="#ICn_5-4.lnote.oe.6"/> he ladian<ptr type="liebermannNote" n="7" target="#ICn_5-4.lnote.oe.7"/> wylle, geladige þonne be dæde mæðe, swa mid þryfealdre<ptr type="liebermannNote" n="8" target="#ICn_5-4.lnote.oe.8"/> swa mid anfealdre lade, be ðam þe seo dæd<ptr type="liebermannNote" n="9" target="#ICn_5-4.lnote.oe.9"/> sy.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.4" corresp="#wit-a"><pb n="288" ed="#liebermann"/>⁊ gif he hine ladian wille, geladiage<ptr type="liebermannNote" n="2" target="#ICn_5-4.lnote.oe.2"/> þonne be dade maðe, swa mid þrifealde<ptr type="liebermannNote" n="2" target="#ICn_5-4.lnote.oe.2"/> lade<ptr type="liebermannNote" n="3" target="#ICn_5-4.lnote.oe.3"/>, be þam þe seo dade<ptr type="liebermannNote" n="2" target="#ICn_5-4.lnote.oe.2"/> sy.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.4" corresp="#wit-q"><pb n="288" ed="#liebermann"/>Si se purgare uelit, secundum facti mensuram sit, uel<ptr type="liebermannNote" n="5" target="#ICn_5-4.lnote.oe.5"/> per triplicem negationem uel per simplicem<ptr type="liebermannNote" n="6" target="#ICn_5-4.lnote.oe.6-2"/> (singularem).</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.4" corresp="#wit-inst-cn"><pb n="289" ed="#liebermann"/>Quodsi negauerit et purgare<ptr type="liebermannNote" n="10" target="#ICn_5-4.lnote.oe.10"/> sé uoluerit, secundum culpę modum et quantitatem sé purget.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.4" corresp="#wit-cons-cn"><pb n="289" ed="#liebermann"/>Quodsi innocentem se probare uoluerit, purget se siue triplici siue simplici purgacione secundum qualitatem accusacionis.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="5a.4" corresp="#wit-g-a"><pb n="162" ed="#robertson"/>⁊ gyf he ladian<ptr type="editorNote" n="1" target="#ICn_5-4.robnote.fn.1"/> wille, geladige þonne be dæde mæðe, swa mid þryfealdre swa mid anfealdre<ptr type="editorNote" n="2" target="#ICn_5-4.robnote.fn.2"/> lade, be ðam þe seo dæd sy.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="240" ed="#rabin-doml"/>And gyf he ladian wylle, geladige þonne be dæde mæðe: swa mid þryfealdre swa mid anfealdre lade, be ðam þe seo dæd sy.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="289" ed="#liebermann"/>Und wenn er sich reinigen will, dann reinige er sich nach Verhältniss der That entweder durch dreifachen oder durch einfachen Reinigungsbeweis, je nachdem die That ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if he wishes to clear himself, then let him clear himself according to the gravity of the deed, either by the threefold or by the single clearing, according to what the deed is.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-g-a"><pb n="163" ed="#robertson"/>And if he seeks to clear himself, he shall do so in proportion to the deed, either by the triple mode of proof or by the simple, in accordance with the nature of the deed.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="241" ed="#rabin-doml"/>And if he wishes to clear himself, he shall do so in the manner appropriate for the offense: either the triple mode of proof or the single, whichever the deed calls for.</ab>
        <note type="comparison" source="#liebermann" n="289"><ref target="clause:VIIIAtr_27-1">VIII Atr 27.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. VIII Atr. 27, 1</note>
        <note type="comparedBy" source="#whitelock" n="456"><ref target="clause:VIIIAtr_27-1">VIII Atr 27.1</ref></note>
        <note type="editorial">A lacks ‘swa mid anfealdre’, supplied by Liebermann. Liebermann compares VIII Atr 27.1.; BR: added from Gesetze I p. 289, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">he ladian: he hine ladian A</note>
        <note type="textual" source="#rabin-doml">swa mid anfealdre: omitted A</note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-4.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">288</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-4.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">288</biblScope></bibl><seg type="original" xml:lang="de">hine geladian wille, geladiage [<hi rend="italic">vgl. A</hi>] <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hine geladian wille, geladiage [cf. A] Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-4.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">288</biblScope></bibl><seg type="original" xml:lang="de">þrifeald lade swa be, <hi rend="italic">ohne</hi> m. a. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þrifeald lade swa be, without m. a. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-4.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">288</biblScope></bibl><seg type="original" xml:lang="de">dæde <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">dæde Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-4.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">288</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-4.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">288</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond, eingeklammertes übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">the text before the bracket Lond, the bracketed text the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-4.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">289</biblScope></bibl><seg type="original" xml:lang="de">se pu. <hi rend="italic">Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">se pu. Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-4.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">288</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-4.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">288</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> swa mid anfealdre</seg><seg type="translation" xml:lang="en" source="#claude">supply swa mid anfealdre</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_5-4.lnote.de.1" n="1" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">199</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Nur dreifach erschwerte Reinigung erlaubt dem Altardiener, der Meinwerk verübte, in sonst gleichen Worten II Cn 41, 1</seg><seg type="translation" xml:lang="en" source="#claude">Only a threefold (aggravated) purgation is allowed, in otherwise identical words, to the altar-servant who has committed a crime, II Cn 41, 1</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="ICn_5-4.robnote.fn.1" n="1" source="#robertson"><bibl><biblScope unit="page">162</biblScope></bibl><label>ladian</label><seg type="original" xml:lang="en"><hi rend="italic">h. hine l.</hi> A, Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="ICn_5-4.robnote.fn.2" n="2" source="#robertson"><bibl><biblScope unit="page">162</biblScope></bibl><label>anfealdre</label><seg type="original" xml:lang="en"><hi rend="italic">s. m. a.</hi> om. A; <hi rend="italic">þrifeald lade swa be</hi> Ld.</seg></note>
      </div>
    </body>
