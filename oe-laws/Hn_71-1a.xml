        <head><ref type="lawCode" target="law:Hn">Hn</ref> 71.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 71.1a" corresp="#wit-lat"><pb n="590" ed="#liebermann"/>Reddatur utique qui fuerit<ptr type="liebermannNote" n="15" target="#Hn_71-1a.lnote.oe.15"/> huiusmodi<ptr type="liebermannNote" n="16" target="#Hn_71-1a.lnote.oe.16"/> parentibus (et<ptr type="liebermannNote" n="17" target="#Hn_71-1a.lnote.oe.17"/> amicis) interfecti, ut eorum misericordiam<ptr type="liebermannNote" n="h" target="#Hn_71-1a.lnote.oe.h"/> et<ptr type="liebermannNote" n="18" target="#Hn_71-1a.lnote.oe.18"/> iudicium senciat, quibus ipse non<ptr type="liebermannNote" n="19" target="#Hn_71-1a.lnote.oe.19"/> pepercit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 590 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1a.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 92, 15</seg><seg type="translation" xml:lang="en" source="#claude">as 92, 15</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1a.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">reus <hi rend="italic">ergänzt Wi Tho</hi> [<hi rend="italic">unnöthig</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">reus supplied by Wi Tho [unnecessarily]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1a.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">homicidii <hi rend="italic">fügt zu ohne Hss. Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">homicidii added by Wi without MS authority</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1a.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">et a. <hi rend="italic">aus Sc; fehlt K Co Or Gi Cnut</hi></seg><seg type="translation" xml:lang="en" source="#claude">et a. from Sc; missing in K Co Or Gi Cnut</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1a.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">et i. <hi rend="italic">fehlt Or;</hi> sen. aut iud. <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">et i. missing in Or; sen. aut iud. K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1a.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">326</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Humor 3; Strafvollzug 2c; Totschlag 16d—<hi rend="italic">et</hi>{17} <hi rend="italic">am</hi>.—<hi rend="italic">mis. sen. aut</hi>{18} <hi rend="italic">iud. qu</hi>.—71, 1b <hi rend="italic">misse ueniat</hi>{21} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Humor 3; Strafvollzug 2c; Totschlag 16d—<hi rend="italic">et</hi>{17} <hi rend="italic">am</hi>.—<hi rend="italic">mis. sen. aut</hi>{18} <hi rend="italic">iud. qu</hi>.—71, 1b <hi rend="italic">misse ueniat</hi>{21} Rs</seg></note>
