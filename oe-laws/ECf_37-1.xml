      <div type="clause" n="37.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 37.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 37.1"><pb n="668" ed="#liebermann"/>Hoc autem dicebat, sepe<ptr type="liebermannNote" n="16" target="#ECf_37-1.lnote.la.16"/> se audisse<ptr type="liebermannNote" n="17" target="#ECf_37-1.lnote.la.17"/> in curia regis Francorum<ptr type="liebermannNote" n="18" target="#ECf_37-1.lnote.la.18"/>, dum ibi moratus esset; nec immerito: usura<ptr type="liebermannNote" n="c" target="#ECf_37-1.lnote.la.fn.c"/> enim summa<ptr type="liebermannNote" n="19" target="#ECf_37-1.lnote.la.19"/> radix omnium<ptr type="liebermannNote" n="20" target="#ECf_37-1.lnote.la.20"/> uiciorum interpretatur<ptr type="liebermannNote" n="21" target="#ECf_37-1.lnote.la.21"/>.</ab>
        <note type="comparison" source="#liebermann" n="668"><label>printed alongside</label> <ref target="clause:ECfRetr_37-1">ECf retr 37.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 668 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_37-1.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielmehr</hi> cupiditas: <hi rend="italic">I Tim.</hi> 6, 10</seg><seg type="translation" xml:lang="en" source="#claude">rather cupiditas: I Tim. 6, 10</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_37-1.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">se sepe <hi rend="italic">Hk Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">se sepe Hk Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_37-1.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">uidisse <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">uidisse Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_37-1.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">Francho. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Francho. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_37-1.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_37-1.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Rl; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Rl; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_37-1.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">endet mit Schluss einer Lage Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cl ends here, at the end of a gathering</seg></note>
