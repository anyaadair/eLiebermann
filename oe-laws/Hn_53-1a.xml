      <div type="clause" n="53.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 53.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 53.1a" corresp="#wit-lat"><pb n="574" ed="#liebermann"/>Et si de nominatis<ptr type="liebermannNote" n="f" target="#Hn_53-1a.lnote.oe.f"/> et susceptis placitis pulsabatur — nisi competens aliquid interuenerit —, reus omnium iudicetur; si secus<ptr type="liebermannNote" n="10" target="#Hn_53-1a.lnote.oe.10"/> erat<ptr type="liebermannNote" n="11" target="#Hn_53-1a.lnote.oe.11"/>, tantum<ptr type="liebermannNote" n="12" target="#Hn_53-1a.lnote.oe.12"/> XX manc.<ptr type="liebermannNote" n="8" target="#Hn_53-1a.lnote.oe.8"/> emendet et rectum faciat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 574 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_53-1a.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">574</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 50, 1; 3</seg><seg type="translation" xml:lang="en" source="#claude">cf. 50, 1; 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_53-1a.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">574</biblScope></bibl><seg type="original" xml:lang="de">mͣ <hi rend="italic">Sc;</hi> mar. <hi rend="italic">K;</hi> marc. <hi rend="italic">Co Or Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">mͣ Sc; mar. K; marc. Co Or Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_53-1a.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">574</biblScope></bibl><seg type="original" xml:lang="de">reus <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">reus Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_53-1a.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">574</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_53-1a.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">574</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Sc Hg;</hi> tamen <hi rend="italic">Wh;</hi> <hi rend="spaced">inde</hi> XXX <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Sc Hg; tamen Wh; <hi rend="italic">inde</hi> XXX Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_53-1a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Vermögenseinziehung 10o—<hi rend="italic">reus</hi>{10}—{12}XXX <hi rend="italic">marcarū</hi>, doch erstes <hi rend="italic">r</hi> korr. zu <hi rend="italic">n</hi>—53, 1b <hi rend="italic">-rit</hi>{14}—<hi rend="italic">plegios</hi>{15}—53, 1e <hi rend="italic">effu</hi>.{17}—53, 2 <hi rend="italic">quodam</hi>{23}—53, 3 <hi rend="italic">dissaisitus</hi>—53, 4 <hi rend="italic">s. o</hi>. 46, 3—ohne <hi rend="italic">de</hi>—53, 5 am Rande spät: <hi rend="italic">Hic de disscisina primo fit mencio, set indistincte</hi>—<hi rend="italic">dissaisitus</hi>—53, 6 <hi rend="italic">Et nemo dissaisiatus l</hi>. Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Vermögenseinziehung 10o—<hi rend="italic">reus</hi>{10}—{12}XXX <hi rend="italic">marcarū</hi>, but the first <hi rend="italic">r</hi> corrected to <hi rend="italic">n</hi>—53, 1b <hi rend="italic">-rit</hi>{14}—<hi rend="italic">plegios</hi>{15}—53, 1e <hi rend="italic">effu</hi>.{17}—53, 2 <hi rend="italic">quodam</hi>{23}—53, 3 <hi rend="italic">dissaisitus</hi>—53, 4 <hi rend="italic">see above</hi> 46, 3—without <hi rend="italic">de</hi>—53, 5 in the margin, in a late hand: <hi rend="italic">Hic de disscisina primo fit mencio, set indistincte</hi>—<hi rend="italic">dissaisitus</hi>—53, 6 <hi rend="italic">Et nemo dissaisiatus l</hi>. Rs</seg></note>
      </div>
