      <div type="clause" n="23">
        <head><ref type="lawCode" target="law:PsCnFor">Ps Cn for</ref> 23</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Ps Cn for 23" corresp="#wit-ho-st-cii"><pb n="624" ed="#liebermann"/>Si uero horum<ptr type="liebermannNote" n="11" target="#PsCnFor_23.lnote.la.11"/> aliquis<ptr type="liebermannNote" n="12" target="#PsCnFor_23.lnote.la.12"/> interfecerit<ptr type="liebermannNote" n="13" target="#PsCnFor_23.lnote.la.13"/>, soluat<ptr type="liebermannNote" n="14" target="#PsCnFor_23.lnote.la.14"/> dupliciter et persoluat<ptr type="liebermannNote" n="f" target="#PsCnFor_23.lnote.la.fn.f"/>, sitque pretii<ptr type="liebermannNote" n="g" target="#PsCnFor_23.lnote.la.fn.g"/> sui reus contra regem.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 624 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-ho-st-cii">But if any of these kills [it], let him pay double and pay again, and let him be liable for his own price to the king.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_23.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de">harum <hi rend="italic">Ho 2 schlimmbessernd</hi></seg><seg type="translation" xml:lang="en" source="#claude">harum Ho 2, a mistaken correction</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_23.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de">aliquot <hi rend="italic">Ho</hi></seg><seg type="translation" xml:lang="en" source="#claude">aliquot Ho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_23.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de">interfic. <hi rend="italic">Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">interfic. Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_23.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de">du. so. <hi rend="italic">St Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">du. so. St Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_23.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verf. versteht nicht mehr, dass</hi> persoluere: doppelt zahlen <hi rend="italic">heisst</hi></seg><seg type="translation" xml:lang="en" source="#claude">The author no longer understands that persoluere means: to pay double</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_23.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de">Wergeld</seg><seg type="translation" xml:lang="en" source="#claude">wergeld</seg></note>
      </div>
    </body>
