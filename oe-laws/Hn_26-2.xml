      <div type="clause" n="26.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 26.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 26.2" corresp="#wit-lat"><pb n="562" ed="#liebermann"/>Porro qui accusantur, presertim pro capitalibus, si diem sic condictum subterfugiant respectatum, partem suam, etsi non<ptr type="liebermannNote" n="17" target="#Hn_26-2.lnote.oe.17"/> mortuam<ptr type="liebermannNote" n="g" target="#Hn_26-2.lnote.oe.g"/>, faciunt tamen egriorem.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 562 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_26-2.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Altfranz.</hi> De l’homme mort le plait est mort <hi rend="italic">bei Loysel</hi> Instit. coutum. 6, 3, 8, 864</seg><seg type="translation" xml:lang="en" source="#claude">cf. Old French De l’homme mort le plait est mort in Loysel Instit. coutum. 6, 3, 8, 864</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_26-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. vom Corr. Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above by the corrector in Sc</seg></note>
      </div>
