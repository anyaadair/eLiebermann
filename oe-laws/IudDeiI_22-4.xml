      <div type="clause" n="22.4">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 22.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 22.4" corresp="#wit-lat"><pb n="405" ed="#liebermann"/>nec patiaris recipere corpus<ptr type="liebermannNote" n="41" target="#IudDeiI_22-4.lnote.oe.41"/>, quod ab onere<ptr type="liebermannNote" n="42" target="#IudDeiI_22-4.lnote.oe.42"/> bonitatis<ptr type="liebermannNote" n="a" target="#IudDeiI_22-4.lnote.oe.a"/> inane<ptr type="liebermannNote" n="43" target="#IudDeiI_22-4.lnote.oe.43"/> est factum; sed quod caret pondere uirtutis<ptr type="liebermannNote" n="44" target="#IudDeiI_22-4.lnote.oe.44"/>, careat pondere propriae substantiae in te.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 405 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-4.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">euacuatum uentus iniquitatis alleuauit et <hi rend="italic">fügt zu Co</hi> = 20, 2</seg><seg type="translation" xml:lang="en" source="#claude">euacuatum uentus iniquitatis alleuauit et added by Co = 20, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-4.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">-pora quę <hi rend="italic">übergeschr. Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">-pora quę written above Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-4.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">honore <hi rend="italic">Ch Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">honore Ch Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-4.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">-nia sunt -ta <hi rend="italic">übergeschr. Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nia sunt -ta written above Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22-4.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">u., c. p. <hi rend="italic">fehlt Ca</hi></seg><seg type="translation" xml:lang="en" source="#claude">u., c. p. omitted in Ca</seg></note>
      </div>
