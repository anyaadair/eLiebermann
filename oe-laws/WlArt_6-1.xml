    <body>
      <div type="clause" n="6.1">
        <head><ref type="lawCode" target="law:WlArt">Wl art</ref> 6.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-h"><pb n="487" ed="#liebermann"/>Si autem<ptr type="liebermannNote" n="56" target="#WlArt_6-1.lnote.oe.56"/> Anglus<ptr type="liebermannNote" n="57" target="#WlArt_6-1.lnote.oe.57"/> infirmus<ptr type="liebermannNote" n="58" target="#WlArt_6-1.lnote.oe.58"/> fuerit, inueniat alium qui pro eo<ptr type="liebermannNote" n="59" target="#WlArt_6-1.lnote.oe.59"/> faciat.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="6.1" corresp="#wit-h"><pb n="240" ed="#robertson"/>Si autem Anglus infirmus fuerit, inveniat alium qui pro eo faciat.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-h"><pb n="241" ed="#robertson"/>If, however, the Englishman is infirm, he shall find a substitute to act for him.</ab>
        <note type="comparison" source="#liebermann" n="487"><ref target="clause:WiLad_2-1">Wl lad 2.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 2, 1</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:WiLad_2-1">Wl lad 2.1</ref></note>
        <note type="editorial">Added October 2026 from Robertson pp. 240–241 (text and translation); Liebermann’s text added from Gesetze I p. 487, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_6-1.lnote.oe.56" n="56" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">487</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier endet Ct mitten in der Columne</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ct ends here in the middle of the column</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_6-1.lnote.oe.57" n="57" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">487</biblScope></bibl><seg type="original" xml:lang="de">-licus <hi rend="italic">Hv; fehlt T Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-licus Hv; omitted T Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_6-1.lnote.oe.58" n="58" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">487</biblScope></bibl><seg type="original" xml:lang="de">f. i. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. i. <hi rend="italic">Hv</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_6-1.lnote.oe.59" n="59" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">487</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_6-1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">281</biblScope></bibl><seg type="original" xml:lang="de">Unrichtig erlaubt Verf. den Vertreter auch fürs Ordal (<hi rend="italic">s. d. Gl</hi> 26) und lässt dessen Qualifikation fort</seg><seg type="translation" xml:lang="en" source="#claude">The author wrongly permits a representative for the ordeal too (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 26) and omits his qualification</seg></note>
      </div>
    </body>
