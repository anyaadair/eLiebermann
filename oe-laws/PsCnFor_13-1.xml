      <div type="clause" n="13.1">
        <head><ref type="lawCode" target="law:PsCnFor">Ps Cn for</ref> 13.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Ps Cn for 13.1" corresp="#wit-ho-st-cii"><pb n="623" ed="#liebermann"/>Attamen<ptr type="liebermannNote" n="1" target="#PsCnFor_13-1.lnote.la.1"/> dico<ptr type="liebermannNote" n="2" target="#PsCnFor_13-1.lnote.la.2"/> uobis, si quis extraneo aut peregrino de longe uenienti, qui<ptr type="liebermannNote" n="3" target="#PsCnFor_13-1.lnote.la.3"/> sunt ab amicis alieni<ptr type="liebermannNote" n="4" target="#PsCnFor_13-1.lnote.la.4"/>, sibi ipsi nocet, si aliud<ptr type="liebermannNote" n="5" target="#PsCnFor_13-1.lnote.la.5"/> iudicium iudicauerit<ptr type="liebermannNote" n="6" target="#PsCnFor_13-1.lnote.la.6"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 623 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-ho-st-cii">Yet I say to you, if anyone [deals] with a stranger or foreigner coming from far away, who are cut off from friends, he harms himself, if he adjudges another judgment [?].</ab>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_13-1.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">623</biblScope></bibl><seg type="original" xml:lang="de">tamen <hi rend="italic">Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">tamen Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_13-1.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">623</biblScope></bibl><seg type="original" xml:lang="de">d. u. <hi rend="italic">fehlt Ho</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. u. lacking in Ho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_13-1.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">623</biblScope></bibl><seg type="original" xml:lang="de">qui s. ab a. a. <hi rend="italic">fehlt Ho</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui s. ab a. a. lacking in Ho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_13-1.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">623</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Lücke vermuthen Frühere grundlos</hi></seg><seg type="translation" xml:lang="en" source="#claude">Earlier editors suspect a lacuna, without grounds</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_13-1.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">623</biblScope></bibl><seg type="original" xml:lang="de">aliquod <hi rend="italic">Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">aliquod MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_13-1.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">623</biblScope></bibl><seg type="original" xml:lang="de">-rint <hi rend="italic">Ho</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rint Ho</seg></note>
      </div>
