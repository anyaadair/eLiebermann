      <div type="clause" n="80.11">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 80.11</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 80.11" corresp="#wit-lat"><pb n="597" ed="#liebermann"/>Hamsocna est si quis alium<ptr type="liebermannNote" n="24" target="#Hn_80-11.lnote.oe.24"/> in<ptr type="liebermannNote" n="25" target="#Hn_80-11.lnote.oe.25"/> sua uel<ptr type="liebermannNote" n="26" target="#Hn_80-11.lnote.oe.26"/> alterius domo cum haraido<ptr type="liebermannNote" n="i" target="#Hn_80-11.lnote.oe.i"/> assailliauerit<ptr type="liebermannNote" n="27" target="#Hn_80-11.lnote.oe.27"/> uel persequatur, ut portam<ptr type="liebermannNote" n="k" target="#Hn_80-11.lnote.oe.k"/> uel domum sagittet uel lapidet uel colpum<ptr type="liebermannNote" n="28" target="#Hn_80-11.lnote.oe.28"/> ostensibilem undecunque faciat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 597 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-11.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">Heeresschaar <hi rend="italic">aus Lex Ribuar.</hi> 64: hariraida (<hi rend="italic">erklärt von Sohm</hi> Mon. Germ., Leg. V 234. 254; <hi rend="italic">Geffcken</hi> Lex. Sal. 125), <hi rend="italic">was einige Codd. ähnlich wie Hn verderben; vgl.</hi> contubernales 80, 12</seg><seg type="translation" xml:lang="en" source="#claude">band of warriors, <hi rend="italic">from Lex Ribuar.</hi> 64: hariraida (<hi rend="italic">explained by Sohm</hi> Mon. Germ., Leg. V 234. 254; <hi rend="italic">Geffcken</hi> Lex. Sal. 125), <hi rend="italic">which some codd. corrupt in a similar way to Hn; cf.</hi> contubernales 80, 12</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-11.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">huys decopiez <hi rend="italic">in London um</hi> 1135 [Engl. hist. rev. 1902, 707] Mun. Gildh. <hi rend="italic">ed. Riley</hi> I 111; <hi rend="italic">zum</hi> Stossen an die Thür <hi rend="italic">als Zeichen feindlicher Absicht im Friesischen vgl. His</hi> Strafr. der Friesen 356; <hi rend="italic">Brunner</hi> DRG. II 652&lt;sup&gt;16&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude">huys decopiez <hi rend="italic">in London c.</hi> 1135 [Engl. hist. rev. 1902, 707] Mun. Gildh. <hi rend="italic">ed. Riley</hi> I 111; <hi rend="italic">on</hi> battering at the door <hi rend="italic">as a sign of hostile intent in Frisian law cf. His</hi> Strafr. der Friesen 356; <hi rend="italic">Brunner</hi> DRG. II 652&lt;sup&gt;16&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-11.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-11.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">uel, <hi rend="italic">darüber anderer Tinte</hi> in <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel, with in written above it in different ink Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-11.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">ergänzt Schmid</hi> [<hi rend="italic">unnöthig</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">in supplied by Schmid [unnecessary]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-11.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">assaliau. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">assaliau. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-11.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">culpam <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">culpam Co Or</seg></note>
      </div>
