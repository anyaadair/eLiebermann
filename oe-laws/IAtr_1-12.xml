    <body>
      <div type="clause" n="1.12">
        <head><ref type="lawCode" target="law:IAtr">I Atr</ref> 1.12</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.12" corresp="#wit-h"><pb n="218" ed="#liebermann"/>⁊ gif man þone hlaford teo, þæt he be his ræde úthleope, ladie hine mid fif þegnu<hi rend="italic">m</hi> ⁊ beo him sylf sixta.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.12" corresp="#wit-b"><pb n="218" ed="#liebermann"/>⁊ gyf<ptr type="liebermannNote" n="1" target="#IAtr_1-12.lnote.oe.1"/> mon ðone hlaford<ptr type="liebermannNote" n="18" target="#IAtr_1-12.lnote.oe.18"/> téo, þ<hi rend="italic">æt</hi> he (be<ptr type="liebermannNote" n="15" target="#IAtr_1-12.lnote.oe.15"/>) his ræde utleope<ptr type="liebermannNote" n="19a" target="#IAtr_1-12.lnote.oe.19a"/>, ladie hine mid fif ðegnu<hi rend="italic">m</hi> ⁊ beo him sylf sixta.<ptr type="liebermannNote" n="20" target="#IAtr_1-12.lnote.oe.20"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.12" corresp="#wit-q"><pb n="219" ed="#liebermann"/>Et si dominus accusetur, quod consilio suo fugerit, ladiet se cum V tainis et ipse<ptr type="liebermannNote" n="8" target="#IAtr_1-12.lnote.oe.8"/> sit sextus.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="1.12" corresp="#wit-b"><pb n="54" ed="#robertson"/>⁊ gyf mon ðone hlaford téo, þæt he be<ptr type="editorNote" n="1" target="#IAtr_1-12.robnote.fn.1"/> his ræde utleope, ladie hine mid fif ðegnum ⁊ beo him sylf sixta.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="219" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#IAtr_1-12.lnote.de.1"/> wenn der Herr beschuldigt wird, dass auf seinen Rath jener entflohen sei, reinige er sich mit fünf Thegnas und sei selbst Sechster [im Eide].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if the lord is accused of the man having escaped on his advice, let him clear himself with five thegns and be himself the sixth [in the oath].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IAtr_1-12.robnote.n.1"/><pb n="55" ed="#robertson"/>And if the lord is accused of advising him to escape, he shall clear himself with [the help of] five thegns, himself making a sixth.</ab>
        <note type="comparison" source="#liebermann" n="219"><ref target="clause:IAtr_1-8">I Atr 1.8</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. 1, 8</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_31-1a">II Cn 31.1a</ref></note>
        <note type="editorial">Liebermann compares I Atr 1.8.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-12.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">219</biblScope></bibl><seg type="original" xml:lang="de">idem <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">idem T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-12.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-12.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">-rde <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rde Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-12.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. von spät. Hd. B</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above by a later hand B</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-12.lnote.oe.19a" n="19a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-12.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">syxta <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">syxta Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IAtr_1-12.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">148</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. 1, 8¹ denselben Fall, aber einen Gefolgsmann treffend</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 1, 8¹, the same case, but concerning a follower</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IAtr_1-12.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">313</biblScope></bibl><seg type="original" xml:lang="en">Cf. § 8.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IAtr_1-12.robnote.fn.1" n="1" source="#robertson"><bibl><biblScope unit="page">54</biblScope></bibl><label>his</label><seg type="original" xml:lang="en">Added above in later handwriting in B.</seg></note>
      </div>
