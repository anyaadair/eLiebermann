      <div type="clause" n="76">
        <head>Ine Rb 76</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="76" corresp="#wit-e"><pb n="26" ed="#liebermann"/>CXX. Be þon<ptr type="liebermannNote" n="14" target="#Rubrics-Ine_76.lnote.oe.14"/> gif<ptr type="liebermannNote" n="15" target="#Rubrics-Ine_76.lnote.oe.15"/> mon oðres godsunu slea<ptr type="liebermannNote" n="16" target="#Rubrics-Ine_76.lnote.oe.16"/> oððe his godfæder.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="76" corresp="#wit-g-prol"><pb n="26" ed="#liebermann"/>CXX. Be ðan gif man oðres godsunu slea oððe his godfæder.<ptr type="liebermannNote" n="3" target="#Rubrics-Ine_76.lnote.oe.3"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="76" corresp="#wit-h"><pb n="27" ed="#liebermann"/>CXX. Be þam gif man oþres godsunu ofslea oððe his godfæder.<ptr type="liebermannNote" n="6" target="#Rubrics-Ine_76.lnote.oe.6"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="76" corresp="#wit-q"><pb n="27" ed="#liebermann"/>Qui<ptr type="liebermannNote" n="19" target="#Rubrics-Ine_76.lnote.oe.19"/> alicuius filiolum uel patrinum occiderit.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="218" ed="#jurasinski-and-oliver"/>CXX Be þon gif mon oðres godsunu slea oððe his godfæder.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="218" ed="#jurasinski-and-oliver"/>Be godfæderes oððe godsunes slæhte</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="27" ed="#liebermann"/>Von dem [Falle], wenn jemand das Pathenkind<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_76.lnote.de.1"/> eines anderen oder des anderen Gevatter erschlägt.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of the [case] when someone slays another’s godchild or the other’s godfather.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="219" ed="#jurasinski-and-oliver"/>Concerning if someone slays another person’s godson or his godfather</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="219" ed="#jurasinski-and-oliver"/>Concerning the slaying of a godfather or godson</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_76.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">26</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> Romgescot <hi rend="italic">und</hi> Dema, <hi rend="italic">dann erst Af El.</hi></seg><seg type="translation" xml:lang="en" source="#claude">followed by Romgescot and Dema, and only then Af El.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_76.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">26</biblScope></bibl><seg type="original" xml:lang="de">godfæderes oþþe godsunes slyht <hi rend="italic">Ld</hi> [<hi rend="italic">aus B?</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">godfæderes oþþe godsunes slyht Ld [from B?]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_76.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">26</biblScope></bibl><seg type="original" xml:lang="de">þe <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">þe So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_76.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">26</biblScope></bibl><seg type="original" xml:lang="de">ofslea, <hi rend="italic">ohne</hi> o. h. g. <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">ofslea, without o. h. g. So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_76.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">27</biblScope></bibl><seg type="original" xml:lang="de">De occidente f. v. p. alicuius <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">De occidente f. v. p. alicuius Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_76.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">27</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> CXXI Be blaserū ⁊ be morðslihtum; <hi rend="italic">dann zwei Zeilen leer</hi> (<hi rend="italic">für Überschrift?</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">followed by CXXI Be blaserū ⁊ be morðslihtum; then two lines left blank (for a heading?)</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_76.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">= ‘Taufkind oder dessen Taufvater’ Schmid</seg><seg type="translation" xml:lang="en" source="#claude">= ‘godchild or its godfather’ Schmid</seg></note>
      </div>
