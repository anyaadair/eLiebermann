    <body>
      <div type="clause" n="36.1[b]">
        <head><ref type="lawCode" target="law:Af">Af</ref> 36.1[b]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.1[b]" corresp="#wit-e"><pb n="68" ed="#liebermann"/>gif hine mon tio<ptr type="liebermannNote" n="46" target="#Af_36-1-b.lnote.oe.46"/> gewealdes on ðære dæde, getriowe<ptr type="liebermannNote" n="1" target="#Af_36-1-b.lnote.oe.1"/> hine be þam<ptr type="liebermannNote" n="2" target="#Af_36-1-b.lnote.oe.2"/> wite ⁊ mid ðy<ptr type="liebermannNote" n="3" target="#Af_36-1-b.lnote.oe.3"/> þæt wite afelle<ptr type="liebermannNote" n="4" target="#Af_36-1-b.lnote.oe.4"/>,</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.1[b]" corresp="#wit-h"><pb n="68" ed="#liebermann"/>Gif hine mon<ptr type="liebermannNote" n="12" target="#Af_36-1-b.lnote.oe.12"/> teo gewealdes on ðære dæde, getrywe hine be ðæm wite ond<ptr type="liebermannNote" n="1" target="#Af_36-1-b.lnote.oe.1-2"/> mid þy ðæt wite afylle<ptr type="liebermannNote" n="2" target="#Af_36-1-b.lnote.oe.2-2"/>,</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="36.1[b]" corresp="#wit-q"><pb n="69" ed="#liebermann"/>Et si<ptr type="liebermannNote" n="29" target="#Af_36-1-b.lnote.oe.29"/> possibilitatis accusetur in eo facto<ptr type="liebermannNote" n="1" target="#Af_36-1-b.lnote.oe.1-3"/>, purget se iuxta modum wite, et ita<ptr type="liebermannNote" n="2" target="#Af_36-1-b.lnote.oe.2-3"/> remaneat de wita<ptr type="liebermannNote" n="3" target="#Af_36-1-b.lnote.oe.3-2"/>,</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="78–80" ed="#attenborough"/>gif hine mon tio gewealdes on ðære dæde, getriowe<ptr type="editorNote" n="1" target="#Af_36-1-b.attnote.fn.1"/> hine be þam wite ⁊ mid ðy<ptr type="editorNote" n="2" target="#Af_36-1-b.attnote.fn.2"/> þæt wite afelle<ptr type="editorNote" n="3" target="#Af_36-1-b.attnote.fn.3"/>,</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="37.2[a]" corresp="#wit-e"><pb n="334" ed="#jurasinski-and-oliver"/>Gif hine mon tio gewealdes on ðære dæde, getriowe hine be þam wite ⁊ mid ðy þæt wite afelle.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="71" ed="#liebermann"/>Wenn er der Absicht<ptr type="liebermannNote" n="3" target="#Af_36-1-b.lnote.de.3"/> bei dieser That geziehen wird, so schwöre er sich rein mit [Eid,] dem Strafgelde [gleich hoch,] und schlage<ptr type="liebermannNote" n="4" target="#Af_36-1-b.lnote.de.4"/> damit<ptr type="liebermannNote" n="5" target="#Af_36-1-b.lnote.de.5"/> das Strafgeld nieder,</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he is accused of intent in this deed, let him clear himself by [an oath] equal to the fine, and thereby strike down the fine,</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="79" ed="#attenborough"/>and if he is accused of deliberate intention in the act, he shall clear himself with an oath equal to the fine, and thereby dismiss the claim for the fine,</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="335" ed="#jurasinski-and-oliver"/>If he is accused of violent intention in the deed, let him clear himself by [an oath equal to] the fine, and with that the fine is dismissed,</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-b.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">teo <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">teo So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-b.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">getreowie <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">getreowie Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-b.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-b.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-b.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">afylle <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">afylle So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-b.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-b.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-b.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">70</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-b.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-b.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">71</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-b.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">71</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_36-1-b.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">71</biblScope></bibl><seg type="original" xml:lang="de">wite <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">wite R</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_36-1-b.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Das Gegenteil ist <hi rend="italic">butan pleo</hi> (36, 2), womit Ælfred <hi rend="italic">innoxie</hi> übersetzt; Toller 775b; <hi rend="italic">pleo</hi> heisst ‘Verantwortlichkeit’ bei Ælfric <hi rend="italic">Gram., Prol.</hi> — Q meint ‘Absicht’; <hi rend="italic">vgl. Wb: posse</hi> 2b. — Die Absicht leugnet der Gefährdeeid; <hi rend="italic">s. d. Gl</hi> 1b; Strafe 12</seg><seg type="translation" xml:lang="en" source="#claude">The opposite is <hi rend="italic">butan pleo</hi> (36, 2), with which Ælfred translates <hi rend="italic">innoxie</hi>; Toller 775b; <hi rend="italic">pleo</hi> means ‘responsibility’ in Ælfric <hi rend="italic">Gram., Prol.</hi> — Q means ‘intention’; <hi rend="italic">cf. Wb: posse</hi> 2b. — The oath denying intent denies the intention; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1b; Strafe 12</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_36-1-b.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘tue ab’ Schmid, ‘mache hinfällig’ Wülfing <hi rend="italic">Syntax</hi> 154</seg><seg type="translation" xml:lang="en" source="#claude">‘put away’ Schmid, ‘render void’ Wülfing <hi rend="italic">Syntax</hi> 154</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_36-1-b.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">B modernisiert, Dativ statt Instrum. setzend</seg><seg type="translation" xml:lang="en" source="#claude">B modernizes, putting the dative instead of the instrumental</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_36-1-b.attnote.fn.1" n="1" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>getriowe</label><seg type="original" xml:lang="en"><hi rend="italic">getreowsie</hi>. B. <hi rend="italic">getrywe</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_36-1-b.attnote.fn.2" n="2" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>ðy</label><seg type="original" xml:lang="en"><hi rend="italic">mid ðam</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_36-1-b.attnote.fn.3" n="3" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>afelle</label><seg type="original" xml:lang="en"><hi rend="italic">afylle</hi>. B, H.</seg></note>
      </div>
