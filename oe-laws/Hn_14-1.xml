    <body>
      <div type="clause" n="14.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 14.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 14.1" corresp="#wit-lat"><pb n="559" ed="#liebermann"/>Sint<ptr type="liebermannNote" n="b" target="#Hn_14-1.lnote.oe.b"/> releuaciones<ptr type="liebermannNote" n="3" target="#Hn_14-1.lnote.oe.3"/> singulorum sicut modus sit: comitis VIII equi, IIII sellati<ptr type="liebermannNote" n="4" target="#Hn_14-1.lnote.oe.4"/> et IIII insellati<ptr type="liebermannNote" n="5" target="#Hn_14-1.lnote.oe.5"/>, et galee<ptr type="liebermannNote" n="6" target="#Hn_14-1.lnote.oe.6"/> IIII et lorice IIII cum VIII lanceis et totidem scutis et gladii IIII et C<ptr type="liebermannNote" n="c" target="#Hn_14-1.lnote.oe.c"/> mance<ptr type="liebermannNote" n="7" target="#Hn_14-1.lnote.oe.7"/> auri.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 559 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_14-1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">CHn cor. 2 <hi rend="italic">bestätigt Wilhelms I. Relevien. Die der</hi> Leis Wl 20 <hi rend="italic">weichen aber von Cnut ab</hi></seg><seg type="translation" xml:lang="en" source="#claude">CHn cor. 2 confirms William I's reliefs. Those of Leis Wl 20, however, differ from Cnut</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_14-1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> CC <hi rend="italic">aus Cnut</hi></seg><seg type="translation" xml:lang="en" source="#claude">read CC, from Cnut</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_14-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">reuela. <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">reuela. K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_14-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">s. et IIII <hi rend="italic">überspringen K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. et IIII skipped by K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_14-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">sine sella <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">sine sella Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_14-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">gallee <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">gallee Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_14-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">Quid sit manca <hi rend="italic">am Rande Corr. Sc; am Rande roth Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">Quid sit manca in the margin, by the corrector, Sc; in the margin in red Hg</seg></note>
      </div>
