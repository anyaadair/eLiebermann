        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.20a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.20a" corresp="#wit-lat"><pb n="580" ed="#liebermann"/>Intra hunc etatis terminum et hoc furti precium poterit ei aliquociens plegii<ptr type="liebermannNote" n="1" target="#Hn_59-20a.lnote.oe.1"/> beneficium prima uice subuenire<ptr type="liebermannNote" n="2" target="#Hn_59-20a.lnote.oe.2"/> condicione, sexu, participacione, euentu<ptr type="liebermannNote" n="3" target="#Hn_59-20a.lnote.oe.3"/>, furti qualitate.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 580 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-20a.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">580</biblScope></bibl><seg type="original" xml:lang="de">per legis <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">per legis <hi rend="italic">Sc Hg</hi></seg></note>
