    <body>
      <div type="clause" n="25">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 25</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="25" corresp="#wit-e"><pb n="100" ed="#liebermann"/>LXVIIII. Gif ciepemon<ptr type="liebermannNote" n="13" target="#Ine_25.lnote.oe.13"/> uppe on folce<ptr type="liebermannNote" n="14" target="#Ine_25.lnote.oe.14-2"/> ceapie, do þæt beforan gewitnessum.<ptr type="liebermannNote" n="15" target="#Ine_25.lnote.oe.15"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="25" corresp="#wit-h"><pb n="100" ed="#liebermann"/>LXIX. Gif ceapmon<ptr type="liebermannNote" n="3" target="#Ine_25.lnote.oe.3"/> uppe<ptr type="liebermannNote" n="4" target="#Ine_25.lnote.oe.4"/> on folce ceapige, dó þæt beforan<ptr type="liebermannNote" n="5" target="#Ine_25.lnote.oe.5"/> gewitnesse.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="25" corresp="#wit-b-no-prol"><pb n="100" ed="#liebermann"/>Be cypmanna fare uppe land. Gyf cepeman uppe on folce ceapige, do þ<hi rend="italic">æt</hi> beforan gewitnysse.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="25" corresp="#wit-q"><pb n="101" ed="#liebermann"/>Si mercator in populo<ptr type="liebermannNote" n="14" target="#Ine_25.lnote.oe.14"/> emat aliquid, faciat hoc coram testibus.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="44" ed="#attenborough"/>[Be cypmanna fare uppe land.] Gif ciepemon uppe on folce ceapie, do þæt beforan gewitnessum<ptr type="editorNote" n="1" target="#Ine_25.attnote.fn.1"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="25" corresp="#wit-e"><pb n="392" ed="#jurasinski-and-oliver"/>{LXVIIII} Gif ciepemon uppe on folce ceapie, do þæt beforan gewitnessum.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="101" ed="#liebermann"/>Wenn ein Kaufmann landeinwärts<ptr type="liebermannNote" n="1" target="#Ine_25.lnote.de.1"/> im Volke handelt<ptr type="liebermannNote" n="2" target="#Ine_25.lnote.de.2"/>, thue er das vor Zeugen.<ptr type="liebermannNote" n="3" target="#Ine_25.lnote.de.3"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a merchant trades up-country among the people, let him do so before witnesses.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="45" ed="#attenborough"/>If a trader [makes his way into] the interior of the country and [proceeds to] traffic, he shall do so before witnesses.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="402" ed="#whitelock"/>If a trader buys among the people in the countryside,<ptr type="editorNote" n="8" target="#Ine_25.whinote.n.8"/> he is to do it before witnesses.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="393" ed="#jurasinski-and-oliver"/>If a merchant does trade out in the countryside, let him do it in the presence of witnesses.</ab>
        <note type="comparedBy" source="#wormald-mel" n="280"><ref target="clause:Af_34">Af 34</ref></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="299"><ref target="clause:Af_34">Af 34</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_25.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">101</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> populis <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Lond; populis the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_25.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">100</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hinter</hi> p <hi rend="italic">Rasur;</hi> o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">erasure after p; o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_25.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">100</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_25.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">100</biblScope></bibl><seg type="original" xml:lang="de">foran ge <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">foran ge written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_25.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">100</biblScope></bibl><seg type="original" xml:lang="de">cypeman <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cypeman Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_25.lnote.oe.14-2" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">100</biblScope></bibl><seg type="original" xml:lang="de">folc ceapige <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">folc ceapige Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_25.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">100</biblScope></bibl><seg type="original" xml:lang="de">-nisse <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nisse Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_25.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">72</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Im Ggsatz zu Seehäfen und, laut Af 34, zu Verkehrsplätzen mit Gericht und Königsvogt. Zunächst ist nicht wie in 23 an Fremde, sondern an heimische Händler zu denken. Doch brauchen jene nicht ausgeschlossen zu sein</seg><seg type="translation" xml:lang="en" source="#claude">In contrast to seaports and, according to Af 34, to places of trade with a court and a king’s reeve. In the first instance one should think not, as in 23, of foreigners, but of native traders. The former, however, need not be excluded</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_25.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">72</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘einkauft’ zu eng und an sonstigen Stellen von Objekt begleitet</seg><seg type="translation" xml:lang="en" source="#claude">‘buys’ is too narrow, and in other passages is accompanied by an object</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_25.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">72</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘Zeugenschaft’ H cor. B; <hi rend="italic">vgl. Gl</hi> Kaufzeugen 1. 6; Handel 8c. 14b</seg><seg type="translation" xml:lang="en" source="#claude">‘witnessing’ H cor. B; <hi rend="italic">cf. Gl</hi> Kaufzeugen 1. 6; Handel 8c. 14b</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_25.attnote.fn.1" n="1" source="#attenborough"><bibl><biblScope unit="page">44</biblScope></bibl><label>gewitnessum</label><seg type="original" xml:lang="en"><hi rend="italic">gewitnesse</hi>. H. <hi rend="italic">gewitnysse</hi>. B.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Ine_25.whinote.n.8" n="8" source="#whitelock"><bibl><biblScope unit="page">402</biblScope></bibl><label>countryside</label><seg type="original" xml:lang="en"><hi rend="italic">uppe on folce.</hi> With up in this sense, cf. <hi rend="italic">uplendisc</hi> “rural, rustic”.</seg></note>
      </div>
