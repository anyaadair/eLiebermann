      <div type="clause" n="11.3">
        <head><ref type="lawCode" target="law:Af">Af</ref> 11.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11.3" corresp="#wit-e"><pb n="56" ed="#liebermann"/>Gif oðer mon<ptr type="liebermannNote" n="13" target="#Af_11-3.lnote.oe.13"/> mid hire læge ǽr, sie<ptr type="liebermannNote" n="14" target="#Af_11-3.lnote.oe.14"/> be healfum ðæm þon<hi rend="italic">ne</hi> sio<ptr type="liebermannNote" n="15" target="#Af_11-3.lnote.oe.15"/> bot.<ptr type="liebermannNote" n="16" target="#Af_11-3.lnote.oe.16"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11.3" corresp="#wit-h"><pb n="56" ed="#liebermann"/>Gif oðer mon<ptr type="liebermannNote" n="1" target="#Af_11-3.lnote.oe.1"/> mid hire læge<ptr type="liebermannNote" n="6" target="#Af_11-3.lnote.oe.6"/> ǽr, sy<ptr type="liebermannNote" n="4" target="#Af_11-3.lnote.oe.4"/> be healfum ðæm<ptr type="liebermannNote" n="7" target="#Af_11-3.lnote.oe.7"/> ðonne<ptr type="liebermannNote" n="2" target="#Af_11-3.lnote.oe.2"/> seo<ptr type="liebermannNote" n="8" target="#Af_11-3.lnote.oe.8"/> bot.<ptr type="liebermannNote" n="9" target="#Af_11-3.lnote.oe.9"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11.3" corresp="#wit-b-no-prol"><pb n="57" ed="#liebermann"/>Gif oðer man mid hire lǽge ǽr, sy be healfu<hi rend="italic">m</hi> seo bót.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="11.3" corresp="#wit-q"><pb n="57" ed="#liebermann"/>Si alius<ptr type="liebermannNote" n="18" target="#Af_11-3.lnote.oe.18"/> cum ea iacuit antea<ptr type="liebermannNote" n="19" target="#Af_11-3.lnote.oe.19"/>, sit emendatio medietas hęc.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="70" ed="#attenborough"/>Gif oðer mon mid hire læge<ptr type="editorNote" n="9" target="#Af_11-3.attnote.fn.9"/> ǽr, sie be healfum ðæm ðonne sio bot<ptr type="editorNote" n="10" target="#Af_11-3.attnote.fn.10"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="13.3" corresp="#wit-e"><pb n="306" ed="#jurasinski-and-oliver"/>Gif oðer mon mid hire læge ær, sie be healfum ðæm þon<hi rend="italic">ne</hi> sio bot.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="57" ed="#liebermann"/>Wenn schon vorher<ptr type="liebermannNote" n="1" target="#Af_11-3.lnote.de.1"/> ein anderer Mann bei ihr gelegen hat, dann sei die Busse um halb so<ptr type="liebermannNote" n="2" target="#Af_11-3.lnote.de.2"/> viel.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If another man has lain with her before, then let the compensation be half as much.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="71" ed="#attenborough"/>If another man has previously lain with her, then the compensation shall be half this [amount].</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="307" ed="#jurasinski-and-oliver"/>If another man lay with her before, let the recompense be half.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-3.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">man <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">man Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-3.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-3.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">seo <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">seo Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-3.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">bote <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">bote So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-3.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-3.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> gelæge</seg><seg type="translation" xml:lang="en" source="#claude">altered to gelæge</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-3.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">æ <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">æ on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-3.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-3.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-3.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> bote</seg><seg type="translation" xml:lang="en" source="#claude">altered to bote</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-3.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">57</biblScope></bibl><seg type="original" xml:lang="de">aliquis <hi rend="italic">Hk Brti;</hi> quis <hi rend="italic">Lond;</hi> alicuius <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">aliquis Hk Brti; quis Lond; alicuius T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11-3.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">57</biblScope></bibl><seg type="original" xml:lang="de">aīa <hi rend="italic">T;</hi> anima <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">aīa T; anima R</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_11-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">54</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd.</hi> 4b</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid.</hi> 4b</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_11-3.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">54</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Also 30 Schill.; <hi rend="italic">vgl.</hi> zur Konstruktion Wülfing <hi rend="italic">Syntax</hi> I 109; Toller s. v. <hi rend="italic">healf</hi></seg><seg type="translation" xml:lang="en" source="#claude">Thus 30 shill.; on the construction <hi rend="italic">cf.</hi> Wülfing <hi rend="italic">Syntax</hi> I 109; Toller s. v. <hi rend="italic">healf</hi></seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_11-3.attnote.fn.9" n="9" source="#attenborough"><bibl><biblScope unit="page">70</biblScope></bibl><label>læge</label><seg type="original" xml:lang="en"><hi rend="italic">gelæge</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_11-3.attnote.fn.10" n="10" source="#attenborough"><bibl><biblScope unit="page">70</biblScope></bibl><label>bot</label><seg type="original" xml:lang="en"><hi rend="italic">bote</hi>. H.</seg></note>
      </div>
