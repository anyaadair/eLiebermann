    <body>
      <div type="clause" n="46">
        <head><ref type="lawCode" target="law:Af">Af</ref> 46</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="46" corresp="#wit-e"><pb n="78" ed="#liebermann"/>XLII. Gif him mon áslea<ptr type="liebermannNote" n="31" target="#Af_46.lnote.oe.31"/> oþer eare of, geselle XXX scill. to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="46" corresp="#wit-h"><pb n="78" ed="#liebermann"/>XLII. Gif mon<ptr type="liebermannNote" n="4" target="#Af_46.lnote.oe.4"/> him ofaslea<ptr type="liebermannNote" n="15" target="#Af_46.lnote.oe.15"/> (þ<hi rend="italic">æt<ptr type="liebermannNote" n="16" target="#Af_46.lnote.oe.16"/></hi>) oðer eare, gesylle<ptr type="liebermannNote" n="2" target="#Af_46.lnote.oe.2"/> XXX scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="46" corresp="#wit-b-no-prol"><pb n="78" ed="#liebermann"/>Gyf him man ofaslea þ<hi rend="italic">æt</hi> oðer eare of<ptr type="liebermannNote" n="4" target="#Af_46.lnote.oe.4-2"/>, gesylle him ðrittig scill' to bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="46" corresp="#wit-q"><pb n="79" ed="#liebermann"/>Si<ptr type="liebermannNote" n="22" target="#Af_46.lnote.oe.22"/> auris amputetur alicui, XXX sol. emendetur (ei<ptr type="liebermannNote" n="23" target="#Af_46.lnote.oe.23"/>).</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="86" ed="#attenborough"/>Gif him mon áslea oþer eare of<ptr type="editorNote" n="3" target="#Af_46.attnote.fn.3"/>, geselle XXX scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="49" corresp="#wit-e"><pb n="350" ed="#jurasinski-and-oliver"/>{XLII} Gif him mon áfslea oþer eare of, geselle XXX scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="79" ed="#liebermann"/>Wenn man ihm das eine<ptr type="liebermannNote" n="1" target="#Af_46.lnote.de.1"/> Ohr abhaut, gebe er<ptr type="liebermannNote" n="2" target="#Af_46.lnote.de.2"/> 30 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone cuts off one of his ears, let him give 30 shillings as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="87" ed="#attenborough"/>If either ear is struck off, 30 shillings shall be given as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="351" ed="#jurasinski-and-oliver"/>If someone strikes off either ear, let him pay 30 shillings as compensation.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_46.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">78</biblScope></bibl><seg type="original" xml:lang="de">ofaslea þ<hi rend="italic">æt</hi> o. e., gesylle him ðrittig <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ofaslea þ<hi rend="italic">æt</hi> o. e., gesylle him ðrittig Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_46.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">78</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_46.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">78</biblScope></bibl><seg type="original" xml:lang="de">of asclea <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">of asclea H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_46.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">78</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_46.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">78</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_46.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">79</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">C.</hi> 46 <hi rend="italic">Pr. fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">C. 46 Pr. lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_46.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">79</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_46.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">78</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ausradirt</hi></seg><seg type="translation" xml:lang="en" source="#claude">erased</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_46.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Aus Abt 40. — Öfter setzt Af 30 Schill. (<hi rend="italic">s. d. Gl</hi> 3) für 12 Abt’s; <hi rend="italic">vgl. Gl</hi> Gliederbussen 1a; Strafgeldfixum 4; Ohr 1a. — Aus <hi rend="italic">oðer</hi> folgt nicht, vorher sei etwas ausgefallen. H B scheinen die Bed. von <hi rend="italic">oðer</hi> ‘der eine’ nicht mehr zu kennen</seg><seg type="translation" xml:lang="en" source="#claude">From Abt 40. — Af often sets 30 shill. (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 3) for Abt’s 12; <hi rend="italic">cf. Gl</hi> Gliederbussen 1a; Strafgeldfixum 4; Ohr 1a. — It does not follow from <hi rend="italic">oðer</hi> that something has dropped out before it. H B seem no longer to know the meaning of <hi rend="italic">oðer</hi> ‘the one’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_46.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘ihm’ fügt B unnötig hinzu</seg><seg type="translation" xml:lang="en" source="#claude">B adds ‘him’ unnecessarily</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_46.attnote.fn.3" n="3" source="#attenborough"><bibl><biblScope unit="page">86</biblScope></bibl><label>of</label><seg type="original" xml:lang="en"><hi rend="italic">ofaslea þæt oðer eare of</hi>. B. <hi rend="italic">ofasclea (þæt) oðer eare</hi>. H*.</seg></note>
      </div>
