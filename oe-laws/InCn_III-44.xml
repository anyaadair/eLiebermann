      <div type="clause" n="III 44">
        <head><ref type="lawCode" target="law:InCn">In Cn</ref> III 44</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="In Cn III 44" corresp="#wit-lat"><pb n="613" ed="#liebermann"/>Sacramentum liberalis<ptr type="liebermannNote" n="i" target="#InCn_III-44.lnote.oe.i"/> hominis, quem<ptr type="liebermannNote" n="25" target="#InCn_III-44.lnote.oe.25"/> quidem<ptr type="liebermannNote" n="26" target="#InCn_III-44.lnote.oe.26"/> Angli<ptr type="liebermannNote" n="27" target="#InCn_III-44.lnote.oe.27"/> uocant<ptr type="liebermannNote" n="28" target="#InCn_III-44.lnote.oe.28"/> tƿelfhende<ptr type="liebermannNote" n="29" target="#InCn_III-44.lnote.oe.29"/> (man<ptr type="liebermannNote" n="30" target="#InCn_III-44.lnote.oe.30"/>), debet stare et ualere iuramentum sex<ptr type="liebermannNote" n="31" target="#InCn_III-44.lnote.oe.31"/> uillanorum, quia<ptr type="liebermannNote" n="32" target="#InCn_III-44.lnote.oe.32"/> prętium eius est<ptr type="liebermannNote" n="33" target="#InCn_III-44.lnote.oe.33"/>, id est ƿeregeld<ptr type="liebermannNote" n="k" target="#InCn_III-44.lnote.oe.k"/><ptr type="liebermannNote" n="34" target="#InCn_III-44.lnote.oe.34"/>, sex<ptr type="liebermannNote" n="35" target="#InCn_III-44.lnote.oe.35"/> uillanorum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 613 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">überfrei, adlig <hi rend="italic">auch S.</hi> 621&lt;sup&gt;a&lt;/sup&gt;. 624&lt;sup&gt;m&lt;/sup&gt;; <hi rend="italic">schon Cnuts Urkunden setzen</hi> þegn <hi rend="italic">und</hi> twelfhynde <hi rend="italic">synonym</hi></seg><seg type="translation" xml:lang="en" source="#claude">more than free, noble, also p. 621&lt;sup&gt;a&lt;/sup&gt;. 624&lt;sup&gt;m&lt;/sup&gt;; Cnut’s charters already use þegn and twelfhynde as synonyms</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">endet Di und Ip Hunt, nämlich LbRcSPlCtJoVa;</hi> Expliciunt (-cit <hi rend="italic">Pl</hi>) hic institutiones (-ucio <hi rend="italic">Pl;</hi> const. <hi rend="italic">Jo</hi>) Cnuti regis <hi rend="italic">fügen zu PlSJoVa</hi></seg><seg type="translation" xml:lang="en" source="#claude">Di ends here, as does Ip Hunt, i.e. LbRcSPlCtJoVa; Expliciunt (-cit Pl) hic institutiones (-ucio Pl; const. Jo) Cnuti regis added by PlSJoVa</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt T</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">quidam <hi rend="italic">Cb; fehlt LbPlSCtJoVa</hi></seg><seg type="translation" xml:lang="en" source="#claude">quidam Cb; missing in LbPlSCtJoVa</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt CbS</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in CbS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">dicunt <hi rend="italic">LbPlSJoVa</hi></seg><seg type="translation" xml:lang="en" source="#claude">dicunt LbPlSJoVa</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">-hænde <hi rend="italic">HDiRl;</hi> thel. <hi rend="italic">Va;</hi> chel. <hi rend="italic">Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-hænde HDiRl; thel. Va; chel. Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">VII <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">VII Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">S;</hi> quia—uillanorum <hi rend="italic">fehlt CbT</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod S; quia—uillanorum missing in CbT</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt CtJo</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in CtJo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Rl;</hi> wer. <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Rl; wer. H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">s. u. <hi rend="italic">aus HRl</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. u. from HRl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.i-2" n="i" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">332</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Thegn 1i; Adel 1f. g; <hi rend="italic">Wb: liber(alis, -alitas)</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Thegn 1i; Adel 1f. g; <hi rend="italic">Wb: liber(alis, -alitas)</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.k-2" n="k" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">332</biblScope></bibl><seg type="original" xml:lang="de">Kein Verfasserwechsel; <hi rend="italic">s. o</hi>. Einl. 4</seg><seg type="translation" xml:lang="en" source="#claude">No change of author; <hi rend="italic">see above</hi> Introduction 4</seg></note>
      </div>
