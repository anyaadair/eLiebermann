      <div type="clause" n="11.11">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 11.11</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 11.11" corresp="#wit-lat"><pb n="557" ed="#liebermann"/>Si<ptr type="liebermannNote" n="e" target="#Hn_11-11.lnote.oe.e"/> quis Dei rectitudines per uim teneat, soluat lahslit<ptr type="liebermannNote" n="24" target="#Hn_11-11.lnote.oe.24"/> cum Dacis, plenam witam<ptr type="liebermannNote" n="25" target="#Hn_11-11.lnote.oe.25"/> cum Anglis<ptr type="liebermannNote" n="26" target="#Hn_11-11.lnote.oe.26"/>; aut<ptr type="liebermannNote" n="27" target="#Hn_11-11.lnote.oe.27"/> neget cum undecim<ptr type="liebermannNote" n="28" target="#Hn_11-11.lnote.oe.28"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 557 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-11.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt</hi> 66, 5; <hi rend="italic">kürzer</hi> 13, 11</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">repeated</hi> 66, 5; <hi rend="italic">more briefly</hi> 13, 11</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-11.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de">-lut, <hi rend="italic">geänd.</hi> -lūg <hi rend="italic">Sc;</hi> lahslūg <hi rend="italic">Hg;</hi> laslith <hi rend="italic">K;</hi> lastlith <hi rend="italic">Co Or;</hi> lashlite <hi rend="italic">Wh Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lut, <hi rend="italic">altered to</hi> -lūg <hi rend="italic">Sc;</hi> lahslūg <hi rend="italic">Hg;</hi> laslith <hi rend="italic">K;</hi> lastlith <hi rend="italic">Co Or;</hi> lashlite <hi rend="italic">Wh Wi</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-11.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de">wyt. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">wyt. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-11.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de">-icis <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-icis <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-11.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de">aut neget — witam <hi rend="italic">übersprungen, Corr. am Rande Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">aut neget — witam <hi rend="italic">omitted, supplied by the corrector in the margin Sc</hi></seg></note>
