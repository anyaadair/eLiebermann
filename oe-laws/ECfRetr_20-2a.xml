    <body>
      <div type="clause" n="20.2a">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 20.2a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 20.2a"><pb n="645" ed="#liebermann"/>de suo <hi rend="bold">illico</hi><ptr type="liebermannNote" n="39" target="#ECfRetr_20-2a.lnote.la.39"/> restauraretur<ptr type="liebermannNote" n="40" target="#ECfRetr_20-2a.lnote.la.40"/> damnum quod fecerat; et, si ad<ptr type="liebermannNote" n="41" target="#ECfRetr_20-2a.lnote.la.41"/> hoc forisfecit, de corpore suo iustitia<ptr type="liebermannNote" n="42" target="#ECfRetr_20-2a.lnote.la.42"/> fieret.</ab>
        <note type="comparison" source="#liebermann" n="645"><label>printed alongside</label> <ref target="clause:ECf_20-2a">ECf 20.2a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 645 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-2a.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">dico <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">dico Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-2a.lnote.la.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">-uretur <hi rend="italic">Cb;</hi> -uratur <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uretur Cb; -uratur Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-2a.lnote.la.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">adhuc f. <hi rend="italic">Lb;</hi> adhuc forisfecerit <hi rend="italic">Va Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">adhuc f. Lb; adhuc forisfecerit Va Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_20-2a.lnote.la.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">645</biblScope></bibl><seg type="original" xml:lang="de">f. i. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. i. Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">the damage which he had done should at once be made good from his own; and, if he has offended to that extent, justice should be done on his body.</ab>
      </div>
