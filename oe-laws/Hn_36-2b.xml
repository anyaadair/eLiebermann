        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 36.2b" corresp="#wit-lat"><pb n="567" ed="#liebermann"/>Si uero contigerit, ut pro emendacione et satisfaccione auferatur aliquid, recipi debet<ptr type="liebermannNote" n="1" target="#Hn_36-2b.lnote.oe.1"/> et retineri potest ex toto uel<ptr type="liebermannNote" n="2" target="#Hn_36-2b.lnote.oe.2"/> ex parte, sicut causa dictauerit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 567 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-2b.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de">debeat <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">debeat Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_36-2b.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">567</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. vom Corr. aus</hi> ue lex per te <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the corrector from ue lex per te Sc</seg></note>
