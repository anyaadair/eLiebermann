      <div type="clause" n="8.2">
        <head><ref type="lawCode" target="law:Duel">Duel</ref> 8.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Duel 8.2" corresp="#wit-lat"><ptr type="liebermannNote" n="54" target="#Duel_8-2.lnote.oe.54"/><pb n="431" ed="#liebermann"/>Confortet te Spiritus sanctus! Amen<ptr type="liebermannNote" n="53" target="#Duel_8-2.lnote.oe.53"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 431 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_8-2.lnote.oe.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr Ym Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Tr Ym Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_8-2.lnote.oe.54" n="54" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">8, 2 <hi rend="italic">fehlt Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">8, 2 missing in Ym</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">May the Holy Spirit strengthen you! Amen.</ab>
      </div>
