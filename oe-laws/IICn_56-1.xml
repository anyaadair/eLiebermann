    <body>
      <div type="clause" n="56.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 56.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="56.1" corresp="#wit-g-a"><pb n="348" ed="#liebermann"/>⁊ gif hit tihtle sig<ptr type="liebermannNote" n="9" target="#IICn_56-1.lnote.oe.9"/>, ⁊ æt lade mistide, deme se bisceop.<ptr type="liebermannNote" n="16" target="#IICn_56-1.lnote.oe.16-2"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="56.1" corresp="#wit-b"><pb n="348" ed="#liebermann"/>⁊ gif hit tihtle sy, ⁊ æt lade mistide, deme se bisceop.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="56.1" corresp="#wit-a"><pb n="348" ed="#liebermann"/>⁊ gif hit tihtle sy, ⁊ æt læde<ptr type="liebermannNote" n="4" target="#IICn_56-1.lnote.oe.4"/> mistide, deme se biscop.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="56.1" corresp="#wit-q"><pb n="349" ed="#liebermann"/>Et si compellatio sit, et in emundatione<ptr type="liebermannNote" n="16" target="#IICn_56-1.lnote.oe.16"/> míseueniat, iudicet episcopus.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="56.1" corresp="#wit-inst-cn"><pb n="349" ed="#liebermann"/>Et si purgatio euenerit, et in purgatione<ptr type="liebermannNote" n="14" target="#IICn_56-1.lnote.oe.14"/> ceciderit, episcopus uideat et iudicet.<ptr type="liebermannNote" n="15" target="#IICn_56-1.lnote.oe.15"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="56.1" corresp="#wit-cons-cn"><pb n="349" ed="#liebermann"/>[56, 1] Quodsi accusacio sit, et inficianti purgamine male succedat, episcopi iudicium subeat.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="56.1" corresp="#wit-b"><pb n="202" ed="#robertson"/>⁊ gif hit tihtle sy ⁊ æt lade mistide, deme se bisceop.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="284" ed="#rabin-doml"/>And gif hit tihtle sig and æt lade mistide, deme se bisceop.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="349" ed="#liebermann"/>Wenn es jedoch eine [leugbare] Anklage ist und es bei der Reinigung misslingt, so urtheile der Bischof.<ptr type="liebermannNote" n="1" target="#IICn_56-1.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If, however, it is a [deniable] accusation and the clearing [oath] fails, let the bishop judge.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="203" ed="#robertson"/>And if the accusation<ptr type="editorNote" n="1" target="#IICn_56-1.robnote.n.1"/> is brought and the attempt [of the accused] to clear himself fails, the bishop<ptr type="editorNote" n="2" target="#IICn_56-1.robnote.n.2"/> shall pronounce judgment.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="470" ed="#whitelock"/>And if an accusation is brought, and [the accused] fails at the exculpation, the bishop is to give judgment.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="285" ed="#rabin-doml"/>And if there is an accusation and the oath of exculpation fails, the bishop shall judge the case.</ab>
        <note type="editorial">BR: added from Gesetze I p. 349, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_56-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">349</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so R;</hi> emen. <hi rend="italic">KDm</hi> [<hi rend="italic">vgl. oben</hi> 53, 1]</seg><seg type="translation" xml:lang="en" source="#claude">thus R; emen. KDm [cf. above 53, 1]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_56-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">348</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_56-1.lnote.oe.16-2" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">348</biblScope></bibl><seg type="original" xml:lang="de">-cop <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cop Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_56-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">348</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_56-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">349</biblScope></bibl><seg type="original" xml:lang="de">purificatione <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">purificatione S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_56-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">349</biblScope></bibl><seg type="original" xml:lang="de">uindicet <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">uindicet Cb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_56-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">210</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Nur über die Strafe entscheidet der Bischof (<hi rend="italic">s. d. Gl</hi> 91) wie <hi rend="italic">o</hi>. 53, 1³. Vielleicht weil Mord der Zauberei verwandt erschien, gehört auch seine Bestrafung der Kirche</seg><seg type="translation" xml:lang="en" source="#claude">The bishop (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 91) decides only on the punishment, as <hi rend="italic">above</hi> 53, 1³. Perhaps because murder seemed akin to sorcery, its punishment too belongs to the Church</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_56-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">357</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e.</hi> a suspicion which has to be proved.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_56-1.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">357</biblScope></bibl><seg type="original" xml:lang="en">Cf. cap. 53, 1. Liebermann suggests that the decision with regard to the penalty may have rested with the bishop in this case because of the belief that the death of an enemy was frequently brought about by magical arts.</seg></note>
      </div>
    </body>
