      <div type="clause" n="90.11c">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 90.11c</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 90.11c" corresp="#wit-lat"><pb n="606" ed="#liebermann"/>Ex quibus sunt<ptr type="liebermannNote" n="22" target="#Hn_90-11c.lnote.oe.22"/>: Si quis alii missione in missatico causa mortis sit; si quis pro quolibet mittat, et in ueniendo occidatur; si quis mortem incidat<ptr type="liebermannNote" n="23" target="#Hn_90-11c.lnote.oe.23"/> ab aliquo uocatus; si<ptr type="liebermannNote" n="24" target="#Hn_90-11c.lnote.oe.24"/> alicuius arma<ptr type="liebermannNote" n="n" target="#Hn_90-11c.lnote.oe.n"/> perimant aliquem, ibidem posita ab eo cuius erant; si quis ea deiecerit, siue occisus siue alius et noceant; si quis uocatus [i]n<ptr type="liebermannNote" n="25" target="#Hn_90-11c.lnote.oe.25"/> alicuius alicubi reposita arma transfigatur; si quis<ptr type="liebermannNote" n="26" target="#Hn_90-11c.lnote.oe.26"/> aliquem terreat<ptr type="liebermannNote" n="o" target="#Hn_90-11c.lnote.oe.o"/> uel inpellat<ptr type="liebermannNote" n="27" target="#Hn_90-11c.lnote.oe.27"/>, ut equo<ptr type="liebermannNote" n="p" target="#Hn_90-11c.lnote.oe.p"/> uel aliunde cadens malum habeat; si quis ad spectaculum<ptr type="liebermannNote" n="28" target="#Hn_90-11c.lnote.oe.28"/> fere<ptr type="liebermannNote" n="q" target="#Hn_90-11c.lnote.oe.q"/> uel insani<ptr type="liebermannNote" n="29" target="#Hn_90-11c.lnote.oe.29"/> ductus aliquid paciatur ab eis; si quis equum uel aliud cuiquam<ptr type="liebermannNote" n="30" target="#Hn_90-11c.lnote.oe.30"/> commendat, et inde malum ei ueniat; si alicuius equus<ptr type="liebermannNote" n="31" target="#Hn_90-11c.lnote.oe.31"/> ab aliquo stimulatus<ptr type="liebermannNote" n="32" target="#Hn_90-11c.lnote.oe.32"/> uel subcaudatus<ptr type="liebermannNote" n="r" target="#Hn_90-11c.lnote.oe.r"/> quemlibet percuciat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 606 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11c.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 88, 2; <hi rend="italic">ist Eigenthümer und Hinleger der Waffen nicht identisch, so haftet letzterer; Frank</hi> Casuelle Tödtung 29</seg><seg type="translation" xml:lang="en" source="#claude">cf. 88, 2; if the owner of the weapons and the person who laid them down are not the same, the latter is liable; Frank Casuelle Tödtung 29</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11c.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 88, 5</seg><seg type="translation" xml:lang="en" source="#claude">cf. 88, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11c.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Somner vergleicht</hi> Edict. Rothari 373: Si seruus regis .. marahuorf .. fecerit; 30: marahworfin: si quis hominem de caballo iactauerit. <hi rend="italic">Ähnliches bei Alamannen, Baiern, Frisen; Brunner</hi> DRG. II 637</seg><seg type="translation" xml:lang="en" source="#claude">Somner compares Edict. Rothari 373: Si seruus regis .. marahuorf .. fecerit; 30: marahworfin: si quis hominem de caballo iactauerit. Similar provisions among the Alamanni, Bavarians and Frisians; Brunner DRG. II 637</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11c.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Archiv f. neu. Spra. CVII, <hi rend="italic">S.</hi> 106</seg><seg type="translation" xml:lang="en" source="#claude">cf. Archiv f. neu. Spra. CVII, p. 106</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11c.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">unter dem Schwanz gereizt; <hi rend="italic">Somner.</hi> [<hi rend="italic">Ducange kennt</hi> soucouer[?], <hi rend="italic">verbindet es mit</hi> secouer, subcutere <hi rend="italic">und versteht</hi> ad caudam et nates flagello urgere, <hi rend="italic">beides falsch.</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">goaded under the tail; Somner. [Ducange knows soucouer[?], connects it with secouer, subcutere and understands ad caudam et nates flagello urgere; both wrong.]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11c.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Hg;</hi> finit <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Hg; finit Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11c.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">insc. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">insc. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11c.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">si — uocatus <hi rend="italic">überspringt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">si — uocatus skipped K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11c.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">an <hi rend="italic">Hss.; geändert</hi> ad <hi rend="italic">Sc; gebessert Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">an MSS; altered to ad Sc; emended edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11c.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">aliquis <hi rend="italic">fügt zu K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">aliquis added K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11c.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">impleat <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">impleat Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11c.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">-andum <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-andum Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11c.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">uisam d. a. prestatur <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">uisam d. a. prestatur K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11c.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">cuidam <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">cuidam K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11c.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing K Co Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11c.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">stumulatus <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">stumulatus K</seg></note>
      </div>
