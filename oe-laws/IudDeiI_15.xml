      <div type="clause" n="15">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 15</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 15" corresp="#wit-lat"><ptr type="liebermannNote" n="55" target="#IudDeiI_15.lnote.oe.55"/><pb n="403" ed="#liebermann"/>Benedictio<ptr type="liebermannNote" n="56" target="#IudDeiI_15.lnote.oe.56"/> ad iudicium<ptr type="liebermannNote" n="57" target="#IudDeiI_15.lnote.oe.57"/>. Deus, de quo scriptum est, quia<ptr type="liebermannNote" n="58" target="#IudDeiI_15.lnote.oe.58"/> iustus es, et rectum iudicium tuum, fac cum his<ptr type="liebermannNote" n="59" target="#IudDeiI_15.lnote.oe.59"/> seruis<ptr type="liebermannNote" n="60" target="#IudDeiI_15.lnote.oe.60"/> tuis secundum misericordiam tuam, ut non de pristinis iudicentur<ptr type="liebermannNote" n="61" target="#IudDeiI_15.lnote.oe.61"/> reatibus, sed in hoc, prout meruerunt<ptr type="liebermannNote" n="62" target="#IudDeiI_15.lnote.oe.62"/>, tua benedictione praeueniente, ueritatis subsequantur<ptr type="liebermannNote" n="63" target="#IudDeiI_15.lnote.oe.63"/> iudicium. Amen.</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">s. o. 4</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 403 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15.lnote.oe.55" n="55" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">15—15, 2 <hi rend="italic">fehlt Ca Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">15—15, 2 lacking in Ca Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15.lnote.oe.56" n="56" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">-iones <hi rend="italic">Rj Ca H;</hi> B. ad i. <hi rend="italic">fehlt Al Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iones Rj Ca H; B. ad i. lacking in Al Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15.lnote.oe.57" n="57" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">missam <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">missam Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15.lnote.oe.58" n="58" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Al Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by Al Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15.lnote.oe.59" n="59" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">hoc <hi rend="italic">Al; fehlt Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">hoc Al; lacking in Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15.lnote.oe.60" n="60" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de">seruo tuo—iudicetur <hi rend="italic">stets Singular Al Ma;</hi> hoc seruo tuo, <hi rend="italic">übergeschr.</hi> his seruis tuis <hi rend="italic">Ch Ci; übergeschr.</hi> hoc -o -o <hi rend="italic">Rj H;</hi> uel ancilla uel his ancillis tuis <hi rend="italic">übergeschr. Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">seruo tuo—iudicetur always in the singular Al Ma; hoc seruo tuo, with his seruis tuis written above, Ch Ci; hoc -o -o written above Rj H; uel ancilla uel his ancillis tuis written above Vt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15.lnote.oe.61" n="61" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi> -etur <hi rend="italic">Rj H;</hi> -cetur, <hi rend="italic">übergeschr.</hi> uel -centur <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">-etur written above Rj H; -cetur, with uel -centur written above, Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15.lnote.oe.62" n="62" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi> -it <hi rend="italic">Rj H;</hi> -it, <hi rend="italic">übergeschr.</hi> -erunt <hi rend="italic">Ch Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">-it written above Rj H; -it, with -erunt written above, Ch Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_15.lnote.oe.63" n="63" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">403</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi> -atur <hi rend="italic">Rj H;</hi> -atur, <hi rend="italic">übergeschr.</hi> -antur <hi rend="italic">Ch;</hi> sententiam sequatur (-antur) <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">-atur written above Rj H; -atur, with -antur written above, Ch; sententiam sequatur (-antur) Ci</seg></note>
      </div>
