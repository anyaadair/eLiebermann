    <body>
      <div type="clause" n="4.3">
        <head><ref type="lawCode" target="law:IudDeiXI">Iud Dei XI</ref> 4.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XI 4.3" corresp="#wit-lat"><pb n="419" ed="#liebermann"/>ut sit refrigerium illud portantibus et habentibus iustitiam et<ptr type="liebermannNote" n="23" target="#IudDeiXI_4-3.lnote.oe.23"/> fortitudinem<ptr type="liebermannNote" n="24" target="#IudDeiXI_4-3.lnote.oe.24"/>, et sit ignis ardens iniquis et facientibus iniqua et credentibus in iniustitiam<ptr type="liebermannNote" n="25" target="#IudDeiXI_4-3.lnote.oe.25"/> suam et<ptr type="liebermannNote" n="26" target="#IudDeiXI_4-3.lnote.oe.26"/> pompam diabolicam.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 419 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXI_4-3.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">419</biblScope></bibl><seg type="original" xml:lang="de">credentibus in tuam iustitiam et <hi rend="italic">überspringen schon einige der festländischen Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">credentibus in tuam iustitiam et is already skipped by some of the Continental MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXI_4-3.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">419</biblScope></bibl><seg type="original" xml:lang="de">rectitudinem <hi rend="italic">Vt2</hi></seg><seg type="translation" xml:lang="en" source="#claude">rectitudinem Vt2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXI_4-3.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">419</biblScope></bibl><seg type="original" xml:lang="de">-iciam <hi rend="italic">Tb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iciam Tb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXI_4-3.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">419</biblScope></bibl><seg type="original" xml:lang="de">iniustam <hi rend="italic">fügen bessere, aber schon auf dem Festland nicht alle, Hss. hinzu</hi></seg><seg type="translation" xml:lang="en" source="#claude">iniustam is added by better MSS, though even on the Continent not by all</seg></note>
      </div>
