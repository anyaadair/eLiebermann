      <div type="clause" n="87.6a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 87.6a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 87.6a" corresp="#wit-lat"><pb n="602" ed="#liebermann"/>Quia, sicut prediximus, multis modis potest homo<ptr type="liebermannNote" n="d" target="#Hn_87-6a.lnote.oe.d"/> weram suam forisfacere, ut per hamsocnam, per<ptr type="liebermannNote" n="4" target="#Hn_87-6a.lnote.oe.4"/> homicidium in ecclesia, per Dei rectum difforciatum, per furtum, per murdrum, per iniustum assultum uel<ptr type="liebermannNote" n="5" target="#Hn_87-6a.lnote.oe.5"/> homicidium et deinceps similium<ptr type="liebermannNote" n="e" target="#Hn_87-6a.lnote.oe.e"/>, de quibus wera parentibus, manbota domino et wita<ptr type="liebermannNote" n="6" target="#Hn_87-6a.lnote.oe.6"/> iusticiis<ptr type="liebermannNote" n="ee" target="#Hn_87-6a.lnote.oe.ee"/> remanet.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 602 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-6a.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">jemand die Zahlungen, <hi rend="italic">die eintreten würden bei Todtschlag</hi> an ihm, durch Missethat aufheben. <hi rend="italic">Vgl.</hi> 11, 11<hi rend="italic">c</hi>. 88, 5</seg><seg type="translation" xml:lang="en" source="#claude">a person [can] by misdeed cancel the payments <hi rend="italic">that would fall due if he were slain</hi>. <hi rend="italic">Cf.</hi> 11, 11<hi rend="italic">c</hi>. 88, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-6a.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 80, 9<hi rend="italic">b</hi>&lt;sup&gt;19&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 80, 9<hi rend="italic">b</hi>&lt;sup&gt;19&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-6a.lnote.oe.ee" n="ee" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">dem jedesmaligen Gerichtsherrn entgeht.</seg><seg type="translation" xml:lang="en" source="#claude">is lost to the lord of the court in each case.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-6a.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">p. ho. <hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. ho. missing in K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-6a.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">per <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">per K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-6a.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">-am iustius remanent <hi rend="italic">Sc Hg, wo</hi> -n‘et</seg><seg type="translation" xml:lang="en" source="#claude">-am iustius remanent Sc Hg, where -n‘et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-6a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Wergeld 17a; Totschlag 3—<hi rend="italic">per</hi>{5}—<hi rend="italic">w</hi>.{8} <hi rend="italic">iustius remaneret</hi>. 87, 7—<hi rend="italic">egerit</hi>{13} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Wergeld 17a; Totschlag 3—<hi rend="italic">per</hi>{5}—<hi rend="italic">w</hi>.{8} <hi rend="italic">iustius remaneret</hi>. 87, 7—<hi rend="italic">egerit</hi>{13} Rs</seg></note>
      </div>
