    <body>
      <div type="clause" n="9.1">
        <head><ref type="lawCode" target="law:EGu">EGu</ref> 9.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="9.1" corresp="#wit-h"><pb n="132" ed="#liebermann"/>Gif man<ptr type="liebermannNote" n="7" target="#EGu_9-1.lnote.oe.7"/> wealdan mage<ptr type="liebermannNote" n="21" target="#EGu_9-1.lnote.oe.21"/>, ne dyde man<ptr type="liebermannNote" n="7" target="#EGu_9-1.lnote.oe.7"/> næfre on Sunnandæges<ptr type="liebermannNote" n="22" target="#EGu_9-1.lnote.oe.22"/> freolse ænigne forwyrhtne, ac wylde ⁊ healde, þ<hi rend="italic">æt</hi> se freolsdæg<ptr type="liebermannNote" n="23" target="#EGu_9-1.lnote.oe.23"/> agan sy.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="9.1" corresp="#wit-b"><pb n="132" ed="#liebermann"/>Gyf man wealdan mæge, ne dyde man næfre on Sunnandæges freolse ænigne forwyrhtne, ac wylde ⁊ healde, þ<hi rend="italic">æt</hi> se freolsdæg agan sy.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="9.1" corresp="#wit-q"><pb n="133" ed="#liebermann"/>Si fieri possit, numquam occidatur aliquis in festo dominice<ptr type="liebermannNote" n="31" target="#EGu_9-1.lnote.oe.31"/> diei, quidquid peccauerit; sed capiatur et seruetur, donec festus<ptr type="liebermannNote" n="32" target="#EGu_9-1.lnote.oe.32"/> dies transierit.<ptr type="liebermannNote" n="33" target="#EGu_9-1.lnote.oe.33"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="9.1" corresp="#wit-h"><pb n="106" ed="#attenborough"/>Gif man wealdan mage, ne dyde man næfre on Sunnandæges freolse ænigne forwyrhtne, ac wylde ⁊ healde, þæt se freolsdæg agan sy.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-h"><pb n="8" ed="#rabin-doml"/>Gif man wealdan mage, ne dyde man næfre on Sunnandæges freolse ænigne forwyrhtne, ac wylde and healde þæt se freolsdæg agan sy.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="133" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#EGu_9-1.lnote.de.1"/> einzurichten möglich ist, richte man niemals in der Sonntagsfeier irgend<ptr type="liebermannNote" n="2" target="#EGu_9-1.lnote.de.2"/> welchen Verurtheilten hin, sondern bewältige und halte [ihn fest, bis] dass der Feiertag vergangen ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If it can be arranged, let no condemned man ever be executed during the Sunday feast, but let him be overpowered and held [until] the feast-day is past.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="107" ed="#attenborough"/>If it can be so contrived, no capital offender shall ever be put to death during the feast of Sunday, but he shall be arrested and kept in custody until the festival is over.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-h"><pb n="9" ed="#rabin-doml"/>If it can be managed, no one sentenced to death should ever be executed on a Sunday festival, but he is to be confined and held until the holy day has ended.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_45">II Cn 45</ref></note>
        <note type="comparedBy" source="#wormald-ppmel" n="58"><ref target="clause:IICn_44-1">II Cn 44.1</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="359"><ref target="clause:IICn_45">II Cn 45</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_9-1.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">133</biblScope></bibl><seg type="original" xml:lang="de">di. do. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">di. do. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_9-1.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">133</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K;</hi> tr. festa d. <hi rend="italic">Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in K; tr. festa d. Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_9-1.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">133</biblScope></bibl><seg type="original" xml:lang="de">transeat <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">transeat MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_9-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">mon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_9-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">a <hi rend="italic">auf Rasur? H;</hi> mæge <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">a on an erasure? H; mæge Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_9-1.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">-dages <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dages Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_9-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">-ge agân <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ge agân Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_9-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Wiederholt II Cn 45, 1. <hi rend="italic">Vgl.</hi> Dunstans Zuwiderhandeln <hi rend="italic">Gl</hi> Feiertag 8d; Sonntag 5; Gefängnis 5</seg><seg type="translation" xml:lang="en" source="#claude">Repeated in II Cn 45, 1. <hi rend="italic">Cf.</hi> Dunstan’s contravention <hi rend="italic">Gl</hi> Feiertag 8d; Sonntag 5; Gefängnis 5</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_9-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">= ‘noch so schworen’ Q richtig</seg><seg type="translation" xml:lang="en" source="#claude">= ‘however grave’ Q, correctly</seg></note>
      </div>
