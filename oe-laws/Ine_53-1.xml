        <note type="editorNote" subtype="footnote" xml:id="Ine_53-1.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">54</biblScope></bibl><label>ierfe</label><seg type="original" xml:lang="en"><hi rend="italic">ðæm yrf</hi>. Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_53-1.attnote.fn.9" n="9" source="#attenborough"><bibl><biblScope unit="page">54</biblScope></bibl><label>unbeceasne</label><seg type="original" xml:lang="en"><hi rend="italic">unbesacene</hi>. H &amp; B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_53-1.attnote.fn.10" n="10" source="#attenborough"><bibl><biblScope unit="page">54</biblScope></bibl><label>deada</label><seg type="original" xml:lang="en"><hi rend="italic">deade</hi>. B.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_53-1.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">190</biblScope></bibl><seg type="original" xml:lang="en">In this clause <hi rend="italic">ierfe</hi> appears to be used in two different senses. In the first three instances, it denotes the whole of the estate of the dead man; in the last, the particular piece of property which is in dispute.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_53-1.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">191</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e.</hi> the slave or any other article which is in dispute.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Ine_53-1.whinote.n.1" n="1" source="#whitelock"><bibl><biblScope unit="page">406</biblScope></bibl><label>purchase</label><seg type="original" xml:lang="en"><hi rend="italic">ceap</hi> will refer either to the transaction of purchasing, or to the thing purchased. Attenborough translates here “[his title to] the chattel”.</seg></note>
      </div>
