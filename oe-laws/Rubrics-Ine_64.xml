      <div type="clause" n="64">
        <head>Ine Rb 64</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="64" corresp="#wit-e"><pb n="26" ed="#liebermann"/>CVIII.<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_64.lnote.oe.2"/> Be<ptr type="liebermannNote" n="*" target="#Rubrics-Ine_64.lnote.oe.star"/> þon þe hæfð XX hida londes.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="64" corresp="#wit-g-prol"><pb n="26" ed="#liebermann"/>CVIII. Be ðan þe hæfð XX hida landes.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="64" corresp="#wit-h"><pb n="27" ed="#liebermann"/>CVIII. Be þon<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_64.lnote.oe.2-3"/> ðe hæfð XX hida londes.<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_64.lnote.oe.1"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="64" corresp="#wit-q"><pb n="27" ed="#liebermann"/>De<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_64.lnote.oe.2-2"/><ptr type="liebermannNote" n="3" target="#Rubrics-Ine_64.lnote.oe.3"/> eo qui habet XX hidas.<ptr type="liebermannNote" n="4" target="#Rubrics-Ine_64.lnote.oe.4"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="214" ed="#jurasinski-and-oliver"/>C\V/III Be þon þe hæfð .XX. hida londes</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="214" ed="#jurasinski-and-oliver"/>Be ðam þe hafð XX hida</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="27" ed="#liebermann"/>Über den, welcher 20 Hiden Landes hat.<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_64.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning one who has 20 hides of land.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="215" ed="#jurasinski-and-oliver"/>Concerning one who has twenty hides of land</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="215" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_64.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">26</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">corr. aus</hi> CIII <hi rend="italic">E</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected from CIII E</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_64.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">26</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Statt Rb.</hi> 64—67: Be lond[land- <hi rend="italic">Ld</hi>]hæbbendum <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Instead of Rb. 64—67: Be lond[land- Ld]hæbbendum So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_64.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">27</biblScope></bibl><seg type="original" xml:lang="de">De habente XX h. et mutante mansionem <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">De habente XX h. et mutante mansionem Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_64.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">27</biblScope></bibl><seg type="original" xml:lang="de">Et de <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et de T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_64.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">27</biblScope></bibl><seg type="original" xml:lang="de">vel X vel III <hi rend="italic">fügt zu statt Rb.</hi> 65. 66 <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">vel X vel III added by Hk instead of Rb. 65. 66</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_64.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">27</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> þam</seg><seg type="translation" xml:lang="en" source="#claude">altered to þam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_64.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">27</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_64.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Für 64—67: ‘Von Landbesitzern’ Ld So</seg><seg type="translation" xml:lang="en" source="#claude">For 64—67: ‘Of landholders’ Ld So</seg></note>
      </div>
