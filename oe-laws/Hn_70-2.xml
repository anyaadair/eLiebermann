      <div type="clause" n="70.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 70.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 70.2" corresp="#wit-lat"><pb n="587" ed="#liebermann"/>Si seruus seruum occidat, domino reddantur XX sol.<ptr type="liebermannNote" n="u" target="#Hn_70-2.lnote.oe.u"/> pro manbota<ptr type="liebermannNote" n="v" target="#Hn_70-2.lnote.oe.v"/>, parentibus<ptr type="liebermannNote" n="w" target="#Hn_70-2.lnote.oe.w"/> interfecti serui XL den.<ptr type="liebermannNote" n="v" target="#Hn_70-2.lnote.oe.v"/></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 587 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-2.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ebenso</hi> Leis Wl 7</seg><seg type="translation" xml:lang="en" source="#claude">likewise Leis Wl 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-2.lnote.oe.v" n="v" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 70, 4. 76, 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. 70, 4. 76, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-2.lnote.oe.w" n="w" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">der Sklav ist nicht mehr, wie im älteren Recht, sippenlos</hi></seg><seg type="translation" xml:lang="en" source="#claude">the slave is no longer without kindred, as in the older law</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Mannbusse 6a. 15e.; unfrei 8ff. 20—70, 3 <hi rend="italic">conponat</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Mannbusse 6a. 15e.; unfrei 8ff. 20—70, 3 <hi rend="italic">conponat</hi> Rs</seg></note>
