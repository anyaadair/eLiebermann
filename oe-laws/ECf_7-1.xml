    <body>
      <div type="clause" n="7.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 7.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 7.1"><pb n="632" ed="#liebermann"/><ptr type="liebermannNote" n="1" target="#ECf_7-1.lnote.la.1"/>Si quis gregem equarum<ptr type="liebermannNote" n="a" target="#ECf_7-1.lnote.la.fn.a"/><ptr type="liebermannNote" n="2" target="#ECf_7-1.lnote.la.2"/> habuerit<ptr type="liebermannNote" n="3" target="#ECf_7-1.lnote.la.3"/>, pullum<ptr type="liebermannNote" n="4" target="#ECf_7-1.lnote.la.4"/> decimum reddat; qui<ptr type="liebermannNote" n="5" target="#ECf_7-1.lnote.la.5"/> unam solam<ptr type="liebermannNote" n="6" target="#ECf_7-1.lnote.la.6"/> uel duas<ptr type="liebermannNote" n="7" target="#ECf_7-1.lnote.la.7"/>, de singulis pullis singulos<ptr type="liebermannNote" n="8" target="#ECf_7-1.lnote.la.8"/> denarios.</ab>
        <note type="comparison" source="#liebermann" n="632"><label>printed alongside</label> <ref target="clause:ECfRetr_7-1">ECf retr 7.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 632 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “decimum” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_7-1.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Af. 9; Ps.-Cn. for. 27, 1<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. Af. 9; Ps.-Cn. for. 27, 1b</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-1.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">De pullis et uitulis <hi rend="italic">Überschrift Rl; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">De pullis et uitulis, heading in Rl; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-1.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">uel equicium <hi rend="italic">fügt zu Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hr adds uel equicium</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-1.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">-uit <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uit Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-1.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">d. p. <hi rend="italic">Hk Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. p. Hk Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-1.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">autem <hi rend="italic">fügt zu Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hr adds autem</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-1.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-1.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">habuerit <hi rend="italic">fügt zu Hr Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hr Ad Do add habuerit</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-1.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">singulum denarium <hi rend="italic">Ad Do No</hi></seg><seg type="translation" xml:lang="en" source="#claude">singulum denarium Ad Do No</seg></note>
      </div>
