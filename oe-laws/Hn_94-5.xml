      <div type="clause" n="94.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 94.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 94.5" corresp="#wit-lat"><pb n="611" ed="#liebermann"/>Si uulnus fiat alicui, et accusatus<ptr type="liebermannNote" n="31" target="#Hn_94-5.lnote.oe.31"/> neget, se sexto iuret<ptr type="liebermannNote" n="o" target="#Hn_94-5.lnote.oe.o"/>: sine preiuramento<ptr type="liebermannNote" n="p" target="#Hn_94-5.lnote.oe.p"/><ptr type="liebermannNote" n="32" target="#Hn_94-5.lnote.oe.32"/>, quia sanguis et uulnus ipsum<ptr type="liebermannNote" n="q" target="#Hn_94-5.lnote.oe.q"/> forað<ptr type="liebermannNote" n="33" target="#Hn_94-5.lnote.oe.33"/> preuenerunt<ptr type="liebermannNote" n="34" target="#Hn_94-5.lnote.oe.34"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 611 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-5.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verklagter</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">the defendant</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-5.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">des Klägers</hi></seg><seg type="translation" xml:lang="en" source="#claude">of the plaintiff</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-5.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">diesem Klageeid vorbeugten; <hi rend="italic">vgl.</hi> V As. 2</seg><seg type="translation" xml:lang="en" source="#claude">forestall this accusatory oath; cf. V As. 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-5.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">acu. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">acu. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-5.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">purgam. <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">purgam. Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-5.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">-ade <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ade Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-5.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">-rant <hi rend="italic">Hg;</hi> -rint <hi rend="italic">Lond. Es folgen zwei leere Zeilen, dann von derselben Hand</hi> [M]yrcheneland [<hi rend="italic">d. i.</hi> ‘Tribal hidage’; <hi rend="italic">vgl. Maitland</hi> Domesday 506] <hi rend="italic">Sc Hg; folgt</hi> (<hi rend="italic">nach leerer halber Spalte K</hi>) <hi rend="italic">in derselben Hand</hi> Cui [<hi rend="italic">nämlich</hi> Henrico I.] successit Stephanus <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rant Hg; -rint Lond. There follow two blank lines, then in the same hand [M]yrcheneland [i.e. the ‘Tribal hidage’; cf. Maitland Domesday 506] Sc Hg; there follows (after an empty half column K) in the same hand Cui [namely Henrico I.] successit Stephanus Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-5.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Klageeid 4—<hi rend="italic">forade</hi>{33} <hi rend="italic">p. Expliciunt leges gloriosi Henrici regis primi</hi> Rs, Worte wahrscheinlich des Londoners um 1200.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Klageeid 4—<hi rend="italic">forade</hi>{33} <hi rend="italic">p. Expliciunt leges gloriosi Henrici regis primi</hi> Rs, words probably of the Londoner c. 1200.</seg></note>
      </div>
