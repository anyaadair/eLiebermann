      <div type="clause" n="73.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 73.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 73.1" corresp="#wit-lat"><pb n="591" ed="#liebermann"/>Si<ptr type="liebermannNote" n="b" target="#Hn_73-1.lnote.oe.b"/> episcopus homicidium faciat, deponatur<ptr type="liebermannNote" n="c" target="#Hn_73-1.lnote.oe.c"/> et peniteat XII annis, VII<ptr type="liebermannNote" n="7" target="#Hn_73-1.lnote.oe.7"/> in pane et aqua, et V ieiunet III diebus in ebdomada, et aliis communi cibo utatur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 591 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_73-1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">591</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Urquellen</hi> (<hi rend="italic">meist Cummean</hi>) <hi rend="italic">citirt hierzu Wasserschleben</hi> Bussordnungen 333 <hi rend="italic">bezw.</hi> 306</seg><seg type="translation" xml:lang="en" source="#claude">Original sources (mostly Cummean) for this are cited by Wasserschleben Bussordnungen 333 and 306 respectively</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_73-1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">591</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">den Bischof oder Priester, der tödtet, setzt auch ab</hi> Modus impon. poen. 9 [<hi rend="italic">der Zeit</hi>] <hi rend="italic">Eadgars, ed. Thorpe</hi> Anc. laws 406</seg><seg type="translation" xml:lang="en" source="#claude">The bishop or priest who kills is also deposed by Modus impon. poen. 9 [of the time] of Eadgar, ed. Thorpe Anc. laws 406</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_73-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">591</biblScope></bibl><seg type="original" xml:lang="de">annis <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">annis added by Lond</seg></note>
      </div>
    </body>
