      <div type="clause" n="8">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 8</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-hk"><pb n="498–499" ed="#liebermann"/>La were del thein XX lib. en<ptr type="liebermannNote" n="3" target="#LeisWl_8.lnote.oe.3"/> Merchenelahe, XXV lib. en<ptr type="liebermannNote" n="3" target="#LeisWl_8.lnote.oe.3"/> Westsexenelahe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-i"><pb n="498–499" ed="#liebermann"/>La were del thein XX li. en Merchenelae, e XXV<ptr type="liebermannNote" n="17" target="#LeisWl_8.lnote.oe.17"/> li. en Westsexenelae<ptr type="liebermannNote" n="18" target="#LeisWl_8.lnote.oe.18"/>.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="498–499" ed="#liebermann"/>De were diuersorum. Est autem were theni in Merchenelahe<ptr type="liebermannNote" n="1" target="#LeisWl_8.lnote.oe.1"/> XX libr., in Westsaxenelahe XXV libr.,</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="8" corresp="#wit-hk"><pb n="256" ed="#robertson"/>La were del thein—XX lib. en Merchenelahe, XXV lib. en Westsexenelahe.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="498–499" ed="#liebermann"/>8. Das Wergeld des Thegn: im Mercier-Rechtsgebiet 20 £, (und <hi rend="italic">I</hi>) im Westsachsen-Rechtsgebiet 25 £.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">8. The wergild of the thegn: in the Mercian legal district 20 £, (and <hi rend="italic">I</hi>) in the West Saxon legal district 25 £.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-hk"><pb n="257" ed="#robertson"/>The wergeld of a thegn is £20 in the province of Mercia, £25 in the province of Wessex.</ab>
        <note type="comparison" source="#liebermann" n="499"><ref target="clause:Wer_1-1">Wer 1.1</ref>; <ref target="clause:Mirce_1-1">Mirce 1.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">vgl. Wer 1, 1 Mirce 1, 1</note>
        <note type="editorial">Added October 2026 from Robertson pp. 256–257 (text and translation); Liebermann’s text and German translation added from Gesetze I p. 498–499, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_8.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">498</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">BA.</hi></seg><seg type="translation" xml:lang="en" source="#claude">in BA.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_8.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">498</biblScope></bibl><seg type="original" xml:lang="de">XXV l. <hi rend="italic">fehlt Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">XXV l. missing in Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_8.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">498</biblScope></bibl><seg type="original" xml:lang="de">-sax. <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sax. Im</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_8.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">499</biblScope></bibl><seg type="original" xml:lang="de">Merchenal. <hi rend="italic">Thorpe gegen Hs.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Merchenal. Thorpe, against the MS</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_8.lnote.de._" n="-" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">287</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Wergeld 5. 9. b; Thegn 13a; gemeinfrei 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Wergeld 5. 9. b; Thegn 13a; gemeinfrei 4</seg><note type="remark" resp="#claude">Liebermann’s heading: Leis Wl 8. 8, 1</note></note>
      </div>
