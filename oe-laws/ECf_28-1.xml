      <div type="clause" n="28.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 28.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 28.1"><pb n="652" ed="#liebermann"/>Isti<ptr type="liebermannNote" n="1" target="#ECf_28-1.lnote.la.1"/> inter uillas<ptr type="liebermannNote" n="2" target="#ECf_28-1.lnote.la.2"/>, inter uicinos tractabant causas<ptr type="liebermannNote" n="a" target="#ECf_28-1.lnote.oe.erkl-a"/> et, secundum quod forisfacture<ptr type="liebermannNote" n="3" target="#ECf_28-1.lnote.la.3"/> erant, emendationes et concordationes<ptr type="liebermannNote" n="4" target="#ECf_28-1.lnote.la.4"/>, uidelicet<ptr type="liebermannNote" n="5" target="#ECf_28-1.lnote.la.5"/> de pascuis<ptr type="liebermannNote" n="6" target="#ECf_28-1.lnote.la.6"/>, de pratis, de messibus, de decertationibus<ptr type="liebermannNote" n="7" target="#ECf_28-1.lnote.la.7"/> inter uicinos et<ptr type="liebermannNote" n="8" target="#ECf_28-1.lnote.la.8"/> de multis huiusmodi, que frequenter insurgunt.</ab>
        <note type="comparison" source="#liebermann" n="652"><label>printed alongside</label> <ref target="clause:ECfRetr_28-1">ECf retr 28.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 652 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28-1.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">autem <hi rend="italic">fügt zu S Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">S Do add autem</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28-1.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad adds et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28-1.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">-factum erat <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-factum erat Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28-1.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">ordinationes <hi rend="italic">S Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">ordinationes S Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28-1.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">uid.—messibus <hi rend="italic">fehlt Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">uid.—messibus lacking in Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28-1.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">prat., de pas. <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">prat., de pas. Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28-1.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de">certat. <hi rend="italic">Hk Hr S;</hi> commutacionibus <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">certat. Hk Hr S; commutacionibus Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28-1.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">652</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">These dealt with cases between vills, between neighbours, and, according as the offences were, compensations and settlements, namely concerning pastures, meadows, harvests, quarrels between neighbours and many things of this kind which frequently arise.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28-1.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Gericht 11b H—M; Dorfgericht 3ff. — <hi rend="italic">casulas</hi><hi rend="superscript">2</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">See <hi rend="italic">Gl</hi> Gericht 11b H—M; Dorfgericht 3ff. — <hi rend="italic">casulas</hi><hi rend="superscript">2</hi> Rs</seg></note>
      </div>
    </body>
