      <div type="clause" n="49.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 49.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 49.2" corresp="#wit-lat"><pb n="572" ed="#liebermann"/>Pro statu uero causarum et esse temporum et modo inplacitatorum<ptr type="liebermannNote" n="20" target="#Hn_49-2.lnote.oe.20"/> uel inplacitancium unusquisque deliberet tam ex presentibus quam (ex<ptr type="liebermannNote" n="18" target="#Hn_49-2.lnote.oe.18"/>) preteritis, an<ptr type="liebermannNote" n="21" target="#Hn_49-2.lnote.oe.21"/> ei inpresentiarum sit, uel non sit placitandum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 572 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">-citor. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-citor. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">ante eum presentancium fit u. n. fit placitancium <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">ante eum presentancium fit u. n. fit placitancium Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de">Hier spricht Verf. als Ratgeber des Beklagten; <hi rend="italic">s. o</hi>. Einl. 7—<hi rend="italic">inplacitor</hi>.{20}—<hi rend="italic">ex</hi>{18}—<hi rend="italic">placitancium</hi>. 49, 2a <hi rend="italic">aliquando</hi>{23} <hi rend="italic">placitare, cum possit dilatari</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">Here the author speaks as adviser to the defendant; <hi rend="italic">see above</hi> Introduction 7—<hi rend="italic">inplacitor</hi>.{20}—<hi rend="italic">ex</hi>{18}—<hi rend="italic">placitancium</hi>. 49, 2a <hi rend="italic">aliquando</hi>{23} <hi rend="italic">placitare, cum possit dilatari</hi> Rs</seg></note>
