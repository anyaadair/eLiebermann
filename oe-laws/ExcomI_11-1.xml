      <div type="clause" n="11.1">
        <head><ref type="lawCode" target="law:ExcomI">Excom I</ref> 11.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom I 11.1" corresp="#wit-ti"><pb n="433" ed="#liebermann"/>idcirco nos eum<ptr type="liebermannNote" n="20" target="#ExcomI_11-1.lnote.oe.20"/> cum<ptr type="liebermannNote" n="c" target="#ExcomI_11-1.lnote.oe.c"/> uniuersis complicibus et<ptr type="liebermannNote" n="21" target="#ExcomI_11-1.lnote.oe.21"/> communicatoribus fautoribusque suis, iudicio<ptr type="liebermannNote" n="d" target="#ExcomI_11-1.lnote.oe.d"/> Dei omnipotentis, Patris et<ptr type="liebermannNote" n="22" target="#ExcomI_11-1.lnote.oe.22"/> Filii et Spiritus sancti, et beati Petri<ptr type="liebermannNote" n="e" target="#ExcomI_11-1.lnote.oe.e"/> principis<ptr type="liebermannNote" n="23" target="#ExcomI_11-1.lnote.oe.23"/> apostolorum et omnium<ptr type="liebermannNote" n="f" target="#ExcomI_11-1.lnote.oe.f"/> sanctorum necnon et nostræ<ptr type="liebermannNote" n="g" target="#ExcomI_11-1.lnote.oe.g"/> mediocritatis auctoritate et potestate<ptr type="liebermannNote" n="h" target="#ExcomI_11-1.lnote.oe.h"/> nobis diuinitus collata ligandi et soluendi in cælo et in terra,</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 433 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11-1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> IV 1. V 2. IX 2. XIII 2, 1. <hi rend="italic">Alet Conc. Silvanect. a.</hi> 990</seg><seg type="translation" xml:lang="en" source="#claude">cf. IV 1. V 2. IX 2. XIII 2, 1. Alet Conc. Silvanect. a. 990</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11-1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de">auctoritate <hi rend="italic">beginnen fast alle Formeln, ausser</hi> II 1</seg><seg type="translation" xml:lang="en" source="#claude">almost all the formulae begin with auctoritate, except II 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11-1.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> V 1. VI 1. VII 1. X 1. <hi rend="italic">Gem</hi> 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. V 1. VI 1. VII 1. X 1. Gem 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11-1.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> V 1. VI 1, 5. VII 2. VIII 1. 17. IX 1. X 1. XI 1. <hi rend="italic">Alet Gem</hi> 1. 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. V 1. VI 1, 5. VII 2. VIII 1. 17. IX 1. X 1. XI 1. Alet Gem 1. 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11-1.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> X 1. XIII 2. <hi rend="italic">Reg</hi> 416</seg><seg type="translation" xml:lang="en" source="#claude">cf. X 1. XIII 2. Reg 416</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11-1.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> II 1. <hi rend="italic">Urg Sen Rot Leo Rem</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. II 1. Urg Sen Rot Leo Rem</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de">eos <hi rend="italic">darüber Ti</hi></seg><seg type="translation" xml:lang="en" source="#claude">eos above it Ti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de">excommunicatoribusque, <hi rend="italic">ohne</hi> et <hi rend="italic">und</hi> fautoribus <hi rend="italic">Ti</hi></seg><seg type="translation" xml:lang="en" source="#claude">excommunicatoribusque, without et and fautoribus Ti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11-1.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Reg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Reg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_11-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">433</biblScope></bibl><seg type="original" xml:lang="de">a. p. <hi rend="italic">Mart</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. p. Mart</seg></note>
