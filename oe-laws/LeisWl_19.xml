    <body>
      <div type="clause" n="19">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 19</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-hk"><ptr type="liebermannNote" n="a" target="#LeisWl_19.lnote.oe.a"/><pb n="504–505" ed="#liebermann"/>. . . . . . . . . . . . . . . .</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-i"><ptr type="liebermannNote" n="26" target="#LeisWl_19.lnote.oe.26"/><pb n="504–505" ed="#liebermann"/>Si alquns<ptr type="liebermannNote" n="h" target="#LeisWl_19.lnote.oe.h"/> crieve<ptr type="liebermannNote" n="27" target="#LeisWl_19.lnote.oe.27"/> l’oil a l’altre per<ptr type="liebermannNote" n="i" target="#LeisWl_19.lnote.oe.i"/> aventure, quel que<ptr type="liebermannNote" n="28" target="#LeisWl_19.lnote.oe.28"/> seit, si amendrad LXX solz del<ptr type="liebermannNote" n="k" target="#LeisWl_19.lnote.oe.k"/> solz Engleis.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="504–505" ed="#liebermann"/>De oculo eruto. Si quis alicui oculum quocunque modo eruit, dabit illi LXX sol. Anglicos.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="19" corresp="#wit-i"><pb n="262" ed="#robertson"/>Si alquns crieve l'oil a l'altre per aventure, quel que seit, si amendrad LXX solz de solz Engleis.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="504–505" ed="#liebermann"/>19. Wenn jemand dem andern ein Auge [ganz] ausstösst durch Zufall, welcher es sei, so soll er (ihm<ptr type="liebermannNote" n="1" target="#LeisWl_19.lnote.de.1"/> <hi rend="italic">L</hi>) 70<ptr type="liebermannNote" n="2" target="#LeisWl_19.lnote.de.2"/> Schill. büssen an Englischen Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">19. If someone knocks out [entirely] an eye of another by accident, whatever it may be, then he shall pay (him <hi rend="italic">L</hi>) 70 shill. compensation in English shill.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-i"><pb n="263" ed="#robertson"/>If anyone knocks out a man's eye by any kind of accident, he shall pay 70 English shillings as compensation.</ab>
        <note type="comparison" source="#liebermann" n="505"><ref target="clause:Af_47">Af 47</ref>; <ref target="clause:LeisWl_11-1">Leis Wl 11.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 47 | (*s. o. 11, 1)</note>
        <note type="editorial">Added October 2026 from Robertson pp. 262–263 (text and translation); 18.2–19.1 are from I (not in Hk) (Robertson).; Liebermann’s text and German translation added from Gesetze I p. 504–505, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_19.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze aus IL</hi></seg><seg type="translation" xml:lang="en" source="#claude">supply from IL</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_19.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">alquens <hi rend="italic">bessert Toynbee</hi></seg><seg type="translation" xml:lang="en" source="#claude">alquens emended by Toynbee</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_19.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">par <hi rend="italic">TO.</hi></seg><seg type="translation" xml:lang="en" source="#claude">par <hi rend="italic">TO.</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_19.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> de</seg><seg type="translation" xml:lang="en" source="#claude">read de</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_19.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">XXI. <hi rend="italic">I</hi></seg><seg type="translation" xml:lang="en" source="#claude">XXI. <hi rend="italic">I</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_19.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">criene <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">criene <hi rend="italic">Io</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_19.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">qe <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">qe Im</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_19.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">289</biblScope></bibl><seg type="original" xml:lang="de">Empfänger ist Verletzter laut 19, 1</seg><seg type="translation" xml:lang="en" source="#claude">The recipient is the injured man, according to 19, 1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_19.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">289</biblScope></bibl><seg type="original" xml:lang="de">Diese 280 Pf., viell. Abrundung (<hi rend="italic">s. d. Gl</hi>; Auge 2) von 266⅔ = ⅓ des Merc. gemeinfreien Wergelds</seg><seg type="translation" xml:lang="en" source="#claude">These 280 pence are perhaps a rounding (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi>; Auge 2) of 266⅔ = ⅓ of the Mercian common freeman’s wergild</seg></note>
      </div>
