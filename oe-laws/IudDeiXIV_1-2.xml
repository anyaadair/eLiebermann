        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIV_1-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">425</biblScope></bibl><seg type="original" xml:lang="de">1, 2 <hi rend="italic">auch Zeu.</hi> 668. 681. 686</seg><seg type="translation" xml:lang="en" source="#claude">1, 2 also Zeu. 668. 681. 686</seg></note>
