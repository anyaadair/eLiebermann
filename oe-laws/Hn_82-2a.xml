      <div type="clause" n="82.2a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 82.2a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 82.2a" corresp="#wit-lat"><pb n="598" ed="#liebermann"/>Quodsi per omnia refragauerit<ptr type="liebermannNote" n="32" target="#Hn_82-2a.lnote.oe.32"/>, et id cause uel temporis uel locorum uel accidencium sit, ut<ptr type="liebermannNote" n="33" target="#Hn_82-2a.lnote.oe.33"/> de suo aliquid pro inborgo<ptr type="liebermannNote" n="r" target="#Hn_82-2a.lnote.oe.r"/> (id<ptr type="liebermannNote" n="34" target="#Hn_82-2a.lnote.oe.34"/> est sine plegio) retineatur, ratione<ptr type="liebermannNote" n="r" target="#Hn_82-2a.lnote.oe.r"/> hoc et legittimis testibus fiat, ne deterius inde<ptr type="liebermannNote" n="35" target="#Hn_82-2a.lnote.oe.35"/> aliquid (contingat<ptr type="liebermannNote" n="36" target="#Hn_82-2a.lnote.oe.36"/> uel) sequatur; que<ptr type="liebermannNote" n="37" target="#Hn_82-2a.lnote.oe.37"/> diligencius aduertenda sunt, sicut accusatus credibilis erit et accusacionibus uel detencionibus adquieuerit, et sicut eius esse<ptr type="liebermannNote" n="38" target="#Hn_82-2a.lnote.oe.38"/> uel non<ptr type="liebermannNote" n="s" target="#Hn_82-2a.lnote.oe.s"/> eius<ptr type="liebermannNote" n="10" target="#Hn_82-2a.lnote.oe.10"/> esse quod ita<ptr type="liebermannNote" n="39" target="#Hn_82-2a.lnote.oe.39"/> retinebitur innotuerit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 598 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2a.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 57, 7; <hi rend="italic">vgl.</hi> 43, 1<hi rend="italic">b</hi>; inborh <hi rend="italic">vielleicht aus II Ew.</hi> 3, 1</seg><seg type="translation" xml:lang="en" source="#claude">as 57, 7; cf. 43, 1<hi rend="italic">b</hi>; inborh perhaps from II Ew. 3, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2a.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">nicht Eigen des Frevlers, sondern nur seiner Freunde; <hi rend="italic">vgl.</hi> 83, 1<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">not the offender's own property, but only that of his friends; cf. 83, 1<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2a.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2a.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">-gatus fuerit <hi rend="italic">besser Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gatus fuerit, better, Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2a.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2a.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">i. s. p. <hi rend="italic">nicht in Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. s. p. not in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2a.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">a. i. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. i. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2a.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">c. u. <hi rend="italic">nicht in Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. u. not in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2a.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2a.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">esset <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">esset K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2a.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">non <hi rend="italic">fügt zu Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">Or adds non</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-2a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Pfändung 4a—<hi rend="italic">refragatus</hi>{32} <hi rend="italic">fuerit</hi>—<hi rend="italic">uel</hi>{33}—<hi rend="italic">id</hi>{34} <hi rend="italic">e. s. p</hi>. fehlt besser—<hi rend="italic">al. i</hi>.{35} <hi rend="italic">c. uel</hi>—<hi rend="italic">eius</hi>{19} fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Pfändung 4a—<hi rend="italic">refragatus</hi>{32} <hi rend="italic">fuerit</hi>—<hi rend="italic">uel</hi>{33}—<hi rend="italic">id</hi>{34} <hi rend="italic">e. s. p</hi>. missing, which is better—<hi rend="italic">al. i</hi>.{35} <hi rend="italic">c. uel</hi>—<hi rend="italic">eius</hi>{19} missing Rs</seg></note>
      </div>
