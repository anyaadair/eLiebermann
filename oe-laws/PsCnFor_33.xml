    <body>
      <div type="clause" n="33">
        <head><ref type="lawCode" target="law:PsCnFor">Ps Cn for</ref> 33</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Ps Cn for 33" corresp="#wit-ho-st-cii"><pb n="626" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#PsCnFor_33.lnote.oe.erkl-clause"/>Quodsi casu inauspicato huiusmodi canes rabidi eueniant<ptr type="liebermannNote" n="4" target="#PsCnFor_33.lnote.la.4"/> et ubique uagantes<ptr type="liebermannNote" n="5" target="#PsCnFor_33.lnote.la.5"/> currunt negligentia<ptr type="liebermannNote" n="6" target="#PsCnFor_33.lnote.la.6"/> dominorum, reddet<ptr type="liebermannNote" n="7" target="#PsCnFor_33.lnote.la.7"/> eos illicitos, et emendentur<ptr type="liebermannNote" n="8" target="#PsCnFor_33.lnote.la.8"/> regi pro illicitis<ptr type="liebermannNote" n="9" target="#PsCnFor_33.lnote.la.9"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 626 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-ho-st-cii">But if by an ill-omened chance such dogs become rabid and run wandering everywhere through the negligence of their owners, it shall make them unlawful [?], and let compensation be paid to the king for them as for unlawful [dogs].</ab>
        <note type="comparison" source="#liebermann" n="626"><ref target="clause:InCn_III-41">In Cn III 41</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_33.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">626</biblScope></bibl><seg type="original" xml:lang="de">fiant <hi rend="italic">Ho</hi></seg><seg type="translation" xml:lang="en" source="#claude">fiant Ho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_33.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">626</biblScope></bibl><seg type="original" xml:lang="de">uagantur <hi rend="italic">statt</hi> u. c. <hi rend="italic">Ho</hi></seg><seg type="translation" xml:lang="en" source="#claude">uagantur instead of u. c. Ho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_33.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">626</biblScope></bibl><seg type="original" xml:lang="de">necl. <hi rend="italic">Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">necl. Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_33.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">626</biblScope></bibl><seg type="original" xml:lang="de">-dit <hi rend="italic">St;</hi> redduntur illiciti <hi rend="italic">Ho</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dit St; redduntur illiciti Ho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_33.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">626</biblScope></bibl><seg type="original" xml:lang="de">-detur <hi rend="italic">Ho</hi></seg><seg type="translation" xml:lang="en" source="#claude">-detur Ho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_33.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">626</biblScope></bibl><seg type="original" xml:lang="de">etc. <hi rend="italic">fügt zu Ho</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ho adds etc.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_33.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">339</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Gegen Ausbreitung der Hundewut schreibt Papst Zacharias 751 Jaffé-Löw. <hi rend="italic">Reg. pont.</hi> 2291; <hi rend="italic">vgl.</hi> Cockayne <hi rend="italic">Leechdoms</hi> III 388</seg><seg type="translation" xml:lang="en" source="#claude">Pope Zacharias writes against the spread of rabies in dogs in 751, Jaffé-Löw. <hi rend="italic">Reg. pont.</hi> 2291; <hi rend="italic">cf.</hi> Cockayne <hi rend="italic">Leechdoms</hi> III 388</seg></note>
      </div>
