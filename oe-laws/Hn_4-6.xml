      <div type="clause" n="4.6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 4.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 4.6" corresp="#wit-lat"><pb n="548" ed="#liebermann"/>Purum uero sit et perspicua breuitate decorum perorantis elogium<ptr type="liebermannNote" n="11" target="#Hn_4-6.lnote.oe.11"/> inuencione, disposicione, elocucione, memoria, pronunciacione, persuasione<ptr type="liebermannNote" n="12" target="#Hn_4-6.lnote.oe.12"/>, naturali ingenio, doctrina sciencie<ptr type="liebermannNote" n="13" target="#Hn_4-6.lnote.oe.13"/> et assiduo usu peritum in<ptr type="liebermannNote" n="14" target="#Hn_4-6.lnote.oe.14"/> omni dicendi<ptr type="liebermannNote" n="15" target="#Hn_4-6.lnote.oe.15"/> genere.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 548 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_4-6.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">eloquium <hi rend="italic">Is.</hi></seg><seg type="translation" xml:lang="en" source="#claude">eloquium Is.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_4-6.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">pers. na., in. <hi rend="italic">interpungiren Frühere</hi></seg><seg type="translation" xml:lang="en" source="#claude">earlier editors punctuate pers. na., in.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_4-6.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">-tia <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tia Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_4-6.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">nominum <hi rend="italic">statt</hi> in o. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">nominum instead of in o. Co Or</seg></note>
