    <body>
      <div type="clause" n="7.1">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 7.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.1" corresp="#wit-e"><pb n="92" ed="#liebermann"/>Gif he ðonne stalie<ptr type="liebermannNote" n="15" target="#Ine_7-1.lnote.oe.15"/> on gewitnesse<ptr type="liebermannNote" n="17" target="#Ine_7-1.lnote.oe.17-2"/> ealles his hiredes<ptr type="liebermannNote" n="18" target="#Ine_7-1.lnote.oe.18-2"/>, gongen hie ealle on ðeowot.<ptr type="liebermannNote" n="19" target="#Ine_7-1.lnote.oe.19-2"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.1" corresp="#wit-bu"><pb n="92" ed="#liebermann"/>Gif he . . . witnysse eallæs his hiredes, . . . ealle on ðeowot.<ptr type="liebermannNote" n="1" target="#Ine_7-1.lnote.oe.1"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.1" corresp="#wit-h"><pb n="92" ed="#liebermann"/>Gif he þonne stalige on gewitnesse ealles his hyredes<ptr type="liebermannNote" n="10" target="#Ine_7-1.lnote.oe.10"/>, gán<ptr type="liebermannNote" n="11" target="#Ine_7-1.lnote.oe.11"/> hy<ptr type="liebermannNote" n="3" target="#Ine_7-1.lnote.oe.3"/> ealle on ðeowet.<ptr type="liebermannNote" n="12" target="#Ine_7-1.lnote.oe.12"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.1" corresp="#wit-b-no-prol"><pb n="93" ed="#liebermann"/>Gyf he ðonne stalie on gewitnysse ealles his hiredes, gangen heo ealle on ðeowet.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7.1" corresp="#wit-q"><pb n="93" ed="#liebermann"/>Si<ptr type="liebermannNote" n="17" target="#Ine_7-1.lnote.oe.17"/> in testimonio (et<ptr type="liebermannNote" n="18" target="#Ine_7-1.lnote.oe.18"/> conscientia) totius familię suę furetur<ptr type="liebermannNote" n="19" target="#Ine_7-1.lnote.oe.19"/>, transeant omnes in seruitutem.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="38" ed="#attenborough"/>Gif he ðonne stalie on gewitnesse ealles his hiredes, gongen<ptr type="editorNote" n="13" target="#Ine_7-1.attnote.fn.13"/> hie<ptr type="editorNote" n="14" target="#Ine_7-1.attnote.fn.14"/> ealle on ðeowot.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="7.1" corresp="#wit-e"><pb n="376" ed="#jurasinski-and-oliver"/>Gif he ðonne stalie on gewitnesse ealles his hiredes, gongen hie ealle on ðeowot.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="93" ed="#liebermann"/>Wenn er jedoch stiehlt unter Mitwissenschaft seines ganzen Haushalts, sollen sie alle in Sklaverei<ptr type="liebermannNote" n="1" target="#Ine_7-1.lnote.de.1"/> verfallen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">But if he steals with the knowledge of his whole household, let them all go into slavery.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="39" ed="#attenborough"/>If, however, he steals with the cognisance of all his household, they shall all go into slavery.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="400" ed="#whitelock"/>If, however, he steals with the knowledge of all his household, they are all to go into slavery.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="377" ed="#jurasinski-and-oliver"/>If, however, he steals with the knowledge of all his household, let them all go into servitude.</ab>
        <note type="comparison" source="#wormald-ppmel" n="127"><label>difficult to reconcile with</label> <ref target="clause:Ine_7">Ine 7</ref> <quote>Ine 7:1 ... decreeing slavery for a whole household ... is difficult to reconcile with the 60 shilling fine for thieves acting alone in Ine 7 (cf. ... Ine 53</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">93</biblScope></bibl><seg type="original" xml:lang="de">i <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">i R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">93</biblScope></bibl><seg type="original" xml:lang="de">et c. <hi rend="italic">fehlt K; übergeschr. Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">et c. lacking in K; written above in Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">93</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht</hi> ðeowat <hi rend="italic">oder</hi> -wut</seg><seg type="translation" xml:lang="en" source="#claude">perhaps ðeowat or -wut</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">und erstes</hi> e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y and first e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dahinter 3 Buchst. radirt</hi></seg><seg type="translation" xml:lang="en" source="#claude">3 letters erased after it</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zweites</hi> e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">second e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">stalige <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">stalige Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-1.lnote.oe.17-2" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">-nysse <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nysse Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-1.lnote.oe.18-2" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">hyr., gan. hi <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hyr., gan. hi Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_7-1.lnote.oe.19-2" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">92</biblScope></bibl><seg type="original" xml:lang="de">-wet <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-wet Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_7-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Q betont mildernd, dass die Mitwissenschaft (<hi rend="italic">s. d. Gl</hi> 3. a) [auf seiten der Kinder] eine der Verantwortung bewusste sein müsse. <hi rend="italic">Vgl.</hi> Verknechtung 12. Die Tat wird als handhafte (<hi rend="italic">s. d. Gl</hi> 5. 7) bestraft, wohl weil sie laut Teilnahme so vieler offenkundig war</seg><seg type="translation" xml:lang="en" source="#claude">Q, mitigating, stresses that the complicity (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 3. a) [on the part of the children] must be conscious of its responsibility. <hi rend="italic">Cf.</hi> Verknechtung 12. The offence is punished as one caught in the act (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 5. 7), probably because, given the participation of so many, it was manifest</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_7-1.attnote.fn.13" n="13" source="#attenborough"><bibl><biblScope unit="page">38</biblScope></bibl><label>gongen</label><seg type="original" xml:lang="en"><hi rend="italic">gan…</hi>. H. <hi rend="italic">gangen</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_7-1.attnote.fn.14" n="14" source="#attenborough"><bibl><biblScope unit="page">38</biblScope></bibl><label>hie</label><seg type="original" xml:lang="en"><hi rend="italic">hy</hi>. H. <hi rend="italic">heo</hi>. B.</seg></note>
      </div>
