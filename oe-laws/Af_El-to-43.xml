      <div type="clause" n="El. 43">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 43</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 43" corresp="#wit-e"><pb n="40" ed="#liebermann"/>Dem<ptr type="liebermannNote" n="29" target="#Af_El-to-43.lnote.oe.29"/> ðu swiðe<ptr type="liebermannNote" n="30" target="#Af_El-to-43.lnote.oe.30"/> emne. Ne dem<ptr type="liebermannNote" n="31" target="#Af_El-to-43.lnote.oe.31"/> ðu oðerne dóm þam<ptr type="liebermannNote" n="32" target="#Af_El-to-43.lnote.oe.32"/> welegan<ptr type="liebermannNote" n="33" target="#Af_El-to-43.lnote.oe.33"/>, oðerne ðam earman; ne oðerne þam liofran<ptr type="liebermannNote" n="34" target="#Af_El-to-43.lnote.oe.34"/> ⁊<ptr type="liebermannNote" n="35" target="#Af_El-to-43.lnote.oe.35"/> oðerne þam laðran ne dem<ptr type="liebermannNote" n="29" target="#Af_El-to-43.lnote.oe.29"/> ðu.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 43" corresp="#wit-g-prol-only"><pb n="40" ed="#liebermann"/>Dem ðú swiðe rihte ⁊ swiðe emne. Ne de<hi rend="italic">m</hi> ðu oðerne dóm þam welegan, oðerne ðæm earman; ne oðerne ðam leofran ⁊ oðerne ðam laðran ne dem ðú.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 43" corresp="#wit-h"><pb n="41" ed="#liebermann"/>Dem ðu swiþe ryhtne dom<ptr type="liebermannNote" n="13" target="#Af_El-to-43.lnote.oe.13"/>; ⁊ ne dem þu oðerne dom ðam welegan, oþerne ðam earman<ptr type="liebermannNote" n="14" target="#Af_El-to-43.lnote.oe.14"/>; ne oðerne ðam leofan<ptr type="liebermannNote" n="4" target="#Af_El-to-43.lnote.oe.4"/> ond<ptr type="liebermannNote" n="2" target="#Af_El-to-43.lnote.oe.2"/> oþerne ðam laðan ne dæm ðu.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 43" corresp="#wit-q"><pb n="41" ed="#liebermann"/>Non<ptr type="liebermannNote" n="10" target="#Af_El-to-43.lnote.oe.10"/> declinabis in iudicio<ptr type="liebermannNote" n="11" target="#Af_El-to-43.lnote.oe.11"/> pauperis.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 43" corresp="#wit-e"><pb n="258" ed="#jurasinski-and-oliver"/>Dem ðu swiðe emne. Ne dem ðu oðerne dom þam welegan, oðerne ðam earman; ne oðerne þam liofran ⁊ oðerne þam laðran ne dem ðu.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="41" ed="#liebermann"/>Richte<ptr type="liebermannNote" n="1" target="#Af_El-to-43.lnote.de.1"/> du höchst (gerecht<ptr type="liebermannNote" n="2" target="#Af_El-to-43.lnote.de.2"/> und höchst) gleichmässig: nicht sprich du anderes Urtheil dem Reichen<ptr type="liebermannNote" n="3" target="#Af_El-to-43.lnote.de.3"/>, anderes dem Armen; noch ertheile du anderes dem [dir] lieberen und anderes dem [dir] leidigeren.<ptr type="liebermannNote" n="4" target="#Af_El-to-43.lnote.de.4"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Judge most (justly and most) evenly: do not pronounce one judgment for the rich man and another for the poor; nor give one to the one dearer [to you] and another to the one more hateful [to you].</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="409" ed="#whitelock"/>Judge thou very fairly. Do not judge one judgment for the rich and another for the poor; nor one for the one more dear and another for the one more hateful.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="259" ed="#jurasinski-and-oliver"/>Judge very evenly. Do not give one judgment to the rich man and another to the poor; nor one for a friend and another for an enemy.</ab>
        <note type="passageSource">Exodus 23,6</note>
        <note type="comparison" source="#liebermann" n="41">Exodus 23.6</note>
        <note type="comparisonPrinted" source="#liebermann">[23, 6]</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Iudex_3">Iudex 3</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="290"><label>short step from</label> <ref target="clause:IIEw_2">II Ew 2</ref> <quote>Ine had already exacted thirty shillings ... for default of justice ... it is a short step thence to what Edward demanded of his reeves</quote></note>
        <note type="translator" source="#whitelock">Elaborated from Exodus xxiii. 6.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-43.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">Deme <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Deme So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-43.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">rihte ⁊ swiþe <hi rend="italic">fügt zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">rihte ⁊ swiþe added by Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-43.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">deme <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">deme Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-43.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-43.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">weol. <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">weol. So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-43.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">leo. <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">leo. So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-43.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt So</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-43.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de">d <hi rend="italic">auf Rasur;</hi> ⁊ <hi rend="italic">übergeschr.; Trennstrich zwischen</hi> dom <hi rend="italic">und</hi> ne <hi rend="italic">nachträglich, also vielleicht ursprünglich</hi> ry. ⁊ emne</seg><seg type="translation" xml:lang="en" source="#claude">d on an erasure; ⁊ written above; the dividing stroke between dom and ne added later, so perhaps originally ry. ⁊ emne</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-43.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rasur vor</hi> an</seg><seg type="translation" xml:lang="en" source="#claude">erasure before an</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-43.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-43.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geändert in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-43.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de">Non — paup. <hi rend="italic">fehlt T Hk</hi> (<hi rend="italic">vgl. Anm.</hi> 7)</seg><seg type="translation" xml:lang="en" source="#claude">Non — paup. lacking in T Hk (cf. note 7)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-43.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">41</biblScope></bibl><seg type="original" xml:lang="de">-cium <hi rend="italic">Vulg.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cium Vulg.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-43.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">47</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. o.</hi> El 41¹. Die Marginalie bessere in: 23, 3 + 6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. above</hi> El 41¹. Correct the marginal note to: 23, 3 + 6</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-43.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">47</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Aus G Ld; ‘erteile gerechtes Urteil’ H, beides nicht authentisch</seg><seg type="translation" xml:lang="en" source="#claude">From G Ld; ‘give just judgement’ H; neither is authentic</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-43.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">47</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. o.</hi> 41¹³</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. above</hi> 41¹³</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-43.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">47</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘der dir verhasster ist’ Schmid; ‘lieben-leidigen’ H. <hi rend="italic">Leof ge lað:</hi> eine häufige Alliteration [nachzutragen II 12] in Agsä. Poesie: Crist 847; Seefahrer 112; Beowulf 511. 1061. 2910</seg><seg type="translation" xml:lang="en" source="#claude">‘who is more hateful to you’ Schmid; ‘dear–loathsome’ H. <hi rend="italic">Leof ge lað:</hi> a frequent alliteration [to be added at II 12] in Anglo-Saxon poetry: Crist 847; Seefahrer 112; Beowulf 511. 1061. 2910</seg></note>
      </div>
