    <body>
      <div type="clause" n="8.4">
        <head><ref type="lawCode" target="law:IIAtr">II Atr</ref> 8.4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8.4" corresp="#wit-b"><pb n="226" ed="#liebermann"/>⁊ cume<ptr type="liebermannNote" n="*" target="#IIAtr_8-4.lnote.oe.star"/> hit mon æure<ptr type="liebermannNote" n="1" target="#IIAtr_8-4.lnote.oe.1-2"/>, ðær hit ærost befangen beo.<ptr type="liebermannNote" n="2" target="#IIAtr_8-4.lnote.oe.2-2"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="8.4" corresp="#wit-q"><pb n="226" ed="#liebermann"/>Et ueniat, ubi primitus<ptr type="liebermannNote" n="1" target="#IIAtr_8-4.lnote.oe.1"/> fuit interciatum.<ptr type="liebermannNote" n="2" target="#IIAtr_8-4.lnote.oe.2"/></ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="8.4" corresp="#wit-b"><pb n="60" ed="#robertson"/>⁊ tyme<ptr type="editorNote" n="7" target="#IIAtr_8-4.robnote.fn.7"/> hit mon æure ðær hit ærost befangen beo<ptr type="editorNote" n="8" target="#IIAtr_8-4.robnote.fn.8"/>.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="227" ed="#liebermann"/>Und man ziehe<ptr type="liebermannNote" n="1" target="#IIAtr_8-4.lnote.de.1"/> es allemal<ptr type="liebermannNote" n="2" target="#IIAtr_8-4.lnote.de.2"/> dort zur Gewähr, wo es zuerst [vom Anefänger] gefasst worden ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let it always be vouched to warranty at the place where it was first attached [by the claimant].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="61" ed="#robertson"/>And vouching to warranty shall always<ptr type="editorNote" n="1" target="#IIAtr_8-4.robnote.n.1"/> take place where the property has first been attached.</ab>
        <note type="comparedBy" source="#wormald-mel" n="370"><label>shared word</label> <ref target="clause:Forf_1">Forf 1</ref> <quote>and 'æfre' (Forf. 1, II Atr 8:4, 9)</quote></note>
        <note type="editorial">B's ‘cume’ should be corrected to ‘tyme’ (B often writes c for t and u for y; Liebermann thinks the archetype already had this error).</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_8-4.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">226</biblScope></bibl><seg type="original" xml:lang="de">prius <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">prius MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_8-4.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">226</biblScope></bibl><seg type="original" xml:lang="de">-tus <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tus MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_8-4.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">226</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> tyme [c <hi rend="italic">statt</hi> t <hi rend="italic">und</hi> u <hi rend="italic">statt</hi> y <hi rend="italic">verschreibt B oft und verschrieb hier, laut Quadr., schon der Archetyp. Nur weil Quadripartitus und Neuere</hi> hit <hi rend="italic">ausliessen, ergab</hi> cume <hi rend="italic">Sinn</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">read tyme [B often miswrites c for t and u for y, and here, as Quadr. shows, the archetype had already miswritten it. Only because Quadripartitus and modern editors omitted hit did cume make sense]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_8-4.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">226</biblScope></bibl><seg type="original" xml:lang="de">æfre <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">æfre Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAtr_8-4.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">226</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">wære</hi> <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">wære</hi> Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAtr_8-4.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">155</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘Man komme’ Price-Thorpe, Schmid; durch <hi rend="italic">hit</hi> wird dies unmöglich</seg><seg type="translation" xml:lang="en" source="#claude">‘Let one come’ Price-Thorpe, Schmid; <hi rend="italic">hit</hi> makes this impossible</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAtr_8-4.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">155</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Im Ggs. zu dem in 9 abgeschafften Herumreisen des Klägers mit den zur Gewähr Ziehenden in die Wohnorte der Bezogenen; <hi rend="italic">s. Gl</hi> Anefang 20c. Das ‘allemal’ ist die Neuerung; das Wort <hi rend="italic">æfre</hi> wird in 9 in demselben Zusammenhang wiederholt</seg><seg type="translation" xml:lang="en" source="#claude">In contrast to the claimant’s travelling round, abolished in 9, with those vouching to warranty to the homes of the persons vouched; see <hi rend="italic">Gl</hi> Anefang 20c. The ‘in every case’ is the innovation; the word <hi rend="italic">æfre</hi> is repeated in 9 in the same context</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIAtr_8-4.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">317</biblScope></bibl><seg type="original" xml:lang="en">Cf. cap. 9 where the new regulation is more fully explained.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAtr_8-4.robnote.fn.7" n="7" source="#robertson"><bibl><biblScope unit="page">60</biblScope></bibl><label>tyme</label><seg type="original" xml:lang="en"><hi rend="italic">cume</hi> B, Ld; <hi rend="italic">tyme</hi> Lieb.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAtr_8-4.robnote.fn.8" n="8" source="#robertson"><bibl><biblScope unit="page">60</biblScope></bibl><label>beo</label><seg type="original" xml:lang="en"><hi rend="italic">wære</hi> Ld.</seg></note>
      </div>
    </body>
