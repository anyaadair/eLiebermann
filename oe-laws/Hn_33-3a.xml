        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 33.3a" corresp="#wit-lat"><pb n="565" ed="#liebermann"/>Erga parem uel<ptr type="liebermannNote" n="7" target="#Hn_33-3a.lnote.oe.7"/> uicinum suum uel alterius hominem agens uiderit, ne pro recti penuria<ptr type="liebermannNote" n="8" target="#Hn_33-3a.lnote.oe.8"/> sine iudicio dimittat eum tercio<ptr type="liebermannNote" n="d" target="#Hn_33-3a.lnote.oe.d"/>, quia curiam suam inde<ptr type="liebermannNote" n="9" target="#Hn_33-3a.lnote.oe.9"/> perderet et placitum et<ptr type="liebermannNote" n="10" target="#Hn_33-3a.lnote.oe.10"/> emendaret.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 565 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-3a.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 33, 1<hi rend="italic">a</hi>. 59, 19</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 33, 1<hi rend="italic">a</hi>. 59, 19</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-3a.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-3a.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">pennu. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">pennu. <hi rend="italic">Co</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-3a.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Co Or</seg></note>
