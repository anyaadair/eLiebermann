    <body>
      <div type="clause" n="35.5">
        <head><ref type="lawCode" target="law:Af">Af</ref> 35.5</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35.5" corresp="#wit-e"><pb n="68" ed="#liebermann"/>Gif he ðone beard<ptr type="liebermannNote" n="37" target="#Af_35-5.lnote.oe.37"/> ófascire<ptr type="liebermannNote" n="38" target="#Af_35-5.lnote.oe.38"/>, mid XX scill. gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35.5" corresp="#wit-h"><pb n="68" ed="#liebermann"/>Gif he ðone beard ofascyre, mid XX scll' gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="35.5" corresp="#wit-b-no-prol"><pb n="69" ed="#liebermann"/>[Gif<ptr type="liebermannNote" n="3" target="#Af_35-5.lnote.oe.3"/> he þone beard ofascere, mid XX scill' gebete.]</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="35.5" corresp="#wit-q"><pb n="69" ed="#liebermann"/>Si barbam<ptr type="liebermannNote" n="19" target="#Af_35-5.lnote.oe.19"/> ei<ptr type="liebermannNote" n="20" target="#Af_35-5.lnote.oe.20"/> radat: decem sol.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="78" ed="#attenborough"/>Gif he ðone beard ófascire, mid XX scill. gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="36.5" corresp="#wit-e"><pb n="330" ed="#jurasinski-and-oliver"/>Gif he ðone beard ófascire, mid XX scill gebete.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="69" ed="#liebermann"/>Wenn er [ihm] den Bart [ganz<ptr type="liebermannNote" n="1" target="#Af_35-5.lnote.de.1"/>] abschert, büsse er mit 20<ptr type="liebermannNote" n="2" target="#Af_35-5.lnote.de.2"/> Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he shaves off [his] beard [completely], let him pay 20 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="79" ed="#attenborough"/>If he cuts off his beard, he shall pay 20<ptr type="editorNote" n="1" target="#Af_35-5.attnote.n.1"/> shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="414" ed="#whitelock"/>If he cuts off his beard, he is to pay him 20 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="331" ed="#jurasinski-and-oliver"/>If he shears off his beard, let him pay with 20 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-5.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">-de <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-de So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-5.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">68</biblScope></bibl><seg type="original" xml:lang="de">-scyre <hi rend="italic">Ld So</hi></seg><seg type="translation" xml:lang="en" source="#claude">-scyre Ld So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-5.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de">ei b. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei b. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-5.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_35-5.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">69</biblScope></bibl><seg type="original" xml:lang="de">35, 5 <hi rend="italic">übersprungen, am Rande im</hi> 16. <hi rend="italic">Jh. geschrieben</hi></seg><seg type="translation" xml:lang="en" source="#claude">35, 5 omitted, written in the margin in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_35-5.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Im Ggs. zu 35, 3</seg><seg type="translation" xml:lang="en" source="#claude">In contrast to 35, 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_35-5.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">58</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Q irrt, wohl absichtlos</seg><seg type="translation" xml:lang="en" source="#claude">Q errs, probably unintentionally</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_35-5.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">197</biblScope></bibl><seg type="original" xml:lang="en">Quadr. <hi rend="italic">decem sol</hi>, which is probably merely a scribal error.</seg></note>
      </div>
