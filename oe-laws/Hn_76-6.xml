      <div type="clause" n="76.6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 76.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 76.6" corresp="#wit-lat"><pb n="593" ed="#liebermann"/>Eodem modo per omnia de cyrlisci<ptr type="liebermannNote" n="45" target="#Hn_76-6.lnote.oe.45"/> uel uillani<ptr type="liebermannNote" n="o" target="#Hn_76-6.lnote.oe.o"/> wera fieri [debet<ptr type="liebermannNote" n="46" target="#Hn_76-6.lnote.oe.46"/>] secundum modum suum, sicut de duodecies centeno diximus:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 593 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-6.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Villan ist hier noch Kleinfreier, laut</hi> 76, 3<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Villan here is still a lesser freeman, according to</hi> 76, 3<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-6.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Hg;</hi> cyl. <hi rend="italic">Sc;</hi> sirl. <hi rend="italic">Gi;</hi> scyrl. <hi rend="italic">K;</hi> scirl. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">thus Hg;</hi> cyl. <hi rend="italic">Sc;</hi> sirl. <hi rend="italic">Gi;</hi> scyrl. <hi rend="italic">K;</hi> scirl. <hi rend="italic">Co Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-6.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänzt Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">supplied by Wi</hi></seg></note>
