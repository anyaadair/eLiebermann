    <body>
      <div type="clause" n="2.1">
        <head><ref type="lawCode" target="law:IIEg">II Eg</ref> 2.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2.1" corresp="#wit-g-a"><pb n="196" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="8" target="#IIEg_2-1.lnote.oe.8"/> hwa cyrican habbe<ptr type="liebermannNote" n="9" target="#IIEg_2-1.lnote.oe.9"/>, þe legerstow on ne sie<ptr type="liebermannNote" n="13" target="#IIEg_2-1.lnote.oe.13"/>, ðon<hi rend="italic">ne</hi> do he of þa<hi rend="italic">m<ptr type="liebermannNote" n="2" target="#IIEg_2-1.lnote.oe.2"/></hi> nigan<ptr type="liebermannNote" n="14" target="#IIEg_2-1.lnote.oe.14"/> dælu<hi rend="italic">m</hi> his preoste<ptr type="liebermannNote" n="15" target="#IIEg_2-1.lnote.oe.15"/> þ<hi rend="italic">æt</hi> þ<hi rend="italic">æt</hi> he wille.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2.1" corresp="#wit-a"><pb n="196" ed="#liebermann"/>Gif hwa cyricean hæbbe, þe legerstow on ne sy, do he of þam nigon dælum his preoste þ<hi rend="italic">æt</hi> þ<hi rend="italic">æt</hi> he wille.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2.1" corresp="#wit-d"><pb n="196" ed="#liebermann"/>Gif hwa circan hæbbe, þe legerstow on<ptr type="liebermannNote" n="2" target="#IIEg_2-1.lnote.oe.2-2"/> sy, do he of þa<hi rend="italic">m</hi> nigoðan<ptr type="liebermannNote" n="2" target="#IIEg_2-1.lnote.oe.2-2"/> dæle his preoste þ<hi rend="italic">æt</hi> þ<hi rend="italic">æt</hi> he wille.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2.1" corresp="#wit-q"><pb n="197" ed="#liebermann"/>Si non sit ibi atrium, det ex suis IX partibus presbytero quod uult.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="2.1" corresp="#wit-d"><pb n="20" ed="#robertson"/>Gif hwa circan hæbbe þe legerstow on [ne]<ptr type="editorNote" n="2" target="#IIEg_2-1.robnote.fn.2"/> sy, do<ptr type="editorNote" n="9" target="#IIEg_2-1.robnote.fn.9"/> he of þam nigoðan dæle<ptr type="editorNote" n="10" target="#IIEg_2-1.robnote.fn.10"/> his preoste þæt þæt he wille.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="350" ed="#rabin-doml"/>Gyf hwa cyrican habbe þe legerstow on ne sie, ðonne do he of þam nigan dælum his preoste þæt þæt he wille.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="197" ed="#liebermann"/>Wenn jemand eine [Landguts-]Kirche<ptr type="liebermannNote" n="1" target="#IIEg_2-1.lnote.de.1"/> hat, an der kein Friedhof<ptr type="liebermannNote" n="2" target="#IIEg_2-1.lnote.de.2"/> ist, dann entrichte er [der alten Pfarre den Zehnten voll und] aus den neun [übrigen<ptr type="liebermannNote" n="3" target="#IIEg_2-1.lnote.de.3"/>] Zehnteln seinem<ptr type="liebermannNote" n="4" target="#IIEg_2-1.lnote.de.4"/> Priester, was er will.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If anyone has an [estate-]church at which there is no graveyard, then let him pay [the tithe in full to the old minster and] give his priest what he will from the [remaining] nine tenths.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d"><pb n="21" ed="#robertson"/>If anyone has a church to which there is no graveyard attached, he shall pay what he will to his priest out of the next tenth part<ptr type="editorNote" n="1" target="#missing"/>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="434" ed="#whitelock"/>If anyone has a church with which there is no graveyard, he is then to pay to his priest from the [remaining] nine parts<ptr type="editorNote" n="3" target="#IIEg_2-1.whinote.n.3"/> what he chooses.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="351" ed="#rabin-doml"/>If anyone has a church without a graveyard, then let him give what he chooses to his priest out of the remaining nine shares after that paid as tithe.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:ICn_11-1">I Cn 11.1</ref></note>
        <note type="editorial">D omits ‘ne’ (an error, as I Cn 11 f. shows).</note>
        <note type="textual" source="#rabin-doml">ne: omitted D</note>
        <note type="textual" source="#rabin-doml">nigan dælum: nigoðan dæle D</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_2-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">196</biblScope></bibl><seg type="original" xml:lang="de">Gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_2-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">196</biblScope></bibl><seg type="original" xml:lang="de">hæbbe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hæbbe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_2-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">196</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_2-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">196</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_2-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">196</biblScope></bibl><seg type="original" xml:lang="de">nygan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">nygan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_2-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">196</biblScope></bibl><seg type="original" xml:lang="de">-st <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-st Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_2-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">196</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Fehler, auch laut I Cnut</hi> 11 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">an error, also according to I Cnut 11 f.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEg_2-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">135</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. 3c; Eigenkirche 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. 3c; Eigenkirche 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEg_2-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">135</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">atrium</hi> ist nicht etwa in <hi rend="italic">coemeterium</hi> zu ändern; <hi rend="italic">s. Wb</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">atrium</hi> should not be altered to <hi rend="italic">coemeterium</hi>; <hi rend="italic">see Wb</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEg_2-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">135</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">⁹⁄₁₀ im Ggs. zum Zehnten auch I As 3</seg><seg type="translation" xml:lang="en" source="#claude">⁹⁄₁₀ in contrast to the tithe also in I As 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEg_2-1.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">135</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Dem Gutskaplan</seg><seg type="translation" xml:lang="en" source="#claude">To the estate chaplain</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIEg_2-1.robnote.fn.2" n="2" source="#robertson"><bibl><biblScope unit="page">20</biblScope></bibl><label>leodscype</label><seg type="original" xml:lang="en">G, A, Ld; om. D.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIEg_2-1.robnote.fn.9" n="9" source="#robertson"><bibl><biblScope unit="page">20</biblScope></bibl><label>do</label><seg type="original" xml:lang="en"><hi rend="italic">ðonne do</hi> G, Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIEg_2-1.robnote.fn.10" n="10" source="#robertson"><bibl><biblScope unit="page">20</biblScope></bibl><label>dæle</label><seg type="original" xml:lang="en"><hi rend="italic">þ. nigan</hi> (<hi rend="italic">nigon, nygan</hi>) <hi rend="italic">dælum</hi> G, A, Ld.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IIEg_2-1.whinote.n.3" n="3" source="#whitelock"><bibl><biblScope unit="page">434</biblScope></bibl><label>parts</label><seg type="original" xml:lang="en">The Corpus text has “from the ninth part”.</seg></note>
      </div>
    </body>
