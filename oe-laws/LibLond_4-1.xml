      <div type="clause" n="4.1">
        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 4.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 4.1" corresp="#wit-lat"><pb n="674" ed="#liebermann"/>nec <ptr type="liebermannNote" n="b" target="#LibLond_4-1.lnote.oe.b"/>habet<ptr type="liebermannNote" n="4" target="#LibLond_4-1.lnote.oe.4"/> aliquem in<ptr type="liebermannNote" n="c" target="#LibLond_4-1.lnote.oe.c"/> socna<ptr type="liebermannNote" n="5" target="#LibLond_4-1.lnote.oe.5"/> manentem ad regis<ptr type="liebermannNote" n="6" target="#LibLond_4-1.lnote.oe.6"/> placita inuitare uel iusticiam de eo<ptr type="liebermannNote" n="7" target="#LibLond_4-1.lnote.oe.7"/> facere, donec custos<ptr type="liebermannNote" n="d" target="#LibLond_4-1.lnote.oe.d"/> illius socne<ptr type="liebermannNote" n="8" target="#LibLond_4-1.lnote.oe.8"/>, in qua manserit, de recto tenendo uicecomiti<ptr type="liebermannNote" n="9" target="#LibLond_4-1.lnote.oe.9"/> defecerit: nisi eum<ptr type="liebermannNote" n="10" target="#LibLond_4-1.lnote.oe.10"/> in<ptr type="liebermannNote" n="e" target="#LibLond_4-1.lnote.oe.e"/> regis<ptr type="liebermannNote" n="11" target="#LibLond_4-1.lnote.oe.11"/> socna<ptr type="liebermannNote" n="12" target="#LibLond_4-1.lnote.oe.12"/> aperte et patenter forefacientem<ptr type="liebermannNote" n="13" target="#LibLond_4-1.lnote.oe.13"/> inuenerit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 674 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_4-1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">darf</seg><seg type="translation" xml:lang="en" source="#claude">may</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_4-1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Bezirk privater Gerichtsbarkeit unter Kirche oder Adel: den Zustand <hi rend="spaced">vor</hi> municipaler Einheit sieht hier noch der städtische Politiker gern</hi></seg><seg type="translation" xml:lang="en" source="#claude">district of private jurisdiction under the Church or the nobility: the civic politician here still looks with favour on the state of affairs <hi rend="italic">before</hi> municipal unity</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_4-1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">der baroniale Gerichtsvogt</hi></seg><seg type="translation" xml:lang="en" source="#claude">the baronial bailiff of the court</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_4-1.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">alle Bezirke nicht privater Jurisdiction, also auch die unter später städtischer, heissen noch königlich</hi></seg><seg type="translation" xml:lang="en" source="#claude">all districts not under private jurisdiction, hence also those later under municipal jurisdiction, are still called royal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_4-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">h’c <hi rend="italic">Ai;</hi> debet <hi rend="italic">Horn Ampl;</hi> <hi rend="spaced">habent</hi> <hi rend="italic">PlS</hi></seg><seg type="translation" xml:lang="en" source="#claude">h’c Ai; debet Horn Ampl; <hi rend="italic">habent</hi> PlS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_4-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so,</hi> alicuius <hi rend="italic">hinzufügend Horn;</hi> socha <hi rend="italic">PlS;</hi> soccha <hi rend="italic">Ai;</hi> sokna <hi rend="italic">Ampl stets</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus, adding alicuius, Horn; socha PlS; soccha Ai; sokna Ampl throughout</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_4-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">regia <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">regia Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_4-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">ipso <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">ipso Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_4-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Horn;</hi> socce <hi rend="italic">Ai;</hi> soche <hi rend="italic">PlS</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Horn; socce Ai; soche PlS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_4-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">partibus</hi>, <hi rend="italic">darüber</hi> uel parti <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">partibus</hi>, with uel parti above it Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_4-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">uicecomes <hi rend="italic">fügt zu Horn;</hi> forsitan reum <hi rend="italic">Cons</hi></seg><seg type="translation" xml:lang="en" source="#claude">uicecomes added by Horn; forsitan reum Cons</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_4-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">reg’ <hi rend="italic">Ai;</hi> regia <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">reg’ Ai; regia Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_4-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Horn;</hi> socca <hi rend="italic">Ai;</hi> socha <hi rend="italic">PlS</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Horn; socca Ai; socha PlS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_4-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Ai;</hi> forisf. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Ai; forisf. the others</seg></note>
      </div>
    </body>
