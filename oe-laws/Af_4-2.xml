        <note type="liebermannNote" subtype="textual" xml:id="Af_4-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">50</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in So Ld</seg></note>
