    <body>
      <div type="clause" n="38">
        <head>Af Rb 38</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="38" corresp="#wit-e"><pb n="18" ed="#liebermann"/>XXXV. Be<ptr type="liebermannNote" n="22" target="#Rubrics-Af_38.lnote.oe.22"/> ðon ðe mon beforan ealdormen on gemote gefeohte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="38" corresp="#wit-ot-frag"><pb n="18" ed="#liebermann"/>… e þon þe mo: :eforan ealdormen o … gefeoht:</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="38" corresp="#wit-g-prol"><pb n="18" ed="#liebermann"/>XXXV. Be þa<hi rend="italic">m</hi> ðe man beforan ealdormen on gemote gefeohte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="38" corresp="#wit-h"><pb n="19" ed="#liebermann"/>XXXV. Be ðon<ptr type="liebermannNote" n="16" target="#Rubrics-Af_38.lnote.oe.16"/> þe mon<ptr type="liebermannNote" n="2" target="#Rubrics-Af_38.lnote.oe.2"/> beforan ealdormen<ptr type="liebermannNote" n="17" target="#Rubrics-Af_38.lnote.oe.17"/> on gemóte fiohte.<ptr type="liebermannNote" n="7" target="#Rubrics-Af_38.lnote.oe.7"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="38" corresp="#wit-q"><pb n="19" ed="#liebermann"/>De eo<ptr type="liebermannNote" n="23" target="#Rubrics-Af_38.lnote.oe.23"/> si quis coram aldremanno pugnet in placito.<ptr type="liebermannNote" n="24" target="#Rubrics-Af_38.lnote.oe.24"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="196" ed="#jurasinski-and-oliver"/>XXXV Be ðon ðe mon beforan ealdormen on gemote gefeohte</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="196" ed="#jurasinski-and-oliver"/>Be ða<hi rend="italic">m</hi> ðe beforan aldorm<hi rend="italic">en</hi> on gemote feohte</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="19" ed="#liebermann"/>Darüber<ptr type="liebermannNote" n="1" target="#Rubrics-Af_38.lnote.de.1"/>, dass jemand vor dem Ealdorman in der Versammlung ficht.<ptr type="liebermannNote" n="2" target="#Rubrics-Af_38.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning someone fighting before the ealdorman in the assembly.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="197" ed="#jurasinski-and-oliver"/>Concerning that someone fights in the assembly in the presence of the king’s <hi rend="italic">ealdorman</hi></ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="197" ed="#jurasinski-and-oliver"/>Concerning he who fights in the assembly in the presence of the king’s <hi rend="italic">ealdorman</hi></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_38.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">pugna in pl. c. al. <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">pugna in pl. c. al. Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_38.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">De illo [De i. <hi rend="italic">fehlt Hk</hi>] qui placitum populi armis turbaverit <hi rend="italic">fügt zu Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">De illo [De i. lacking in Hk] qui placitum populi armis turbaverit added by Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_38.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Nur</hi> Be gefeoht <hi rend="italic">So, hiermit abbrechend; die erste Rubrik des hierher gehörigen, zunächst folgen sollenden Bruchstücks betrifft Ine</hi> 55; <hi rend="italic">nur</hi> Be gefeohte b. e. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">only Be gefeoht So, which breaks off here; the first rubric of the fragment that belongs here and should follow next concerns Ine 55; only Be gefeohte b. e. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_38.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> ðam</seg><seg type="translation" xml:lang="en" source="#claude">altered ðam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_38.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_38.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geändert</hi> ealder.</seg><seg type="translation" xml:lang="en" source="#claude">altered ealder.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_38.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">i <hi rend="italic">in</hi> e <hi rend="italic">geändert</hi></seg><seg type="translation" xml:lang="en" source="#claude">i altered to e</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_38.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘Von blutigem Fechten’ So</seg><seg type="translation" xml:lang="en" source="#claude">‘Of bloody fighting’ So</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_38.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Q spät. Rez. erfindet Rb zu Af 38, 1</seg><seg type="translation" xml:lang="en" source="#claude">Q later rec. invents a Rb for Af 38, 1</seg></note>
      </div>
    </body>
