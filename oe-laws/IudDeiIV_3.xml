        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 3" corresp="#wit-du" ana="#glossed"><pb n="409" ed="#liebermann"/>Ad furtum requirendum benedictio aquæ. <seg type="glossed"><seg type="base">Domine</seg><gloss xml:lang="ang">Driht<hi rend="italic">en</hi></gloss></seg> <seg type="glossed"><seg type="base">Iesu</seg><gloss xml:lang="ang">hæl<hi rend="italic">end<ptr type="liebermannNote" n="29" target="#IudDeiIV_3.lnote.oe.29"/></hi></gloss></seg> <seg type="glossed"><seg type="base">Christe,</seg><gloss xml:lang="ang">Crist,</gloss></seg> <seg type="glossed"><seg type="base">qui</seg><gloss xml:lang="ang">ðu ðe</gloss></seg> <seg type="glossed"><seg type="base">es</seg><gloss xml:lang="ang">+ arð</gloss></seg> <seg type="glossed"><seg type="base">iudex</seg><gloss xml:lang="ang">doeme</gloss></seg> <seg type="glossed"><seg type="base">iustus,</seg><gloss xml:lang="ang">soðfæst,</gloss></seg> <seg type="glossed"><seg type="base">fortis</seg><gloss xml:lang="ang">strong</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">patiens</seg><gloss xml:lang="ang">ðyldig</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">multum</seg><gloss xml:lang="ang">monigfald</gloss></seg> <seg type="glossed"><seg type="base">misericors,</seg><gloss xml:lang="ang">miltheart,</gloss></seg> <seg type="glossed"><seg type="base">per</seg><gloss xml:lang="ang">ðerh</gloss></seg> <seg type="glossed"><seg type="base">quem</seg><gloss xml:lang="ang">ðone</gloss></seg> <seg type="glossed"><seg type="base">facta sunt</seg><gloss xml:lang="ang">awurdon</gloss></seg> <seg type="glossed"><seg type="base">omnia,</seg><gloss xml:lang="ang">alle,</gloss></seg> <seg type="glossed"><seg type="base">Deus</seg><gloss xml:lang="ang">God</gloss></seg> <seg type="glossed"><seg type="base">deorum<ptr type="liebermannNote" n="40" target="#IudDeiIV_3.lnote.oe.40"/>,</seg><gloss xml:lang="ang">godana<ptr type="liebermannNote" n="39" target="#IudDeiIV_3.lnote.oe.39"/>,</gloss></seg> <seg type="glossed"><seg type="base">Dominus<ptr type="liebermannNote" n="41" target="#IudDeiIV_3.lnote.oe.41"/></seg><gloss xml:lang="ang">drih<hi rend="italic">ten</hi></gloss></seg> <seg type="glossed"><seg type="base">dominantium,</seg><gloss xml:lang="ang">ricsandra,</gloss></seg></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 409 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">Iesus <hi rend="italic">glossirt durch ‘Heiland’</hi> 3. 4, 6. V 2, 1. VII 23 <hi rend="italic">A</hi></seg><seg type="translation" xml:lang="en" source="#claude">Iesus glossed by ‘Saviour’ 3. 4, 6. V 2, 1. VII 23 A</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Lind. S.</hi> 114</seg><seg type="translation" xml:lang="en" source="#claude">Lind. p. 114</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> III 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. III 2</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-du">For seeking out a theft, the blessing of the water. Lord Jesus Christ, who are a just judge, strong and patient and very merciful, through whom all things were made, God of gods, Lord of lords (lit. 'of those ruling'),</ab>
