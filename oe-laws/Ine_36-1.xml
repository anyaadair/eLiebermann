      <div type="clause" n="36.1">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 36.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.1" corresp="#wit-e"><pb n="104" ed="#liebermann"/>Gif he ealdormon<ptr type="liebermannNote" n="19" target="#Ine_36-1.lnote.oe.19"/> sie, ðolie his scire, buton<ptr type="liebermannNote" n="20" target="#Ine_36-1.lnote.oe.20"/> him kyning arian wille.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.1" corresp="#wit-h"><pb n="104" ed="#liebermann"/>Gif he<ptr type="liebermannNote" n="9" target="#Ine_36-1.lnote.oe.9"/> ealdermon<ptr type="liebermannNote" n="14" target="#Ine_36-1.lnote.oe.14"/> sy<ptr type="liebermannNote" n="1" target="#Ine_36-1.lnote.oe.1"/>, þolige his scire, buton<ptr type="liebermannNote" n="4" target="#Ine_36-1.lnote.oe.4"/> him se cyning arian wille.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.1" corresp="#wit-b-no-prol"><pb n="104" ed="#liebermann"/>Gyf he ealdorman sy, ðolie his scire, buton him cyning arian wylle.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="36.1" corresp="#wit-q"><pb n="105" ed="#liebermann"/>Si aldermannus<ptr type="liebermannNote" n="24" target="#Ine_36-1.lnote.oe.24"/> sit, perdat comitatum suum, nisi rex<ptr type="liebermannNote" n="25" target="#Ine_36-1.lnote.oe.25"/> ei<ptr type="liebermannNote" n="26" target="#Ine_36-1.lnote.oe.26"/> parcere uelit.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="48" ed="#attenborough"/>Gif he ealdormon sie, ðolie his scire, buton him kyning<ptr type="editorNote" n="3" target="#Ine_36-1.attnote.fn.3"/> arian wille.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="37.1" corresp="#wit-e"><pb n="402" ed="#jurasinski-and-oliver"/>Gif he ealdormon sie, ðolie his scire, buton him kyning arian wille.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="105" ed="#liebermann"/>Wenn er Ealdorman<ptr type="liebermannNote" n="1" target="#Ine_36-1.lnote.de.1"/> ist, verliere er sein Amt, es sei denn, (der<ptr type="liebermannNote" n="2" target="#Ine_36-1.lnote.de.2"/>) König wolle ihn begnadigen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he is an ealdorman, let him lose his office, unless (the) king is willing to pardon him.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="49" ed="#attenborough"/>If he is an <hi rend="italic">ealdorman<ptr type="editorNote" n="1" target="#Ine_36-1.attnote.n.1"/></hi> he shall forfeit his ‘shire<ptr type="editorNote" n="2" target="#Ine_36-1.attnote.n.2"/>,’ unless the king is willing to pardon him.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="403" ed="#whitelock"/>If he is an ealdorman, he is to lose his office, unless the king wishes to pardon him.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="403" ed="#jurasinski-and-oliver"/>If he is an <hi rend="italic">ealdorman</hi>, let him forfeit his shire, unless the king is willing to show him mercy.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_36-1.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">105</biblScope></bibl><seg type="original" xml:lang="de">aldrem. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">aldrem. R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_36-1.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">105</biblScope></bibl><seg type="original" xml:lang="de">ei rex <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei rex T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_36-1.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">105</biblScope></bibl><seg type="original" xml:lang="de">pa. uel. ei <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">pa. uel. ei MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_36-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_36-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zweites</hi> e <hi rend="italic">auf Rasur;</hi> o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">second e on an erasure; o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_36-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_36-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_36-1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">-man sy þolige <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-man sy þolige Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_36-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">104</biblScope></bibl><seg type="original" xml:lang="de">butan h. cy. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">butan h. cy. Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_36-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">74</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Fraglich bleibt 1. ob des Ealdorman Amtsbezirk bereits stets nur die spätere Grafschaft (<hi rend="italic">s. d. Gl</hi> 1. 3a) ist (so Corbett in <hi rend="italic">Cambridge mediæ. hist.</hi> I 5. 70), und 2., selbst wenn dies der Fall, ob [wie Kemble (<hi rend="italic">Saxons</hi> II 134), Schmid, Earle (<hi rend="italic">Anglo-S. liter.</hi> 152) verstehen] diese schon mit <hi rend="italic">scir</hi> von Ine gemeint ist; <hi rend="italic">s. o.</hi> Pro¹²·¹⁶; <hi rend="italic">Gl</hi> Amtsentsetzung 1</seg><seg type="translation" xml:lang="en" source="#claude">It remains doubtful, 1. whether the ealdorman's district was already always just the later shire (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1. 3a) (so Corbett in <hi rend="italic">Cambridge mediæ. hist.</hi> I 5. 70), and 2., even if this was the case, whether [as Kemble (<hi rend="italic">Saxons</hi> II 134), Schmid and Earle (<hi rend="italic">Anglo-S. liter.</hi> 152) understand it] this is already what Ine means by <hi rend="italic">scir</hi>; <hi rend="italic">see above</hi> Pro¹²·¹⁶; <hi rend="italic">Gl</hi> Amtsentsetzung 1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_36-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">74</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Artikel führt H modernisierend ein</seg><seg type="translation" xml:lang="en" source="#claude">H, modernising, introduces the article</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_36-1.attnote.fn.3" n="3" source="#attenborough"><bibl><biblScope unit="page">48</biblScope></bibl><label>kyning</label><seg type="original" xml:lang="en"><hi rend="italic">se cyning</hi>. H.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_36-1.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">187</biblScope></bibl><seg type="original" xml:lang="en">See note 2 to the preamble; note 2 to cap. 8.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_36-1.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">187</biblScope></bibl><seg type="original" xml:lang="en">See note 2 to the preamble; note 2 to cap. 8.</seg></note>
      </div>
