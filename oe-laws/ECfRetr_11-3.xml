    <body>
      <div type="clause" n="11.3">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 11.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 11.3"><pb n="637" ed="#liebermann"/>Dum <hi rend="bold">uero</hi> collectio <hi rend="bold">census</hi><ptr type="liebermannNote" n="1" target="#ECfRetr_11-3.lnote.la.1"/> fieret, <hi rend="bold">pro</hi>clamabat<ptr type="liebermannNote" n="2" target="#ECfRetr_11-3.lnote.la.2"/> ecclesia, suam reposcens<ptr type="liebermannNote" n="3" target="#ECfRetr_11-3.lnote.la.3"/> libertatem, sed nihil <hi rend="bold">profecit.</hi></ab>
        <note type="comparison" source="#liebermann" n="637"><label>printed alongside</label> <ref target="clause:ECf_11-3">ECf 11.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 637 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_11-3.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">f. c. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. c. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_11-3.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">sancta <hi rend="italic">fügt zu Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">Sp adds sancta</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_11-3.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">l. r. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">l. r. Cb</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But while the collection of the tax was being made, the Church protested, demanding back its liberty; but it availed nothing.</ab>
      </div>
    </body>
