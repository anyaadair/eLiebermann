      <div type="clause" n="12">
        <head><ref type="lawCode" target="law:Iudex">Iudex</ref> 12</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="12" corresp="#wit-g-a"><pb n="476" ed="#liebermann"/>Þa únrihtwisan deman, æfter witegan cwyde, swa swa wulfas on æfne, ne læfað náwiht oð morgen: þ<hi rend="italic">æt</hi> ys, þ<hi rend="italic">æt</hi> hi be þisses anweardan<ptr type="liebermannNote" n="1" target="#Iudex_12.lnote.oe.1-2"/> lifes ongehyðnesse ðenceað ⁊ nawiht be þæs towerdan.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="12" corresp="#wit-q"><pb n="476" ed="#liebermann"/>Impii iudices, iuxta uerba<ptr type="liebermannNote" n="1" target="#Iudex_12.lnote.oe.1"/> sapientium<ptr type="liebermannNote" n="2" target="#Iudex_12.lnote.oe.2"/>, sicut rapaces<ptr type="liebermannNote" n="a" target="#Iudex_12.lnote.oe.a"/> lupi uespere nil residuant<ptr type="liebermannNote" n="b" target="#Iudex_12.lnote.oe.b"/> usque mane, id est de presenti<ptr type="liebermannNote" n="3" target="#Iudex_12.lnote.oe.3"/> solum uita cogitant; de futura<ptr type="liebermannNote" n="4" target="#Iudex_12.lnote.oe.4"/> nichil<ptr type="liebermannNote" n="5" target="#Iudex_12.lnote.oe.5"/> considerant.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="476" ed="#liebermann"/>Die ungerechten Richter lassen nach des Propheten<ptr type="liebermannNote" n="a" target="#Iudex_12.lnote.de1.a"/> Spruch, so wie Wölfe<ptr type="liebermannNote" n="1" target="#Iudex_12.lnote.de.1"/> am Abend nichts bis zum Morgen übrig: d. h. dass sie an das Vortheilhafte<ptr type="liebermannNote" n="2" target="#Iudex_12.lnote.de.2"/> dieses gegenwärtigen Lebens denken und nicht an das des zukünftigen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Unjust judges, according to the prophet's saying, like wolves in the evening, leave nothing until morning: that is, they think of the advantage of this present life and not of the life to come.</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-g-a">Unjust judges follow the prophet’s saying: like wolves in the evening, they leave nothing for morning. That is, they think about this present life’s advantages and nothing about the next.</ab>
        <note type="passageSource">Zephaniah 3:3 (cf. Acts 20:29)</note>
        <note type="comparison" source="#liebermann" n="476">Isidor, Sent. III 52.12</note>
        <note type="comparisonPrinted" source="#liebermann">Isidor, Sent. III 52, 12</note>
        <note type="comparisonIncomplete">Some of Liebermann’s notes here are cut off in the gutter of the scan used, and are still to be completed.</note>
        <note type="editorial">U: translator unrecorded: check; Isidore, Sent. III 52.12. Liebermann suggests reading ‘reliquunt’ for the Quadripartitus's ‘residuant’.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_12.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de">-bum <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">-bum <hi rend="italic">Br</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_12.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de">-tum <hi rend="italic">TMHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tum <hi rend="italic">TMHkBr</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_12.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Act. apost.</hi> 20, 29</seg><seg type="translation" xml:lang="en" source="#claude">from Act. apost. 20, 29</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_12.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">lies</hi> relīquunt<hi rend="italic">?</hi></seg><seg type="translation" xml:lang="en" source="#claude">read relīquunt?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_12.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de">dienti <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">dienti <hi rend="italic">R</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_12.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de">-ris <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ris <hi rend="italic">T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_12.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de">nil <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">nil <hi rend="italic">R</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_12.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Sievers Gramm.</hi> 198, 5 <hi rend="italic">A</hi>²</seg><seg type="translation" xml:lang="en" source="#claude">cf. Sievers Gramm. 198, 5 A²</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="Iudex_12.lnote.de1.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Isidor folgt Sophon.</hi> 3, 3</seg><seg type="translation" xml:lang="en" source="#claude">Isidor follows Sophon. 3, 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Iudex_12.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">269</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Bestochene Richter <hi rend="italic">beoð . . slitende wulfas, þonne hie for feos lufan carmne fordemað buton scylde</hi>; Blickling Homil. 63</seg><seg type="translation" xml:lang="en" source="#claude">Bribed judges <hi rend="italic">beoð . . slitende wulfas, þonne hie for feos lufan carmne fordemað buton scylde</hi>; Blickling Homil. 63</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Iudex_12.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">269</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">gehyðnes</hi> ‘advantage’, <hi rend="italic">gehyðlice</hi> ‘comfortably?’ Sweet</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">gehyðnes</hi> ‘advantage’, <hi rend="italic">gehyðlice</hi> ‘comfortably?’ Sweet</seg></note>
      </div>
