    <body>
      <div type="clause" n="38.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 38.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 38.1"><pb n="668" ed="#liebermann"/>Et<ptr type="liebermannNote" n="22" target="#ECfRetr_38-1.lnote.la.22"/> si <hi rend="bold">esset</hi><ptr type="liebermannNote" n="23" target="#ECfRetr_38-1.lnote.la.23"/> opus aureum uel argenteum, unde <hi rend="bold">emptor</hi> <hi rend="spaced">dubitare</hi> <hi rend="bold">posset,</hi> non<ptr type="liebermannNote" n="24" target="#ECfRetr_38-1.lnote.la.24"/> <hi rend="spaced">emeret</hi> <hi rend="bold">absque</hi><ptr type="liebermannNote" n="25" target="#ECfRetr_38-1.lnote.la.25"/> <hi rend="spaced">aurifabris</hi> <hi rend="bold">uel</hi> <hi rend="spaced">monetariis</hi>. <hi rend="bold">Qui</hi> si <hi rend="spaced">uidissent</hi>, quod <hi rend="spaced">esset</hi> de ecclesia uel de<ptr type="liebermannNote" n="26" target="#ECfRetr_38-1.lnote.la.26"/> <hi rend="spaced">thesauro</hi>, non <hi rend="spaced">emisset</hi> sine plegio<ptr type="liebermannNote" n="27" target="#ECfRetr_38-1.lnote.la.27"/>.</ab>
        <note type="comparison" source="#liebermann" n="668"><label>printed alongside</label> <ref target="clause:ECf_38-1">ECf 38.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 668 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-1.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">38, 1 <hi rend="italic">ist Parenthese, da</hi> 38 <hi rend="italic">in</hi> 38, 1<hi rend="italic">a fortgesetzt wird</hi></seg><seg type="translation" xml:lang="en" source="#claude">38, 1 is a parenthesis, since 38 is continued in 38, 1a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-1.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wohl nicht die wenigen</hi> aurifabri regis (<hi rend="italic">s.</hi> Domesday <hi rend="italic">Indices</hi> 545), <hi rend="italic">sondern eine ganze Zunft scheint gemeint, die der Ausführung von Staatsgesetzen zu dienen (sonst zuerst</hi> 1300) <hi rend="italic">schien; Cunningham</hi> Growth of industry 263. <hi rend="italic">Die Münzer sind königlich</hi></seg><seg type="translation" xml:lang="en" source="#claude">probably not the few aurifabri regis (see Domesday, Indices 545): a whole guild seems to be meant, which appeared to serve the carrying out of the laws of the state (otherwise first in 1300); Cunningham, Growth of industry 263. The moneyers are royal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-1.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">des Königs, zu Winchester und London</hi></seg><seg type="translation" xml:lang="en" source="#claude">the king’s, at Winchester and London</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-1.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Lb Va Db K;</hi> Set <hi rend="italic">st.</hi> Et si <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Lb Va Db K; Set instead of Et si Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-1.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">fieret <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">fieret Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-1.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">n. e. <hi rend="italic">fehlt Lb Va Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">n. e. lacking in Lb Va Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-1.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">sine <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">sine Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-1.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_38-1.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">-iis <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iis Hv</seg></note>
      </div>
