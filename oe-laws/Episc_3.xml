    <body>
      <div type="clause" n="3">
        <head><ref type="lawCode" target="law:Episc">Episc</ref> 3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3" corresp="#wit-x"><pb n="477" ed="#liebermann"/>He sceal beon symle ymbe some ⁊ ymbe sibbe, swa he geornost mæg.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3" corresp="#wit-q"><pb n="477" ed="#liebermann"/>Debet eciam sedulo concordiam<ptr type="liebermannNote" n="11" target="#Episc_3.lnote.oe.11"/> et pacem<ptr type="liebermannNote" n="12" target="#Episc_3.lnote.oe.12"/></ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-x"><pb n="102" ed="#rabin-doml"/>He sceal beon symle ymbe some and ymbe sibbe swa he geornost mæg.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="477" ed="#liebermann"/>Er soll immer um Versöhnung und um Frieden bemüht sein, eifrigst wie er vermag.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">He shall always be concerned with reconciliation and with peace, as zealously as he can.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-x"><pb n="103" ed="#rabin-doml"/>He must always be concerned with reconciliation and peace as fervently as he can.</ab>
        <note type="editorial">A line was skipped in the Quadripartitus here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_3.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">477</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> p. et c. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Lond; p. et c. the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_3.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">477</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Zeile übersprungen</hi></seg><seg type="translation" xml:lang="en" source="#claude">line skipped</seg></note>
      </div>
    </body>
