      <div type="clause" n="80.6a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 80.6a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 80.6a" corresp="#wit-lat"><pb n="596" ed="#liebermann"/>Si plures interfuerunt<ptr type="liebermannNote" n="36" target="#Hn_80-6a.lnote.oe.36"/> cum domino uel preposito, uel ad hu[n]c<ptr type="liebermannNote" n="37" target="#Hn_80-6a.lnote.oe.37"/> modum<ptr type="liebermannNote" n="38" target="#Hn_80-6a.lnote.oe.38"/> aliquo quouis<ptr type="liebermannNote" n="m" target="#Hn_80-6a.lnote.oe.m"/> habeat<ptr type="liebermannNote" n="n" target="#Hn_80-6a.lnote.oe.n"/> in eos, si occisus<ptr type="liebermannNote" n="39" target="#Hn_80-6a.lnote.oe.39"/> et locus unius domini sint qui socnam suam habeat<ptr type="liebermannNote" n="40" target="#Hn_80-6a.lnote.oe.40"/>, manbotam et fihtþitam<ptr type="liebermannNote" n="41" target="#Hn_80-6a.lnote.oe.41"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 596 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-6a.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de">qui ius <hi rend="italic">Sc; wer mit Edd. so liest, übersetze:</hi> mit . . . einem, der über sie [<hi rend="italic">die Verbrecher</hi>] Gewalt hat, <hi rend="italic">denke</hi> recipiat <hi rend="italic">aus</hi> 80, 6 <hi rend="italic">hinzu, muss aber noch ergänzen</hi> ab eis [omnibus]</seg><seg type="translation" xml:lang="en" source="#claude">qui ius <hi rend="italic">Sc; anyone who reads thus with the edd. should translate:</hi> with . . . someone who has power over them [<hi rend="italic">the criminals</hi>], <hi rend="italic">supply</hi> recipiat <hi rend="italic">from</hi> 80, 6, <hi rend="italic">but must also add</hi> ab eis [omnibus]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-6a.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de">erhalte der Gerichtsherr gegen sie <hi rend="italic">alle, wenn auch nur einer verhaftet war, Anspruch auf</hi> Mannenbusse und Fechtstrafe, falls Erschlagener und Gericht des Thatorts derselben Herrschaft angehören</seg><seg type="translation" xml:lang="en" source="#claude">let the lord of jurisdiction obtain against them <hi rend="italic">all, even if only one had been arrested, a claim to</hi> man-compensation and fighting-fine, if the slain man and the court of the scene of the crime belong to the same lordship</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-6a.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de">-rint <hi rend="italic">Hg;</hi> -ficiunt <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rint Hg; -ficiunt Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-6a.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de">adhuc <hi rend="italic">Hss. Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">adhuc MSS edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-6a.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de">modo <hi rend="italic">K Co Or Sl Tw Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">modo K Co Or Sl Tw edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-6a.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de">-sos <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sos Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-6a.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de">-ant <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ant Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-6a.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de">-wyt. <hi rend="italic">Co Or;</hi> fityyt. <hi rend="italic">Sc;</hi> fytyyt. <hi rend="italic">Hg;</hi> -twit. <hi rend="italic">Sl Tw;</hi> fightwy. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-wyt. Co Or; fityyt. Sc; fytyyt. Hg; -twit. Sl Tw; fightwy. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-6a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">327</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> gemeinschaftliche Missetat 11; Mannbusse 4. 5f. Zu ergänzen scheint <hi rend="italic">unam</hi> vor <hi rend="italic">manbotam</hi>—<hi rend="italic">-rint</hi>{38}—<hi rend="italic">ad huc</hi>{37} <hi rend="italic">modo a qui ius</hi> [dies gehört als richtig in den Text] <hi rend="italic">h</hi>.—<hi rend="italic">fit</hi>.{41}—80, 7 <hi rend="italic">homip</hi>.{43} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> gemeinschaftliche Missetat 11; Mannbusse 4. 5f. <hi rend="italic">unam</hi> seems to need supplying before <hi rend="italic">manbotam</hi>—<hi rend="italic">-rint</hi>{38}—<hi rend="italic">ad huc</hi>{37} <hi rend="italic">modo a qui ius</hi> [this belongs in the text as correct] <hi rend="italic">h</hi>.—<hi rend="italic">fit</hi>.{41}—80, 7 <hi rend="italic">homip</hi>.{43} Rs</seg></note>
      </div>
