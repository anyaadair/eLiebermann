      <div type="clause" n="7">
        <head><ref type="lawCode" target="law:ExcomI">Excom I</ref> 7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom I 7" corresp="#wit-ti"><pb n="432" ed="#liebermann"/>Et in alio loco membrum<ptr type="liebermannNote" n="m" target="#ExcomI_7.lnote.oe.m"/> quod a sua compage resoluitur et a iunctura karitatis dissociatur et omne corpus<ptr type="liebermannNote" n="34" target="#ExcomI_7.lnote.oe.34"/> scandalizat, Dominus abscidi<ptr type="liebermannNote" n="35" target="#ExcomI_7.lnote.oe.35"/> et proici iubet, dicens: “Si oculus<ptr type="liebermannNote" n="36" target="#ExcomI_7.lnote.oe.36"/>, manus uel pes tuus scandalizat te, erue<ptr type="liebermannNote" n="37" target="#ExcomI_7.lnote.oe.37"/> eum et proice abs<ptr type="liebermannNote" n="38" target="#ExcomI_7.lnote.oe.38"/> te”.</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">ebd. 18, 9</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 432 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_7.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. u.</hi> 10</seg><seg type="translation" xml:lang="en" source="#claude">cf. below 10</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_7.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">fügt zu Bal</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod added by Bal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_7.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de">et a. <hi rend="italic">Vb;</hi> abscindi <hi rend="italic">Reg</hi></seg><seg type="translation" xml:lang="en" source="#claude">et a. Vb; abscindi Reg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_7.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">fügt zu Reg</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel added by Reg</seg></note>
