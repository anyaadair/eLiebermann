    <body>
      <div type="clause" n="70.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 70.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 70.3" corresp="#wit-lat"><pb n="588" ed="#liebermann"/>Si dominus occisoris nec pro eo reddit<ptr type="liebermannNote" n="a" target="#Hn_70-3.lnote.oe.a"/>, nec seruus habet unde reddat, dimittere<ptr type="liebermannNote" n="1" target="#Hn_70-3.lnote.oe.1"/> potest<ptr type="liebermannNote" n="b" target="#Hn_70-3.lnote.oe.b"/> eum dominus, ut sibi<ptr type="liebermannNote" n="2" target="#Hn_70-3.lnote.oe.2"/> caueat<ptr type="liebermannNote" n="c" target="#Hn_70-3.lnote.oe.c"/>: nisi forte crauetur<ptr type="liebermannNote" n="3" target="#Hn_70-3.lnote.oe.3"/>, dum<ptr type="liebermannNote" n="d" target="#Hn_70-3.lnote.oe.d"/> secum est: quod si eueniat<ptr type="liebermannNote" n="4" target="#Hn_70-3.lnote.oe.4"/>, eum repetentibus<ptr type="liebermannNote" n="5" target="#Hn_70-3.lnote.oe.5"/> (parentibus) reddat uel inde componat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 588 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-3.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">Wergeld zahlt</seg><seg type="translation" xml:lang="en" source="#claude">pays wergild</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-3.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">70, 5; 5<hi rend="italic">a näher zu Ine</hi></seg><seg type="translation" xml:lang="en" source="#claude">70, 5; 5a closer to Ine</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-3.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">auf dass der Sklav [<hi rend="italic">fliehend vor den Rächern</hi>] sich hüte</seg><seg type="translation" xml:lang="en" source="#claude">so that the slave [<hi rend="italic">fleeing from the avengers</hi>] may be on his guard</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-3.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">erfolgt die Anklage, während der Herr den Mörder bei sich hält, so muss er ihn ausliefern oder Busse zahlen; vorher haftet er nicht, wenn er ihn (<hi rend="italic">der dann die Fehdegefahr allein trägt</hi>) entlässt</seg><seg type="translation" xml:lang="en" source="#claude">if the accusation is made while the lord keeps the killer with him, he must hand him over or pay compensation; before that he is not liable if he dismisses him (<hi rend="italic">who then bears the risk of feud alone</hi>)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-3.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">dem. <hi rend="italic">ohne Hss. Wh Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">dem. Wh Wi, without MS authority</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-3.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">si <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">si Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-3.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">cau. <hi rend="italic">Sc Hg</hi>; grau. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">cau. Sc Hg; grau. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">ueniat <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">ueniat Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-3.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">588</biblScope></bibl><seg type="original" xml:lang="de">re. <hi rend="italic">Sc Hg K; dafür</hi> pa. [<hi rend="italic">wie</hi> 70, 5] <hi rend="italic">Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">re. Sc Hg K; instead pa. [as 70, 5] Co Or Gi</seg></note>
      </div>
