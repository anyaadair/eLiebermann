      <div type="clause" n="58">
        <head><ref type="lawCode" target="law:Af">Af</ref> 58</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="58" corresp="#wit-e"><pb n="82" ed="#liebermann"/>Gif se midlesta finger<ptr type="liebermannNote" n="12" target="#Af_58.lnote.oe.12"/> sie ófaslegen<ptr type="liebermannNote" n="7" target="#Af_58.lnote.oe.7"/>, sio<ptr type="liebermannNote" n="13" target="#Af_58.lnote.oe.13"/> bot bið XII scill.; ⁊ his nægles bot<ptr type="liebermannNote" n="14" target="#Af_58.lnote.oe.14"/> bið II scill.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="58" corresp="#wit-h"><pb n="82" ed="#liebermann"/>Gif se midlæsta finger bið ofaslægen, seo<ptr type="liebermannNote" n="4" target="#Af_58.lnote.oe.4"/> bot bið XII scll'; ⁊ his nægles bot bið II scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="58" corresp="#wit-b-no-prol"><pb n="82" ed="#liebermann"/>Gyf se midleste finger sy ofaslagen, seo bot bið XII scill' ⁊ his nægles II scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="58" corresp="#wit-q"><pb n="83" ed="#liebermann"/>Si<ptr type="liebermannNote" n="14" target="#Af_58.lnote.oe.14-2"/> medius amputetur, eius emendatio sit duodecim sol.; unguis<ptr type="liebermannNote" n="15" target="#Af_58.lnote.oe.15"/> II solid.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="88" ed="#attenborough"/>Gif se midlesta<ptr type="editorNote" n="9" target="#Af_58.attnote.fn.9"/> finger sie<ptr type="editorNote" n="10" target="#Af_58.attnote.fn.10"/> ófaslegen, sio bot bið XII scill.; ⁊ his nægles bot bið II scill.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="61" corresp="#wit-e"><pb n="356" ed="#jurasinski-and-oliver"/>Gif se midlesta finger sie ófaslegen, sio bot bið XII scill, ⁊ his nægles bot bið II scill.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="83" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_58.lnote.de.1"/> der mittelste<ptr type="liebermannNote" n="2" target="#Af_58.lnote.de.2"/> Finger abgeschlagen ist<ptr type="liebermannNote" n="3" target="#Af_58.lnote.de.3"/>, ist die Busse 12 Schill.; und die Busse seines Nagels ist 2 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the middle finger is struck off, the compensation is 12 shillings; and the compensation for its nail is 2 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="89" ed="#attenborough"/>If the middle finger is struck off, the compensation [to be paid] shall be 12 shillings; for the nail of the same, 2 shillings compensation shall be paid.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="357" ed="#jurasinski-and-oliver"/>If the middle finger is struck off, the compensation is 12 shillings; and the compensation for its nail is 2 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_58.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">-ere sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ere sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_58.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">ofaslagen <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ofaslagen Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_58.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">se <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">se Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_58.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">b. b. <hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">b. b. lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_58.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_58.lnote.oe.14-2" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">c.</hi> 58 <hi rend="italic">setzt hinter</hi> 59 <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. 58 placed after 59 by T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_58.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius added by Lond</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_58.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Durch Abt 54c beeinflusst</seg><seg type="translation" xml:lang="en" source="#claude">Influenced by Abt 54c</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_58.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Den Mittelfinger verdeutlicht durch <hi rend="italic">impudicus</hi> wie Inst. auch Hn</seg><seg type="translation" xml:lang="en" source="#claude">Hn, like Inst., makes the middle finger explicit by <hi rend="italic">impudicus</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_58.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nach <hi rend="italic">gif</hi> führt hier, 63, 1. 64, 4 H Indikativ ein, dagegen den Optativ B in Af 60 und Ld in 64, 3</seg><seg type="translation" xml:lang="en" source="#claude">After <hi rend="italic">gif</hi> H introduces the indicative here and in 63, 1. 64, 4, whereas B introduces the optative in Af 60 and Ld in 64, 3</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_58.attnote.fn.9" n="9" source="#attenborough"><bibl><biblScope unit="page">88</biblScope></bibl><label>midlesta</label><seg type="original" xml:lang="en"><hi rend="italic">midleste</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_58.attnote.fn.10" n="10" source="#attenborough"><bibl><biblScope unit="page">88</biblScope></bibl><label>sie</label><seg type="original" xml:lang="en"><hi rend="italic">bið</hi>. H.</seg><note type="remark" resp="#claude">The number 10 is printed 2 times on the page (58, 59), with one footnote.</note></note>
      </div>
    </body>
