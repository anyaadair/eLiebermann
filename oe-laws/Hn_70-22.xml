      <div type="clause" n="70.22">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 70.22</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 70.22" corresp="#wit-lat"><pb n="590" ed="#liebermann"/>Si sponsa uirum suum superuixerit, dotem et maritacionem<ptr type="liebermannNote" n="a" target="#Hn_70-22.lnote.oe.a"/> suam cartarum instrumentis<ptr type="liebermannNote" n="1" target="#Hn_70-22.lnote.oe.1"/> uel testium<ptr type="liebermannNote" n="b" target="#Hn_70-22.lnote.oe.b"/><ptr type="liebermannNote" n="2" target="#Hn_70-22.lnote.oe.2"/> exhibicionibus ei traditam perpetualiter habeat et morgangifam<ptr type="liebermannNote" n="3" target="#Hn_70-22.lnote.oe.3"/> suam et terciam partem de omni collaboracione<ptr type="liebermannNote" n="4" target="#Hn_70-22.lnote.oe.4"/> sua preter<ptr type="liebermannNote" n="c" target="#Hn_70-22.lnote.oe.c"/> uestes et lectum suum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 590 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-22.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht aus CHn cor.</hi> 3, 3: dotem suam et maritationem habebit</seg><seg type="translation" xml:lang="en" source="#claude">perhaps from CHn cor. 3, 3: dotem suam et maritationem habebit</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-22.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht aus Lex Ribuar.</hi> 48: testibus adhibitis</seg><seg type="translation" xml:lang="en" source="#claude">perhaps from Lex Ribuar. 48: testibus adhibitis</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-22.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">neben</seg><seg type="translation" xml:lang="en" source="#claude">besides</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-22.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">-torum <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-torum Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-22.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">fügt zu unterpunctirt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">in added, dotted for deletion, Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-22.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">-iuam <hi rend="italic">Sc Hg;</hi> morha. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iuam Sc Hg; morha. the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-22.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">collob. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">collob. Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-22.lnote.oe.a-2" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">326</biblScope></bibl><seg type="original" xml:lang="de">Laut Aufnahme dieses Satzes, folgern Pol Mai II 399f., kannte Hn kein eheliches Güterrecht (<hi rend="italic">s. d. Gl</hi> 9f.) aus England. <hi rend="italic">Vgl. Gl</hi> Aussteuer 4; Wittum 6.—Am Rande spät: <hi rend="italic">Hic primo statutum est, sponsam habere dotem</hi>—<hi rend="italic">-ginam</hi>{3}—70, 22a <hi rend="italic">quis</hi>{5}—<hi rend="italic">uel</hi>{6} <hi rend="italic">in com</hi>. Rs</seg><seg type="translation" xml:lang="en" source="#claude">From the inclusion of this sentence Pol Mai II 399f. conclude that Hn knew no English law of matrimonial property (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 9f.). <hi rend="italic">Cf. Gl</hi> Aussteuer 4; Wittum 6.—In the margin, in a late hand: <hi rend="italic">Hic primo statutum est, sponsam habere dotem</hi>—<hi rend="italic">-ginam</hi>{3}—70, 22a <hi rend="italic">quis</hi>{5}—<hi rend="italic">uel</hi>{6} <hi rend="italic">in com</hi>. Rs</seg></note>
      </div>
