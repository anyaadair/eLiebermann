      <div type="clause" n="49">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 49</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 49" corresp="#wit-lat"><pb n="572" ed="#liebermann"/>(C. XLIX<ptr type="liebermannNote" n="7" target="#Hn_49.lnote.oe.7"/>) Quibus<ptr type="liebermannNote" n="8" target="#Hn_49.lnote.oe.8"/> causis statim responderi<ptr type="liebermannNote" n="9" target="#Hn_49.lnote.oe.9"/> debeat<ptr type="liebermannNote" n="10" target="#Hn_49.lnote.oe.10"/>, quibus non.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 572 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">Que causa r. d., que non <hi rend="italic">K und so vor</hi> 50 <hi rend="italic">Co; keine Überschrift Or Gi;</hi> Quomodo possunt uti consilio [<hi rend="italic">d. i. zu</hi> 48] <hi rend="italic">durchstr. Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Que causa r. d., que non K, and so before 50 Co; no heading Or Gi; Quomodo possunt uti consilio [i.e. belonging to 48] struck through Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">-re <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">-re Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">-ant <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ant Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Que cause r. d., que n</hi>.—<hi rend="italic">Vgl. Gl</hi> Rechtsgang 14b—49, 1 ohne <hi rend="italic">de</hi>{11}—ohne <hi rend="italic">tenetur</hi>{12}—<hi rend="italic">cogitare</hi>{15}—<hi rend="italic">resp</hi>.{16} bis <hi rend="italic">de quibus</hi> überspr.—<hi rend="italic">non</hi>{17}—<hi rend="italic">tam in</hi>{18} <hi rend="italic">accusatoribus</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Que cause r. d., que n</hi>.—<hi rend="italic">Cf. Gl</hi> Rechtsgang 14b—49, 1 without <hi rend="italic">de</hi>{11}—without <hi rend="italic">tenetur</hi>{12}—<hi rend="italic">cogitare</hi>{15}—<hi rend="italic">resp</hi>.{16} to <hi rend="italic">de quibus</hi> omitted—<hi rend="italic">non</hi>{17}—<hi rend="italic">tam in</hi>{18} <hi rend="italic">accusatoribus</hi> Rs</seg></note>
      </div>
