      <div type="clause" n="80.11a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 80.11a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 80.11a" corresp="#wit-lat"><pb n="597" ed="#liebermann"/>Hamsocna<ptr type="liebermannNote" n="29" target="#Hn_80-11a.lnote.oe.29"/> est uel hamfare<ptr type="liebermannNote" n="l" target="#Hn_80-11a.lnote.oe.l"/>, si quis premeditate ad<ptr type="liebermannNote" n="24" target="#Hn_80-11a.lnote.oe.24"/> domum eat, ubi suum hostem esse<ptr type="liebermannNote" n="30" target="#Hn_80-11a.lnote.oe.30"/> scit<ptr type="liebermannNote" n="31" target="#Hn_80-11a.lnote.oe.31"/>, et ibi eum inuadat, si die uel nocte hoc faciat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 597 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-11a.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Kriterium der Absicht auch</hi> Leis Wl 2; nulli licuit in Normannia hanfara facere <hi rend="italic">Weisthum des Herzogsrechts</hi> 1091 <hi rend="italic">zu Caen; neben</hi> forsteal, pax regis <hi rend="italic">bleibt</hi> heimfare forisfactura in dominio regis, extra firmam comitatus; <hi rend="italic">Domesday</hi> I 152</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">criterion of intent also</hi> Leis Wl 2; nulli licuit in Normannia hanfara facere <hi rend="italic">declaration of the duke’s rights</hi> 1091 <hi rend="italic">at Caen; alongside</hi> forsteal <hi rend="italic">and</hi> pax regis, heimfare <hi rend="italic">remains</hi> forisfactura in dominio regis, extra firmam comitatus; <hi rend="italic">Domesday</hi> I 152</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-11a.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-11a.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">-am <hi rend="italic">ohne</hi> est <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-am without est Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-11a.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-11a.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">sit <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit Wh</seg></note>
