    <body>
      <div type="clause" n="5.1a">
        <head><ref type="lawCode" target="law:ICn">I Cn</ref> 5.1a</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.1a" corresp="#wit-g-a"><pb n="286" ed="#liebermann"/>⁊ gyf<ptr type="liebermannNote" n="2" target="#ICn_5-1a.lnote.oe.2"/> man hine tihtlige þryfealdre spæce<ptr type="liebermannNote" n="1" target="#ICn_5-1a.lnote.oe.1"/>, nime VI<ptr type="liebermannNote" n="3" target="#ICn_5-1a.lnote.oe.3"/> his gehadan ⁊ ladige hine mid<ptr type="liebermannNote" n="4" target="#ICn_5-1a.lnote.oe.4"/> ðam ⁊ beo he sylf seofeþa.<ptr type="liebermannNote" n="5" target="#ICn_5-1a.lnote.oe.5"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.1a" corresp="#wit-a"><pb n="286" ed="#liebermann"/>And gif man hine t[i]htlige<ptr type="liebermannNote" n="2" target="#ICn_5-1a.lnote.oe.2-2"/> þrifealdre spræce, nime six his gehadan ⁊ ladige hine<ptr type="liebermannNote" n="*" target="#ICn_5-1a.lnote.oe.star"/> þam ⁊ beo he sylf seofoða.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.1a" corresp="#wit-q"><pb n="286" ed="#liebermann"/>in triplici cum VI diaconibus se adlegiet.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.1a" corresp="#wit-inst-cn"><pb n="287" ed="#liebermann"/>Et si tres calumnię fuerint, assumat<ptr type="liebermannNote" n="1" target="#ICn_5-1a.lnote.oe.1-2"/> VI secum et ipse sit septimus (sex secum diaconibus acceptis, ita se purget).</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.1a" corresp="#wit-cons-cn"><pb n="287" ed="#liebermann"/>si uero triplici, assumat VI et ipse sit septimus.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="5a.1a" corresp="#wit-g-a"><pb n="160" ed="#robertson"/>⁊ gyf man hine tihtlige þryfealdre spæce, nime VI his gehadan ⁊ ladige hine mid ðam ⁊ beo he sylf seofeþa.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="238" ed="#rabin-doml"/>And gyf man hine tihtlige þryfealdre spæce, nime VI his gehadan and ladige hine mid ðam, and beo he sylf seofeþa.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="287" ed="#liebermann"/>Und wenn er mit dreifacher Anklage bezichtigt wird, so nehme er sechs seiner Standesgenossen und reinige sich mit denen und er selbst sei der siebente [im Eide].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if he is charged with a threefold accusation, let him take six of his fellow-clergy and clear himself with them, and be himself the seventh [in the oath].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-g-a"><pb n="161" ed="#robertson"/>And if a triple accusation is brought against him, he shall take six supporters of the same ecclesiastical rank —himself being a seventh—and clear himself with their help.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="239" ed="#rabin-doml"/>And if a threefold accusation is brought against him, he is to take six clerics of his rank and, himself being the seventh, exculpate himself with them.</ab>
        <note type="comparison" source="#liebermann" n="287"><ref target="clause:VIIIAtr_20-1">VIII Atr 20.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 20, 1</note>
        <note type="editorial">Liebermann compares VIII Atr 20.1.; BR: added from Gesetze I p. 287, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-1a.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">286</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-1a.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">286</biblScope></bibl><seg type="original" xml:lang="de">spræce <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">spræce Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-1a.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">286</biblScope></bibl><seg type="original" xml:lang="de">six <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">six Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-1a.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">286</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt</hi> [<hi rend="italic">wie A</hi>] <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted [as in A] in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-1a.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">286</biblScope></bibl><seg type="original" xml:lang="de">-foþa <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-foþa Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-1a.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">287</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Cb; eingeklammertes übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">the text before the bracket Cb; the bracketed text the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-1a.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">286</biblScope></bibl><seg type="original" xml:lang="de">thlige <hi rend="italic">A</hi></seg><seg type="translation" xml:lang="en" source="#claude">thlige A</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_5-1a.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">286</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> mid</seg><seg type="translation" xml:lang="en" source="#claude">supply mid</seg></note>
      </div>
    </body>
