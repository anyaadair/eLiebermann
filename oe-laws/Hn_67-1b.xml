      <div type="clause" n="67.1b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 67.1b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 67.1b" corresp="#wit-lat"><pb n="586" ed="#liebermann"/>Et de omnibus causis<ptr type="liebermannNote" n="23" target="#Hn_67-1b.lnote.oe.23"/>, unde accusatus<ptr type="liebermannNote" n="24" target="#Hn_67-1b.lnote.oe.24"/> iuraret se<ptr type="liebermannNote" n="o" target="#Hn_67-1b.lnote.oe.o"/> sexto<ptr type="liebermannNote" n="25" target="#Hn_67-1b.lnote.oe.25"/>, sit iudicium XX<ptr type="liebermannNote" n="p" target="#Hn_67-1b.lnote.oe.p"/> sol.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 586 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_67-1b.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">einfache Reinigung; vgl.</hi> 66, 8</seg><seg type="translation" xml:lang="en" source="#claude">simple purgation; cf. 66, 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_67-1b.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ein Pfund wiege das im Ordal zu tragende Glüheisen</hi></seg><seg type="translation" xml:lang="en" source="#claude">the glowing iron to be carried in the ordeal is to weigh one pound</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_67-1b.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_67-1b.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">iu. a. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">iu. a. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_67-1b.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">-tus <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tus Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_67-1b.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Ordal 33; Eisenordal 8—<hi rend="italic">iu. ac</hi>.{24} <hi rend="italic">-tus</hi>{25} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Ordal 33; Eisenordal 8—<hi rend="italic">iu. ac</hi>.{24} <hi rend="italic">-tus</hi>{25} Rs</seg></note>
