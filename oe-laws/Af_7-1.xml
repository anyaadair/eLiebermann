      <div type="clause" n="7.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 7.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.1" corresp="#wit-e"><pb n="54" ed="#liebermann"/>Gif he losige, ⁊ hine mon eft gefó, forgielde<ptr type="liebermannNote" n="1" target="#Af_7-1.lnote.oe.1"/> he hine self<ptr type="liebermannNote" n="2" target="#Af_7-1.lnote.oe.2"/> á<ptr type="liebermannNote" n="3" target="#Af_7-1.lnote.oe.3"/> be his weregilde<ptr type="liebermannNote" n="4" target="#Af_7-1.lnote.oe.4"/>, ⁊ ðone gylt gebete, swa wer<ptr type="liebermannNote" n="5" target="#Af_7-1.lnote.oe.5"/> swa wite, swa he gewyrht age.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.1" corresp="#wit-h"><pb n="54" ed="#liebermann"/>Gif he losige, ⁊ hine mon<ptr type="liebermannNote" n="1" target="#Af_7-1.lnote.oe.1-2"/> eft<ptr type="liebermannNote" n="2" target="#Af_7-1.lnote.oe.2-2"/> gefó, forgylde<ptr type="liebermannNote" n="3" target="#Af_7-1.lnote.oe.3-2"/> he hine sylfne<ptr type="liebermannNote" n="4" target="#Af_7-1.lnote.oe.4-2"/> be his wergilde, ⁊ þone gylt gebete, swa wer swa wite, swa he gewyrht age.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7.1" corresp="#wit-b-no-prol"><pb n="55" ed="#liebermann"/>Gyf he losige, ⁊ hine mon eft gefó, forgylde he hine sylfne be his wergylde, ⁊ þone gylt g<hi rend="italic">e</hi>béte, swa wér swa wite, swá he gewyrht<ptr type="liebermannNote" n="1" target="#Af_7-1.lnote.oe.1-4"/> age.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7.1" corresp="#wit-q"><pb n="55" ed="#liebermann"/>Si perdatur<ptr type="liebermannNote" n="1" target="#Af_7-1.lnote.oe.1-3"/> (aufugiat) et<ptr type="liebermannNote" n="2" target="#Af_7-1.lnote.oe.2-3"/> item<ptr type="liebermannNote" n="3" target="#Af_7-1.lnote.oe.3-3"/> aliquando capiatur, redimat se precio natiuitatis sue et culpam emendet sic<ptr type="liebermannNote" n="4" target="#Af_7-1.lnote.oe.4-3"/> wera sic wita, sicut egerit.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="68" ed="#attenborough"/>Gif he losige, ⁊ hine mon eft gefó, forgielde he hine self<ptr type="editorNote" n="7" target="#Af_7-1.attnote.fn.7"/> á<ptr type="editorNote" n="8" target="#Af_7-1.attnote.fn.8"/> be his weregilde, ⁊ ðone gylt gebete, swa wer swa wite, swa he gewyrht<ptr type="editorNote" n="9" target="#Af_7-1.attnote.fn.9"/> age.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="8.1" corresp="#wit-e"><pb n="300" ed="#jurasinski-and-oliver"/>Gif he losige, ⁊ hine mon eft gefó, forgielde he hine self á be his weregilde, ⁊ ðone gylt gebete, swa wer swa wite, swa he gewryht age.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="55" ed="#liebermann"/>Wenn er entkommt<ptr type="liebermannNote" n="1" target="#Af_7-1.lnote.de.1"/>, und man ihn nachher einfängt, darf er immer sich selbst durch sein Wergeld auslösen und büsse sein Verschulden, sowohl Wergeld<ptr type="liebermannNote" n="2" target="#Af_7-1.lnote.de.2"/> [des Erschlagenen] als Strafgeld, je wie er Verschuldung<ptr type="liebermannNote" n="3" target="#Af_7-1.lnote.de.3"/> trägt.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he escapes, and he is caught later, he may always redeem himself by his wergeld, and let him compensate for his offence, both wergeld [of the slain] and fine, according to the guilt he bears.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="69" ed="#attenborough"/>If he escapes and is subsequently arrested, he shall pay for himself by his wergeld in every case; and he shall pay compensation for the offence—both wergeld<ptr type="editorNote" n="1" target="#Af_7-1.attnote.n.1"/> and fine<ptr type="editorNote" n="2" target="#Af_7-1.attnote.n.2"/>—according to the nature of the outrage he has perpetrated.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="411" ed="#whitelock"/>If he escapes, and is afterwards captured, he shall always pay for himself with his wergild, and compensate for the crime, with wergild as with fine, according to what he has done.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="301" ed="#jurasinski-and-oliver"/>If he escapes and is caught afterwards, let him always pay for himself with his wergild, and recompense for that offense – either [with] wergild or fine – which he has committed.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_7-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">-gylde <hi rend="italic">Ld;</hi> -gyld <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gylde Ld; -gyld So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_7-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">sylfne <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sylfne So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_7-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_7-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">-gylde <hi rend="italic">So;</hi> wergyld <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gylde So; wergyld Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_7-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">were <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">were Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_7-1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_7-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_7-1.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_7-1.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur;</hi> ne <hi rend="italic">übergeschr., dahinter ein Buchstabe radirt</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure; ne written above, after it a letter erased</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_7-1.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">55</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> p. <hi rend="italic">K, nur</hi> au. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">only p. K, only au. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_7-1.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">55</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_7-1.lnote.oe.3-3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">55</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> iterum</seg><seg type="translation" xml:lang="en" source="#claude">read iterum</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_7-1.lnote.oe.4-3" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">55</biblScope></bibl><seg type="original" xml:lang="de">s. w. <hi rend="italic">fehlt Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. w. lacking in Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_7-1.lnote.oe.1-4" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">55</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> gewyrhte</seg><seg type="translation" xml:lang="en" source="#claude">altered to gewyrhte</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_7-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘verloren geht’ Q wörtlicher, also früher. — Durch Entwischen des Täters hört die Missetat auf, handhaft (<hi rend="italic">s. d. Gl</hi> 10) zu sein</seg><seg type="translation" xml:lang="en" source="#claude">‘is lost’ Q, more literal, therefore earlier. — Through the offender’s escape the misdeed ceases to be one caught in the act (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 10)</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_7-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">An des Erschlagenen Sippe, während des Täters Wergeld (<hi rend="italic">s. d. Gl</hi> 29. 30) dessen Leben auslöst</seg><seg type="translation" xml:lang="en" source="#claude">To the slain man’s kindred, while the offender’s wergild (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 29. 30) redeems his life</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_7-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Das Strafgeld erhält der König; es wechselt nach der Schwere der Bluttat und dem Worte des Gegners, also nach dem Eingeklagten. — Q denkt ans Partizip <hi rend="italic">geworht,</hi> aber <hi rend="italic">s. gewyrhto ahton</hi> ‘besassen Verdienste’ bei Toller</seg><seg type="translation" xml:lang="en" source="#claude">The fine goes to the king; it varies according to the gravity of the act of bloodshed and the opponent’s word, i.e. according to what is claimed in the suit. — Q thinks of the participle <hi rend="italic">geworht,</hi> but <hi rend="italic">see gewyrhto ahton</hi> ‘possessed merits’ in Toller</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_7-1.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">68</biblScope></bibl><label>self</label><seg type="original" xml:lang="en"><hi rend="italic">sylfne</hi>. B &amp; H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_7-1.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">68</biblScope></bibl><label>á</label><seg type="original" xml:lang="en">Schmid writes <hi rend="italic">selfa</hi>.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_7-1.attnote.fn.9" n="9" source="#attenborough"><bibl><biblScope unit="page">68</biblScope></bibl><label>gewyrht</label><seg type="original" xml:lang="en"><hi rend="italic">gewyrhte</hi>. B.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_7-1.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">195</biblScope></bibl><seg type="original" xml:lang="en">If a man is slain.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_7-1.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">195</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e.</hi> such a fine as he may have incurred by his original offence.</seg></note>
      </div>
