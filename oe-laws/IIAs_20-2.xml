      <div type="clause" n="20.2">
        <head><ref type="lawCode" target="law:IIAs">II As</ref> 20.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="20.2" corresp="#wit-h"><pb n="160" ed="#liebermann"/>Gif hwa þonne<ptr type="liebermannNote" n="3" target="#IIAs_20-2.lnote.oe.3"/> nylle<ptr type="liebermannNote" n="4" target="#IIAs_20-2.lnote.oe.4"/> ridan<ptr type="liebermannNote" n="11" target="#IIAs_20-2.lnote.oe.11"/> mid his geferan<ptr type="liebermannNote" n="12" target="#IIAs_20-2.lnote.oe.12"/>, gilde cynges oferhyrnesse.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="20.2" corresp="#wit-ld"><pb n="160" ed="#liebermann"/>Gif ðonne nelle hwa toridan mid his geferum, gylde cynges oferhyrnysse.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="20.2" corresp="#wit-ot"><pb n="160" ed="#liebermann"/>Gif þonne nelle hwa ge::dan mid his geferum, gelde cynges oferhiernesse.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="20.2" corresp="#wit-q"><pb n="161" ed="#liebermann"/>Si quis tunc nolit illuc<ptr type="liebermannNote" n="32" target="#IIAs_20-2.lnote.oe.32"/> ire cum sociis suis, emendet overhyrnessam<ptr type="liebermannNote" n="33" target="#IIAs_20-2.lnote.oe.33"/> regis.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="20.2" corresp="#wit-h"><pb n="136" ed="#attenborough"/>Gif hwa þonne nylle ridan<ptr type="editorNote" n="25" target="#IIAs_20-2.attnote.fn.25"/> mid his geferan<ptr type="editorNote" n="26" target="#IIAs_20-2.attnote.fn.26"/>, gilde cynges oferhyrnesse.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="161" ed="#liebermann"/>Wenn aber einer [dorthin] mit seinen Genossen nicht mitziehen will, zahle<ptr type="liebermannNote" n="1" target="#IIAs_20-2.lnote.de.1"/> er [Busse für] Ungehorsam<ptr type="liebermannNote" n="2" target="#IIAs_20-2.lnote.de.2"/> gegen den König.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">But if anyone will not ride [there] with his companions, let him pay [the fine for] disobedience to the king.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="137" ed="#attenborough"/>If anyone refuses to ride [on such a mission] with his companions, he shall pay the fine for insubordination to the king<ptr type="editorNote" n="1" target="#IIAs_20-2.attnote.n.1"/>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="421" ed="#whitelock"/>If, however, anyone will not ride with his fellows, he is to pay the fine for disobedience to the king.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IIIEm_2">III Em 2</ref>; <ref target="clause:IIIEg_7-2">III Eg 7.2</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_20-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">160</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_20-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">160</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_20-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">160</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">davor zwei Buchstaben radirt</hi></seg><seg type="translation" xml:lang="en" source="#claude">two letters erased before it</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_20-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">160</biblScope></bibl><seg type="original" xml:lang="de">ran <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">ran on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_20-2.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">161</biblScope></bibl><seg type="original" xml:lang="de">ire il. <hi rend="italic">TMHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">ire il. TMHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_20-2.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">161</biblScope></bibl><seg type="original" xml:lang="de">-hir- <hi rend="italic">R;</hi> -her- <hi rend="italic">M;</hi> -hernussam <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-hir- R; -her- M; -hernussam K</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_20-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">105</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Der gewöhnliche Weigerungsgrund zur Strafbeihilfe war Verwandtschaft; III Eg 7. Der Strafvollzug (<hi rend="italic">s. d. Gl</hi> 4) ist allgemeine Staatsbürgerpflicht. Die <hi rend="italic">geferan</hi> sind hier Gerichtsgenossen, Nachbarn</seg><seg type="translation" xml:lang="en" source="#claude">The usual ground for refusing to help in punishment was kinship; III Eg 7. The execution of punishment (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 4) is a general duty of the citizen. The <hi rend="italic">geferan</hi> here are fellow members of the court, neighbours</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_20-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">105</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">120 Schill.; <hi rend="italic">s. Gl</hi> Ungehorsam 23. — Nach III Em 2 erhält auch das Hundred 30 Schill. Strafgeld</seg><seg type="translation" xml:lang="en" source="#claude">120 shill.; see <hi rend="italic">Gl</hi> Ungehorsam 23. — According to III Em 2 the hundred also receives 30 shill. as fine</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIAs_20-2.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">208</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e</hi>. 120 shillings.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_20-2.attnote.fn.25" n="25" source="#attenborough"><bibl><biblScope unit="page">136</biblScope></bibl><label>ridan</label><seg type="original" xml:lang="en"><hi rend="italic">nelle toridan</hi>. Ld. <hi rend="italic">ge::dan</hi>. Ot.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_20-2.attnote.fn.26" n="26" source="#attenborough"><bibl><biblScope unit="page">136</biblScope></bibl><label>geferan</label><seg type="original" xml:lang="en"><hi rend="italic">geferum</hi>. Ld, Ot.</seg></note>
      </div>
    </body>
