      <div type="clause" n="70.16">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 70.16</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 70.16" corresp="#wit-lat"><pb n="589" ed="#liebermann"/>Mulieres<ptr type="liebermannNote" n="k" target="#Hn_70-16.lnote.oe.k"/> que fornicantur et partus suos extingunt<ptr type="liebermannNote" n="9*" target="#Hn_70-16.lnote.oe.9_"/> et eas<ptr type="liebermannNote" n="10" target="#Hn_70-16.lnote.oe.10"/> que secum agunt, ut utero conceptum excutiant<ptr type="liebermannNote" n="11" target="#Hn_70-16.lnote.oe.11"/>, antiqua<ptr type="liebermannNote" n="12" target="#Hn_70-16.lnote.oe.12"/> diffinicio usque ad exitum uite remouet<ptr type="liebermannNote" n="13" target="#Hn_70-16.lnote.oe.13"/> ab ecclesia.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 589 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-16.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Cummean</hi> VI 3 <hi rend="italic">steht ferner</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cummean VI 3 is more remote</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-16.lnote.oe.9_" n="9*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-16.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">eos qui <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">eos qui Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-16.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">excruciant <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">excruciant Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-16.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">-quam <hi rend="italic">Sc;</hi> -quam diffinicionem <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-quam Sc; -quam diffinicionem Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-16.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">-tur <hi rend="italic">K;</hi> -entur <hi rend="italic">Co Or Wi</hi> [<hi rend="italic">falsch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">-tur K; -entur Co Or Wi [wrong]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-16.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Abtreibung 1. Ps.-Theodor folgt Halitgar.—<hi rend="italic">excruciant</hi>{11}—70, 16a <hi rend="italic">diffinitus</hi>{14}—<hi rend="italic">peniteat</hi>{16}—70, 16b <hi rend="italic">suum</hi>{18} fehlt—70, 17 <hi rend="italic">diem</hi>—70, 18 Am Rande spät: <hi rend="italic">Nota, nullum heredem infra XV annos subire iudicium; quod heres in statu remaneat, quo antecessor eius ipsum reliquit</hi>.—<hi rend="italic">auct</hi>.{21}—<hi rend="italic">diebus</hi>{24} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Abtreibung 1. Ps.-Theodor follows Halitgar.—<hi rend="italic">excruciant</hi>{11}—70, 16a <hi rend="italic">diffinitus</hi>{14}—<hi rend="italic">peniteat</hi>{16}—70, 16b <hi rend="italic">suum</hi>{18} missing—70, 17 <hi rend="italic">diem</hi>—70, 18 in the margin, in a late hand: <hi rend="italic">Nota, nullum heredem infra XV annos subire iudicium; quod heres in statu remaneat, quo antecessor eius ipsum reliquit</hi>.—<hi rend="italic">auct</hi>.{21}—<hi rend="italic">diebus</hi>{24} Rs</seg></note>
