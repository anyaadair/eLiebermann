      <div type="clause" n="60">
        <head><ref type="lawCode" target="law:Af">Af</ref> 60</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="60" corresp="#wit-e"><pb n="82" ed="#liebermann"/>Gif se lytla finger bið<ptr type="liebermannNote" n="18" target="#Af_60.lnote.oe.18"/> ófaslegen<ptr type="liebermannNote" n="7" target="#Af_60.lnote.oe.7"/>, ðam<ptr type="liebermannNote" n="15" target="#Af_60.lnote.oe.15"/> sceal to bote VIIII<ptr type="liebermannNote" n="19" target="#Af_60.lnote.oe.19"/> scill., ⁊ an scill. his nægles, gif se<ptr type="liebermannNote" n="20" target="#Af_60.lnote.oe.20"/> sie ófaslegen.<ptr type="liebermannNote" n="7" target="#Af_60.lnote.oe.7"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="60" corresp="#wit-h"><pb n="82" ed="#liebermann"/>Gif se litla finger bið ofaslægen, ðæm<ptr type="liebermannNote" n="6" target="#Af_60.lnote.oe.6"/> scel<ptr type="liebermannNote" n="7" target="#Af_60.lnote.oe.7-2"/> to bote IX scll'; his nægles, gif se bið ofaslægen, I scll.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="60" corresp="#wit-b-no-prol"><pb n="82" ed="#liebermann"/>Gyf se lytle finger sy ofaslagen, ðam sceal to bote nigon scill', ⁊ an scill' his nægles, gyf he<ptr type="liebermannNote" n="3" target="#Af_60.lnote.oe.3"/> sy ofaslagen.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="60" corresp="#wit-q"><pb n="83" ed="#liebermann"/>Si minimus digitus amputetur, IX solid. emendetur<ptr type="liebermannNote" n="19" target="#Af_60.lnote.oe.19-2"/>; unguis eius I sol.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="88" ed="#attenborough"/>Gif se lytla<ptr type="editorNote" n="11" target="#Af_60.attnote.fn.11"/> finger bið<ptr type="editorNote" n="12" target="#Af_60.attnote.fn.12"/> ófaslegen, ðam sceal to bote VIIII scill., ⁊ an scill. his nægles, gif se<ptr type="editorNote" n="13" target="#Af_60.attnote.fn.13"/> sie<ptr type="editorNote" n="14" target="#Af_60.attnote.fn.14"/> ófaslegen.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="63" corresp="#wit-e"><pb n="356" ed="#jurasinski-and-oliver"/>Gif se lytla finger bið ófaslegen, ðam sceal to bote VIIII scill, ⁊ an scill his nægles, gif se sie ófaslegen.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="83" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_60.lnote.de.1"/> der kleine Finger<ptr type="liebermannNote" n="2" target="#Af_60.lnote.de.2"/> abgeschlagen ist, dafür gebührt<ptr type="liebermannNote" n="3" target="#Af_60.lnote.de.3"/> 9 Schill. zur Busse; und ein<ptr type="liebermannNote" n="2" target="#Af_60.lnote.de.2"/> Schilling<ptr type="liebermannNote" n="4" target="#Af_60.lnote.de.4"/> [die] seines Nagels, wenn der abgeschlagen ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the little finger is struck off, 9 shillings are due for it as compensation; and one shilling [that] for its nail, if that is struck off.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="89" ed="#attenborough"/>If the little finger is struck off, 9 shillings must be paid as compensation for it, and one shilling [must be paid as compensation for] the nail of the same, if it is struck off.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="357" ed="#jurasinski-and-oliver"/>If the little finger is struck off, for that 9 shillings shall be compensation, and one shilling for its nail, if it is struck off.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_11-2">Leis Wl 11.2</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_60.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_60.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">ofaslagen <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ofaslagen Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_60.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_60.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">nigon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">nigon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_60.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">hit sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hit sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_60.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">æ <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">æ on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_60.lnote.oe.7-2" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> sceal</seg><seg type="translation" xml:lang="en" source="#claude">altered to sceal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_60.lnote.oe.19-2" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_60.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geändert aus</hi> hit</seg><seg type="translation" xml:lang="en" source="#claude">altered from hit</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_60.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auricularis</hi> auch Hn 93, 19</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">auricularis</hi> also Hn 93, 19</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_60.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Beeinflusst durch Abt 54e</seg><seg type="translation" xml:lang="en" source="#claude">Influenced by Abt 54e</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_60.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">H’s Form <hi rend="italic">scel</hi> bei Cosijn <hi rend="italic">Altwests. Gram.</hi> II § 135, <hi rend="italic">scell</hi> Toller <hi rend="italic">Dict.</hi> 844b, Z. 10 <hi rend="italic">v. u.</hi></seg><seg type="translation" xml:lang="en" source="#claude">H’s form <hi rend="italic">scel</hi> in Cosijn <hi rend="italic">Altwests. Gram.</hi> II § 135, <hi rend="italic">scell</hi> Toller <hi rend="italic">Dict.</hi> 844b, l. 10 <hi rend="italic">from the bottom</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_60.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Inst. setzen irrig den Normann. Schilling, wie <hi rend="italic">u.</hi> 66, Leis Wl 11 den Mercischen</seg><seg type="translation" xml:lang="en" source="#claude">Inst. wrongly put the Norman shilling, as <hi rend="italic">below</hi> 66, Leis Wl 11 the Mercian</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_60.attnote.fn.11" n="11" source="#attenborough"><bibl><biblScope unit="page">88</biblScope></bibl><label>lytla</label><seg type="original" xml:lang="en"><hi rend="italic">lytle</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_60.attnote.fn.12" n="12" source="#attenborough"><bibl><biblScope unit="page">88</biblScope></bibl><label>bið</label><seg type="original" xml:lang="en"><hi rend="italic">sy</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_60.attnote.fn.13" n="13" source="#attenborough"><bibl><biblScope unit="page">88</biblScope></bibl><label>se</label><seg type="original" xml:lang="en"><hi rend="italic">gyf he</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_60.attnote.fn.14" n="14" source="#attenborough"><bibl><biblScope unit="page">88</biblScope></bibl><label>sie</label><seg type="original" xml:lang="en"><hi rend="italic">bið</hi>. H.</seg></note>
