  <text>
    <body>
      <div type="clause" n="43">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 43</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-i"><ptr type="liebermannNote" n="6" target="#LeisWl_43.lnote.oe.6"/><pb n="517" ed="#liebermann"/>E ne face [h]un<ptr type="liebermannNote" n="7" target="#LeisWl_43.lnote.oe.7"/> pleinte a rei<ptr type="liebermannNote" n="8" target="#LeisWl_43.lnote.oe.8"/>, d’ici que<ptr type="liebermannNote" n="9" target="#LeisWl_43.lnote.oe.9"/> l’un li seit defaili el hundred u el conté<ptr type="liebermannNote" n="10" target="#LeisWl_43.lnote.oe.10"/>.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="517" ed="#liebermann"/>Ne quis regi conqueratur, nisi ei hundredus uel comitatus defecerit. Nemo querelam ad regem deferat, nisi ei ius defecerit in hundredo uel in comitatu.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="43" corresp="#wit-i"><pb n="272" ed="#robertson"/>E ne face [h]un pleinte a rei d'ici que l'un li seit defaili el hundred u el conté.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="517" ed="#liebermann"/>43. Und niemand erhebe Klage beim König, bis man in der Hundertschaft oder in der Grafschaft<ptr type="liebermannNote" n="1" target="#LeisWl_43.lnote.de.1"/> ihm ermangelt<ptr type="liebermannNote" n="c" target="#LeisWl_43.lnote.de1.c"/> hat [Recht zu gewähren].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">43. And let no one bring a complaint before the king until one has failed him in the hundred or in the shire [to grant justice].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-i"><pb n="273" ed="#robertson"/>And no-one shall appeal to the king until he fails [to obtain justice] in the hundred or county courts.</ab>
        <note type="comparison" source="#liebermann" n="517"><ref target="clause:IICn_17">II Cn 17</ref>; <ref target="clause:WlArt_8-1">Wl art 8.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 17 | (vgl. Wl art. 8, 1)</note>
        <note type="editorial">Added October 2026 from Robertson pp. 272–273 (text and translation); Liebermann’s text and German translation added from Gesetze I p. 517, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_43.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">517</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">kein Absatz I</hi></seg><seg type="translation" xml:lang="en" source="#claude">no paragraph break I</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_43.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">517</biblScope></bibl><seg type="original" xml:lang="de">bun <hi rend="italic">Im;</hi> bon plainte <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">bun Im; bon plainte Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_43.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">517</biblScope></bibl><seg type="original" xml:lang="de">roi <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">roi Im</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_43.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">517</biblScope></bibl><seg type="original" xml:lang="de">qui <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_43.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">517</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht</hi> conte (<hi rend="italic">beim Grafen</hi>), <hi rend="italic">da</hi> el <hi rend="italic">vorhergeht</hi></seg><seg type="translation" xml:lang="en" source="#claude">not conte (at the count’s), since el precedes</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="LeisWl_43.lnote.de1.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">517</biblScope></bibl><seg type="original" xml:lang="de">defaillir: in Stich lassen, <hi rend="italic">nicht</hi> bis [Klage] fehlgeschlagen ist; <hi rend="italic"><hi rend="spaced">Wiederaufnahme</hi> eines Processes liegt nicht vor</hi></seg><seg type="translation" xml:lang="en" source="#claude">defaillir: leave in the lurch, not ‘until [the suit] has failed’; there is no question of the <hi rend="italic">reopening</hi> of a suit</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_43.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">292</biblScope></bibl><seg type="original" xml:lang="de">Dieser Zusatz ist (anders als in 44) hier sachlich richtig und vielleicht schon von Cnut mitgemeint; <hi rend="italic">s. Gl</hi> Grafschaftsgericht 5</seg><seg type="translation" xml:lang="en" source="#claude">This addition is here (unlike in 44) correct in substance and was perhaps already implied by Cnut; see <hi rend="italic">Gl</hi> Grafschaftsgericht 5</seg></note>
      </div>
    </body>
