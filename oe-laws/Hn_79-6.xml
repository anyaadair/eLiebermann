      <div type="clause" n="79.6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 79.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 79.6" corresp="#wit-lat"><pb n="595" ed="#liebermann"/>Matris et capitalis ecclesie griðbreche<ptr type="liebermannNote" n="43" target="#Hn_79-6.lnote.oe.43"/> est ad minus sicut<ptr type="liebermannNote" n="44" target="#Hn_79-6.lnote.oe.44"/> infraccio pacis regie<ptr type="liebermannNote" n="45" target="#Hn_79-6.lnote.oe.45"/>, id est V lib. in Anglorum lege; medie L<ptr type="liebermannNote" n="o" target="#Hn_79-6.lnote.oe.o"/> sol., que est wita regis, et adhuc minoris, ubi<ptr type="liebermannNote" n="46" target="#Hn_79-6.lnote.oe.46"/> parua parochia est<ptr type="liebermannNote" n="47" target="#Hn_79-6.lnote.oe.47"/>, et atrium tamen<ptr type="liebermannNote" n="48" target="#Hn_79-6.lnote.oe.48"/> sit, XXV<ptr type="liebermannNote" n="o" target="#Hn_79-6.lnote.oe.o"/> sol., et campestris capelle, ubi non sit atrium XII<ptr type="liebermannNote" n="o" target="#Hn_79-6.lnote.oe.o"/> sol. et<ptr type="liebermannNote" n="21" target="#Hn_79-6.lnote.oe.21"/> VI den.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 595 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-6.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">umgerechnet in Normannische Währung</hi></seg><seg type="translation" xml:lang="en" source="#claude">converted into Norman currency</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-6.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-6.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">gridb. <hi rend="italic">Sc;</hi> grindb. <hi rend="italic">Gi;</hi> grindeb. <hi rend="italic">K Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">gridb. Sc; grindb. Gi; grindeb. K Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-6.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">sicut — est <hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">sicut — est missing K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-6.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">regis <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">regis Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-6.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">ut <hi rend="italic">Sc Hg K</hi></seg><seg type="translation" xml:lang="en" source="#claude">ut Sc Hg K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-6.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">sit <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-6.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">transit <hi rend="italic">statt</hi> t. s. <hi rend="italic">K Co Or Gi;</hi> cum <hi rend="italic">Wh Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">transit instead of t. s. K Co Or Gi; cum Wh Wi</seg></note>
      </div>
