    <body>
      <div type="clause" n="2.6">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 2.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 2.6"><pb n="629" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_2-6.lnote.oe.erkl-clause"/>Item in festiuitatum<ptr type="liebermannNote" n="1" target="#ECf_2-6.lnote.la.1"/> celebrationibus<ptr type="liebermannNote" n="2" target="#ECf_2-6.lnote.la.2"/> sanctorum, quacumque<ptr type="liebermannNote" n="3" target="#ECf_2-6.lnote.la.3"/> fuerint in parochiis, ubi sunt ecclesie<ptr type="liebermannNote" n="4" target="#ECf_2-6.lnote.la.4"/> eorum.</ab>
        <note type="comparison" source="#liebermann" n="629"><label>printed alongside</label> <ref target="clause:ECfRetr_2-6">ECf retr 2.6</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 629 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann leaves the ECf column empty at 2, 6a: that sentence is only in ECf retr.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-6.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">-tate <hi rend="italic">Pl S;</hi> -tatibus <hi rend="italic">Hy;</hi> festis <hi rend="italic">Ad Do No</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tate Pl S; -tatibus Hy; festis Ad Do No</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-6.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">-nis <hi rend="italic">Pl;</hi> celebracioribus <hi rend="italic">Hy</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nis Pl; celebracioribus Hy</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-6.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">quic. <hi rend="italic">Hr;</hi> quec. <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">quic. Hr; quec. Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-6.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">eo. ec. <hi rend="italic">Ad Do No Ck</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo. ec. Ad Do No Ck</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Likewise at the celebrations of the feasts of the saints, wherever they may be in the parishes where their churches are.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-6.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">343</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Kirchenweihe 3.</seg><seg type="translation" xml:lang="en" source="#claude">Cf. Gl Kirchenweihe 3.</seg></note>
      </div>
    </body>
