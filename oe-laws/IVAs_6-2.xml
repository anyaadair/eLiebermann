      <div type="clause" n="6.2">
        <head><ref type="lawCode" target="law:IVAs">IV As</ref> 6.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6.2" corresp="#wit-q"><pb n="172" ed="#liebermann"/>Si<ptr type="liebermannNote" n="23" target="#IVAs_6-2.lnote.oe.23"/> episcopum<ptr type="liebermannNote" n="24" target="#IVAs_6-2.lnote.oe.24"/> uel comitem<ptr type="liebermannNote" n="***" target="#IVAs_6-2.lnote.oe.star3"/> uel abbatem uel aldermannum uel thainum<ptr type="liebermannNote" n="25" target="#IVAs_6-2.lnote.oe.25"/> requirat, habeat terminum tres noctes. Et querat quicquid<ptr type="liebermannNote" n="26" target="#IVAs_6-2.lnote.oe.26"/> querat, non<ptr type="liebermannNote" n="27" target="#IVAs_6-2.lnote.oe.27"/> habeat uitam diucius, si<ptr type="liebermannNote" n="28" target="#IVAs_6-2.lnote.oe.28"/> capiatur.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="6.2" corresp="#wit-q"><ptr type="editorNote" n="14" target="#IVAs_6-2.attnote.fn.14"/><pb n="148" ed="#attenborough"/>Si episcopum vel comitem vel abbatem vel aldermannum vel thainum requirat, habeat terminum tres noctes; et quærat quicquid<ptr type="editorNote" n="15" target="#IVAs_6-2.attnote.fn.15"/> quærat, non habeat vitam diucius, si capiatur.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="149" ed="#attenborough"/>And if he seeks a bishop<ptr type="editorNote" n="1" target="#IVAs_6-2.attnote.n.1"/> or a nobleman, an abbot or an <hi rend="italic">ealdorman</hi> or a thegn, he shall have a respite for three days. But let him seek whatever he may, he shall not be spared longer, if he is caught.</ab>
        <note type="comparison" source="#liebermann" n="172">Vor. S.</note>
        <note type="comparisonPrinted" source="#liebermann">ebd.</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Grith_5">Grið 5</ref></note>
        <note type="editorial">Latin only; no German translation in Liebermann. ‘uel comitem’ is probably originally a gloss on ‘aldermannum’ (Liebermann). Liebermann numbers the second sentence 6.2c. Old English in H (rows 849–851).</note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-2.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">K (danach Price, Schmid) stellt</hi> 6, 3 <hi rend="italic">vor</hi> 6, 2; <hi rend="italic">Co streicht</hi> § 6, 2, <hi rend="italic">der wie K gelautet hatte, und ändert</hi> 6, 3, <hi rend="italic">der auch ursprünglich K glich, nach T's Form</hi></seg><seg type="translation" xml:lang="en" source="#claude">K (followed by Price, Schmid) places 6, 3 before 6, 2; Co deletes § 6, 2, which had read as in K, and alters 6, 3, which also originally agreed with K, to T's form</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-2.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">e. uel <hi rend="italic">fehlt K; aber vgl.</hi> Grith 5</seg><seg type="translation" xml:lang="en" source="#claude">e. uel lacking in K; but cf. Grith 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-2.lnote.oe.star3" n="***" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">uel comitem <hi rend="italic">ursprünglich wohl Glosse zu</hi> aldermannum.</seg><seg type="translation" xml:lang="en" source="#claude">uel comitem probably originally a gloss on aldermannum.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-2.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">thayn. <hi rend="italic">KOr;</hi> tain. <hi rend="italic">RT</hi></seg><seg type="translation" xml:lang="en" source="#claude">thayn. KOr; tain. RT</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-2.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">OrRTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod OrRTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-2.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">ut supra <hi rend="italic">statt</hi> non — capiatur <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">ut supra instead of non — capiatur K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-2.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">sed capiat <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">sed capiat Or</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAs_6-2.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">210</biblScope></bibl><seg type="original" xml:lang="en">In the Anglo-Saxon fragment preserved in H the bishop shares with the king the privilege of granting a respite of 9 days. Liebermann suggests that this elevation of the bishop is due to the Rochester scribe’s desire to increase his bishop’s dignity.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_6-2.attnote.fn.14" n="14" source="#attenborough"><bibl><biblScope unit="page">148</biblScope></bibl><seg type="original" xml:lang="en">In K (followed by Price and Schmid) § 3 comes before § 2.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_6-2.attnote.fn.15" n="15" source="#attenborough"><bibl><biblScope unit="page">148</biblScope></bibl><label>quicquid</label><seg type="original" xml:lang="en"><hi rend="italic">quod</hi>. Or, R, T, M, Hk.</seg></note>
      </div>
    </body>
