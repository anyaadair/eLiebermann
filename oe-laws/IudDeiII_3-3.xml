      <div type="clause" n="3.3">
        <head><ref type="lawCode" target="law:IudDeiII">Iud Dei II</ref> 3.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei II 3.3" corresp="#wit-lat"><pb n="406" ed="#liebermann"/>tu, clementissime Pater, dominator omnipotens, presta, ut, si quis<ptr type="liebermannNote" n="60" target="#IudDeiII_3-3.lnote.oe.60"/> innocens de furto<ptr type="liebermannNote" n="61" target="#IudDeiII_3-3.lnote.oe.61"/> hoc<ptr type="liebermannNote" n="62" target="#IudDeiII_3-3.lnote.oe.62"/> — uel homicidio aut<ptr type="liebermannNote" n="63" target="#IudDeiII_3-3.lnote.oe.63"/> adulterio seu maleficio — in<ptr type="liebermannNote" n="64" target="#IudDeiII_3-3.lnote.oe.64"/> hoc ferrum feruens<ptr type="liebermannNote" n="65" target="#IudDeiII_3-3.lnote.oe.65"/> (uel<ptr type="liebermannNote" n="66" target="#IudDeiII_3-3.lnote.oe.66"/> in hanc aquam feruentem) miserit<ptr type="liebermannNote" n="67" target="#IudDeiII_3-3.lnote.oe.67"/> manum suam, salua<ptr type="liebermannNote" n="68" target="#IudDeiII_3-3.lnote.oe.68"/>, te pręstante Domino nostro, permaneat<ptr type="liebermannNote" n="69" target="#IudDeiII_3-3.lnote.oe.69"/>;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 406 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-3.lnote.oe.60" n="60" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">uel qui -tes <hi rend="italic">übergeschr. H;</hi> hęc qui -tes <hi rend="italic">übergeschr. Ci; in anderer Tinte übergeschr.</hi> [qu]a <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel qui -tes written above H; hęc qui -tes written above Ci; [qu]a written above in different ink Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-3.lnote.oe.61" n="61" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">furto—maleficio <hi rend="italic">am Rande;</hi> hoc cuius inquisitio agitur <hi rend="italic">im Texte H;</hi> hac re <hi rend="italic">statt</hi> fu.—maleficio <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">furto—maleficio in the margin; hoc cuius inquisitio agitur in the text H; hac re instead of fu.—maleficio Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-3.lnote.oe.62" n="62" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-3.lnote.oe.63" n="63" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-3.lnote.oe.64" n="64" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">hoc f. f. tetigerit uel <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">hoc f. f. tetigerit uel Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-3.lnote.oe.65" n="65" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">Quodsi aqua feruens est, dimisso prescripto, dicat: <hi rend="italic">vor</hi> uel <hi rend="italic">übergeschr. Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">Quodsi aqua feruens est, dimisso prescripto, dicat: written above before uel Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-3.lnote.oe.66" n="66" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">uel -feru. <hi rend="italic">fehlt Co Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel -feru. omitted in Co Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-3.lnote.oe.67" n="67" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">-nt -s -s <hi rend="italic">überschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nt -s -s written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-3.lnote.oe.68" n="68" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">-s (<hi rend="italic">so</hi>) <hi rend="italic">überschr. H;</hi> saluus <hi rend="italic">Ch;</hi> saluante <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-s (sic) written above H; saluus Ch; saluante Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_3-3.lnote.oe.69" n="69" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">-nt <hi rend="italic">übergeschr. H;</hi> -nt <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nt written above H; -nt Co</seg></note>
      </div>
