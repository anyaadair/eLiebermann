      <div type="clause" n="8.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 8.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 8.1"><pb n="632" ed="#liebermann"/><hi rend="spaced"><ptr type="liebermannNote" n="21" target="#ECfRetr_8-1.lnote.la.21"/>De <ptr type="liebermannNote" n="22" target="#ECfRetr_8-1.lnote.la.22"/>apibus et<ptr type="liebermannNote" n="23" target="#ECfRetr_8-1.lnote.la.23"/> de <hi rend="bold">aliis</hi><ptr type="liebermannNote" n="24" target="#ECfRetr_8-1.lnote.la.24"/> <hi rend="bold">multis</hi><ptr type="liebermannNote" n="25" target="#ECfRetr_8-1.lnote.la.25"/> <hi rend="bold">minutis decimis.</hi></hi> De apibus <hi rend="bold">uero</hi><ptr type="liebermannNote" n="26" target="#ECfRetr_8-1.lnote.la.26"/> <hi rend="bold">similiter decimum</hi><ptr type="liebermannNote" n="27" target="#ECfRetr_8-1.lnote.la.27"/> <hi rend="bold">commodi.</hi></ab>
        <note type="comparison" source="#liebermann" n="632"><label>printed alongside</label> <ref target="clause:ECf_8-1">ECf 8.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 632 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-1.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Überschr. fehlt Dc S</hi></seg><seg type="translation" xml:lang="en" source="#claude">heading lacking in Dc S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-1.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">ouibus et purcellis [<hi rend="italic">s.</hi> 7, 4] et <hi rend="italic">fügt Lb Va zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">Lb Va add ouibus et purcellis [see 7, 4] et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-1.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">et—dec. <hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">et—dec. lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-1.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">omnibus a. (<hi rend="italic">statt</hi> a. m.) <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">omnibus a. (instead of a. m.) Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-1.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">rebus <hi rend="italic">statt</hi> m. m. d. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">rebus instead of m. m. d. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-1.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">u. s. <hi rend="italic">fehlt Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. s. lacking in Dc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-1.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">X ā <hi rend="italic">Lb Va Sp K; fehlt Cb Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">X ā Lb Va Sp K; lacking in Cb Kn</seg></note>
