    <body>
      <div type="clause" n="42.3">
        <head><ref type="lawCode" target="law:Af">Af</ref> 42.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42.3" corresp="#wit-e"><pb n="76" ed="#liebermann"/>Gif he ðon<hi rend="italic">ne</hi> þæs mægenes ne hæbbe, þæt he hine inne besitte, ride to þam<ptr type="liebermannNote" n="5" target="#Af_42-3.lnote.oe.5"/> ealdormen, bidde hine fultumes; gif he him fultuman<ptr type="liebermannNote" n="6" target="#Af_42-3.lnote.oe.6"/> ne wille, ride to<ptr type="liebermannNote" n="7" target="#Af_42-3.lnote.oe.7"/> cyninge, ær he feohte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42.3" corresp="#wit-ot-frags"><pb n="76" ed="#liebermann"/>Gyf ... he hine inn..., ..hine ful....</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42.3" corresp="#wit-h"><pb n="76" ed="#liebermann"/>Gif he ðonne ðæs mægnes næbbe<ptr type="liebermannNote" n="4" target="#Af_42-3.lnote.oe.4"/>, ðæt he hine inne besitte<ptr type="liebermannNote" n="5" target="#Af_42-3.lnote.oe.5-2"/> mæge, ride to ðam ealdormen (⁊<ptr type="liebermannNote" n="6" target="#Af_42-3.lnote.oe.6-2"/>) bidde hine fultumes<ptr type="liebermannNote" n="7" target="#Af_42-3.lnote.oe.7-2"/>; gif he him fultoman<ptr type="liebermannNote" n="8" target="#Af_42-3.lnote.oe.8"/> nelle, ride to cyninge, ær he feohte.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="42.3" corresp="#wit-q"><pb n="77" ed="#liebermann"/>Si uim non habeat, ut eum intus obsideat<ptr type="liebermannNote" n="3" target="#Af_42-3.lnote.oe.3"/>, uadat ad aldremannum et querat auxilium. Si ei subuenire nolit, adeat regem, priusquam assalliat eum.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="84" ed="#attenborough"/>Gif he ðonne þæs mægenes ne hæbbe<ptr type="editorNote" n="1" target="#Af_42-3.attnote.fn.1"/>, þæt he hine inne besitte<ptr type="editorNote" n="2" target="#Af_42-3.attnote.fn.2"/>, ride to þam ealdormen, [⁊]<ptr type="editorNote" n="3" target="#Af_42-3.attnote.fn.3"/> bidde hine fultumes; gif he him fultuman ne wille<ptr type="editorNote" n="4" target="#Af_42-3.attnote.fn.4"/>, ride to cyninge, ær he feohte.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="44.3" corresp="#wit-e"><pb n="342" ed="#jurasinski-and-oliver"/>Gif he þon<hi rend="italic">ne</hi> þæs mægenes ne hæbbe, þæt he hine inne besette, ride to þam ealdormen, bidde hine fultumes; gif he him fultuman ne wille, ride to cyninge, ær he feohte.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="77" ed="#liebermann"/>Wenn er aber nicht dazu Macht hat, [nämlich] dass er ihn drinnen belagern kann, so ziehe<ptr type="liebermannNote" n="1" target="#Af_42-3.lnote.de.1"/> er zum Ealdorman (und) bitte den um Hilfe; wenn der ihm nicht helfen will, ziehe<ptr type="liebermannNote" n="1" target="#Af_42-3.lnote.de.1"/> er zum König<ptr type="liebermannNote" n="2" target="#Af_42-3.lnote.de.2"/> [um Hilfe], bevor er [in Rache] ficht.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">But if he does not have the power for it, [namely] to besiege him inside, let him ride to the ealdorman (and) ask him for help; if he will not help him, let him ride to the king [for help] before he fights [in vengeance].</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="85" ed="#attenborough"/>If, however, he has not power enough to besiege him in his house, he shall ride to the <hi rend="italic">ealdorman</hi> and ask him for help. If he will not help him, he shall ride to the king before having recourse to violence.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="416" ed="#whitelock"/>If he [the attacker] has not sufficient power to besiege him in his house, he is to ride to the ealdorman and ask him for support; if he will not give him support, he is to ride to the king, before having recourse to fighting.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="343" ed="#jurasinski-and-oliver"/>If he however does not have [sufficient] force that he may besiege him inside, let him ride to the ealdorman and ask him for support; if he is not willing to give him support, let him ride to the king before he attacks.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-3.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-3.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">-mian <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-mian Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-3.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">ðæm cyning <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm cyning Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-3.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de">te <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">te on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-3.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-3.lnote.oe.7-2" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zweites</hi> u <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">second u on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-3.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">76</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> -mian</seg><seg type="translation" xml:lang="en" source="#claude">altered to -mian</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_42-3.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">77</biblScope></bibl><seg type="original" xml:lang="de">-diat <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-diat K</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_42-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">60</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘reite’ Schmid zu eng; ‘bewege sich’</seg><seg type="translation" xml:lang="en" source="#claude">‘ride’ Schmid, too narrow; ‘move’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_42-3.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">60</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Instanzenzug 2. 5; Ealdorman 19b</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Instanzenzug 2. 5; Ealdorman 19b</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_42-3.attnote.fn.1" n="1" source="#attenborough"><bibl><biblScope unit="page">84</biblScope></bibl><label>hæbbe</label><seg type="original" xml:lang="en"><hi rend="italic">mægnes næbbe</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_42-3.attnote.fn.2" n="2" source="#attenborough"><bibl><biblScope unit="page">84</biblScope></bibl><label>besitte</label><seg type="original" xml:lang="en"><hi rend="italic">besitte mæge</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_42-3.attnote.fn.3" n="3" source="#attenborough"><bibl><biblScope unit="page">84</biblScope></bibl><label>⁊</label><seg type="original" xml:lang="en">H*.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_42-3.attnote.fn.4" n="4" source="#attenborough"><bibl><biblScope unit="page">84</biblScope></bibl><label>wille</label><seg type="original" xml:lang="en"><hi rend="italic">fultoman nelle</hi>. H.</seg></note>
      </div>
