      <div type="clause" n="61.17">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 61.17</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 61.17" corresp="#wit-lat"><pb n="582" ed="#liebermann"/>Quando<ptr type="liebermannNote" n="21" target="#Hn_61-17.lnote.oe.21"/> autem aliquis inplacitatur sine domino suo — nisi de illis sit<ptr type="liebermannNote" n="16" target="#Hn_61-17.lnote.oe.16"/> in quibus statim<ptr type="liebermannNote" n="h" target="#Hn_61-17.lnote.oe.h"/> oporteat<ptr type="liebermannNote" n="22" target="#Hn_61-17.lnote.oe.22"/> responderi, ut de furto, de<ptr type="liebermannNote" n="23" target="#Hn_61-17.lnote.oe.23"/> incendio, de murdro, de hamsocna<ptr type="liebermannNote" n="i" target="#Hn_61-17.lnote.oe.i"/> et<ptr type="liebermannNote" n="24" target="#Hn_61-17.lnote.oe.24"/> capitalibus —, terminum querat ac respectum, donec dominum<ptr type="liebermannNote" n="e" target="#Hn_61-17.lnote.oe.e"/> suum habeat secundum rectum; et interim<ptr type="liebermannNote" n="25" target="#Hn_61-17.lnote.oe.25"/>, si opus est, uadium<ptr type="liebermannNote" n="k" target="#Hn_61-17.lnote.oe.k"/> det et plegios mittat<ptr type="liebermannNote" n="l" target="#Hn_61-17.lnote.oe.l"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 582 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-17.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 52, 1<hi rend="italic">b</hi>. 61, 16 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 52, 1<hi rend="italic">b</hi>. 61, 16 <hi rend="italic">f.</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-17.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 46, 1<hi rend="italic">a</hi>; <hi rend="italic">Londoner Recht um</hi> 1170 (<hi rend="italic">ed. Bateson</hi> Engl. hist. rev. 1902, 708): roberia, pax fracta, raptus, felonia, membrum fractum, incendium, assaltus propensatus defendenda (<hi rend="italic">abzuleugnen</hi>) sunt ante consilium</seg><seg type="translation" xml:lang="en" source="#claude">cf. 46, 1<hi rend="italic">a</hi>; London law of c. 1170 (ed. Bateson Engl. hist. rev. 1902, 708): roberia, pax fracta, raptus, felonia, membrum fractum, incendium, assaltus propensatus defendenda (to be denied) sunt ante consilium</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-17.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">hamsocn <hi rend="italic">gehört zwar zur Kroncompetenz</hi> (10, 1), <hi rend="italic">ist aber mit 5 Pfund büssbar</hi> (12, 2). <hi rend="italic">Vermuthlich meint Hn hier ihre erschwerte Form</hi> (<hi rend="italic">vgl.</hi> 80, 11), <hi rend="italic">die er als</hi> husbreche <hi rend="italic">zu Capitalfällen zählt</hi> 12, 1. 47. 64, 2</seg><seg type="translation" xml:lang="en" source="#claude">hamsocn does indeed belong to the jurisdiction of the Crown (10, 1), but is emendable with 5 pounds (12, 2). Hn presumably means here its aggravated form (cf. 80, 11), which, as husbreche, he counts among capital cases 12, 1. 47. 64, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-17.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 52, 1<hi rend="italic">c</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 52, 1<hi rend="italic">c</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-17.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">stelle</seg><seg type="translation" xml:lang="en" source="#claude">provide</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-17.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">fit <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">fit Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-17.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">Quoniam <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">Quoniam Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-17.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">opp. <hi rend="italic">meist Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">opp. mostly Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-17.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Sc Hg;</hi> et de <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Sc Hg; et de Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-17.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">de <hi rend="italic">K Co;</hi> et de <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">de K Co; et de Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-17.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">iterum <hi rend="italic">Lond Edd.</hi> [<hi rend="italic">falsch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">iterum Lond edd. [wrong]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-17.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Kapitalverbrechen 7; Prozessualpfand 6. 9—61, 18b <hi rend="italic">f. s</hi>.{26}—61, 18c <hi rend="italic">-sito</hi>{33}.—Der Archetyp-Verderber meinte mit <hi rend="italic">societate</hi> wohl ‘gemeinschaftliche Missetat’</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Kapitalverbrechen 7; Prozessualpfand 6. 9—61, 18b <hi rend="italic">f. s</hi>.{26}—61, 18c <hi rend="italic">-sito</hi>{33}.—By <hi rend="italic">societate</hi> the corrupter of the archetype probably meant ‘joint misdeed’</seg></note>
      </div>
