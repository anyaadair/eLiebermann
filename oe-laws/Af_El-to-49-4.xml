      <div type="clause" n="El. 49.4">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 49.4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 49.4" corresp="#wit-e"><pb n="44" ed="#liebermann"/>Mid him we sendon Iudam ⁊ Silam, þæt<ptr type="liebermannNote" n="*" target="#Af_El-to-49-4.lnote.oe.star"/> eow<ptr type="liebermannNote" n="8" target="#Af_El-to-49-4.lnote.oe.8"/> þæt ilce<ptr type="liebermannNote" n="9" target="#Af_El-to-49-4.lnote.oe.9"/> seccgen.<ptr type="liebermannNote" n="10" target="#Af_El-to-49-4.lnote.oe.10"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 49.4" corresp="#wit-g-prol-only"><pb n="44" ed="#liebermann"/>Mid hym we sendað Iudam ⁊ Silam, þ<hi rend="italic">æt<ptr type="liebermannNote" n="1" target="#Af_El-to-49-4.lnote.oe.1-2"/></hi> eow þ<hi rend="italic">æt</hi> ilce secgað.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 49.4" corresp="#wit-h"><pb n="45" ed="#liebermann"/>Mid hi<hi rend="italic">m</hi> we sendon<ptr type="liebermannNote" n="9" target="#Af_El-to-49-4.lnote.oe.9-2"/> Iudam ond<ptr type="liebermannNote" n="1" target="#Af_El-to-49-4.lnote.oe.1"/> Silam, ðæt (hy<ptr type="liebermannNote" n="7" target="#Af_El-to-49-4.lnote.oe.7"/>) eow ðæt ilce secgan.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 49.4" corresp="#wit-q"><pb n="45" ed="#liebermann"/>Misimus etiam<ptr type="liebermannNote" n="3" target="#Af_El-to-49-4.lnote.oe.3"/> Iudam et Silam<ptr type="liebermannNote" n="4" target="#Af_El-to-49-4.lnote.oe.4"/>, qui et ipsi uobis uerba referent eadem.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 49.4" corresp="#wit-e"><pb n="268" ed="#jurasinski-and-oliver"/>Mid him we sendon Iudam ⁊ Silam, þæt eow þæt ilce secggen</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="45" ed="#liebermann"/>Mit ihnen sandten<ptr type="liebermannNote" n="1" target="#Af_El-to-49-4.lnote.de.1"/> wir Judas und Silas, damit sie euch dasselbe sagen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">With them we sent Judas and Silas, so that they may tell you the same.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="269" ed="#jurasinski-and-oliver"/>With them we sent Judas and Silas, that they might say the same to you.</ab>
        <note type="passageSource">Acts 15,27</note>
        <note type="comparison" source="#liebermann" n="45">A Apost. 15.27</note>
        <note type="comparisonPrinted" source="#liebermann">[15, 27]</note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-4.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">44</biblScope></bibl><seg type="original" xml:lang="de">hie <hi rend="italic">fügt zu So;</hi> hi <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hie added by So; hi Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-4.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">44</biblScope></bibl><seg type="original" xml:lang="de">eowe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">eowe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-4.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">44</biblScope></bibl><seg type="original" xml:lang="de">ylce <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ylce Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-4.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">44</biblScope></bibl><seg type="original" xml:lang="de">sæcgen <hi rend="italic">So;</hi> secgan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sæcgen So; secgan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-4.lnote.oe.9-2" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">45</biblScope></bibl><seg type="original" xml:lang="de">on <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">on written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-4.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">45</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-4.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">45</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-4.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">45</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Hk;</hi> ergo <hi rend="italic">Vulg.</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by Hk; ergo Vulg.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-4.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">45</biblScope></bibl><seg type="original" xml:lang="de">Syl. <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">Syl. Dm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-4.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">44</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">modern zugefügt:</hi> hy</seg><seg type="translation" xml:lang="en" source="#claude">added by a modern hand: hy</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-49-4.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">48</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘senden’ G, wo auch Ind. statt Opt. in folg. Z. Diesen Ind. in Absichtsätzen kennt Wülfing <hi rend="italic">Syntax</hi> II 156 auch sonst; <hi rend="italic">vgl. u.</hi> 49, 6⁴. Af’s Praet. übs. Vulg., hat nicht Praesens-Bed., wie Koerner (<hi rend="italic">Gram.</hi> 63, <hi rend="italic">Agsä. Texte</hi> 175) meint</seg><seg type="translation" xml:lang="en" source="#claude">‘send’ G, which also has the indic. instead of the opt. in the following line. Wülfing <hi rend="italic">Syntax</hi> II 156 knows this indic. in purpose clauses elsewhere too; <hi rend="italic">cf. below</hi> 49, 6⁴. Af’s preterite translates the Vulg. and does not have present meaning, as Koerner (<hi rend="italic">Gram.</hi> 63, <hi rend="italic">Agsä. Texte</hi> 175) thinks</seg></note>
      </div>
    </body>
  </text>
