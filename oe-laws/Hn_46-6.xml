    <body>
      <div type="clause" n="46.6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 46.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 46.6" corresp="#wit-lat"><pb n="571" ed="#liebermann"/>Sepe<ptr type="liebermannNote" n="a" target="#Hn_46-6.lnote.oe.a"/> enim fit, ut in sua causa quis minus<ptr type="liebermannNote" n="1" target="#Hn_46-6.lnote.oe.1"/> uideat quam in alterius; et<ptr type="liebermannNote" n="2" target="#Hn_46-6.lnote.oe.2"/> in ore alterius plerumque poterit emendari quod in suo<ptr type="liebermannNote" n="b" target="#Hn_46-6.lnote.oe.b"/> non liceret.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 571 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-6.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">Rarum ut sit idoneus rei suae quisque defensor <hi rend="italic">Quinctilian</hi> IV 1, 46</seg><seg type="translation" xml:lang="en" source="#claude">Rarum ut sit idoneus rei suae quisque defensor Quinctilian IV 1, 46</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-6.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Besserung des eigenen Wortes ist unzulässig; Brunner</hi> Forsch. z. Gesch. Dtsch. u. Franz. Rechts 374</seg><seg type="translation" xml:lang="en" source="#claude">amendment of one’s own words is not permitted; Brunner Forsch. z. Gesch. Dtsch. u. Franz. Rechts 374</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-6.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">mitius <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">mitius Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-6.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">et in o. a. <hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">et in o. a. lacking in Lond</seg></note>
      </div>
