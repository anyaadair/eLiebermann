        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 9.2"><pb n="633" ed="#liebermann"/>Et<ptr type="liebermannNote" n="31" target="#ECf_9-2.lnote.la.31"/> si placitum de<ptr type="liebermannNote" n="32" target="#ECf_9-2.lnote.la.32"/> hominibus aliorum baronum oritur in curiis suis<ptr type="liebermannNote" n="1" target="#ECf_9-2.lnote.la.1"/>, assit<ptr type="liebermannNote" n="33" target="#ECf_9-2.lnote.la.33"/> ad placitum iusticia<ptr type="liebermannNote" n="34" target="#ECf_9-2.lnote.la.34"/> regis, quoniam absque eo finiri non debet.</ab>
        <note type="comparison" source="#liebermann" n="633"><label>printed alongside</label> <ref target="clause:ECfRetr_9-2">ECf retr 9.2</ref></note>
