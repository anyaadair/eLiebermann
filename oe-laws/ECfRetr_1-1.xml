  <text>
    <body>
      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 1.1"><pb n="628" ed="#liebermann"/><hi rend="spaced">De<ptr type="liebermannNote" n="6" target="#ECfRetr_1-1.lnote.la.6"/> clericis et possessionibus eorum.</hi> Omnis clerus<ptr type="liebermannNote" n="7" target="#ECfRetr_1-1.lnote.la.7"/> et <hi rend="bold">etiam</hi><ptr type="liebermannNote" n="8" target="#ECfRetr_1-1.lnote.la.8"/> scholares<ptr type="liebermannNote" n="9" target="#ECfRetr_1-1.lnote.la.9"/> et omnes eorum<ptr type="liebermannNote" n="10" target="#ECfRetr_1-1.lnote.la.10"/> <hi rend="bold">res</hi><ptr type="liebermannNote" n="11" target="#ECfRetr_1-1.lnote.la.11"/> <hi rend="bold">et</hi> possessiones, ubicunque fuerint, pacem Dei et sancte ecclesie habeant.</ab>
        <note type="comparison" source="#liebermann" n="628"><label>printed alongside</label> <ref target="clause:ECf_1-1">ECf 1.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 628 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_1-1.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Überschriften roth Cb; nicht im Text wiederholt Ph; fehlen Kn Cc</hi></seg><seg type="translation" xml:lang="en" source="#claude">the headings in red Cb; not repeated in the text Ph; lacking in Kn Cc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_1-1.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">-ricus <hi rend="italic">Cb Hv Ph Ba Lond Kn Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ricus Cb Hv Ph Ba Lond Kn Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_1-1.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">omnes <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds omnes</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_1-1.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">-ris <hi rend="italic">Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ris Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_1-1.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">res et po. eor. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">res et po. eor. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_1-1.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">res et <hi rend="italic">fehlt Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">res et lacking in Co Or</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Of clerics and their possessions. Let all clergy and also scholars and all their goods and possessions, wherever they may be, have the peace of God and of holy Church.</ab>
      </div>
    </body>
