      <div type="clause" n="1">
        <head><ref type="lawCode" target="law:IudDeiXVI">Iud Dei XVI</ref> 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XVI 1" corresp="#wit-co"><pb n="427" ed="#liebermann"/>Post accusacionem<ptr type="liebermannNote" n="c" target="#IudDeiXVI_1.lnote.oe.c"/> legitime factam, et triduum<ptr type="liebermannNote" n="d" target="#IudDeiXVI_1.lnote.oe.d"/> in ieiuniis et oratione consummatum, sacerdos, uestibus sacris preter<ptr type="liebermannNote" n="1" target="#IudDeiXVI_1.lnote.oe.1"/> casulam indutus, ferrum ante altare positum forcipe<ptr type="liebermannNote" n="e" target="#IudDeiXVI_1.lnote.oe.e"/> accipiat</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 427 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXVI_1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">427</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o.</hi> I 2, 1ᵃ</seg><seg type="translation" xml:lang="en" source="#claude">See above I 2, 1ᵃ</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXVI_1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">427</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o.</hi> I 1</seg><seg type="translation" xml:lang="en" source="#claude">See above I 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXVI_1.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">427</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Abgebildet Zeumer Tab.</hi> 3</seg><seg type="translation" xml:lang="en" source="#claude">Illustrated in Zeumer Tab. 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXVI_1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">427</biblScope></bibl><seg type="original" xml:lang="de">excepta casula <hi rend="italic">Zeu.</hi> 650. 703, <hi rend="italic">dagegen</hi> et casula 678</seg><seg type="translation" xml:lang="en" source="#claude">excepta casula Zeu. 650. 703, but et casula 678</seg></note>
