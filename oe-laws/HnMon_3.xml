    <body>
      <div type="clause" n="3">
        <head><ref type="lawCode" target="law:HnMon">Hn mon</ref> 3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-sc"><pb n="523" ed="#liebermann"/>Preterea defendo<ptr type="liebermannNote" n="13" target="#HnMon_3.lnote.oe.13"/>, ne aliquis monetarius denarios<ptr type="liebermannNote" n="16" target="#HnMon_3.lnote.oe.16"/> mutet nisi in comitatu suo, et hoc coram duobus legittimis<ptr type="liebermannNote" n="17" target="#HnMon_3.lnote.oe.17"/> testibus de<ptr type="liebermannNote" n="18" target="#HnMon_3.lnote.oe.18"/> ipso comitatu.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="3" corresp="#wit-sc"><pb n="284" ed="#robertson"/>Praeterea defendo, ne aliquis monetarius denarios mutet, nisi in comitatu suo et hoc coram duobus legittimis testibus de ipso comitatu.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-sc"><pb n="285" ed="#robertson"/>In addition, I forbid any moneyer to recast money, except in his own county and in the presence of two lawful witnesses from the same county.</ab>
        <note type="editorial">Added October 2026 from Robertson pp. 284–285 (text and translation); Liebermann’s text added from Gesetze I p. 523, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="HnMon_3.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">523</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="HnMon_3.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">523</biblScope></bibl><seg type="original" xml:lang="de">-ium m. ubi in <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ium m. ubi in <hi rend="italic">K</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="HnMon_3.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">523</biblScope></bibl><seg type="original" xml:lang="de">t. l. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. l. <hi rend="italic">K</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="HnMon_3.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">523</biblScope></bibl><seg type="original" xml:lang="de">ab <hi rend="italic">Spelman</hi> [<hi rend="italic">falsch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">ab <hi rend="italic">Spelman</hi> [<hi rend="italic">wrong</hi>]</seg></note>
