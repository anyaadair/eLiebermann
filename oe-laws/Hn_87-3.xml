      <div type="clause" n="87.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 87.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 87.3" corresp="#wit-lat"><pb n="601" ed="#liebermann"/>Si quelibet arma politori uel emundatori commissa sint ad purgandum uel<ptr type="liebermannNote" n="36" target="#Hn_87-3.lnote.oe.36"/> cuilibet ad seruandum, et de subito arripiantur ad aliquid male agendum, iustum est<ptr type="liebermannNote" n="hh" target="#Hn_87-3.lnote.oe.hh"/>: cui absoluta<ptr type="liebermannNote" n="l" target="#Hn_87-3.lnote.oe.l"/> commissa sunt, absoluta<ptr type="liebermannNote" n="l" target="#Hn_87-3.lnote.oe.l"/> restituat, nisi forte custodiam eorum diffinitis<ptr type="liebermannNote" n="m" target="#Hn_87-3.lnote.oe.m"/> prelocucionibus abdicarat<ptr type="liebermannNote" n="37" target="#Hn_87-3.lnote.oe.37"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 601 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-3.lnote.oe.hh" n="hh" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">Folgendes</seg><seg type="translation" xml:lang="en" source="#claude">the following</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-3.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">rein von Blutschuld</seg><seg type="translation" xml:lang="en" source="#claude">free from blood-guilt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-3.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 59, 2<hi rend="italic">c</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 59, 2<hi rend="italic">c</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-3.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">seruandum <hi rend="italic">fügt ein, unterpunctirt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">seruandum inserted, dotted underneath for deletion, Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-3.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">-ret <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ret K Co</seg></note>
