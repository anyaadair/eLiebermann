      <div type="clause" n="13A">
        <head><ref type="lawCode" target="law:IudDeiVII">Iud Dei VII</ref> 13A</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei VII 13A" corresp="#wit-ci"><pb n="413–414" ed="#liebermann"/>Ic<ptr type="liebermannNote" n="d" target="#IudDeiVII_13A.lnote.oe.d"/> halsige þe (eow<ptr type="liebermannNote" n="1" target="#IudDeiVII_13A.lnote.oe.1"/>) þurh þæne Fæder ⁊ Sunu ⁊ þæne halegan Gast ⁊ þurh þine (eowre<ptr type="liebermannNote" n="1" target="#IudDeiVII_13A.lnote.oe.1-2"/>) cristennysse, þe þu underfenge (ge<ptr type="liebermannNote" n="1" target="#IudDeiVII_13A.lnote.oe.1-2"/> -gon), ⁊ þurh þæne ancennedan sunu Godes ⁊ þurh þa halegan Þrynnysse ⁊ þurh þ<hi rend="italic">æt</hi> halige Godes spell ⁊ þurh þa halgan láua, þe innan þisre cyricean synt, ⁊ þurh þæne fulluht, þe se mæssepreost þe (eow<ptr type="liebermannNote" n="1" target="#IudDeiVII_13A.lnote.oe.1-2"/>) of geedcende, þ<hi rend="italic">æt</hi> þu (ge<ptr type="liebermannNote" n="2" target="#IudDeiVII_13A.lnote.oe.2"/>) na geþristlæce (-læcon<ptr type="liebermannNote" n="2" target="#IudDeiVII_13A.lnote.oe.2"/>) natestohwí to þisu<hi rend="italic">m</hi> husle to ganne ne furþon<ptr type="liebermannNote" n="1" target="#IudDeiVII_13A.lnote.oe.1-2"/> to þisu<hi rend="italic">m</hi> weofude to genealæcenne, gif þu (ge<ptr type="liebermannNote" n="2" target="#IudDeiVII_13A.lnote.oe.2"/>) þis dydest (-don<ptr type="liebermannNote" n="2" target="#IudDeiVII_13A.lnote.oe.2"/>), þ<hi rend="italic">æt<ptr type="liebermannNote" n="3" target="#IudDeiVII_13A.lnote.oe.3"/></hi> we embe synt, oþþe gif þu (ge<ptr type="liebermannNote" n="2" target="#IudDeiVII_13A.lnote.oe.2"/>) þarto<ptr type="liebermannNote" n="4" target="#IudDeiVII_13A.lnote.oe.4"/> geþwærudest (-don<ptr type="liebermannNote" n="2" target="#IudDeiVII_13A.lnote.oe.2"/>) oþþe wistest (-ston<ptr type="liebermannNote" n="2" target="#IudDeiVII_13A.lnote.oe.2"/>), hwa (ua it<ptr type="liebermannNote" n="5" target="#IudDeiVII_13A.lnote.oe.5"/>) hyt dyde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei VII 13A" corresp="#wit-vt"><pb n="413–414" ed="#liebermann"/>Ic halsige þe (eow<ptr type="liebermannNote" n="8" target="#IudDeiVII_13A.lnote.oe.8"/>) þurh þone Fæder ⁊ þurh þone . . . ⁊ þurh þone haligan . . . ⁊ þurh þine cri . . ., . . þu underfenge (ge<ptr type="liebermannNote" n="8" target="#IudDeiVII_13A.lnote.oe.8"/> -on), ⁊ þurh þone ancenne . . . . . . des ⁊ þurh þa haligan . . . . se ⁊ þurh þ<hi rend="italic">æt</hi> halige Godes spell ⁊ þurh þa h . . . . . . ., þe innan þyssere cyrcean synt, ⁊ þu . . . . . fulluht, þe se mæssepreost þe of geedcende, þ<hi rend="italic">æt</hi> þu (ge<ptr type="liebermannNote" n="8" target="#IudDeiVII_13A.lnote.oe.8"/>) na geþristlæce (-on<ptr type="liebermannNote" n="1" target="#IudDeiVII_13A.lnote.oe.1-3"/>) natetohwig to þysum husle to ganne, ne furðon to þisu<hi rend="italic">m</hi> weofude na genealæce þu (ge<ptr type="liebermannNote" n="1" target="#IudDeiVII_13A.lnote.oe.1-4"/>), gif ge (þu<ptr type="liebermannNote" n="2" target="#IudDeiVII_13A.lnote.oe.2-2"/>) þis dydon (-de<ptr type="liebermannNote" n="2" target="#IudDeiVII_13A.lnote.oe.2-3"/>), þ<hi rend="italic">æt</hi> we embe synt, oððe gif þu (ge<ptr type="liebermannNote" n="1" target="#IudDeiVII_13A.lnote.oe.1-4"/>) wistes<ptr type="liebermannNote" n="2*" target="#IudDeiVII_13A.lnote.oe.2_"/> (-on<ptr type="liebermannNote" n="1" target="#IudDeiVII_13A.lnote.oe.1-4"/>), hwa hit dyde.<ptr type="liebermannNote" n="3" target="#IudDeiVII_13A.lnote.oe.3-2"/></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 413–414 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">413</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Latein. Original oben S.</hi> 401, <hi rend="italic">c.</hi> 2, 1; <hi rend="italic">ähnlich</hi> VI, <hi rend="italic">oben S.</hi> 412.</seg><seg type="translation" xml:lang="en" source="#claude">Latin original above p. 401, c. 2, 1; similar VI, above p. 412.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">413</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Plural übergeschr. Ci Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">plural written above Ci Vt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">413</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">in anderer Tinte übergeschrieben</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above in different ink</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">‘sogar’ nicht aus Latein</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘even’ not from the Latin</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">‘sogar’ nicht aus Latein</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘even’ not from the Latin</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">‘worüber wir [beschäftigt] sind’</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘about which we are [occupied]’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">‘worüber wir [beschäftigt] sind’</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘about which we are [occupied]’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">‘dazu beistimmtest’ nicht in Vt, obwohl aus Latein</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘consented thereto’ not in Vt, although from the Latin</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">in anderer Hand über</hi> hwa; <hi rend="italic">aber</hi> it <hi rend="italic">soll</hi> hyt <hi rend="italic">ersetzen</hi></seg><seg type="translation" xml:lang="en" source="#claude">in another hand above hwa; but it is meant to replace hyt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.1-4" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">in anderer Tinte übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above in different ink</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier Sing. über Plur.</hi></seg><seg type="translation" xml:lang="en" source="#claude">here sing. above pl.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.2_" n="2*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Sievers</hi> Gram. § 356¹</seg><seg type="translation" xml:lang="en" source="#claude">cf. Sievers Gram. § 356¹</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.3-3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt Lateinisch</hi> De reliquiis <hi rend="italic">Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">followed by the Latin De reliquiis Vt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_13A.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">für</hi> drihtnes <hi rend="italic">auch</hi> 23, 2 <hi rend="italic">A; Sievers</hi> § 196, 3</seg><seg type="translation" xml:lang="en" source="#claude">for drihtnes; also 23, 2 A; Sievers § 196, 3</seg></note>
      </div>
