        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 69.2" corresp="#wit-lat"><pb n="587" ed="#liebermann"/>De twyhindi<ptr type="liebermannNote" n="25" target="#Hn_69-2.lnote.oe.25"/> hominis wera debent reddi secundum legem XXX solidi ad manbotam, id<ptr type="liebermannNote" n="26" target="#Hn_69-2.lnote.oe.26"/> est hodie<ptr type="liebermannNote" n="n" target="#Hn_69-2.lnote.oe.n"/> V mance; de tƿelfhindo<ptr type="liebermannNote" n="27" target="#Hn_69-2.lnote.oe.27"/>, id est<ptr type="liebermannNote" n="o" target="#Hn_69-2.lnote.oe.o"/> thaino, CXX sol., qui<ptr type="liebermannNote" n="28" target="#Hn_69-2.lnote.oe.28"/> faciunt XX manc.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 587 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_69-2.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de">1 <hi rend="italic">sol.</hi> = 5 <hi rend="italic">den.</hi>; <hi rend="italic">wie</hi> 34, 3; <hi rend="italic">vgl.</hi> 76, 6<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">1 sol. = 5 den.; as 34, 3; cf. 76, 6a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_69-2.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 70, 1. 76, 4; <hi rend="italic">aus Af Rb.</hi> 31</seg><seg type="translation" xml:lang="en" source="#claude">as 70, 1. 76, 4; from Af Rb. 31</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_69-2.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de">thyᵗh. <hi rend="italic">Sc</hi>; tih. <hi rend="italic">K Co Or Sp</hi>; thythuiti <hi rend="italic">Wh</hi>; thithi. <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">thyᵗh. Sc; tih. K Co Or Sp; thythuiti Wh; thithi. Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_69-2.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">587</biblScope></bibl><seg type="original" xml:lang="de">idem h. V marce <hi rend="italic">K Co Or</hi>; idemue <hi rend="italic">Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">idem h. V marce K Co Or; idemue Gi</seg></note>
