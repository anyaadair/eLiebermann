      <div type="clause" n="Prol., 2">
        <head><ref type="lawCode" target="law:VAs">V As</ref> Prol., 2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Prol., 2" corresp="#wit-h"><pb n="166" ed="#liebermann"/>⁊ gif heo<ptr type="liebermannNote" n="11" target="#VAs_Prol-to-2.lnote.oe.11"/> man æfre eft on earde gemete, ðæt hy sýn swa scyldige<ptr type="liebermannNote" n="12" target="#VAs_Prol-to-2.lnote.oe.12-2"/>, swa se ðe æt hæbbendre handa gefongen<ptr type="liebermannNote" n="9" target="#VAs_Prol-to-2.lnote.oe.9"/> sy.<ptr type="liebermannNote" n="10" target="#VAs_Prol-to-2.lnote.oe.10"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Prol., 2" corresp="#wit-ld"><pb n="166" ed="#liebermann"/>And gif hi mon æfre eft on ðæm<ptr type="liebermannNote" n="1" target="#VAs_Prol-to-2.lnote.oe.1"/> eorda<ptr type="liebermannNote" n="1" target="#VAs_Prol-to-2.lnote.oe.1"/> gemitte, þ<hi rend="italic">æt</hi> hi syn swa scildig, swa se ðe æt hebbendra<ptr type="liebermannNote" n="1" target="#VAs_Prol-to-2.lnote.oe.1"/> handa gefongen syn.<ptr type="liebermannNote" n="1" target="#VAs_Prol-to-2.lnote.oe.1"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Prol., 2" corresp="#wit-q"><pb n="167" ed="#liebermann"/>Et si unquam amplius inibi<ptr type="liebermannNote" n="12" target="#VAs_Prol-to-2.lnote.oe.12"/> compareant, sint ita culpabiles, sicut qui furtum habens<ptr type="liebermannNote" n="13" target="#VAs_Prol-to-2.lnote.oe.13"/> in manibus capietur.<ptr type="liebermannNote" n="14" target="#VAs_Prol-to-2.lnote.oe.14"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="§2" corresp="#wit-h"><pb n="152" ed="#attenborough"/>⁊ gif heo man æfre eft on earde gemete<ptr type="editorNote" n="14" target="#VAs_Prol-to-2.attnote.fn.14"/>, ðæt hy sýn swa scyldige, swa se ðe æt hæbbendre<ptr type="editorNote" n="15" target="#VAs_Prol-to-2.attnote.fn.15"/> handa gefongen<ptr type="editorNote" n="10" target="#VAs_Prol-to-2.attnote.fn.10"/> sy.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="167" ed="#liebermann"/>Und wenn<ptr type="liebermannNote" n="1" target="#VAs_Prol-to-2.lnote.de.1"/> man sie je wieder in der Heimathgegend trifft, dass sie als so<ptr type="liebermannNote" n="2" target="#VAs_Prol-to-2.lnote.de.2"/> schuldbelastet gelten, wie wer auf handhafter That gefasst wird.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if they are ever met with again in the home country, that they be held as guilty as one who is caught in the act.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="153" ed="#attenborough"/>And if anyone ever meets them afterwards in their native district<ptr type="editorNote" n="1" target="#VAs_Prol-to-2.attnote.n.1"/>, they shall be liable to the same punishment as one who is taken in the act of thieving<ptr type="editorNote" n="2" target="#VAs_Prol-to-2.attnote.n.2"/>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="423" ed="#whitelock"/>And if they are ever met with in the district, that they are to be liable [to the same penalty] as he who is caught with stolen goods.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IVAs_3">IV As 3</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="VAs_Prol-to-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">167</biblScope></bibl><seg type="original" xml:lang="de">ibi <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">ibi Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VAs_Prol-to-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">167</biblScope></bibl><seg type="original" xml:lang="de">-nt <hi rend="italic">Lond;</hi> in m. h. <hi rend="italic">TMHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nt Lond; in m. h. TMHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VAs_Prol-to-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">167</biblScope></bibl><seg type="original" xml:lang="de">-entur <hi rend="italic">Lond;</hi> -iatur <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-entur Lond; -iatur MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VAs_Prol-to-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">166</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VAs_Prol-to-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">166</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VAs_Prol-to-2.lnote.oe.12-2" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">166</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> scyldig</seg><seg type="translation" xml:lang="en" source="#claude">altered scyldig</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VAs_Prol-to-2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">166</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VAs_Prol-to-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">166</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAs_Prol-to-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">108</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Diesen und folg. Paragraphen wiederholt IV 3—3, 2</seg><seg type="translation" xml:lang="en" source="#claude">IV 3—3, 2 repeats this and the following section</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAs_Prol-to-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">108</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Der der Verpflanzung Ungehorsame ist friedlos (<hi rend="italic">s. d. Gl</hi> 10 b), kann also straflos getötet werden, wie später der zurückkehrende Abschwörer (<hi rend="italic">s. d. Gl</hi> 3) des Reiches</seg><seg type="translation" xml:lang="en" source="#claude">The man who refuses to be removed is outlawed (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 10 b), and may therefore be killed with impunity, as later may the abjurer (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 3) of the realm who returns</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VAs_Prol-to-2.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">211</biblScope></bibl><seg type="original" xml:lang="en">Cf. IV As. cap. 3.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VAs_Prol-to-2.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">211</biblScope></bibl><seg type="original" xml:lang="en">Cf. Wiht. cap. 26; Ine, cap. 29; II As. cap. 11, etc.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="VAs_Prol-to-2.attnote.fn.10" n="10" source="#attenborough"><bibl><biblScope unit="page">152</biblScope></bibl><label>wille</label><seg type="original" xml:lang="en"><hi rend="italic">o</hi> altered to <hi rend="italic">a</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="VAs_Prol-to-2.attnote.fn.14" n="14" source="#attenborough"><bibl><biblScope unit="page">152</biblScope></bibl><label>gemete</label><seg type="original" xml:lang="en"><hi rend="italic">on ðæm eorda gemitte</hi>.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="VAs_Prol-to-2.attnote.fn.15" n="15" source="#attenborough"><bibl><biblScope unit="page">152</biblScope></bibl><label>hæbbendre</label><seg type="original" xml:lang="en"><hi rend="italic">hebbendra</hi>.</seg></note>
      </div>
    </body>
