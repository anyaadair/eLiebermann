    <body>
      <div type="clause" n="74">
        <head><ref type="lawCode" target="law:Af">Af</ref> 74</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="74" corresp="#wit-e"><pb n="86" ed="#liebermann"/>Gif hie<ptr type="liebermannNote" n="13" target="#Af_74.lnote.oe.13"/> mon inbeslea ⁊ mon ban ófado, geselle<ptr type="liebermannNote" n="2" target="#Af_74.lnote.oe.2"/> mon ðæs to bote XV<ptr type="liebermannNote" n="7" target="#Af_74.lnote.oe.7"/> scill.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="74" corresp="#wit-h"><pb n="86" ed="#liebermann"/>Gif hie<ptr type="liebermannNote" n="9" target="#Af_74.lnote.oe.9"/> mon<ptr type="liebermannNote" n="1" target="#Af_74.lnote.oe.1"/> inbeslea ⁊ mon<ptr type="liebermannNote" n="1" target="#Af_74.lnote.oe.1"/> bán ofadó, gesylle<ptr type="liebermannNote" n="2" target="#Af_74.lnote.oe.2-2"/> mon ðæs to bote XV scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="74" corresp="#wit-b-no-prol"><pb n="86" ed="#liebermann"/>Gyf hine mon inbesléa ⁊ man ban ofadó, gesylle mon ðæs to bote fiftyne scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="74" corresp="#wit-q"><pb n="87" ed="#liebermann"/>Si quis<ptr type="liebermannNote" n="9" target="#Af_74.lnote.oe.9-2"/> intro plagietur, ut os<ptr type="liebermannNote" n="10" target="#Af_74.lnote.oe.10"/> extrahatur<ptr type="liebermannNote" n="11" target="#Af_74.lnote.oe.11"/>, sit emenda<ptr type="liebermannNote" n="12" target="#Af_74.lnote.oe.12"/> XV sol.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="92" ed="#attenborough"/>Gif hie<ptr type="editorNote" n="3" target="#Af_74.attnote.fn.3"/> mon inbeslea ⁊ mon ban ófado, geselle mon ðæs to bote mid XV scill.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="77.1" corresp="#wit-e"><pb n="362" ed="#jurasinski-and-oliver"/>Gif hie mon inbeslea ⁊ mon ban ófado, geselle mon ðæs to bote XV scill.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="87" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_74.lnote.de.1"/> jemand in sie<ptr type="liebermannNote" n="2" target="#Af_74.lnote.de.2"/> hineinhaut<ptr type="liebermannNote" n="3" target="#Af_74.lnote.de.3"/> und er einen Knochen heraushaut<ptr type="liebermannNote" n="4" target="#Af_74.lnote.de.4"/>, zahle er zur Busse dessen 15 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone strikes into them and knocks out a bone, let him pay 15 shillings as compensation for it.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="93" ed="#attenborough"/>If anyone hacks into it [the shoulder], and a bone is removed<ptr type="editorNote" n="1" target="#Af_74.attnote.n.1"/>, 15 shillings shall be given as compensation for it [in addition to the above].</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="363" ed="#jurasinski-and-oliver"/>If one strikes into it and removes a bone [fragment], let him be paid for that 15 shillings as compensation.</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="363"><label>compare</label> <ref target="clause:Af_53">Af 53</ref> <quote>Presumably in addition to the fine for striking the shoulder; compare §§57, 72.</quote></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="363"><label>compare</label> <ref target="clause:Af_68">Af 68</ref> <quote>Presumably in addition to the fine for striking the shoulder; compare §§57, 72.</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_74.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">hi <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hi Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_74.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">gesylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gesylle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_74.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">fiftyne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fiftyne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_74.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> hine</seg><seg type="translation" xml:lang="en" source="#claude">altered to hine</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_74.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geändert in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_74.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">86</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_74.lnote.oe.9-2" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">87</biblScope></bibl><seg type="original" xml:lang="de">qui <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_74.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">87</biblScope></bibl><seg type="original" xml:lang="de">hos <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">hos Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_74.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">87</biblScope></bibl><seg type="original" xml:lang="de">-hat <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">-hat T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_74.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">87</biblScope></bibl><seg type="original" xml:lang="de">-datio <hi rend="italic">HkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-datio HkBr</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_74.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl.</hi> Gliederbussen 8H. 9a</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf.</hi> Gliederbussen 8H. 9a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_74.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘ihn’ H cor. B Q Inst.</seg><seg type="translation" xml:lang="en" source="#claude">‘him’ H cor. B Q Inst.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_74.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Das Kompositum nur hier; <hi rend="italic">vgl. inbestingan</hi></seg><seg type="translation" xml:lang="en" source="#claude">The compound occurs only here; <hi rend="italic">cf. inbestingan</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_74.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl.</hi> Af 70, 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf.</hi> Af 70, 1</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_74.attnote.fn.3" n="3" source="#attenborough"><bibl><biblScope unit="page">92</biblScope></bibl><label>hie</label><seg type="original" xml:lang="en"><hi rend="italic">hine</hi>. B.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_74.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">200</biblScope></bibl><seg type="original" xml:lang="en">Quadr. reads <hi rend="italic">Si quis intro plagietur, ut os extrahatur</hi>—the removal of the bone being the result of the wound; this is also, perhaps, the meaning of the original.</seg></note>
      </div>
