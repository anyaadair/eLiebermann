    <body>
      <div type="clause" n="11">
        <head><ref type="lawCode" target="law:Af">Af</ref> 11</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11" corresp="#wit-e"><pb n="56" ed="#liebermann"/>XII. Gif mon on cirliscre<ptr type="liebermannNote" n="9" target="#Af_11.lnote.oe.9"/> fæmnan breost gefó, mid V<ptr type="liebermannNote" n="10" target="#Af_11.lnote.oe.10"/> scill. hire gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11" corresp="#wit-h"><pb n="56" ed="#liebermann"/>XII. Gif mon<ptr type="liebermannNote" n="1" target="#Af_11.lnote.oe.1"/> on cyrliscre<ptr type="liebermannNote" n="4" target="#Af_11.lnote.oe.4"/> fæmnon<ptr type="liebermannNote" n="5" target="#Af_11.lnote.oe.5"/> breost gefó, mid V scll' hire gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11" corresp="#wit-b-no-prol"><pb n="57" ed="#liebermann"/>Eft: Gyf man on ceorliscne fæ<hi rend="italic">m</hi>nan breost gefó, mid fif scill' [hire<ptr type="liebermannNote" n="2" target="#Af_11.lnote.oe.2"/>] gebete.<ptr type="liebermannNote" n="3" target="#Af_11.lnote.oe.3"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="11" corresp="#wit-q"><pb n="57" ed="#liebermann"/>Si quis cyrliscre<ptr type="liebermannNote" n="10" target="#Af_11.lnote.oe.10-2"/> femine pectus apprehendat, quinque solidis emendetur ei.<ptr type="liebermannNote" n="11" target="#Af_11.lnote.oe.11"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="70" ed="#attenborough"/>Gif<ptr type="editorNote" n="6" target="#Af_11.attnote.fn.6"/> mon on cirliscre<ptr type="editorNote" n="7" target="#Af_11.attnote.fn.7"/> fæmnan breost gefó, mid V scill. hire gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="13" corresp="#wit-e"><pb n="306" ed="#jurasinski-and-oliver"/>{XII} Gif mon on cirliscre fæmnan breost gefó, mid V scill hire gebete.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="57" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_11.lnote.de.1"/> jemand an die Brust<ptr type="liebermannNote" n="2" target="#Af_11.lnote.de.2"/> einer gemeinfreien Jungfrau<ptr type="liebermannNote" n="3" target="#Af_11.lnote.de.3"/> fasst, büsse er ihr<ptr type="liebermannNote" n="4" target="#Af_11.lnote.de.4"/> mit 5 Schill.<ptr type="liebermannNote" n="5" target="#Af_11.lnote.de.5"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone seizes the breast of a common-free girl, let him pay her 5 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="71" ed="#attenborough"/>If anyone seizes by the breast a young woman belonging to the commons, he shall pay her 5 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="307" ed="#jurasinski-and-oliver"/>If a man seizes a <hi rend="italic">ceorl</hi>-woman on the breast, let him recompense her with 5 shillings.</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="307"><label>cf.</label> <ref target="clause:Af_9-1">Af 9.1</ref> <quote>Carole Hough, adducing §29 (in which a man who rapes a female slave must pay 5 shillings restitution plus the 60 shilling fine required by §11)</quote></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="307"><label>cf.</label> <ref target="clause:Af_18">Af 18</ref> <quote>Following §20, this occurs "without her permission"; the penalty is there doubled if the woman is a nun.</quote></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="307"><label>cf.</label> <ref target="clause:Af_25">Af 25</ref> <quote>Carole Hough, adducing §29 (in which a man who rapes a female slave must pay 5 shillings restitution plus the 60 shilling fine required by §11)</quote></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="253"><ref target="clause:Af_El-to-29">Af El 29</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="270"><ref target="clause:Af_18">Af 18</ref></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="311"><ref target="clause:Af_18">Af 18</ref></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="381"><ref target="clause:Ine_14">Ine 14</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">cyrl. <hi rend="italic">So;</hi> ceorliscne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyrl. So; ceorliscne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">fif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">56</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.,</hi> o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">written above, o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11.lnote.oe.10-2" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">57</biblScope></bibl><seg type="original" xml:lang="de">cirl. <hi rend="italic">T; später geänd.</hi> cyrlisce <hi rend="italic">R;</hi> cyrlisce <hi rend="italic">Hk;</hi> cirlisce <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">cirl. T; later altered to cyrlisce R; cyrlisce Hk; cirlisce Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">57</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">57</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. im</hi> 16. <hi rend="italic">Jh.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_11.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">57</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor</hi> 11, 1 <hi rend="italic">steht</hi> 11, 2 gyf he mid gehæmede, tyn scill' gebete <hi rend="italic">ausradirt und unterstrichen</hi></seg><seg type="translation" xml:lang="en" source="#claude">before 11, 1 stands 11, 2 gyf he mid gehæmede, tyn scill' gebete, erased and underlined</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_11.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘Ferner (Lat.: <hi rend="italic">Item</hi>)’ B Rb</seg><seg type="translation" xml:lang="en" source="#claude">‘Further (Lat.: <hi rend="italic">Item</hi>)’ B Rb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_11.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Versuch 2b; Notzucht 4—5; Jungfrau 6; ‘ohne ihre Erlaubnis’ im Parallelsatze 18, der sich hierauf beruft. Falls das Mädchen eingewilligt hätte, erhielte sie keine Busse</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Versuch 2b; Notzucht 4—5; Jungfrau 6; ‘without her permission’ in the parallel clause 18, which refers back to this one. Had the girl consented, she would receive no compensation</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_11.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘Ehefrau’, laut 11, 3</seg><seg type="translation" xml:lang="en" source="#claude">Not ‘wife’, according to 11, 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_11.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Sonst empfängt der Vormund die Unzuchtbusse oder der Herr</seg><seg type="translation" xml:lang="en" source="#claude">Otherwise the guardian or the lord receives the compensation for unchastity</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_11.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Doppelt so viel bei der Nonne; Af 18</seg><seg type="translation" xml:lang="en" source="#claude">Twice as much in the case of a nun; Af 18</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_11.attnote.fn.6" n="6" source="#attenborough"><bibl><biblScope unit="page">70</biblScope></bibl><label>Gif</label><seg type="original" xml:lang="en"><hi rend="italic">Eft gif</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_11.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">70</biblScope></bibl><label>cirliscre</label><seg type="original" xml:lang="en"><hi rend="italic">ceorliscne</hi>. B.</seg></note>
      </div>
