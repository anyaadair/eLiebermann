      <div type="clause" n="32.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 32.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 32.2" corresp="#wit-lat"><pb n="564" ed="#liebermann"/>Nemo<ptr type="liebermannNote" n="q" target="#Hn_32-2.lnote.oe.q"/> dominum suum iudicet uel iudicium proferat super eum cuius ligius<ptr type="liebermannNote" n="r" target="#Hn_32-2.lnote.oe.r"/> sit, si etiam de principis causa sit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 564 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_32-2.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">anders ausgedrückt</hi> 30</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">expressed differently</hi> 30</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_32-2.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 43, 6. 55, 2. 82, 5; Leis Wl 20, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 43, 6. 55, 2. 82, 5; Leis Wl 20, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_32-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Ligius 9; Urteilfinder 9.—32, 3 <hi rend="italic">ho. su</hi>.{22}—<hi rend="italic">infor[ti]are</hi>{24} ist zu lesen laut 29, 1c. 33, 1; streiche <hi rend="italic">informare</hi> 1 im Wb <hi rend="italic">o</hi>. II 124; <hi rend="italic">vgl</hi>. Ducange <hi rend="italic">renfortium</hi> und <hi rend="italic">ranforcier</hi> a. 1269 im Privileg für Dreux; <hi rend="italic">Layettes du trésor</hi> n. 5575</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Ligius 9; Urteilfinder 9.—32, 3 <hi rend="italic">ho. su</hi>.{22}—<hi rend="italic">infor[ti]are</hi>{24} should be read, according to 29, 1c. 33, 1; delete <hi rend="italic">informare</hi> 1 in the Wb <hi rend="italic">above</hi> II 124; <hi rend="italic">cf</hi>. Ducange <hi rend="italic">renfortium</hi>, and <hi rend="italic">ranforcier</hi> a. 1269 in the privilege for Dreux; <hi rend="italic">Layettes du trésor</hi> n. 5575</seg></note>
