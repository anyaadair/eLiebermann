      <div type="clause" n="5.2">
        <head><ref type="lawCode" target="law:Af">Af</ref> 5.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.2" corresp="#wit-e"><pb n="52" ed="#liebermann"/>Gewite ðære<ptr type="liebermannNote" n="10" target="#Af_5-2.lnote.oe.10"/> cirican<ptr type="liebermannNote" n="3" target="#Af_5-2.lnote.oe.3"/> ealdor, þæt<ptr type="liebermannNote" n="11" target="#Af_5-2.lnote.oe.11"/> him mon on þam<ptr type="liebermannNote" n="12" target="#Af_5-2.lnote.oe.12"/> fierste<ptr type="liebermannNote" n="13" target="#Af_5-2.lnote.oe.13"/> mete ne selle.<ptr type="liebermannNote" n="14" target="#Af_5-2.lnote.oe.14"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.2" corresp="#wit-h"><pb n="52" ed="#liebermann"/>Gewite þære cirican<ptr type="liebermannNote" n="6" target="#Af_5-2.lnote.oe.6"/> ealdor, ðæt him mon on þa<hi rend="italic">m</hi> fyrste mete<ptr type="liebermannNote" n="5" target="#Af_5-2.lnote.oe.5"/> ne sylle.<ptr type="liebermannNote" n="7" target="#Af_5-2.lnote.oe.7"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.2" corresp="#wit-b-no-prol"><pb n="53" ed="#liebermann"/>Gewite ðære ciricean ealdor, þ<hi rend="italic">æt</hi> him mon on fyrste mete ne sylle.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.2" corresp="#wit-q"><pb n="53" ed="#liebermann"/>Et caueat ipsius ecclesie senior, ne eum<ptr type="liebermannNote" n="4" target="#Af_5-2.lnote.oe.4"/> pascant<ptr type="liebermannNote" n="5" target="#Af_5-2.lnote.oe.5-2"/> interim.<ptr type="liebermannNote" n="6" target="#Af_5-2.lnote.oe.6-2"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="66" ed="#attenborough"/>Gewite ðære cirican ealdor, þæt him mon on þam fierste mete ne selle.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="5.2" corresp="#wit-e"><pb n="296" ed="#jurasinski-and-oliver"/>Gewite þære cirican ealdor, þæt him mon on þam fierste mete ne selle.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="53" ed="#liebermann"/>Es beobachte der Kirchenvorsteher<ptr type="liebermannNote" n="1" target="#Af_5-2.lnote.de.1"/>, dass jenem niemand in dieser Frist Speise<ptr type="liebermannNote" n="2" target="#Af_5-2.lnote.de.2"/> gebe.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Let the head of the church see to it that no one gives that man food during this term.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="67" ed="#attenborough"/>The chief authority of the church shall see to it, that during this time no food is given to him.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="411" ed="#whitelock"/>The head of that church is to take care that no one give him food during that period.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="297" ed="#jurasinski-and-oliver"/>Let the head of the church make sure that he is not given food during that period.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">þær <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">þær So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">cyr. <hi rend="italic">So;</hi> cyricean <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyr. So; cyricean Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt So</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">fyrste <hi rend="italic">So;</hi> fyrst <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fyrste So; fyrst Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">sylle <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sylle So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rasur vor</hi> an</seg><seg type="translation" xml:lang="en" source="#claude">erasure before an</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">53</biblScope></bibl><seg type="original" xml:lang="de">reum <hi rend="italic">R Hk T Or;</hi> int. r. pascat <hi rend="italic">Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">reum R Hk T Or; int. r. pascat Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-2.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">53</biblScope></bibl><seg type="original" xml:lang="de">i. p. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. p. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-2.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">53</biblScope></bibl><seg type="original" xml:lang="de">iterum <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">iterum Hk</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘Älteste’ Q, Schmid, unzutreffend; wie in Wi 17 meint Af vielmehr den (bisweilen laienhaften) Kirchenherrn (<hi rend="italic">s. d. Gl</hi> 1—5), wofür <hi rend="italic">hlaford</hi> mit <hi rend="italic">ealdor</hi> variiert</seg><seg type="translation" xml:lang="en" source="#claude">‘Elders’ Q, Schmid, wrongly; as in Wi 17, Af rather means the (sometimes lay) lord of the church (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1—5), for which <hi rend="italic">hlaford</hi> alternates with <hi rend="italic">ealdor</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o.</hi> Af 5⁸</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> Af 5⁸</seg></note>
      </div>
    </body>
