      <div type="clause" n="13.1">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 13.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 13.1" corresp="#wit-lat"><pb n="424" ed="#liebermann"/>Adiuro<ptr type="liebermannNote" n="3" target="#IudDeiXIII_13-1.lnote.oe.3"/> uos<ptr type="liebermannNote" n="4" target="#IudDeiXIII_13-1.lnote.oe.4"/>, homines N., per inuocationem domini nostri Iesu Christi et per<ptr type="liebermannNote" n="5" target="#IudDeiXIII_13-1.lnote.oe.5"/> iudicium aquę frigidę,</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 424 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">13, 1—8 <hi rend="italic">fast gleich Zeumer</hi> (665&lt;sub&gt;13&lt;/sub&gt; =) 695&lt;sub&gt;19&lt;/sub&gt;; <hi rend="italic">vereinzelt noch näher zu Co in</hi> XV; <hi rend="italic">Originaltext für</hi> VIII 2 <hi rend="italic">oben S.</hi> 415</seg><seg type="translation" xml:lang="en" source="#claude">13, 1—8 almost identical with Zeumer (665&lt;sub&gt;13&lt;/sub&gt; =) 695&lt;sub&gt;19&lt;/sub&gt;; in places even closer to Co in XV; original text for VIII 2 above p. 415</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">te homo <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">te homo Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_13-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Co</seg></note>
      </div>
