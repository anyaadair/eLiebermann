      <div type="clause" n="64.7">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 64.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 64.7" corresp="#wit-lat"><pb n="585" ed="#liebermann"/>Quando quis iurare debeat solus, quando<ptr type="liebermannNote" n="1" target="#Hn_64-7.lnote.oe.1"/> cum pluribus, in causa semper est<ptr type="liebermannNote" n="2" target="#Hn_64-7.lnote.oe.2"/> et persona iuxta legalitatem<ptr type="liebermannNote" n="a" target="#Hn_64-7.lnote.oe.a"/> et modum concausancium in omni ordine et iuxta pretium capitalis et<ptr type="liebermannNote" n="2" target="#Hn_64-7.lnote.oe.2"/> wite<ptr type="liebermannNote" n="3" target="#Hn_64-7.lnote.oe.3"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 585 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-7.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 64, 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. 64, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-7.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de">quandoque <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">quandoque Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-7.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-7.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de">wyt. <hi rend="italic">Lond meist</hi></seg><seg type="translation" xml:lang="en" source="#claude">wyt. Lond mostly</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-7.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl Gl</hi> Eidesschwere 1. 9—64, 8 <hi rend="italic">regalem</hi>{4}—<hi rend="italic">sui o</hi>.{5}—64, 8c <hi rend="italic">a</hi>{6} <hi rend="italic">s</hi>.—64, 9 <hi rend="italic">omnis</hi>{7} fehlt—<hi rend="italic">fuerit</hi> besser—versetze Gedankenstrich zw. <hi rend="italic">ordalium</hi> und <hi rend="italic">in h. s</hi>.—64, 9a <hi rend="italic">-dietur</hi>{14}—<hi rend="italic">lada</hi>{15} bis <hi rend="italic">triplex</hi> überspr.—65 <hi rend="italic">De</hi> fehlt—65, 3 <hi rend="italic">nil</hi>{22}—65, 4 <hi rend="italic">fregerit</hi>{30}—66 <hi rend="italic">-rorum</hi>{34}—66, 1 <hi rend="italic">ministrum</hi>{36} Rs, wie ich emendierte; so auch Stubbs <hi rend="italic">Lect</hi>. 164.—66, 2 Am Rande spät: <hi rend="italic">De ministris ecclesie occisoribus</hi>—66, 3 <hi rend="italic">aliquem</hi>{44} fehlt; daher missverstanden am Rande spät: <hi rend="italic">De clericis transgressoribus, qui tam per regem quam episcopum puniendi sunt</hi>—66, 4 <hi rend="italic">prof</hi>.{47}—66, 5 <hi rend="italic">laslith</hi>{48}—<hi rend="italic">Anglicis</hi>{50}—66, 6 <hi rend="italic">burblo</hi>.{51} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Eidesschwere 1. 9—64, 8 <hi rend="italic">regalem</hi>{4}—<hi rend="italic">sui o</hi>.{5}—64, 8c <hi rend="italic">a</hi>{6} <hi rend="italic">s</hi>.—64, 9 <hi rend="italic">omnis</hi>{7} missing—<hi rend="italic">fuerit</hi> better—move the dash to between <hi rend="italic">ordalium</hi> and <hi rend="italic">in h. s</hi>.—64, 9a <hi rend="italic">-dietur</hi>{14}—<hi rend="italic">lada</hi>{15} to <hi rend="italic">triplex</hi> skipped—65 <hi rend="italic">De</hi> missing—65, 3 <hi rend="italic">nil</hi>{22}—65, 4 <hi rend="italic">fregerit</hi>{30}—66 <hi rend="italic">-rorum</hi>{34}—66, 1 <hi rend="italic">ministrum</hi>{36} Rs, as I emended; so too Stubbs <hi rend="italic">Lect</hi>. 164.—66, 2 In the margin, in a late hand: <hi rend="italic">De ministris ecclesie occisoribus</hi>—66, 3 <hi rend="italic">aliquem</hi>{44} missing; hence misunderstood in the margin, in a late hand: <hi rend="italic">De clericis transgressoribus, qui tam per regem quam episcopum puniendi sunt</hi>—66, 4 <hi rend="italic">prof</hi>.{47}—66, 5 <hi rend="italic">laslith</hi>{48}—<hi rend="italic">Anglicis</hi>{50}—66, 6 <hi rend="italic">burblo</hi>.{51} Rs</seg></note>
