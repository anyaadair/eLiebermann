      <div type="clause" n="8.2a">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 8.2a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 8.2a"><pb n="632" ed="#liebermann"/>Et<ptr type="liebermannNote" n="33" target="#ECfRetr_8-2a.lnote.la.33"/> qui eam detinuerit, per iusticiam<ptr type="liebermannNote" n="34" target="#ECfRetr_8-2a.lnote.la.34"/> <hi rend="bold">episcopi</hi> et regis, si necesse fuerit, ad redditionem<ptr type="liebermannNote" n="35" target="#ECfRetr_8-2a.lnote.la.35"/> <hi rend="bold">arguatur.</hi></ab>
        <note type="comparison" source="#liebermann" n="632"><label>printed alongside</label> <ref target="clause:ECf_8-2a">ECf 8.2a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 632 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-2a.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lb Va Dc Ph Sp Kn K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lb Va Dc Ph Sp Kn K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-2a.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">-as <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-as K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-2a.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">solutionem <hi rend="italic">Hv K;</hi> arg. ad r. <hi rend="italic">Cc</hi></seg><seg type="translation" xml:lang="en" source="#claude">solutionem Hv K; arg. ad r. Cc</seg></note>
      </div>
