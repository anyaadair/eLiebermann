      <div type="clause" n="8.2">
        <head><ref type="lawCode" target="law:Af">Af</ref> 8.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8.2" corresp="#wit-e"><pb n="54" ed="#liebermann"/>Gif hio<ptr type="liebermannNote" n="15" target="#Af_8-2.lnote.oe.15"/> bearn gestriene<ptr type="liebermannNote" n="22" target="#Af_8-2.lnote.oe.22"/>, næbbe ðæt ðæs ierfes<ptr type="liebermannNote" n="23" target="#Af_8-2.lnote.oe.23"/> ðon<ptr type="liebermannNote" n="24" target="#Af_8-2.lnote.oe.24"/> mare ðe<ptr type="liebermannNote" n="25" target="#Af_8-2.lnote.oe.25"/> seo<ptr type="liebermannNote" n="26" target="#Af_8-2.lnote.oe.26"/> modor.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8.2" corresp="#wit-h"><pb n="54" ed="#liebermann"/>Gif heo<ptr type="liebermannNote" n="8" target="#Af_8-2.lnote.oe.8"/> bearn gestrine<ptr type="liebermannNote" n="10" target="#Af_8-2.lnote.oe.10"/>, nage þæt þes<ptr type="liebermannNote" n="11" target="#Af_8-2.lnote.oe.11"/> irfes ðe mare ðe seo modor.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8.2" corresp="#wit-b-no-prol"><pb n="55" ed="#liebermann"/>Gyf héo bearn gestryne, næbbe þ<hi rend="italic">æt</hi> þæs yrfes na mare þonne seo moder.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="8.2" corresp="#wit-q"><pb n="55" ed="#liebermann"/>Si<ptr type="liebermannNote" n="8" target="#Af_8-2.lnote.oe.8-2"/> infantem procreauerint, nichil inde habeat infans, sicut<ptr type="liebermannNote" n="9" target="#Af_8-2.lnote.oe.9"/> nec mater eius.<ptr type="liebermannNote" n="10" target="#Af_8-2.lnote.oe.10-2"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="68" ed="#attenborough"/>Gif hio bearn gestriene, næbbe ðæt ðæs ierfes ðon mare<ptr type="editorNote" n="15" target="#Af_8-2.attnote.fn.15"/> ðe seo modor.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="9.2" corresp="#wit-e"><pb n="302" ed="#jurasinski-and-oliver"/>Gif hio bearn gestriene, næbbe ðæt ðæs ierfes ðon mare ðe se modor.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="55" ed="#liebermann"/>Wenn sie Nachkommenschaft gebiert<ptr type="liebermannNote" n="1" target="#Af_8-2.lnote.de.1"/>, habe diese vom Erbe<ptr type="liebermannNote" n="2" target="#Af_8-2.lnote.de.2"/> nicht mehr als die Mutter.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If she bears offspring, let it have no more of the estate than the mother.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="69" ed="#attenborough"/>If she bears a child, it shall inherit no more of the property than its mother.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="411" ed="#whitelock"/>If she bears a child, it is not to have any of that inheritance, any more than the mother.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="303" ed="#jurasinski-and-oliver"/>If she produces a child, it does not have the inheritance any more than the mother.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">heo <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">heo Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-2.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">-stryne <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-stryne So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-2.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">yr. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">yr. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-2.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">þon<hi rend="italic">ne</hi> <hi rend="italic">So;</hi> na <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þon<hi rend="italic">ne</hi> So; na Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-2.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">þon<hi rend="italic">ne</hi> <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þon<hi rend="italic">ne</hi> So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-2.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">sio <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">sio So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rasur hinter</hi> i</seg><seg type="translation" xml:lang="en" source="#claude">erasure after i</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">am Rande</hi></seg><seg type="translation" xml:lang="en" source="#claude">in the margin</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-2.lnote.oe.8-2" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">55</biblScope></bibl><seg type="original" xml:lang="de">Si — infans <hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">Si — infans lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">55</biblScope></bibl><seg type="original" xml:lang="de">Set <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">Set K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_8-2.lnote.oe.10-2" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">55</biblScope></bibl><seg type="original" xml:lang="de">habeatur <hi rend="italic">fügt zu K</hi></seg><seg type="translation" xml:lang="en" source="#claude">habeatur added by K</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_8-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Das Verhältnis erscheint offenbar als dauernder Konkubinat (<hi rend="italic">s. d. Gl</hi> 4), obwohl 8, 1—3 offenbar von einer sogar ohne Dispens geraubten Nonne handeln</seg><seg type="translation" xml:lang="en" source="#claude">The relationship evidently appears as a permanent concubinage (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 4), although 8, 1—3 clearly deal with a nun abducted even without dispensation</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_8-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">53</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Wb: þe</hi> VI</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Wb: þe</hi> VI</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_8-2.attnote.fn.15" n="15" source="#attenborough"><bibl><biblScope unit="page">68</biblScope></bibl><label>mare</label><seg type="original" xml:lang="en"><hi rend="italic">nage…ðe mare ðe</hi>. H. <hi rend="italic">næbbe…na mare þonne</hi>. B.</seg></note>
      </div>
