      <div type="clause" n="8.1">
        <head><ref type="lawCode" target="law:QuadrII">Quadr II</ref> 8.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr II 8.1" corresp="#wit-lat"><ptr type="liebermannNote" n="13" target="#QuadrII_8-1.lnote.oe.13"/><pb n="545" ed="#liebermann"/>Post reditum<ptr type="liebermannNote" n="14" target="#QuadrII_8-1.lnote.oe.14"/> autem predictorum nuntiorum habitum est Londoniæ<ptr type="liebermannNote" n="15" target="#QuadrII_8-1.lnote.oe.15"/> famosum illud concilium: de archidiaconis et canonicis et presbyteris in uxoribus abiurandis; ne monachi uel presbyteri sint prepositi<ptr type="liebermannNote" n="g" target="#QuadrII_8-1.lnote.oe.g"/> laicorum; de superfluis crinibus et uestibus; ut occulta uota<ptr type="liebermannNote" n="h" target="#QuadrII_8-1.lnote.oe.h"/> pueri uel puellæ sint irrita; de Sodomitis publice<ptr type="liebermannNote" n="16" target="#QuadrII_8-1.lnote.oe.16"/> excommunicandis.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 545 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8-1.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de">quilibet clerici <hi rend="italic">sollten nicht Gutsvögte sein; Text bei Eadmer</hi> Nov. III; <hi rend="italic">ed. Rule p.</hi> 141</seg><seg type="translation" xml:lang="en" source="#claude">quilibet clerici were not to be estate stewards; text in Eadmer Nov. III; ed. Rule p. 141</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8-1.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de">fides de coniugio data <hi rend="italic">ebd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">fides de coniugio data ibid.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de">XIX. <hi rend="italic">roth am Rande Hk; Br</hi> 1000 <hi rend="italic">zieht den Quadr. hier nur aus</hi></seg><seg type="translation" xml:lang="en" source="#claude">XIX. in red in the margin Hk; Br 1000 merely excerpts the Quadr. here</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de">reddi. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">reddi. T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de">Lund. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Lund. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de">publicæ <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">publicæ MHk</seg></note>
