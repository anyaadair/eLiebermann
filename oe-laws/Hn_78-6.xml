      <div type="clause" n="78.6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 78.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 78.6" corresp="#wit-lat"><pb n="595" ed="#liebermann"/>Si quis a natiuitate surdus et mutus sit<ptr type="liebermannNote" n="18" target="#Hn_78-6.lnote.oe.18"/>, ut sua uel alterius nequeat irrogata<ptr type="liebermannNote" n="19" target="#Hn_78-6.lnote.oe.19"/> confiteri, emendet<ptr type="liebermannNote" n="20" target="#Hn_78-6.lnote.oe.20"/> pater eius<ptr type="liebermannNote" n="21" target="#Hn_78-6.lnote.oe.21"/> forisfacta sua.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 595 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-6.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">et eiusdem maleficos <hi rend="italic">fügt zu aus</hi> 78, 7 <hi rend="italic">Sc, aber darüber</hi> vacat</seg><seg type="translation" xml:lang="en" source="#claude">et eiusdem maleficos added from 78, 7 Sc, but vacat written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-6.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Hg;</hi> nrog. <hi rend="italic">Sc;</hi> interrog. <hi rend="italic">Or Tho</hi> [<hi rend="italic">falsch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">thus Hg; nrog. Sc; interrog. Or Tho [wrong]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-6.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">-dat <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dat Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-6.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K Co</seg></note>
