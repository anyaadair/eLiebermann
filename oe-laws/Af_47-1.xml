    <body>
      <div type="clause" n="47.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 47.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47.1" corresp="#wit-e"><pb n="80" ed="#liebermann"/>Gif hit in ðam heafde<ptr type="liebermannNote" n="9" target="#Af_47-1.lnote.oe.9"/> sie, ⁊ he noht<ptr type="liebermannNote" n="10" target="#Af_47-1.lnote.oe.10"/> geseon ne mæge mid, stande<ptr type="liebermannNote" n="11" target="#Af_47-1.lnote.oe.11"/> ðriddan dæl þære bote inne.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47.1" corresp="#wit-h"><pb n="80" ed="#liebermann"/>Gif hit on ðam heafde sy<ptr type="liebermannNote" n="1" target="#Af_47-1.lnote.oe.1"/>, ⁊ he noht geseon ne<ptr type="liebermannNote" n="6" target="#Af_47-1.lnote.oe.6"/> mæge mid, stonde<ptr type="liebermannNote" n="4" target="#Af_47-1.lnote.oe.4"/> (se<ptr type="liebermannNote" n="6" target="#Af_47-1.lnote.oe.6"/>) þriddan dæl þære bote inne.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47.1" corresp="#wit-b-no-prol"><pb n="80" ed="#liebermann"/>Gyf hit in ðan heafde sy, ⁊ he noht geseon ne mæge míd, stande ðriddan<ptr type="liebermannNote" n="2" target="#Af_47-1.lnote.oe.2"/> dæl ðære bote inne.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="47.1" corresp="#wit-q"><pb n="81" ed="#liebermann"/>Si oculus in<ptr type="liebermannNote" n="6" target="#Af_47-1.lnote.oe.6-2"/> capite remaneat, nec<ptr type="liebermannNote" n="7" target="#Af_47-1.lnote.oe.7"/> tamen inde uideat, remaneat<ptr type="liebermannNote" n="8" target="#Af_47-1.lnote.oe.8"/> tercia pars emendationis.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="86" ed="#attenborough"/>Gif hit in<ptr type="editorNote" n="8" target="#Af_47-1.attnote.fn.8"/> ðam<ptr type="editorNote" n="9" target="#Af_47-1.attnote.fn.9"/> heafde sie, ⁊ he noht geseon ne mæge mid, stande ðriddan<ptr type="editorNote" n="10" target="#Af_47-1.attnote.fn.10"/> dæl þære bote inne.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="50.1" corresp="#wit-e"><pb n="352" ed="#jurasinski-and-oliver"/>Gif hit in ðam heafde sie, ⁊ he noht geseon ne mæge mid, stande ðriddan dæl þære bote inne.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="81" ed="#liebermann"/>Wenn es [noch] im<ptr type="liebermannNote" n="1" target="#Af_47-1.lnote.de.1"/> Kopfe<ptr type="liebermannNote" n="2" target="#Af_47-1.lnote.de.2"/> ist, jener [Verletzte] jedoch nichts damit sehen kann, bleibe der<ptr type="liebermannNote" n="3" target="#Af_47-1.lnote.de.3"/> dritte Theil der Busse einbehalten.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If it is [still] in the head, but that [injured man] can see nothing with it, let a third of the compensation be withheld.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="87" ed="#attenborough"/>If it remains in the head, but he can see nothing with it, one-third of the compensation shall be withheld.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="353" ed="#jurasinski-and-oliver"/>If it remains in the head, but he may not see anything with it, let a third part of the compensation be withheld.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_19-1">Leis Wl 19.1</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_47-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">hæfde sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hæfde sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_47-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">nocht <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">nocht Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_47-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">stand ð. dæle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">stand ð. dæle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_47-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_47-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_47-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_47-1.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">in c. <hi rend="italic">fehlt Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">in c. lacking in Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_47-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">nec — remaneat <hi rend="italic">überspringt R</hi></seg><seg type="translation" xml:lang="en" source="#claude">nec — remaneat omitted by R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_47-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">in eo consistat <hi rend="italic">Hn</hi> 93, 5</seg><seg type="translation" xml:lang="en" source="#claude">in eo consistat Hn 93, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_47-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">driddan <hi rend="italic">B</hi></seg><seg type="translation" xml:lang="en" source="#claude">driddan B</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_47-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">H modernisiert</seg><seg type="translation" xml:lang="en" source="#claude">H modernizes</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_47-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Auge 2d. e</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Auge 2d. e</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_47-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Accus. statt Nom. Anakoluth wie Af 43. 71; H cor. setzt Artikel im Nom. davor. — Inst., mindestens Einer Rezension, missverstehen, nur ¹/₃ bleibe zu büssen</seg><seg type="translation" xml:lang="en" source="#claude">Accus. instead of nom.; anacoluthon as in Af 43. 71; H cor. puts the article in the nom. in front. — Inst., in at least one recension, misunderstand this to mean that only ¹/₃ remains to be compensated</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_47-1.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">86</biblScope></bibl><label>in</label><seg type="original" xml:lang="en"><hi rend="italic">on</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_47-1.attnote.fn.9" n="9" source="#attenborough"><bibl><biblScope unit="page">86</biblScope></bibl><label>ðam</label><seg type="original" xml:lang="en"><hi rend="italic">ðan</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_47-1.attnote.fn.10" n="10" source="#attenborough"><bibl><biblScope unit="page">86</biblScope></bibl><label>ðriddan</label><seg type="original" xml:lang="en"><hi rend="italic">(se) þriddan</hi>. H*.</seg></note>
      </div>
