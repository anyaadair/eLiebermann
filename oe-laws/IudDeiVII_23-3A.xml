      <div type="clause" n="23.3A">
        <head><ref type="lawCode" target="law:IudDeiVII">Iud Dei VII</ref> 23.3A</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei VII 23.3A" corresp="#wit-ci"><pb n="414" ed="#liebermann"/>gyf þu (ge<ptr type="liebermannNote" n="4" target="#IudDeiVII_23-3A.lnote.oe.4"/>) scyldig si (-dige<ptr type="liebermannNote" n="4" target="#IudDeiVII_23-3A.lnote.oe.4-2"/> sin), þænne ahnexa þu (ahnexige<ptr type="liebermannNote" n="4" target="#IudDeiVII_23-3A.lnote.oe.4-2"/> ge) þine (eowre<ptr type="liebermannNote" n="4" target="#IudDeiVII_23-3A.lnote.oe.4-2"/>) heortan ⁊ geandet (-detað<ptr type="liebermannNote" n="4" target="#IudDeiVII_23-3A.lnote.oe.4-2"/>), swa hwætt swa þu (ge<ptr type="liebermannNote" n="4" target="#IudDeiVII_23-3A.lnote.oe.4-2"/>) þar onwite<ptr type="liebermannNote" n="14" target="#IudDeiVII_23-3A.lnote.oe.14"/> (-ton<ptr type="liebermannNote" n="4" target="#IudDeiVII_23-3A.lnote.oe.4-2"/>).</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 414 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-3A.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">‘dazu beistimmtest’ nicht in Vt, obwohl aus Latein</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘consented thereto’ not in Vt, although from the Latin</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-3A.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiVII_23-3A.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">414</biblScope></bibl><seg type="original" xml:lang="de">owite, n <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">owite, n written above</seg></note>
