    <body>
      <div type="clause" n="33.1a">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 33.1a</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="33.1a" corresp="#wit-g-a"><pb n="336" ed="#liebermann"/>And gif hine hwa forene<ptr type="liebermannNote" n="17" target="#IICn_33-1a.lnote.oe.17"/> forstande, beon<ptr type="liebermannNote" n="18" target="#IICn_33-1a.lnote.oe.18"/> hi begen anes rihtes wyrðe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="33.1a" corresp="#wit-b"><pb n="336" ed="#liebermann"/>⁊ gyf híne hwá forstande, beo<ptr type="liebermannNote" n="6" target="#IICn_33-1a.lnote.oe.6"/> hig begen anes rihtes wyrðe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="33.1a" corresp="#wit-a"><pb n="336" ed="#liebermann"/>And gif hine hwa fora forstande, beo<ptr type="liebermannNote" n="2" target="#IICn_33-1a.lnote.oe.2"/> hig begen anes rihtes wyrðe.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="33.1a" corresp="#wit-q"><pb n="337" ed="#liebermann"/>Si quis<ptr type="liebermannNote" n="15" target="#IICn_33-1a.lnote.oe.15"/> eum defendere presumat, sint ambo unius recti digni.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="33.1a" corresp="#wit-inst-cn"><pb n="337" ed="#liebermann"/>Quod si forte<ptr type="liebermannNote" n="9" target="#IICn_33-1a.lnote.oe.9"/> aliquis eum ui<ptr type="liebermannNote" n="10" target="#IICn_33-1a.lnote.oe.10"/> defendere uoluerit, habeat eandem legem.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="33.1a" corresp="#wit-cons-cn"><pb n="337" ed="#liebermann"/>Quodsi quisquam obstiterit, uterque eidem iuri subiaceat.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="33.1a" corresp="#wit-b"><pb n="192" ed="#robertson"/>⁊ gyf híne hwá forstande<ptr type="editorNote" n="12" target="#IICn_33-1a.robnote.fn.12"/>, beo hig begen anes rihtes wyrðe.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="274" ed="#rabin-doml"/>And gif hine hwa forene forstande, beon hi begen anes rihtes wyrðe.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="337" ed="#liebermann"/>Und wenn jemand ihn [gewaltsam] vertheidigt<ptr type="liebermannNote" n="1" target="#IICn_33-1a.lnote.de.1"/>, seien<ptr type="liebermannNote" n="2" target="#IICn_33-1a.lnote.de.2"/> sie beide gleicher Rechtsstrafe theilhaftig.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if anyone defends him [by force], let them both be subject to the same legal penalty.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="193" ed="#robertson"/>And if anyone interposes in his defence, they shall both incur the same punishment.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="467" ed="#whitelock"/>And if anyone offers resistance on his account, they are both to share the same penalty.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="275" ed="#rabin-doml"/>And if anyone intervenes on his behalf, they shall both suffer the same justice.</ab>
        <note type="comparison" source="#liebermann" n="337"><ref target="clause:IAtr_4-2">I Atr 4.2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. I Atr. 4, 2</note>
        <note type="editorial">Liebermann compares I Atr 4.2.; BR: added from Gesetze I p. 337, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">forene: omitted B; fora A</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_33-1a.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">eiusdem <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">eiusdem Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_33-1a.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_33-1a.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">q. e. <hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">q. e. omitted Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_33-1a.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de">fora <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fora Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_33-1a.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de">beo hig <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">beo hig Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_33-1a.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">336</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_33-1a.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de">a. f. <hi rend="italic">Cb; fehlt Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. f. Cb; omitted Lb S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_33-1a.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">337</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_33-1a.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">207</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Zu <hi rend="italic">fora</hi> in A <hi rend="italic">vgl</hi>. die häufigen Endungen -<hi rend="italic">a</hi> statt des normalen -<hi rend="italic">e</hi> in Deklination und Konjugation; z. B. im <hi rend="italic">Wb</hi>: <hi rend="italic">geara</hi>, <hi rend="italic">rihla</hi>, <hi rend="italic">smeaga</hi></seg><seg type="translation" xml:lang="en" source="#claude">On <hi rend="italic">fora</hi> in A <hi rend="italic">cf.</hi> the frequent endings -<hi rend="italic">a</hi> instead of the normal -<hi rend="italic">e</hi> in declension and conjugation; e.g. in the <hi rend="italic">Wb</hi>: <hi rend="italic">geara</hi>, <hi rend="italic">rihla</hi>, <hi rend="italic">smeaga</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_33-1a.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">207</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">beo</hi> statt <hi rend="italic">beon</hi> in BA kann mittelengl. sein</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">beo</hi> for <hi rend="italic">beon</hi> in BA may be Middle English</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_33-1a.robnote.fn.12" n="12" source="#robertson"><bibl><biblScope unit="page">192</biblScope></bibl><label>forstande</label><seg type="original" xml:lang="en"><hi rend="italic">forene f.</hi> G; <hi rend="italic">fora f.</hi> A, Ld.</seg></note>
      </div>
    </body>
