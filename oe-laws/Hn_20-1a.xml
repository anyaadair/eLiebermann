    <body>
      <div type="clause" n="20.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 20.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 20.1a" corresp="#wit-lat"><pb n="560" ed="#liebermann"/>Omnis<ptr type="liebermannNote" n="e" target="#Hn_20-1a.lnote.oe.e"/> enim<ptr type="liebermannNote" n="12" target="#Hn_20-1a.lnote.oe.12"/> socna<ptr type="liebermannNote" n="1" target="#Hn_20-1a.lnote.oe.1"/> simplex est habentibus aut coniuncta, in custodia uero trina<ptr type="liebermannNote" n="13" target="#Hn_20-1a.lnote.oe.13"/> principalitate<ptr type="liebermannNote" n="14" target="#Hn_20-1a.lnote.oe.14"/> distincta: sub prepositis maneriorum in<ptr type="liebermannNote" n="f" target="#Hn_20-1a.lnote.oe.f"/> iis<ptr type="liebermannNote" n="15" target="#Hn_20-1a.lnote.oe.15"/> adiacentibus halimotis<ptr type="liebermannNote" n="16" target="#Hn_20-1a.lnote.oe.16"/>; sub prelatis<ptr type="liebermannNote" n="17" target="#Hn_20-1a.lnote.oe.17"/> hundretorum et burgorum; sub uicecomitibus.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 560 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1a.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 9, 1<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">as 9, 1<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1a.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">in den diesen [Manors] zugehörigen Herrschaftshallen-Gerichten</seg><seg type="translation" xml:lang="en" source="#claude">in the lords' hall-courts belonging to these [manors]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1a.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">sokn. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sokn. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1a.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">autem <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">autem Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1a.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. vom Corr. Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above by the corrector in Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1a.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vom Corr. geänd. in</hi> -liter <hi rend="italic">Sc;</hi> -liter <hi rend="italic">übr., Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">altered by the corrector to -liter Sc; -liter the rest, Edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1a.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> in us̄ <hi rend="italic">Sc;</hi> in usum <hi rend="italic">Hg;</hi> minus <hi rend="italic">Wh;</hi> causis [<hi rend="italic">vgl.</hi> 20, 2] <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">altered to in us̄ Sc; in usum Hg; minus Wh; causis [cf. 20, 2] the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1a.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">halem. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">halem. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1a.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">prepositis <hi rend="italic">Wi, nicht Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">prepositis Wi, not MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">319</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">custodia</hi>: ‘finanzielle Ausnützung für den Gerichtsherrn’ im Ggs. zur ‘richterlichen Abhaltung, Präsidierung’; <hi rend="italic">vgl. Gl</hi> Gericht 11b E ff.; Vogt 12c. 19b; Sheriff 16—<hi rend="italic">principaliter</hi>{14}—<hi rend="italic">causis</hi>{15} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">custodia</hi>: ‘financial exploitation for the lord of the court’, in contrast to ‘judicial holding, presiding’; <hi rend="italic">cf. Gl</hi> Gericht 11b E ff.; Vogt 12c. 19b; Sheriff 16—<hi rend="italic">principaliter</hi>{14}—<hi rend="italic">causis</hi>{15} Rs</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">For every soke is either single or joint for those who have it, but in its keeping it is divided into a threefold primacy: under the reeves of manors, in the hallmoots belonging to them; under the heads of hundreds and boroughs; under the sheriffs.</ab>
      </div>
    </body>
