      <div type="clause" n="III 44">
        <head><ref type="lawCode" target="law:InCn">In Cn</ref> III 44</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="In Cn III 44" corresp="#wit-lat"><pb n="613" ed="#liebermann"/><hi rend="small">Sacramentum liberalis<ptr type="liebermannNote" n="i" target="#InCn_III-44.lnote.oe.i-2"/></hi><ptr type="liebermannNote" n="i" target="#InCn_III-44.lnote.oe.i"/><hi rend="small"> hominis, <hi rend="spaced">quem</hi></hi><ptr type="liebermannNote" n="25" target="#InCn_III-44.lnote.oe.25"/><hi rend="small"><hi rend="spaced"> quidem</hi></hi><ptr type="liebermannNote" n="26" target="#InCn_III-44.lnote.oe.26"/><hi rend="small"><hi rend="spaced"> Angli</hi></hi><ptr type="liebermannNote" n="27" target="#InCn_III-44.lnote.oe.27"/><hi rend="small"><hi rend="spaced"> uocant</hi></hi><ptr type="liebermannNote" n="28" target="#InCn_III-44.lnote.oe.28"/><hi rend="small"> tƿelfhende</hi><ptr type="liebermannNote" n="29" target="#InCn_III-44.lnote.oe.29"/> <seg type="recension"><hi rend="small">(man</hi><ptr type="liebermannNote" n="30" target="#InCn_III-44.lnote.oe.30"/><hi rend="small">)</hi></seg><hi rend="small">, <hi rend="spaced">debet stare et</hi> ualere iuramentum sex</hi><ptr type="liebermannNote" n="31" target="#InCn_III-44.lnote.oe.31"/><hi rend="small"> uillanorum, quia</hi><ptr type="liebermannNote" n="32" target="#InCn_III-44.lnote.oe.32"/><hi rend="small"> prętium eius est</hi><ptr type="liebermannNote" n="33" target="#InCn_III-44.lnote.oe.33"/><hi rend="small">, id est ƿeregeld<ptr type="liebermannNote" n="k" target="#InCn_III-44.lnote.oe.k-2"/></hi><ptr type="liebermannNote" n="k" target="#InCn_III-44.lnote.oe.k"/><ptr type="liebermannNote" n="34" target="#InCn_III-44.lnote.oe.34"/><hi rend="small">, sex</hi><ptr type="liebermannNote" n="35" target="#InCn_III-44.lnote.oe.35"/><hi rend="small"> uillanorum.</hi></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 613 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">überfrei, adlig <hi rend="italic">auch S.</hi> 621&lt;sup&gt;a&lt;/sup&gt;. 624&lt;sup&gt;m&lt;/sup&gt;; <hi rend="italic">schon Cnuts Urkunden setzen</hi> þegn <hi rend="italic">und</hi> twelfhynde <hi rend="italic">synonym</hi></seg><seg type="translation" xml:lang="en" source="#claude">more than free, noble, also p. 621&lt;sup&gt;a&lt;/sup&gt;. 624&lt;sup&gt;m&lt;/sup&gt;; Cnut’s charters already use þegn and twelfhynde as synonyms</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">endet Di und Ip Hunt, nämlich Lb Rc S Pl Ct Jo Va;</hi> Expliciunt (-cit <hi rend="italic">Pl</hi>) hic institutiones (-ucio <hi rend="italic">Pl;</hi> const. <hi rend="italic">Jo</hi>) Cnuti regis <hi rend="italic">fügen zu Pl S Jo Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">Di ends here, as does Ip Hunt, i.e. Lb Rc S Pl Ct Jo Va; Expliciunt (-cit Pl) hic institutiones (-ucio Pl; const. Jo) Cnuti regis added by Pl S Jo Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt T</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">quidam <hi rend="italic">Cb; fehlt Lb Pl S Ct Jo Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">quidam Cb; missing in Lb Pl S Ct Jo Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Cb S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">dicunt <hi rend="italic">Lb Pl S Jo Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">dicunt Lb Pl S Jo Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">-hænde <hi rend="italic">H Di Rl;</hi> thel. <hi rend="italic">Va;</hi> chel. <hi rend="italic">Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-hænde H Di Rl; thel. Va; chel. Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">VII <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">VII Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">S;</hi> quia—uillanorum <hi rend="italic">fehlt Cb T</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod S; quia—uillanorum missing in Cb T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ct Jo</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Ct Jo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Rl;</hi> wer. <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Rl; wer. H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">s. u. <hi rend="italic">aus H Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. u. from H Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.i-2" n="i" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">332</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Thegn 1i; Adel 1f. g; <hi rend="italic">Wb: liber(alis, -alitas)</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Thegn 1i; Adel 1f. g; <hi rend="italic">Wb: liber(alis, -alitas)</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-44.lnote.oe.k-2" n="k" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">332</biblScope></bibl><seg type="original" xml:lang="de">Kein Verfasserwechsel; <hi rend="italic">s. o</hi>. Einl. 4</seg><seg type="translation" xml:lang="en" source="#claude">No change of author; <hi rend="italic">see above</hi> Introduction 4</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat"><hi rend="small">The oath of a noble, <hi rend="spaced">whom</hi><hi rend="spaced"> indeed</hi><hi rend="spaced"> the English</hi><hi rend="spaced"> call</hi> <hi rend="italic">tƿelfhende</hi></hi> <seg type="recension"><hi rend="small">(man)</hi></seg><hi rend="small">, <hi rend="spaced">ought to stand and</hi> be worth the oath of six villeins, because his price, that is <hi rend="italic">ƿeregeld</hi> [wergeld], is [that] of six villeins.</hi></ab>
      </div>
    </body>
  </text>
