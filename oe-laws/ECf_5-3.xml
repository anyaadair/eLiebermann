      <div type="clause" n="5.3">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 5.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 5.3"><pb n="630" ed="#liebermann"/>Si autem<ptr type="liebermannNote" n="35" target="#ECf_5-3.lnote.la.35"/> hoc egerit<ptr type="liebermannNote" n="36" target="#ECf_5-3.lnote.la.36"/> sepius et forte<ptr type="liebermannNote" n="17" target="#ECf_5-3.lnote.la.17"/> fortuitu ad<ptr type="liebermannNote" n="37" target="#ECf_5-3.lnote.la.37"/> ecclesiam sic<ptr type="liebermannNote" n="38" target="#ECf_5-3.lnote.la.38"/> sepius confugerit<ptr type="liebermannNote" n="39" target="#ECf_5-3.lnote.la.39"/>, ablatione<ptr type="liebermannNote" n="40" target="#ECf_5-3.lnote.la.40"/> reddita, prouinciam<ptr type="liebermannNote" n="g" target="#ECf_5-3.lnote.la.fn.g"/> forisiuret<ptr type="liebermannNote" n="41" target="#ECf_5-3.lnote.la.41"/> nec redeat<ptr type="liebermannNote" n="42" target="#ECf_5-3.lnote.la.42"/>.</ab>
        <note type="comparison" source="#liebermann" n="630"><label>printed alongside</label> <ref target="clause:ECfRetr_5-3">ECf retr 5.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 630 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “forisiuret” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5-3.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">Grafschaft; <hi rend="italic">vgl.</hi> 9. 31. <hi rend="italic">Zum Abschwören vgl. u.</hi> 18b. 18, 2</seg><seg type="translation" xml:lang="en" source="#claude">shire; cf. 9. 31. On abjuring cf. below, 18b. 18, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5-3.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5-3.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">s. e. <hi rend="italic">Hk Cl S Do No</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. e. Hk Cl S Do No</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5-3.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5-3.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">sic ad e. sepe <hi rend="italic">Hk;</hi> ad e. <hi rend="italic">fehlt S</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic ad e. sepe Hk; ad e. lacking in S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5-3.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">Dei si <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">Dei si Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5-3.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">fug. <hi rend="italic">Hr Ad;</hi> effug. <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">fug. Hr Ad; effug. Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_5-3.lnote.la.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">630</biblScope></bibl><seg type="original" xml:lang="de">obl. <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">obl. S</seg></note>
