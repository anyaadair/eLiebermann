    <body>
      <div type="clause" n="14">
        <head><ref type="lawCode" target="law:Iudex">Iudex</ref> 14</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="14" corresp="#wit-g-a"><pb n="476" ed="#liebermann"/>Se hatheorta dema ne mæg he behealdan ðas<ptr type="liebermannNote" n="3" target="#Iudex_14.lnote.oe.3"/> domes riht, for ðan þe for ðæs yrres dimnesse he ne mæg geseon ðas rihtes beorhtnesse.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="14" corresp="#wit-q"><pb n="476" ed="#liebermann"/>Iracundus iudex non potest attendere rectam iudicii satisfactionem: nam<ptr type="liebermannNote" n="8" target="#Iudex_14.lnote.oe.8"/> per furoris excecationem non perspicit<ptr type="liebermannNote" n="9" target="#Iudex_14.lnote.oe.9"/> rectitudinis claritatem.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="476" ed="#liebermann"/>Der zornige Richter, der kann nicht [im Auge] behalten Richtigkeit des Urtheilspruches, weil er wegen des Zornes Umdüsterung die Klarheit des Rechtes nicht zu ersehen vermag.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">The angry judge cannot keep [in view] the rightness of the judgment, because through the darkening of anger he cannot see the brightness of what is right.</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-g-a">The angry judge cannot focus on just judgements because due to the darkness of his wrath, he cannot see the brightness of justice.</ab>
        <note type="comparison" source="#liebermann" n="476">Isidor, Sent. III 52.15f.</note>
        <note type="comparisonPrinted" source="#liebermann">52, 15 f.</note>
        <note type="editorial">U: translator unrecorded: check; Isidore, Sent. III 52.15 f.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_14.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de">aut <hi rend="italic">RT</hi></seg><seg type="translation" xml:lang="en" source="#claude">aut <hi rend="italic">RT</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_14.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de">percipit <hi rend="italic">Br-Ti</hi></seg><seg type="translation" xml:lang="en" source="#claude">percipit <hi rend="italic">Br-Ti</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_14.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
