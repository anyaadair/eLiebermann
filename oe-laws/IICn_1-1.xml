        <note type="liebermannNote" subtype="textual" xml:id="IICn_1-1.lnote.oe.2-4" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">308</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_1-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">309</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Jo</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Jo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_1-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">309</biblScope></bibl><seg type="original" xml:lang="de">-tis et pauperis <hi rend="italic">LbJo</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tis et pauperis LbJo</seg></note>
