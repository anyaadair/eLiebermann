      <div type="clause" n="El. 35">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 35</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 35" corresp="#wit-e"><pb n="38" ed="#liebermann"/>Gif ðu fioh<ptr type="liebermannNote" n="38" target="#Af_El-to-35.lnote.oe.38"/> to borge selle<ptr type="liebermannNote" n="39" target="#Af_El-to-35.lnote.oe.39"/> þinu<hi rend="italic">m</hi> geferan, þe mid þe eardian wille, ne niede<ptr type="liebermannNote" n="40" target="#Af_El-to-35.lnote.oe.40"/> ðu hine swa swa<ptr type="liebermannNote" n="41" target="#Af_El-to-35.lnote.oe.41"/> niedling<ptr type="liebermannNote" n="42" target="#Af_El-to-35.lnote.oe.42"/> ⁊ ne gehene<ptr type="liebermannNote" n="43" target="#Af_El-to-35.lnote.oe.43"/> þu hine mid ðy eacan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 35" corresp="#wit-g-prol-only"><pb n="38" ed="#liebermann"/>Gif ðu feoh to borge gesylle ðinu<hi rend="italic">m</hi> geferan, ðe mid þe eardian wille, ne niede þu hine swa niedling, ne gehyne ðu hyne mid þy éacan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 35" corresp="#wit-h"><pb n="39" ed="#liebermann"/>Gif þu feoh<ptr type="liebermannNote" n="3" target="#Af_El-to-35.lnote.oe.3"/> to borge sylle<ptr type="liebermannNote" n="4" target="#Af_El-to-35.lnote.oe.4"/> þinum geferan, þe mid þe eardian wylle, ne nyd þu hine swa nydling ⁊ ne gehyn þu hine mid þy eacan.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 35" corresp="#wit-q"><pb n="39" ed="#liebermann"/>Si pecuniam mutuam dederis populo meo pauperi qui habitat tecum, non urgeas eum quasi exactor<ptr type="liebermannNote" n="4" target="#Af_El-to-35.lnote.oe.4-2"/> nec usuris opprimes.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 35" corresp="#wit-e"><pb n="254" ed="#jurasinski-and-oliver"/>Gif ðu fioh to borge selle þinu<hi rend="italic">m</hi> geferan, þe mid þe eardian wille, ne niede ðu hine swa swa niedling ⁊ ne gehene þu hine mid ðy eacan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="39" ed="#liebermann"/>Wenn du deinem Gefährten, der bei dir wohnen mag<ptr type="liebermannNote" n="2" target="#Af_El-to-35.lnote.de.2"/>, Geld zur Leihe giebst, so dränge du ihn nicht so wie einen Sklaven<ptr type="liebermannNote" n="3" target="#Af_El-to-35.lnote.de.3"/> und drücke du ihn nicht mit dem Zinse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If you give money on loan to your companion who wishes to live with you, do not press him as if he were a slave, and do not oppress him with interest.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="255" ed="#jurasinski-and-oliver"/>If you give property to be borrowed by your fellow, who will dwell with you, do not oppress him like a slave and do not abuse him with interest.</ab>
        <note type="passageSource">Exodus 22,25</note>
        <note type="comparison" source="#liebermann" n="39">Exodus 22.25</note>
        <note type="comparisonPrinted" source="#liebermann">[22, 25]</note>
        <note type="comparedBy" source="#wormald-mel" n="282"><ref target="clause:Af_17">Af 17</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-35.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">38</biblScope></bibl><seg type="original" xml:lang="de">feoh to borh <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">feoh to borh So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-35.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">38</biblScope></bibl><seg type="original" xml:lang="de">geselle <hi rend="italic">So;</hi> gesylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">geselle So; gesylle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-35.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">38</biblScope></bibl><seg type="original" xml:lang="de">nide <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">nide Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-35.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">38</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-35.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">38</biblScope></bibl><seg type="original" xml:lang="de">nid. <hi rend="italic">ohne</hi> ⁊ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">nid. without ⁊ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-35.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">38</biblScope></bibl><seg type="original" xml:lang="de">gehine <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gehine So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-35.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">39</biblScope></bibl><seg type="original" xml:lang="de">e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-35.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">39</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-35.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">39</biblScope></bibl><seg type="original" xml:lang="de">actor <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">actor R</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-35.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">46</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘will’ Schmid; vielmehr Potential; <hi rend="italic">s. Wb willan</hi> 9</seg><seg type="translation" xml:lang="en" source="#claude">‘will’ Schmid; rather a potential; <hi rend="italic">see Wb willan</hi> 9</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-35.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">46</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">In bewusster Abweichung von Vulg. verbietet Af Herabdrückung Verschuldeter zu Sklaven. Diese Bed. findet sich bei Ælfred mehrfach (Toller). Den Nom. ‘Bedränger, Wucherer’ verstanden Frühere, nur aus Vulg. <hi rend="italic">Vgl. Gl</hi> Darlehn 3; Schaub <hi rend="italic">Kampf gegen Zinswucher</hi> (Freib. 1905) 126</seg><seg type="translation" xml:lang="en" source="#claude">In deliberate departure from the Vulg., Af forbids reducing debtors to slavery. This meaning occurs several times in Ælfred (Toller). Earlier scholars took it as the noun ‘oppressor, usurer’, solely on the basis of the Vulg. <hi rend="italic">Cf. Gl</hi> Darlehn 3; Schaub <hi rend="italic">Kampf gegen Zinswucher</hi> (Freib. 1905) 126</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-35.lnote.de.1" n="1" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">46</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">[ergänze über ‘Gefährten’] ‘Ärmere, sozial Abhängige’ Vulg. <hi rend="italic">Gefera</hi> bed. meist den Gleichstehenden, manchmal aber <hi rend="italic">puer,</hi> also vielleicht wie <hi rend="italic">geneat</hi> auch einen niederen</seg><seg type="translation" xml:lang="en" source="#claude">[add above ‘Gefährten’] ‘poorer, socially dependent persons’ Vulg. <hi rend="italic">Gefera</hi> usually means one’s equal, but sometimes <hi rend="italic">puer,</hi> and so perhaps, like <hi rend="italic">geneat</hi>, also an inferior</seg></note>
      </div>
