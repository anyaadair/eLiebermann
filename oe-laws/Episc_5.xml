  <text>
    <body>
      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:Episc">Episc</ref> 5</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5" corresp="#wit-x"><pb n="477" ed="#liebermann"/>He sceall æt tihtlan ladunge gedihtan, þ<hi rend="italic">æt</hi> ænig man oðrum ænig woh beodan ne mæge aðor oððe on aþe oððe on ordale.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5" corresp="#wit-q"><pb n="477" ed="#liebermann"/>(et<ptr type="liebermannNote" n="13" target="#Episc_5.lnote.oe.13"/>) in compellationum<ptr type="liebermannNote" n="14" target="#Episc_5.lnote.oe.14"/> adlegatione<ptr type="liebermannNote" n="15" target="#Episc_5.lnote.oe.15"/> edocere<ptr type="liebermannNote" n="3" target="#Episc_5.lnote.oe.3"/> (docere), ne quis alii faciat<ptr type="liebermannNote" n="3" target="#Episc_5.lnote.oe.3"/> iniuriam uel (perperam agat) in iusiurando<ptr type="liebermannNote" n="16" target="#Episc_5.lnote.oe.16"/> uel in ordalio.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-x"><pb n="102" ed="#rabin-doml"/>He sceall æt tihtlan ladunge gedihtan, þæt ænig man oðrum ænig woh beodan ne mæge aðor oððe on aþe oððe on ordale.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="477" ed="#liebermann"/>Er<ptr type="liebermannNote" n="1" target="#Episc_5.lnote.de.1"/> soll bei Verklagung den Reinigungsbeweis [des Beklagten] anordnen<ptr type="liebermannNote" n="2" target="#Episc_5.lnote.de.2"/>, damit niemand dem anderen entweder im Eide oder im Ordale irgend ein Unrecht anthun könne.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">He shall direct the clearing proof [of the accused] in an accusation, so that no one can do another any wrong either in the oath or in the ordeal.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-x"><pb n="103" ed="#rabin-doml"/>He must oversee the defense in response to an accusation, so that no one can inflict harm on another through an oath or an ordeal.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_5.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">477</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_5.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">477</biblScope></bibl><seg type="original" xml:lang="de">-tiuum <hi rend="italic">Hk Br;</hi> -lacionti̅ <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tiuum Hk Br; -lacionti̅ K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_5.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">477</biblScope></bibl><seg type="original" xml:lang="de">-nem <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nem Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_5.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">477</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond; eingeklammertes übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">the text before the bracket Lond; the bracketed text the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_5.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">477</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus the MSS</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Episc_5.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">271</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Bischof 9b</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Bischof 9b</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Episc_5.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">271</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Nicht etwa bloss Reliquien reichen, auf die der Eid abzuleisten ist, was jeder andere Geistliche auch konnte. Teilnahme des Priesters an Ordal und Eid <hi rend="italic">s</hi>. Northu 39f.; <hi rend="italic">vgl. Gl</hi> Beweis 14</seg><seg type="translation" xml:lang="en" source="#claude">Not merely, say, handing over the relics on which the oath is to be sworn, which any other cleric could also do. For the participation of the priest in ordeal and oath <hi rend="italic">see</hi> Northu 39f.; <hi rend="italic">cf. Gl</hi> Beweis 14</seg></note>
      </div>
    </body>
  </text>
