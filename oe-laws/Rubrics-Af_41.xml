      <div type="clause" n="41">
        <head>Af Rb 41</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="41" corresp="#wit-e"><pb n="18" ed="#liebermann"/>XXXVII. Be bóclondum.<ptr type="liebermannNote" n="25" target="#Rubrics-Af_41.lnote.oe.25"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="41" corresp="#wit-ot-frag"><pb n="18" ed="#liebermann"/>… boclondum.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="41" corresp="#wit-g-prol"><pb n="18" ed="#liebermann"/>XXXVII. Be boclandum.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="41" corresp="#wit-h"><pb n="19" ed="#liebermann"/>XXXVII. Be boclandum.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="41" corresp="#wit-q"><pb n="19" ed="#liebermann"/>De infractura burgi.<ptr type="liebermannNote" n="27" target="#Rubrics-Af_41.lnote.oe.27"/> De terra hereditatis.<ptr type="liebermannNote" n="28" target="#Rubrics-Af_41.lnote.oe.28"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="198" ed="#jurasinski-and-oliver"/>XXXVII Be bóclondum</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="198" ed="#jurasinski-and-oliver"/>Be boclande</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="19" ed="#liebermann"/>Von urkund[lich verschriebenen] Landgütern.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of estates [granted] by charter.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="199" ed="#jurasinski-and-oliver"/>Concerning book-lands</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="199" ed="#jurasinski-and-oliver"/>Concerning book-land</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_41.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zu</hi> [40] horgi <hi rend="italic">Hk;</hi> borgi <hi rend="italic">Br;</hi> regis vel archiepiscopi <hi rend="italic">fügt zu Hk Br;</hi> vel aldremanni, XIIhindi hominis vel VIhindi <hi rend="italic">fügt dann zu Hk. Dann:</hi> De fractione sepis rustici. [40,2] De sancto [<hi rend="italic">fehlt Br</hi>] velo in XLª. iniuste deposito <hi rend="italic">fügen zu Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">relating to [40]: horgi Hk; borgi Br; regis vel archiepiscopi added by Hk Br; vel aldremanni, XIIhindi hominis vel VIhindi then added by Hk. Then: De fractione sepis rustici. [40,2] De sancto [lacking in Br] velo in XLª. iniuste deposito added by Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_41.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">-taria <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">-taria Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_41.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de">-lande <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lande Ld</seg></note>
