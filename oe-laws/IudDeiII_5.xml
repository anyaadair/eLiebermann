      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:IudDeiII">Iud Dei II</ref> 5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei II 5" corresp="#wit-lat"><ptr type="liebermannNote" n="c" target="#IudDeiII_5.lnote.oe.c"/><pb n="407" ed="#liebermann"/>His peractis, aqua benedicta cunctis<ptr type="liebermannNote" n="64" target="#IudDeiII_5.lnote.oe.64"/> adstantibus<ptr type="liebermannNote" n="65" target="#IudDeiII_5.lnote.oe.65"/> detur ad degustandum et aspergatur per totam domum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 407 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_5.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Folgendes bis Ende</hi> (<hi rend="italic">wie Anfang; s.</hi> 1ᶜ) <hi rend="italic">England eigen; vgl.</hi> II As. 23, 1 (<hi rend="italic">aus</hi> niht : noctes 5, 2); Ordal 5, 1 <hi rend="italic">f.</hi> 2.</seg><seg type="translation" xml:lang="en" source="#claude">What follows, to the end (like the beginning; see 1ᶜ), is peculiar to England; cf. II As. 23, 1 (from niht : noctes 5, 2); Ordal 5, 1 f. 2.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_5.lnote.oe.64" n="64" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> I 19, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. I 19, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_5.lnote.oe.65" n="65" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">ast. <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">ast. H</seg></note>
      </div>
