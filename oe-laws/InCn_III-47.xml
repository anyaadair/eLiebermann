      <div type="clause" n="III 47">
        <head><ref type="lawCode" target="law:InCn">In Cn</ref> III 47</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="In Cn III 47" corresp="#wit-lat"><pb n="613" ed="#liebermann"/>pastio<ptr type="liebermannNote" n="p" target="#InCn_III-47.lnote.oe.p"/> proclamati<ptr type="liebermannNote" n="u" target="#InCn_III-47.lnote.oe.u"/> exulis, quod Angli dicunt (uocant<ptr type="liebermannNote" n="45" target="#InCn_III-47.lnote.oe.45"/>) bebodenes<ptr type="liebermannNote" n="v" target="#InCn_III-47.lnote.oe.v"/><ptr type="liebermannNote" n="46" target="#InCn_III-47.lnote.oe.46"/> utlage;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 613 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-47.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">feorm <hi rend="italic">bot die Quelle</hi></seg><seg type="translation" xml:lang="en" source="#claude">the source had feorm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-47.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. oben zu II Cn.</hi> 13, 2 gecydne</seg><seg type="translation" xml:lang="en" source="#claude">cf. above on II Cn. 13, 2 gecydne</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-47.lnote.oe.v" n="v" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dieser Genetiv passt grammatisch nicht, weshalb Cb</hi> beboden <hi rend="italic">bessert; in der Quelle hing er von</hi> feorm <hi rend="italic">ab</hi></seg><seg type="translation" xml:lang="en" source="#claude">this genitive does not fit grammatically, which is why Cb corrects it to beboden; in the source it depended on feorm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-47.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> di. <hi rend="italic">HRl; nur</hi> uo. <hi rend="italic">CbT</hi></seg><seg type="translation" xml:lang="en" source="#claude">only di. HRl; only uo. CbT</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-47.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">-den <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-den Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-47.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">333</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. friedlos 1s. 3d. e; Begünstigung 14</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. friedlos 1s. 3d. e; Begünstigung 14</seg></note>
      </div>
