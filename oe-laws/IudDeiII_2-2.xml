        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_2-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">406</biblScope></bibl><seg type="original" xml:lang="de">de <hi rend="italic">Al</hi></seg><seg type="translation" xml:lang="en" source="#claude">de Al</seg></note>
