      <div type="clause" n="6.4">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 6.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 6.4" corresp="#wit-lat"><pb n="552" ed="#liebermann"/>Tanta quippe rerum peruersitas<ptr type="liebermannNote" n="32" target="#Hn_6-4.lnote.oe.32"/> et malorum affluencia est, ut definita<ptr type="liebermannNote" n="33" target="#Hn_6-4.lnote.oe.33"/> legis ueritas<ptr type="liebermannNote" n="r" target="#Hn_6-4.lnote.oe.r"/> uel stabilis medicine prouidentia raro possit inueniri; set ad maiorem omnium confusionem nouus<ptr type="liebermannNote" n="p" target="#Hn_6-4.lnote.oe.p"/> inplacitationis modus exquiritur, noua nocendi fraus inuenitur, tanquam parum noceat quicquid ante fuerit, et pluris esse iudicetur qui pluribus plus nocuerit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 552 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-4.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verf. leitet die Verwickelung des Rechts auch sonst aus gerichtsherrlicher Habgier ab; vgl.</hi> Quadr. Ded. 4; Arg. 13</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">the author elsewhere too derives the complication of the law from the greed of lords of courts; cf.</hi> Quadr. Ded. 4; Arg. 13</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-4.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verf. beklagt die Unsicherheit des Rechts auch sonst</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">the author elsewhere too laments the uncertainty of the law</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-4.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">-rss. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rss. <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-4.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">diff. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">diff. <hi rend="italic">Co Or</hi></seg></note>
      </div>
