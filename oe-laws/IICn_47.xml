        <note type="liebermannNote" subtype="textual" xml:id="IICn_47.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">344</biblScope></bibl><seg type="original" xml:lang="de">-lic lenc. ðurh f. g. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lic lenc. ðurh f. g. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_47.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">344</biblScope></bibl><seg type="original" xml:lang="de">o. þ. r. <hi rend="italic">im</hi> 16. <hi rend="italic">Jh. übergeschr. G; fehlte ursprünglich auch Quadr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">o. þ. r. written above in the 16th cent. G; originally lacking in Quadr. too</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_47.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">344</biblScope></bibl><seg type="original" xml:lang="de">-ig <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ig Ld</seg></note>
