      <div type="clause" n="51.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 51.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 51.1" corresp="#wit-lat"><pb n="573" ed="#liebermann"/>Qui<ptr type="liebermannNote" n="d" target="#Hn_51-1.lnote.oe.d"/> ad hundretum secundum legem submonitus non uenerit, prima et secunda uice XXX den. culpa sit erga ipsum hundretum, nisi sonius<ptr type="liebermannNote" n="18" target="#Hn_51-1.lnote.oe.18"/> legalis eum detineat; tercia uice plena<ptr type="liebermannNote" n="19" target="#Hn_51-1.lnote.oe.19"/> wita<ptr type="liebermannNote" n="e" target="#Hn_51-1.lnote.oe.e"/> sit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 573 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_51-1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt aus</hi> 29, 2</seg><seg type="translation" xml:lang="en" source="#claude">repeated from 29, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_51-1.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">oferhyrnesse<hi rend="italic">? vgl. II As.</hi> 20; <hi rend="italic">u.</hi> 53, 1</seg><seg type="translation" xml:lang="en" source="#claude">oferhyrnesse? cf. II As. 20; below 53, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_51-1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Co;</hi> sōniꝰ <hi rend="italic">Sc;</hi> soinus <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Co; sōniꝰ Sc; soinus the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_51-1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">wyta p. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">wyta p. Lond</seg></note>
