      <div type="clause" n="3.3">
        <head><ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 3.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 3.3" corresp="#wit-du"><pb n="410" ed="#liebermann"/>Te, domine Deus, supplices deprecamur, qui in Chana Galiléǽ ex aqua uinum fecisti et tres pueros Sidrac, Misac et Abdenago de camino ignis ardentis inlaesos eduxisti et Susannam de falso crimine liberasti, caeco nato oculos aperuisti, Lazarum<ptr type="liebermannNote" n="14" target="#IudDeiIV_3-3.lnote.oe.14"/> a monumento suscitasti et Petro mergenti manum porrexisti,</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei IV 3.3" corresp="#wit-gl"><pb n="410" ed="#liebermann"/>Ðec, driht<hi rend="italic">en</hi> God, eðmodlic<hi rend="italic">e</hi> <hi rend="italic">uel<ptr type="liebermannNote" n="11" target="#IudDeiIV_3-3.lnote.oe.11"/></hi> ve biddað, ða<ptr type="liebermannNote" n="12" target="#IudDeiIV_3-3.lnote.oe.12"/> ðe in Chan' Gali' of vætre win worhtest ⁊ ðrio cnæhtas Sið', Mis' ⁊ Abdi' of ofone fyres biornendos unascendado gilæddest ⁊ þ<hi rend="italic">æt<ptr type="liebermannNote" n="13" target="#IudDeiIV_3-3.lnote.oe.13"/></hi> vif of leasum synne alesdest, blindu<hi rend="italic">m</hi> giboren<hi rend="italic">um</hi> ego untyndest, Lazaru<hi rend="italic">m</hi> from byrgenne awoehtest ⁊ Petre ðæm drencende hond girahtest<ptr type="liebermannNote" n="15" target="#IudDeiIV_3-3.lnote.oe.15"/>,</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Ioan. 2, 11; Dan. 3, 12; Dan. 13, 6; Ioan. 9, 19; Ioan. 11, 1; Matth. 14, 3</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 410 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-3.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbesserndes Synonym fehlt</hi></seg><seg type="translation" xml:lang="en" source="#claude">correcting synonym missing</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-3.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Glossator missversteht</hi> qui <hi rend="italic">als Plural</hi></seg><seg type="translation" xml:lang="en" source="#claude">the glossator misunderstands qui as a plural</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-3.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">für</hi> Susanna <hi rend="italic">setzt Glossator ‘das Weib’ auch</hi> 4, 2</seg><seg type="translation" xml:lang="en" source="#claude">for Susanna the glossator puts ‘the woman’, also 4, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-3.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">quatriduanum <hi rend="italic">fügt zu Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">quatriduanum added by Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-3.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">über</hi> a [<hi rend="italic">das hier</hi> u <hi rend="italic">gleicht</hi>] <hi rend="italic">vgl. Lind. p.</hi> 30</seg><seg type="translation" xml:lang="en" source="#claude">above a [which here resembles u]; cf. Lind. p. 30</seg></note>
      </div>
