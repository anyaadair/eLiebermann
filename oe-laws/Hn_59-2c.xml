      <div type="clause" n="59.2c">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 59.2c</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 59.2c" corresp="#wit-lat"><pb n="577" ed="#liebermann"/>Hec<ptr type="liebermannNote" n="39" target="#Hn_59-2c.lnote.oe.39"/> secundum legem diximus; qui pactum<ptr type="liebermannNote" n="m" target="#Hn_59-2c.lnote.oe.m"/> fecit aliter, habeat: que<ptr type="liebermannNote" n="40" target="#Hn_59-2c.lnote.oe.40"/> ad ius<ptr type="liebermannNote" n="41" target="#Hn_59-2c.lnote.oe.41"/> diffinitum<ptr type="liebermannNote" n="v" target="#Hn_59-2c.lnote.oe.v"/> utrimque<ptr type="liebermannNote" n="42" target="#Hn_59-2c.lnote.oe.42"/> se habent, diffinitis<ptr type="liebermannNote" n="w" target="#Hn_59-2c.lnote.oe.w"/> prelocutionibus egent.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 577 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-2c.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 49, 5<hi rend="italic">a</hi>. 59, 2<hi rend="italic">c</hi>; 4<hi rend="italic">a</hi>&lt;sup&gt;<hi rend="italic">k</hi>&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude">cf. 49, 5<hi rend="italic">a</hi>. 59, 2<hi rend="italic">c</hi>; 4<hi rend="italic">a</hi>&lt;sup&gt;<hi rend="italic">k</hi>&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-2c.lnote.oe.v" n="v" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">was das durch die Parteien verabredete Recht anbetrifft</hi></seg><seg type="translation" xml:lang="en" source="#claude">as regards the law agreed upon by the parties</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-2c.lnote.oe.w" n="w" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 10, 4. 19, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. 10, 4. 19, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-2c.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">Hoc <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hoc Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-2c.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">qui <hi rend="italic">empfiehlt Tho</hi> [<hi rend="italic">falsch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">qui recommended by Tho [wrongly]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-2c.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">ad indefinitum <hi rend="italic">Sc Hg;</hi> ad indiffinitum <hi rend="italic">Wh Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad indefinitum Sc Hg; ad indiffinitum Wh Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_59-2c.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">utrumque <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">utrumque K Co Or Gi</seg></note>
