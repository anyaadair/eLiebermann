      <div type="clause" n="94.2a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 94.2a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 94.2a" corresp="#wit-lat"><pb n="611" ed="#liebermann"/>Et wita domini<ptr type="liebermannNote" n="3" target="#Hn_94-2a.lnote.oe.3"/> decidat, si<ptr type="liebermannNote" n="4" target="#Hn_94-2a.lnote.oe.4"/> sanguis exeat, et ipsi<ptr type="liebermannNote" n="e" target="#Hn_94-2a.lnote.oe.e"/> coa[gente]s<ptr type="liebermannNote" n="6" target="#Hn_94-2a.lnote.oe.6"/> non [sin]t unius dominii, et<ptr type="liebermannNote" n="e" target="#Hn_94-2a.lnote.oe.e"/> sine crauatione<ptr type="liebermannNote" n="7" target="#Hn_94-2a.lnote.oe.7"/> sit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 611 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2a.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">für unblutigen Fall dasselbe positiv</hi> 94, 1<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">for the bloodless case the same is stated positively in 94, 1a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2a.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">de. do. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">de. do. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2a.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">si — dominii <hi rend="italic">nur aus Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">si — dominii only from Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2a.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">coanguis n. fit <hi rend="italic">Sc; Hg</hi> (<hi rend="italic">wo</hi> sit); et — dominii <hi rend="italic">fehlt Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">coanguis n. fit Sc; Hg (where sit); et — dominii missing in edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2a.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">grau. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">grau. Lond</seg></note>
      </div>
