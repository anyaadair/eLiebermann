      <div type="clause" n="10.2">
        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 10.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 10.2" corresp="#wit-lat"><pb n="675" ed="#liebermann"/>Seruare<ptr type="liebermannNote" n="t" target="#LibLond_10-2.lnote.oe.t"/> debent<ptr type="liebermannNote" n="40" target="#LibLond_10-2.lnote.oe.40"/> ciuitatem sicut refugium et propugnaculum regni: omnes [enim<ptr type="liebermannNote" n="41" target="#LibLond_10-2.lnote.oe.41"/>] ibi refugium et egressum<ptr type="liebermannNote" n="42" target="#LibLond_10-2.lnote.oe.42"/> habent<ptr type="liebermannNote" n="43" target="#LibLond_10-2.lnote.oe.43"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 675 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10-2.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">10, 1 <hi rend="italic">f. vielleicht Zusatz aus Londoner Ansprüchen unter Johann;</hi> 10, 2 <hi rend="italic">erinnert an</hi> Leges Angl. s. XIII. in. Lond. coll.; <hi rend="italic">vgl. dort S.</hi> 35. 62 <hi rend="italic">f.</hi>; Wl art. retr. 11. <hi rend="italic">Freiheit von</hi> expeditio <hi rend="italic">besassen Englische Städte nach Breteuils Muster; und Edward III. verbriefte den Londonern:</hi> quod non distringantur ad proficiscendum seu mittendum in guerram extra ciuitatem; <hi rend="italic">Bateson</hi> 712{28}</seg><seg type="translation" xml:lang="en" source="#claude">10, 1 f. perhaps an addition from London claims under John; 10, 2 recalls Leges Angl. s. XIII. in. Lond. coll.; cf. there pp. 35. 62 f.; Wl art. retr. 11. English towns on the model of Breteuil possessed freedom from expeditio; and Edward III granted the Londoners by charter: quod non distringantur ad proficiscendum seu mittendum in guerram extra ciuitatem; Bateson 712{28}</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10-2.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">c. d. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. d. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10-2.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Horn, nicht Ai Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Horn, not in Ai Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10-2.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">ingr. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">ingr. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10-2.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">libertatis <hi rend="italic">fügt zu, aber halb ausradirt, Co; Rest der Seite leer, dann</hi> De excubiis (<hi rend="italic">ed. Round</hi> Commune of London 255) <hi rend="italic">Ai.</hi></seg><seg type="translation" xml:lang="en" source="#claude">libertatis added, but half erased, by Co; rest of the page blank, then De excubiis (ed. Round <hi rend="italic">Commune of London</hi> 255) Ai.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. London 52; Stadt 11</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. London 52; Stadt 11</seg></note>
      </div>
