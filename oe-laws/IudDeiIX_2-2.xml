      <div type="clause" n="2.2">
        <head><ref type="lawCode" target="law:IudDeiIX">Iud Dei IX</ref> 2.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IX 2.2" corresp="#wit-lat"><pb n="416" ed="#liebermann"/>Si autem culpabilis (uel<ptr type="liebermannNote" n="2" target="#IudDeiIX_2-2.lnote.oe.2"/> -les<ptr type="liebermannNote" n="11" target="#IudDeiIX_2-2.lnote.oe.11"/>) atque reus (uel<ptr type="liebermannNote" n="2" target="#IudDeiIX_2-2.lnote.oe.2"/> rei<ptr type="liebermannNote" n="11" target="#IudDeiIX_2-2.lnote.oe.11"/>) té<ptr type="liebermannNote" n="12" target="#IudDeiIX_2-2.lnote.oe.12"/> contempserit (uel<ptr type="liebermannNote" n="2" target="#IudDeiIX_2-2.lnote.oe.2"/> -rint), <ptr type="liebermannNote" n="13" target="#IudDeiIX_2-2.lnote.oe.13"/>qui iustus Deus es et omnia iuste et recte iúdicas, et<ptr type="liebermannNote" n="14" target="#IudDeiIX_2-2.lnote.oe.14"/> suadénte<ptr type="liebermannNote" n="15" target="#IudDeiIX_2-2.lnote.oe.15"/> diabolo per aliquod<ptr type="liebermannNote" n="16" target="#IudDeiIX_2-2.lnote.oe.16"/> maleficium<ptr type="liebermannNote" n="17" target="#IudDeiIX_2-2.lnote.oe.17"/> aut per hérbas uel quęcumque temptamenta<ptr type="liebermannNote" n="18" target="#IudDeiIX_2-2.lnote.oe.18"/> siue molímina peccata sua contuéri<ptr type="liebermannNote" n="19" target="#IudDeiIX_2-2.lnote.oe.19"/> contra ueritatis tuae exámen uolúerit (uel<ptr type="liebermannNote" n="2" target="#IudDeiIX_2-2.lnote.oe.2"/> -rint),</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 416 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_2-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">rund Eingeklammertes übergeschrieben Ch; fehlt Rj Vt Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">words in round brackets written above in Ch; missing in Rj Vt Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_2-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so auch Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">so also Vt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_2-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so auch II</hi> 4, 2; extiterit <hi rend="italic">Zeu. statt</hi> te cont.</seg><seg type="translation" xml:lang="en" source="#claude">so also II 4, 2; extiterit Zeu. instead of te cont.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_2-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de">tú <hi rend="italic">fügt</hi> [<hi rend="italic">irrig</hi>] <hi rend="italic">zu Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ch adds tú [wrongly]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_2-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> si <hi rend="italic">aus Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">read si, from Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_2-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de">su.—aut <hi rend="italic">fehlt Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">su.—aut missing in Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_2-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de">-quid <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">-quid Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_2-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de">malif. <hi rend="italic">Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">malif. Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_2-2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">gegen Zeu. auch II</hi> 4, 2</seg><seg type="translation" xml:lang="en" source="#claude">against Zeu. also II 4, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIX_2-2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">416</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. oben S.</hi> 407⁵¹</seg><seg type="translation" xml:lang="en" source="#claude">see above p. 407⁵¹</seg></note>
      </div>
