    <body>
      <div type="clause" n="2.9a">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 2.9a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 2.9a"><pb n="629" ed="#liebermann"/>Et si<ptr type="liebermannNote" n="b" target="#ECf_2-9a.lnote.la.fn.b"/> pro iustitia episcopi emendare noluerit, ostendat regi; et rex constringet<ptr type="liebermannNote" n="21" target="#ECf_2-9a.lnote.la.21"/> forisfactorem<ptr type="liebermannNote" n="22" target="#ECf_2-9a.lnote.la.22"/>, ut emendet cui<ptr type="liebermannNote" n="23" target="#ECf_2-9a.lnote.la.23"/> forisfecit<ptr type="liebermannNote" n="24" target="#ECf_2-9a.lnote.la.24"/>, et<ptr type="liebermannNote" n="c" target="#ECf_2-9a.lnote.la.fn.c"/> episcopo et sibi.</ab>
        <note type="comparison" source="#liebermann" n="629"><label>printed alongside</label> <ref target="clause:ECfRetr_2-9a">ECf retr 2.9a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 629 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “regi” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_2-9a.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht ist benutzt</hi> Wl ep. 3—3, 2; <hi rend="italic">vgl.</hi> Hn 11, 15; <hi rend="italic">u.</hi> 6. 8, 2a. 10, 2. Arroganter <hi rend="italic">setzt Retr. auch</hi> 6a</seg><seg type="translation" xml:lang="en" source="#claude">perhaps Wl ep. 3–3, 2 is used; cf. Hn 11, 15; below 6. 8, 2a. 10, 2. The Retractator also puts arrogans at 6a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_2-9a.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Retr. wahrt</hi> (<hi rend="italic">klerikaler, auch</hi> 3, 1) <hi rend="italic">dem Bischof Priorität, wie u.</hi> 3. 6a</seg><seg type="translation" xml:lang="en" source="#claude">the Retractator (more clerical, also at 3, 1) keeps the priority for the bishop, as below, 3. 6a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-9a.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">-gat <hi rend="italic">Hk Pl S Ad No</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gat Hk Pl S Ad No</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-9a.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-9a.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">de forisfacto <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">de forisfacto Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-9a.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl Hr;</hi> forisfecerit <hi rend="italic">Ad No</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl Hr; forisfecerit Ad No</seg></note>
      </div>
