    <body>
      <div type="clause" n="53.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 53.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 53.2" corresp="#wit-lat"><pb n="574" ed="#liebermann"/>Si quis inplacitetur de eo<ptr type="liebermannNote" n="g" target="#Hn_53-2.lnote.oe.g"/> unde per plegium corporis et tocius peccunie<ptr type="liebermannNote" n="21" target="#Hn_53-2.lnote.oe.21"/> sit, remaneat de omnibus aliis causis, donec primi<ptr type="liebermannNote" n="22" target="#Hn_53-2.lnote.oe.22"/> finis sit, quia est qu[a]dam<ptr type="liebermannNote" n="23" target="#Hn_53-2.lnote.oe.23"/> tenus in captione regis.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 574 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_53-2.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">574</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im Sinne von</hi> 46, 3: (<hi rend="italic">Criminalklage</hi>) weswegen er für Leib und Habe unter Bürgschaft steht; <hi rend="italic">vgl.</hi> 53, 4</seg><seg type="translation" xml:lang="en" source="#claude">in the sense of 46, 3: (criminal charge) on account of which he is under surety for his person and property; cf. 53, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_53-2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">574</biblScope></bibl><seg type="original" xml:lang="de">responsurus <hi rend="italic">ergänzt ohne Hss. Wi Tho</hi> [<hi rend="italic">falsch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">responsurus supplied without MSS Wi Tho [wrongly]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_53-2.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">574</biblScope></bibl><seg type="original" xml:lang="de">prime <hi rend="italic">bessert Tho</hi> [<hi rend="italic">unnöthig</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">prime emended by Tho [unnecessarily]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_53-2.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">574</biblScope></bibl><seg type="original" xml:lang="de">quod. <hi rend="italic">Hss. Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod. MSS edd.</seg></note>
      </div>
