    <body>
      <div type="clause" n="4.5">
        <head><ref type="lawCode" target="law:Rect">Rect</ref> 4.5</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4.5" corresp="#wit-b"><pb n="448" ed="#liebermann"/>[4.5] On sumen<ptr type="liebermannNote" n="2" target="#Rect_4-5.lnote.oe.2"/> landa<ptr type="liebermannNote" n="2" target="#Rect_4-5.lnote.oe.2"/> gebur sceal syllan huniggafol, on suman metegafol, on suman ealugafol.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="4.5" corresp="#wit-q"><pb n="448" ed="#liebermann"/>In quibusdam locis gebúr dabit hunigablum<ptr type="liebermannNote" n="1" target="#Rect_4-5.lnote.oe.1"/>, in quibusdam metegablum<ptr type="liebermannNote" n="2" target="#Rect_4-5.lnote.oe.2-2"/>, in quibusdam ealagablum.</ab>
        <ab type="editionText" xml:lang="ang" source="#gobbitt" n="5.1" corresp="#wit-b">On sumen landa gebur sceal syllan huniggafol</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-b"><pb n="320" ed="#rabin-doml"/>On sumen landa gebur sceal syllan huniggafol, on suman metegafol, on suman ealugafol.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="448" ed="#liebermann"/>Auf eínem Landgut muss der Bauer Abgabe in Honig<ptr type="liebermannNote" n="1" target="#Rect_4-5.lnote.de.1"/> geben, auf dem anderen Abgabe in Speise<ptr type="liebermannNote" n="2" target="#Rect_4-5.lnote.de.2"/>, auf dem anderen Abgabe in Bier<ptr type="liebermannNote" n="3" target="#Rect_4-5.lnote.de.3"/>.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">On one estate the gebur must pay a rent in honey, on another a rent in food, on another a rent in ale.</ab>
        <ab type="translation" xml:lang="en" source="#gobbitt" corresp="#wit-b">In some estates the peasant must give honey-rent.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-b"><pb n="321" ed="#rabin-doml"/>On some estates, the tenant farmer must pay honey dues, on some meat dues, on some ale dues.</ab>
        <note type="editorial">B's ‘sumen landa’ stands so.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Rect_4-5.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">448</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rect_4-5.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">448</biblScope></bibl><seg type="original" xml:lang="de">un. <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">un. MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rect_4-5.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">448</biblScope></bibl><seg type="original" xml:lang="de">methe. <hi rend="italic">MHk;</hi> m. in q. <hi rend="italic">überspringt R</hi></seg><seg type="translation" xml:lang="en" source="#claude">methe. MHk; m. in q. skipped by R</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rect_4-5.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">249</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Bienen. <hi rend="italic">Honeigsilver, metegafol, alerent</hi> belegt mit Beispielen Neilson <hi rend="italic">Custom. rents</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cf. <hi rend="italic">Gl</hi> Bienen. Neilson <hi rend="italic">Custom. rents</hi> documents <hi rend="italic">Honeigsilver, metegafol, alerent</hi> with examples</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rect_4-5.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">249</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Speiseabgabe; diesen Sinn hat <hi rend="italic">mescinga</hi> in Hale (<hi rend="italic">o</hi>. 2⁸) 43, wohl <hi rend="italic">metsing</hi> zu lesen; <hi rend="italic">s. u</hi>. 8</seg><seg type="translation" xml:lang="en" source="#claude">See <hi rend="italic">Gl</hi> Speiseabgabe; <hi rend="italic">mescinga</hi> has this meaning in Hale (<hi rend="italic">above</hi> 2⁸) 43, where <hi rend="italic">metsing</hi> should probably be read; <hi rend="italic">see below</hi> 8</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rect_4-5.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">249</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Bier 3—4</seg><seg type="translation" xml:lang="en" source="#claude">See <hi rend="italic">Gl</hi> Bier 3—4</seg></note>
      </div>
    </body>
