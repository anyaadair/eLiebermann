      <div type="clause" n="II Cn 74">
        <head>Quadr Rb II Cn 74</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Rb II Cn 74" corresp="#wit-lat"><pb n="538" ed="#liebermann"/>Ne uis<ptr type="liebermannNote" n="42" target="#Quadr-Rb_II-Cn-74.lnote.la.42"/> fiat alicui uiduæ<ptr type="liebermannNote" n="43" target="#Quadr-Rb_II-Cn-74.lnote.la.43"/> uel<ptr type="liebermannNote" n="44" target="#Quadr-Rb_II-Cn-74.lnote.la.44"/> uirgini <ptr type="liebermannNote" n="a" target="#Quadr-Rb_II-Cn-74.lnote.la.fn.a"/>(uel femine) in<ptr type="liebermannNote" n="45" target="#Quadr-Rb_II-Cn-74.lnote.la.45"/> maritando.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 538 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">That no force be done to any widow or virgin (or woman) in giving her in marriage.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-74.lnote.la.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de">uidua aut uirgo ui desponsetur <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">uidua aut uirgo ui desponsetur R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-74.lnote.la.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de">uirg. u. fem., <hi rend="italic">ohne</hi> uid., <hi rend="italic">HkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">uirg. u. fem., without uid., HkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-74.lnote.la.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de">alicui <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Lond adds alicui</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-74.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. S</hi> 537<hi rend="superscript">c</hi></seg><seg type="translation" xml:lang="en" source="#claude">see p. 537, note c</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-74.lnote.la.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de">in m. <hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">in m. lacking in Hk</seg></note>
      </div>
