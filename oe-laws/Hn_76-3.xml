        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 76.3" corresp="#wit-lat"><pb n="593" ed="#liebermann"/>Serui alii natura<ptr type="liebermannNote" n="d" target="#Hn_76-3.lnote.oe.d"/>, alii facti<ptr type="liebermannNote" n="14" target="#Hn_76-3.lnote.oe.14"/>, et<ptr type="liebermannNote" n="12" target="#Hn_76-3.lnote.oe.12"/> alii empcione et<ptr type="liebermannNote" n="12" target="#Hn_76-3.lnote.oe.12"/> alii redempcione<ptr type="liebermannNote" n="e" target="#Hn_76-3.lnote.oe.e"/>, alii sui<ptr type="liebermannNote" n="f" target="#Hn_76-3.lnote.oe.f"/><ptr type="liebermannNote" n="15" target="#Hn_76-3.lnote.oe.15"/> uel alterius<ptr type="liebermannNote" n="g" target="#Hn_76-3.lnote.oe.g"/> dacione serui, — et si que sunt alie<ptr type="liebermannNote" n="16" target="#Hn_76-3.lnote.oe.16"/> species huiusmodi<ptr type="liebermannNote" n="17" target="#Hn_76-3.lnote.oe.17"/>, quas tamen omnes uolumus<ptr type="liebermannNote" n="18" target="#Hn_76-3.lnote.oe.18"/> sub uno seruitutis menbro constitui, quem ‘casum’<ptr type="liebermannNote" n="d" target="#Hn_76-3.lnote.oe.d"/> ponimus appellari<ptr type="liebermannNote" n="19" target="#Hn_76-3.lnote.oe.19"/>, ut ita<ptr type="liebermannNote" n="20" target="#Hn_76-3.lnote.oe.20"/> dictum sit: serui alii<ptr type="liebermannNote" n="d" target="#Hn_76-3.lnote.oe.d"/> casu, alii genitura.</ab>
