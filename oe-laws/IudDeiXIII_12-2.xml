      <div type="clause" n="12.2">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 12.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 12.2" corresp="#wit-lat"><pb n="423" ed="#liebermann"/>Adiuro autem<ptr type="liebermannNote" n="47" target="#IudDeiXIII_12-2.lnote.oe.47"/> té, aqua, per nomen Christi et praecipio tibi, ut nobis obędias per nomen eius, cui omnis creatura seruit, quem<ptr type="liebermannNote" n="48" target="#IudDeiXIII_12-2.lnote.oe.48"/> Cherubim et Seraphim collaudant, dicentes ‘Sanctus Sanctus Sanctus dominus Deus exercituum’, qui regnat et dominatur Deus per infinita seculorum<ptr type="liebermannNote" n="49" target="#IudDeiXIII_12-2.lnote.oe.49"/> secula. Amen.</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Apoc. 4, 8</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 423 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_12-2.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">te a. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">te a. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_12-2.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Zeu.;</hi> quam <hi rend="italic">Vt2</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Zeu.; quam Vt2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_12-2.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">-la -lorum <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-la -lorum Tr</seg></note>
