    <body>
      <div type="clause" n="70.20a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 70.20a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 70.20a" corresp="#wit-lat"><pb n="589" ed="#liebermann"/>Si nec hos habeat<ptr type="liebermannNote" n="33" target="#Hn_70-20a.lnote.oe.33"/>, soror<ptr type="liebermannNote" n="34" target="#Hn_70-20a.lnote.oe.34"/> patris uel matris, et deinceps in quintum geniculum<ptr type="liebermannNote" n="u" target="#Hn_70-20a.lnote.oe.u"/>, quicumque<ptr type="liebermannNote" n="35" target="#Hn_70-20a.lnote.oe.35"/> propinquiores in parentela fuerint<ptr type="liebermannNote" n="36" target="#Hn_70-20a.lnote.oe.36"/>, hereditario iure succedant.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 589 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-20a.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">obwohl auch Angelsachsen nach Knieen die Verwandtschaft rechneten, darf man dies Fränkische Stück nicht aus Hn als Englisch annehmen</hi></seg><seg type="translation" xml:lang="en" source="#claude">although the Anglo-Saxons too reckoned kinship by knees, this Frankish passage from Hn may not be taken as English</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-20a.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-20a.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">-rem <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rem Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-20a.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">qui cum <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui cum Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-20a.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">fuint <hi rend="italic">Sc;</hi> fiunt <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">fuint Sc; fiunt Hg</seg></note>
