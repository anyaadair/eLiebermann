      <div type="clause" n="20">
        <head>Af Rb 20</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="20" corresp="#wit-e"><pb n="18" ed="#liebermann"/>XVIII. Be ðam þe munecum heora<ptr type="liebermannNote" n="3" target="#Rubrics-Af_20.lnote.oe.3-2"/> feoh buton<ptr type="liebermannNote" n="4" target="#Rubrics-Af_20.lnote.oe.4"/> leafe befæstað.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="20" corresp="#wit-ot-frag"><pb n="18" ed="#liebermann"/>… e þā þe munecum heora feoh buton lea …</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="20" corresp="#wit-g-prol"><pb n="18" ed="#liebermann"/>XVIII.<ptr type="liebermannNote" n="1" target="#Rubrics-Af_20.lnote.oe.1-2"/> Be ðan<ptr type="liebermannNote" n="2" target="#Rubrics-Af_20.lnote.oe.2-3"/> þe munecu<hi rend="italic">m</hi> heora feoh butan leafe befestað.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="20" corresp="#wit-h"><pb n="19" ed="#liebermann"/>XVIII. Be þon<ptr type="liebermannNote" n="1" target="#Rubrics-Af_20.lnote.oe.1"/> þe<ptr type="liebermannNote" n="5" target="#Rubrics-Af_20.lnote.oe.5"/> (man<ptr type="liebermannNote" n="5" target="#Rubrics-Af_20.lnote.oe.5"/>) munecum<ptr type="liebermannNote" n="6" target="#Rubrics-Af_20.lnote.oe.6"/> heora<ptr type="liebermannNote" n="3" target="#Rubrics-Af_20.lnote.oe.3-3"/> feoh buton<ptr type="liebermannNote" n="2" target="#Rubrics-Af_20.lnote.oe.2-2"/> leafe befæstað.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="20" corresp="#wit-q"><pb n="19" ed="#liebermann"/>De illis<ptr type="liebermannNote" n="2" target="#Rubrics-Af_20.lnote.oe.2"/> qui pecuniam committunt monachis sine<ptr type="liebermannNote" n="3" target="#Rubrics-Af_20.lnote.oe.3"/> licentia.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="190" ed="#jurasinski-and-oliver"/>XVIII Be ðam þe munecum heora feoh butan leafe befæstað</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="190" ed="#jurasinski-and-oliver"/>Be þam þe munecan heore feoh befæstað</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="19" ed="#liebermann"/>Von denen, die ihr Gut<ptr type="liebermannNote" n="1" target="#Rubrics-Af_20.lnote.de.1"/> Mönchen anvertrauen ohne Genehmigung [durch deren Oberen].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of those who entrust their property to monks without permission [from their superior].</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="191" ed="#jurasinski-and-oliver"/>Concerning someone who entrusts monks with their property without permission.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="191" ed="#jurasinski-and-oliver"/>Concerning someone who entrusts monks with their property</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_20.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">peccunia commissa monacho <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">peccunia commissa monacho Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_20.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">s. l. <hi rend="italic">fehlt Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. l. lacking in Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_20.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_20.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de">b. l. <hi rend="italic">fehlt So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">b. l. lacking in So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_20.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> þam</seg><seg type="translation" xml:lang="en" source="#claude">altered þam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_20.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. vom Schreiber</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above by the scribe</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_20.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_20.lnote.oe.3-3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_20.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_20.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Der Beginn aller Zahlen der Verso-Seiten ist durch den Einbinder verschnitten, was ich nicht im einzelnen bemerke.</hi></seg><seg type="translation" xml:lang="en" source="#claude">The beginning of all the numbers on the verso pages has been cropped by the binder; I do not note this in each case.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_20.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geändert durch andere Hd. in</hi> ðam</seg><seg type="translation" xml:lang="en" source="#claude">altered by another hand to ðam</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_20.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">= Fahrhabe; ‘nummum’ Lambarde; ‘cattle’ Price, beides zu eng</seg><seg type="translation" xml:lang="en" source="#claude">= movable goods; ‘nummum’ Lambarde; ‘cattle’ Price, both too narrow</seg></note>
      </div>
