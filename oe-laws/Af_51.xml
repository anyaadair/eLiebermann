      <div type="clause" n="51">
        <head><ref type="lawCode" target="law:Af">Af</ref> 51</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="51" corresp="#wit-e"><pb n="80" ed="#liebermann"/>Gif monnes<ptr type="liebermannNote" n="28" target="#Af_51.lnote.oe.28"/> ðrotbolla bið<ptr type="liebermannNote" n="29" target="#Af_51.lnote.oe.29"/> þyrel, gebete mid XII<ptr type="liebermannNote" n="27" target="#Af_51.lnote.oe.27"/> scill.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="51" corresp="#wit-h"><pb n="80" ed="#liebermann"/>Gif monnes<ptr type="liebermannNote" n="4" target="#Af_51.lnote.oe.4"/> ðrotbolla byð þyrel, gebete ðæt mid XII scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="51" corresp="#wit-b-no-prol"><pb n="80" ed="#liebermann"/>Gyf mannes ðrotbolla bið ðyrl, gebete mid twelf scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="51" corresp="#wit-q"><pb n="81" ed="#liebermann"/>Qui gurgulionem<ptr type="liebermannNote" n="25" target="#Af_51.lnote.oe.25"/> perforabit alicui, duodecim sol. emendet.<ptr type="liebermannNote" n="26" target="#Af_51.lnote.oe.26"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="86" ed="#attenborough"/>Gif monnes ðrotbolla bið þyrel, gebete<ptr type="editorNote" n="19" target="#Af_51.attnote.fn.19"/> mid XII scill.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="55" corresp="#wit-e"><pb n="352" ed="#jurasinski-and-oliver"/>Gif monnes ðrotbolla bið þyrel, gebete mid XII scill.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="81" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_51.lnote.de.1"/> jemandes Kehle<ptr type="liebermannNote" n="2" target="#Af_51.lnote.de.2"/> durchbohrt ist, büsse [der Verletzer] mit 12 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a person’s throat is pierced, let [the one who did it] pay 12 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="87" ed="#attenborough"/>If a man's throat<ptr type="editorNote" n="1" target="#Af_51.attnote.n.1"/> is pierced, 12 shillings shall be paid as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="353" ed="#jurasinski-and-oliver"/>If a man’s Adam’s apple is pierced, let him be paid 12 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_51.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">man. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">man. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_51.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">byþ ðyrl <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">byþ ðyrl Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_51.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">twelf <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">twelf Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_51.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_51.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">purg. <hi rend="italic">Hk;</hi> uel <hi rend="spaced">þrotebolla</hi> <hi rend="italic">fügt zu Hn</hi></seg><seg type="translation" xml:lang="en" source="#claude">purg. Hk; uel <hi rend="italic">þrotebolla</hi> added by Hn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_51.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">-detur <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-detur Hk</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_51.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Hn 93, 10 steht dem Or. näher als Q; er übernimmt das Agsä. Wort in den Text</seg><seg type="translation" xml:lang="en" source="#claude">Hn 93, 10 stands closer to the original than Q; he takes the Anglo-Saxon word over into his text</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_51.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Kehle. ‘<hi rend="italic">Gurgulio</hi> Luftröhre’ zu eng; <hi rend="italic">throat,</hi> dt. <hi rend="italic">drossel</hi> bed. den ganzen vorderen Hals</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Kehle. ‘<hi rend="italic">Gurgulio</hi> windpipe’ is too narrow; <hi rend="italic">throat,</hi> German <hi rend="italic">drossel</hi> means the whole front of the neck</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_51.attnote.fn.19" n="19" source="#attenborough"><bibl><biblScope unit="page">86</biblScope></bibl><label>gebete</label><seg type="original" xml:lang="en"><hi rend="italic">gebete ðæt</hi>. H.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_51.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">199</biblScope></bibl><seg type="original" xml:lang="en">Not merely the larynx. Thorpe translates ‘windpipe.’</seg></note>
      </div>
    </body>
