      <div type="clause" n="57.8">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 57.8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 57.8" corresp="#wit-lat"><pb n="576–577" ed="#liebermann"/>Pensandum autem erit omni domino, siue<ptr type="liebermannNote" n="t" target="#Hn_57-8.lnote.oe.t"/> socnam<ptr type="liebermannNote" n="36" target="#Hn_57-8.lnote.oe.36"/> [et<ptr type="liebermannNote" n="37" target="#Hn_57-8.lnote.oe.37"/>] sacam<ptr type="liebermannNote" n="38" target="#Hn_57-8.lnote.oe.38"/> habeat siue non<ptr type="liebermannNote" n="u" target="#Hn_57-8.lnote.oe.u"/> habeat, ut ita suum hominem ubique manuteneat, ne dampnum pro defensione<ptr type="liebermannNote" n="v" target="#Hn_57-8.lnote.oe.v"/> uel<ptr type="liebermannNote" n="39" target="#Hn_57-8.lnote.oe.39"/> pro demissione<ptr type="liebermannNote" n="40" target="#Hn_57-8.lnote.oe.40"/> dedecus incurrat, iuxta causarum modum et locum diffinitum, aliquando in diuisis<ptr type="liebermannNote" n="a" target="#Hn_57-8.lnote.oe.a"/> uel [m]erchimotis<ptr type="liebermannNote" n="1" target="#Hn_57-8.lnote.oe.1"/>, aliquando super ipsam<ptr type="liebermannNote" n="b" target="#Hn_57-8.lnote.oe.b"/> terram uicine, aliquando<ptr type="liebermannNote" n="2" target="#Hn_57-8.lnote.oe.2"/> in curia domini, aliquando in hundreto uel hundretis<ptr type="liebermannNote" n="c" target="#Hn_57-8.lnote.oe.c"/>, aliquando in comitatu<ptr type="liebermannNote" n="3" target="#Hn_57-8.lnote.oe.3"/> uel burgimoto<ptr type="liebermannNote" n="4" target="#Hn_57-8.lnote.oe.4"/> uel hallimoto<ptr type="liebermannNote" n="5" target="#Hn_57-8.lnote.oe.5"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 576–577 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 59, 19</seg><seg type="translation" xml:lang="en" source="#claude">cf. 59, 19</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">also auch der Gerichtsbarkeit nicht geniessende Herr Freier muss diesen beistehen und tritt so zwischen Staat und Hintersassen; vgl. Maitland</hi> Domesday 285</seg><seg type="translation" xml:lang="en" source="#claude">so even a lord of free men who does not enjoy jurisdiction must stand by them, and thus stands between the state and the tenants; cf. Maitland Domesday 285</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe.v" n="v" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 82, 4</seg><seg type="translation" xml:lang="en" source="#claude">cf. 82, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">socam <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">socam Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">siue <hi rend="italic">Hss. Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">siue MSS edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">saccam <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">saccam Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">uel p. d. <hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel p. d. missing Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">576</biblScope></bibl><seg type="original" xml:lang="de">dim. <hi rend="italic">bessern Wh Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">dim. emended by Wh Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 57, 1; merchimot <hi rend="italic">ist nur der Englische Terminus dafür.</hi> [<hi rend="italic">Für das Englisch-Schottische</hi> ‘Border meeting ad Marchiam’, <hi rend="italic">seit</hi> 13. <hi rend="italic">Jh., erblickt zwar eine Vorstufe in</hi> endemot (<hi rend="italic">auch</hi> hen., <hi rend="italic">von Dugdale</hi> ond. <hi rend="italic">gelesen</hi>) <hi rend="italic">J. Wilson</hi> Victoria hist. of Cumberland I 321. 325: <hi rend="italic">da liegt aber nur Verderbniss vor für</hi> hundredmot]</seg><seg type="translation" xml:lang="en" source="#claude">cf. 57, 1; merchimot is merely the English term for it. [For the Anglo-Scottish ‘Border meeting ad Marchiam’, from the 13th cent., J. Wilson Victoria hist. of Cumberland I 321. 325 does indeed see an earlier stage in endemot (also hen., read ond. by Dugdale): but that is merely a corruption of hundredmot]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 56, 4</seg><seg type="translation" xml:lang="en" source="#claude">cf. 56, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 48, 2<hi rend="italic">g</hi></seg><seg type="translation" xml:lang="en" source="#claude">see above 48, 2<hi rend="italic">g</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">in erchmio. [erth. <hi rend="italic">Wh Wi</hi>] <hi rend="italic">Sc Hg;</hi> in herimo. (herm. <hi rend="italic">Co Or</hi>) <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">in erchmio. [erth. Wh Wi] Sc Hg; in herimo. (herm. Co Or) Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">a. in c. d. <hi rend="italic">fehlt Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. in c. d. missing Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">comm. <hi rend="italic">Co Or oft</hi></seg><seg type="translation" xml:lang="en" source="#claude">comm. Co Or often</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">burgm. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">burgm. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">577</biblScope></bibl><seg type="original" xml:lang="de">halim. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">halim. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_57-8.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">324</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Vassallität 18; Gericht 11a; Gefolge 16a—<hi rend="italic">socam et</hi> (wie ich emendierte) <hi rend="italic">sa</hi>.—<hi rend="italic">uel p</hi>.{39} <hi rend="italic">d</hi>. fehlt—<hi rend="italic">in erch</hi>.{1}—<hi rend="italic">halim</hi>.—57, 8a <hi rend="italic">L. est e</hi>. Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Vassallität 18; Gericht 11a; Gefolge 16a—<hi rend="italic">socam et</hi> (as I emended) <hi rend="italic">sa</hi>.—<hi rend="italic">uel p</hi>.{39} <hi rend="italic">d</hi>. missing—<hi rend="italic">in erch</hi>.{1}—<hi rend="italic">halim</hi>.—57, 8a <hi rend="italic">L. est e</hi>. Rs</seg></note>
      </div>
