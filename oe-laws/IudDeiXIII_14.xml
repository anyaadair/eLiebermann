      <div type="clause" n="14">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 14</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 14" corresp="#wit-lat"><ptr type="liebermannNote" n="46" target="#IudDeiXIII_14.lnote.oe.46"/><pb n="424" ed="#liebermann"/>Post<ptr type="liebermannNote" n="47" target="#IudDeiXIII_14.lnote.oe.47"/> communionem uero<ptr type="liebermannNote" n="48" target="#IudDeiXIII_14.lnote.oe.48"/> exuat<ptr type="liebermannNote" n="49" target="#IudDeiXIII_14.lnote.oe.49"/> illos uestimentis suis et faciat<ptr type="liebermannNote" n="50" target="#IudDeiXIII_14.lnote.oe.50"/> illos per singulos osculari euangelium et crucem Christi<ptr type="liebermannNote" n="51" target="#IudDeiXIII_14.lnote.oe.51"/>, et postea<ptr type="liebermannNote" n="52" target="#IudDeiXIII_14.lnote.oe.52"/> aspergat unumquemque aqua benedicta et proiciat eos statim singulos in aquam.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 424 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_14.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">15. 15, 1 <hi rend="italic">fast gleich Zeu.</hi> 619&lt;sub&gt;7&lt;/sub&gt;. 654 <hi rend="italic">f. Vgl.</hi> I 23 <hi rend="italic">oben S.</hi> 405</seg><seg type="translation" xml:lang="en" source="#claude">15. 15, 1 almost identical with Zeu. 619&lt;sub&gt;7&lt;/sub&gt;. 654 f. Cf. I 23 above p. 405</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_14.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">has coniurationes et <hi rend="italic">fügt zu Tr;</hi> coniurationem <hi rend="italic">Zeumer</hi> 619. 654 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">has coniurationes et added by Tr; coniurationem Zeumer 619. 654 f.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_14.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_14.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">-antur <hi rend="italic">ohne</hi> i. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-antur without i. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_14.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">osculentur singuli eu. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">osculentur singuli eu. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_14.lnote.oe.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_14.lnote.oe.52" n="52" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">424</biblScope></bibl><seg type="original" xml:lang="de">sic aspersi a. b. proiciantur singuli in a. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic aspersi a. b. proiciantur singuli in a. Tr</seg></note>
