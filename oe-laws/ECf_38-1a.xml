  <text>
    <body>
      <div type="clause" n="38.1a">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 38.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 38.1a"><pb n="668" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_38-1a.lnote.oe.erkl-clause"/>Et si<ptr type="liebermannNote" n="26" target="#ECf_38-1a.lnote.la.26"/> uenditor non potest<ptr type="liebermannNote" n="27" target="#ECf_38-1a.lnote.la.27"/> habere plegios, retineatur cum pecunia<ptr type="liebermannNote" n="h" target="#ECf_38-1a.lnote.la.fn.h"/>, donec ueniat aut<ptr type="liebermannNote" n="28" target="#ECf_38-1a.lnote.la.28"/> dominus eius aut quilibet alius qui iuste possit<ptr type="liebermannNote" n="29" target="#ECf_38-1a.lnote.la.29"/> eum warantizare.</ab>
        <note type="comparison" source="#liebermann" n="668"><label>printed alongside</label> <ref target="clause:ECfRetr_38-1a">ECf retr 38.1a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 668 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-1a.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">Fahrhabe, <hi rend="italic">zunächst</hi> Vieh, <hi rend="italic">was Retr. in</hi> censu (Geld) <hi rend="italic">zu eng fasst</hi></seg><seg type="translation" xml:lang="en" source="#claude">movable goods, in the first place cattle, which the Retr. takes too narrowly as censu (money)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-1a.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-1a.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">poterit <hi rend="italic">Hk;</hi> poterat <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">poterit Hk; poterat Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-1a.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk S</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-1a.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">668</biblScope></bibl><seg type="original" xml:lang="de">e. p. guar. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. p. guar. Hk</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And if the seller cannot have pledges, let him be detained with the goods, until either his lord comes or anyone else who can justly warrant him.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-1a.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">350</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Vassallität 18a. 19a; Gefolge 16f.; Bürgschaft 13 — <hi rend="italic">alter</hi><hi rend="superscript">29</hi> <hi rend="italic">q. b. p. e.</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">Cf. <hi rend="italic">Gl</hi> Vassallität 18a. 19a; Gefolge 16f.; Bürgschaft 13 — <hi rend="italic">alter</hi><hi rend="superscript">29</hi> <hi rend="italic">q. b. p. e.</hi> Rs</seg></note>
      </div>
    </body>
