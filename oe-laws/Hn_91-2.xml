      <div type="clause" n="91.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 91.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 91.2" corresp="#wit-lat"><pb n="607" ed="#liebermann"/>Si murdrum<ptr type="liebermannNote" n="13" target="#Hn_91-2.lnote.oe.13"/> in domo uel in curia uel in<ptr type="liebermannNote" n="14" target="#Hn_91-2.lnote.oe.14"/> claustura<ptr type="liebermannNote" n="15" target="#Hn_91-2.lnote.oe.15"/> inueniatur, cum<ptr type="liebermannNote" n="16" target="#Hn_91-2.lnote.oe.16"/> ad premissam XL et<ptr type="liebermannNote" n="14" target="#Hn_91-2.lnote.oe.14"/> VI marcarum reddicionem peruenietur, primo<ptr type="liebermannNote" n="17" target="#Hn_91-2.lnote.oe.17"/> quicquid in ipso manerio est, in<ptr type="liebermannNote" n="18" target="#Hn_91-2.lnote.oe.18"/> annona uiridi et sicca, in animalibus et in omnibus omnino<ptr type="liebermannNote" n="19" target="#Hn_91-2.lnote.oe.19"/>, primo<ptr type="liebermannNote" n="20" target="#Hn_91-2.lnote.oe.20"/> uendatur usque ad olera.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 607 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_91-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de">acciderit <hi rend="italic">fügt (aus vor. Zeile) zu, unterpunctirt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">acciderit added (from the preceding line), dotted for deletion Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_91-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_91-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de">claustra <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">claustra K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_91-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de">tum <hi rend="italic">Edd. gegen Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">tum edd. against MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_91-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de">promo <hi rend="italic">Wh Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">promo Wh Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_91-2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">doppelt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">written twice Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_91-2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Punkt Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">full stop edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_91-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so nochmals</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus again</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_91-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de">Am Rande spät: <hi rend="italic">Quoddam genus mirabile de murdro</hi>, wegen Pfändung (<hi rend="italic">Gl</hi> 4b) unreifen Getreides; anders <hi rend="italic">Gl</hi> Ernte 2—<hi rend="italic">et</hi>{14} fehlt—91, 2a <hi rend="italic">et</hi>{21} fehlt—<hi rend="italic">exigatur</hi>—<hi rend="italic">ab hundreto</hi> besser Rs</seg><seg type="translation" xml:lang="en" source="#claude">In the margin, in a late hand: <hi rend="italic">Quoddam genus mirabile de murdro</hi>, on account of the distraint (<hi rend="italic">Gl</hi> 4b) of unripe grain; a different view in <hi rend="italic">Gl</hi> Ernte 2—<hi rend="italic">et</hi>{14} missing—91, 2a <hi rend="italic">et</hi>{21} missing—<hi rend="italic">exigatur</hi>—<hi rend="italic">ab hundreto</hi> better Rs</seg></note>
      </div>
