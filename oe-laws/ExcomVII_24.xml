      <div type="clause" n="24">
        <head><ref type="lawCode" target="law:ExcomVII">Excom VII</ref> 24</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Excom VII 24" corresp="#wit-cx"><pb n="439" ed="#liebermann"/>Eall folc cweðe: ‘soð hit si, gewurþe þæt!’<ptr type="liebermannNote" n="1" target="#ExcomVII_24.lnote.oe.1"/></ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="439" ed="#liebermann"/>24. Alles Volk<ptr type="liebermannNote" n="c" target="#ExcomVII_24.lnote.de1.c"/> spreche: ‘Wahr sei es, geschehe das!’</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">24. Let all the people say: ‘True be it, may that come to pass!’</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text and German translation transcribed from Gesetze I p. 439 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVII_24.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">439</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgen Sätze über</hi> Achitofel <hi rend="italic">Cx</hi></seg><seg type="translation" xml:lang="en" source="#claude">there follow sentences about Achitofel <hi rend="italic">Cx</hi></seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="ExcomVII_24.lnote.de1.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">439</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> I 13</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> I 13</seg></note>
      </div>
