      <div type="clause" n="2.1">
        <head><ref type="lawCode" target="law:IudDeiIII">Iud Dei III</ref> 2.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei III 2.1" corresp="#wit-lat"><pb n="408" ed="#liebermann"/>praesta, quaesumus, per sanctum ac<ptr type="liebermannNote" n="35" target="#IudDeiIII_2-1.lnote.oe.35"/> mirabile nomen tuum, ut qui reus<ptr type="liebermannNote" n="36" target="#IudDeiIII_2-1.lnote.oe.36"/> est<ptr type="liebermannNote" n="37" target="#IudDeiIII_2-1.lnote.oe.37"/> huius<ptr type="liebermannNote" n="38" target="#IudDeiIII_2-1.lnote.oe.38"/> furti — uel homicidii aut adulterii seu maleficii —, de quo<ptr type="liebermannNote" n="39" target="#IudDeiIII_2-1.lnote.oe.39"/> hic<ptr type="liebermannNote" n="40" target="#IudDeiIII_2-1.lnote.oe.40"/> requiritur, uel in facto uel in conscientia, ad adpositam ei<ptr type="liebermannNote" n="41" target="#IudDeiIII_2-1.lnote.oe.41"/> pro ostensione ueritatis creaturam panis<ptr type="liebermannNote" n="42" target="#IudDeiIII_2-1.lnote.oe.42"/> sanctificati uel casei faux<ptr type="liebermannNote" n="43" target="#IudDeiIII_2-1.lnote.oe.43"/> eius<ptr type="liebermannNote" n="44" target="#IudDeiIII_2-1.lnote.oe.44"/> claudatur, guttur eius stranguletur, et in nomine tuo ante illud reiciatur<ptr type="liebermannNote" n="45" target="#IudDeiIII_2-1.lnote.oe.45"/> quam deuoretur<ptr type="liebermannNote" n="45" target="#IudDeiIII_2-1.lnote.oe.45"/>,</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 408 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-1.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">admirabile <hi rend="italic">Ci;</hi> ammir. <hi rend="italic">Vt;</hi> et admir. <hi rend="italic">Rj Ch Ca H;</hi> et mir. <hi rend="italic">Parker</hi></seg><seg type="translation" xml:lang="en" source="#claude">admirabile Ci; ammir. Vt; et admir. Rj Ch Ca H; et mir. Parker</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-1.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">-i <hi rend="italic">übergeschr. Rj H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-i written above in Rj H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-1.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">uel sunt <hi rend="italic">übergeschr. Rj H;</hi> uel reae sunt <hi rend="italic">übergeschr. Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel sunt written above in Rj H; uel reae sunt written above in Vt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-1.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">hu. — malef. <hi rend="italic">am Rande H</hi></seg><seg type="translation" xml:lang="en" source="#claude">hu. — malef. in the margin in H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-1.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">hoc cuius inquisitio agitur <hi rend="italic">statt</hi> quo h. r. <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">hoc cuius inquisitio agitur instead of quo h. r. H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-1.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">nunc <hi rend="italic">fügt zu Ch Par.</hi></seg><seg type="translation" xml:lang="en" source="#claude">nunc added in Ch Par.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-1.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">-is <hi rend="italic">übergeschr. Rj H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-is written above in Rj H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-1.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">beginnt Abschrift</hi> 16. <hi rend="italic">Jhs. Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">here begins the 16th-cent. transcript Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-1.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">-ces eorum -n-ra eorum -n- <hi rend="italic">übergeschr. Rj H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ces eorum -n-ra eorum -n- written above in Rj H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-1.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">constringantur fauces et guttur eius claudatur, antea reuomat <hi rend="italic">Zeu.</hi> 633 <hi rend="italic">f.</hi> 647. 681; fauces et guttur constricti <hi rend="italic">Zeu.</hi> 671<hi rend="italic">g</hi></seg><seg type="translation" xml:lang="en" source="#claude">constringantur fauces et guttur eius claudatur, antea reuomat Zeu. 633 f. 647. 681; fauces et guttur constricti Zeu. 671g</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_2-1.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">-n- <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-n- written above in H</seg></note>
      </div>
    </body>
