      <div type="clause" n="3.2">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 3.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-hk"><pb n="496–497" ed="#liebermann"/>E en Westsexenelahe C sol., XX sol. al clamif pur la teste e IIII lib. al rei.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-i"><pb n="496–497" ed="#liebermann"/>En Westsexenelae cent solz, . . . .<ptr type="liebermannNote" n="1" target="#LeisWl_3-2.lnote.oe.1"/> al clamur pur la teste<ptr type="liebermannNote" n="2" target="#LeisWl_3-2.lnote.oe.2"/> e IIII livres<ptr type="liebermannNote" n="3" target="#LeisWl_3-2.lnote.oe.3"/> al rei.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="496–497" ed="#liebermann"/>Iuxta Westsaxenelahe in tali casu dabit C solid., . . .<ptr type="liebermannNote" n="a" target="#LeisWl_3-2.lnote.oe.a"/> pro capite illi qui clamium prosecutus est, et regi IIII libr.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="3.2" corresp="#wit-hk"><pb n="254" ed="#robertson"/>E en Westsexenelahe C sol., XX sol. al clamif pur la teste, e IIII lib. al rei.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="496–497" ed="#liebermann"/>3, 2. Und im Westsachsen-Rechtsgebiet 100 Schilling: 20 Schilling dem Kläger statt des Kopfs [des Angeklagten] und 4 £ dem König.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">3, 2. And in the West Saxon legal district 100 shillings: 20 shillings to the plaintiff in place of the head [of the accused] and 4 £ to the king.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-hk"><pb n="255" ed="#robertson"/>And in the province of Wessex 100 shillings shall be paid—20 shillings to the plaintiff in lieu of the head [of the accused man] and £4 to the King.</ab>
        <note type="editorial">Added October 2026 from Robertson pp. 254–255 (text and translation); Liebermann’s text and German translation added from Gesetze I p. 496–497, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_3-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">496</biblScope></bibl><seg type="original" xml:lang="de">XX s. <hi rend="italic">fehlt auch L</hi></seg><seg type="translation" xml:lang="en" source="#claude">XX s. also missing in L</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_3-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">496</biblScope></bibl><seg type="original" xml:lang="de">test <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">test Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_3-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">496</biblScope></bibl><seg type="original" xml:lang="de">liueres <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">liueres Im</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_3-2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">497</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> XX sol.</seg><seg type="translation" xml:lang="en" source="#claude">supply XX sol.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_3-2.lnote.de._" n="-" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">287</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Strafgeldfixum 15</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Strafgeldfixum 15</seg></note>
      </div>
