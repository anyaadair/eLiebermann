        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="63" corresp="#wit-e"><pb n="26" ed="#liebermann"/>CVII. Be gesiðcundes monnes fære.<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_63.lnote.oe.1"/></ab>
