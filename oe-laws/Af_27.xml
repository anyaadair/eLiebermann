        <note type="liebermannNote" subtype="textual" xml:id="Af_27.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">on gefeohte mon of. <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">on gefeohte mon of. So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">he <hi rend="italic">fügt zu So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">he added by So Ld</seg></note>
