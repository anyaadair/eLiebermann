      <div type="clause" n="11.1 B 3">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 11.1 B 3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 11.1 B 3"><pb n="636" ed="#liebermann"/>Uicarius<ptr type="liebermannNote" n="l" target="#ECf_11-1-B-3.lnote.la.fn.l"/> uero Dei estis in regno iuxta psalmistam<ptr type="liebermannNote" n="16" target="#ECf_11-1-B-3.lnote.la.16"/> regem: ‘Domini est terra et plenitudo eius orbis terrarum et uniuersi qui habitant<ptr type="liebermannNote" n="17" target="#ECf_11-1-B-3.lnote.la.17"/> in eo’; et rursum iuxta psalmistam<ptr type="liebermannNote" n="16" target="#ECf_11-1-B-3.lnote.la.16"/> regem: ‘Dilexisti iustitiam et odisti iniquitatem; propterea unxit te Deus<ptr type="liebermannNote" n="18" target="#ECf_11-1-B-3.lnote.la.18"/> Deus tuus oleo letitie pre consortibus<ptr type="liebermannNote" n="19" target="#ECf_11-1-B-3.lnote.la.19"/> tuis’; et rursum iuxta psalmistam<ptr type="liebermannNote" n="16" target="#ECf_11-1-B-3.lnote.la.16"/> regem: ‘Deus, iudicium tuum’ etc. Non enim dixit<ptr type="liebermannNote" n="20" target="#ECf_11-1-B-3.lnote.la.20"/>: ‘iudicium neque iustitiam Cesaris’.</ab>
        <note type="comparisonPrinted" source="#liebermann">Ps. 23, 1</note>
        <note type="comparisonPrinted" source="#liebermann">Ps. 44, 8</note>
        <note type="comparisonPrinted" source="#liebermann">Ps. 71, 2</note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 636 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">This passage is not part of ECf or ECf retr: it is one of the additions of the London collection (Leges Anglorum s. XIII in. Londoniis collectae), which Liebermann prints in smaller type across the page, under ECf retr. 11, 1, and numbers 11, 1 A ff. The dictionary cites it as “ECf 11, 1 A …”, so it is kept with ECf here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1-B-3.lnote.la.fn.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 11, 1 A (<hi rend="italic">aus</hi> ECf. 17)</seg><seg type="translation" xml:lang="en" source="#claude">cf. 11, 1 A (from ECf. 17)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1-B-3.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de">psā <hi rend="italic">Hss. stets;</hi> prophetam <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">psā the MSS always; prophetam Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1-B-3.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de">inhabitant <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">inhabitant Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1-B-3.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1-B-3.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de">co[mitantibus] te <hi rend="italic">K</hi> [<hi rend="italic">Riley</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">co[mitantibus] te K [Riley]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1-B-3.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">636</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co Or Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Co Or Ld</seg></note>
      </div>
