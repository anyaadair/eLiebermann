      <div type="clause" n="26">
        <head>Ine Rb 26</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="26" corresp="#wit-e"><pb n="22" ed="#liebermann"/>LXX. Be fundenes cildes fostre.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="26" corresp="#wit-g-prol"><pb n="22" ed="#liebermann"/>LXX. Be fundenes cildes fostre.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="26" corresp="#wit-h"><pb n="23" ed="#liebermann"/>LXX. Be fundenes cildes fostre.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="26" corresp="#wit-q"><pb n="23" ed="#liebermann"/>De nutricatura<ptr type="liebermannNote" n="10" target="#Rubrics-Ine_26.lnote.oe.10"/> inuenti pueri.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="204" ed="#jurasinski-and-oliver"/>LXX Be fundenes cildes foster</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="204" ed="#jurasinski-and-oliver"/>Be fundenes cildes fostre</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="23" ed="#liebermann"/>Von Nahrungspflege<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_26.lnote.de.1"/> für ein gefundenes Kind.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of the fostering of a foundling child.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="205" ed="#jurasinski-and-oliver"/>Concerning the fostering of a foundling</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="205" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_26.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">nutritura <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">nutritura Hk Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_26.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Q’s <hi rend="italic">nutricatura</hi> aus Fränk. Recht</seg><seg type="translation" xml:lang="en" source="#claude">Q’s <hi rend="italic">nutricatura</hi> comes from Frankish law</seg></note>
