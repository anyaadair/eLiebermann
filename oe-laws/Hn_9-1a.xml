      <div type="clause" n="9.1a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 9.1a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 9.1a" corresp="#wit-lat"><pb n="554" ed="#liebermann"/>Omnes uero cause<ptr type="liebermannNote" n="p" target="#Hn_9-1a.lnote.oe.p"/><ptr type="liebermannNote" n="36" target="#Hn_9-1a.lnote.oe.36"/> simplices<ptr type="liebermannNote" n="q" target="#Hn_9-1a.lnote.oe.q"/><ptr type="liebermannNote" n="37" target="#Hn_9-1a.lnote.oe.37"/> sunt aut coniuncte, et in manifestacione<ptr type="liebermannNote" n="r" target="#Hn_9-1a.lnote.oe.r"/><ptr type="liebermannNote" n="38" target="#Hn_9-1a.lnote.oe.38"/> consistunt uel in accusacione.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 554 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-1a.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt</hi> 20, 1<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">repeated 20, 1a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-1a.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur Einen Gerichtsherrn angehend oder</hi> utrumque spectantes 9, 5</seg><seg type="translation" xml:lang="en" source="#claude">concerning only one lord of a court, or utrumque spectantes 9, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-1a.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de">‘handhaft’ [Ine 37], 9, 6 in actu <hi rend="italic">auch im Gegensatz zu</hi> sola tihla: ‘Inzicht’</seg><seg type="translation" xml:lang="en" source="#claude">‘caught in the act’ [Ine 37], 9, 6 in actu, also in contrast to sola tihla: ‘accusation’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-1a.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de">cāe <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">cāe Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-1a.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de">multipl. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">multipl. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_9-1a.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de">manifēne, <hi rend="italic">Corr. fügt</hi> sta <hi rend="italic">ein Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">manifēne, corrector inserts sta Sc</seg></note>
      </div>
