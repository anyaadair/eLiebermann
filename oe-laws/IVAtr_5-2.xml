    <body>
      <div type="clause" n="5.2">
        <head><ref type="lawCode" target="law:IVAtr">IV Atr</ref> 5.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.2" corresp="#wit-q"><pb n="234" ed="#liebermann"/>Et si aliquis eorum accusetur, sit<ptr type="liebermannNote" n="51" target="#IVAtr_5-2.lnote.oe.51"/> Anglicus sit transmarinus, ladiet se pleno ordalio.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="5.2" corresp="#wit-q"><pb n="74" ed="#robertson"/>Et si aliquis eorum accusetur, sit<ptr type="editorNote" n="14" target="#IVAtr_5-2.robnote.fn.14"/> Anglicus sit transmarinus, ladiet se pleno ordalio.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="235" ed="#liebermann"/>Und wenn einer von diesen [dreien] angeklagt wird, sei es ein Engländer, sei es ein Überseeischer<ptr type="liebermannNote" n="1" target="#IVAtr_5-2.lnote.de.1"/>, reinige er sich durch volles<ptr type="liebermannNote" n="2" target="#IVAtr_5-2.lnote.de.2"/> Ordal.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if one of these [three] is accused, whether an Englishman or a man from overseas, let him clear himself by the full ordeal.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q"><pb n="75" ed="#robertson"/>And if one of them is accused, whether he be an Englishman or a foreigner, he shall clear himself by the full ordeal<ptr type="editorNote" n="1" target="#IVAtr_5-2.robnote.n.1"/>.</ab>
        <note type="comparison" source="#liebermann" n="235"><ref target="clause:IIAs_14-1">II As 14.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. II As. 14, 1</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IVAtr_7-1">IV Atr 7.1</ref>; <ref target="clause:IVAtr_7-3">IV Atr 7.3</ref></note>
        <note type="editorial">Liebermann compares II As 14.1.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_5-2.lnote.oe.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">234</biblScope></bibl><seg type="original" xml:lang="de">si <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">si R</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_5-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">166</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ofersæwisc, ofersælic</hi> (Toller) heisst ‘festländisch’, was hier gemeint ist</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">ofersæwisc, ofersælic</hi> (Toller) means ‘continental’, which is what is meant here</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_5-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">166</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">full</hi> hatte Orig., was im Sinne von ‘vollständig’ vor <hi rend="italic">lad</hi> vorkommt; hier ‘dreifach’ III Atr 8. <hi rend="italic">Vgl</hi>. Münzfälschung 6; Ordal 33d</seg><seg type="translation" xml:lang="en" source="#claude">The orig. had <hi rend="italic">full</hi>, which occurs before <hi rend="italic">lad</hi> in the sense of ‘complete’; here ‘threefold’, III Atr 8. <hi rend="italic">Cf</hi>. Münzfälschung 6; Ordal 33d</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_5-2.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">326</biblScope></bibl><seg type="original" xml:lang="en">From III, 8 it would seem that this expression means the triple ordeal.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_5-2.robnote.fn.14" n="14" source="#robertson"><bibl><biblScope unit="page">74</biblScope></bibl><label>sit</label><seg type="original" xml:lang="en"><hi rend="italic">si</hi> R.</seg></note>
      </div>
    </body>
