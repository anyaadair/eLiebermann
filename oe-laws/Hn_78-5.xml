      <div type="clause" n="78.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 78.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 78.5" corresp="#wit-lat"><pb n="595" ed="#liebermann"/>De inuentis et pauperibus<ptr type="liebermannNote" n="c" target="#Hn_78-5.lnote.oe.c"/> et abiectis positum est, si quis eos occidat — eque<ptr type="liebermannNote" n="4" target="#Hn_78-5.lnote.oe.4"/> si<ptr type="liebermannNote" n="d" target="#Hn_78-5.lnote.oe.d"/> parentes repetentes wera, wita, manbota, sicut iustum, accidentia fecerit —, persoluantur uel in taschis<ptr type="liebermannNote" n="e" target="#Hn_78-5.lnote.oe.e"/><ptr type="liebermannNote" n="5" target="#Hn_78-5.lnote.oe.5"/> uel huiusmodi<ptr type="liebermannNote" n="6" target="#Hn_78-5.lnote.oe.6"/> suggerendis<ptr type="liebermannNote" n="7" target="#Hn_78-5.lnote.oe.7"/>, sicut<ptr type="liebermannNote" n="8" target="#Hn_78-5.lnote.oe.8"/> de b[a]st[ar]dis<ptr type="liebermannNote" n="9" target="#Hn_78-5.lnote.oe.9"/> est<ptr type="liebermannNote" n="10" target="#Hn_78-5.lnote.oe.10"/> institutum, quos<ptr type="liebermannNote" n="11" target="#Hn_78-5.lnote.oe.11"/> parentes sui diuites ac domini multa sinunt<ptr type="liebermannNote" n="12" target="#Hn_78-5.lnote.oe.12"/> in progenies egestate mendicos<ptr type="liebermannNote" n="13" target="#Hn_78-5.lnote.oe.13"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 595 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-5.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 10, 3. 21</seg><seg type="translation" xml:lang="en" source="#claude">cf. 10, 3. 21</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-5.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">ebenso [und ferner] wenn Wergeld, Strafgeld, Mannenbusse, von Rechtswegen anfallend, die Verwandten (oder Herren <hi rend="italic">zu ergänzen</hi>) zu Klägern macht</seg><seg type="translation" xml:lang="en" source="#claude">likewise [and further] if wergild, fine and manbot, accruing by right, make the kinsmen (or lords, to be supplied) plaintiffs</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-5.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">[<hi rend="italic">leeren</hi>] Beuteln (Geldtaschen) <hi rend="italic">als Scheinbusse; vgl.</hi> 90, 7<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">[empty] purses (money-bags) as a token compensation; cf. 90, 7a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-5.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">eumque <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">eumque Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-5.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">tha. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">tha. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-5.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">huius <hi rend="italic">Lond Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">huius Lond Edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-5.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">-dum <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dum Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-5.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-5.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">beldstotis <hi rend="italic">Lond;</hi> bledstodiis <hi rend="italic">Sc Hg</hi> [blods. <hi rend="italic">Wh Wi</hi>]. <hi rend="italic">Verf. vergass</hi> r <hi rend="italic">und schrieb beide</hi> a <hi rend="italic">so undeutlich, dass Archetyp das zweite als</hi> o <hi rend="italic">las und das erste als</hi> el, <hi rend="italic">letzteres durch übergeschriebenes</hi> a <hi rend="italic">corrigirend, das die Schreiber für</hi> d <hi rend="italic">hielten. Sie dachten vielleicht an</hi> belistre ‘<hi rend="italic">Bettler, Lump</hi>’</seg><seg type="translation" xml:lang="en" source="#claude">beldstotis Lond; bledstodiis Sc Hg [blods. Wh Wi]. The author omitted r and wrote both a’s so indistinctly that the archetype read the second as o and the first as el, correcting the latter with an a written above, which the scribes took for d. They were perhaps thinking of belistre ‘beggar, rascal’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-5.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">statutum est <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">statutum est Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-5.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">K Or;</hi> quo <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod K Or; quo Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-5.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">sint <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sint Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-5.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">med. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">med. Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-5.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">327</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Bastard 6; Scheinbusse 1; bei anderen Germanen: Grimm <hi rend="italic">DRA</hi> 677; er führt in jenem Sinne Handschuhe, kleinste Münze an; Geldbeutel bildet oft die fast wertlose Zugabe (<hi rend="italic">s. d. Gl</hi> 2b) zur Hauptsumme; z. B. <hi rend="italic">klein frevel: 40 hlr + 1 umb ein beitelin</hi>; Grimm <hi rend="italic">Weistümer</hi> VI 280. Houard (<hi rend="italic">Cout. Agnorm</hi>. I 348) erklärt <hi rend="italic">taschis</hi>: ‘deniers comptants’ falsch.—<hi rend="italic">tha</hi>.{5}—<hi rend="italic">beldstotis</hi>{9} <hi rend="italic">in. est, quod</hi>—<hi rend="italic">sint</hi>{12}—78, 5b <hi rend="italic">sunt</hi>{17}—78, 6 <hi rend="italic">emendat</hi>{20} <hi rend="italic">p. f</hi>. ohne <hi rend="italic">eius</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Bastard 6; Scheinbusse 1; among other Germanic peoples: Grimm <hi rend="italic">DRA</hi> 677; he cites gloves and the smallest coin in that sense; a purse often forms the almost worthless addition (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 2b) to the principal sum; e.g. <hi rend="italic">klein frevel: 40 hlr + 1 umb ein beitelin</hi>; Grimm <hi rend="italic">Weistümer</hi> VI 280. Houard (<hi rend="italic">Cout. Agnorm</hi>. I 348) wrongly explains <hi rend="italic">taschis</hi> as ‘deniers comptants’.—<hi rend="italic">tha</hi>.{5}—<hi rend="italic">beldstotis</hi>{9} <hi rend="italic">in. est, quod</hi>—<hi rend="italic">sint</hi>{12}—78, 5b <hi rend="italic">sunt</hi>{17}—78, 6 <hi rend="italic">emendat</hi>{20} <hi rend="italic">p. f</hi>. without <hi rend="italic">eius</hi> Rs</seg></note>
      </div>
