      <div type="clause" n="58">
        <head>Ine Rb 58</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="58" corresp="#wit-e"><pb n="24" ed="#liebermann"/>CII. Be<ptr type="liebermannNote" n="***" target="#Rubrics-Ine_58.lnote.oe.star3"/> oxan horne.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="58" corresp="#wit-g-prol"><pb n="24" ed="#liebermann"/>CII. Be oxan horne.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="58" corresp="#wit-h"><pb n="25" ed="#liebermann"/>CII. Be oxan horne.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="58" corresp="#wit-q"><pb n="25" ed="#liebermann"/>De<ptr type="liebermannNote" n="27" target="#Rubrics-Ine_58.lnote.oe.27"/> cornu<ptr type="liebermannNote" n="28" target="#Rubrics-Ine_58.lnote.oe.28"/> bouis.<ptr type="liebermannNote" n="29" target="#Rubrics-Ine_58.lnote.oe.29"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="212" ed="#jurasinski-and-oliver"/>CII Be oxan horne</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="25" ed="#liebermann"/>Vom<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_58.lnote.de.1"/> Ochsenhorne.<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_58.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of an ox’s horn.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="213" ed="#jurasinski-and-oliver"/>Concerning an ox’s horn</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_58.lnote.oe.star3" n="***" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">24</biblScope></bibl><seg type="original" xml:lang="de">Be neatum <hi rend="italic">So</hi>; Be oxan <hi rend="italic">Ld statt Rb.</hi> 58. 59</seg><seg type="translation" xml:lang="en" source="#claude">Be neatum So; Be oxan Ld instead of Rb. 58. 59</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_58.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">Et de <hi rend="italic">T</hi>; emendatione <hi rend="italic">fügt zu Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et de T; emendatione added by Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_58.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">vel cauda vel oculo <hi rend="italic">fügt zu Hk</hi>; vel oculi <hi rend="italic">fügt zu Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">vel cauda vel oculo added by Hk; vel oculi added by Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_58.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">vel vaccæ <hi rend="italic">fügt zu Hk Br, wo Rb.</hi> 59 <hi rend="italic">fehlt</hi></seg><seg type="translation" xml:lang="en" source="#claude">vel vaccæ added by Hk Br, where Rb. 59 is lacking</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_58.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Q spät. Rez. vervollständigt die Rb aus seinem Text</seg><seg type="translation" xml:lang="en" source="#claude">The later recension of Q completes the Rb from its own text</seg><note type="remark" resp="#claude">On several rubrics: Ine Rb 40. 43f. 46—50. 54. 56f. 58. 61f. 67. 70f.</note></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_58.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘Von Rindern’ So; ‘von Ochsen’ Ld</seg><seg type="translation" xml:lang="en" source="#claude">‘Of cattle’ So; ‘of oxen’ Ld</seg></note>
      </div>
