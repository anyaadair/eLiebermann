      <div type="clause" n="88.13">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 88.13</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 88.13" corresp="#wit-lat"><pb n="604" ed="#liebermann"/>Si<ptr type="liebermannNote" n="b" target="#Hn_88-13.lnote.oe.b"/> quis propter<ptr type="liebermannNote" n="19" target="#Hn_88-13.lnote.oe.19"/> faidiam uel causam aliquam de parentela se uelit tollere et eam forisiurauerit<ptr type="liebermannNote" n="20" target="#Hn_88-13.lnote.oe.20"/> et de societate et hereditate et tota illius ratione<ptr type="liebermannNote" n="21" target="#Hn_88-13.lnote.oe.21"/> se separet<ptr type="liebermannNote" n="22" target="#Hn_88-13.lnote.oe.22"/>, si postea aliquis de parentibus suis<ptr type="liebermannNote" n="23" target="#Hn_88-13.lnote.oe.23"/> abiuratis moriatur uel occidatur, nichil ad eum de hereditate uel compositione pertineat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 604 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-13.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Geltung für England bezweifeln Pollock and Maitland</hi> HEL. I 87</seg><seg type="translation" xml:lang="en" source="#claude">Pollock and Maitland HEL. I 87 doubt its validity for England</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-13.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">per faldiam <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">per faldiam K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-13.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">fori iu. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">fori iu. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-13.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">se r. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">se r. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-13.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">seperaret <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">seperaret Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-13.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht in Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">not in Sc Hg</seg></note>
