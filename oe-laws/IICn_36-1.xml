      <div type="clause" n="36.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 36.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.1" corresp="#wit-g-a"><pb n="338" ed="#liebermann"/>⁊ na<ptr type="liebermannNote" n="9" target="#IICn_36-1.lnote.oe.9-2"/> beo he þanon forð aðes wyrðe, butan<ptr type="liebermannNote" n="10" target="#IICn_36-1.lnote.oe.10"/> he for Gode<ptr type="liebermannNote" n="11" target="#IICn_36-1.lnote.oe.11-2"/> þe deoppar gebete ⁊ him borh finde, þ<hi rend="italic">æt</hi> he æfre eft<ptr type="liebermannNote" n="12" target="#IICn_36-1.lnote.oe.12-2"/> swylces geswice.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.1" corresp="#wit-b"><pb n="338" ed="#liebermann"/>⁊ ne beo ðanon forþ<ptr type="liebermannNote" n="1" target="#IICn_36-1.lnote.oe.1"/> aðes wyrðe, buton he for God ðe deoppor gebete ⁊ him borh finde, þ<hi rend="italic">æt</hi> he æfre eft swylces geswice.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.1" corresp="#wit-a"><pb n="338" ed="#liebermann"/>⁊ ne beo he þanon forð aðes wyrðe, buton he for Gode þe deopor gebete ⁊ him borh finde, þ<hi rend="italic">æt</hi> he æfre æft swylces geswice.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="36.1" corresp="#wit-q"><pb n="339" ed="#liebermann"/>Et non habeatur deinceps iuratione dignus, nisi<ptr type="liebermannNote" n="3" target="#IICn_36-1.lnote.oe.3"/> (si non<ptr type="liebermannNote" n="11" target="#IICn_36-1.lnote.oe.11"/>) erga Deum profundius emendet et plegios inueniat, quod semper in reliquum de<ptr type="liebermannNote" n="12" target="#IICn_36-1.lnote.oe.12"/> talibus cesset.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36.1" corresp="#wit-inst-cn"><pb n="339" ed="#liebermann"/>Et post hoc non sit dignus iuramenti, quod Angli dicunt aðes þyrðe<ptr type="liebermannNote" n="8" target="#IICn_36-1.lnote.oe.8"/>, nisi altius Deo satisfaciat et fideiussores inueniat, quod amplius cessauerit.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="36.1" corresp="#wit-cons-cn"><pb n="339" ed="#liebermann"/>Nec sit deinceps iuramento dignus, nisi erga Deum plene satisfecerit et fideiussorem dederit, se deinceps ab huiusmodi obseruaturum.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="36.1" corresp="#wit-b"><pb n="194" ed="#robertson"/>⁊ ne beo ðanon forþ aðes wyrðe, buton he for God ðe deoppor gebete ⁊ him borh finde, þæt he æfre eft swylces geswice.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="274" ed="#rabin-doml"/>And na beo he þanon forð aðes wyrðe, butan he for Gode þe deoppar gebete and him borh finde þæt he æfre eft swylces geswice.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="338" ed="#liebermann"/>Und nicht<ptr type="liebermannNote" n="1" target="#IICn_36-1.lnote.de.1"/> sei er hinfort Eides würdig,<ptr type="liebermannNote" n="*" target="#IICn_36-1.lnote.de1.star"/> ausser wenn er kirchlich um so tiefer büsst und Bürgschaft für sich findet, dass er später stets solchen [Meineides] sich enthalten<ptr type="liebermannNote" n="2" target="#IICn_36-1.lnote.de.2"/> werde.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let him not be oath-worthy thereafter, unless he atones all the more deeply before God and finds a surety that he will always refrain from such [perjury] afterwards.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="195" ed="#robertson"/>And henceforth<ptr type="editorNote" n="1" target="#IICn_36-1.robnote.n.1"/> he shall not be entitled to swear an oath, unless he makes amends to the best of his ability before God, and finds surety that ever afterwards he will desist from such [perjury].</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="467" ed="#whitelock"/>And from thenceforth he is not to be entitled to an oath, unless he atones for it very deeply with God, and finds surety for himself that he will desist from such ever afterwards.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="275" ed="#rabin-doml"/>And thenceforth, he shall not be considered worthy to swear an oath, unless he repents most sincerely before God and appoints a surety to guarantee that he will afterward cease from such perjury.</ab>
        <note type="comparison" source="#liebermann" n="338"><ref target="clause:IIAs_26">II As 26</ref>; <ref target="clause:ICn_5-3">I Cn 5.3</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. | *Vgl. I Cn. 5, 3</note>
        <note type="editorial">Liebermann compares I Cn 5.3.; BR: added from Gesetze I p. 339, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_36-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">339</biblScope></bibl><seg type="original" xml:lang="de">eius. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_36-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">338</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert aus</hi> forh</seg><seg type="translation" xml:lang="en" source="#claude">corrected from forh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_36-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">339</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer K; eingeklammertes übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">the words before the bracket K; the bracketed words the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_36-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">339</biblScope></bibl><seg type="original" xml:lang="de">erga D. p. non <hi rend="italic">Hk T</hi></seg><seg type="translation" xml:lang="en" source="#claude">erga D. p. non Hk T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_36-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">339</biblScope></bibl><seg type="original" xml:lang="de">de t. <hi rend="italic">aus K; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">de t. from K; omitted in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_36-1.lnote.oe.9-2" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">338</biblScope></bibl><seg type="original" xml:lang="de">ne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_36-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">338</biblScope></bibl><seg type="original" xml:lang="de">buton <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">buton Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_36-1.lnote.oe.11-2" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">338</biblScope></bibl><seg type="original" xml:lang="de">God ðe deopor <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">God ðe deopor Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_36-1.lnote.oe.12-2" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">338</biblScope></bibl><seg type="original" xml:lang="de">æft swil. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">æft swil. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_36-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">339</biblScope></bibl><seg type="original" xml:lang="de">ƿurþe <hi rend="italic">H Di Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">ƿurþe H Di Lb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_36-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">207</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Vom Klerus allein hatte dies I 5, 3 gesagt; <hi rend="italic">vgl. Gl</hi> Meineid 11b. Hier dagegen macht Geistliches Gericht wieder eidesfähig; <hi rend="italic">s. o</hi>. S. 107 Sp. 3 Z. 1</seg><seg type="translation" xml:lang="en" source="#claude">I 5, 3 had said this of the clergy alone; <hi rend="italic">cf. Gl</hi> Meineid 11b. Here, by contrast, the ecclesiastical court restores the capacity to swear; <hi rend="italic">see above</hi> p. 107 col. 3 l. 1</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="IICn_36-1.lnote.de1.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">338</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. I Cn.</hi> 5, 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. I Cn.</hi> 5, 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_36-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">207</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Zu Cons <hi rend="italic">vgl. Wb observare</hi> 3</seg><seg type="translation" xml:lang="en" source="#claude">On Cons <hi rend="italic">cf. Wb observare</hi> 3</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_36-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">356</biblScope></bibl><seg type="original" xml:lang="en">Cf. II As. 26; I Cn. 5, 3.</seg></note>
      </div>
