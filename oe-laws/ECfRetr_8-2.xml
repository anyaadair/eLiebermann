      <div type="clause" n="8.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 8.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 8.2"><pb n="632" ed="#liebermann"/>Quin<ptr type="liebermannNote" n="28" target="#ECfRetr_8-2.lnote.la.28"/> etiam de bosco, de prato <hi rend="bold">et</hi><ptr type="liebermannNote" n="29" target="#ECfRetr_8-2.lnote.la.29"/> aquis <hi rend="bold">et</hi> molendinis, parcis<ptr type="liebermannNote" n="30" target="#ECfRetr_8-2.lnote.la.30"/>, uiuariis<ptr type="liebermannNote" n="31" target="#ECfRetr_8-2.lnote.la.31"/>, piscariis, uirgultis <hi rend="bold">et</hi><ptr type="liebermannNote" n="32" target="#ECfRetr_8-2.lnote.la.32"/> hortis <hi rend="bold">et</hi> negotiationibus et omnibus rebus, quas dederit Dominus, decima <hi rend="bold">pars Ei</hi> reddenda est, <hi rend="bold">qui nouem partes simul cum decima largitur.</hi></ab>
        <note type="comparison" source="#liebermann" n="632"><label>printed alongside</label> <ref target="clause:ECf_8-2">ECf 8.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 632 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-2.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">Quid <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">Quid K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-2.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">de <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">de Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-2.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv;</hi> partis <hi rend="italic">Cb;</hi> et <hi rend="italic">fügt zu Hv Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv; partis Cb; Hv Dc add et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-2.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">uirg., uiu., pis. <hi rend="italic">Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">uirg., uiu., pis. Dc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_8-2.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Dc Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Dc Sp</seg></note>
      </div>
