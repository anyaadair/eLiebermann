    <body>
      <div type="clause" n="4.1">
        <head><ref type="lawCode" target="law:Ordal">Ordal</ref> 4.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4.1" corresp="#wit-h"><ptr type="liebermannNote" n="*" target="#Ordal_4-1.lnote.oe.star"/><pb n="387" ed="#liebermann"/>⁊ sprænge se mæssepr<hi rend="italic">eost<ptr type="liebermannNote" n="1" target="#Ordal_4-1.lnote.oe.1"/></hi> haligwæter ofer hig ealle — ⁊ heora ælc abyrige þæs haligwæteres — ⁊ sylle heom eallu<hi rend="italic">m</hi> cyssan bóc ⁊ Cristes rode tacn.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="4.1" corresp="#wit-q"><pb n="387" ed="#liebermann"/>Et aspergat super<ptr type="liebermannNote" n="1" target="#Ordal_4-1.lnote.oe.1-2"/> eos omnes<ptr type="liebermannNote" n="2" target="#Ordal_4-1.lnote.oe.2"/> presbiter<ptr type="liebermannNote" n="3" target="#Ordal_4-1.lnote.oe.3"/> aquam benedictam, et<ptr type="liebermannNote" n="4" target="#Ordal_4-1.lnote.oe.4"/> humilient se singuli ad aquam benedictam<ptr type="liebermannNote" n="5" target="#Ordal_4-1.lnote.oe.5"/>, et det eis omnibus osculari textum (sancti<ptr type="liebermannNote" n="2" target="#Ordal_4-1.lnote.oe.2"/>) euangelii et signum sancte crucis.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="1.4[b]" corresp="#wit-h">and sprænge se mæssepreost haligwæter ofer hig ealle, and heora ælc abyrige þæs halig-wæteres, and sylle heom eallum cyssan bóc and Cristes rode tacn;</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="387" ed="#liebermann"/>Und es sprenge<ptr type="liebermannNote" n="1" target="#Ordal_4-1.lnote.de.1"/> der Priester Weihwasser über sie alle, und ihrer jeder koste<ptr type="liebermannNote" n="2" target="#Ordal_4-1.lnote.de.2"/> vom Weihwasser; und er gebe ihnen allen das [Evangelien]buch<ptr type="liebermannNote" n="3" target="#Ordal_4-1.lnote.de.3"/> zu küssen und Christi Kreuzeszeichen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let the priest sprinkle holy water over them all, and let each of them taste the holy water; and let him give them all the [Gospel] book to kiss and the sign of Christ's cross.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">and the mass-priest shall sprinkle holy water over them all, and each of them shall taste the holy water. And [the mass-priest] shall give them all the book and the symbol of Christ's cross to kiss.</ab>
        <note type="comparison" source="#liebermann" n="387">Iud Dei</note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. Iud. Dei</note>
        <note type="editorial">From here the text draws on the Latin ritual formulae (see Iudicium Dei).</note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_4-1.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Das Folgende schöpft aus den Lateinischen Ritualformeln; s. u.</hi> Iudicia Dei.</seg><seg type="translation" xml:lang="en" source="#claude">What follows draws on the Latin ritual formulae; see below Iudicia Dei.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_4-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de">-pr't</seg><seg type="translation" xml:lang="en" source="#claude">-pr't</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_4-1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de">pr. a. b. s. eos o. <hi rend="italic">RT</hi></seg><seg type="translation" xml:lang="en" source="#claude">pr. a. b. s. eos o. RT</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_4-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_4-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_4-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de">et—benedictam <hi rend="italic">überspringt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">et—benedictam skipped by Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ordal_4-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">387</biblScope></bibl><seg type="original" xml:lang="de">utraque parte <hi rend="italic">fügt zu T</hi></seg><seg type="translation" xml:lang="en" source="#claude">utraque parte added by T</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ordal_4-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">227</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Gl</hi> Weihwasser A. B</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Gl</hi> Weihwasser A. B</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ordal_4-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">227</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Q übs. als stände <hi rend="italic">byge</hi> (‘se humiliet’) da. Dies Trinken des Umstandes ist eine Englische Eigenheit des Ordals; <hi rend="italic">s. o</hi>. I 404{*}</seg><seg type="translation" xml:lang="en" source="#claude">Q translates as if <hi rend="italic">byge</hi> (‘se humiliet’) stood here. This drinking by the bystanders is a peculiarly English feature of the ordeal; <hi rend="italic">see above</hi> I 404{*}</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ordal_4-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">227</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Ordal 14b; Kreuz 1. <hi rend="italic">Cristesboc</hi> heisst sonst Evangeliar; davon scheint <hi rend="italic">boc</hi> Abkürzung, welches Agsä. und im 12. Jh. für ‘Bibel’ vorkommt. Das Küssen des Buches kennt Stubbs (<hi rend="italic">Lect</hi>. 174) sonst erst vom Ende 12. Jhs., das des Kreuzes Trautmann <hi rend="italic">Altengl. Rätsel</hi> 91</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Ordal 14b; Kreuz 1. <hi rend="italic">Cristesboc</hi> elsewhere means gospel-book; <hi rend="italic">boc</hi>, which occurs in A.-S. and in the 12th cent. for ‘Bible’, seems to be an abbreviation of it. Stubbs (<hi rend="italic">Lect</hi>. 174) otherwise knows the kissing of the book only from the end of the 12th cent., and Trautmann <hi rend="italic">Altengl. Rätsel</hi> 91 the kissing of the cross</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ordal_4-1.attnote.n.1" n="1" source="#attenborough" rend="wholeClause"><bibl><biblScope unit="page">173</biblScope></bibl><seg type="original" xml:lang="en">The Gospels, according to Liebermann.</seg></note>
      </div>
    </body>
