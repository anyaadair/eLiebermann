      <div type="clause" n="5.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.2" corresp="#wit-lat"><pb n="548" ed="#liebermann"/>Nē peregrina<ptr type="liebermannNote" n="h" target="#Hn_5-2.lnote.oe.h"/> sint<ptr type="liebermannNote" n="38" target="#Hn_5-2.lnote.oe.38"/> iudicia, uel a<ptr type="liebermannNote" n="39" target="#Hn_5-2.lnote.oe.39"/> non suo iudice uel loco uel tempore celebrata.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 548 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-2.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">diese einzeln häufig vorkommenden Sätze in</hi> 5, 2. 5, 2<hi rend="italic">a stellte vielleicht erst Verf. zusammen aus Angilram</hi> 759. 761 <hi rend="italic">f.</hi>; <hi rend="italic">vgl. Ps.-Is.</hi> 73. 131. 167. 562; <hi rend="italic">Ivo</hi> Decr. VI 331. 323. 329; <hi rend="italic">Pan.</hi> IV 54. 123. 113; <hi rend="italic">Gr.</hi> C. 3 q. 6 c. 12f.; C. 3 q. 9 c. 11. <hi rend="italic">Er wiederholt sie</hi> 31, 7<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">these sentences, which often occur singly, were perhaps first put together in 5, 2. 5, 2a by the author, from Angilram 759. 761 f.; cf. Ps.-Is. 73. 131. 167. 562; Ivo Decr. VI 331. 323. 329; Pan. IV 54. 123. 113; Gr. C. 3 q. 6 c. 12f.; C. 3 q. 9 c. 11. He repeats them in 31, 7a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-2.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">sunt <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">sunt Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-2.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">ante suum iudicium <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">ante suum iudicium Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">315</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Vorladung—{39}<hi rend="italic">ante suo iudice</hi>—5, 3{41} <hi rend="italic">h. l</hi>.—5, 4 <hi rend="italic">causa, recedere licet</hi>{6} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Vorladung—{39}<hi rend="italic">ante suo iudice</hi>—5, 3{41} <hi rend="italic">h. l</hi>.—5, 4 <hi rend="italic">causa, recedere licet</hi>{6} Rs</seg></note>
      </div>
