      <div type="clause" n="1">
        <head><ref type="lawCode" target="law:ExcomXI">Excom XI</ref> 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom XI 1" corresp="#wit-vu"><pb n="441" ed="#liebermann"/>Ex auctoritate Dei, patris et filii et Spiritus sancti, necnon et sancte Marie<ptr type="liebermannNote" n="c" target="#ExcomXI_1.lnote.oe.c"/> genetricis Dei et domini nostri Iesu Christi et sancti Michaelis et sanctorum angelorum<ptr type="liebermannNote" n="d" target="#ExcomXI_1.lnote.oe.d"/> et archangelorum et sancti Petri et Pauli<ptr type="liebermannNote" n="c" target="#ExcomXI_1.lnote.oe.c"/> et sanctorum apostolorum et sancti Stephani et sanctorum martyrum et sancti Martini<ptr type="liebermannNote" n="e" target="#ExcomXI_1.lnote.oe.e"/> et sanctorum confessorum<ptr type="liebermannNote" n="c" target="#ExcomXI_1.lnote.oe.c"/> et sancte Marie Magdalene<ptr type="liebermannNote" n="f" target="#ExcomXI_1.lnote.oe.f"/> et sancte Katerine<ptr type="liebermannNote" n="g" target="#ExcomXI_1.lnote.oe.g"/> et omnium sanctarum uirginum<ptr type="liebermannNote" n="h" target="#ExcomXI_1.lnote.oe.h"/> et omnium<ptr type="liebermannNote" n="i" target="#ExcomXI_1.lnote.oe.i"/> sanctorum Dei</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 441 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXI_1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> V 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> V 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXI_1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> VI 1, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> VI 1, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXI_1.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Gem</hi> 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. Gem 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXI_1.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> X 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. X 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXI_1.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">diese kommt erst in den spätesten Angelsächsischen Kalendern vor; Piper</hi> Kalend. 68. 78. 82</seg><seg type="translation" xml:lang="en" source="#claude">she appears only in the latest Anglo-Saxon calendars; Piper Kalend. 68. 78. 82</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXI_1.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> VI 1, 5</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> VI 1, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomXI_1.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">441</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> I 11, 1 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> I 11, 1 <hi rend="italic">f.</hi></seg></note>
