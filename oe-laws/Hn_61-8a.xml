        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-8a.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">581</biblScope></bibl><seg type="original" xml:lang="de">tamen <hi rend="italic">Hss. Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">tamen <hi rend="italic">MSS edd.</hi></seg></note>
