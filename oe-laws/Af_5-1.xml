      <div type="clause" n="5.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 5.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.1" corresp="#wit-e"><pb n="52" ed="#liebermann"/>Gif<ptr type="liebermannNote" n="1" target="#Af_5-1.lnote.oe.1"/> hiwan hiora<ptr type="liebermannNote" n="2" target="#Af_5-1.lnote.oe.2"/> cirican<ptr type="liebermannNote" n="3" target="#Af_5-1.lnote.oe.3"/> maran<ptr type="liebermannNote" n="4" target="#Af_5-1.lnote.oe.4"/> þearfe hæbben, healde<ptr type="liebermannNote" n="5" target="#Af_5-1.lnote.oe.5"/> hine mon on oðru<hi rend="italic">m</hi> ærne<ptr type="liebermannNote" n="6" target="#Af_5-1.lnote.oe.6"/>, ⁊ ðæt næbbe ðon<ptr type="liebermannNote" n="7" target="#Af_5-1.lnote.oe.7"/> ma dura þon<hi rend="italic">ne</hi> sio<ptr type="liebermannNote" n="8" target="#Af_5-1.lnote.oe.8"/> cirice.<ptr type="liebermannNote" n="9" target="#Af_5-1.lnote.oe.9"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.1" corresp="#wit-h"><pb n="52" ed="#liebermann"/>Gif hiwan heora<ptr type="liebermannNote" n="1" target="#Af_5-1.lnote.oe.1-2"/> cirican mare<ptr type="liebermannNote" n="2" target="#Af_5-1.lnote.oe.2-2"/> ðearfe hæbben, healde hine mon on oþrum ærne, ond<ptr type="liebermannNote" n="3" target="#Af_5-1.lnote.oe.3-2"/> þæt næbbe ðon<ptr type="liebermannNote" n="4" target="#Af_5-1.lnote.oe.4-2"/> ma dura ðonne seo<ptr type="liebermannNote" n="5" target="#Af_5-1.lnote.oe.5-2"/> circe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.1" corresp="#wit-b-no-prol"><pb n="53" ed="#liebermann"/>Gyf hiwan héora ciricean mare ðearfe hæbben, healde hine mon on oðru<hi rend="italic">m</hi> huse, ⁊ þ<hi rend="italic">æt</hi> næbbe ðon ma dura ðonne<ptr type="liebermannNote" n="1" target="#Af_5-1.lnote.oe.1-4"/> seo cyrice.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.1" corresp="#wit-q"><pb n="53" ed="#liebermann"/>Si editui magis<ptr type="liebermannNote" n="1" target="#Af_5-1.lnote.oe.1-3"/> opus habeant ecclesiam<ptr type="liebermannNote" n="2" target="#Af_5-1.lnote.oe.2-3"/> suam, custodiant eum in alia domo, et<ptr type="liebermannNote" n="3" target="#Af_5-1.lnote.oe.3-3"/> hec non habeat plura hostia quam ecclesia.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="66" ed="#attenborough"/>Gif hiwan hiora cirican maran<ptr type="editorNote" n="8" target="#Af_5-1.attnote.fn.8"/> þearfe hæbben, healde hine mon on oðrum ærne<ptr type="editorNote" n="9" target="#Af_5-1.attnote.fn.9"/>, ⁊ ðæt næbbe ðon<ptr type="editorNote" n="10" target="#Af_5-1.attnote.fn.10"/> ma dura þonne sio cirice<ptr type="editorNote" n="11" target="#Af_5-1.attnote.fn.11"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="5.1" corresp="#wit-e"><pb n="296" ed="#jurasinski-and-oliver"/>Gif hiwan hiora cirican maran þearfe hæbben, healde hine mon on oðru<hi rend="italic">m</hi> ærne, ⁊ ðæt næbbe ðon ma dura þon<hi rend="italic">ne</hi> sio cirice.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="53" ed="#liebermann"/>Wenn die Stiftsgeistlichen<ptr type="liebermannNote" n="1" target="#Af_5-1.lnote.de.1"/> ihrer Kirche mehr bedürfen, so bewahre man ihn in einem anderen Gebäude<ptr type="liebermannNote" n="2" target="#Af_5-1.lnote.de.2"/>, und dies habe im<ptr type="liebermannNote" n="3" target="#Af_5-1.lnote.de.3"/> Vergleich nicht mehr Thüren<ptr type="liebermannNote" n="4" target="#Af_5-1.lnote.de.4"/> als die Kirche.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the clergy of the community have greater need of their church, let him be kept in another building, and let this have no more doors by comparison than the church.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="67" ed="#attenborough"/>If the community have so great need<ptr type="editorNote" n="1" target="#Af_5-1.attnote.n.1"/> of their church [that it cannot be used as an asylum], he [the fugitive] shall be kept in another building, and this shall not have more doors than the church.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="411" ed="#whitelock"/>If the community have more need of their church, he is to be kept in another building, and it is to have no more doors than the church.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="297" ed="#jurasinski-and-oliver"/>If a household has greater need of their church, let him be kept in another building, and let that have no more doors than the church.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">hwa <hi rend="italic">fügt zu So</hi></seg><seg type="translation" xml:lang="en" source="#claude">hwa added by So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">heora <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">heora Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">cyr. <hi rend="italic">So;</hi> cyricean <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyr. So; cyricean Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">mare ðearf <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mare ðearf Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">heald <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">heald So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">hús <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hús Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">þon<hi rend="italic">ne</hi> <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þon<hi rend="italic">ne</hi> So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">seo <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">seo Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">cyr. <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyr. So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">eo <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eo on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> ðonne</seg><seg type="translation" xml:lang="en" source="#claude">altered to ðonne</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">53</biblScope></bibl><seg type="original" xml:lang="de">maius <hi rend="italic">T Hk Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">maius T Hk Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">53</biblScope></bibl><seg type="original" xml:lang="de">-sie sue <hi rend="italic">K;</hi> -sia sua <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sie sue K; -sia sua Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.3-3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">53</biblScope></bibl><seg type="original" xml:lang="de">quę <hi rend="italic">statt</hi> et hec <hi rend="italic">R T Hk Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">quę instead of et hec R T Hk Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-1.lnote.oe.1-4" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">53</biblScope></bibl><seg type="original" xml:lang="de">donne <hi rend="italic">B</hi></seg><seg type="translation" xml:lang="en" source="#claude">donne B</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Statt des ganzen Konvents setzt Q dessen Beamten, der die Kirchenschlüssel führt; <hi rend="italic">vgl.</hi> Ducange s. v. <hi rend="italic">ostiarius</hi></seg><seg type="translation" xml:lang="en" source="#claude">Instead of the whole convent Q puts its official who keeps the church keys; <hi rend="italic">cf.</hi> Ducange s. v. <hi rend="italic">ostiarius</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">B modernisiert</seg><seg type="translation" xml:lang="en" source="#claude">B modernises</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘dann’ verderben H cor. So Ld; die Erklärer verwechseln es hiermit; aber <hi rend="italic">vgl. Wb þon</hi> B 2b; Wülfing <hi rend="italic">Syntax</hi> 75</seg><seg type="translation" xml:lang="en" source="#claude">H cor. So Ld corrupt it to ‘then’; the commentators confuse it with this; but <hi rend="italic">cf. Wb þon</hi> B 2b; Wülfing <hi rend="italic">Syntax</hi> 75</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5-1.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Und dadurch Aussicht des Entkommens vor dem draussen lauernden Rächer; <hi rend="italic">vgl.</hi> Asyl 12</seg><seg type="translation" xml:lang="en" source="#claude">And thereby a prospect of escaping the avenger lurking outside; <hi rend="italic">cf.</hi> Asyl 12</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_5-1.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">66</biblScope></bibl><label>maran</label><seg type="original" xml:lang="en"><hi rend="italic">mare</hi>. B &amp; H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_5-1.attnote.fn.9" n="9" source="#attenborough"><bibl><biblScope unit="page">66</biblScope></bibl><label>ærne</label><seg type="original" xml:lang="en"><hi rend="italic">huse</hi>. B &amp; Ld.</seg></note>
