      <div type="clause" n="2.1">
        <head><ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 2.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 2.1" corresp="#wit-du" ana="#glossed"><pb n="409" ed="#liebermann"/><seg type="glossed"><seg type="base">ut</seg><gloss xml:lang="ang">þ<hi rend="italic">æt</hi>te</gloss></seg> <seg type="glossed"><seg type="base">si</seg><gloss xml:lang="ang">gif</gloss></seg> <seg type="glossed"><seg type="base">hic</seg><gloss xml:lang="ang">her<ptr type="liebermannNote" n="32" target="#IudDeiIV_2-1.lnote.oe.32"/></gloss></seg> <seg type="glossed"><seg type="base">homo,</seg><gloss xml:lang="ang"><hi rend="italic">monn<ptr type="liebermannNote" n="33" target="#IudDeiIV_2-1.lnote.oe.33"/></hi>,</gloss></seg> <seg type="glossed"><seg type="base">manum</seg><gloss xml:lang="ang">hond</gloss></seg> <seg type="glossed"><seg type="base">suam</seg><gloss xml:lang="ang">his</gloss></seg> <seg type="glossed"><seg type="base">in</seg><gloss xml:lang="ang">on</gloss></seg> <seg type="glossed"><seg type="base">te</seg><gloss xml:lang="ang">ðec</gloss></seg> <seg type="glossed"><seg type="base">missurus,</seg><gloss xml:lang="ang">bið sendend,</gloss></seg> <seg type="glossed"><seg type="base">innocens</seg><gloss xml:lang="ang">vnscyldig<ptr type="liebermannNote" n="34" target="#IudDeiIV_2-1.lnote.oe.34"/></gloss></seg> <seg type="glossed"><seg type="base">est</seg><gloss xml:lang="ang">is</gloss></seg> <seg type="glossed"><seg type="base">unde</seg><gloss xml:lang="ang">bi ðon</gloss></seg> <seg type="glossed"><seg type="base">reputatur,</seg><gloss xml:lang="ang">bið ateled,</gloss></seg> <seg type="glossed"><seg type="base">pietas</seg><gloss xml:lang="ang">arfæst<hi rend="italic">nise</hi></gloss></seg> <seg type="glossed"><seg type="base">Dei</seg><gloss xml:lang="ang">God<hi rend="italic">es</hi></gloss></seg> <seg type="glossed"><seg type="base">omnipotentis</seg><gloss xml:lang="ang">allm<hi rend="italic">æhtiges</hi></gloss></seg> <seg type="glossed"><seg type="base">liberet</seg><gloss xml:lang="ang">gifrie</gloss></seg> <seg type="glossed"><seg type="base">eum;</seg><gloss xml:lang="ang">hine;</gloss></seg></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 409 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2-1.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Glossator missversteht</hi> hīc</seg><seg type="translation" xml:lang="en" source="#claude">the glossator misunderstands hīc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2-1.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rune</hi> ᛞ</seg><seg type="translation" xml:lang="en" source="#claude">rune ᛞ</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_2-1.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">oft</hi> v <hi rend="italic">für</hi> u</seg><seg type="translation" xml:lang="en" source="#claude">often v for u</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-du">that, if this man, who is about to put his hand into you, is innocent of that of which he is accused, the mercy of God almighty may free him;</ab>
