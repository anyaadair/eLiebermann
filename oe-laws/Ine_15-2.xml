    <body>
      <div type="clause" n="15.2">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 15.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15.2" corresp="#wit-e"><ptr type="liebermannNote" n="*" target="#Ine_15-2.lnote.oe.star"/><pb n="96" ed="#liebermann"/>Þeof, siððan<ptr type="liebermannNote" n="5" target="#Ine_15-2.lnote.oe.5"/> he bið on cyninges bende<ptr type="liebermannNote" n="6" target="#Ine_15-2.lnote.oe.6"/>, nah he þa swicne.<ptr type="liebermannNote" n="7" target="#Ine_15-2.lnote.oe.7"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15.2" corresp="#wit-bu"><pb n="96" ed="#liebermann"/>LX. Þeof, siðþan he bið on kininges bende, nah he þa swycne.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15.2" corresp="#wit-h"><pb n="96" ed="#liebermann"/>LX. Ðeof, syððan he biþ on cyninges bende, nah he ða swicne.<ptr type="liebermannNote" n="3" target="#Ine_15-2.lnote.oe.3-2"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15.2" corresp="#wit-b-no-prol"><pb n="97" ed="#liebermann"/>Þeof<ptr type="liebermannNote" n="3" target="#Ine_15-2.lnote.oe.3"/>, syððan he bið on cyninges bendum, nah he ða geswicne.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="15.2" corresp="#wit-q"><pb n="97" ed="#liebermann"/>Fur postquam est in uinculis regis, non habet<ptr type="liebermannNote" n="8" target="#Ine_15-2.lnote.oe.8"/> hanc abnegationem.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="40" ed="#attenborough"/>Ðeof, siððan he bið on cyninges bende<ptr type="editorNote" n="12" target="#Ine_15-2.attnote.fn.12"/>, nah he þa swicne<ptr type="editorNote" n="13" target="#Ine_15-2.attnote.fn.13"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="15" corresp="#wit-e"><pb n="380" ed="#jurasinski-and-oliver"/>Þeof, siððan he bið on cyninges bende, nah he þa swicne.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="97" ed="#liebermann"/>Ein Dieb, sobald er in des Königs Haft<ptr type="liebermannNote" n="1" target="#Ine_15-2.lnote.de.1"/> ist, verliert dieses Reinigungsrecht.<ptr type="liebermannNote" n="2" target="#Ine_15-2.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">A thief, as soon as he is in the king’s custody, loses this right of clearing himself.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="41" ed="#attenborough"/>A thief shall not have the right of clearing himself by oath after he is in the king's power.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="401" ed="#whitelock"/>A thief, when he is in the king’s bonds, has then no right to purge himself.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="381" ed="#jurasinski-and-oliver"/>A thief, once he is in the king’s confinement, does not have the right to clear himself by an oath.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_15-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">97</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> Ðeof.</seg><seg type="translation" xml:lang="en" source="#claude">altered to Ðeof.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_15-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">97</biblScope></bibl><seg type="original" xml:lang="de">habeat <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">habeat K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_15-2.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">96</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> geswicne</seg><seg type="translation" xml:lang="en" source="#claude">altered to geswicne</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_15-2.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">96</biblScope></bibl><seg type="original" xml:lang="de">15, 2 <hi rend="italic">vereint mit</hi> 16 <hi rend="italic">zu Cap.</hi> LX <hi rend="italic">Bu H, gegen Rubrikenliste, o. S.</hi> 20.</seg><seg type="translation" xml:lang="en" source="#claude">15, 2 combined with 16 into cap. LX Bu H, contrary to the list of rubrics, above p. 20.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_15-2.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">96</biblScope></bibl><seg type="original" xml:lang="de">syþþan he beoþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">syþþan he beoþ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_15-2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">96</biblScope></bibl><seg type="original" xml:lang="de">bendum <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">bendum Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_15-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">96</biblScope></bibl><seg type="original" xml:lang="de">geswicne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">geswicne Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_15-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">70</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘Banden’ B (Q?). — Die Vereinigung des Satzes mit 16 durch H ist sinngemäss, aber nicht archetyp</seg><seg type="translation" xml:lang="en" source="#claude">‘Bands’ B (Q?). — H’s joining of the sentence with 16 accords with the sense, but is not from the archetype</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_15-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">71</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Ins Gefängnis kam nur ein bei Missetat Ertappter und dem Staatsbeamten Eingelieferter; <hi rend="italic">s. Gl</hi> Gefängnis 5b; Reinigung 3. — H cor. B ändern zu <hi rend="italic">geswicne:</hi> was nur hier vorkommt</seg><seg type="translation" xml:lang="en" source="#claude">Only someone caught in a misdeed and handed over to the state official went to prison; <hi rend="italic">see Gl</hi> Gefängnis 5b; Reinigung 3. — H cor. B alter to <hi rend="italic">geswicne:</hi> which occurs only here</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_15-2.attnote.fn.12" n="12" source="#attenborough"><bibl><biblScope unit="page">40</biblScope></bibl><label>bende</label><seg type="original" xml:lang="en"><hi rend="italic">bendum</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_15-2.attnote.fn.13" n="13" source="#attenborough"><bibl><biblScope unit="page">40</biblScope></bibl><label>swicne</label><seg type="original" xml:lang="en"><hi rend="italic">geswicne</hi>. B.</seg></note>
      </div>
    </body>
