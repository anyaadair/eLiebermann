      <div type="clause" n="49.3b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 49.3b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 49.3b" corresp="#wit-lat"><pb n="572" ed="#liebermann"/>Et cum responderit, queratur, an<ptr type="liebermannNote" n="d" target="#Hn_49-3b.lnote.oe.d"/> amplius dicere uelit? ne quis occasione<ptr type="liebermannNote" n="e" target="#Hn_49-3b.lnote.oe.e"/> potius quam ratione placitare uideatur: si ita ammonitus<ptr type="liebermannNote" n="28" target="#Hn_49-3b.lnote.oe.28"/> aliquid<ptr type="liebermannNote" n="29" target="#Hn_49-3b.lnote.oe.29"/> pretermiserit, sibimet deputet<ptr type="liebermannNote" n="30" target="#Hn_49-3b.lnote.oe.30"/>, si dampnum ei euenerit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 572 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-3b.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 28, 4</seg><seg type="translation" xml:lang="en" source="#claude">cf. 28, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-3b.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">Chicane, <hi rend="italic">mfz.</hi> acheson</seg><seg type="translation" xml:lang="en" source="#claude">chicanery, Middle French acheson</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-3b.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">amo. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">amo. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-3b.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">-uis <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uis Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-3b.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">572</biblScope></bibl><seg type="original" xml:lang="de">imputet <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">imputet Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_49-3b.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Rechtsgang 20—<hi rend="italic">aliquis</hi>{29}—49, 3d <hi rend="italic">Baro</hi>{33}—<hi rend="italic">opus est a</hi>.{35} <hi rend="italic">iu</hi>.—49, 4a <hi rend="italic">aliquis</hi>{37}—49, 4b <hi rend="italic">non</hi>{39} fehlt—<hi rend="italic">querandum</hi>—49, 5 <hi rend="italic">simul</hi>{44} fehlt—<hi rend="italic">faciat</hi>{48} der Herr der beklagten Leute; meine Änderung <hi rend="italic">fiat</hi> war unnötig</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Rechtsgang 20—<hi rend="italic">aliquis</hi>{29}—49, 3d <hi rend="italic">Baro</hi>{33}—<hi rend="italic">opus est a</hi>.{35} <hi rend="italic">iu</hi>.—49, 4a <hi rend="italic">aliquis</hi>{37}—49, 4b <hi rend="italic">non</hi>{39} is missing—<hi rend="italic">querandum</hi>—49, 5 <hi rend="italic">simul</hi>{44} is missing—<hi rend="italic">faciat</hi>{48}: the lord of the accused men; my emendation <hi rend="italic">fiat</hi> was unnecessary</seg></note>
