      <div type="clause" n="88.7">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 88.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 88.7" corresp="#wit-lat"><pb n="603" ed="#liebermann"/>Si<ptr type="liebermannNote" n="13" target="#Hn_88-7.lnote.oe.13"/> quis alterius puerum, qui uel ei commissus sit ad educandum uel docendum, occidat<ptr type="liebermannNote" n="14" target="#Hn_88-7.lnote.oe.14"/> uel dormiens opprimat<ptr type="liebermannNote" n="e" target="#Hn_88-7.lnote.oe.e"/>, nichilominus reddat quam si uirum<ptr type="liebermannNote" n="15" target="#Hn_88-7.lnote.oe.15"/> adultum<ptr type="liebermannNote" n="f" target="#Hn_88-7.lnote.oe.f"/> occidisset.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 603 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-7.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus einem Poenitential wie Ps.-Theod.</hi> 21, 36; <hi rend="italic">oder Ps.-Egberti Add.</hi> 4: si quis infantem oppresserit</seg><seg type="translation" xml:lang="en" source="#claude">from a penitential such as Ps.-Theod. 21, 36; or Ps.-Egberti Add. 4: si quis infantem oppresserit</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-7.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 70, 15</seg><seg type="translation" xml:lang="en" source="#claude">cf. 70, 15</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-7.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">Qui al. <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Qui al. K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-7.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-7.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">603</biblScope></bibl><seg type="original" xml:lang="de">uiuum <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">uiuum Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-7.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Erziehung 4b</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Erziehung 4b</seg></note>
