  <text>
    <body>
      <div type="clause" n="38.3a">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 38.3a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 38.3a"><pb n="669" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_38-3a.lnote.oe.erkl-clause"/>Et si scit<ptr type="liebermannNote" n="19" target="#ECf_38-3a.lnote.la.19"/> uenditorem, quis<ptr type="liebermannNote" n="20" target="#ECf_38-3a.lnote.la.20"/> sit uel<ptr type="liebermannNote" n="21" target="#ECf_38-3a.lnote.la.21"/> ubi sit, dicat; et iusticia querat eum ad faciendam iusticiam; et si<ptr type="liebermannNote" n="f" target="#ECf_38-3a.lnote.la.fn.f"/> inueniri<ptr type="liebermannNote" n="23" target="#ECf_38-3a.lnote.la.23"/> non poterit, utlagetur<ptr type="liebermannNote" n="f" target="#ECf_38-3a.lnote.la.fn.f"/>.</ab>
        <note type="comparison" source="#liebermann" n="669"><label>printed alongside</label> <ref target="clause:ECfRetr_38-3a">ECf retr 38.3a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 669 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">There is no note 22 in the ECf column of this page: Liebermann’s numbering goes from 21 to 23.</note>
        <note type="editorial">Liebermann puts his note f both after “si” and after “utlagetur”.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-3a.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">jener Verkäufer</hi></seg><seg type="translation" xml:lang="en" source="#claude">that seller</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-3a.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">sciat <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">sciat S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-3a.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">qui <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-3a.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">et S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-3a.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">669</biblScope></bibl><seg type="original" xml:lang="de">n. i. <hi rend="italic">Hr;</hi> -ire <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">n. i. Hr; -ire Hk</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And if he knows the seller, who he is or where he is, let him say; and let the justice seek him to do justice; and if he cannot be found, let him be outlawed.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_38-3a.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">350</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> friedlos 10b.c</seg><seg type="translation" xml:lang="en" source="#claude">Cf. <hi rend="italic">Gl</hi> friedlos 10b.c</seg></note>
      </div>
    </body>
  </text>
