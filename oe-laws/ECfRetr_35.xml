      <div type="clause" n="35">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 35</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 35"><pb n="664" ed="#liebermann"/><hi rend="bold">De</hi><ptr type="liebermannNote" n="9" target="#ECfRetr_35.lnote.la.9"/> <hi rend="bold">aduentu s. Margarete, matris</hi><ptr type="liebermannNote" n="a" target="#ECfRetr_35.lnote.la.fn.a"/> <hi rend="bold">regis</hi><ptr type="liebermannNote" n="10" target="#ECfRetr_35.lnote.la.10"/> <hi rend="bold">Scotie, et Ædgari æþeling</hi><ptr type="liebermannNote" n="11" target="#ECfRetr_35.lnote.la.11"/><hi rend="bold">, fratris eius, in Angliam, de quo sanctus Edwardus rex heredem suum facere uoluit. (Quomodo</hi><ptr type="liebermannNote" n="12" target="#ECfRetr_35.lnote.la.12"/> <hi rend="bold">s. M-a, mater</hi><ptr type="liebermannNote" n="a" target="#ECfRetr_35.lnote.la.fn.a"/> Dauid<ptr type="liebermannNote" n="13" target="#ECfRetr_35.lnote.la.13"/> <hi rend="bold">r. S., cum patre et matre, sorore et fratre Eadgaro edelingo, de—her. regni sui f. u., in A. uenit.)</hi><ptr type="liebermannNote" n="14" target="#ECfRetr_35.lnote.la.14"/> Iste <hi rend="bold">(uero</hi><ptr type="liebermannNote" n="15" target="#ECfRetr_35.lnote.la.15"/><hi rend="bold">) prefatus</hi> Eadmundus<ptr type="liebermannNote" n="*" target="#ECfRetr_35.lnote.la.star"/> habuit<ptr type="liebermannNote" n="16" target="#ECfRetr_35.lnote.la.16"/> quendam filium Eadwardum <hi rend="bold">nomine.</hi> Qui <hi rend="bold">mox</hi><ptr type="liebermannNote" n="17" target="#ECfRetr_35.lnote.la.17"/>, patre†† mortuo, timore regis<ptr type="liebermannNote" n="18" target="#ECfRetr_35.lnote.la.18"/> Cnuti aufugit ad <hi rend="bold">regnum</hi> Rugorum<ptr type="liebermannNote" n="19" target="#ECfRetr_35.lnote.la.19"/>, <hi rend="bold">quod nos melius</hi> uocamus<ptr type="liebermannNote" n="20" target="#ECfRetr_35.lnote.la.20"/> Russiam. Quem<ptr type="liebermannNote" n="21" target="#ECfRetr_35.lnote.la.21"/> rex terre, Malesclodus<ptr type="liebermannNote" n="22" target="#ECfRetr_35.lnote.la.22"/> nomine, ut <hi rend="bold">cognouit,</hi> quis esset, honeste retinuit.</ab>
        <note type="comparison" source="#liebermann" n="664"><label>printed alongside</label> <ref target="clause:ECf_35">ECf 35</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 664 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">The heading has two forms: “De aduentu … facere uoluit” in Pl S, and “Quomodo … in A. uenit” in the other manuscripts (note 9); Liebermann prints the second in brackets after the first. In it “Dauid” is printed in ordinary type.</note>
        <note type="editorial">Liebermann prints “patre††” and gives in the outer margin of the ECf retr column the date ††1016.</note>
        <note type="editorial">The starred notes (*, **, ***) are printed across the whole page; they are given with both columns.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">falls in der Überschrift des Retr.</hi> Dauid <hi rend="italic">ursprünglich fehlte, so meinte sie unter Margaretens Söhnen die <hi rend="spaced">regierenden</hi> Könige von Schottland [oder den gegenwärtigen] und entstand, da deren letzter, David,</hi> 1153 <hi rend="italic">starb, vor</hi> 1153</seg><seg type="translation" xml:lang="en" source="#claude">if Dauid was originally lacking in the Retr.’s heading, then the heading meant, among Margaret’s sons, the reigning kings of Scotland [or the present one], and it was written before 1153, since the last of them, David, died in 1153</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">Jaroslaw I. <hi rend="italic">von Kiew, in Französischen Quellen</hi> Bullesclot, Juriscloht, Jeresclauus, Georgius sclauus: Coll. Teruan. <hi rend="italic">bei Sdralek</hi> Wolfenbüttl. Fragm. 178. 186; Hist. Franc. (<hi rend="italic">Duchesne</hi> IV 87C); <hi rend="italic">mein</hi> Über Edw. Conf. 38. <hi rend="italic">Vor Cnut floh über Schweden nach Russland auch Olaf der Heilige; Metcalfe</hi> Passio Olavi 16</seg><seg type="translation" xml:lang="en" source="#claude">Jaroslav I of Kiev, in French sources Bullesclot, Juriscloht, Jeresclauus, Georgius sclauus: Coll. Teruan. in Sdralek, Wolfenbüttl. Fragm. 178. 186; Hist. Franc. (Duchesne IV 87C); my Über Edw. Conf. 38. Olaf the Saint also fled from Cnut to Russia by way of Sweden; Metcalfe, Passio Olavi 16</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">Ireneside</hi> <hi rend="italic">fügt zu Lond</hi> (<hi rend="italic">s. o.</hi> 34, 2<hi rend="italic">b</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">Lond adds Ireneside (see above, 34, 2b)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Pl S;</hi> Quomodo—uenit <hi rend="italic">übr.; Überschrift fehlt Cb Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Pl S; Quomodo—uenit the others; the heading is lacking in Cb Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">regi <hi rend="italic">Pl;</hi> Scotorum <hi rend="italic">Ba</hi></seg><seg type="translation" xml:lang="en" source="#claude">regi Pl; Scotorum Ba</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">ædþ. <hi rend="italic">Pl;</hi> æde. <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">ædþ. Pl; æde. S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">Quod <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">Quod Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">r. D. <hi rend="italic">Va Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. D. Va Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">et postea Willelmum ducem heredem suum fecit, eo quod de Ædgaro facere nequiuit <hi rend="italic">fügt zu Pl S</hi> [<hi rend="italic">vgl. Rubrik</hi> 35, 2]</seg><seg type="translation" xml:lang="en" source="#claude">Pl S add et postea Willelmum ducem heredem suum fecit, eo quod de Ædgaro facere nequiuit [cf. the rubric of 35, 2]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Lb Ba; fehlt übrigen</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Lb Ba; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">-uerit <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uerit Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Dc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">C. r. <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">C. r. Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">Rog. <hi rend="italic">Dc;</hi> Dog. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Rog. Dc; Dog. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">dicimus <hi rend="italic">Dc</hi></seg><seg type="translation" xml:lang="en" source="#claude">dicimus Dc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">Quoniam <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Quoniam Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_35.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">664</biblScope></bibl><seg type="original" xml:lang="de">-chlodus <hi rend="italic">Va;</hi> -clotus <hi rend="italic">Lond;</hi> -scoldus <hi rend="italic">Cb Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-chlodus Va; -clotus Lond; -scoldus Cb Hv</seg></note>
      </div>
    </body>
