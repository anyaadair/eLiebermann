      <div type="clause" n="88.12a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 88.12a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 88.12a" corresp="#wit-lat"><pb n="604" ed="#liebermann"/>Si quis posth[a]c<ptr type="liebermannNote" n="5" target="#Hn_88-12a.lnote.oe.5"/> hominem occidat, ipse sibi portet<ptr type="liebermannNote" n="6" target="#Hn_88-12a.lnote.oe.6"/> homicidii faidiam, nisi amicorum auxilio intra XII menses persoluat pleno weregildo<ptr type="liebermannNote" n="7" target="#Hn_88-12a.lnote.oe.7"/>, sit<ptr type="liebermannNote" n="8" target="#Hn_88-12a.lnote.oe.8"/> natus<ptr type="liebermannNote" n="9" target="#Hn_88-12a.lnote.oe.9"/> sicut sit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 604 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-12a.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">-hec <hi rend="italic">Sc;</hi> -hoc <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">-hec Sc; -hoc the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-12a.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">-tat h. fauliam <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tat h. fauliam K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-12a.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">sicut <hi rend="italic">fügt zu Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">sicut added by Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-12a.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co;</hi> sicut <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Co; sicut Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-12a.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">sic. n. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic. n. Co</seg></note>
