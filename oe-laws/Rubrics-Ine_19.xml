      <div type="clause" n="19">
        <head>Ine Rb 19</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19" corresp="#wit-e"><pb n="20" ed="#liebermann"/>LXIII. Be cyninges geneate.<ptr type="liebermannNote" n="17" target="#Rubrics-Ine_19.lnote.oe.17"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19" corresp="#wit-g-prol"><pb n="20" ed="#liebermann"/>LXIII. Be cyninges geneate.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="19" corresp="#wit-h"><pb n="21" ed="#liebermann"/>LXIII. Be kyninges geneate.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="19" corresp="#wit-q"><pb n="21" ed="#liebermann"/>De colono<ptr type="liebermannNote" n="24" target="#Rubrics-Ine_19.lnote.oe.24"/> fiscalino.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="204" ed="#jurasinski-and-oliver"/>LXIII Be cyninges geneate</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="204" ed="#jurasinski-and-oliver"/>Be cinges geneate</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="21" ed="#liebermann"/>Von des Königs [Gefolgs]genossen.<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_19.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of the king’s [retinue-]companion.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="205" ed="#jurasinski-and-oliver"/>Concerning a man in the king’s service</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="205" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_19.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">20</biblScope></bibl><seg type="original" xml:lang="de">-eat <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-eat Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_19.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">21</biblScope></bibl><seg type="original" xml:lang="de">colono <hi rend="italic">Hk;</hi> regis <hi rend="italic">fügt zu Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">colono Hk; regis added by Hk Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_19.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Q verkennt ‘Gefolgsadel’; <hi rend="italic">s. d. Gl</hi> 2h; <hi rend="italic">Wb: fiscalini</hi></seg><seg type="translation" xml:lang="en" source="#claude">Q fails to recognise ‘retainer nobility’; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 2h; <hi rend="italic">Wb: fiscalini</hi></seg></note>
