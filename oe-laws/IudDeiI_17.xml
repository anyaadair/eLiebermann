        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_17.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">Communio <hi rend="italic">statt</hi> A. p. c. <hi rend="italic">Ch Vt Ci Ca H Al Ma Vt2 Tr Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Communio instead of A. p. c. Ch Vt Ci Ca H Al Ma Vt2 Tr Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_17.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zu</hi> I. D. <hi rend="italic">Neumen Rj; statt</hi> Iustus—eius <hi rend="italic">hat Vt2:</hi> Amen dico uobis quicquid orantes</seg><seg type="translation" xml:lang="en" source="#claude">neumes over I. D. Rj; instead of Iustus—eius Vt2 has: Amen dico uobis quicquid orantes</seg></note>
