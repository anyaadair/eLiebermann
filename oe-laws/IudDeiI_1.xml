      <div type="clause" n="1">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 1" corresp="#wit-lat"><ptr type="liebermannNote" n="d" target="#IudDeiI_1.lnote.oe.d"/><pb n="401" ed="#liebermann"/>Peractis<ptr type="liebermannNote" n="e" target="#IudDeiI_1.lnote.oe.e"/> coram sacerdote trium dierum ieiuniis, <ptr type="liebermannNote" n="3" target="#IudDeiI_1.lnote.oe.3"/>cum homines<ptr type="liebermannNote" n="4" target="#IudDeiI_1.lnote.oe.4"/> uis<ptr type="liebermannNote" n="f" target="#IudDeiI_1.lnote.oe.f"/> mittere ad iudicium aquae frigidae ob<ptr type="liebermannNote" n="5" target="#IudDeiI_1.lnote.oe.5"/> comprobationem, ita facere debes:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 401 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic"><hi rend="spaced">Sperrdruck</hi> bezeichnet das in den Hss. roth Geschriebene.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Spaced type denotes what is written in red in the MSS.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_1.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Erste sechs Wörter scheinen fertigem</hi> Ordo, <hi rend="italic">wonach erst in</hi> 1, 1 <hi rend="italic">die Verdächtigen zum Priester kommen, nachträglich vorangesetzt, gemäss</hi> II As. 23, <hi rend="italic">o. S.</hi> 162. <hi rend="italic">Vgl. u. S.</hi> 406ᶜ.</seg><seg type="translation" xml:lang="en" source="#claude">The first six words seem to have been put afterwards in front of a finished Ordo, according to which the suspects come to the priest only in 1, 1, in accordance with II As. 23, above p. 162. Cf. below p. 406ᶜ.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_1.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Angeredet ist laut</hi> 3, 1 <hi rend="italic">der</hi> sacerdos, <hi rend="italic">obwohl er dort und vorher in dritter Person steht.</hi></seg><seg type="translation" xml:lang="en" source="#claude">According to 3, 1 it is the sacerdos who is addressed, although there and earlier he is referred to in the third person.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_1.lnote.oe.II_a" n="II a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Aufrechte</hi> (‘Antiqua’-)<hi rend="italic">Buchstabennoten beziehen sich auf</hi> Band II: Erklärungen.</seg><seg type="translation" xml:lang="en" source="#claude">Upright (‘Antiqua’, i.e. roman) letters used as note-markers refer to Band II: Erklärungen.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">von hier</hi> Cum—5 <hi rend="italic">einschl. = Quelle von Zeumer p.</hi> 618. 620 <hi rend="italic">ff.</hi> 626. 641. 643. 653. 655. 667. 669. 672. 675. 684. 689. 692</seg><seg type="translation" xml:lang="en" source="#claude">from here, Cum—5 inclusive = source of Zeumer p. 618. 620 ff. 626. 641. 643. 653. 655. 667. 669. 672. 675. 684. 689. 692</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">-nem <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nem Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">401</biblScope></bibl><seg type="original" xml:lang="de">ad <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_1.lnote.oe.a__b" n="a. b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">239</biblScope></bibl><seg type="original" xml:lang="de">Eigen; <hi rend="italic">s. Gl</hi> Ordal 7 C. 21; Fasten 9—c (auch XVI 1{d})</seg><seg type="translation" xml:lang="en" source="#claude">Peculiar to this text; see <hi rend="italic">Gl</hi> Ordal 7 C. 21; Fasten 9—c (also XVI 1{d})</seg></note>
      </div>
