    <body>
      <div type="clause" n="34.2d">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 34.2d</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 34.2d"><pb n="663" ed="#liebermann"/><ptr type="liebermannNote" n="19" target="#ECf_34-2d.lnote.la.19"/>Quo mortuo, Haroldus<ptr type="liebermannNote" n="*" target="#ECf_34-2d.lnote.la.star"/>, falso<ptr type="liebermannNote" n="c" target="#ECf_34-2d.lnote.la.fn.c"/> pene ab omnibus putatus<ptr type="liebermannNote" n="20" target="#ECf_34-2d.lnote.la.20"/> filius<ptr type="liebermannNote" n="21" target="#ECf_34-2d.lnote.la.21"/> eius, successit et<ptr type="liebermannNote" n="22" target="#ECf_34-2d.lnote.la.22"/> quinque<ptr type="liebermannNote" n="d" target="#ECf_34-2d.lnote.la.fn.d"/> annis regnauit††.</ab>
        <note type="comparison" source="#liebermann" n="663"><label>printed alongside</label> <ref target="clause:ECfRetr_34-2d">ECf retr 34.2d</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 663 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann prints “††” and gives in the outer margin of the ECf retr column the dates ††1035–39.</note>
        <note type="editorial">The note (*) is printed across the whole page; given with both columns.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2d.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">Harefot (Herewod <hi rend="italic">K</hi>), filius Chnuti et Elwyne <hi rend="italic">Lond;</hi> Haral. <hi rend="italic">S Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Harefot (Herewod K), filius Chnuti et Elwyne Lond; Haral. S Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2d.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Cnuts Vaterschaft bezweifeln</hi> Ann. Anglosax., Flor., Encom. Emmae</seg><seg type="translation" xml:lang="en" source="#claude">Cnut’s paternity is doubted by the Ann. Anglosax., Florence, and the Encom. Emmae</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2d.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielmehr</hi> IV</seg><seg type="translation" xml:lang="en" source="#claude">rather IV</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2d.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">Regnum Haraldi <hi rend="italic">überschr. Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">Pl S head it Regnum Haraldi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2d.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">f. e. p. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. e. p. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2d.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">f. e. <hi rend="italic">fehlt S</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. e. lacking in S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2d.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">663</biblScope></bibl><seg type="original" xml:lang="de">ei annisque XV r. <hi rend="italic">Hr;</hi> et <hi rend="italic">fehlt S</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei annisque XV r. Hr; et lacking in S</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">When he was dead, Harold, falsely thought by almost everyone to be his son, succeeded and reigned five years††.</ab>
      </div>
