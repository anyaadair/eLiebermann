      <div type="clause" n="76.7e">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 76.7e</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 76.7e" corresp="#wit-lat"><pb n="594" ed="#liebermann"/>Inde ponant<ptr type="liebermannNote" n="7" target="#Hn_76-7e.lnote.oe.7"/> terminum (suum<ptr type="liebermannNote" n="2" target="#Hn_76-7e.lnote.oe.2"/>) parentes mortui de XL ouibus, que pro<ptr type="liebermannNote" n="c" target="#Hn_76-7e.lnote.oe.c"/> XX sol. computantur; sint autem oues uidentes<ptr type="liebermannNote" n="d" target="#Hn_76-7e.lnote.oe.d"/> et cornute et<ptr type="liebermannNote" n="2" target="#Hn_76-7e.lnote.oe.2"/> nulla parte corporis<ptr type="liebermannNote" n="8" target="#Hn_76-7e.lnote.oe.8"/> diminute.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 594 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-7e.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de">1 <hi rend="italic">Schaf früher nur</hi> 5 <hi rend="italic">oder</hi> 4 <hi rend="italic">Denar</hi> (Archiv f. d. Stud. neu. Spra. CII, 287); Leis Wl 9, 1 <hi rend="italic">bestimmen aus anderer Ortsgewohnheit das Wergeld in Thierwerthen</hi></seg><seg type="translation" xml:lang="en" source="#claude">1 <hi rend="italic">sheep formerly only</hi> 5 <hi rend="italic">or</hi> 4 <hi rend="italic">pence</hi> (Archiv f. d. Stud. neu. Spra. CII, 287); Leis Wl 9, 1 <hi rend="italic">fix the wergild in values of livestock, from a different local custom</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-7e.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Lex Ribuar.</hi> 36, 11: Si quis weregeldum soluere coeperit, bouem cornutum uidentem et sanum pro 2 sol. tribuat</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf. Lex Ribuar.</hi> 36, 11: Si quis weregeldum soluere coeperit, bouem cornutum uidentem et sanum pro 2 sol. tribuat</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-7e.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-7e.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de">-at <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-at <hi rend="italic">Co Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-7e.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Co; in Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">missing in Sc Co; in Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-7e.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">327</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Preis 11; Schaf 1a—<hi rend="italic">suum</hi>{2}—<hi rend="italic">corporis</hi>{8} fehlt—76, 7f <hi rend="italic">numendus</hi>{10} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Preis 11; Schaf 1a—<hi rend="italic">suum</hi>{2}—<hi rend="italic">corporis</hi>{8} missing—76, 7f <hi rend="italic">numendus</hi>{10} Rs</seg></note>
      </div>
