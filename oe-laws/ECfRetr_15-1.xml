    <body>
      <div type="clause" n="15.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 15.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 15.1"><pb n="641" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECfRetr_15-1.lnote.la.star"/>Si <hi rend="bold">uero</hi> inueniri non poterat<ptr type="liebermannNote" n="7" target="#ECfRetr_15-1.lnote.la.7"/>, mensis et unius diei respectum<ptr type="liebermannNote" n="8" target="#ECfRetr_15-1.lnote.la.8"/> habebant<ptr type="liebermannNote" n="9" target="#ECfRetr_15-1.lnote.la.9"/> ad eum perquirendum.</ab>
        <note type="comparison" source="#liebermann" n="641"><label>printed alongside</label> <ref target="clause:ECf_15-1">ECf 15.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 641 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-1.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-rit <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rit Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-1.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-tus <hi rend="italic">Hv K;</hi> terminum <hi rend="italic">Lb Va L Ph Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tus Hv K; terminum Lb Va L Ph Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-1.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">habeatur ad quer. eum <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">habeatur ad quer. eum Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-1.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">De Englecherie <hi rend="italic">am Rande Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">De Englecherie in the margin Co</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But if he could not be found, they had a respite of a month and one day to search for him.</ab>
      </div>
    </body>
