        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom I 6.3" corresp="#wit-ti"><pb n="432" ed="#liebermann"/>Iubet ergo<ptr type="liebermannNote" n="29" target="#ExcomI_6-3.lnote.oe.29"/> Dominus, ut frater, id est Christianus in nos peccans, primo<ptr type="liebermannNote" n="i" target="#ExcomI_6-3.lnote.oe.i"/> secrete corripiatur, deinde cum testibus redarguatur, nouissime in conuentu<ptr type="liebermannNote" n="30" target="#ExcomI_6-3.lnote.oe.30"/> æcclesiæ publice conueniatur.</ab>
