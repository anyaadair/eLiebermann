    <body>
      <div type="clause" n="9.3">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 9.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 9.3"><pb n="633" ed="#liebermann"/>Et si barones sunt<ptr type="liebermannNote" n="35" target="#ECf_9-3.lnote.la.35"/> qui iudicia<ptr type="liebermannNote" n="f" target="#ECf_9-3.lnote.la.fn.f"/><ptr type="liebermannNote" n="36" target="#ECf_9-3.lnote.la.36"/> non habeant<ptr type="liebermannNote" n="37" target="#ECf_9-3.lnote.la.37"/>, in hundredo<ptr type="liebermannNote" n="g" target="#ECf_9-3.lnote.la.fn.g"/> ubi<ptr type="liebermannNote" n="38" target="#ECf_9-3.lnote.la.38"/> placitum habitum<ptr type="liebermannNote" n="39" target="#ECf_9-3.lnote.la.39"/> fuerit, ad propinquiorem ecclesiam<ptr type="liebermannNote" n="40" target="#ECf_9-3.lnote.la.40"/>, ubi iudicium<ptr type="liebermannNote" n="h" target="#ECf_9-3.lnote.la.fn.h"/> regis erit, determinandum est, saluis<ptr type="liebermannNote" n="41" target="#ECf_9-3.lnote.la.41"/> rectitudinibus<ptr type="liebermannNote" n="i" target="#ECf_9-3.lnote.la.fn.i"/> baronum<ptr type="liebermannNote" n="42" target="#ECf_9-3.lnote.la.42"/> ipsorum<ptr type="liebermannNote" n="1" target="#ECf_9-3.lnote.la.1"/>.</ab>
        <note type="comparison" source="#liebermann" n="633"><label>printed alongside</label> <ref target="clause:ECfRetr_9-3">ECf retr 9.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 633 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “propinquiorem” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-3.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">‘[<hi rend="italic">Privileg der</hi>] Ordalien [-Abhaltung]’</seg><seg type="translation" xml:lang="en" source="#claude">‘[the privilege of holding] ordeals’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-3.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 22, 5; <hi rend="italic">mein</hi> Über ECf. 89</seg><seg type="translation" xml:lang="en" source="#claude">cf. 22, 5; my Über ECf. 89</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-3.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">öffentlicher Ordalapparat</seg><seg type="translation" xml:lang="en" source="#claude">the public apparatus of the ordeal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-3.lnote.la.fn.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">Geldvortheil <hi rend="italic">aus dem Strafprocess</hi></seg><seg type="translation" xml:lang="en" source="#claude">the financial profit from the criminal proceedings</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-3.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">sint <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">sint S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-3.lnote.la.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">iusticiam <hi rend="italic">Hr; fehlt Hk;</hi> sua aliqua <hi rend="italic">fügt zu Ad Do No</hi></seg><seg type="translation" xml:lang="en" source="#claude">iusticiam Hr; lacking in Hk; Ad Do No add sua aliqua</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-3.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">habent <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">habent Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-3.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">si <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">si Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-3.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschrieben Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above the line Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-3.lnote.la.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-3.lnote.la.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">salus. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">salus. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-3.lnote.la.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">i. b. <hi rend="italic">Hk Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. b. Hk Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-3.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And if there are barons who do not have ordeals, in the hundred where the plea has been held, it is to be determined at the nearest church where the king's ordeal shall be, saving the rights of those barons.</ab>
      </div>
    </body>
  </text>
