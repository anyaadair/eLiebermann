      <div type="clause" n="I Cn 14">
        <head>Quadr Rb I Cn 14</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Rb I Cn 14" corresp="#wit-lat"><pb n="536" ed="#liebermann"/>De<ptr type="liebermannNote" n="31" target="#Quadr-Rb_I-Cn-14.lnote.la.31"/><ptr type="liebermannNote" n="33" target="#Quadr-Rb_I-Cn-14.lnote.la.33"/> feriatione diei dominicæ et<ptr type="liebermannNote" n="32" target="#Quadr-Rb_I-Cn-14.lnote.la.32"/> de sollempnitatibus sanctorum celebrandis<ptr type="liebermannNote" n="34" target="#Quadr-Rb_I-Cn-14.lnote.la.34"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 536 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">Of keeping the Lord's day as a holiday and of celebrating the feasts of the saints.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-14.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zu</hi> 14, 1 <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">at 14, 1 R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-14.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt LondDm, wo</hi> De s. s. c. <hi rend="italic">besonders</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in LondDm, where De s. s. c. stands separately</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-14.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt RBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in RBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_I-Cn-14.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt R</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in R</seg></note>
      </div>
