      <div type="clause" n="12.10">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 12.10</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 12.10"><pb n="639" ed="#liebermann"/>Et si quid operis<ptr type="liebermannNote" n="29" target="#ECf_12-10.lnote.la.29"/> ad disturbationem<ptr type="liebermannNote" n="30" target="#ECf_12-10.lnote.la.30"/> eorum<ptr type="liebermannNote" n="31" target="#ECf_12-10.lnote.la.31"/> erigitur, solo tenus<ptr type="liebermannNote" n="h" target="#ECf_12-10.lnote.la.fn.h"/> deponatur, et chimini reparentur, et secundum legem comitatus erga comitem et<ptr type="liebermannNote" n="32" target="#ECf_12-10.lnote.la.32"/> uicecomitem emendetur.<ptr type="liebermannNote" n="*" target="#ECf_12-10.lnote.la.star"/></ab>
        <note type="comparison" source="#liebermann" n="639"><label>printed alongside</label> <ref target="clause:ECfRetr_12-10">ECf retr 12.10</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 639 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s asterisk introduces the London collection’s insertion here, 12, 10 A–A 3.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-10.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 12, 2</seg><seg type="translation" xml:lang="en" source="#claude">as at 12, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-10.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">ad d. o. <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad d. o. Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-10.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">destructionem <hi rend="italic">Hr;</hi> -nes <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">destructionem Hr; -nes Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-10.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-10.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Hk</hi> [‘<hi rend="italic">beziehungsweise</hi>’]</seg><seg type="translation" xml:lang="en" source="#claude">uel Hk [‘or respectively’]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-10.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Hier schaltet Lond in die Retr. ein</hi> [<hi rend="italic">vgl. meine</hi> Leges Angl. s. XIII. in. Lond. coll. <hi rend="italic">S.</hi> 55]:</seg><seg type="translation" xml:lang="en" source="#claude">Here Lond inserts into the Retr. [cf. my Leges Angl. s. XIII. in. Lond. coll. p. 55]:</seg></note>
      </div>
