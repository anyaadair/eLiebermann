    <body>
      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-e"><pb n="88" ed="#liebermann"/>Æfter þam we bebeodað<ptr type="liebermannNote" n="25" target="#Ine_1-1.lnote.oe.25"/>, þætte<ptr type="liebermannNote" n="18" target="#Ine_1-1.lnote.oe.18"/> ealles folces æw<ptr type="liebermannNote" n="26" target="#Ine_1-1.lnote.oe.26"/> ⁊ domas ðus sien<ptr type="liebermannNote" n="27" target="#Ine_1-1.lnote.oe.27"/> gehealdene:</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-bu"><pb n="88" ed="#liebermann"/>Æfter þæ<hi rend="italic">m</hi> we bebeodað, þ<hi rend="italic">æt</hi>te ealles folces æw ⁊ domas þus sien gehealdenne:</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-h"><pb n="88" ed="#liebermann"/>Æfter þam we beodað, þæt<ptr type="liebermannNote" n="12" target="#Ine_1-1.lnote.oe.12"/> ealles folces æw ⁊ domas ðus syn gehealdene:</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-b-no-prol"><pb n="89" ed="#liebermann"/>Æfter ðam we beodað, þ<hi rend="italic">æt</hi> ealles folces æw<ptr type="liebermannNote" n="5" target="#Ine_1-1.lnote.oe.5"/> ⁊ domas ðus syn gehealdene:</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.1" corresp="#wit-q"><pb n="89" ed="#liebermann"/>Postea precipimus<ptr type="liebermannNote" n="13" target="#Ine_1-1.lnote.oe.13"/> (uolumus), ut totius populi<ptr type="liebermannNote" n="21" target="#Ine_1-1.lnote.oe.21"/> coniugia sint et iudicia deuote conseruata.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="36" ed="#attenborough"/>Æfter þam we bebeodað þætte ealles folces æw ⁊ domas ðus sien gehealdene.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="1.1" corresp="#wit-e"><pb n="370" ed="#jurasinski-and-oliver"/>{XLV} Æfter þam we bebeodað þætte ealles folces æw ⁊ domas ðus sien gehealdene.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="89" ed="#liebermann"/>Demnächst<ptr type="liebermannNote" n="1" target="#Ine_1-1.lnote.de.1"/> gebieten wir, dass alles [Laien]volkes<ptr type="liebermannNote" n="2" target="#Ine_1-1.lnote.de.2"/> Recht<ptr type="liebermannNote" n="3" target="#Ine_1-1.lnote.de.3"/> und Gesetze folgendermassen gehalten werden:</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Next we command that the law and statutes of the whole [lay] people be kept as follows:</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="37" ed="#attenborough"/>After this we command that the law and decrees affecting the whole nation be observed as follows.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="399" ed="#whitelock"/>After that, we enjoin that the law and decrees of all the people are to be observed thus:</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="371" ed="#jurasinski-and-oliver"/>Next we command that the law and judgments regarding all the folk be held as follows.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_1-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">89</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. geänd. in</hi> ǽ</seg><seg type="translation" xml:lang="en" source="#claude">altered to ǽ in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_1-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">89</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lesart Lond;</hi> (<hi rend="italic">eingeklammertes</hi>) <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">reading of Lond before the bracket; (the bracketed words) the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_1-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">89</biblScope></bibl><seg type="original" xml:lang="de">c. p. <hi rend="italic">HkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. p. HkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_1-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">88</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dahinter</hi> te <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">te written above after it</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_1-1.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">88</biblScope></bibl><seg type="original" xml:lang="de">beodæþ <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">beodæþ Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_1-1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">88</biblScope></bibl><seg type="original" xml:lang="de">þ' <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þ' Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_1-1.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">88</biblScope></bibl><seg type="original" xml:lang="de">æ, <hi rend="italic">am Rande</hi> al. æw <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">æ, in the margin al. æw Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_1-1.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">88</biblScope></bibl><seg type="original" xml:lang="de">synd <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">synd Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_1-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">68</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Zwar folgt noch Kirchenrecht, aber von Laien zu beobachtendes</seg><seg type="translation" xml:lang="en" source="#claude">Ecclesiastical law does indeed still follow, but law to be observed by the laity</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_1-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">68</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl.</hi> Wi Pro</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf.</hi> Wi Pro</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_1-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">68</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Missverständnis in Q wie Pro¹⁵</seg><seg type="translation" xml:lang="en" source="#claude">Misunderstanding in Q, as Pro¹⁵</seg></note>
      </div>
    </body>
