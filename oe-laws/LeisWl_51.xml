    <body>
      <div type="clause" n="51">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 51</head>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-i"><ptr type="liebermannNote" n="24" target="#LeisWl_51.lnote.oe.24"/><pb n="519" ed="#liebermann"/>Si est a[l]cons<ptr type="liebermannNote" n="25" target="#LeisWl_51.lnote.oe.25"/> qui blamet seit dedenz<ptr type="liebermannNote" n="26" target="#LeisWl_51.lnote.oe.26"/> le hundred, e<ptr type="liebermannNote" n="27" target="#LeisWl_51.lnote.oe.27"/> IIII humes le retent, sei<ptr type="liebermannNote" n="28" target="#LeisWl_51.lnote.oe.28"/> XII. main s’espurget.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="519" ed="#liebermann"/>De culpato in hundredo. Si quis in hundredo inculpatus fuerit et a IIII hominibus rectatus, purget se manu XIIᵃ.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="51" corresp="#wit-i"><pb n="274" ed="#robertson"/>Si est a[l]cons qui blamet seit dedenz le hundred, e IIII humes le retent, sei XII main s'espurget.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="519" ed="#liebermann"/>51. Wenn jemand ist, der bescholten ist im Hundertschaftsgericht, und 4<ptr type="liebermannNote" n="d" target="#LeisWl_51.lnote.de1.d"/> Leute ihn anklagen, reinige er sich selbzwölfter<ptr type="liebermannNote" n="e" target="#LeisWl_51.lnote.de1.e"/> Hand.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">51. If there is someone who is ill-reputed in the hundred court, and 4 people accuse him, he shall clear himself with himself as twelfth hand.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-i"><pb n="275" ed="#robertson"/>If there is anyone who has charges brought against him in the hundred court to such an extent that 4 men accuse him, he shall clear himself with 11 compurgators.</ab>
        <note type="comparison" source="#liebermann" n="519"><ref target="clause:IICn_30">II Cn 30</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 30</note>
        <note type="editorial">Added October 2026 from Robertson pp. 274–275 (text and translation); Liebermann’s text and German translation added from Gesetze I p. 519, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_51.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">519</biblScope></bibl><seg type="original" xml:lang="de">L., <hi rend="italic">hinter</hi> 52, <hi rend="italic">vor</hi> 52, 1 <hi rend="italic">I</hi></seg><seg type="translation" xml:lang="en" source="#claude">L., after 52, before 52, 1 I</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_51.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">519</biblScope></bibl><seg type="original" xml:lang="de">asc. <hi rend="italic">I</hi></seg><seg type="translation" xml:lang="en" source="#claude">asc. I</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_51.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">519</biblScope></bibl><seg type="original" xml:lang="de">de dinz <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">de dinz Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_51.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">519</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_51.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">519</biblScope></bibl><seg type="original" xml:lang="de">si <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">si Im</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="LeisWl_51.lnote.de1.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">519</biblScope></bibl><seg type="original" xml:lang="de">3 <hi rend="italic">Cnut</hi></seg><seg type="translation" xml:lang="en" source="#claude">3 <hi rend="italic">Cnut</hi></seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="LeisWl_51.lnote.de1.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">519</biblScope></bibl><seg type="original" xml:lang="de">durch dreifaches Ordal <hi rend="italic">Cnut</hi></seg><seg type="translation" xml:lang="en" source="#claude">by threefold ordeal <hi rend="italic">Cnut</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_51.lnote.de._" n="-" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">292</biblScope></bibl><seg type="original" xml:lang="de">12 Eideshelfer (<hi rend="italic">s. d. Gl</hi> 27) sollen schwerlich dreifachem Ordale (<hi rend="italic">s. d</hi>. 33) gleichstehen</seg><seg type="translation" xml:lang="en" source="#claude">12 compurgators (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 27) can hardly be meant as equivalent to threefold ordeal (<hi rend="italic">see</hi> that word 33)</seg></note>
      </div>
