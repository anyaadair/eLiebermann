    <body>
      <div type="clause" n="1.4">
        <head><ref type="lawCode" target="law:IAtr">I Atr</ref> 1.4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.4" corresp="#wit-h"><pb n="218" ed="#liebermann"/>Gif hy þonne aþ syllan ne durron, gange to þa<hi rend="italic">m</hi> þryfealdan ordale.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.4" corresp="#wit-b"><pb n="218" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="1" target="#IAtr_1-4.lnote.oe.1"/> hi<ptr type="liebermannNote" n="2" target="#IAtr_1-4.lnote.oe.2"/> ðonne að syllan ne durron, gange<ptr type="liebermannNote" n="3" target="#IAtr_1-4.lnote.oe.3"/> to ðam<ptr type="liebermannNote" n="4" target="#IAtr_1-4.lnote.oe.4"/> ðrifealdan<ptr type="liebermannNote" n="5" target="#IAtr_1-4.lnote.oe.5"/> ordale.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.4" corresp="#wit-q"><pb n="219" ed="#liebermann"/>Si iurare pro eo non audeant, uadat ad triplex ordalium.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="1.4" corresp="#wit-b"><pb n="52" ed="#robertson"/>Gyf hi ðonne að syllan ne durron, gange to ðam ðrifealdan ordale.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="219" ed="#liebermann"/>Wenn sie [Herr und Helfer] aber den Eid nicht<ptr type="liebermannNote" n="1" target="#IAtr_1-4.lnote.de.1"/> zu leisten wagen, schreite [Verklagter] zum dreifachen Ordal.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">But if they [the lord and helpers] do not dare to give the oath, let [the accused] go to the threefold ordeal.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="53" ed="#robertson"/>If they dare not give the oath, he (the accused) shall go to the triple ordeal<ptr type="editorNote" n="1" target="#IAtr_1-4.robnote.n.1"/>.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_30-3">II Cn 30.3</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="329"><label>harsher application</label> <ref target="clause:IIIAtr_3-4">III Atr 3.4–4.1</ref> <quote>parts of 'III Æthelred' gave 'I' and 'IV' a harsher application (n. 301: I Atr 1:4–6; III Atr 3:4 – 4:1, 8; IV Atr 5 – 5:4, 7 – 7:1)</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="367"><label>parallel</label> <ref target="clause:IICn_30-3">II Cn 30.3–30.3a</ref> <quote>I Atr 1:1,4/II Cn 30:1,3,3a</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-4.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-4.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">he <hi rend="italic">Ld im Text;</hi> hy <hi rend="italic">unter ‘Errata’</hi></seg><seg type="translation" xml:lang="en" source="#claude">he Ld in the text; hy under ‘Errata’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-4.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">gang <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gang Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-4.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-4.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">ðreof. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðreof. Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IAtr_1-4.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">147</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Dann unterliegt Verklagter der Reinigungsschwere des Bescholtenen in 1, 1</seg><seg type="translation" xml:lang="en" source="#claude">The accused is then subject to the weight of exculpation required of the man of ill repute in 1, 1</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IAtr_1-4.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">312</biblScope></bibl><seg type="original" xml:lang="en">Cf. 1, 1.</seg></note>
      </div>
    </body>
