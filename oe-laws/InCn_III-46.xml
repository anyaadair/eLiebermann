        <head><ref type="lawCode" target="law:InCn">In Cn</ref> III 46</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="In Cn III 46" corresp="#wit-lat"><pb n="613" ed="#liebermann"/>Omnes rectitudines<ptr type="liebermannNote" n="38" target="#InCn_III-46.lnote.oe.38"/> ciuitatum<ptr type="liebermannNote" n="o" target="#InCn_III-46.lnote.oe.o"/> (regis<ptr type="liebermannNote" n="39" target="#InCn_III-46.lnote.oe.39"/> sunt); et pastum<ptr type="liebermannNote" n="p" target="#InCn_III-46.lnote.oe.p"/> [suum cum omnibus rebus quę ad illum<ptr type="liebermannNote" n="40" target="#InCn_III-46.lnote.oe.40"/> pastum pertinent; carta alodii<ptr type="liebermannNote" n="q" target="#InCn_III-46.lnote.oe.q"/> ad ęternam hęreditatem; forisfactura<ptr type="liebermannNote" n="r" target="#InCn_III-46.lnote.oe.r"/> alodii; et prętium<ptr type="liebermannNote" n="s" target="#InCn_III-46.lnote.oe.s"/> eorum qui habent alodium<ptr type="liebermannNote" n="q" target="#InCn_III-46.lnote.oe.q"/>, quando ita profunde forisfaciunt<ptr type="liebermannNote" n="41" target="#InCn_III-46.lnote.oe.41"/> se ipsos; forisfactura<ptr type="liebermannNote" n="42" target="#InCn_III-46.lnote.oe.42"/> belli, quod<ptr type="liebermannNote" n="43" target="#InCn_III-46.lnote.oe.43"/> Angli uocant ferdƿíte<ptr type="liebermannNote" n="t" target="#InCn_III-46.lnote.oe.t"/><ptr type="liebermannNote" n="44" target="#InCn_III-46.lnote.oe.44"/> in terra omnium suorum;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 613 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-46.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">to ælcere byrig .. hæbbe ic mines cynescipes gerihta <hi rend="italic">IV Eg.</hi> 2<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">to ælcere byrig .. hæbbe ic mines cynescipes gerihta IV Eg. 2a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-46.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">feorm <hi rend="italic">bot die Quelle</hi></seg><seg type="translation" xml:lang="en" source="#claude">the source had feorm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-46.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">bocland <hi rend="italic">Quelle</hi></seg><seg type="translation" xml:lang="en" source="#claude">bocland in the source</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-46.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. II Cn.</hi> 13, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. II Cn. 13, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-46.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Hn</hi> 20, 3; ælc þæra wita þe þa men gewyrcen þe bocland habban <hi rend="italic">I Atr.</hi> 1, 14</seg><seg type="translation" xml:lang="en" source="#claude">cf. Hn 20, 3; ælc þæra wita þe þa men gewyrcen þe bocland habban I Atr. 1, 14</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-46.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. II Cn.</hi> 12. 15</seg><seg type="translation" xml:lang="en" source="#claude">cf. II Cn. 12. 15</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-46.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">consuetudines et ci. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">consuetudines et ci. T</seg></note>
