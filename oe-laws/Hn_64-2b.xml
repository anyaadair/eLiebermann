      <div type="clause" n="64.2b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 64.2b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 64.2b" corresp="#wit-lat"><pb n="584" ed="#liebermann"/>Quia<ptr type="liebermannNote" n="16" target="#Hn_64-2b.lnote.oe.16"/> thaini<ptr type="liebermannNote" n="17" target="#Hn_64-2b.lnote.oe.17"/> iusiurandum contraualet iusiurandum sex uillanorum; et si occideretur, plene<ptr type="liebermannNote" n="o" target="#Hn_64-2b.lnote.oe.o"/> uindicaretur<ptr type="liebermannNote" n="18" target="#Hn_64-2b.lnote.oe.18"/> in sex uillanis<ptr type="liebermannNote" n="p" target="#Hn_64-2b.lnote.oe.p"/>; et si emendaretur, eius weregyldum<ptr type="liebermannNote" n="19" target="#Hn_64-2b.lnote.oe.19"/> est VI uillanorum<ptr type="liebermannNote" n="p" target="#Hn_64-2b.lnote.oe.p"/> weregyldum<ptr type="liebermannNote" n="20" target="#Hn_64-2b.lnote.oe.20"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 584 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-2b.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 70, 9</seg><seg type="translation" xml:lang="en" source="#claude">cf. 70, 9</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-2b.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">ceorl <hi rend="italic">Quadr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">ceorl Quadr.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-2b.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">qm [<hi rend="italic">statt</hi> quoniam?] <hi rend="italic">Sc;</hi> Qui <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">qm [instead of quoniam?] Sc; Qui Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-2b.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">-nis <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nis <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-2b.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">iudic. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">iudic. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-2b.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">-gil- <hi rend="italic">Wh Wi stets;</hi> wergildus <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gil- Wh Wi throughout; wergildus Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_64-2b.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">584</biblScope></bibl><seg type="original" xml:lang="de">-gil. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gil. Co Or</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">For the oath of a thegn is equal in value to the oath of six villeins; and if he were killed, he would be fully avenged on six villeins; and if compensation were paid for him, his wergild is the wergild of six villeins.</ab>
      </div>
