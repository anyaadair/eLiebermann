      <div type="clause" n="12.1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 12.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 12.1"><pb n="638" ed="#liebermann"/>Illa autem manus<ptr type="liebermannNote" n="14" target="#ECfRetr_12-1.lnote.la.14"/> sue pax <hi rend="bold">et</hi> dierum coronationis et breuis sub iudicio unius forisfacture<ptr type="liebermannNote" n="15" target="#ECfRetr_12-1.lnote.la.15"/> est (similiter quatuor<ptr type="liebermannNote" n="16" target="#ECfRetr_12-1.lnote.la.16"/> chiminorum<ptr type="liebermannNote" n="17" target="#ECfRetr_12-1.lnote.la.17"/> et maiorum<ptr type="liebermannNote" n="18" target="#ECfRetr_12-1.lnote.la.18"/> aquarum<ptr type="liebermannNote" n="19" target="#ECfRetr_12-1.lnote.la.19"/>): de assaltu<ptr type="liebermannNote" n="20" target="#ECfRetr_12-1.lnote.la.20"/>;</ab>
        <note type="comparison" source="#liebermann" n="638"><label>printed alongside</label> <ref target="clause:ECf_12-1">ECf 12.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 638 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-1.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">pax s. m. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">pax s. m. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-1.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">est f. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">est f. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-1.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">chim. qu. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">chim. qu. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-1.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-1.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">aq. et maior de <hi rend="italic">Lb Va Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">aq. et maior de Lb Va Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-1.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt Cb über Linie zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cb adds et above the line</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-1.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">assultu <hi rend="italic">Cb Lb Va Kn;</hi> assistu et <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">assultu Cb Lb Va Kn; assistu et K</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But that peace of his hand and of the days of the coronation and of the writ is under the judgment of one forfeiture (likewise that of the four highways and of the greater waters): for assault;</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-1.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">345</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">for.</hi><hi rend="superscript">15</hi> <hi rend="italic">un.</hi> — <hi rend="italic">assultu</hi><hi rend="superscript">20</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">for.</hi><hi rend="superscript">15</hi> <hi rend="italic">un.</hi> — <hi rend="italic">assultu</hi><hi rend="superscript">20</hi> Rs</seg></note>
      </div>
    </body>
