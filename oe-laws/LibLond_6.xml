      <div type="clause" n="6">
        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 6" corresp="#wit-lat"><ptr type="liebermannNote" n="22" target="#LibLond_6.lnote.oe.22"/><pb n="674" ed="#liebermann"/>Ciuis<ptr type="liebermannNote" n="g" target="#LibLond_6.lnote.oe.g"/> iterum<ptr type="liebermannNote" n="h" target="#LibLond_6.lnote.oe.h"/> Lund[oniensis<ptr type="liebermannNote" n="23" target="#LibLond_6.lnote.oe.23"/>] si pro inopia<ptr type="liebermannNote" n="i" target="#LibLond_6.lnote.oe.i"/> terram suam uenundare<ptr type="liebermannNote" n="24" target="#LibLond_6.lnote.oe.24"/> uoluerit, nec<ptr type="liebermannNote" n="k" target="#LibLond_6.lnote.oe.k"/> filii<ptr type="liebermannNote" n="l" target="#LibLond_6.lnote.oe.l"/> nec parentes eius<ptr type="liebermannNote" n="25" target="#LibLond_6.lnote.oe.25"/> uetare poterunt<ptr type="liebermannNote" n="26" target="#LibLond_6.lnote.oe.26"/>, nisi eam ad concessum<ptr type="liebermannNote" n="m" target="#LibLond_6.lnote.oe.m"/> ipsius mercari<ptr type="liebermannNote" n="27" target="#LibLond_6.lnote.oe.27"/> uoluerint.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 674 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_6.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">6. 7 <hi rend="italic">auch in</hi> Cons. 715</seg><seg type="translation" xml:lang="en" source="#claude">6. 7 also in Cons. 715</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_6.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> item; <hi rend="italic">fehlt</hi> Cons.</seg><seg type="translation" xml:lang="en" source="#claude">read item; missing in Cons.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_6.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Freibriefe anderer Englischer Städte erlauben den Verkauf des</hi> burgagium <hi rend="italic">erst, nachdem der Eigenthümer den Erben dreimal vergeblich um Lebensunterhalt ersucht hatte; Bateson ebd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Charters of other English towns permit the sale of the burgagium only after the owner has asked the heir three times in vain for maintenance; Bateson ibid.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_6.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Aufhebung des Beispruchrechts der Erben, über welches vgl. Schröder</hi> Lehrb. DRG. 263. 673; <hi rend="italic">Pollock-Maitland</hi> HEL. I 632</seg><seg type="translation" xml:lang="en" source="#claude">abolition of the heirs’ right of objection, on which cf. Schröder Lehrb. DRG. 263. 673; Pollock-Maitland HEL. I 632</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_6.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">filius <hi rend="italic">PlS</hi> [<hi rend="italic">gemäss Primogeniturfolge geändert</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">filius PlS [altered in accordance with succession by primogeniture]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_6.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">spätere Stadtfreibriefe fordern vom Erben denselben Preis, den ein Fremder gäbe</hi> (<hi rend="italic">Bateson ebd.</hi>), <hi rend="italic">erlauben also jenem nur den Vorkauf</hi></seg><seg type="translation" xml:lang="en" source="#claude">later town charters require from the heir the same price that a stranger would give (Bateson ibid.), and so allow him only the right of pre-emption</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_6.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">Item (de Londoniensibus <hi rend="italic">Pl</hi>) <hi rend="italic">überschr. PlS;</hi> 6. 7 <hi rend="italic">fehlen Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Item (de Londoniensibus Pl) as heading PlS; 6. 7 missing in Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_6.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">Lon’ <hi rend="italic">Pl;</hi> de Londonia <hi rend="italic">S;</hi> London’ <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">Lon’ Pl; de Londonia S; London’ Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_6.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">uendere <hi rend="italic">Horn Cons</hi></seg><seg type="translation" xml:lang="en" source="#claude">uendere Horn Cons</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_6.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">ei <hi rend="italic">fügt zu Cons</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei added by Cons</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_6.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">-rint <hi rend="italic">Ai;</hi> possunt <hi rend="italic">Cons</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rint Ai; possunt Cons</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_6.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">674</biblScope></bibl><seg type="original" xml:lang="de">-re <hi rend="italic">Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-re Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_6.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi> Erbgang 13; Vorkaufsrecht 3; Sippe 28; London 55; Ballard p. 69; Bateson <hi rend="italic">Bor. cus</hi>. I 193. 210. II 61 und M. de W. Hemmeon <hi rend="italic">Burgage tenure in med. Engl</hi>. [1913/14 als Buch ersch.] in <hi rend="italic">Law quart. rev</hi>. 26 (1910) 344f.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi> Erbgang 13; Vorkaufsrecht 3; Sippe 28; London 55; Ballard p. 69; Bateson <hi rend="italic">Bor. cus</hi>. I 193. 210. II 61 and M. de W. Hemmeon <hi rend="italic">Burgage tenure in med. Engl</hi>. [published as a book 1913/14] in <hi rend="italic">Law quart. rev</hi>. 26 (1910) 344f.</seg></note>
      </div>
