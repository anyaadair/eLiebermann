      <div type="clause" n="7.2">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 7.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 7.2" corresp="#wit-lat"><pb n="423" ed="#liebermann"/>Idemque<ptr type="liebermannNote" n="15" target="#IudDeiXIII_7-2.lnote.oe.15"/> si culpabilis est de iam supra dicta re et diabolo<ptr type="liebermannNote" n="b" target="#IudDeiXIII_7-2.lnote.oe.b"/> incrassante cor induratum habuerit uel per aliquod maleficium peccatum suum celare uoluerit, largissima dextera<ptr type="liebermannNote" n="16" target="#IudDeiXIII_7-2.lnote.oe.16"/> filii tui, domini nostri Iesu Christi, in eius corpore declarare dignetur. Qui tecum uiuit (et<ptr type="liebermannNote" n="17" target="#IudDeiXIII_7-2.lnote.oe.17"/> regnat).</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 423 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_7-2.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> XII 17</seg><seg type="translation" xml:lang="en" source="#claude">cf. XII 17</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_7-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">Itemque <hi rend="italic">Zeu.</hi> 649&lt;sub&gt;4&lt;/sub&gt;</seg><seg type="translation" xml:lang="en" source="#claude">Itemque Zeu. 649&lt;sub&gt;4&lt;/sub&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_7-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_7-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">et r. <hi rend="italic">aus Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">et r. from Tr</seg></note>
