    <body>
      <div type="clause" n="25.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 25.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="25.1" corresp="#wit-g-a"><pb n="328" ed="#liebermann"/>⁊ gilde man þam<ptr type="liebermannNote" n="16" target="#IICn_25-1.lnote.oe.16"/> teonde his ceapgild<ptr type="liebermannNote" n="17" target="#IICn_25-1.lnote.oe.17"/>; ⁊ fo se hlaford elles to healfum, to healfu<hi rend="italic">m<ptr type="liebermannNote" n="18" target="#IICn_25-1.lnote.oe.18"/></hi> þ<hi rend="italic">æt</hi> hundred.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="25.1" corresp="#wit-b"><pb n="328" ed="#liebermann"/>⁊ gylde man ðam teonde his ceapgyld; ⁊ fó se hlaford elles to healfu<hi rend="italic">m</hi> ⁊ to healfu<hi rend="italic">m</hi> þ<hi rend="italic">æt</hi> hundred.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="25.1" corresp="#wit-a"><pb n="328" ed="#liebermann"/>⁊ gilde man þa[<hi rend="italic">m<ptr type="liebermannNote" n="6" target="#IICn_25-1.lnote.oe.6-2"/></hi>] teonde his ceapgyld; ⁊ fo se hlaford elles to healfu<hi rend="italic">m</hi>, to halfan þ<hi rend="italic">æt</hi> hundred.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="25.1" corresp="#wit-q"><pb n="329" ed="#liebermann"/>Et soluatur repetenti captale suum (solutio<ptr type="liebermannNote" n="9" target="#IICn_25-1.lnote.oe.9"/> sue pecunie); reliquum<ptr type="liebermannNote" n="10" target="#IICn_25-1.lnote.oe.10"/> habeat dominus eius dimidium<ptr type="liebermannNote" n="11" target="#IICn_25-1.lnote.oe.11"/>, hundretus<ptr type="liebermannNote" n="12" target="#IICn_25-1.lnote.oe.12"/> dimidium.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="25.1" corresp="#wit-inst-cn"><pb n="329" ed="#liebermann"/>Et inprimis reddatur calumnianti de<ptr type="liebermannNote" n="7" target="#IICn_25-1.lnote.oe.7"/> rebus latronis, quod Angli uocant his ceapgeld<ptr type="liebermannNote" n="8" target="#IICn_25-1.lnote.oe.8"/>; et quod remanet diuidatur per medium inter hundredum et dominum latronis.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="25.1" corresp="#wit-cons-cn"><pb n="329" ed="#liebermann"/>Et reddant callumpniatori suum censum capitalem; residui uero dimidium domini sit ipsius, et dimidium centenarii.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="25a.1" corresp="#wit-b"><pb n="188" ed="#robertson"/>⁊ gylde man ðam teonde his ceapgyld ⁊ fó se hlaford elles to healfum ⁊ to healfum þæt hundred.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="268" ed="#rabin-doml"/>And gilde man þam teonde his ceapgild, and fo se hlaford elles to healfum, to healfum þæt hundred.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="329" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#IICn_25-1.lnote.de.1"/> man zahle [davon] dem Kläger dessen Ersatzgeld, und vom Übrigen greife zur Hälfte der Herr [des Verbrechers], (und <hi rend="italic">B</hi>) zur Hälfte die Hundertschaft.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let the plaintiff be paid [from it] his compensation, and of the rest let the lord [of the criminal] take half, (and, B) the hundred half.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="189" ed="#robertson"/>And they shall pay to the accuser the value of his goods, and the lord shall take half of what remains and the hundred half.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="269" ed="#rabin-doml"/>And they shall give to the accuser a single payment equivalent to the market value of his goods, and half of the remainder is to be taken by the landlord and half by the hundred.</ab>
        <note type="comparison" source="#liebermann" n="329"><ref target="clause:IIIEg_7-1">III Eg 7.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. III Eg. 7, 1</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_47-1">Leis Wl 47.1</ref></note>
        <note type="comparedBy" source="#wormald-ppmel" n="206"><label>cf.</label> <ref target="clause:Hu_2-1">Hu 2.1</ref> <quote>4 i. Hundred Ordinance 2:1: ... half to the hundred, half to the lord (hlaford). [cf. III Edgar 7:1, II Cnut 25:1]</quote></note>
        <note type="editorial">Liebermann compares III Eg 7.1.; BR: added from Gesetze I p. 329, October 2026 (MS Cons)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_25-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_25-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de">dom̄ <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">dom̄ Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_25-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de">s. s. p. <hi rend="italic">nur Dm; fehlt übrigen</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. s. p. only Dm; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_25-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de">-qui <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-qui Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_25-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu T</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_25-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">fügt zu K</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius added by K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_25-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de">ða <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ða Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_25-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de">-gyld <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-gyld Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_25-1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de">halfan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">halfan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_25-1.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de">þa <hi rend="italic">A</hi></seg><seg type="translation" xml:lang="en" source="#claude">þa A</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_25-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de">d. r. l. <hi rend="italic">fehlt S</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. r. l. lacking in S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_25-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de">cepg. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">cepg. Cb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_25-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">206</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Übersetzt in Leis Wl 47</seg><seg type="translation" xml:lang="en" source="#claude">Translated in Leis Wl 47</seg><note type="remark" resp="#claude">On several rubrics: II Cn 25. 25, 1; 2</note></note>
