  <text>
    <body>
      <div type="clause" n="14">
        <head><ref type="lawCode" target="law:Ger">Ger</ref> 14</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="14" corresp="#wit-b"><pb n="455" ed="#liebermann"/>[14] He sceal fela tola to tune tilian ⁊ fela andlomena to husan habban:</ab>
        <ab type="editionText" xml:lang="ang" source="#gobbitt" n="27.2" corresp="#wit-b">He sceal fela tola to tune tilian . 7 fela andlomena to husan habban .</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-b"><pb n="336" ed="#rabin-doml"/>He sceal fela tola to tune tilian and fela andlomena to husan habban:</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="455" ed="#liebermann"/>Er muss viele Werkzeuge<ptr type="liebermannNote" n="f" target="#Ger_14.lnote.de1.f"/> für das Gut<ptr type="liebermannNote" n="1" target="#Ger_14.lnote.de.1"/> anschaffen und viele Geräthe<ptr type="liebermannNote" n="g" target="#Ger_14.lnote.de1.g"/> für die Häuser<ptr type="liebermannNote" n="2" target="#Ger_14.lnote.de.2"/> halten:</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">He must provide many tools for the estate and keep many implements for the houses:</ab>
        <ab type="translation" xml:lang="en" source="#gobbitt" corresp="#wit-b">He must procure many tools for the estate and have many utensils for the house:</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-b"><pb n="337" ed="#rabin-doml"/>He must obtain many tools for the estate and have many utensils for the house:</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Rect_4-3-to-4-3c">Rect 4.3, 4.3a, 4.3b, 4.3c</ref></note>
        <note type="editorial">K: ‘tilan’ corrected to ‘tilian’. Liebermann compares Rect 4.3b.</note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="Ger_14.lnote.de1.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">455</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Rect. 4, 3b</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> Rect. 4, 3b</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ger_14.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">254</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Wohl hier Domänengehöft, ohne Bauerdorf</seg><seg type="translation" xml:lang="en" source="#claude">Probably here the demesne farmstead, without a peasant village</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="Ger_14.lnote.de1.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">455</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 12; <hi rend="italic">u.</hi> 17 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">see above</hi> 12; <hi rend="italic">below</hi> 17 <hi rend="italic">f.</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ger_14.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">254</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Wohl Wirtschaftshäuser und Wohnungen der herrschaftlichen Unfreien, des Gesindes, der Domänenarbeiter, im Ggs. zu Bauerstellen</seg><seg type="translation" xml:lang="en" source="#claude">Probably the farm buildings and dwellings of the lord's unfree men, the household servants and the demesne labourers, in contrast to peasant holdings</seg></note>
      </div>
    </body>
