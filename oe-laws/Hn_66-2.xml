      <div type="clause" n="66.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 66.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 66.2" corresp="#wit-lat"><pb n="585" ed="#liebermann"/>Si quis minister<ptr type="liebermannNote" n="39" target="#Hn_66-2.lnote.oe.39"/> altaris hominem occidat<ptr type="liebermannNote" n="m" target="#Hn_66-2.lnote.oe.m"/> uel malis actibus supra modum differatur<ptr type="liebermannNote" n="40" target="#Hn_66-2.lnote.oe.40"/>, ordine simul et dignitate priuetur et peregrinetur, sicut<ptr type="liebermannNote" n="n" target="#Hn_66-2.lnote.oe.n"/> ei papa suus<ptr type="liebermannNote" n="41" target="#Hn_66-2.lnote.oe.41"/> iniunget, et opus emendet sedulo<ptr type="liebermannNote" n="2" target="#Hn_66-2.lnote.oe.2"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 585 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-2.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">anders</hi> 64, 2. 73, 2</seg><seg type="translation" xml:lang="en" source="#claude">otherwise 64, 2. 73, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-2.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 5, 23. 57, 9<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 5, 23. 57, 9<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-2.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de">a. m. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. m. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-2.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de">diffama. <hi rend="italic">oder</hi> defe. <hi rend="italic">empfiehlt Somner</hi> [<hi rend="italic">gegen Quadr.</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">diffama. or defe. recommended by Somner [against Quadr.]</seg></note>
