      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 5" corresp="#wit-lat"><pb n="423" ed="#liebermann"/>Expleta<ptr type="liebermannNote" n="3" target="#IudDeiXIII_5.lnote.oe.3"/> missa, faciat<ptr type="liebermannNote" n="4" target="#IudDeiXIII_5.lnote.oe.4"/> ipse sacerdos aquam benedictam et uadat ad locum, ubi homines probantur, pręcedente euangelio et<ptr type="liebermannNote" n="5" target="#IudDeiXIII_5.lnote.oe.5"/> cruce et thuribulo, et<ptr type="liebermannNote" n="6" target="#IudDeiXIII_5.lnote.oe.6"/> benedicat<ptr type="liebermannNote" n="7" target="#IudDeiXIII_5.lnote.oe.7"/> dicens: Dominus uobiscum. Et<ptr type="liebermannNote" n="8" target="#IudDeiXIII_5.lnote.oe.8"/> cum spirituo tuo!</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 423 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_5.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie Zeumer p.</hi> 655&lt;sub&gt;10&lt;/sub&gt;</seg><seg type="translation" xml:lang="en" source="#claude">as Zeumer p. 655&lt;sub&gt;10&lt;/sub&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_5.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">fa.— et <hi rend="italic">aus Tr;</hi> f. a. b. <hi rend="italic">Zeumer</hi> 653&lt;sub&gt;27&lt;/sub&gt;; <hi rend="italic">fehlt Mg Vt2; vgl. Zeumer</hi> 621&lt;sub&gt;15&lt;/sub&gt;. 622&lt;sub&gt;36&lt;/sub&gt;. 648&lt;sub&gt;19&lt;/sub&gt;</seg><seg type="translation" xml:lang="en" source="#claude">fa.— et from Tr; f. a. b. Zeumer 653&lt;sub&gt;27&lt;/sub&gt;; omitted in Mg Vt2; cf. Zeumer 621&lt;sub&gt;15&lt;/sub&gt;. 622&lt;sub&gt;36&lt;/sub&gt;. 648&lt;sub&gt;19&lt;/sub&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_5.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">cum <hi rend="italic">Tr Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">cum Tr Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_5.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">Quo cum uenerit, det illis omnibus bibere de aqua benedicta. Postea coniuret aquam ita d. (<hi rend="italic">statt</hi> et b. d.) <hi rend="italic">Tr; ähnlich Zeumer</hi> 619 <hi rend="italic">f.</hi> 656. 675</seg><seg type="translation" xml:lang="en" source="#claude">Quo cum uenerit, det illis omnibus bibere de aqua benedicta. Postea coniuret aquam ita d. (instead of et b. d.) Tr; similarly Zeumer 619 f. 656. 675</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_5.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">fatiat aquam benedictam (<hi rend="italic">wie Zeumer</hi> 655&lt;sub&gt;12&lt;/sub&gt;), di. Oremus <hi rend="italic">Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">fatiat aquam benedictam (as Zeumer 655&lt;sub&gt;12&lt;/sub&gt;), di. Oremus Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_5.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">et c. s. t. <hi rend="italic">fehlt Vt2;</hi> s. t. <hi rend="italic">fehlt Mg; vgl. Zeu.</hi> 689&lt;sub&gt;25&lt;/sub&gt;</seg><seg type="translation" xml:lang="en" source="#claude">et c. s. t. omitted in Vt2; s. t. omitted in Mg; cf. Zeu. 689&lt;sub&gt;25&lt;/sub&gt;</seg></note>
      </div>
