        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-46.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">istum <hi rend="italic">CbT</hi></seg><seg type="translation" xml:lang="en" source="#claude">istum CbT</seg></note>
