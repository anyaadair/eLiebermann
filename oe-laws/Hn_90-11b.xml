      <div type="clause" n="90.11b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 90.11b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 90.11b" corresp="#wit-lat"><pb n="606" ed="#liebermann"/>Et in quibus non<ptr type="liebermannNote" n="20" target="#Hn_90-11b.lnote.oe.20"/> potest homo legittime iurare, quod ‘per<ptr type="liebermannNote" n="l" target="#Hn_90-11b.lnote.oe.l"/> eum non fuerit<ptr type="liebermannNote" n="21" target="#Hn_90-11b.lnote.oe.21"/> aliquis uite<ptr type="liebermannNote" n="m" target="#Hn_90-11b.lnote.oe.m"/> remocior, morti propinquior’, digne componat, sicut factum sit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 606 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11b.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Formel in England</hi> (<hi rend="italic">im</hi> 13. <hi rend="italic">Jh.</hi>) <hi rend="italic">und auch Nordisch; Beispiele auch für die Fälle in</hi> 90, 11<hi rend="italic">c</hi>: <hi rend="italic">Brunner</hi> 820. 828. 840; <hi rend="italic">Pollock-Maitland</hi> HEL. II 469</seg><seg type="translation" xml:lang="en" source="#claude">a formula in England (in the 13th cent.) and also in the North; examples, also for the cases in 90, 11<hi rend="italic">c</hi>: Brunner 820. 828. 840; Pollock-Maitland HEL. II 469</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11b.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 87, 8</seg><seg type="translation" xml:lang="en" source="#claude">cf. 87, 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11b.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">h. n. p. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. n. p. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11b.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">fuit <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">fuit Lond</seg></note>
