      <div type="clause" n="39.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 39.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="39.1" corresp="#wit-e"><pb n="72" ed="#liebermann"/>Gif he wæpne gebrede<ptr type="liebermannNote" n="10" target="#Af_39-1.lnote.oe.10"/> ⁊ no feohte, sie be healfum ðam.<ptr type="liebermannNote" n="2" target="#Af_39-1.lnote.oe.2"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="39.1" corresp="#wit-h"><pb n="72" ed="#liebermann"/>Gif he wæpne gebrede<ptr type="liebermannNote" n="7" target="#Af_39-1.lnote.oe.7"/> ond<ptr type="liebermannNote" n="5" target="#Af_39-1.lnote.oe.5"/> no<ptr type="liebermannNote" n="8" target="#Af_39-1.lnote.oe.8"/> feohte<ptr type="liebermannNote" n="4" target="#Af_39-1.lnote.oe.4"/>, sy<ptr type="liebermannNote" n="9" target="#Af_39-1.lnote.oe.9"/> be healfum ðam.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="39.1" corresp="#wit-b-no-prol"><pb n="72" ed="#liebermann"/>Gyf hé wæpne g<hi rend="italic">e</hi>brede ⁊ ne feohte, sy be healfu<hi rend="italic">m</hi> ðam.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="39.1" corresp="#wit-q"><pb n="73" ed="#liebermann"/>Si arma extrahat, nec inde pugnet, sit dimidium hoc.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="80" ed="#attenborough"/>Gif he wæpne gebrede ⁊ no<ptr type="editorNote" n="24" target="#Af_39-1.attnote.fn.24"/> feohte, sie be healfum ðam.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="40.1" corresp="#wit-e"><pb n="338" ed="#jurasinski-and-oliver"/>Gif he wæpne gebrede ⁊ no feohte, sie be healfum ðam.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="73" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_39-1.lnote.de.1"/> er eine Waffe zückt<ptr type="liebermannNote" n="2" target="#Af_39-1.lnote.de.2"/>, jedoch nicht ficht, sei [die Busse] mit halb so viel.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he draws a weapon but does not fight, let [the compensation] be half as much.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="81" ed="#attenborough"/>If he draws his weapon, but does not fight, the [compensation] shall be half this sum.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="415" ed="#whitelock"/>If he draws a weapon and does not fight, it is to be half as much.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="339" ed="#jurasinski-and-oliver"/>If he draws a weapon but does not fight, let it be half that.</ab>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="337"><ref target="clause:Af_38-1">Af 38.1</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de">-ed ⁊ ne gefeohte, sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ed ⁊ ne gefeohte, sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rasur vor</hi> de</seg><seg type="translation" xml:lang="en" source="#claude">erasure before de</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> ne</seg><seg type="translation" xml:lang="en" source="#claude">altered to ne</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">erstes</hi> e <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">first e on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_39-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">72</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_39-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Hieraus Hn 81, 4</seg><seg type="translation" xml:lang="en" source="#claude">From this Hn 81, 4</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_39-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">59</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Waffenzücken 3f.; Halbverletzung</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Waffenzücken 3f.; Halbverletzung</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_39-1.attnote.fn.24" n="24" source="#attenborough"><bibl><biblScope unit="page">80</biblScope></bibl><label>no</label><seg type="original" xml:lang="en"><hi rend="italic">ne</hi>. B, H.</seg></note>
      </div>
