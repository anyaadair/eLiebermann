    <body>
      <div type="clause" n="7.3">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 7.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 7.3"><pb n="632" ed="#liebermann"/>Et si de eis caseum<ptr type="liebermannNote" n="b" target="#ECf_7-3.lnote.la.fn.b"/> fecerit, caseum<ptr type="liebermannNote" n="14" target="#ECf_7-3.lnote.la.14"/> decimum; <ptr type="liebermannNote" n="15" target="#ECf_7-3.lnote.la.15"/>si<ptr type="liebermannNote" n="16" target="#ECf_7-3.lnote.la.16"/> non fecerit, lac decima die.</ab>
        <note type="comparison" source="#liebermann" n="632"><label>printed alongside</label> <ref target="clause:ECfRetr_7-3">ECf retr 7.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 632 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-3.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Zehnt von</hi> lana, agni, casei <hi rend="italic">fordert, neben früher Verzehntetem,</hi> Syn. Westmon. a. 1175, <hi rend="italic">bei Seckel</hi> Deutsche Ztschr. f. Kirchenrecht IX 172</seg><seg type="translation" xml:lang="en" source="#claude">the Synod of Westminster of 1175 demands tithe of lana, agni, casei, besides what was tithed earlier; Seckel, Deutsche Ztschr. f. Kirchenrecht IX 172</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-3.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">cas.—fecerit <hi rend="italic">überspringt Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Do skips cas.—fecerit</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-3.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hr adds et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_7-3.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">632</biblScope></bibl><seg type="original" xml:lang="de">autem <hi rend="italic">fügt zu Ad;</hi> uel <hi rend="italic">statt</hi> si n. f. <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad adds autem; uel instead of si n. f. S</seg></note>
      </div>
