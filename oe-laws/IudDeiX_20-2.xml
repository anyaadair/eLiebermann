      <div type="clause" n="20.2">
        <head><ref type="lawCode" target="law:IudDeiX">Iud Dei X</ref> 20.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei X 20.2" corresp="#wit-lat"><pb n="418" ed="#liebermann"/>Si autem culpabilis aut reus contempserit et quasi temptator iudicium tuum adierit<ptr type="liebermannNote" n="18" target="#IudDeiX_20-2.lnote.oe.18"/>, aut per herbas uel<ptr type="liebermannNote" n="19" target="#IudDeiX_20-2.lnote.oe.19"/> quaecumque temptamenta seu molimina maleficiosa peccata sua confiteri noluerit, sed defendere<ptr type="liebermannNote" n="20" target="#IudDeiX_20-2.lnote.oe.20"/>, inflatus per afflatorem<ptr type="liebermannNote" n="21" target="#IudDeiX_20-2.lnote.oe.21"/> malitiae, contra examen ueritatis tuae, iustissime et misericordissime domine<ptr type="liebermannNote" n="22" target="#IudDeiX_20-2.lnote.oe.22"/> Deus,</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 418 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_20-2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de">aud. <hi rend="italic">Bc</hi></seg><seg type="translation" xml:lang="en" source="#claude">aud. Bc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_20-2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de">per <hi rend="italic">fügt zu Al</hi></seg><seg type="translation" xml:lang="en" source="#claude">Al adds per</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_20-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de">deff. <hi rend="italic">Bc Al</hi></seg><seg type="translation" xml:lang="en" source="#claude">deff. Bc Al</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_20-2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de">afflict. <hi rend="italic">Al Bc</hi></seg><seg type="translation" xml:lang="en" source="#claude">afflict. Al Bc</seg></note>
