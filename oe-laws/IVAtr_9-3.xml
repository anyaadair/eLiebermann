    <body>
      <div type="clause" n="9.3">
        <head><ref type="lawCode" target="law:IVAtr">IV Atr</ref> 9.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="9.3" corresp="#wit-q"><pb n="236" ed="#liebermann"/>Et custodiant omnes monetam, sicut uos docere precipio et omnes elegimus.<ptr type="liebermannNote" n="21" target="#IVAtr_9-3.lnote.oe.21"/></ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="9.3" corresp="#wit-q"><pb n="78" ed="#robertson"/>Et custodiant omnes monetam, sicut vos docere praecipio et omnes elegimus.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="237" ed="#liebermann"/>Und alle sollen die Münze so [aufrecht<ptr type="liebermannNote" n="1" target="#IVAtr_9-3.lnote.de.1"/>] halten, wie ich euch verordnen lasse und wie wir alle entschieden haben.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let all maintain the coinage as I have had you instructed and as we have all decided.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q"><pb n="79" ed="#robertson"/>And the coinage is to be maintained by all at the standard which I lay down in your instructions, in accordance with the decision at which we have all arrived.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_9-3.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">236</biblScope></bibl><seg type="original" xml:lang="de">elig. <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">elig. MHk</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_9-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">166</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S</hi>. 9, 2¹; wohl im Sinne von <hi rend="italic">tenere et servare</hi> Hn mon 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See</hi> 9, 2¹; probably in the sense of <hi rend="italic">tenere et servare</hi> Hn mon 1</seg></note>
      </div>
    </body>
