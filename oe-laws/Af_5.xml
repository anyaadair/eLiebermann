        <note type="liebermannNote" subtype="textual" xml:id="Af_5.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">51</biblScope></bibl><seg type="original" xml:lang="de">Ut quicumque <hi rend="italic">st.</hi> Si quis <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ut quicumque instead of Si quis Lond</seg></note>
