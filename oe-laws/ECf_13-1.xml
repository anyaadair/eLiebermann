      <div type="clause" n="13.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 13.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 13.1"><pb n="640" ed="#liebermann"/><ptr type="liebermannNote" n="10" target="#ECf_13-1.lnote.la.10"/>Diuisiones<ptr type="liebermannNote" n="11" target="#ECf_13-1.lnote.la.11"/> hundredorum<ptr type="liebermannNote" n="12" target="#ECf_13-1.lnote.la.12"/> — wapentagiorum — comitibus<ptr type="liebermannNote" n="13" target="#ECf_13-1.lnote.la.13"/>, uicecomitibus cum iudicio<ptr type="liebermannNote" n="a" target="#ECf_13-1.lnote.la.fn.a"/> comitatus.<ptr type="liebermannNote" n="*" target="#ECf_13-1.lnote.la.star"/></ab>
        <note type="comparison" source="#liebermann" n="640"><label>printed alongside</label> <ref target="clause:ECfRetr_13-1">ECf retr 13.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 640 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s asterisk introduces the London collection’s insertion here, 13, 1 A–A 3.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_13-1.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 12, 9<hi rend="italic">g</hi></seg><seg type="translation" xml:lang="en" source="#claude">see above, 12, 9, note g</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">c. 14 <hi rend="italic">stellt vor</hi> 13, 1 <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hk puts c. 14 before 13, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">autem <hi rend="italic">fügt zu Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad adds autem</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu S Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">S Do add et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu S</hi></seg><seg type="translation" xml:lang="en" source="#claude">S adds et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_13-1.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">640</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier schaltet Lond s. XIII. in. ein in die Retr.:</hi></seg><seg type="translation" xml:lang="en" source="#claude">here Lond s. XIII. in. inserts into the Retr.:</seg></note>
