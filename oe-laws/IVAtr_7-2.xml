    <body>
      <div type="clause" n="7.2">
        <head><ref type="lawCode" target="law:IVAtr">IV Atr</ref> 7.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7.2" corresp="#wit-q"><pb n="236" ed="#liebermann"/>Et habeat postea dampnum illud ex incuria sua, ut cambiat<ptr type="liebermannNote" n="6" target="#IVAtr_7-2.lnote.oe.6"/> ab institutis monetariis purum et recte<ptr type="liebermannNote" n="7" target="#IVAtr_7-2.lnote.oe.7"/> appendens.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="7.2" corresp="#wit-q"><pb n="76" ed="#robertson"/>Et habeat postea dampnum illud ex incuria sua, ut cambiat<ptr type="editorNote" n="6" target="#IVAtr_7-2.robnote.fn.6"/> ab institutis monetariis purum et recte<ptr type="editorNote" n="7" target="#IVAtr_7-2.robnote.fn.7"/> appendens.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="237" ed="#liebermann"/>Und [dieser Kaufmann] trage danach infolge seiner Unachtsamkeit den Schaden, dass er von den angestellten Münzern<ptr type="liebermannNote" n="1" target="#IVAtr_7-2.lnote.de.1"/> reines und vollwichtiges Geld [gegen sein mangelhaftes] einwechseln muss.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let [this merchant] afterwards bear the loss resulting from his carelessness, in that he must exchange [his defective money] for pure money of full weight from the appointed moneyers.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q"><pb n="77" ed="#robertson"/>And afterwards such a trader shall pay the penalty of his carelessness by having to change [his base money] for pure money of the proper weight obtained from the authorised moneyers<ptr type="editorNote" n="1" target="#IVAtr_7-2.robnote.n.1"/>.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_7-2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">236</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_7-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">236</biblScope></bibl><seg type="original" xml:lang="de">-tum <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tum Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_7-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">166</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Münze 12. Neben <hi rend="italic">monetarium</hi> erhält <hi rend="italic">cambiatores</hi> vom König bestätigt Bury Saint Edmunds a. 1087—97; Davis <hi rend="italic">Reg. Agnorm</hi>. n. <hi rend="smallcaps">lxiij</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Münze 12. Besides a <hi rend="italic">monetarium</hi>, Bury Saint Edmunds receives royal confirmation of <hi rend="italic">cambiatores</hi> a. 1087—97; Davis <hi rend="italic">Reg. Agnorm</hi>. n. <hi rend="smallcaps">lxiij</hi></seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_7-2.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">326</biblScope></bibl><seg type="original" xml:lang="en">The business of exchange was separated from that of coining money by Edward I, see Cunningham, <hi rend="italic">Growth of Industry</hi>, p. 283.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_7-2.robnote.fn.6" n="6" source="#robertson"><bibl><biblScope unit="page">76</biblScope></bibl><label>cambiat</label><seg type="original" xml:lang="en">Om. M, Hk, Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_7-2.robnote.fn.7" n="7" source="#robertson"><bibl><biblScope unit="page">76</biblScope></bibl><label>recte</label><seg type="original" xml:lang="en"><hi rend="italic">rectum</hi> Br.</seg></note>
      </div>
    </body>
