    <body>
      <div type="clause" n="15">
        <head>Af Rb 15</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15" corresp="#wit-e"><pb n="16" ed="#liebermann"/>XV. Be þam<ptr type="liebermannNote" n="20" target="#Rubrics-Af_15.lnote.oe.20"/> monnu<hi rend="italic">m<ptr type="liebermannNote" n="21" target="#Rubrics-Af_15.lnote.oe.21"/></hi> þe beforan biscopu<hi rend="italic">m<ptr type="liebermannNote" n="22" target="#Rubrics-Af_15.lnote.oe.22"/></hi> feohtað.<ptr type="liebermannNote" n="23" target="#Rubrics-Af_15.lnote.oe.23"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15" corresp="#wit-ot-frag"><pb n="16" ed="#liebermann"/>… þam monnum þe beforan bisceopū f …</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15" corresp="#wit-g-prol"><pb n="16" ed="#liebermann"/>XV. Be ðan mannu<hi rend="italic">m</hi> ðe beforan bisceopu<hi rend="italic">m</hi> feohtað.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15" corresp="#wit-h"><pb n="17" ed="#liebermann"/>XV. Be þam monnum<ptr type="liebermannNote" n="3" target="#Rubrics-Af_15.lnote.oe.3"/> ðe beforan biscope feohtaþ.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="15" corresp="#wit-q"><pb n="17" ed="#liebermann"/>De illis qui coram<ptr type="liebermannNote" n="16" target="#Rubrics-Af_15.lnote.oe.16"/> episcopo pugnant.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="190" ed="#jurasinski-and-oliver"/>XV Be þam monnu<hi rend="italic">m</hi> þe beforan biscopu<hi rend="italic">m</hi> feohtað</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="190" ed="#jurasinski-and-oliver"/>Be ða<hi rend="italic">m</hi> þ<hi rend="italic">æt</hi> man toforan b<hi rend="italic">isceope</hi> feohteð Be ða<hi rend="italic">m</hi> gif man of myran folan adrifþ oððe cucealf Ðe oðru<hi rend="italic">m</hi> his unmagu<hi rend="italic">m</hi> ætfæsteð</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="17" ed="#liebermann"/>Von denjenigen Männern, die in Gegenwart von Bischöfen<ptr type="liebermannNote" n="1" target="#Rubrics-Af_15.lnote.de.1"/> fechten.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of those men who fight in the presence of bishops.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="191" ed="#jurasinski-and-oliver"/>Concerning men who fight in the presence of bishops</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="191" ed="#jurasinski-and-oliver"/>Concerning that a man fights before a bishop Concerning if a man causes abortion of a foal from a mare or a cow-calf He who afflicts the child of another</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_15.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">17</biblScope></bibl><seg type="original" xml:lang="de">pug. cor. archiepiscopo vel ep. vel aldremanno [vel e. vel a. <hi rend="italic">fehlt Br</hi>]. De vaccis et equabus furatis (vel pregnantibus affligatis <hi rend="italic">fehlt Br</hi>). De aliquo inbecili in commendatione mortuo <hi rend="italic">fügt Hk Br zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">pug. cor. archiepiscopo vel ep. vel aldremanno [vel e. vel a. lacking in Br]. De vaccis et equabus furatis (vel pregnantibus affligatis lacking in Br). De aliquo inbecili in commendatione mortuo added by Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_15.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> gefeohtum <hi rend="italic">statt</hi> þam — feohtað <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">only gefeohtum instead of þam — feohtað Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_15.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt So</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_15.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de">bisceo. <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">bisceo. So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_15.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de">Be ðon ðe mon myre oþ[þe] cú forstele. Be ðon ðe oþru[m] his unmagum oþfæsteþ <hi rend="italic">fügt zu Ld</hi> [<hi rend="italic">aus B?</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">Be ðon ðe mon myre oþ[þe] cú forstele. Be ðon ðe oþru[m] his unmagum oþfæsteþ added by Ld [from B?]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_15.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">17</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_15.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">40</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">H und Quadr lesen Singular, B die Abkürzung <hi rend="italic">b’</hi>, solche verschuldet vielleicht die Variante</seg><seg type="translation" xml:lang="en" source="#claude">H and Quadr read the singular, B the abbreviation <hi rend="italic">b’</hi>; such an abbreviation perhaps caused the variant</seg></note>
      </div>
    </body>
  </text>
