      <div type="clause" n="48.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 48.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 48.2" corresp="#wit-lat"><pb n="571" ed="#liebermann"/>Si totus comitatus uel sep[arati]m<ptr type="liebermannNote" n="g" target="#Hn_48-2.lnote.oe.g"/> hundreta super aliquibus inplacitentur<ptr type="liebermannNote" n="24" target="#Hn_48-2.lnote.oe.24"/>, et ad aliquem specialiter uel singulariter inculpacio dirigatur, petat, ut ei comitatum suum — qui<ptr type="liebermannNote" n="h" target="#Hn_48-2.lnote.oe.h"/> eiusdem esse dicitur — habere<ptr type="liebermannNote" n="25" target="#Hn_48-2.lnote.oe.25"/> liceat, et cum<ptr type="liebermannNote" n="i" target="#Hn_48-2.lnote.oe.i"/> eo respondeat, ut, sicut omnium una est inculpatio, una emundatio<ptr type="liebermannNote" n="26" target="#Hn_48-2.lnote.oe.26"/> uel emendatio sit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 571 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-2.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">VII <hi rend="italic">Hss. Edd.</hi>, septem <hi rend="italic">wohl aus</hi> sepatim <hi rend="italic">verlesend: zwar handeln mehrere</hi> hundreta <hi rend="italic">oft</hi> (<hi rend="italic">vgl.</hi> 57, 8) <hi rend="italic">einheitlich, aber gerade sieben? Neun Grafschaften antworten königlicher Inquisition</hi> 1080; <hi rend="italic">vgl. meine</hi> Anglonorm. Geschqu. 254</seg><seg type="translation" xml:lang="en" source="#claude">VII MSS edd., septem probably through misreading sepatim: several hundreta do indeed often act as one (cf. 57, 8), but exactly seven? Nine shires answer a royal inquest in 1080; cf. my Anglonorm. Geschqu. 254</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-2.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">welche ‘seine’ Grafschaft heisst (<hi rend="italic">da er in ihr wohnt</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">which is called ‘his’ county (since he lives in it)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-2.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 48, 3</seg><seg type="translation" xml:lang="en" source="#claude">cf. 48, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-2.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">-tetur <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tetur Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-2.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">d <hi rend="italic">fügt ein, vom Schreiber unterpunctirt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">d inserted by Sc, dotted for deletion by the scribe</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-2.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">emu. u. <hi rend="italic">nur</hi> [<hi rend="italic">vgl.</hi> 52, 1<hi rend="italic">b.</hi> 59, 4<hi rend="italic">a</hi>] <hi rend="italic">Sc Hg; fehlt übr.;</hi> emu. uel e. sit <hi rend="italic">fehlt Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">emu. u. only [cf. 52, 1<hi rend="italic">b.</hi> 59, 4<hi rend="italic">a</hi>] Sc Hg; lacking in the rest; emu. uel e. sit lacking Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Grafschaft 21; Hundred 21a; Vertreter 4f.—<hi rend="italic">seplē</hi> (verlesen aus <hi rend="italic">sepatī</hi>, wie ich emendierte)—<hi rend="italic">spũalit'</hi> (d. i. <hi rend="italic">spiritualiter</hi>) <hi rend="italic">uel sing</hi>.—<hi rend="italic">emu</hi>.{26} <hi rend="italic">uel</hi> fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Grafschaft 21; Hundred 21a; Vertreter 4f.—<hi rend="italic">seplē</hi> (misread from <hi rend="italic">sepatī</hi>, as I emended)—<hi rend="italic">spũalit'</hi> (i.e. <hi rend="italic">spiritualiter</hi>) <hi rend="italic">uel sing</hi>.—<hi rend="italic">emu</hi>.{26} <hi rend="italic">uel</hi> lacking Rs</seg></note>
      </div>
