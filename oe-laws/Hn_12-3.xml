    <body>
      <div type="clause" n="12.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 12.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 12.3" corresp="#wit-lat"><pb n="558" ed="#liebermann"/>Hec emendantur<ptr type="liebermannNote" n="l" target="#Hn_12-3.lnote.oe.l"/> wera<ptr type="liebermannNote" n="17" target="#Hn_12-3.lnote.oe.17"/>, si ad emendacionem ueniat<ptr type="liebermannNote" n="18" target="#Hn_12-3.lnote.oe.18"/>: qui<ptr type="liebermannNote" n="b" target="#Hn_12-3.lnote.oe.b"/> in ecclesia fecerit homicidium; persolucio furti<ptr type="liebermannNote" n="19" target="#Hn_12-3.lnote.oe.19"/> uel robarie; qui furem<ptr type="liebermannNote" n="n" target="#Hn_12-3.lnote.oe.n"/> plegiatum amiserit<ptr type="liebermannNote" n="20" target="#Hn_12-3.lnote.oe.20"/>; qui ei obuiauerit et gratis sine uociferatione dimiserit<ptr type="liebermannNote" n="o" target="#Hn_12-3.lnote.oe.o"/>; qui ei<ptr type="liebermannNote" n="p" target="#Hn_12-3.lnote.oe.p"/> consentiet in aliquo; homicidium wera<ptr type="liebermannNote" n="21" target="#Hn_12-3.lnote.oe.21"/> soluatur uel werelada<ptr type="liebermannNote" n="q" target="#Hn_12-3.lnote.oe.q"/><ptr type="liebermannNote" n="22" target="#Hn_12-3.lnote.oe.22"/> negetur; si uxoratus homo fornicetur<ptr type="liebermannNote" n="23" target="#Hn_12-3.lnote.oe.23"/>; qui<ptr type="liebermannNote" n="r" target="#Hn_12-3.lnote.oe.r"/> uiduam duxerit ante unum annum; qui in<ptr type="liebermannNote" n="s" target="#Hn_12-3.lnote.oe.s"/> hostico<ptr type="liebermannNote" n="24" target="#Hn_12-3.lnote.oe.24"/> uel<ptr type="liebermannNote" n="25" target="#Hn_12-3.lnote.oe.25"/> familia regis pacem<ptr type="liebermannNote" n="26" target="#Hn_12-3.lnote.oe.26"/> fregerit, si<ptr type="liebermannNote" n="t" target="#Hn_12-3.lnote.oe.t"/> ad emendandum uenire poterit<ptr type="liebermannNote" n="27" target="#Hn_12-3.lnote.oe.27"/>; si prepositus pro firme adiutorio witam<ptr type="liebermannNote" n="u" target="#Hn_12-3.lnote.oe.u"/><ptr type="liebermannNote" n="4" target="#Hn_12-3.lnote.oe.4"/> exigat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 558 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 11, 1<hi rend="italic">a</hi>. 79, 5</seg><seg type="translation" xml:lang="en" source="#claude">cf. 11, 1a. 79, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">citirt</hi> 87, 6<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">cited 87, 6a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">begrenzte Geldstrafe fordert</hi> Leis Wl 3 — 3, 3</seg><seg type="translation" xml:lang="en" source="#claude">a fixed fine is required by Leis Wl 3 — 3, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt</hi> 65, 1; <hi rend="italic">vgl.</hi> 59, 18</seg><seg type="translation" xml:lang="en" source="#claude">repeated 65, 1; cf. 59, 18</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">II Cn.</hi> 31, 1<hi rend="italic">a</hi>; 2 <hi rend="italic">fordert Wergeld, wenn der Herr den diebischen Mann fortlässt</hi></seg><seg type="translation" xml:lang="en" source="#claude">II Cn. 31, 1a; 2 requires wergild if the lord lets the thievish man escape</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 64, 4</seg><seg type="translation" xml:lang="en" source="#claude">cf. 64, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 11, 13<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">see above 11, 13b</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 10, 1. 12, 3. 13, 1; 7 <hi rend="italic">f.</hi> 16. 80, 1; 7</seg><seg type="translation" xml:lang="en" source="#claude">cf. 10, 1. 12, 3. 13, 1; 7 f. 16. 80, 1; 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verfällt</hi> in misericordia regis <hi rend="italic">oder Wergeld oder Leibesstrafe</hi> 13, 7 <hi rend="italic">f.</hi> 68, 2. 80, 1; 7</seg><seg type="translation" xml:lang="en" source="#claude">is liable in misericordia regis, or to wergild or corporal punishment 13, 7 f. 68, 2. 80, 1; 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht aus Angelsächs. Cnut</hi></seg><seg type="translation" xml:lang="en" source="#claude">perhaps from the Anglo-Saxon Cnut</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">wyt. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">wyt. Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">werra <hi rend="italic">aus</hi> weta <hi rend="italic">corr. Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">werra corrected from weta Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">-iant <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iant Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. aus</hi> furtił <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected from furtił Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. vom Corr. aus</hi> -runt <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the corrector from -runt Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">werra <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">werra Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">werral. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">werral. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">-catur <hi rend="italic">Wi Tho.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-catur Wi Tho.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">hostio <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">hostio <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">in added by Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">pacis <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">pacis Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">possit <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">possit Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Wergeld 30; Kirchenfrieden 2a. 4c. 6d; Diebstahl 15 ff; Freilassen 3a</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Wergeld 30; Kirchenfrieden 2a. 4c. 6d; Diebstahl 15 ff; Freilassen 3a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.b-2" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de">Wergeld ist hier Strafe, also das des Täters, nicht des Erschlagenen; <hi rend="italic">vgl. Gl</hi> Totschlag 16e</seg><seg type="translation" xml:lang="en" source="#claude">Wergild here is a punishment, and so it is that of the offender, not of the slain man; <hi rend="italic">cf. Gl</hi> Totschlag 16e</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_12-3.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Ehebruch 4b—<hi rend="italic">uel</hi>{25} <hi rend="italic">in f</hi>.—<hi rend="italic">posset</hi>{27} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Ehebruch 4b—<hi rend="italic">uel</hi>{25} <hi rend="italic">in f</hi>.—<hi rend="italic">posset</hi>{27} Rs</seg></note>
      </div>
