        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-12.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">30</biblScope></bibl><seg type="original" xml:lang="de">to <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">to Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-12.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">30</biblScope></bibl><seg type="original" xml:lang="de">sy heo <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy heo Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-12.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">30</biblScope></bibl><seg type="original" xml:lang="de">-wa <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">-wa So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-12.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">30</biblScope></bibl><seg type="original" xml:lang="de">oðra <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">oðra So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-12.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">30</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Statt der nächsten zwei Sätze:</hi> Ac gif hio ne licie{a} hire hlafordes eagum se hie gebohte{b}, læte hie faran freo, ac nage{c} he hie ut on ælþeodig folc to bebycganne, gif he hire ne recce [<hi rend="italic">näher zur Exodus</hi>] <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">Instead of the next two sentences: Ac gif hio ne licie{a} hire hlafordes eagum se hie gebohte{b}, læte hie faran freo, ac nage{c} he hie ut on ælþeodig folc to bebycganne, gif he hire ne recce [closer to Exodus] So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-12.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">30</biblScope></bibl><seg type="original" xml:lang="de">hi <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hi Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-12.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">30</biblScope></bibl><seg type="original" xml:lang="de">ælþe. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ælþe. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-12.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">30</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-12.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">30</biblScope></bibl><seg type="original" xml:lang="de">hi <hi rend="spaced">faran</hi> <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hi <hi rend="italic">faran</hi> Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-12.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">30</biblScope></bibl><seg type="original" xml:lang="de">þonne he alyfe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þonne he alyfe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-12.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">30</biblScope></bibl><seg type="original" xml:lang="de">sunu <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sunu So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-12.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">30</biblScope></bibl><seg type="original" xml:lang="de">-mænne <hi rend="italic">Ld;</hi> do hire gifta locig <hi rend="italic">folgt durchstrichen So</hi></seg><seg type="translation" xml:lang="en" source="#claude">-mænne Ld; do hire gifta locig follows, struck through, So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-12.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">30</biblScope></bibl><seg type="original" xml:lang="de">hire swa swa dohtru<hi rend="italic">m</hi> gedafenað; gif he oðerne{d} genimme, do hire gifta ⁊ loc. [<hi rend="italic">näher zur Exodus</hi>] <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">hire swa swa dohtru<hi rend="italic">m</hi> gedafenað; gif he oðerne{d} genimme, do hire gifta ⁊ loc. [closer to Exodus] So</seg></note>
