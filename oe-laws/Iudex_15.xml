  <text>
    <body>
      <div type="clause" n="15">
        <head><ref type="lawCode" target="law:Iudex">Iudex</ref> 15</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15" corresp="#wit-g-a"><pb n="476" ed="#liebermann"/>In dóme ne sceal man æniges mannes mæð sceawian, ac þa spæce.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="15" corresp="#wit-q"><pb n="476" ed="#liebermann"/>Iustum iudicium est, ubi non persona, sed<ptr type="liebermannNote" n="10" target="#Iudex_15.lnote.oe.10"/> opera considerantur.<ptr type="liebermannNote" n="11" target="#Iudex_15.lnote.oe.11"/></ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="476" ed="#liebermann"/>Beim Urtheilsprechen soll man nicht auf irgend jemandes Rang, sondern auf die Klagesache achten.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">In judging one must look not at anyone's rank but at the suit.</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-g-a">In (matters of) judgement, one should not take a man’s rank into consideration.</ab>
        <note type="comparison" source="#liebermann" n="476">Isidor, Sent. III 53.1; <ref target="clause:Iudex_3">Iudex 3</ref>; <ref target="clause:Iudex_16">Iudex 16</ref></note>
        <note type="comparisonPrinted" source="#liebermann">53, 1 | s. 3. 16</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Iudex_16">Iudex 16</ref></note>
        <note type="editorial">U: translator unrecorded: check; Isidore, Sent. III 53.1; compare 3 and 16.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_15.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de">s. o. <hi rend="italic">fehlt MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. o. omitted in MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_15.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de">consideratur <hi rend="italic">HkBr; geänd.</hi> -ratur <hi rend="italic">M</hi></seg><seg type="translation" xml:lang="en" source="#claude">consideratur HkBr; altered to -ratur M</seg></note>
      </div>
    </body>
