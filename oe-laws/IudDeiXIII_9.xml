      <div type="clause" n="9">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 9</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 9" corresp="#wit-lat"><pb n="423" ed="#liebermann"/>Tunc<ptr type="liebermannNote" n="c" target="#IudDeiXIII_9.lnote.oe.c"/> aspergens eos<ptr type="liebermannNote" n="25" target="#IudDeiXIII_9.lnote.oe.25"/> aqua<ptr type="liebermannNote" n="26" target="#IudDeiXIII_9.lnote.oe.26"/> benedicta dicat ad unumquemque:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 423 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_9.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">9, 1 <hi rend="italic">verbinden die meisten Formeln mit</hi> <hi rend="spaced"><hi rend="italic">Trinken</hi></hi> <hi rend="italic">des Weihwassers</hi> (<hi rend="italic">Zeu.</hi> 619—22. 641. 648. 667. 685. 689), <hi rend="italic">einige mit dem Besprengen</hi> (626. 653. 655; <hi rend="italic">vgl. u.</hi> XIV 9)</seg><seg type="translation" xml:lang="en" source="#claude">Most formulae connect 9, 1 with the <hi rend="italic">drinking</hi> of the holy water (Zeu. 619—22. 641. 648. 667. 685. 689), some with the sprinkling (626. 653. 655; cf. below XIV 9)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_9.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">darüber</hi> eum <hi rend="italic">und so öfter Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">above it eum, and so more often Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_9.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">a. b. <hi rend="italic">fehlt Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. b. omitted in Mg</seg></note>
      </div>
    </body>
