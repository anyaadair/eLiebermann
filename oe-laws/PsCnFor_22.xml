      <div type="clause" n="22">
        <head><ref type="lawCode" target="law:PsCnFor">Ps Cn for</ref> 22</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Ps Cn for 22" corresp="#wit-ho-st-cii"><pb n="624" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#PsCnFor_22.lnote.oe.erkl-clause"/>Si liberalis<ptr type="liebermannNote" n="1" target="#PsCnFor_22.lnote.la.1"/> aliquis feram<ptr type="liebermannNote" n="a" target="#PsCnFor_22.lnote.la.fn.a"/> foreste fugerit<ptr type="liebermannNote" n="b" target="#PsCnFor_22.lnote.la.fn.b"/><ptr type="liebermannNote" n="2" target="#PsCnFor_22.lnote.la.2"/>, siue<ptr type="liebermannNote" n="3" target="#PsCnFor_22.lnote.la.3"/> casu<ptr type="liebermannNote" n="bb" target="#PsCnFor_22.lnote.la.fn.bb"/> siue prehabita uoluntate, ita ut cursu celeri cogatur<ptr type="liebermannNote" n="4" target="#PsCnFor_22.lnote.la.4"/> fera anhelare<ptr type="liebermannNote" n="5" target="#PsCnFor_22.lnote.la.5"/>, <ptr type="liebermannNote" n="c" target="#PsCnFor_22.lnote.la.fn.c"/>decem solidos<ptr type="liebermannNote" n="6" target="#PsCnFor_22.lnote.la.6"/> regi emendet<ptr type="liebermannNote" n="7" target="#PsCnFor_22.lnote.la.7"/>; si<ptr type="liebermannNote" n="8" target="#PsCnFor_22.lnote.la.8"/> illiberalis<ptr type="liebermannNote" n="d" target="#PsCnFor_22.lnote.la.fn.d"/>, dupliciter emendet<ptr type="liebermannNote" n="9" target="#PsCnFor_22.lnote.la.9"/>; si seruus<ptr type="liebermannNote" n="e" target="#PsCnFor_22.lnote.la.fn.e"/>, careat corio<ptr type="liebermannNote" n="10" target="#PsCnFor_22.lnote.la.10"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 624 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-ho-st-cii">If any noble chases a beast of the forest, whether by chance or with premeditated will, so that the beast is made to pant by the swift running, let him pay the king ten shillings compensation; if a non-noble, let him pay double compensation; if a slave, let him lose his hide.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de">liber <hi rend="italic">Ho</hi></seg><seg type="translation" xml:lang="en" source="#claude">liber Ho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o. S.</hi> 623<hi rend="superscript"><hi rend="italic">n</hi></hi></seg><seg type="translation" xml:lang="en" source="#claude">see above, p. 623 note n</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hetzt</hi></seg><seg type="translation" xml:lang="en" source="#claude">hunts (drives, chases)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de">ad cursum impulerit <hi rend="italic">Ho 2 antikisirend</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad cursum impulerit Ho 2, archaizing</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de">sit c. aut (an <hi rend="italic">St</hi>) pr. <hi rend="italic">St Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit c. aut (an St) pr. St Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.la.fn.bb" n="bb" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verf. kennt noch keine Milde für absichtslose Missethat</hi></seg><seg type="translation" xml:lang="en" source="#claude">The author does not yet know any leniency for unintentional misdeeds</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de">cogetur <hi rend="italic">St;</hi> cogitur <hi rend="italic">Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">cogetur St; cogitur Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de">anhil. <hi rend="italic">Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">anhil. Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">In Cn drohen</hi> 10 <hi rend="italic">Schill. für Feiertagsbruch; dass Verf. diese Summe dorther nahm, lässt sich nur aus der Benutzung der folgenden Zeile vermuthen. Doch gilt derselbe Betrag auch o.</hi> 18<hi rend="superscript"><hi rend="italic">g</hi></hi>; <hi rend="italic">u.</hi> 31, 2</seg><seg type="translation" xml:lang="en" source="#claude">In Cn 10 shillings are threatened for breach of a holy day; that the author took this sum from there can only be conjectured from his use of the following line. But the same amount also applies above, 18 note g; below, 31, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de">solidis <hi rend="italic">Ho</hi></seg><seg type="translation" xml:lang="en" source="#claude">solidis Ho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de">-dat <hi rend="italic">St Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dat St Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de">si i. d. e. <hi rend="italic">fehlt Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">si i. d. e. lacking in Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de">= mediocris; <hi rend="italic">s. o.</hi> 3, 1, <hi rend="italic">nicht</hi> unfrei <hi rend="italic">laut</hi> 24 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">= mediocris; see above, 3, 1; not unfree, according to 24 f.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de">-dat <hi rend="italic">St</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dat St</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 5</seg><seg type="translation" xml:lang="en" source="#claude">see above, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">624</biblScope></bibl><seg type="original" xml:lang="de">coreo <hi rend="italic">Cii</hi></seg><seg type="translation" xml:lang="en" source="#claude">coreo Cii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="PsCnFor_22.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">339</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Forst 21. a</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Forst 21. a</seg></note>
      </div>
