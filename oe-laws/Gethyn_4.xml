    <body>
      <div type="clause" n="4">
        <head><ref type="lawCode" target="law:Gethinctho">Geþyncðo</ref> 4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4" corresp="#wit-d"><pb n="456" ed="#liebermann"/>And se ðe swa geþogene forwyrhtan næfde, swore for silfne æft<hi rend="italic">er</hi> his rihte, oððe his þolode.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4" corresp="#wit-h"><pb n="456" ed="#liebermann"/>⁊ se þe swa geþogenne forwyrhtan næfde, swore for sylfne æfter his rihte oððe his þolode.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="4" corresp="#wit-q"><pb n="457" ed="#liebermann"/>Et qui sic promotum<ptr type="liebermannNote" n="12" target="#Gethyn_4.lnote.oe.12"/> hominem non habet, ipse causam suam superiuret uel amittat<ptr type="liebermannNote" n="13" target="#Gethyn_4.lnote.oe.13"/>.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="4" corresp="#wit-in"><pb n="457" ed="#liebermann"/>[61, 1] Qui autem talem<ptr type="liebermannNote" n="18" target="#Gethyn_4.lnote.oe.18"/> non haberet, per semetipsum id faceret aut caréret.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-h"><pb n="10" ed="#rabin-doml"/>And se þe swa geþogenne forwyrhtan næfde swore for sylfne æfter his rihte oððe his þolode.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="457" ed="#liebermann"/>Und wer einen so hochgestiegenen Vertreter<ptr type="liebermannNote" n="1" target="#Gethyn_4.lnote.de.1"/> nicht hatte, der musste<ptr type="liebermannNote" n="2" target="#Gethyn_4.lnote.de.2"/> für sich selbst, um<ptr type="liebermannNote" n="3" target="#Gethyn_4.lnote.de.3"/> sein Recht [zu erstreiten,] schwören oder verlor es [seinen Process].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And whoever did not have so high-risen a representative had to swear for himself to [win] his right, or lost it [his suit].</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-d"><pb n="476" ed="#whitelock"/>And he who had no such distinguished representative, swore in person to obtain his rights, or lost his case.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-h">And he who did not have such a worthy representative swore for himself to his rights or forfeited his case.</ab>
        <note type="comparison" source="#liebermann" n="457"><ref target="clause:IICn_22-2">II Cn 22.2</ref>; <ref target="clause:IICn_22-3">II Cn 22.3</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. | ebd. 22, 3</note>
        <note type="editorial">Liebermann compares II Cn 22.3.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Gethyn_4.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">457</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Gethyn_4.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">457</biblScope></bibl><seg type="original" xml:lang="de">motum <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">motum Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Gethyn_4.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">457</biblScope></bibl><seg type="original" xml:lang="de">amm. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">amm. R</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Gethyn_4.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">259</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">sylf</hi>: ‘in eigener Person’</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">sylf</hi>: ‘in person’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Gethyn_4.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">259</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">sylf</hi>: ‘in eigener Person’</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">sylf</hi>: ‘in person’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Gethyn_4.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">259</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘wegen, zum Zwecke, zielend auf’</seg><seg type="translation" xml:lang="en" source="#claude">‘on account of, for the purpose of, aiming at’</seg></note>
      </div>
