      <div type="clause" n="48.2a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 48.2a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 48.2a" corresp="#wit-lat"><pb n="571" ed="#liebermann"/>Si<ptr type="liebermannNote" n="27" target="#Hn_48-2a.lnote.oe.27"/> eis<ptr type="liebermannNote" n="k" target="#Hn_48-2a.lnote.oe.k"/> alternatim uerum de se testantibus<ptr type="liebermannNote" n="27" target="#Hn_48-2a.lnote.oe.27"/>, quia Francorum et Anglorum plenum est testimonium, ita<ptr type="liebermannNote" n="28" target="#Hn_48-2a.lnote.oe.28"/>.sit; si secus<ptr type="liebermannNote" n="29" target="#Hn_48-2a.lnote.oe.29"/> est, eligantur<ptr type="liebermannNote" n="kk" target="#Hn_48-2a.lnote.oe.kk"/> de melioribus iuraturi<ptr type="liebermannNote" n="30" target="#Hn_48-2a.lnote.oe.30"/> secundum rerum<ptr type="liebermannNote" n="31" target="#Hn_48-2a.lnote.oe.31"/> meritum et cause modum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 571 (two independent readings of the page images, differences settled against the page); Liebermann’s print has a stray full stop in ‘ita.sit’; transcribed as printed</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-2a.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">Francis et Anglis</seg><seg type="translation" xml:lang="en" source="#claude">Francis et Anglis</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-2a.lnote.oe.kk" n="kk" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">kraft königlicher Inquisitionsgewalt lässt der Justicia die Beweisjury wählen</hi></seg><seg type="translation" xml:lang="en" source="#claude">by virtue of the royal power of inquest the justice has the jury of proof chosen</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-2a.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Anakoluth des Verfassers, der</hi> Si ei .. testantur <hi rend="italic">meint oder</hi> Si <hi rend="italic">zu streichen vergisst</hi></seg><seg type="translation" xml:lang="en" source="#claude">an anacoluthon on the part of the author, who means Si ei .. testantur, or forgets to delete Si</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-2a.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">uisum <hi rend="italic">fügt zu Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">uisum added by Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-2a.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">cecus <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">cecus Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-2a.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">-ros <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ros Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-2a.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">571</biblScope></bibl><seg type="original" xml:lang="de">regum <hi rend="italic">K Co Or Gi;</hi> rei <hi rend="italic">Wh Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">regum K Co Or Gi; rei Wh Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_48-2a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Zeugen 3b; Angelsachsen 30. a; Geschworene 6; <hi rend="italic">u</hi>. 92, 11—<hi rend="italic">regum</hi>{31}—48, 3 <hi rend="italic">solus</hi>{32} fehlt—48, 5 <hi rend="italic">quis</hi>{34} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Zeugen 3b; Angelsachsen 30. a; Geschworene 6; <hi rend="italic">below</hi> 92, 11—<hi rend="italic">regum</hi>{31}—48, 3 <hi rend="italic">solus</hi>{32} lacking—48, 5 <hi rend="italic">quis</hi>{34} Rs</seg></note>
