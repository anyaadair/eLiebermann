    <body>
      <div type="clause" n="23.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 23.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 23.1"><pb n="648" ed="#liebermann"/>Quodsi tercia nocte<ptr type="liebermannNote" n="23" target="#ECf_23-1.lnote.la.23"/> hospitatus fuerit, et ipse<ptr type="liebermannNote" n="24" target="#ECf_23-1.lnote.la.24"/> forisfecerit<ptr type="liebermannNote" n="14" target="#ECf_23-1.lnote.la.14"/> alicui, habeat<ptr type="liebermannNote" n="a" target="#ECf_23-1.lnote.oe.erkl-a"/> eum ad rectum tanquam de propria familia, quod<ptr type="liebermannNote" n="26" target="#ECf_23-1.lnote.la.26"/> Angli dicunt: <ptr type="liebermannNote" n="e" target="#ECf_23-1.lnote.la.fn.e"/>Tƿa<ptr type="liebermannNote" n="27" target="#ECf_23-1.lnote.la.27"/> niht<ptr type="liebermannNote" n="28" target="#ECf_23-1.lnote.la.28"/> gest<ptr type="liebermannNote" n="29" target="#ECf_23-1.lnote.la.29"/>, þridde<ptr type="liebermannNote" n="30" target="#ECf_23-1.lnote.la.30"/> niht<ptr type="liebermannNote" n="31" target="#ECf_23-1.lnote.la.31"/> ogen<ptr type="liebermannNote" n="32" target="#ECf_23-1.lnote.la.32"/> hyþen<ptr type="liebermannNote" n="33" target="#ECf_23-1.lnote.la.33"/>.</ab>
        <note type="comparison" source="#liebermann" n="648"><label>printed alongside</label> <ref target="clause:ECfRetr_23-1">ECf retr 23.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 648 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">There is no note 25 in the ECf column of this page: Liebermann’s numbering goes from 24 to 26.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-1.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">zwei Nächte Gast, dritte Nacht [<hi rend="italic">vgl.</hi> 18, 3a] eigener Hausverband <hi rend="italic">Rl adow</hi> [Familiengenoss <hi rend="italic">übrige</hi>]. <hi rend="italic">Provinziell lebt noch</hi> hyne, hind; <hi rend="italic">Earle</hi> Landchar. 470</seg><seg type="translation" xml:lang="en" source="#claude">two nights a guest, the third night one’s own household Rl adow [member of the family, the others]. Regionally hyne, hind still lives on; Earle, Landchar. 470</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-1.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">eum <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hk adds eum</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-1.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-1.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-1.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">nam <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">nam Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-1.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Ad No;</hi> tuua <hi rend="italic">S;</hi> tƿo <hi rend="italic">Rl Hr;</hi> tuo <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Ad No; tuua S; tƿo Rl Hr; tuo Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-1.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Hk;</hi> nicht <hi rend="italic">Rl; geänd. in</hi> nihte <hi rend="italic">Ad;</hi> nite <hi rend="italic">No;</hi> nicte <hi rend="italic">S;</hi> nych <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Hk; nicht Rl; altered to nihte Ad; nite No; nicte S; nych Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-1.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">gist <hi rend="italic">Ad No;</hi> geste <hi rend="italic">S;</hi> īpī <hi rend="italic">fügt zu No</hi></seg><seg type="translation" xml:lang="en" source="#claude">gist Ad No; geste S; No adds īpī</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-1.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">tþridde <hi rend="italic">Ad;</hi> þe þirdde <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">tþridde Ad; þe þirdde S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-1.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">nicht <hi rend="italic">Rl;</hi> nicte <hi rend="italic">S;</hi> nych <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">nicht Rl; nicte S; nych Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-1.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">oyen <hi rend="italic">Hk;</hi> oghan <hi rend="italic">Rl;</hi> ogene <hi rend="italic">Ad No;</hi> agen <hi rend="italic">S;</hi> ouine <hi rend="italic">Hr;</hi> age <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">oyen Hk; oghan Rl; ogene Ad No; agen S; ouine Hr; age Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-1.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">hy þen <hi rend="italic">Rl;</hi> he þen <hi rend="italic">Ad Do No;</hi> hine <hi rend="italic">Hk Hr S;</hi> hyne <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">hy þen Rl; he þen Ad Do No; hine Hk Hr S; hyne Cl</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But if he has been lodged for a third night, and he commits an offence against anyone, let him have him to right as of his own household, as the English say: <hi rend="italic">Tƿa niht gest, þridde niht ogen hyþen</hi> ('Two nights a guest, the third night one's own household').</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23-1.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd.</hi> Haushalt 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid.</hi> Haushalt 2</seg></note>
      </div>
    </body>
  </text>
