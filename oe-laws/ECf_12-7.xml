    <body>
      <div type="clause" n="12.7">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 12.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 12.7"><pb n="639" ed="#liebermann"/><ptr type="liebermannNote" n="8" target="#ECf_12-7.lnote.la.8"/>Pax autem<ptr type="liebermannNote" n="9" target="#ECf_12-7.lnote.la.9"/> quatuor chiminorum<ptr type="liebermannNote" n="10" target="#ECf_12-7.lnote.la.10"/> et<ptr type="liebermannNote" n="11" target="#ECf_12-7.lnote.la.11"/> aquarum predictarum sub maiori iudicio quod<ptr type="liebermannNote" n="12" target="#ECf_12-7.lnote.la.12"/> superius<ptr type="liebermannNote" n="c" target="#ECf_12-7.lnote.la.fn.c"/> diximus continetur<ptr type="liebermannNote" n="13" target="#ECf_12-7.lnote.la.13"/>: de assaltu<ptr type="liebermannNote" n="14" target="#ECf_12-7.lnote.la.14"/>.</ab>
        <note type="comparison" source="#liebermann" n="639"><label>printed alongside</label> <ref target="clause:ECfRetr_12-7">ECf retr 12.7</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 639 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-7.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 12, 1; 2</seg><seg type="translation" xml:lang="en" source="#claude">see above, 12, 1; 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-7.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">De pace chiminorum <hi rend="italic">überschreibt Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cl heads it De pace chiminorum</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-7.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-7.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">chem. <hi rend="italic">Hk Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">chem. Hk Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-7.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">maiorum <hi rend="italic">fügt zu Hk</hi> [<hi rend="italic">aus</hi> 12, 1]</seg><seg type="translation" xml:lang="en" source="#claude">Hk adds maiorum [from 12, 1]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-7.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">quam <hi rend="italic">Hk</hi> [<hi rend="italic">falsch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">quam Hk [wrong]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-7.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">-nentur <hi rend="italic">S;</hi> scilicet <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nentur S; Hk adds scilicet</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-7.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">639</biblScope></bibl><seg type="original" xml:lang="de">et de ceteris forisfacturis <hi rend="italic">fügt zu Hk</hi> [<hi rend="italic">missverstehend</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">Hk adds et de ceteris forisfacturis [misunderstanding]</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But the peace of the four highways and of the aforesaid waters is held under the greater judgment which we stated above: for assault.</ab>
      </div>
    </body>
  </text>
