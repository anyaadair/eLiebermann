      <div type="clause" n="7.4">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 7.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 7.4" corresp="#wit-lat"><pb n="553" ed="#liebermann"/>Debet<ptr type="liebermannNote" n="q" target="#Hn_7-4.lnote.oe.q"/> autem scyregemot<ptr type="liebermannNote" n="25" target="#Hn_7-4.lnote.oe.25"/> et<ptr type="liebermannNote" n="26" target="#Hn_7-4.lnote.oe.26"/> burgemot<ptr type="liebermannNote" n="27" target="#Hn_7-4.lnote.oe.27"/> bis, hundreta<ptr type="liebermannNote" n="r" target="#Hn_7-4.lnote.oe.r"/> uel<ptr type="liebermannNote" n="28" target="#Hn_7-4.lnote.oe.28"/> wapentagia<ptr type="liebermannNote" n="29" target="#Hn_7-4.lnote.oe.29"/> duodecies in anno congregari, et septem<ptr type="liebermannNote" n="s" target="#Hn_7-4.lnote.oe.s"/> diebus antea submoneri<ptr type="liebermannNote" n="30" target="#Hn_7-4.lnote.oe.30"/>, nisi publicum comodum uel efficiencie<ptr type="liebermannNote" n="t" target="#Hn_7-4.lnote.oe.t"/><ptr type="liebermannNote" n="31" target="#Hn_7-4.lnote.oe.31"/> regis<ptr type="liebermannNote" n="32" target="#Hn_7-4.lnote.oe.32"/> dominica neccessitas terminum preueniat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 553 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-4.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dies benutzt Lond zu</hi> E Cf. 32 B 11</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Lond uses this for</hi> E Cf. 32 B 11</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-4.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht aus Hu</hi> 1: 4 ebdomadas; <hi rend="italic">vgl.</hi> 51, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">perhaps from Hu</hi> 1: 4 ebdomadas; <hi rend="italic">cf.</hi> 51, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-4.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">sex <hi rend="italic">Sc Hg;</hi> VII <hi rend="italic">übr., auch u.</hi> 51, 2<hi rend="italic">a</hi> (41, 2; 46, 1); <hi rend="italic">E Cf.</hi> 32 <hi rend="italic">B</hi> 11</seg><seg type="translation" xml:lang="en" source="#claude">sex <hi rend="italic">Sc Hg;</hi> VII <hi rend="italic">the rest, also below</hi> 51, 2<hi rend="italic">a</hi> (41, 2; 46, 1); <hi rend="italic">E Cf.</hi> 32 <hi rend="italic">B</hi> 11</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-4.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">etwa</hi> ‘Macht, Regierungsgewalt’; <hi rend="italic">anders</hi> 66, 6<hi rend="italic">b; bei Cicero für</hi> ενεργεια</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">roughly</hi> ‘power, governmental authority’; <hi rend="italic">otherwise</hi> 66, 6<hi rend="italic">b; in Cicero for</hi> ενεργεια</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-4.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">sirestmot <hi rend="italic">Corr. Sc;</hi> syresmot <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">sirestmot <hi rend="italic">corrector Sc;</hi> syresmot <hi rend="italic">Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-4.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">et b. <hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">et b. <hi rend="italic">omitted Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-4.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">burgimotis <hi rend="italic">ohne</hi> bis <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">burgimotis <hi rend="italic">without</hi> bis <hi rend="italic">Wh</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-4.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt KOr;</hi> u. w. <hi rend="italic">vom Corr. übergeschr. Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">omitted KOr;</hi> u. w. <hi rend="italic">written above by the corrector Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-4.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">-achia <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-achia <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-4.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">summoniri <hi rend="italic">Wi;</hi> submotum, <hi rend="italic">am Rande</hi> submonitionem <hi rend="italic">Wh; fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">summoniri <hi rend="italic">Wi;</hi> submotum, <hi rend="italic">in the margin</hi> submonitionem <hi rend="italic">Wh; omitted Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-4.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">-nte <hi rend="italic">Sc; fehlt Wi Tho.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nte <hi rend="italic">Sc; omitted Wi Tho.</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-4.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Sc;</hi> d. r. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">so Sc;</hi> d. r. <hi rend="italic">Co Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-4.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">316</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Hundred 17. 30. 31—<hi rend="italic">et</hi>{26} <hi rend="italic">bu</hi>. fehlt—<hi rend="italic">hu. et</hi> {28} <hi rend="italic">wa</hi>. Rs.—Die Vorladung (<hi rend="italic">s. d. Gl</hi> 1d; <hi rend="italic">h</hi>.{r} <hi rend="italic">v. w. d</hi>. ist Nachtrag) erging nur an Parteien und Urteilfinder, nicht an alle Mitglieder, nach Stubbs <hi rend="italic">Lect</hi>. 167</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Hundred 17. 30. 31—<hi rend="italic">et</hi>{26} <hi rend="italic">bu</hi>. omitted—<hi rend="italic">hu. et</hi> {28} <hi rend="italic">wa</hi>. Rs.—According to Stubbs <hi rend="italic">Lect</hi>. 167, the summons (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1d; <hi rend="italic">h</hi>.{r} <hi rend="italic">v. w. d</hi>. is an addition) went out only to the parties and the doomsmen, not to all members</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-4.lnote.oe.t-2" n="t" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">316</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">efficiencia</hi> besser zu erklären als ‘Wirksamkeit, Arbeitsverrichtung’. Die folg. Worte <hi rend="italic">regis dom. nec</hi>. schöpft Verf. aus Hn com 2, 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">efficiencia</hi> is better explained as ‘effectiveness, performance of work’. The following words <hi rend="italic">regis dom. nec</hi>. the author draws from Hn com 2, 1</seg></note>
      </div>
