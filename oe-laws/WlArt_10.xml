      <div type="clause" n="10">
        <head><ref type="lawCode" target="law:WlArt">Wl art</ref> 10</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-h"><pb n="488" ed="#liebermann"/>Interdico<ptr type="liebermannNote" n="51" target="#WlArt_10.lnote.oe.51"/> etiam<ptr type="liebermannNote" n="52" target="#WlArt_10.lnote.oe.52"/>, ne quis occidatur<ptr type="liebermannNote" n="f" target="#WlArt_10.lnote.oe.f"/> aut<ptr type="liebermannNote" n="53" target="#WlArt_10.lnote.oe.53"/> suspendatur pro aliqua culpa, sed eruantur<ptr type="liebermannNote" n="g" target="#WlArt_10.lnote.oe.g"/> oculi et<ptr type="liebermannNote" n="54" target="#WlArt_10.lnote.oe.54"/> testiculi<ptr type="liebermannNote" n="55" target="#WlArt_10.lnote.oe.55"/> abscidantur<ptr type="liebermannNote" n="56" target="#WlArt_10.lnote.oe.56"/>; et hoc<ptr type="liebermannNote" n="57" target="#WlArt_10.lnote.oe.57"/> praeceptum non sit<ptr type="liebermannNote" n="58" target="#WlArt_10.lnote.oe.58"/> uiolatum super forisfacturam meam<ptr type="liebermannNote" n="59" target="#WlArt_10.lnote.oe.59"/> plenam.<ptr type="liebermannNote" n="60" target="#WlArt_10.lnote.oe.60"/></ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="10" corresp="#wit-h"><pb n="242" ed="#robertson"/>Interdico etiam ne quis occidatur aut suspendatur pro aliqua culpa, sed eruantur oculi et testiculi abscidantur; et hoc praeceptum non sit violatum super forisfacturam meam plenam.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-h"><pb n="243" ed="#robertson"/>I likewise prohibit the slaying or hanging of anyone for any offence, but his eyes shall be put out and he shall suffer castration; and this decree shall not be violated under pain of incurring the full fine for insubordination to me.</ab>
        <note type="comparison" source="#liebermann" n="488">Inst Cn II 2.1</note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 2, 1</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:WlArtRetr_8">Wl art retr 8</ref>; <ref target="clause:WlArtRetr_17">Wl art retr 17</ref></note>
        <note type="comparison" source="#wormald-mel" n="404"><label>cf.</label> In Cn II 2.1 <quote>Wl art. 10, cf. Inst. Cn II 2:1, 30:4-5 (though here there is no mention of testicles)</quote></note>
        <note type="comparison" source="#wormald-mel" n="404"><label>cf.</label> In Cn II 30.4–5 <quote>Wl art. 10, cf. Inst. Cn II 2:1, 30:4-5 (though here there is no mention of testicles)</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="409"><label>order of</label> <ref target="clause:LeisWl_40">Leis Wl 40</ref> <quote>Leis Wl 41 – 41:1 ... and 40 (on capital punishment) are ... in the order of the 'Articles' (9, 10), not that of Cnut (II 3 - 3:1, 2:1)</quote></note>
        <note type="editorial">Added October 2026 from Robertson pp. 242–243 (text and translation); Liebermann’s text added from Gesetze I p. 488, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_10.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Spur solchen Gesetzes vielleicht auch</hi> Leis Wl 40</seg><seg type="translation" xml:lang="en" source="#claude">a trace of such a law perhaps also in Leis Wl 40</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_10.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> II Cn 30, 4 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. II Cn 30, 4 f.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_10.lnote.oe.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">-cimus <hi rend="italic">Vi</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cimus Vi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_10.lnote.oe.52" n="52" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Va Ph Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Va Ph Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_10.lnote.oe.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Cb Hv Retr Ra Vi Va Ph Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel Cb Hv Retr Ra Vi Va Ph Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_10.lnote.oe.54" n="54" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">sed <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">sed Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_10.lnote.oe.55" n="55" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">a. t. <hi rend="italic">Cb Hv Retr Ra Vi Va Ph Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. t. Cb Hv Retr Ra Vi Va Ph Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_10.lnote.oe.56" n="56" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">abscind. <hi rend="italic">Hv;</hi> eius <hi rend="italic">fügt zu Vi</hi></seg><seg type="translation" xml:lang="en" source="#claude">abscind. Hv; Vi adds eius</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_10.lnote.oe.57" n="57" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Vi</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Vi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_10.lnote.oe.58" n="58" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">fuit <hi rend="italic">Vi</hi></seg><seg type="translation" xml:lang="en" source="#claude">fuit Vi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_10.lnote.oe.59" n="59" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">nostram <hi rend="italic">Vi</hi></seg><seg type="translation" xml:lang="en" source="#claude">nostram Vi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_10.lnote.oe.60" n="60" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> Ed. Conf. retr. <hi rend="italic">Tripartita.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ed. Conf. retr. follows in the Tripartita.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_10.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">281</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Todesstrafe 6. 7; Enthauptung 3 Letztere vollstreckte Wilhelm I an Graf Waltheof. Diesen Widerspruch versuchen Pol Mai I 69 fortzuräumen durch die Annahme, unser Satz binde nur die untergeordneten Richter, nicht den König. Vielleicht blieb vielmehr Hochverrat (<hi rend="italic">s. d. Gl</hi> 8, Herrenverrat 9), wie <hi rend="italic">perfidia</hi> jedenfalls kurz darauf, als schwerstes Verbrechen gesondert von <hi rend="italic">culpa</hi>; <hi rend="italic">vgl. Gl</hi> Verbrechen 2.—Todesurteil, ausdrücklich neben dem zur Verstümmelung, war 1075 gewöhnlich und Geistlichen (<hi rend="italic">s. d Gl</hi> 33d) verboten.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Todesstrafe 6. 7; Enthauptung 3 William I carried out the latter on Earl Waltheof. Pol Mai I 69 try to remove this contradiction by assuming that our sentence binds only the subordinate judges, not the king. Perhaps, rather, high treason (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 8, Herrenverrat 9), like <hi rend="italic">perfidia</hi> at any rate shortly afterwards, remained distinct from <hi rend="italic">culpa</hi> as the gravest crime; <hi rend="italic">cf. Gl</hi> Verbrechen 2.—A sentence of death, expressly mentioned alongside one of mutilation, was usual in 1075, and forbidden to clergy (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 33d).</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_10.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">281</biblScope></bibl><seg type="original" xml:lang="de">Zur letzten Z. <hi rend="italic">s. Gl</hi> Entmannung 4; Auge 4ff.; Ungehorsam 6</seg><seg type="translation" xml:lang="en" source="#claude">On the last line <hi rend="italic">see Gl</hi> Entmannung 4; Auge 4ff.; Ungehorsam 6</seg></note>
      </div>
