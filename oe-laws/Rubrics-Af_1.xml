      <div type="clause" n="1">
        <head>Af Rb 1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1" corresp="#wit-e"><pb n="16" ed="#liebermann"/>II. Be<ptr type="liebermannNote" n="2" target="#Rubrics-Af_1.lnote.oe.2-2"/> aþum ⁊ be weddum.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1" corresp="#wit-ot-frag"><pb n="16" ed="#liebermann"/>… m ⁊ be weddum.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1" corresp="#wit-g-prol"><pb n="16" ed="#liebermann"/>II. Be aðum ⁊ be weddum.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1" corresp="#wit-h"><pb n="17" ed="#liebermann"/>II. Be aðum ond<ptr type="liebermannNote" n="3" target="#Rubrics-Af_1.lnote.oe.3"/> be weddu<hi rend="italic">m</hi>.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1" corresp="#wit-q"><pb n="17" ed="#liebermann"/>De iuramentis et de<ptr type="liebermannNote" n="2" target="#Rubrics-Af_1.lnote.oe.2"/> uadiis.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="186" ed="#jurasinski-and-oliver"/>II Be aþum be weddum</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="17" ed="#liebermann"/>Von Eiden und von Wettverträgen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of oaths and of pledges.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="187" ed="#jurasinski-and-oliver"/>Concerning oaths and concerning vows</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">17</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">16</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Diese Rb. fehlt So</hi></seg><seg type="translation" xml:lang="en" source="#claude">This rubric lacking in So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">17</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
      </div>
