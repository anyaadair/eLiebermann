    <body>
      <div type="clause" n="40.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 40.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="40.1" corresp="#wit-g-a"><pb n="340" ed="#liebermann"/>⁊ bete man þa<hi rend="italic">m</hi> cingce<ptr type="liebermannNote" n="11" target="#IICn_40-1.lnote.oe.11"/>, swa hit gebyrige, oððe he ða dæde<ptr type="liebermannNote" n="12" target="#IICn_40-1.lnote.oe.12"/> wrece swiþe deope.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="40.1" corresp="#wit-b"><pb n="340" ed="#liebermann"/>⁊ beton ðam kyninge, swa hit gebyrige, oððe he ða dæde wrece swyðe deope.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="40.1" corresp="#wit-a"><pb n="340" ed="#liebermann"/>⁊ bete man þam cynincge, swa hit gebyrige, oððe he þa dada<ptr type="liebermannNote" n="2" target="#IICn_40-1.lnote.oe.2"/> wrece swyðe deope.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="40.1" corresp="#wit-q"><pb n="341" ed="#liebermann"/>Et emendetur regi, sicut iustum est, aut<ptr type="liebermannNote" n="5" target="#IICn_40-1.lnote.oe.5"/> ipsum (uel illud) factum nimis profunde uindicet.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="40.1" corresp="#wit-inst-cn"><pb n="341" ed="#liebermann"/>Et<ptr type="liebermannNote" n="6" target="#IICn_40-1.lnote.oe.6"/> emendetur regi secundum quod iustum est, aut ipse rex districte uindicet quod factum est,</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="40.1" corresp="#wit-cons-cn"><pb n="341" ed="#liebermann"/>Regique satisfaciat, aut ipse delictum acriter uindicet:</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="40.1" corresp="#wit-b"><pb n="196" ed="#robertson"/>⁊ beton<ptr type="editorNote" n="4" target="#IICn_40-1.robnote.fn.4"/> ðam kyninge swa hit gebyrige, oððe he ða dæde wrece swyðe deope.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="276" ed="#rabin-doml"/>And bete man þam cingce, swa hit gebyrige, oððe he ða dæde wrece swiþe deope.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="340" ed="#liebermann"/>und büsse man dem König<ptr type="liebermannNote" n="1" target="#IICn_40-1.lnote.de.1"/>, wie es sich gebührt, oder dieser strafe die That sehr hoch.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">and let compensation be paid to the king as is fitting, or let him avenge the deed very severely.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_40-1.robnote.n.1"/><pb n="197" ed="#robertson"/>And such compensation as is fitting shall be paid to the king, or he shall avenge the deed to the uttermost.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="468" ed="#whitelock"/>And compensation is to be paid to the king, as is fitting, or he is to avenge the deed very severely.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="277" ed="#rabin-doml"/>And appropriate compensation shall be paid to the king, or he shall avenge that deed most severely.</ab>
        <note type="comparison" source="#liebermann" n="340"><ref target="clause:VIIIAtr_34">VIII Atr 34</ref></note>
        <note type="comparisonPrinted" source="#liebermann">VIII Atr. 34</note>
        <note type="comparison" source="#wormald-mel" n="359"><label>source (roman)</label> <ref target="clause:EGu_12">EGu 12</ref> <quote>Table 5.4, II Cn 40:1: VIII Atr 34  EGu 12</quote></note>
        <note type="comparison" source="#wormald-mel" n="359"><label>quoted verbatim (bold in Wormald's table)</label> <ref target="clause:VIIIAtr_34">VIII Atr 34</ref> <quote>Table 5.4, II Cn 40:1: VIII Atr 34  EGu 12</quote></note>
        <note type="editorial">Liebermann compares VIII Atr 34.; BR: added from Gesetze I p. 341, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">bete man: beton B</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_40-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">341</biblScope></bibl><seg type="original" xml:lang="de">a. i. <hi rend="italic">K;</hi> u. i. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">a. i. K; u. i. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_40-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">340</biblScope></bibl><seg type="original" xml:lang="de">cyning <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyning Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_40-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">340</biblScope></bibl><seg type="original" xml:lang="de">dæda <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">dæda Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_40-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">340</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_40-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">341</biblScope></bibl><seg type="original" xml:lang="de">un̄ detur <hi rend="italic">Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">un̄ detur Lb S</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_40-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">208</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Busse an Verletzten (VIII Atr 34) und Kirche (EGu 12) ist hinzuzudenken</seg><seg type="translation" xml:lang="en" source="#claude">Compensation to the injured party (VIII Atr 34) and to the Church (EGu 12) is to be understood in addition</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_40-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">356</biblScope></bibl><seg type="original" xml:lang="en">Cf. VIII Atr. 34.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_40-1.robnote.fn.4" n="4" source="#robertson"><bibl><biblScope unit="page">196</biblScope></bibl><label>beton</label><seg type="original" xml:lang="en"><hi rend="italic">bete man</hi> G, A, Ld.</seg></note>
      </div>
    </body>
