  <text>
    <body>
      <div type="clause" n="13">
        <head><ref type="lawCode" target="law:Iudex">Iudex</ref> 13</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="13" corresp="#wit-g-a"><pb n="476" ed="#liebermann"/>Yfelra gerefena þeaw ýs, þ<hi rend="italic">æt</hi> hí nymað ælcwiht ⁊ uneaðe hí þam þearfiendum lytles hwæt læfa[ð<ptr type="liebermannNote" n="2" target="#Iudex_13.lnote.oe.2"/>].</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="13" corresp="#wit-q"><pb n="476" ed="#liebermann"/>Malorum prepositorum mos est, ut quicquid possunt auferant et uix necessariorum<ptr type="liebermannNote" n="6" target="#Iudex_13.lnote.oe.6"/> parum quid relinquant sustentationum<ptr type="liebermannNote" n="7" target="#Iudex_13.lnote.oe.7"/>.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="476" ed="#liebermann"/>Böser Amtleute<ptr type="liebermannNote" n="b" target="#Iudex_13.lnote.de1.b"/> Brauch ist, dass sie jegliches fortnehmen und kaum etwas weniges den armen [Hintersassen ihres Bezirks] belassen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">It is the custom of bad reeves that they take away everything and scarcely leave a little to the needy [tenants of their district].</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-g-a">It is the custom of evil officials that they take everything and unwillingly leave little for the poor</ab>
        <note type="editorial">U: translator unrecorded: check; The ‘ð’ of ‘læfa[ð]’ was cut off in binding.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_13.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de">-arium <hi rend="italic">TMBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-arium <hi rend="italic">TMBr</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_13.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de">-ni <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ni <hi rend="italic">Br</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_13.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de">ð <hi rend="italic">beim Binden durchschnitten</hi></seg><seg type="translation" xml:lang="en" source="#claude">ð cut through in binding</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="Iudex_13.lnote.de1.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">476</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">gleich</hi> deman 8. 10</seg><seg type="translation" xml:lang="en" source="#claude">equivalent to deman 8. 10</seg></note>
      </div>
    </body>
