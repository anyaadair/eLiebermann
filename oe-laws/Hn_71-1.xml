      <div type="clause" n="71.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 71.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 71.1" corresp="#wit-lat"><pb n="590" ed="#liebermann"/>Si quis ueneno uel sortilegio<ptr type="liebermannNote" n="f" target="#Hn_71-1.lnote.oe.f"/> uel inuultuacione<ptr type="liebermannNote" n="g" target="#Hn_71-1.lnote.oe.g"/><ptr type="liebermannNote" n="10" target="#Hn_71-1.lnote.oe.10"/> seu maleficio<ptr type="liebermannNote" n="11" target="#Hn_71-1.lnote.oe.11"/> aliquo faciat homicidium<ptr type="liebermannNote" n="f" target="#Hn_71-1.lnote.oe.f"/>, siue illi paratum<ptr type="liebermannNote" n="12" target="#Hn_71-1.lnote.oe.12"/> sit siue<ptr type="liebermannNote" n="13" target="#Hn_71-1.lnote.oe.13"/> alii, nichil refert<ptr type="liebermannNote" n="14" target="#Hn_71-1.lnote.oe.14"/>, quin factum mortiferum et nullo modo redimendum sit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 590 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielleicht theilweise aus II As.</hi> 6; 6, 1</seg><seg type="translation" xml:lang="en" source="#claude">perhaps partly from II As. 6; 6, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">Verhexung durch Schädigung plastischen Abbildes</seg><seg type="translation" xml:lang="en" source="#claude">bewitchment by injuring a sculpted image</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">uult. <hi rend="italic">Gi;</hi> in uultu. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">uult. Gi; in uultu. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">-ico <hi rend="italic">Sc;</hi> -facto <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ico Sc; -facto Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">parentum <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">parentum K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">590</biblScope></bibl><seg type="original" xml:lang="de">fecerit <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">fecerit Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_71-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">326</biblScope></bibl><seg type="original" xml:lang="de">Über Zauber (<hi rend="italic">s. d. Gl</hi> 6a; busslos 5C) im Strafrecht <hi rend="italic">s</hi>. Pol Mai II 551.—Ducange belegt <hi rend="italic">invultuare</hi> ‘Abbild machen’, <hi rend="italic">vultuare</hi> ‘durch Magie töten’, <hi rend="italic">invultuor, vultuarius</hi> ‘Magier’. Johanna, Gemahlin Philipps IV, <hi rend="italic">invultatione decesserat</hi>; Eleonore Cobham soll 1441 Heinrich dem VI. durch Schmelzen seines Wachsbildes nach dem Leben getrachtet haben. (An bezauberndes Anschauen oder bösen Blick ist nicht zu denken.) Über <hi rend="italic">defixio, punctura</hi> durch Nadelstechen bei Agsa. <hi rend="italic">vgl</hi>. Toller s. v. <hi rend="italic">staca</hi>, die Pönitentialien Ps. Egb. IV 18 = <hi rend="italic">Mod. impon. poen</hi>. 38; H. S. Cuming <hi rend="italic">Pinlore and the waxen image</hi> im <hi rend="italic">Journ. Brit. archl. assoc</hi>. 1899, 161.—<hi rend="italic">siue</hi>{18} fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude">On magic (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 6a; busslos 5C) in criminal law <hi rend="italic">see</hi> Pol Mai II 551.—Ducange attests <hi rend="italic">invultuare</hi> ‘to make an image’, <hi rend="italic">vultuare</hi> ‘to kill by magic’, <hi rend="italic">invultuor, vultuarius</hi> ‘magician’. Joan, wife of Philip IV, <hi rend="italic">invultatione decesserat</hi>; in 1441 Eleanor Cobham is said to have sought the life of Henry VI by melting his wax image. (Bewitching looks or the evil eye are not to be thought of.) On <hi rend="italic">defixio, punctura</hi> by pricking with needles among the Anglo-Saxons <hi rend="italic">cf</hi>. Toller s. v. <hi rend="italic">staca</hi>, the penitentials Ps. Egb. IV 18 = <hi rend="italic">Mod. impon. poen</hi>. 38; H. S. Cuming <hi rend="italic">Pinlore and the waxen image</hi> in <hi rend="italic">Journ. Brit. archl. assoc</hi>. 1899, 161.—<hi rend="italic">siue</hi>{18} missing Rs</seg></note>
      </div>
