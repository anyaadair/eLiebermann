    <body>
      <div type="clause" n="II Cn 51">
        <head>Quadr Rb II Cn 51</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Rb II Cn 51" corresp="#wit-lat"><pb n="537" ed="#liebermann"/>De<ptr type="liebermannNote" n="70" target="#Quadr-Rb_II-Cn-51.lnote.la.70"/> incesto in amica<ptr type="liebermannNote" n="71" target="#Quadr-Rb_II-Cn-51.lnote.la.71"/> (cognata<ptr type="liebermannNote" n="c" target="#Quadr-Rb_II-Cn-51.lnote.la.fn.c"/>) et raptu, quod est illicitus cóitus<ptr type="liebermannNote" n="72" target="#Quadr-Rb_II-Cn-51.lnote.la.72"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 537 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">Of incest with an <hi rend="italic">amica</hi> [?] (a kinswoman) and of <hi rend="italic">raptus</hi>, which is unlawful intercourse.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-51.lnote.la.70" n="70" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">537</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">statt</hi> De <hi rend="italic">Dm;</hi> De adultera [<hi rend="italic">s. u. c.</hi> 53] et de inc. <hi rend="italic">T;</hi> De stupris <hi rend="italic">statt</hi> De inc. — coitus <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">et instead of De Dm; De adultera [see below c. 53] et de inc. T; De stupris instead of De inc. — coitus R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-51.lnote.la.71" n="71" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">537</biblScope></bibl><seg type="original" xml:lang="de">uel ancilla [<hi rend="italic">s. c.</hi> 54] <hi rend="italic">fügt zu T; statt</hi> amica <hi rend="italic">setzen</hi> cognata <hi rend="italic">und lassen</hi> et — coitus <hi rend="italic">fort HkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">T adds uel ancilla [see c. 54]; instead of amica HkBr put cognata and omit et — coitus</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-51.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">537</biblScope></bibl><seg type="original" xml:lang="de">(<hi rend="italic">Eingeklammertes</hi>) <hi rend="italic">entstammt letzter Recension</hi></seg><seg type="translation" xml:lang="en" source="#claude">(What is in brackets) comes from the last recension</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-51.lnote.la.72" n="72" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">537</biblScope></bibl><seg type="original" xml:lang="de">uel coh[erc]itus concubitus <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel coh[erc]itus concubitus Lond</seg></note>
      </div>
    </body>
