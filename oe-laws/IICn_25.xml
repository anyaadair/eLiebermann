        <note type="liebermannNote" subtype="textual" xml:id="IICn_25.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de">mage <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mage Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_25.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so auch III Eg.</hi> ⁊</seg><seg type="translation" xml:lang="en" source="#claude">so also III Eg. ⁊</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_25.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de">feordam <hi rend="italic">A</hi></seg><seg type="translation" xml:lang="en" source="#claude">feordam A</seg></note>
