      <div type="clause" n="83.6a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 83.6a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 83.6a" corresp="#wit-lat"><pb n="600" ed="#liebermann"/>Et ad<ptr type="liebermannNote" n="15" target="#Hn_83-6a.lnote.oe.15"/> proximam uillam<ptr type="liebermannNote" n="h" target="#Hn_83-6a.lnote.oe.h"/> et<ptr type="liebermannNote" n="5" target="#Hn_83-6a.lnote.oe.5"/> cui prius obuiabit<ptr type="liebermannNote" n="16" target="#Hn_83-6a.lnote.oe.16"/> denunciet, et etiam socnam<ptr type="liebermannNote" n="hh" target="#Hn_83-6a.lnote.oe.hh"/> habenti<ptr type="liebermannNote" n="17" target="#Hn_83-6a.lnote.oe.17"/>, quod probari denique uel defendi possit contra parentes uel<ptr type="liebermannNote" n="18" target="#Hn_83-6a.lnote.oe.18"/> consocios eius.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 600 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6a.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 92, 10; <hi rend="italic">nur dem Selbstanzeiger seines Todtschlags am Verbrecher gewährt Reinigungseid</hi> Ine 21, 1. 35; <hi rend="italic">vgl. Levita</hi> Nothwehr 121</seg><seg type="translation" xml:lang="en" source="#claude">cf. 92, 10; Ine 21, 1. 35 grants the oath of exculpation only to the man who himself reports his slaying of a criminal; cf. Levita Nothwehr 121</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6a.lnote.oe.hh" n="hh" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">dem Gerichtsherrn (<hi rend="italic">des Thatorts oder dem des Erschlagenen?</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">the lord of jurisdiction (of the place of the deed, or of the slain man?)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6a.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6a.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">adeat <hi rend="italic">ändert unnöthig Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">Wi Tho alter unnecessarily to adeat</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6a.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">-auerit <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-auerit Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6a.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">-nt <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nt Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6a.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Schmid falsch</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Schmid, wrongly</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-6a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Kundmachung 1b</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Kundmachung 1b</seg></note>
      </div>
