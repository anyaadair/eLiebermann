        <note type="liebermannNote" subtype="textual" xml:id="Af_5-4.lnote.oe.3-3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">53</biblScope></bibl><seg type="original" xml:lang="de">is <hi rend="italic">im</hi> 16. <hi rend="italic">Jh. zugefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">is added in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5-4.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘errennt’ So wie <hi rend="italic">o.</hi> 5</seg><seg type="translation" xml:lang="en" source="#claude">‘reaches by running’ So, as <hi rend="italic">above</hi> 5</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5-4.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Über das Rel. <hi rend="italic">þara þe</hi> s. Wülfing <hi rend="italic">Syntax</hi> 419</seg><seg type="translation" xml:lang="en" source="#claude">On the relative <hi rend="italic">þara þe</hi> see Wülfing <hi rend="italic">Syntax</hi> 419</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_5-4.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">52</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Asyl 5a; Geständnis 3. Dies bringt <hi rend="italic">rationabilis misericordia</hi> in Karoling. Kapitular (Beyerle <hi rend="italic">Gnade</hi> 8), und die anfängliche Ableugnung Strafe; <hi rend="italic">s. u.</hi> Ine 71¹</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Asyl 5a; Geständnis 3. This earns <hi rend="italic">rationabilis misericordia</hi> in a Carolingian capitulary (Beyerle <hi rend="italic">Gnade</hi> 8), and the initial denial earns punishment; <hi rend="italic">see below</hi> Ine 71¹</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_5-4.attnote.fn.14" n="14" source="#attenborough"><bibl><biblScope unit="page">66</biblScope></bibl><label>frið</label><seg type="original" xml:lang="en"><hi rend="italic">is</hi>. B. 16th century addition.</seg></note>
