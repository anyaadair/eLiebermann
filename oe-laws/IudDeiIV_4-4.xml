        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 4.4" corresp="#wit-du" ana="#glossed"><pb n="410" ed="#liebermann"/><seg type="glossed"><seg type="base">ita,</seg><gloss xml:lang="ang">svæ,</gloss></seg> <seg type="glossed"><seg type="base">Domine</seg><gloss xml:lang="ang">Driht<hi rend="italic">en</hi></gloss></seg> <seg type="glossed"><seg type="base">omnipotens,</seg><gloss xml:lang="ang">allm<hi rend="italic">æhtig</hi>,</gloss></seg> <seg type="glossed"><seg type="base">ut<ptr type="liebermannNote" n="8" target="#IudDeiIV_4-4.lnote.oe.8"/>,</seg><gloss xml:lang="ang">þ<hi rend="italic">æt</hi>te,</gloss></seg> <seg type="glossed"><seg type="base">si</seg><gloss xml:lang="ang">gif</gloss></seg> <seg type="glossed"><seg type="base">quis</seg><gloss xml:lang="ang">hvoelc</gloss></seg> <seg type="glossed"><seg type="base">culpabilis,</seg><gloss xml:lang="ang">synnig,</gloss></seg> <seg type="glossed"><seg type="base">ingrassante</seg><gloss xml:lang="ang">gihefgindu<hi rend="italic">m<ptr type="liebermannNote" n="38" target="#IudDeiIV_4-4.lnote.oe.38"/></hi></gloss></seg> <seg type="glossed"><seg type="base">diabolico<ptr type="liebermannNote" n="40" target="#IudDeiIV_4-4.lnote.oe.40"/></seg><gloss xml:lang="ang">diab'<ptr type="liebermannNote" n="39" target="#IudDeiIV_4-4.lnote.oe.39"/></gloss></seg> <seg type="glossed"><seg type="base">corde,</seg><gloss xml:lang="ang">heorte,</gloss></seg> <seg type="glossed"><seg type="base">indurato</seg><gloss xml:lang="ang">gistiðia</gloss></seg> <seg type="glossed"><seg type="base">presumpserit</seg><gloss xml:lang="ang">f<hi rend="italic">or</hi>efenge <hi rend="italic">uel<ptr type="liebermannNote" n="11" target="#IudDeiIV_4-4.lnote.oe.11"/></hi></gloss></seg> <seg type="glossed"><seg type="base">manum</seg><gloss xml:lang="ang">hond</gloss></seg> <seg type="glossed"><seg type="base">mittere,</seg><gloss xml:lang="ang">gisende,</gloss></seg> <seg type="glossed"><seg type="base">tua</seg><gloss xml:lang="ang">ðinræ<ptr type="liebermannNote" n="41" target="#IudDeiIV_4-4.lnote.oe.41"/></gloss></seg> <seg type="glossed"><seg type="base">iustissima</seg><gloss xml:lang="ang">soðfæstisto</gloss></seg> <seg type="glossed"><seg type="base">ueritas</seg><gloss xml:lang="ang">soðfæstnise</gloss></seg> <seg type="glossed"><seg type="base">hoc</seg><gloss xml:lang="ang">ðis</gloss></seg> <seg type="glossed"><seg type="base">declaret,</seg><gloss xml:lang="ang">giberhta,</gloss></seg> <seg type="glossed"><seg type="base">ut</seg><gloss xml:lang="ang">þ<hi rend="italic">æt</hi>te</gloss></seg> <seg type="glossed"><seg type="base">in</seg><gloss xml:lang="ang">in</gloss></seg> <seg type="glossed"><seg type="base">corpore</seg><gloss xml:lang="ang">lichome</gloss></seg> <seg type="glossed"><seg type="base">suo<ptr type="liebermannNote" n="42" target="#IudDeiIV_4-4.lnote.oe.42"/></seg><gloss xml:lang="ang">his</gloss></seg> <seg type="glossed"><seg type="base">tua</seg><gloss xml:lang="ang">ðin</gloss></seg> <seg type="glossed"><seg type="base">uirtus</seg><gloss xml:lang="ang">mæht</gloss></seg> <seg type="glossed"><seg type="base">sit</seg><gloss xml:lang="ang">sie</gloss></seg> <seg type="glossed"><seg type="base">manifestata<ptr type="liebermannNote" n="43" target="#IudDeiIV_4-4.lnote.oe.43"/>,</seg><gloss xml:lang="ang">giypped,</gloss></seg> <seg type="glossed"><seg type="base">et</seg><gloss xml:lang="ang">⁊</gloss></seg> <seg type="glossed"><seg type="base">anima</seg><gloss xml:lang="ang">savel</gloss></seg> <seg type="glossed"><seg type="base">per</seg><gloss xml:lang="ang">ðerh</gloss></seg> <seg type="glossed"><seg type="base">penitentiam</seg><gloss xml:lang="ang">gihreonisse</gloss></seg> <seg type="glossed"><seg type="base">saluetur;</seg><gloss xml:lang="ang">sie gihæled;</gloss></seg></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 410 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-4.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-4.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbesserndes Synonym fehlt</hi></seg><seg type="translation" xml:lang="en" source="#claude">correcting synonym missing</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-4.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">von</hi> d <hi rend="italic">schwand Obertheil und blieb nur</hi> o, <hi rend="italic">daher</hi> ‘?’ <hi rend="italic">Skeat</hi></seg><seg type="translation" xml:lang="en" source="#claude">the upper part of d has vanished, leaving only o, hence ‘?’ Skeat</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-4.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Glossator behält Latein. Form bei</hi></seg><seg type="translation" xml:lang="en" source="#claude">the glossator keeps the Latin form</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-4.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">diabolo cor induratum, pr. <hi rend="italic">besser Zeu.;</hi> indurat ōpsu. <hi rend="italic">Du;</hi> induratam <hi rend="italic">las Stev.</hi></seg><seg type="translation" xml:lang="en" source="#claude">diabolo cor induratum, pr. better Zeu.; indurat ōpsu. Du; Stev. read induratam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-4.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Glossator missversteht</hi> tua <hi rend="italic">als Ablativ auch</hi> 4, 5</seg><seg type="translation" xml:lang="en" source="#claude">the glossator misunderstands tua as an ablative, also 4, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-4.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_4-4.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">-stetur <hi rend="italic">Zeu</hi></seg><seg type="translation" xml:lang="en" source="#claude">-stetur Zeu</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-du">thus, Lord almighty, that, if any guilty man, with his devilish heart growing gross [?] [and] hardened, has presumed to put in his hand, your most just truth may declare this, so that your power may be made manifest in his body, and his soul be saved through penance;</ab>
      </div>
