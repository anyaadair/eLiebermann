    <body>
      <div type="clause" n="32.3">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 32.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 32.3"><pb n="655" ed="#liebermann"/>Et sicut modo uocantur greue<ptr type="liebermannNote" n="1" target="#ECfRetr_32-3.lnote.la.1"/> qui super alios prefecturas habent, ita <hi rend="bold">apud Anglos</hi><ptr type="liebermannNote" n="2" target="#ECfRetr_32-3.lnote.la.2"/> <hi rend="bold">antiquitus</hi> uocabantur alderman, <hi rend="bold">quasi seniores,</hi> non propter senectutem, <hi rend="bold">cum quidam</hi><ptr type="liebermannNote" n="3" target="#ECfRetr_32-3.lnote.la.3"/> <hi rend="bold">adolescentes essent,</hi> sed propter sapientiam<ptr type="liebermannNote" n="4" target="#ECfRetr_32-3.lnote.la.4"/>.<ptr type="liebermannNote" n="*" target="#ECfRetr_32-3.lnote.la.star"/></ab>
        <note type="comparison" source="#liebermann" n="655"><label>printed alongside</label> <ref target="clause:ECf_32-3">ECf 32.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 655 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32-3.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht ganz übernahm der Sheriff das Amt des Angelsächs.</hi> ealdorman <hi rend="italic">und nicht jedem</hi> ealdor <hi rend="italic">folgte ein</hi> gerefa</seg><seg type="translation" xml:lang="en" source="#claude">the sheriff did not entirely take over the office of the Anglo-Saxon ealdorman, and not every ealdor was followed by a gerefa</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32-3.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier schaltet Lond in die Retr.</hi> 32 A—E, <hi rend="italic">bis S.</hi> 660, <hi rend="italic">ein:</hi></seg><seg type="translation" xml:lang="en" source="#claude">here Lond inserts 32 A–E into the Retr., up to p. 660:</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32-3.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de">greiue <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">greiue Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32-3.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de">qui <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds qui</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32-3.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de">quid’ <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">quid’ Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32-3.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">655</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt sofort</hi> XXXVI De latronibus <hi rend="italic">Db L</hi></seg><seg type="translation" xml:lang="en" source="#claude">XXXVI De latronibus follows at once Db L</seg></note>
      </div>
