      <div type="clause" n="5.7a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.7a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.7a" corresp="#wit-lat"><pb n="549" ed="#liebermann"/>Et<ptr type="liebermannNote" n="g" target="#Hn_5-7a.lnote.oe.g"/> nichil<ptr type="liebermannNote" n="15" target="#Hn_5-7a.lnote.oe.15"/> fiat<ptr type="liebermannNote" n="16" target="#Hn_5-7a.lnote.oe.16"/> absque accusatore; nam Deus<ptr type="liebermannNote" n="h" target="#Hn_5-7a.lnote.oe.h"/> et dominus noster Iesus Christus Iudam furem esse sciebat; set quia non est<ptr type="liebermannNote" n="17" target="#Hn_5-7a.lnote.oe.17"/> accusatus, ideo non est abiectus<ptr type="liebermannNote" n="18" target="#Hn_5-7a.lnote.oe.18"/>; et quicquid inter apostolos egit, pro dignitate officii ratum<ptr type="liebermannNote" n="i" target="#Hn_5-7a.lnote.oe.i"/> mansit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 549 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-7a.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">n. f. a. ac. nam <hi rend="italic">nicht in Pan., aber in anderen Quellen von Gr.</hi> C. 2 q. 1 c. 4, <hi rend="italic">der die Schlusszeile fortlässt. Frühere citiren hierzu</hi> Ambrosius <hi rend="italic">und</hi> Capitularia (<hi rend="italic">d. i.</hi> Benedict. levita), <hi rend="italic">die aber Verf. schwerlich kannte</hi></seg><seg type="translation" xml:lang="en" source="#claude">n. f. a. ac. nam is not in Pan., but is in other sources of Gr. C. 2 q. 1 c. 4, who leaves out the final line. Earlier writers cite Ambrosius and Capitularia (i.e. Benedict. levita) here, which, however, the author can hardly have known</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-7a.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch Ivo</hi> Pan. IV 115</seg><seg type="translation" xml:lang="en" source="#claude">also Ivo Pan. IV 115</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-7a.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">ratum <hi rend="italic">fehlt</hi> Pan. IV 115</seg><seg type="translation" xml:lang="en" source="#claude">ratum missing in Pan. IV 115</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-7a.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">nil <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">nil Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-7a.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">faciat <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">faciat Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-7a.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-7a.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">549</biblScope></bibl><seg type="original" xml:lang="de">abre. <hi rend="italic">Sc Hg;</hi> eiectus <hi rend="italic">Ivo; Ps.-Is.</hi> 126</seg><seg type="translation" xml:lang="en" source="#claude">abre. Sc Hg; eiectus Ivo; Ps.-Is. 126</seg></note>
      </div>
