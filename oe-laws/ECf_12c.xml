      <div type="clause" n="12c">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 12c</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 12c"><pb n="637" ed="#liebermann"/><ptr type="liebermannNote" n="16" target="#ECf_12c.lnote.la.16"/>alia quam habent quatuor<ptr type="liebermannNote" n="17" target="#ECf_12c.lnote.la.17"/> chimini<ptr type="liebermannNote" n="18" target="#ECf_12c.lnote.la.18"/><ptr type="liebermannNote" n="a" target="#ECf_12c.lnote.oe.erkl-a"/>, id<ptr type="liebermannNote" n="19" target="#ECf_12c.lnote.la.19"/> est Watlingestrete<ptr type="liebermannNote" n="20" target="#ECf_12c.lnote.la.20"/>, Fosse<ptr type="liebermannNote" n="21" target="#ECf_12c.lnote.la.21"/>, Hikenildestret<ptr type="liebermannNote" n="22" target="#ECf_12c.lnote.la.22"/>, Ermingestret<ptr type="liebermannNote" n="23" target="#ECf_12c.lnote.la.23"/>, quorum <pb n="638" ed="#liebermann"/>duo in longitudinem<ptr type="liebermannNote" n="1" target="#ECf_12c.lnote.la.1"/> regni, alii uero<ptr type="liebermannNote" n="2" target="#ECf_12c.lnote.la.2"/> in latitudinem<ptr type="liebermannNote" n="3" target="#ECf_12c.lnote.la.3"/> distenduntur;</ab>
        <note type="comparison" source="#liebermann" n="637"><label>printed alongside</label> <ref target="clause:ECfRetr_12c">ECf retr 12c</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 637–638 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12c.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">Pax quatuor chiminorum <hi rend="italic">überschreibt Wo</hi></seg><seg type="translation" xml:lang="en" source="#claude">Wo heads it Pax quatuor chiminorum</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12c.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12c.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">chem. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">chem. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12c.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">scilicet <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">scilicet S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12c.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">Wathl. <hi rend="italic">Rl;</hi> -strate <hi rend="italic">Ad;</hi> -gst. <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Wathl. Rl; -strate Ad; -gst. Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12c.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">Hyk., Erni., Fo. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hyk., Erni., Fo. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12c.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">Hyk. <hi rend="italic">Hk;</hi> Hichen. <hi rend="italic">Rl;</hi> -strete <hi rend="italic">S;</hi> -strate <hi rend="italic">Ad;</hi> -dst. <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hyk. Hk; Hichen. Rl; -strete S; -strate Ad; -dst. Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12c.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">Erni. <hi rend="italic">Rl Hk;</hi> -strete <hi rend="italic">S;</hi> Herningestrate <hi rend="italic">Ad;</hi> Hundesstr. <hi rend="italic">Do;</hi> qu. d. in l. r. Er. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Erni. Rl Hk; -strete S; Herningestrate Ad; Hundesstr. Do; qu. d. in l. r. Er. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12c.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">-ne <hi rend="italic">Rl Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ne Rl Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12c.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">duo <hi rend="italic">Hk Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">duo Hk Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12c.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">-ne <hi rend="italic">Rl S Do;</hi> regni <hi rend="italic">fügt zu Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ne Rl S Do; Hk adds regni</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">another, which the four highways have, that is Watling Street (Watlingestrete), the Fosse, Icknield Street (Hikenildestret), Ermine Street (Ermingestret), of which two extend along the length of the kingdom, but the others across its breadth;</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12c.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">345</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Strassen 14; Watling-; Fosse; Icknield-; Eormenstræt — <hi rend="italic">Wadigestret, F., Hichinidestret, Erningestret</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cf. Gl Strassen 14; Watling-; Fosse; Icknield-; Eormenstræt — <hi rend="italic">Wadigestret, F., Hichinidestret, Erningestret</hi></seg></note>
      </div>
    </body>
