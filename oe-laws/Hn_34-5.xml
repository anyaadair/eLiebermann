      <div type="clause" n="34.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 34.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 34.5" corresp="#wit-lat"><pb n="566" ed="#liebermann"/>Si quis in placito per iustitiam<ptr type="liebermannNote" n="c" target="#Hn_34-5.lnote.oe.c"/><ptr type="liebermannNote" n="2" target="#Hn_34-5.lnote.oe.2"/> posito sui uel suorum causam iniustis con[tra]criminationibus<ptr type="liebermannNote" n="d" target="#Hn_34-5.lnote.oe.d"/><ptr type="liebermannNote" n="3" target="#Hn_34-5.lnote.oe.3"/> uel contraposicionibus difforciet, hanc perdat et de cetero rectum<ptr type="liebermannNote" n="4" target="#Hn_34-5.lnote.oe.4"/> faciat, sicut hundreto uel iudicibus<ptr type="liebermannNote" n="e" target="#Hn_34-5.lnote.oe.e"/> uidebitur ydoneum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 566 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-5.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">Gerichtshalter, <hi rend="italic">zunächst</hi> Königsbeamter</seg><seg type="translation" xml:lang="en" source="#claude">holder of the court, <hi rend="italic">in the first place</hi> a royal official</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-5.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus</hi> wiðertihtlan <hi rend="italic">Cnuts</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">from Cnut’s</hi> wiðertihtlan</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-5.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">Urtheilsfinder</seg><seg type="translation" xml:lang="en" source="#claude">judgment-finders</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-5.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Hg; über</hi> iudicium <hi rend="italic">Corr. Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">so Hg; written above</hi> iudicium <hi rend="italic">by the corrector Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-5.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">concr. <hi rend="italic">Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">concr. <hi rend="italic">MSS</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-5.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vom Corr. über</hi> ir <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">by the corrector above</hi> ir <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-5.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Gegenklage.—<hi rend="italic">concri</hi>.{8} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Gegenklage.—<hi rend="italic">concri</hi>.{8} Rs</seg></note>
