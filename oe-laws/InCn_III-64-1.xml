      <div type="clause" n="III 64.1">
        <head><ref type="lawCode" target="law:InCn">In Cn</ref> III 64.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="In Cn III 64.1" corresp="#wit-lat"><pb n="616" ed="#liebermann"/>cauda (uero<ptr type="liebermannNote" n="5" target="#InCn_III-64-1.lnote.oe.5"/>) bouis (persoluitur<ptr type="liebermannNote" n="6" target="#InCn_III-64-1.lnote.oe.6"/>) solido<ptr type="liebermannNote" n="7" target="#InCn_III-64-1.lnote.oe.7"/> uno et uaccę (persoluitur<ptr type="liebermannNote" n="8" target="#InCn_III-64-1.lnote.oe.8"/>) quinque denariis; oculus bouis (persoluitur<ptr type="liebermannNote" n="8" target="#InCn_III-64-1.lnote.oe.8"/>) quinque denariis et<ptr type="liebermannNote" n="9" target="#InCn_III-64-1.lnote.oe.9"/> uaccę quattuor (denariis<ptr type="liebermannNote" n="10" target="#InCn_III-64-1.lnote.oe.10"/>)<ptr type="liebermannNote" n="b" target="#InCn_III-64-1.lnote.oe.b"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 616 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-64-1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">616</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">in Cb folgt</hi> Nola bouis — — libras tres, <hi rend="italic">d. i. Schluss der</hi> Consiliatio Cnuti <hi rend="italic">aus</hi> Hundred 8 <hi rend="italic">f., oben S.</hi> 195 = <hi rend="italic">u. S.</hi> 619{10}, <hi rend="italic">dann</hi> Wl art., <hi rend="italic">o. S.</hi> 486. <hi rend="italic">Auch in HRl</hi> [<hi rend="italic">wo erst</hi> CHn cor. <hi rend="italic">eingefügt</hi>] <hi rend="italic">folgt</hi> Wl art. <hi rend="italic">Hier endet T.</hi></seg><seg type="translation" xml:lang="en" source="#claude">in Cb there follows Nola bouis — — libras tres, i.e. the end of the Consiliatio Cnuti from Hundred 8 f., above p. 195 = below p. 619{10}, then Wl art., above p. 486. In HRl too [where CHn cor. is inserted first] Wl art. follows. T ends here.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-64-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">616</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur Cb; fehlt HRl T</hi></seg><seg type="translation" xml:lang="en" source="#claude">only <hi rend="italic">Cb</hi>; missing in <hi rend="italic">HRl T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-64-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">616</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus HRl; fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">from <hi rend="italic">HRl</hi>; missing in <hi rend="italic">Cb</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-64-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">616</biblScope></bibl><seg type="original" xml:lang="de">u. s. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. s. <hi rend="italic">Cb</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-64-1.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">616</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus HRl T; fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">from <hi rend="italic">HRl T</hi>; missing in <hi rend="italic">Cb</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-64-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">616</biblScope></bibl><seg type="original" xml:lang="de">cauda <hi rend="italic">fügt zu T</hi></seg><seg type="translation" xml:lang="en" source="#claude">cauda added by <hi rend="italic">T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-64-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">616</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur Cb T; fehlt HRl</hi></seg><seg type="translation" xml:lang="en" source="#claude">only <hi rend="italic">Cb T</hi>; missing in <hi rend="italic">HRl</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-64-1.lnote.oe.b-2" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">616</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic"><hi rend="spaced">gesperrt</hi> drucke ich die Wörter, die von Cb’s <hi rend="spaced">Texte</hi> der</hi> In Cn <hi rend="italic">abweichen</hi></seg><seg type="translation" xml:lang="en" source="#claude">I print in <hi rend="italic">spaced type</hi> the words that differ from Cb's <hi rend="italic">text</hi> of the In Cn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-64-1.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">616</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">diese Zeile zwar roth, ist aber Texttheil; s. o. S.</hi> 319</seg><seg type="translation" xml:lang="en" source="#claude">this line, although in red, is part of the text; see above p. 319</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-64-1.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">616</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb.</hi> uicto, <hi rend="italic">gemäss dem Texte</hi></seg><seg type="translation" xml:lang="en" source="#claude">emend to uicto, in accordance with the text</seg></note>
      </div>
    </body>
