      <div type="clause" n="23">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 23</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 23"><pb n="648" ed="#liebermann"/><ptr type="liebermannNote" n="10" target="#ECf_23.lnote.la.10"/>Si aliquis<ptr type="liebermannNote" n="11" target="#ECf_23.lnote.la.11"/> hospitatur aliquem cognitum<ptr type="liebermannNote" n="c" target="#ECf_23.lnote.la.fn.c"/> uel incognitum duabus<ptr type="liebermannNote" n="a" target="#ECf_23.lnote.oe.erkl-a"/> noctibus, potest<ptr type="liebermannNote" n="12" target="#ECf_23.lnote.la.12"/> habere<ptr type="liebermannNote" n="13" target="#ECf_23.lnote.la.13"/> eum tanquam hospitem; quodsi ipse forisfecerit<ptr type="liebermannNote" n="14" target="#ECf_23.lnote.la.14"/>, non incurret<ptr type="liebermannNote" n="15" target="#ECf_23.lnote.la.15"/> dampnum pro eo.</ab>
        <note type="comparison" source="#liebermann" n="648"><label>printed alongside</label> <ref target="clause:ECfRetr_23">ECf retr 23</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 648 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Retr. hat dafür das Englische</hi></seg><seg type="translation" xml:lang="en" source="#claude">the Retr. has the English for this</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">De hospitibus <hi rend="italic">überschr. Pl S Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">headed De hospitibus Pl S Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">quis <hi rend="italic">Ad Do Wo</hi></seg><seg type="translation" xml:lang="en" source="#claude">quis Ad Do Wo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">poterit <hi rend="italic">Hk S Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">poterit Hk S Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">e. h. <hi rend="italic">S Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. h. S Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">648</biblScope></bibl><seg type="original" xml:lang="de">-rit <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rit Ad Do</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">If anyone lodges someone, known or unknown, for two nights, he may have him as a guest; but if he commits an offence, he will not incur loss on his account.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_23.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Fremde 12; drei Tage 6 — <hi rend="italic">rec.</hi><hi rend="superscript">19</hi> fehlt — <hi rend="italic">chud</hi><hi rend="superscript">28</hi> <hi rend="italic">odthr unchut</hi> — <hi rend="italic">qui</hi><hi rend="superscript">27</hi> <hi rend="italic">si</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">Cf. <hi rend="italic">Gl</hi> Fremde 12; drei Tage 6 — <hi rend="italic">rec.</hi><hi rend="superscript">19</hi> lacking — <hi rend="italic">chud</hi><hi rend="superscript">28</hi> <hi rend="italic">odthr unchut</hi> — <hi rend="italic">qui</hi><hi rend="superscript">27</hi> <hi rend="italic">si</hi> Rs</seg></note>
      </div>
