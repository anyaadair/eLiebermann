  <text>
    <body>
      <div type="clause" n="15.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 15.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 15.1"><pb n="641" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_15-1.lnote.oe.erkl-clause"/><ptr type="liebermannNote" n="*" target="#ECf_15-1.lnote.la.star"/>Si autem<ptr type="liebermannNote" n="10" target="#ECf_15-1.lnote.la.10"/> inueniri non poterat<ptr type="liebermannNote" n="11" target="#ECf_15-1.lnote.la.11"/>, mensem et diem<ptr type="liebermannNote" n="12" target="#ECf_15-1.lnote.la.12"/> unum<ptr type="liebermannNote" n="b" target="#ECf_15-1.lnote.la.fn.b"/> ad eum<ptr type="liebermannNote" n="13" target="#ECf_15-1.lnote.la.13"/> perquirendum in respectum habebant.</ab>
        <note type="comparison" source="#liebermann" n="641"><label>printed alongside</label> <ref target="clause:ECfRetr_15-1">ECf retr 15.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 641 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-1.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dieselbe Frist</hi> 20, 1a <hi rend="italic">für Einlieferung des Freibürgschaftsgenossen und</hi> Leis Wl 3 <hi rend="italic">für Stellung des processualisch Verbürgten durch Privatbürgen; vgl. u.</hi> 23, 2</seg><seg type="translation" xml:lang="en" source="#claude">the same term at 20, 1a for handing over the member of the frankpledge, and at Leis Wl 3 for the production of a man under procedural surety by private sureties; cf. below, 23, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-1.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">uero <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">uero S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-1.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">-rit <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rit Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-1.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">u. d. <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. d. Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-1.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">p. e. <hi rend="italic">Hr;</hi> requir. eum <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. e. Hr; requir. eum Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-1.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">De Englecherie <hi rend="italic">am Rande Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">De Englecherie in the margin Co</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">But if he could not be found, they had a respite of a month and one day to search for him.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_15-1.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">346</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Frist 12p. q. r; Zugabe 1; auch <hi rend="italic">o.</hi> 6, 1</seg><seg type="translation" xml:lang="en" source="#claude">Cf. Gl Frist 12p. q. r; Zugabe 1; also above 6, 1</seg></note>
      </div>
    </body>
