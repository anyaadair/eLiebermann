      <div type="clause" n="10">
        <head><ref type="lawCode" target="law:ExcomI">Excom I</ref> 10</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom I 10" corresp="#wit-ti"><pb n="432" ed="#liebermann"/>Dominica itaque<ptr type="liebermannNote" n="52" target="#ExcomI_10.lnote.oe.52"/> atque apostolica precepta adimplentes, membrum putridum<ptr type="liebermannNote" n="o" target="#ExcomI_10.lnote.oe.o"/> et insanabile, quod medicinam non recipit, ferro excommunicationis a corpore ęcclesiæ abscidamus<ptr type="liebermannNote" n="53" target="#ExcomI_10.lnote.oe.53"/>, ne tam pestifero morbo reliqua membra corporis ueluti ueneno inficiantur<ptr type="liebermannNote" n="54" target="#ExcomI_10.lnote.oe.54"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 432 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_10.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 7</seg><seg type="translation" xml:lang="en" source="#claude">see above 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_10.lnote.oe.52" n="52" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Mart</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Mart</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_10.lnote.oe.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de">abscind. <hi rend="italic">Mart</hi></seg><seg type="translation" xml:lang="en" source="#claude">abscind. Mart</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_10.lnote.oe.54" n="54" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de">Per <hi rend="italic">fügt zu Vb</hi></seg><seg type="translation" xml:lang="en" source="#claude">Per added by Vb</seg></note>
