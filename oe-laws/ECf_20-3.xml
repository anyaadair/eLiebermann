    <body>
      <div type="clause" n="20.3">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 20.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 20.3"><pb n="646" ed="#liebermann"/>Si autem infra supradictum<ptr type="liebermannNote" n="1" target="#ECf_20-3.lnote.la.1"/> terminum inueniri non poterit, quia in omni friborge<ptr type="liebermannNote" n="2" target="#ECf_20-3.lnote.la.2"/> unus erat<ptr type="liebermannNote" n="3" target="#ECf_20-3.lnote.la.3"/> capitalis, quem<ptr type="liebermannNote" n="4" target="#ECf_20-3.lnote.la.4"/> ipsi uocabant<ptr type="liebermannNote" n="5" target="#ECf_20-3.lnote.la.5"/> friborges<ptr type="liebermannNote" n="6" target="#ECf_20-3.lnote.la.6"/> heued<ptr type="liebermannNote" n="7" target="#ECf_20-3.lnote.la.7"/>, ipse capitalis acciperet<ptr type="liebermannNote" n="8" target="#ECf_20-3.lnote.la.8"/> duos de melioribus in<ptr type="liebermannNote" n="9" target="#ECf_20-3.lnote.la.9"/> suo friborge<ptr type="liebermannNote" n="10" target="#ECf_20-3.lnote.la.10"/> et de tribus<ptr type="liebermannNote" n="a" target="#ECf_20-3.lnote.la.fn.a"/> friborgis<ptr type="liebermannNote" n="11" target="#ECf_20-3.lnote.la.11"/> propinquioribus uicinis suis accipiat de unoquoque<ptr type="liebermannNote" n="12" target="#ECf_20-3.lnote.la.12"/> capitalem<ptr type="liebermannNote" n="13" target="#ECf_20-3.lnote.la.13"/> et duos<ptr type="liebermannNote" n="14" target="#ECf_20-3.lnote.la.14"/> similiter<ptr type="liebermannNote" n="15" target="#ECf_20-3.lnote.la.15"/> de melioribus, si poterit<ptr type="liebermannNote" n="16" target="#ECf_20-3.lnote.la.16"/> eos habere<ptr type="liebermannNote" n="17" target="#ECf_20-3.lnote.la.17"/>, et se<ptr type="liebermannNote" n="b" target="#ECf_20-3.lnote.la.fn.b"/> duodecimo<ptr type="liebermannNote" n="18" target="#ECf_20-3.lnote.la.18"/> expurget se et friborgum<ptr type="liebermannNote" n="19" target="#ECf_20-3.lnote.la.19"/> suum, si facere poterit, de forisfacto<ptr type="liebermannNote" n="20" target="#ECf_20-3.lnote.la.20"/> et fuga<ptr type="liebermannNote" n="21" target="#ECf_20-3.lnote.la.21"/> supradicti malefactoris.</ab>
        <note type="comparison" source="#liebermann" n="646"><label>printed alongside</label> <ref target="clause:ECfRetr_20-3">ECf retr 20.3</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 646 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “capitalis”, “tribus” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_20-3.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 24, 1. <hi rend="italic">Dem Verfasser ist die Freibürgschaft territorialisirt, nicht rein persönlich</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 24, 1. For the author the frankpledge is territorial, not purely personal</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_20-3.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Leis Wl 3; Wl art. 8</seg><seg type="translation" xml:lang="en" source="#claude">cf. Leis Wl 3; Wl art. 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-3.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">pred. <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">pred. Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-3.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">-ghe <hi rend="italic">Rl;</hi> fridb. <hi rend="italic">S;</hi> -burga <hi rend="italic">Hr;</hi> friþborga <hi rend="italic">Ad;</hi> fridborga <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ghe Rl; fridb. S; -burga Hr; friþborga Ad; fridborga Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-3.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">erit <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">erit Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-3.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-3.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">-cant <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cant Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-3.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">-ghes <hi rend="italic">Rl;</hi> -ge <hi rend="italic">Hk Hr;</hi> fridborg <hi rend="italic">S;</hi> friþborge <hi rend="italic">Ad;</hi> fridb. <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ghes Rl; -ge Hk Hr; fridborg S; friþborge Ad; fridb. Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-3.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">-et <hi rend="italic">Hr;</hi> haued <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">-et Hr; haued Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-3.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">-piet <hi rend="italic">Hr Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">-piet Hr Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-3.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">de sua friþborga <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">de sua friþborga Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-3.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">-ghe <hi rend="italic">Rl;</hi> -go <hi rend="italic">Hr;</hi> fridb. <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ghe Rl; -go Hr; fridb. S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-3.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">-ghis <hi rend="italic">Rl;</hi> fridb. <hi rend="italic">S;</hi> friþb. <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ghis Rl; fridb. S; friþb. Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-3.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">unaquaque <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">unaquaque Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_20-3.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">646</biblScope></bibl><seg type="original" xml:lang="de">friþborgum <hi rend="italic">fügt zu Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad Do add friþborgum</seg></note>
