        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 34.1c" corresp="#wit-lat"><pb n="565" ed="#liebermann"/>Sepe enim culpa<ptr type="liebermannNote" n="32" target="#Hn_34-1c.lnote.oe.32"/><ptr type="liebermannNote" n="p" target="#Hn_34-1c.lnote.oe.p"/> malum aggrauat et were uel wite<ptr type="liebermannNote" n="33" target="#Hn_34-1c.lnote.oe.33"/> uel lahslite<ptr type="liebermannNote" n="34" target="#Hn_34-1c.lnote.oe.34"/> discrimen inf[orci]at<ptr type="liebermannNote" n="35" target="#Hn_34-1c.lnote.oe.35"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 565 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1c.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 35, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 35, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1c.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr. vom Corr. Sc;</hi> culpe <hi rend="italic">Lond; fehlt Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">written above by the corrector Sc;</hi> culpe <hi rend="italic">Lond; omitted in Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1c.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">wyte <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">wyte <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-1c.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">565</biblScope></bibl><seg type="original" xml:lang="de">lahil. <hi rend="italic">Sc Hg;</hi> lashl. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lahil. <hi rend="italic">Sc Hg;</hi> lashl. <hi rend="italic">Lond</hi></seg></note>
