      <div type="clause" n="2.8">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 2.8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 2.8"><pb n="629" ed="#liebermann"/>Item omnibus Christicolis ad ecclesiam<ptr type="liebermannNote" n="a" target="#ECf_2-8.lnote.oe.erkl-a"/> Dei causa<ptr type="liebermannNote" n="8" target="#ECf_2-8.lnote.la.8"/> orationis pergentibus pax sit<ptr type="liebermannNote" n="9" target="#ECf_2-8.lnote.la.9"/> in eundo et redeundo; item ad dedicationes euntibus et<ptr type="liebermannNote" n="9" target="#ECf_2-8.lnote.la.9"/> ad<ptr type="liebermannNote" n="10" target="#ECf_2-8.lnote.la.10"/> synodos et<ptr type="liebermannNote" n="9" target="#ECf_2-8.lnote.la.9"/> ad<ptr type="liebermannNote" n="10" target="#ECf_2-8.lnote.la.10"/> capitula, siue submoniti<ptr type="liebermannNote" n="11" target="#ECf_2-8.lnote.la.11"/> sint, siue per se ibi<ptr type="liebermannNote" n="12" target="#ECf_2-8.lnote.la.12"/> quid agendum habeant<ptr type="liebermannNote" n="13" target="#ECf_2-8.lnote.la.13"/>.</ab>
        <note type="comparison" source="#liebermann" n="629"><label>printed alongside</label> <ref target="clause:ECfRetr_2-8">ECf retr 2.8</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 629 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-8.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">perg. c. or. <hi rend="italic">Ad Do No</hi></seg><seg type="translation" xml:lang="en" source="#claude">perg. c. or. Ad Do No</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-8.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Rl Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Rl Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-8.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt No</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in No</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-8.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Rl;</hi> summ. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Rl; summ. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-8.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">ag. ibi <hi rend="italic">ohne</hi> quid <hi rend="italic">Ad Do No</hi></seg><seg type="translation" xml:lang="en" source="#claude">ag. ibi without quid Ad Do No</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-8.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">habeat <hi rend="italic">S;</hi> eant <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">habeat S; eant Do</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Likewise to all Christians going to the church of God for the sake of prayer let there be peace in going and returning; likewise to those going to dedications and to synods and to chapters, whether they have been summoned or have something to do there on their own account.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-8.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">343</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Kirchgang 2; Gerichtsfrieden 5; Synode 2; Exkommunikation 13b. <hi rend="italic">Viri peregrinatio</hi> schützt vor Todesdrohung schon den hl. Wilfrid 660; Eadmer <hi rend="italic">V. Wilfr.</hi> 7 — <hi rend="italic">seu</hi><hi rend="superscript">15</hi> — <hi rend="italic">su. pax</hi><hi rend="superscript">19</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">Cf. Gl Kirchgang 2; Gerichtsfrieden 5; Synode 2; Exkommunikation 13b. <hi rend="italic">Viri peregrinatio</hi> already protects St Wilfrid from threat of death in 660; Eadmer <hi rend="italic">V. Wilfr.</hi> 7 — <hi rend="italic">seu</hi><hi rend="superscript">15</hi> — <hi rend="italic">su. pax</hi><hi rend="superscript">19</hi> Rs</seg></note>
      </div>
    </body>
  </text>
