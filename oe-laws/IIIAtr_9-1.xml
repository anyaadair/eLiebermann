    <body>
      <div type="clause" n="9.1">
        <head><ref type="lawCode" target="law:IIIAtr">III Atr</ref> 9.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="9.1" corresp="#wit-h"><pb n="230" ed="#liebermann"/>⁊ gif he þa hyde ǽr þam awég sylle, gilde XX oran.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="9.1" corresp="#wit-q"><pb n="230" ed="#liebermann"/>Et si corium antea uendat alicui, reddat uiginti oris.<ptr type="liebermannNote" n="21" target="#IIIAtr_9-1.lnote.oe.21"/></ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="9.1" corresp="#wit-h"><pb n="68" ed="#robertson"/>⁊ gif he þa hyde ǽr þam awég sylle, gilde XX oran.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="231" ed="#liebermann"/>Und wenn er die Haut vor diesem [Termin] hinweg veräussert<ptr type="liebermannNote" n="1" target="#IIIAtr_9-1.lnote.de.1"/>, büsse er 20 Ör.<ptr type="liebermannNote" n="2" target="#IIIAtr_9-1.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if he disposes of the hide before that [time], let him pay 20 ores.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-h"><pb n="69" ed="#robertson"/>And if he disposes of the hide before that, he shall pay 20 ores<ptr type="editorNote" n="1" target="#IIIAtr_9-1.robnote.n.1"/>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h"><pb n="446" ed="#whitelock"/>And if he gives away the hide before that, he is to pay 20 ores.</ab>
        <note type="editorial">AP: corrected against Whitelock p. 446, October 2026 (was “10. And every fugitive, who is a fugitive in one district, is to be so in every district.”, now “∅”)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIAtr_9-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">230</biblScope></bibl><seg type="original" xml:lang="de">oras <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">oras <hi rend="italic">T</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIIAtr_9-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">160</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Fell 2f. Es gab also Lederhandel</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Fell 2f. There was, then, a trade in leather</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIIAtr_9-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">160</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. 4, 1⁴</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 4, 1⁴</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIAtr_9-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="en">Cf. 4, 1.</seg></note>
      </div>
    </body>
