        <note type="liebermannNote" subtype="textual" xml:id="Hn_92-3a.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">607</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in K Co Or Gi</seg></note>
