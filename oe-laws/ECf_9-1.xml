    <body>
      <div type="clause" n="9.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 9.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 9.1"><pb n="633" ed="#liebermann"/><ptr type="liebermannNote" n="23" target="#ECf_9-1.lnote.la.23"/>Barones autem<ptr type="liebermannNote" n="24" target="#ECf_9-1.lnote.la.24"/>, qui curias<ptr type="liebermannNote" n="25" target="#ECf_9-1.lnote.la.25"/> suas habent<ptr type="liebermannNote" n="26" target="#ECf_9-1.lnote.la.26"/> de hominibus suis<ptr type="liebermannNote" n="27" target="#ECf_9-1.lnote.la.27"/>, uideant ut ita agant<ptr type="liebermannNote" n="28" target="#ECf_9-1.lnote.la.28"/> de eis, quatinus erga<ptr type="liebermannNote" n="29" target="#ECf_9-1.lnote.la.29"/> Deum<ptr type="liebermannNote" n="30" target="#ECf_9-1.lnote.la.30"/> reatum non incurrant et regem<ptr type="liebermannNote" n="e" target="#ECf_9-1.lnote.la.fn.e"/> non offendant.</ab>
        <note type="comparison" source="#liebermann" n="633"><label>printed alongside</label> <ref target="clause:ECfRetr_9-1">ECf retr 9.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 633 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “hominibus” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_9-1.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verf. droht wohl mit Übertragung des Processes an die königliche Justiz; vgl.</hi> 4. Hn 33, 1a</seg><seg type="translation" xml:lang="en" source="#claude">the author probably threatens the transfer of the case to the king’s justice; cf. 4. Hn 33, 1a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-1.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">De baronibus qui curiam habent <hi rend="italic">überschr. Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">headed De baronibus qui curiam habent Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-1.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad Do Wo;</hi> regis <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad Do Wo; regis Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-1.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">-am suam <hi rend="italic">Hk Ad Do Wo</hi></seg><seg type="translation" xml:lang="en" source="#claude">-am suam Hk Ad Do Wo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-1.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">de ho. s. ha. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">de ho. s. ha. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-1.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-1.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">agatur <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">agatur Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-1.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">re. e. D. <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">re. e. D. Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_9-1.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">633</biblScope></bibl><seg type="original" xml:lang="de">Dominum <hi rend="italic">S Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">Dominum S Ad</seg></note>
      </div>
