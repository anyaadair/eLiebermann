      <div type="clause" n="7">
        <head><ref type="lawCode" target="law:ExcomV">Excom V</ref> 7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom V 7" corresp="#wit-ca"><pb n="436" ed="#liebermann"/>Fiatque habitatio<ptr type="liebermannNote" n="14" target="#ExcomV_7.lnote.oe.14"/> eorum<ptr type="liebermannNote" n="15" target="#ExcomV_7.lnote.oe.15"/> deserta; et in tabernaculis eorum non sit qui inhabitet<ptr type="liebermannNote" n="16" target="#ExcomV_7.lnote.oe.16"/>.<ptr type="liebermannNote" n="*" target="#ExcomV_7.lnote.oe.star"/></ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Ps. 68, 26</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 436 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomV_7.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">436</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ci schiebt ein:</hi> [7a] Sintque anathematizati{1} maranatha{†}, quod est perditio in die iudicii! [7b] Excommunicatis{††} et uos? <hi rend="spaced">Respons</hi>. Excommunicamus. [7c] Dampnatis et uos? <hi rend="spaced">Respons</hi>. Dampnamus. [7d] Anathematizatis et uos? Anathematizamus.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ci</hi> inserts: [7a] Sintque anathematizati{1} maranatha{†}, quod est perditio in die iudicii! [7b] Excommunicatis{††} et uos? <hi rend="italic">Respons</hi>. Excommunicamus. [7c] Dampnatis et uos? <hi rend="italic">Respons</hi>. Dampnamus. [7d] Anathematizatis et uos? Anathematizamus.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomV_7.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">436</biblScope></bibl><seg type="original" xml:lang="de">abitacio <hi rend="italic">Ca</hi></seg><seg type="translation" xml:lang="en" source="#claude">abitacio <hi rend="italic">Ca</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomV_7.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">436</biblScope></bibl><seg type="original" xml:lang="de">illorum <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">illorum <hi rend="italic">Ci</hi></seg></note>
