      <div type="clause" n="3.1">
        <head><ref type="lawCode" target="law:EGu">EGu</ref> 3.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.1" corresp="#wit-h"><pb n="130" ed="#liebermann"/>⁊<ptr type="liebermannNote" n="5" target="#EGu_3-1.lnote.oe.5"/> gif mæssepr<hi rend="italic">eost</hi> folc<ptr type="liebermannNote" n="14" target="#EGu_3-1.lnote.oe.14"/> miswyssige æt freolse oððe æt fæstene, gylde XXX scill' mid Englu<hi rend="italic">m</hi> ⁊ mid Denu<hi rend="italic">m</hi> þreo healfmare.<ptr type="liebermannNote" n="*" target="#EGu_3-1.lnote.oe.star"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.1" corresp="#wit-b"><pb n="130" ed="#liebermann"/>⁊ gyf mæssepreost folc miswissige æt freolse oððe æt fæstene<ptr type="liebermannNote" n="2" target="#EGu_3-1.lnote.oe.2-2"/>, gylde XXX scill' mid Englum ⁊ mid Denu<hi rend="italic">m</hi> ðreo healfmarc.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3.1" corresp="#wit-q"><pb n="131" ed="#liebermann"/>Et si presbiter populum (suum<ptr type="liebermannNote" n="2" target="#EGu_3-1.lnote.oe.2"/>) misdoceat<ptr type="liebermannNote" n="11" target="#EGu_3-1.lnote.oe.11"/> de festo uel de<ptr type="liebermannNote" n="6" target="#EGu_3-1.lnote.oe.6"/> ieiunio, reddat XXX sol. cum Anglis et cum Danis<ptr type="liebermannNote" n="12" target="#EGu_3-1.lnote.oe.12"/> III<ptr type="liebermannNote" n="13" target="#EGu_3-1.lnote.oe.13"/> dimidias marcas.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="3.1" corresp="#wit-h"><pb n="102" ed="#attenborough"/>⁊ gif mæssepreost folc miswyssige æt freolse oððe æt fæstene, gylde XXX scill' mid Englum ⁊ mid Denum þreo healfmarc<ptr type="editorNote" n="1" target="#EGu_3-1.attnote.fn.1"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-h"><pb n="4" ed="#rabin-doml"/>And gif mæssepreost folc miswyssige æt freolse oððe æt fæstene, gylde XXX scillinga mid Englum and mid Denum þreo healfmarc.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="131" ed="#liebermann"/>Und wenn ein Pfarrer die Gemeinde<ptr type="liebermannNote" n="1" target="#EGu_3-1.lnote.de.1"/> missleitet<ptr type="liebermannNote" n="2" target="#EGu_3-1.lnote.de.2"/> betreffend Feiertag oder Fasten, zahle er 30 Schill.<ptr type="liebermannNote" n="3" target="#EGu_3-1.lnote.de.3"/> bei den Engländern und bei den Dänen drei<ptr type="liebermannNote" n="4" target="#EGu_3-1.lnote.de.4"/> Halbmark.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if a mass-priest misleads the people concerning a feast or a fast, let him pay 30 shillings among the English and three half-marks among the Danes.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="103" ed="#attenborough"/>If a mass priest misdirects the people with regard to a festival or a fast, he shall pay 30 shillings in an English district, and 3 half-marks<ptr type="editorNote" n="1" target="#EGu_3-1.attnote.n.1"/> in a Danish district.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-h"><pb n="5" ed="#rabin-doml"/>And if a priest misleads the people concerning a holy day or a fast, he must pay thirty shillings among the English or three half-marks among the Danes.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Northu_11">Northu 11</ref></note>
        <note type="textual" source="#rabin-doml">healfmarc: healmare H</note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_3-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">131</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fügt zu TMHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">TMHkBr add</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_3-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">131</biblScope></bibl><seg type="original" xml:lang="de">doc. <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">doc. Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_3-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">131</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond.</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Lond.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_3-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">131</biblScope></bibl><seg type="original" xml:lang="de">Dacis <hi rend="italic">meist K</hi></seg><seg type="translation" xml:lang="en" source="#claude">Dacis mostly K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_3-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">131</biblScope></bibl><seg type="original" xml:lang="de">duas m. et dimidiam <hi rend="italic">statt</hi> III d. m. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">duas m. et dimidiam instead of III d. m. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_3-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">130</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_3-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">130</biblScope></bibl><seg type="original" xml:lang="de">þ' f. miswisige <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þ' f. miswisige Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_3-1.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">130</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere mit BLd Quadr.</hi> healfmarc</seg><seg type="translation" xml:lang="en" source="#claude">read with BLd Quadr. healfmarc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_3-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">130</biblScope></bibl><seg type="original" xml:lang="de">æ <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">æ on an erasure</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_3-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">90</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Dies benutzt Northu 11, hier und weiterhin die Beziehung auf Englisches Recht fortlassend, aber mehrfach Pönitenz hinzusetzend. <hi rend="italic">Vgl. Gl</hi> Fasten 6; Feiertag 4; Geistliche 27c</seg><seg type="translation" xml:lang="en" source="#claude">This is used by Northu 11, which here and subsequently omits the reference to English law but in several places adds penance. <hi rend="italic">Cf. Gl</hi> Fasten 6; Feiertag 4; Geistliche 27c</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_3-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">90</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">misdocere</hi> zitiert Ducange nur hierher aus Q. Dieser bildet hybrid auch <hi rend="italic">misevenire</hi>, <hi rend="italic">misfacere</hi>, <hi rend="italic">mislocutio; s. Wb</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ducange cites <hi rend="italic">misdocere</hi> only for this passage, from Q. Q also forms the hybrids <hi rend="italic">misevenire</hi>, <hi rend="italic">misfacere</hi>, <hi rend="italic">mislocutio; see Wb</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_3-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">90</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o.</hi> 2⁵·⁶</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 2⁵·⁶</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_3-1.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">90</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Halbmark 2. 5. Sie steht im Angloskandinav. Testament bei M. Förster in <hi rend="italic">Morsbach Festschr.</hi> 155</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Halbmark 2. 5. It occurs in the Anglo-Scandinavian will in M. Förster in <hi rend="italic">Morsbach Festschr.</hi> 155</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="EGu_3-1.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">202</biblScope></bibl><seg type="original" xml:lang="en">Three half-marks, <hi rend="italic">i.e</hi>. 12 <hi rend="italic">oran</hi>, probably a pound (240 pence). This agrees with the <hi rend="italic">wite</hi> of 60 shillings (strictly speaking Mercian shillings), found elsewhere; but not with the fine of 30 shillings here imposed. This offence was apparently less costly among the English than among the Danes (see also A. and G. cap. 2, note 1).</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="EGu_3-1.attnote.fn.1" n="1" source="#attenborough"><bibl><biblScope unit="page">104</biblScope></bibl><label>healfmarc</label><seg type="original" xml:lang="en"><hi rend="italic">healf mare</hi>. H. <hi rend="italic">healfmarc</hi>. B, Ld.</seg></note>
      </div>
