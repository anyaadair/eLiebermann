      <div type="clause" n="70.12c">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 70.12c</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 70.12c" corresp="#wit-lat"><pb n="589" ed="#liebermann"/>amicicie tamen et uenie<ptr type="liebermannNote" n="b" target="#Hn_70-12c.lnote.oe.b"/> propius<ptr type="liebermannNote" n="3" target="#Hn_70-12c.lnote.oe.3"/> uel remocius erit, si<ptr type="liebermannNote" n="4" target="#Hn_70-12c.lnote.oe.4"/> meritum<ptr type="liebermannNote" n="c" target="#Hn_70-12c.lnote.oe.c"/> eius qui occisus est interfuit, et<ptr type="liebermannNote" n="5" target="#Hn_70-12c.lnote.oe.5"/> sicut acciderit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 589 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-12c.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Milde bei absichtsloser Missethat</hi> VI Atr. 52, 1, <hi rend="italic">daraus</hi> II Cn. 68, 2, <hi rend="italic">wo wie in dem von</hi> Hn 90, 11<hi rend="italic">a citirten Sprichwort der Gegensatz</hi> ungewealdes <hi rend="italic">zu</hi> gewealdes</seg><seg type="translation" xml:lang="en" source="#claude">Leniency for an unintentional misdeed VI Atr. 52, 1, whence II Cn. 68, 2, where, as in the proverb cited by Hn 90, 11<hi rend="italic">a</hi>, ungewealdes is contrasted with gewealdes</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-12c.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Schuld; vgl.</hi> 70, 10. 88, 5</seg><seg type="translation" xml:lang="en" source="#claude">Guilt; cf. 70, 10. 88, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-12c.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">propicius <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">propicius Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-12c.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">sicut <hi rend="italic">gegen Hss. Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">sicut against the MSS Wi Tho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-12c.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in K Co Or Gi</seg></note>
      </div>
