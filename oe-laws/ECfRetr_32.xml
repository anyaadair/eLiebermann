    <body>
      <div type="clause" n="32">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 32</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 32"><pb n="654" ed="#liebermann"/><ptr type="liebermannNote" n="9" target="#ECfRetr_32.lnote.la.9"/><hi rend="bold"><hi rend="spaced">Quid sit prepositus et</hi></hi><ptr type="liebermannNote" n="10" target="#ECfRetr_32.lnote.la.10"/> <hi rend="bold"><hi rend="spaced">prefectura et quid alderman</hi></hi><ptr type="liebermannNote" n="11" target="#ECfRetr_32.lnote.la.11"/><hi rend="bold"><hi rend="spaced">, quod</hi></hi><ptr type="liebermannNote" n="12" target="#ECfRetr_32.lnote.la.12"/> <hi rend="bold"><hi rend="spaced">Latine senior populi sonat; et quam multipliciter uocabulum</hi></hi><ptr type="liebermannNote" n="13" target="#ECfRetr_32.lnote.la.13"/> <hi rend="bold"><hi rend="spaced">prepositi distenditur.</hi></hi> Greue <hi rend="bold">quidem</hi><ptr type="liebermannNote" n="14" target="#ECfRetr_32.lnote.la.14"/> nomen <hi rend="bold">est</hi> potestatis; <hi rend="bold">Latinorum lingua</hi> nichil<ptr type="liebermannNote" n="15" target="#ECfRetr_32.lnote.la.15"/> <hi rend="bold">expressius</hi><ptr type="liebermannNote" n="*" target="#ECfRetr_32.lnote.la.star"/> <hi rend="bold">sonat</hi> quam prefectura; <hi rend="bold">quoniam hoc uocabulum adeo</hi><ptr type="liebermannNote" n="16" target="#ECfRetr_32.lnote.la.16"/> multipliciter <hi rend="bold">distenditur, quod</hi> de scira<ptr type="liebermannNote" n="17" target="#ECfRetr_32.lnote.la.17"/>, de wapentagiis<ptr type="liebermannNote" n="18" target="#ECfRetr_32.lnote.la.18"/>, quod<ptr type="liebermannNote" n="19" target="#ECfRetr_32.lnote.la.19"/> est et leð<ptr type="liebermannNote" n="a" target="#ECfRetr_32.lnote.la.fn.a"/><ptr type="liebermannNote" n="20" target="#ECfRetr_32.lnote.la.20"/>, de hundretis<ptr type="liebermannNote" n="21" target="#ECfRetr_32.lnote.la.21"/>, de burgis, de uillis <hi rend="bold">etiam</hi> greue <hi rend="bold">uocetur</hi><ptr type="liebermannNote" n="22" target="#ECfRetr_32.lnote.la.22"/><hi rend="bold">, in quo</hi><ptr type="liebermannNote" n="23" target="#ECfRetr_32.lnote.la.23"/> <hi rend="bold">idem</hi><ptr type="liebermannNote" n="24" target="#ECfRetr_32.lnote.la.24"/> <hi rend="bold">sonare uidetur et significare quod dominus</hi><ptr type="liebermannNote" n="d" target="#ECfRetr_32.lnote.la.fn.d"/>.</ab>
        <note type="comparison" source="#liebermann" n="654"><label>printed alongside</label> <ref target="clause:ECf_32">ECf 32</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 654 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">Liebermann prints “quod est et leð” in the larger type of the ECf column.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.fn.aa" n="aa" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vom Angelsächs.</hi> gerefa <hi rend="italic">schwindet</hi> ge <hi rend="italic">schon um</hi> 1210 <hi rend="italic">u.</hi> 32, 3¹, <hi rend="italic">doch sind noch heute</hi> moorgrieve, fieldgrieve <hi rend="italic">Gemeindeämter; vgl. Gomme</hi> Index of munic. offices 30. 32</seg><seg type="translation" xml:lang="en" source="#claude">the ge of Anglo-Saxon gerefa disappears already around 1210 and at 32, 3¹, but moorgrieve, fieldgrieve are still parish offices today; cf. Gomme, Index of munic. offices 30. 32</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">tungerefa, <hi rend="italic">nicht, wie Retr. meint,</hi> Dorfherr</seg><seg type="translation" xml:lang="en" source="#claude">tungerefa, not, as the Retr. thinks, the lord of the village</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Retr.</hi> 32 <hi rend="italic">stellt eher</hi> lathe — <hi rend="italic">im Domesday und jetzt nur in Kent bekannt — und</hi> wapentake <hi rend="italic">gleich. Ebenso Cb</hi> 22, 5. <hi rend="italic">Er vollzieht hier den Vergleich mit</hi> riding <hi rend="italic">nur der Symmetrie wegen. Heinrich I. befreite S. Trinity zu London</hi> de omnibus sectis de syris et hundredis et lethis et hustingis [<hi rend="italic">vgl.</hi> Hn Lond 9]; <hi rend="italic">ed. Sharpe</hi> Calendar of letterbooks of London C <hi rend="italic">p.</hi> 74</seg><seg type="translation" xml:lang="en" source="#claude">at 32 the Retr. rather equates lathe — in Domesday and now known only in Kent — with wapentake. So too Cb at 22, 5. He makes the comparison with riding here only for symmetry. Henry I freed Holy Trinity, London, de omnibus sectis de syris et hundredis et lethis et hustingis [cf. Hn Lond 9]; ed. Sharpe, Calendar of letterbooks of London C p. 74</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 35, 1d</seg><seg type="translation" xml:lang="en" source="#claude">cf. 35, 1d</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">De greuis et aldermannis <hi rend="italic">Lond;</hi> Quid est hec potestas greue <hi rend="italic">Cb; Rubrik erst vor</hi> 32, 1 <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">De greuis et aldermannis Lond; Quid est hec potestas greue Cb; the rubric only before 32, 1 Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">et pr. et <hi rend="italic">fehlt Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">et pr. et lacking in Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">eldeman <hi rend="italic">Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">eldeman Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">quia <hi rend="italic">Pl;</hi> qui <hi rend="italic">S;</hi> quod—dist. <hi rend="italic">fehlt Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">quia Pl; qui S; quod—dist. lacking in Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">nomen <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">nomen Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">Cb;</hi> quoque <hi rend="italic">Lond;</hi> quoddam <hi rend="italic">Db</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod Cb; quoque Lond; quoddam Db</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">uel expresse idem quod pref. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel expresse idem quod pref. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">tam <hi rend="italic">Hv;</hi> ab eo <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">tam Hv; ab eo K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">sira <hi rend="italic">Va;</hi> schira <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">sira Va; schira Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">-achiis <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-achiis Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">et quod etiam <hi rend="italic">Hv;</hi> q. etiam est <hi rend="italic">Cb Db Ph Lond;</hi> est <hi rend="italic">fehlt Lb Hv Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">et quod etiam Hv; q. etiam est Cb Db Ph Lond; est lacking in Lb Hv Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">ledh <hi rend="italic">Lb Va Db;</hi> lede <hi rend="italic">ohne</hi> de <hi rend="italic">Hv;</hi> leid <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">ledh Lb Va Db; lede without de Hv; leid Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">-edum <hi rend="italic">Hv;</hi> -edis <hi rend="italic">Cb;</hi> -edis, de b., et. de u. greiue <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-edum Hv; -edis Cb; -edis, de b., et. de u. greiue Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">uocatur <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">uocatur Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">qua i. so. et si. ui. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">qua i. so. et si. ui. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_32.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">654</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel Lond</seg></note>
      </div>
