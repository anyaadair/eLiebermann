      <div type="clause" n="78.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 78.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 78.2" corresp="#wit-lat"><pb n="594" ed="#liebermann"/>Si quis in seruum transeat<ptr type="liebermannNote" n="m" target="#Hn_78-2.lnote.oe.m"/>, sicut<ptr type="liebermannNote" n="n" target="#Hn_78-2.lnote.oe.n"/> possessor est, in halimoto<ptr type="liebermannNote" n="nn" target="#Hn_78-2.lnote.oe.nn"/> uel hundreto uel uicinio<ptr type="liebermannNote" n="27" target="#Hn_78-2.lnote.oe.27"/> coram testibus<ptr type="liebermannNote" n="o" target="#Hn_78-2.lnote.oe.o"/> agatur, eum<ptr type="liebermannNote" n="28" target="#Hn_78-2.lnote.oe.28"/> extoln[eat]<ptr type="liebermannNote" n="29" target="#Hn_78-2.lnote.oe.29"/>, ut nec ille deinceps abneget.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 594 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-2.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 76, 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">see above</hi> 76, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-2.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de">je welchen <hi rend="italic">Gerichtsstandes der ihn zum Sklaven aufnehmende</hi> Besitzer</seg><seg type="translation" xml:lang="en" source="#claude">according to <hi rend="italic">whichever court the</hi> possessor <hi rend="italic">taking him as a slave is subject to</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-2.lnote.oe.nn" n="nn" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 57, 8. <hi rend="italic">Hallmoot hält jeder Herr über Villane; Maitland</hi> Domesday 82</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 57, 8. <hi rend="italic">Every lord holds a hallmoot for his villeins; Maitland</hi> Domesday 82</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-2.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 78, 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 78, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-2.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de">-no <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-no <hi rend="italic">Sc Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-2.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de">cum <hi rend="italic">Lond Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">cum Lond edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-2.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">594</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi> (= excolu), <hi rend="italic">Lücke für zwei Buchst. Sc Hg;</hi> excoluerit <hi rend="italic">übr. Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus (= excolu), gap for two letters Sc Hg; excoluerit the other edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_78-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">327</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Verknechtung 4d—<hi rend="italic">extoluect</hi>{29}, lies <hi rend="italic">extolnect</hi>, wie ich emendierte—78, 2a <hi rend="italic">sint l</hi>.{31}—<hi rend="italic">multi</hi>{2} fehlt—<hi rend="italic">factum</hi>{32} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Verknechtung 4d—<hi rend="italic">extoluect</hi>{29}, read <hi rend="italic">extolnect</hi>, as I emended—78, 2a <hi rend="italic">sint l</hi>.{31}—<hi rend="italic">multi</hi>{2} missing—<hi rend="italic">factum</hi>{32} Rs</seg></note>
      </div>
