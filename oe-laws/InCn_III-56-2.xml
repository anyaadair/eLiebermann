      <div type="clause" n="III 56.2">
        <head><ref type="lawCode" target="law:InCn">In Cn</ref> III 56.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="In Cn III 56.2" corresp="#wit-lat"><pb n="615" ed="#liebermann"/>Ali[a]s<ptr type="liebermannNote" n="7" target="#InCn_III-56-2.lnote.oe.7"/> archiepiscopus et filius regis<ptr type="liebermannNote" n="g" target="#InCn_III-56-2.lnote.oe.g"/> de legali coniuge habent similem secuiarem rectitudinem in multis rebus, hoc est in despectu<ptr type="liebermannNote" n="h" target="#InCn_III-56-2.lnote.oe.h"/>, in<ptr type="liebermannNote" n="8" target="#InCn_III-56-2.lnote.oe.8"/> emendatione hominis occisi, quod dicitur manbote<ptr type="liebermannNote" n="d" target="#InCn_III-56-2.lnote.oe.d"/>, et in multis aliis diuersis<ptr type="liebermannNote" n="9" target="#InCn_III-56-2.lnote.oe.9"/> rebus, id est þere prętio<ptr type="liebermannNote" n="i" target="#InCn_III-56-2.lnote.oe.i"/> reddendo et forisfactura(m)<ptr type="liebermannNote" n="k" target="#InCn_III-56-2.lnote.oe.k"/><ptr type="liebermannNote" n="10" target="#InCn_III-56-2.lnote.oe.10"/>, utroque<ptr type="liebermannNote" n="11" target="#InCn_III-56-2.lnote.oe.11"/> ęque magnum et carum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 615 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-56-2.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de">manbote comiti XX sol., baronibus X sol., <hi rend="italic">ECf.</hi> 12, 5; manbot <hi rend="italic">steigert Verf. mit dem Stande des Herrn auch</hi> 56, 2 <hi rend="italic">gegen Hn</hi> 87, 4<hi rend="italic">a</hi>{q}</seg><seg type="translation" xml:lang="en" source="#claude">manbote comiti XX sol., baronibus X sol., <hi rend="italic">ECf.</hi> 12, 5; the author also makes manbot rise with the rank of the lord in 56, 2, contrary to <hi rend="italic">Hn</hi> 87, 4a{q}</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-56-2.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de">æþeling <hi rend="italic">stand in des Verfassers Quelle. Er verengt den Begriff (zum Unterschiede von Heinrichs I. Bastarden und im Hinblick auf den Thronfolger</hi> Wilhelm Æþeling) <hi rend="italic">zu sehr; denn</hi> Eadgar Æþeling, <hi rend="italic">der Bruder der Königin, war kein Königssohn</hi></seg><seg type="translation" xml:lang="en" source="#claude">æþeling stood in the author's source. He narrows the concept too much (to distinguish it from Henry I's bastards and with an eye to the heir to the throne, William Æþeling); for Eadgar Æþeling, the queen's brother, was no king's son</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-56-2.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de">oferseunesse</seg><seg type="translation" xml:lang="en" source="#claude">oferseunesse</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-56-2.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de">arcebiscopes ⁊ æþelinges wergild is . . <hi rend="italic">Norðleod</hi> 2; <hi rend="italic">die Benutzung dieses Stückes ist wahrscheinlich, weil</hi> Mirce, Að, Had <hi rend="italic">benutzt sind, mit denen es stets zusammen erscheint; vgl. o. S.</hi> 613{h}</seg><seg type="translation" xml:lang="en" source="#claude">arcebiscopes ⁊ æþelinges wergild is . . <hi rend="italic">Norðleod</hi> 2; the use of this piece is probable, because Mirce, Að, Had have been used, with which it always appears together; cf. above p. 613{h}</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-56-2.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de">beforan æðelinge oððe arcebiscpe gefeoht . . <hi rend="italic">Grið</hi> 12; <hi rend="italic">vgl.</hi> III 55{e}</seg><seg type="translation" xml:lang="en" source="#claude">beforan æðelinge oððe arcebiscpe gefeoht . . <hi rend="italic">Grið</hi> 12; cf. III 55{e}</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-56-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de">alius <hi rend="italic">HRl Cb;</hi> alterius <hi rend="italic">T; gebessert Kolderup</hi> [<hi rend="italic">aus</hi> elles?]</seg><seg type="translation" xml:lang="en" source="#claude">alius <hi rend="italic">HRl Cb;</hi> alterius <hi rend="italic">T</hi>; emended by Kolderup [from elles?]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-56-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-56-2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert aus</hi> r. d. <hi rend="italic">Rl Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected from r. d. <hi rend="italic">Rl Cb</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-56-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de">-ra <hi rend="italic">HRl;</hi> -ram <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ra <hi rend="italic">HRl;</hi> -ram <hi rend="italic">Cb</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-56-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">615</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">statt</hi> utrique <hi rend="italic">Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">for utrique MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-56-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">333</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Ætheling 3.a. 9; Erzbischof 8; <hi rend="italic">o</hi>. Einl. 3. 14</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Ætheling 3.a. 9; Erzbischof 8; <hi rend="italic">above</hi> Introduction 3. 14</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-56-2.lnote.oe.h-2" n="h" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">333</biblScope></bibl><seg type="original" xml:lang="de">durch <hi rend="italic">despectus</hi> scheint <hi rend="italic">mundbryce</hi> übersetzt; <hi rend="italic">ebd</hi>. Schutz 14; Mannbusse 16b; Wergeld 10a; Ungehorsam 25b</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">despectus</hi> seems to translate <hi rend="italic">mundbryce</hi>; <hi rend="italic">ibid</hi>. Schutz 14; Mannbusse 16b; Wergeld 10a; Ungehorsam 25b</seg></note>
      </div>
