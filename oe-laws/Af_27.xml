        <note type="liebermannNote" subtype="textual" xml:id="Af_27.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">gylden <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gylden So Ld</seg></note>
