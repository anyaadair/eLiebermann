      <div type="clause" n="II Cn 10">
        <head>Quadr Rb II Cn 10</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Rb II Cn 10" corresp="#wit-lat"><pb n="536" ed="#liebermann"/>De<ptr type="liebermannNote" n="61" target="#Quadr-Rb_II-Cn-10.lnote.la.61"/><ptr type="liebermannNote" n="66" target="#Quadr-Rb_II-Cn-10.lnote.la.66"/> burhbota<ptr type="liebermannNote" n="62" target="#Quadr-Rb_II-Cn-10.lnote.la.62"/> et<ptr type="liebermannNote" n="63" target="#Quadr-Rb_II-Cn-10.lnote.la.63"/> brigbota<ptr type="liebermannNote" n="64" target="#Quadr-Rb_II-Cn-10.lnote.la.64"/> et<ptr type="liebermannNote" n="65" target="#Quadr-Rb_II-Cn-10.lnote.la.65"/> de expeditione nauali uel terrestri.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 536 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">Of <hi rend="italic">burhbot</hi> (repair of fortresses) and <hi rend="italic">brigbot</hi> (repair of bridges) and of naval or land expedition.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-10.lnote.la.61" n="61" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">et de <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">et de Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-10.lnote.la.62" n="62" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">-te <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">-te R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-10.lnote.la.63" n="63" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt HkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in HkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-10.lnote.la.64" n="64" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">brucgb. <hi rend="italic">R;</hi> byrgb. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">brucgb. R; byrgb. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-10.lnote.la.65" n="65" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Dm</hi> (<hi rend="italic">wo neue Rubrik</hi>) <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Dm (where a new rubric begins) R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-10.lnote.la.66" n="66" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt OrHk; nur</hi> aliis <hi rend="italic">statt</hi> de — terr. <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in OrHk; only aliis instead of de — terr. Br</seg></note>
      </div>
