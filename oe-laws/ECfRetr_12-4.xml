  <text>
    <body>
      <div type="clause" n="12.4">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 12.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 12.4"><pb n="638" ed="#liebermann"/>Manbote<ptr type="liebermannNote" n="29" target="#ECfRetr_12-4.lnote.la.29"/> in Denelaga<ptr type="liebermannNote" n="33" target="#ECfRetr_12-4.lnote.la.33"/> de uillano et<ptr type="liebermannNote" n="34" target="#ECfRetr_12-4.lnote.la.34"/> socman<ptr type="liebermannNote" n="35" target="#ECfRetr_12-4.lnote.la.35"/> XII horas<ptr type="liebermannNote" n="i" target="#ECfRetr_12-4.lnote.la.fn.i"/>, de liberis <hi rend="bold">autem</hi> hominibus tres marcas.</ab>
        <note type="comparison" source="#liebermann" n="638"><label>printed alongside</label> <ref target="clause:ECf_12-4">ECf 12.4</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 638 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-4.lnote.la.fn.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">i. e. uiginti solidos <hi rend="italic">zur Retr. am Rande Co, im Text Or; vgl.</hi> pur le serf XX sol. <hi rend="italic">Leis Wl</hi> 7; <hi rend="italic">Hn</hi> 70, 2; 4</seg><seg type="translation" xml:lang="en" source="#claude">i. e. uiginti solidos, to the Retr., in the margin Co, in the text Or; cf. pur le serf XX sol., Leis Wl 7; Hn 70, 2; 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-4.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Cb Hv;</hi> Mon. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Cb Hv; Mon. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-4.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Cb Lb Hv;</hi> Dan. <hi rend="italic">übr.;</hi> et <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Cb Lb Hv; Dan. the others; Hv adds et</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-4.lnote.la.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">de <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds de</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_12-4.lnote.la.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">scotman <hi rend="italic">Hv;</hi> -men <hi rend="italic">Cb;</hi> sokeman <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">scotman Hv; -men Cb; sokeman K</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Manbot in the Danelaw: for a villein and a socman twelve oras (<hi rend="italic">horas</hi>), but for free men three marks.</ab>
      </div>
    </body>
