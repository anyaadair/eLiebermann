  <text>
    <body>
      <div type="clause" n="48">
        <head><ref type="lawCode" target="law:VIAtr">VI Atr</ref> 48</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="48" corresp="#wit-k"><pb n="258" ed="#liebermann"/>⁊ þ<hi rend="italic">æt</hi> hy ælþeodige m<hi rend="italic">en</hi> ⁊ feorran cumene ne tyrian ne ne tynan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="48" corresp="#wit-d-incomplete"><pb n="258" ed="#liebermann"/>And þ<hi rend="italic">æt</hi> hi ælþeodige men ⁊ feorran cumene ne tyrian ne tynan.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="48" corresp="#wit-k"><pb n="104" ed="#robertson"/>And þæt hi ælþeodige men ⁊ feorran cumene ne tyrian ne tynan.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-k"><pb n="176" ed="#rabin-doml"/>And þæt hy ælþeodige men and feorrancumene ne tyrian ne ne tynan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="259" ed="#liebermann"/>Und dass sie fremde<ptr type="liebermannNote" n="1" target="#VIAtr_48.lnote.de.1"/> und fernher gekommene<ptr type="liebermannNote" n="2" target="#VIAtr_48.lnote.de.2"/> Menschen nicht plagen<ptr type="liebermannNote" n="3" target="#VIAtr_48.lnote.de.3"/> noch quälen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And that they do not vex or harass foreigners and people come from afar.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-k"><ptr type="editorNote" n="1" target="#VIAtr_48.robnote.n.1"/><pb n="105" ed="#robertson"/>And that they should not vex<ptr type="editorNote" n="2" target="#VIAtr_48.robnote.n.2"/> or oppress strangers and men come from afar.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-k"><pb n="177" ed="#rabin-doml"/>And that strangers and those who have come from afar are not to be harassed or mistreated.</ab>
        <note type="comparison" source="#liebermann" n="259"><ref target="clause:Af_El-to-33">Af El 33</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 33</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_35">II Cn 35</ref></note>
        <note type="editorial">Liebermann compares Af El. 33.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VIAtr_48.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">177</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Vielleicht direkt aus Ex. 22, 21. <hi rend="italic">S. Gl</hi> Fremde 3. 7</seg><seg type="translation" xml:lang="en" source="#claude">Perhaps directly from Ex. 22, 21. <hi rend="italic">See Gl</hi> Fremde 3. 7</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VIAtr_48.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">177</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Vielleicht direkt aus Ex. 22, 21. <hi rend="italic">S. Gl</hi> Fremde 3. 7</seg><seg type="translation" xml:lang="en" source="#claude">Perhaps directly from Ex. 22, 21. <hi rend="italic">See Gl</hi> Fremde 3. 7</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VIAtr_48.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">177</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ne tyrige ne tyne</hi> auch <hi rend="italic">Hom. n</hi>. Wulfstan 70</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">ne tyrige ne tyne</hi> also <hi rend="italic">Hom. n</hi>. Wulfstan 70</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VIAtr_48.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">335</biblScope></bibl><seg type="original" xml:lang="en">Cf. Exodus Ch. 22, v. 21; Wulfstan, p. 119.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VIAtr_48.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">335</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e.</hi> no prejudice is to be shown in pronouncing judgment against strangers, cf. II Cn. 35, 1. For regulations regarding the protection extended to strangers, cf. E. and G. 12; VIII Atr. 33; 34; II Cn. 40; <hi rend="italic">Geþyncðo</hi>, 8.</seg></note>
      </div>
    </body>
  </text>
