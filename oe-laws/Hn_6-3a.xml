      <div type="clause" n="6.3a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 6.3a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 6.3a" corresp="#wit-lat"><pb n="552" ed="#liebermann"/>Ipsorum etiam iura<ptr type="liebermannNote" n="n" target="#Hn_6-3a.lnote.oe.n"/> comitatuum<ptr type="liebermannNote" n="28" target="#Hn_6-3a.lnote.oe.28"/> per prouincias<ptr type="liebermannNote" n="o" target="#Hn_6-3a.lnote.oe.o"/> plerumque dissenciunt<ptr type="liebermannNote" n="29" target="#Hn_6-3a.lnote.oe.29"/>, sicut<ptr type="liebermannNote" n="p" target="#Hn_6-3a.lnote.oe.p"/> uidelicet cupiditas<ptr type="liebermannNote" n="30" target="#Hn_6-3a.lnote.oe.30"/> et maligna professorum<ptr type="liebermannNote" n="q" target="#Hn_6-3a.lnote.oe.q"/> detestanda studia grauiora nocendi genera legalibus statibus<ptr type="liebermannNote" n="31" target="#Hn_6-3a.lnote.oe.31"/> adiecerunt.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 552 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-3a.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">von örtlichen Rechtsverschiedenheiten in Einer Lagu führt Verf. u.</hi> 22. 76, 7<hi rend="italic">g die Londons und Kents an, Domesday z. B. die Herefords</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">of local differences of law within one Lagu the author cites below</hi> 22. 76, 7<hi rend="italic">g those of London and Kent; Domesday, e.g., that of Hereford</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-3a.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">Shires <hi rend="italic">auch</hi> 7, 1</seg><seg type="translation" xml:lang="en" source="#claude">Shires <hi rend="italic">also</hi> 7, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-3a.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verf. leitet die Verwickelung des Rechts auch sonst aus gerichtsherrlicher Habgier ab; vgl.</hi> Quadr. Ded. 4; Arg. 13</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">the author elsewhere too derives the complication of the law from the greed of lords of courts; cf.</hi> Quadr. Ded. 4; Arg. 13</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-3a.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Quadr. Ded. 24. 38</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> Quadr. Ded. 24. 38</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-3a.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">comm. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">comm. <hi rend="italic">Co Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-3a.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">-nsum <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nsum <hi rend="italic">Co Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-3a.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de">-tatis <hi rend="italic">Sc Hg;</hi> -tate <hi rend="italic">Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tatis <hi rend="italic">Sc Hg;</hi> -tate <hi rend="italic">Wi</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-3a.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">552</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. vom Corr.</hi> statutibus <hi rend="italic">Sc;</hi> -tutibus <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">altered by the corrector</hi> statutibus <hi rend="italic">Sc;</hi> -tutibus <hi rend="italic">Hg</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_6-3a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">315</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Diversorum comit</hi>[<hi rend="italic">atuum</hi>] <hi rend="italic">sunt iura diuersa</hi> am Rande, spät im 13. Jh.—<hi rend="italic">cupiditatis</hi>{30}—Zu <hi rend="italic">professor</hi>{9} <hi rend="italic">vgl. Gl</hi> Jurist 3b; Gerechtigkeit 10—<hi rend="italic">leg. statibus</hi>: ‘Rechtsverfassung, Gesetzesstand’, nicht (mit Stubbs <hi rend="italic">Lect</hi>. 152) ‘statutes’</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Diversorum comit</hi>[<hi rend="italic">atuum</hi>] <hi rend="italic">sunt iura diuersa</hi> in the margin, late 13th cent.—<hi rend="italic">cupiditatis</hi>{30}—On <hi rend="italic">professor</hi>{9} <hi rend="italic">cf. Gl</hi> Jurist 3b; Gerechtigkeit 10—<hi rend="italic">leg. statibus</hi>: ‘legal constitution, state of the laws’, not (with Stubbs <hi rend="italic">Lect</hi>. 152) ‘statutes’</seg></note>
      </div>
