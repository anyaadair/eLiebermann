      <div type="clause" n="5.1">
        <head><ref type="lawCode" target="law:IudDeiXII">Iud Dei XII</ref> 5.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XII 5.1" corresp="#wit-lat"><pb n="420" ed="#liebermann"/>Et<ptr type="liebermannNote" n="30" target="#IudDeiXII_5-1.lnote.oe.30"/> his peractis, inponat<ptr type="liebermannNote" n="31" target="#IudDeiXII_5-1.lnote.oe.31"/> introitum:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 420 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_5-1.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr; Zeu.</hi> 609</seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr; Zeu. 609</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_5-1.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de">ponat <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">ponat Tr</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">And these things done, let him begin the introit:</ab>
      </div>
