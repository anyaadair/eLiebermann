  <text>
    <body>
      <div type="clause" n="2.1">
        <head><ref type="lawCode" target="law:IAtr">I Atr</ref> 2.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2.1" corresp="#wit-h"><pb n="220" ed="#liebermann"/>⁊ æt ðam oðrum cyrre ne sy þær nan oþer bot buton þæt heafod.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2.1" corresp="#wit-b"><pb n="220" ed="#liebermann"/>⁊ æt ðam<ptr type="liebermannNote" n="1" target="#IAtr_2-1.lnote.oe.1"/> oðran cyrre ne sy ðær<ptr type="liebermannNote" n="2" target="#IAtr_2-1.lnote.oe.2"/> nan bót buton þ<hi rend="italic">æt</hi> heafod.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2.1" corresp="#wit-q"><pb n="221" ed="#liebermann"/>Ad secundam uicem non sit illic alia emendatio quam capitalis.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="2.1" corresp="#wit-b"><pb n="54" ed="#robertson"/>⁊ æt ðam oðran cyrre ne sy ðær nan bót buton þæt heafod.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="221" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#IAtr_2-1.lnote.de.1"/> beim zweiten Male gebe es da keine andere Busse als den Kopf.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And the second time let there be no other compensation there than the head.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IAtr_2-1.robnote.n.1"/><pb n="55" ed="#robertson"/>And on the second occasion he shall not be able to make any amends except by his head.</ab>
        <note type="comparison" source="#liebermann" n="221"><ref target="clause:IAtr_1-6">I Atr 1.6</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. 1, 6</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_32-1">II Cn 32.1</ref></note>
        <note type="comparedBy" source="#whitelock" n="467"><ref target="clause:IICn_32">II Cn 32</ref></note>
        <note type="editorial">Liebermann compares I Atr 1.6.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_2-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">220</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_2-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">220</biblScope></bibl><seg type="original" xml:lang="de">ðære <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðære Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IAtr_2-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">148</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Wie beim Rückfall (<hi rend="italic">s. d. Gl</hi> 4a) Freier <hi rend="italic">o</hi>. 1, 6; an Unfreien ward die Hinrichtung gewiss öfter durch Hängen (<hi rend="italic">s. d. Gl</hi> 1) vollzogen</seg><seg type="translation" xml:lang="en" source="#claude">As in the case of relapse (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 4a) of free men <hi rend="italic">above</hi> 1, 6; on the unfree, execution was certainly more often carried out by hanging (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1)</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IAtr_2-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">313</biblScope></bibl><seg type="original" xml:lang="en">Cf. In. 24; VI As. 6, 3; III Edm. 4, where death by hanging is specified.</seg></note>
      </div>
