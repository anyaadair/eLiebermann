      <div type="clause" n="50">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 50</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 50" corresp="#wit-lat"><pb n="573" ed="#liebermann"/>(C. L<ptr type="liebermannNote" n="1" target="#Hn_50.lnote.oe.1"/>) De<ptr type="liebermannNote" n="a" target="#Hn_50.lnote.oe.a"/> supersessionibus<ptr type="liebermannNote" n="2" target="#Hn_50.lnote.oe.2"/> placiti<ptr type="liebermannNote" n="3" target="#Hn_50.lnote.oe.3"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 573 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_50.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">diese Überschrift fehlt hier und steht vor</hi> 51 <hi rend="italic">Co Or Gi. Hier steht die Rubrik für</hi> 49 <hi rend="italic">und am Rande roth:</hi> Semper ab isto capitulo in antea sequens rubrica est de precedenti capitulo, ut ad oculum patet <hi rend="italic">Co. Diese Verschiebung jeder Rubrik zum nächstfolgenden Capitel notire ich fortan nicht</hi></seg><seg type="translation" xml:lang="en" source="#claude">this heading is missing here and stands before 51 Co Or Gi. Here stands the rubric for 49, and in the margin in red: Semper ab isto capitulo in antea sequens rubrica est de precedenti capitulo, ut ad oculum patet Co. From now on I do not note this displacement of each rubric to the next following chapter</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_50.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_50.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">-rcess. <hi rend="italic">K Co Or Gi;</hi> -rsisio. <hi rend="italic">Wh;</hi> supersessis <hi rend="italic">gegen Hss., Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rcess. K Co Or Gi; -rsisio. Wh; supersessis against the MSS, Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_50.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">-tis <hi rend="italic">Sc Hg;</hi> -torum <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tis Sc Hg; -torum K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_50.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Vorladung 13. a; Klage 16b; Gerichtsversäumnis 12—<hi rend="italic">placitorum</hi>{3}—50, 2 <hi rend="italic">i</hi>.{10} <hi rend="italic">uel</hi> fehlt—<hi rend="italic">mannitus</hi> fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Vorladung 13. a; Klage 16b; Gerichtsversäumnis 12—<hi rend="italic">placitorum</hi>{3}—50, 2 <hi rend="italic">i</hi>.{10} <hi rend="italic">uel</hi> is missing—<hi rend="italic">mannitus</hi> is missing Rs</seg></note>
      </div>
