      <div type="clause" n="11">
        <head><ref type="lawCode" target="law:ExcomI">Excom I</ref> 11</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom I 11" corresp="#wit-ti"><pb n="433" ed="#liebermann"/>Excommunicatio<ptr type="liebermannNote" n="1" target="#ExcomI_11.lnote.oe.1"/>. Igitur quia monita nostra et crebras exhortationes contempnit<ptr type="liebermannNote" n="2" target="#ExcomI_11.lnote.oe.2"/>, quia<ptr type="liebermannNote" n="3" target="#ExcomI_11.lnote.oe.3"/> tercio<ptr type="liebermannNote" n="a" target="#ExcomI_11.lnote.oe.a"/> secundum dominicum preceptum uocatus<ptr type="liebermannNote" n="4" target="#ExcomI_11.lnote.oe.4"/> ad emendationem et pęnitenciam uenire despexit<ptr type="liebermannNote" n="5" target="#ExcomI_11.lnote.oe.5"/>, quod<ptr type="liebermannNote" n="6" target="#ExcomI_11.lnote.oe.6"/> culpam suam necdum cognouit<ptr type="liebermannNote" n="7" target="#ExcomI_11.lnote.oe.7"/> nec confessus<ptr type="liebermannNote" n="8" target="#ExcomI_11.lnote.oe.8"/> est, nec missa<ptr type="liebermannNote" n="9" target="#ExcomI_11.lnote.oe.9"/> nobis legatione, qui<ptr type="liebermannNote" n="10" target="#ExcomI_11.lnote.oe.10"/> causam<ptr type="liebermannNote" n="11" target="#ExcomI_11.lnote.oe.11"/> ipsius<ptr type="liebermannNote" n="12" target="#ExcomI_11.lnote.oe.12"/> exequimur<ptr type="liebermannNote" n="13" target="#ExcomI_11.lnote.oe.13"/>, quia noster<ptr type="liebermannNote" n="14" target="#ExcomI_11.lnote.oe.14"/> parrochyanus est, uoniam<ptr type="liebermannNote" n="15" target="#ExcomI_11.lnote.oe.15"/> postulauit<ptr type="liebermannNote" n="16" target="#ExcomI_11.lnote.oe.16"/>, quia in<ptr type="liebermannNote" n="b" target="#ExcomI_11.lnote.oe.b"/> incepta<ptr type="liebermannNote" n="17" target="#ExcomI_11.lnote.oe.17"/> malitia, diabolo cor<ptr type="liebermannNote" n="18" target="#ExcomI_11.lnote.oe.18"/> eius indurante, perseuerat et, iuxta quod apostolus dicit, secundum duriciam suam et cor inpęnitens thesaurizat sibi iram in die irae<ptr type="liebermannNote" n="19" target="#ExcomI_11.lnote.oe.19"/>,</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Regino II 413; Rom. 2, 5</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 433 (two independent readings of the page images, differences settled against the page); Liebermann’s print has ‘uoniam’ (an o for e; read ‘ueniam’); transcribed as printed</note>
