    <body>
      <div type="clause" n="84.5">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 84.5</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="84.5" corresp="#wit-g-a"><pb n="370" ed="#liebermann"/>Á<ptr type="liebermannNote" n="4" target="#IICn_84-5.lnote.oe.4"/> sy Godes nama ecelice gebletsod, ⁊ lof him<ptr type="liebermannNote" n="5" target="#IICn_84-5.lnote.oe.5-2"/> ⁊ wuldor ⁊ wyrðmynt symle<ptr type="liebermannNote" n="6" target="#IICn_84-5.lnote.oe.6-2"/> æfre to worulde!</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="84.5" corresp="#wit-b"><pb n="370" ed="#liebermann"/>Ac<ptr type="liebermannNote" n="1" target="#IICn_84-5.lnote.oe.1"/> sy Godes nama ecelice gebletsod, ⁊ lof him ⁊ wuldor ⁊ wyrðmynt æfre to worulde! Amen.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="84.5" corresp="#wit-a"><pb n="370" ed="#liebermann"/>Á sy Godes nama ecelice gebletsod, ⁊ lof him ⁊ wuldor ⁊ wyrðmynt symble æfre to weorulde!</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="84.5" corresp="#wit-q"><pb n="371" ed="#liebermann"/>Sit nomen eius benedictum in uitam ęternam<ptr type="liebermannNote" n="5" target="#IICn_84-5.lnote.oe.5"/>, et laus ei<ptr type="liebermannNote" n="6" target="#IICn_84-5.lnote.oe.6"/>, gloria et honor pariter in secula seculorum!</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="84.5" corresp="#wit-cons-cn"><pb n="371" ed="#liebermann"/>In eternum sit nomen Domini benedictum, cui laus et honor et gloria in secula seculorum!</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="84.5" corresp="#wit-b"><pb n="218" ed="#robertson"/>A[a]<ptr type="editorNote" n="6" target="#IICn_84-5.robnote.fn.6"/> sy Godes nama ecelice gebletsod, ⁊ lof him ⁊ wuldor ⁊ wyrðmynt æfre<ptr type="editorNote" n="7" target="#IICn_84-5.robnote.fn.7"/> to worulde. Amen<ptr type="editorNote" n="8" target="#IICn_84-5.robnote.fn.8"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="298" ed="#rabin-doml"/>A sy Godes nama ecelice gebletsod, and lof him and wuldor and wyrðmynt symle æfre to worulde.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="371" ed="#liebermann"/>Immer<ptr type="liebermannNote" n="1" target="#IICn_84-5.lnote.de.1"/> (Aber <hi rend="italic">B</hi>) sei Gottes Name ewiglich gesegnet, und Lob ihm und Preis und Ehre immer stets in Ewigkeit!</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Ever (But, B) be God's name blessed eternally, and praise to him and glory and honour always and forever!</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IICn_84-5.robnote.n.1"/><pb n="219" ed="#robertson"/>May the name of God be eternally blessed, and to Him be praise and glory and honour for ever and ever. Amen.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="299" ed="#rabin-doml"/>May God’s name be eternally blessed, and may there always be praise and glory and honor to him forever throughout the world.</ab>
        <note type="editorial">BR: added from Gesetze I p. 371, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">symle: omitted B</note>
        <note type="textual" source="#rabin-doml">worulde: B adds Amen</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-5.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">370</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> Aa?</seg><seg type="translation" xml:lang="en" source="#claude">read Aa?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-5.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">371</biblScope></bibl><seg type="original" xml:lang="de">sęcula <hi rend="italic">statt</hi> u. ę. <hi rend="italic">HkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">sęcula instead of u. ę. HkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-5.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">371</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu K</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-5.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">370</biblScope></bibl><seg type="original" xml:lang="de">aá <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">aá Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-5.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">370</biblScope></bibl><seg type="original" xml:lang="de">hym <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">hym Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_84-5.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">370</biblScope></bibl><seg type="original" xml:lang="de">symble <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">symble Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_84-5.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">214</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Ebenso <hi rend="italic">o</hi>. I 26, 5 BC.—<hi rend="italic">Vgl</hi>. Einl. 19</seg><seg type="translation" xml:lang="en" source="#claude">Likewise <hi rend="italic">above</hi> I 26, 5 BC.—<hi rend="italic">Cf</hi>. Introduction 19</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_84-5.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">359</biblScope></bibl><seg type="original" xml:lang="en">Cf. I Cn. 26, 4 B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_84-5.robnote.fn.6" n="6" source="#robertson"><bibl><biblScope unit="page">218</biblScope></bibl><label>A[a</label><seg type="original" xml:lang="en"><hi rend="italic">á</hi> G, A; <hi rend="italic">aá</hi> Ld; <hi rend="italic">ac</hi> B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_84-5.robnote.fn.7" n="7" source="#robertson"><bibl><biblScope unit="page">218</biblScope></bibl><label>æfre</label><seg type="original" xml:lang="en"><hi rend="italic">symle</hi> (<hi rend="italic">symble</hi>) <hi rend="italic">æ.</hi> G, A, Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_84-5.robnote.fn.8" n="8" source="#robertson"><bibl><biblScope unit="page">218</biblScope></bibl><label>Amen</label><seg type="original" xml:lang="en">Om. G, A, Ld.</seg></note>
      </div>
