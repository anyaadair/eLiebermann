    <body>
      <div type="clause" n="1">
        <head><ref type="lawCode" target="law:Mirce">Mirce</ref> 1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1" corresp="#wit-d"><pb n="462" ed="#liebermann"/>Ceorles wergild is on Myrcna lage CC scill'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1" corresp="#wit-o"><pb n="462" ed="#liebermann"/>[C]eorles<ptr type="liebermannNote" n="1" target="#Mirce_1.lnote.oe.1"/> wergild is on Mercena lage CC scill'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1" corresp="#wit-h"><pb n="462" ed="#liebermann"/>Ceorles wergyld is on Myrcna lage CC scill'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1" corresp="#wit-ld"><pb n="463" ed="#liebermann"/>Ceorles weregyld on Mercna land<ptr type="liebermannNote" n="b" target="#Mirce_1.lnote.oe.b"/><ptr type="liebermannNote" n="*" target="#Mirce_1.lnote.oe.star"/> biþ CC scill.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1" corresp="#wit-q"><pb n="463" ed="#liebermann"/>Ceorles<ptr type="liebermannNote" n="2" target="#Mirce_1.lnote.oe.2"/> weregildum est in Mircenorum<ptr type="liebermannNote" n="3" target="#Mirce_1.lnote.oe.3"/> laga CC sol.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1" corresp="#wit-in"><pb n="463" ed="#liebermann"/>Prętium hominis<ptr type="liebermannNote" n="1" target="#Mirce_1.lnote.oe.1-2"/>, quem superius<ptr type="liebermannNote" n="a" target="#Mirce_1.lnote.oe.a"/><ptr type="liebermannNote" n="2" target="#Mirce_1.lnote.oe.2-2"/> nominauimus ceorlman<ptr type="liebermannNote" n="3" target="#Mirce_1.lnote.oe.3-2"/>, secundum legem Merciorum sunt CC solidi.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-h"><pb n="14" ed="#rabin-doml"/>Ceorles wergyld is on Myrcna lage CC scillinga.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="462" ed="#liebermann"/>Eines Gemeinfreien Wergeld ist in Mercier-Recht (Land <hi rend="italic">Ld</hi>) 200 Schill. [3¹/₃ Pfund].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">A ceorl's wergild is by Mercian law (in the Mercian land, Ld) 200 shillings [3⅓ pounds].</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-d"><pb n="477" ed="#whitelock"/>In the law of the Mercians a <hi rend="italic">ceorl's</hi> wergild is 200 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-h">According to the law of the Mercians, a commoner’s wergild is two hundred shillings.</ab>
        <note type="comparison" source="#liebermann" n="462">Norðleoda [?]</note>
        <note type="comparisonPrinted" source="#liebermann">Norðleo[?]</note>
        <note type="comparisonIncomplete">Some of Liebermann’s notes here are cut off in the gutter of the scan used, and are still to be completed.</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Northleoda_6">Norðleoda 6</ref></note>
        <note type="editorial">Column O holds the Quadripartitus. Liebermann compares Norðleod 6.; U: checked against Whitelock, EHD I (1979), and corrected (before: ‘In the law of the Mercians a ceorl's wergild is 200 shillings’).; AZ: added from Rabin p. 14, October 2026 (Rabin’s note to the translation)</note>
        <note type="translator" source="#rabin-doml">On the Law of the Mercians: The title is omitted from Textus Roffensis (MS H).</note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">462</biblScope></bibl><seg type="original" xml:lang="de">eorles, <hi rend="italic">Platz für roth einzufüllende Initiale frei</hi></seg><seg type="translation" xml:lang="en" source="#claude">eorles, space left free for an initial to be filled in in red</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Abweichung vom Original</hi></seg><seg type="translation" xml:lang="en" source="#claude">Departure from the original</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de">Che. <hi rend="italic">stets Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Che. always Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so R;</hi> Mer. <hi rend="italic">LondMHk;</hi> Myr. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">so R; Mer. LondMHk; Myr. T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">Lb S Pl Jo Ct</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius Lb S Pl Jo Ct</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">III</hi> 5. <hi rend="italic">aus Af</hi> 29, <hi rend="italic">oben S.</hi> 65</seg><seg type="translation" xml:lang="en" source="#claude">III 5. from Af 29, above p. 65</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de">supra <hi rend="italic">Cb; fehlt Ct</hi></seg><seg type="translation" xml:lang="en" source="#claude">supra Cb; missing in Ct</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Mirce_1.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">463</biblScope></bibl><seg type="original" xml:lang="de">cher. <hi rend="italic">Cb;</hi> cherlem. <hi rend="italic">Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">cher. Cb; cherlem. Pl</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Mirce_1.lnote.de.1" n="1" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">262</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Wergeld 6. 9b</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Wergeld 6. 9b</seg></note>
      </div>
