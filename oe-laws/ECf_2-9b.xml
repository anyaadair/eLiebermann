      <div type="clause" n="2.9b">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 2.9b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 2.9b"><pb n="629" ed="#liebermann"/>Et<ptr type="liebermannNote" n="25" target="#ECf_2-9b.lnote.la.25"/> sic iuste<ptr type="liebermannNote" n="26" target="#ECf_2-9b.lnote.la.26"/> gladius gladium iuuabit<ptr type="liebermannNote" n="d" target="#ECf_2-9b.lnote.la.fn.d"/>.</ab>
        <note type="comparison" source="#liebermann" n="629"><label>printed alongside</label> <ref target="clause:ECfRetr_2-9b">ECf retr 2.9b</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 629 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “gladius” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_2-9b.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. u.</hi> 17</seg><seg type="translation" xml:lang="en" source="#claude">cf. below, 17</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-9b.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de">Et—iuuabit <hi rend="italic">fehlt Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et—iuuabit lacking in Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_2-9b.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">629</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
      </div>
    </body>
