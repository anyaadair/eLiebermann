    <body>
      <div type="clause" n="70">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 70</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="70" corresp="#wit-h"><pb n="7" ed="#liebermann"/>Gif seo micle<ptr type="liebermannNote" n="3" target="#Abt_70.lnote.oe.3"/> ta of weorðeþ, X scll'<ptr type="liebermannNote" n="2" target="#Abt_70.lnote.oe.2"/> forgelden.<ptr type="liebermannNote" n="*" target="#Abt_70.lnote.oe.star"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-h"><pb n="12" ed="#attenborough"/>Gif seo micle<ptr type="editorNote" n="2" target="#Abt_70.attnote.fn.2"/> ta of weorðeþ, X scll' forgelde<ptr type="editorNote" n="1" target="#Abt_70.attnote.fn.1"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="70" corresp="#wit-h"><pb n="76" ed="#oliver"/>Gif seo micle<ptr type="editorNote" n="d" target="#Abt_70.olinote.fn.d"/> ta of weorðeþ, X scƚƚ forgelde(n).<ptr type="editorNote" n="e" target="#Abt_70.olinote.fn.e"/></ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="7" ed="#liebermann"/>Wenn die grosse<ptr type="liebermannNote" n="1" target="#Abt_70.lnote.de.1"/> Zehe ab[gehauen] wird, entgelte er 10 Schll.<ptr type="liebermannNote" n="2" target="#Abt_70.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the big toe is [cut] off, let him pay 10 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="13" ed="#attenborough"/>If the big toe is struck off, 10 shillings shall be paid for it.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h"><pb n="77" ed="#oliver"/>If the big toe becomes [struck] off, let him pay [with] 10 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Abt_70.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">7</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geändert in</hi> mycle</seg><seg type="translation" xml:lang="en" source="#claude">altered to mycle</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Abt_70.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">7</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so ohne</hi> i</seg><seg type="translation" xml:lang="en" source="#claude">so, without i</seg><note type="remark" resp="#claude">One footnote serves four places on p. 7: Abt 67.1, 70, 73 and 75.1.</note></note>
        <note type="liebermannNote" subtype="textual" xml:id="Abt_70.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">7</biblScope></bibl><seg type="original" xml:lang="de">forgelde <hi rend="italic">bessern Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">forgelde, as the editors emend</seg><note type="remark" resp="#claude">One footnote serves Abt 69 and Abt 70.</note></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_70.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">13</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Korrektor ändert öfter früheres <hi rend="italic">i</hi> in <hi rend="italic">y;</hi> <hi rend="italic">s.</hi> 74. 76 <hi rend="italic">sy</hi></seg><seg type="translation" xml:lang="en" source="#claude">The corrector frequently changes an earlier <hi rend="italic">i</hi> to <hi rend="italic">y;</hi> <hi rend="italic">see</hi> 74. 76 <hi rend="italic">sy</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_70.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">13</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Halbsoviel wie der Daumen <hi rend="italic">o.</hi> 54; <hi rend="italic">vgl. Gl</hi> Fuss 2b. Die Summe der Zehenbussen macht 25 Schill., also bleibt für den Fussstumpf 25 Schill., ‘was sich mit der physiologischen Bedeutung des Metatarsus erklärt’ (Schreuer 21) und bei anderen Germanen wiederfindet</seg><seg type="translation" xml:lang="en" source="#claude">Half as much as the thumb, <hi rend="italic">above</hi> 54; <hi rend="italic">cf. Gl</hi> Fuss 2b. The compensations for the toes add up to 25 shillings, which leaves 25 shillings for the stump of the foot, an arrangement ‘which is explained by the physiological importance of the metatarsus’ (Schreuer 21) and is found among other Germanic peoples as well</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Abt_70.attnote.fn.1" n="1" source="#attenborough"><bibl><biblScope unit="page">12</biblScope></bibl><label>forgelde</label><seg type="original" xml:lang="en">em. Hickes. <hi rend="italic">forgelden</hi>. H.</seg><note type="remark" resp="#claude">The number 1 is printed 2 times on the page (69, 70), with one footnote.</note></note>
        <note type="editorNote" subtype="footnote" xml:id="Abt_70.attnote.fn.2" n="2" source="#attenborough"><bibl><biblScope unit="page">12</biblScope></bibl><label>micle</label><seg type="original" xml:lang="en">Altered to <hi rend="italic">mycle</hi>.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Abt_70.olinote.fn.d" n="d" source="#oliver"><bibl><biblScope unit="page">76</biblScope></bibl><label>micle</label><seg type="original" xml:lang="en">Changed from <hi rend="italic">mycle</hi> by scribe.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Abt_70.olinote.fn.e" n="e" source="#oliver"><bibl><biblScope unit="page">76</biblScope></bibl><label>forgelde(n).</label><seg type="original" xml:lang="en">I follow Liebermann’s suggestion that <hi rend="italic">forgelden</hi> should be emended to the singular <hi rend="italic">forgelde</hi>; see §§27.2 and 69.</seg></note>
      </div>
