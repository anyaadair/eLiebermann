        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr II 8.2" corresp="#wit-lat"><pb n="545" ed="#liebermann"/>Depositi sunt ibi<ptr type="liebermannNote" n="17" target="#QuadrII_8-2.lnote.oe.17"/> duo<ptr type="liebermannNote" n="i" target="#QuadrII_8-2.lnote.oe.i"/> abbates propter symonie<ptr type="liebermannNote" n="18" target="#QuadrII_8-2.lnote.oe.18"/> circumuentionem, et<ptr type="liebermannNote" n="19" target="#QuadrII_8-2.lnote.oe.19"/> exordinati duo monachi propter homicidium in ecclesia<ptr type="liebermannNote" n="20" target="#QuadrII_8-2.lnote.oe.20"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 545 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8-2.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">drei: Wido von Pershore, Witmund von Tavistock, Ealdwine von Ramsey</hi></seg><seg type="translation" xml:lang="en" source="#claude">three: Wido of Pershore, Witmund of Tavistock, Ealdwine of Ramsey</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_8-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">545</biblScope></bibl><seg type="original" xml:lang="de">duo ibi <hi rend="italic">M</hi></seg><seg type="translation" xml:lang="en" source="#claude">duo ibi M</seg></note>
