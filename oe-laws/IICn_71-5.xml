  <text>
    <body>
      <div type="clause" n="71.5">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 71.5</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="71.5" corresp="#wit-g-a"><pb n="358" ed="#liebermann"/>⁊ se ðe læsse<ptr type="liebermannNote" n="21" target="#IICn_71-5.lnote.oe.21-2"/> mage<ptr type="liebermannNote" n="*" target="#IICn_71-5.lnote.oe.star"/> si: II pund.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="71.5" corresp="#wit-b"><pb n="358" ed="#liebermann"/>And se ðe læsse<ptr type="liebermannNote" n="3" target="#IICn_71-5.lnote.oe.3"/> habbe ⁊ læsse maga sy<ptr type="liebermannNote" n="4" target="#IICn_71-5.lnote.oe.4"/>: II pund.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="71.5" corresp="#wit-a"><pb n="358" ed="#liebermann"/>⁊ se ðe lesse mæge sy: II pund.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="71.5" corresp="#wit-q"><pb n="359" ed="#liebermann"/>Et<ptr type="liebermannNote" n="21" target="#IICn_71-5.lnote.oe.21"/> qui minus potest, det II libras.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="71.5" corresp="#wit-inst-cn"><pb n="359" ed="#liebermann"/>et qui tantum non (habet<ptr type="liebermannNote" n="8" target="#IICn_71-5.lnote.oe.8"/> uel) potest<ptr type="liebermannNote" n="9" target="#IICn_71-5.lnote.oe.9"/>, XL solidos.<ptr type="liebermannNote" n="**" target="#IICn_71-5.lnote.oe.star2"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="71.5" corresp="#wit-cons-cn"><pb n="359" ed="#liebermann"/>Eius uero qui impotencior apud regem: due libre.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="71a.5" corresp="#wit-b"><pb n="210" ed="#robertson"/>⁊ se ðe læsse habbe ⁊<ptr type="editorNote" n="4" target="#IICn_71-5.robnote.fn.4"/> læsse maga sy—II pund.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="290" ed="#rabin-doml"/>And se ðe læsse maga si: II pund.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="359" ed="#liebermann"/>Und wer (weniger besitzt und <hi rend="italic">B</hi>) weniger vermögend<ptr type="liebermannNote" n="1" target="#IICn_71-5.lnote.de.1"/> ist: 2<ptr type="liebermannNote" n="2" target="#IICn_71-5.lnote.de.2"/> Pfund [Silber].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And he who (has less and, B) is less well-off: 2 pounds [of silver].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="211" ed="#robertson"/>And for the man who is inferior in wealth<ptr type="editorNote" n="1" target="#IICn_71-5.robnote.n.1"/> and position the heriot shall be £2.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="472" ed="#whitelock"/>And he who is of lower position: two pounds.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="291" ed="#rabin-doml"/>And for those lower in rank: two pounds.</ab>
        <note type="editorial">Liebermann prefers B's ‘maga’ to G's ‘mage’.; BR: added from Gesetze I p. 359, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">maga: mage G</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_71-5.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">358</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Instituta</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. Instituta</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_71-5.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">358</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt ein Buchstabe radirt</hi></seg><seg type="translation" xml:lang="en" source="#claude">a letter follows, erased</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_71-5.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">359</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt R</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_71-5.lnote.oe.21-2" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">358</biblScope></bibl><seg type="original" xml:lang="de">læsse hæbbe ⁊ l. m. sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">læsse hæbbe ⁊ l. m. sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_71-5.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">358</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">besser</hi> maga <hi rend="italic">B</hi></seg><seg type="translation" xml:lang="en" source="#claude">better maga B</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_71-5.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">359</biblScope></bibl><seg type="original" xml:lang="de">h. u. <hi rend="italic">nur Cb</hi> [<hi rend="italic">vgl. Hs. B</hi>]; <hi rend="italic">fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. u. only Cb [cf. MS B]; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_71-5.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">359</biblScope></bibl><seg type="original" xml:lang="de">poterit <hi rend="italic">Lb S</hi></seg><seg type="translation" xml:lang="en" source="#claude">poterit Lb S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_71-5.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">359</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Normannischer Rechnung</hi></seg><seg type="translation" xml:lang="en" source="#claude">by Norman reckoning</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_71-5.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">212</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘mächtig beim König’ ungenau A. Vielmehr wie AGu 3: weniger ‘wohlhabend, reich’, auch da im Ggs. zum Königsthegn. Dies besagt B's Zusatz</seg><seg type="translation" xml:lang="en" source="#claude">‘powerful with the king’ A, inaccurately. Rather, as in AGu 3: less ‘well-to-do, rich’, there too in contrast to the king’s thegn. This is what B’s addition says</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_71-5.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">212</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Wie <hi rend="italic">o</hi>. 71, 2. Doch sind im übrigen England nur 2 Thegnklassen, hier 3 genannt</seg><seg type="translation" xml:lang="en" source="#claude">As <hi rend="italic">above</hi> 71, 2. But in the rest of England only 2 classes of thegn are named, here 3</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_71-5.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">358</biblScope></bibl><seg type="original" xml:lang="en">This reference to wealth is peculiar to B. The phrase <hi rend="italic">læsse maga</hi> (cf. A. and G. 3), which is common to all the texts, would seem to have the same meaning as <hi rend="italic">medemra ðegna</hi> (MSS. G, A) in § 2.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IICn_71-5.robnote.fn.4" n="4" source="#robertson"><bibl><biblScope unit="page">210</biblScope></bibl><label>⁊</label><seg type="original" xml:lang="en"><hi rend="italic">l. h.</hi> ⁊ om. G, A.</seg></note>
      </div>
    </body>
