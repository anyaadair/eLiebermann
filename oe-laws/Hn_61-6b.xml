        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 61.6b" corresp="#wit-lat"><pb n="581" ed="#liebermann"/>Set siue antea siue postmodum inplacitet alius<ptr type="liebermannNote" n="28" target="#Hn_61-6b.lnote.oe.28"/> aliquis eum<ptr type="liebermannNote" n="l" target="#Hn_61-6b.lnote.oe.l"/> et eundem uel alium diem ponat, ei iure<ptr type="liebermannNote" n="29" target="#Hn_61-6b.lnote.oe.29"/> semper<ptr type="liebermannNote" n="30" target="#Hn_61-6b.lnote.oe.30"/> preerit<ptr type="liebermannNote" n="31" target="#Hn_61-6b.lnote.oe.31"/> dominus cuius ligius<ptr type="liebermannNote" n="ll" target="#Hn_61-6b.lnote.oe.ll"/> est.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 581 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-6b.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">581</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verklagter</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">the defendant</hi></seg></note>
