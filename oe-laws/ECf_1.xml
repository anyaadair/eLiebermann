    <body>
      <div type="clause" n="1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 1"><pb n="628" ed="#liebermann"/><ptr type="liebermannNote" n="1" target="#ECf_1.lnote.la.1"/>A<ptr type="liebermannNote" n="2" target="#ECf_1.lnote.la.2"/> sancta itaque<ptr type="liebermannNote" n="3" target="#ECf_1.lnote.la.3"/> ecclesia exordium sumentes<ptr type="liebermannNote" n="a" target="#ECf_1.lnote.la.fn.a"/>, per quam rex<ptr type="liebermannNote" n="a" target="#ECf_1.lnote.oe.erkl-a"/> et regnum<ptr type="liebermannNote" n="4" target="#ECf_1.lnote.la.4"/> solide subsistere<ptr type="liebermannNote" n="b" target="#ECf_1.lnote.la.fn.b"/> haberent<ptr type="liebermannNote" n="5" target="#ECf_1.lnote.la.5"/>, pacem<ptr type="liebermannNote" n="6" target="#ECf_1.lnote.la.6"/> et<ptr type="liebermannNote" n="7" target="#ECf_1.lnote.la.7"/> libertatem illius<ptr type="liebermannNote" n="8" target="#ECf_1.lnote.la.8"/> concionati<ptr type="liebermannNote" n="9" target="#ECf_1.lnote.la.9"/> sunt dicentes:</ab>
        <note type="comparison" source="#liebermann" n="628"><label>printed alongside</label> <ref target="clause:ECfRetr_1">ECf retr 1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 628 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">mit der Kirche beginnen Gesetze, Rechtsbücher und Freibriefe</hi> 11./12. <hi rend="italic">Jhs.</hi></seg><seg type="translation" xml:lang="en" source="#claude">laws, law books and charters of the 11th and 12th centuries begin with the Church</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Retr. bessert oft den Stil</hi></seg><seg type="translation" xml:lang="en" source="#claude">the Retractator often improves the style</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">De pace et libertate sancte ecclesie <hi rend="italic">überschr. Pl S;</hi> De ecclesia <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">headed De pace et libertate sancte ecclesie Pl S; De ecclesia Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">De <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">De Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">e. i. <hi rend="italic">Cl; fehlt Ad Do Wo Ed</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. i. Cl; lacking in Ad Do Wo Ed</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">regum <hi rend="italic">Pl Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">regum Pl Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">habere <hi rend="italic">Ad Do Wo No Ck;</hi> ualerent <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">habere Ad Do Wo No Ck; ualerent Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">pacemque li. illis <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">pacemque li. illis Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">ill. et l. <hi rend="italic">Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">ill. et l. Pl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad;</hi> ipsius <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad; ipsius Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">628</biblScope></bibl><seg type="original" xml:lang="de">c. s. <hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. s. lacking in Hr</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Taking their beginning, therefore, from holy Church, through which king and kingdom were to stand firm, they declared her peace and liberty, saying:</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_1.lnote.oe.erkl-a" n="a" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">343</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Kirchenstaatsrecht 4; Kirchenfreiheit 4. Als Sprecher ist die angebliche Jury zu denken, hauptsächlich Laien, von denen also dieser Klerikale das Kirchenrecht feststellen lässt!</seg><seg type="translation" xml:lang="en" source="#claude">Cf. Gl Kirchenstaatsrecht 4; Kirchenfreiheit 4. The speakers are to be thought of as the alleged jury, mainly laymen, by whom, then, this cleric has church law declared!</seg></note>
      </div>
    </body>
  </text>
