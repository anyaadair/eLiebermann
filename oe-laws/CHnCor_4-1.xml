    <body>
      <div type="clause" n="4.1">
        <head><ref type="lawCode" target="law:CHnCor">CHn cor</ref> 4.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-lat"><pb n="522" ed="#liebermann"/>Et terræ et<ptr type="liebermannNote" n="5" target="#CHnCor_4-1.lnote.oe.5"/> liberorum custos erit siue uxor siue alius propinquorum<ptr type="liebermannNote" n="6" target="#CHnCor_4-1.lnote.oe.6"/>, qui iustius esse debebit<ptr type="liebermannNote" n="7" target="#CHnCor_4-1.lnote.oe.7"/>.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="4.1" corresp="#wit-h"><pb n="278" ed="#robertson"/>Et terrae et liberorum custos erit sive uxor sive alius propinquarius qui iustius esse debeat.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-h"><pb n="279" ed="#robertson"/>And the guardian of the land and children shall be either the wife or some other relative who has a better right.</ab>
        <note type="editorial">Added October 2026 from Robertson pp. 278–279 (text and translation); Liebermann’s text added from Gesetze I p. 522, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="CHnCor_4-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">522</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt</hi> [<hi rend="italic">falsch</hi>] <hi rend="italic">Alb Haug Gl Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted [wrong] Alb Haug Gl Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="CHnCor_4-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">522</biblScope></bibl><seg type="original" xml:lang="de">-quarius <hi rend="italic">HRl;</hi> -quior <hi rend="italic">Alb Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-quarius HRl; -quior Alb Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="CHnCor_4-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">522</biblScope></bibl><seg type="original" xml:lang="de">† debet <hi rend="italic">Alb;</hi> debeat <hi rend="italic">HRl</hi></seg><seg type="translation" xml:lang="en" source="#claude">† debet Alb; debeat HRl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="CHnCor_4-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">297</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Vormund 5. a; Sippe 14d</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Vormund 5. a; Sippe 14d</seg></note>
      </div>
