    <body>
      <div type="clause" n="6.2c">
        <head><ref type="lawCode" target="law:IVAs">IV As</ref> 6.2c</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.2c" corresp="#wit-h-frag"><pb n="171" ed="#liebermann"/>⁊ sece swylce socne swylce<ptr type="liebermannNote" n="1" target="#IVAs_6-2c.lnote.oe.1"/> he sece, þæt he ne sy his feores wyrðe, butan swa feola nihta swa we her beufan cwædon.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="6.4" corresp="#wit-h-frag"><pb n="150" ed="#attenborough"/>⁊ sece swylce socne swylce he sece, þæt he ne sy his feores wyrðe, butan swa feola nihta swa we her beufan cwædon.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="171" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#IVAs_6-2c.lnote.de.1"/> jener [Verbrecher] mag, welche Zuflucht immer er auch suche, aufsuchen: dass er seines Lebens nicht [länger] sicher sei als so viel Tage, wie wir hier oben<ptr type="liebermannNote" n="2" target="#IVAs_6-2c.lnote.de.2"/> bestimmt haben.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And whatever sanctuary that [criminal] may seek: that he is not secure of his life [any longer] than as many days as we determined here above.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h-frag"><pb n="151" ed="#attenborough"/>But let him seek what sanctuary he may, his life shall be spared only for as many days as we have declared above.</ab>
        <note type="comparison" source="#liebermann" n="172">Vor. S.</note>
        <note type="comparisonPrinted" source="#liebermann">ebd.</note>
        <note type="comparedBy" source="#wormald-mel" n="358"><label>loose/partial source (in parentheses)</label> <ref target="clause:IICn_26-1">II Cn 26.1</ref> <quote>Table 5.4, II Cn 26:1: (IV As 6:2c)</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-2c.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">171</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAs_6-2c.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">113</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">In Q = 6, 2 Ende</seg><seg type="translation" xml:lang="en" source="#claude">In Q = end of 6, 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAs_6-2c.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">113</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">In 6, 1 und 6, 2a</seg><seg type="translation" xml:lang="en" source="#claude">In 6, 1 and 6, 2a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAs_6-2c.lnote.de.0" n="0" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">114</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S.</hi> vor. Erkl.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See</hi> preceding note</seg></note>
      </div>
