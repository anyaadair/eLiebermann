    <body>
      <div type="clause" n="El. 44">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 44</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 44" corresp="#wit-e"><pb n="40" ed="#liebermann"/>Ónscuna<ptr type="liebermannNote" n="36" target="#Af_El-to-44.lnote.oe.36"/> ðu á<ptr type="liebermannNote" n="35" target="#Af_El-to-44.lnote.oe.35"/> leasunga.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 44" corresp="#wit-g-prol-only"><pb n="40" ed="#liebermann"/>Onscuna þu á leasunga.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 44" corresp="#wit-h"><pb n="41" ed="#liebermann"/>Onscuna ða leasunga.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 44" corresp="#wit-q"><pb n="41" ed="#liebermann"/>Mendacium fugies.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 44" corresp="#wit-e"><pb n="258" ed="#jurasinski-and-oliver"/>Ónscuna ðu á leasunga.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="41" ed="#liebermann"/>Verabscheue du<ptr type="liebermannNote" n="1" target="#Af_El-to-44.lnote.de.1"/> stets Lügen.<ptr type="liebermannNote" n="2" target="#Af_El-to-44.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Always abhor lies.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="259" ed="#jurasinski-and-oliver"/>Always shun lies.</ab>
        <note type="passageSource">Exodus 23,7</note>
        <note type="comparison" source="#liebermann" n="41">Exodus 23.7</note>
        <note type="comparisonPrinted" source="#liebermann">[23, 7]</note>
        <note type="comparedBy" source="#wormald-mel" n="283"><ref target="clause:Af_32">Af 32</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-44.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de">-ne <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ne So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-44.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">40</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt So</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in So</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-44.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">47</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘die’ H, vermutlich durch unabsichtliches Übersehen des Vokals <hi rend="italic">u</hi> neben ähnlichem <hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">‘those’ H, presumably through inadvertently overlooking the vowel <hi rend="italic">u</hi> next to the similar <hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-44.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">47</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘üble Nachrede’ Schmid gegen Vulgata, wohl nur weil Price-Thorpe ‘leasings’ (jetzt ‘Verleumdung’) der Wortgleichheit wegen bot. Toller ebenso, aber mit nur drei Belegen, die alle nicht diesen Sinn, sondern ‘Lüge, Betrug’ fordern</seg><seg type="translation" xml:lang="en" source="#claude">‘evil report’ Schmid, against the Vulgate, probably only because Price-Thorpe offered ‘leasings’ (now ‘slander’) on account of the identity of the word. Toller likewise, but with only three references, none of which requires this sense; all require ‘lie, deceit’</seg></note>
      </div>
