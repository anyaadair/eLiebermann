        <note type="liebermannNote" subtype="textual" xml:id="Af_10.lnote.oe.3-3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">57</biblScope></bibl><seg type="original" xml:lang="de">ipsam weram <hi rend="italic">fügt zu Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">ipsam weram added by Or</seg></note>
