        <note type="liebermannNote" subtype="textual" xml:id="Ine_4.lnote.oe.9-2" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> -sceatt</seg><seg type="translation" xml:lang="en" source="#claude">altered to -sceatt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_4.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">Cyr. syn <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cyr. syn Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_4.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">seint Martynes <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">seint Martynes Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_4.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">sy <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">sy Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_4.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">feowertig <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">feowertig Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_4.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">90</biblScope></bibl><seg type="original" xml:lang="de">twelff. agyfe ð. cyr. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">twelff. agyfe ð. cyr. Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_4.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Nicht ‘Schoss’, sondern ‘Schatz’ entspricht <hi rend="italic">sceatt</hi> lautlich. <hi rend="italic">Vgl. Gl</hi> Kirchenpfennig 8. 9. Er ward mit Zehnten nur durch falsche Interpunktion hinter II Eg 2, 1 vermengt. Er ist meist nur im alten Wessex verbreitet; Neilson <hi rend="italic">Customary rents</hi> 193ff. Zum Übergang in Laienhände <hi rend="italic">vgl.</hi> Red book of Exchequer III 1039: nach 1066 [auch früher] <hi rend="italic">le pristrent a lor oeps plusors seignurs</hi></seg><seg type="translation" xml:lang="en" source="#claude">Not ‘Schoss’ but ‘Schatz’ corresponds phonetically to <hi rend="italic">sceatt</hi>. <hi rend="italic">Cf. Gl</hi> Kirchenpfennig 8. 9. It was confused with tithe only through faulty punctuation after II Eg 2, 1. It is mostly found only in old Wessex; Neilson <hi rend="italic">Customary rents</hi> 193ff. On its passing into lay hands <hi rend="italic">cf.</hi> Red book of Exchequer III 1039: after 1066 [earlier too] <hi rend="italic">le pristrent a lor oeps plusors seignurs</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_4.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Er heisst danach <hi rend="italic">Martinsrent;</hi> Neilson 195. Dies zitiert II Eg 3</seg><seg type="translation" xml:lang="en" source="#claude">It is accordingly called <hi rend="italic">Martinsrent;</hi> Neilson 195. This is cited by II Eg 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_4.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Fehler <hi rend="italic">XL</hi> aus <hi rend="italic">LX</hi> B Ld wie 53¹⁰. Af 48²</seg><seg type="translation" xml:lang="en" source="#claude">Error <hi rend="italic">XL</hi> for <hi rend="italic">LX</hi> B Ld, as 53¹⁰. Af 48²</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_4.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Königliche Beamte helfen zur Eintreibung; I As 4</seg><seg type="translation" xml:lang="en" source="#claude">Royal officials help to collect it; I As 4</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_4.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">69</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Aus den zwei verschiedenen Verben fürs Zahlen erhellen zweierlei Empfänger: Staat und Kirche. — Bessere Übs.: ‘Kirchenpfennig’; <hi rend="italic">vgl.</hi> Einl. 11</seg><seg type="translation" xml:lang="en" source="#claude">The two different verbs for paying show that there are two kinds of recipient: the state and the Church. — Better translation: ‘church-penny’; <hi rend="italic">cf.</hi> Introduction 11</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_4.attnote.fn.11" n="11" source="#attenborough"><bibl><biblScope unit="page">36</biblScope></bibl><label>ciricsceatte</label><seg type="original" xml:lang="en">This and subsequent titles taken from B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_4.attnote.fn.12" n="12" source="#attenborough"><bibl><biblScope unit="page">36</biblScope></bibl><label>lx</label><seg type="original" xml:lang="en"><hi rend="italic">feortig</hi>. B.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_4.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">183</biblScope></bibl><seg type="original" xml:lang="en">To the king (Liebermann).</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_4.attnote.n.2" n="2" source="#attenborough"><bibl><biblScope unit="page">183</biblScope></bibl><seg type="original" xml:lang="en">To the church (Liebermann).</seg></note>
