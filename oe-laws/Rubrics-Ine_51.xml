      <div type="clause" n="51">
        <head>Ine Rb 51</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="51" corresp="#wit-e"><pb n="24" ed="#liebermann"/>XCV. Be ðon ðe gesiðcund mon fierd<ptr type="liebermannNote" n="9" target="#Rubrics-Ine_51.lnote.oe.9"/> forsitte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="51" corresp="#wit-g-prol"><pb n="24" ed="#liebermann"/>XCV. Be þan ðe gesiðcund man fyrd forsitte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="51" corresp="#wit-h"><pb n="25" ed="#liebermann"/>XCV. Be þon<ptr type="liebermannNote" n="3" target="#Rubrics-Ine_51.lnote.oe.3"/> ðe gesiþcund mon<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_51.lnote.oe.2"/> fyrde forsitte.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="51" corresp="#wit-q"><pb n="25" ed="#liebermann"/>De<ptr type="liebermannNote" n="16" target="#Rubrics-Ine_51.lnote.oe.16"/> eo si homo syðcundus<ptr type="liebermannNote" n="17" target="#Rubrics-Ine_51.lnote.oe.17"/> hosticum<ptr type="liebermannNote" n="18" target="#Rubrics-Ine_51.lnote.oe.18"/> supersedeat.<ptr type="liebermannNote" n="19" target="#Rubrics-Ine_51.lnote.oe.19"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="210" ed="#jurasinski-and-oliver"/>XCV Be ðon ðe gesiðcund mon fierd forsitte</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="210" ed="#jurasinski-and-oliver"/>Be þam þe gesiðcund man fyrde forsitte</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="25" ed="#liebermann"/>Darüber, dass jemand vom Gefolgsstande Heerdienst<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_51.lnote.de.1"/> versäumt.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning someone of the retainer class neglecting military service.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="211" ed="#jurasinski-and-oliver"/>Concerning a nobly born man neglecting his fyrd-duty</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="211" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_51.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">24</biblScope></bibl><seg type="original" xml:lang="de">fyrd <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fyrd Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_51.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">De eo <hi rend="italic">fehlt Hk</hi>. De siðcundo <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">De eo lacking in Hk. De siðcundo Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_51.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">cyrliscus <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyrliscus Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_51.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">hostium <hi rend="italic">Dm</hi>; expeditionem regis <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">hostium Dm; expeditionem regis Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_51.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">-derit <hi rend="italic">Hk</hi>; -dente <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">-derit Hk; -dente Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_51.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> þam</seg><seg type="translation" xml:lang="en" source="#claude">altered þam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_51.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_51.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hostis</hi> Kriegszug mlat., <hi rend="italic">hosticum</hi> gallolat.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">hostis</hi> ‘military expedition’ in Med. Lat., <hi rend="italic">hosticum</hi> in Gallo-Latin</seg></note>
      </div>
