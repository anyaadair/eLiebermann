        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-1.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">42</biblScope></bibl><seg type="original" xml:lang="de">-dracan <hi rend="italic">So;</hi> -drecan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dracan So; -drecan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-1.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">42</biblScope></bibl><seg type="original" xml:lang="de">-ochia <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ochia So Ld</seg></note>
