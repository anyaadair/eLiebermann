    <body>
      <div type="clause" n="29">
        <head>Af Rb 29</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="29" corresp="#wit-e"><pb n="18" ed="#liebermann"/>XXIIII.<ptr type="liebermannNote" n="*" target="#Rubrics-Af_29.lnote.oe.star"/> Be twyhyndu<hi rend="italic">m<ptr type="liebermannNote" n="10" target="#Rubrics-Af_29.lnote.oe.10-2"/></hi> men æt hloþslyhte.<ptr type="liebermannNote" n="11" target="#Rubrics-Af_29.lnote.oe.11"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="29" corresp="#wit-ot-frag"><pb n="18" ed="#liebermann"/>… e twyhindum<ptr type="liebermannNote" n="2" target="#Rubrics-Af_29.lnote.oe.2"/> men æt hloð …</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="29" corresp="#wit-g-prol"><pb n="18" ed="#liebermann"/>XXIIII. Be twyhyndu<hi rend="italic">m</hi> men æt hloþslihte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="29" corresp="#wit-h"><pb n="19" ed="#liebermann"/>XXIII. Be twyhyndum<ptr type="liebermannNote" n="10" target="#Rubrics-Af_29.lnote.oe.10-3"/> men æt hloðslihte.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="29" corresp="#wit-q"><pb n="19" ed="#liebermann"/>De homine tƿyhindo<ptr type="liebermannNote" n="9" target="#Rubrics-Af_29.lnote.oe.9"/> (id est ducenteno) occiso a<ptr type="liebermannNote" n="10" target="#Rubrics-Af_29.lnote.oe.10"/> hloþ (id est á cohorte).</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="192" ed="#jurasinski-and-oliver"/>XXIII Be ceorles mennenes niedhæmede</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="192" ed="#jurasinski-and-oliver"/>Be ceorles me<hi rend="italic">n</hi>nenes nydhemede</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="19" ed="#liebermann"/>Über jemanden von 200 [Schilling<ptr type="liebermannNote" n="1" target="#Rubrics-Af_29.lnote.de.1"/> Wergeld] bei [seiner] Erschlagung durch Bande;</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning someone of 200 [shillings’ wergeld] at [his] slaying by a band;</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="193" ed="#jurasinski-and-oliver"/>Concerning the rape of a <hi rend="italic">ceorl</hi>’s female slave</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="193" ed="#jurasinski-and-oliver"/></ab>
        <note type="editorial">H’s rubric XXIII belongs to Af 29 (Liebermann’s margin [29]).</note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_29.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. von anderer Hd.</hi> twyhyn.</seg><seg type="translation" xml:lang="en" source="#claude">altered by another hand twyhyn.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_29.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">tƿih. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">tƿih. T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_29.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de">a — coh. <hi rend="italic">fehlt Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">a — coh. lacking in Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_29.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de">[29—31] Be mansliht mid hloþe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">[29—31] Be mansliht mid hloþe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_29.lnote.oe.10-2" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de">-hin- <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">-hin- So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_29.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">18</biblScope></bibl><seg type="original" xml:lang="de">hloðes. <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">hloðes. So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Af_29.lnote.oe.10-3" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">19</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">beide</hi> y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">both y’s on an erasure</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Af_29.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">41</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Die Erkl. des Quadr zu Rb 31 entstammt vielleicht Wer 1. Dass der alte Schilling nur 5 Pf. umfasste, bemerkt Q mehrfach. Zur Identifikation von <hi rend="italic">12hynde</hi> und <hi rend="italic">nobilis vgl. Gl</hi> Wergeld 4ff., Stand 11, Thegn 13a</seg><seg type="translation" xml:lang="en" source="#claude">Quadr’s explanation on Rb 31 perhaps derives from Wer 1. That the old shilling comprised only 5 pence Q notes more than once. On the identification of <hi rend="italic">12hynde</hi> and <hi rend="italic">nobilis cf. Gl</hi> Wergeld 4ff., Stand 11, Thegn 13a</seg></note>
      </div>
    </body>
