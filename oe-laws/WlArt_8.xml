    <body>
      <div type="clause" n="8">
        <head><ref type="lawCode" target="law:WlArt">Wl art</ref> 8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-h"><pb n="488" ed="#liebermann"/>Omnis homo qui uoluerit<ptr type="liebermannNote" n="10" target="#WlArt_8.lnote.oe.10"/> se<ptr type="liebermannNote" n="11" target="#WlArt_8.lnote.oe.11"/> tenere<ptr type="liebermannNote" n="12" target="#WlArt_8.lnote.oe.12"/> pro libero sit in plegio<ptr type="liebermannNote" n="b" target="#WlArt_8.lnote.oe.b"/>, ut plegius<ptr type="liebermannNote" n="b" target="#WlArt_8.lnote.oe.b"/> teneat<ptr type="liebermannNote" n="13" target="#WlArt_8.lnote.oe.13"/> et habeat<ptr type="liebermannNote" n="14" target="#WlArt_8.lnote.oe.14"/> illum<ptr type="liebermannNote" n="15" target="#WlArt_8.lnote.oe.15"/> ad iusticiam, si quid offenderit;</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="8" corresp="#wit-h"><pb n="240" ed="#robertson"/>Omnis homo, qui voluerit se teneri pro libero, sit in plegio, ut plegius teneat et habeat illum ad iusticiam si quid offenderit;</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-h"><pb n="241" ed="#robertson"/>Everyone who desires to keep the status of a freeman shall be in a frankpledge, so that the frankpledge may bring him to justice, if he has committed an offence.</ab>
        <note type="comparison" source="#liebermann" n="488">Inst Cn II 2[?]</note>
        <note type="comparisonPrinted" source="#liebermann">Inst. Cn. II 2[?]</note>
        <note type="comparisonIncomplete">Some of Liebermann’s notes here are cut off in the gutter of the scan used, and are still to be completed.</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_3">Leis Wl 3</ref>; <ref target="clause:LeisWl_20-3a">Leis Wl 20.3a</ref>; <ref target="clause:LeisWl_25">Leis Wl 25</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="409"><ref target="clause:LeisWl_20-3a">Leis Wl 20.3a</ref></note>
        <note type="editorial">Added October 2026 from Robertson pp. 240–241 (text and translation); Liebermann’s text added from Gesetze I p. 488, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier</hi> Freibürgschaftsverband, Zehntschaft; <hi rend="italic">vgl. Liebermann</hi> Über Leg. Ed. Conf. 81 <hi rend="italic">ff.</hi></seg><seg type="translation" xml:lang="en" source="#claude">here the frankpledge association, tithing; cf. Liebermann Über Leg. Ed. Conf. 81 ff.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">se tenuerit <hi rend="italic">statt</hi> uol. se t. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">se tenuerit instead of uol. se t. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ra</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Ra</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">-ri <hi rend="italic">H Rl Ra Vi Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ri H Rl Ra Vi Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">t. et <hi rend="italic">fehlt Cb Hv Cu Retr Ra Vi Va Ph Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">t. et omitted in Cb Hv Cu Retr Ra Vi Va Ph Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">eum h. <hi rend="italic">Hv Retr</hi></seg><seg type="translation" xml:lang="en" source="#claude">eum h. Hv Retr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">eum <hi rend="italic">Cb Hv Va Ph Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">eum Cb Hv Va Ph Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">281</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Zehnerschaft 10d. 17. Dass Wilhelm I. hierüber ein Gesetz gab, ist an sich wahrscheinlich und wird auch in Leis Wl 25 behauptet</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Zehnerschaft 10d. 17. That William I issued a law on this matter is probable in itself, and is also asserted in Leis Wl 25</seg></note>
      </div>
