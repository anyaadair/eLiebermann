        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">44</biblScope></bibl><seg type="original" xml:lang="de">Bern. <hi rend="italic">So;</hi> Bernaba <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Bern. So; Bernaba Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">44</biblScope></bibl><seg type="original" xml:lang="de">heora <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">heora So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">44</biblScope></bibl><seg type="original" xml:lang="de">syl. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">syl. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">44</biblScope></bibl><seg type="original" xml:lang="de">Drih. <hi rend="italic">So;</hi> dryhtenes <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Drih. So; dryhtenes Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">43</biblScope></bibl><seg type="original" xml:lang="de">d <hi rend="italic">übergeschr.,</hi> o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">d written above, o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">43</biblScope></bibl><seg type="original" xml:lang="de">ra <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">ra on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">43</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">45</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">45</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. aus</hi> forwyrdon</seg><seg type="translation" xml:lang="en" source="#claude">altered from forwyrdon</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">45</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> gesamnoden</seg><seg type="translation" xml:lang="en" source="#claude">altered to gesamnoden</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">45</biblScope></bibl><seg type="original" xml:lang="de">þa <hi rend="italic">über der Linie zugefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">þa added above the line</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">45</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">followed by an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.7-2" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">45</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">45</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">43</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Wo Quadr. mehr Matthaeus und den Actus als Af folgt, setze ich</hi> {m} <hi rend="italic">und</hi> {a}.</seg><seg type="translation" xml:lang="en" source="#claude">Where Quadr. follows Matthew and the Acts more closely than it follows Af, I put {m} and {a}.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">43</biblScope></bibl><seg type="original" xml:lang="de">Cyl. <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cyl. Dm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">43</biblScope></bibl><seg type="original" xml:lang="de">ex g. <hi rend="italic">fehlt T</hi></seg><seg type="translation" xml:lang="en" source="#claude">ex g. missing in T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">43</biblScope></bibl><seg type="original" xml:lang="de">scitis enim aduenarum animas <hi rend="italic">fügt Vulg. zu</hi></seg><seg type="translation" xml:lang="en" source="#claude">scitis enim aduenarum animas added by Vulg.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">43</biblScope></bibl><seg type="original" xml:lang="de">Egipti <hi rend="italic">R. Es folgt Ex.</hi> 23,10<hi rend="italic">ff. in Vulg.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Egipti R. Ex. 23,10ff. follows in Vulg.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_El-to-49-3.lnote.oe.2-4" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">42</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">mod. Hd. verb. in</hi> wysc.</seg><seg type="translation" xml:lang="en" source="#claude">corrected by a modern hand to wysc.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-49-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">48</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Quadr folgt im ganzen mehr der Vulg., aber in <hi rend="italic">cupiunt</hi> zu Ende doch Af</seg><seg type="translation" xml:lang="en" source="#claude">Quadr on the whole follows the Vulg. more closely, but in <hi rend="italic">cupiunt</hi> at the end it follows Af after all</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-49-3.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">48</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘Gebrüder’ So Ld, auch sonst im geistigen Sinne</seg><seg type="translation" xml:lang="en" source="#claude">‘brethren’ so Ld; also elsewhere in the spiritual sense</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-49-3.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">48</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Inhaltliche Abweichungen von Vulg. drucke ich <hi rend="bold">fett</hi>, stilistische <hi rend="spaced">gesperrt</hi>. — Hier führt Af aus Agsächs. Urkundenwesen den Briefanfang ein</seg><seg type="translation" xml:lang="en" source="#claude">Departures in content from the Vulg. I print in <hi rend="bold">bold</hi>, stylistic ones <hi rend="italic">letter-spaced</hi>. — Here Af introduces the opening formula of the letter from Anglo-Saxon diplomatic practice</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-49-3.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">48</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Über <hi rend="italic">sume</hi> appositiv in Mehrzahl <hi rend="italic">vgl.</hi> Wülfing <hi rend="italic">Syntax</hi> I 434</seg><seg type="translation" xml:lang="en" source="#claude">On <hi rend="italic">sume</hi> used appositively in the plural <hi rend="italic">cf.</hi> Wülfing <hi rend="italic">Syntax</hi> I 434</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-49-3.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">48</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">‘strengeres Gesetz’ Schmid, eher ‘Sittenordnung’. Af verdeutlicht Paulus’ Gegensatz zu den Zeremonienanhängern. Die Worte Fulcos (<hi rend="italic">s. o.</hi> Einl. 24): <hi rend="italic">noluerunt graviori iugo nisi ut praeciperent</hi> scheinen anzuklingen an <hi rend="italic">hefigran wisan budon . . . byrðenne noldon ofer þæt</hi> El 49, 3; 5</seg><seg type="translation" xml:lang="en" source="#claude">‘stricter law’ Schmid; rather ‘rule of conduct’. Af brings out more clearly Paul’s opposition to the adherents of ceremonial. The words of Fulco (<hi rend="italic">see above</hi> Introduction 24): <hi rend="italic">noluerunt graviori iugo nisi ut praeciperent</hi> seem to echo <hi rend="italic">hefigran wisan budon . . . byrðenne noldon ofer þæt</hi> El 49, 3; 5</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-49-3.lnote.de.6" n="6" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">48</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Af lässt die anderen Gesandten fort</seg><seg type="translation" xml:lang="en" source="#claude">Af omits the other envoys</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_El-to-49-3.lnote.de.7" n="7" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">48</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Af nahm wohl <hi rend="italic">animam tradere</hi> der Vulg. für ‘sterben’ und führt daher, in Erinnerung an Pauli Martyrium, Zukunft statt Vergangenheit ein, hierin von Q befolgt; ‘wollen’ G</seg><seg type="translation" xml:lang="en" source="#claude">Af probably took the Vulg.’s <hi rend="italic">animam tradere</hi> as ‘to die’ and therefore, recalling Paul’s martyrdom, introduces the future instead of the past, in which Q follows him; ‘wish to’ G</seg></note>
