      <div type="clause" n="23">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 23</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 23" corresp="#wit-lat"><ptr type="liebermannNote" n="49" target="#IudDeiI_23.lnote.oe.49"/><pb n="405" ed="#liebermann"/>Post<ptr type="liebermannNote" n="50" target="#IudDeiI_23.lnote.oe.50"/> has autem coniurationes aquae exuantur<ptr type="liebermannNote" n="51" target="#IudDeiI_23.lnote.oe.51"/> homines, qui mittendi<ptr type="liebermannNote" n="52" target="#IudDeiI_23.lnote.oe.52"/> sunt in aquam, propriis uestimentis, et osculentur<ptr type="liebermannNote" n="53" target="#IudDeiI_23.lnote.oe.53"/> singuli<ptr type="liebermannNote" n="54" target="#IudDeiI_23.lnote.oe.54"/> euangelium et<ptr type="liebermannNote" n="c" target="#IudDeiI_23.lnote.oe.c"/> crucem Christi, et aqua benedicta super omnes<ptr type="liebermannNote" n="55" target="#IudDeiI_23.lnote.oe.55"/> aspergatur.<ptr type="liebermannNote" n="d" target="#IudDeiI_23.lnote.oe.d"/></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 405 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_23.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">⁊ rod Cristes ⁊ ƿat̃ (<hi rend="italic">bessere</hi> wæter) gebletsod <hi rend="italic">übergeschr. in anderer Tinte Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">⁊ rod Cristes ⁊ ƿat̃ (read wæter) gebletsod written above in different ink Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_23.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> II As 23, 2; Ordal 4, 1.</seg><seg type="translation" xml:lang="en" source="#claude">cf. II As 23, 2; Ordal 4, 1.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_23.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">c.</hi> 23 <hi rend="italic">fehlt Co; steht Zeu.</hi> 620. 621. 622. 623. 627. 638. 641. 644. 649. 652. 654. 655. 663. 667. 670. 690. 692</seg><seg type="translation" xml:lang="en" source="#claude">c. 23 omitted in Co; found in Zeu. 620. 621. 622. 623. 627. 638. 641. 644. 649. 652. 654. 655. 663. 667. 670. 690. 692</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_23.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">Per <hi rend="italic">Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">Per Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_23.lnote.oe.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">h. e. <hi rend="italic">Ca; übergeschr.</hi> -atur homo <hi rend="italic">Ci H</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. e. Ca; -atur homo written above Ci H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_23.lnote.oe.52" n="52" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">-us est <hi rend="italic">übergeschr. Ci H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-us est written above Ci H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_23.lnote.oe.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi> -etur <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-etur written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_23.lnote.oe.54" n="54" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Rj Vt Ci H</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Rj Vt Ci H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_23.lnote.oe.55" n="55" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">eum <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">eum written above H</seg></note>
      </div>
