      <div type="clause" n="5.30">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.30</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.30" corresp="#wit-lat"><pb n="551" ed="#liebermann"/>Qui<ptr type="liebermannNote" n="s" target="#Hn_5-30.lnote.oe.s"/> exigit iurationem, multum interest, si scit<ptr type="liebermannNote" n="38" target="#Hn_5-30.lnote.oe.38"/> illum<ptr type="liebermannNote" n="39" target="#Hn_5-30.lnote.oe.39"/> falsum iuraturum, uel nescit: si<ptr type="liebermannNote" n="40" target="#Hn_5-30.lnote.oe.40"/> nescit, et dicit ‘Iura mihi (iura<ptr type="liebermannNote" n="u" target="#Hn_5-30.lnote.oe.u"/> mihi), ut fides stet!’ non audeo dicere, [hoc<ptr type="liebermannNote" n="41" target="#Hn_5-30.lnote.oe.41"/>] esse<ptr type="liebermannNote" n="42" target="#Hn_5-30.lnote.oe.42"/> peccatum; tamen humana temptatio est. Si nouit<ptr type="liebermannNote" n="t" target="#Hn_5-30.lnote.oe.t"/> fecisse et cogit iurare, homicida est.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 551 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-30.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch Ivo</hi> Decr. XII 30; <hi rend="italic">Gr.</hi> C. 22 q. 5 c. 6</seg><seg type="translation" xml:lang="en" source="#claude">also Ivo Decr. XII 30; Gr. C. 22 q. 5 c. 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-30.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Gratian</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Gratian</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-30.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zweites</hi> i. m. <hi rend="italic">fehlt Lond, Ivo, Augustin</hi> Sermo 180, <hi rend="italic">c.</hi> 10</seg><seg type="translation" xml:lang="en" source="#claude">second i. m. lacking in Lond, Ivo, Augustine Sermo 180, c. 10</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-30.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">sit <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sit Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-30.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">multum f. i. [illud <hi rend="italic">Co Or</hi>] iuratum <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">multum f. i. [illud Co Or] iuratum Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-30.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">siue scit <hi rend="italic">Hss.; gebessert Somner</hi></seg><seg type="translation" xml:lang="en" source="#claude">siue scit MSS; corrected by Somner</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-30.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">non <hi rend="italic">Hss.</hi> [<hi rend="italic">verkehrt</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">non MSS [wrong]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-30.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">551</biblScope></bibl><seg type="original" xml:lang="de">est <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">est Lond</seg></note>
