      <div type="clause" n="19.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 19.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 19.1" corresp="#wit-lat"><pb n="559" ed="#liebermann"/>Hec<ptr type="liebermannNote" n="p" target="#Hn_19-1.lnote.oe.p"/> sunt que<ptr type="liebermannNote" n="17" target="#Hn_19-1.lnote.oe.17"/> ad iusticiam uel indulgenciam<ptr type="liebermannNote" n="q" target="#Hn_19-1.lnote.oe.q"/> regis et fiscum proprie<ptr type="liebermannNote" n="56" target="#Hn_19-1.lnote.oe.56"/> censentur cum apendenciis<ptr type="liebermannNote" n="57" target="#Hn_19-1.lnote.oe.57"/> suis — nec sine<ptr type="liebermannNote" n="r" target="#Hn_19-1.lnote.oe.r"/> diffinitis prelocucionibus pertinent<ptr type="liebermannNote" n="58" target="#Hn_19-1.lnote.oe.58"/> uicecomitibus uel prepositis eius in firma sua —, ubicunque, a quocunque, in quemcunque fiant, siue terra dominica<ptr type="liebermannNote" n="s" target="#Hn_19-1.lnote.oe.s"/> regis et socna<ptr type="liebermannNote" n="59" target="#Hn_19-1.lnote.oe.59"/> sit, siue sit alterius.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 559 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_19-1.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">‘Obiges’, d. h. C.</hi> 10. 11, 16<hi rend="italic">a</hi>. 12—17</seg><seg type="translation" xml:lang="en" source="#claude">‘the foregoing’, i.e. C. 10. 11, 16<hi rend="italic">a</hi>. 12—17</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_19-1.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">= misericordiam 13, 1; ueniam 11, 16<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">= misericordiam 13, 1; ueniam 11, 16<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_19-1.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ebenso</hi> 10, 4</seg><seg type="translation" xml:lang="en" source="#claude">likewise 10, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_19-1.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">unausgeliehen</seg><seg type="translation" xml:lang="en" source="#claude">not granted out</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_19-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_19-1.lnote.oe.56" n="56" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_19-1.lnote.oe.57" n="57" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">appendiciis <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">appendiciis Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_19-1.lnote.oe.58" n="58" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">-net <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-net Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_19-1.lnote.oe.59" n="59" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">559</biblScope></bibl><seg type="original" xml:lang="de">sokn. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sokn. Lond</seg></note>
