        <note type="liebermannNote" subtype="textual" xml:id="IICn_75-1.lnote.oe.9-2" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">363</biblScope></bibl><seg type="original" xml:lang="de">fuit <hi rend="italic">K</hi>; nec consilio <hi rend="italic">fügt zu Hn</hi></seg><seg type="translation" xml:lang="en" source="#claude">fuit K; nec consilio added by Hn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_75-1.lnote.oe.10-2" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">363</biblScope></bibl><seg type="original" xml:lang="de">inde habuerit <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">inde habuerit Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_75-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">362</biblScope></bibl><seg type="original" xml:lang="de">-pen a., gel. hine <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-pen a., gel. hine Ld</seg></note>
