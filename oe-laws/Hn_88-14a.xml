        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 88.14a" corresp="#wit-lat"><pb n="604" ed="#liebermann"/>Et nulli liceat forismittere<ptr type="liebermannNote" n="e" target="#Hn_88-14a.lnote.oe.e"/><ptr type="liebermannNote" n="28" target="#Hn_88-14a.lnote.oe.28"/> hereditatem suam de parentela sua dacione uel uendicione, sicut<ptr type="liebermannNote" n="f" target="#Hn_88-14a.lnote.oe.f"/> diximus, maxime si<ptr type="liebermannNote" n="g" target="#Hn_88-14a.lnote.oe.g"/> contradicat et peccuniam suam uelit in ea<ptr type="liebermannNote" n="29" target="#Hn_88-14a.lnote.oe.29"/> mittere.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 604 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-14a.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. inhaltlich Af</hi> 41</seg><seg type="translation" xml:lang="en" source="#claude">cf., for the content, Af 41</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-14a.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">70, 21<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">70, 21<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-14a.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">parentela <hi rend="italic">ergänzt Wi Tho unnöthig</hi></seg><seg type="translation" xml:lang="en" source="#claude">Wi Tho supply parentela, unnecessarily</seg></note>
