      <div type="clause" n="43.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 43.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 43.3" corresp="#wit-lat"><pb n="569" ed="#liebermann"/>Qui<ptr type="liebermannNote" n="e" target="#Hn_43-3.lnote.oe.e"/> sibi<ptr type="liebermannNote" n="17" target="#Hn_43-3.lnote.oe.17"/> facit aduocatum<ptr type="liebermannNote" n="g" target="#Hn_43-3.lnote.oe.g"/> contra dominum suum per superbiam, perdat quod de eo tenet.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 569 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-3.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ein Villan, nicht, wie in</hi> 55, 3<hi rend="italic">b</hi>, <hi rend="italic">ein vollfreier Lehnsmann</hi></seg><seg type="translation" xml:lang="en" source="#claude">a villein, not, as in 55, 3b, a fully free vassal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-3.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">sich einen gerichtlichen Beschützer [<hi rend="italic">Domesday</hi> I 216<hi rend="italic">b</hi>&lt;sup&gt;1&lt;/sup&gt;] wählt; <hi rend="italic">vgl.</hi> Leis Wl 30</seg><seg type="translation" xml:lang="en" source="#claude">chooses himself a protector in court [Domesday I 216b&lt;sup&gt;1&lt;/sup&gt;]; cf. Leis Wl 30</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-3.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">g&lt;sup&gt;i&lt;/sup&gt; <hi rend="italic">K;</hi> igitur <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">g&lt;sup&gt;i&lt;/sup&gt; K; igitur Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-3.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Schutz 21; Lehnwesen 15b; Vassallität 16b</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Schutz 21; Lehnwesen 15b; Vassallität 16b</seg></note>
