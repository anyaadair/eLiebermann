      <div type="clause" n="3.2">
        <head><ref type="lawCode" target="law:IudDeiIII">Iud Dei III</ref> 3.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei III 3.2" corresp="#wit-lat"><pb n="409" ed="#liebermann"/>quatinus innocens<ptr type="liebermannNote" n="9" target="#IudDeiIII_3-2.lnote.oe.9"/> sine ulla difficultate hoc pabulum probationis deglutiat<ptr type="liebermannNote" n="10" target="#IudDeiIII_3-2.lnote.oe.10"/>, obnoxius autem, obtrepidante mentis statu et totius conpagine corporis uacillante, quod<ptr type="liebermannNote" n="11" target="#IudDeiIII_3-2.lnote.oe.11"/> in tuo sancto nomine<ptr type="liebermannNote" n="12" target="#IudDeiIII_3-2.lnote.oe.12"/> consecratur et benedicitur<ptr type="liebermannNote" n="12" target="#IudDeiIII_3-2.lnote.oe.12"/>, nullatenus deuorandi ualetudinem<ptr type="liebermannNote" n="13" target="#IudDeiIII_3-2.lnote.oe.13"/> percipiat<ptr type="liebermannNote" n="14" target="#IudDeiIII_3-2.lnote.oe.14"/>, sed coram omnibus inualitudine confusus<ptr type="liebermannNote" n="15" target="#IudDeiIII_3-2.lnote.oe.15"/>, quod praesumptione inmerita suscepit<ptr type="liebermannNote" n="16" target="#IudDeiIII_3-2.lnote.oe.16"/>, cum irrisione proiciat<ptr type="liebermannNote" n="14" target="#IudDeiIII_3-2.lnote.oe.14"/>. Per dominum<ptr type="liebermannNote" n="17" target="#IudDeiIII_3-2.lnote.oe.17"/> nostrum<ptr type="liebermannNote" n="18" target="#IudDeiIII_3-2.lnote.oe.18"/> Iesum Christum.<ptr type="liebermannNote" n="19" target="#IudDeiIII_3-2.lnote.oe.19"/></ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 409 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_3-2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">-ntes <hi rend="italic">Pt; übergeschr.</hi> -ntes <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ntes Pt; -ntes written above in H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_3-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">dig. <hi rend="italic">Ps;</hi> -ant, obnoxii <hi rend="italic">u. ferner Plural Pt;</hi> -n -i <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">dig. Ps; -ant, obnoxii and the plural thereafter Pt; -n -i written above in H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_3-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">quam <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">quam Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_3-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">+ <hi rend="italic">roth H</hi></seg><seg type="translation" xml:lang="en" source="#claude">+ in red H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_3-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">ualit. <hi rend="italic">Ch Ca H</hi></seg><seg type="translation" xml:lang="en" source="#claude">ualit. Ch Ca H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_3-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">-n- <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-n- written above in H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_3-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">-i <hi rend="italic">übergeschr. Rj H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-i written above in Rj H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_3-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">-erunt <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-erunt written above in H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_3-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">d. n. I. C. <hi rend="italic">fehlt Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. n. I. C. omitted in Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_3-2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">n. I. Ch. <hi rend="italic">fehlt Ps</hi></seg><seg type="translation" xml:lang="en" source="#claude">n. I. Ch. omitted in Ps</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_3-2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">409</biblScope></bibl><seg type="original" xml:lang="de">filium <hi rend="italic">fügt zu Rj; folgen leere Zeilen H; folgt Segen zum Weihwasser Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">filium added in Rj; blank lines follow in H; a blessing for holy water follows in Ch</seg></note>
      </div>
