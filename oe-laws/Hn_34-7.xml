      <div type="clause" n="34.7">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 34.7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 34.7" corresp="#wit-lat"><pb n="566" ed="#liebermann"/>Qui aliquem erga iusticiam<ptr type="liebermannNote" n="c" target="#Hn_34-7.lnote.oe.c"/> accusabit — et presertim in quibus conuictus uite iacturam uel honoris detrimentum pateretur —, et mendacium denique pernoscatur, linguam<ptr type="liebermannNote" n="f" target="#Hn_34-7.lnote.oe.f"/> perdat uel wera<ptr type="liebermannNote" n="7" target="#Hn_34-7.lnote.oe.7"/> sua redimat.</ab>
        <note type="comparison" source="#wormald-mel" n="314"><label>makes the same point</label> <ref target="clause:IIIEg_4">III Eg 4</ref> <quote>when in Hn 34:7 the same translator ... made the same point, he wrote 'vita vel honoris'</quote></note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 566 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-7.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">Gerichtshalter, <hi rend="italic">zunächst</hi> Königsbeamter</seg><seg type="translation" xml:lang="en" source="#claude">holder of the court, <hi rend="italic">in the first place</hi> a royal official</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-7.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 59, 13</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 59, 13</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-7.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">werra <hi rend="italic">Sc öfter</hi></seg><seg type="translation" xml:lang="en" source="#claude">werra <hi rend="italic">Sc frequently</hi></seg></note>
      </div>
