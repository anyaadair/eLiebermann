    <body>
      <div type="clause" n="24.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 24.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 24.1" corresp="#wit-lat"><pb n="561" ed="#liebermann"/>Super barones socnam<ptr type="liebermannNote" n="45" target="#Hn_24-1.lnote.oe.45"/> suam habentes habet iudex fiscalis<ptr type="liebermannNote" n="46" target="#Hn_24-1.lnote.oe.46"/> iusticie legis obseruanciam, et<ptr type="liebermannNote" n="47" target="#Hn_24-1.lnote.oe.47"/> quicquid peccabitur in eorum personam; nemo<ptr type="liebermannNote" n="r" target="#Hn_24-1.lnote.oe.r"/> enim<ptr type="liebermannNote" n="37" target="#Hn_24-1.lnote.oe.37"/> forisfacturam sui ipsius habuerit<ptr type="liebermannNote" n="48" target="#Hn_24-1.lnote.oe.48"/>, set fortasse dominus eius.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 561 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_24-1.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">561</biblScope></bibl><seg type="original" xml:lang="de">keiner [<hi rend="italic">obwohl Jurisdictionsbesitzer</hi>] besitzt Gericht sammt Strafgeld (<hi rend="italic">auch nicht</hi> ouerseunessam 36, 1) für Vergehen gegen seine eigene Person, sondern die Instanz <hi rend="spaced">über</hi> ihm</seg><seg type="translation" xml:lang="en" source="#claude">none [although holding jurisdiction] has the court together with the fine (not even ouerseunessam 36, 1) for offences against his own person; rather, the instance <hi rend="italic">above</hi> him has it</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_24-1.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">561</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_24-1.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">561</biblScope></bibl><seg type="original" xml:lang="de">socham <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">socham Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_24-1.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">561</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">gebessert vom Corr. aus</hi> fissc. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the corrector from fissc. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_24-1.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">561</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">besser zu streichen;</hi> et si quid <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">better deleted; et si quid Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_24-1.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">561</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Co Or;</hi> habuit <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Co Or; habuit the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_24-1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. o</hi>. 20, 3; <hi rend="italic">fortasse</hi>: ‘eventuell’—<hi rend="italic">fischalis</hi>{46}—<hi rend="italic">et</hi>{47} <hi rend="italic">si quid p</hi>.—<hi rend="italic">n</hi>.{37} <hi rend="italic">f</hi>. ohne <hi rend="italic">enim</hi>—<hi rend="italic">habuit</hi>{48} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. above</hi> 20, 3; <hi rend="italic">fortasse</hi>: ‘possibly’—<hi rend="italic">fischalis</hi>{46}—<hi rend="italic">et</hi>{47} <hi rend="italic">si quid p</hi>.—<hi rend="italic">n</hi>.{37} <hi rend="italic">f</hi>. without <hi rend="italic">enim</hi>—<hi rend="italic">habuit</hi>{48} Rs</seg></note>
      </div>
