    <body>
      <div type="clause" n="20.5">
        <head><ref type="lawCode" target="law:IIAs">II As</ref> 20.5</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="20.5" corresp="#wit-h"><pb n="160" ed="#liebermann"/>Gif he nite, hwa hine aborgie, hæfton hine.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="20.5" corresp="#wit-ld"><pb n="160" ed="#liebermann"/>Gif he nyt<ptr type="liebermannNote" n="1" target="#IIAs_20-5.lnote.oe.1"/>, hwa hine aborgige, hæften hine.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="20.5" corresp="#wit-ot"><pb n="160" ed="#liebermann"/>Gif he …, hwa hine aborgige, hæften hine.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="20.5" corresp="#wit-q"><pb n="161" ed="#liebermann"/>Si plegium non habeat, ipse<ptr type="liebermannNote" n="43" target="#IIAs_20-5.lnote.oe.43"/> capiatur.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="20.5" corresp="#wit-h"><pb n="138" ed="#attenborough"/>Gif he nite<ptr type="editorNote" n="2" target="#IIAs_20-5.attnote.fn.2"/>, hwa hine aborgie, hæfton hine.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="161" ed="#liebermann"/>Wenn er niemanden weiss, wer ihn verbürge, sollen sie ihn verhaften.<ptr type="liebermannNote" n="1" target="#IIAs_20-5.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he knows of no one who will stand surety for him, they are to arrest him.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="139" ed="#attenborough"/>And if he knows no one who will act as surety for him, they shall arrest him.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="422" ed="#whitelock"/>If he knows no one to stand surety for him, they are to take him prisoner.</ab>
        <note type="comparison" source="#liebermann" n="161"><ref target="clause:IIEw_3-1">II Ew 3.1f.</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. II Ew. 3, 1 f.</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IIIEg_7-1">III Eg 7.1</ref></note>
        <note type="editorial">Liebermann compares II Ew 3.1 f.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_20-5.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">160</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_20-5.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">161</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> idem <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Lond; idem the others</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_20-5.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">106</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Gefängnis 6 b</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Gefängnis 6 b</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_20-5.attnote.fn.2" n="2" source="#attenborough"><bibl><biblScope unit="page">138</biblScope></bibl><label>nite</label><seg type="original" xml:lang="en"><hi rend="italic">nyt</hi>. Ld.</seg></note>
      </div>
