    <body>
      <div type="clause" n="31">
        <head>Ine Rb 31</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="31" corresp="#wit-e"><pb n="22" ed="#liebermann"/>LXXV. Be ðon þe mon wíf byccge<ptr type="liebermannNote" n="9" target="#Rubrics-Ine_31.lnote.oe.9"/>, ⁊ þon<hi rend="italic">ne</hi> sio gift tostande.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="31" corresp="#wit-g-prol"><pb n="22" ed="#liebermann"/>LXXV. Be þan ðe m<hi rend="italic">an<ptr type="liebermannNote" n="3" target="#Rubrics-Ine_31.lnote.oe.3"/></hi> wif bicge, ⁊ ðonne seo gyft tostande.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="31" corresp="#wit-h"><pb n="23" ed="#liebermann"/>LXXV. Be þo<hi rend="italic">n<ptr type="liebermannNote" n="16" target="#Rubrics-Ine_31.lnote.oe.16"/></hi> ðe mon<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_31.lnote.oe.2"/> wif bycge, ⁊ ðonne sio<ptr type="liebermannNote" n="17" target="#Rubrics-Ine_31.lnote.oe.17"/> gift tostonde.<ptr type="liebermannNote" n="18" target="#Rubrics-Ine_31.lnote.oe.18"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="31" corresp="#wit-q"><pb n="23" ed="#liebermann"/>Si<ptr type="liebermannNote" n="19" target="#Rubrics-Ine_31.lnote.oe.19"/> quis feminam emat et pretium retineat.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="206" ed="#jurasinski-and-oliver"/>LXXV Be ðon þe mon wíf bycgge, þon<hi rend="italic">ne</hi> sio gift tostande.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="206" ed="#jurasinski-and-oliver"/>Be þa<hi rend="italic">m</hi> þe man wif bycge, seo gift wiðstande</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="23" ed="#liebermann"/>Darüber, dass jemand eine Frau [zur Ehe] kauft, und nachher die Trauung<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_31.lnote.de.1"/> unterbleibt.<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_31.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning someone buying a woman [in marriage], and the marriage afterwards not taking place.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="207" ed="#jurasinski-and-oliver"/>Concerning if a man makes a contract for a wife, and then the gift [marriage] is not forthcoming</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="207" ed="#jurasinski-and-oliver"/>Concerning he who makes a contract for a wife, and the gift [marriage] is withheld</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_31.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de">ñ</seg><seg type="translation" xml:lang="en" source="#claude">ñ</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_31.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de">bicge <hi rend="italic">ohne</hi> ⁊ — tostande <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">bicge without ⁊ — tostande Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_31.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">De emente f. et pr. retinente <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">De emente f. et pr. retinente Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_31.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.; geänd.</hi> þam</seg><seg type="translation" xml:lang="en" source="#claude">written above; altered þam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_31.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_31.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> seo</seg><seg type="translation" xml:lang="en" source="#claude">altered seo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_31.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> -stande</seg><seg type="translation" xml:lang="en" source="#claude">altered -stande</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_31.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘Brautkaufpreis vorenthält’ missversteht Q, für <hi rend="italic">gift</hi> (wie Schmid und Toller) falsche Bedeutung wählend</seg><seg type="translation" xml:lang="en" source="#claude">Q misunderstands this as ‘withholds the bride-price’, choosing a wrong meaning for <hi rend="italic">gift</hi> (as do Schmid and Toller)</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_31.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">tostandan</hi> kann laut <hi rend="italic">sio</hi> nicht transitiv gebraucht sein; es glossiert <hi rend="italic">distare</hi>, <hi rend="italic">morari</hi> und ‘fehlen’ wie ahd. <hi rend="italic">zestan</hi>, ndd. <hi rend="italic">tostan</hi>, nhd. <hi rend="italic">anstehn</hi></seg><seg type="translation" xml:lang="en" source="#claude">In view of <hi rend="italic">sio</hi>, <hi rend="italic">tostandan</hi> cannot be used transitively; it glosses <hi rend="italic">distare</hi>, <hi rend="italic">morari</hi> and ‘to be lacking’, like OHG <hi rend="italic">zestan</hi>, LG <hi rend="italic">tostan</hi>, NHG <hi rend="italic">anstehn</hi></seg></note>
      </div>
    </body>
  </text>
