        <head><ref type="lawCode" target="law:Hn">Hn</ref> 86</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 86" corresp="#wit-lat"><ptr type="liebermannNote" n="5" target="#Hn_86.lnote.oe.5"/><pb n="601" ed="#liebermann"/>Ne<ptr type="liebermannNote" n="6" target="#Hn_86.lnote.oe.6"/> quis se<ptr type="liebermannNote" n="7" target="#Hn_86.lnote.oe.7"/> uindicet<ptr type="liebermannNote" n="c" target="#Hn_86.lnote.oe.c"/> de suo<ptr type="liebermannNote" n="8" target="#Hn_86.lnote.oe.8"/> homine sine lege.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 601 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_86.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">Selbsthilfe übe gegen seinen Mann ohne Gericht</seg><seg type="translation" xml:lang="en" source="#claude">take the law into his own hands against his man without going to court</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_86.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">C. 85 <hi rend="italic">K; am Rande</hi> 85 <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">C. 85 K; in the margin 85 Co</seg></note>
