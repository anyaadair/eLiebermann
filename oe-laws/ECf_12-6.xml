  <text>
    <body>
      <div type="clause" n="12.6">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 12.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 12.6"><pb n="638" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_12-6.lnote.oe.erkl-clause"/>Emendationem faciat<ptr type="liebermannNote" n="37" target="#ECf_12-6.lnote.la.37"/> parentibus uel<ptr type="liebermannNote" n="38" target="#ECf_12-6.lnote.la.38"/> werram<ptr type="liebermannNote" n="39" target="#ECf_12-6.lnote.la.39"/> patiatur<ptr type="liebermannNote" n="40" target="#ECf_12-6.lnote.la.40"/>, unde Angli prouerbium habebant: ‘Bugge<ptr type="liebermannNote" n="41" target="#ECf_12-6.lnote.la.41"/> <pb n="639" ed="#liebermann"/>spere of<ptr type="liebermannNote" n="a" target="#ECf_12-6.lnote.la.fn.a"/> side<ptr type="liebermannNote" n="1" target="#ECf_12-6.lnote.la.1"/> othe<ptr type="liebermannNote" n="b" target="#ECf_12-6.lnote.la.fn.b"/><ptr type="liebermannNote" n="2" target="#ECf_12-6.lnote.la.2"/> bere!’ quod est dicere<ptr type="liebermannNote" n="3" target="#ECf_12-6.lnote.la.3"/>: ‘Lanceam eme<ptr type="liebermannNote" n="4" target="#ECf_12-6.lnote.la.4"/> de<ptr type="liebermannNote" n="5" target="#ECf_12-6.lnote.la.5"/> latere aut<ptr type="liebermannNote" n="6" target="#ECf_12-6.lnote.la.6"/> fer<ptr type="liebermannNote" n="7" target="#ECf_12-6.lnote.la.7"/>!’</ab>
        <note type="comparison" source="#liebermann" n="638"><label>printed alongside</label> <ref target="clause:ECfRetr_12-6">ECf retr 12.6</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 638–639 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-6.lnote.la.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">-iant <hi rend="italic">Ad;</hi> p. f. <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iant Ad; p. f. Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-6.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">aut <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">aut S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-6.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">guer. <hi rend="italic">Hk Ad;</hi> weram <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">guer. Hk Ad; weram S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-6.lnote.la.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">-ciantur <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ciantur Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-6.lnote.la.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">buge <hi rend="italic">Hk;</hi> bigge <hi rend="italic">Cl;</hi> bugye <hi rend="italic">Hr;</hi> bunge <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">buge Hk; bigge Cl; bugye Hr; bunge Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-6.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">von <hi rend="italic">deinem durch die Bluträcher gefährdeten</hi> Körper ab, oder trage (<hi rend="italic">d. i.</hi> leide) die Lanze (<hi rend="italic">d. i.</hi> Fehde); <hi rend="italic">als dies Sprichwort aufkam, war noch nicht das Schwert die Hauptwaffe; vgl.</hi> 30, 3</seg><seg type="translation" xml:lang="en" source="#claude">away from your body, endangered by the avengers of blood, or bear (i.e. suffer) the spear (i.e. the feud); when this proverb arose, the sword was not yet the chief weapon; cf. 30, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-6.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">hure <hi rend="italic">fügt zu Ad No:</hi> eben, freilich, halt</seg><seg type="translation" xml:lang="en" source="#claude">Ad No add hure: just, indeed</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-6.lnote.la.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">syde <hi rend="italic">Rl Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">syde Rl Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-6.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">oðer <hi rend="italic">Hk;</hi> oþer <hi rend="italic">S Ad Do No</hi></seg><seg type="translation" xml:lang="en" source="#claude">oðer Hk; oþer S Ad Do No</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-6.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">dicendum <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">dicendum Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-6.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">ēme [<hi rend="italic">für</hi> emere] <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">ēme [for emere] Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-6.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">de l. <hi rend="italic">fehlt Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">de l. lacking in Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-6.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-6.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">638</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so S Ad;</hi> feras <hi rend="italic">Hk Hr;</hi> ferre <hi rend="italic">Rl;</hi> eam <hi rend="italic">fügt zu S Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">so S Ad; feras Hk Hr; ferre Rl; S Ad Do add eam</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Let him make compensation to the kinsmen or suffer feud (<hi rend="italic">werra</hi>), whence the English had a proverb: <hi rend="italic">Bugge spere of side othe bere!</hi>, which is to say: 'Buy the lance from your side or bear it!'</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12-6.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">345</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Blutrache 13; Speer 1. b (auch <hi rend="italic">o.</hi> II 200 Sp. 1) — p. 639 <hi rend="italic">othe</hi><hi rend="superscript">2</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">Cf. Gl Blutrache 13; Speer 1. b (also above II 200 col. 1) — p. 639 <hi rend="italic">othe</hi><hi rend="superscript">2</hi> Rs</seg></note>
      </div>
    </body>
  </text>
