    <body>
      <div type="clause" n="83.1b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 83.1b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 83.1b" corresp="#wit-lat"><pb n="599" ed="#liebermann"/>Si tamen se reddiderit<ptr type="liebermannNote" n="s" target="#Hn_83-1b.lnote.oe.s"/><ptr type="liebermannNote" n="40" target="#Hn_83-1b.lnote.oe.40"/> et pacem ac misericordiam uel inuitus quesierit<ptr type="liebermannNote" n="s" target="#Hn_83-1b.lnote.oe.s"/>, non occidatur<ptr type="liebermannNote" n="s" target="#Hn_83-1b.lnote.oe.s"/>, set ad satisfactionem a rep[et]ente<ptr type="liebermannNote" n="41" target="#Hn_83-1b.lnote.oe.41"/> custodiatur<ptr type="liebermannNote" n="s" target="#Hn_83-1b.lnote.oe.s"/> XXX noctes et parentibus et amicis suis sepius interim offeratur<ptr type="liebermannNote" n="s" target="#Hn_83-1b.lnote.oe.s"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 599 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-1b.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rechtsweigerer</hi></seg><seg type="translation" xml:lang="en" source="#claude">the man refusing justice</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-1b.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">credid. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">credid. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_83-1b.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">repente <hi rend="italic">Hss.</hi>; reperiente <hi rend="italic">Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">repente MSS; reperiente Wi Tho</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">If however he surrenders and seeks peace and mercy, even unwillingly, let him not be killed, but let him be kept by the [claim]ant for satisfaction thirty nights, and meanwhile let him be offered frequently to his kinsmen and friends.</ab>
      </div>
    </body>
