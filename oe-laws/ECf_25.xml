    <body>
      <div type="clause" n="25">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 25</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 25"><pb n="650" ed="#liebermann"/><ptr type="liebermannNote" n="8" target="#ECf_25.lnote.la.8"/>Sciendum est<ptr type="liebermannNote" n="7" target="#ECf_25.lnote.la.7"/>, quia<ptr type="liebermannNote" n="c" target="#ECf_25.lnote.la.fn.c"/> omnes Iudei, <ptr type="liebermannNote" n="d" target="#ECf_25.lnote.la.fn.d"/>quocumque<ptr type="liebermannNote" n="9" target="#ECf_25.lnote.la.9"/> regno<ptr type="liebermannNote" n="7" target="#ECf_25.lnote.la.7"/> sint<ptr type="liebermannNote" n="10" target="#ECf_25.lnote.la.10"/>, sub<ptr type="liebermannNote" n="e" target="#ECf_25.lnote.la.fn.e"/> tutela<ptr type="liebermannNote" n="11" target="#ECf_25.lnote.la.11"/> et defensione<ptr type="liebermannNote" n="12" target="#ECf_25.lnote.la.12"/> regis ligie<ptr type="liebermannNote" n="7" target="#ECf_25.lnote.la.7"/> debent esse; neque aliquis eorum potest se<ptr type="liebermannNote" n="13" target="#ECf_25.lnote.la.13"/> subdere alicui diuiti<ptr type="liebermannNote" n="14" target="#ECf_25.lnote.la.14"/> sine<ptr type="liebermannNote" n="15" target="#ECf_25.lnote.la.15"/> licentia regis, quia ipsi Iudei et omnia sua regis sunt.</ab>
        <note type="comparison" source="#liebermann" n="650"><label>printed alongside</label> <ref target="clause:ECfRetr_25">ECf retr 25</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 650 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “Iudei” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_25.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">dass</seg><seg type="translation" xml:lang="en" source="#claude">that</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_25.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">fügt zu Rl S; aber Verf. meint nicht:</hi> in welchem (<hi rend="italic">auch fremden</hi>) Reiche, <hi rend="italic">sondern</hi> wo immer im Reiche. <hi rend="italic">Vielleicht las Or</hi> quoc. in r.</seg><seg type="translation" xml:lang="en" source="#claude">Rl S add in; but the author means not: in whatever (even foreign) realm, but: wherever in the realm. Perhaps Or read quoc. in r.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_25.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 15, 7; <hi rend="italic">über</hi> ligius <hi rend="italic">Hn</hi> 43, 6</seg><seg type="translation" xml:lang="en" source="#claude">cf. 15, 7; on ligius, Hn 43, 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_25.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">De Iudeis <hi rend="italic">überschr. Cl Pl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">headed De Iudeis Cl Pl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_25.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_25.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">ubicumque <hi rend="italic">Hk Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">ubicumque Hk Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_25.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">sunt <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">sunt Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_25.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">def. et tu. domini r. <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">def. et tu. domini r. Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_25.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">domini <hi rend="italic">fügt zu Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ad Do add domini</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_25.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">su. se <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">su. se S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_25.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">regi <hi rend="italic">unterstr., darüber</hi> d. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">regi underlined, with d. above Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_25.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">s. l. r. <hi rend="italic">übergeschr. Hk;</hi> nisi cum <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. l. r. written above Hk; nisi cum Ad Do</seg></note>
      </div>
    </body>
