        <head><ref type="lawCode" target="law:IudDeiIII">Iud Dei III</ref> 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei III 1" corresp="#wit-lat"><pb n="408" ed="#liebermann"/>Primitus faciat sacerdos laetanias<ptr type="liebermannNote" n="5" target="#IudDeiIII_1.lnote.oe.5"/>, et omnes qui intus sint<ptr type="liebermannNote" n="6" target="#IudDeiIII_1.lnote.oe.6"/> cum eo ieiuni sint, et sic incipiat<ptr type="liebermannNote" n="7" target="#IudDeiIII_1.lnote.oe.7"/>:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 408 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">Primum laetania celebretur <hi rend="italic">Zeu.</hi> 639. 687; <hi rend="italic">unten</hi> XIV</seg><seg type="translation" xml:lang="en" source="#claude">Primum laetania celebretur Zeu. 639. 687; below XIV</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">fuerint <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">fuerint Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">-iunt <hi rend="italic">Vt;</hi> hanc orationem <hi rend="italic">fügt zu Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iunt Vt; hanc orationem added in Ch</seg></note>
