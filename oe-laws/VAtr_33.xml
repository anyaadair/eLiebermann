    <body>
      <div type="clause" n="33">
        <head><ref type="lawCode" target="law:VAtr">V Atr</ref> 33</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="33" corresp="#wit-g"><pb n="244" ed="#liebermann"/>⁊ æghwylce unlaga alecge man georne.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="33" corresp="#wit-g2"><pb n="244" ed="#liebermann"/>⁊ æghwilce unlaga alecge man georne.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="33" corresp="#wit-d"><ptr type="editorNote" n="6" target="#VAtr_33.robnote.fn.6"/><pb n="88" ed="#robertson"/>[⁊ æghwylce unlaga alecge man georne.]</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g"><pb n="156" ed="#rabin-doml"/>And æghwylce unlaga alecge man georne.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="245" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#VAtr_33.lnote.de.1"/> jegliches Unrecht<ptr type="liebermannNote" n="2" target="#VAtr_33.lnote.de.2"/> beseitige man eifrig.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let every abuse be eagerly put down.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d"><ptr type="editorNote" n="1" target="#VAtr_33.robnote.n.1"/><pb n="89" ed="#robertson"/>[And injustice of every kind shall be zealously suppressed.]</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-g"><pb n="452" ed="#whitelock"/>And every abuse is to be zealously suppressed.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g"><pb n="157" ed="#rabin-doml"/>And all injustice is to be utterly eradicated.</ab>
        <note type="comparison" source="#wormald-mel" n="333"><label>repeats</label> <ref target="clause:VAtr_32-5">V Atr 32.5</ref> <quote>the G texts ... at once repeat the same point in more or less the same words, V Atr 33, cf. 32:5</quote></note>
        <note type="editorial">Clause number standardised from ‘[33]’.</note>
        <note type="textual" source="#rabin-doml">omitted D</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_33.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">174</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">= VI 40 = II Cn 11</seg><seg type="translation" xml:lang="en" source="#claude">= VI 40 = II Cn 11</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_33.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">174</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Schon <hi rend="italic">o</hi>. 1, 1. 23. 32</seg><seg type="translation" xml:lang="en" source="#claude">Already <hi rend="italic">above</hi> 1, 1. 23. 32</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VAtr_33.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">331</biblScope></bibl><seg type="original" xml:lang="en">Cf. 1, 1; 23; 32; VI, 40; II Cn. 11. This clause is omitted in D.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="VAtr_33.robnote.fn.6" n="6" source="#robertson"><bibl><biblScope unit="page">88</biblScope></bibl><label>⁊</label><seg type="original" xml:lang="en">G, G₂.</seg></note>
      </div>
    </body>
