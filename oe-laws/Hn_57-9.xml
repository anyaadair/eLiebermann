        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 57.9" corresp="#wit-lat"><pb n="577" ed="#liebermann"/>Cum clerico<ptr type="liebermannNote" n="f" target="#Hn_57-9.lnote.oe.f"/> qui uxorem habeat et<ptr type="liebermannNote" n="11" target="#Hn_57-9.lnote.oe.11"/> firmam<ptr type="liebermannNote" n="ff" target="#Hn_57-9.lnote.oe.ff"/> teneat laicorum et rebus extrinsecis<ptr type="liebermannNote" n="12" target="#Hn_57-9.lnote.oe.12"/> seculariter deditus sit, seculariter<ptr type="liebermannNote" n="13" target="#Hn_57-9.lnote.oe.13"/> est disceptandum.</ab>
