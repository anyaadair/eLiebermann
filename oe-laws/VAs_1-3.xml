      <div type="clause" n="1.3">
        <head><ref type="lawCode" target="law:VAs">V As</ref> 1.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.3" corresp="#wit-h"><pb n="168" ed="#liebermann"/>⁊ swylc gerefa swylc medsceat nime ⁊ oþres ryht ðurh þæt alecge, gylde þæs cinges oferhyrnesse ⁊ wege eac ða ungerisnu, swa swa we gecweden habbað.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.3" corresp="#wit-ld"><pb n="168" ed="#liebermann"/>And swylc gerefa swylce<ptr type="liebermannNote" n="2" target="#VAs_1-3.lnote.oe.2"/> midsceattas<ptr type="liebermannNote" n="2" target="#VAs_1-3.lnote.oe.2"/> nime ⁊ oðres rihte<ptr type="liebermannNote" n="2" target="#VAs_1-3.lnote.oe.2"/> ðurh þ<hi rend="italic">æt</hi> alecge, gylde ðæs cynges oferhyrnysse ⁊ wege æt<ptr type="liebermannNote" n="1" target="#VAs_1-3.lnote.oe.1"/> ða ungerisenu, swa swa we gecwæden habbaþ.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.3" corresp="#wit-q"><pb n="169" ed="#liebermann"/>Et prepositus qui mercedem<ptr type="liebermannNote" n="8" target="#VAs_1-3.lnote.oe.8"/> recipiet<ptr type="liebermannNote" n="9" target="#VAs_1-3.lnote.oe.9"/> et alicuius rectum propter hoc<ptr type="liebermannNote" n="10" target="#VAs_1-3.lnote.oe.10"/> euertet, emendet ouerhernessam<ptr type="liebermannNote" n="11" target="#VAs_1-3.lnote.oe.11"/> regis et contumeliam habeat<ptr type="liebermannNote" n="12" target="#VAs_1-3.lnote.oe.12"/>, sicut prediximus.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="1.3" corresp="#wit-h"><pb n="154" ed="#attenborough"/>⁊ swylc gerefa swylc medsceat<ptr type="editorNote" n="3" target="#VAs_1-3.attnote.fn.3"/> nime ⁊ oþres ryht ðurh þæt alecge, gylde þæs cinges oferhyrnesse ⁊ wege eac ða ungerisnu, swa swa we gecweden habbað.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="169" ed="#liebermann"/>Und jeder Vogt, der Bestechung nimmt und<ptr type="liebermannNote" n="1" target="#VAs_1-3.lnote.de.1"/> deshalb das Recht eines anderen beugt, zahle [Busse für] Ungehorsam gegen den König und trage ausserdem die Unehre, wie wir<ptr type="liebermannNote" n="*" target="#missing"/> bestimmt<ptr type="liebermannNote" n="2" target="#VAs_1-3.lnote.de.2"/> haben.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And any reeve who takes a bribe and thereby sets aside another's right, let him pay [the fine for] disobedience to the king and also bear the disgrace, as we have determined.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="155" ed="#attenborough"/>And any reeve who takes bribes, and frustrates thereby the just claims of another, shall pay the fine for insubordination to the king, and suffer also such disgrace as we have ordained<ptr type="editorNote" n="1" target="#VAs_1-3.attnote.n.1"/>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="424" ed="#whitelock"/>And such reeve as accepts bribes, and through that ruins the rights of another, is to pay the fine for disobedience to the king and bear also the degradation, as we have pronounced.<ptr type="editorNote" n="1" target="#VAs_1-3.whinote.n.1"/></ab>
        <note type="comparison" source="#liebermann" n="169"><ref target="clause:IIAs_25">II As 25</ref>; <ref target="clause:IIAs_17">II As 17</ref></note>
        <note type="comparisonPrinted" source="#liebermann">*Vgl. II As. 25. 17</note>
        <note type="comparison" source="#whitelock" n="424"><label>as in</label> <ref target="clause:IIAs_25">II As 25</ref> <quote>Loss of office is probably meant, as in II Athelstan, 25.</quote></note>
        <note type="editorial">Liebermann compares II As 25 and 17.</note>
        <note type="liebermannNote" subtype="textual" xml:id="VAs_1-3.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">169</biblScope></bibl><seg type="original" xml:lang="de">hoc peruertet [<hi rend="italic">aus</hi> 1, 2 <hi rend="italic">Anfang</hi>] <hi rend="italic">fügt zu MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">hoc peruertet [from the beginning of 1, 2] added by MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VAs_1-3.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">169</biblScope></bibl><seg type="original" xml:lang="de">-iat <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-iat MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VAs_1-3.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">169</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VAs_1-3.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">169</biblScope></bibl><seg type="original" xml:lang="de">-hyr. <hi rend="italic">T;</hi> hir. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">-hyr. T; hir. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VAs_1-3.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">169</biblScope></bibl><seg type="original" xml:lang="de">hanc <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">hanc MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VAs_1-3.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">168</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VAs_1-3.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">168</biblScope></bibl><seg type="original" xml:lang="de">c <hi rend="italic">als</hi> t <hi rend="italic">verlesen</hi></seg><seg type="translation" xml:lang="en" source="#claude">c misread as t</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAs_1-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">109</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Bestechung 1. 2. — Statt ‘eines anderen’ lies ‘der Gegenpartei des Bestechenden’</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Bestechung 1. 2. — Instead of ‘of another’ read ‘of the party opposed to the briber’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAs_1-3.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">109</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Strenger fordert Wergeld II 17; <hi rend="italic">vgl. Gl</hi> Amtsentsetzung 2 ff.</seg><seg type="translation" xml:lang="en" source="#claude">II 17 more strictly demands wergild; <hi rend="italic">cf. Gl</hi> Amtsentsetzung 2 ff.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VAs_1-3.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">211</biblScope></bibl><seg type="original" xml:lang="en">Cf. IV As. cap. 7; II As. cap. 26; VI As. cap. 11.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="VAs_1-3.attnote.fn.3" n="3" source="#attenborough"><bibl><biblScope unit="page">154</biblScope></bibl><label>medsceat</label><seg type="original" xml:lang="en"><hi rend="italic">midsceattas</hi>.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="VAs_1-3.whinote.n.1" n="1" source="#whitelock"><bibl><biblScope unit="page">424</biblScope></bibl><label>pronounced</label><seg type="original" xml:lang="en">Loss of office is probably meant, as in II Athelstan, 25.</seg></note>
      </div>
