      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:IIIEm">III Em</ref> 2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2" corresp="#wit-q"><pb n="190" ed="#liebermann"/>[II.] Uult etiam, ut ubi fur pro certo cognoscetur, tƿelfhyndi<ptr type="liebermannNote" n="16" target="#IIIEm_2.lnote.oe.16"/> et<ptr type="liebermannNote" n="17" target="#IIIEm_2.lnote.oe.17"/> tƿihyndi<ptr type="liebermannNote" n="18" target="#IIIEm_2.lnote.oe.18"/> consocientur<ptr type="liebermannNote" n="a" target="#IIIEm_2.lnote.oe.a"/> et exuperent<ptr type="liebermannNote" n="b" target="#IIIEm_2.lnote.oe.b"/> eum<ptr type="liebermannNote" n="19" target="#IIIEm_2.lnote.oe.19"/> uiuum uel mortuum, alterutrum quod poterunt; et<ptr type="liebermannNote" n="c" target="#IIIEm_2.lnote.oe.c"/> qui aliquem eorum infaidiabit qui in ea questione<ptr type="liebermannNote" n="d" target="#IIIEm_2.lnote.oe.d"/> fuerint<ptr type="liebermannNote" n="20" target="#IIIEm_2.lnote.oe.20"/>, sit inimicus regis et omnium amicorum eius<ptr type="liebermannNote" n="21" target="#IIIEm_2.lnote.oe.21"/>; et<ptr type="liebermannNote" n="e" target="#IIIEm_2.lnote.oe.e"/> si quis adire negauerit et coadiuuare nolit, emendet regi CXX s.<ptr type="liebermannNote" n="f" target="#IIIEm_2.lnote.oe.f"/> — uel secundum hoc perneget, quod nesciuit — et hundreto<ptr type="liebermannNote" n="g" target="#IIIEm_2.lnote.oe.g"/> XXX s.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="2" corresp="#wit-q"><pb n="12" ed="#robertson"/>Vult etiam, ut ubi fur pro certo cognoscetur, twelfhindi et twihindi<ptr type="editorNote" n="14" target="#IIIEm_2.robnote.fn.14"/> consocientur et exuperent eum<ptr type="editorNote" n="15" target="#IIIEm_2.robnote.fn.15"/> vivum vel mortuum, alterutrum quod poterunt; et qui aliquem eorum infaidiabit qui in ea quaestione fuerint<ptr type="editorNote" n="16" target="#IIIEm_2.robnote.fn.16"/>, sit inimicus regis et omnium amicorum eius<ptr type="editorNote" n="17" target="#IIIEm_2.robnote.fn.17"/>; et si quis adire negaverit et coadjuvare nolit, emendet regi CXX s.—vel secundum hoc perneget quod nescivit—et hundreto XXX s.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q"><ptr type="editorNote" n="1" target="#IIIEm_2.robnote.n.1"/><pb n="13" ed="#robertson"/>Further, it is his will, that where a man is proved to be a thief, nobles and commoners shall unite and seize him, alive or dead, whichever they can. And he who institutes a vendetta against any of those who have been concerned in that pursuit shall incur the hostility of the king and of all his friends<ptr type="editorNote" n="2" target="#IIIEm_2.robnote.n.2"/>, and if anyone shall refuse to come forward and lend his assistance, he shall pay 120 shillings to the king<ptr type="editorNote" n="3" target="#IIIEm_2.robnote.n.3"/>—or deny knowledge of the affair by an oath of equivalent value—and 30 shillings to the hundred<ptr type="editorNote" n="4" target="#IIIEm_2.robnote.n.4"/>.</ab>
        <note type="comparison" source="#liebermann" n="190"><ref target="clause:IIAs_20-7">II As 20.7</ref>; <ref target="clause:IIAs_20-2">II As 20.2</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. II As. 20, 7; 20, 2</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Hu_2">Hu 2</ref>; <ref target="clause:IIIEg_7-1">III Eg 7.1</ref>; <ref target="clause:IIIEg_7-2">III Eg 7.2</ref>; <ref target="clause:App-AGu_7">App AGu 7</ref></note>
        <note type="comparison" source="#wormald-mel" n="312"><label>echoes</label> <ref target="clause:IIAs_20-7">II As 20.7</ref> <quote>III Em 2, 1; the first echoes II As 20:7</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="378"><ref target="clause:Hu_Inscr">Hu</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="378"><ref target="clause:Hu_2">Hu 2</ref></note>
        <note type="comparedBy" source="#wormald-ppmel" n="175"><ref target="clause:Hu_2">Hu 2</ref></note>
        <note type="editorial">Latin only; no German translation in Liebermann. Liebermann prints ‘tƿelfhyndi’, ‘tƿihyndi’ with the OE letter wynn (ƿ), now kept as printed (October 2026; before, normalised to w). Liebermann compares II As 20.7.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEm_2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">190</biblScope></bibl><seg type="original" xml:lang="de">-hindi <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-hindi <hi rend="italic">MHkBr</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEm_2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">190</biblScope></bibl><seg type="original" xml:lang="de">et twi. <hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">et twi. lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEm_2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">190</biblScope></bibl><seg type="original" xml:lang="de">tƿifhyndi <hi rend="italic">T;</hi> tƿifhindi <hi rend="italic">MBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">tƿifhyndi <hi rend="italic">T;</hi> tƿifhindi <hi rend="italic">MBr</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEm_2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">190</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">in <hi rend="italic">T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEm_2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">190</biblScope></bibl><seg type="original" xml:lang="de">-rit <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rit <hi rend="italic">T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEm_2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">190</biblScope></bibl><seg type="original" xml:lang="de">eorum <hi rend="italic">MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">eorum <hi rend="italic">MHkBr</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEm_2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">129</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Polizei 1 G.—Or. hatte wohl <hi rend="italic">gesamnian</hi> laut VI As 8, 3.—‘Zwei- und Zwölfhunderter’ (<hi rend="italic">s. Gl</hi> Wergeld 4) = gemeinfrei (<hi rend="italic">s. d. Gl</hi> 1) und adlig</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Polizei 1 G.—The original probably had <hi rend="italic">gesamnian</hi>, according to VI As 8, 3.—‘Two- and twelve-hundred men’ (<hi rend="italic">see Gl</hi> Wergeld 4) = common freemen (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1) and nobles</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEm_2.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">129</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">gewielden hine swa cucne swa deadne swa hwæðer swa mægen</hi> las Or. laut III Eg 7. II Atr 6. Nach Schmid S. <hi rend="smallcaps">xlviii</hi> ist hinzuzudenken: ⁊ <hi rend="italic">nimen eal þæt he age</hi> aus II As 20, 3. II Em 1, 2. III Eg 7. Diesen Satz zitiert mit Eadmunds Namen Hu 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">gewielden hine swa cucne swa deadne swa hwæðer swa mægen</hi> was the reading of the original, according to III Eg 7. II Atr 6. According to Schmid p. <hi rend="smallcaps">xlviii</hi> one should supply: ⁊ <hi rend="italic">nimen eal þæt he age</hi>, from II As 20, 3. II Em 1, 2. III Eg 7. This sentence is quoted under Eadmund’s name in Hu 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEm_2.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">129</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">⁊ <hi rend="italic">gif hwa heora ænigne fælæce, . . . beo he fah wið þone cyning</hi> ⁊ <hi rend="italic">wið ealle his friend</hi> las Or. laut II As 20, 7. <hi rend="italic">Vgl</hi>. Strafen auf Rache an Diebeshinrichtern II As 6, 2. VI 1, 5</seg><seg type="translation" xml:lang="en" source="#claude">⁊ <hi rend="italic">gif hwa heora ænigne fælæce, . . . beo he fah wið þone cyning</hi> ⁊ <hi rend="italic">wið ealle his friend</hi> was the reading of the original, according to II As 20, 7. <hi rend="italic">Cf</hi>. the penalties for vengeance on those who execute thieves, II As 6, 2. VI 1, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEm_2.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">129</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">æsce</hi> las Or.; <hi rend="italic">inquisitio</hi> sagt Q zumeist dafür</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">æsce</hi> was the reading of the original; Q mostly renders it <hi rend="italic">inquisitio</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEm_2.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">129</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">⁊ <hi rend="italic">gif hwa to ridan</hi> (oder <hi rend="italic">faran</hi> oder <hi rend="italic">þa rade forsace</hi>) ⁊ <hi rend="italic">fylstan nylle, bete cyninge</hi> las Or. laut II As 20, 2. Hu 2. III Eg 7</seg><seg type="translation" xml:lang="en" source="#claude">⁊ <hi rend="italic">gif hwa to ridan</hi> (or <hi rend="italic">faran</hi> or <hi rend="italic">þa rade forsace</hi>) ⁊ <hi rend="italic">fylstan nylle, bete cyninge</hi> was the reading of the original, according to II As 20, 2. Hu 2. III Eg 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEm_2.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">129</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">= <hi rend="italic">oferhiernesse</hi> II As 20, 2.—Diese Strafsumme wendet ab ein Reinigungschwur des Nichtwissens in gleicher Höhe; <hi rend="italic">vgl. Gl</hi> Gefährdeeid 4; Eidesschwere 2a; Ungehorsam 23</seg><seg type="translation" xml:lang="en" source="#claude">= <hi rend="italic">oferhiernesse</hi> II As 20, 2.—This penalty is averted by an oath of exculpation denying knowledge, of the same amount; <hi rend="italic">cf. Gl</hi> Gefährdeeid 4; Eidesschwere 2a; Ungehorsam 23</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIIEm_2.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">129</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Hundred 11. 18</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Hundred 11. 18</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIEm_2.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">298</biblScope></bibl><seg type="original" xml:lang="en">Cf. II As. 20, 2 and 7; VI As. 8, 2.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIEm_2.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">298</biblScope></bibl><seg type="original" xml:lang="en">Cf. II Edm. 1, 3 and note.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIEm_2.robnote.n.3" n="3" source="#robertson"><bibl><biblScope unit="page">298</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e.</hi> the fine due for insubordination, cf. II As. 20, 2.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIIEm_2.robnote.n.4" n="4" source="#robertson"><bibl><biblScope unit="page">299</biblScope></bibl><seg type="original" xml:lang="en">This is the first mention of the hundred in the Laws. The fact that a fine is made payable to it shows that it was already an organised body.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIEm_2.robnote.fn.14" n="14" source="#robertson"><bibl><biblScope unit="page">12</biblScope></bibl><label>twihindi</label><seg type="original" xml:lang="en"><hi rend="italic">et twih.</hi> om. Hk; <hi rend="italic">twifhindi</hi> M, Br; <hi rend="italic">twifhyndi</hi> T.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIEm_2.robnote.fn.15" n="15" source="#robertson"><bibl><biblScope unit="page">12</biblScope></bibl><label>eum</label><seg type="original" xml:lang="en"><hi rend="italic">eum in</hi> T.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIEm_2.robnote.fn.16" n="16" source="#robertson"><bibl><biblScope unit="page">12</biblScope></bibl><label>fuerint</label><seg type="original" xml:lang="en"><hi rend="italic">fuerit</hi> T.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIIEm_2.robnote.fn.17" n="17" source="#robertson"><bibl><biblScope unit="page">12</biblScope></bibl><label>eius</label><seg type="original" xml:lang="en"><hi rend="italic">eorum</hi> M, Hk, Br.</seg></note>
      </div>
    </body>
