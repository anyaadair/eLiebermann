        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 35.2" corresp="#wit-lat"><pb n="566" ed="#liebermann"/>In causis regiis grithbreche<ptr type="liebermannNote" n="m" target="#Hn_35-2.lnote.oe.m"/><ptr type="liebermannNote" n="21" target="#Hn_35-2.lnote.oe.21"/> C sol., stretbreche<ptr type="liebermannNote" n="22" target="#Hn_35-2.lnote.oe.22"/><ptr type="liebermannNote" n="n" target="#Hn_35-2.lnote.oe.n"/> C sol., forestel<ptr type="liebermannNote" n="n" target="#Hn_35-2.lnote.oe.n"/><ptr type="liebermannNote" n="23" target="#Hn_35-2.lnote.oe.23"/> C sol., hamsocne<ptr type="liebermannNote" n="n" target="#Hn_35-2.lnote.oe.n"/> C sol., burhbreche<ptr type="liebermannNote" n="n" target="#Hn_35-2.lnote.oe.n"/><ptr type="liebermannNote" n="24" target="#Hn_35-2.lnote.oe.24"/> C sol.; et deinceps, sicut prediximus<ptr type="liebermannNote" n="o" target="#Hn_35-2.lnote.oe.o"/>, emendabitur wita<ptr type="liebermannNote" n="25" target="#Hn_35-2.lnote.oe.25"/>, wera, iuxta<ptr type="liebermannNote" n="26" target="#Hn_35-2.lnote.oe.26"/> culpam potius quam personam.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 566 (two independent readings of the page images, differences settled against the page)</note>
