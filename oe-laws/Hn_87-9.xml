      <div type="clause" n="87.9">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 87.9</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 87.9" corresp="#wit-lat"><pb n="602" ed="#liebermann"/>Si quis in conuenticulo<ptr type="liebermannNote" n="i" target="#Hn_87-9.lnote.oe.i"/> aliquo conuiuii<ptr type="liebermannNote" n="k" target="#Hn_87-9.lnote.oe.k"/> uel potacionis uel huiusmodi fuerit occisus, defendant<ptr type="liebermannNote" n="16" target="#Hn_87-9.lnote.oe.16"/> se uel emendent<ptr type="liebermannNote" n="17" target="#Hn_87-9.lnote.oe.17"/> quibus fuerit inputatum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 602 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-9.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">Gilde <hi rend="italic">heisst</hi> conventiculus <hi rend="italic">auch bei Alcwine; vgl.</hi> Archiv Stud. neu. Spra. 96, 335</seg><seg type="translation" xml:lang="en" source="#claude">guild; <hi rend="italic">Alcwine too calls it</hi> conventiculus; <hi rend="italic">cf.</hi> Archiv Stud. neu. Spra. 96, 335</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-9.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 81, 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 81, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-9.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">-dat <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dat Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-9.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">602</biblScope></bibl><seg type="original" xml:lang="de">-det <hi rend="italic">ohne Hss. Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">-det without MS authority Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_87-9.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de">Hier schon entstammen einige Worte der zu 87, 10b zitierten <hi rend="italic">Lex Salica emend</hi>. 45, 2</seg><seg type="translation" xml:lang="en" source="#claude">Already here some words derive from the <hi rend="italic">Lex Salica emend</hi>. 45, 2 cited at 87, 10b</seg></note>
      </div>
