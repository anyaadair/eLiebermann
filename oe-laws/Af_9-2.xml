        <note type="liebermannNote" subtype="textual" xml:id="Af_9-2.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">54</biblScope></bibl><seg type="original" xml:lang="de">synd <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">synd Ld</seg></note>
