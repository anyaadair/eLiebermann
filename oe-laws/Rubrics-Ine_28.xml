    <body>
      <div type="clause" n="28">
        <head>Ine Rb 28</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="28" corresp="#wit-e"><pb n="22" ed="#liebermann"/>LXXII. Be ðeofes onfenge<ptr type="liebermannNote" n="7" target="#Rubrics-Ine_28.lnote.oe.7"/> æt ðiefðe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="28" corresp="#wit-g-prol"><pb n="22" ed="#liebermann"/>LXXII. Be þeofes onfenge æt ðyfðe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="28" corresp="#wit-h"><pb n="23" ed="#liebermann"/>LXXII. Be þeowes<ptr type="liebermannNote" n="12" target="#Rubrics-Ine_28.lnote.oe.12"/> (mannes)<ptr type="liebermannNote" n="13" target="#Rubrics-Ine_28.lnote.oe.13"/> onfenge æt þyfðe.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="28" corresp="#wit-q"><pb n="23" ed="#liebermann"/>De fure capto cum furto.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="206" ed="#jurasinski-and-oliver"/>LXXII Be ðeofes onfenge æt ðiefðe</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="206" ed="#jurasinski-and-oliver"/>Be ðeowes mannes onfenge æt ðyfðe</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="23" ed="#liebermann"/>Vom Einfangen eines Diebes<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_28.lnote.de.1"/> beim Diebstahl [selbst].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of the catching of a thief in the [very] act of theft.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="207" ed="#jurasinski-and-oliver"/>Concerning the capture of a thief in the act of theft</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="207" ed="#jurasinski-and-oliver"/>Concerning the capture of a slave in the act of theft</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_28.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de">-ng <hi rend="italic">ohne</hi> æt ð. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ng without æt ð. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_28.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">w <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">w on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_28.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_28.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘unfreien Menschen’ Hcor. B, vielleicht auf 29 blickend; derselbe Schreibfehler Af 9, 2 B⁴</seg><seg type="translation" xml:lang="en" source="#claude">‘unfree person’ Hcor. B, perhaps with an eye to 29; the same scribal error at Af 9, 2 B⁴</seg></note>
      </div>
