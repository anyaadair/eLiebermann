      <entry xml:lang="de" type="grammatical">
        <form type="lemma">
          <orth>Accusativ</orth>
        </form>
        <dictScrap type="liebermann"><hi rend="bold"><hi rend="italic">Accusativ.</hi></hi> <hi rend="bold">1</hi>) <hi rend="italic"><ref type="abbreviation" target="gram:statt"><abbr>Statt</abbr></ref> Nominativs</hi> [<hi rend="italic"><ref type="abbreviation" target="gram:durch"><abbr>durch</abbr></ref> <ref type="abbreviation" target="gram:unsyntaktisch"><abbr>unsyntakt.</abbr></ref> Hineindenken des</hi> Haben <hi rend="italic"><ref type="abbreviation" target="gram:statt"><abbr>statt</abbr></ref></hi> Sein, Eintreten] sien forgifene XII dagas ⁊ þone dæg <ref type="lawCode" target="law:Af">Af</ref> 43; stande þriddan dæl þære bote inne 47,1; gæð bot: þriddan dæl 71; beon þa heregeata: byrnan (<hi rend="italic"><ref type="abbreviation" target="gram:Singular"><abbr>sg</abbr></ref></hi>) <ref type="lawCode" target="law:IICn">II Cn</ref> 71,1 <hi rend="bold">2</hi>) <hi rend="italic"><ref type="abbreviation" target="gram:accusativusCumInfinitivo"><abbr>Acc. cum infinit</abbr></ref>: <ref type="abbreviation" target="gram:siehe"><abbr>s.</abbr></ref></hi> <ref type="entry" target="entry:thaet-2">þæt</ref> <hi rend="italic"><ref type="abbreviation" target="gram:conjunctio"><abbr>cj</abbr></ref>, <ref type="abbreviation" target="gram:Nummer"><abbr>n.</abbr></ref></hi> 3a <hi rend="bold">3</hi>) <hi rend="italic"><ref type="abbreviation" target="gram:accusativDerZeit"><abbr>Acc. d. Zeit</abbr></ref>:</hi> his deig <hi rend="italic">zu Lebzeiten</hi> <ref type="lawCode" target="law:IICn">II Cn</ref> 72 <ref type="lawCode" target="law:B">B</ref>; dagas <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 3; III (VII) niht <ref type="lawCode" target="law:Hl">Hl</ref> 15. <ref type="lawCode" target="law:IIIAtr">III Atr</ref> 9. <ref type="lawCode" target="law:Rect">Rect</ref> 13; þa hwile þe <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 13; ælc gear <ref type="lawCode" target="law:AsAlm">As Alm</ref> 1 <hi rend="bold">4</hi>) <hi rend="italic">der Beziehung:</hi> his dæl <hi rend="italic">seinesteils</hi> <ref type="lawCode" target="law:Ine">Ine</ref> 57 <hi rend="bold">5</hi>) <hi rend="italic"><ref type="abbreviation" target="gram:regiertVon"><abbr>regiert von</abbr></ref></hi> befleon, gebugan, <hi rend="italic"><ref type="abbreviation" target="gram:abweichend"><abbr>abw.</abbr></ref> <ref type="abbreviation" target="gram:vom"><abbr>vom</abbr></ref> Deutschen</hi> (<hi rend="italic"><ref type="abbreviation" target="gram:sieheDort"><abbr>s.d.</abbr></ref></hi>); <hi rend="italic"><ref type="abbreviation" target="gram:von"><abbr>von</abbr></ref> Verben, die <ref type="abbreviation" target="gram:fruher"><abbr>früher</abbr></ref> <ref type="abbreviation" target="gram:Genitiv"><abbr>gn</abbr></ref> <ref type="abbreviation" target="gram:Dativ"><abbr>dt</abbr></ref> <ref type="abbreviation" target="gram:regiert"><abbr>regiert</abbr></ref> hatten, <ref type="abbreviation" target="gram:siehe"><abbr>s.</abbr></ref> Genetiv, <ref type="entry" target="entry:Dativ">Dativ</ref></hi> <hi rend="bold">6</hi>) <hi rend="italic">Flexion <ref type="abbreviation" target="gram:siehe"><abbr>s.</abbr></ref> <ref type="entry" target="entry:Declination">Declination</ref></hi></dictScrap>
        <dictScrap type="senses">
          <sense n="1"><hi rend="italic"><ref type="abbreviation" target="gram:statt"><abbr>Statt</abbr></ref> Nominativs</hi> [<hi rend="italic"><ref type="abbreviation" target="gram:durch"><abbr>durch</abbr></ref> <ref type="abbreviation" target="gram:unsyntaktisch"><abbr>unsyntakt.</abbr></ref> Hineindenken des</hi> Haben <hi rend="italic"><ref type="abbreviation" target="gram:statt"><abbr>statt</abbr></ref></hi> Sein, Eintreten] sien forgifene XII dagas ⁊ þone dæg <ref type="lawCode" target="law:Af">Af</ref> 43; stande þriddan dæl þære bote inne 47,1; gæð bot: þriddan dæl 71; beon þa heregeata: byrnan (<hi rend="italic"><ref type="abbreviation" target="gram:Singular"><abbr>sg</abbr></ref></hi>) <ref type="lawCode" target="law:IICn">II Cn</ref> 71,1</sense>
          <sense n="2"><hi rend="italic"><ref type="abbreviation" target="gram:accusativusCumInfinitivo"><abbr>Acc. cum infinit</abbr></ref>: <ref type="abbreviation" target="gram:siehe"><abbr>s.</abbr></ref></hi> <ref type="entry" target="entry:thaet-2">þæt</ref> <hi rend="italic"><ref type="abbreviation" target="gram:conjunctio"><abbr>cj</abbr></ref>, <ref type="abbreviation" target="gram:Nummer"><abbr>n.</abbr></ref></hi> 3a</sense>
          <sense n="3"><hi rend="italic"><ref type="abbreviation" target="gram:accusativDerZeit"><abbr>Acc. d. Zeit</abbr></ref>:</hi> his deig <hi rend="italic">zu Lebzeiten</hi> <ref type="lawCode" target="law:IICn">II Cn</ref> 72 <ref type="lawCode" target="law:B">B</ref>; dagas <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 3; III (VII) niht <ref type="lawCode" target="law:Hl">Hl</ref> 15. <ref type="lawCode" target="law:IIIAtr">III Atr</ref> 9. <ref type="lawCode" target="law:Rect">Rect</ref> 13; þa hwile þe <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 13; ælc gear <ref type="lawCode" target="law:AsAlm">As Alm</ref> 1</sense>
          <sense n="4"><hi rend="italic">der Beziehung:</hi> his dæl <hi rend="italic">seinesteils</hi> <ref type="lawCode" target="law:Ine">Ine</ref> 57</sense>
          <sense n="5"><hi rend="italic"><ref type="abbreviation" target="gram:regiertVon"><abbr>regiert von</abbr></ref></hi> befleon, gebugan, <hi rend="italic"><ref type="abbreviation" target="gram:abweichend"><abbr>abw.</abbr></ref> <ref type="abbreviation" target="gram:vom"><abbr>vom</abbr></ref> Deutschen</hi> (<hi rend="italic"><ref type="abbreviation" target="gram:sieheDort"><abbr>s.d.</abbr></ref></hi>); <hi rend="italic"><ref type="abbreviation" target="gram:von"><abbr>von</abbr></ref> Verben, die <ref type="abbreviation" target="gram:fruher"><abbr>früher</abbr></ref> <ref type="abbreviation" target="gram:Genitiv"><abbr>gn</abbr></ref> <ref type="abbreviation" target="gram:Dativ"><abbr>dt</abbr></ref> <ref type="abbreviation" target="gram:regiert"><abbr>regiert</abbr></ref> hatten, <ref type="abbreviation" target="gram:siehe"><abbr>s.</abbr></ref> Genetiv, <ref type="entry" target="entry:Dativ">Dativ</ref></hi></sense>
          <sense n="6"><hi rend="italic">Flexion <ref type="abbreviation" target="gram:siehe"><abbr>s.</abbr></ref> <ref type="entry" target="entry:Declination">Declination</ref></hi></sense>
        </dictScrap>
        <note type="editorial">Liebermann’s “n. 3a” has no match: <ref target="entry:thaet-2">þæt</ref> as a conjunction (section IV) has no subsection 3a. The accusative and infinitive is treated at the end of IV B) 2), where þæt introduces a clause that stands for it: “fela man wite, þæt ungelygene syn” V As 1,5; “þone we geaxian, þæt ful sy”, glossing Latin <hi rend="italic">quem reum esse</hi>, VI As 1,1.</note>
