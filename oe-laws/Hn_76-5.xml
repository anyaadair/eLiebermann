        <note type="liebermannNote" subtype="textual" xml:id="Hn_76-5.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">593</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur Sc Hg; fehlt übr. besser</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">only Sc Hg; missing in the others, which is better</hi></seg></note>
