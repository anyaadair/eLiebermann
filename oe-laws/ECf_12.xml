  <text>
    <body>
      <div type="clause" n="12">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 12</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 12"><pb n="637" ed="#liebermann"/><ptr type="liebermannNote" n="*" target="#ECf_12.lnote.oe.erkl-clause"/><hi rend="spaced">De multiplici<ptr type="liebermannNote" n="3" target="#ECf_12.lnote.la.3"/> pace regis<ptr type="liebermannNote" n="4" target="#ECf_12.lnote.la.4"/>.</hi> Pax<ptr type="liebermannNote" n="b" target="#ECf_12.lnote.la.fn.b"/> regis<ptr type="liebermannNote" n="5" target="#ECf_12.lnote.la.5"/> multiplex est: Alia data manu sua, quam Angli<ptr type="liebermannNote" n="6" target="#ECf_12.lnote.la.6"/> uocant<ptr type="liebermannNote" n="c" target="#ECf_12.lnote.la.fn.c"/> kinges<ptr type="liebermannNote" n="7" target="#ECf_12.lnote.la.7"/> hand<ptr type="liebermannNote" n="8" target="#ECf_12.lnote.la.8"/> s[ea]lde<ptr type="liebermannNote" n="9" target="#ECf_12.lnote.la.9"/> grið<ptr type="liebermannNote" n="10" target="#ECf_12.lnote.la.10"/>;</ab>
        <note type="comparison" source="#liebermann" n="637"><label>printed alongside</label> <ref target="clause:ECfRetr_12">ECf retr 12</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 637 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt</hi> 27; <hi rend="italic">vgl.</hi> Hn 10, 1<hi rend="italic">h</hi></seg><seg type="translation" xml:lang="en" source="#claude">repeated at 27; cf. Hn 10, 1, note h</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">grið, þæt he mid his agenre [<hi rend="italic">daraus Rl</hi>] hand sylð <hi rend="italic">III Atr.</hi> 1</seg><seg type="translation" xml:lang="en" source="#claude">grið, þæt he mid his agenre [whence Rl] hand sylð, III Atr. 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12.lnote.la.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12.lnote.la.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">regia <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">regia Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">regia <hi rend="italic">Rl S Ad Do Wo</hi></seg><seg type="translation" xml:lang="en" source="#claude">regia Rl S Ad Do Wo</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">Anglici <hi rend="italic">S Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">Anglici S Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">chingis <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">chingis Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">han <hi rend="italic">Hr;</hi> hanȝ <hi rend="italic">Ad;</hi> achan [<hi rend="italic">d. i.</hi> aghen: <hi rend="italic">eigen</hi>] <hi rend="italic">Rl;</hi> hauwes <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">han Hr; hanȝ Ad; achan [i.e. aghen: own] Rl; hauwes Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">selde <hi rend="italic">Rl;</hi> salde <hi rend="italic">Hk;</hi> shalde <hi rend="italic">Hr;</hi> alde <hi rend="italic">S;</hi> s. g. <hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">selde Rl; salde Hk; shalde Hr; alde S; s. g. lacking in Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">grid <hi rend="italic">Rl Hk S</hi></seg><seg type="translation" xml:lang="en" source="#claude">grid Rl Hk S</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Of the manifold peace of the king. The king's peace is manifold: one, given by his own hand, which the English call <hi rend="italic">kinges hand s[ea]lde grið</hi> (peace given by the king's hand);</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_12.lnote.oe.erkl-clause" n="*" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">345</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd.</hi> Schutz 9c II; Handfrieden 2. 3a. 7; verbinde <hi rend="italic">handsealde</hi> zu einem Wort.</seg><seg type="translation" xml:lang="en" source="#claude">Ibid. Schutz 9c II; Handfrieden 2. 3a. 7; join <hi rend="italic">handsealde</hi> into one word.</seg></note>
      </div>
    </body>
  </text>
