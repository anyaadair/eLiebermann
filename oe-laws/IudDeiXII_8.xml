        <head><ref type="lawCode" target="law:IudDeiXII">Iud Dei XII</ref> 8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XII 8" corresp="#wit-lat"><pb n="420" ed="#liebermann"/>Lectio<ptr type="liebermannNote" n="37" target="#IudDeiXII_8.lnote.oe.37"/> Ysaię prophetae. In diebus illis locutus est Ysaias<ptr type="liebermannNote" n="38" target="#IudDeiXII_8.lnote.oe.38"/> propheta dicens:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 420 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_8.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">c.</hi> 8—13 <hi rend="italic">auch in Mg f.</hi> 212, <hi rend="italic">im Kaltwasserritual unten</hi> XIII 2</seg><seg type="translation" xml:lang="en" source="#claude">c. 8—13 also in Mg f. 212, in the cold-water ritual below XIII 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_8.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de">Is. <hi rend="italic">Tb</hi></seg><seg type="translation" xml:lang="en" source="#claude">Is. Tb</seg></note>
