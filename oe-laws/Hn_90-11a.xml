      <div type="clause" n="90.11a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 90.11a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 90.11a" corresp="#wit-lat"><pb n="606" ed="#liebermann"/>Legis<ptr type="liebermannNote" n="i" target="#Hn_90-11a.lnote.oe.i"/><ptr type="liebermannNote" n="14" target="#Hn_90-11a.lnote.oe.14"/> enim est: ‘qui inscienter peccat, scienter emendet’; et ‘qui<ptr type="liebermannNote" n="15" target="#Hn_90-11a.lnote.oe.15"/> brecht<ptr type="liebermannNote" n="k" target="#Hn_90-11a.lnote.oe.k"/><ptr type="liebermannNote" n="16" target="#Hn_90-11a.lnote.oe.16"/> ungeƿaldes<ptr type="liebermannNote" n="17" target="#Hn_90-11a.lnote.oe.17"/>, betan<ptr type="liebermannNote" n="18" target="#Hn_90-11a.lnote.oe.18"/> geƿealdes’<ptr type="liebermannNote" n="19" target="#Hn_90-11a.lnote.oe.19"/>.</ab>
        <note type="comparison" source="#wormald-ppmel" n="95"><label>repeats</label> <ref target="clause:Hn_88-6a">Hn 88.6a</ref> <quote>‘he who unknowingly offends will knowingly amend’ ... each time the author made this point</quote></note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 606 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11a.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 88, 6<hi rend="italic">a</hi>; <hi rend="italic">vgl.</hi> 70, 12<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">as 88, 6<hi rend="italic">a</hi>; cf. 70, 12<hi rend="italic">b</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11a.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">laut vorangehendem Relativ kein Imperativ, sondern</hi> peccat <hi rend="italic">entsprechende Form;</hi> betan <hi rend="italic">ist aber</hi> emendent</seg><seg type="translation" xml:lang="en" source="#claude">in view of the preceding relative, not an imperative but a form corresponding to peccat; betan, however, is emendent</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11a.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">Legum <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">Legum Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11a.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11a.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Sc Hg;</hi> brech <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Sc Hg; brech the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11a.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">un se. <hi rend="italic">Sc Hg;</hi> unƿa., <hi rend="italic">nur stets</hi> y <hi rend="italic">statt</hi> ƿ <hi rend="italic">übrige;</hi> -wea- <hi rend="italic">bessert Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">un se. Sc Hg; unƿa., only always with y instead of ƿ, the others; -wea- emended by Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11a.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">bete <hi rend="italic">bessern Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">bete emended by Wi Tho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11a.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">se ƿa. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">se ƿa. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-11a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Absicht 2c. 8—<hi rend="italic">et brecch unpe</hi>. ohne <hi rend="italic">qui</hi>{16}—90, 11b <hi rend="italic">h. n</hi>.{20} <hi rend="italic">p</hi>.—90, 11c Z. 3 <hi rend="italic">cuius</hi> fehlt—<hi rend="italic">degecerit</hi>—<hi rend="italic">an</hi>{25}—{29}<hi rend="italic">d. a. p̃ratur ab</hi>—<hi rend="italic">cuidam</hi>{30}—<hi rend="italic">eueniat</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Absicht 2c. 8—<hi rend="italic">et brecch unpe</hi>. without <hi rend="italic">qui</hi>{16}—90, 11b <hi rend="italic">h. n</hi>.{20} <hi rend="italic">p</hi>.—90, 11c l. 3 <hi rend="italic">cuius</hi> missing—<hi rend="italic">degecerit</hi>—<hi rend="italic">an</hi>{25}—{29}<hi rend="italic">d. a. p̃ratur ab</hi>—<hi rend="italic">cuidam</hi>{30}—<hi rend="italic">eueniat</hi> Rs</seg></note>
      </div>
