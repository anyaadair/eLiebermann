      <div type="clause" n="51.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 51.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 51.5" corresp="#wit-lat"><pb n="573" ed="#liebermann"/>Nemo iusticie uel domino suo namium<ptr type="liebermannNote" n="33" target="#Hn_51-5.lnote.oe.33"/> excutere presumat, si iuste uel iniuste capiatur; set iuste repetat, plegium offerat<ptr type="liebermannNote" n="34" target="#Hn_51-5.lnote.oe.34"/> et terminum satisfaciendi.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 573 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_51-5.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">manum <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">manum Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_51-5.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">573</biblScope></bibl><seg type="original" xml:lang="de">afferat <hi rend="italic">kann man lesen Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">afferat can be read Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_51-5.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de">Am Rande spät: <hi rend="italic">Nota, rescussionem</hi> [Pfandkehrung; <hi rend="italic">s. d. Gl</hi> 3f.] <hi rend="italic">districtionis nullatenus faciendam, quod hic sumitur principium</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">In the margin, in a late hand: <hi rend="italic">Nota, rescussionem</hi> [rescue of a distress; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 3f.] <hi rend="italic">districtionis nullatenus faciendam, quod hic sumitur principium</hi> Rs</seg></note>
      </div>
