        <head><ref type="lawCode" target="law:IudDeiXII">Iud Dei XII</ref> 16.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XII 16.4" corresp="#wit-lat"><pb n="421" ed="#liebermann"/>et sicut<ptr type="liebermannNote" n="20" target="#IudDeiXII_16-4.lnote.oe.20"/> tres pueros Sidrac, Misac et Abdenago iussione regis Babilonis<ptr type="liebermannNote" n="21" target="#IudDeiXII_16-4.lnote.oe.21"/> missos in caminum ignis accensa fornace saluasti et illesos per angelum tuum eduxisti et<ptr type="liebermannNote" n="22" target="#IudDeiXII_16-4.lnote.oe.22"/> Susannam de falso crimine liberasti,</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Dan. 3, 12; 13, 42</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 421 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_16-4.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">421</biblScope></bibl><seg type="original" xml:lang="de">qui <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_16-4.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">421</biblScope></bibl><seg type="original" xml:lang="de">Babyl. <hi rend="italic">Tr Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Babyl. Tr Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_16-4.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">421</biblScope></bibl><seg type="original" xml:lang="de">et S. de f. c. l. <hi rend="italic">erst hinter</hi> mittat 16, 5 <hi rend="italic">Zeumer; nur Bc, p.</hi> 609*, <hi rend="italic">lautet XII gleich</hi></seg><seg type="translation" xml:lang="en" source="#claude">et S. de f. c. l. only after mittat 16, 5 Zeumer; only Bc, p. 609*, has the same wording as XII</seg></note>
