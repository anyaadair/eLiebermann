    <body>
      <div type="clause" n="6.2">
        <head><ref type="lawCode" target="law:IIAs">II As</ref> 6.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.2" corresp="#wit-h"><pb n="154" ed="#liebermann"/>Be<ptr type="liebermannNote" n="9" target="#IIAs_6-2.lnote.oe.9"/> blæserum. Ða blysieras<ptr type="liebermannNote" n="3" target="#IIAs_6-2.lnote.oe.3-2"/> ond<ptr type="liebermannNote" n="10" target="#IIAs_6-2.lnote.oe.10"/> þa ðe ðeof wrecen<ptr type="liebermannNote" n="11" target="#IIAs_6-2.lnote.oe.11"/>, beon þæs ilcan ryhtes wyrðe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.2" corresp="#wit-ld"><pb n="154" ed="#liebermann"/>And ða blisgeras<ptr type="liebermannNote" n="*" target="#IIAs_6-2.lnote.oe.star"/> ⁊ ða ðe ðeof wræcan, beon<ptr type="liebermannNote" n="3" target="#IIAs_6-2.lnote.oe.3"/> ðæs ylca<ptr type="liebermannNote" n="1" target="#IIAs_6-2.lnote.oe.1"/> wyrþe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.2" corresp="#wit-so"><pb n="154" ed="#liebermann"/>And þa blisgeras ⁊ þa þe þeof wrecan, beon þæs ylca<ptr type="liebermannNote" n="1" target="#IIAs_6-2.lnote.oe.1-2"/> wyrð.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6.2" corresp="#wit-q"><ptr type="liebermannNote" n="7" target="#IIAs_6-2.lnote.oe.7"/><pb n="155" ed="#liebermann"/>Et<ptr type="liebermannNote" n="8" target="#IIAs_6-2.lnote.oe.8"/> blasigeras<ptr type="liebermannNote" n="9" target="#IIAs_6-2.lnote.oe.9-2"/> et qui furem uindicauerint, sint eiusdem<ptr type="liebermannNote" n="10" target="#IIAs_6-2.lnote.oe.10-2"/> digni.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="6.2" corresp="#wit-h"><pb n="130" ed="#attenborough"/>Be blæserum. Ða<ptr type="editorNote" n="21" target="#IIAs_6-2.attnote.fn.21"/> blysieras<ptr type="editorNote" n="22" target="#IIAs_6-2.attnote.fn.22"/> ond þa ðe ðeof wrecen<ptr type="editorNote" n="23" target="#IIAs_6-2.attnote.fn.23"/>, beon þæs ilcan<ptr type="editorNote" n="24" target="#IIAs_6-2.attnote.fn.24"/> ryhtes wyrðe<ptr type="editorNote" n="25" target="#IIAs_6-2.attnote.fn.25"/>.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="155" ed="#liebermann"/>Von Brandstiftern.<ptr type="liebermannNote" n="1" target="#IIAs_6-2.lnote.de.1"/> Die Brandstifter<ptr type="liebermannNote" n="2" target="#IIAs_6-2.lnote.de.2"/> und die, welche einen [hingerichteten] Dieb rächen, seien desselben Strafrechtes theilhaftig.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of arsonists. The arsonists and those who avenge a [executed] thief are to be subject to the same penal law.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="131" ed="#attenborough"/>Incendiaries, and those who avenge a thief<ptr type="editorNote" n="1" target="#IIAs_6-2.attnote.n.1"/>, shall be subject to the same law.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="420" ed="#whitelock"/>Concerning incendiaries. Incendiaries and those who avenge a thief are to be subject to the same penalty.</ab>
        <note type="comparedBy" source="#wormald-mel" n="367"><ref target="clause:Blas_Inscr">Blas</ref></note>
        <note type="editorial">Ld has the marginal gloss ‘al[ias] beligeras, quod sonat: accusatores falsos’. The heading is H's.</note>
        <note type="translator" source="#whitelock">from Textus Roffensis</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_6-2.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">154</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">am Rande:</hi> al[ias] ‘beligeras’, quod sonat: accusatores falsos</seg><seg type="translation" xml:lang="en" source="#claude">in the margin: al[ias] ‘beligeras’, quod sonat: accusatores falsos</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_6-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">154</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">doppelt</hi></seg><seg type="translation" xml:lang="en" source="#claude">written twice</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_6-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">154</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_6-2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">154</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht archetyp</hi></seg><seg type="translation" xml:lang="en" source="#claude">not in the archetype</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_6-2.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">154</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_6-2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">154</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_6-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">154</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> -con</seg><seg type="translation" xml:lang="en" source="#claude">altered to -con</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_6-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">155</biblScope></bibl><seg type="original" xml:lang="de">Qui furem uindicauerit (De uindicantibus fures <hi rend="italic">Br</hi>) <hi rend="italic">Rubrik M Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Qui furem uindicauerit (De uindicantibus fures Br) rubric M Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_6-2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">155</biblScope></bibl><seg type="original" xml:lang="de">Et bl. <hi rend="italic">fehlt M Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et bl. missing in M Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_6-2.lnote.oe.9-2" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">155</biblScope></bibl><seg type="original" xml:lang="de">-sieg- <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sieg- Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_6-2.lnote.oe.10-2" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">155</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">K;</hi> eius dedigni <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius K; eius dedigni Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_6-2.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">154</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_6-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">103</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Unübersetzt, auch in Blas, Q; als <hi rend="italic">balatro</hi> (Einbläser) wird <hi rend="italic">blasere</hi> von Cons Cn u. als ‘Belüger, Betrüger’ von Ld's Anm. missdeutet. <hi rend="italic">Vgl.</hi> Toller <hi rend="italic">Suppl.: blæse, blysa</hi> ‘Fackel’, <hi rend="italic">blysian</hi> ‘brennen’</seg><seg type="translation" xml:lang="en" source="#claude">Untranslated, in Blas and Q as well; <hi rend="italic">blasere</hi> is misinterpreted as <hi rend="italic">balatro</hi> (‘one who blows in’) by Cons Cn, and as ‘liar, deceiver’ by Ld’s note. <hi rend="italic">Cf.</hi> Toller <hi rend="italic">Suppl.: blæse, blysa</hi> ‘torch’, <hi rend="italic">blysian</hi> ‘burn’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_6-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">103</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Brandstiftung 2—5; Blutrache 14 m. Feuer (<hi rend="italic">s. d. Gl</hi>) ist ein unehrlich Mittel; <hi rend="italic">vgl.</hi> v. Schwerin in <hi rend="italic">Sav. Zs. RG</hi> 33, <hi rend="italic">Germ.</hi> 412. — Das Rächen gerecht Hingerichteter (<hi rend="italic">s. d. Gl</hi> 6; bessere Übs. auch in 6, 3 weiteren Sinnes: ‘[gerecht getöteten]’) kostet Leben und Vermögen, wenn zur Bluttat vollendet</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Brandstiftung 2—5; Blutrache 14 m. Fire (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi>) is a dishonourable means; <hi rend="italic">cf.</hi> v. Schwerin in <hi rend="italic">Sav. Zs. RG</hi> 33, <hi rend="italic">Germ.</hi> 412. — Avenging men justly executed (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 6; in 6, 3 too correct the translation in the wider sense: ‘[justly slain]’) costs life and property if carried through to an act of bloodshed</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIAs_6-2.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">207</biblScope></bibl><seg type="original" xml:lang="en">The reference is to those who seek vengeance for a relative or friend who has been put to death for thieving.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_6-2.attnote.fn.21" n="21" source="#attenborough"><bibl><biblScope unit="page">130</biblScope></bibl><label>Ða</label><seg type="original" xml:lang="en"><hi rend="italic">And þa</hi>. Ld, So.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_6-2.attnote.fn.22" n="22" source="#attenborough"><bibl><biblScope unit="page">130</biblScope></bibl><label>blysieras</label><seg type="original" xml:lang="en"><hi rend="italic">al[ias]</hi> “<hi rend="italic">beligeras</hi>,” <hi rend="italic">quod sonat: accusatores falsos</hi> in the margin of Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_6-2.attnote.fn.23" n="23" source="#attenborough"><bibl><biblScope unit="page">130</biblScope></bibl><label>wrecen</label><seg type="original" xml:lang="en"><hi rend="italic">-can</hi>. Ld, So.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_6-2.attnote.fn.24" n="24" source="#attenborough"><bibl><biblScope unit="page">130</biblScope></bibl><label>ilcan</label><seg type="original" xml:lang="en"><hi rend="italic">ylca</hi>. Ld, So.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_6-2.attnote.fn.25" n="25" source="#attenborough"><bibl><biblScope unit="page">130</biblScope></bibl><label>wyrðe</label><seg type="original" xml:lang="en"><hi rend="italic">wyrð</hi>. So. om. <hi rend="italic">ryhtes</hi>. B, So.</seg></note>
      </div>
