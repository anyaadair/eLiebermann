    <body>
      <div type="clause" n="11">
        <head><ref type="lawCode" target="law:QuadrArg">Quadr Arg</ref> 11</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Arg 11" corresp="#wit-lat"><pb n="533" ed="#liebermann"/>Hinc sunt illæ leges<ptr type="liebermannNote" n="i" target="#QuadrArg_11.lnote.oe.i"/>, illa pacis federa, quo semper Angligenarum<ptr type="liebermannNote" n="k" target="#QuadrArg_11.lnote.oe.k"/> corda suspirant et modis optant<ptr type="liebermannNote" n="13" target="#QuadrArg_11.lnote.oe.13"/> omnibus, quicquid suspecta dominorum<ptr type="liebermannNote" n="l" target="#QuadrArg_11.lnote.oe.l"/> commenta nouitent et raro boni completa<ptr type="liebermannNote" n="m" target="#QuadrArg_11.lnote.oe.m"/> promissio.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 533 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_11.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">533</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">also eine Verfassung, nicht ein Codex Eadwards. Vgl.</hi> CHn cor. 13; <hi rend="italic">u.</hi> 27</seg><seg type="translation" xml:lang="en" source="#claude">thus a constitution, not a code of Eadward’s. Cf. CHn cor. 13; below 27</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_11.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">533</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier das Volk Angelsächsischer Abkunft</hi></seg><seg type="translation" xml:lang="en" source="#claude">here the people of Anglo-Saxon descent</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_11.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">533</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">die</hi> seigneurs <hi rend="italic">Französischer Abkunft; vgl. u. S.</hi> 543&lt;sup&gt;a&lt;/sup&gt;</seg><seg type="translation" xml:lang="en" source="#claude">the seigneurs of French descent; cf. below p. 543&lt;sup&gt;a&lt;/sup&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_11.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">533</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">d. h.</hi> die Politik, Rechtsherstellung zu versprechen, mit [zu] seltener Erfüllung; <hi rend="italic">derselbe Sinn wie das was</hi> pietatis recordatione preparatur 12</seg><seg type="translation" xml:lang="en" source="#claude">i.e. the policy of promising the restoration of law, with [too] rare fulfilment; the same sense as that which pietatis recordatione preparatur 12</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_11.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">533</biblScope></bibl><seg type="original" xml:lang="de">om. op. <hi rend="italic">T Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">om. op. T Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrArg_11.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. 1; <hi rend="italic">u</hi>. 27</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 1; <hi rend="italic">below</hi> 27</seg></note>
      </div>
