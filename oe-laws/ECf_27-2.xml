      <div type="clause" n="27.2">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 27.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 27.2"><pb n="651" ed="#liebermann"/>nec hoc<ptr type="liebermannNote" n="14" target="#ECf_27-2.lnote.la.14"/> sine causa<ptr type="liebermannNote" n="ff" target="#ECf_27-2.lnote.la.fn.ff"/>: de istis<ptr type="liebermannNote" n="g" target="#ECf_27-2.lnote.la.fn.g"/> enim habebat<ptr type="liebermannNote" n="15" target="#ECf_27-2.lnote.la.15"/> rex<ptr type="liebermannNote" n="16" target="#ECf_27-2.lnote.la.16"/> C sol. et comes<ptr type="liebermannNote" n="17" target="#ECf_27-2.lnote.la.17"/> comitatus L, qui tertium<ptr type="liebermannNote" n="h" target="#ECf_27-2.lnote.la.fn.h"/> denarium habet de forisfacturis<ptr type="liebermannNote" n="12" target="#ECf_27-2.lnote.la.12"/>, decanus<ptr type="liebermannNote" n="i" target="#ECf_27-2.lnote.la.fn.i"/> autem reliquos X) —, <ptr type="liebermannNote" n="a" target="#ECf_27-2.lnote.la.fn.a"/>propter<ptr type="liebermannNote" n="18" target="#ECf_27-2.lnote.la.18"/> pacem regis, scilicet de pace data<ptr type="liebermannNote" n="19" target="#ECf_27-2.lnote.la.19"/> manu regis et de primo coronatu et de<ptr type="liebermannNote" n="20" target="#ECf_27-2.lnote.la.20"/> supradictis festis: natali, pascha, pentecoste.</ab>
        <note type="comparison" source="#liebermann" n="651"><label>printed alongside</label> <ref target="clause:ECfRetr_27-2">ECf retr 27.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 651 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s letter a before “propter” is his footnote a (as at 27).</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_27-2.lnote.la.fn.ff" n="ff" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 30, 2</seg><seg type="translation" xml:lang="en" source="#claude">as at 30, 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_27-2.lnote.la.fn.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">8 £ = 100 + 50 + 10 sol.</seg><seg type="translation" xml:lang="en" source="#claude">£8 = 100 + 50 + 10 shillings</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_27-2.lnote.la.fn.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. o.</hi> 12, 10 A 1; In. Cn. III 55</seg><seg type="translation" xml:lang="en" source="#claude">cf. above, 12, 10 A 1; In. Cn. III 55</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_27-2.lnote.la.fn.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">kirchlich</hi> (<hi rend="italic">zu trennen vom</hi> decanus <hi rend="italic">in</hi> 28); <hi rend="italic">vgl. Schröder</hi> Entwickl. des Archidiakonats <hi rend="italic">S.</hi> 36</seg><seg type="translation" xml:lang="en" source="#claude">ecclesiastical (to be distinguished from the decanus in 28); cf. Schröder, Entwickl. des Archidiakonats p. 36</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_27-2.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 12—12, 3. 27, 2; <hi rend="italic">mein</hi> Über Ed. Conf. <hi rend="italic">S.</hi> 113</seg><seg type="translation" xml:lang="en" source="#claude">cf. 12–12, 3. 27, 2; my Über Ed. Conf. p. 113</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-2.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">non et <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">non et Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-2.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">habet <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">habet S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-2.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">C s. rex <hi rend="italic">Ad</hi> (<hi rend="italic">nicht Do</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">C s. rex Ad (not Do)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-2.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">comit. comes <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">comit. comes Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-2.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">foref. <hi rend="italic">Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">foref. Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-2.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Rl;</hi> preter <hi rend="italic">übr. Retr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Rl; preter the others, Retr.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-2.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">m. r. d. <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">m. r. d. Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_27-2.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
      </div>
