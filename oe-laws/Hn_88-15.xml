        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-15.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">intra <hi rend="italic">Wh;</hi> heredipedum <hi rend="italic">fügt zu K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">intra Wh; K Co Or Gi add heredipedum</seg></note>
