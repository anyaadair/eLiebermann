      <div type="clause" n="80.9a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 80.9a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 80.9a" corresp="#wit-lat"><pb n="597" ed="#liebermann"/>Cum enim in<ptr type="liebermannNote" n="8" target="#Hn_80-9a.lnote.oe.8"/> omnibus graue sit, grauius tamen est de parente<ptr type="liebermannNote" n="d" target="#Hn_80-9a.lnote.oe.d"/> domini<ptr type="liebermannNote" n="9" target="#Hn_80-9a.lnote.oe.9"/> occiso, de<ptr type="liebermannNote" n="10" target="#Hn_80-9a.lnote.oe.10"/> ministro suo, et ante eum: grauius<ptr type="liebermannNote" n="11" target="#Hn_80-9a.lnote.oe.11"/> est hoc effectum, et ouerseunessa<ptr type="liebermannNote" n="12" target="#Hn_80-9a.lnote.oe.12"/> uel multa<ptr type="liebermannNote" n="e" target="#Hn_80-9a.lnote.oe.e"/> constituta<ptr type="liebermannNote" n="13" target="#Hn_80-9a.lnote.oe.13"/> diffaçcione<ptr type="liebermannNote" n="14" target="#Hn_80-9a.lnote.oe.14"/> plectendum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 597 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-9a.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">einem Verwandten</seg><seg type="translation" xml:lang="en" source="#claude">a kinsman</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-9a.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">starke Verstümmelung</seg><seg type="translation" xml:lang="en" source="#claude">severe mutilation</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-9a.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">g. sit in o. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">g. sit in o. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-9a.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">-no <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-no Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-9a.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">di <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">di K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-9a.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">i <hi rend="italic">fügt zu, unterpunctirt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">i added, and underdotted, by Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-9a.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">-rss. <hi rend="italic">Sc oft</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rss. Sc often</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-9a.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">-tutali <hi rend="italic">Lond;</hi> uel <hi rend="italic">fügt zu Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tutali Lond; uel added by Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-9a.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">597</biblScope></bibl><seg type="original" xml:lang="de">-ccio <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ccio Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-9a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de">Zu <hi rend="italic">ministro vgl</hi>. 68, 2; <hi rend="italic">Gl</hi> Vassallität 8d; Ungehorsam 3; Schutz 4—<hi rend="italic">domino suo</hi>, aber <hi rend="italic">suo</hi> ausgestr.—<hi rend="italic">co. uel diff</hi>.{14} Rs</seg><seg type="translation" xml:lang="en" source="#claude">On <hi rend="italic">ministro cf</hi>. 68, 2; <hi rend="italic">Gl</hi> Vassallität 8d; Ungehorsam 3; Schutz 4—<hi rend="italic">domino suo</hi>, but <hi rend="italic">suo</hi> struck through.—<hi rend="italic">co. uel diff</hi>.{14} Rs</seg></note>
