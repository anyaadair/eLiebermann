        <head><ref type="lawCode" target="law:Hn">Hn</ref> 88.15</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 88.15" corresp="#wit-lat"><pb n="604" ed="#liebermann"/>Et si quis in necessitate mortali uel infirmitate uel egestate superuacue<ptr type="liebermannNote" n="h" target="#Hn_88-15.lnote.oe.h"/> deserat patrem uel parentem<ptr type="liebermannNote" n="30" target="#Hn_88-15.lnote.oe.30"/> suum, et aliquis propinquus uel extraneus in tanto uite neccessario succurret<ptr type="liebermannNote" n="31" target="#Hn_88-15.lnote.oe.31"/> ei<ptr type="liebermannNote" n="i" target="#Hn_88-15.lnote.oe.i"/>, et hereditet<ptr type="liebermannNote" n="i" target="#Hn_88-15.lnote.oe.i"/> eum in fine cum testibus et filium sibi constituat<ptr type="liebermannNote" n="i" target="#Hn_88-15.lnote.oe.i"/> de feodo uel<ptr type="liebermannNote" n="32" target="#Hn_88-15.lnote.oe.32"/> alio conquisito<ptr type="liebermannNote" n="k" target="#Hn_88-15.lnote.oe.k"/>, sapientum hoc<ptr type="liebermannNote" n="33" target="#Hn_88-15.lnote.oe.33"/> inter<ptr type="liebermannNote" n="34" target="#Hn_88-15.lnote.oe.34"/> heredipetas iudicio terminetur, sicut acciderit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 604 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-15.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 43, 8</seg><seg type="translation" xml:lang="en" source="#claude">as 43, 8</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-15.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Erblasser gemeint</hi></seg><seg type="translation" xml:lang="en" source="#claude">the testator is meant</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-15.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 70, 21</seg><seg type="translation" xml:lang="en" source="#claude">cf. 70, 21</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-15.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">parentelam suam <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">parentelam suam Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-15.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">-reret <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-reret Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-15.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">de <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Lond adds de</seg></note>
