    <body>
      <div type="clause" n="Prol.">
        <head><ref type="lawCode" target="law:VIAtrLat">VI Atr Lat</ref> Prol.</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Prol." corresp="#wit-k"><pb n="247" ed="#liebermann"/>Quodam tempore contigit, ut regis Æþelredi edicto concrepante<ptr type="liebermannNote" n="a" target="#VI-Atr-Latin-Paraphrase_Prol.lnote.oe.a"/>, archipresulumque Ælfeahi<ptr type="liebermannNote" n="b" target="#VI-Atr-Latin-Paraphrase_Prol.lnote.oe.b"/> et Þulfstani<ptr type="liebermannNote" n="c" target="#VI-Atr-Latin-Paraphrase_Prol.lnote.oe.c"/> hortatu instigante, uniuersi Anglorum optimates die sancto pentecosten ad locum ab indigenis Eanham<ptr type="liebermannNote" n="d" target="#VI-Atr-Latin-Paraphrase_Prol.lnote.oe.d"/> nominatum acciti sunt<ptr type="liebermannNote" n="1" target="#VI-Atr-Latin-Paraphrase_Prol.lnote.oe.1"/> conuenire.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:XAtr_Prol-to-3">X Atr Prol. 3</ref></note>
        <note type="editorial">Latin paraphrase of VI Atr (early 11th c.; K = Cotton Claudius A III f. 30), text in column K (Liebermann’s text; until October 2026 in column T). This passage has no Old English equivalent; Liebermann gives no German translation.; T: corrected against Gesetze I, October 2026 (was “(Liebermann’s Latin Paraphrase)”, now “∅ (moved to K)”)</note>
        <note type="liebermannNote" subtype="textual" xml:id="VI-Atr-Latin-Paraphrase_Prol.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">247</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VI-Atr-Latin-Paraphrase_Prol.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">174</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">conoperante</hi> bisheriger Texte war falsche Lesung. Ducange kennt <hi rend="italic">concrepare</hi> für <hi rend="italic">consentire</hi>. Nur hier ist, unzweifelhaft richtig, Æthelreds Name erwähnt; <hi rend="italic">s. o</hi>. Einl. 13</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">conoperante</hi> of earlier texts was a misreading. Ducange knows <hi rend="italic">concrepare</hi> in the sense of <hi rend="italic">consentire</hi>. Only here is Æthelred’s name mentioned, undoubtedly correctly; <hi rend="italic">see above</hi> Introduction 13</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VI-Atr-Latin-Paraphrase_Prol.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">174</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Von Canterbury; <hi rend="italic">s. o</hi>. Einl. 4</seg><seg type="translation" xml:lang="en" source="#claude">Of Canterbury; <hi rend="italic">see above</hi> Introduction 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VI-Atr-Latin-Paraphrase_Prol.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">174</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">von York; <hi rend="italic">s. ebd</hi>. 7. 19</seg><seg type="translation" xml:lang="en" source="#claude">of York; <hi rend="italic">see ibid</hi>. 7. 19</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="VI-Atr-Latin-Paraphrase_Prol.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">174</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Von Canterbury; <hi rend="italic">s. o</hi>. Einl. 4</seg><seg type="translation" xml:lang="en" source="#claude">Of Canterbury; <hi rend="italic">see above</hi> Introduction 4</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VI-Atr-Latin-Paraphrase_Prol.lnote.de.1" n="1" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">174</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Synonym für <hi rend="italic">witan; s. d. Gl</hi> 1 Z. 5. 10; Einl. 14f.</seg><seg type="translation" xml:lang="en" source="#claude">Synonym for <hi rend="italic">witan</hi>; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1 ll. 5. 10; Introduction 14f.</seg></note>
      </div>
    </body>
