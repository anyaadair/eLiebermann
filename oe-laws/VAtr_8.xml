    <body>
      <div type="clause" n="8">
        <head><ref type="lawCode" target="law:VAtr">V Atr</ref> 8</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8" corresp="#wit-g"><pb n="238" ed="#liebermann"/>⁊ ealle mæssepreostas we biddað ⁊ lærað, þ<hi rend="italic">æt</hi> hy beorgan heom sylfum wið Godes yrre.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8" corresp="#wit-g2"><pb n="238" ed="#liebermann"/>⁊ ealle mæssepr<hi rend="italic">eostas</hi> we biddað ⁊ læreið<ptr type="liebermannNote" n="1" target="#VAtr_8.lnote.oe.1"/>, þ<hi rend="italic">æt</hi> hy beorgan heom sylfu<hi rend="italic">m</hi> wið Godes yrre.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8" corresp="#wit-d"><pb n="239" ed="#liebermann"/>And ealle mæssepreostas we biddað ⁊ lærað, þ<hi rend="italic">æt</hi> hi beorgan heo<hi rend="italic">m</hi> silfu<hi rend="italic">m</hi> wið Godes irre.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="8" corresp="#wit-d"><pb n="80" ed="#robertson"/>And ealle mæssepreostas we biddað ⁊ lærað þæt hi beorgan heom silfum wið Godes irre.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g"><pb n="148" ed="#rabin-doml"/>And ealle mæssepreostas we biddað and lærað þæt hy beorgan heom sylfum wið Godes yrre.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="239" ed="#liebermann"/>Und<ptr type="liebermannNote" n="1" target="#VAtr_8.lnote.de.1"/> alle Priester bitten wir und weisen wir an, dass sie sich selbst vor<ptr type="liebermannNote" n="2" target="#VAtr_8.lnote.de.2"/> Gottes Zorne hüten.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And we ask and instruct all priests to guard themselves against God's anger.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d"><ptr type="editorNote" n="1" target="#VAtr_8.robnote.n.1"/><pb n="81" ed="#robertson"/>And we pray and admonish all priests to guard against incurring the wrath of God.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-g"><pb n="449" ed="#whitelock"/>And we pray and instruct all mass-priests to protect themselves from God’s anger.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g"><pb n="149" ed="#rabin-doml"/>And we require and instruct all priests to protect themselves against the wrath of God.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="VAtr_8.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">238</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_8.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">172</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">= VI 5 = I Cn 6, 1 = <hi rend="italic">Hom. n</hi>. Wulfstan 269</seg><seg type="translation" xml:lang="en" source="#claude">= VI 5 = I Cn 6, 1 = <hi rend="italic">Hom. n</hi>. Wulfstan 269</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VAtr_8.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">172</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Diese Drohung <hi rend="italic">s. Gl</hi> Gott 3</seg><seg type="translation" xml:lang="en" source="#claude">On this threat see <hi rend="italic">Gl</hi> Gott 3</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="VAtr_8.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="en">Cf. VI, 5; I Cn. 6, 1; Wulfstan, p. 269.</seg></note>
      </div>
