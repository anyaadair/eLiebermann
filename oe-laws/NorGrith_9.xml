    <body>
      <div type="clause" n="9">
        <head><ref type="lawCode" target="law:NorGrith">Nor Grið</ref> 9</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="9" corresp="#wit-g-b"><pb n="473" ed="#liebermann"/>æghwar be mæðe ofer ealle ðam rice.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" n="4[b]" corresp="#wit-g-b"><pb n="32" ed="#rabin-doml"/>æghwar be mæðe ofer ealle ðam rice.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="473" ed="#liebermann"/>[Fortsetzung von 4]</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">[Continuation of clause 4; see line 8.]</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-b"><pb n="33" ed="#rabin-doml"/>everywhere according to its degree over the entire kingdom.</ab>
      </div>
