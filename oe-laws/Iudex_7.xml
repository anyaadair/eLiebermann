    <body>
      <div type="clause" n="7">
        <head><ref type="lawCode" target="law:Iudex">Iudex</ref> 7</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7" corresp="#wit-g-a"><pb n="475" ed="#liebermann"/>Se þe þam unscyldigan sceððeþ, oððe þam scyldegan scyldeþ for metsceattu<hi rend="italic">m<ptr type="liebermannNote" n="1" target="#Iudex_7.lnote.oe.1-2"/></hi> oðð<ptr type="liebermannNote" n="2" target="#Iudex_7.lnote.oe.2-2"/> for æniges mannes lufan oððe feonge, he biþ eft geniðerad fra<hi rend="italic">m</hi> ða<hi rend="italic">m</hi> ecan deman.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7" corresp="#wit-q"><pb n="475" ed="#liebermann"/>Qui innocentem opprimit<ptr type="liebermannNote" n="1" target="#Iudex_7.lnote.oe.1"/> et dimittit noxium pro pecunia uel amicitia<ptr type="liebermannNote" n="2" target="#Iudex_7.lnote.oe.2"/> uel odio uel quacumque factione<ptr type="liebermannNote" n="a" target="#Iudex_7.lnote.oe.a"/>, opprimetur ab omnipotente<ptr type="liebermannNote" n="3" target="#Iudex_7.lnote.oe.3"/> iudice.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="475" ed="#liebermann"/>Wer dem Unschuldigen<ptr type="liebermannNote" n="1" target="#Iudex_7.lnote.de.1"/> schadet oder den Schuldigen schirmt für Lohngelder oder aus Liebe oder Hass zu jemandem, der wird später verdammt werden von dem ewigen Richter.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Whoever harms the innocent or shields the guilty for bribes or out of love or hatred for anyone will later be condemned by the eternal Judge.</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-g-a">Whoever harms the guiltless or shields the guilty for money, or for hatred or love of any man, he will afterwards be condemned by the eternal judge.</ab>
        <note type="comparison" source="#liebermann" n="475">Isidor, Sent. III 54.7; <ref target="clause:Iudex_3">Iudex 3</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Isidor, Sent. III 54, 7 | *(s. o. 3)</note>
        <note type="editorial">U: translator unrecorded: check; Isidore, Sent. III 54.7.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_7.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de">-mat et dimittat <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">-mat et dimittat <hi rend="italic">Br</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_7.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de">auaritia <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">auaritia <hi rend="italic">T</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_7.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">für</hi> fæhðe <hi rend="italic">Ine</hi> 74, 2</seg><seg type="translation" xml:lang="en" source="#claude">for fæhðe Ine 74, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_7.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de">-ti <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ti <hi rend="italic">R</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_7.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Iudex_7.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">475</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vom Schreiber</hi> oððe <hi rend="italic">verbessert</hi> [<hi rend="italic">aber vgl. II Cn.</hi> 30, 5, <hi rend="italic">Hs. A</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">oððe corrected by the scribe [but cf. II Cn. 30, 5, MS A]</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Iudex_7.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">269</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Hie gescyldað þa unscyldigan</hi> heisst es umgekehrt von guten Richtern <hi rend="italic">ebd</hi>. 63; <hi rend="italic">s. o</hi>. 3²</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Hie gescyldað þa unscyldigan</hi> is said, conversely, of good judges, <hi rend="italic">ibid</hi>. 63; <hi rend="italic">see above</hi> 3²</seg></note>
      </div>
