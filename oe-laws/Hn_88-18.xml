    <body>
      <div type="clause" n="88.18">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 88.18</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 88.18" corresp="#wit-lat"><pb n="604" ed="#liebermann"/>Et si plures aliqui faciant homicidium, quorum crocca<ptr type="liebermannNote" n="m" target="#Hn_88-18.lnote.oe.m"/><ptr type="liebermannNote" n="39" target="#Hn_88-18.lnote.oe.39"/> towallet<ptr type="liebermannNote" n="40" target="#Hn_88-18.lnote.oe.40"/>, si uelint, simul<ptr type="liebermannNote" n="41" target="#Hn_88-18.lnote.oe.41"/> componant.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 604 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-18.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">glossirt</hi> 94, 3<hi rend="italic">a</hi>; <hi rend="italic">auch franz. steht</hi> pot <hi rend="italic">für</hi> Wirthschaft, Haushaltung (<hi rend="italic">Beaune</hi> Introd. du droit cout. 396. 416 <hi rend="italic">aus</hi> 13. <hi rend="italic">Jh.</hi>) <hi rend="italic">und</hi> bouillir <hi rend="italic">für deren</hi> unterhalten werden; <hi rend="italic">Littré</hi> Dict. 1237. <hi rend="italic">Sinn erfordert</hi> non</seg><seg type="translation" xml:lang="en" source="#claude">glossed 94, 3<hi rend="italic">a</hi>; in French too, pot stands for household economy, housekeeping (Beaune Introd. du droit cout. 396. 416, from the 13th cent.), and bouillir for being maintained by it; Littré Dict. 1237. The sense requires non</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-18.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">-cum <hi rend="italic">Schmid falsch;</hi> -cta <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cum Schmid, wrongly; -cta Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-18.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">cowellet <hi rend="italic">Sc;</hi> towellent <hi rend="italic">Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">cowellet Sc; towellent Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-18.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">604</biblScope></bibl><seg type="original" xml:lang="de">s. c. Si n. <hi rend="italic">überspringt Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">Co Or Gi skip s. c. Si n.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_88-18.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">potwalter</hi> heisst im 18. Jh. ‘Haushaltsbesitzer und daher wahlberechtigt’. <hi rend="italic">Vgl. Gl</hi> Hausgemeinschaft 2; gemeinschaftliche Missetat 7</seg><seg type="translation" xml:lang="en" source="#claude">In the 18th cent. <hi rend="italic">potwalter</hi> means ‘householder, and hence entitled to vote’. <hi rend="italic">Cf. Gl</hi> Hausgemeinschaft 2; gemeinschaftliche Missetat 7</seg></note>
      </div>
