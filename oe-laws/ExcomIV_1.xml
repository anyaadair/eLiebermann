      <div type="clause" n="1">
        <head><ref type="lawCode" target="law:ExcomIV">Excom IV</ref> 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom IV 1" corresp="#wit-ci"><pb n="435" ed="#liebermann"/>Ex auctoritate Patris et Filii et Spiritus sancti maledicimus et excommunicamus et a<ptr type="liebermannNote" n="b" target="#ExcomIV_1.lnote.oe.b"/> consortio Christianorum sequestramus<ptr type="liebermannNote" n="1" target="#ExcomIV_1.lnote.oe.1"/> temerarium depredatorem<ptr type="liebermannNote" n="c" target="#ExcomIV_1.lnote.oe.c"/> sacrarum<ptr type="liebermannNote" n="2" target="#ExcomIV_1.lnote.oe.2"/> ęcclesiasticarumque rerum, necnon et<ptr type="liebermannNote" n="d" target="#ExcomIV_1.lnote.oe.d"/> consentaneos, participes et adiutores huius uiolentissime presumptionis N.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 435 (two independent readings of the page images, differences settled against the page); Liebermann’s heading: [IV. aus Ci]; F: corrected against Liebermann, Gesetze I (date at the head of the text); Wormald, Making of English Law I; Whitelock, English Historical Documents I, October 2026 (was “c. 900–c. 1050 (Liebermann)”, now “c. 900–c. 1050 (Liebermann, I p. 435)”)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomIV_1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">435</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Hs. Cambridge Corpus</hi> 146 <hi rend="italic">letztes Blatt, p.</hi> 329, <hi rend="italic">Ende</hi> 11. <hi rend="italic">Jhs.; vgl. o. S.</hi> 401<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">MS Cambridge Corpus</hi> 146 <hi rend="italic">last leaf, p.</hi> 329, <hi rend="italic">end of the</hi> 11. <hi rend="italic">cent.; cf. above p.</hi> 401<hi rend="italic">b</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomIV_1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">435</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> I 11, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> I 11, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomIV_1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">435</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> I 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> I 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomIV_1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">435</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> I 11, 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> I 11, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomIV_1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">435</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt Rasur dreier Wörter</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">followed by an erasure of three words</hi></seg></note>
