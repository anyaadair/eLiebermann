      <div type="clause" n="9.2">
        <head><ref type="lawCode" target="law:IVAtr">IV Atr</ref> 9.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="9.2" corresp="#wit-q"><pb n="236" ed="#liebermann"/>Et ipsi qui portos<ptr type="liebermannNote" n="15" target="#IVAtr_9-2.lnote.oe.15"/> custodiunt, efficiant per ouerhyrnessam<ptr type="liebermannNote" n="16" target="#IVAtr_9-2.lnote.oe.16"/> meam, ut omne pondus sit<ptr type="liebermannNote" n="17" target="#IVAtr_9-2.lnote.oe.17"/> marcatum ad pondus quo pecunia mea recipitur; et eorum singulum signetur ita, cur<ptr type="liebermannNote" n="18" target="#IVAtr_9-2.lnote.oe.18"/> (quod) XV<ptr type="liebermannNote" n="19" target="#IVAtr_9-2.lnote.oe.19"/> ore<ptr type="liebermannNote" n="20" target="#IVAtr_9-2.lnote.oe.20"/> libram faciant.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="9.2" corresp="#wit-q"><pb n="78" ed="#robertson"/>Et ipsi qui portos<ptr type="editorNote" n="1" target="#IVAtr_9-2.robnote.fn.1"/> custodiunt, efficiant per overhernessam meam, ut omne pondus sit marcatum ad pondus quo pecunia mea recipitur; et eorum singulum signetur ita, cur<ptr type="editorNote" n="2" target="#IVAtr_9-2.robnote.fn.2"/> XV<ptr type="editorNote" n="3" target="#IVAtr_9-2.robnote.fn.3"/> orae libram<ptr type="editorNote" n="4" target="#IVAtr_9-2.robnote.fn.4"/> faciant.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="237" ed="#liebermann"/>Und sie, die die Städte [für mich] verwalten<ptr type="liebermannNote" n="1" target="#IVAtr_9-2.lnote.de.1"/>, sollen, bei [Strafe der Busse für] Ungehorsam gegen mich, bewirken, dass jedes Gewicht gezeichnet werde, gemäss<ptr type="liebermannNote" n="2" target="#IVAtr_9-2.lnote.de.2"/> dem Gewicht, wonach meine Münze angenommen wird; und deren jedes werde so gezeichnet, dass 15 Ör ein Pfund ausmachen.<ptr type="liebermannNote" n="3" target="#IVAtr_9-2.lnote.de.3"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And those who govern the towns [for me] are, on [pain of the fine for] disobedience to me, to bring it about that every weight be marked according to the weight by which my money is received; and that each of them be marked so that 15 ores make a pound.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q"><pb n="79" ed="#robertson"/>And those who have the charge of towns shall see to it, under pain of incurring the fine for insubordination to me, that every weight is stamped according to the standard employed in my mint<ptr type="editorNote" n="1" target="#IVAtr_9-2.robnote.n.1"/>; and the stamp used for each of them shall show that the pound contains 15 ores<ptr type="editorNote" n="2" target="#IVAtr_9-2.robnote.n.2"/>.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_9-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">236</biblScope></bibl><seg type="original" xml:lang="de">porcos <hi rend="italic">RT</hi></seg><seg type="translation" xml:lang="en" source="#claude">porcos RT</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_9-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">236</biblScope></bibl><seg type="original" xml:lang="de">-her. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">-her. R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_9-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">236</biblScope></bibl><seg type="original" xml:lang="de">m. ad p. sit <hi rend="italic">TMHk;</hi> ad m. sit p. <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">m. ad p. sit TMHk; ad m. sit p. Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_9-2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">236</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> cur <hi rend="italic">RT; nur</hi> q. <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">only cur RT; only q. MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_9-2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">236</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_9-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">236</biblScope></bibl><seg type="original" xml:lang="de">bilibram <hi rend="italic">statt</hi> o. l. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">bilibram instead of o. l. T</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_9-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">166</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">(<hi rend="italic">ge</hi>)<hi rend="italic">healdan</hi> sagte Original.—<hi rend="italic">Vgl. Gl</hi> Stadt 13; Vogt 18; Ungehorsam 6</seg><seg type="translation" xml:lang="en" source="#claude">The original said (<hi rend="italic">ge</hi>)<hi rend="italic">healdan</hi>.—<hi rend="italic">Cf. Gl</hi> Stadt 13; Vogt 18; Ungehorsam 6</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_9-2.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">166</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Gewicht 7. 8</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Gewicht 7. 8</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_9-2.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">166</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Ör 4; Amira <hi rend="italic">Westnord. Obligat</hi>. 518</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Ör 4; Amira <hi rend="italic">Westnord. Obligat</hi>. 518</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_9-2.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">326</biblScope></bibl><seg type="original" xml:lang="en">Lit. ‘according to the weight for which my money is accepted.’</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_9-2.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">326</biblScope></bibl><seg type="original" xml:lang="en">The ore, according to this reckoning, contains 16 pence, a value which is supported by other evidence, see Chadwick, <hi rend="italic">A.S. Institutions</hi>, pp. 24 f., 412. In Domesday Book an ore of 20 pence is frequently mentioned.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_9-2.robnote.fn.1" n="1" source="#robertson"><bibl><biblScope unit="page">78</biblScope></bibl><label>portos</label><seg type="original" xml:lang="en"><hi rend="italic">porcos</hi> R, T.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_9-2.robnote.fn.2" n="2" source="#robertson"><bibl><biblScope unit="page">78</biblScope></bibl><label>cur</label><seg type="original" xml:lang="en"><hi rend="italic">quod</hi> Hk.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_9-2.robnote.fn.3" n="3" source="#robertson"><bibl><biblScope unit="page">78</biblScope></bibl><label>xv</label><seg type="original" xml:lang="en">Om. Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_9-2.robnote.fn.4" n="4" source="#robertson"><bibl><biblScope unit="page">78</biblScope></bibl><label>libram</label><seg type="original" xml:lang="en"><hi rend="italic">bilibram</hi> inst. of <hi rend="italic">o. l.</hi> T.</seg></note>
      </div>
    </body>
