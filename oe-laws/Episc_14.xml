    <body>
      <div type="clause" n="14">
        <head><ref type="lawCode" target="law:Episc">Episc</ref> 14</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="14" corresp="#wit-x"><pb n="479" ed="#liebermann"/>Ealle we syndon Godes ágene nydþeowan; ⁊ swa he gedemð ús, swa we her demað þam þe we on eorðan dom ofer ágan.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="14" corresp="#wit-q"><pb n="479" ed="#liebermann"/>Et omnes sumus Dei<ptr type="liebermannNote" n="15" target="#Episc_14.lnote.oe.15"/> necessario-serui; et sic iudicabit nobis<ptr type="liebermannNote" n="16" target="#Episc_14.lnote.oe.16"/>, sicut ante<ptr type="liebermannNote" n="17" target="#Episc_14.lnote.oe.17"/> iudicauimus<ptr type="liebermannNote" n="18" target="#Episc_14.lnote.oe.18"/> eis<ptr type="liebermannNote" n="19" target="#Episc_14.lnote.oe.19"/>, quibus in<ptr type="liebermannNote" n="20" target="#Episc_14.lnote.oe.20"/> terris iudicium superhabebimus<ptr type="liebermannNote" n="21" target="#Episc_14.lnote.oe.21"/>.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-x"><pb n="106" ed="#rabin-doml"/>Ealle we syndon Godes agene nydþeowan; and swa he gedemð us, swa we her demað þam þe we on eorðan dom ofer agan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="479" ed="#liebermann"/>Alle sind wir Gottes eigene Knechte; und er<ptr type="liebermannNote" n="a" target="#Episc_14.lnote.de1.a"/> wird uns so richten, wie wir hienieden die richten, über die wir auf Erden Verfügung [Rechtsprechung] besitzen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">We are all God's own slaves; and he will judge us as we here judge those over whom we have authority [jurisdiction] on earth.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-x"><pb n="107" ed="#rabin-doml"/>We are all God’s own slaves, and he judges us just as we judge those over whom we hold power here on earth.</ab>
        <note type="passageSource">Matthew 7:2</note>
        <note type="comparison" source="#liebermann" n="479">Matth. 7, 2</note>
        <note type="comparisonPrinted" source="#liebermann">Matth. 7, 2</note>
        <note type="editorial">Liebermann compares Iudex 5.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_14.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">479</biblScope></bibl><seg type="original" xml:lang="de">Deo <hi rend="italic">M</hi></seg><seg type="translation" xml:lang="en" source="#claude">Deo M</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_14.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">479</biblScope></bibl><seg type="original" xml:lang="de">nos <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">nos K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_14.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">479</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus</hi> ær? <hi rend="italic">Vgl.</hi> nú <hi rend="italic">Iudex</hi> 5</seg><seg type="translation" xml:lang="en" source="#claude">from ær? Cf. nú Iudex 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_14.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">479</biblScope></bibl><seg type="original" xml:lang="de">-abimus <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-abimus K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_14.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">479</biblScope></bibl><seg type="original" xml:lang="de">eos <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">eos Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_14.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">479</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> iu. superhabuimus ín t. <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Lond; iu. superhabuimus ín t. the rest</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Episc_14.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">479</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Or</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="Episc_14.lnote.de1.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">479</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Iudex 5</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> Iudex 5</seg></note>
      </div>
