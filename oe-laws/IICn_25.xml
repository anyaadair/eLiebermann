        <note type="liebermannNote" subtype="textual" xml:id="IICn_25.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de">þæs <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þæs Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_25.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de">ðrywa, ð. scepige m. of feoƿrdam <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðrywa, ð. scepige m. of feoƿrdam Ld</seg></note>
