    <body>
      <div type="clause" n="1.4">
        <head><ref type="lawCode" target="law:Af">Af</ref> 1.4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.4" corresp="#wit-e"><pb n="48" ed="#liebermann"/>Gif hine mon togenedan<ptr type="liebermannNote" n="15" target="#Af_1-4.lnote.oe.15"/> scyle, ⁊ he elles nylle, gif hine mon gebinde, þolige his wæpna<ptr type="liebermannNote" n="16" target="#Af_1-4.lnote.oe.16"/> ⁊ his ierfes.<ptr type="liebermannNote" n="17" target="#Af_1-4.lnote.oe.17"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.4" corresp="#wit-h"><pb n="48" ed="#liebermann"/>Gif hine man togenydan scyle, ⁊ he elles nylle, gif hine man gebinde, þolie his wæpna and his yrfes.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.4" corresp="#wit-q"><pb n="49" ed="#liebermann"/>Et si cogi oporteat et aliter nolit, si ligetur, perdat arma sua cum<ptr type="liebermannNote" n="7" target="#Af_1-4.lnote.oe.7"/> tota<ptr type="liebermannNote" n="8" target="#Af_1-4.lnote.oe.8"/> pecunia sua.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="62" ed="#attenborough"/>Gif hine mon togenedan<ptr type="editorNote" n="16" target="#Af_1-4.attnote.fn.16"/> scyle, ⁊ he elles nylle, gif hine mon gebinde, þolige<ptr type="editorNote" n="17" target="#Af_1-4.attnote.fn.17"/> his wæpna ⁊ his ierfes.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="1.4" corresp="#wit-e"><pb n="288" ed="#jurasinski-and-oliver"/>Gif hine mon togenedan scyle, ⁊ he elles nylle, gif hine mon gebinde, þolige his wæpna ⁊ his ierfes.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="49" ed="#liebermann"/>Wenn man<ptr type="liebermannNote" n="1" target="#Af_1-4.lnote.de.1"/> ihn zur [Gefängnisstrafe] zwingen muss, und er anders nicht [sich fügen] will, wenn man ihn bindet, so verliere er<ptr type="liebermannNote" n="2" target="#Af_1-4.lnote.de.2"/> seine Waffen und sein Eigenthum.<ptr type="liebermannNote" n="3" target="#Af_1-4.lnote.de.3"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he has to be compelled [to the imprisonment], and will not [submit] otherwise, if he is bound, let him forfeit his weapons and his property.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="63" ed="#attenborough"/>If he will not submit unless force is used against him, [i.e.] if he has to be bound, he shall forfeit his weapons and his property.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="410" ed="#whitelock"/>If he has to be forced thither, and will not go otherwise, and he is bound, he is to forfeit his weapons and his possessions.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="289" ed="#jurasinski-and-oliver"/>If he has to be forced thither, and he resists, if he needs to be bound, let him forfeit his weapons and his property.</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="288"><label>parallel usage</label> <ref target="clause:Af_El-to-11">Af El 11</ref> <quote>see MP §11 and Ine §6 for parallel uses as "possessions."</quote></note>
        <note type="comparison" source="#jurasinski-and-oliver" n="288"><label>parallel usage</label> <ref target="clause:Ine_6">Ine 6</ref> <quote>see MP §11 and Ine §6 for parallel uses as "possessions."</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_1-4.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">48</biblScope></bibl><seg type="original" xml:lang="de">-neodan <hi rend="italic">So;</hi> -nydan <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-neodan So; -nydan Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_1-4.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">48</biblScope></bibl><seg type="original" xml:lang="de">pæpna <hi rend="italic">E</hi></seg><seg type="translation" xml:lang="en" source="#claude">pæpna E</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_1-4.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">48</biblScope></bibl><seg type="original" xml:lang="de">yrfes <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">yrfes So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_1-4.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">49</biblScope></bibl><seg type="original" xml:lang="de">et totam pecuniam suam <hi rend="italic">Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">et totam pecuniam suam Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_1-4.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">49</biblScope></bibl><seg type="original" xml:lang="de">p. s. t. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. s. t. Lond</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_1-4.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">50</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Strafvollzug (<hi rend="italic">s. d. Gl</hi> 2, wo dies nachzutragen) gehört dem Kläger wie 2, 1, nicht dem Richter, laut 1, 5. — Statt des nächsten ‘und’ setze besser ‘indem’</seg><seg type="translation" xml:lang="en" source="#claude">The execution of the penalty (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 2, where this should be added) belongs to the plaintiff, as in 2, 1, not to the judge, according to 1, 5. — For the next ‘and’ it would be better to put ‘in that’</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_1-4.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">50</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">dauernd, vermutlich an den Gerichtsherrn, also anders als 1, 2</seg><seg type="translation" xml:lang="en" source="#claude">permanently, presumably to the lord of the court, and thus differently from 1, 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_1-4.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">50</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘Fahrhabe’ Q, Schmid, vermutlich meistens richtig, da Land noch grossenteils der Familie gehörte; Toller nimmt die weitere Bed. ‘property, possessions’ an</seg><seg type="translation" xml:lang="en" source="#claude">‘movable goods’ Q, Schmid, presumably correct in most cases, since land still belonged largely to the family; Toller assumes the wider meaning ‘property, possessions’</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_1-4.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">62</biblScope></bibl><label>togenedan</label><seg type="original" xml:lang="en"><hi rend="italic">togenydan</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_1-4.attnote.fn.17" n="17" source="#attenborough"><bibl><biblScope unit="page">62</biblScope></bibl><label>þolige</label><seg type="original" xml:lang="en"><hi rend="italic">þolie</hi>. H.</seg></note>
      </div>
    </body>
