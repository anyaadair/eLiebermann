      <div type="clause" n="11.1">
        <head><ref type="lawCode" target="law:IudDeiXIII">Iud Dei XIII</ref> 11.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XIII 11.1" corresp="#wit-lat"><pb n="423" ed="#liebermann"/>Adiuro<ptr type="liebermannNote" n="33" target="#IudDeiXIII_11-1.lnote.oe.33"/> te, homo N.<ptr type="liebermannNote" n="34" target="#IudDeiXIII_11-1.lnote.oe.34"/>, per Patrem et Filium et Spiritum sanctum, per<ptr type="liebermannNote" n="35" target="#IudDeiXIII_11-1.lnote.oe.35"/> diem tremendi iudicii, per IIII euangelistas, per XXIIII seniores, qui indefessa uoce Deum laudare non cessant, per duodecim apostolos, per uictoriam martyrum, per inuocationem sacri baptismatis tui, ut, si tu de hac re culpabilis sis, siue<ptr type="liebermannNote" n="36" target="#IudDeiXIII_11-1.lnote.oe.36"/> in facto aut aliquo<ptr type="liebermannNote" n="37" target="#IudDeiXIII_11-1.lnote.oe.37"/>, indurato corde a diaboli suggestione, ad hoc iudicium non<ptr type="liebermannNote" n="38" target="#IudDeiXIII_11-1.lnote.oe.38"/> præsumptuosus accedas, et<ptr type="liebermannNote" n="11" target="#IudDeiXIII_11-1.lnote.oe.11"/> aqua te non suscipiat, et<ptr type="liebermannNote" n="11" target="#IudDeiXIII_11-1.lnote.oe.11"/> hoc signo crucis Christi tua malicia appareat, et uirtus omnipotentis Dei manifestetur.</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Apoc. 4, 10</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 423 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_11-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_11-1.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">11, 1 = <hi rend="italic">Zeu.</hi> 664&lt;sub&gt;27&lt;/sub&gt;</seg><seg type="translation" xml:lang="en" source="#claude">11, 1 = Zeu. 664&lt;sub&gt;27&lt;/sub&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_11-1.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_11-1.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> V 2 <hi rend="italic">o. S.</hi> 411, VII 23 <hi rend="italic">o. S.</hi> 414, VIII 2 <hi rend="italic">o. S.</hi> 415</seg><seg type="translation" xml:lang="en" source="#claude">cf. V 2 above p. 411, VII 23 above p. 414, VIII 2 above p. 415</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_11-1.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> in al. et <hi rend="italic">statt</hi> s. in f. aut al. <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">only in al. et instead of s. in f. aut al. Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_11-1.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> modo <hi rend="italic">aus Zeu.</hi> 664&lt;sub&gt;31&lt;/sub&gt;</seg><seg type="translation" xml:lang="en" source="#claude">supply modo from Zeu. 664&lt;sub&gt;31&lt;/sub&gt;</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXIII_11-1.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">423</biblScope></bibl><seg type="original" xml:lang="de">nunc <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">nunc Tr</seg></note>
      </div>
