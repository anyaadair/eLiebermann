      <div type="clause" n="7">
        <head><ref type="lawCode" target="law:ExcomVI">Excom VI</ref> 7</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom VI 7" corresp="#wit-ca"><pb n="436–437" ed="#liebermann"/>Maledictus sit in uia<ptr type="liebermannNote" n="v" target="#ExcomVI_7.lnote.oe.v"/> et in uilla<ptr type="liebermannNote" n="w" target="#ExcomVI_7.lnote.oe.w"/>. Maledictus sit in silua<ptr type="liebermannNote" n="x" target="#ExcomVI_7.lnote.oe.x"/> et in mercato<ptr type="liebermannNote" n="5" target="#ExcomVI_7.lnote.oe.5"/> (foro). Maledictus sit in mari<ptr type="liebermannNote" n="6" target="#ExcomVI_7.lnote.oe.6"/><ptr type="liebermannNote" n="y" target="#ExcomVI_7.lnote.oe.y"/> et extra mare. Maledictus sit in omnibus<ptr type="liebermannNote" n="a" target="#ExcomVI_7.lnote.oe.a"/> omnino locis.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 436–437 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVI_7.lnote.oe.v" n="v" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">436</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> V 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> V 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVI_7.lnote.oe.w" n="w" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">436</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Sen</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf. Sen</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVI_7.lnote.oe.x" n="x" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">436</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> VIII 19</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> VIII 19</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVI_7.lnote.oe.y" n="y" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">436</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> VII 13. X 5. XI 6. <hi rend="italic">Sen Rot</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> VII 13. X 5. XI 6. <hi rend="italic">Sen Rot</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVI_7.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">436</biblScope></bibl><seg type="original" xml:lang="de">fo. <hi rend="italic">andere Hand über ausgeschriebenem</hi> me.</seg><seg type="translation" xml:lang="en" source="#claude">fo. in another hand above me. written out in full</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVI_7.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">436</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">gebessert aus</hi> mare</seg><seg type="translation" xml:lang="en" source="#claude">corrected from mare</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVI_7.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">437</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> V 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> V 4</seg></note>
