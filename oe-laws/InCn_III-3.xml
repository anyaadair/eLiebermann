      <div type="clause" n="III 3">
        <head><ref type="lawCode" target="law:InCn">In Cn</ref> III 3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="In Cn III 3" corresp="#wit-lat"><pb n="613" ed="#liebermann"/>Qui calumniatur<ptr type="liebermannNote" n="15" target="#InCn_III-3.lnote.oe.15"/> de hloth<ptr type="liebermannNote" n="11" target="#InCn_III-3.lnote.oe.11"/>, sí negauerit, ita sé purget: acceptis<ptr type="liebermannNote" n="d" target="#InCn_III-3.lnote.oe.d"/> undecim hominibus, et ipse sit duodecimus; aut despectum<ptr type="liebermannNote" n="e" target="#InCn_III-3.lnote.oe.e"/> calumniantis persoluat et duas libras pro<ptr type="liebermannNote" n="16" target="#InCn_III-3.lnote.oe.16"/> forisfactura ei det qui habet consuetudines<ptr type="liebermannNote" n="f" target="#InCn_III-3.lnote.oe.f"/> suas.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 613 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-3.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">120 Hiden <hi rend="italic">fordert Ine</hi> 14; <hi rend="italic">jeder Eideshelfer stellt also hier</hi> 10 <hi rend="italic">Hiden dar, wie auch im</hi> Quadr. Ine 19. 46</seg><seg type="translation" xml:lang="en" source="#claude">Ine 14 requires 120 hides; each oath-helper here therefore represents 10 hides, as also in Quadr. Ine 19. 46</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-3.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">mundbrece III 56; calumnians <hi rend="italic">ist hier und</hi> III 4 der Geschädigte</seg><seg type="translation" xml:lang="en" source="#claude">mundbrece III 56; calumnians here and in III 4 is the injured party</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-3.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">= sacam et socnam III 1; <hi rend="italic">vgl.</hi> II 30, 3<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">= sacam et socnam III 1; cf. II 30, 3b</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-3.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">hloht <hi rend="italic">Di;</hi> hlot <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">hloht Di; hlot Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-3.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">-umpn. <hi rend="italic">Cb und spätere Hss. stets;</hi> -tus est <hi rend="italic">SCt</hi></seg><seg type="translation" xml:lang="en" source="#claude">-umpn. Cb and later MSS throughout; -tus est SCt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-3.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">613</biblScope></bibl><seg type="original" xml:lang="de">ei det p. f. <hi rend="italic">S;</hi> p. f. <hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">ei det p. f. S; p. f. missing in Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="InCn_III-3.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">332</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Eideshufen 9; Strafgeldfixum 14b; die Busse an den Kläger wechselt nach der Höhe des Schutzes (<hi rend="italic">Gl</hi> 2. 5. 15c), die seinem Stande gebührt</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Eideshufen 9; Strafgeldfixum 14b; the compensation to the plaintiff varies according to the level of protection (<hi rend="italic">Gl</hi> 2. 5. 15c) due to his rank</seg></note>
      </div>
