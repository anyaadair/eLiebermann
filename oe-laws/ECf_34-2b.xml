        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2b.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Rl S</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Rl S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_34-2b.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">662</biblScope></bibl><seg type="original" xml:lang="de">A. p. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">A. p. Hk</seg></note>
