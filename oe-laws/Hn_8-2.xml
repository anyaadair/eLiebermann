      <div type="clause" n="8.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 8.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 8.2" corresp="#wit-lat"><pb n="554" ed="#liebermann"/>Communis<ptr type="liebermannNote" n="e" target="#Hn_8-2.lnote.oe.e"/> quippe<ptr type="liebermannNote" n="11" target="#Hn_8-2.lnote.oe.11"/> commodi<ptr type="liebermannNote" n="12" target="#Hn_8-2.lnote.oe.12"/> prouida<ptr type="liebermannNote" n="13" target="#Hn_8-2.lnote.oe.13"/> dispensacione statutum est, ut a<ptr type="liebermannNote" n="14" target="#Hn_8-2.lnote.oe.14"/> duodecimo etatis sue anno et<ptr type="liebermannNote" n="15" target="#Hn_8-2.lnote.oe.15"/> in hundreto sit et decima uel plegio<ptr type="liebermannNote" n="16" target="#Hn_8-2.lnote.oe.16"/> liberali<ptr type="liebermannNote" n="ee" target="#Hn_8-2.lnote.oe.ee"/> quisquis were<ptr type="liebermannNote" n="17" target="#Hn_8-2.lnote.oe.17"/> uel wite uel<ptr type="liebermannNote" n="4" target="#Hn_8-2.lnote.oe.4"/> iure liberi dignus<ptr type="liebermannNote" n="4" target="#Hn_8-2.lnote.oe.4"/> curat estimari.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 554 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_8-2.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 11, 16<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 11, 16a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_8-2.lnote.oe.ee" n="ee" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 6, 1<hi rend="italic">a im Gegensatz zu</hi> dominorum plegio 8, 2<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">as 6, 1a, in contrast to dominorum plegio 8, 2a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_8-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_8-2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de">causa <hi rend="italic">fügt zu K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">causa added K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_8-2.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de">comodi <hi rend="italic">Sc meist; hier</hi> comm. <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">comodi Sc mostly; here comm. K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_8-2.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de">-di <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-di Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_8-2.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de">ad <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_8-2.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co Cnut</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted K Co Cnut</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_8-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de">pleggio <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">pleggio Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_8-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">554</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. vom Corr. aus</hi> uuete <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected by the corrector from uuete Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_8-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">316</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Co. q. causa comm</hi>. Rs, scheint mir besser.—Am Rande: <hi rend="italic">Ut unusquisque XII annorum sit in plegio decim</hi>[<hi rend="italic">ae</hi> oder <hi rend="italic">-ationis</hi>]—<hi rend="italic">et</hi>{15} fehlt besser—<hi rend="italic">uel</hi>{4} fehlt—<hi rend="italic">curat</hi> fehlt Rs.—In Note {<hi rend="italic">ee</hi>} bessere: 6, 1<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Co. q. causa comm</hi>. Rs, which seems to me better.—In the margin: <hi rend="italic">Ut unusquisque XII annorum sit in plegio decim</hi>[<hi rend="italic">ae</hi> or <hi rend="italic">-ationis</hi>]—<hi rend="italic">et</hi>{15} omitted, which is better—<hi rend="italic">uel</hi>{4} omitted—<hi rend="italic">curat</hi> omitted Rs.—In note {<hi rend="italic">ee</hi>} correct to: 6, 1<hi rend="italic">b</hi></seg></note>
      </div>
