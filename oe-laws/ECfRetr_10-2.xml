      <div type="clause" n="10.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 10.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 10.2"><pb n="634" ed="#liebermann"/>Si quispiam<ptr type="liebermannNote" n="19" target="#ECfRetr_10-2.lnote.la.19"/> detinuerit, ad iusticiam<ptr type="liebermannNote" n="20" target="#ECfRetr_10-2.lnote.la.20"/> regis<ptr type="liebermannNote" n="21" target="#ECfRetr_10-2.lnote.la.21"/> clamor deferatur, quoniam denarius <hi rend="bold">hic</hi> elemosyna<ptr type="liebermannNote" n="22" target="#ECfRetr_10-2.lnote.la.22"/> regis est, iusticia <hi rend="bold">uero</hi><ptr type="liebermannNote" n="23" target="#ECfRetr_10-2.lnote.la.23"/> <hi rend="bold">(eius</hi><ptr type="liebermannNote" n="24" target="#ECfRetr_10-2.lnote.la.24"/><hi rend="bold">)</hi> faciat<ptr type="liebermannNote" n="25" target="#ECfRetr_10-2.lnote.la.25"/> denarium<ptr type="liebermannNote" n="26" target="#ECfRetr_10-2.lnote.la.26"/> reddere<ptr type="liebermannNote" n="27" target="#ECfRetr_10-2.lnote.la.27"/> et forisfacturam<ptr type="liebermannNote" n="28" target="#ECfRetr_10-2.lnote.la.28"/> episcopi<ptr type="liebermannNote" n="29" target="#ECfRetr_10-2.lnote.la.29"/> et regis.</ab>
        <note type="comparison" source="#liebermann" n="634"><label>printed alongside</label> <ref target="clause:ECf_10-2">ECf 10.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 634 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">Liebermann prints “quispiam” with “piam” in bold.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-2.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">quisquam <hi rend="italic">Hv Kn Sin</hi></seg><seg type="translation" xml:lang="en" source="#claude">quisquam Hv Kn Sin</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-2.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">custodiam <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">custodiam Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-2.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-2.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">r. e. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. e. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-2.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Kn Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Kn Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-2.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Hv Sp Lond besser</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking, which is better, in Cb Hv Sp Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-2.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">eum <hi rend="italic">fügt zu Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cb adds eum</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-2.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">r. d. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. d. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-2.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">illum <hi rend="italic">fügt zu Cb;</hi> reddi <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cb adds illum; reddi Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-2.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">-factionem <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-factionem Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_10-2.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">634</biblScope></bibl><seg type="original" xml:lang="de">r. et ep. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. et ep. Cb</seg></note>
      </div>
