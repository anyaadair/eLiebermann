      <div type="clause" n="82.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 82.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 82.3" corresp="#wit-lat"><pb n="598" ed="#liebermann"/>Et<ptr type="liebermannNote" n="w" target="#Hn_82-3.lnote.oe.w"/> unicuique licet domino suo sine wita subuenire, si quis assaliet<ptr type="liebermannNote" n="47" target="#Hn_82-3.lnote.oe.47"/> eum, et in omnibus legittimis<ptr type="liebermannNote" n="48" target="#Hn_82-3.lnote.oe.48"/> obedire preter(quam<ptr type="liebermannNote" n="49" target="#Hn_82-3.lnote.oe.49"/>) in prodicione, furto<ptr type="liebermannNote" n="7" target="#Hn_82-3.lnote.oe.7"/>, murdro et deinceps similibus<ptr type="liebermannNote" n="x" target="#Hn_82-3.lnote.oe.x"/>, que nullo prorsus ingenio fieri concessa sunt et legibus infamantur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 598 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-3.lnote.oe.w" n="w" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">citirt</hi> 88, 10. <hi rend="italic">Wichtigkeit dieser Gefolgschaft erklärt Maitland</hi> Domesday 72</seg><seg type="translation" xml:lang="en" source="#claude">cited 88, 10. The importance of this personal following is explained by Maitland Domesday 72</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-3.lnote.oe.x" n="x" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 85, 2<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 85, 2<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-3.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-3.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">-alliat <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-alliat Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-3.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">598</biblScope></bibl><seg type="original" xml:lang="de">-ittimus <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ittimus Co</seg></note>
