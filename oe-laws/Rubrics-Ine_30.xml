      <div type="clause" n="30">
        <head>Ine Rb 30</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="30" corresp="#wit-e"><pb n="22" ed="#liebermann"/>LXXIIII. Be ðon<ptr type="liebermannNote" n="8" target="#Rubrics-Ine_30.lnote.oe.8"/> þe cierlisc mon flieman feormige.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="30" corresp="#wit-g-prol"><pb n="22" ed="#liebermann"/>LXXIIII. Be þan ðe cyrlisc man flyman feormige.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="30" corresp="#wit-h"><pb n="23" ed="#liebermann"/>LXXIIII. Be þon<ptr type="liebermannNote" n="3" target="#Rubrics-Ine_30.lnote.oe.3"/> ðe cierlisc mon<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_30.lnote.oe.2"/> flyman feormige.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="30" corresp="#wit-q"><pb n="23" ed="#liebermann"/>Si<ptr type="liebermannNote" n="16" target="#Rubrics-Ine_30.lnote.oe.16"/> quis homo<ptr type="liebermannNote" n="17" target="#Rubrics-Ine_30.lnote.oe.17"/> cyrliscus<ptr type="liebermannNote" n="18" target="#Rubrics-Ine_30.lnote.oe.18"/> forisbannitum firmet.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="206" ed="#jurasinski-and-oliver"/>LXXIIII Be ðon þe cierlisc mon flieman feormige</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="206" ed="#jurasinski-and-oliver"/>Be þa<hi rend="italic">m</hi> þe cyrlis man feormige flyman</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="23" ed="#liebermann"/>Darüber, dass ein gemeinfreier Mann einen [friedlosen] Flüchtling beherbergt.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning a common freeman harbouring an [outlawed] fugitive.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="207" ed="#jurasinski-and-oliver"/>Concerning a <hi rend="italic">ceorl</hi>-rank man harboring a fugitive</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="207" ed="#jurasinski-and-oliver"/>Concerning a <hi rend="italic">ceorl</hi>-rank man who harbors a fugitive</ab>
        <note type="comparedBy" source="#wormald-mel" n="269"><ref target="clause:IIEw_5-2">II Ew 5.2</ref></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="182"><ref target="clause:IIEw_5-2">II Ew 5.2</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_30.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de">ðam ðe flyman, <hi rend="italic">ohne</hi> c. m. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðam ðe flyman, without c. m. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_30.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">De cirliscis forbannitis <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">De cirliscis forbannitis Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_30.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">kyrl. h. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">kyrl. h. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_30.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">cirl. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">cirl. T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_30.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> þam</seg><seg type="translation" xml:lang="en" source="#claude">altered þam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_30.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
      </div>
