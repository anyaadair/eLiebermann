      <div type="clause" n="Prol. 1">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> Prol. 1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr Prol. 1"><pb n="627" ed="#liebermann"/>Electi<ptr type="liebermannNote" n="19" target="#ECfRetr_Prol-1.lnote.la.19"/> igitur de singulis totius<ptr type="liebermannNote" n="20" target="#ECfRetr_Prol-1.lnote.la.20"/> patrie comitatibus <hi rend="bold">uiri</hi> duodecim, iureiurando<ptr type="liebermannNote" n="21" target="#ECfRetr_Prol-1.lnote.la.21"/> coram<ptr type="liebermannNote" n="22" target="#ECfRetr_Prol-1.lnote.la.22"/> <hi rend="bold">rege confirmauerunt</hi><ptr type="liebermannNote" n="23" target="#ECfRetr_Prol-1.lnote.la.23"/> primo, ut quoad possent, recto tramite<ptr type="liebermannNote" n="24" target="#ECfRetr_Prol-1.lnote.la.24"/>, <hi rend="bold">neque</hi><ptr type="liebermannNote" n="25" target="#ECfRetr_Prol-1.lnote.la.25"/> <hi rend="bold">ad dextram neque</hi><ptr type="liebermannNote" n="25" target="#ECfRetr_Prol-1.lnote.la.25"/> <hi rend="bold">ad sinistram</hi><ptr type="liebermannNote" n="26" target="#ECfRetr_Prol-1.lnote.la.26"/> <hi rend="bold">diuertentes</hi><ptr type="liebermannNote" n="27" target="#ECfRetr_Prol-1.lnote.la.27"/>, legum suarum<ptr type="liebermannNote" n="28" target="#ECfRetr_Prol-1.lnote.la.28"/> et consuetudinum sancita<ptr type="liebermannNote" n="29" target="#ECfRetr_Prol-1.lnote.la.29"/> <hi rend="bold">patefacerent</hi>, nil<ptr type="liebermannNote" n="30" target="#ECfRetr_Prol-1.lnote.la.30"/> pretermittentes, <hi rend="bold">nil</hi><ptr type="liebermannNote" n="31" target="#ECfRetr_Prol-1.lnote.la.31"/> <hi rend="bold">addentes</hi>, nil<ptr type="liebermannNote" n="32" target="#ECfRetr_Prol-1.lnote.la.32"/> preuaricando<ptr type="liebermannNote" n="33" target="#ECfRetr_Prol-1.lnote.la.33"/> mutantes<ptr type="liebermannNote" n="*" target="#ECfRetr_Prol-1.lnote.la.star"/>.</ab>
        <note type="comparison" source="#liebermann" n="627"><label>printed alongside</label> <ref target="clause:ECf_Prol-1">ECf Prol. 1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Num. 20, 17</note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 627 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="editorial">Liebermann marks “neque ad dextram neque ad sinistram” with an asterisk, for his marginal reference to Numbers 20, 17. The asterisk after “mutantes” is the one in the ECf column, where his note gives Ce’s addition; it is given here as well.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Prol-1.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">627</biblScope></bibl><seg type="original" xml:lang="de">-tis .. uiris <hi rend="italic">Cc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tis .. uiris Cc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Prol-1.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">627</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Prol-1.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">627</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Cb Lb Or; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Cb Lb Or; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Prol-1.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">627</biblScope></bibl><seg type="original" xml:lang="de">p. cor. r. con. <hi rend="italic">Or Sp;</hi> c. r. <hi rend="italic">fehlt K Hv Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. cor. r. con. Or Sp; c. r. lacking in K Hv Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Prol-1.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">627</biblScope></bibl><seg type="original" xml:lang="de">primum con. <hi rend="italic">Cb Lb Ra Ph Lond Cc Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">primum con. Cb Lb Ra Ph Lond Cc Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Prol-1.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">627</biblScope></bibl><seg type="original" xml:lang="de">incedentes <hi rend="italic">fügt zu Sp Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Sp Ld add incedentes</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Prol-1.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">627</biblScope></bibl><seg type="original" xml:lang="de">nec <hi rend="italic">Cb Sp Ld Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">nec Cb Sp Ld Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Prol-1.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">627</biblScope></bibl><seg type="original" xml:lang="de">partem <hi rend="italic">fügt zu Hv Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv Ph add partem</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Prol-1.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">627</biblScope></bibl><seg type="original" xml:lang="de">deu. <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">deu. Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Prol-1.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">627</biblScope></bibl><seg type="original" xml:lang="de">su. consuetudinem et sa. <hi rend="italic">Hv Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">su. consuetudinem et sa. Hv Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Prol-1.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">627</biblScope></bibl><seg type="original" xml:lang="de">sibi <hi rend="italic">Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">sibi Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Prol-1.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">627</biblScope></bibl><seg type="original" xml:lang="de">nichil <hi rend="italic">Cb Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">nichil Cb Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Prol-1.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">627</biblScope></bibl><seg type="original" xml:lang="de">nec <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">nec Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Prol-1.lnote.la.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">627</biblScope></bibl><seg type="original" xml:lang="de">nichil <hi rend="italic">Lb; fehlt Hv;</hi> nec <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">nichil Lb; lacking in Hv; nec Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Prol-1.lnote.la.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">627</biblScope></bibl><seg type="original" xml:lang="de">-cantes, nil <hi rend="italic">Kn</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cantes, nil Kn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_Prol-1.lnote.la.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">627</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier fügt zu</hi> Ce, <hi rend="italic">vergeblich</hi> Lond, <hi rend="italic">u.</hi> 34, 1a, <hi rend="italic">zu bessern versuchend, und</hi> (<hi rend="italic">da</hi> Ealdred 1069 <hi rend="italic">starb,</hi> Hugo <hi rend="italic">erst</hi> 1075 <hi rend="italic">geweiht ward</hi>) <hi rend="italic">in sich widersprechend:</hi> Aldredus autem Eboracensis archiepiscopus, qui regem Willelmum coronauerat, et Hugo Londoniensis episcopus per preceptum regis scripserunt propriis manibus omnia que predicti iurati dixerunt.</seg><seg type="translation" xml:lang="en" source="#claude">here Ce adds, trying in vain to improve on Lond (below, 34, 1a), and contradicting itself (since Ealdred died in 1069 and Hugh was only consecrated in 1075): Aldredus autem Eboracensis archiepiscopus, qui regem Willelmum coronauerat, et Hugo Londoniensis episcopus per preceptum regis scripserunt propriis manibus omnia que predicti iurati dixerunt.</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Twelve men, therefore, having been chosen from each of the shires of the whole country, first affirmed by oath before the king that, as far as they could, proceeding by the right path, turning aside neither to the right nor to the left, they would make known the ordinances of their laws and customs, omitting nothing, adding nothing, changing nothing by prevarication.</ab>
      </div>
    </body>
  </text>
