      <div type="clause" n="4.2">
        <head><ref type="lawCode" target="law:IudDeiII">Iud Dei II</ref> 4.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei II 4.2" corresp="#wit-lat"><pb n="407" ed="#liebermann"/>si<ptr type="liebermannNote" n="40" target="#IudDeiII_4-2.lnote.oe.40"/> autem culpabilis<ptr type="liebermannNote" n="41" target="#IudDeiII_4-2.lnote.oe.41"/> atque<ptr type="liebermannNote" n="42" target="#IudDeiII_4-2.lnote.oe.42"/> reus<ptr type="liebermannNote" n="43" target="#IudDeiII_4-2.lnote.oe.43"/> contempserit<ptr type="liebermannNote" n="44" target="#IudDeiII_4-2.lnote.oe.44"/> et quasi temptator<ptr type="liebermannNote" n="45" target="#IudDeiII_4-2.lnote.oe.45"/> iudicium tuum<ptr type="liebermannNote" n="46" target="#IudDeiII_4-2.lnote.oe.46"/> adierit<ptr type="liebermannNote" n="47" target="#IudDeiII_4-2.lnote.oe.47"/>, aut per herbas<ptr type="liebermannNote" n="48" target="#IudDeiII_4-2.lnote.oe.48"/> uel<ptr type="liebermannNote" n="49" target="#IudDeiII_4-2.lnote.oe.49"/> quaecunque temptamenta<ptr type="liebermannNote" n="50" target="#IudDeiII_4-2.lnote.oe.50"/> siue molimina maleficiosa peccata sua contueri<ptr type="liebermannNote" n="51" target="#IudDeiII_4-2.lnote.oe.51"/> et defendere, inflatus<ptr type="liebermannNote" n="52" target="#IudDeiII_4-2.lnote.oe.52"/> per afflatorem malitiae, contra ueritatis tuae examen uoluerit<ptr type="liebermannNote" n="47" target="#IudDeiII_4-2.lnote.oe.47"/>, iustissime et misericordissime domine Deus, ad<ptr type="liebermannNote" n="53" target="#IudDeiII_4-2.lnote.oe.53"/> hoc uirtus tua, quae omnia superat, in eo<ptr type="liebermannNote" n="54" target="#IudDeiII_4-2.lnote.oe.54"/> cum ueritate, quae<ptr type="liebermannNote" n="55" target="#IudDeiII_4-2.lnote.oe.55"/> permanet<ptr type="liebermannNote" n="56" target="#IudDeiII_4-2.lnote.oe.56"/> in seculum<ptr type="liebermannNote" n="57" target="#IudDeiII_4-2.lnote.oe.57"/> seculi, declaretur<ptr type="liebermannNote" n="58" target="#IudDeiII_4-2.lnote.oe.58"/>, quatinus iustitiae tuae non dominetur iniquitas, sed ueritati subdatur falsitas, et<ptr type="liebermannNote" n="59" target="#IudDeiII_4-2.lnote.oe.59"/> ut<ptr type="liebermannNote" n="60" target="#IudDeiII_4-2.lnote.oe.60"/> caeteri hoc uidentes ab incredulitate sua, te miserante, liberentur<ptr type="liebermannNote" n="61" target="#IudDeiII_4-2.lnote.oe.61"/>. Qui<ptr type="liebermannNote" n="b" target="#IudDeiII_4-2.lnote.oe.b"/> uiuis et<ptr type="liebermannNote" n="62" target="#IudDeiII_4-2.lnote.oe.62"/> regnas<ptr type="liebermannNote" n="63" target="#IudDeiII_4-2.lnote.oe.63"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 407 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">Per <hi rend="italic">statt</hi> Qui u. et r. <hi rend="italic">Ci, wo zwischen den Zeilen folgt:</hi> Bened[ictio] Dei Patris omnipotentis et Filii et Spiritus sancti desc[endat] super hoc ferrum ad discernendum uerum Dei iudicium, <hi rend="italic">was gleich unten</hi> IX 4. XI 6. XVI 38, 2. <hi rend="italic">Zeumer</hi> 616<hi rend="italic">h</hi>.</seg><seg type="translation" xml:lang="en" source="#claude">Per instead of Qui u. et r. Ci, where there follows between the lines: Bened[ictio] Dei Patris omnipotentis et Filii et Spiritus sancti desc[endat] super hoc ferrum ad discernendum uerum Dei iudicium, which is the same as below IX 4. XI 6. XVI 38, 2. Zeumer 616h.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 3, 6</seg><seg type="translation" xml:lang="en" source="#claude">cf. 3, 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-es <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-es written above in H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">aut <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">aut Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-i -nt <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-i -nt written above in H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch</hi> IX, <hi rend="italic">nicht bei Zeumer</hi></seg><seg type="translation" xml:lang="en" source="#claude">also IX, not in Zeumer</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">uel -es <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel -es written above in H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-nt <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nt written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 3, 6; aut per h. — dom. Deus <hi rend="italic">fehlt Zeu.</hi> 701₁, <hi rend="italic">aber in</hi> 617₇</seg><seg type="translation" xml:lang="en" source="#claude">cf. 3, 6; aut per h. — dom. Deus omitted in Zeu. 701₁, but present in 617₇</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">per <hi rend="italic">fügt zu Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">per added in Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">für</hi> -mina (<hi rend="italic">Zeu.</hi>) <hi rend="italic">auch</hi> IX</seg><seg type="translation" xml:lang="en" source="#claude">instead of -mina (Zeu.) also IX</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.51" n="51" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">contegere <hi rend="italic">Zeu.</hi> 604₂₄; tegere 608₁₅. 658₃₄; <hi rend="italic">meist aber</hi> contueri 607₁₀. 609₁₉ (= <hi rend="italic">unten</hi> XII 17, 2). 617₈</seg><seg type="translation" xml:lang="en" source="#claude">contegere Zeu. 604₂₄; tegere 608₁₅. 658₃₄; but mostly contueri 607₁₀. 609₁₉ (= below XII 17, 2). 617₈</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.52" n="52" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-i <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-i written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.53" n="53" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">ad hoc <hi rend="italic">fehlt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad hoc omitted in Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.54" n="54" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-is <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-is written above in H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.55" n="55" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">qua <hi rend="italic">Ps;</hi> quē <hi rend="italic">Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">qua Ps; quē Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.56" n="56" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-neat <hi rend="italic">Pt</hi></seg><seg type="translation" xml:lang="en" source="#claude">-neat Pt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.57" n="57" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-la seculorum <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-la seculorum H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.58" n="58" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-ratur <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ratur H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.59" n="59" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">ut et <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">ut et H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.60" n="60" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.61" n="61" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">-etur <hi rend="italic">übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">-etur written above H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.62" n="62" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">et r. <hi rend="italic">fehlt Ps Pt</hi></seg><seg type="translation" xml:lang="en" source="#claude">et r. omitted in Ps Pt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4-2.lnote.oe.63" n="63" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">et r. <hi rend="italic">fehlt Co,</hi> cum Deo <hi rend="italic">fügt zu Rj;</hi> cum Deo patre <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">et r. omitted in Co, cum Deo added in Rj; cum Deo patre Tr</seg></note>
