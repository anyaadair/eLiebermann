  <text>
    <body>
      <div type="clause" n="44">
        <head><ref type="lawCode" target="law:VIAtr">VI Atr</ref> 44</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-k"><pb n="258" ed="#liebermann"/>⁊ þ<hi rend="italic">æt</hi> hy Sunnandaga cypinga ⁊ folciscra gemota georne geswican.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-d-incomplete"><pb n="258" ed="#liebermann"/>And þ<hi rend="italic">æt</hi> hi Sunnandæges cypinga ⁊ folciscra gemota georne geswican.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="44" corresp="#wit-k"><pb n="104" ed="#robertson"/>⁊ þæt hy Sunnandaga<ptr type="editorNote" n="6" target="#VIAtr_44.robnote.fn.6"/> cypinga ⁊ folciscra gemota georne geswican.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-k"><pb n="176" ed="#rabin-doml"/>And þæt hy Sunnandaga cypinga and folciscra gemota georne geswican.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="259" ed="#liebermann"/>Und dass sie willig ablassen von Sonntagskäufen und -versammlungen des Volkes [zum Gericht].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And that they eagerly give up Sunday trading and public assemblies [for justice].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-k"><ptr type="editorNote" n="1" target="#VIAtr_44.robnote.n.1"/><pb n="105" ed="#robertson"/>And that they should diligently abstain from marketings and public assemblies on Sundays.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-k"><pb n="177" ed="#rabin-doml"/>And that on Sundays markets and public meetings are to be assiduously avoided.</ab>
        <note type="comparison" source="#liebermann" n="259"><ref target="clause:VIAtr_22-1">VI Atr 22.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 22, 1</note>
        <note type="editorNote" subtype="endnote" xml:id="VIAtr_44.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">335</biblScope></bibl><seg type="original" xml:lang="en">Cf. 22, 1; <hi rend="italic">Can. Edg.</hi> 19, ed. Thorpe, <hi rend="italic">Anc. Laws</hi>, <hi rend="smallcaps">ii</hi>. p. 248.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="VIAtr_44.robnote.fn.6" n="6" source="#robertson"><bibl><biblScope unit="page">104</biblScope></bibl><label>Sunnandaga</label><seg type="original" xml:lang="en"><hi rend="italic">Sunnandæges</hi> D.</seg></note>
      </div>
    </body>
