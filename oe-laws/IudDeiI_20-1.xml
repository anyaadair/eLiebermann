      <div type="clause" n="20.1">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 20.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 20.1" corresp="#wit-lat"><pb n="404" ed="#liebermann"/>Deus, qui in mari Rubro cuneos Egyptiorum<ptr type="liebermannNote" n="28" target="#IudDeiI_20-1.lnote.oe.28"/> inuoluisti et agmina Israhelitica<ptr type="liebermannNote" n="29" target="#IudDeiI_20-1.lnote.oe.29"/> inperterrita abire<ptr type="liebermannNote" n="30" target="#IudDeiI_20-1.lnote.oe.30"/> iussisti, uirtutem tuae benedictionis<ptr type="liebermannNote" n="31" target="#IudDeiI_20-1.lnote.oe.31"/> his aquis infundere<ptr type="liebermannNote" n="32" target="#IudDeiI_20-1.lnote.oe.32"/> et nouum ac mirabile signum in eis ostendere<ptr type="liebermannNote" n="33" target="#IudDeiI_20-1.lnote.oe.33"/> digneris,</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Exod. 15, 4</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 404 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_20-1.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">Ęg. <hi rend="italic">Ci H</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ęg. Ci H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_20-1.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">Israel. <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">Israel. Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_20-1.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">ambire <hi rend="italic">Ch</hi></seg><seg type="translation" xml:lang="en" source="#claude">ambire Ch</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_20-1.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">+ <hi rend="italic">übergeschr. H; und</hi> bene+dic. <hi rend="italic">öfters auch in anderen Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">+ written above H; and bene+dic. frequently in other MSS too</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_20-1.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">-de <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-de Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_20-1.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">-de <hi rend="italic">ohne</hi> digneris <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-de without digneris Co</seg></note>
