      <div type="clause" n="10.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 10.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 10.3" corresp="#wit-lat"><pb n="556" ed="#liebermann"/>Et omnibus ordinatis et alienigenis<ptr type="liebermannNote" n="vv" target="#Hn_10-3.lnote.oe.vv"/> et pauperibus<ptr type="liebermannNote" n="w" target="#Hn_10-3.lnote.oe.w"/> et abiectis debet esse rex pro cognacione<ptr type="liebermannNote" n="38" target="#Hn_10-3.lnote.oe.38"/> et aduocato, si penitus alium non habent.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 556 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_10-3.lnote.oe.vv" n="vv" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> 75, 7<hi rend="italic">a</hi>. <hi rend="italic">Ferner steht</hi> II Cn. 40</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">as</hi> 75, 7<hi rend="italic">a</hi>. <hi rend="italic">A further parallel is</hi> II Cn. 40</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_10-3.lnote.oe.w" n="w" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de">p. et a. <hi rend="italic">vgl. unten</hi> 78, 5</seg><seg type="translation" xml:lang="en" source="#claude">p. et a. <hi rend="italic">cf. below</hi> 78, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_10-3.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">556</biblScope></bibl><seg type="original" xml:lang="de">cognicione <hi rend="italic">vom Corr. geänd.</hi> cognato <hi rend="italic">Sc;</hi> cognato <hi rend="italic">übrige, auch Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">cognicione <hi rend="italic">altered by the corrector to</hi> cognato <hi rend="italic">Sc;</hi> cognato <hi rend="italic">the rest, also edd.</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_10-3.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> König 14—<hi rend="italic">cognato</hi>{38} (Rs) setze in den Text, da näher zu <hi rend="italic">mæg</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> König 14—<hi rend="italic">cognato</hi>{38} (Rs) should be put in the text, as closer to <hi rend="italic">mæg</hi></seg></note>
      </div>
