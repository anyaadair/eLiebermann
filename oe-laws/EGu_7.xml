  <text>
    <body>
      <div type="clause" n="7">
        <head><ref type="lawCode" target="law:EGu">EGu</ref> 7</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7" corresp="#wit-h"><ptr type="liebermannNote" n="†" target="#EGu_7.lnote.oe.dagger"/><pb n="132" ed="#liebermann"/>Sunnandæges cypinge<ptr type="liebermannNote" n="9" target="#EGu_7.lnote.oe.9"/> gif hwa agynne, þolie þæs ceapes ⁊ twelf<ptr type="liebermannNote" n="10" target="#EGu_7.lnote.oe.10"/> orena mid Denu<hi rend="italic">m</hi> ⁊ XXX scll' mid Englu<hi rend="italic">m</hi>.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7" corresp="#wit-b"><pb n="132" ed="#liebermann"/>Sunnandæges cypinge gyf hwá agynne, ðolie ðæs ceapes ⁊ XII ore mid Denu<hi rend="italic">m</hi> ⁊ XXX scill' mid Englum.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7" corresp="#wit-q"><pb n="133" ed="#liebermann"/>Si quis in die dominica negociationem facere presumat, perdat ipsum captale et XII oran<ptr type="liebermannNote" n="13" target="#EGu_7.lnote.oe.13"/> cum Dacis, et<ptr type="liebermannNote" n="14" target="#EGu_7.lnote.oe.14"/> triginta sol. cum Anglis.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="7" corresp="#wit-h"><pb n="106" ed="#attenborough"/>[Be freolsdæges weorcum.]<ptr type="editorNote" n="6" target="#EGu_7.attnote.fn.6"/> Sunnandæges cypinge gif hwa agynne, þolie þæs ceapes ⁊ twelf orena<ptr type="editorNote" n="7" target="#EGu_7.attnote.fn.7"/> mid Denum ⁊ XXX scll' mid Englum.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-h"><pb n="6" ed="#rabin-doml"/>Sunnandæges cypinge gif hwa agynne, þolie þæs ceapes and twelf orena mid Denum and XXX scillinga mid Englum.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="133" ed="#liebermann"/>(Über<ptr type="liebermannNote" n="1" target="#EGu_7.lnote.de.1"/> Feiertagsarbeiten. <hi rend="italic">Ld</hi>) Wenn<ptr type="liebermannNote" n="2" target="#EGu_7.lnote.de.2"/> jemand Sonntags<ptr type="liebermannNote" n="3" target="#EGu_7.lnote.de.3"/> Kaufgeschäft vornimmt, verliere er das Kaufgut<ptr type="liebermannNote" n="4" target="#EGu_7.lnote.de.4"/> und 12 Ör<ptr type="liebermannNote" n="5" target="#EGu_7.lnote.de.5"/> bei den Dänen, beziehungsweise 30 Schill. bei den Engländern.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">(Of work on feast-days. Ld) If anyone engages in trade on a Sunday, let him lose the goods and 12 ores among the Danes, or 30 shillings among the English.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="107" ed="#attenborough"/>If anyone proceeds to bargain on a Sunday, he shall forfeit the goods, and 12 ores<ptr type="editorNote" n="1" target="#EGu_7.attnote.n.1"/> [in addition] in a Danish district, and 30 shillings in an English district.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-h"><pb n="7" ed="#rabin-doml"/>If anyone does business on a Sunday, he shall forfeit his purchases and twelve oras among the Danes and thirty shillings among the English.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IIAs_24-1">II As 24.1</ref>; <ref target="clause:VAtr_13-1">V Atr 13.1</ref></note>
        <note type="comparison" source="#wormald-ppmel" n="56"><label>cites</label> <ref target="clause:Ine_3">Ine 3–3.2</ref> <quote>EGu 7 (with its Æthelstanian penalty adapted to Danelaw conditions – and going on to cite a version of Ine 3 – 3:2)</quote></note>
        <note type="comparison" source="#wormald-ppmel" n="56"><label>adapts penalty of</label> <ref target="clause:IIAs_24-1">II As 24.1</ref> <quote>EGu 7 (with its Æthelstanian penalty adapted to Danelaw conditions</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="359"><ref target="clause:IICn_45-1">II Cn 45.1–46</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_7.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">133</biblScope></bibl><seg type="original" xml:lang="de">oras <hi rend="italic">TBr;</hi> hóras <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">oras TBr; hóras MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_7.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">133</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_7.lnote.oe.dagger" n="†" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">Be freolsdæges weorcum <hi rend="italic">überschreibt Ld; vgl. Quadr. zu</hi> 7, 1</seg><seg type="translation" xml:lang="en" source="#claude">Be freolsdæges weorcum as heading in Ld; cf. Quadr. on 7, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_7.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">cypunge <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cypunge Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_7.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">132</biblScope></bibl><seg type="original" xml:lang="de">XII ore <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">XII ore Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_7.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Über die Rubrik <hi rend="italic">s. o.</hi> Einl. 2</seg><seg type="translation" xml:lang="en" source="#claude">On the rubric <hi rend="italic">see above</hi> Introduction 2</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_7.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Wörtlich ähnlich II As 24, 1, der die Strafe vervierfacht</seg><seg type="translation" xml:lang="en" source="#claude">II As 24, 1, which quadruples the penalty, is similar in wording</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_7.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Handel 5; Sonntag 4—6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Handel 5; Sonntag 4—6</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_7.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">So verliert der Arbeiter am Feiertag den Arbeitsertrag Wi 11</seg><seg type="translation" xml:lang="en" source="#claude">Similarly the worker on a holy day loses the proceeds of his work Wi 11</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_7.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Dies Strafgeld hierher Northu 56</seg><seg type="translation" xml:lang="en" source="#claude">Northu 56 has this fine here</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="EGu_7.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">202</biblScope></bibl><seg type="original" xml:lang="en">See note 1 to cap. 3 § 1, above.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="EGu_7.attnote.fn.6" n="6" source="#attenborough"><bibl><biblScope unit="page">106</biblScope></bibl><label>weorcum</label><seg type="original" xml:lang="en">Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="EGu_7.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">106</biblScope></bibl><label>orena</label><seg type="original" xml:lang="en"><hi rend="italic">ore</hi>. B, Ld.</seg></note>
      </div>
    </body>
