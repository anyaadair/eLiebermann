    <body>
      <div type="clause" n="4.3">
        <head><ref type="lawCode" target="law:IIEg">II Eg</ref> 4.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4.3" corresp="#wit-g-a"><pb n="198" ed="#liebermann"/>Æt þa<hi rend="italic">m<ptr type="liebermannNote" n="26" target="#IIEg_4-3.lnote.oe.26"/></hi> þriddan cyrre gyf<ptr type="liebermannNote" n="21" target="#IIEg_4-3.lnote.oe.21"/> he þon<hi rend="italic">ne</hi> git<ptr type="liebermannNote" n="27" target="#IIEg_4-3.lnote.oe.27"/> nelle, þolie<ptr type="liebermannNote" n="28" target="#IIEg_4-3.lnote.oe.28"/> ealles þæs ðe he áge.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4.3" corresp="#wit-a"><pb n="198" ed="#liebermann"/>Æt ðam ðriddan syðe gyf he þon<hi rend="italic">ne</hi> gyt nelle, ðolige ealles þæs þe he age.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4.3" corresp="#wit-d"><pb n="198" ed="#liebermann"/>Æt þa<hi rend="italic">m</hi> þriddan siðe gif he þon<hi rend="italic">ne</hi> git nelle, þolige ealles ðæs þe he age.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="4.3" corresp="#wit-q"><pb n="199" ed="#liebermann"/>Ad tertiam uicem, si adhuc non reddiderit, perdat totum quod habebit.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="4.3" corresp="#wit-d"><pb n="22" ed="#robertson"/>Æt þam þriddan siðe<ptr type="editorNote" n="5" target="#IIEg_4-3.robnote.fn.5"/>, gif he þonne git nelle, þolige ealles ðæs þe he age.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="352" ed="#rabin-doml"/>Æt þam þriddan cyrre gyf he þonne git nelle, þolie ealles þæs ðe he age.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="199" ed="#liebermann"/>Beim dritten Male, wenn er dann noch sich weigert, verliere er alles<ptr type="liebermannNote" n="1" target="#IIEg_4-3.lnote.de.1"/> was er hat.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">The third time, if he still refuses, let him lose everything he has.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d"><pb n="23" ed="#robertson"/>And on the third occasion, if he still refuses, he shall suffer the loss of all that he possesses.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="435" ed="#whitelock"/>On the third occasion, if he still will not pay, he is to forfeit all that he owns.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="353" ed="#rabin-doml"/>And if he still refuses to pay for a third time, he is to suffer the forfeiture of all that he owns.</ab>
        <note type="textual" source="#rabin-doml">cyrre: syðe A; siðe D</note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_4-3.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">198</biblScope></bibl><seg type="original" xml:lang="de">þæm <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þæm So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_4-3.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">198</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_4-3.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">198</biblScope></bibl><seg type="original" xml:lang="de">gyt <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gyt So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEg_4-3.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">198</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geändert in</hi> þolige <hi rend="italic">G;</hi> þolige <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">altered to þolige G; þolige So Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEg_4-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">135</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Vermögenseinziehung 4. 10h; Kirchengeldeintreiber 1—2a. Schreuer meint, der Kirche entgehe damit die Busse, da Schuldiger friedlos (<hi rend="italic">s. d. Gl</hi> 13) sei. Eher erfolgt Halbteilung 3, 1⁴</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Vermögenseinziehung 4. 10h; Kirchengeldeintreiber 1—2a. Schreuer holds that the church thereby loses the compensation, since the guilty man is outlawed (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 13). More probably the halving of 3, 1⁴ takes place</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIEg_4-3.robnote.fn.5" n="5" source="#robertson"><bibl><biblScope unit="page">22</biblScope></bibl><label>siðe</label><seg type="original" xml:lang="en"><hi rend="italic">cyrre</hi> G, Ld.</seg></note>
      </div>
    </body>
