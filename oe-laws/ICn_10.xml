  <text>
    <body>
      <div type="clause" n="10">
        <head><ref type="lawCode" target="law:ICn">I Cn</ref> 10</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="10" corresp="#wit-g-a"><pb n="292" ed="#liebermann"/>And cyricsceat to Martines mæssan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="10" corresp="#wit-a"><pb n="292" ed="#liebermann"/>And cyricseat<ptr type="liebermannNote" n="4" target="#ICn_10.lnote.oe.4"/> to Martines mæssan.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="10" corresp="#wit-q"><pb n="292" ed="#liebermann"/>Cyricsceat, id est ęcclesię census<ptr type="liebermannNote" n="17" target="#ICn_10.lnote.oe.17"/>, in festo sancti Martini.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="10" corresp="#wit-inst-cn"><pb n="293" ed="#liebermann"/>. . . . Omne uero<ptr type="liebermannNote" n="21" target="#ICn_10.lnote.oe.21"/> ęcclesiasticum<ptr type="liebermannNote" n="22" target="#ICn_10.lnote.oe.22"/> donum, quod Angli ciricsceat<ptr type="liebermannNote" n="23" target="#ICn_10.lnote.oe.23"/> uocant, detur antiquis<ptr type="liebermannNote" n="24" target="#ICn_10.lnote.oe.24"/> ęcclesiis; quod sit persolutum in festiuitate sancti<ptr type="liebermannNote" n="25" target="#ICn_10.lnote.oe.25"/> Martini; si quis ultra illum diem illud retinuerit, reddat illud<ptr type="liebermannNote" n="11" target="#ICn_10.lnote.oe.11"/> episcopo et undecies persoluat ei et regi quadraginta<ptr type="liebermannNote" n="26" target="#ICn_10.lnote.oe.26"/> solidos . . .<ptr type="liebermannNote" n="27" target="#ICn_10.lnote.oe.27"/></ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="10" corresp="#wit-cons-cn"><pb n="293" ed="#liebermann"/>Et ecclesiasticus census ad festum sancti Martini.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="10" corresp="#wit-g-a"><pb n="164" ed="#robertson"/>And cyricsceat to Martines mæssan.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="242" ed="#rabin-doml"/>And cyricsceat to Martines mæssan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><ptr type="liebermannNote" n="1" target="#ICn_10.lnote.de.1"/><pb n="293" ed="#liebermann"/>Und Kirchensteuer zum Martinsfest [11. November].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And church-scot at Martinmas [11 November].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-g-a"><pb n="165" ed="#robertson"/>And church dues [shall be rendered] at Martinmas.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="243" ed="#rabin-doml"/>And Church dues are to be paid by the Feast of Saint Martin.</ab>
        <note type="comparison" source="#liebermann" n="293"><ref target="clause:VIIIAtr_11">VIII Atr 11</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 11</note>
        <note type="comparison" source="#wormald-mel" n="356"><label>quoted verbatim (bold in Wormald's table)</label> <ref target="clause:VIAtr_18-1">VI Atr 18.1</ref> <quote>Table 5.4, I Cn 10: VI Atr 18:1</quote></note>
        <note type="comparison" source="#wormald-ppmel" n="29"><label>substantially repeats</label> <ref target="clause:IIEg_2-2">II Eg 2.2–3</ref> <quote>The references in Wulfstan's codes for Æthelred and Cnut substantially repeated what Edgar had said</quote></note>
        <note type="comparedBy" source="#kennedy" n="59"><ref target="clause:Cn-1018_part-035">Cn 1018 13.5–14.1</ref></note>
        <note type="comparedBy" source="#wormald-ppmel" n="29"><ref target="clause:Hn_11-4">Hn 11.4</ref></note>
        <note type="editorial">Liebermann compares VIII Atr 11.; BR: added from Gesetze I p. 293, October 2026 (MS Cons)</note>
        <note type="translator" source="#rabin-doml">Feast of Martin: November 11.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_10.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">292</biblScope></bibl><seg type="original" xml:lang="de">dignitatem reddendum est <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">dignitatem reddendum est K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_10.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">293</biblScope></bibl><seg type="original" xml:lang="de">ergo, <hi rend="italic">am Rande</hi> uero <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">ergo, in the margin uero Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_10.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">293</biblScope></bibl><seg type="original" xml:lang="de">-siarum <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">-siarum T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_10.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">293</biblScope></bibl><seg type="original" xml:lang="de">u. c. <hi rend="italic">Cb T</hi>; kirchescot <hi rend="italic">Lb S</hi>; chercþanc <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. c. Cb T; kirchescot Lb S; chercþanc Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_10.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">293</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus</hi> 11, 2</seg><seg type="translation" xml:lang="en" source="#claude">from 11, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_10.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">293</biblScope></bibl><seg type="original" xml:lang="de">s. M. <hi rend="italic">fehlt S</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. M. missing in S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_10.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">293</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_10.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">293</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. o. II Eg.</hi> 4, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. above II Eg. 4, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_10.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">293</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> I 13</seg><seg type="translation" xml:lang="en" source="#claude">followed by I 13</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_10.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">292</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_10.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">200</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">10 und 10, 1 wird zusammengezogen und 11, 2 hineingemengt in Inst</seg><seg type="translation" xml:lang="en" source="#claude">In Inst 10 and 10, 1 are combined and 11, 2 is mixed in</seg></note>
      </div>
    </body>
  </text>
