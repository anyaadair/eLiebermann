  <text>
    <body>
      <div type="clause" n="6">
        <head><ref type="lawCode" target="law:EGu">EGu</ref> 6</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6" corresp="#wit-h"><pb n="130" ed="#liebermann"/>Gif hwa teoþunge forhealde<ptr type="liebermannNote" n="35" target="#EGu_6.lnote.oe.35"/>, gylde lahslit<ptr type="liebermannNote" n="18" target="#EGu_6.lnote.oe.18"/> mid Denu<hi rend="italic">m</hi>, wíte mid Englu<hi rend="italic">m</hi>.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6" corresp="#wit-b"><pb n="130" ed="#liebermann"/>⁊ gyf hwá teoðunge forheolde, gylde lahslit mid Denu<hi rend="italic">m</hi>, wite mid Englum.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6" corresp="#wit-q"><pb n="131" ed="#liebermann"/>Et si quis decimam contrateneat, reddat lahslit cum Dacis, witam cum Anglis.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="6" corresp="#wit-h"><pb n="104" ed="#attenborough"/>Gif<ptr type="editorNote" n="17" target="#EGu_6.attnote.fn.17"/> hwa teoþunge forhealde, gylde lahslit mid Denum, wíte mid Englum.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-h"><pb n="4" ed="#rabin-doml"/>Gif hwa teoþunge forhealde, gylde lahslit mid Denum, wite mid Englum.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="131" ed="#liebermann"/>Wenn jemand den<ptr type="liebermannNote" n="1" target="#EGu_6.lnote.de.1"/> Zehnten<ptr type="liebermannNote" n="2" target="#EGu_6.lnote.de.2"/> vorenthält<ptr type="liebermannNote" n="3" target="#EGu_6.lnote.de.3"/>, zahle er Rechtsbruchbusse<ptr type="liebermannNote" n="4" target="#EGu_6.lnote.de.4"/> bei den Dänen, Strafgeld bei den Engländern.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If anyone withholds tithe, let him pay the penalty for breach of law among the Danes, a fine among the English.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="105" ed="#attenborough"/>If anyone withholds tithe, he shall pay <hi rend="italic">lahslit</hi> in a Danish district, and a fine in an English district.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-h"><pb n="5" ed="#rabin-doml"/>If anyone withholds his tithe, he shall pay lahslit among the Danes or a penalty among the English.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IEm_2">I Em 2</ref>; <ref target="clause:Northu_60">Northu 60</ref></note>
        <note type="textual" source="#rabin-doml">Gif: And B</note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_6.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">130</biblScope></bibl><seg type="original" xml:lang="de">-heolde <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-heolde Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="EGu_6.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">130</biblScope></bibl><seg type="original" xml:lang="de">-ite <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ite Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_6.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Northu 60 benutzt dies für den Ceorl, fügt aber höheres Strafgeld hinzu, wo höhere Stände Zehnt (<hi rend="italic">s. d. Gl</hi> 6—8) weigern</seg><seg type="translation" xml:lang="en" source="#claude">Northu 60 uses this for the ceorl, but adds a higher fine where those of higher rank withhold tithe (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 6—8)</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_6.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Northu 60 benutzt dies für den Ceorl, fügt aber höheres Strafgeld hinzu, wo höhere Stände Zehnt (<hi rend="italic">s. d. Gl</hi> 6—8) weigern</seg><seg type="translation" xml:lang="en" source="#claude">Northu 60 uses this for the ceorl, but adds a higher fine where those of higher rank withhold tithe (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 6—8)</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_6.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">-<hi rend="italic">heolde</hi> spätes Präsens</seg><seg type="translation" xml:lang="en" source="#claude">-<hi rend="italic">heolde</hi> late present</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="EGu_6.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">91</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">= 12 Ör; Northu 60</seg><seg type="translation" xml:lang="en" source="#claude">= 12 ores; Northu 60</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="EGu_6.attnote.fn.17" n="17" source="#attenborough"><bibl><biblScope unit="page">104</biblScope></bibl><label>Gif</label><seg type="original" xml:lang="en"><hi rend="italic">⁊ gyf</hi>. B.</seg></note>
      </div>
