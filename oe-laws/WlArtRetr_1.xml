        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">489</biblScope></bibl><seg type="original" xml:lang="de">insulanos <hi rend="italic">ohne</hi> om. ins. et <hi rend="italic">Sc Hg K3</hi></seg><seg type="translation" xml:lang="en" source="#claude">insulanos without om. ins. et Sc Hg K3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">489</biblScope></bibl><seg type="original" xml:lang="de">prouincias et patrias <hi rend="italic">Sc Hg K3</hi></seg><seg type="translation" xml:lang="en" source="#claude">prouincias et patrias Sc Hg K3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">489</biblScope></bibl><seg type="original" xml:lang="de">et ad <hi rend="italic">fehlt Sc Hg K3</hi></seg><seg type="translation" xml:lang="en" source="#claude">et ad omitted in Sc Hg K3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">489</biblScope></bibl><seg type="original" xml:lang="de">nostri <hi rend="italic">fügt zu Sc Hg K3</hi></seg><seg type="translation" xml:lang="en" source="#claude">Sc Hg K3 add nostri</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">489</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">489</biblScope></bibl><seg type="original" xml:lang="de">nobis <hi rend="italic">Sc Hg K3</hi></seg><seg type="translation" xml:lang="en" source="#claude">nobis Sc Hg K3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Anm. d auf S.</hi> 489</seg><seg type="translation" xml:lang="en" source="#claude">cf. note d on p. 489</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_1.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de">m. o. <hi rend="italic">fehlt Sc Hg K3</hi></seg><seg type="translation" xml:lang="en" source="#claude">m. o. omitted in Sc Hg K3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de">nullo <hi rend="italic">Co Or K3</hi></seg><seg type="translation" xml:lang="en" source="#claude">nullo Co Or K3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_1.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de">forisfcm̄ <hi rend="italic">zweimal Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">forisfcm̄ twice Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">282</biblScope></bibl><seg type="original" xml:lang="de">{e} <hi rend="italic">quidem</hi> Rs—<hi rend="italic">Scottos</hi>{d} <hi rend="italic">Al</hi>. Rs—<hi rend="italic">prou</hi>.{13} <hi rend="italic">et patriarum</hi>, <hi rend="italic">que</hi> Rs besser.—<hi rend="italic">Vgl. Gl</hi> Inseln 1; Schottland 3; Franko-Engländer</seg><seg type="translation" xml:lang="en" source="#claude">{e} <hi rend="italic">quidem</hi> Rs—<hi rend="italic">Scottos</hi>{d} <hi rend="italic">Al</hi>. Rs—<hi rend="italic">prou</hi>.{13} <hi rend="italic">et patriarum</hi>, <hi rend="italic">que</hi> Rs, better.—<hi rend="italic">Cf. Gl</hi> Inseln 1; Schottland 3; Franko-Engländer</seg></note>
