      <div type="clause" n="5.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 5.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 5.3" corresp="#wit-lat"><pb n="548" ed="#liebermann"/>Notandumque<ptr type="liebermannNote" n="40" target="#Hn_5-3.lnote.oe.40"/> per omnia: si accusatus<ptr type="liebermannNote" n="i" target="#Hn_5-3.lnote.oe.i"/> inducias competentes et respondendi uel defendendi licentiam legittimam<ptr type="liebermannNote" n="41" target="#Hn_5-3.lnote.oe.41"/> habuit, ne disseisiatus<ptr type="liebermannNote" n="k" target="#Hn_5-3.lnote.oe.k"/><ptr type="liebermannNote" n="42" target="#Hn_5-3.lnote.oe.42"/> uel inplegiatus uel illegiatus<ptr type="liebermannNote" n="l" target="#Hn_5-3.lnote.oe.l"/> uel surreptione aliqua circumuentus aut fraude iudicetur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 548 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-3.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">induciae, subreptione <hi rend="italic">gleich Pan.</hi> IV 98 <hi rend="italic">f.</hi>; <hi rend="italic">genauer folgt Verf.</hi> 49, 4<hi rend="italic">a.b dem Ivo</hi> Pan. IV 103 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">induciae, subreptione as in Pan. IV 98 f.; in 49, 4a.b the author follows Ivo Pan. IV 103 f. more closely</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-3.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Worte des Verfassers;</hi> inpl. uel inl. uel diss. <hi rend="italic">auch unten</hi> 53, 3; <hi rend="italic">vgl.</hi> 29, 2<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">the author's words; inpl. uel inl. uel diss. also below 53, 3; cf. 29, 2a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-3.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">hier, nicht wie</hi> inlegiet 11, 1<hi rend="italic">a</hi>, <hi rend="italic">Präposition, sondern negativ</hi> (<hi rend="italic">wie</hi> 45, 5 delegiatus), <hi rend="italic">gleich</hi> exlex</seg><seg type="translation" xml:lang="en" source="#claude">in here is not a preposition, as in inlegiet 11, 1a, but negative (as in 45, 5 delegiatus), equivalent to exlex</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-3.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">-mqȝ <hi rend="italic">Sc K;</hi> -mque <hi rend="italic">Co Or;</hi> -m quod <hi rend="italic">Hg Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">-mqȝ Sc K; -mque Co Or; -m quod Hg edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-3.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">h. l. <hi rend="italic">K;</hi> habuerit l. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">h. l. K; habuerit l. Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_5-3.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">548</biblScope></bibl><seg type="original" xml:lang="de">-sais. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sais. Lond</seg></note>
      </div>
