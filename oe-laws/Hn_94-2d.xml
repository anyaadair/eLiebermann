      <div type="clause" n="94.2d">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 94.2d</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 94.2d" corresp="#wit-lat"><pb n="611" ed="#liebermann"/>Si sanguinem ei faciat et recedat sine crauacione<ptr type="liebermannNote" n="12" target="#Hn_94-2d.lnote.oe.12"/> et diuadiacione, witam domini<ptr type="liebermannNote" n="17" target="#Hn_94-2d.lnote.oe.17"/> retulit<ptr type="liebermannNote" n="h" target="#Hn_94-2d.lnote.oe.h"/>, et non habebit eam dominus cuius<ptr type="liebermannNote" n="18" target="#Hn_94-2d.lnote.oe.18"/> hominem uulnerauit<ptr type="liebermannNote" n="19" target="#Hn_94-2d.lnote.oe.19"/>; si autem retineatur<ptr type="liebermannNote" n="i" target="#Hn_94-2d.lnote.oe.i"/> uel diuadietur<ptr type="liebermannNote" n="20" target="#Hn_94-2d.lnote.oe.20"/> uel implegietur ibi, blodwita<ptr type="liebermannNote" n="21" target="#Hn_94-2d.lnote.oe.21"/> et<ptr type="liebermannNote" n="22" target="#Hn_94-2d.lnote.oe.22"/> fihtwita<ptr type="liebermannNote" n="23" target="#Hn_94-2d.lnote.oe.23"/> poterit aggregari.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 611 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2d.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">hat er das dem Herrn des Orts oder Verletzten zustehende Strafgeld mit fortgenommen, <hi rend="italic">braucht er nur Strafe für Blutverguss zu zahlen, da wo er verklagt werden wird</hi></seg><seg type="translation" xml:lang="en" source="#claude">if he has carried off with him the fine due to the lord of the place or of the injured man, he need only pay the penalty for bloodshed where he is accused</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2d.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 23, 1</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 23, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2d.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">gr. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">gr. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2d.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">domi <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">domi K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2d.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">cum <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">cum Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2d.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">-uerit <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-uerit Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2d.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">deu. <hi rend="italic">Co;</hi> -iatur <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">deu. Co; -iatur Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2d.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">-wytam <hi rend="italic">K;</hi> -am <hi rend="italic">Or;</hi> blodhwitam <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-wytam K; -am Or; blodhwitam Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-2d.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">611</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel Lond</seg></note>
