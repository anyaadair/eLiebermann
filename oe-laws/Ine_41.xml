    <body>
      <div type="clause" n="41">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 41</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="41" corresp="#wit-e"><pb n="106" ed="#liebermann"/>LXXXV. Borges mon mót oðsacan<ptr type="liebermannNote" n="16" target="#Ine_41.lnote.oe.16"/>, gif he wát, þ<hi rend="italic">æt</hi> he ryht<ptr type="liebermannNote" n="17" target="#Ine_41.lnote.oe.17"/> deð.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="41" corresp="#wit-h"><pb n="106" ed="#liebermann"/>LXXXV. Borges mon<ptr type="liebermannNote" n="1" target="#Ine_41.lnote.oe.1-2"/> mot ætsacan, gif he wat, ðæt he riht deð.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="41" corresp="#wit-b-no-prol"><pb n="106" ed="#liebermann"/>Borges<ptr type="liebermannNote" n="1" target="#Ine_41.lnote.oe.1"/> mon mot ætsacan, gyf he wat, þ<hi rend="italic">æt</hi> he riht deð.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="41" corresp="#wit-q"><pb n="107" ed="#liebermann"/>Plegium potest<ptr type="liebermannNote" n="8" target="#Ine_41.lnote.oe.8"/> homo (licet homini<ptr type="liebermannNote" n="9" target="#Ine_41.lnote.oe.9"/>) pernegare<ptr type="liebermannNote" n="10" target="#Ine_41.lnote.oe.10"/>, si sciat, quod rectum<ptr type="liebermannNote" n="11" target="#Ine_41.lnote.oe.11"/> faciat.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="48" ed="#attenborough"/>Borges mon mót oðsacan<ptr type="editorNote" n="18" target="#Ine_41.attnote.fn.18"/>, gif he wát þæt he ryht deð.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="42" corresp="#wit-e"><pb n="406" ed="#jurasinski-and-oliver"/>{LXXXV} Borges mon mót oðsacan, gif he wát, þ<hi rend="italic">æt</hi> he ryht deð.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="107" ed="#liebermann"/>Von<ptr type="liebermannNote" n="1" target="#Ine_41.lnote.de.1"/> Bürgschafts[pflicht] kann sich jemand frei schwören<ptr type="liebermannNote" n="2" target="#Ine_41.lnote.de.2"/>, wenn er weiss<ptr type="liebermannNote" n="3" target="#Ine_41.lnote.de.3"/>, dass er recht thut.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Someone may swear himself free of [the obligation of] surety, if he knows that he is acting rightly.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="49" ed="#attenborough"/>It is permissible for one to repudiate bail [that he has given for another], if he knows he is acting justly.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="404" ed="#whitelock"/>Anyone can deny bail<ptr type="editorNote" n="5" target="#Ine_41.whinote.n.5"/> by oath if he knows that he is doing right.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="407" ed="#jurasinski-and-oliver"/>A person may deny surety [that he has promised for another] if he knows that he does it justly.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_41.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">106</biblScope></bibl><seg type="original" xml:lang="de">orges, <hi rend="italic">im 16. Jh.</hi> B <hi rend="italic">davor</hi></seg><seg type="translation" xml:lang="en" source="#claude">orges, B added before it in the 16th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_41.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">107</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur</hi> po. homo <hi rend="italic">Lond; nur</hi> li. h. <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">only po. homo Lond; only li. h. the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_41.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">107</biblScope></bibl><seg type="original" xml:lang="de">hominis <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">hominis MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_41.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">107</biblScope></bibl><seg type="original" xml:lang="de">purgare <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">purgare Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_41.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">107</biblScope></bibl><seg type="original" xml:lang="de">f. r. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. r. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_41.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">106</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in a</hi></seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_41.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">106</biblScope></bibl><seg type="original" xml:lang="de">ætsa. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ætsa. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_41.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">106</biblScope></bibl><seg type="original" xml:lang="de">riht <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">riht Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_41.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">75</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Diese 2 Zeilen stehen an diesem Orte gewiss nicht im Sinne des ursprünglichen Ordners. Denkt man sie fort, so folgt auf die Umzäunung des Gehöftes sachgemäss die von Flur und Wiese. — Gegen meine Übersetzung berichtige man ‘Darlehnschuld’; <hi rend="italic">s. d. Gl</hi> 4. Nicht ‘Friedensbürgschaft’ mit Thorpe <hi rend="italic">Dipl.</hi> p. xvij</seg><seg type="translation" xml:lang="en" source="#claude">These 2 lines certainly do not stand in this place as the original arranger intended. If one leaves them out, the fencing of the homestead is fittingly followed by that of arable and meadow. — In my translation, correct to ‘debt on a loan’; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 4. Not ‘surety for the peace’, with Thorpe <hi rend="italic">Dipl.</hi> p. xvij</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_41.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">75</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">H modernisiert</seg><seg type="translation" xml:lang="en" source="#claude">H modernises</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_41.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">75</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Moralische Mahnung ans Gewissen; <hi rend="italic">s. d. Gl</hi> 1</seg><seg type="translation" xml:lang="en" source="#claude">A moral admonition to the conscience; <hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_41.attnote.fn.18" n="18" source="#attenborough"><bibl><biblScope unit="page">48</biblScope></bibl><label>oðsacan</label><seg type="original" xml:lang="en"><hi rend="italic">ætsacan</hi>. B, H.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Ine_41.whinote.n.5" n="5" source="#whitelock"><bibl><biblScope unit="page">404</biblScope></bibl><label>bail</label><seg type="original" xml:lang="en">or perhaps “a debt”</seg></note>
      </div>
