      <div type="clause" n="22">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 22</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 22" corresp="#wit-lat"><ptr type="liebermannNote" n="13" target="#IudDeiI_22.lnote.oe.13"/><pb n="405" ed="#liebermann"/>Alia. <ptr type="liebermannNote" n="14" target="#IudDeiI_22.lnote.oe.14"/>Adiuro te, creatura<ptr type="liebermannNote" n="15" target="#IudDeiI_22.lnote.oe.15"/> aquae, per Deum<ptr type="liebermannNote" n="16" target="#IudDeiI_22.lnote.oe.16"/> patrem et<ptr type="liebermannNote" n="16" target="#IudDeiI_22.lnote.oe.16"/> Filium et Spiritum<ptr type="liebermannNote" n="16" target="#IudDeiI_22.lnote.oe.16"/> sanctum et per tremendum diem iudicii et per<ptr type="liebermannNote" n="17" target="#IudDeiI_22.lnote.oe.17"/> duodecim apostolos et<ptr type="liebermannNote" n="18" target="#IudDeiI_22.lnote.oe.18"/> per septuaginta duos discipulos et per duodecim prophetas et per uiginti quatuor seniores, qui assidue Dominum<ptr type="liebermannNote" n="19" target="#IudDeiI_22.lnote.oe.19"/> laudant et per centum quadraginta quatuor milia, quae<ptr type="liebermannNote" n="20" target="#IudDeiI_22.lnote.oe.20"/> sequuntur<ptr type="liebermannNote" n="21" target="#IudDeiI_22.lnote.oe.21"/> Agnum, et per omnia agmina sanctorum angelorum, archangelorum, thronorum<ptr type="liebermannNote" n="22" target="#IudDeiI_22.lnote.oe.22"/>, dominationum, principatuum<ptr type="liebermannNote" n="23" target="#IudDeiI_22.lnote.oe.23"/>, potestatum, uirtutum, Cherubin atque<ptr type="liebermannNote" n="24" target="#IudDeiI_22.lnote.oe.24"/> Seraphin, et per omnia milia<ptr type="liebermannNote" n="25" target="#IudDeiI_22.lnote.oe.25"/> sanctorum martyrum, uirginum<ptr type="liebermannNote" n="26" target="#IudDeiI_22.lnote.oe.26"/> et confessorum.</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Luc. 10, 1; Apoc. 4, 10; 7, 4; Colos. 1, 16; Rom. 8, 38</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 405 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">Item tertia <hi rend="italic">Rj;</hi> Alia adiuratio <hi rend="italic">Ch;</hi> Item a. coniuracio <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Item tertia Rj; Alia adiuratio Ch; Item a. coniuracio Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">22—22, 3 <hi rend="italic">gleich unten</hi> V 2, <hi rend="italic">nur dort bezogen auf</hi> ferrum; <hi rend="italic">vgl. u. S.</hi> 418²</seg><seg type="translation" xml:lang="en" source="#claude">22—22, 3 identical with V 2 below, only there referring to ferrum; cf. below p. 418²</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">aqua per Pa. <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">aqua per Pa. Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">+ <hi rend="italic">roth übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">+ written above in red H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ähnliche Formel Zeumer</hi> 695 (3). 617. 623. 633. 648. 656<hi rend="italic">l</hi>. 664₂₇. 666<hi rend="italic">c</hi>. 671<hi rend="italic">f</hi>. 685<hi rend="italic">o</hi>. 689<hi rend="italic">i</hi>. 691<hi rend="italic">f</hi>; <hi rend="italic">Excommunic.</hi> II 1</seg><seg type="translation" xml:lang="en" source="#claude">similar formula Zeumer 695 (3). 617. 623. 633. 648. 656<hi rend="italic">l</hi>. 664₂₇. 666<hi rend="italic">c</hi>. 671<hi rend="italic">f</hi>. 685<hi rend="italic">o</hi>. 689<hi rend="italic">i</hi>. 691<hi rend="italic">f</hi>; <hi rend="italic">Excommunic.</hi> II 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">et—prophetas <hi rend="italic">fehlt Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">et—prophetas omitted in Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">Deum <hi rend="italic">Rj Ch Ci Ca H Co</hi> V</seg><seg type="translation" xml:lang="en" source="#claude">Deum Rj Ch Ci Ca H Co V</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">qui <hi rend="italic">Rj Ci Co</hi> V</seg><seg type="translation" xml:lang="en" source="#claude">qui Rj Ci Co V</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">secu. <hi rend="italic">Ps Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">secu. Ps Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">thronos, dominationes V, <hi rend="italic">näher zu Zeu.</hi> 648</seg><seg type="translation" xml:lang="en" source="#claude">thronos, dominationes V, closer to Zeu. 648</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">-tum <hi rend="italic">Ch Ca H</hi> V</seg><seg type="translation" xml:lang="en" source="#claude">-tum Ch Ca H V</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">et Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">s. mi. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. mi. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_22.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">405</biblScope></bibl><seg type="original" xml:lang="de">co. et ui. <hi rend="italic">Ch Vt;</hi> co. atque ui. <hi rend="italic">Ci Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">co. et ui. Ch Vt; co. atque ui. Ci Co</seg></note>
