      <div type="clause" n="62">
        <head><ref type="lawCode" target="law:Af">Af</ref> 62</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="62" corresp="#wit-e"><pb n="82" ed="#liebermann"/>Gif monnes ðeoh bið þyrel<ptr type="liebermannNote" n="24" target="#Af_62.lnote.oe.24"/>, geselle<ptr type="liebermannNote" n="25" target="#Af_62.lnote.oe.25"/> him mon XXX scill. to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="62" corresp="#wit-h"><pb n="82" ed="#liebermann"/>Gif monnes<ptr type="liebermannNote" n="1" target="#Af_62.lnote.oe.1"/> þeoh bið þyrel, gesylle<ptr type="liebermannNote" n="10" target="#Af_62.lnote.oe.10"/> him mon<ptr type="liebermannNote" n="1" target="#Af_62.lnote.oe.1"/> XXX scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="62" corresp="#wit-b-no-prol"><pb n="82" ed="#liebermann"/>Gyf monnes ðeoh bið ðurl<ptr type="liebermannNote" n="5" target="#Af_62.lnote.oe.5"/>, gesylle him man ðrittig scill' to bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="62" corresp="#wit-q"><pb n="83" ed="#liebermann"/>Si coxa transpungatur homini, XXX<ptr type="liebermannNote" n="25" target="#Af_62.lnote.oe.25-2"/> solid. emendetur ei.<ptr type="liebermannNote" n="19" target="#Af_62.lnote.oe.19"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="88" ed="#attenborough"/>Gif monnes ðeoh bið þyrel, geselle him mon XXX scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="65" corresp="#wit-e"><pb n="356" ed="#jurasinski-and-oliver"/>Gif monnes ðeoh bið þyrel, geselle him mon XXX scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="83" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_62.lnote.de.1"/> jemandes Dickbein<ptr type="liebermannNote" n="2" target="#Af_62.lnote.de.2"/> durchbohrt ist, gebe man ihm 30 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a person’s thigh is pierced, let him be given 30 shillings as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="89" ed="#attenborough"/>If a man's thigh is pierced, 30 shillings shall be given to him as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="357" ed="#jurasinski-and-oliver"/>If a man’s thigh is pierced, let him be paid 30 shillings as compensation.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_62.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">ðyrl <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðyrl Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_62.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">gesylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gesylle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_62.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_62.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_62.lnote.oe.25-2" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">em. XXX s. <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">em. XXX s. Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_62.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_62.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> ðyrl</seg><seg type="translation" xml:lang="en" source="#claude">altered to ðyrl</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_62.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Beeinflusst durch Abt 67</seg><seg type="translation" xml:lang="en" source="#claude">Influenced by Abt 67</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_62.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Oberschenkel</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Oberschenkel</seg></note>
