      <div type="clause" n="75.9">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 75.9</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 75.9" corresp="#wit-lat"><pb n="592" ed="#liebermann"/>Si ex parte patris parentes habeat et<ptr type="liebermannNote" n="7" target="#Hn_75-9.lnote.oe.7"/> ex parte matris non habeat, et hominem occiderit, reddant pertinentes<ptr type="liebermannNote" n="35" target="#Hn_75-9.lnote.oe.35"/> ei<ptr type="liebermannNote" n="v" target="#Hn_75-9.lnote.oe.v"/> quantum de eius interfeccione reciperent<ptr type="liebermannNote" n="36" target="#Hn_75-9.lnote.oe.36"/>, id est duas partes weregildi sui.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 592 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-9.lnote.oe.v" n="v" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de">die mit dem Todtschläger Verwandten; <hi rend="italic">vgl.</hi> 88, 11<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">those related to the slayer; <hi rend="italic">cf.</hi> 88, 11<hi rend="italic">b</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-9.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-9.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de">parentes <hi rend="italic">statt</hi> p. ei <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">parentes <hi rend="italic">instead of</hi> p. ei <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_75-9.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">592</biblScope></bibl><seg type="original" xml:lang="de">-pient <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-pient <hi rend="italic">Lond</hi></seg></note>
