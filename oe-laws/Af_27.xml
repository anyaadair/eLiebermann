      <div type="clause" n="27">
        <head><ref type="lawCode" target="law:Af">Af</ref> 27</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="27" corresp="#wit-e"><pb n="66" ed="#liebermann"/>Gif fædrenmæga<ptr type="liebermannNote" n="5" target="#Af_27.lnote.oe.5"/> mægleas mon<ptr type="liebermannNote" n="6" target="#Af_27.lnote.oe.6"/> gefeohte<ptr type="liebermannNote" n="7" target="#Af_27.lnote.oe.7"/><ptr type="liebermannNote" n="**" target="#Af_27.lnote.oe.star2"/> ⁊ mon<ptr type="liebermannNote" n="6" target="#Af_27.lnote.oe.6"/> ófslea, ⁊ þon<hi rend="italic">ne</hi> gif<ptr type="liebermannNote" n="8" target="#Af_27.lnote.oe.8"/> medrenmægas<ptr type="liebermannNote" n="9" target="#Af_27.lnote.oe.9"/> hæbbe, gielden<ptr type="liebermannNote" n="10" target="#Af_27.lnote.oe.10"/> ða<ptr type="liebermannNote" n="***" target="#Af_27.lnote.oe.star3"/> þæs weres ðriddan<ptr type="liebermannNote" n="11" target="#Af_27.lnote.oe.11"/> dæl [⁊<ptr type="liebermannNote" n="†" target="#Af_27.lnote.oe.dagger"/> ðriddan<ptr type="liebermannNote" n="11" target="#Af_27.lnote.oe.11"/> dæl þa<ptr type="liebermannNote" n="12" target="#Af_27.lnote.oe.12"/> gegildan<ptr type="liebermannNote" n="13" target="#Af_27.lnote.oe.13"/>, for ðriddan<ptr type="liebermannNote" n="14" target="#Af_27.lnote.oe.14"/> dæl] he fleo.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="27" corresp="#wit-h"><pb n="66" ed="#liebermann"/>Gif fædrenmæga<ptr type="liebermannNote" n="3" target="#Af_27.lnote.oe.3"/> mægleas mon gefeohte ⁊ mon<ptr type="liebermannNote" n="2" target="#Af_27.lnote.oe.2"/> ofslea, ⁊ þonne gif he medrenmægas<ptr type="liebermannNote" n="4" target="#Af_27.lnote.oe.4"/> hæbbe, gilden<ptr type="liebermannNote" n="5" target="#Af_27.lnote.oe.5-2"/> ða ðæs weres<ptr type="liebermannNote" n="6" target="#Af_27.lnote.oe.6-2"/> ðriddan dæl, ðriddan dæl þa gegyldan, for ðriddan<ptr type="liebermannNote" n="7" target="#Af_27.lnote.oe.7-2"/> dæl he fleo.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="27" corresp="#wit-b-no-prol"><pb n="67" ed="#liebermann"/>Gyf fædrenmaga<ptr type="liebermannNote" n="2" target="#Af_27.lnote.oe.2-2"/> mæigleas mon gefeohte ⁊ mon ofsléa, ⁊ ðonne gyf<ptr type="liebermannNote" n="3" target="#Af_27.lnote.oe.3-3"/> meddrenmagas hæbbe, gylden þa ðæs weres ðriddan dǽl [ <ptr type="liebermannNote" n="4" target="#Af_27.lnote.oe.4-3"/>], for ðriddan dæl he fléo.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="27" corresp="#wit-q"><pb n="67" ed="#liebermann"/>Si quis ex parte patris sui cognatione carens hominem<ptr type="liebermannNote" n="3" target="#Af_27.lnote.oe.3-2"/> occidat, si ex materna<ptr type="liebermannNote" n="4" target="#Af_27.lnote.oe.4-2"/> cognationem<ptr type="liebermannNote" n="5" target="#Af_27.lnote.oe.5-3"/> habeat, reddat ipsa<ptr type="liebermannNote" n="6" target="#Af_27.lnote.oe.6-3"/> terciam partem compositionis, terciam congildones eius<ptr type="liebermannNote" n="7" target="#Af_27.lnote.oe.7-3"/>, pro tercia parte fugiat.<ptr type="liebermannNote" n="8" target="#Af_27.lnote.oe.8-2"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="76" ed="#attenborough"/>Gif fædrenmæga mægleas<ptr type="editorNote" n="16" target="#Af_27.attnote.fn.16"/> mon gefeohte ⁊ mon ófslea<ptr type="editorNote" n="17" target="#Af_27.attnote.fn.17"/>, ⁊ þonne gif<ptr type="editorNote" n="18" target="#Af_27.attnote.fn.18"/> medrenmægas hæbbe, gielden ða<ptr type="editorNote" n="19" target="#Af_27.attnote.fn.19"/> þæs weres ðriddan dæl, [ðriddan dæl þa gegyldan, for ðriddan dæl]<ptr type="editorNote" n="20" target="#Af_27.attnote.fn.20"/> he fleo.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="32" corresp="#wit-e"><pb n="324" ed="#jurasinski-and-oliver"/>Gif fædrenmæga mægleas mon gefeohte ⁊ mon óflsea, ⁊ þon<hi rend="italic">ne</hi> gif medrenmægas hæbbe, gielden ða þæs weres ðriddan dæl, [ðriddan dæl þa gegyldan, for ðriddan dæl] he fleo.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="67" ed="#liebermann"/>Wenn ein an Vaterfamilie sippenloser<ptr type="liebermannNote" n="1" target="#Af_27.lnote.de.1"/> Mann ficht und einen Menschen erschlägt<ptr type="liebermannNote" n="2" target="#Af_27.lnote.de.2"/>, falls er jedoch mütterliche Verwandte besitzt, so entrichten diese des Wergeldes dritten Theil und ein Drittel die Gildegenossen<ptr type="liebermannNote" n="3" target="#Af_27.lnote.de.3"/>; für [das letzte] Drittel<ptr type="liebermannNote" n="4" target="#Af_27.lnote.de.4"/> fliehe er.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a man without kin on his father’s side fights and slays a person, if he nevertheless has maternal kinsmen, let these pay a third of the wergeld and the guild-brothers a third; for [the last] third let him flee.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="77" ed="#attenborough"/>If anyone who has no paternal relatives fights and kills a man, his maternal relatives, if he has any, shall pay one-third of the wergeld and his associates<ptr type="editorNote" n="1" target="#Af_27.attnote.n.1"/> shall pay one-third. In default of payment of the [remaining] third, he shall be held personally responsible<ptr type="editorNote" n="2" target="#Af_27.attnote.n.2"/>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="414" ed="#whitelock"/>If a man without paternal kinsmen fights and kills a man, and if then he has maternal kinsmen, those are to pay a third share of the wergild, [and the associates<ptr type="editorNote" n="3" target="#Af_27.whinote.n.3"/> a third; for the third part]<ptr type="editorNote" n="4" target="#Af_27.whinote.n.4"/> he is to flee.<ptr type="editorNote" n="5" target="#Af_27.whinote.n.5"/></ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="325" ed="#jurasinski-and-oliver"/>If someone who has no paternal kin fights and kills someone, and if he nonetheless has maternal kin, let them pay a third portion of the <hi rend="italic">wer</hi>, and his associates a third portion, and for the third portion let him flee.</ab>
        <note type="comparison" source="#jurasinski-and-oliver" n="325"><label>cf.</label> <ref target="clause:Ine_74">Ine 74</ref> <quote>he fleo ("let him flee") is unclear. Ine §75 states that if a Welsh slave kills an English man [...] Perhaps this is what the guilty party here is fleeing.</quote></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">fædrem. <hi rend="italic">So;</hi> -maga <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fædrem. So; -maga Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_27.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">man <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">man Ld</seg></note>
