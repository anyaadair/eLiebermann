        <note type="liebermannNote" subtype="textual" xml:id="Af_5-4.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">hwil. <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">hwil. So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-4.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">nom. <hi rend="italic">So</hi></seg><seg type="translation" xml:lang="en" source="#claude">nom. So</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_5-4.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">52</biblScope></bibl><seg type="original" xml:lang="de">geond. <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">geond. So Ld</seg></note>
