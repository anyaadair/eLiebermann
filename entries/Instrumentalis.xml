          <sense n="5"><hi rend="italic">Beschaffenheit:</hi> hine fleame nyste <hi rend="italic">ihn unter Acht</hi> (<hi rend="italic">in Bann</hi>) <hi rend="italic">nicht wusste</hi> <ref type="lawCode" target="law:IICn">II Cn</ref> 13,2</sense>
