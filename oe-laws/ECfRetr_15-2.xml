    <body>
      <div type="clause" n="15.2">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 15.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 15.2"><pb n="641" ed="#liebermann"/><hi rend="bold">Qui</hi> si<ptr type="liebermannNote" n="10" target="#ECfRetr_15-2.lnote.la.10"/> <hi rend="bold">infra terminum</hi> non inueniebatur<ptr type="liebermannNote" n="11" target="#ECfRetr_15-2.lnote.la.11"/>, colligebantur in uilla<ptr type="liebermannNote" n="12" target="#ECfRetr_15-2.lnote.la.12"/> quadraginta sex marce.</ab>
        <note type="comparison" source="#liebermann" n="641"><label>printed alongside</label> <ref target="clause:ECf_15-2">ECf 15.2</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 641 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-2.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">Quodsi <hi rend="italic">Lb Va Kn Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Quodsi Lb Va Kn Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-2.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">inueniri non poterit, colligantur <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">inueniri non poterit, colligantur Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-2.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">641</biblScope></bibl><seg type="original" xml:lang="de">sua <hi rend="italic">fügt zu Lb Va Ph;</hi> illa <hi rend="italic">fügt zu K</hi></seg><seg type="translation" xml:lang="en" source="#claude">Lb Va Ph add sua; K adds illa</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">And if he was not found within the term, forty-six marks were collected in the vill.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_15-2.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">346</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Quodsi</hi><hi rend="superscript">10</hi> — <hi rend="italic">uilla</hi><hi rend="superscript">12</hi> <hi rend="italic">illa</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Quodsi</hi><hi rend="superscript">10</hi> — <hi rend="italic">uilla</hi><hi rend="superscript">12</hi> <hi rend="italic">illa</hi> Rs</seg></note>
      </div>
    </body>
