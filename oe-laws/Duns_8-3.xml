    <body>
      <div type="clause" n="8.3">
        <head><ref type="lawCode" target="law:Duns">Duns</ref> 8.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8.3" corresp="#wit-b"><pb n="378" ed="#liebermann"/>Gif hit man<ptr type="liebermannNote" n="5" target="#Duns_8-3.lnote.oe.5"/> begeondan str[e]ame<ptr type="liebermannNote" n="15" target="#Duns_8-3.lnote.oe.15"/> agnian wylle<ptr type="liebermannNote" n="11" target="#Duns_8-3.lnote.oe.11"/>, ðone<ptr type="liebermannNote" n="16" target="#Duns_8-3.lnote.oe.16"/> sceal þ<hi rend="italic">æt</hi> beon mid ordale.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="8.3" corresp="#wit-q"><pb n="379" ed="#liebermann"/>Si quis trans flumen propriare sibi uelit<ptr type="liebermannNote" n="19" target="#Duns_8-3.lnote.oe.19"/>, tunc erit hoc per ordalium.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="379" ed="#liebermann"/>Wenn jemand jenseits des Stromes [gegen diesseitigen Anefänger] es als sein Ureigen behaupten will, dann soll dies [nur] durch Ordal<ptr type="liebermannNote" n="1" target="#Duns_8-3.lnote.de.1"/> [ihm möglich] sein.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If anyone beyond the river wishes to claim it as his own property [against the attacher on this side], then this shall be [possible for him only] by ordeal.</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-b">If the man on the other side of the stream [he who seized the cattle] wants to retain them, then that shall be [only possible] through the ordeal.</ab>
        <note type="editorial">U: translator unrecorded: check; B reads ‘strame’; Ld ‘stream’.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Duns_8-3.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">378</biblScope></bibl><seg type="original" xml:lang="de">mon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duns_8-3.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">378</biblScope></bibl><seg type="original" xml:lang="de">strame <hi rend="italic">B;</hi> stream <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">strame B; stream Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duns_8-3.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">378</biblScope></bibl><seg type="original" xml:lang="de">wille <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wille Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duns_8-3.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">378</biblScope></bibl><seg type="original" xml:lang="de">ðonne sceall <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðonne sceall Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duns_8-3.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">379</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt M Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in M Hk</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Duns_8-3.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">219</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Wie <hi rend="italic">o</hi>. 2, 1¹ erschwert gegen sonstiges Recht; <hi rend="italic">s. Gl</hi> Ordal 22a; Anefang 25c</seg><seg type="translation" xml:lang="en" source="#claude">As <hi rend="italic">above</hi> 2, 1¹, made harder than under the ordinary law; <hi rend="italic">see Gl</hi> Ordal 22a; Anefang 25c</seg></note>
      </div>
