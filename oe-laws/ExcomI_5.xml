      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:ExcomI">Excom I</ref> 5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom I 5" corresp="#wit-ti"><pb n="432" ed="#liebermann"/>De talibus itaque transgressoribus et sanctæ religionis pacisque, quam Christus<ptr type="liebermannNote" n="19" target="#ExcomI_5.lnote.oe.19"/> suis discipulis dedit atque reliquit<ptr type="liebermannNote" n="20" target="#ExcomI_5.lnote.oe.20"/>, uiolatoribus precepta dominica et apostolica habemus, quibus informamur, quod<ptr type="liebermannNote" n="21" target="#ExcomI_5.lnote.oe.21"/> de huiusmodi preuaricatoribus agere nos oporteat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 432 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_5.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de">s. d. C. <hi rend="italic">Vb;</hi> ipse <hi rend="italic">fügt zu Reg in einigen Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. d. C. Vb; ipse added by Reg in some MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_5.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de">-qið <hi rend="italic">Ti;</hi> dereliquit <hi rend="italic">Mart</hi></seg><seg type="translation" xml:lang="en" source="#claude">-qið Ti; dereliquit Mart</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomI_5.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">432</biblScope></bibl><seg type="original" xml:lang="de">quid de huiuscem. <hi rend="italic">Vb Roz.</hi></seg><seg type="translation" xml:lang="en" source="#claude">quid de huiuscem. Vb Roz.</seg></note>
