      <div type="clause" n="90.4">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 90.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 90.4" corresp="#wit-lat"><pb n="605" ed="#liebermann"/>Quodsi<ptr type="liebermannNote" n="39" target="#Hn_90-4.lnote.oe.39"/> in sepem animal inpalauerit et ipsa<ptr type="liebermannNote" n="12" target="#Hn_90-4.lnote.oe.12"/> sepes<ptr type="liebermannNote" n="k" target="#Hn_90-4.lnote.oe.k"/> mentonalis<ptr type="liebermannNote" n="40" target="#Hn_90-4.lnote.oe.40"/> non<ptr type="liebermannNote" n="41" target="#Hn_90-4.lnote.oe.41"/> fuerit, dominus<ptr type="liebermannNote" n="42" target="#Hn_90-4.lnote.oe.42"/> sepis interfeccionis<ptr type="liebermannNote" n="l" target="#Hn_90-4.lnote.oe.l"/> seu<ptr type="liebermannNote" n="43" target="#Hn_90-4.lnote.oe.43"/> debilitatis reus iudicetur.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 605 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-4.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verf. benutzt also Classe</hi> B <hi rend="italic">der Lex Ribuaria</hi></seg><seg type="translation" xml:lang="en" source="#claude">The author therefore uses class B of the Lex Ribuaria</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-4.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur wenn der Zaun sechs kleine Fuss, kinnhoch ist, zahlt den Schaden, den eindringendes Vich stiftet, dessen Herr noch in Amerika; Leo</hi> Rectitudines 62</seg><seg type="translation" xml:lang="en" source="#claude">only if the fence is six small feet, i.e. chin-high, does its owner pay for the damage done by cattle breaking in, even today in America; Leo Rectitudines 62</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-4.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-4.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">Quod <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Quod Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-4.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">-olanis <hi rend="italic">Sc Hg;</hi> -ncionalis <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-olanis Sc Hg; -ncionalis Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-4.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">si <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">si K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-4.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">dnis <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">dnis Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-4.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-4.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Gehege 5—<hi rend="italic">ipsa</hi>{42} fehlt—<hi rend="italic">uel</hi>{45}—90, 4b <hi rend="italic">-dum</hi>{49}—90, 5 <hi rend="italic">-tus</hi>{51}—90, 6 <hi rend="italic">illud</hi>{55} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Gehege 5—<hi rend="italic">ipsa</hi>{42} missing—<hi rend="italic">uel</hi>{45}—90, 4b <hi rend="italic">-dum</hi>{49}—90, 5 <hi rend="italic">-tus</hi>{51}—90, 6 <hi rend="italic">illud</hi>{55} Rs</seg></note>
