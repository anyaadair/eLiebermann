    <body>
      <div type="clause" n="11.17">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 11.17</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 11.17" corresp="#wit-lat"><pb n="557" ed="#liebermann"/>In causis autem<ptr type="liebermannNote" n="l" target="#Hn_11-17.lnote.oe.l"/> emendabilibus sanctorum miseracione permissum<ptr type="liebermannNote" n="52" target="#Hn_11-17.lnote.oe.52"/> est, ut terreni domini audeant ex eorum licencia peccunialem emendacionem capere secundum legem<ptr type="liebermannNote" n="m" target="#Hn_11-17.lnote.oe.m"/> patrie.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 557 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-17.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de">nämlich, <hi rend="italic">erklärt</hi> uenia</seg><seg type="translation" xml:lang="en" source="#claude">namely, <hi rend="italic">explains</hi> uenia</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-17.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de">Angelsächs. Recht; <hi rend="italic">auch sonst</hi> patria: England, <hi rend="italic">nicht:</hi> Verfassers Geburtsland</seg><seg type="translation" xml:lang="en" source="#claude">Anglo-Saxon law; <hi rend="italic">elsewhere too</hi> patria: England, <hi rend="italic">not</hi> the author's native land</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-17.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de">Dominum <hi rend="italic">Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Dominum <hi rend="italic">edd.</hi></seg><note type="remark" resp="#claude">marker not found in the text</note></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-17.lnote.oe.52" n="52" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">557</biblScope></bibl><seg type="original" xml:lang="de">prom. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">prom. <hi rend="italic">Co Or</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_11-17.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de">Religiöse Begründung weltlicher Justiz erblickt hierin Stubbs (<hi rend="italic">Lect</hi>. 156) richtig: doch vielleicht nur für die Quelle, Ælfred, beweiskräftig—12 <hi rend="italic">em</hi>.{2} <hi rend="italic">d., que non</hi>: besser—12, 1 <hi rend="italic">Ex his</hi>—12, 1a <hi rend="italic">Q. eme. n</hi>.{6} <hi rend="italic">p</hi>., <hi rend="italic">q</hi>. besser—<hi rend="italic">þiepe</hi>{8} <hi rend="italic">et c. morð et hafordswiche</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude">Stubbs (<hi rend="italic">Lect</hi>. 156) rightly sees in this a religious justification of secular justice: but perhaps conclusive only for the source, Ælfred—12 <hi rend="italic">em</hi>.{2} <hi rend="italic">d., que non</hi>: better—12, 1 <hi rend="italic">Ex his</hi>—12, 1a <hi rend="italic">Q. eme. n</hi>.{6} <hi rend="italic">p</hi>., <hi rend="italic">q</hi>. better—<hi rend="italic">þiepe</hi>{8} <hi rend="italic">et c. morð et hafordswiche</hi> Rs</seg></note>
      </div>
