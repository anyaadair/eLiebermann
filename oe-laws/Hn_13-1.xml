      <div type="clause" n="13.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 13.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 13.1" corresp="#wit-lat"><pb n="558" ed="#liebermann"/>Hec mittunt hominem in misericordia regis: infraccio<ptr type="liebermannNote" n="w" target="#Hn_13-1.lnote.oe.w"/> pacis, quam per manum<ptr type="liebermannNote" n="x" target="#Hn_13-1.lnote.oe.x"/> suam dabit alicui; contemptus<ptr type="liebermannNote" n="y" target="#Hn_13-1.lnote.oe.y"/> breuium<ptr type="liebermannNote" n="35" target="#Hn_13-1.lnote.oe.35"/> suorum<ptr type="liebermannNote" n="36" target="#Hn_13-1.lnote.oe.36"/> et quicquid ad propriam eius<ptr type="liebermannNote" n="z" target="#Hn_13-1.lnote.oe.z"/> personam uel mandatorum suorum contumeliatur iniuriam; de famulis<ptr type="liebermannNote" n="y" target="#Hn_13-1.lnote.oe.y"/> suis<ptr type="liebermannNote" n="z" target="#Hn_13-1.lnote.oe.z"/> in ciuitate uel<ptr type="liebermannNote" n="37" target="#Hn_13-1.lnote.oe.37"/> castello uel ubicunque occisis<ptr type="liebermannNote" n="38" target="#Hn_13-1.lnote.oe.38"/>; infidelitas<ptr type="liebermannNote" n="x" target="#Hn_13-1.lnote.oe.x"/> et prodicio; despectus<ptr type="liebermannNote" n="y" target="#Hn_13-1.lnote.oe.y"/> de eo; castellacio<ptr type="liebermannNote" n="y" target="#Hn_13-1.lnote.oe.y"/> sine licentia; utlagaria<ptr type="liebermannNote" n="y" target="#Hn_13-1.lnote.oe.y"/> — et qui eam faciet, in iure<ptr type="liebermannNote" n="39" target="#Hn_13-1.lnote.oe.39"/> regio sit, et si<ptr type="liebermannNote" n="40" target="#Hn_13-1.lnote.oe.40"/> boclond<ptr type="liebermannNote" n="41" target="#Hn_13-1.lnote.oe.41"/> habeat, in manum regis ueniat —; furtum<ptr type="liebermannNote" n="x" target="#Hn_13-1.lnote.oe.x"/> probatum et morte dignum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 558 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_13-1.lnote.oe.w" n="w" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ferner stehen</hi> I Cn. 2, 2 <hi rend="italic">f.</hi> EGu. 1</seg><seg type="translation" xml:lang="en" source="#claude">there are further I Cn. 2, 2 f. EGu. 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_13-1.lnote.oe.x" n="x" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 10, 1. 12, 1<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. 10, 1. 12, 1a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_13-1.lnote.oe.y" n="y" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 10, 1</seg><seg type="translation" xml:lang="en" source="#claude">cf. 10, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_13-1.lnote.oe.z" n="z" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 79, 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. 79, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_13-1.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">breuui. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">breuui. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_13-1.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">uel mand. su. <hi rend="italic">aus folgender Zeile möchte hierher stellen, gemäss</hi> 10, 1, <hi rend="italic">Somner</hi> [<hi rend="italic">unnöthig</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">Somner would move uel mand. su. here from the following line, in accordance with 10, 1 [unnecessary]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_13-1.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">fügt zu Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">in added by Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_13-1.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">-sus <hi rend="italic">Lond Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sus Lond Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_13-1.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">r. i. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. i. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_13-1.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. aus</hi> sit <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected from sit Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_13-1.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">558</biblScope></bibl><seg type="original" xml:lang="de">bochland <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">bochland Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_13-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">318</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Misericordia 8; Majestätsbeleidigung 2; Königsdienst 6b; Felonie.—Spät am Rd.: <hi rend="italic">Nota, contemptorem brevis regis puniendum</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Misericordia 8; Majestätsbeleidigung 2; Königsdienst 6b; Felonie.—In the margin, in a late hand: <hi rend="italic">Nota, contemptorem brevis regis puniendum</hi> Rs</seg></note>
      </div>
