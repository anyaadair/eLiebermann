      <div type="clause" n="79.4">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 79.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 79.4" corresp="#wit-lat"><pb n="595" ed="#liebermann"/>Si quis a uicecomite uel<ptr type="liebermannNote" n="l" target="#Hn_79-4.lnote.oe.l"/> [e]t<ptr type="liebermannNote" n="33" target="#Hn_79-4.lnote.oe.33"/> a ministro pacem regis habeat, si infringatur<ptr type="liebermannNote" n="34" target="#Hn_79-4.lnote.oe.34"/> in eo, gri[ð]breche<ptr type="liebermannNote" n="35" target="#Hn_79-4.lnote.oe.35"/> sit et C<ptr type="liebermannNote" n="m" target="#Hn_79-4.lnote.oe.m"/> sol. emendetur, si ad emendandum<ptr type="liebermannNote" n="36" target="#Hn_79-4.lnote.oe.36"/> uenire liceat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 595 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-4.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">oder auch vom königlichen Beamten. <hi rend="italic">Einem vom Feinde Vergewaltigten und Bedrohten</hi> seruiens regis dedit pacem regis 1211; <hi rend="italic">Maitland</hi> Sel. pleas of the crown <hi rend="italic">p.</hi> 8. 58</seg><seg type="translation" xml:lang="en" source="#claude">or also from the royal official. To a man assaulted and threatened by his enemy seruiens regis dedit pacem regis 1211; Maitland Sel. pleas of the crown p. 8. 58</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-4.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 12, 2. 35, 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. 12, 2. 35, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-4.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">ita m. <hi rend="italic">Hss.;</hi> alio <hi rend="italic">empfiehlt Wh, im Text Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">ita m. MSS; alio recommended by Wh, in the text Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-4.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">infran. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">infran. Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-4.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">gridb. <hi rend="italic">Sc;</hi> grindeb. <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">gridb. Sc; grindeb. K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-4.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">595</biblScope></bibl><seg type="original" xml:lang="de">-dend. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dend. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_79-4.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">327</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Sheriff 14 ff.; Königsschutz 5.—<hi rend="italic">uel ita</hi>{33} <hi rend="italic">m</hi>., Wheloc's <hi rend="italic">alio</hi> ist glatter—<hi rend="italic">grindeb</hi>.{35}—79, 5 <hi rend="italic">forsitan</hi>{37}—<hi rend="italic">emendari</hi>{41}—79, 6 <hi rend="italic">grindb</hi>.{43}—<hi rend="italic">sicut</hi>{44} bis {45}<hi rend="italic">id est</hi> übersprungen—<hi rend="italic">sit</hi>{47} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Sheriff 14 ff.; Königsschutz 5.—<hi rend="italic">uel ita</hi>{33} <hi rend="italic">m</hi>., Wheloc’s <hi rend="italic">alio</hi> is smoother—<hi rend="italic">grindeb</hi>.{35}—79, 5 <hi rend="italic">forsitan</hi>{37}—<hi rend="italic">emendari</hi>{41}—79, 6 <hi rend="italic">grindb</hi>.{43}—<hi rend="italic">sicut</hi>{44} to {45}<hi rend="italic">id est</hi> omitted—<hi rend="italic">sit</hi>{47} Rs</seg></note>
      </div>
