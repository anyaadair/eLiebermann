    <body>
      <div type="clause" n="41.1">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 41.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" corresp="#wit-i"><ptr type="liebermannNote" n="a" target="#LeisWl_41-1.lnote.oe.a"/><pb n="516" ed="#liebermann"/>Wart l’um<ptr type="liebermannNote" n="1" target="#LeisWl_41-1.lnote.oe.1"/>, que<ptr type="liebermannNote" n="2" target="#LeisWl_41-1.lnote.oe.2"/> l’um<ptr type="liebermannNote" n="1" target="#LeisWl_41-1.lnote.oe.1"/> l’anme<ptr type="liebermannNote" n="3" target="#LeisWl_41-1.lnote.oe.3"/> ne perde, que<ptr type="liebermannNote" n="2" target="#LeisWl_41-1.lnote.oe.2"/> Deu<ptr type="liebermannNote" n="4" target="#LeisWl_41-1.lnote.oe.4"/> rechatat de sa vie<ptr type="liebermannNote" n="5" target="#LeisWl_41-1.lnote.oe.5"/>.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="516" ed="#liebermann"/>Cauendum enim ualde est, ne anime in dampnacionem uendantur, pro quibus Christus<ptr type="liebermannNote" n="a" target="#LeisWl_41-1.lnote.oe.a-2"/> uitam impendit.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="41.1" corresp="#wit-i"><pb n="270" ed="#robertson"/>Wart l'um que l'um l'anme ne perde que Deu rechatat de sa vie.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="516" ed="#liebermann"/>41, 1.<ptr type="liebermannNote" n="1" target="#LeisWl_41-1.lnote.de.1"/> Hüte man sich (sehr <hi rend="italic">L</hi>), dass man die Seele nicht verderbe, die Gott (Christus<ptr type="liebermannNote" n="2" target="#LeisWl_41-1.lnote.de.2"/> <hi rend="italic">L</hi>) mit seinem Leben erkaufte<ptr type="liebermannNote" n="3" target="#LeisWl_41-1.lnote.de.3"/>.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">41, 1. Let one beware (greatly <hi rend="italic">L</hi>) lest one destroy the soul which God (Christ <hi rend="italic">L</hi>) bought with his life.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-i"><pb n="271" ed="#robertson"/>Care shall be taken not to destroy the soul which God redeemed with his life.</ab>
        <note type="comparison" source="#liebermann" n="516"><ref target="clause:IICn_3">II Cn 3</ref></note>
        <note type="comparisonPrinted" source="#liebermann">II Cn. 3</note>
        <note type="comparisonIncomplete">Some of Liebermann’s notes here are cut off in the gutter of the scan used, and are still to be completed.</note>
        <note type="editorial">Added October 2026 from Robertson pp. 270–271 (text and translation); Liebermann’s text and German translation added from Gesetze I p. 516, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_41-1.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">516</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Orig. hatte, wie L</hi> ualde, <hi rend="italic">wohl ein Wort für Cnuts</hi> georne</seg><seg type="translation" xml:lang="en" source="#claude">the original had, like L, ualde, probably a word for Cnut’s georne</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_41-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">516</biblScope></bibl><seg type="original" xml:lang="de">lun <hi rend="italic">Im</hi></seg><seg type="translation" xml:lang="en" source="#claude">lun Im</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_41-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">516</biblScope></bibl><seg type="original" xml:lang="de">qui <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_41-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">516</biblScope></bibl><seg type="original" xml:lang="de">laume <hi rend="italic">Im;</hi> lamne <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">laume Im; lamne Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_41-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">516</biblScope></bibl><seg type="original" xml:lang="de">Du <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">Du Io</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_41-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">516</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">kein Absatz I</hi></seg><seg type="translation" xml:lang="en" source="#claude">no paragraph break I</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_41-1.lnote.oe.a-2" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">516</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wohl nur zufällig näher als I zu Cnut</hi></seg><seg type="translation" xml:lang="en" source="#claude">probably only by chance closer to Cnut than I is</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_41-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">291</biblScope></bibl><seg type="original" xml:lang="de">Verf. benutzt also nicht etwa Wl art 9f., wo statt dieses Cnutschen Nachsatzes Strafe steht</seg><seg type="translation" xml:lang="en" source="#claude">The author therefore does not use, say, Wl art 9f., where a penalty stands in place of this concluding clause of Cnut’s</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_41-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">291</biblScope></bibl><seg type="original" xml:lang="de">Für Christus (<hi rend="italic">s. d. Gl</hi> 1), besonders beim Sühnetod, steht auch sonst Gott; 1 Cn 18, 3. II 2, 1</seg><seg type="translation" xml:lang="en" source="#claude">God also stands elsewhere for Christ (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 1), especially with reference to his atoning death; 1 Cn 18, 3. II 2, 1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_41-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">291</biblScope></bibl><seg type="original" xml:lang="de">Wiederholt <hi rend="italic">u</hi>. 40{d}</seg><seg type="translation" xml:lang="en" source="#claude">Repeated <hi rend="italic">below</hi> 40{d}</seg></note>
      </div>
    </body>
