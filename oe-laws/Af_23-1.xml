    <body>
      <div type="clause" n="23.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 23.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="23.1" corresp="#wit-e"><pb n="62" ed="#liebermann"/>Gif æt ðissa<ptr type="liebermannNote" n="23" target="#Af_23-1.lnote.oe.23"/> misdæda hwelcere<ptr type="liebermannNote" n="24" target="#Af_23-1.lnote.oe.24"/> se hund losige, ga ðeos bót hwæðre<ptr type="liebermannNote" n="25" target="#Af_23-1.lnote.oe.25"/> forð.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="23.1" corresp="#wit-h"><pb n="62" ed="#liebermann"/>Gif æt ðissa misdæda hwylcre<ptr type="liebermannNote" n="9" target="#Af_23-1.lnote.oe.9"/> se hund losige, ga ðeos bot hweþre<ptr type="liebermannNote" n="10" target="#Af_23-1.lnote.oe.10"/> forþ.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="23.1" corresp="#wit-b-no-prol"><pb n="62" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="5" target="#Af_23-1.lnote.oe.5"/> æt ðisra misdæda hwylcere se hund losige, ga ðeos bót ðeah hwæðere forð.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="23.1" corresp="#wit-q"><pb n="63" ed="#liebermann"/>Si in his forisfactis aliquibus<ptr type="liebermannNote" n="14" target="#Af_23-1.lnote.oe.14"/> canis perdatur, procedat tamen<ptr type="liebermannNote" n="15" target="#Af_23-1.lnote.oe.15"/> hęc emendatio.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="74" ed="#attenborough"/>Gif æt ðissa<ptr type="editorNote" n="14" target="#Af_23-1.attnote.fn.14"/> misdæda hwelcere se hund losige, ga ðeos bót hwæðre<ptr type="editorNote" n="15" target="#Af_23-1.attnote.fn.15"/> forð.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="27.1" corresp="#wit-e"><pb n="318" ed="#jurasinski-and-oliver"/>Gif æt ðissa misdæda hwelcere se hund losige, ga ðeos bót hwæðre forð.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="63" ed="#liebermann"/>Wenn[gleich<ptr type="liebermannNote" n="1" target="#Af_23-1.lnote.de.1"/>] bei einer dieser Missethaten der Hund verloren geht, so trete diese Busse dennoch<ptr type="liebermannNote" n="2" target="#Af_23-1.lnote.de.2"/> ein.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Even if the dog is lost in any of these misdeeds, let this compensation nevertheless apply.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="75" ed="#attenborough"/>If the dog disappears after committing any of these offences, this compensation must nevertheless be paid.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="413" ed="#whitelock"/>If in any of these misdeeds the dog is destroyed,<ptr type="editorNote" n="5" target="#Af_23-1.whinote.n.5"/> nevertheless this compensation is still to be paid.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="319" ed="#jurasinski-and-oliver"/>If at any of these misdeeds the dog escapes, the compensation is nevertheless applicable.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_23-1.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">62</biblScope></bibl><seg type="original" xml:lang="de">ðisra <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðisra So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_23-1.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">62</biblScope></bibl><seg type="original" xml:lang="de">-cre <hi rend="italic">So;</hi> hwyl. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cre So; hwyl. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_23-1.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">62</biblScope></bibl><seg type="original" xml:lang="de">-ðere <hi rend="italic">So;</hi> ðeah hwaþere <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ðere So; ðeah hwaþere Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_23-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">62</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> -cere</seg><seg type="translation" xml:lang="en" source="#claude">altered to -cere</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_23-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">62</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> -þere</seg><seg type="translation" xml:lang="en" source="#claude">altered to -þere</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_23-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">63</biblScope></bibl><seg type="original" xml:lang="de">aliquis <hi rend="italic">Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">aliquis Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_23-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">63</biblScope></bibl><seg type="original" xml:lang="de">inde <hi rend="italic">Hk Brti</hi></seg><seg type="translation" xml:lang="en" source="#claude">inde Hk Brti</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_23-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">62</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> he, <hi rend="italic">aber ausradiert</hi></seg><seg type="translation" xml:lang="en" source="#claude">followed by he, but erased</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_23-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">56</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Auch wenn der Hund fortgejagt, ausgeliefert oder vom Gebissenen getötet wird, muss die Busse dennoch gezahlt werden. Der Tierhalter hätte sonst jene Alternative stets gewählt, da ein Hund keine 6 Schill. galt</seg><seg type="translation" xml:lang="en" source="#claude">Even if the dog is driven away, handed over or killed by the man it has bitten, the compensation must still be paid. Otherwise the owner of the animal would always have chosen that alternative, since a dog was not worth 6 shill.</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_23-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">56</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">B modernisiert</seg><seg type="translation" xml:lang="en" source="#claude">B modernises</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_23-1.attnote.fn.14" n="14" source="#attenborough"><bibl><biblScope unit="page">74</biblScope></bibl><label>ðissa</label><seg type="original" xml:lang="en"><hi rend="italic">ðisra</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_23-1.attnote.fn.15" n="15" source="#attenborough"><bibl><biblScope unit="page">74</biblScope></bibl><label>hwæðre</label><seg type="original" xml:lang="en"><hi rend="italic">ðeah. h</hi>. B &amp; Ld.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="Af_23-1.whinote.n.5" n="5" source="#whitelock"><bibl><biblScope unit="page">413</biblScope></bibl><label>destroyed</label><seg type="original" xml:lang="en">perhaps merely “escapes”</seg></note>
      </div>
    </body>
