      <div type="clause" n="90.2a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 90.2a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 90.2a" corresp="#wit-lat"><pb n="605" ed="#liebermann"/>Inde pensandum de eo<ptr type="liebermannNote" n="g" target="#Hn_90-2a.lnote.oe.g"/> cui hoc licuit: an qui lesus est herbagium<ptr type="liebermannNote" n="h" target="#Hn_90-2a.lnote.oe.h"/> uel lignagium<ptr type="liebermannNote" n="33" target="#Hn_90-2a.lnote.oe.33"/> uel causam aliquam in nemus habeat, unde iure debeat premoneri<ptr type="liebermannNote" n="34" target="#Hn_90-2a.lnote.oe.34"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 605 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-2a.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">während</hi> 90, 2 <hi rend="italic">Ersatz für jeden Schaden durch Selbstschüsse fordert, büsst für den mit triftigem Grunde Genahten der Fallensteller mehr, vermuthlich Strafgeld; anders Frank</hi> Casuelle Tödtung 46. <hi rend="italic">Vgl. Dig.</hi> IX 2, 28 <hi rend="italic">f.</hi></seg><seg type="translation" xml:lang="en" source="#claude">whereas 90, 2 demands compensation for every injury caused by self-triggering weapons, the trap-setter pays more for a person who approached with good reason, presumably a fine; Frank, Casuelle Tödtung 46, takes a different view. Cf. Dig. IX 2, 28 f.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-2a.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">Weiderecht; <hi rend="italic">Beispiele aus England bei Ducange; vgl.</hi> Summa de leg. Norm. 7, 10</seg><seg type="translation" xml:lang="en" source="#claude">right of pasture; examples from England in Ducange; cf. Summa de leg. Norm. 7, 10</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-2a.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">lin. <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lin. Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-2a.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">605</biblScope></bibl><seg type="original" xml:lang="de">premio iniri (-re <hi rend="italic">Co Or</hi>) <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">premio iniri (-re Co Or) Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-2a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Holz 4; Servitut 2—90, 3 <hi rend="italic">-cludat</hi>{36}—ohne <hi rend="italic">uero</hi>{37} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Holz 4; Servitut 2—90, 3 <hi rend="italic">-cludat</hi>{36}—without <hi rend="italic">uero</hi>{37} Rs</seg></note>
