        <note type="liebermannNote" subtype="textual" xml:id="IICn_16.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">320</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_16.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">321</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Dm; fehlt übrigen</hi></seg><seg type="translation" xml:lang="en" source="#claude">from Dm; lacking in the others</seg></note>
