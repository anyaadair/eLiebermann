      <div type="clause" n="35.1b">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 35.1b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 35.1b"><pb n="665" ed="#liebermann"/>Propter quem<ptr type="liebermannNote" n="b" target="#ECf_35-1b.lnote.la.fn.b"/> misit rex<ptr type="liebermannNote" n="5" target="#ECf_35-1b.lnote.la.5"/> Eadwardus, auunculus<ptr type="liebermannNote" n="c" target="#ECf_35-1b.lnote.la.fn.c"/> eius, et fecit eum<ptr type="liebermannNote" n="6" target="#ECf_35-1b.lnote.la.6"/> ad se uenire. Ipse<ptr type="liebermannNote" n="b" target="#ECf_35-1b.lnote.la.fn.b"/> autem et uxor eius non longo<ptr type="liebermannNote" n="7" target="#ECf_35-1b.lnote.la.7"/> tempore uixerunt post aduentum eorum. Eadgarum<ptr type="liebermannNote" n="d" target="#ECf_35-1b.lnote.la.fn.d"/> uero<ptr type="liebermannNote" n="8" target="#ECf_35-1b.lnote.la.8"/>, filium eius<ptr type="liebermannNote" n="9" target="#ECf_35-1b.lnote.la.9"/>, rex<ptr type="liebermannNote" n="10" target="#ECf_35-1b.lnote.la.10"/> Eadwardus secum retinuit et nutriuit pro filio.</ab>
        <note type="comparison" source="#liebermann" n="665"><label>printed alongside</label> <ref target="clause:ECfRetr_35-1b">ECf retr 35.1b</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 665 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Beside this clause, in the outer margin of the ECf retr column, Liebermann gives the date †1057 (the Ætheling’s death).</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1b.lnote.la.fn.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">Eadward Ætheling</seg><seg type="translation" xml:lang="en" source="#claude">Edward Ætheling</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1b.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vatersbruder</hi></seg><seg type="translation" xml:lang="en" source="#claude">father’s brother</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1b.lnote.la.fn.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">lebte noch nach</hi> 1126; <hi rend="italic">Stubbs</hi> Will. Malm. II <hi rend="italic">p.</hi> cxiv</seg><seg type="translation" xml:lang="en" source="#claude">still alive after 1126; Stubbs, Will. Malm. II p. cxiv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1b.lnote.la.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1b.lnote.la.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">ad se eum <hi rend="italic">Hk;</hi> se ad eum <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad se eum Hk; se ad eum Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1b.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">multo <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">multo S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1b.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hk S;</hi> autem <hi rend="italic">Cl</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hk S; autem Cl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1b.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">eorum <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">eorum S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_35-1b.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">665</biblScope></bibl><seg type="original" xml:lang="de">r. E. <hi rend="italic">fehlt Hk S</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. E. lacking in Hk S</seg></note>
      </div>
