    <body>
      <div type="clause" n="3.1">
        <head><ref type="lawCode" target="law:Hu">Hu</ref> 3.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.1" corresp="#wit-b"><pb n="192" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="12" target="#Hu_3-1.lnote.oe.12"/> hit ðriddan siðe dó, sylle healf pund; æt ðam feorðan cyrre ðolie ealles ðæs ðe he age ⁊ beo útlah<ptr type="liebermannNote" n="13" target="#Hu_3-1.lnote.oe.13"/>, buton him se cyng eard alyfe.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3.1" corresp="#wit-q"><pb n="192" ed="#liebermann"/>Si tercio quis<ptr type="liebermannNote" n="11" target="#Hu_3-1.lnote.oe.11"/> faciat, det decem solidos; ad quartam uicem perdat omne quod habet et sit utlaga<ptr type="liebermannNote" n="19" target="#Hu_3-1.lnote.oe.19"/> (id est exul uel exlex), nisi rex ei<ptr type="liebermannNote" n="20" target="#Hu_3-1.lnote.oe.20"/> patriam concedat.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3.1" corresp="#wit-cons-cn"><pb n="193" ed="#liebermann"/>Quodsi tercio obtigerit, det dimidiam libram; si autem quarto, amittat omnia que possidet; ipse autem sit exlex, nisi<ptr type="liebermannNote" n="9" target="#Hu_3-1.lnote.oe.9"/> rex patriam ei indulgeat.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="3.1" corresp="#wit-b"><pb n="16" ed="#robertson"/>Gyf hit ðriddan siðe dó, sylle healf pund; æt ðam feorðan cyrre ðolie ealles ðæs ðe he age ⁊ beo útlah<ptr type="editorNote" n="4" target="#Hu_3-1.robnote.fn.4"/>, buton him se cyng eard alyfe.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="193" ed="#liebermann"/>Wenn er es zum dritten Male thut, zahle er ein halbes Pfund<ptr type="liebermannNote" n="1" target="#Hu_3-1.lnote.de.1"/>; beim vierten Male verliere er alles, was er hat, und werde geächtet, es sei denn, der König erlaubt ihm das Vaterland.<ptr type="liebermannNote" n="2" target="#Hu_3-1.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he does it a third time, let him pay half a pound; the fourth time let him lose everything he has and be outlawed, unless the king permits him [to remain in] the homeland.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="17" ed="#robertson"/>If he does it a third time, he shall pay half a pound<ptr type="editorNote" n="1" target="#Hu_3-1.robnote.n.1"/>. On the fourth occasion he shall suffer the loss of all that he possesses and be outlawed, unless the king allow him to remain in the country.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-b"><pb n="433" ed="#whitelock"/>If he does it a third time, he is to pay half a pound; at the fourth time he is to forfeit all that he owns and be an outlaw, unless the king allows him [to remain in] the land.</ab>
        <note type="editorial">The Latin's ‘decem solidos’ = half a pound. Editors supply ‘he’ in B before ‘hit’.</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_3-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">192</biblScope></bibl><seg type="original" xml:lang="de">he <hi rend="italic">ergänzen Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">he supplied by edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_3-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">192</biblScope></bibl><seg type="original" xml:lang="de">útlaht, <hi rend="italic">aber</hi> t <hi rend="italic">ausgestrichen</hi></seg><seg type="translation" xml:lang="en" source="#claude">útlaht, but t struck out</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_3-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">193</biblScope></bibl><seg type="original" xml:lang="de">n. rex <hi rend="italic">am Rande Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">n. rex in the margin Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_3-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">192</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_3-1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">192</biblScope></bibl><seg type="original" xml:lang="de">-ge <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ge Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hu_3-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">192</biblScope></bibl><seg type="original" xml:lang="de">p. ei <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. ei Lond</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Hu_3-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">132</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Q meint, wie <hi rend="italic">u</hi>. 9³, Normannische Schillinge von ¹/₂₀ £</seg><seg type="translation" xml:lang="en" source="#claude">Q means, as <hi rend="italic">below</hi> 9³, Norman shillings of ¹/₂₀ £</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Hu_3-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">132</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> friedlos 4. 9. 10b. 17</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> friedlos 4. 9. 10b. 17</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Hu_3-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">301</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="smallcaps">x</hi> <hi rend="italic">sol.</hi> Q, <hi rend="italic">i.e.</hi> Norman shillings.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Hu_3-1.robnote.fn.4" n="4" source="#robertson"><bibl><biblScope unit="page">16</biblScope></bibl><label>útlah</label><seg type="original" xml:lang="en"><hi rend="italic">utlaht</hi>—<hi rend="italic">t</hi> struck out later.</seg></note>
      </div>
    </body>
