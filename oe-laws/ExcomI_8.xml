        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom I 8" corresp="#wit-ti"><pb n="432" ed="#liebermann"/>Et apostolus: ‘Auferte, inquit, malum de<ptr type="liebermannNote" n="39" target="#ExcomI_8.lnote.oe.39"/> medio<ptr type="liebermannNote" n="40" target="#ExcomI_8.lnote.oe.40"/> uestri’.</ab>
