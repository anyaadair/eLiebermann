      <div type="clause" n="3.5">
        <head><ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 3.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei IV 3.5" corresp="#wit-du"><pb n="410" ed="#liebermann"/>ut, si hic homo pro hac reputationis causa modo ad presens manum suam in hac<ptr type="liebermannNote" n="21" target="#IudDeiIV_3-5.lnote.oe.21"/> aqua igne feruente miserit et culpabilis ex hac causa non est, hoc ei prestare digneris, ut nulla lesio uel malicia in eandem manum appareat, per quam sine culpa calumniam incurrat.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Iud Dei IV 3.5" corresp="#wit-gl"><pb n="410" ed="#liebermann"/>þ<hi rend="italic">æt</hi>te, gif ðes <hi rend="italic">monn<ptr type="liebermannNote" n="19" target="#IudDeiIV_3-5.lnote.oe.19"/></hi> f<hi rend="italic">or</hi>e ðassum totales<ptr type="liebermannNote" n="20" target="#IudDeiIV_3-5.lnote.oe.20"/> <hi rend="italic">uel<ptr type="liebermannNote" n="11" target="#IudDeiIV_3-5.lnote.oe.11"/></hi> intinge nv to ondveard hond his in ðis<hi rend="italic">sum</hi> vætre fyr vallende gisende ⁊ synnig of ðissv<hi rend="italic">m</hi> intinga ne is, ðis him giwunna<ptr type="liebermannNote" n="22" target="#IudDeiIV_3-5.lnote.oe.22"/> ðv gimeodo<hi rend="italic">mia<ptr type="liebermannNote" n="23" target="#IudDeiIV_3-5.lnote.oe.23"/></hi>, þ<hi rend="italic">æt</hi>te nængo woerding <hi rend="italic">oððe</hi> yfelgiornisse in ða ilca<ptr type="liebermannNote" n="24" target="#IudDeiIV_3-5.lnote.oe.24"/> hond ædeava, ðerh þ<hi rend="italic">æt</hi> bvtan synn sceoma <hi rend="italic">uel<ptr type="liebermannNote" n="11" target="#IudDeiIV_3-5.lnote.oe.11"/></hi> oniorne.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 410 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-5.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbesserndes Synonym fehlt</hi></seg><seg type="translation" xml:lang="en" source="#claude">correcting synonym missing</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-5.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Rune wie</hi> 2, 1</seg><seg type="translation" xml:lang="en" source="#claude">rune as 2, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-5.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Haken über</hi> e</seg><seg type="translation" xml:lang="en" source="#claude">hook above e</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-5.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">hanc aquam i. ferventem <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">hanc aquam i. ferventem Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-5.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">u <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">u written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-5.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de">gimeodo<hi rend="italic">m</hi> <hi rend="italic">Skeat;</hi> gimeodumes <hi rend="italic">für</hi> digneris <hi rend="italic">Lind. S.</hi> 80</seg><seg type="translation" xml:lang="en" source="#claude">gimeodo<hi rend="italic">m</hi> Skeat; gimeodumes for digneris Lind. p. 80</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIV_3-5.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">410</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Lind. S.</hi> 125</seg><seg type="translation" xml:lang="en" source="#claude">cf. Lind. p. 125</seg></note>
      </div>
