      <div type="clause" n="II Cn Prol">
        <head>Quadr Rb II Cn Prol</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Rb II Cn Prol" corresp="#wit-lat"><pb n="536" ed="#liebermann"/>Edictum regis in opprimendis<ptr type="liebermannNote" n="49" target="#Quadr-Rb_II-Cn-Prol.lnote.la.49"/> uitiis<ptr type="liebermannNote" n="c" target="#Quadr-Rb_II-Cn-Prol.lnote.la.fn.c"/> et augendis uirtutibus.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 536 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">The king's edict on suppressing vices and increasing virtues.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-Prol.lnote.la.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">u. o. uirtutibusque aug. <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. o. uirtutibusque aug. Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-Prol.lnote.la.fn.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">gleich S.</hi> 538<hi rend="superscript">65</hi></seg><seg type="translation" xml:lang="en" source="#claude">same as p. 538 note 65</seg></note>
      </div>
