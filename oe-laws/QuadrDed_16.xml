      <div type="clause" n="16">
        <head><ref type="lawCode" target="law:QuadrDed">Quadr Ded</ref> 16</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Ded 16" corresp="#wit-lat"><pb n="530" ed="#liebermann"/>Perfidi, periuri, malitiosi, maliuoli, totis nocendi desideriis estuantes, qui semper alienis casibus gaudent et maxime notas<ptr type="liebermannNote" n="f" target="#QuadrDed_16.lnote.oe.f"/> occultis odiis persecuntur, qui sane propriam habent malitiæ prerogatiuam<ptr type="liebermannNote" n="ff" target="#QuadrDed_16.lnote.oe.ff"/>, bonis numquam morigeri, et quorum facinus per dies singulos ad deteriora festinat, obscura taciturnitate suspecti, sacrilegi, rapaces, adulteri m[a]ritorum<ptr type="liebermannNote" n="1" target="#QuadrDed_16.lnote.oe.1"/> sepius infamatione pulsati, qui dulcibus ueneriis<ptr type="liebermannNote" n="2" target="#QuadrDed_16.lnote.oe.2"/> et uoluptatum miseris torquentur illecebris, qui nefand[ar]um<ptr type="liebermannNote" n="3" target="#QuadrDed_16.lnote.oe.3"/> libidinum cupiditatibus inflammantur et qui turpi puerorum coitu<ptr type="liebermannNote" n="g" target="#QuadrDed_16.lnote.oe.g"/> pallent, qui meretriciis actibus ad omnium feditates exponuntur et alieni iuris illicitos inuadunt amplexus, qui se lepidis affectationibus uniuersant, qui dissolutos modulationibus inhiant, qui, uera morum generositate carentes et honesta prosapia, longo nummorum stemmate gloriantur, Epycur[e]i<ptr type="liebermannNote" n="4" target="#QuadrDed_16.lnote.oe.4"/>, qui multorum facultates una lance consumunt<ptr type="liebermannNote" n="5" target="#QuadrDed_16.lnote.oe.5"/>, effeminati<ptr type="liebermannNote" n="g" target="#QuadrDed_16.lnote.oe.g"/>, quibus semper mulieres ingratæ sunt, qui cucullorum deformitate grandescunt, qui uetitum pecuniæ fenus excercent, qui uenundati<ptr type="liebermannNote" n="6" target="#QuadrDed_16.lnote.oe.6"/> sunt ut maleficiant<ptr type="liebermannNote" n="gg" target="#QuadrDed_16.lnote.oe.gg"/> et qui dampna pupplica malis amplioribus aggrauant, qui terciane remedia querunt, qui scurrarum gremiis a cunabulis adoleuer[u]nt<ptr type="liebermannNote" n="7" target="#QuadrDed_16.lnote.oe.7"/> et multarum libidinum sordibus inplicantur<ptr type="liebermannNote" n="h" target="#QuadrDed_16.lnote.oe.h"/> — et infiniti ualitudinum concursus huiusmodi uirtutum omnium ueneranda præsidia uariis infortuniorum concitationibus oppresserunt —, transierunt<ptr type="liebermannNote" n="i" target="#QuadrDed_16.lnote.oe.i"/> in affectum cordis.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 530 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">530</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> notabiles <hi rend="italic">oder ergänze</hi> (<hi rend="italic">nach Cicero</hi> Rabir. 36) uirtutis</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">read</hi> notabiles <hi rend="italic">or supply</hi> (<hi rend="italic">after Cicero</hi> Rabir. 36) uirtutis</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.ff" n="ff" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">530</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Arg.</hi> 26; <hi rend="italic">Hn</hi> 61, 18; <hi rend="italic">wohl aus Firm. Mat.</hi> Math. III 4, 6</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf. Arg.</hi> 26; <hi rend="italic">Hn</hi> 61, 18; <hi rend="italic">probably from Firm. Mat.</hi> Math. III 4, 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">530</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 11</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">see above</hi> 11</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.gg" n="gg" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">530</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">I Mac.</hi> 1, 16</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">I Mac.</hi> 1, 16</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">530</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">erst hier endet das Subject</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">the subject ends only here</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">530</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Psalm</hi> 72, 7</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Psalm</hi> 72, 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">530</biblScope></bibl><seg type="original" xml:lang="de">meritorum <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">meritorum <hi rend="italic">Dm</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">530</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">d. i.</hi> uenereis</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">i.e.</hi> uenereis</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">530</biblScope></bibl><seg type="original" xml:lang="de">nefandum <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">nefandum <hi rend="italic">Dm</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">530</biblScope></bibl><seg type="original" xml:lang="de">Epycuri <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">Epycuri <hi rend="italic">Dm</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">530</biblScope></bibl><seg type="original" xml:lang="de">consummunt <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">consummunt <hi rend="italic">Dm</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">530</biblScope></bibl><seg type="original" xml:lang="de">-danti <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">-danti <hi rend="italic">Dm</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">530</biblScope></bibl><seg type="original" xml:lang="de">-rint <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rint <hi rend="italic">Dm</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de">Vier Zeilen weiter verabscheut Verf. neben Päderasten (<hi rend="italic">o</hi>. 11) auch Weiberverächter und mönchische Heuchler: wahrscheinlich um jenes Laster denen, die strenge Enthaltsamkeit vom Weibe für alle Geistlichen fordern, anzuhängen</seg><seg type="translation" xml:lang="en" source="#claude">Four lines further on the author, besides pederasts (<hi rend="italic">above</hi> 11), also execrates despisers of women and monkish hypocrites: probably in order to pin that vice on those who demand strict abstinence from women for all clergy</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de">Im Widerspruch hierzu steht der Tadel gegen die Yorker Domherren, die Gerhard angeblich wegen seiner Zölibatsforderung anfeindeten; <hi rend="italic">s. u</hi>. II 17, 3{k–m} (S. 546)</seg><seg type="translation" xml:lang="en" source="#claude">This is contradicted by the censure of the canons of York, who allegedly were hostile to Gerard because of his demand for celibacy; <hi rend="italic">see below</hi> II 17, 3{k–m} (p. 546)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de">Ein Ausfall gegen die Mönche</seg><seg type="translation" xml:lang="en" source="#claude">An attack on the monks</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Wucher 2—3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Wucher 2—3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_16.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Arzt 1.—Die Wendung sechs Wörter weiter <hi rend="italic">a cunabulis adolescere</hi> auch <hi rend="italic">u</hi>. II 17, 4 (S. 546 Z. 12)</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Arzt 1.—The phrase six words further on, <hi rend="italic">a cunabulis adolescere</hi>, also <hi rend="italic">below</hi> II 17, 4 (p. 546 l. 12)</seg></note>
      </div>
