      <div type="clause" n="21.3">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 21.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 21.3" corresp="#wit-lat"><pb n="404" ed="#liebermann"/>Adiuro te per nomen<ptr type="liebermannNote" n="49" target="#IudDeiI_21-3.lnote.oe.49"/> sanctum<ptr type="liebermannNote" n="66" target="#IudDeiI_21-3.lnote.oe.66"/> et<ptr type="liebermannNote" n="67" target="#IudDeiI_21-3.lnote.oe.67"/> indiuiduae Diuinitatis<ptr type="liebermannNote" n="68" target="#IudDeiI_21-3.lnote.oe.68"/>, cuius uoluntate aquarum<ptr type="liebermannNote" n="69" target="#IudDeiI_21-3.lnote.oe.69"/> elementum diuisum est, et populus Israel<ptr type="liebermannNote" n="70" target="#IudDeiI_21-3.lnote.oe.70"/> siccis pedibus statim transiuit, ad cuius etiam inuocationem Heliseus<ptr type="liebermannNote" n="71" target="#IudDeiI_21-3.lnote.oe.71"/> ferrum, quod de manubrio exierat, super aquam natare fecerat<ptr type="liebermannNote" n="72" target="#IudDeiI_21-3.lnote.oe.72"/>,</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Exod. 14, 16; IV Reg. 6, 6</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 404 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-3.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">+ <hi rend="italic">über der Zeile H</hi></seg><seg type="translation" xml:lang="en" source="#claude">+ above the line H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-3.lnote.oe.66" n="66" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">sanctae <hi rend="italic">Ci Tr Vt2 Zeu.;</hi> Trinitatis <hi rend="italic">fügt zu Rj</hi></seg><seg type="translation" xml:lang="en" source="#claude">sanctae Ci Tr Vt2 Zeu.; Trinitatis added by Rj</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-3.lnote.oe.67" n="67" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ch Vt Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ch Vt Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-3.lnote.oe.68" n="68" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">Trinitatis <hi rend="italic">Ch Ci Co</hi> XIII <hi rend="italic">Zeu.</hi> 664</seg><seg type="translation" xml:lang="en" source="#claude">Trinitatis Ch Ci Co XIII Zeu. 664</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-3.lnote.oe.69" n="69" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">natura <hi rend="italic">fügt zu, aber unterpunctirt, Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">natura added, but underdotted, by Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-3.lnote.oe.70" n="70" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">per illud <hi rend="italic">fügt zu Tr Vt2 Zeu.</hi> 664; Israheliticus per illud s. uestigiis tr. <hi rend="italic">Zeu.</hi> 694; <hi rend="italic">doch stimmt jede unserer Varianten zu einer oder der anderen festländischen Hs.;</hi> uestigiis <hi rend="italic">ohne</hi> st. <hi rend="italic">auch</hi> XIII</seg><seg type="translation" xml:lang="en" source="#claude">per illud added by Tr Vt2 Zeu. 664; Israheliticus per illud s. uestigiis tr. Zeu. 694; yet each of our variants agrees with one or other of the Continental MSS; uestigiis without st. also XIII</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-3.lnote.oe.71" n="71" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">Helias XIII <hi rend="italic">Zeu.</hi> 665</seg><seg type="translation" xml:lang="en" source="#claude">Helias XIII Zeu. 665</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_21-3.lnote.oe.72" n="72" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">404</biblScope></bibl><seg type="original" xml:lang="de">fecit <hi rend="italic">Vt2 Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">fecit Vt2 Mg</seg></note>
      </div>
