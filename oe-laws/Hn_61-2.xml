        <head><ref type="lawCode" target="law:Hn">Hn</ref> 61.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 61.2" corresp="#wit-lat"><pb n="581" ed="#liebermann"/>Si dominus ministro<ptr type="liebermannNote" n="14" target="#Hn_61-2.lnote.oe.14"/> suo precipiat, ut causam suam agat, et idem minister ad diem non ueniat<ptr type="liebermannNote" n="15" target="#Hn_61-2.lnote.oe.15"/>, nec eum ydoneum quid<ptr type="liebermannNote" n="16" target="#Hn_61-2.lnote.oe.16"/> detineat, quietum<ptr type="liebermannNote" n="e" target="#Hn_61-2.lnote.oe.e"/> iure dicimus super quem causa erat; et minister domino suo<ptr type="liebermannNote" n="17" target="#Hn_61-2.lnote.oe.17"/> suppleat<ptr type="liebermannNote" n="18" target="#Hn_61-2.lnote.oe.18"/>, si<ptr type="liebermannNote" n="19" target="#Hn_61-2.lnote.oe.19"/> per eum quid amittat<ptr type="liebermannNote" n="f" target="#Hn_61-2.lnote.oe.f"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 581 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-2.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">581</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verklagten; vgl.</hi> 60, 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">the defendant; cf.</hi> 60, 3</seg></note>
