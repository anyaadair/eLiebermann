        <head><ref type="lawCode" target="law:Hn">Hn</ref> 66.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 66.5" corresp="#wit-lat"><pb n="585" ed="#liebermann"/>Si<ptr type="liebermannNote" n="q" target="#Hn_66-5.lnote.oe.q"/> quis Dei rectitudines per uim deforciet<ptr type="liebermannNote" n="48" target="#Hn_66-5.lnote.oe.48"/>, emendet lahslit<ptr type="liebermannNote" n="49" target="#Hn_66-5.lnote.oe.49"/> cum Dacis, plenam witam<ptr type="liebermannNote" n="3" target="#Hn_66-5.lnote.oe.3"/> cum Anglis<ptr type="liebermannNote" n="50" target="#Hn_66-5.lnote.oe.50"/>; uel ita neget: assumat XI et idem sit XIIᵘˢ.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 585 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-5.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 13, 11</seg><seg type="translation" xml:lang="en" source="#claude">cf. 13, 11</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-5.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de">wyt. <hi rend="italic">Lond meist</hi></seg><seg type="translation" xml:lang="en" source="#claude">wyt. Lond mostly</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-5.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de">-ciat <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ciat Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_66-5.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">585</biblScope></bibl><seg type="original" xml:lang="de">per laslith <hi rend="italic">Co Or;</hi> -iht <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">per laslith Co Or; -iht K</seg></note>
