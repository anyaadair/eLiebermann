        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 34.6" corresp="#wit-lat"><pb n="566" ed="#liebermann"/>Et nemo apud regem proclamacionem faciat de aliquo qui ei secundum legem rectum<ptr type="liebermannNote" n="5" target="#Hn_34-6.lnote.oe.5"/> offerat in hundreto<ptr type="liebermannNote" n="6" target="#Hn_34-6.lnote.oe.6"/> suo.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 566 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-6.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">überschr. Corr. Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">written above by the corrector Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_34-6.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">566</biblScope></bibl><seg type="original" xml:lang="de">hon. <hi rend="italic">Sc;</hi> -edo <hi rend="italic">Co Or meist</hi></seg><seg type="translation" xml:lang="en" source="#claude">hon. <hi rend="italic">Sc;</hi> -edo <hi rend="italic">Co Or mostly</hi></seg></note>
