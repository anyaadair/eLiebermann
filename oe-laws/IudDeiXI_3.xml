        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XI 3" corresp="#wit-lat"><ptr type="liebermannNote" n="10" target="#IudDeiXI_3.lnote.oe.10"/><pb n="419" ed="#liebermann"/>Oratio ante<ptr type="liebermannNote" n="11" target="#IudDeiXI_3.lnote.oe.11"/> iudicium<ptr type="liebermannNote" n="12" target="#IudDeiXI_3.lnote.oe.12"/> dicenda. Deus<ptr type="liebermannNote" n="13" target="#IudDeiXI_3.lnote.oe.13"/>, plasmator hominum et totius bonitatis auctor, respice super nos, famulos tuos ad té toto corde clamantes,</ab>
