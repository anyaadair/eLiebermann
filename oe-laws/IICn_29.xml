        <note type="liebermannNote" subtype="textual" xml:id="IICn_29.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">330</biblScope></bibl><seg type="original" xml:lang="de">buton <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">buton Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_29.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">330</biblScope></bibl><seg type="original" xml:lang="de">-lum <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-lum Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_29.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">330</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">dazu am Rande:</hi> ‘al. <hi rend="spaced">lade</hi>’ <hi rend="italic">Ld</hi> [<hi rend="italic">vgl. Quadr.</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">beside it in the margin: ‘al. <hi rend="italic">lade</hi>’ Ld [cf. Quadr.]</seg></note>
