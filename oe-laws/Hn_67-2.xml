      <div type="clause" n="67.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 67.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 67.2" corresp="#wit-lat"><pb n="586" ed="#liebermann"/>In causis que cotidie non cessant, par contra parem solus iuret, inferior contra superiorem se altero uel tercio, contra<ptr type="liebermannNote" n="26" target="#Hn_67-2.lnote.oe.26"/> dominum se tertio<ptr type="liebermannNote" n="r" target="#Hn_67-2.lnote.oe.r"/> uel sexto; in weminga<ptr type="liebermannNote" n="s" target="#Hn_67-2.lnote.oe.s"/><ptr type="liebermannNote" n="27" target="#Hn_67-2.lnote.oe.27"/> duo sunt contra unum et eiusdem dignitatis.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 586 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_67-2.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> Summa de leg. Norm. 85, 5: In deraisniis exiguntur adiutores . . versus dominum 6. manu <hi rend="italic">oder</hi> 3. manu; <hi rend="italic">vgl. dort</hi> 122, 7</seg><seg type="translation" xml:lang="en" source="#claude">cf. Summa de leg. Norm. 85, 5: In deraisniis exiguntur adiutores . . versus dominum 6. manu or 3. manu; cf. ibid. 122, 7</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_67-2.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 33, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 33, 2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_67-2.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">c. d. se t. <hi rend="italic">überspringt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. d. se t. omitted by Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_67-2.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">586</biblScope></bibl><seg type="original" xml:lang="de">wenūga <hi rend="italic">Sc</hi>; wemūga <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">wenūga Sc; wemūga Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_67-2.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">325</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Eidesschwere 9; Eineid 3—<hi rend="italic">wenninga</hi>{27} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Eidesschwere 9; Eineid 3—<hi rend="italic">wenninga</hi>{27} Rs</seg></note>
