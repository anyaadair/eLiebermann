  <text>
    <body>
      <div type="clause" n="31a">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 31a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 31a"><pb n="653" ed="#liebermann"/>Et qui super ipsam dominabantur, uocabantur<ptr type="liebermannNote" n="14" target="#ECf_31a.lnote.la.14"/> [þ]rehinggrefes<ptr type="liebermannNote" n="15" target="#ECf_31a.lnote.la.15"/>, ad quos deferebantur cause que<ptr type="liebermannNote" n="16" target="#ECf_31a.lnote.la.16"/> non poterant diffiniri in wapentagiis.</ab>
        <note type="comparison" source="#liebermann" n="653"><label>printed alongside</label> <ref target="clause:ECfRetr_31a">ECf retr 31a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 653 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">Liebermann’s upright (roman) letter a after “[þ]rehinggrefes” refers to his explanatory notes, the Erklärungen (printed as Gesetze III; his note on p. 627 calls it “Band II”), which are not yet added here.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31a.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt S</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31a.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">trehiggreues <hi rend="italic">Rl;</hi> trehiggres <hi rend="italic">S;</hi> threhiggres <hi rend="italic">Hr;</hi> trehinghef <hi rend="italic">Hk</hi> [f <hi rend="italic">wohl ursprünglich, vgl. Retr. Lond</hi>]; tþringe <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">trehiggreues Rl; trehiggres S; threhiggres Hr; trehinghef Hk [f probably original, cf. Retr. Lond]; tþringe Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31a.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">quando <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">quando S</seg></note>
      </div>
    </body>
