        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 33.1a" corresp="#wit-lat"><pb n="564" ed="#liebermann"/>Defectus<ptr type="liebermannNote" n="w" target="#Hn_33-1a.lnote.oe.w"/> quippe iusticie et<ptr type="liebermannNote" n="38" target="#Hn_33-1a.lnote.oe.38"/> uiolenta recti eorum<ptr type="liebermannNote" n="x" target="#Hn_33-1a.lnote.oe.x"/><ptr type="liebermannNote" n="39" target="#Hn_33-1a.lnote.oe.39"/> destitutio<ptr type="liebermannNote" n="40" target="#Hn_33-1a.lnote.oe.40"/> est, que<ptr type="liebermannNote" n="41" target="#Hn_33-1a.lnote.oe.41"/> causas protrahunt<ptr type="liebermannNote" n="42" target="#Hn_33-1a.lnote.oe.42"/> in ius regium uel in<ptr type="liebermannNote" n="43" target="#Hn_33-1a.lnote.oe.43"/> dicionem<ptr type="liebermannNote" n="44" target="#Hn_33-1a.lnote.oe.44"/> dominorum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 564 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-1a.lnote.oe.w" n="w" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 7, 6. 9, 4. 10, 1. 22. 26, 1. 33, 3; <hi rend="italic">wiederholt</hi> 59, 19</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> 7, 6. 9, 4. 10, 1. 22. 26, 1. 33, 3; <hi rend="italic">repeated</hi> 59, 19</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-1a.lnote.oe.x" n="x" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">der Kläger; <hi rend="italic">vgl.</hi> 22</seg><seg type="translation" xml:lang="en" source="#claude">of the plaintiffs; <hi rend="italic">cf.</hi> 22</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-1a.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-1a.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">d. eo. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. eo. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-1a.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">destitō <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">destitō <hi rend="italic">Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-1a.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb.</hi> qui <hi rend="italic">Sc Hg;</hi> qui <hi rend="italic">übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">corrected to</hi> qui <hi rend="italic">Sc Hg;</hi> qui <hi rend="italic">the others</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-1a.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">-hant <hi rend="italic">Sc;</hi> et <hi rend="italic">fügt ein, aber unterpunctirt Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-hant <hi rend="italic">Sc;</hi> et <hi rend="italic">inserted, but expunged, Sc</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-1a.lnote.oe.43" n="43" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">in diciones, <hi rend="italic">verb. vom Corr.</hi> iurisdictiones <hi rend="italic">Sc und so Hg Edd.;</hi> in <hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">in diciones, <hi rend="italic">corrected by the corrector to</hi> iurisdictiones <hi rend="italic">Sc, and so Hg Edd.;</hi> in <hi rend="italic">omitted in K Co Or Gi</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_33-1a.lnote.oe.44" n="44" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">564</biblScope></bibl><seg type="original" xml:lang="de">-ne <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ne <hi rend="italic">Co</hi></seg></note>
