    <body>
      <div type="clause" n="22.2">
        <head><ref type="lawCode" target="law:IIAs">II As</ref> 22.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.2" corresp="#wit-h"><pb n="162" ed="#liebermann"/>⁊ non<ptr type="liebermannNote" n="4" target="#IIAs_22-2.lnote.oe.4"/> mon<ptr type="liebermannNote" n="4" target="#IIAs_22-2.lnote.oe.4"/> ne tæce his getihtledan<ptr type="liebermannNote" n="9" target="#IIAs_22-2.lnote.oe.9"/> mon<ptr type="liebermannNote" n="4" target="#IIAs_22-2.lnote.oe.4"/> from<ptr type="liebermannNote" n="4" target="#IIAs_22-2.lnote.oe.4"/> him, ær he hæbbe ryht geworht.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.2" corresp="#wit-ld"><pb n="162" ed="#liebermann"/>⁊ nan man ne getæce his getyhtledan men<ptr type="liebermannNote" n="1" target="#IIAs_22-2.lnote.oe.1"/> fram him, ær he hæbbe riht geworhte.<ptr type="liebermannNote" n="1" target="#IIAs_22-2.lnote.oe.1"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.2" corresp="#wit-ot"><pb n="162" ed="#liebermann"/>⁊ nan . . . tyhtledan men<ptr type="liebermannNote" n="1" target="#IIAs_22-2.lnote.oe.1-2"/> fram, ær he hæbbe ryht . . .</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="22.2" corresp="#wit-q"><ptr type="liebermannNote" n="16" target="#IIAs_22-2.lnote.oe.16"/><pb n="163" ed="#liebermann"/>Et nemo suum hominem<ptr type="liebermannNote" n="17" target="#IIAs_22-2.lnote.oe.17"/> accusatum a<ptr type="liebermannNote" n="18" target="#IIAs_22-2.lnote.oe.18"/> se dimittat, donec rectum (per<ptr type="liebermannNote" n="19" target="#IIAs_22-2.lnote.oe.19"/> omnia) faciat.<ptr type="liebermannNote" n="20" target="#IIAs_22-2.lnote.oe.20"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="22.2" corresp="#wit-h"><pb n="138" ed="#attenborough"/>⁊ non mon ne tæce<ptr type="editorNote" n="16" target="#IIAs_22-2.attnote.fn.16"/> his getihtledan mon from him, ær he hæbbe ryht geworht<ptr type="editorNote" n="17" target="#IIAs_22-2.attnote.fn.17"/>.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="163" ed="#liebermann"/>Und niemand<ptr type="liebermannNote" n="1" target="#IIAs_22-2.lnote.de.1"/> weise seinen verklagten Untergebenen von sich, bevor dieser Rechtspflicht erfüllt hat.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let no one dismiss his accused dependant from him before that man has fulfilled his legal obligation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="139" ed="#attenborough"/>And no one shall send away one of his men, if he has been accused, before the man has complied with the demands of the law.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="422" ed="#whitelock"/>And no one is to dismiss his man who has been accused, before he has rendered justice.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_28-1">II Cn 28.1</ref>; <ref target="clause:App-AGu_5">App AGu 5</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="358"><ref target="clause:IICn_28">II Cn 28–28.1</ref></note>
        <note type="comparedBy" source="#whitelock" n="465"><ref target="clause:IICn_28">II Cn 28</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22-2.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">162</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">162</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22-2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">162</biblScope></bibl><seg type="original" xml:lang="de">edan <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">edan on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22-2.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">163</biblScope></bibl><seg type="original" xml:lang="de">Ne quis accusatum suum dimittat ante rectum <hi rend="italic">Rubrik MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ne quis accusatum suum dimittat ante rectum rubric MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22-2.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">163</biblScope></bibl><seg type="original" xml:lang="de">ac. ho. <hi rend="italic">RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">ac. ho. RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22-2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">163</biblScope></bibl><seg type="original" xml:lang="de">a se <hi rend="italic">fehlt MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">a se lacking in MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22-2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">163</biblScope></bibl><seg type="original" xml:lang="de">per o. <hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">per o. lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">163</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so K;</hi> fecerit <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus K; fecerit the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_22-2.lnote.oe.1-2" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">162</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_22-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">106</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd.</hi> 19 d. — Den Dativ nach <hi rend="italic">tæcean</hi> hat mit Ot Ld auch II Cn 28</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid.</hi> 19 d. — II Cn 28 too, like Ot Ld, has the dative after <hi rend="italic">tæcean</hi></seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_22-2.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">138</biblScope></bibl><label>tæce</label><seg type="original" xml:lang="en"><hi rend="italic">getæce</hi>. Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_22-2.attnote.fn.17" n="17" source="#attenborough"><bibl><biblScope unit="page">138</biblScope></bibl><label>geworht</label><seg type="original" xml:lang="en"><hi rend="italic">geworhte</hi>. Ld.</seg></note>
      </div>
    </body>
