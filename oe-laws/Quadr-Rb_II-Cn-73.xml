        <head>Quadr Rb II Cn 73</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Rb II Cn 73" corresp="#wit-lat"><pb n="538" ed="#liebermann"/><ptr type="liebermannNote" n="38" target="#Quadr-Rb_II-Cn-73.lnote.la.38"/>De uiduis <ptr type="liebermannNote" n="a" target="#Quadr-Rb_II-Cn-73.lnote.la.fn.a"/>(infra<ptr type="liebermannNote" n="39" target="#Quadr-Rb_II-Cn-73.lnote.la.39"/> annum nubentibus et earum maritis).</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 538 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">Of widows (who marry within the year, and their husbands).</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-73.lnote.la.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de">et ui. <hi rend="italic">LondDmT</hi></seg><seg type="translation" xml:lang="en" source="#claude">et ui. LondDmT</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-73.lnote.la.fn.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. S</hi> 537<hi rend="superscript">c</hi></seg><seg type="translation" xml:lang="en" source="#claude">see p. 537, note c</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-73.lnote.la.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">538</biblScope></bibl><seg type="original" xml:lang="de">infra — termino <hi rend="italic">nur HkBr</hi> (<hi rend="italic">wo</hi> nuptis)</seg><seg type="translation" xml:lang="en" source="#claude">infra — termino only HkBr (where nuptis)</seg></note>
