        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 12.2" corresp="#wit-lat"><pb n="558" ed="#liebermann"/>Hec<ptr type="liebermannNote" n="d" target="#Hn_12-2.lnote.oe.d"/> emendantur C solidis: griþbreche<ptr type="liebermannNote" n="e" target="#Hn_12-2.lnote.oe.e"/><ptr type="liebermannNote" n="11" target="#Hn_12-2.lnote.oe.11"/>, stretbreche<ptr type="liebermannNote" n="f" target="#Hn_12-2.lnote.oe.f"/><ptr type="liebermannNote" n="12" target="#Hn_12-2.lnote.oe.12"/>, forestel<ptr type="liebermannNote" n="g" target="#Hn_12-2.lnote.oe.g"/><ptr type="liebermannNote" n="13" target="#Hn_12-2.lnote.oe.13"/>, burchbreche<ptr type="liebermannNote" n="h" target="#Hn_12-2.lnote.oe.h"/><ptr type="liebermannNote" n="14" target="#Hn_12-2.lnote.oe.14"/>, hamsocna<ptr type="liebermannNote" n="i" target="#Hn_12-2.lnote.oe.i"/><ptr type="liebermannNote" n="15" target="#Hn_12-2.lnote.oe.15"/>, flymonfirma<ptr type="liebermannNote" n="k" target="#Hn_12-2.lnote.oe.k"/><ptr type="liebermannNote" n="16" target="#Hn_12-2.lnote.oe.16"/>.</ab>
