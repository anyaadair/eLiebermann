      <div type="clause" n="56.2">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 56.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 56.2" corresp="#wit-lat"><pb n="575" ed="#liebermann"/>Si quis uero firmam in feodo<ptr type="liebermannNote" n="27" target="#Hn_56-2.lnote.oe.27"/> teneat et homagium inde fecerit, siue in ea manens sit uel<ptr type="liebermannNote" n="28" target="#Hn_56-2.lnote.oe.28"/> non sit, et eam<ptr type="liebermannNote" n="29" target="#Hn_56-2.lnote.oe.29"/> diligit, satisfaciat domino suo in curia sua<ptr type="liebermannNote" n="30" target="#Hn_56-2.lnote.oe.30"/> uel in<ptr type="liebermannNote" n="31" target="#Hn_56-2.lnote.oe.31"/> curia domini, de quo ipsum feodum est.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 575 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-2.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">feudo <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">feudo K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-2.lnote.oe.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">uel — suo <hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel — suo missing K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-2.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">eum <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">eum Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-2.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de">eius <hi rend="italic">K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">eius K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_56-2.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">575</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K Co</seg></note>
