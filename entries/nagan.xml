        <dictScrap type="liebermann"><hi rend="bold">nagan</hi> <hi rend="italic">nicht haben</hi> (<hi rend="italic">bekommen</hi>); 3: nah <ref type="lawCode" target="law:Ine">Ine</ref> 15,2. 27. 40. 50. 62. 72. <ref type="lawCode" target="law:ICn">I Cn</ref> 22,5. <ref type="lawCode" target="law:IICn">II</ref> 24,3. <ref type="lawCode" target="law:Duns">Duns</ref> 6 | <hi rend="italic"><ref type="abbreviation" target="gram:Plural"><abbr>pl</abbr></ref></hi> 3: nagon <ref type="lawCode" target="law:VAtr">V Atr</ref> 9 = <ref type="lawCode" target="law:VIAtr">VI</ref> 5,1 | <hi rend="italic"><ref type="abbreviation" target="gram:Optativ"><abbr>op</abbr></ref></hi> 3: nage <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 12. <ref type="lawCode" target="law:Af">Af</ref> 8,1. 8,2 <ref type="lawCode" target="law:H">H</ref> (næbbe <ref type="lawCode" target="law:E">E</ref> <ref type="lawCode" target="law:B">B</ref>). 27,1 (næbbe <ref type="lawCode" target="law:B">B</ref>). 28. 77. <ref type="lawCode" target="law:Ine">Ine</ref> 6. <ref type="lawCode" target="law:IIIAtr">III Atr</ref> 11. <ref type="lawCode" target="law:Blas">Blas</ref> 3. <ref type="lawCode" target="law:Grith">Grið</ref> 9. — <hi rend="bold">1</hi>) (<hi rend="italic">Beziehungen</hi>) <hi rend="italic">entbehren:</hi> mægas <ref type="lawCode" target="law:Af">Af</ref> 27,1. 28; geweald 77; socne <ref type="lawCode" target="law:IIIAtr">III Atr</ref> 11; gemanan <ref type="lawCode" target="law:VAtr">V Atr</ref> 9 = <ref type="lawCode" target="law:VIAtr">VI</ref> 5,1. <ref type="lawCode" target="law:ICn">I Cn</ref> 22,5 <hi rend="bold">2</hi>) <hi rend="italic">nicht erhalten:</hi> owiht <ref type="lawCode" target="law:Af">Af</ref> 8,1 <ref type="lawCode" target="law:H">H</ref>; nan wiht <ref type="lawCode" target="law:Ine">Ine</ref> 40; wite 2. 72; wer 27 <hi rend="bold">3</hi>) <hi rend="italic">verlieren:</hi> swicne 15,2 | lif age, þe nage <hi rend="italic">Leben behalte <ref type="abbreviation" target="gram:oder"><abbr>od</abbr></ref>. Tod leide</hi> <ref type="lawCode" target="law:Ine">Ine</ref> 6 = <ref type="lawCode" target="law:Blas">Blas</ref> 3 = <ref type="lawCode" target="law:Grith">Grið</ref> 9 <hi rend="bold">4</hi>) <hi rend="italic"><ref type="abbreviation" target="gram:vor"><abbr>vor</abbr></ref></hi> to <hi rend="italic"><ref type="abbreviation" target="gram:mitInfinitiv"><abbr>m inf</abbr></ref></hi> <hi rend="bold">a</hi>) <hi rend="italic">nicht können;</hi> nah nane wiht to gesellanne <ref type="lawCode" target="law:Ine">Ine</ref> 62 <hi rend="bold">b</hi>) <hi rend="italic">nicht dürfen, kein Recht haben zu;</hi> nage to bebycganne <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 12, non habebit potestatem vendendi <hi rend="italic"><ref type="abbreviation" target="gram:ubersetzend"><abbr>übsnd</abbr></ref></hi> | ~ to onfonne <ref type="lawCode" target="law:ICn">I Cn</ref> 22,5; <hi rend="italic"><ref type="abbreviation" target="gram:dafur"><abbr>dafür</abbr></ref></hi> beon wyrðe, <hi rend="italic">blosser unfl. <ref type="abbreviation" target="gram:Infinitiv"><abbr>inf</abbr></ref> <ref type="abbreviation" target="gram:ohne"><abbr>ohne</abbr></ref></hi> to <ref type="lawCode" target="law:B">B</ref> <ref type="lawCode" target="law:MsA">A</ref> | nah to geahnianne II 24,3; to farenne <ref type="lawCode" target="law:Duns">Duns</ref> 6. — <hi rend="italic">Variirt <ref type="abbreviation" target="gram:mit"><abbr>mit</abbr></ref></hi> nabban <hi rend="italic"><ref type="abbreviation" target="gram:sieheOben"><abbr>s. o.</abbr></ref></hi></dictScrap>
        <dictScrap type="senses">
          <sense n="1">(<hi rend="italic">Beziehungen</hi>) <hi rend="italic">entbehren:</hi> mægas <ref type="lawCode" target="law:Af">Af</ref> 27,1. 28; geweald 77; socne <ref type="lawCode" target="law:IIIAtr">III Atr</ref> 11; gemanan <ref type="lawCode" target="law:VAtr">V Atr</ref> 9 = <ref type="lawCode" target="law:VIAtr">VI</ref> 5,1. <ref type="lawCode" target="law:ICn">I Cn</ref> 22,5</sense>
          <sense n="2"><hi rend="italic">nicht erhalten:</hi> owiht <ref type="lawCode" target="law:Af">Af</ref> 8,1 <ref type="lawCode" target="law:H">H</ref>; nan wiht <ref type="lawCode" target="law:Ine">Ine</ref> 40; wite 2. 72; wer 27</sense>
          <sense n="3"><hi rend="italic">verlieren:</hi> swicne 15,2 | lif age, þe nage <hi rend="italic">Leben behalte <ref type="abbreviation" target="gram:oder"><abbr>od</abbr></ref>. Tod leide</hi> <ref type="lawCode" target="law:Ine">Ine</ref> 6 = <ref type="lawCode" target="law:Blas">Blas</ref> 3 = <ref type="lawCode" target="law:Grith">Grið</ref> 9</sense>
          <sense n="4"><hi rend="italic"><ref type="abbreviation" target="gram:vor"><abbr>vor</abbr></ref></hi> to <hi rend="italic"><ref type="abbreviation" target="gram:mitInfinitiv"><abbr>m inf</abbr></ref></hi> <hi rend="bold">a</hi>) <hi rend="italic">nicht können;</hi> nah nane wiht to gesellanne <ref type="lawCode" target="law:Ine">Ine</ref> 62 <hi rend="bold">b</hi>) <hi rend="italic">nicht dürfen, kein Recht haben zu;</hi> nage to bebycganne <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 12, non habebit potestatem vendendi <hi rend="italic"><ref type="abbreviation" target="gram:ubersetzend"><abbr>übsnd</abbr></ref></hi> | ~ to onfonne <ref type="lawCode" target="law:ICn">I Cn</ref> 22,5; <hi rend="italic"><ref type="abbreviation" target="gram:dafur"><abbr>dafür</abbr></ref></hi> beon wyrðe, <hi rend="italic">blosser unfl. <ref type="abbreviation" target="gram:Infinitiv"><abbr>inf</abbr></ref> <ref type="abbreviation" target="gram:ohne"><abbr>ohne</abbr></ref></hi> to <ref type="lawCode" target="law:B">B</ref> <ref type="lawCode" target="law:MsA">A</ref> | nah to geahnianne II 24,3; to farenne <ref type="lawCode" target="law:Duns">Duns</ref> 6. — <hi rend="italic">Variirt <ref type="abbreviation" target="gram:mit"><abbr>mit</abbr></ref></hi> nabban <hi rend="italic"><ref type="abbreviation" target="gram:sieheOben"><abbr>s. o.</abbr></ref></hi></sense>
