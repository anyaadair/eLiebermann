      <div type="clause" n="7.6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 7.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 7.6" corresp="#wit-lat"><pb n="553" ed="#liebermann"/>Et si<ptr type="liebermannNote" n="39" target="#Hn_7-6.lnote.oe.39"/> quisquam uiolenta<ptr type="liebermannNote" n="40" target="#Hn_7-6.lnote.oe.40"/> recti destitucione uel detencione in hundretis<ptr type="liebermannNote" n="34" target="#Hn_7-6.lnote.oe.34"/> uel congruis agendorum locis causam suam ita turbauerit, ut ad comitatus audientiam pertrahatur, perdat eam<ptr type="liebermannNote" n="41" target="#Hn_7-6.lnote.oe.41"/> et de cetero<ptr type="liebermannNote" n="42" target="#Hn_7-6.lnote.oe.42"/> componat, sicut rectum sit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 553 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-6.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">-edis <hi rend="italic">Lond meist</hi></seg><seg type="translation" xml:lang="en" source="#claude">-edis mostly Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-6.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-6.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. aus</hi> uil. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected from uil. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-6.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">eciam <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">eciam Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-6.lnote.oe.42" n="42" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">553</biblScope></bibl><seg type="original" xml:lang="de">decetō [<hi rend="italic">viell.</hi> detentionem?] <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">decetō [perhaps detentionem?] Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_7-6.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">316</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. 29; Grafschaftsgericht 4a. 6g; Instanzenzug 4. a</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. 29; Grafschaftsgericht 4a. 6g; Instanzenzug 4. a</seg></note>
