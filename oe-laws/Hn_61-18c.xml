      <div type="clause" n="61.18c">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 61.18c</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 61.18c" corresp="#wit-lat"><pb n="582" ed="#liebermann"/>Differt enim de infami et<ptr type="liebermannNote" n="32" target="#Hn_61-18c.lnote.oe.32"/> saisiato<ptr type="liebermannNote" n="p" target="#Hn_61-18c.lnote.oe.p"/><ptr type="liebermannNote" n="33" target="#Hn_61-18c.lnote.oe.33"/> et de societate<ptr type="liebermannNote" n="q" target="#Hn_61-18c.lnote.oe.q"/> compellato.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 582 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-18c.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">handhaft; <hi rend="italic">vgl.</hi> 26, 3</seg><seg type="translation" xml:lang="en" source="#claude">taken in the act; cf. 26, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-18c.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verderbt</hi> (<hi rend="italic">aus</hi> optimate <hi rend="italic">oder, wie</hi> 9, 6, sola tihla?)</seg><seg type="translation" xml:lang="en" source="#claude">corrupt (from optimate or, as in 9, 6, sola tihla?)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-18c.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">infamie <hi rend="italic">ohne</hi> et <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">infamie without et Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-18c.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">582</biblScope></bibl><seg type="original" xml:lang="de">-sito <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sito Lond</seg></note>
