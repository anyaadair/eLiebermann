    <body>
      <div type="clause" n="32 B 11">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 32 B 11</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 32 B 11"><pb n="657" ed="#liebermann"/>Debet<ptr type="liebermannNote" n="k" target="#ECf_32-B-11.lnote.la.fn.k"/> autem schiremot<ptr type="liebermannNote" n="22" target="#ECf_32-B-11.lnote.la.22"/> bis, hundreda et wapentagia<ptr type="liebermannNote" n="23" target="#ECf_32-B-11.lnote.la.23"/> duodecies in anno congregari, et septem diebus antea summoniri, nisi publicum commodum uel efficiencie<ptr type="liebermannNote" n="14" target="#ECf_32-B-11.lnote.la.14"/> regis<ptr type="liebermannNote" n="24" target="#ECf_32-B-11.lnote.la.24"/> dominica necessitas terminum preueniat.</ab>
        <note type="comparisonPrinted" source="#liebermann">Hn. 7, 4</note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 657 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">This passage is not part of ECf or ECf retr: it is one of the additions of the London collection (Leges Anglorum s. XIII in. Londoniis collectae), which Liebermann prints across the page as an insertion into ECf retr. 32 (32 A–E, pp. 655–660). The dictionary cites it as “ECf 32 B …”, so it is kept with ECf here.</note>
        <note type="editorial">Liebermann prints the words borrowed from Hn 7, 4 in smaller type; his margin names the source (Hn. 7, 4).</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-B-11.lnote.la.fn.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">der Londoner wird</hi> Hn, <hi rend="italic">den er hier und</hi> 32 C 8 <hi rend="italic">plündert, ganz aufnehmen, hinter</hi> ECf.; <hi rend="italic">s. o. S.</hi> 547<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">the Londoner will take in Hn, which he plunders here and at 32 C 8, entire, after ECf.; see above, p. 547, note a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-B-11.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de">scyremote <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">scyremote Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-B-11.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de">-tachia <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-tachia Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-B-11.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_32-B-11.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">657</biblScope></bibl><seg type="original" xml:lang="de">d. r. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. r. Ld</seg></note>
      </div>
    </body>
