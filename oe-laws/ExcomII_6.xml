        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Excom II 6" corresp="#wit-lat"><pb n="434" ed="#liebermann"/>Et si quis ei se<ptr type="liebermannNote" n="7" target="#ExcomII_6.lnote.oe.7"/> sociauerit<ptr type="liebermannNote" n="i" target="#ExcomII_6.lnote.oe.i"/> et communicauerit eius<ptr type="liebermannNote" n="27" target="#ExcomII_6.lnote.oe.27"/> operibus malignis, nouerit se simili<ptr type="liebermannNote" n="28" target="#ExcomII_6.lnote.oe.28"/> percussum<ptr type="liebermannNote" n="i" target="#ExcomII_6.lnote.oe.i"/> anathemate,</ab>
