    <body>
      <div type="clause" n="17">
        <head><ref type="lawCode" target="law:IIAs">II As</ref> 17</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="17" corresp="#wit-h"><pb n="158" ed="#liebermann"/>Syxte: Gif hwa æt þeofe<ptr type="liebermannNote" n="15" target="#IIAs_17.lnote.oe.15"/> medsceat<ptr type="liebermannNote" n="16" target="#IIAs_17.lnote.oe.16"/> nime ⁊ oþres ryht afylle, beo (he<ptr type="liebermannNote" n="11" target="#IIAs_17.lnote.oe.11"/>) his weres scyldig.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="17" corresp="#wit-ld"><pb n="158" ed="#liebermann"/>Be ðæm ðe æt þeofe medsceatte<ptr type="liebermannNote" n="1" target="#IIAs_17.lnote.oe.1"/> nimaþ. Gif hwa æt ðeofe medsceat nime ⁊ oþres rihte<ptr type="liebermannNote" n="1" target="#IIAs_17.lnote.oe.1"/> afylle, be<ptr type="liebermannNote" n="1" target="#IIAs_17.lnote.oe.1"/> he his weres scyldig.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="17" corresp="#wit-ot"><pb n="158" ed="#liebermann"/>Syxte: Gif hwa æt ðeofe metsce …, beo his weres scyldig.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="17" corresp="#wit-q"><pb n="159" ed="#liebermann"/>De<ptr type="liebermannNote" n="33" target="#IIAs_17.lnote.oe.33"/> illis qui a fure munera suscipiunt. Si<ptr type="liebermannNote" n="34" target="#IIAs_17.lnote.oe.34"/> quis a fure munera<ptr type="liebermannNote" n="35" target="#IIAs_17.lnote.oe.35"/> suscipiat (uel mercedem accipiat) et rectum<ptr type="liebermannNote" n="36" target="#IIAs_17.lnote.oe.36"/> alicuius peruertat<ptr type="liebermannNote" n="37" target="#IIAs_17.lnote.oe.37"/> (aut adnichilet), werę suę reus sit.<ptr type="liebermannNote" n="38" target="#IIAs_17.lnote.oe.38"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="17" corresp="#wit-h"><pb n="136" ed="#attenborough"/>[Be ðæm ðe æt þeofe medsceatte nimaþ.]<ptr type="editorNote" n="6" target="#IIAs_17.attnote.fn.6"/> Syxte: Gif hwa æt þeofe medsceat nime ⁊ oþres ryht<ptr type="editorNote" n="7" target="#IIAs_17.attnote.fn.7"/> afylle, beo<ptr type="editorNote" n="8" target="#IIAs_17.attnote.fn.8"/> he his weres scyldig.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="159" ed="#liebermann"/>(Über die, welche Bestechung von einem Verbrecher annehmen. <hi rend="italic">Ld</hi>) Sechstens: wenn jemand von einem Verbrecher Bestechung annimmt und er [deshalb] den Rechtsanspruch eines dritten zu Falle bringt, sei er sein Wergeld<ptr type="liebermannNote" n="1" target="#IIAs_17.lnote.de.1"/> [dem König] schuldig.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">(Of those who take a bribe from a criminal. Ld) Sixthly: if anyone takes a bribe from a criminal and [therefore] defeats a third party's legal claim, let him be liable for his wergild [to the king].</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h"><pb n="137" ed="#attenborough"/>Sixthly: [we declare] if anyone takes bribes from a thief and [by so doing] frustrates the just claims of another, he shall forfeit his wergeld.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="421" ed="#whitelock"/>Sixthly: if anyone accepts a bribe from a thief and ruins the rights of another, he is to be liable to pay his wergild. 18. Seventhly: that no one is to sell a horse across the sea, unless he wishes to give it.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VAs_1-3">V As 1.3</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_17.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">158</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_17.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">158</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_17.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">158</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> -att</seg><seg type="translation" xml:lang="en" source="#claude">altered to -att</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_17.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">158</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_17.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">159</biblScope></bibl><seg type="original" xml:lang="de">De suscipientibus m. a f. <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">De suscipientibus m. a f. Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_17.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">159</biblScope></bibl><seg type="original" xml:lang="de">Et si <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et si Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_17.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">159</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so nur Lond; nur</hi> mer. sus. <hi rend="italic">RMHkBr; nur</hi> mer. accipiet <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus only Lond; only mer. sus. RMHkBr; only mer. accipiet T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_17.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">159</biblScope></bibl><seg type="original" xml:lang="de">r. a. <hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. a. lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_17.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">159</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Or;</hi> p. aut <hi rend="italic">fehlt K;</hi> ad. aut p. [<hi rend="italic">verbessert aus</hi> peruertet <hi rend="italic">M</hi>] <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Or; p. aut lacking in K; ad. aut p. [corrected from peruertet M] the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIAs_17.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">159</biblScope></bibl><seg type="original" xml:lang="de">erit <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">erit T</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIAs_17.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">105</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Wergeld 30 g; Bestechung 3. a; Richter 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Wergeld 30 g; Bestechung 3. a; Richter 3</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_17.attnote.fn.6" n="6" source="#attenborough"><bibl><biblScope unit="page">136</biblScope></bibl><label>nimaþ</label><seg type="original" xml:lang="en">Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_17.attnote.fn.7" n="7" source="#attenborough"><bibl><biblScope unit="page">136</biblScope></bibl><label>ryht</label><seg type="original" xml:lang="en"><hi rend="italic">rihte</hi>. Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIAs_17.attnote.fn.8" n="8" source="#attenborough"><bibl><biblScope unit="page">136</biblScope></bibl><label>beo</label><seg type="original" xml:lang="en"><hi rend="italic">be</hi>. Ld.</seg></note>
      </div>
