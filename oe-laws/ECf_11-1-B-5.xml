    <body>
      <div type="clause" n="11.1 B 5">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 11.1 B 5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 11.1 B 5"><pb n="637" ed="#liebermann"/>‘Ue<ptr type="liebermannNote" n="l" target="#ECf_11-1-B-5.lnote.la.fn.l"/><ptr type="liebermannNote" n="7" target="#ECf_11-1-B-5.lnote.la.7"/> regno, cuius rex puer est, et cuius principes mane comedunt!’ Non uoco regem [puerum<ptr type="liebermannNote" n="8" target="#ECf_11-1-B-5.lnote.la.8"/>] propter paruam et minimam<ptr type="liebermannNote" n="9" target="#ECf_11-1-B-5.lnote.la.9"/> etatem, sed propter stultitiam et iniquitatem et insanitatem iuxta psalmistam<ptr type="liebermannNote" n="10" target="#ECf_11-1-B-5.lnote.la.10"/> regem: ‘Uiri sanguinum et dolosi non dimidiabunt<ptr type="liebermannNote" n="11" target="#ECf_11-1-B-5.lnote.la.11"/> dies suos’ etc.</ab>
        <note type="comparisonPrinted" source="#liebermann">Eccles. 10, 16</note>
        <note type="comparisonPrinted" source="#liebermann">Ps. 54, 24</note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 637 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="editorial">This passage is not part of ECf or ECf retr: it is one of the additions of the London collection (Leges Anglorum s. XIII in. Londoniis collectae), which Liebermann prints in smaller type across the page, under ECf retr. 11, 1, and numbers 11, 1 A ff. The dictionary cites it as “ECf 11, 1 A …”, so it is kept with ECf here.</note>
        <note type="editorial">There is no note 6 in the London text of this page: Liebermann’s numbering goes from 5 to 7.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_11-1-B-5.lnote.la.fn.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 11, 1 A 10</seg><seg type="translation" xml:lang="en" source="#claude">cf. 11, 1 A 10</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1-B-5.lnote.la.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Ld;</hi> De <hi rend="italic">Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Ld; De the MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1-B-5.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänzt Usher; übergeschrieben im</hi> 16. <hi rend="italic">Jh. Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">supplied by Usher; written above in the 16th century Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1-B-5.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so bessert Usher;</hi> nimiam <hi rend="italic">Hss. Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Usher corrects; nimiam MSS Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1-B-5.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">psā <hi rend="italic">Hss.;</hi> prophetam <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">psā MSS; prophetam Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_11-1-B-5.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">637</biblScope></bibl><seg type="original" xml:lang="de">-dicab. <hi rend="italic">K Co Ld;</hi> dimicabunt <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dicab. K Co Ld; dimicabunt Or</seg></note>
      </div>
