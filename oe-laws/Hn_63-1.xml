    <body>
      <div type="clause" n="63.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 63.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 63.1" corresp="#wit-lat"><pb n="583" ed="#liebermann"/>In causis ubi iudex<ptr type="liebermannNote" n="17" target="#Hn_63-1.lnote.oe.17"/> fiscalis aliquem inplacitet de<ptr type="liebermannNote" n="d" target="#Hn_63-1.lnote.oe.d"/> socna sua sine<ptr type="liebermannNote" n="e" target="#Hn_63-1.lnote.oe.e"/> alio<ptr type="liebermannNote" n="18" target="#Hn_63-1.lnote.oe.18"/> accusatore, sine<ptr type="liebermannNote" n="19" target="#Hn_63-1.lnote.oe.19"/> sagemanno<ptr type="liebermannNote" n="f" target="#Hn_63-1.lnote.oe.f"/><ptr type="liebermannNote" n="20" target="#Hn_63-1.lnote.oe.20"/>, sine<ptr type="liebermannNote" n="19" target="#Hn_63-1.lnote.oe.19"/> inuestitura<ptr type="liebermannNote" n="g" target="#Hn_63-1.lnote.oe.g"/>, si quis se tercio uicinorum<ptr type="liebermannNote" n="21" target="#Hn_63-1.lnote.oe.21"/> suorum purget, satis est propter iusticie reuerenciam.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 583 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_63-1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de">kraft Anklageprivilegs (<hi rend="italic">des Fiscus</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">by virtue of the privilege of accusation (of the fisc)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_63-1.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur Königsrichter und Gerichtsherr können ohne Klagezeugen den Beklagten zur Antwort zwingen. Vgl.</hi> Summa leg. Norm. 123, 3: Nullus in curia sua teste indiget; uox domini sufficit ad accusationem subditorum. <hi rend="italic">Ferner</hi> Très anc. cout. Norm. I 40, 2: Forestarii non producent testem super forisfacto foreste, nec parcarii, prepositi, seruientes; <hi rend="italic">von anderen Klägern gilt solche</hi> compellatio <hi rend="italic">als</hi> uacua (45, 1<hi rend="italic">a</hi>)</seg><seg type="translation" xml:lang="en" source="#claude">only the king’s judge and the lord of the court can compel the defendant to answer without witnesses to the charge. Cf. Summa leg. Norm. 123, 3: Nullus in curia sua teste indiget; uox domini sufficit ad accusationem subditorum. Further Très anc. cout. Norm. I 40, 2: Forestarii non producent testem super forisfacto foreste, nec parcarii, prepositi, seruientes; coming from other accusers, such a compellatio counts as uacua (45, 1<hi rend="italic">a</hi>)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_63-1.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de">‘Melder, Anzeiger’, <hi rend="italic">für</hi> secga <hi rend="italic">Swer.</hi> 4</seg><seg type="translation" xml:lang="en" source="#claude">‘informer, denouncer’, for secga Swer. 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_63-1.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wie</hi> seisina: ‘Handhaftigkeit’</seg><seg type="translation" xml:lang="en" source="#claude">like seisina: ‘being taken in the act’</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_63-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de">f. i. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. i. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_63-1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de">aliquo <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">aliquo Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_63-1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Sc Hg K Co;</hi> siue <hi rend="italic">Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Sc Hg K Co; siue edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_63-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de">sakem. <hi rend="italic">K Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">sakem. K Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_63-1.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">583</biblScope></bibl><seg type="original" xml:lang="de">-no suo <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">-no suo Wh</seg></note>
      </div>
