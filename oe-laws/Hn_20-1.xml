      <div type="clause" n="20.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 20.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 20.1" corresp="#wit-lat"><pb n="560" ed="#liebermann"/>Participantium<ptr type="liebermannNote" n="b" target="#Hn_20-1.lnote.oe.b"/> quoque<ptr type="liebermannNote" n="9" target="#Hn_20-1.lnote.oe.9"/> causarum partim<ptr type="liebermannNote" n="c" target="#Hn_20-1.lnote.oe.c"/> in socna<ptr type="liebermannNote" n="1" target="#Hn_20-1.lnote.oe.1"/>, id est in questione<ptr type="liebermannNote" n="d" target="#Hn_20-1.lnote.oe.d"/><ptr type="liebermannNote" n="10" target="#Hn_20-1.lnote.oe.10"/> sua, rex habet, partim<ptr type="liebermannNote" n="c" target="#Hn_20-1.lnote.oe.c"/> concedit<ptr type="liebermannNote" n="11" target="#Hn_20-1.lnote.oe.11"/> aliis.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 560 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 9, 11</seg><seg type="translation" xml:lang="en" source="#claude">cf. 9, 11</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">partem <hi rend="italic">empfiehlt Schmid</hi> [<hi rend="italic">unnöthig, da Accus.</hi> partim <hi rend="italic">klassisch</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">Schmid recommends partem [unnecessary, since the accusative partim is classical]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so erklären damals auch andere; vgl. mein</hi> Über Edward Confessor <hi rend="italic">S.</hi> 91</seg><seg type="translation" xml:lang="en" source="#claude">others at that time also explain it thus; cf. my Über Edward Confessor p. 91</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">sokn. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sokn. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">uero <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">uero <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">qōē <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">qōē Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_20-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">-dat <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">-dat Wh</seg></note>
