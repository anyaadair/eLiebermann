      <div type="clause" n="3">
        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 3" corresp="#wit-lat"><ptr type="liebermannNote" n="22" target="#LibLond_3.lnote.oe.22"/><pb n="673" ed="#liebermann"/>Sciendum est<ptr type="liebermannNote" n="23" target="#LibLond_3.lnote.oe.23"/> itaque, quod<ptr type="liebermannNote" n="24" target="#LibLond_3.lnote.oe.24"/> ciuis<ptr type="liebermannNote" n="25" target="#LibLond_3.lnote.oe.25"/> Lund.’ extra ciuitatis muros<ptr type="liebermannNote" n="m" target="#LibLond_3.lnote.oe.m"/> uersus regem nec uersus alium placitare debet<ptr type="liebermannNote" n="n" target="#LibLond_3.lnote.oe.n"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 673 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_3.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">673</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> nec</seg><seg type="translation" xml:lang="en" source="#claude">supply nec</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_3.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">673</biblScope></bibl><seg type="original" xml:lang="de">preter placita de tenuris exterioribus, exceptis monetariis et ministris meis, <hi rend="italic">fügt beschränkend Heinrich II.</hi> 1155 <hi rend="italic">hinzu, wonach Ampl.</hi> 711</seg><seg type="translation" xml:lang="en" source="#claude">preter placita de tenuris exterioribus, exceptis monetariis et ministris meis, Henry II, 1155, adds by way of restriction, followed by Ampl. 711</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_3.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">673</biblScope></bibl><seg type="original" xml:lang="de">Item de Londoniensibus (Lond’ <hi rend="italic">S</hi>) <hi rend="italic">überschr. PlS</hi></seg><seg type="translation" xml:lang="en" source="#claude">Item de Londoniensibus (Lond’ S) as heading PlS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_3.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">673</biblScope></bibl><seg type="original" xml:lang="de">i. est <hi rend="italic">Ai Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">i. est Ai Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_3.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">673</biblScope></bibl><seg type="original" xml:lang="de">quia <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">quia S</seg></note>
