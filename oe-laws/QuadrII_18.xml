  <text>
    <body>
      <div type="clause" n="18">
        <head><ref type="lawCode" target="law:QuadrII">Quadr II</ref> 18</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr II 18" corresp="#wit-lat"><ptr type="liebermannNote" n="7" target="#QuadrII_18.lnote.oe.7"/><pb n="546" ed="#liebermann"/>Decreta de archidiaconibus et ceteris gradibus. Hæc sunt instituta<ptr type="liebermannNote" n="8" target="#QuadrII_18.lnote.oe.8"/> de archidiaconibus<ptr type="liebermannNote" n="n" target="#QuadrII_18.lnote.oe.n"/> — — uisum fuerit. <hi rend="italic">Ed. Liebermann</hi> Quadripartitus <hi rend="italic">S</hi>. 163 <hi rend="italic">ff</hi>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 546 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_18.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">546</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Quadr. nennt Gerhard, der vielmehr</hi> 21. <hi rend="italic">Mai</hi> 1108 <hi rend="italic">verstorben war, als bei dieser Synode, Ende Mai, noch anwesend: um ihn zu verherrlichen</hi></seg><seg type="translation" xml:lang="en" source="#claude">The Quadr. names Gerard, who had in fact died on 21 May 1108, as still present at this synod at the end of May: in order to glorify him</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_18.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">546</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Überschrift roth T; fehlt MHk (wo am Rande roth:</hi> XX) <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Heading in red T; missing in MHk (where XX in red in the margin) Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrII_18.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">546</biblScope></bibl><seg type="original" xml:lang="de">statuta <hi rend="italic">M</hi></seg><seg type="translation" xml:lang="en" source="#claude">statuta M</seg></note>
      </div>
