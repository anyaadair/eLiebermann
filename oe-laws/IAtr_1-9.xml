    <body>
      <div type="clause" n="1.9">
        <head><ref type="lawCode" target="law:IAtr">I Atr</ref> 1.9</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.9" corresp="#wit-h"><pb n="218" ed="#liebermann"/>⁊ gif seo lad forðcume, beo he þæs weres wurðe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.9" corresp="#wit-b"><pb n="218" ed="#liebermann"/>⁊ gyf<ptr type="liebermannNote" n="1" target="#IAtr_1-9.lnote.oe.1"/> seo lad forðcume, beo he ðes<ptr type="liebermannNote" n="14" target="#IAtr_1-9.lnote.oe.14"/> weres wyrðe.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.9" corresp="#wit-q"><pb n="219" ed="#liebermann"/>Et si lada procedat, sit were sue dignus.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="1.9" corresp="#wit-b"><pb n="54" ed="#robertson"/>⁊ gyf seo lad forðcume, beo he ðes weres wyrðe.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="219" ed="#liebermann"/>Und wenn diese Reinigung zu Stande kommt, so sei er zu jenem Wergeld [seines verklagten Untergebenen] berechtigt.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if this clearing succeeds, let him be entitled to that wergild [of his accused dependant].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><ptr type="editorNote" n="1" target="#IAtr_1-9.robnote.n.1"/><pb n="55" ed="#robertson"/>And if he succeeds in clearing himself, he shall be entitled to the wergeld.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IICn_30-8">II Cn 30.8</ref></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-9.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IAtr_1-9.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">218</biblScope></bibl><seg type="original" xml:lang="de">ðæs <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæs Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IAtr_1-9.lnote.de.0" n="0" source="#liebermann-erkl" rend="wholeClause"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">148</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o</hi>. 1, 7⁶; <hi rend="italic">u</hi>. 1, 11</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 1, 7⁶; <hi rend="italic">below</hi> 1, 11</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IAtr_1-9.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">313</biblScope></bibl><seg type="original" xml:lang="en">Cf. 1, 7.</seg></note>
      </div>
