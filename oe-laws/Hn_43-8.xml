    <body>
      <div type="clause" n="43.8">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 43.8</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 43.8" corresp="#wit-lat"><pb n="569" ed="#liebermann"/>Si dominus terram suam<ptr type="liebermannNote" n="29" target="#Hn_43-8.lnote.oe.29"/> uel feodum suum auferat homini suo, unde est homo suus, uel si eum in mortali neccessitate deserat<ptr type="liebermannNote" n="r" target="#Hn_43-8.lnote.oe.r"/> superuacue, forisfacere<ptr type="liebermannNote" n="30" target="#Hn_43-8.lnote.oe.30"/> potest domin[i]um<ptr type="liebermannNote" n="31" target="#Hn_43-8.lnote.oe.31"/> suum erga eum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 569 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-8.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">d. s. <hi rend="italic">auch</hi> 88, 15: feige (schwächlich) verlässt</seg><seg type="translation" xml:lang="en" source="#claude">d. s. also 88, 15: deserts in cowardly fashion (feebly)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-8.lnote.oe.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Sc Hg Edd.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-8.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">-ciat <hi rend="italic">statt</hi> -cere p. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ciat instead of -cere p. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-8.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">569</biblScope></bibl><seg type="original" xml:lang="de">dominum <hi rend="italic">Hss. Wh;</hi> -nus suus <hi rend="italic">ändern gegen Hss. Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">dominum MSS Wh; -nus suus Wi Tho, altering against the MSS</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_43-8.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">322</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. 15a—<hi rend="italic">forisfaciet dominium</hi>{31}, wie ich emendierte, Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. 15a—<hi rend="italic">forisfaciet dominium</hi>{31}, as I emended, Rs</seg></note>
      </div>
