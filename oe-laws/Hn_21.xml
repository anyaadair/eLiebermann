    <body>
      <div type="clause" n="21">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 21</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 21" corresp="#wit-lat"><ptr type="liebermannNote" n="45" target="#Hn_21.lnote.oe.45"/><pb n="560" ed="#liebermann"/>De generibus causarum. Sunt etiam, ut<ptr type="liebermannNote" n="46" target="#Hn_21.lnote.oe.46"/> diximus<ptr type="liebermannNote" n="p" target="#Hn_21.lnote.oe.p"/>, quedam genera causarum<ptr type="liebermannNote" n="47" target="#Hn_21.lnote.oe.47"/> premissa<ptr type="liebermannNote" n="q" target="#Hn_21.lnote.oe.q"/> singularitate licentius expedita, in quarum emendacionibus rex particulariter communicat, ubicunque fiant, in diuinis uel secularibus, super regios et ecclesiasticos et<ptr type="liebermannNote" n="48" target="#Hn_21.lnote.oe.48"/> baronum homines et acephalos<ptr type="liebermannNote" n="49" target="#Hn_21.lnote.oe.49"/> et pauperes, siue socnam<ptr type="liebermannNote" n="50" target="#Hn_21.lnote.oe.50"/> totaliter habeat uel particulariter: ex quibus sunt adulterium<ptr type="liebermannNote" n="r" target="#Hn_21.lnote.oe.r"/>; homicidium<ptr type="liebermannNote" n="s" target="#Hn_21.lnote.oe.s"/> in ecclesia factum; infraccio pacis uel ordinis<ptr type="liebermannNote" n="t" target="#Hn_21.lnote.oe.t"/> uel christianitatis uel legalitatis, si<ptr type="liebermannNote" n="u" target="#Hn_21.lnote.oe.u"/> cogi oporteat per mundanam potestatem, ut rectum fiat.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 560 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_21.lnote.oe.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">11, 1—5; 7—9; 11—15</seg><seg type="translation" xml:lang="en" source="#claude">11, 1—5; 7—9; 11—15</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_21.lnote.oe.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">kraft obiger Ausnahme-Qualität freier ungebunden [<hi rend="italic">durch Rücksicht auf Ort oder Thäter des Verbrechens und ihr entfliessende Privatjurisdiction</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">by virtue of the exceptional quality stated above, more freely unbound [by regard to the place or the perpetrator of the crime and the private jurisdiction arising from that]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_21.lnote.oe.r" n="r" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">o.</hi> 11, 5</seg><seg type="translation" xml:lang="en" source="#claude">above 11, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_21.lnote.oe.s" n="s" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">o.</hi> 11, 1<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude">above 11, 1<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_21.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">o.</hi> 11, 12</seg><seg type="translation" xml:lang="en" source="#claude">above 11, 12</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_21.lnote.oe.u" n="u" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt aus</hi> 11, 15</seg><seg type="translation" xml:lang="en" source="#claude">repeated from 11, 15</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_21.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">C. XXII <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">C. XXII Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_21.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">ut d. <hi rend="italic">fehlt K Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">ut d. lacking in K Co Or Gi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_21.lnote.oe.47" n="47" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond;</hi> a <hi rend="italic">fügt zu K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond; K adds a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_21.lnote.oe.48" n="48" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_21.lnote.oe.49" n="49" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Sl Tw;</hi> aze. <hi rend="italic">Lond;</hi> acefa. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Sl Tw; aze. Lond; acefa. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_21.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">560</biblScope></bibl><seg type="original" xml:lang="de">socham <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">socham Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_21.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">319</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Kronprozess 2. 14 ff.; Justizertrag 7a; Halbteilung 1. 2.—Spät. am Rande: <hi rend="italic">Nota, regem correctiones pro transgressionibus factis tam ecclesiasticis personis quam laicis pro parte sibi reservandas</hi> (lies <hi rend="italic">-vare</hi>)—<hi rend="italic">g. a pr̃</hi>. ohne <hi rend="italic">caus</hi>.{47}—<hi rend="italic">socam</hi>{50}—22 <hi rend="italic">De grindeb. et hamsochna</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Kronprozess 2. 14 ff.; Justizertrag 7a; Halbteilung 1. 2.—Later, in the margin: <hi rend="italic">Nota, regem correctiones pro transgressionibus factis tam ecclesiasticis personis quam laicis pro parte sibi reservandas</hi> (read <hi rend="italic">-vare</hi>)—<hi rend="italic">g. a pr̃</hi>. without <hi rend="italic">caus</hi>.{47}—<hi rend="italic">socam</hi>{50}—22 <hi rend="italic">De grindeb. et hamsochna</hi> Rs</seg></note>
      </div>
