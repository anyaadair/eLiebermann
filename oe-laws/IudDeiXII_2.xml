    <body>
      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:IudDeiXII">Iud Dei XII</ref> 2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei XII 2" corresp="#wit-lat"><ptr type="liebermannNote" n="6" target="#IudDeiXII_2.lnote.oe.6"/><pb n="420" ed="#liebermann"/>Inquisitus<ptr type="liebermannNote" n="7" target="#IudDeiXII_2.lnote.oe.7"/> si<ptr type="liebermannNote" n="8" target="#IudDeiXII_2.lnote.oe.8"/> fuerit aliquis de furto — luxuria, adulterio uel quacumque<ptr type="liebermannNote" n="9" target="#IudDeiXII_2.lnote.oe.9"/> alia re — et noluerit confiteri magistro, seniori<ptr type="liebermannNote" n="10" target="#IudDeiXII_2.lnote.oe.10"/> uel misso senioris, ista erit ratio<ptr type="liebermannNote" n="11" target="#IudDeiXII_2.lnote.oe.11"/>:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 420 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">c.</hi> 2—5 = <hi rend="italic">Zeu.</hi> 703 (20)</seg><seg type="translation" xml:lang="en" source="#claude">c. 2—5 = Zeu. 703 (20)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Tb;</hi> Nquis. <hi rend="italic">Ll,</hi> igitur <hi rend="italic">fügt zu Tr; über</hi> -tus <hi rend="italic">schreibt</hi> ti <hi rend="italic">und so fernerhin den Plural über die Zeile Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Tb; Nquis. Ll, Tr adds igitur; above -tus Tr writes ti, and so henceforth writes the plural above the line</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_2.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de">al. si fu. de <hi rend="italic">Vt2</hi></seg><seg type="translation" xml:lang="en" source="#claude">al. si fu. de Vt2</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_2.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de">qualicu. re alia <hi rend="italic">Zeu.</hi></seg><seg type="translation" xml:lang="en" source="#claude">qualicu. re alia Zeu.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_2.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de">domino u. m. domini <hi rend="italic">als synonym liest Hs. Bamberg XI. Jhs.</hi></seg><seg type="translation" xml:lang="en" source="#claude">an 11th-cent. Bamberg MS reads domino u. m. domini as a synonym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiXII_2.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">420</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">endet Mg, wo</hi> XIII <hi rend="italic">folgt</hi></seg><seg type="translation" xml:lang="en" source="#claude">Mg ends, where XIII follows</seg></note>
      </div>
