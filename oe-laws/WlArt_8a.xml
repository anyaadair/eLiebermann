    <body>
      <div type="clause" n="8a">
        <head><ref type="lawCode" target="law:WlArt">Wl art</ref> 8a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-h"><pb n="488" ed="#liebermann"/>et si quisquam talium<ptr type="liebermannNote" n="16" target="#WlArt_8a.lnote.oe.16"/> euaserit, uideant plegii<ptr type="liebermannNote" n="b" target="#WlArt_8a.lnote.oe.b"/>, ut<ptr type="liebermannNote" n="17" target="#WlArt_8a.lnote.oe.17"/> simpliciter<ptr type="liebermannNote" n="18" target="#WlArt_8a.lnote.oe.18"/> soluant quod calumniatum<ptr type="liebermannNote" n="c" target="#WlArt_8a.lnote.oe.c"/> est, et purgent se, quia<ptr type="liebermannNote" n="19" target="#WlArt_8a.lnote.oe.19"/> in<ptr type="liebermannNote" n="d" target="#WlArt_8a.lnote.oe.d"/> euaso nullam fraudem<ptr type="liebermannNote" n="20" target="#WlArt_8a.lnote.oe.20"/> nouerunt.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="8a" corresp="#wit-h"><pb n="240" ed="#robertson"/>et si quisquam talium evaserit, videant plegii ut simpliciter solvant quod calumniatum est, et purgent se, quia in evaso nullam fraudem noverunt.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-h"><pb n="241" ed="#robertson"/>And if any such escapes, the members of the frankpledge shall be responsible for the simple payment of what is claimed, and shall clear themselves from [the charge of] any knowledge of fraud on the part of the runaway.</ab>
        <note type="comparison" source="#liebermann" n="488">Inst Cn II 31.1</note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 31, 1</note>
        <note type="editorial">Added October 2026 from Robertson pp. 240–241 (text and translation); Liebermann’s text added from Gesetze I p. 488, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8a.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier</hi> Freibürgschaftsverband, Zehntschaft; <hi rend="italic">vgl. Liebermann</hi> Über Leg. Ed. Conf. 81 <hi rend="italic">ff.</hi></seg><seg type="translation" xml:lang="en" source="#claude">here the frankpledge association, tithing; cf. Liebermann Über Leg. Ed. Conf. 81 ff.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8a.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. u.</hi> 8, 3</seg><seg type="translation" xml:lang="en" source="#claude">see below 8, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8a.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Anklang an Eidesformel</hi> IV As. 6, 3; I Atr. 1, 8. 1, 12. II Cn 13, 2. <hi rend="italic">Vgl.</hi> Ed. Conf. 20, 5; Leis Wl 3</seg><seg type="translation" xml:lang="en" source="#claude">echo of the oath formula IV As. 6, 3; I Atr. 1, 8. 1, 12. II Cn 13, 2. Cf. Ed. Conf. 20, 5; Leis Wl 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8a.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">e. t. <hi rend="italic">Hv Retr</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. t. Hv Retr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8a.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">Vi</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod Vi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8a.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Hv Retr Ra Vi Va Ph Pl</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted in Cb Hv Retr Ra Vi Va Ph Pl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8a.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">quod <hi rend="italic">Hv;</hi> qui <hi rend="italic">Vi</hi></seg><seg type="translation" xml:lang="en" source="#claude">quod Hv; qui Vi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8a.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">488</biblScope></bibl><seg type="original" xml:lang="de">habuerunt nec <hi rend="italic">fügt zu Ra</hi></seg><seg type="translation" xml:lang="en" source="#claude">Ra adds habuerunt nec</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArt_8a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">281</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Gefährdeeid 4; Haftung 17a</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Gefährdeeid 4; Haftung 17a</seg></note>
      </div>
    </body>
