    <body>
      <div type="clause" n="24">
        <head><ref type="lawCode" target="law:QuadrDed">Quadr Ded</ref> 24</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Ded 24" corresp="#wit-lat"><pb n="531" ed="#liebermann"/>Uereor itaque futura<ptr type="liebermannNote" n="f" target="#QuadrDed_24.lnote.oe.f"/> de te iudicia, dum me talia<ptr type="liebermannNote" n="g" target="#QuadrDed_24.lnote.oe.g"/> professorum<ptr type="liebermannNote" n="h" target="#QuadrDed_24.lnote.oe.h"/> manus inpure conuenient et ad singula conclamabunt: ‘hoc ineptum est, hoc inualidum’, uel quicquid ad egerendam dire mentis suæ [p]etul[a]ntiam<ptr type="liebermannNote" n="7" target="#QuadrDed_24.lnote.oe.7"/> ledorie<ptr type="liebermannNote" n="hh" target="#QuadrDed_24.lnote.oe.hh"/> uel scommatum uerbis aut motibus occurrerit intempestum.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 531 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_24.lnote.oe.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Macrob.</hi> Sat. I 24: erubuit de se futura iudicia; <hi rend="italic">vgl. o.</hi> 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf. Macrob.</hi> Sat. I 24: erubuit de se futura iudicia; <hi rend="italic">cf. above</hi> 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_24.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze</hi> locutum <hi rend="italic">oder ähnliches</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">supply</hi> locutum <hi rend="italic">or something similar</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_24.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. u.</hi> 38 <hi rend="italic">und Hn</hi> 6, 2: maligna professorum studia</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf. below</hi> 38 <hi rend="italic">and Hn</hi> 6, 2: maligna professorum studia</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_24.lnote.oe.hh" n="hh" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Macrob.</hi> Saturn. 7, 3: loedoria et scomma</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Macrob.</hi> Saturn. 7, 3: loedoria et scomma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_24.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de">uętulentiam <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">uętulentiam <hi rend="italic">Dm</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_24.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de">Vielleicht ist statt der Ergänzung <hi rend="italic">g</hi> vielmehr <hi rend="italic">professum</hi> (‘mich, der ich solches offen bekannte’) zu lesen</seg><seg type="translation" xml:lang="en" source="#claude">Perhaps, instead of the supplement <hi rend="italic">g</hi>, <hi rend="italic">professum</hi> (‘me, who openly professed such things’) should rather be read</seg></note>
      </div>
