      <div type="clause" n="9">
        <head><ref type="lawCode" target="law:IudDeiI">Iud Dei I</ref> 9</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei I 9" corresp="#wit-lat"><pb n="402" ed="#liebermann"/>Uersus. Adiuua nos, Deus salutaris<ptr type="liebermannNote" n="68" target="#IudDeiI_9.lnote.oe.68"/> noster, et propter honorem<ptr type="liebermannNote" n="69" target="#IudDeiI_9.lnote.oe.69"/> nominis tui, Domine, libera<ptr type="liebermannNote" n="70" target="#IudDeiI_9.lnote.oe.70"/> nos.</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">78, 9</note>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 402 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_9.lnote.oe.68" n="68" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">sal.—nos <hi rend="italic">fehlt Ca Ma</hi></seg><seg type="translation" xml:lang="en" source="#claude">sal.—nos omitted in Ca Ma</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_9.lnote.oe.69" n="69" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">gloriam <hi rend="italic">wie Vulgata Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">gloriam, as in the Vulgate, Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiI_9.lnote.oe.70" n="70" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">402</biblScope></bibl><seg type="original" xml:lang="de">super <hi rend="italic">Vt</hi></seg><seg type="translation" xml:lang="en" source="#claude">super Vt</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">Verse. Help us, O God our saviour, and for the honour of your name, O Lord, deliver us.</ab>
      </div>
