        <note type="liebermannNote" subtype="textual" xml:id="ICn_2-5.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">282</biblScope></bibl><seg type="original" xml:lang="de">þare cyrican be cyninges f. mundbrece ⁊ ðas mynstres clans. <hi rend="italic">Ld</hi> [<hi rend="italic">vgl. A</hi>]</seg><seg type="translation" xml:lang="en" source="#claude">þare cyrican be cyninges f. mundbrece ⁊ ðas mynstres clans. Ld [cf. A]</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_2-5.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">282</biblScope></bibl><seg type="original" xml:lang="de">myst. <hi rend="italic">G</hi></seg><seg type="translation" xml:lang="en" source="#claude">myst. G</seg></note>
