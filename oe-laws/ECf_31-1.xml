      <div type="clause" n="31.1">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 31.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 31.1"><pb n="653" ed="#liebermann"/>Et quod Angli<ptr type="liebermannNote" n="17" target="#ECf_31-1.lnote.la.17"/> uocabant hundredum<ptr type="liebermannNote" n="18" target="#ECf_31-1.lnote.la.18"/>, isti<ptr type="liebermannNote" n="19" target="#ECf_31-1.lnote.la.19"/>: wapentagium<ptr type="liebermannNote" n="e" target="#ECf_31-1.lnote.la.fn.e"/>; et quod illi<ptr type="liebermannNote" n="20" target="#ECf_31-1.lnote.la.20"/> uocabant tria<ptr type="liebermannNote" n="21" target="#ECf_31-1.lnote.la.21"/> hundreda<ptr type="liebermannNote" n="f" target="#ECf_31-1.lnote.la.fn.f"/> uel<ptr type="liebermannNote" n="22" target="#ECf_31-1.lnote.la.22"/> IIII uel<ptr type="liebermannNote" n="23" target="#ECf_31-1.lnote.la.23"/> plurima<ptr type="liebermannNote" n="24" target="#ECf_31-1.lnote.la.24"/>, isti uocabant<ptr type="liebermannNote" n="25" target="#ECf_31-1.lnote.la.25"/> [þ]rehing<ptr type="liebermannNote" n="26" target="#ECf_31-1.lnote.la.26"/>.</ab>
        <note type="comparison" source="#liebermann" n="653"><label>printed alongside</label> <ref target="clause:ECfRetr_31-1">ECf retr 31.1</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 653 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-1.lnote.la.fn.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt aus</hi> 30, 1</seg><seg type="translation" xml:lang="en" source="#claude">repeated from 30, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-1.lnote.la.fn.f" n="f" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht etwa ein fester District</hi></seg><seg type="translation" xml:lang="en" source="#claude">not, say, a fixed district</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-1.lnote.la.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">alii <hi rend="italic">zu emendiren lehnt ab Steenstrup</hi> Danelag 96 <hi rend="italic">mit Recht</hi></seg><seg type="translation" xml:lang="en" source="#claude">Steenstrup, Danelag 96, rightly declines to emend to alii</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-1.lnote.la.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">-da <hi rend="italic">Hk Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-da Hk Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-1.lnote.la.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">uocant <hi rend="italic">fügt zu S Hr Do;</hi> uocabant <hi rend="italic">Ad</hi></seg><seg type="translation" xml:lang="en" source="#claude">S Hr Do add uocant; uocabant Ad</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-1.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">ipsi <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">ipsi Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-1.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">duo h. uel tria uel plur. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">duo h. uel tria uel plur. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-1.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">u. IIII <hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. IIII lacking in Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-1.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Rl</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Rl</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-1.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">plura <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">plura Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-1.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">uocant <hi rend="italic">S</hi></seg><seg type="translation" xml:lang="en" source="#claude">uocant S</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_31-1.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">653</biblScope></bibl><seg type="original" xml:lang="de">tþrihingam <hi rend="italic">Ad;</hi> tr. <hi rend="italic">übr.;</hi> treigg <hi rend="italic">S;</hi> trydinge <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">tþrihingam Ad; tr. the others; treigg S; trydinge Do</seg></note>
      </div>
