    <body>
      <div type="clause" n="9.1">
        <head><ref type="lawCode" target="law:ICn">I Cn</ref> 9.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="9.1" corresp="#wit-g-a"><pb n="292" ed="#liebermann"/>⁊ se ðe ofer þæne<ptr type="liebermannNote" n="7" target="#ICn_9-1.lnote.oe.7"/> dæg hit healde, agyfe<ptr type="liebermannNote" n="15" target="#ICn_9-1.lnote.oe.15"/> þam bisceope<ptr type="liebermannNote" n="16" target="#ICn_9-1.lnote.oe.16"/> þæne penig ⁊ þærto XXX<ptr type="liebermannNote" n="17" target="#ICn_9-1.lnote.oe.17"/> ⁊ þa<hi rend="italic">m</hi> cingce<ptr type="liebermannNote" n="18" target="#ICn_9-1.lnote.oe.18"/> CXX scyll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="9.1" corresp="#wit-a"><pb n="292" ed="#liebermann"/>⁊ se þe ofer þonne<ptr type="liebermannNote" n="3" target="#ICn_9-1.lnote.oe.3"/> dæg hit healde, agife þa<hi rend="italic">m</hi> biscope þane peningc ⁊ þærto ðrittig penega ⁊ þam cyninge twa<ptr type="liebermannNote" n="5" target="#ICn_9-1.lnote.oe.5-2"/> hundred ⁊ twentig scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="9.1" corresp="#wit-q"><pb n="292" ed="#liebermann"/>Qui supratenuerit, reddat episcopo denarium illum et XXX denarios addat<ptr type="liebermannNote" n="4" target="#ICn_9-1.lnote.oe.4"/> et regi det quinquaginta<ptr type="liebermannNote" n="16" target="#ICn_9-1.lnote.oe.16-2"/> (CXX) solidos.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="9.1" corresp="#wit-cons-cn"><pb n="293" ed="#liebermann"/>et quicumque illum ultra prenominatum diem tenuerit, reddat episcopo ipsum denarium et insuper [XXX] et regi CXX solidos.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="9.1" corresp="#wit-g-a"><pb n="164" ed="#robertson"/>⁊ se ðe ofer þæne dæg hit healde, agyfe þam bisceope þæne penig ⁊ þærto XXX<ptr type="editorNote" n="4" target="#ICn_9-1.robnote.fn.4"/> ⁊ þam cingce CXX<ptr type="editorNote" n="5" target="#ICn_9-1.robnote.fn.5"/> scyll'.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="242" ed="#rabin-doml"/>And se ðe ofer þæne dæg hit healde, agyfe þam bisceope þæne penig and þærto XXX and þam cingce CXX scyllinga.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="293" ed="#liebermann"/>und wer es über diesen Tag [vorent]hält, gebe dem Bischof den Pfennig und 30 (Pfennig <hi rend="italic">A</hi>) dazu und dem König 120 (220<ptr type="liebermannNote" n="1" target="#ICn_9-1.lnote.de.1"/> <hi rend="italic">A</hi>) Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">and whoever withholds it beyond that day, let him give the bishop the penny and 30 (pence, A) besides, and the king 120 (220, A) shillings.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-g-a"><ptr type="editorNote" n="1" target="#ICn_9-1.robnote.n.1"/><pb n="165" ed="#robertson"/>And he who withholds it beyond that date shall give the bishop the penny and 30 pence in addition, and 120 shillings<ptr type="editorNote" n="2" target="#ICn_9-1.robnote.n.2"/> to the king.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="243" ed="#rabin-doml"/>And anyone who withholds it beyond that day shall give the money and a further thirty pence to the bishop, and one hundred twenty shillings to the king.</ab>
        <note type="comparison" source="#liebermann" n="293"><ref target="clause:VIIIAtr_10">VIII Atr 10</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 10,</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_17-3">Leis Wl 17.3</ref></note>
        <note type="comparison" source="#wormald-mel" n="356"><label>source (roman)</label> <ref target="clause:VIIIAtr_10-1">VIII Atr 10.1</ref> <quote>Table 5.4, I Cn 9:1: (HomN LXI) VIII Atr 10:1</quote></note>
        <note type="comparison" source="#wormald-mel" n="368"><label>modifies</label> <ref target="clause:IIEg_4-1">II Eg 4.1–3</ref> <quote>in I Cn 9:1, it goes no further than the bishop</quote></note>
        <note type="comparison" source="#wormald-mel" n="368"><label>modifies</label> <ref target="clause:VIIIAtr_10-1">VIII Atr 10.1</ref> <quote>in I Cn 9:1, it goes no further than the bishop</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="404"><ref target="clause:InCn_Inscr">In Cn</ref></note>
        <note type="editorial">A's ‘twa hundred’ (220) is arbitrary (also in 10.1). Quadr. MS K's ‘quinquaginta’ reflects Norman reckoning (Hn 11.3). Liebermann compares VIII Atr 10.1.; BR: added from Gesetze I p. 293, October 2026 (MS Cons); AY: corrected against Rabin p. 242 / 243, October 2026 (was “xxx:; cxx”, now “XXX:; CXX”)</note>
        <note type="textual" source="#rabin-doml">XXX: ðrittig þenega A</note>
        <note type="textual" source="#rabin-doml">CXX scyllinga: twa hundred and twentig scillinga A</note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_9-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">292</biblScope></bibl><seg type="original" xml:lang="de">þonne <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">þonne Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_9-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">292</biblScope></bibl><seg type="original" xml:lang="de">agife <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">agife Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_9-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">292</biblScope></bibl><seg type="original" xml:lang="de">biscope þane pening <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">biscope þane pening Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_9-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">292</biblScope></bibl><seg type="original" xml:lang="de">pening <hi rend="italic">fügt zu Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">pening added by Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_9-1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">292</biblScope></bibl><seg type="original" xml:lang="de">cyning 220 scill. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">cyning 220 scill. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_9-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">292</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_9-1.lnote.oe.16-2" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">292</biblScope></bibl><seg type="original" xml:lang="de">qu. <hi rend="italic">K Hn.</hi> 11, 3 [<hi rend="italic">Normannische Rechnung</hi>]; CXX <hi rend="italic">Dm</hi>; centum uiginti <hi rend="italic">R</hi>; CXXX <hi rend="italic">T</hi>; XXX <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">qu. K Hn. 11, 3 [Norman reckoning]; CXX Dm; centum uiginti R; CXXX T; XXX Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_9-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">293</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt</hi></seg><seg type="translation" xml:lang="en" source="#claude">omitted</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_9-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">292</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. o.</hi> 6, 1</seg><seg type="translation" xml:lang="en" source="#claude">see above 6, 1</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ICn_9-1.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">292</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">willkürlich in</hi> 9, 1 <hi rend="italic">und</hi> 10, 1</seg><seg type="translation" xml:lang="en" source="#claude">arbitrarily in 9, 1 and 10, 1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ICn_9-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">200</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Am Rande lies 10, 1.—Benutzt durch Hn 11, 3.—Auch in 10, 1 erhöht Schreiber A willkürlich die Strafsumme für Hinterziehung von Kirchenabgabe</seg><seg type="translation" xml:lang="en" source="#claude">In the margin read 10, 1. — Used by Hn 11, 3. — In 10, 1 too scribe A arbitrarily raises the penalty for withholding church dues</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="ICn_9-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">349</biblScope></bibl><seg type="original" xml:lang="en">Cf. Hn. 11, 3.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="ICn_9-1.robnote.n.2" n="2" source="#robertson"><bibl><biblScope unit="page">349</biblScope></bibl><seg type="original" xml:lang="en">Note that A reads 220 sh. here and in 10, 1.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="ICn_9-1.robnote.fn.4" n="4" source="#robertson"><bibl><biblScope unit="page">164</biblScope></bibl><label>xxx</label><seg type="original" xml:lang="en"><hi rend="italic">penega</hi> A; <hi rend="italic">pening</hi> Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="ICn_9-1.robnote.fn.5" n="5" source="#robertson"><bibl><biblScope unit="page">164</biblScope></bibl><label>cxx</label><seg type="original" xml:lang="en"><hi rend="italic">twa hundred</hi> ⁊ <hi rend="italic">twentig scill'</hi> A; 220 <hi rend="italic">scill.</hi> Ld.</seg></note>
      </div>
