        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 61.6" corresp="#wit-lat"><pb n="581" ed="#liebermann"/>Si quis forte causam habeat contra dominum suum, remanere potest<ptr type="liebermannNote" n="l" target="#Hn_61-6.lnote.oe.l"/><ptr type="liebermannNote" n="22" target="#Hn_61-6.lnote.oe.22"/> infirmitatis<ptr type="liebermannNote" n="m" target="#Hn_61-6.lnote.oe.m"/> uel legis<ptr type="liebermannNote" n="23" target="#Hn_61-6.lnote.oe.23"/> inoperacionis uel<ptr type="liebermannNote" n="n" target="#Hn_61-6.lnote.oe.n"/> [regis<ptr type="liebermannNote" n="24" target="#Hn_61-6.lnote.oe.24"/>] inplacitationis<ptr type="liebermannNote" n="25" target="#Hn_61-6.lnote.oe.25"/> exc[usation]ibus<ptr type="liebermannNote" n="26" target="#Hn_61-6.lnote.oe.26"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 581 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-6.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">581</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Verklagter</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">the defendant</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-6.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">581</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt</hi> 61, 7; <hi rend="italic">ähnlich</hi> 41, 2<hi rend="italic">b</hi>; 59, 1<hi rend="italic">a</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">repeated</hi> 61, 7; <hi rend="italic">similarly</hi> 41, 2<hi rend="italic">b</hi>; 59, 1<hi rend="italic">a</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_61-6.lnote.oe.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">581</biblScope></bibl><seg type="original" xml:lang="de">si submonitus in curia militis ad illum diem oportebit placitare in ducis curia, poterit se exoniare in curia domini; Très anc. cout. Norm. I 44, 1</seg><seg type="translation" xml:lang="en" source="#claude">si submonitus in curia militis ad illum diem oportebit placitare in ducis curia, poterit se exoniare in curia domini; Très anc. cout. Norm. I 44, 1</seg></note>
