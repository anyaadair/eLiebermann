      <div type="clause" n="8.3">
        <head><ref type="lawCode" target="law:Duel">Duel</ref> 8.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Duel 8.3" corresp="#wit-lat"><pb n="431" ed="#liebermann"/>Pręstet<ptr type="liebermannNote" n="55" target="#Duel_8-3.lnote.oe.55"/> tibi uictoriam trinus<ptr type="liebermannNote" n="56" target="#Duel_8-3.lnote.oe.56"/> et unus Deus, qui uiuit<ptr type="liebermannNote" n="57" target="#Duel_8-3.lnote.oe.57"/> et regnat per omnia secula<ptr type="liebermannNote" n="58" target="#Duel_8-3.lnote.oe.58"/> seculorum!<ptr type="liebermannNote" n="50" target="#Duel_8-3.lnote.oe.50"/> Amen<ptr type="liebermannNote" n="e" target="#Duel_8-3.lnote.oe.e"/><ptr type="liebermannNote" n="59" target="#Duel_8-3.lnote.oe.59"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 431 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_8-3.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">Deinde aspergat sacerdos eum aqua benedicta, et ita recedat in nomine Domini <hi rend="italic">fügt zu Sr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Deinde aspergat sacerdos eum aqua benedicta, et ita recedat in nomine Domini added in Sr.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_8-3.lnote.oe.50" n="50" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">R[espon.] <hi rend="italic">fügt zu Hm</hi></seg><seg type="translation" xml:lang="en" source="#claude">R[espon.] added in Hm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_8-3.lnote.oe.55" n="55" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">Pręstetque <hi rend="italic">Tr Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">Pręstetque Tr Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_8-3.lnote.oe.56" n="56" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">qui t. et un. D. u. <hi rend="italic">Tr Ym</hi></seg><seg type="translation" xml:lang="en" source="#claude">qui t. et un. D. u. Tr Ym</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_8-3.lnote.oe.57" n="57" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">ui. — seculorum <hi rend="italic">fehlt Hm</hi></seg><seg type="translation" xml:lang="en" source="#claude">ui. — seculorum missing in Hm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_8-3.lnote.oe.58" n="58" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de">s. s. <hi rend="italic">fehlt Mg</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. s. missing in Mg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Duel_8-3.lnote.oe.59" n="59" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">431</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">folgt</hi> Benedictio oculorum (infirmorum <hi rend="italic">Sr</hi>) <hi rend="italic">Sr Gl; folgt</hi> Ordo ad uisitandum infirmum <hi rend="italic">Hm; folgt</hi> Feria IV. in capite ieiunii, VI dicta, incipiat benediccio cinerum <hi rend="italic">Ta</hi></seg><seg type="translation" xml:lang="en" source="#claude">followed by Benedictio oculorum (infirmorum Sr) in Sr Gl; followed by Ordo ad uisitandum infirmum in Hm; followed by Feria IV. in capite ieiunii, VI dicta, incipiat benediccio cinerum in Ta</seg></note>
      </div>
