    <body>
      <div type="clause" n="58.1">
        <head><ref type="lawCode" target="law:IICn">II Cn</ref> 58.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="58.1" corresp="#wit-g-a"><pb n="350" ed="#liebermann"/>[G]if<ptr type="liebermannNote" n="4" target="#IICn_58-1.lnote.oe.4-2"/> hwa arcebisceopes<ptr type="liebermannNote" n="5" target="#IICn_58-1.lnote.oe.5-2"/> borh oððe æþelingces<ptr type="liebermannNote" n="6" target="#IICn_58-1.lnote.oe.6"/> abrece, gebete þ<hi rend="italic">æt</hi> mid þrim<ptr type="liebermannNote" n="7" target="#IICn_58-1.lnote.oe.7"/> pundan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="58.1" corresp="#wit-b"><pb n="350" ed="#liebermann"/>Gyf hwa ar[ce]bisceopes<ptr type="liebermannNote" n="2" target="#IICn_58-1.lnote.oe.2-2"/> borh brece oððe æðelinges, gebete þ<hi rend="italic">æt</hi> mid ðrym pundu<hi rend="italic">m</hi>.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="58.1" corresp="#wit-a"><pb n="350" ed="#liebermann"/>Gif hwa arcebiscopes borh oððe aðelinges abrece, gebete þ<hi rend="italic">æt</hi> mid þrym pundu<hi rend="italic">m</hi>.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="58.1" corresp="#wit-q"><pb n="351" ed="#liebermann"/>Si quis archiepiscopi uel comitis<ptr type="liebermannNote" n="2" target="#IICn_58-1.lnote.oe.2-3"/> (filii<ptr type="liebermannNote" n="3" target="#IICn_58-1.lnote.oe.3"/> regis) plegium<ptr type="liebermannNote" n="4" target="#IICn_58-1.lnote.oe.4"/> frangat, III libris<ptr type="liebermannNote" n="5" target="#IICn_58-1.lnote.oe.5"/> emendet.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="58.1" corresp="#wit-inst-cn"><pb n="351" ed="#liebermann"/>Et qui fregerit plegium<ptr type="liebermannNote" n="3" target="#IICn_58-1.lnote.oe.3-2"/> archiepiscopi aut reguli, quem Angli uocant æðeling, III<ptr type="liebermannNote" n="4" target="#IICn_58-1.lnote.oe.4-3"/> libr. emendet<ptr type="liebermannNote" n="5" target="#IICn_58-1.lnote.oe.5-3"/>;</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="58.1" corresp="#wit-cons-cn"><pb n="351" ed="#liebermann"/>[58, 1] qui autem archiepiscopi uel basilide, III libris;</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="58.1" corresp="#wit-b"><pb n="204" ed="#robertson"/>Gyf hwa arcebisceopes borh brece oððe æðelinges, gebete þæt mid ðrym pundum.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g-a"><pb n="284" ed="#rabin-doml"/>Gif hwa arcebisceopes borh oððe æþelingces abrece, gebete þæt mid þrim pundan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="350" ed="#liebermann"/>Wenn einer eines Erzbischofs oder eines königlichen Prinzen<ptr type="liebermannNote" n="1" target="#IICn_58-1.lnote.de.1"/> Schutzgewähr verletzt, büsse er das [diesem] mit 3 Pfund.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If anyone violates the protection of an archbishop or of a royal prince, let him atone for it [to him] with 3 pounds.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="205" ed="#robertson"/>If anyone violates the protection of an archbishop or of a member of the royal family<ptr type="editorNote" n="1" target="#IICn_58-1.robnote.n.1"/>, he shall pay £3 as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><ptr type="editorNote" n="5" target="#IICn_58-1.whinote.n.5"/><pb n="470" ed="#whitelock"/>If anyone violates the archbishop’s or the atheling’s surety, he is to compensate for it with three pounds.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-a"><pb n="285" ed="#rabin-doml"/>If anyone violates the protection of the archbishop or a nobleman, he shall be penalized three pounds.</ab>
        <note type="comparison" source="#liebermann" n="350"><ref target="clause:Af_3">Af 3</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd.</note>
        <note type="comparison" source="#whitelock" n="470"><label>cf.</label> <ref target="clause:Af_3">Af 3</ref> <quote>cf. Alfred 3, where, however, the atheling is not mentioned.</quote></note>
        <note type="editorial">BR: added from Gesetze I p. 351, October 2026 (MS Cons)</note>
        <note type="textual" source="#rabin-doml">Gif: if with space for the initial in G</note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_58-1.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de">58, 1; 2 <hi rend="italic">fehlt Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">58, 1; 2 lacking in Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_58-1.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">350</biblScope></bibl><seg type="original" xml:lang="de">ce <hi rend="italic">später übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">ce later written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_58-1.lnote.oe.2-3" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt THk</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in THk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_58-1.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de">f. r. <hi rend="italic">übergeschr. Dm; fehlt KR</hi></seg><seg type="translation" xml:lang="en" source="#claude">f. r. written above Dm; lacking in KR</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_58-1.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de">p. f. <hi rend="italic">fehlt K</hi></seg><seg type="translation" xml:lang="en" source="#claude">p. f. lacking in K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_58-1.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de">libras <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">libras K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_58-1.lnote.oe.4-2" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">350</biblScope></bibl><seg type="original" xml:lang="de">if, <hi rend="italic">davor Raum für</hi> [<hi rend="italic">farbige</hi>] <hi rend="italic">Initiale G</hi></seg><seg type="translation" xml:lang="en" source="#claude">if, with space before it for the [coloured] initial G</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_58-1.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">350</biblScope></bibl><seg type="original" xml:lang="de">-cop. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cop. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_58-1.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">350</biblScope></bibl><seg type="original" xml:lang="de">-ges <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ges Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_58-1.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">350</biblScope></bibl><seg type="original" xml:lang="de">ðrym pundum <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðrym pundum Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_58-1.lnote.oe.3-2" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">am Rande Cb;</hi> iuditium <hi rend="italic">Di</hi></seg><seg type="translation" xml:lang="en" source="#claude">in the margin Cb; iuditium Di</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_58-1.lnote.oe.4-3" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de">tribus libris <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">tribus libris H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IICn_58-1.lnote.oe.5-3" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IICn_58-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">210</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Ætheling 3—4. 7</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Ætheling 3—4. 7</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IICn_58-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">357</biblScope></bibl><seg type="original" xml:lang="en">In <hi rend="italic">Norðleoda laga</hi>, 2 the wergeld of an <hi rend="italic">æþeling</hi> is stated to be the same as that of an archbishop.</seg></note>
        <note type="editorNote" subtype="translationFootnote" xml:id="IICn_58-1.whinote.n.5" n="5" source="#whitelock"><bibl><biblScope unit="page">470</biblScope></bibl><label>58.1</label><seg type="original" xml:lang="en">cf. Alfred 3, where, however, the atheling is not mentioned.</seg></note>
      </div>
