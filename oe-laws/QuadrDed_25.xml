      <div type="clause" n="25">
        <head><ref type="lawCode" target="law:QuadrDed">Quadr Ded</ref> 25</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Ded 25" corresp="#wit-lat"><pb n="531" ed="#liebermann"/>Iniqui enim sunt et malo digni iudices qui de incognitis rebus iudicare festinant et personarum nomina magis qua[m<ptr type="liebermannNote" n="8" target="#QuadrDed_25.lnote.oe.8"/>] rerum merita prosecuntur, qui seueri censores et obiurgatores quorumlibet fiunt, priusquam utriusque partis negotia didicerint, et communiter uel partiliter electi<ptr type="liebermannNote" n="i" target="#QuadrDed_25.lnote.oe.i"/> sint siue constituti iudices super ill[o]s<ptr type="liebermannNote" n="k" target="#QuadrDed_25.lnote.oe.k"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 531 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_25.lnote.oe.i" n="i" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. Hn</hi> 5, 5</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf. Hn</hi> 5, 5</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_25.lnote.oe.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nämlich</hi> quoslibet; illas <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">namely</hi> quoslibet; illas <hi rend="italic">Dm</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_25.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">531</biblScope></bibl><seg type="original" xml:lang="de">qua <hi rend="italic">Dm</hi></seg><seg type="translation" xml:lang="en" source="#claude">qua <hi rend="italic">Dm</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="QuadrDed_25.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">311</biblScope></bibl><seg type="original" xml:lang="de">Juristisches Zitat; <hi rend="italic">vgl. Gl</hi> Gerechtigkeit 8; Urteilfinder 7. b. 18</seg><seg type="translation" xml:lang="en" source="#claude">A legal quotation; <hi rend="italic">cf. Gl</hi> Gerechtigkeit 8; Urteilfinder 7. b. 18</seg></note>
