      <div type="clause" n="80.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 80.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 80.3" corresp="#wit-lat"><pb n="596" ed="#liebermann"/>Tanta uero<ptr type="liebermannNote" n="11" target="#Hn_80-3.lnote.oe.11"/> debet esse<ptr type="liebermannNote" n="13" target="#Hn_80-3.lnote.oe.13"/>, ut inibi duo carri sibi possint<ptr type="liebermannNote" n="14" target="#Hn_80-3.lnote.oe.14"/> ad<ptr type="liebermannNote" n="15" target="#Hn_80-3.lnote.oe.15"/> inuicem obuiare, et<ptr type="liebermannNote" n="16" target="#Hn_80-3.lnote.oe.16"/> bubulci de longo stumbli<ptr type="liebermannNote" n="d" target="#Hn_80-3.lnote.oe.d"/> sui possint assimulare<ptr type="liebermannNote" n="17" target="#Hn_80-3.lnote.oe.17"/>, et XVI milites possint<ptr type="liebermannNote" n="18" target="#Hn_80-3.lnote.oe.18"/> equitare de latere, armati.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 596 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-3.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch sonst für</hi> stimuli [<hi rend="italic">das Wi Tho einsetzt</hi>] <hi rend="italic">DUCANGE; s. o.</hi> 78, 2<hi rend="italic">c</hi></seg><seg type="translation" xml:lang="en" source="#claude">also used elsewhere for stimuli [which Wi Tho substitute] DUCANGE; see above 78, 2c</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-3.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nicht in Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">not in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-3.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de">uia <hi rend="italic">ergänzt Co Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">uia supplied Co Wi Tho</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-3.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de">-sunt <hi rend="italic">Lond, wo</hi> ad — possint <hi rend="italic">übersprungen</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sunt Lond, where ad — possint is omitted</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-3.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de">ad i. <hi rend="italic">fehlt Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad i. missing Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-3.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Zahl?</hi></seg><seg type="translation" xml:lang="en" source="#claude">number missing?</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-3.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de">astimulare <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">astimulare K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-3.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">596</biblScope></bibl><seg type="original" xml:lang="de">e. p. a. de l. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">e. p. a. de l. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_80-3.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">327</biblScope></bibl><seg type="original" xml:lang="de">Über Messung der Strassenbreite nach Wagen, Reitern, quer gelegtem Spiesse Heyne <hi rend="italic">Nahrung</hi> 25. 140; Ritterstrassen im Gegensatz zur Hauptstrasse im Brit. Epos 12./13. Jhs. bei Windisch <hi rend="italic">Kelt. Britannien</hi> 163.—Am Rande spät: <hi rend="italic">Hic distinguit latitudinem et modum viarum regiarum, et ubi esse dicuntur</hi>.—<hi rend="italic">ad</hi>{15} bis <hi rend="italic">possint</hi> überspr.—<hi rend="italic">eq. po</hi>.{15} <hi rend="italic">ar. de la</hi>.—80, 3a <hi rend="italic">claudere</hi>{18}—<hi rend="italic">au. cum ramis s</hi>. Rs</seg><seg type="translation" xml:lang="en" source="#claude">On measuring the width of roads by wagons, riders, or a spear laid crosswise, Heyne <hi rend="italic">Nahrung</hi> 25. 140; knights’ roads in contrast to the main road in the British epic of the 12th/13th cent., in Windisch <hi rend="italic">Kelt. Britannien</hi> 163.—In the margin, in a late hand: <hi rend="italic">Hic distinguit latitudinem et modum viarum regiarum, et ubi esse dicuntur</hi>.—<hi rend="italic">ad</hi>{15} to <hi rend="italic">possint</hi> omitted—<hi rend="italic">eq. po</hi>.{15} <hi rend="italic">ar. de la</hi>.—80, 3a <hi rend="italic">claudere</hi>{18}—<hi rend="italic">au. cum ramis s</hi>. Rs</seg></note>
      </div>
