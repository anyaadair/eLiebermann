      <div type="clause" n="10.1">
        <head><ref type="lawCode" target="law:LibLond">Lib Lond</ref> 10.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Lib Lond 10.1" corresp="#wit-lat"><pb n="675" ed="#liebermann"/>nec<ptr type="liebermannNote" n="t" target="#LibLond_10-1.lnote.oe.t"/> ire debent in expeditione<ptr type="liebermannNote" n="36" target="#LibLond_10-1.lnote.oe.36"/> nauali uel<ptr type="liebermannNote" n="37" target="#LibLond_10-1.lnote.oe.37"/> terrestri<ptr type="liebermannNote" n="38" target="#LibLond_10-1.lnote.oe.38"/>, quia<ptr type="liebermannNote" n="39" target="#LibLond_10-1.lnote.oe.39"/> liberi et quieti sunt ab omni exercitu:</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 675 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10-1.lnote.oe.t" n="t" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">10, 1 <hi rend="italic">f. vielleicht Zusatz aus Londoner Ansprüchen unter Johann;</hi> 10, 2 <hi rend="italic">erinnert an</hi> Leges Angl. s. XIII. in. Lond. coll.; <hi rend="italic">vgl. dort S.</hi> 35. 62 <hi rend="italic">f.</hi>; Wl art. retr. 11. <hi rend="italic">Freiheit von</hi> expeditio <hi rend="italic">besassen Englische Städte nach Breteuils Muster; und Edward III. verbriefte den Londonern:</hi> quod non distringantur ad proficiscendum seu mittendum in guerram extra ciuitatem; <hi rend="italic">Bateson</hi> 712{28}</seg><seg type="translation" xml:lang="en" source="#claude">10, 1 f. perhaps an addition from London claims under John; 10, 2 recalls Leges Angl. s. XIII. in. Lond. coll.; cf. there pp. 35. 62 f.; Wl art. retr. 11. English towns on the model of Breteuil possessed freedom from expeditio; and Edward III granted the Londoners by charter: quod non distringantur ad proficiscendum seu mittendum in guerram extra ciuitatem; Bateson 712{28}</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10-1.lnote.oe.36" n="36" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">expeditacione <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">expeditacione Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10-1.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">neque <hi rend="italic">Alb</hi></seg><seg type="translation" xml:lang="en" source="#claude">neque Alb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10-1.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">tere. <hi rend="italic">Ai;</hi> terr’ <hi rend="italic">Horn</hi></seg><seg type="translation" xml:lang="en" source="#claude">tere. Ai; terr’ Horn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10-1.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">675</biblScope></bibl><seg type="original" xml:lang="de">quia — <hi rend="italic">Ende nur Ai Horn Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">quia — to the end only in Ai Horn Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LibLond_10-1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">351</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. Heer 3e; London 40. Beschränkung der staatlichen Wehrpflicht findet sich in manchem städtischen Freibrief; Ballard 90</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. Heer 3e; London 40. A restriction of the public obligation of military service is found in many a borough charter; Ballard 90</seg></note>
      </div>
