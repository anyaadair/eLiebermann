      <div type="clause" n="II Cn 20">
        <head>Quadr Rb II Cn 20</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Rb II Cn 20" corresp="#wit-lat"><pb n="536" ed="#liebermann"/>Ut omnis homo<ptr type="liebermannNote" n="75" target="#Quadr-Rb_II-Cn-20.lnote.la.75"/> liber sit in hundreto<ptr type="liebermannNote" n="82" target="#Quadr-Rb_II-Cn-20.lnote.la.82"/> et<ptr type="liebermannNote" n="83" target="#Quadr-Rb_II-Cn-20.lnote.la.83"/> decima;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 536 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">That every free man be in a hundred and a tithing;</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-20.lnote.la.75" n="75" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-20.lnote.la.82" n="82" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">-redo <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">-redo R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-20.lnote.la.83" n="83" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">in <hi rend="italic">fügt zu TR</hi></seg><seg type="translation" xml:lang="en" source="#claude">TR add in</seg></note>
      </div>
