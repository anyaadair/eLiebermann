    <body>
      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:IIEm">II Em</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-h"><pb n="186" ed="#liebermann"/>Gif hine þonne seo mægð forlete, ⁊ him foregyldan nellen, ðon<hi rend="italic">ne</hi> wille ic, ðæt eall seo mægð sy unfah, butan ðam handdædan, gif hy him syððan ne doð mete ne munde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-b"><pb n="186" ed="#liebermann"/>Gyf<ptr type="liebermannNote" n="14" target="#IIEm_1-1.lnote.oe.14"/> hine ðonne seo mægð<ptr type="liebermannNote" n="15" target="#IIEm_1-1.lnote.oe.15"/> forlæte, ⁊ him foregyldan<ptr type="liebermannNote" n="16" target="#IIEm_1-1.lnote.oe.16"/> nellen, ðon<hi rend="italic">ne</hi> wille ic, þ<hi rend="italic">æt</hi> eal<ptr type="liebermannNote" n="17" target="#IIEm_1-1.lnote.oe.17"/> seo mægð sy unfah, butan ðam<ptr type="liebermannNote" n="18" target="#IIEm_1-1.lnote.oe.18"/> handædan<ptr type="liebermannNote" n="19" target="#IIEm_1-1.lnote.oe.19"/>, gif<ptr type="liebermannNote" n="20" target="#IIEm_1-1.lnote.oe.20"/> hy him syððan ne doð mete ne munde.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.1" corresp="#wit-q"><pb n="187" ed="#liebermann"/>Si eum<ptr type="liebermannNote" n="11" target="#IIEm_1-1.lnote.oe.11"/> cognatio sua deserat et pro eo gildare nolit<ptr type="liebermannNote" n="12" target="#IIEm_1-1.lnote.oe.12"/>, tunc uolo, ut omnis tribus<ptr type="liebermannNote" n="13" target="#IIEm_1-1.lnote.oe.13"/> (uel cognatio) illa sit extra<ptr type="liebermannNote" n="14" target="#IIEm_1-1.lnote.oe.14-2"/> factionem<ptr type="liebermannNote" n="15" target="#IIEm_1-1.lnote.oe.15-2"/>, preter solum malefactorem<ptr type="liebermannNote" n="16" target="#IIEm_1-1.lnote.oe.16-2"/>, si<ptr type="liebermannNote" n="17" target="#IIEm_1-1.lnote.oe.17-2"/> deinceps ei nec uictum det nec pacem.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="1.1" corresp="#wit-b"><pb n="8" ed="#robertson"/>Gyf hine ðonne seo mægð forlæte ⁊ him foregyldan nellen, ðonne wille ic þæt eal seo mægð sy unfah, butan ðam hand[d]ædan<ptr type="editorNote" n="5" target="#IIEm_1-1.robnote.fn.5"/>, gif<ptr type="editorNote" n="6" target="#IIEm_1-1.robnote.fn.6"/> hy him syððan ne doð mete ne munde.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="187" ed="#liebermann"/>Wenn ihn aber die Sippe verlässt<ptr type="liebermannNote" n="1" target="#IIEm_1-1.lnote.de.1"/>, und [sie] zu seinen Gunsten nicht zahlen wollen, dann will ich, dass diese Sippe ganz, nur ausser dem wirklichen<ptr type="liebermannNote" n="2" target="#IIEm_1-1.lnote.de.2"/> Thäter, durch Rache unverfolgt bleibe; vorausgesetzt, sie gewähren ihm fernerhin weder Speise<ptr type="liebermannNote" n="3" target="#IIEm_1-1.lnote.de.3"/> noch Schutz.<ptr type="liebermannNote" n="4" target="#IIEm_1-1.lnote.de.4"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">But if the kindred abandons him and [they] will not pay on his behalf, then I will that this whole kindred, except only the actual perpetrator, remain free from vengeance, provided they give him neither food nor protection thereafter.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b"><pb n="9" ed="#robertson"/>If, however, his kindred abandon him and will not pay compensation on his behalf, it is my will that, if afterwards they give him neither food nor shelter<ptr type="editorNote" n="1" target="#IIEm_1-1.robnote.n.1"/>, all the kindred, except the delinquent, shall be free from vendetta.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="429" ed="#whitelock"/>If, however, the kindred abandons him, and is not willing to pay compensation for him, it is then my will that all that kindred is to be exempt from the feud, except the actual slayer, if they give him neither food nor protection afterwards.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-1.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">186</biblScope></bibl><seg type="original" xml:lang="de">Gif <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Gif Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-1.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">186</biblScope></bibl><seg type="original" xml:lang="de">-þe <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-þe Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-1.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">186</biblScope></bibl><seg type="original" xml:lang="de">forg. nyllon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">forg. nyllon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-1.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">186</biblScope></bibl><seg type="original" xml:lang="de">ealle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ealle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-1.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">186</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-1.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">186</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-1.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">186</biblScope></bibl><seg type="original" xml:lang="de">⁊ hi <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">⁊ hi Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-1.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">187</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">tunc</hi> <hi rend="italic">fügt Hn zu</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">tunc</hi> added by Hn</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-1.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">187</biblScope></bibl><seg type="original" xml:lang="de">noluit <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">noluit Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-1.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">187</biblScope></bibl><seg type="original" xml:lang="de">t. u. <hi rend="italic">fehlt Hn, wo</hi> i. c.</seg><seg type="translation" xml:lang="en" source="#claude">t. u. lacking in Hn, where i. c.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-1.lnote.oe.14-2" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">187</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">unfah</hi> <hi rend="italic">Hn statt</hi> e. f</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">unfah</hi> Hn instead of e. f</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-1.lnote.oe.15-2" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">187</biblScope></bibl><seg type="original" xml:lang="de">fra. <hi rend="italic">Hk</hi></seg><seg type="translation" xml:lang="en" source="#claude">fra. Hk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-1.lnote.oe.16-2" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">187</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verbessert aus</hi> melef. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected from melef. T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IIEm_1-1.lnote.oe.17-2" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">187</biblScope></bibl><seg type="original" xml:lang="de">sed <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">sed Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEm_1-1.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">127</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Dass der Kreis der der Blutrache (<hi rend="italic">s. d. Gl</hi> 5. e) Unterworfenen sogar über die Sippe hinaus reichte, bleibt in II Em unberücksichtigt.—Über die Entsippung <hi rend="italic">s. Gl</hi> Sippe 13a</seg><seg type="translation" xml:lang="en" source="#claude">That the circle of those subject to blood-feud (<hi rend="italic">see</hi> that word in <hi rend="italic">Gl</hi> 5. e) extended even beyond the kindred is left out of account in II Em.—On expulsion from the kindred see <hi rend="italic">Gl</hi> Sippe 13a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEm_1-1.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">127</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">= <hi rend="italic">rihthanddæda</hi> 1, 3</seg><seg type="translation" xml:lang="en" source="#claude">= <hi rend="italic">rihthanddæda</hi> 1, 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEm_1-1.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">127</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl</hi>. festländisch <hi rend="italic">metiban; Gl</hi> Begünstigung 1b</seg><seg type="translation" xml:lang="en" source="#claude">Cf. Continental <hi rend="italic">metiban; Gl</hi> Begünstigung 1b</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IIEm_1-1.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">127</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Q wählt für <hi rend="italic">mund</hi> unrichtig die nur da, wo sie vom König ausgeht, giltige Bed.</seg><seg type="translation" xml:lang="en" source="#claude">For <hi rend="italic">mund</hi> Q wrongly chooses the meaning that is valid only where it proceeds from the king</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IIEm_1-1.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">296</biblScope></bibl><seg type="original" xml:lang="en">Liebermann compares with this phrase the continental <hi rend="italic">meziban</hi>, see Brunner, <hi rend="smallcaps">ii</hi>. p. 465¹⁷.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIEm_1-1.robnote.fn.5" n="5" source="#robertson"><bibl><biblScope unit="page">8</biblScope></bibl><label>hand[d]ædan</label><seg type="original" xml:lang="en">H; <hi rend="italic">handædan</hi> B, Ld.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IIEm_1-1.robnote.fn.6" n="6" source="#robertson"><bibl><biblScope unit="page">8</biblScope></bibl><label>gif</label><seg type="original" xml:lang="en">⁊ <hi rend="italic">hi</hi> Ld.</seg></note>
      </div>
