      <div type="clause" n="90.6b">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 90.6b</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 90.6b" corresp="#wit-lat"><pb n="606" ed="#liebermann"/>Distancia uero sit, si quis eum<ptr type="liebermannNote" n="3" target="#Hn_90-6b.lnote.oe.3"/> ad opus suum rogauerit<ptr type="liebermannNote" n="a" target="#Hn_90-6b.lnote.oe.a"/>, et si sponte aduenerit; et item si ad precium, uel gratiam<ptr type="liebermannNote" n="aa" target="#Hn_90-6b.lnote.oe.aa"/> operetur; et si quis casu decidat, uel ab aliquo deiciatur; differt etiam, si commune sit opus eorum domini, uel commune<ptr type="liebermannNote" n="b" target="#Hn_90-6b.lnote.oe.b"/> operancium, uel alicuius proprium.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 606 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-6b.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 88, 9</seg><seg type="translation" xml:lang="en" source="#claude">cf. 88, 9</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-6b.lnote.oe.aa" n="aa" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de">ad gratiam = gratis</seg><seg type="translation" xml:lang="en" source="#claude">ad gratiam = gratis</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-6b.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 90, 6</seg><seg type="translation" xml:lang="en" source="#claude">cf. 90, 6</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_90-6b.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">606</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
      </div>
