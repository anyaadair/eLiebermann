    <body>
      <div type="clause" n="56">
        <head><ref type="lawCode" target="law:Af">Af</ref> 56</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="56" corresp="#wit-e"><pb n="82" ed="#liebermann"/>Gif se ðuma bið ófaslægen<ptr type="liebermannNote" n="7" target="#Af_56.lnote.oe.7"/>, þa<hi rend="italic">m<ptr type="liebermannNote" n="8" target="#Af_56.lnote.oe.8"/></hi> sceal XXX scill. to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="56" corresp="#wit-h"><pb n="82" ed="#liebermann"/>Gif se þuma bið ofaslægen, þæm<ptr type="liebermannNote" n="6" target="#Af_56.lnote.oe.6"/> sceal<ptr type="liebermannNote" n="7" target="#Af_56.lnote.oe.7-2"/> XXX scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="56" corresp="#wit-b-no-prol"><pb n="82" ed="#liebermann"/>Gyf ðe ðuma bið ofaslagen, ðæm sceall ðrittig scill' to bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="56" corresp="#wit-q"><pb n="83" ed="#liebermann"/>Si pollex manus amputetur, homini<ptr type="liebermannNote" n="5" target="#Af_56.lnote.oe.5"/> XXX solid. emendetur.<ptr type="liebermannNote" n="6" target="#Af_56.lnote.oe.6-2"/></ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="88" ed="#attenborough"/>Gif se<ptr type="editorNote" n="4" target="#Af_56.attnote.fn.4"/> ðuma bið ófaslægen, þam sceal XXX scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="59" corresp="#wit-e"><pb n="354" ed="#jurasinski-and-oliver"/>Gif se ðuma bið ófaslægen, þa<hi rend="italic">m</hi> sceal XXX scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="83" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_56.lnote.de.1"/> der<ptr type="liebermannNote" n="2" target="#Af_56.lnote.de.2"/> Daumen<ptr type="liebermannNote" n="3" target="#Af_56.lnote.de.3"/> abgeschlagen ist: dafür<ptr type="liebermannNote" n="4" target="#Af_56.lnote.de.4"/> gehört 30 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the thumb is struck off: 30 shillings are due for it as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="89" ed="#attenborough"/>If the thumb is struck off, 30 shillings must be paid as compensation for it.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="355" ed="#jurasinski-and-oliver"/>If the thumb is struck off, for that 30 shillings shall be the compensation.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_56.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">ofaslagen <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ofaslagen Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_56.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">ðæm <hi rend="spaced">sculon</hi> <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ðæm <hi rend="italic">sculon</hi> Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_56.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">æ <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">æ on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_56.lnote.oe.7-2" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> sceal</seg><seg type="translation" xml:lang="en" source="#claude">altered to sceal</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_56.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_56.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">-ndabitur <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ndabitur T</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_56.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Daumen</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Daumen</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_56.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">B modernisiert</seg><seg type="translation" xml:lang="en" source="#claude">B modernises</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_56.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Beeinflusst durch Abt 54, aber nicht in den Zahlen</seg><seg type="translation" xml:lang="en" source="#claude">Influenced by Abt 54, but not in the figures</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_56.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘dem [Verwundeten]’ missversteht Q spät. Rez.</seg><seg type="translation" xml:lang="en" source="#claude">‘to the [wounded man]’ Q later rec. misunderstands</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_56.attnote.fn.4" n="4" source="#attenborough"><bibl><biblScope unit="page">88</biblScope></bibl><label>se</label><seg type="original" xml:lang="en"><hi rend="italic">ðe</hi>. B.</seg></note>
      </div>
    </body>
  </text>
