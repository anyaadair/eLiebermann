        <note type="liebermannNote" subtype="textual" xml:id="Ine_4.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">91</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> feowertig <hi rend="italic">aus Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">read feowertig from Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_4.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">91</biblScope></bibl><seg type="original" xml:lang="de">Kirksceattas <hi rend="italic">Co Or;</hi> ciricsceatta <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">Kirksceattas Co Or; ciricsceatta the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_4.lnote.oe.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">91</biblScope></bibl><seg type="original" xml:lang="de">ad festum <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad festum Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_4.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">91</biblScope></bibl><seg type="original" xml:lang="de">homo <hi rend="italic">K</hi></seg><seg type="translation" xml:lang="en" source="#claude">homo K</seg></note>
