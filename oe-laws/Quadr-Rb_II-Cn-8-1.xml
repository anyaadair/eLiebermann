      <div type="clause" n="II Cn 8.1">
        <head>Quadr Rb II Cn 8.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Quadr Rb II Cn 8.1" corresp="#wit-lat"><pb n="536" ed="#liebermann"/><ptr type="liebermannNote" n="56" target="#Quadr-Rb_II-Cn-8-1.lnote.la.56"/>De falsariis <ptr type="liebermannNote" n="††" target="#Quadr-Rb_II-Cn-8-1.lnote.la.dagger2"/>(et<ptr type="liebermannNote" n="57" target="#Quadr-Rb_II-Cn-8-1.lnote.la.57"/> eorum manutentoribus).</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 536 (two independent readings of the page images, differences settled against the page)</note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-lat">Of forgers (and those who harbour them).</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-8-1.lnote.la.56" n="56" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zu</hi> 8, 2 <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">at 8, 2 R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-8-1.lnote.la.dagger2" n="††" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">(<hi rend="italic">Eingeklammertes</hi>) <hi rend="italic">entstammt letzter Recension</hi></seg><seg type="translation" xml:lang="en" source="#claude">(What is in brackets) comes from the last recension</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Quadr-Rb_II-Cn-8-1.lnote.la.57" n="57" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">536</biblScope></bibl><seg type="original" xml:lang="de">et e. m. <hi rend="italic">nur aus HkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">et e. m. only from HkBr</seg></note>
      </div>
