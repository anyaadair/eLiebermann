        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Duel 2.1" corresp="#wit-lat"><pb n="430" ed="#liebermann"/>ut hoc<ptr type="liebermannNote" n="53" target="#Duel_2-1.lnote.oe.53"/> scutum atque baculum istum dextera potentię<ptr type="liebermannNote" n="54" target="#Duel_2-1.lnote.oe.54"/> tuę bene+dicere digneris, ut sint arma inuincibilia atque, triumphali potentia tua adminiculante<ptr type="liebermannNote" n="55" target="#Duel_2-1.lnote.oe.55"/>, uictricia;</ab>
