      <div type="clause" n="46.5">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 46.5</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 46.5" corresp="#wit-lat"><pb n="570" ed="#liebermann"/>Bonum autem est, ut cum<ptr type="liebermannNote" n="x" target="#Hn_46-5.lnote.oe.x"/> alicuius consilium<ptr type="liebermannNote" n="30" target="#Hn_46-5.lnote.oe.30"/> in<ptr type="liebermannNote" n="31" target="#Hn_46-5.lnote.oe.31"/> placito redditur, cum emendacione<ptr type="liebermannNote" n="32" target="#Hn_46-5.lnote.oe.32"/> dicendum predicatur: ut, si forte perorator uel superadiecerit aliquid<ptr type="liebermannNote" n="33" target="#Hn_46-5.lnote.oe.33"/> uel omiserit<ptr type="liebermannNote" n="34" target="#Hn_46-5.lnote.oe.34"/>, emendare<ptr type="liebermannNote" n="35" target="#Hn_46-5.lnote.oe.35"/> liceat<ptr type="liebermannNote" n="y" target="#Hn_46-5.lnote.oe.y"/> ei.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 570 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-5.lnote.oe.x" n="x" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">indem der Beschluss (<hi rend="italic">des Freundesraths; vgl. Brunner</hi> Forsch. 354) im Process (<hi rend="italic">durch den Vorsprech</hi>) abgegeben wird, werde vorbehalten, dass er ‘mit Wortbesserung’ gesagt werden dürfe: damit (nämlich), wenn etwa der Vorsprech</seg><seg type="translation" xml:lang="en" source="#claude">in that, when the decision (of the council of friends; cf. Brunner Forsch. 354) is delivered in the proceedings (by the spokesman), it should be reserved that it may be spoken ‘with amendment of words’: so that (namely), if perhaps the spokesman</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-5.lnote.oe.y" n="y" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">der den Vorsprech beauftragenden Partei</seg><seg type="translation" xml:lang="en" source="#claude">of the party instructing the spokesman</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-5.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-5.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">alic. inplacitatio reddatur <hi rend="italic">ohne Hss., Wi</hi></seg><seg type="translation" xml:lang="en" source="#claude">alic. inplacitatio reddatur without MSS, Wi</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-5.lnote.oe.32" n="32" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">-nem <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nem Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-5.lnote.oe.33" n="33" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">-quis <hi rend="italic">Co Or;</hi> -quo <hi rend="italic">Wh</hi></seg><seg type="translation" xml:lang="en" source="#claude">-quis Co Or; -quo Wh</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-5.lnote.oe.34" n="34" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">emi. <hi rend="italic">Co;</hi> emers. <hi rend="italic">Ko Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">emi. Co; emers. Ko Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-5.lnote.oe.35" n="35" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">570</biblScope></bibl><seg type="original" xml:lang="de">-ri <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ri Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_46-5.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. Gl</hi> Missesprechen 3b; Vorsprech 3a; <hi rend="italic">vgl</hi>. Pol Mai I 199—<hi rend="italic">-ri</hi>{35}—46, 6 <hi rend="italic">et</hi>{3} <hi rend="italic">in o. a</hi>. fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See Gl</hi> Missesprechen 3b; Vorsprech 3a; <hi rend="italic">cf</hi>. Pol Mai I 199—<hi rend="italic">-ri</hi>{35}—46, 6 <hi rend="italic">et</hi>{3} <hi rend="italic">in o. a</hi>. lacking Rs</seg></note>
      </div>
