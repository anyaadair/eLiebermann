          <sense n="2">[<hi rend="italic">Ort</hi>] <hi rend="italic">‘<ref type="abbreviation" target="gram:von"><abbr>von</abbr></ref> .. weg’:</hi> fordrife þy botle <ref type="lawCode" target="law:Ine">Ine</ref> 68</sense>
