    <body>
      <div type="clause" n="2.4">
        <head><ref type="lawCode" target="law:IVAtr">IV Atr</ref> 2.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2.4" corresp="#wit-q"><pb n="232" ed="#liebermann"/>Qui ad pontem uenisset<ptr type="liebermannNote" n="18" target="#IVAtr_2-4.lnote.oe.18"/> cum uno<ptr type="liebermannNote" n="17" target="#IVAtr_2-4.lnote.oe.17"/> bato, ubi<ptr type="liebermannNote" n="19" target="#IVAtr_2-4.lnote.oe.19"/> piscis inesset<ptr type="liebermannNote" n="20" target="#IVAtr_2-4.lnote.oe.20"/>, ipse mango<ptr type="liebermannNote" n="21" target="#IVAtr_2-4.lnote.oe.21"/> unum obolum dabat<ptr type="liebermannNote" n="22" target="#IVAtr_2-4.lnote.oe.22"/> in telon., et de una<ptr type="liebermannNote" n="17" target="#IVAtr_2-4.lnote.oe.17"/> maiori naue unum d.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="2.4" corresp="#wit-q"><pb n="72" ed="#robertson"/>Qui ad pontem venisset<ptr type="editorNote" n="1" target="#IVAtr_2-4.robnote.fn.1"/> cum uno<ptr type="editorNote" n="2" target="#IVAtr_2-4.robnote.fn.2"/> bato ubi piscis inesset<ptr type="editorNote" n="3" target="#IVAtr_2-4.robnote.fn.3"/>, ipse mango<ptr type="editorNote" n="4" target="#IVAtr_2-4.robnote.fn.4"/> unum obolum dabat<ptr type="editorNote" n="5" target="#IVAtr_2-4.robnote.fn.5"/> in telon., et de una<ptr type="editorNote" n="2" target="#IVAtr_2-4.robnote.fn.2"/> maiori nave unum d.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="233" ed="#liebermann"/>Wer zur [London-]Bridge<ptr type="liebermannNote" n="1" target="#IVAtr_2-4.lnote.de.1"/> mit einem Boot<ptr type="liebermannNote" n="2" target="#IVAtr_2-4.lnote.de.2"/> kam, wo Fisch darin war: zahlte dieser Händler<ptr type="liebermannNote" n="3" target="#IVAtr_2-4.lnote.de.3"/> ½ Pfennig als Zoll, und von einem grösseren Schiffe 1 Pfennig.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Whoever came to [London] Bridge with a boat with fish in it: that trader paid ½ penny as toll, and for a larger ship 1 penny.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q"><pb n="73" ed="#robertson"/>A merchant who came to the bridge<ptr type="editorNote" n="1" target="#IVAtr_2-4.robnote.n.1"/> with a boat containing fish paid 1 half-penny as toll, and for a larger ship 1 penny.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_2-4.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">232</biblScope></bibl><seg type="original" xml:lang="de">ueniat <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">ueniat Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_2-4.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">232</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt MHkBr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in MHkBr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_2-4.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">232</biblScope></bibl><seg type="original" xml:lang="de">unus <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">unus T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_2-4.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">232</biblScope></bibl><seg type="original" xml:lang="de">inest, unus obolus dabatur <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">inest, unus obolus dabatur Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_2-4.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">232</biblScope></bibl><seg type="original" xml:lang="de">magno <hi rend="italic">MHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">magno MHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAtr_2-4.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">232</biblScope></bibl><seg type="original" xml:lang="de">dabit <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">dabit R</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_2-4.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">163</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> London 30</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> London 30</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_2-4.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">163</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Agsächs. <hi rend="italic">bat</hi></seg><seg type="translation" xml:lang="en" source="#claude">Anglo-Saxon <hi rend="italic">bat</hi></seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="IVAtr_2-4.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">163</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">mercator</hi> hätte Q gesagt, wenn er nicht Agsächs. <hi rend="italic">mangere</hi> vor sich gesehen hätte.—Das <hi rend="italic">una</hi> nächster Zeile übs. den unbestimmten Artikel <hi rend="italic">anre</hi>, der Agsächs. noch selten vorkommt; <hi rend="italic">s. Wb an</hi> 6</seg><seg type="translation" xml:lang="en" source="#claude">Q would have said <hi rend="italic">mercator</hi> if he had not seen Anglo-Saxon <hi rend="italic">mangere</hi> before him.—The <hi rend="italic">una</hi> of the next line translates the indefinite article <hi rend="italic">anre</hi>, which still occurs only rarely in Anglo-Saxon; <hi rend="italic">see Wb an</hi> 6</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAtr_2-4.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">323</biblScope></bibl><seg type="original" xml:lang="en">Old London Bridge which crossed the river to the east of the present bridge has been proved by discoveries of Roman coins, tiles and pottery to be of Roman origin (see Lethaby, <hi rend="italic">op. cit.</hi> p. 70 f.). It is mentioned in a document of about 970 in connection with a woman who was drowned there for practising pin-sticking witchcraft (see Kemble, 591; Birch, 1131). An interesting description of the bridge as it was about 1014 is found in the <hi rend="italic">Heimskringla</hi> (<hi rend="italic">Saga of Olaf the Holy</hi>, Ch. 11).</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_2-4.robnote.fn.1" n="1" source="#robertson"><bibl><biblScope unit="page">72</biblScope></bibl><label>venisset</label><seg type="original" xml:lang="en"><hi rend="italic">veniat</hi> Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_2-4.robnote.fn.2" n="2" source="#robertson"><bibl><biblScope unit="page">72</biblScope></bibl><label>uno</label><seg type="original" xml:lang="en">Om. M, Hk, Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_2-4.robnote.fn.3" n="3" source="#robertson"><bibl><biblScope unit="page">72</biblScope></bibl><label>inesset</label><seg type="original" xml:lang="en"><hi rend="italic">inest, unus ob. dabatur</hi> Br.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_2-4.robnote.fn.4" n="4" source="#robertson"><bibl><biblScope unit="page">72</biblScope></bibl><label>mango</label><seg type="original" xml:lang="en"><hi rend="italic">magno</hi> M, Hk.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAtr_2-4.robnote.fn.5" n="5" source="#robertson"><bibl><biblScope unit="page">72</biblScope></bibl><label>dabat</label><seg type="original" xml:lang="en"><hi rend="italic">dabit</hi> R.</seg></note>
      </div>
