      <div type="clause" n="82.6">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 82.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 82.6" corresp="#wit-lat"><pb n="599" ed="#liebermann"/>Et in quibusdam potest dominus homini suo warantus<ptr type="liebermannNote" n="d" target="#Hn_82-6.lnote.oe.d"/> esse, si precepto suo uerberauerit uel alio modo constrictauerit<ptr type="liebermannNote" n="10" target="#Hn_82-6.lnote.oe.10"/> aliquem, qui pertineat uel<ptr type="liebermannNote" n="11" target="#Hn_82-6.lnote.oe.11"/> non pertineat ad eum; in quibusdam uero non poterit.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 599 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-6.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">wiederholt</hi> 85, 2; <hi rend="italic">vgl.</hi> 43, 1. 82, 3</seg><seg type="translation" xml:lang="en" source="#claude">repeated 85, 2; cf. 43, 1. 82, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-6.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Sc Hg</hi>; contrista. <hi rend="italic">übrige</hi>; contrecta. <hi rend="italic">Wh Wi ohne Hss.</hi></seg><seg type="translation" xml:lang="en" source="#claude">so Sc Hg; contrista. the rest; contrecta. Wh Wi without MS authority</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_82-6.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">599</biblScope></bibl><seg type="original" xml:lang="de">u. n. p. <hi rend="italic">überspringt Co Or Gi</hi></seg><seg type="translation" xml:lang="en" source="#claude">Co Or Gi omit u. n. p.</seg></note>
      </div>
