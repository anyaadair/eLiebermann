        <head><ref type="lawCode" target="law:Hn">Hn</ref> 28.4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 28.4" corresp="#wit-lat"><pb n="562" ed="#liebermann"/>Et ipsi coagentes frequenter<ptr type="liebermannNote" n="o" target="#Hn_28-4.lnote.oe.o"/> interrogandi sunt, an amplius aliquid<ptr type="liebermannNote" n="41" target="#Hn_28-4.lnote.oe.41"/> dicere uelint an inde iudicari: quia multa per subrepcionem eueniunt.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 562 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_28-4.lnote.oe.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch Angilram</hi> 763; <hi rend="italic">Ivo</hi> Decr. VI 317; <hi rend="italic">wiederholt</hi> 49, 4<hi rend="italic">a</hi>; <hi rend="italic">vgl.</hi> 49, 3<hi rend="italic">b</hi></seg><seg type="translation" xml:lang="en" source="#claude">also Angilram 763; Ivo Decr. VI 317; repeated at 49, 4<hi rend="italic">a</hi>; <hi rend="italic">cf.</hi> 49, 3<hi rend="italic">b</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_28-4.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">562</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">missing in Sc Hg</seg></note>
