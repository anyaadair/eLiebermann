    <body>
      <div type="clause" n="38">
        <head>Ine Rb 38</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="38" corresp="#wit-e"><pb n="22" ed="#liebermann"/>LXXXII. Be þon ðe ryhtgesamhiwan<ptr type="liebermannNote" n="16" target="#Rubrics-Ine_38.lnote.oe.16"/> bearn hæbben<ptr type="liebermannNote" n="17" target="#Rubrics-Ine_38.lnote.oe.17"/>, ⁊ þon<hi rend="italic">ne</hi> se wer gewite.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="38" corresp="#wit-g-prol"><pb n="22" ed="#liebermann"/>LXXXII. Be ðan þe rihtgesamhiwon<ptr type="liebermannNote" n="4" target="#Rubrics-Ine_38.lnote.oe.4"/> bearn habben, ⁊ ðonne se wer gewite.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="38" corresp="#wit-h"><pb n="23" ed="#liebermann"/>LXXXII. Be ðon<ptr type="liebermannNote" n="24" target="#Rubrics-Ine_38.lnote.oe.24"/> ðe rihtgesamhiwan bearn habban<ptr type="liebermannNote" n="25" target="#Rubrics-Ine_38.lnote.oe.25"/> ond<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_38.lnote.oe.2"/> ðonne se wer gewite.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="38" corresp="#wit-q"><pb n="23" ed="#liebermann"/>Si<ptr type="liebermannNote" n="30" target="#Rubrics-Ine_38.lnote.oe.30"/> recte contubernales puerum habeant, et uir moriatur.<ptr type="liebermannNote" n="31" target="#Rubrics-Ine_38.lnote.oe.31"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="208" ed="#jurasinski-and-oliver"/>LXXXII Be þon ðe ryhtgesamhiwan bearn hæbben, þonne se wer gewite</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="208" ed="#jurasinski-and-oliver"/>Be ðam ðe rihtgesamhiwan bearn habban</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="23" ed="#liebermann"/>Darüber, dass rechtmässige Ehegatten Nachkommenschaft haben, und dann der Mann stirbt.<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_38.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning lawful spouses having offspring, and then the husband dying.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="209" ed="#jurasinski-and-oliver"/>Concerning those rightfully married who have a child, and then the husband departs</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="209" ed="#jurasinski-and-oliver"/>Concerning those rightfully married who have a child</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_38.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de">t <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">t written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_38.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="spaced">rihtgehiwan</hi> <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">rihtgehiwan</hi> Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_38.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de">-ban <hi rend="italic">ohne</hi> ⁊ — gewite <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ban without ⁊ — gewite Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_38.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">De femina que per ceorlum puerum habeat, et ipse abeat <hi rend="italic">Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">De femina que per ceorlum puerum habeat, et ipse abeat Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_38.lnote.oe.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">abeat <hi rend="italic">Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">abeat Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_38.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd.</hi> ðam</seg><seg type="translation" xml:lang="en" source="#claude">altered ðam</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_38.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">erstes</hi> a <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">first a on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_38.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_38.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Im Q schöpft zwar Br aus seinem Text; dagegen <hi rend="italic">abeat</hi>, obwohl nur in spät. Rez., scheint aus <hi rend="italic">gewite</hi> zu wörtliche, früheste Übs. und <hi rend="italic">moriatur</hi> Besserung</seg><seg type="translation" xml:lang="en" source="#claude">In Q, Br does indeed draw on its own text; on the other hand <hi rend="italic">abeat</hi>, although only in the later recension, appears to be the earliest, too literal, translation of <hi rend="italic">gewite</hi>, and <hi rend="italic">moriatur</hi> a correction</seg></note>
      </div>
    </body>
  </text>
