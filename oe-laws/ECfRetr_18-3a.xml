      <div type="clause" n="18.3a">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 18.3a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 18.3a"><pb n="644" ed="#liebermann"/>Et si quis eos<ptr type="liebermannNote" n="26" target="#ECfRetr_18-3a.lnote.la.26"/> <hi rend="bold">gratis</hi><ptr type="liebermannNote" n="27" target="#ECfRetr_18-3a.lnote.la.27"/> detinuerit pro una nocte <hi rend="bold">sola,</hi> maiori<ptr type="liebermannNote" n="28" target="#ECfRetr_18-3a.lnote.la.28"/> lege Anglorum uel Danorum<ptr type="liebermannNote" n="29" target="#ECfRetr_18-3a.lnote.la.29"/> emendabit<ptr type="liebermannNote" n="2" target="#ECfRetr_18-3a.lnote.la.2"/>, pro secunda duplici<ptr type="liebermannNote" n="30" target="#ECfRetr_18-3a.lnote.la.30"/>; pro tertia nocte<ptr type="liebermannNote" n="2" target="#ECfRetr_18-3a.lnote.la.2"/> socius est<ptr type="liebermannNote" n="31" target="#ECfRetr_18-3a.lnote.la.31"/> et compar malefactorum <hi rend="bold">iudicabitur.</hi></ab>
        <note type="comparison" source="#liebermann" n="644"><label>printed alongside</label> <ref target="clause:ECf_18-3a">ECf 18.3a</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 644 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-3a.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">g. eum <hi rend="italic">Hv;</hi> g. e. <hi rend="italic">Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">g. eum Hv; g. e. Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-3a.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">d. g. p. u. s. n. <hi rend="italic">Cb</hi></seg><seg type="translation" xml:lang="en" source="#claude">d. g. p. u. s. n. Cb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-3a.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">-re <hi rend="italic">Hv Va K</hi></seg><seg type="translation" xml:lang="en" source="#claude">-re Hv Va K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-3a.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">Danao. <hi rend="italic">Lb</hi></seg><seg type="translation" xml:lang="en" source="#claude">Danao. Lb</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-3a.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-3a.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">-citer <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">-citer Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_18-3a.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">644</biblScope></bibl><seg type="original" xml:lang="de">erit <hi rend="italic">Lb Va Ph; fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">erit Lb Va Ph; lacking in Hv</seg></note>
