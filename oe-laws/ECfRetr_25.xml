      <div type="clause" n="25">
        <head><ref type="lawCode" target="law:ECfRetr">ECf retr</ref> 25</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf retr 25"><pb n="650" ed="#liebermann"/><hi rend="bold"><hi rend="spaced">De Iudeis (in</hi></hi><ptr type="liebermannNote" n="8" target="#ECfRetr_25.lnote.la.8"/> <hi rend="bold"><hi rend="spaced">regno constitutis).</hi></hi> Sciendum est<ptr type="liebermannNote" n="9" target="#ECfRetr_25.lnote.la.9"/> <hi rend="bold">quoque,</hi> quod omnes Iudei, <hi rend="bold">ubi</hi>cunque <hi rend="bold">in</hi> regno sint<ptr type="liebermannNote" n="10" target="#ECfRetr_25.lnote.la.10"/>, sub tutela et defensione<ptr type="liebermannNote" n="11" target="#ECfRetr_25.lnote.la.11"/> regis<ptr type="liebermannNote" n="12" target="#ECfRetr_25.lnote.la.12"/> ligie<ptr type="liebermannNote" n="13" target="#ECfRetr_25.lnote.la.13"/> debent esse; nec qui<hi rend="bold">libet</hi><ptr type="liebermannNote" n="14" target="#ECfRetr_25.lnote.la.14"/> eorum<ptr type="liebermannNote" n="15" target="#ECfRetr_25.lnote.la.15"/> alicui diuiti se potest subdere sine licentia<ptr type="liebermannNote" n="16" target="#ECfRetr_25.lnote.la.16"/> regis; Iudei <hi rend="bold">enim</hi><ptr type="liebermannNote" n="2" target="#ECfRetr_25.lnote.la.2"/> et omnia sua regis sunt.</ab>
        <note type="comparison" source="#liebermann" n="650"><label>printed alongside</label> <ref target="clause:ECf_25">ECf 25</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 650 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page; the words in bold are the Retractator’s changes to ECf, as Liebermann prints them.</note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_25.lnote.la.8" n="8" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">in r. c. <hi rend="italic">aus Lb Va Hv; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">in r. c. from Lb Va Hv; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_25.lnote.la.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Cb Sp K</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Cb Sp K</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_25.lnote.la.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">sunt <hi rend="italic">Sp</hi></seg><seg type="translation" xml:lang="en" source="#claude">sunt Sp</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_25.lnote.la.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">domini <hi rend="italic">fügt zu Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">Hv adds domini</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_25.lnote.la.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">legis regia <hi rend="italic">Va</hi></seg><seg type="translation" xml:lang="en" source="#claude">legis regia Va</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_25.lnote.la.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so K;</hi> ligea <hi rend="italic">Sp; fehlt Hv;</hi> legie <hi rend="italic">Ph</hi></seg><seg type="translation" xml:lang="en" source="#claude">so K; ligea Sp; lacking in Hv; legie Ph</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_25.lnote.la.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">quisl. <hi rend="italic">Cb Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">quisl. Cb Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_25.lnote.la.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">illorum <hi rend="italic">Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">illorum Hv</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_25.lnote.la.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de">r. l. <hi rend="italic">Cb Hv Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">r. l. Cb Hv Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_25.lnote.la.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">650</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hv</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hv</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin">Concerning the Jews (established in the kingdom). It is also to be known that all Jews, wherever in the kingdom they may be, ought to be under the liege guardianship and protection of the king; nor can any of them subject himself to any rich man without the king's licence; for the Jews and all that is theirs are the king's.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="ECfRetr_25.lnote.oe.erkl-rs" n="Rs" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">347</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">in</hi><hi rend="superscript">8</hi> <hi rend="italic">r. c.</hi> fehlt — <hi rend="italic">est</hi><hi rend="superscript">9</hi> fehlt — <hi rend="italic">quisl.</hi><hi rend="superscript">14</hi> — <hi rend="italic">r. l.</hi><hi rend="superscript">16</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">in</hi><hi rend="superscript">8</hi> <hi rend="italic">r. c.</hi> lacking — <hi rend="italic">est</hi><hi rend="superscript">9</hi> lacking — <hi rend="italic">quisl.</hi><hi rend="superscript">14</hi> — <hi rend="italic">r. l.</hi><hi rend="superscript">16</hi> Rs</seg></note>
      </div>
    </body>
