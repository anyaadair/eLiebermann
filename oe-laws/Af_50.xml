    <body>
      <div type="clause" n="50">
        <head><ref type="lawCode" target="law:Af">Af</ref> 50</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="50" corresp="#wit-e"><pb n="80" ed="#liebermann"/>Gif<ptr type="liebermannNote" n="21" target="#Af_50.lnote.oe.21"/> monnes ceacan<ptr type="liebermannNote" n="22" target="#Af_50.lnote.oe.22"/> mon forslihð, þæt hie<ptr type="liebermannNote" n="23" target="#Af_50.lnote.oe.23"/> beoð forode, gebete<ptr type="liebermannNote" n="24" target="#Af_50.lnote.oe.24"/> mid XV scill.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="50" corresp="#wit-h"><pb n="80" ed="#liebermann"/>Gif monnes<ptr type="liebermannNote" n="4" target="#Af_50.lnote.oe.4"/> ceacan mon<ptr type="liebermannNote" n="4" target="#Af_50.lnote.oe.4"/> forslyhð<ptr type="liebermannNote" n="1" target="#Af_50.lnote.oe.1"/>, ðæt hy<ptr type="liebermannNote" n="1" target="#Af_50.lnote.oe.1"/> beon forede<ptr type="liebermannNote" n="10" target="#Af_50.lnote.oe.10"/>, gebete mid XV scll'.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="50" corresp="#wit-b-no-prol"><pb n="80" ed="#liebermann"/>Gyf man mannes ceacan forslea<ptr type="liebermannNote" n="5" target="#Af_50.lnote.oe.5"/>, þ<hi rend="italic">æt</hi> heo beon forede, fiftyne scill' gebete.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="50" corresp="#wit-q"><pb n="81" ed="#liebermann"/>Si quis homini genas (siue<ptr type="liebermannNote" n="18" target="#Af_50.lnote.oe.18"/> os<ptr type="liebermannNote" n="19" target="#Af_50.lnote.oe.19"/> maxillare) frangat, emendet<ptr type="liebermannNote" n="20" target="#Af_50.lnote.oe.20"/> quindecim<ptr type="liebermannNote" n="21" target="#Af_50.lnote.oe.21-2"/> sol.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="86" ed="#attenborough"/>Gif<ptr type="editorNote" n="16" target="#Af_50.attnote.fn.16"/> monnes ceacan mon forslihð<ptr type="editorNote" n="17" target="#Af_50.attnote.fn.17"/>, þæt hie beoð forode<ptr type="editorNote" n="18" target="#Af_50.attnote.fn.18"/>, gebete mid XV scill.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="53" corresp="#wit-e"><pb n="352" ed="#jurasinski-and-oliver"/>Gif monnes \c/eacan mon forslihð, þæt hie beoð forode, gebete mid XV scill.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="81" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_50.lnote.de.1"/> jemand eines Menschen Backen zerschlägt, so dass sie gebrochen sind, büsse er mit 15 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone smashes a person’s jaw so that it is broken, let him pay 15 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="87" ed="#attenborough"/>If anyone strikes another’s jaws so violently that they are fractured, he shall pay 15 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="353" ed="#jurasinski-and-oliver"/>If someone strikes a man’s jaws, so that they are both broken [namely, upper and lower jawbones], let him pay with 15 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">mon monnes c. forslea <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">mon monnes c. forslea Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">erstes</hi> c <hi rend="italic">von anderer Hand übergeschr. E</hi></seg><seg type="translation" xml:lang="en" source="#claude">first c written above by another hand E</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">heo <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">heo Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">fiftyne s. gebete <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">fiftyne s. gebete Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">letztes</hi> e <hi rend="italic">übergeschr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">last e written above</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">s. o. m. <hi rend="italic">aus T; fehlt K R Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. o. m. from T; lacking in K R Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">maxillam <hi rend="italic">statt</hi> os m. <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">maxillam instead of os m. Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">XV s. e. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">XV s. e. Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50.lnote.oe.21-2" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">81</biblScope></bibl><seg type="original" xml:lang="de">XII <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">XII T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_50.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">80</biblScope></bibl><seg type="original" xml:lang="de">ea <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">ea on an erasure</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_50.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">61</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Backen</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Backen</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_50.attnote.fn.16" n="16" source="#attenborough"><bibl><biblScope unit="page">86</biblScope></bibl><label>Gif</label><seg type="original" xml:lang="en"><hi rend="italic">Gif man mannes</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_50.attnote.fn.17" n="17" source="#attenborough"><bibl><biblScope unit="page">86</biblScope></bibl><label>forslihð</label><seg type="original" xml:lang="en"><hi rend="italic">forslea</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_50.attnote.fn.18" n="18" source="#attenborough"><bibl><biblScope unit="page">86</biblScope></bibl><label>forode</label><seg type="original" xml:lang="en"><hi rend="italic">beon forede</hi>. B &amp; H.</seg></note>
      </div>
    </body>
