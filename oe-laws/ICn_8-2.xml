        <note type="liebermannNote" subtype="textual" xml:id="ICn_8-2.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">292</biblScope></bibl><seg type="original" xml:lang="de">nælle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">nælle Ld</seg></note>
