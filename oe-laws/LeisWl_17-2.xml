      <div type="clause" n="17.2">
        <head><ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 17.2</head>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-hk"><ptr type="liebermannNote" n="a" target="#LeisWl_17-2.lnote.oe.a"/><pb n="504–505" ed="#liebermann"/>. . . . . . . . . . . . . . . .</ab>
        <ab type="liebermannText" xml:lang="xno" source="#liebermann" corresp="#wit-i"><ptr type="liebermannNote" n="d" target="#LeisWl_17-2.lnote.oe.d"/><pb n="504–505" ed="#liebermann"/>Ki retient<ptr type="liebermannNote" n="18" target="#LeisWl_17-2.lnote.oe.18"/> le dener Seint Pere, le dener rendra<ptr type="liebermannNote" n="19" target="#LeisWl_17-2.lnote.oe.19"/> per la justice de seinte<ptr type="liebermannNote" n="20" target="#LeisWl_17-2.lnote.oe.20"/> eglise, e XXX den.<ptr type="liebermannNote" n="21" target="#LeisWl_17-2.lnote.oe.21"/> forfait.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-l"><pb n="504–505" ed="#liebermann"/>Qui uero denarium Sancti Petri detinet<ptr type="liebermannNote" n="a" target="#LeisWl_17-2.lnote.oe.a-2"/>, cogetur censura<ptr type="liebermannNote" n="b" target="#LeisWl_17-2.lnote.oe.b"/> ecclesiastica illum soluere, et insuper XXX d. pro forisfacto.</ab>
        <ab type="editionText" xml:lang="xno" source="#robertson" n="17.2" corresp="#wit-i"><pb n="262" ed="#robertson"/>[Ki retient le dener Seint Pere, le dener rendra per la justice de seinte eglise e XXX den. forfait.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="504–505" ed="#liebermann"/>17, 2. Wer den Peterspfennig vorenthält, soll den Pfennig hergeben (gezwungen <hi rend="italic">L</hi>) durch den Richter (die Gerichtsbarkeit <hi rend="italic">L</hi>) der heiligen Kirche, und 30 Pfennig Busse [an sie<ptr type="liebermannNote" n="1" target="#LeisWl_17-2.lnote.de.1"/>].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">17, 2. Whoever withholds Peter's Pence shall hand over the penny (compelled <hi rend="italic">L</hi>) by the judge (the jurisdiction <hi rend="italic">L</hi>) of holy church, and 30 pennies compensation [to it].</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-i"><pb n="263" ed="#robertson"/>[He who withholds Peter's Pence shall pay the penny through the court of Holy Church, and 30 pence as a fine.</ab>
        <note type="comparison" source="#liebermann" n="505">ECf 10.2</note>
        <note type="comparisonPrinted" source="#liebermann">vgl. ebd. 10, 2</note>
        <note type="editorial">Added October 2026 from Robertson pp. 262–263 (text and translation); 17.2 and 17.3 are from I (not in Hk) (Robertson).; Liebermann’s text and German translation added from Gesetze I p. 504–505, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_17-2.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">ergänze aus IL</hi></seg><seg type="translation" xml:lang="en" source="#claude">supply from IL</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_17-2.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">XX. <hi rend="italic">I, wo</hi> 17, 2 <hi rend="italic">und</hi> 17, 3 <hi rend="italic">hinter</hi> 18,2 (<hi rend="italic">irrig laut Inhalts und Lateinischen Textes</hi>) <hi rend="italic">folgen</hi></seg><seg type="translation" xml:lang="en" source="#claude">XX. I, where 17, 2 and 17, 3 follow after 18,2 (wrongly, judging by the content and the Latin text)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_17-2.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">renent <hi rend="italic">Io Isp</hi></seg><seg type="translation" xml:lang="en" source="#claude">renent <hi rend="italic">Io Isp</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_17-2.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">pendra <hi rend="italic">Io</hi></seg><seg type="translation" xml:lang="en" source="#claude">pendra <hi rend="italic">Io</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_17-2.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">seint <hi rend="italic">Io Isp</hi></seg><seg type="translation" xml:lang="en" source="#claude">seint <hi rend="italic">Io Isp</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_17-2.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">504</biblScope></bibl><seg type="original" xml:lang="de">de <hi rend="italic">ergänzt MAT.; gemäss L</hi></seg><seg type="translation" xml:lang="en" source="#claude">de supplied by MAT., in accordance with L</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_17-2.lnote.oe.a-2" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">505</biblScope></bibl><seg type="original" xml:lang="de">detinuerit <hi rend="italic">auch ECf.; dass aber L die gemeinsame (Lateinische?) Quelle unmittelbar kannte, folgt deshalb noch nicht</hi></seg><seg type="translation" xml:lang="en" source="#claude">detinuerit also ECf.; but it does not yet follow from this that L knew the common (Latin?) source directly</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="LeisWl_17-2.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">505</biblScope></bibl><seg type="original" xml:lang="de">iusticia s. ecclesiæ <hi rend="italic">ECf.;</hi> iustitia episcopi <hi rend="italic">Wl ep.</hi> 3,2; <hi rend="italic">den bischöflichen Official so zu nennen vermeidet L</hi></seg><seg type="translation" xml:lang="en" source="#claude">iusticia s. ecclesiæ ECf.; iustitia episcopi Wl ep. 3,2; L avoids giving the bishop’s official this name</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="LeisWl_17-2.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">289</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Peterspfennig 17c-g; Geistliches Gericht 12b. 21f. g; <hi rend="italic">o</hi>. Einl. 18, Z. 3 und 19ff.</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Peterspfennig 17c-g; Geistliches Gericht 12b. 21f. g; <hi rend="italic">above</hi> Introduction 18, l. 3 and 19ff.</seg><note type="remark" resp="#claude">Liebermann’s heading: Leis Wl 17, 2. 3</note></note>
      </div>
    </body>
