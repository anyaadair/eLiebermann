      <div type="clause" n="84a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 84a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 84a" corresp="#wit-lat"><pb n="600" ed="#liebermann"/>In quibusdam locis<ptr type="liebermannNote" n="25" target="#Hn_84a.lnote.oe.25"/>, sicut<ptr type="liebermannNote" n="l" target="#Hn_84a.lnote.oe.l"/> diximus, reus est qui uerberat et qui uerberatur, ut nec malefaciens<ptr type="liebermannNote" n="26" target="#Hn_84a.lnote.oe.26"/> inpunitate superbiat nec contumeliatus fedis<ptr type="liebermannNote" n="27" target="#Hn_84a.lnote.oe.27"/> emendacionibus insolescat<ptr type="liebermannNote" n="m" target="#Hn_84a.lnote.oe.m"/>.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 600 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_84a.lnote.oe.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> 39</seg><seg type="translation" xml:lang="en" source="#claude">cf. 39</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_84a.lnote.oe.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">ausarte. <hi rend="italic">Oder bessere</hi> insuescat <hi rend="italic">laut</hi> assuescat 39</seg><seg type="translation" xml:lang="en" source="#claude">degenerate. Or emend to insuescat, after assuescat 39</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_84a.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_84a.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">-fic. <hi rend="italic">K Co Or Sl Tw</hi>; -facaciens <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-fic. K Co Or Sl Tw; -facaciens Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_84a.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">600</biblScope></bibl><seg type="original" xml:lang="de">feodis, <hi rend="italic">unterpunctirt</hi> o <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">feodis, with o marked for deletion by a dot beneath Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_84a.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de">Statt <hi rend="italic">verberare</hi> steht ‘Blutvergiessen’ <hi rend="italic">o</hi>. 39—<hi rend="italic">locis</hi>{25} fehlt Rs</seg><seg type="translation" xml:lang="en" source="#claude">Instead of <hi rend="italic">verberare</hi>, ‘bloodshed’ appears <hi rend="italic">above</hi> 39—<hi rend="italic">locis</hi>{25} missing Rs</seg></note>
      </div>
