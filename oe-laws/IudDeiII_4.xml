      <div type="clause" n="4">
        <head><ref type="lawCode" target="law:IudDeiII">Iud Dei II</ref> 4</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei II 4" corresp="#wit-lat"><pb n="407" ed="#liebermann"/>Item tertia<ptr type="liebermannNote" n="19" target="#IudDeiII_4.lnote.oe.19"/>. Deus<ptr type="liebermannNote" n="20" target="#IudDeiII_4.lnote.oe.20"/>, innocentiae restitutor et amator, qui<ptr type="liebermannNote" n="21" target="#IudDeiII_4.lnote.oe.21"/> auctor pacis es et iudicas aequitatem, te<ptr type="liebermannNote" n="22" target="#IudDeiII_4.lnote.oe.22"/> subnixis rogamus precibus, ut hoc ferrum ignitum, ordinatum —- uel<ptr type="liebermannNote" n="23" target="#IudDeiII_4.lnote.oe.23"/> hanc aquam, ordinatam<ptr type="liebermannNote" n="24" target="#IudDeiII_4.lnote.oe.24"/> — ad iustitiam<ptr type="liebermannNote" n="25" target="#IudDeiII_4.lnote.oe.25"/> et examinationem cuiuslibet dubietatis, benedicere<ptr type="liebermannNote" n="26" target="#IudDeiII_4.lnote.oe.26"/> et sanctificare<ptr type="liebermannNote" n="26" target="#IudDeiII_4.lnote.oe.26"/> digneris;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 407 (two independent readings of the page images, differences settled against the page); Liebermann’s print has a stray hyphen after the dash in ‘ordinatum —- uel’; transcribed as printed</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">Alia oratio <hi rend="italic">Ch;</hi> I. alia oratio <hi rend="italic">Rj;</hi> Alia <hi rend="italic">Ci;</hi> Oratio <hi rend="italic">Tr Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">Alia oratio Ch; I. alia oratio Rj; Alia Ci; Oratio Tr Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">zumeist</hi> = <hi rend="italic">Zeu.</hi> 700 (13), <hi rend="italic">noch näher</hi> 617₁ = <hi rend="italic">unten</hi> IX 2. <hi rend="italic">Für Iud. Dei</hi> X 20—20, 3 <hi rend="italic">ist</hi> 4—4, 3 <hi rend="italic">oder die Quelle Vorbild</hi></seg><seg type="translation" xml:lang="en" source="#claude">for the most part = Zeu. 700 (13), still closer 617₁ = below IX 2. For Iud. Dei X 20—20, 3, 4—4, 3 or its source is the model</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">qui — equit. = <hi rend="italic">Zeu.</hi> 700₅.₁₆</seg><seg type="translation" xml:lang="en" source="#claude">qui — equit. = Zeu. 700₅.₁₆</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">s. te <hi rend="italic">Tr</hi></seg><seg type="translation" xml:lang="en" source="#claude">s. te Tr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">u. h. a. o. <hi rend="italic">fehlt Rj Ch Tr Co; am Rande H; übergeschr. Ca Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">u. h. a. o. omitted in Rj Ch Tr Co; in the margin in H; written above in Ca Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">feruentem, <hi rend="italic">aber</hi> ā <hi rend="italic">schon über</hi> ordinatum <hi rend="italic">H</hi></seg><seg type="translation" xml:lang="en" source="#claude">feruentem, but ā already above ordinatum H</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4.lnote.oe.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">iustam exa. <hi rend="italic">Zeu.</hi> 700₁₈; examinationemque IX</seg><seg type="translation" xml:lang="en" source="#claude">iustam exa. Zeu. 700₁₈; examinationemque IX</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiII_4.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">407</biblScope></bibl><seg type="original" xml:lang="de">+ <hi rend="italic">roth übergeschr. H</hi></seg><seg type="translation" xml:lang="en" source="#claude">+ written above in red H</seg></note>
      </div>
