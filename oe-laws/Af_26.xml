        <note type="liebermannNote" subtype="textual" xml:id="Af_26.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">65</biblScope></bibl><seg type="original" xml:lang="de">ad u. c. p. cogat <hi rend="italic">aus Lond; nur</hi> <hi rend="spaced">uiolenter opprimat</hi> <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad u. c. p. cogat from Lond; only <hi rend="italic">uiolenter opprimat</hi> the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_26.lnote.oe.1-3" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">67</biblScope></bibl><seg type="original" xml:lang="de">prof. <hi rend="italic">Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">prof. Or</seg></note>
