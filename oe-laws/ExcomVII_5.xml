      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:ExcomVII">Excom VII</ref> 5</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Excom VII 5" corresp="#wit-cx"><pb n="438" ed="#liebermann"/>⁊ þær to eacan habban hio . dæl ⁊ ece sar mid Iudan, ures Drihtenes belewedan<ptr type="liebermannNote" n="4" target="#ExcomVII_5.lnote.oe.4"/>, ⁊ mid þa<hi rend="italic">m</hi> þe ure Drihtene cwæden: ‘Gewit fram us, nelle we þane<ptr type="liebermannNote" n="5" target="#ExcomVII_5.lnote.oe.5"/> weg þinre ingehyde!’ — buton hi gecerran ⁊ to dædbote cuman.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="438" ed="#liebermann"/>Und ausserdem sollen sie Theil haben und ewige<ptr type="liebermannNote" n="n" target="#ExcomVII_5.lnote.de1.n"/> Pein mit Judas<ptr type="liebermannNote" n="o" target="#ExcomVII_5.lnote.de1.o"/>, unseres Herrn Verräther, und mit<ptr type="liebermannNote" n="p" target="#ExcomVII_5.lnote.de1.p"/> denen, die zu unserem Herrn sprachen: ‘Weiche von uns, wir wollen nicht den Weg Deines Denkens!’ — es sei denn<ptr type="liebermannNote" n="q" target="#ExcomVII_5.lnote.de1.q"/> sie kehren um und kommen zu Poenitenz.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And moreover they shall have part and eternal torment with Judas, our Lord’s betrayer, and with those who said to our Lord: ‘Depart from us, we desire not the way of Thy thought!’ — unless they turn back and come to penance.</ab>
        <note type="comparison" source="#liebermann"/>
        <note type="comparisonPrinted" source="#liebermann">Hiob 21, 14</note>
        <note type="editorial">New row (October 2026): Liebermann’s text and German translation transcribed from Gesetze I p. 438 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVII_5.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">438</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> belæwendan; <hi rend="italic">doch nimmt Bosworth-Toller nur hiernach ein</hi> beleweda <hi rend="italic">an</hi></seg><seg type="translation" xml:lang="en" source="#claude">read belæwendan; but Bosworth-Toller assumes a form beleweda solely on the strength of this passage</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ExcomVII_5.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">438</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. aus</hi> þane</seg><seg type="translation" xml:lang="en" source="#claude">corr. from þane</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="ExcomVII_5.lnote.de1.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">438</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl. unten</hi> 23. I 11, 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf. below</hi> 23. I 11, 2</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="ExcomVII_5.lnote.de1.o" n="o" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">438</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> III 2</seg><seg type="translation" xml:lang="en" source="#claude">cf. III 2</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="ExcomVII_5.lnote.de1.p" n="p" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">438</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> IV 2</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">cf.</hi> IV 2</seg></note>
        <note type="liebermannNote" subtype="translationFootnote" xml:id="ExcomVII_5.lnote.de1.q" n="q" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">438</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. u.</hi> 22</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">see below</hi> 22</seg></note>
