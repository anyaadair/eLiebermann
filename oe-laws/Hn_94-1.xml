      <div type="clause" n="94.1">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 94.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 94.1" corresp="#wit-lat"><pb n="610" ed="#liebermann"/>Qui aliquem ita uerberauerit, ut sanguinem eius non effundat, quotlibet<ptr type="liebermannNote" n="37" target="#Hn_94-1.lnote.oe.37"/> ictus ei det, tres solummodo<ptr type="liebermannNote" n="g" target="#Hn_94-1.lnote.oe.g"/> ictus per<ptr type="liebermannNote" n="38" target="#Hn_94-1.lnote.oe.38"/> legem emendet, singulum<ptr type="liebermannNote" n="h" target="#Hn_94-1.lnote.oe.h"/> V den.<ptr type="liebermannNote" n="39" target="#Hn_94-1.lnote.oe.39"/>, quod est in summa XV den.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 610 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-1.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">610</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">auch andere Germanen beschränken bei vielen Schlägen die Vervielfältigung der Busse; Schreuer</hi> Verbrechenskonkurrenz <hi rend="italic">S.</hi> 2—12</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">other Germanic peoples too limit the multiplication of the compensation where there are many blows; Schreuer</hi> Verbrechenskonkurrenz <hi rend="italic">pp.</hi> 2—12</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-1.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">610</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Lex Sal.</hi> (<hi rend="italic">vgl. o. Anm. f</hi>): 1 sol., <hi rend="italic">den Hn als Westsächsisch auffasst; vgl.</hi> 94, 4</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Lex Sal.</hi> (<hi rend="italic">cf. above note f</hi>): 1 sol., <hi rend="italic">which Hn takes as West Saxon; cf.</hi> 94, 4</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-1.lnote.oe.37" n="37" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">610</biblScope></bibl><seg type="original" xml:lang="de">quodl. ei ic. det, t. i. so. <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">quodl. ei ic. det, t. i. so. <hi rend="italic">Lond</hi></seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-1.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">610</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">umgestellt aus</hi> em. per l. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">transposed from em. per l. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-1.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">610</biblScope></bibl><seg type="original" xml:lang="de">denarios <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">denarios Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_94-1.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">329</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Blauwunde—<hi rend="italic">quodl. ei i d. tres i. s. per</hi>{38} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Blauwunde—<hi rend="italic">quodl. ei i d. tres i. s. per</hi>{38} Rs</seg></note>
      </div>
