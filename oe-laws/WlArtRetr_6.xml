      <div type="clause" n="6">
        <head><ref type="lawCode" target="law:WlArtRetr">Wl art retr</ref> 6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" corresp="#wit-lond"><pb n="490" ed="#liebermann"/>Statuimus etiam et firmiter<ptr type="liebermannNote" n="18" target="#WlArtRetr_6.lnote.oe.18"/> precipimus, ut omnes ciuitates<ptr type="liebermannNote" n="g" target="#WlArtRetr_6.lnote.oe.g"/> et burgi et castella et hundredi<ptr type="liebermannNote" n="19" target="#WlArtRetr_6.lnote.oe.19"/> et wapentachia<ptr type="liebermannNote" n="20" target="#WlArtRetr_6.lnote.oe.20"/> tocius regni nostri predicti singulis noctibus uigilentur et custodiantur in girum pro maleficis<ptr type="liebermannNote" n="21" target="#WlArtRetr_6.lnote.oe.21"/> et inimicis, prout uicecomites<ptr type="liebermannNote" n="22" target="#WlArtRetr_6.lnote.oe.22"/> et aldermanni<ptr type="liebermannNote" n="h" target="#WlArtRetr_6.lnote.oe.h"/> et prepositi et ceteri<ptr type="liebermannNote" n="23" target="#WlArtRetr_6.lnote.oe.23"/> balliui<ptr type="liebermannNote" n="24" target="#WlArtRetr_6.lnote.oe.24"/> et ministri nostri melius per commune<ptr type="liebermannNote" n="e" target="#WlArtRetr_6.lnote.oe.e"/> consilium ad utilitatem regni prouidebunt.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="6" corresp="#wit-rs"><pb n="246" ed="#robertson"/>Statuimus eciam et firmiter praecipimus, ut omnes civitates et burgi et castella et hundreda et wapentagia totius regni nostri praedicti, singulis noctibus vigilentur et custodiantur in girum pro maleficis et inimicis, prout vicecomites et aldermani et praepositi et ceteri ballivi et ministri nostri melius per commune consilium ad utilitatem regni providebunt.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-rs"><pb n="247" ed="#robertson"/>We likewise decree and firmly enjoin, that all cities, boroughs, castles, hundreds and wapentakes throughout the whole of our realm aforesaid shall be watched and guarded every night on all sides against malefactors and enemies, as our sheriffs, ealdormen, reeves and our other officials and servants shall, with the general approval, best provide for the benefit of the realm.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:WlArtRetr_11">Wl art retr 11</ref></note>
        <note type="editorial">Added October 2026 from Robertson pp. 246–247 (text and translation); Liebermann’s text added from Gesetze I p. 490, October 2026 (two independent readings of the page images)</note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_6.lnote.oe.e" n="e" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ansprüche gegen König Johann</hi></seg><seg type="translation" xml:lang="en" source="#claude">Claims against King John</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_6.lnote.oe.g" n="g" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vgl.</hi> E Cf. 32 B 9. <hi rend="italic">Verf. giebt oft Londoner Einrichtungen als Reichsgesetze aus</hi></seg><seg type="translation" xml:lang="en" source="#claude">cf. E Cf. 32 B 9. The author often presents London institutions as laws of the realm</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_6.lnote.oe.h" n="h" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">als städtische Vorsteher seit</hi> 12. <hi rend="italic">Jh.</hi></seg><seg type="translation" xml:lang="en" source="#claude">as municipal officials since the 12th cent.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_6.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de">similiter <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">similiter Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_6.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de">-da <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-da Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_6.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de">-cha <hi rend="italic">Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">-cha Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_6.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de">-ciis <hi rend="italic">Co Or K3;</hi> malif. <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ciis Co Or K3; malif. Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_6.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de">-comes <hi rend="italic">Se</hi></seg><seg type="translation" xml:lang="en" source="#claude">-comes Se</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_6.lnote.oe.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Co Or</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Co Or</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_6.lnote.oe.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">490</biblScope></bibl><seg type="original" xml:lang="de">baill. <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">baill. Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="WlArtRetr_6.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">283</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Nacht 4; Stadt 14; Wache 3. 4.—<hi rend="italic">hundreda</hi>{19} <hi rend="italic">et wapentagia</hi> Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Nacht 4; Stadt 14; Wache 3. 4.—<hi rend="italic">hundreda</hi>{19} <hi rend="italic">et wapentagia</hi> Rs</seg></note>
