      <div type="clause" n="21">
        <head><ref type="lawCode" target="law:IudDeiX">Iud Dei X</ref> 21</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei X 21" corresp="#wit-lat"><pb n="418" ed="#liebermann"/>Postea iurent sacramenta et accusans<ptr type="liebermannNote" n="b" target="#IudDeiX_21.lnote.oe.b"/> et defensor<ptr type="liebermannNote" n="c" target="#IudDeiX_21.lnote.oe.c"/>, quasi duellum<ptr type="liebermannNote" n="d" target="#IudDeiX_21.lnote.oe.d"/> ingressuri iurant<ptr type="liebermannNote" n="30" target="#IudDeiX_21.lnote.oe.30"/>;</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 418 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_21.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. o. S.</hi> 402{a} <hi rend="italic">und</hi> II As. 23, 2. <hi rend="italic">Bei Zeu.</hi> 628 <hi rend="italic">bietet</hi> accusator voreit <hi rend="italic">an.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Cf. above p. 402{a} and II As. 23, 2. In Zeu. 628 the accuser offers the fore-oath.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_21.lnote.oe.c" n="c" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de">exuatur et, dato iuramento, mittatur in aquam <hi rend="italic">Zeu.</hi> 638.</seg><seg type="translation" xml:lang="en" source="#claude">exuatur et, dato iuramento, mittatur in aquam Zeu. 638.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_21.lnote.oe.d" n="d" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Also nicht Angelsächsisch.</hi></seg><seg type="translation" xml:lang="en" source="#claude">Therefore not Anglo-Saxon.</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiX_21.lnote.oe.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">418</biblScope></bibl><seg type="original" xml:lang="de">iurent <hi rend="italic">Bc</hi></seg><seg type="translation" xml:lang="en" source="#claude">iurent Bc</seg></note>
