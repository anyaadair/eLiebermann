      <div type="clause" n="70.21a">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 70.21a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 70.21a" corresp="#wit-lat"><pb n="589" ed="#liebermann"/>Si<ptr type="liebermannNote" n="38" target="#Hn_70-21a.lnote.oe.38"/> bocland<ptr type="liebermannNote" n="y" target="#Hn_70-21a.lnote.oe.y"/><ptr type="liebermannNote" n="39" target="#Hn_70-21a.lnote.oe.39"/> habeat, quam ei parentes dederint<ptr type="liebermannNote" n="40" target="#Hn_70-21a.lnote.oe.40"/>, non mittat eam<ptr type="liebermannNote" n="41" target="#Hn_70-21a.lnote.oe.41"/> extra cognacionem suam, sicut prediximus.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 589 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-21a.lnote.oe.y" n="y" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">aus Angelsächs. Ælfred; vgl.</hi> 70, 21. 88, 14</seg><seg type="translation" xml:lang="en" source="#claude">from the Anglo-Saxon Ælfred; cf. 70, 21. 88, 14</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-21a.lnote.oe.38" n="38" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">Et si <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et si Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-21a.lnote.oe.39" n="39" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">bocl'a h'tat [<hi rend="italic">Rest aus</hi> terram hereditariam <hi rend="italic">des Quadr.?</hi>] <hi rend="italic">Sc</hi></seg><seg type="translation" xml:lang="en" source="#claude">bocl'a h'tat [remains of terram hereditariam of the Quadr.?] Sc</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-21a.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">sui dederunt <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">sui dederunt Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_70-21a.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">589</biblScope></bibl><seg type="original" xml:lang="de">eum <hi rend="italic">gegen Hss. Wi Tho</hi></seg><seg type="translation" xml:lang="en" source="#claude">eum against the MSS Wi Tho</seg></note>
