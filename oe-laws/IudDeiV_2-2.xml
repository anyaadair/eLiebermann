        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_2-2.lnote.oe.40" n="40" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiV_2-2.lnote.oe.41" n="41" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">411</biblScope></bibl><seg type="original" xml:lang="de">uel si <hi rend="italic">fehlt besser I</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel si omitted in I, better</seg></note>
        <ab type="translation" xml:lang="en" source="#claude-crib" ana="#fromLatin" corresp="#wit-du">I adjure you by the holy catholic Church and by the communion of saints and by their resurrection, that you may become exorcised, adjured and made firm against the enemy of man, the devil, and against the man — or if anyone, led astray by him, committed this theft about which inquiry is being made, or was privy to it when committed, or in any way gave consent;</ab>
