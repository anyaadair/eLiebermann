      <div type="clause" n="28">
        <head><ref type="lawCode" target="law:ECf">ECf</ref> 28</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="ECf 28"><pb n="651" ed="#liebermann"/><ptr type="liebermannNote" n="21" target="#ECf_28.lnote.la.21"/>Cum autem uiderent<ptr type="liebermannNote" n="22" target="#ECf_28.lnote.la.22"/>, quod aliqui stulti libenter forisfaciebant erga uicinos suos<ptr type="liebermannNote" n="23" target="#ECf_28.lnote.la.23"/>, sapientiores<ptr type="liebermannNote" n="k" target="#ECf_28.lnote.la.fn.k"/> ceperunt consilium<ptr type="liebermannNote" n="24" target="#ECf_28.lnote.la.24"/> intra<ptr type="liebermannNote" n="25" target="#ECf_28.lnote.la.25"/> se, quomodo eos reprimerent; et sic imposuerunt iusticiarios super quosque decem<ptr type="liebermannNote" n="26" target="#ECf_28.lnote.la.26"/> friborghas<ptr type="liebermannNote" n="l" target="#ECf_28.lnote.la.fn.l"/><ptr type="liebermannNote" n="27" target="#ECf_28.lnote.la.27"/>, quos decanos possumus dicere; Anglice autem<ptr type="liebermannNote" n="20" target="#ECf_28.lnote.la.20"/> <ptr type="liebermannNote" n="m" target="#ECf_28.lnote.la.fn.m"/>tyenþe<ptr type="liebermannNote" n="28" target="#ECf_28.lnote.la.28"/> heued<ptr type="liebermannNote" n="29" target="#ECf_28.lnote.la.29"/> uocati sunt, hoc<ptr type="liebermannNote" n="30" target="#ECf_28.lnote.la.30"/> est caput de<ptr type="liebermannNote" n="31" target="#ECf_28.lnote.la.31"/> decem<ptr type="liebermannNote" n="n" target="#ECf_28.lnote.la.fn.n"/>.</ab>
        <note type="comparison" source="#liebermann" n="651"><label>printed alongside</label> <ref target="clause:ECfRetr_28">ECf retr 28</ref></note>
        <note type="editorial">Liebermann’s text transcribed from Gesetze I p. 651 (November 2026): read from the page images and checked against the scan’s own text layer, differences settled against the page.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_28.lnote.la.fn.k" n="k" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">Witan <hi rend="italic">vor</hi> 1066, <hi rend="italic">auch</hi> 29, <hi rend="italic">also nicht die des Prologs; auch Will. Malm.</hi> Reg. II 122 <hi rend="italic">setzt die Entstehung vor</hi> 1066</seg><seg type="translation" xml:lang="en" source="#claude">witan before 1066, also at 29, so not those of the Prologue; Will. Malm., Reg. II 122, too places the origin before 1066</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_28.lnote.la.fn.l" n="l" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">hier Einzelmitglied des</hi> friborg; <hi rend="italic">vgl.</hi> 20; <hi rend="italic">mein</hi> Ed. Conf. <hi rend="italic">S.</hi> 30</seg><seg type="translation" xml:lang="en" source="#claude">here an individual member of the friborg; cf. 20; my Ed. Conf. p. 30</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_28.lnote.la.fn.m" n="m" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">theþingeman (<hi rend="italic">statt</hi> t. h.) <hi rend="italic">Ad; vgl. Hu</hi> 2. 4; tynigman <hi rend="italic">Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">theþingeman (instead of t. h.) Ad; cf. Hu 2. 4; tynigman Do</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="ECf_28.lnote.la.fn.n" n="n" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vielmehr</hi> decima: <hi rend="italic">Zehntel</hi></seg><seg type="translation" xml:lang="en" source="#claude">rather decima: a tenth</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28.lnote.la.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">Quare fridborgi constituti sunt <hi rend="italic">überschr. Pl S; fehlt übr.</hi></seg><seg type="translation" xml:lang="en" source="#claude">headed Quare fridborgi constituti sunt Pl S; lacking in the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28.lnote.la.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">-runt <hi rend="italic">S Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">-runt S Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28.lnote.la.23" n="23" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28.lnote.la.24" n="24" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">querere <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">querere Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28.lnote.la.25" n="25" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">inter <hi rend="italic">S Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">inter S Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28.lnote.la.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">friþborges X <hi rend="italic">Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">friþborges X Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28.lnote.la.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">-rg’ <hi rend="italic">Hk;</hi> fridborgos <hi rend="italic">S Ad;</hi> frithborgos <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rg’ Hk; fridborgos S Ad; frithborgos Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28.lnote.la.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28.lnote.la.28" n="28" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">-nte <hi rend="italic">Rl;</hi> tente <hi rend="italic">S;</hi> tenc <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">-nte Rl; tente S; tenc Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28.lnote.la.29" n="29" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">phte <hi rend="italic">Rl;</hi> fe <hi rend="italic">S;</hi> heeuit <hi rend="italic">Hr</hi></seg><seg type="translation" xml:lang="en" source="#claude">phte Rl; fe S; heeuit Hr</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28.lnote.la.30" n="30" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de">hoc—dec. <hi rend="italic">fehlt Ad Do</hi></seg><seg type="translation" xml:lang="en" source="#claude">hoc—dec. lacking in Ad Do</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="ECf_28.lnote.la.31" n="31" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">651</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">fehlt S</hi></seg><seg type="translation" xml:lang="en" source="#claude">lacking in S</seg></note>
      </div>
