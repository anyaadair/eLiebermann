      <div type="clause" n="86.3">
        <head><ref type="lawCode" target="law:Hn">Hn</ref> 86.3</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Hn 86.3" corresp="#wit-lat"><pb n="601" ed="#liebermann"/>Et ubi forte plures fuerint, et eorum quidam forisfaciant<ptr type="liebermannNote" n="12" target="#Hn_86-3.lnote.oe.12"/>, non est eis inputandum qui tenuerint uiam suam et recedent ab illis<ptr type="liebermannNote" n="13" target="#Hn_86-3.lnote.oe.13"/>, si per omnia se allegient, quod nec consilium eorum uel auxilium sit in forcia ipsa.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 601 (two independent readings of the page images, differences settled against the page)</note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_86-3.lnote.oe.12" n="12" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">-ient <hi rend="italic">Sc Hg</hi></seg><seg type="translation" xml:lang="en" source="#claude">-ient Sc Hg</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_86-3.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">601</biblScope></bibl><seg type="original" xml:lang="de">eis, si per se om. <hi rend="italic">K Co</hi></seg><seg type="translation" xml:lang="en" source="#claude">eis, si per se om. K Co</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Hn_86-3.lnote.oe._" n="-" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">328</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Ebd</hi>. gemeinschaftliche Missetat 10; <hi rend="italic">forcia s. o</hi>. S. 312 Z. 20—<hi rend="italic">eis</hi>{13}—87 <hi rend="italic">ad</hi>{16} <hi rend="italic">oc</hi>.—87, 1b <hi rend="italic">In ueritate</hi>—<hi rend="italic">-ndi</hi>{20}—87, 2 <hi rend="italic">loq</hi>.{21}—<hi rend="italic">h. dam. aliquod</hi> (nicht orig.) <hi rend="italic">ing</hi>.—87, 2a <hi rend="italic">extitit</hi>{33}—87, 2b <hi rend="italic">quis</hi>{34} Rs</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Ibid</hi>. gemeinschaftliche Missetat 10; <hi rend="italic">forcia see above</hi> p. 312 l. 20—<hi rend="italic">eis</hi>{13}—87 <hi rend="italic">ad</hi>{16} <hi rend="italic">oc</hi>.—87, 1b <hi rend="italic">In ueritate</hi>—<hi rend="italic">-ndi</hi>{20}—87, 2 <hi rend="italic">loq</hi>.{21}—<hi rend="italic">h. dam. aliquod</hi> (not original) <hi rend="italic">ing</hi>.—87, 2a <hi rend="italic">extitit</hi>{33}—87, 2b <hi rend="italic">quis</hi>{34} Rs</seg></note>
