    <body>
      <div type="clause" n="6.6">
        <head><ref type="lawCode" target="law:IVAs">IV As</ref> 6.6</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6.6" corresp="#wit-q"><pb n="172" ed="#liebermann"/>Tunc<ptr type="liebermannNote" n="1" target="#IVAs_6-6.lnote.oe.1"/> (Et<ptr type="liebermannNote" n="45" target="#IVAs_6-6.lnote.oe.45"/>) quando furatus seruus mortuus<ptr type="liebermannNote" n="46" target="#IVAs_6-6.lnote.oe.46"/> fuerit, reddat<ptr type="liebermannNote" n="a" target="#IVAs_6-6.lnote.oe.a"/> unusquisque seruorum illorum tres denarios<ptr type="liebermannNote" n="b" target="#IVAs_6-6.lnote.oe.b"/> domino suo.</ab>
        <ab type="editionText" xml:lang="la" source="#attenborough" n="6.6" corresp="#wit-q"><pb n="150" ed="#attenborough"/>Tunc<ptr type="editorNote" n="4" target="#IVAs_6-6.attnote.fn.4"/> quando furatus servus mortuus fuerit<ptr type="editorNote" n="5" target="#IVAs_6-6.attnote.fn.5"/>, reddat unusquisque servorum illorum tres denarios domino suo.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-q"><pb n="151" ed="#attenborough"/>When a slave guilty of theft has been put to death, each of those slaves shall give three pennies to his lord<ptr type="editorNote" n="1" target="#IVAs_6-6.attnote.n.1"/>.</ab>
        <note type="editorial">Latin only; no German translation in Liebermann.</note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-6.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lond; (eingeklammertes) übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">before the bracket Lond; (bracketed words) the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-6.lnote.oe.45" n="45" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">Et <hi rend="italic">Or Co (auf Rasur)</hi></seg><seg type="translation" xml:lang="en" source="#claude">Et Or Co (on an erasure)</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-6.lnote.oe.46" n="46" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">172</biblScope></bibl><seg type="original" xml:lang="de">erit mo. <hi rend="italic">RTMHk</hi></seg><seg type="translation" xml:lang="en" source="#claude">erit mo. RTMHk</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-6.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">114</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Zusammenschiessen behufs Entschädigung des Sklavenhalters für hingerichteten Unfreien auf andere Art: VI As 6, 3</seg><seg type="translation" xml:lang="en" source="#claude">Joint contribution to compensate the slave-owner for an executed unfree man, arranged differently: VI As 6, 3</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IVAs_6-6.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">114</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> unfrei 7b. c</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> unfrei 7b. c</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="IVAs_6-6.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">211</biblScope></bibl><seg type="original" xml:lang="en">Apparently to make up the price of a slave, which was a pound (240 pence); cf. Ine, cap. 3 § 2, 74, 23 § 3.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_6-6.attnote.fn.4" n="4" source="#attenborough"><bibl><biblScope unit="page">150</biblScope></bibl><label>Tunc</label><seg type="original" xml:lang="en"><hi rend="italic">Et</hi>.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="IVAs_6-6.attnote.fn.5" n="5" source="#attenborough"><bibl><biblScope unit="page">150</biblScope></bibl><label>fuerit</label><seg type="original" xml:lang="en"><hi rend="italic">erit mortuus</hi>. R, T, M, Hk.</seg></note>
      </div>
    </body>
