    <body>
      <div type="clause" n="23">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 23</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="23" corresp="#wit-e"><pb n="98" ed="#liebermann"/>LXVII. Gif mon elðeodigne<ptr type="liebermannNote" n="15" target="#Ine_23.lnote.oe.15"/> ófslea, se cyning ah twædne<ptr type="liebermannNote" n="16" target="#Ine_23.lnote.oe.16"/> dǽl weres, þriddan dæl sunu oððe mægas.<ptr type="liebermannNote" n="17" target="#Ine_23.lnote.oe.17"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="23" corresp="#wit-bu"><pb n="98" ed="#liebermann"/>LXVII. Gif mon elþeodigne ofslea, se kining ah<ptr type="liebermannNote" n="2" target="#Ine_23.lnote.oe.2"/> twædne dæl weres, ðriddan dæl sunu oððe mæges.<ptr type="liebermannNote" n="3" target="#Ine_23.lnote.oe.3"/></ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="23" corresp="#wit-h"><pb n="98" ed="#liebermann"/>LXVII. Gif mon<ptr type="liebermannNote" n="2" target="#Ine_23.lnote.oe.2-2"/> ælðeodigne ofslea, se cyning ah twegen dæl<ptr type="liebermannNote" n="11" target="#Ine_23.lnote.oe.11"/> weres, ðriddan dæl sunu oþþe magas.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="23" corresp="#wit-b-no-prol"><pb n="99" ed="#liebermann"/>Be ælðeodiges mannes slæge. Gyf mon ælþeodigne mon ofslea, se cyng ah twegen dælas þæs weres, ðriddan dæl sunu oððe magas.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="23" corresp="#wit-q"><pb n="99" ed="#liebermann"/>Si homo alienigena occidatur, habeat rex duas partes werę suę,<ptr type="liebermannNote" n="21" target="#Ine_23.lnote.oe.21"/> tertiam partem habeant filii<ptr type="liebermannNote" n="22" target="#Ine_23.lnote.oe.22"/> uel parentes sui.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="42" ed="#attenborough"/>[Be ælðeodiges mannes slæge.] Gif mon elðeodigne ófslea, se cyning ah twædne<ptr type="editorNote" n="15" target="#Ine_23.attnote.fn.15"/> dǽl weres þriddan dæl sunu oððe mægas.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="22" corresp="#wit-e"><pb n="388" ed="#jurasinski-and-oliver"/>{LXVII} Gif mon elðeodigne ófslea, se cyning ah twædne dǽl weres, þriddan dæl sunu oððe mægas.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="99" ed="#liebermann"/>Wenn jemand einen Ausländer<ptr type="liebermannNote" n="1" target="#Ine_23.lnote.de.1"/> erschlägt, so erhält der König den doppelten<ptr type="liebermannNote" n="2" target="#Ine_23.lnote.de.2"/> [Dritt]theil des Wergeldes, das [übrige] Drittel der Sohn<ptr type="liebermannNote" n="3" target="#Ine_23.lnote.de.3"/> oder die Verwandten.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone slays a foreigner, the king receives two [thirds] of the wergeld, the [remaining] third the son or the kinsmen.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="43" ed="#attenborough"/>If anyone slays a foreigner<ptr type="editorNote" n="1" target="#Ine_23.attnote.n.1"/>, the king shall have two-thirds of his wergeld, and his son or relatives one-third.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock"><pb n="402" ed="#whitelock"/>If a foreigner is slain, the king has two-thirds of the wergild, his son or kinsmen the third part.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="389" ed="#jurasinski-and-oliver"/>If a foreigner is killed, the king gets two parts of the <hi rend="italic">wer</hi>, the third goes to the son[s] or kinsmen.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_23.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">99</biblScope></bibl><seg type="original" xml:lang="de">et <hi rend="italic">fügt zu M Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">et added by M Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_23.lnote.oe.22" n="22" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">99</biblScope></bibl><seg type="original" xml:lang="de">fi. sui uel p. eius <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">fi. sui uel p. eius Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_23.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">98</biblScope></bibl><seg type="original" xml:lang="de">an cwædne? <hi rend="italic">Bu</hi></seg><seg type="translation" xml:lang="en" source="#claude">an cwædne? Bu</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_23.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">98</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">endet Bu</hi></seg><seg type="translation" xml:lang="en" source="#claude">Bu ends</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_23.lnote.oe.2-2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">98</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_23.lnote.oe.11" n="11" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">98</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> dælas þæs</seg><seg type="translation" xml:lang="en" source="#claude">altered to dælas þæs</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_23.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">98</biblScope></bibl><seg type="original" xml:lang="de">ælþeodigne mon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">ælþeodigne mon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_23.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">98</biblScope></bibl><seg type="original" xml:lang="de">twegen dælas þæs w. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">twegen dælas þæs w. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Ine_23.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">98</biblScope></bibl><seg type="original" xml:lang="de">magas <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">magas Ld</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_23.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">71</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Fremde 5a—c; König 14; Sippe 26b. 29d</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Fremde 5a—c; König 14; Sippe 26b. 29d</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_23.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">71</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘2 Teile’ = ⅔ modernisiert hb</seg><seg type="translation" xml:lang="en" source="#claude">‘2 parts’ = ⅔, modernised hb</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Ine_23.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">72</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘Söhne’ Q, was in später Sprache möglich. Ælfred braucht dafür <hi rend="italic">suna;</hi> Cosijn <hi rend="italic">Altwestsä. Gram.</hi> II 43</seg><seg type="translation" xml:lang="en" source="#claude">‘Sons’ Q, which is possible in late usage. Ælfred uses <hi rend="italic">suna</hi> for this; Cosijn <hi rend="italic">Altwestsä. Gram.</hi> II 43</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Ine_23.attnote.fn.15" n="15" source="#attenborough"><bibl><biblScope unit="page">42</biblScope></bibl><label>twædne</label><seg type="original" xml:lang="en"><hi rend="italic">twegen dælas þæs weres</hi>. B. <hi rend="italic">twegen dæl weres</hi>. H.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Ine_23.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">185</biblScope></bibl><seg type="original" xml:lang="en">Including probably, as Liebermann suggests, a subject of one of the English kingdoms other than Wessex.</seg></note>
      </div>
