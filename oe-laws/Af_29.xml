        <note type="liebermannNote" subtype="textual" xml:id="Af_29.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">64</biblScope></bibl><seg type="original" xml:lang="de">-bót <hi rend="italic">So Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-bót So Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_29.lnote.oe.15-2" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">62</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Cap.</hi> 25 <hi rend="italic">stellt H allein hinter</hi> 31,1 <hi rend="italic">und vor</hi> [<hi rend="italic">das inhaltlich verwandte</hi>] 26</seg><seg type="translation" xml:lang="en" source="#claude">H alone places cap. 25 after 31,1 and before 26 [which is related in content]</seg></note>
