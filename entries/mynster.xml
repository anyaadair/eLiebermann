        <dictScrap type="liebermann"><hi rend="bold">mynster</hi> <hi rend="italic">Kirchengebäude, kirchliches Einzelstift; <ref type="abbreviation" target="gram:Genitiv"><abbr>gn</abbr></ref>:</hi> ~stres <ref type="lawCode" target="law:Wi">Wi</ref> 17. <ref type="lawCode" target="law:IIEg">II Eg</ref> 3,1 = <ref type="lawCode" target="law:VIIIAtr">VIII Atr</ref> 8 = <ref type="lawCode" target="law:ICn">I Cn</ref> 8,2. 2,5 <ref type="lawCode" target="law:MsA">A</ref> (~rclænsung <hi rend="italic"><ref type="abbreviation" target="gram:ubrigeHandschriften"><abbr>übr.</abbr></ref></hi>). <ref type="lawCode" target="law:VIIIAtr">VIII Atr</ref> 5,1 = <ref type="lawCode" target="law:ICn">I Cn</ref> 3,2. <ref type="lawCode" target="law:Grith">Grið</ref> 10 | <hi rend="italic"><ref type="abbreviation" target="gram:Dativ"><abbr>dt</abbr></ref>:</hi> ~re <ref type="lawCode" target="law:Af">Af</ref> 8; minster<ref type="abbreviation" target="gram:sic"><abbr>!</abbr></ref> <ref type="lawCode" target="law:Ld">Ld</ref>; ~tre 21. <ref type="lawCode" target="law:Ine">Ine</ref> 6,1 <ref type="lawCode" target="law:H">H</ref>. <ref type="lawCode" target="law:VAs">V As</ref> 3. <ref type="lawCode" target="law:IIEg">II Eg</ref> 1,1. 2,2 (= <ref type="lawCode" target="law:ICn">I Cn</ref> 11,2). 3,1 (= <ref type="lawCode" target="law:VIIIAtr">VIII Atr</ref> 8 = <ref type="lawCode" target="law:ICn">I Cn</ref> 8,2). 5,2 <ref type="lawCode" target="law:D">D</ref> <ref type="lawCode" target="law:MsA">A</ref>. <ref type="lawCode" target="law:VAtr">V Atr</ref> 5 = <ref type="lawCode" target="law:VIAtr">VI</ref> 3. 3a. <ref type="lawCode" target="law:VAtr">V</ref> 12,1 = <ref type="lawCode" target="law:VIAtr">VI</ref> 21 (= <ref type="lawCode" target="law:ICn">I Cn</ref> 13,1). VIIa 6 (minstre 6,2). <ref type="lawCode" target="law:Grith">Grið</ref> 10 | <hi rend="italic"><ref type="abbreviation" target="gram:accusativus"><abbr>ac</abbr></ref>:</hi> ~ <ref type="lawCode" target="law:Ine">Ine</r