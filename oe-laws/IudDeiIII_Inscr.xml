      <div type="clause" n="Inscr.">
        <head><ref type="lawCode" target="law:IudDeiIII">Iud Dei III</ref> Inscr.</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="Iud Dei III Inscr." corresp="#wit-lat"><pb n="408" ed="#liebermann"/>Incipit exorcismus<ptr type="liebermannNote" n="1" target="#IudDeiIII_Inscr.lnote.oe.1"/> panis ordeacii<ptr type="liebermannNote" n="2" target="#IudDeiIII_Inscr.lnote.oe.2"/> et<ptr type="liebermannNote" n="3" target="#IudDeiIII_Inscr.lnote.oe.3"/> casei<ptr type="liebermannNote" n="b" target="#IudDeiIII_Inscr.lnote.oe.b"/>, ad<ptr type="liebermannNote" n="4" target="#IudDeiIII_Inscr.lnote.oe.4"/> probationem ueri.</ab>
        <note type="editorial">New row (October 2026): Liebermann’s text transcribed from Gesetze I p. 408 (two independent readings of the page images, differences settled against the page); Liebermann’s heading: [III.]; F: corrected against Liebermann, Gesetze I (date at the head of the text); Wormald, Making of English Law I; Whitelock, English Historical Documents I, October 2026 (was “c. 850–c. 975 (Liebermann)”, now “c. 850–c. 975 (Liebermann, I p. 408)”)</note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_Inscr.lnote.oe.a" n="a" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Fortsetzung zu</hi> II</seg><seg type="translation" xml:lang="en" source="#claude">Continuation of II</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_Inscr.lnote.oe.b" n="b" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">quorum appensio est{*} unius unciae{**} <hi rend="italic">fügen zu alle Hss., ausser Ps Ci; vgl.</hi> untia dimidia panis, similiter et casei <hi rend="italic">Zeumer</hi> 666<hi rend="italic">d</hi>. 681<hi rend="italic">a</hi>. 686<hi rend="italic">a</hi>. 688; <hi rend="italic">unten</hi> XIV 1, 1. <hi rend="italic">Anders Zeu.</hi> 629 (631<hi rend="italic">k</hi>. 634<hi rend="italic">c</hi>). 645₄₀. 671<hi rend="italic">e</hi></seg><seg type="translation" xml:lang="en" source="#claude">quorum appensio est{*} unius unciae{**} added in all MSS except Ps Ci; cf. untia dimidia panis, similiter et casei Zeumer 666d. 681a. 686a. 688; below XIV 1, 1. Differently Zeu. 629 (631k. 634c). 645₄₀. 671e</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_Inscr.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Inscr.,</hi> 1 <hi rend="italic">u.</hi> 2—2, 5 <hi rend="italic">druckte</hi> (<hi rend="italic">aus Ch?</hi>) <hi rend="italic">Parker</hi> Antiq. eccl. Brit. (<hi rend="italic">ed.</hi> 1605) <hi rend="italic">p.</hi> 104</seg><seg type="translation" xml:lang="en" source="#claude">Inscr., 1 and 2—2, 5 were printed (from Ch?) by Parker, Antiq. eccl. Brit. (ed. 1605) p. 104</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_Inscr.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">hordeacei <hi rend="italic">Pt</hi></seg><seg type="translation" xml:lang="en" source="#claude">hordeacei Pt</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_Inscr.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">uel <hi rend="italic">Ps Ci</hi></seg><seg type="translation" xml:lang="en" source="#claude">uel Ps Ci</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="IudDeiIII_Inscr.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">408</biblScope></bibl><seg type="original" xml:lang="de">ad p. u. <hi rend="italic">fehlt Pt Rj Ch Ca H</hi></seg><seg type="translation" xml:lang="en" source="#claude">ad p. u. omitted in Pt Rj Ch Ca H</seg></note>
      </div>
