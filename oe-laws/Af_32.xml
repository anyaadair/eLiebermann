        <note type="liebermannNote" subtype="textual" xml:id="Af_32.lnote.oe.13" n="13" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">món nó <hi rend="italic">vom Schreiber accentuirt zur Verbesserung des ursprünglichen</hi> monno</seg><seg type="translation" xml:lang="en" source="#claude">món nó accented by the scribe to correct the original monno</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_32.lnote.oe.14" n="14" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">e <hi rend="italic">und erstes</hi> r <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">e and first r on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_32.lnote.oe.15" n="15" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">eor <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">eor on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_32.lnote.oe.16" n="16" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">66</biblScope></bibl><seg type="original" xml:lang="de">æm <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">æm on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_32.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">67</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">verb. aus</hi> confri. <hi rend="italic">R</hi></seg><seg type="translation" xml:lang="en" source="#claude">corrected from confri. R</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_32.lnote.oe.18" n="18" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">67</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> ipso <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Lond; ipso the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_32.lnote.oe.19" n="19" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">67</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so Lond;</hi> <hi rend="spaced">liceat</hi> <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">thus Lond; <hi rend="italic">liceat</hi> the others</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_32.lnote.oe.5-2" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">67</biblScope></bibl><seg type="original" xml:lang="de">ne <hi rend="italic">später eingefügt</hi></seg><seg type="translation" xml:lang="en" source="#claude">ne inserted later</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_32.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">67</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">so</hi></seg><seg type="translation" xml:lang="en" source="#claude">sic</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_32.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Verleumdung 1. 3</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Verleumdung 1. 3</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_32.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Zum Wort <hi rend="italic">vgl.</hi> Sievers <hi rend="italic">Gram.</hi> § 192. 264, 3. 267; nach Toller heisst <hi rend="italic">ræfsan</hi> ‘tadeln’ <hi rend="italic">interpellare</hi> [= anschuldigen], <hi rend="italic">ræpsit, -sung: interceptum, -tio</hi> [ertappt]. <hi rend="italic">Vgl.</hi> ahd. <hi rend="italic">rafsjan, refsan, -sunga</hi> ‘beschuldigen’, mhd. <hi rend="italic">gerefsen</hi> ‘schelten’. Toller bringt <hi rend="italic">geresp:</hi> ‘convictus’ und <hi rend="italic">geræf:</hi> ‘fixus’ nur aus Af 32. <hi rend="italic">Vgl.</hi> II Cn 76 B⁷</seg><seg type="translation" xml:lang="en" source="#claude">On the word <hi rend="italic">cf.</hi> Sievers <hi rend="italic">Gram.</hi> § 192. 264, 3. 267; according to Toller <hi rend="italic">ræfsan</hi> means ‘to blame’, <hi rend="italic">interpellare</hi> [= to accuse], <hi rend="italic">ræpsit, -sung: interceptum, -tio</hi> [caught in the act]. <hi rend="italic">Cf.</hi> OHG <hi rend="italic">rafsjan, refsan, -sunga</hi> ‘to accuse’, MHG <hi rend="italic">gerefsen</hi> ‘to scold’. Toller cites <hi rend="italic">geresp:</hi> ‘convictus’ and <hi rend="italic">geræf:</hi> ‘fixus’ only from Af 32. <hi rend="italic">Cf.</hi> II Cn 76 B⁷</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_32.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Vgl. Gl</hi> Zunge 3; sie gilt ¹/₃ Wergeld; Af 47. 52</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">Cf. Gl</hi> Zunge 3; it is valued at ¹/₃ of the wergild; Af 47. 52</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_32.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">57</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Nicht des Verleumdeten</seg><seg type="translation" xml:lang="en" source="#claude">Not that of the person slandered</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_32.attnote.fn.27" n="27" source="#attenborough"><bibl><biblScope unit="page">76</biblScope></bibl><label>geresp</label><seg type="original" xml:lang="en"><hi rend="italic">geræf</hi>. Ld, B &amp; H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_32.attnote.fn.28" n="28" source="#attenborough"><bibl><biblScope unit="page">76</biblScope></bibl><label>weorðe</label><seg type="original" xml:lang="en"><hi rend="italic">wurde</hi>. B.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_32.attnote.fn.29" n="29" source="#attenborough"><bibl><biblScope unit="page">76</biblScope></bibl><label>lesan</label><seg type="original" xml:lang="en"><hi rend="italic">alysan</hi>. H.</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_32.attnote.fn.30" n="30" source="#attenborough"><bibl><biblScope unit="page">76</biblScope></bibl><label>geeahtige</label><seg type="original" xml:lang="en"><hi rend="italic">geehtige</hi>. B.</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Af_32.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">196</biblScope></bibl><seg type="original" xml:lang="en"><hi rend="italic">i.e.</hi> one-third of the wergeld; cf. cap. 52 and 47, below.</seg></note>
